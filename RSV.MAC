;============================================================
; FILE:    RSV.MAC
; PROJECT: VI
; MODULE:  The reserve block -- storage that lives ABOVE the linked image.
;------------------------------------------------------------
; L80 writes every byte between 0100H and the top of the image into the .COM,
; DS included -- and what it writes there is not zeros, it is whatever was in
; L80's own memory as it linked (dump UNDREC out of an old VI.COM and you get
; 8080 code).  So a DS inside the image costs a byte of FILE, and a sector of
; load time, for every byte of storage, and buys nothing at all: the loader
; faithfully copies rubbish that the program overwrites before it reads it.
;
; This module holds that storage instead.  It emits NO bytes, so it adds
; nothing to the image; linking it LAST puts its (empty) CSEG at the top, and
; every member is named as an offset from there.  BUF.MAC's PBEGMEM -- the
; base of the gap-buffer arena -- then starts at RSVTOP rather than at the
; image top, so the arena is exactly the size it always was.  Nothing is
; bought here except .COM bytes; nothing is paid except that these names now
; resolve through the linker instead of inside their own module.
;
; WHAT MAY LIVE HERE.  Two kinds of storage, and nothing else:
;
;   - a reserve: a block that is written before it is read, so it does not
;     matter what it holds when the program starts.  The stack, the buffers
;     and the tables in the first part of the layout are these.
;   - a cell that starts at zero.  These are the second part of the layout,
;     RSVZ to RSVTOP, and BUF.MAC's ZINIT clears every byte of it before
;     anything else runs -- in VI.COM and in every test program alike.  A
;     DB 0 in the image was a promise the linker kept; this is the same
;     promise, kept by fifteen bytes of code instead of a byte of file each.
;
; A cell that starts at anything BUT zero stays a DB or DW in its own module
; (NROWS, GOALCOL, UNDNEW ...): setting it at run time would cost more code
; than the byte it frees.  So does a cell that code reaches from such a one
; by stepping a pointer -- SCRN.MAC's frame row is copied whole and holds
; TXEND and FILCH, so all of it stays there.
;
; ORDER IS PART OF THE CONTRACT.  Each module's cells are here in the order
; they had in that module, because code walks from one into the next: WM's
; pointer row, AUXCNT after NEWFIL, the two flag bytes below each FCB, the
; length byte below SRCHST and below SREPL, and every LHLD that takes two
; byte cells at once.  Add a cell at the end of its module's run, or beside
; the cell it belongs with; never sort them.
;
; SECBUF is a reserve, and comes with its two guard bytes -- STAGSEC writes
; SECBUF-1 through SECBUF+128 (C=82H) and ^Z-pads whatever the copy did not
; fill, so no stale byte reaches a sector.
;
; Sizes that also exist in the module that uses the storage are declared in
; VI.INC (DOTMAX, KBRSIZ, EXMAX, SREPMX) so the two cannot disagree.  The
; sizes that cannot be shared -- BUF.MAC does not include VI.INC -- carry a
; CHECK line below, which build_vi.py evaluates against BUF.MAC on every
; build.
;============================================================
	INCLUDE VI.INC

	PUBLIC	VISTK			; VI.MAC   -- the stack
	PUBLIC	DOTSCR, DOTBUF		; CMD.MAC  -- '.' scratch + last change
	PUBLIC	FNAME, ZTOP, PLUSB	; CMD.MAC  -- name, G/gg top, '+{n}'
	PUBLIC	EXBUF			; CMD.MAC  -- the ':' line
	PUBLIC	KBRING			; KEY.MAC  -- type-ahead ring
	PUBLIC	WRTYP, SECBUF		; PAGE.MAC -- saved type, sector stage
	PUBLIC	UNDREC			; BUF.MAC  -- the captured change
	PUBLIC	MKTAB			; CMD.MAC  -- the marks 'm' sets
	PUBLIC	MKSAV			; CMD.MAC  -- ... as a refused 'dd' found them
	PUBLIC	MKUND			; CMD.MAC  -- ... as the last change found them
	PUBLIC	HTAB			; SCRN.MAC -- the rows of the lines about the
					;             screen, for the scrolls
	PUBLIC	RSVZ, RSVZN		; BUF.MAC  -- ZINIT: the cells to clear
	PUBLIC	RSVTOP			; BUF.MAC  -- PBEGMEM, the arena base

;--- Sizes ------------------------------------------------------------------
;UNDREC is URSIZE*URMAX in BUF.MAC, which does not include VI.INC.  The CHECK
;line is read by build_vi.py, which evaluates the expression against BUF.MAC's
;own equates and fails the build if the two ever drift apart.
;CHECK BUF.MAC URSIZE*URMAX = 168
RVUNDN	EQU	168		; UNDREC:  BUF.MAC URSIZE*URMAX
RVSTKN	EQU	128		; VISTK:   64 was enough until '.' replayed a
				;          command through CMDDIS from inside
				;          a handler
RVFNMN	EQU	12		; FNAME:   drive, name, type
RVZTPN	EQU	3		; ZTOP:    a 3-byte file position
RVPLSN	EQU	6		; PLUSB:   '+{n}' digits, 0-terminated
RVWRTN	EQU	3		; WRTYP:   an FCB type field
RVSECN	EQU	128		; SECBUF:  one CP/M sector
RVHTN	EQU	255		; HTAB:    a byte a line; SCRN.MAC HTPUT drops
				;          a 256th
;MKSAV is a copy of MKTAB that CMD.MAC makes and restores with COPY12.
;CHECK VI.INC MKMAX*MKSIZ = 12

;--- Layout, as offsets from the image top ----------------------------------
;Plain constants, so no relocatable symbol is ever used to build another.
;DOTBUF must follow DOTSCR: the '.' overflow test walks one into the other.
RVSTK	EQU	0
RVDOTS	EQU	RVSTK+RVSTKN
RVDOTB	EQU	RVDOTS+DOTMAX
RVFNM	EQU	RVDOTB+DOTMAX
RVZTP	EQU	RVFNM+RVFNMN
RVPLS	EQU	RVZTP+RVZTPN
RVEXB	EQU	RVPLS+RVPLSN
RVKBR	EQU	RVEXB+EXMAX+1
RVWRT	EQU	RVKBR+KBRSIZ
RVSEC	EQU	RVWRT+RVWRTN+1	; +1: STAGSEC's guard byte at SECBUF-1
RVUND	EQU	RVSEC+RVSECN+1	; +1: ... and its guard at SECBUF+128
RVMKT	EQU	RVUND+RVUNDN
RVMKS	EQU	RVMKT+MKMAX*MKSIZ
RVMKU	EQU	RVMKS+MKMAX*MKSIZ
RVHTB	EQU	RVMKU+MKMAX*MKSIZ
RVSIZE	EQU	RVHTB+RVHTN	; ... and the cells that start at zero follow

	CSEG
RSVBAS:				; the top of the linked image -- no bytes here

VISTK	EQU	RSVBAS+RVSTK+RVSTKN	; the stack GROWS DOWN from its top
DOTSCR	EQU	RSVBAS+RVDOTS
DOTBUF	EQU	RSVBAS+RVDOTB
FNAME	EQU	RSVBAS+RVFNM
ZTOP	EQU	RSVBAS+RVZTP
PLUSB	EQU	RSVBAS+RVPLS
EXBUF	EQU	RSVBAS+RVEXB
KBRING	EQU	RSVBAS+RVKBR
WRTYP	EQU	RSVBAS+RVWRT
SECBUF	EQU	RSVBAS+RVSEC
UNDREC	EQU	RSVBAS+RVUND
MKTAB	EQU	RSVBAS+RVMKT
MKSAV	EQU	RSVBAS+RVMKS
MKUND	EQU	RSVBAS+RVMKU
HTAB	EQU	RSVBAS+RVHTB
;============================================================
; THE CELLS THAT START AT ZERO -- RSVZ to RSVTOP, cleared by BUF.MAC's ZINIT.
;------------------------------------------------------------
; CELL names the next SIZE bytes and makes the name PUBLIC; the module that
; owns the cell declares it EXTRN.  RZ is the running offset from the image
; top.  A byte with no name of its own is passed over with a bare RZ SET.
;============================================================
CELL	MACRO	NAME,SIZE
	PUBLIC	NAME
NAME	EQU	RSVBAS+RZ
RZ	SET	RZ+SIZE
	ENDM

RZ	SET	RVSIZE
RSVZ	EQU	RSVBAS+RZ

;--- SCRN.MAC ---------------------------------------------------------------
	CELL	TCOK,1		; TCPOS is where the terminal's cursor is
	CELL	TCPOS,2		; SCOL, SROW as SCURS last sent them
;What SCPRE keeps of the frame before: SCRN.MAC's frame row (WINROW to NXTR,
;which stays in the image), copied whole, so in that row's order.
	CELL	OLDWR,2	
	CELL	OLDSK,2	
	CELL	OLDSC,2	
	CELL	OLDTX,2		; (TXEND, and FILCH)
	CELL	OLDBOT,1
	CELL	OLDAB,2	
	CELL	OLDCS,1	
	CELL	OLDCR,1	
	CELL	OLDNR,1	
	CELL	OPN,1		; SCDRAW: rows the screen gave up at the top
	CELL	OPM,1		; ... or gained there
	CELL	EDA,1		; the edit: the rows it had
	CELL	EDB,1		; ... and has
	CELL	EDR,1		; ... its first row
	CELL	EDP,1		; ... the first of them to draw
	CELL	PEND,1		; PRNG: the row to stop before
	CELL	TALLF,1		; 1 = the top line is taller than the screen
	CELL	SCRLN,2		; lines the text moved up this frame (signed)
	CELL	LYOK,1		; 1 = the row table is the screen's, as it stands
	CELL	LQKC,1		; LYQK: the cells before the cursor on its row
	CELL	LYTOP,2		; ... the bytes in memory before the top line then
	CELL	HTTOPC,2	; HTBLD: the bytes from the table's first line to
				;   the cursor
	CELL	LYPG,2		; ... and PGTOPM
	CELL	FORCEF,1	; 1 = a full frame is not finished -> repaint in full
	CELL	OEDMOD,1	; the mode the bottom row last showed (0FFH: unknown)
	CELL	SCEOF,1		; 1 = the end of the file is on the screen
	CELL	SCBOF,1		; 1 = the top row is the file's first line
	CELL	PLACE,1		; the command's request of the next layout (VI.INC
				;   PL_ASK / PL_SET / PL_MID)
	CELL	CSUB,1		; the row of its line the cursor is on (0 = first)
	CELL	TOPLEN,2	; bytes from the top line's start to the cursor
	CELL	CBOL,2		; bytes from the cursor line's start to the cursor
	CELL	CURDCL,2	; cursor display column (0-based, tabs expanded)
	CELL	LYDLT,2		; LAYOUT: LNDLT taken for this frame
	CELL	LYROW,1		; LAYOUT: working row
	CELL	LYIB,2		; LYMID: -> the entry of the next line below
	CELL	LYVB,1		; LAYOUT: the column its current row starts at (low
				;   byte: TAB stops)
	CELL	LYLIM,2		; HTBLD: bytes back to pin while reading down
	CELL	LYUSE,1		; LYMID: rows taken
	CELL	LYMAB,1		; LYMID: ... of them above the cursor's line
	CELL	LYMBL,1		; LYMID: ... and below it ('~' rows too)
	CELL	LYND,1		; LYMID: lines under the last one shown (LYFAR)
	CELL	LYPRF,1		; LYMID: 1 = a line above first when rows are even
	CELL	LYSVR,1		; LAYOUT: LYROW as CURRW gave it
	CELL	HTLIM,1		; HTBLD: rows still to gather
	CELL	LYXE,1		; HTBLD: 1 when the cursor has a row to itself
	CELL	LYLAST,1	; LAYOUT: last byte read forward
	CELL	SVCNT,2		; LAYOUT: saved CMDCNT
	CELL	SVAUX,2		; LAYOUT: saved AUXCNT
	CELL	SVDIR,1		; LAYOUT: saved DIRFLG
	CELL	RDP,2		; reader: next before-gap byte
	CELL	RDN,2		; reader: before-gap bytes left
	CELL	RDHL,2		; reader: RGET pointer
	CELL	RDBC,2		; reader: RGET count
	CELL	RDSEG,1		; reader: 1 once reading after the gap
	CELL	SKPN,1		; RDSKIP line count
	CELL	PROWN,1		; screen row being painted (0-based)
	CELL	PSKN,2		; PROW: rows of the line to pass over first
	CELL	DCOL,1		; column in the line while painting (low byte)
	CELL	XC,1		; cells used in the row being painted
	CELL	TMPR,2		; DSR parse: rows
	CELL	TMPC,2		; DSR parse: cols

;--- CMD.MAC ----------------------------------------------------------------
	CELL	EDMODE,1
	CELL	CMDCNT,2	; count prefix (0 = none)
	CELL	QUITF,1		; set 1 by :q / :wq
	CELL	MODF,1		; 1 = unsaved changes
	CELL	RINTENT,1	; render intent for the last key (SCRN.MAC reads)
	CELL	ICHAPP,1	; 1 = the R_ICH char went at the row's end, so
				;   nothing follows it to shift: no ICH needed
	CELL	DCHBS,1		; 1 = they went left of the cursor (insert's BS)
	CELL	LNALL,1		; 1 = this R_LINE is drawn from the line's first
				;   row, not the cursor's (SCRN.MAC clears it)
	CELL	ILABOV,1	; 1 = the row above an R_ILIN's opened rows lost
				;   text to them and must be redrawn too
	CELL	WBIG,1		; word motion: 0 = w/b/e, 1 = W/B/E
	CELL	WPULL,1		; w/W ended off a line's end and was pulled back
	CELL	HFAMT,1		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
	CELL	HFN,1		; ^D/^U: the rows this one goes
	CELL	HFTP,2		; ^D/^U: -> the new top line's entry
	CELL	HTN,1		; row table: its entries
	CELL	HTCUR,1		; ... the cursor line's
	CELL	HTTP,1		; ... the top line's
	CELL	HTEOF,1		; ... 1 = its last is the file's last line
	CELL	HTBOF,1		; ... 1 = its first is the file's first
	CELL	RWR,2		; ^F/^B: rows still to go
	CELL	RWMV,1		; ^F/^B: 1 = the table was made again on the way
	CELL	OVDIR,1		; OVLAP: 0 = h2.. are above h1 in the table
	CELL	JKCNT,2		; j/k: count
	CELL	JKN,2		; j/k: lines scanned for (min(count, limit))
	CELL	JKMOV,2		; j: lines moved
	CELL	JKBK,2		; k: scan position, bytes back from GAPBEG
	CELL	JKPHN,1		; j: 1 = moved may be one less (last LF ends the file)
	CELL	JKLST,1		; j: last byte of the scan
	CELL	JKVC,2		; j/k landing: screen column
	CELL	JKLS,2		; j/k landing: last content char (0FFFFH = none)
;'.' (repeat): see CMD.MAC's '.' section for how these are driven.
	CELL	DOTCHG,1	; 1 = the command being typed changed the text
	CELL	DOTRPL,1	; 1 = '.' is replaying, so nothing is recorded
	CELL	DOTOVF,1	; 1 = the change outgrew the scratch
	CELL	DOTLK,1		; the last key recorded, encoded
	CELL	DOTLEN,1	; keys in DOTBUF (0 = nothing to repeat)
	CELL	DOTIX,1		; the replay's read index into DOTBUF
	CELL	DOTNCT,2	; the count typed on the '.' (0 = none)
	CELL	GPEND,1		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
	CELL	GSAVE,1		; the pending snapshot for the current command
	CELL	PENDOP,1	; pending operator ('d' for dd)
	CELL	PSAVE,1		; pending-op snapshot for the current command
	CELL	DDSNG,1		; 1 = the current dd deletes a single line (DL paint)
	CELL	OPCLSV,1	; operator: motion class (0 excl, 1 incl, 2 linewise,
				;   3 excl but a jump -- no end-of-line clamp)
	CELL	CWEOL,1		; operator: the motion is 'cw' rewritten to 'ce',
				;   and its first word is yet to be stepped
	CELL	OPSTA,2		; operator: span start (cursor before the motion)
	CELL	OPEND2,2	; operator: span end (cursor after the motion)
	CELL	OPSFP,3		; operator: the start as a place in the file
	CELL	OPSLO,3		; ... where its line starts
	CELL	OPSHI,3		; ... where the next line does (OPPGD: the span's
				;   high end, whichever line that turned out to be)
	CELL	OPTOGO,3	; OPPGD: bytes still to take
	CELL	OPLO,2		; operator: low offset of the delete range
	CELL	OPHI,2		; operator: high offset of the delete range
	CELL	CNTV,2		; motion repeat counter
	CELL	TTI,2		; TAILTAB scan index
	CELL	WKI,2		; scan index
	CELL	WKTERM,2	; line terminator offset
	CELL	WKBOL,2		; EOLC scratch: line BOL
	CELL	WKCLS,1		; word motion: class of the current run
	CELL	VRCH,1		; 'r' / R: the char being stored
	CELL	RPDEL,2		; R: chars overwritten, still in the gap (BS puts back)
	CELL	RPAPP,2		; R: chars appended past the line end (BS deletes)
	CELL	RPGE,2		; R: GAPEND as the last overwrite left it
	CELL	RLPTR,2		; RDLINE: write pointer
	CELL	RLLEN,1		; RDLINE: chars stored
	CELL	RLMAX,1		; RDLINE: capacity
	CELL	EXOP,1		; ex: the command (EO_xx)
	CELL	EXARG,1		; ex: 0 = no file name given
	CELL	EXBAK,1		; ex: the write keeps a backup
	CELL	EXCMD,2		; ex: text shown after a message
	CELL	WPROW,1		; :w -- the cursor's row
	CELL	WPBYT,1		; :w -- the cursor's byte in its record
	CELL	WPREC,2		; :w -- the cursor's record in the file
	CELL	ZDIF,2		; G/gg: target - top (low 16 bits)
	CELL	ZLF,1		; G/gg: lines from the target up to the top
	CELL	ZSVCNT,2	; G/gg: CMDCNT around LINPSB
	CELL	ZSVAUX,2	; G/gg: AUXCNT around LINPSB
	CELL	ZSVDIR,1	; G/gg: DIRFLG around LINPSB
	CELL	MSGWHT,1	; the message the bottom row still owes (MW_xxx)
	CELL	MSGNEW,1	; the file was not there when it was opened ('[New]')
	CELL	EXBANG,1	; ex: 0 = '!' given
	CELL	ROFLAG,1	; command line: '-R' / '/R' was given
	CELL	PLUSF,1		; command line: '+' was given
	CELL	YMODF,1		; yy: MODF across the delete + put back
	CELL	YDCHG,1		; yy: DOTCHG across it too (see '.')
	CELL	YURPL,1		; yy: UNDRPL across it too (see 'u')
	CELL	YOFF,2		; yy: the cursor, which a yank leaves alone
	CELL	YPT,2		; yy: where the lines came from
	CELL	PCNT,2		; p/P: copies still to put
	CELL	PPFP,3		; p/P: the first line put, a file position
	CELL	PLFS,2		; p/P: the lines in the register
	CELL	PCPY,1		; p/P: the copies, kept for the paint
	CELL	YLDLT,2		; yy: LNDLT across the delete + put back
	CELL	SDIR,1		; the last '/' or '?' direction (FFH = back)
	CELL	SDIRE,1		; ... the direction THIS search runs in ('N')
	CELL	SHAVE,1		; nonzero once a pattern has been entered
	CELL	FNDKND,1	; f/F/t/T: which find ';' repeats (0 = none yet)
	CELL	FNDCH,1		; ... and the character it looked for
	CELL	FNDRUN,1	; the find THIS command is running (',' reverses)
	CELL	FNDSTP,1	; how far along it starts: 2 for a 't' repeat
	CELL	FNDN,2		; occurrences still to count off
	CELL	FNDCUR,2	; the cursor it started from
	CELL	FNDLIM,2	; ... and the end of the line it may not pass
	CELL	GPKEEP,1	; GPLACE: keep the column (a search) not FNBLNK
	CELL	MKVAL,3		; marks: nonzero once 'm' has set that one.  It
				;   is a cell and not part of MKTAB because
				;   it must start at zero, and a reserve need not
	CELL	MKEDIT,3	; MKSHFT: where in the file the edit is
	CELL	MKN,2		; ... how long it is
	CELL	MKTYP,1		; ... and which way: 1 text went in, 2 came out
	CELL	MKPOS,3		; MKJMP: the file position being jumped to
	CELL	MKWHAT,1	; which of 'm' / '`' / ''' is running
	CELL	MKHOLD,1	; set across YKGO's delete + put back (a yank
				;   that could not copy): MKSHFT must leave the
				;   marks alone through it
	CELL	YACT,2		; how this yank takes its lines (VD_DD / YSPAN)
	CELL	YTGT,2		; YSPAN: the text's length once the span is out
	CELL	YWAS,2		; ... and its length BEFORE the lines came out
	CELL	YCOL,2		; ... how far into them the cursor sat
	CELL	YPFP,3		; ... and where in the file they start
	CELL	YNPG,2		; the window the yank started in (YNDONE's paint)
	CELL	YNCNT,2		; YNLINE: the lines it still wants
	CELL	SCNT,2		; searches still to do (the count)
	CELL	SOFF,3		; BRKON: where in the FILE the command began
	CELL	SLDLT,2		; ... and LNDLT: for a search that fails, and
				;   any move an ESC stops
	CELL	BRKARM,1	; nonzero: CNTTST looks for an ESC
	CELL	BRKHIT,1	; nonzero: one was found, and the count spent
	CELL	SSKIP,1		; skip the character under the cursor (not
				;   on the wrapped pass)
	CELL	SRNGF,1		; ex: a line range was given
	CELL	SRNG1,2		; ex: its first line
	CELL	SRNG2,2		; ... and its last (FFFFH = the file's last)
	CELL	SDELIM,1	; ':s' the delimiter typed
	CELL	SGFLAG,1	; ':s' the 'g' flag
	CELL	SANY,1		; ':s' something in the range has changed
	CELL	SLCHG,1		; ':s' this line changed
	CELL	SBACK,2		; ':s' lines walked past the last change
	CELL	SLINES,2	; ':s' / ':N,Mw' lines of the range still to do
	CELL	RWPTR,1		; ':N,Mw' the next free byte of the record at
				;   0080H, as that address's low byte
	CELL	RWERR,1		; ':N,Mw' a record would not go: the disk is full
	CELL	RDANY,1		; ':r' something has been read in
	CELL	RDBRK,1		; ':r' the line above wants a line end first
	CELL	SOFFS,3		; ':s' the cursor's place in the file, for one that
	CELL	SLDLTS,2	;   changes nothing, and its LNDLT
;SREPLN sits just below SREPL: WM's RDSTR layout, so INSSTR can splice it.
	CELL	SREPLN,1	; ':s' the replacement's length, kept
	CELL	SREPL,SREPMX+1	; ... and the replacement

;--- KEY.MAC ----------------------------------------------------------------
	CELL	KBHEAD,1	; ring read index (oldest byte)
	CELL	KBTAIL,1	; ring write index (next free slot)

;--- PAGE.MAC ---------------------------------------------------------------
;Each FCB is preceded by two flag bytes: [FCB-2] = WRREC/CLOSEC's per-file
;open flag, [FCB-1] = the file's has-data flag (WM layout: OUTACT before
;OUTFCB, BAKRDY before BAKFCB; the source uses 005BH before the CCP's FCB at
;005CH).
;WM's marks OUTPOS (0x26CD) and BAKPOS (0x26F3) are NOT separate cells -- the
;authoritative wm_map.py addresses show they ARE FCB random-record fields:
;OUTPOS = OUTFCB(0x26AB)+22H and BAKPOS = BAKFCB(0x26D1)+22H.  They advance
;with the file automatically: RECINC/RECDEC/WRRECP step FCB+22H, so OUTPOS is
;OUTFCB's current write position and PAGEOUT's "OUTREC vs OUTPOS" compare
;skips exactly the records REWIND already pulled back.  A separate static
;cell would never advance, and the save would stop after its first record.
RZ	SET	RZ+1		; OUTFCB-2 : WRREC/CLOSEC open flag
	CELL	OUTACT,1	; OUTFCB-1 : out-side active flag
	CELL	OUTFCB,36	; output file (name.$$$)
OUTTYP	EQU	OUTFCB+9	; OUTFCB type field ('$$$' / briefly 'BAK')
	PUBLIC	OUTTYP
OUTPOS	EQU	OUTFCB+22H	; OUTFCB random-record word (write position)
	PUBLIC	OUTPOS
RZ	SET	RZ+1		; BAKFCB-2 : WRREC/CLOSEC open flag
	CELL	BAKRDY,1	; BAKFCB-1 : backup-has-data flag
	CELL	BAKFCB,36	; backup file (VIBACKUP$$$)
BAKPOS	EQU	BAKFCB+22H	; BAKFCB random-record word (RECBASE input base)
	PUBLIC	BAKPOS
	CELL	PGTOPM,2	; (appended) times the pager moved TXTBEG --
				;   the window signature 'u' checks (see BUF.MAC)
	CELL	OUTREC,2	; output write high-water (record)
	CELL	OUTHI,2		; (appended) most records name.$$$ has held
	CELL	SRCREC,2	; source read low-water (record)
	CELL	BAKREC,2	; backup read low-water (record)
	CELL	INLEN,1		; last input record byte count
	CELL	DSTDRV,1	; nonzero if output is on a different drive
	CELL	NEWFIL,1	; nonzero if the source did not exist
	CELL	AUXCNT,2	; WM L271E -- must follow NEWFIL: GOLINE's
				;   LHLD NEWFIL / DAD H tests its low byte
	CELL	DIRFLG,1	; scroll/search direction (neg = backward)
;APPENDED (not WordMaster).  Kept clear of NEWFIL/AUXCNT: GOLINE reads the
;byte after NEWFIL as AUXCNT's low byte.
	CELL	WRKMAD,1	; a work record has been written, so name.$$$ /
				;   VIBACKUP$$$ may exist (DISCRD tests it)
	CELL	SKREC,2		; SEEKTO: target record (APPENDED, not WM)
	CELL	SKBYT,1		; SEEKTO: target byte in that record
	CELL	TOPLF,2		; the line feeds behind the window: in output
				;   records 0 to OUTPOS-1 (TLFADD / TLFSUB)
	CELL	CLCNT,2		; CNTLF: line feeds counted
RZ	SET	RZ+1		; TFCB-2 : WRREC/CLOSEC open flag (DELF clears)
RZ	SET	RZ+1		; TFCB-1
	CELL	TFCB,36		; WRTO / TEXIST: the target file
	CELL	WRLIM,2		; PAGEOUT write limit (set to PGINIT / 81H)
	CELL	RDLIM,2		; PAGEBOT read limit (set to PGINIT)
	CELL	BUFLO,2		; buffer low-water reserve (PGCONST)
	CELL	BUFHI,2		; buffer high-water fill target (PGCONST)
	CELL	PGSCAL,1	; memory-scaled batch count (PGCONST)
	CELL	PGSCL2,1	; = PGSCAL*2 (SPILL arithmetic)
	CELL	MARGLO,1	; WM 272F: fixed 0 low byte so LHLD MARGLO = PGMARGN*256
	CELL	PGMARGN,1	; paging low-water margin in pages
	CELL	IOBATCH,1	; records per read-ahead / write-behind batch
	CELL	PGSCRA,1	; (PGCONST scratch; nothing reads it)
	CELL	SPLCNT,1	; SPILL batch counter

;--- BUF.MAC ----------------------------------------------------------------
;The (base,limit) pointer row (WM 6828-6871 layout).  The disassembly's DB
;values for these cells are aliased code bytes; only the order/adjacency is
;authoritative.  BINIT sets every cell at run time.
	CELL	BUFBEG,2	; region-array base
	CELL	QBEG,2		; ^Q scratch buffer begin
	CELL	QEND,2		; ^Q scratch buffer end
	CELL	HOLEQP,2
	CELL	TXTBAS,2	; text base = PBEGMEM+1 (past the 0 sentinel)
;UBEG/UEND -- APPENDED: the undo region, a region of the arena like the Q
;buffer, with UEND its insertion point.  It goes HERE, between the slider and
;the text, so both of the row's interleaved walks stay aligned: the holes from
;BUFBEG are (BUFBEG,QBEG) (QEND,HOLEQP) (TXTBAS,UBEG) (UEND,TXTBEG)
;(GAPBEG,GAPEND) (TXTEND,BUFEND), and the data regions from QBEG are
;(QBEG,QEND) (HOLEQP,TXTBAS) (UBEG,UEND) (TXTBEG,GAPBEG) (GAPEND,TXTEND).
;NEXTPR, MOVGAP, BUFSUM, HOLEUP/HOLEDN, PRSPAN and INIBAS's count are all
;untouched by it; INIGAP empties it.
	CELL	UBEG,2		; undo region begin
	CELL	UEND,2		; undo region end = its insertion point
	CELL	TXTBEG,2	; window start
	CELL	GAPBEG,2	; cursor / gap start
	CELL	GAPEND,2	; gap end / first char after cursor
	CELL	TXTEND,2	; window end
PRTERM	EQU	TXTEND+1	; NEXTPR terminator = high byte of TXTEND
	PUBLIC	PRTERM
	CELL	BUFEND,2	; top of usable text RAM
MVGTOP	EQU	BUFEND+1	; MOVGAP upper bound = high byte of BUFEND
	PUBLIC	MVGTOP
	CELL	ERRFLG,1	; nonzero after ERRMSG fired (harness reads it)
;The search pattern, in WM's SRCHBUF layout (WM 6900): the length, then the
;string, 0-terminated.  CMD.MAC fills it from the '/' line and passes DE =
;SRCHST; FWDCNT reads the length from the byte below that, as WM does.
;CHECK BUF.MAC SRMAX+1 = 31
	CELL	SRCHBF,1	; the pattern length
	CELL	SRCHST,31	; the pattern, 0-terminated: BUF.MAC SRMAX+1
	CELL	L2756,2		; WM L2756 -- GOLINE's last target position
	CELL	QCPDON,2	; (appended) QCPYN: bytes already copied in
;'u' (undo): see BUF.MAC's UNDO section for how these are driven.
	CELL	UNDN,1		; steps captured (0 = nothing to undo)
	CELL	UNDST,1		; 0 none, 1 change applied ('u' undoes it),
				;   2 already undone ('u' puts it back)
	CELL	UNDBAD,1	; 1 = this change was too big to capture
	CELL	UNDRPL,1	; 1 = 'u' replaying, so nothing is captured
	CELL	UNDDIR,1	; the replay's direction (0 forward, 1 inverse)
	CELL	UNDWHY,1	; 0 = nothing to undo, 1 = it has paged away
	CELL	UNDTY,1		; the step / record type being handled
	CELL	UNDOF,2		; ... its logical offset
	CELL	UNDLN,2		; ... its length
	CELL	UNDBO,2		; ... where its bytes lie in the region
	CELL	UNDCL,2		; the length being captured (BC does not survive)
	CELL	UNDLSA,2	; the last record's address (UNDEXT's scratch)
	CELL	UNDPG,2		; PGTOPM when this change was captured
	CELL	UNDPTR,2	; the region's write point, as an OFFSET
	CELL	UNDB1,1		; the byte going in (PRSPAN wants BC)
	CELL	UNDPCU,2	; the cursor as the current command began
	CELL	UNDCUR,2	; ... as the command that made THIS change began
	CELL	UNDLK,1		; the replay: 1 = whole lines put in, 2 = taken
	CELL	UNDLC,1		;   out, 0FFH neither; how many; and LNDLT where
	CELL	UNDLL0,2	;   they start (URLNQ)
	CELL	UNDML,1		; the replay: 0 = every step on one line, no
				;   line end put back or taken (0FFH: no step
				;   yet, 1: not so)
	CELL	UNDL0,2		; ... LNDLT with the cursor on that line
	CELL	LNDLT,2		; (appended) lines the cursor moved since the last
				;   screen layout (signed; SCRN.MAC consumes it)

RSVZN	EQU	RZ-RVSIZE		; bytes ZINIT clears
RSVTOP	EQU	RSVBAS+RZ		; BUF.MAC's PBEGMEM: the arena base

	END
