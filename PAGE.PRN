                                ;============================================================
                                ; TYPE-AHEAD POLL -- WM 6199 (POLLBRK).
                                ;============================================================
                                ;POLLBRK -- WM 6199: drain type-ahead during long operations so keys typed at
                                ;9600 baud are queued, not lost.  WM's CALL GETKEY is KEY.MAC's KBPOLL (the
                                ;ring lives there).  Only WM's non-interruptible path (L26A5 = 0) is kept;
                                ;the ^C 'INTERRUPTED' path (L23E3/CKBRK) belongs to WM's command language.
  099E'                         POLLBRK:			; WM 6199
  099E'   F5                    	PUSH	PSW
  099F'   CD 0000*              	CALL	KBPOLL
  09A2'   F1                    	POP	PSW
  09A3'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the two names and one flag.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;Their order there is the order they had here, and code depends on it.
                                ;The three FCBs, each with its two flag bytes below it, the pager's marks and
                                ;its constants are there.
                                	EXTRN	OUTACT, OUTFCB, OUTTYP, OUTPOS, BAKRDY, BAKFCB
                                	EXTRN	BAKPOS, PGTOPM, OUTREC, OUTHI, SRCREC, BAKREC
                                	EXTRN	INLEN, DSTDRV, NEWFIL, AUXCNT, DIRFLG, WRKMAD
                                	EXTRN	SKREC, SKBYT, TOPLF, CLCNT, TFCB, WRLIM
                                	EXTRN	RDLIM, BUFLO, BUFHI, PGSCAL, PGSCL2, MARGLO
                                	EXTRN	PGMARGN, IOBATCH, PGSCRA, SPLCNT
                                	EXTRN	SAMREC, SAVMOD, SRCFCB, SVFCNT	; deviation 8
                                	EXTRN	SCNFLG, SCNOLD			; (appended) SCNREC
                                
  09A4'   56 49 42 41           BAKNAM:	 DB	 'VIBACKUP$$$'	  ; WM 520 -- BAKFCB name (WM: WMBACKUP$$$)
  09A8'   43 4B 55 50           
  09AC'   24 24 24              
  09AC'                         BAKTYP	EQU	BAKNAM+8	 ; the '$$$' substring (WM BAKTYP EQU 443H)
  09AF'   42 41 4B              BAKEXT: DB	'BAK'		; WM 5245 -- the .BAK rename type
                                
  09B2'   FF                    CPMNEW: DB	0FFH		; nonzero = CP/M 2.x+ (tolerant rename)
                                
                                	END
