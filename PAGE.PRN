                                ;WRSEC -- WM 5646: BDOS write-seq one record from [HL]; return disk status.
  0753'                         WRSEC:				; WM 5646
  0753'   CD 0799'              	CALL	SETRCW
  0756'   CD 0639'              	CALL	BDOSC
  0759'   15                    	DB	15H
  075A'   FE 01                 	CPI	1H
  075C'   C8                    	RZ
  075D'   FE FF                 	CPI	0FFH
  075F'   C8                    	RZ
  0760'   FE 02                 	CPI	2H
  0762'   C9                    	RET
                                
                                ;WRRECP -- WM 5674: poll ^C-break, then WRREC; WRRECA writes then advances.
  0763'                         WRRECP:				; WM 5674
  0763'   CD 07E8'              	CALL	POLLBRK
  0766'                         WRRECA:				; WM 5678
  0766'   CD 070F'              	CALL	WRREC
                                ;RECINC -- WM 5682: FCB random-record number += 1.
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0769'                         RECINC:				; WM 5682
  0769'   C5                    	PUSH	B
  076A'   01 0001               	LXI	B,1H
  076D'   C3 0774'              	JMP	RECADJ
                                ;RECDEC -- WM 5688: FCB random-record number += -1.
