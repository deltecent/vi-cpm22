  0616'   D5                    	PUSH	D
  0617'   11 0080               	LXI	D,80H
  061A'   CD 061F'              	CALL	BDOSC
  061D'   1A                    	DB	1AH
  061E'   D1                    	POP	D
                                ;BDOSC -- WM 5412: BDOS call with the fn number stored inline after the CALL.
  061F'                         BDOSC:				; WM 5412
  061F'   E3                    	XTHL
  0620'   C5                    	PUSH	B
  0621'   4E                    	MOV	C,M
  0622'   23                    	INX	H
  0623'   D5                    	PUSH	D
  0624'   E5                    	PUSH	H
  0625'   CD 0005               	CALL	5H
  0628'   E1                    	POP	H
  0629'   D1                    	POP	D
  062A'   C1                    	POP	B
  062B'   E3                    	XTHL
  062C'   C9                    	RET
                                
                                ;FATAL -- WM 5429 (deviation 2): share ERRMSG's tail.
  062D'                         FATAL:				; WM 5429
  062D'   C3 0000*              	JMP	ERRMSG
                                
                                ;============================================================
                                ; FILE PRIMITIVES -- WM 5436-5566.
                                ;============================================================
                                
                                ;OPENF -- WM 5438: BDOS-open the FCB at DE, then zero its random-record bytes.
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  0630'                         OPENF:				; WM 5438
  0630'   CD 0616'              	CALL	BDOSFN
  0633'   0F                    	DB	0FH
  0634'   3C                    	INR	A
