  02FF'   7E                    	MOV	A,M
  0300'   12                    	STAX	D
  0301'   23                    	INX	H
  0302'   13                    	INX	D
  0303'   0D                    	DCR	C
  0304'   05                    	DCR	B
  0305'   C2 02FF'              	JNZ	STGCPY
  0308'                         STGPAD:				 ; WM 4608 -- pad the rest with ^Z
  0308'   3E 1A                 	MVI	A,EOF
  030A'   12                    	STAX	D
