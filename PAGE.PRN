  0623'   E5                    	PUSH	H
  0624'   21 0023               	LXI	H,23H
  0627'   19                    	DAD	D
  0628'   36 00                 	MVI	M,0H
  062A'   2B                    	DCX	H
  062B'   36 00                 	MVI	M,0H
  062D'   E1                    	POP	H
  062E'   C9                    	RET
                                
                                ;CLSBAK/CLOSEC -- WM 5455/5459: close the FCB at DE if its open flag is set.
  062F'                         CLSBAK:				; WM 5455
  062F'   11 07EA'              	LXI	D,BAKFCB
  0632'                         CLOSEC:				; WM 5459
  0632'   1B                    	DCX	D
  0633'   1B                    	DCX	D
  0634'   1A                    	LDAX	D
  0635'   13                    	INX	D
  0636'   13                    	INX	D
  0637'   B7                    	ORA	A
  0638'   C8                    	RZ
                                ;CLOSEF -- WM 5469: BDOS-close the file; FATAL 'CLOSE ERR' on failure.
  0639'                         CLOSEF:				; WM 5469
  0639'   CD 0604'              	CALL	BDOSFN
  063C'   10                    	DB	10H
  063D'   3C                    	INR	A
  063E'   C0                    	RNZ
  063F'   CD 061B'              	CALL	FATAL
  0642'   43 4C 4F 53           	DB	'CLOSE ERR',0H
  0646'   45 20 45 52           
  064A'   52 00                 
                                
                                ;KILLBAK -- WM 5478: close then delete VIBACKUP$$$ (BAKFCB).
  064C'                         KILLBAK:			; WM 5478
  064C'   11 07EA'              	LXI	D,BAKFCB
  064F'   CD 0632'              	CALL	CLOSEC
                                ;DELF -- WM 5483: BDOS-delete the file named by the FCB at DE.
