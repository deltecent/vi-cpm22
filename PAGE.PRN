                                ;WRMAKE -- DEVIATION 9: DELRST (make the file afresh), keeping the record
                                ;number DELRST zeroes: with deviation 8 the first record written need not
                                ;be record 0.  Keeps every register but A.
  0924'                         WRMAKE:
  0924'   E5                    	PUSH	H
  0925'   21 0022               	LXI	H,22H
  0928'   19                    	DAD	D
  0929'   E5                    	PUSH	H
  092A'   CD 0000*              	CALL	LDHLI
