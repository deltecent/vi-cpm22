                                ;RENAME -- WM 5534: rename the file on the FCB at DE to the 3-byte type at HL.
  0879'                         RENAME:				; WM 5534
  0879'   C5                    	PUSH	B
  087A'   D5                    	PUSH	D
  087B'   E5                    	PUSH	H
  087C'   D5                    	PUSH	D
  087D'   21 0010               	LXI	H,10H
  0880'   19                    	DAD	D
  0881'   01 0010               	LXI	B,10H
  0884'   EB                    	XCHG
  0885'   CD 0000*              	CALL	MEMCPY
  0888'   36 00                 	MVI	M,0H
  088A'   D1                    	POP	D
