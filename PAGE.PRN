  03DB'                         MOREIN:				; WM 4743
  03DB'   3A 0857'              	LDA	DIRFLG
  03DE'   B7                    	ORA	A
  03DF'   3A 07EF'              	LDA	OUTACT
  03E2'   F4 03D0'              	CP	INRDY
  03E5'   B7                    	ORA	A
  03E6'   C9                    	RET
                                
