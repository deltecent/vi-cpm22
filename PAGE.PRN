                                ;SETRCW/SETREC -- WM 5723/5733: prepare an FCB (DE) for the next record I/O.
  0980'                         SETRCW:			       ; WM 5723
  0980'   3E FF                 	MVI	A,0FFH
  0982'                         SETREC:				; WM 5733
  0982'   C5                    	PUSH	B
  0983'   47                    	MOV	B,A
  0984'   E5                    	PUSH	H
  0985'   21 0022               	LXI	H,22H
  0988'   19                    	DAD	D
  0989'   CD 0000*              	CALL	LDHLI
  098C'   7D                    	MOV	A,L
  098D'   E6 7F                 	ANI	7FH
  098F'   4F                    	MOV	C,A
  0990'   29                    	DAD	H
  0991'   7C                    	MOV	A,H
  0992'   21 000C               	LXI	H,0CH
  0995'   19                    	DAD	D
  0996'   BE                    	CMP	M
  0997'   CA 09BB'              	JZ	SETRCR
  099A'   E5                    	PUSH	H
  099B'   F5                    	PUSH	PSW
  099C'   21 0021               	LXI	H,21H
  099F'   19                    	DAD	D
  09A0'   7E                    	MOV	A,M
  09A1'   B7                    	ORA	A
  09A2'   C4 0836'              	CNZ	CLOSEF
  09A5'   36 00                 	MVI	M,0H
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  09A7'   F1                    	POP	PSW
  09A8'   E1                    	POP	H
  09A9'   77                    	MOV	M,A
  09AA'   CD 0801'              	CALL	BDOSFN
  09AD'   0F                    	DB	0FH
  09AE'   3C                    	INR	A
  09AF'   C2 09BB'              	JNZ	SETRCR
  09B2'   78                    	MOV	A,B
  09B3'   B7                    	ORA	A
  09B4'   37                    	STC
  09B5'   CA 09C4'              	JZ	SETDMA
  09B8'   CD 0861'              	CALL	MAKEF
  09BB'                         SETRCR:				; WM 5771 -- extent already open: set CR + DMA
  09BB'   21 0020               	LXI	H,20H
  09BE'   19                    	DAD	D
  09BF'   71                    	MOV	M,C
  09C0'   23                    	INX	H
  09C1'   7E                    	MOV	A,M
  09C2'   B0                    	ORA	B
  09C3'   77                    	MOV	M,A
  09C4'                         SETDMA:				 ; WM 5780 -- set the DMA address (BDOS 1A)
  09C4'   E1                    	POP	H
  09C5'   F5                    	PUSH	PSW
  09C6'   EB                    	XCHG
  09C7'   CD 080A'              	CALL	BDOSC
  09CA'   1A                    	DB	1AH
  09CB'   EB                    	XCHG
  09CC'   F1                    	POP	PSW
  09CD'   C1                    	POP	B
  09CE'   C9                    	RET
                                
                                ;============================================================
                                ; TYPE-AHEAD POLL -- WM 6199 (POLLBRK).
                                ;============================================================
                                ;POLLBRK -- WM 6199: drain type-ahead during long operations so keys typed at
                                ;9600 baud are queued, not lost.  WM's CALL GETKEY is KEY.MAC's KBPOLL (the
                                ;ring lives there).  Only WM's non-interruptible path (L26A5 = 0) is kept;
                                ;the ^C 'INTERRUPTED' path (L23E3/CKBRK) belongs to WM's command language.
  09CF'                         POLLBRK:			; WM 6199
  09CF'   F5                    	PUSH	PSW
  09D0'   CD 0000*              	CALL	KBPOLL
  09D3'   F1                    	POP	PSW
  09D4'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the two names and one flag.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;The three FCBs, each with its two flag bytes below it, the pager's marks and
                                ;its constants are there.
                                	EXTRN	OUTACT, OUTFCB, OUTTYP, OUTPOS, BAKRDY, BAKFCB
                                	EXTRN	BAKPOS, PGTOPM, OUTREC, OUTHI, SRCREC, BAKREC
                                	EXTRN	INLEN, DSTDRV, NEWFIL, AUXCNT, DIRFLG, WRKMAD
                                	EXTRN	SKREC, SKBYT, TOPLF, CLCNT, TFCB, WRLIM
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                	EXTRN	RDLIM, BUFLO, BUFHI, PGSCAL, PGSCL2, MARGLO
                                	EXTRN	PGMARGN, IOBATCH, PGSCRA, SPLCNT
                                	EXTRN	SAMREC, SAVMOD, SRCFCB, SVFCNT	; deviation 8
                                	EXTRN	SCNFLG, SCNOLD			; (appended) SCNREC
                                
  09D5'   56 49 42 41           BAKNAM:	 DB	 'VIBACKUP$$$'	  ; WM 520 -- BAKFCB name (WM: WMBACKUP$$$)
  09D9'   43 4B 55 50           
  09DD'   24 24 24              
  09DD'                         BAKTYP	EQU	BAKNAM+8	 ; the '$$$' substring (WM BAKTYP EQU 443H)
  09E0'   42 41 4B              BAKEXT: DB	'BAK'		; WM 5245 -- the .BAK rename type
                                
  09E3'   FF                    CPMNEW: DB	0FFH		; nonzero = CP/M 2.x+ (tolerant rename)
                                
                                	END
