  0367'                         FILRLP:				 ; WM 4671 -- read & clean one input record
  0367'   CD 0382'              	CALL	RDIN
  036A'   D4 039B'              	CNC	CLNSEC
  036D'   D2 0374'              	JNC	FILRSV		; DEVIATION (WM bug): WM is JC L1C6B, which
  0370'   B7                    	ORA	A		;   skips the store for a full record (CY,
  0371'   CA 0377'              	JZ	FILRST		;   A=80H), so a file ending on a record
  0374'   32 0000*              FILRSV: STA	INLEN		;   boundary w/o ^Z leaves INLEN=0 and PAGEBOT
                                				;   RECDECs one record too far (record saved
                                				;   twice).  Skip only RDIN's no-record case
                                				;   (CY, A=0).
  0377'                         FILRST:				 ; WM 4677
  0377'   22 0000*              	SHLD	TXTEND
  037A'   0D                    	DCR	C
  037B'   C2 0367'              	JNZ	FILRLP
  037E'   B7                    	ORA	A
  037F'                         FILRET:				 ; WM 4683
  037F'   C3 0000*              	JMP	POPRET
                                
                                ;RDIN -- WM 4689: read the next input record into [HL] (backup then source).
  0382'                         RDIN:				; WM 4689
