  02F5'   11 0000*              	LXI	D,SECBUF
  02F8'   D5                    	PUSH	D
  02F9'   47                    	MOV	B,A
  02FA'   0E 82                 	MVI	C,82H
  02FC'   04                    	INR	B
  02FD'   2B                    	DCX	H
  02FE'   1B                    	DCX	D
