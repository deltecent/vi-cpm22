  0793'   12                    	STAX	D
  0794'   37                    	STC
  0795'   E1                    	POP	H
  0796'   C3 0000*              	JMP	POPRET
                                
                                ;SETRCW/SETREC -- WM 5723/5733: prepare an FCB (DE) for the next record I/O.
  0799'                         SETRCW:			       ; WM 5723
