  0745'   C8                    	RZ
  0746'   FE 02                 	CPI	2H
  0748'   C9                    	RET
                                
                                ;WRRECP -- WM 5674: poll ^C-break, then WRREC; WRRECA writes then advances.
  0749'                         WRRECP:				; WM 5674
  0749'   CD 07CE'              	CALL	POLLBRK
  074C'                         WRRECA:				; WM 5678
  074C'   CD 06F5'              	CALL	WRREC
                                ;RECINC -- WM 5682: FCB random-record number += 1.
  074F'                         RECINC:				; WM 5682
  074F'   C5                    	PUSH	B
  0750'   01 0001               	LXI	B,1H
  0753'   C3 075A'              	JMP	RECADJ
                                ;RECDEC -- WM 5688: FCB random-record number += -1.
  0756'                         RECDEC:				; WM 5688
  0756'   C5                    	PUSH	B
  0757'   01 FFFF               	LXI	B,0FFFFH
  075A'                         RECADJ:				 ; WM 5692 -- adjust FCB+22/23 by BC
  075A'   D5                    	PUSH	D
  075B'   E5                    	PUSH	H
  075C'   1B                    	DCX	D
  075D'   3E FF                 	MVI	A,0FFH
  075F'   12                    	STAX	D
  0760'   21 0023               	LXI	H,23H
  0763'   19                    	DAD	D
  0764'   E5                    	PUSH	H
  0765'   CD 0000*              	CALL	LDHLI
  0768'   09                    	DAD	B
  0769'   7C                    	MOV	A,H
  076A'   A5                    	ANA	L
  076B'   3C                    	INR	A
