                                ;FLUSHTX -- WM 4471: collapse the gap and PAGEOUT every remaining sector.
  02D5'                         FLUSHTX:			; WM 4471
  02D5'   C5                    	PUSH	B
  02D6'   D5                    	PUSH	D
  02D7'   E5                    	PUSH	H
  02D8'   21 0081               	LXI	H,81H
  02DB'   22 0000*              	SHLD	WRLIM
  02DE'   21 0000*              	LXI	H,BUFEND
  02E1'   CD 0000*              	CALL	PUTHOLE
  02E4'   2A 0000*              	LHLD	TXTEND
  02E7'   CD 0000*              	CALL	PUTCUR
