  0612'   E5                    	PUSH	H
  0613'   CD 0005               	CALL	5H
  0616'   E1                    	POP	H
  0617'   D1                    	POP	D
  0618'   C1                    	POP	B
  0619'   E3                    	XTHL
  061A'   C9                    	RET
                                
                                ;FATAL -- WM 5429 (deviation 2): share ERRMSG's tail.
  061B'                         FATAL:				; WM 5429
  061B'   C3 0000*              	JMP	ERRMSG
                                
