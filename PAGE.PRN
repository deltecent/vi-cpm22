                                ;============================================================
                                ; TYPE-AHEAD POLL -- WM 6199 (POLLBRK).
                                ;============================================================
                                ;POLLBRK -- WM 6199: drain type-ahead during long operations so keys typed at
                                ;9600 baud are queued, not lost.  WM's CALL GETKEY is KEY.MAC's KBPOLL (the
                                ;ring lives there).  Only WM's non-interruptible path (L26A5 = 0) is kept;
                                ;the ^C 'INTERRUPTED' path (L23E3/CKBRK) belongs to WM's command language.
  07A9'                         POLLBRK:			; WM 6199
  07A9'   F5                    	PUSH	PSW
  07AA'   CD 0000*              	CALL	KBPOLL
  07AD'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  07AE'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- FCBs, sector buffer, pager marks and constants.
                                ; The disassembly renders these cells as aliased code bytes; only their layout
                                ; is authoritative.  OPENFIL sets the live ones at run time.  Each FCB is
                                ; preceded by two flag bytes: [FCB-2] = WRREC/CLOSEC per-file open flag,
                                ; [FCB-1] = the file's has-data flag (WM layout: OUTACT before OUTFCB, BAKRDY
                                ; before BAKFCB; source uses 005BH before the CCP FCB at 005CH).
                                ;============================================================
                                ;WM's marks OUTPOS (0x26CD) and BAKPOS (0x26F3) are NOT separate cells -- the
                                ;authoritative wm_map.py addresses show they ARE FCB random-record fields:
                                ;OUTPOS = OUTFCB(0x26AB)+22H and BAKPOS = BAKFCB(0x26D1)+22H.  They advance with
                                ;the file automatically: RECINC/RECDEC/WRRECP step FCB+22H, so OUTPOS is OUTFCB's
                                ;current write position and PAGEOUT's "OUTREC vs OUTPOS" compare skips exactly the
                                ;records REWIND already pulled back.  A separate static cell would never
                                ;advance, and the save would stop after its first record.
  07AF'   00                    	DB	0		; OUTFCB-2 : WRREC/CLOSEC open flag
  07B0'   00                    OUTACT:	 DB	 0		 ; OUTFCB-1 : out-side active flag
  07B1'                         OUTFCB: DS	36		; output file (name.$$$)
  07BA'                         OUTTYP	EQU	OUTFCB+9	; OUTFCB type field ('$$$' / briefly 'BAK')
  07D3'                         OUTPOS	 EQU	 OUTFCB+22H	 ; OUTFCB random-record word (write position)
                                
  07D5'   00                    	DB	0		; BAKFCB-2 : WRREC/CLOSEC open flag
  07D6'   00                    BAKRDY: DB	0		; BAKFCB-1 : backup-has-data flag
  07D7'                         BAKFCB: DS	36		; backup file (VIBACKUP$$$)
  07F9'                         BAKPOS	 EQU	 BAKFCB+22H	 ; BAKFCB random-record word (RECBASE input base)
                                
  07FB'   56 49 42 41           BAKNAM:	 DB	 'VIBACKUP$$$'	  ; WM 520 -- BAKFCB name (WM: WMBACKUP$$$)
  07FF'   43 4B 55 50           
  0803'   24 24 24              
  0803'                         BAKTYP	EQU	BAKNAM+8	 ; the '$$$' substring (WM BAKTYP EQU 443H)
  0806'   42 41 4B              BAKEXT: DB	'BAK'		; WM 5245 -- the .BAK rename type
                                
  0809'   0000                  PGTOPM: DW	0		; (appended) times the pager moved TXTBEG --
                                				;   the window signature 'u' checks (see BUF.MAC)
  080B'   0000                  OUTREC: DW	0		; output write high-water (record)
  080D'   0000                  SRCREC: DW	0		; source read low-water (record)
  080F'   0000                  BAKREC: DW	0		; backup read low-water (record)
  0811'   00                    INLEN:	DB	0		; last input record byte count
  0812'   00                    DSTDRV: DB	0		; nonzero if output is on a different drive
  0813'   00                    NEWFIL: DB	0		; nonzero if the source did not exist
  0814'   0000                  AUXCNT: DW	0		; WM L271E -- must follow NEWFIL: GOLINE's
                                				;   LHLD NEWFIL / DAD H tests its low byte
  0816'   00                    DIRFLG: DB	0		; scroll/search direction (neg = backward)
  0817'   FF                    CPMNEW: DB	0FFH		; nonzero = CP/M 2.x+ (tolerant rename)
                                
                                ;--- APPENDED (NOT WordMaster).  Kept clear of NEWFIL/AUXCNT: GOLINE reads the
                                ;    byte after NEWFIL as AUXCNT's low byte.
  0818'   00                    WRKMAD: DB	0		; a work record has been written, so name.$$$ /
                                				;   VIBACKUP$$$ may exist (DISCRD tests it)
  0819'   0000                  SKREC:	DW	0		; SEEKTO: target record (APPENDED, not WM)
  081B'   00                    SKBYT:	DB	0		; SEEKTO: target byte in that record
  081C'   0000                  CLREC:	DW	0		; CNTLF: OUTPOS on entry
  081E'   0000                  CLCNT:	DW	0		; CNTLF: line feeds counted
  0820'   00                    	DB	0		; TFCB-2 : WRREC/CLOSEC open flag (DELF clears)
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  0821'   00                    	DB	0		; TFCB-1
  0822'                         TFCB:	DS	36		; WRTO / TEXIST: the target file
                                
  0846'   0000                  WRLIM:	DW	0		; PAGEOUT write limit (set to PGINIT / 81H)
  0848'   0000                  RDLIM:	DW	0		; PAGEBOT read limit (set to PGINIT)
  084A'   0000                  BUFLO:	DW	0		; buffer low-water reserve (PGCONST)
  084C'   0000                  BUFHI:	DW	0		; buffer high-water fill target (PGCONST)
  084E'   00                    PGSCAL:DB      0	       ; memory-scaled batch count (PGCONST)
  084F'   00                    PGSCL2:DB      0	       ; = PGSCAL*2 (SPILL arithmetic)
  0850'   00                    MARGLO: DB	0		; WM 272F: fixed 0 low byte so LHLD MARGLO = PGMARGN*256
  0851'   00                    PGMARGN:DB	0		; paging low-water margin in pages
  0852'   00                    IOBATCH:DB	0		; records per read-ahead / write-behind batch
  0853'   00                    PGSCRA:	 DB	 0		 ; (PGCONST scratch; nothing reads it)
  0854'   00                    SPLCNT:	 DB	 0		 ; SPILL batch counter
                                
                                	END
