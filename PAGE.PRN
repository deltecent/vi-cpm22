  090A'   C0                    	RNZ
  090B'   F5                    	PUSH	PSW
  090C'   E5                    	PUSH	H
  090D'   21 0000*              	LXI	H,BAKFCB
  0910'   CD 0000*              	CALL	CMP16
  0913'   E1                    	POP	H
  0914'   CA 0926'              	JZ	DSKFUL
  0917'   3A 0000*              	LDA	BAKRDY
  091A'   B7                    	ORA	A
  091B'   D5                    	PUSH	D
  091C'   CC 085E'              	CZ	KILLBAK
  091F'   D1                    	POP	D
  0920'   F1                    	POP	PSW
  0921'   CD 094F'              	CALL	WRSEC
  0924'   C0                    	RNZ
  0925'   F5                    	PUSH	PSW
