  03EF'   CD 0000*              	CALL	BUFSUM
  03F2'   CD 0000*              	CALL	CMP16
  03F5'   E1                    	POP	H
  03F6'   DC 0431'              	CC	DISPKEY
  03F9'   2A 088B'              	LHLD	BUFLO
  03FC'   29                    	DAD	H
  03FD'   24                    	INR	H
  03FE'   24                    	INR	H
  03FF'   EB                    	XCHG
  0400'   E1                    	POP	H
