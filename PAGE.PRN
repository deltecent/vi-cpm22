  0772'   23                    	INX	H
  0773'   72                    	MOV	M,D
  0774'   B7                    	ORA	A
  0775'   C3 0000*              	JMP	POPRET
  0778'                         RECWRP:				 ; WM 5715 -- wrapped / overflow: flag EOF
  0778'   AF                    	XRA	A
  0779'   12                    	STAX	D
  077A'   37                    	STC
  077B'   E1                    	POP	H
  077C'   C3 0000*              	JMP	POPRET
                                
                                ;SETRCW/SETREC -- WM 5723/5733: prepare an FCB (DE) for the next record I/O.
  077F'                         SETRCW:			       ; WM 5723
  077F'   3E FF                 	MVI	A,0FFH
  0781'                         SETREC:				; WM 5733
  0781'   C5                    	PUSH	B
  0782'   47                    	MOV	B,A
  0783'   E5                    	PUSH	H
  0784'   21 0022               	LXI	H,22H
  0787'   19                    	DAD	D
