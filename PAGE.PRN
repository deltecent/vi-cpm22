  039D'   7E                    	MOV	A,M
  039E'   E6 7F                 	ANI	7FH
  03A0'   77                    	MOV	M,A
  03A1'   FE 1A                 	CPI	EOF
  03A3'   CA 03AF'              	JZ	CLNEOF
