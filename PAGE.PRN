  0824'   19                    	DAD	D
  0825'   36 00                 	MVI	M,0H
  0827'   2B                    	DCX	H
  0828'   36 00                 	MVI	M,0H
  082A'   E1                    	POP	H
  082B'   C9                    	RET
                                
                                ;CLSBAK/CLOSEC -- WM 5455/5459: close the FCB at DE if its open flag is set.
  082C'                         CLSBAK:				; WM 5455
  082C'   11 0000*              	LXI	D,BAKFCB
  082F'                         CLOSEC:				; WM 5459
  082F'   1B                    	DCX	D
  0830'   1B                    	DCX	D
  0831'   1A                    	LDAX	D
  0832'   13                    	INX	D
  0833'   13                    	INX	D
  0834'   B7                    	ORA	A
  0835'   C8                    	RZ
                                ;CLOSEF -- WM 5469: BDOS-close the file; FATAL 'CLOSE ERR' on failure.
  0836'                         CLOSEF:				; WM 5469
  0836'   CD 0801'              	CALL	BDOSFN
  0839'   10                    	DB	10H
  083A'   3C                    	INR	A
  083B'   C0                    	RNZ
  083C'   CD 0818'              	CALL	FATAL
  083F'   43 4C 4F 53           	DB	'CLOSE ERR',0H
  0843'   45 20 45 52           
  0847'   52 00                 
                                
                                ;KILLBAK -- WM 5478: close then delete VIBACKUP$$$ (BAKFCB).
  0849'                         KILLBAK:			; WM 5478
  0849'   11 0000*              	LXI	D,BAKFCB
  084C'   CD 082F'              	CALL	CLOSEC
                                ;DELF -- WM 5483: BDOS-delete the file named by the FCB at DE.
  084F'                         DELF:				; WM 5483
  084F'   CD 0801'              	CALL	BDOSFN
  0852'   13                    	DB	13H
  0853'   1B                    	DCX	D
  0854'   CD 08DA'              	CALL	IOEOF
  0857'   13                    	INX	D
  0858'   C3 08DA'              	JMP	IOEOF
                                
                                ;DELRST -- WM 5492: delete the FCB's file, then ZERORR (prep a fresh file).
