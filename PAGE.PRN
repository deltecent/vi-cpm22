                                ;WRMAKE -- DEVIATION 9: DELRST (make the file afresh), keeping the record
                                ;number DELRST zeroes: with deviation 8 the first record written need not
                                ;be record 0.  Keeps every register but A.
  0939'                         WRMAKE:
  0939'   E5                    	PUSH	H
  093A'   21 0022               	LXI	H,22H
  093D'   19                    	DAD	D
  093E'   E5                    	PUSH	H
  093F'   CD 0000*              	CALL	LDHLI
  0942'   E3                    	XTHL			; [SP] = the record, HL = where it goes
  0943'   CD 0870'              	CALL	DELRST
  0946'   E3                    	XTHL
  0947'   EB                    	XCHG			; DE = the record, HL = the FCB
  0948'   E3                    	XTHL
  0949'   73                    	MOV	M,E
  094A'   23                    	INX	H
  094B'   72                    	MOV	M,D
  094C'   D1                    	POP	D
  094D'   E1                    	POP	H
  094E'   C9                    	RET
                                
                                ;WRSEC -- WM 5646: BDOS write-seq one record from [HL]; return disk status.
  094F'                         WRSEC:				; WM 5646
  094F'   CD 0995'              	CALL	SETRCW
  0952'   CD 081F'              	CALL	BDOSC
  0955'   15                    	DB	15H
  0956'   FE 01                 	CPI	1H
  0958'   C8                    	RZ
  0959'   FE FF                 	CPI	0FFH
  095B'   C8                    	RZ
  095C'   FE 02                 	CPI	2H
