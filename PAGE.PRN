  095F'   CD 09E4'              	CALL	POLLBRK
  0962'                         WRRECA:				; WM 5678
  0962'   CD 08F5'              	CALL	WRREC
                                ;RECINC -- WM 5682: FCB random-record number += 1.
  0965'                         RECINC:				; WM 5682
  0965'   C5                    	PUSH	B
  0966'   01 0001               	LXI	B,1H
  0969'   C3 0970'              	JMP	RECADJ
                                ;RECDEC -- WM 5688: FCB random-record number += -1.
  096C'                         RECDEC:				; WM 5688
  096C'   C5                    	PUSH	B
  096D'   01 FFFF               	LXI	B,0FFFFH
  0970'                         RECADJ:				 ; WM 5692 -- adjust FCB+22/23 by BC
  0970'   D5                    	PUSH	D
  0971'   E5                    	PUSH	H
  0972'   1B                    	DCX	D
  0973'   3E FF                 	MVI	A,0FFH
  0975'   12                    	STAX	D
  0976'   21 0023               	LXI	H,23H
  0979'   19                    	DAD	D
  097A'   E5                    	PUSH	H
  097B'   CD 0000*              	CALL	LDHLI
  097E'   09                    	DAD	B
  097F'   7C                    	MOV	A,H
  0980'   A5                    	ANA	L
  0981'   3C                    	INR	A
  0982'   CA 098E'              	JZ	RECWRP
  0985'   EB                    	XCHG
  0986'   E1                    	POP	H
  0987'   73                    	MOV	M,E
  0988'   23                    	INX	H
  0989'   72                    	MOV	M,D
  098A'   B7                    	ORA	A
  098B'   C3 0000*              	JMP	POPRET
  098E'                         RECWRP:				 ; WM 5715 -- wrapped / overflow: flag EOF
  098E'   AF                    	XRA	A
  098F'   12                    	STAX	D
  0990'   37                    	STC
  0991'   E1                    	POP	H
  0992'   C3 0000*              	JMP	POPRET
                                
                                ;SETRCW/SETREC -- WM 5723/5733: prepare an FCB (DE) for the next record I/O.
  0995'                         SETRCW:			       ; WM 5723
  0995'   3E FF                 	MVI	A,0FFH
  0997'                         SETREC:				; WM 5733
  0997'   C5                    	PUSH	B
  0998'   47                    	MOV	B,A
  0999'   E5                    	PUSH	H
  099A'   21 0022               	LXI	H,22H
  099D'   19                    	DAD	D
  099E'   CD 0000*              	CALL	LDHLI
  09A1'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  09A2'   E6 7F                 	ANI	7FH
  09A4'   4F                    	MOV	C,A
  09A5'   29                    	DAD	H
  09A6'   7C                    	MOV	A,H
  09A7'   21 000C               	LXI	H,0CH
  09AA'   19                    	DAD	D
  09AB'   BE                    	CMP	M
  09AC'   CA 09D0'              	JZ	SETRCR
  09AF'   E5                    	PUSH	H
  09B0'   F5                    	PUSH	PSW
  09B1'   21 0021               	LXI	H,21H
  09B4'   19                    	DAD	D
  09B5'   7E                    	MOV	A,M
  09B6'   B7                    	ORA	A
  09B7'   C4 084B'              	CNZ	CLOSEF
  09BA'   36 00                 	MVI	M,0H
  09BC'   F1                    	POP	PSW
  09BD'   E1                    	POP	H
  09BE'   77                    	MOV	M,A
  09BF'   CD 0816'              	CALL	BDOSFN
  09C2'   0F                    	DB	0FH
  09C3'   3C                    	INR	A
  09C4'   C2 09D0'              	JNZ	SETRCR
  09C7'   78                    	MOV	A,B
  09C8'   B7                    	ORA	A
  09C9'   37                    	STC
  09CA'   CA 09D9'              	JZ	SETDMA
  09CD'   CD 0876'              	CALL	MAKEF
  09D0'                         SETRCR:				; WM 5771 -- extent already open: set CR + DMA
  09D0'   21 0020               	LXI	H,20H
  09D3'   19                    	DAD	D
  09D4'   71                    	MOV	M,C
  09D5'   23                    	INX	H
  09D6'   7E                    	MOV	A,M
  09D7'   B0                    	ORA	B
  09D8'   77                    	MOV	M,A
  09D9'                         SETDMA:				 ; WM 5780 -- set the DMA address (BDOS 1A)
  09D9'   E1                    	POP	H
  09DA'   F5                    	PUSH	PSW
  09DB'   EB                    	XCHG
  09DC'   CD 081F'              	CALL	BDOSC
  09DF'   1A                    	DB	1AH
  09E0'   EB                    	XCHG
  09E1'   F1                    	POP	PSW
  09E2'   C1                    	POP	B
  09E3'   C9                    	RET
                                
                                ;============================================================
                                ; TYPE-AHEAD POLL -- WM 6199 (POLLBRK).
                                ;============================================================
                                ;POLLBRK -- WM 6199: drain type-ahead during long operations so keys typed at
                                ;9600 baud are queued, not lost.  WM's CALL GETKEY is KEY.MAC's KBPOLL (the
                                ;ring lives there).  Only WM's non-interruptible path (L26A5 = 0) is kept;
                                ;the ^C 'INTERRUPTED' path (L23E3/CKBRK) belongs to WM's command language.
  09E4'                         POLLBRK:			; WM 6199
  09E4'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09E5'   CD 0000*              	CALL	KBPOLL
  09E8'   F1                    	POP	PSW
  09E9'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the two names and one flag.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;The three FCBs, each with its two flag bytes below it, the pager's marks and
                                ;its constants are there.
                                	EXTRN	OUTACT, OUTFCB, OUTTYP, OUTPOS, BAKRDY, BAKFCB
                                	EXTRN	BAKPOS, PGTOPM, OUTREC, OUTHI, SRCREC, BAKREC
                                	EXTRN	INLEN, DSTDRV, NEWFIL, AUXCNT, DIRFLG, WRKMAD
                                	EXTRN	SKREC, SKBYT, TOPLF, CLCNT, TFCB, WRLIM
                                	EXTRN	RDLIM, BUFLO, BUFHI, PGSCAL, PGSCL2, MARGLO
                                	EXTRN	PGMARGN, IOBATCH, PGSCRA, SPLCNT
                                	EXTRN	SAMREC, SAVMOD, SRCFCB, SVFCNT	; deviation 8
                                	EXTRN	SCNFLG, SCNOLD			; (appended) SCNREC
                                
  09EA'   56 49 42 41           BAKNAM:	 DB	 'VIBACKUP$$$'	  ; WM 520 -- BAKFCB name (WM: WMBACKUP$$$)
  09EE'   43 4B 55 50           
  09F2'   24 24 24              
  09F2'                         BAKTYP	EQU	BAKNAM+8	 ; the '$$$' substring (WM BAKTYP EQU 443H)
  09F5'   42 41 4B              BAKEXT: DB	'BAK'		; WM 5245 -- the .BAK rename type
                                
  09F8'   FF                    CPMNEW: DB	0FFH		; nonzero = CP/M 2.x+ (tolerant rename)
                                
                                	END
