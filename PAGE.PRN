  052C'   2B                    	DCX	H
  052D'   22 080F'              	SHLD	BAKREC
  0530'   E1                    	POP	H
  0531'   04                    	INR	B
  0532'                         PBFIN:				; WM 4578 -- store new TXTEND; note input remaining
  0532'   CD 03AB'              	CALL	INRDY
  0535'   B7                    	ORA	A
  0536'   E1                    	POP	H
  0537'   22 0000*              	SHLD	TXTEND
