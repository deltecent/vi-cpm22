  0938'   E1                    	POP	H
  0939'   C9                    	RET
                                
                                ;WRSEC -- WM 5646: BDOS write-seq one record from [HL]; return disk status.
  093A'                         WRSEC:				; WM 5646
  093A'   CD 0980'              	CALL	SETRCW
  093D'   CD 080A'              	CALL	BDOSC
  0940'   15                    	DB	15H
  0941'   FE 01                 	CPI	1H
  0943'   C8                    	RZ
  0944'   FE FF                 	CPI	0FFH
  0946'   C8                    	RZ
  0947'   FE 02                 	CPI	2H
  0949'   C9                    	RET
                                
                                ;WRRECP -- WM 5674: poll ^C-break, then WRREC; WRRECA writes then advances.
