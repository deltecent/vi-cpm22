  079B'                         SETREC:				; WM 5733
  079B'   C5                    	PUSH	B
  079C'   47                    	MOV	B,A
  079D'   E5                    	PUSH	H
  079E'   21 0022               	LXI	H,22H
  07A1'   19                    	DAD	D
  07A2'   CD 0000*              	CALL	LDHLI
