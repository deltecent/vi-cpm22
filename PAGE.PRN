  0635'   E5                    	PUSH	H
  0636'   21 0023               	LXI	H,23H
  0639'   19                    	DAD	D
  063A'   36 00                 	MVI	M,0H
  063C'   2B                    	DCX	H
  063D'   36 00                 	MVI	M,0H
  063F'   E1                    	POP	H
  0640'   C9                    	RET
                                
                                ;CLSBAK/CLOSEC -- WM 5455/5459: close the FCB at DE if its open flag is set.
  0641'                         CLSBAK:				; WM 5455
  0641'   11 0000*              	LXI	D,BAKFCB
  0644'                         CLOSEC:				; WM 5459
  0644'   1B                    	DCX	D
  0645'   1B                    	DCX	D
  0646'   1A                    	LDAX	D
  0647'   13                    	INX	D
  0648'   13                    	INX	D
  0649'   B7                    	ORA	A
  064A'   C8                    	RZ
                                ;CLOSEF -- WM 5469: BDOS-close the file; FATAL 'CLOSE ERR' on failure.
  064B'                         CLOSEF:				; WM 5469
  064B'   CD 0616'              	CALL	BDOSFN
  064E'   10                    	DB	10H
  064F'   3C                    	INR	A
  0650'   C0                    	RNZ
