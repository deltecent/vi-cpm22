                                ;RESVBF0/RESVBUF -- WM 4786/4790: reserve free buffer space up to BUFHI.
  03CD'                         RESVBF0:			; WM 4786
  03CD'   11 0254'              	LXI	D,SPILL
  03D0'                         RESVBUF:			; WM 4790
  03D0'   E5                    	PUSH	H
  03D1'   2A 0000*              	LHLD	BUFHI
  03D4'   D5                    	PUSH	D
