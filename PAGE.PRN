  0361'   CD 03D0'              	CALL	INRDY
  0364'   CA 0399'              	JZ	FILRET
  0367'   79                    	MOV	A,C
  0368'   B7                    	ORA	A
  0369'   C2 037E'              	JNZ	FILLRD
  036C'   C3 0000*              	JMP	POPRET
                                
                                ;FILLBUF -- WM 4659: top the window up from the input file(s).
  036F'                         FILLBUF:			; WM 4659
  036F'   C5                    	PUSH	B
  0370'   D5                    	PUSH	D
  0371'   E5                    	PUSH	H
  0372'   CD 03D0'              	CALL	INRDY
  0375'   CA 0399'              	JZ	FILRET
  0378'   21 0000*              	LXI	H,BUFEND
  037B'   CD 03E7'              	CALL	RESVBF0
  037E'                         FILLRD:				 ; WM 4668
  037E'   2A 0000*              	LHLD	TXTEND
  0381'                         FILRLP:				 ; WM 4671 -- read & clean one input record
  0381'   CD 039C'              	CALL	RDIN
  0384'   D4 03B5'              	CNC	CLNSEC
  0387'   D2 038E'              	JNC	FILRSV		; DEVIATION (WM bug): WM is JC L1C6B, which
  038A'   B7                    	ORA	A		;   skips the store for a full record (CY,
  038B'   CA 0391'              	JZ	FILRST		;   A=80H), so a file ending on a record
  038E'   32 0852'              FILRSV: STA	INLEN		;   boundary w/o ^Z leaves INLEN=0 and PAGEBOT
                                				;   RECDECs one record too far (record saved
                                				;   twice).  Skip only RDIN's no-record case
                                				;   (CY, A=0).
  0391'                         FILRST:				 ; WM 4677
  0391'   22 0000*              	SHLD	TXTEND
  0394'   0D                    	DCR	C
  0395'   C2 0381'              	JNZ	FILRLP
  0398'   B7                    	ORA	A
  0399'                         FILRET:				 ; WM 4683
  0399'   C3 0000*              	JMP	POPRET
                                
                                ;RDIN -- WM 4689: read the next input record into [HL] (backup then source).
  039C'                         RDIN:				; WM 4689
  039C'   CD 07E8'              	CALL	POLLBRK
  039F'   11 0815'              	LXI	D,BAKRDY
  03A2'   1A                    	LDAX	D
  03A3'   13                    	INX	D
  03A4'   B7                    	ORA	A
  03A5'   37                    	STC
  03A6'   C4 06F4'              	CNZ	RDPREV
  03A9'   D0                    	RNC
  03AA'   11 005B               	LXI	D,5BH
  03AD'   1A                    	LDAX	D
  03AE'   13                    	INX	D
  03AF'   B7                    	ORA	A
