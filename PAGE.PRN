  0347'   CD 03B6'              	CALL	INRDY
  034A'   CA 037F'              	JZ	FILRET
  034D'   79                    	MOV	A,C
  034E'   B7                    	ORA	A
  034F'   C2 0364'              	JNZ	FILLRD
  0352'   C3 0000*              	JMP	POPRET
                                
                                ;FILLBUF -- WM 4659: top the window up from the input file(s).
