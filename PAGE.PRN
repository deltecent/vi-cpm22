  03B0'   37                    	STC
  03B1'   C4 06ED'              	CNZ	RDNEXT
  03B4'   C9                    	RET
                                
                                ;CLNSEC -- WM 4709: mask bit 7, stop at ^Z; return live byte count in A.
  03B5'                         CLNSEC:				; WM 4709
  03B5'   06 80                 	MVI	B,80H
  03B7'                         CLNLP:				; WM 4712
  03B7'   7E                    	MOV	A,M
  03B8'   E6 7F                 	ANI	7FH
  03BA'   77                    	MOV	M,A
  03BB'   FE 1A                 	CPI	EOF
  03BD'   CA 03C9'              	JZ	CLNEOF
  03C0'   23                    	INX	H
  03C1'   05                    	DCR	B
  03C2'   C2 03B7'              	JNZ	CLNLP
  03C5'   37                    	STC
  03C6'   3E 80                 	MVI	A,80H
  03C8'   C9                    	RET
  03C9'                         CLNEOF:				 ; WM 4725 -- input EOF: return the byte count
  03C9'   CD 0709'              	CALL	IOEOF
  03CC'   3E 80                 	MVI	A,80H
  03CE'   90                    	SUB	B
  03CF'   C9                    	RET
                                
                                ;INRDY -- WM 4733: NZ while any input data is still unread.
  03D0'                         INRDY:				; WM 4733
  03D0'   E5                    	PUSH	H
  03D1'   3A 005B               	LDA	5BH
  03D4'   21 0815'              	LXI	H,BAKRDY
  03D7'   B6                    	ORA	M
  03D8'   37                    	STC
  03D9'   E1                    	POP	H
  03DA'   C9                    	RET
                                
                                ;MOREIN -- WM 4743: NZ if more input remains in the current direction
