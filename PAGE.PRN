	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    PAGE.MAC
                                ; PROJECT: VI
                                ; MODULE:  WordMaster's file-I/O layer, transcribed VERBATIM from WM.ASM.
                                ;
                                ; This is the disk side of WordMaster's single-buffer design: the random-
                                ; record engine, the file primitives (open/close/make/rename/delete), and the
                                ; load (FILLBUF) and save (SAVCLO/FLUSHTX) drivers.  WordMaster's control flow
                                ; and instruction sequence are reproduced exactly (same assembled object code);
                                ; only the label NAMES are translated -- WM.ASM's address-derived labels (Lxxxx)
                                ; are renamed descriptively, which changes nothing in the assembled bytes.
                                ; Every routine cites its WM.ASM source line, so it still diffs against WM.ASM.
                                ;
                                ; WHAT IS HERE: the load path is FILLBUF and the save path SAVCLO/FLUSHTX --
                                ; the read and write sides of WordMaster's pager.  The window slides along a
                                ; file bigger than RAM through the eviction seam: MKROOM (SPILL forward, SPILLB
                                ; backward), REWIND, PAGEBOT, PAGEDIR/PAGEWIN/PGNEED and NEEDIN.  UPDMARK keeps
                                ; the three record marks (OUTREC/SRCREC/BAKREC) that let PAGEOUT and PAGEBOT
                                ; tell "already on disk" from "must transfer", so nothing is written twice or
                                ; lost; every mark starts each file at zero, as WM's per-file work-variable
                                ; clear leaves it.
                                ;
                                ; DEVIATIONS FROM WM (each is also flagged where it is):
                                ;   1. GETKEY -> KBPOLL.  RDSEC and POLLBRK drain type-ahead through WM's
                                ;      GETKEY; the ring is KEY.MAC's, so they call its KBPOLL.  POLLBRK keeps
                                ;      only WM's non-interruptible path (no ^C 'INTERRUPTED').  Harnesses
                                ;      without KEY.MAC supply a KBPOLL RET stub.
                                ;   2. FATAL -> JMP ERRMSG.  WM's FATAL (WM 5429) prints via CRLF/PUTSTR/CONOUT
                                ;      then JMP ABORT (screen + stack-unwind, neither exists).  It shares the
                                ;      'CALL x / DB msg,0' convention with ERRMSG, so FATAL just enters ERRMSG's
                                ;      tail (print msg, set ERRFLG, warm-boot).  Only reached on a disk error.
                                ;   3. OPENFIL / SAVEFIL wrappers.  WM's file-open is inline INIT code (WM
                                ;      412-519) and its save is ENDEDIT reached from the command loop (557-567);
                                ;      neither is a CALLable unit.  These two entry points run WM's exact
                                ;      instruction sequences verbatim, with the source FCB pre-staged at 005CH
                                ;      by CP/M from the command tail.  Same-drive / user-0 only: the multi-drive
                                ;      DRVMAP / DSTDRV branches (INIT 458-493) are omitted -- the bodies kept
                                ;      are verbatim.  A write to another drive is WRTO's, below.
                                ;   4. FILLBUF stores the last record's byte count (80H) for a full record with
                                ;      no ^Z, which WM does not -- WM's end-of-file bug; see FILLBUF.
                                ;   5. DISCRD skips the work-file deletes when this session never wrote a work
                                ;      record; see DISCRD.
                                ;   6. The backup work file is VIBACKUP.$$$, where WM names it WMBACKUP.$$$
                                ;      (BAKNAM).  Same length, so no layout moves.
                                ;
                                ; APPENDED (not WM), tagged where each starts: REOPEN/SEEKTO/OPENZ (':w' keeps
                                ; editing), TFCB/WRTO/TEXIST/DISCRD/CNTLF (':w name', ':e', a buffer with no
                                ; name), PGTOPM (the count of times the pager moved TXTBEG) and TOPLF with
                                ; TLFADD/TLFSUB (the line feeds behind the window, kept in PAGEOUT and REWIND).
                                ;============================================================
                                
  0000                          WBOOT	EQU	0
  0005                          BDOS	EQU	5
  001A                          EOF	EQU	1AH		; ^Z
  0008                          BS	EQU	08H
  0200                          PGINIT	EQU	200H		; WM 20 -- cold WRLIM/RDLIM (no-spill window)
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                                
                                ;--- entry points the harness / editor calls -------------------------------
                                	PUBLIC	OPENFIL, SAVEFIL
                                	PUBLIC	FILLBUF, SAVCLO
                                ;--- the disk seam BUF.MAC reaches -----------------------------------------
                                	PUBLIC	MKROOM, REWIND, UPDMARK, MARKGB
                                ;--- scroll/search paging drivers (BUF.MAC's PAGESTP / SCRLST reach them)
                                	PUBLIC	PAGEDIR, PAGEWIN
                                	PUBLIC	POLLBRK		; break poll (CNTTST tail-calls it)
                                	PUBLIC	MOREIN		; WM 4743 -- GOLINE (BUF.MAC) tests it
                                	PUBLIC	AUXCNT		; WM L271E -- after NEWFIL, as in WM
                                ;--- data the harness reads to check state ---------------------------------
                                	PUBLIC	NEWFIL, OUTFCB, BAKFCB
                                	PUBLIC	OUTREC, SRCREC, BAKREC, DIRFLG
                                	PUBLIC	PGTOPM		; (appended) times the pager moved TXTBEG
                                	PUBLIC	OUTPOS		; OUTFCB read/write position (rewind progress)
                                	PUBLIC	INRDY		; NZ while input remains (harness scroll loop)
                                	PUBLIC	BAKRDY		; set FFH when a VIBACKUP$$$ record is written
                                ;--- on-demand page-in (BUF.MAC RGET) and the renderer's spill guard ------------
                                	PUBLIC	NEEDIN		; WM 4617 -- RGET pages input in
                                	PUBLIC	WRLIM		; WM L2745 -- the screen sets it (WM MEASURE)
                                ;--- APPENDED (NOT WordMaster): vi :w keeps editing (WM 'H' on the same file) ---
                                	PUBLIC	REOPEN, SEEKTO, OPENZ
                                ;--- APPENDED (NOT WordMaster): vi :w name, :e, a buffer with no name ---------
                                	PUBLIC	TFCB, WRTO, TEXIST, DISCRD, CNTLF
                                	EXTRN	BINIT		; BUF.MAC -- WM L02F2 gap-pointer reset
                                	EXTRN	WRTYP, SECBUF	; RSV.MAC -- held above the image (see RSV.MAC)
                                
                                ;--- gap-buffer primitives + cells this layer drives (from BUF.MAC) ---------
                                	EXTRN	MEMCPY, CMP16, LDHLI, PRSPAN, BUFSUM
                                	EXTRN	PUTHOLE, PUTCUR, SUBHD, SUBCP2, POPRET, ERRMSG
                                	EXTRN	TXTBEG, GAPBEG, GAPEND, TXTEND, BUFEND
                                	EXTRN	KBPOLL		; KEY.MAC -- WM GETKEY (type-ahead drain)
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; OPENFIL -- open the source file (staged at 005CH by CP/M) and read it into
                                ; the gap buffer.  Verbatim INIT subset (WM 412-518) + CMDINI limits (854);
                                ; wrapper glue only (deviation 3).  BINIT must have run first.
                                ;============================================================
  0000'                         OPENFIL:
  0000'   21 0200               	LXI	H,PGINIT	; WM 854 (CMDINI) -- no-spill window
  0003'   22 0859'              	SHLD	WRLIM
  0006'   22 085B'              	SHLD	RDLIM
  0009'   2A 0000*              	LHLD	BUFEND		; WM 388/412 -- H = high byte of BUFEND
  000C'   7C                    	MOV	A,H
  000D'   CD 0232'              	CALL	PGCONST		; paging constants (BUFHI/BUFLO/IOBATCH/...)
  0010'   21 005C               	LXI	H,5CH		; build OUTFCB as a copy of the source FCB
  0013'   11 07C4'              	LXI	D,OUTFCB
  0016'   01 0010               	LXI	B,10H
  0019'   CD 0000*              	CALL	MEMCPY		; WM 462-463 -- 16-byte FCB header copy
  001C'   21 0816'              	LXI	H,BAKTYP	; set OUTFCB type = '$$$'  (WM 516-517)
  001F'   11 07CD'              	LXI	D,OUTTYP
  0022'   CD 06BB'              	CALL	CPYTYP
  0025'   11 07C4'              	LXI	D,OUTFCB	; zero OUTFCB random-record bytes
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0028'   CD 0623'              	CALL	ZERORR
  002B'   3A 005C               	LDA	5CH		; build BAKFCB = drive + 'VIBACKUP$$$'
  002E'   32 07EA'              	STA	BAKFCB		; WM 479-485
  0031'   21 080E'              	LXI	H,BAKNAM
  0034'   11 07EA'              	LXI	D,BAKFCB
  0037'   13                    	INX	D
  0038'   01 000B               	LXI	B,0BH
  003B'   CD 0000*              	CALL	MEMCPY
  003E'   11 07C4'              	LXI	D,OUTFCB	; delete any stale name.$$$  (WM 513-514)
  0041'   CD 0652'              	CALL	DELF
  0044'   21 0819'              	LXI	H,BAKEXT	; delete any stale name.BAK  (WM 510-517):
  0047'   11 07CD'              	LXI	D,OUTTYP	;   point OUTTYP at 'BAK', delete, restore '$$$'
  004A'   CD 06BB'              	CALL	CPYTYP
  004D'   11 07C4'              	LXI	D,OUTFCB
  0050'   CD 0652'              	CALL	DELF
  0053'   21 0816'              	LXI	H,BAKTYP
  0056'   11 07CD'              	LXI	D,OUTTYP
  0059'   CD 06BB'              	CALL	CPYTYP
  005C'   11 005C               	LXI	D,5CH		; open the source file  (WM 496-505)
  005F'   CD 061E'              	CALL	OPENF
  0062'   3E FF                 	MVI	A,0FFH
  0064'   CA 006D'              	JZ	OPNEW
  0067'   32 005B               	STA	5BH		; source has data (input side live)
  006A'   C3 0070'              	JMP	OPRD
  006D'                         OPNEW:				; source not found -> new file
  006D'   32 0826'              	STA	NEWFIL
  0070'                         OPRD:				; cold-start the pager state.  WM does this by
  0070'   AF                    	XRA	A		;   zeroing its whole work-variable area (WM
  0071'   32 07E9'              	STA	BAKRDY		;   369-373, the L0307 clear loop over TXTROWS..
  0074'   32 07C3'              	STA	OUTACT		 ;   2730): every deque mark -- OUTACT/OUTPOS/BAKPOS/
  0077'   32 0824'              	STA	INLEN		;   INLEN/OUTREC/SRCREC/BAKREC -- lives in that
  007A'   32 0829'              	STA	DIRFLG		;   region, so its true cold value is ZERO.  With
  007D'   21 0000               	LXI	H,0H		;   the real UPDMARK maintaining them (below), no
  0080'   22 081E'              	SHLD	OUTREC		;   bias is needed: at cold OUTPOS=0 and UPDMARK
  0083'   22 0820'              	SHLD	SRCREC		;   raises OUTREC to track each record spilled.
  0086'   22 0822'              	SHLD	BAKREC
  0089'   22 080C'              	SHLD	BAKPOS
  008C'   22 07E6'              	SHLD	OUTPOS
  008F'   22 082F'              	SHLD	TOPLF		; (appended) no line is behind the window yet
  0092'   CD 035A'              	CALL	FILLBUF		; WM 518 -- read the file into the buffer
  0095'   C9                    	RET
                                
                                ;============================================================
                                ; SAVEFIL -- finish the file: flush the buffer to name.$$$ then swap names
                                ; (source -> name.BAK, name.$$$ -> original).  Verbatim ENDEDIT (WM 557-567).
                                ;============================================================
  0096'                         SAVEFIL:			; WM 557 (ENDEDIT)
  0096'   CD 0431'              	CALL	SAVCLO
  0099'   21 0826'              	LXI	H,NEWFIL
  009C'   7E                    	MOV	A,M
  009D'   B7                    	ORA	A
  009E'   11 005C               	LXI	D,5CH
  00A1'   21 0819'              	LXI	H,BAKEXT
  00A4'   CC 067C'              	CZ	RENAME		; not new: source -> name.BAK
  00A7'   11 07C4'              	LXI	D,OUTFCB
  00AA'   21 0065               	LXI	H,65H
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  00AD'   C3 067C'              	JMP	RENAME		; name.$$$ -> original type (005CH+9 = 0065H)
                                
                                ;============================================================
                                ; APPENDED (NOT WordMaster): vi ':w' saves and keeps editing.  WM has no such
                                ; command -- its 'H' (EDNEXT, WM 525-545) ends the edit and re-inits for the
                                ; next file.  REOPEN is that re-init applied to the same file, and SEEKTO
                                ; pages the saved text back in up to the cursor's old place, flushing and
                                ; refilling exactly as the save loop (SAVCLO) does.  Without this, the editor
                                ; kept running on the flushed buffer and closed/renamed FCBs after a ':w'.
                                ;============================================================
                                
                                ;REOPEN -- after a save: re-open the file named at 005CH and load its start.
  00B0'                         REOPEN:
  00B0'   CD 062F'              	CALL	CLSBAK		; WM 526 (EDNEXT)
  00B3'   CD 0000*              	CALL	BINIT		; WM L02F2 -- reset the gap pointers
                                ;OPENZ -- OPENFIL after WM's L02F2 clears (WM 369-376): the source FCB's input
                                ; flag, extent, record count and random record, and NEWFIL.  At start-up the
                                ; input flag (005BH) holds whatever the last program left there; a file that
                                ; is not found must not be read from.
  00B6'                         OPENZ:
  00B6'   AF                    	XRA	A
  00B7'   32 005B               	STA	5BH
  00BA'   32 0068               	STA	68H
  00BD'   32 006B               	STA	6BH
  00C0'   32 007D               	STA	7DH
  00C3'   32 0826'              	STA	NEWFIL
  00C6'   C3 0000'              	JMP	OPENFIL		; WM INIT: FCBs, stale-file deletes, open, fill
                                
                                ;SEEKTO -- DE = record, A = byte (0-127) of a file position: page forward
                                ;until that position is in the window.  HL = its logical offset (the end of
                                ;the text if the file is shorter).  OUTPOS*128 is TXTBEG's file position.
  00C9'                         SEEKTO:
  00C9'   32 082E'              	STA	SKBYT
  00CC'   EB                    	XCHG
  00CD'   22 082C'              	SHLD	SKREC
  00D0'                         SKLP:
  00D0'   2A 07E6'              	LHLD	OUTPOS
  00D3'   EB                    	XCHG
  00D4'   2A 082C'              	LHLD	SKREC
  00D7'   CD 0000*              	CALL	SUBHD		; HL = records past TXTBEG's
  00DA'   7C                    	MOV	A,H
  00DB'   FE 02                 	CPI	2H
  00DD'   D2 00FE'              	JNC	SKMORE		; >= 200H records: not in the window
  00E0'   1F                    	RAR			; CY = bit 8 (H is 0 or 1)
  00E1'   7D                    	MOV	A,L
  00E2'   1F                    	RAR			; A = bits 8-1, CY = bit 0
  00E3'   57                    	MOV	D,A
  00E4'   3E 00                 	MVI	A,0
  00E6'   1F                    	RAR			; A = bit 0 << 7
  00E7'   5F                    	MOV	E,A
  00E8'   3A 082E'              	LDA	SKBYT
  00EB'   B3                    	ORA	E
  00EC'   5F                    	MOV	E,A		; DE = HL*128 + byte: the target offset
  00ED'   D5                    	PUSH	D
  00EE'   2A 0000*              	LHLD	TXTBEG
  00F1'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  00F2'   2A 0000*              	LHLD	TXTEND
  00F5'   CD 0000*              	CALL	SUBHD
  00F8'   EB                    	XCHG			; DE = text in the window
  00F9'   E1                    	POP	H		; HL = target
  00FA'   CD 0000*              	CALL	CMP16		; CY iff length < target
  00FD'   D0                    	RNC			; in the window
  00FE'                         SKMORE:
  00FE'   CD 02DA'              	CALL	FLUSHTX		; WM 4850 (SAVCLO): write it all, refill
  0101'   CD 0340'              	CALL	FILLBF2
  0104'   D2 00D0'              	JNC	SKLP
  0107'   2A 0000*              	LHLD	TXTBEG		; no more input: the end of the text
  010A'   EB                    	XCHG
  010B'   2A 0000*              	LHLD	TXTEND
  010E'   C3 0000*              	JMP	SUBHD
                                
                                ;============================================================
                                ; APPENDED (NOT WordMaster): vi writes the text to a name of its own (:w name,
                                ; and a buffer that has no name) and drops it for another file (:e).  WM always
                                ; writes back to the file it read.  These use WM's own primitives: SAVCLO for
                                ; the flush, RENAME for the backup, RENF, DELF, MAKEF, OPENF, CLOSEF.
                                ; TFCB holds the target name; the vi layer fills its drive, name and type
                                ; (bytes 0-11) and zeroes the rest.
                                ;============================================================
                                
                                ;TEXIST -- Z iff no file has TFCB's name.
  0111'                         TEXIST:
  0111'   11 0835'              	LXI	D,TFCB
  0114'   CD 0604'              	CALL	BDOSFN
  0117'   11                    	DB	11H		; search for the first match
  0118'   3C                    	INR	A
  0119'   C9                    	RET
                                
                                ;WRTO -- write the whole text to the file named in TFCB (the edit is flushed
                                ; to name.$$$, as WM's ENDEDIT does).  A <> 0: a file already there becomes
                                ; name.BAK (WM ENDEDIT); A = 0: it is deleted (vim overwrites it).  Then
                                ; name.$$$ takes TFCB's name, by RENF on its own drive or by a copy to another
                                ; drive.  REOPEN must follow (from TFCB's name).
  011A'                         WRTO:
  011A'   F5                    	PUSH	PSW
  011B'   CD 0431'              	CALL	SAVCLO		; WM 558 (ENDEDIT)
  011E'   11 0835'              	LXI	D,TFCB
  0121'   F1                    	POP	PSW
  0122'   B7                    	ORA	A
  0123'   CA 0150'              	JZ	WRDEL
  0126'   21 083E'              	LXI	H,TFCB+9	; delete any old name.BAK
  0129'   11 0000*              	LXI	D,WRTYP
  012C'   CD 06BB'              	CALL	CPYTYP
  012F'   11 083E'              	LXI	D,TFCB+9
  0132'   CD 06B8'              	CALL	CPYBAK
  0135'   11 0835'              	LXI	D,TFCB
  0138'   CD 0652'              	CALL	DELF
  013B'   21 0000*              	LXI	H,WRTYP
  013E'   11 083E'              	LXI	D,TFCB+9
  0141'   CD 06BB'              	CALL	CPYTYP
  0144'   11 0835'              	LXI	D,TFCB		; name -> name.BAK (WM 562)
  0147'   21 0819'              	LXI	H,BAKEXT
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  014A'   CD 067C'              	CALL	RENAME
  014D'   C3 0153'              	JMP	WRMOV
  0150'                         WRDEL:
  0150'   CD 0652'              	CALL	DELF
  0153'                         WRMOV:
  0153'   3A 07C4'              	LDA	OUTFCB
  0156'   21 0835'              	LXI	H,TFCB
  0159'   BE                    	CMP	M
  015A'   C2 017F'              	JNZ	WRCPY		; another drive
  015D'   21 07C4'              	LXI	H,OUTFCB	; RENF block: name.$$$, then TFCB's name
  0160'   11 07D4'              	LXI	D,OUTFCB+10H
  0163'   01 0010               	LXI	B,10H
  0166'   CD 0000*              	CALL	MEMCPY
  0169'   21 0836'              	LXI	H,TFCB+1
  016C'   11 07D5'              	LXI	D,OUTFCB+11H
  016F'   01 000B               	LXI	B,0BH
  0172'   CD 0000*              	CALL	MEMCPY
  0175'   AF                    	XRA	A
  0176'   32 07D4'              	STA	OUTFCB+10H	; the new name's drive byte is 0 (as RENAME)
  0179'   11 07C4'              	LXI	D,OUTFCB
  017C'   C3 069B'              	JMP	RENF		; WM 566
  017F'                         WRCPY:				; name.$$$ copied record by record
  017F'   AF                    	XRA	A		; extent 0, record 0 on both
  0180'   32 07D0'              	STA	OUTFCB+0CH
  0183'   32 07E4'              	STA	OUTFCB+20H
  0186'   32 0855'              	STA	TFCB+20H
  0189'   11 07C4'              	LXI	D,OUTFCB
  018C'   CD 061E'              	CALL	OPENF
  018F'   11 0835'              	LXI	D,TFCB
  0192'   CD 065E'              	CALL	DELRST		; make the new file
  0195'                         WRCLP:
  0195'   11 07C4'              	LXI	D,OUTFCB
  0198'   CD 0604'              	CALL	BDOSFN
  019B'   14                    	DB	14H		; read the next record
  019C'   B7                    	ORA	A
  019D'   C2 01AE'              	JNZ	WRCEND
  01A0'   11 0835'              	LXI	D,TFCB
  01A3'   CD 0604'              	CALL	BDOSFN
  01A6'   15                    	DB	15H		; write it
  01A7'   B7                    	ORA	A
  01A8'   CA 0195'              	JZ	WRCLP
  01AB'   C3 071A'              	JMP	DSKERR
  01AE'                         WRCEND:
  01AE'   11 0835'              	LXI	D,TFCB
  01B1'   CD 0639'              	CALL	CLOSEF
  01B4'   11 07C4'              	LXI	D,OUTFCB
  01B7'   C3 0652'              	JMP	DELF
                                
                                ;DISCRD -- drop the edit: delete name.$$$ and VIBACKUP$$$ (WM EDEND, 581).
                                ;DEVIATION (not WordMaster): both are skipped when this session never wrote a
                                ;work record at all (WRKMAD clear), because then neither file can exist.  A BDOS
                                ;delete scans the whole directory whether or not the name is on it -- the best
                                ;part of a second each on a large drive -- and ':q' on a text that never spilled
                                ;paid it twice for nothing.  The per-file [FCB-2]/[FCB-1] flags will NOT do:
                                ;reading the backup back to its end clears them while the file is still there,
                                ;which is why WM's EDEND deletes unconditionally.
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  01BA'                         DISCRD:
  01BA'   3A 082B'              	LDA	WRKMAD
  01BD'   B7                    	ORA	A
  01BE'   C8                    	RZ			; no work file was ever made: nothing to drop
  01BF'   AF                    	XRA	A
  01C0'   32 082B'              	STA	WRKMAD		; the deletes below leave nothing to drop again
  01C3'   11 07C4'              	LXI	D,OUTFCB
  01C6'   CD 0652'              	CALL	DELF
  01C9'   C3 064C'              	JMP	KILLBAK
                                
                                ;CNTLF -- HL = the line feeds before the cursor: TOPLF for the records behind
                                ;the window, plus a scan of the text from TXTBEG to the gap.  It reads no disk.
  01CC'                         CNTLF:
  01CC'   2A 082F'              	LHLD	TOPLF
  01CF'   22 0831'              	SHLD	CLCNT
  01D2'   2A 0000*              	LHLD	TXTBEG
  01D5'   E5                    	PUSH	H
  01D6'   EB                    	XCHG
  01D7'   2A 0000*              	LHLD	GAPBEG
  01DA'   CD 0000*              	CALL	SUBHD
  01DD'   EB                    	XCHG			; DE = the text before the gap
  01DE'   E1                    	POP	H
  01DF'   CD 021B'              	CALL	CLBYTS
  01E2'   2A 0831'              	LHLD	CLCNT
  01E5'   C9                    	RET
                                
                                ;TLFADD / TLFSUB -- the sector at HL leaves the window's top (PAGEOUT) or comes
                                ;back to it (REWIND): TOPLF gains or loses its line feeds.  TOPLF is then the
                                ;line feeds in output records 0 to OUTPOS-1 at all times, which is what CNTLF
                                ;used to read those records back to find.  Keeps every register and the flags.
  01E6'                         TLFADD:
  01E6'   F5                    	PUSH	PSW
  01E7'   C5                    	PUSH	B
  01E8'   D5                    	PUSH	D
  01E9'   E5                    	PUSH	H
  01EA'   CD 0209'              	CALL	TLFSEC
  01ED'   2A 082F'              	LHLD	TOPLF
  01F0'   19                    	DAD	D
  01F1'   C3 0201'              	JMP	TLFSTO
  01F4'                         TLFSUB:
  01F4'   F5                    	PUSH	PSW
  01F5'   C5                    	PUSH	B
  01F6'   D5                    	PUSH	D
  01F7'   E5                    	PUSH	H
  01F8'   CD 0209'              	CALL	TLFSEC
  01FB'   2A 082F'              	LHLD	TOPLF
  01FE'   CD 0000*              	CALL	SUBHD
  0201'                         TLFSTO:
  0201'   22 082F'              	SHLD	TOPLF
  0204'   E1                    	POP	H
  0205'   D1                    	POP	D
  0206'   C1                    	POP	B
  0207'   F1                    	POP	PSW
  0208'   C9                    	RET
                                
                                ;TLFSEC -- DE = the line feeds in the 128 bytes at HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0209'                         TLFSEC:
  0209'   11 0000               	LXI	D,0
  020C'   06 80                 	MVI	B,80H
  020E'                         TLFLP:
  020E'   7E                    	MOV	A,M
  020F'   23                    	INX	H
  0210'   FE 0A                 	CPI	0AH
  0212'   C2 0216'              	JNZ	TLFNX
  0215'   13                    	INX	D
  0216'                         TLFNX:
  0216'   05                    	DCR	B
  0217'   C2 020E'              	JNZ	TLFLP
  021A'   C9                    	RET
                                
                                ;CLBYTS -- HL = text, DE = its length: CLCNT += its line feeds.
  021B'                         CLBYTS:
  021B'   7A                    	MOV	A,D
  021C'   B3                    	ORA	E
  021D'   C8                    	RZ
  021E'   7E                    	MOV	A,M
  021F'   23                    	INX	H
  0220'   1B                    	DCX	D
  0221'   FE 0A                 	CPI	0AH
  0223'   C2 021B'              	JNZ	CLBYTS
  0226'   E5                    	PUSH	H
  0227'   2A 0831'              	LHLD	CLCNT
  022A'   23                    	INX	H
  022B'   22 0831'              	SHLD	CLCNT
  022E'   E1                    	POP	H
  022F'   C3 021B'              	JMP	CLBYTS
                                
                                ;============================================================
                                ; PAGING CONSTANTS -- WM 412-447.  From A/H = high byte of BUFEND, derive the
                                ; batch/margin sizing and the free-space water marks the load/spill path reads.
                                ;============================================================
  0232'                         PGCONST:			; WM 412
  0232'   7C                    	MOV	A,H
  0233'   B7                    	ORA	A
  0234'   1F                    	RAR
  0235'   1F                    	RAR
  0236'   1F                    	RAR
  0237'   3C                    	INR	A
  0238'   3C                    	INR	A
  0239'   E6 3C                 	ANI	3CH
  023B'   47                    	MOV	B,A
  023C'   32 0861'              	STA	PGSCAL
  023F'   07                    	RLC
  0240'   32 0862'              	STA	PGSCL2
  0243'   78                    	MOV	A,B
  0244'   FE 08                 	CPI	BS
  0246'   D2 024B'              	JNC	PGCON1
  0249'   3E 08                 	MVI	A,BS
  024B'                         PGCON1:				 ; WM 430
  024B'   32 0864'              	STA	PGMARGN
  024E'   7C                    	MOV	A,H
  024F'   FE 64                 	CPI	64H
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0251'   21 0400               	LXI	H,400H
  0254'   22 085D'              	SHLD	BUFLO
  0257'   DA 025B'              	JC	PGCON2
  025A'   29                    	DAD	H
  025B'                         PGCON2:				 ; WM 439
  025B'   22 085F'              	SHLD	BUFHI
  025E'   3E 08                 	MVI	A,BS
  0260'   32 0866'              	STA	PGSCRA
  0263'   DA 0267'              	JC	PGCON3
  0266'   87                    	ADD	A
  0267'                         PGCON3:				 ; WM 446
  0267'   32 0865'              	STA	IOBATCH
  026A'   C9                    	RET
                                
                                ;============================================================
                                ; SPILL / PAGEOUT / FLUSHTX -- the output (write-behind) side.  RAM-only, SPILL
                                ; no-ops (CKWRLIM) on load and FLUSHTX drains the whole buffer on save.
                                ;============================================================
                                
                                ;SPILL -- WM 4386: write-behind a batch of TXTBEG-side sectors to OUTFCB.
  026B'                         SPILL:				; WM 4386
  026B'   C5                    	PUSH	B
  026C'   D5                    	PUSH	D
  026D'   E5                    	PUSH	H
  026E'   CD 029A'              	CALL	PAGEOUT
  0271'   DA 0000*              	JC	POPRET
  0274'   21 0867'              	LXI	H,SPLCNT
  0277'   34                    	INR	M
  0278'   46                    	MOV	B,M
  0279'   21 0862'              	LXI	H,PGSCL2
  027C'   AF                    	XRA	A
  027D'                         SPLSUM:				 ; WM 4398
  027D'   86                    	ADD	M
  027E'   05                    	DCR	B
  027F'   C2 027D'              	JNZ	SPLSUM
  0282'   3D                    	DCR	A
  0283'   F6 07                 	ORI	7H
  0285'   4F                    	MOV	C,A
  0286'   3A 0865'              	LDA	IOBATCH
  0289'   3D                    	DCR	A
  028A'   47                    	MOV	B,A
  028B'                         SPLLP:				; WM 4409
  028B'   CD 029A'              	CALL	PAGEOUT
  028E'   05                    	DCR	B
  028F'   CA 0296'              	JZ	SPLDON
  0292'   0D                    	DCR	C
  0293'   C2 028B'              	JNZ	SPLLP
  0296'                         SPLDON:				 ; WM 4416
  0296'   B7                    	ORA	A
  0297'   C3 0000*              	JMP	POPRET
                                
                                ;PAGEOUT -- WM 4439: spill one sector at TXTBEG to OUTFCB, bump TXTBEG.
  029A'                         PAGEOUT:			; WM 4439
  029A'   2A 0000*              	LHLD	TXTBEG
  029D'   CD 0453'              	CALL	CKWRLIM
  02A0'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  02A1'   E5                    	PUSH	H
  02A2'   2A 07E6'              	LHLD	OUTPOS
  02A5'   EB                    	XCHG
  02A6'   2A 081E'              	LHLD	OUTREC
  02A9'   CD 0000*              	CALL	CMP16
  02AC'   E1                    	POP	H
  02AD'   11 07C4'              	LXI	D,OUTFCB
  02B0'   D2 02B9'              	JNC	POFRSH
  02B3'   CD 073D'              	CALL	RECINC
  02B6'   C3 02C6'              	JMP	POADV
  02B9'                         POFRSH:				 ; WM 4454 -- write a fresh output record
  02B9'   CD 0737'              	CALL	WRRECP
  02BC'   EB                    	XCHG
  02BD'   2A 081E'              	LHLD	OUTREC
  02C0'   23                    	INX	H
  02C1'   22 081E'              	SHLD	OUTREC
  02C4'   EB                    	XCHG
  02C5'   04                    	INR	B
  02C6'                         POADV:				; WM 4463 -- advance TXTBEG past the sector
  02C6'   CD 01E6'              	CALL	TLFADD		; (appended) its line feeds are behind the
                                				;   window now
  02C9'   11 0080               	LXI	D,80H
  02CC'   19                    	DAD	D
  02CD'   22 0000*              	SHLD	TXTBEG
  02D0'   E5                    	PUSH	H
  02D1'   2A 081C'              	LHLD	PGTOPM		; (appended) the window's top moved: 'u' reads
  02D4'   23                    	INX	H		;   this to know its offsets have shifted
  02D5'   22 081C'              	SHLD	PGTOPM
  02D8'   E1                    	POP	H
  02D9'   C9                    	RET
                                
                                ;FLUSHTX -- WM 4471: collapse the gap and PAGEOUT every remaining sector.
  02DA'                         FLUSHTX:			; WM 4471
  02DA'   C5                    	PUSH	B
  02DB'   D5                    	PUSH	D
  02DC'   E5                    	PUSH	H
  02DD'   21 0081               	LXI	H,81H
  02E0'   22 0859'              	SHLD	WRLIM
  02E3'   21 0000*              	LXI	H,BUFEND
  02E6'   CD 0000*              	CALL	PUTHOLE
  02E9'   2A 0000*              	LHLD	TXTEND
  02EC'   CD 0000*              	CALL	PUTCUR
  02EF'                         FLXLP:				; WM 4482 -- flush loop
  02EF'   CD 029A'              	CALL	PAGEOUT
  02F2'   D2 02EF'              	JNC	FLXLP
  02F5'   C3 0000*              	JMP	POPRET
                                
                                ;STAGSEC -- WM 4588: stage a short final record into SECBUF, ^Z-pad the tail.
  02F8'                         STAGSEC:			; WM 4588
  02F8'   C5                    	PUSH	B
  02F9'   D5                    	PUSH	D
  02FA'   11 0000*              	LXI	D,SECBUF
  02FD'   D5                    	PUSH	D
  02FE'   47                    	MOV	B,A
  02FF'   0E 82                 	MVI	C,82H
  0301'   04                    	INR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  0302'   2B                    	DCX	H
  0303'   1B                    	DCX	D
  0304'                         STGCPY:				 ; WM 4599 -- copy the partial sector
  0304'   7E                    	MOV	A,M
  0305'   12                    	STAX	D
  0306'   23                    	INX	H
  0307'   13                    	INX	D
  0308'   0D                    	DCR	C
  0309'   05                    	DCR	B
  030A'   C2 0304'              	JNZ	STGCPY
  030D'                         STGPAD:				 ; WM 4608 -- pad the rest with ^Z
  030D'   3E 1A                 	MVI	A,EOF
  030F'   12                    	STAX	D
  0310'   13                    	INX	D
  0311'   0D                    	DCR	C
  0312'   C2 030D'              	JNZ	STGPAD
  0315'   C3 0000*              	JMP	POPRET
                                
                                ;============================================================
                                ; FILLBUF / RDIN / CLNSEC -- the input (read) side.
                                ;============================================================
                                
                                ;NEEDIN -- WM 4617: page input in when the forward read (RGET) runs dry.
                                ;SPILL first if free space is under a record, then reserve and fill.
  0318'                         NEEDIN:				; WM 4617
  0318'   CD 03BB'              	CALL	INRDY
  031B'   C8                    	RZ
  031C'   C5                    	PUSH	B
  031D'   D5                    	PUSH	D
  031E'   E5                    	PUSH	H
  031F'   CD 0000*              	CALL	BUFSUM
  0322'   21 0080               	LXI	H,80H
  0325'   CD 0000*              	CALL	CMP16
  0328'   EB                    	XCHG
  0329'   2A 085F'              	LHLD	BUFHI
  032C'   D2 0336'              	JNC	NDIRSV
  032F'   CD 026B'              	CALL	SPILL
  0332'   DA 03F9'              	JC	MEMSHT
  0335'   EB                    	XCHG
  0336'                         NDIRSV:				 ; WM 4633 -- reserve free space, then fill
  0336'   EB                    	XCHG
  0337'   21 0000*              	LXI	H,BUFEND
  033A'   CD 03EC'              	CALL	FREEREC
  033D'   C3 0369'              	JMP	FILLRD
                                
                                ;FILLBF2 -- WM 4640: fill from input, capped at 7800H.
  0340'                         FILLBF2:			; WM 4640
  0340'   C5                    	PUSH	B
  0341'   D5                    	PUSH	D
  0342'   E5                    	PUSH	H
  0343'   21 0000*              	LXI	H,BUFEND
  0346'   11 7800               	LXI	D,7800H
  0349'   CD 041D'              	CALL	BUFFREE
  034C'   CD 03BB'              	CALL	INRDY
  034F'   CA 0384'              	JZ	FILRET
  0352'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0353'   B7                    	ORA	A
  0354'   C2 0369'              	JNZ	FILLRD
  0357'   C3 0000*              	JMP	POPRET
                                
                                ;FILLBUF -- WM 4659: top the window up from the input file(s).
  035A'                         FILLBUF:			; WM 4659
  035A'   C5                    	PUSH	B
  035B'   D5                    	PUSH	D
  035C'   E5                    	PUSH	H
  035D'   CD 03BB'              	CALL	INRDY
  0360'   CA 0384'              	JZ	FILRET
  0363'   21 0000*              	LXI	H,BUFEND
  0366'   CD 03D2'              	CALL	RESVBF0
  0369'                         FILLRD:				 ; WM 4668
  0369'   2A 0000*              	LHLD	TXTEND
  036C'                         FILRLP:				 ; WM 4671 -- read & clean one input record
  036C'   CD 0387'              	CALL	RDIN
  036F'   D4 03A0'              	CNC	CLNSEC
  0372'   D2 0379'              	JNC	FILRSV		; DEVIATION (WM bug): WM is JC L1C6B, which
  0375'   B7                    	ORA	A		;   skips the store for a full record (CY,
  0376'   CA 037C'              	JZ	FILRST		;   A=80H), so a file ending on a record
  0379'   32 0824'              FILRSV: STA	INLEN		;   boundary w/o ^Z leaves INLEN=0 and PAGEBOT
                                				;   RECDECs one record too far (record saved
                                				;   twice).  Skip only RDIN's no-record case
                                				;   (CY, A=0).
  037C'                         FILRST:				 ; WM 4677
  037C'   22 0000*              	SHLD	TXTEND
  037F'   0D                    	DCR	C
  0380'   C2 036C'              	JNZ	FILRLP
  0383'   B7                    	ORA	A
  0384'                         FILRET:				 ; WM 4683
  0384'   C3 0000*              	JMP	POPRET
                                
                                ;RDIN -- WM 4689: read the next input record into [HL] (backup then source).
  0387'                         RDIN:				; WM 4689
  0387'   CD 07BC'              	CALL	POLLBRK
  038A'   11 07E9'              	LXI	D,BAKRDY
  038D'   1A                    	LDAX	D
  038E'   13                    	INX	D
  038F'   B7                    	ORA	A
  0390'   37                    	STC
  0391'   C4 06C8'              	CNZ	RDPREV
  0394'   D0                    	RNC
  0395'   11 005B               	LXI	D,5BH
  0398'   1A                    	LDAX	D
  0399'   13                    	INX	D
  039A'   B7                    	ORA	A
  039B'   37                    	STC
  039C'   C4 06C1'              	CNZ	RDNEXT
  039F'   C9                    	RET
                                
                                ;CLNSEC -- WM 4709: mask bit 7, stop at ^Z; return live byte count in A.
  03A0'                         CLNSEC:				; WM 4709
  03A0'   06 80                 	MVI	B,80H
  03A2'                         CLNLP:				; WM 4712
  03A2'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  03A3'   E6 7F                 	ANI	7FH
  03A5'   77                    	MOV	M,A
  03A6'   FE 1A                 	CPI	EOF
  03A8'   CA 03B4'              	JZ	CLNEOF
  03AB'   23                    	INX	H
  03AC'   05                    	DCR	B
  03AD'   C2 03A2'              	JNZ	CLNLP
  03B0'   37                    	STC
  03B1'   3E 80                 	MVI	A,80H
  03B3'   C9                    	RET
  03B4'                         CLNEOF:				 ; WM 4725 -- input EOF: return the byte count
  03B4'   CD 06DD'              	CALL	IOEOF
  03B7'   3E 80                 	MVI	A,80H
  03B9'   90                    	SUB	B
  03BA'   C9                    	RET
                                
                                ;INRDY -- WM 4733: NZ while any input data is still unread.
  03BB'                         INRDY:				; WM 4733
  03BB'   E5                    	PUSH	H
  03BC'   3A 005B               	LDA	5BH
  03BF'   21 07E9'              	LXI	H,BAKRDY
  03C2'   B6                    	ORA	M
  03C3'   37                    	STC
  03C4'   E1                    	POP	H
  03C5'   C9                    	RET
                                
                                ;MOREIN -- WM 4743: NZ if more input remains in the current direction
                                ;(WM's L26AA is OUTACT, the byte before OUTFCB).
  03C6'                         MOREIN:				; WM 4743
  03C6'   3A 0829'              	LDA	DIRFLG
  03C9'   B7                    	ORA	A
  03CA'   3A 07C3'              	LDA	OUTACT
  03CD'   F4 03BB'              	CP	INRDY
  03D0'   B7                    	ORA	A
  03D1'   C9                    	RET
                                
                                ;============================================================
                                ; FREE-SPACE ACCOUNTING -- WM 4786-4841.  Reserve/compute the read-ahead room.
                                ;============================================================
                                
                                ;RESVBF0/RESVBUF -- WM 4786/4790: reserve free buffer space up to BUFHI.
  03D2'                         RESVBF0:			; WM 4786
  03D2'   11 026B'              	LXI	D,SPILL
  03D5'                         RESVBUF:			; WM 4790
  03D5'   E5                    	PUSH	H
  03D6'   2A 085F'              	LHLD	BUFHI
  03D9'   D5                    	PUSH	D
  03DA'   CD 0000*              	CALL	BUFSUM
  03DD'   CD 0000*              	CALL	CMP16
  03E0'   E1                    	POP	H
  03E1'   DC 041C'              	CC	DISPKEY
  03E4'   2A 085D'              	LHLD	BUFLO
  03E7'   29                    	DAD	H
  03E8'   24                    	INR	H
  03E9'   24                    	INR	H
  03EA'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  03EB'   E1                    	POP	H
  03EC'                         FREEREC:			; WM 4806 -- free bytes -> capped record count
  03EC'   CD 041D'              	CALL	BUFFREE
  03EF'   FE 08                 	CPI	BS
  03F1'   DA 03F7'              	JC	FRECOK
  03F4'   D6 04                 	SUI	4H
  03F6'   4F                    	MOV	C,A
  03F7'                         FRECOK:				 ; WM 4813
  03F7'   B7                    	ORA	A
  03F8'   C0                    	RNZ
  03F9'                         MEMSHT:				 ; WM 4817
  03F9'   CD 0000*              	CALL	ERRMSG
  03FC'   4D 45 4D 20           	DB	'MEM SHORTAGE, TRY CLEARING QBUF',0H
  0400'   53 48 4F 52           
  0404'   54 41 47 45           
  0408'   2C 20 54 52           
  040C'   59 20 43 4C           
  0410'   45 41 52 49           
  0414'   4E 47 20 51           
  0418'   42 55 46 00           
                                
                                ;DISPKEY -- WM 2846: PCHL trampoline (call the reserve routine held in HL).
  041C'                         DISPKEY:			; WM 2846
  041C'   E9                    	PCHL
                                
                                ;BUFFREE -- WM 4827: collapse the gap and report free bytes (A/C = pages).
  041D'                         BUFFREE:			; WM 4827
  041D'   CD 0000*              	CALL	PUTHOLE
  0420'   D5                    	PUSH	D
  0421'   CD 0000*              	CALL	BUFSUM
  0424'   E1                    	POP	H
  0425'   CD 0000*              	CALL	SUBCP2
  0428'   EB                    	XCHG
  0429'   29                    	DAD	H
  042A'                         BFRLP:				; WM 4836
  042A'   DA 042A'              	JC	BFRLP
  042D'   EB                    	XCHG
  042E'   7A                    	MOV	A,D
  042F'   4A                    	MOV	C,D
  0430'   C9                    	RET
                                
                                ;============================================================
                                ; SAVCLO -- WM 4846: flush all buffered text to OUTFCB and close it.
                                ;============================================================
  0431'                         SAVCLO:				; WM 4846
  0431'   CD 0340'              	CALL	FILLBF2
  0434'                         SAVLP:				; WM 4849 -- flush all, refill, repeat
  0434'   CD 02DA'              	CALL	FLUSHTX
  0437'   CD 0340'              	CALL	FILLBF2
  043A'   D2 0434'              	JNC	SAVLP
  043D'   21 0000*              	LXI	H,TXTBEG
  0440'   CD 0000*              	CALL	PRSPAN
  0443'   CD 0000*              	CALL	LDHLI
  0446'   79                    	MOV	A,C
  0447'   CD 02F8'              	CALL	STAGSEC
  044A'   11 07C4'              	LXI	D,OUTFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  044D'   CD 0737'              	CALL	WRRECP
  0450'   C3 0639'              	JMP	CLOSEF
                                
                                ;CKWRLIM -- WM 4863: CY if GAPBEG is below the PAGEOUT write limit.
  0453'                         CKWRLIM:			; WM 4863
  0453'   E5                    	PUSH	H
  0454'   2A 0859'              	LHLD	WRLIM
  0457'   EB                    	XCHG
  0458'   2A 0000*              	LHLD	GAPBEG
  045B'   CD 0000*              	CALL	SUBHD
  045E'   EB                    	XCHG
  045F'   E1                    	POP	H
  0460'   C3 0000*              	JMP	CMP16
                                
                                ;CKRDLIM -- WM 4874: compare GAPEND against the read limit (PAGEBOT guard).
  0463'                         CKRDLIM:			; WM 4874
  0463'   E5                    	PUSH	H
  0464'   2A 085B'              	LHLD	RDLIM
  0467'   EB                    	XCHG
  0468'   2A 0000*              	LHLD	GAPEND
  046B'   19                    	DAD	D
  046C'   D1                    	POP	D
  046D'   CD 0000*              	CALL	CMP16
  0470'   EB                    	XCHG
  0471'   C9                    	RET
                                
                                ;============================================================
                                ; EVICTION SEAM + DEQUE MARKS.  Transcribed VERBATIM (WM 4335-4962).
                                ; MKGAP (BUF.MAC) reaches disk only here: MKROOM evicts a window edge (SPILL the
                                ; TXTBEG side to OUTFCB when scrolling forward, SPILLB the TXTEND side back to
                                ; the input/backup side when scrolling back).  UPDMARK keeps the three record
                                ; marks (OUTREC / SRCREC / BAKREC) that let PAGEOUT and PAGEBOT tell "already on
                                ; disk" from "must transfer", so nothing is written twice or lost.
                                ; PAGEDIR / PAGEWIN / PGNEED (scroll- and search-time paging) are real below:
                                ; PAGEDIR picks REWIND (backward, re-read spilled text) vs FILLBUF (forward),
                                ; and PGNEED / PAGEWIN keep PGMARGN bytes of text resident on the active edge.
                                ; The editor reaches them through BUF.MAC's PAGESTP and SCRLST (the line moves,
                                ; the line kill and the search sweep); PGBKTST drives PAGEDIR directly.
                                ;============================================================
                                
                                ;PAGEDIR -- WM 4320: page more text into the window in the current scroll
                                ;direction -- REWIND (re-read text previously spilled to OUTFCB) when DIRFLG is
                                ;backward, else FILLBUF (read more of the input) when forward.
  0472'                         PAGEDIR:			; WM 4320
  0472'   CD 07BC'              	CALL	POLLBRK
  0475'   3A 0829'              	LDA	DIRFLG
  0478'   B7                    	ORA	A
  0479'   FA 054B'              	JM	REWIND
  047C'   C3 035A'              	JMP	FILLBUF
                                
                                ;MKROOM -- WM 4335: free gap space by evicting a window edge (DIRFLG picks).
  047F'                         MKROOM:				; WM 4335
  047F'   3A 0829'              	LDA	DIRFLG
  0482'   B7                    	ORA	A
  0483'   37                    	STC
  0484'   FC 04BE'              	CM	SPILLB
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0487'   D0                    	RNC
  0488'   CD 026B'              	CALL	SPILL
  048B'   D0                    	RNC
  048C'   C3 04BE'              	JMP	SPILLB
                                
                                ;PAGEWIN -- WM 4350: keep PGMARGN bytes of text buffered around the cursor on
                                ;the active edge (for a whole-file search); PAGEDIR one increment at a time
                                ;until PGNEED is satisfied or the source runs out.
  048F'                         PAGEWIN:			; WM 4350
  048F'   CD 049F'              	CALL	PGNEED
  0492'   D8                    	RC
  0493'   CD 0472'              	CALL	PAGEDIR
  0496'   D8                    	RC
  0497'   CD 049F'              	CALL	PGNEED
  049A'   D4 0472'              	CNC	PAGEDIR
  049D'   B7                    	ORA	A
  049E'   C9                    	RET
                                
                                ;PGNEED -- WM 4361: CY if the active edge (TXTBEG scanning back, GAPEND scanning
                                ;forward) is still within PGMARGN*256 bytes -- i.e. the resident text on that
                                ;side is shorter than the margin, so more must be paged in.  LHLD MARGLO reads
                                ;the word whose high byte is PGMARGN and whose low byte (MARGLO) is a fixed 0,
                                ;yielding PGMARGN*256 (WM does this as LHLD 272F).
  049F'                         PGNEED:				; WM 4361
  049F'   C5                    	PUSH	B
  04A0'   D5                    	PUSH	D
  04A1'   E5                    	PUSH	H
  04A2'   3A 0829'              	LDA	DIRFLG
  04A5'   B7                    	ORA	A
  04A6'   11 0000*              	LXI	D,TXTBEG
  04A9'   FA 04AF'              	JM	PGNCMP
  04AC'   11 0000*              	LXI	D,GAPEND
  04AF'                         PGNCMP:				 ; WM 4371 -- span the active edge, compare to margin
  04AF'   2A 0863'              	LHLD	MARGLO
  04B2'   EB                    	XCHG
  04B3'   CD 0000*              	CALL	PRSPAN
  04B6'   60                    	MOV	H,B
  04B7'   69                    	MOV	L,C
  04B8'   CD 0000*              	CALL	CMP16
  04BB'   C3 0000*              	JMP	POPRET
                                
                                ;SPILLB -- WM 4491: evict a batch of bottom (TXTEND-side) sectors via PAGEBOT.
  04BE'                         SPILLB:				; WM 4491
  04BE'   C5                    	PUSH	B
  04BF'   D5                    	PUSH	D
  04C0'   E5                    	PUSH	H
  04C1'   CD 04DE'              	CALL	PAGEBOT
  04C4'   DA 0000*              	JC	POPRET
  04C7'   3A 0865'              	LDA	IOBATCH
  04CA'   47                    	MOV	B,A
  04CB'   05                    	DCR	B
  04CC'   87                    	ADD	A
  04CD'   4F                    	MOV	C,A
  04CE'   0D                    	DCR	C
  04CF'                         SPBLP:				; WM 4504 -- evict-batch loop
  04CF'   CD 04DE'              	CALL	PAGEBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  04D2'   05                    	DCR	B
  04D3'   CA 04DA'              	JZ	SPBDON
  04D6'   0D                    	DCR	C
  04D7'   C2 04CF'              	JNZ	SPBLP
  04DA'                         SPBDON:				 ; WM 4511
  04DA'   B7                    	ORA	A
  04DB'   C3 0000*              	JMP	POPRET
                                
                                ;PAGEBOT -- WM 4520: evict the window's bottom sector back to the input side.
                                ;If it still aligns with the original, un-read the source (RECDEC); otherwise
                                ;write it to VIBACKUP$$$ -- SRCREC/BAKREC decide which.  Then TXTEND -= 128.
  04DE'                         PAGEBOT:			; WM 4520
  04DE'   2A 0000*              	LHLD	TXTEND
  04E1'   CD 03BB'              	CALL	INRDY
  04E4'   C2 04F6'              	JNZ	PBSTEP
  04E7'   3A 0824'              	LDA	INLEN
  04EA'   57                    	MOV	D,A
  04EB'   CD 05F9'              	CALL	SUBHA
  04EE'   E5                    	PUSH	H
  04EF'   7A                    	MOV	A,D
  04F0'   CD 02F8'              	CALL	STAGSEC
  04F3'   C3 04FB'              	JMP	PBRDLM
  04F6'                         PBSTEP:				 ; WM 4532 -- step back one sector at TXTEND
  04F6'   11 FF80               	LXI	D,0FF80H
  04F9'   19                    	DAD	D
  04FA'   E5                    	PUSH	H
  04FB'                         PBRDLM:				 ; WM 4537 -- check the read limit
  04FB'   E3                    	XTHL
  04FC'   CD 0463'              	CALL	CKRDLIM
  04FF'   E3                    	XTHL
  0500'   D2 0505'              	JNC	PBSRC
  0503'   E1                    	POP	H
  0504'   C9                    	RET
  0505'                         PBSRC:				; WM 4545 -- read from the source if its rec is due
  0505'   E5                    	PUSH	H
  0506'   2A 0820'              	LHLD	SRCREC
  0509'   EB                    	XCHG
  050A'   CD 05DA'              	CALL	RECBASE
  050D'   CD 0000*              	CALL	CMP16
  0510'   E1                    	POP	H
  0511'   D2 051D'              	JNC	PBBAK
  0514'   11 005C               	LXI	D,5CH
  0517'   CD 0744'              	CALL	RECDEC
  051A'   C3 0542'              	JMP	PBFIN
  051D'                         PBBAK:				; WM 4557 -- else read / recycle from the backup
  051D'   E5                    	PUSH	H
  051E'   2A 0822'              	LHLD	BAKREC
  0521'   EB                    	XCHG
  0522'   CD 05DA'              	CALL	RECBASE
  0525'   CD 0000*              	CALL	CMP16
  0528'   E1                    	POP	H
  0529'   11 07EA'              	LXI	D,BAKFCB
  052C'   D2 0535'              	JNC	PBWBAK
  052F'   CD 073D'              	CALL	RECINC
  0532'   C3 0542'              	JMP	PBFIN
  0535'                         PBWBAK:				 ; WM 4569 -- write back a backup record; step BAKREC
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0535'   CD 0737'              	CALL	WRRECP
  0538'   E5                    	PUSH	H
  0539'   2A 0822'              	LHLD	BAKREC
  053C'   2B                    	DCX	H
  053D'   22 0822'              	SHLD	BAKREC
  0540'   E1                    	POP	H
  0541'   04                    	INR	B
  0542'                         PBFIN:				; WM 4578 -- store new TXTEND; note input remaining
  0542'   CD 03BB'              	CALL	INRDY
  0545'   B7                    	ORA	A
  0546'   E1                    	POP	H
  0547'   22 0000*              	SHLD	TXTEND
  054A'   C9                    	RET
                                
                                ;REWIND -- WM 4755: scrolling back, re-read sectors previously spilled to
                                ;OUTFCB (by random record, stepping backward) and prepend them at TXTBEG.
                                ;Enabled only when OUTACT marks that text has actually been written out.
  054B'                         REWIND:				; WM 4755
  054B'   C5                    	PUSH	B
  054C'   D5                    	PUSH	D
  054D'   E5                    	PUSH	H
  054E'   3A 07C3'              	LDA	OUTACT
  0551'   B7                    	ORA	A
  0552'   37                    	STC
  0553'   CA 0586'              	JZ	RWNRET
  0556'   11 04BE'              	LXI	D,SPILLB
  0559'   21 0000*              	LXI	H,TXTBEG
  055C'   CD 03D5'              	CALL	RESVBUF
  055F'   2A 0000*              	LHLD	TXTBEG
  0562'                         RWNLP:				; WM 4768 -- re-read one output record backward
  0562'   CD 07BC'              	CALL	POLLBRK
  0565'   11 FF80               	LXI	D,0FF80H
  0568'   19                    	DAD	D
  0569'   11 07C4'              	LXI	D,OUTFCB
  056C'   CD 06C8'              	CALL	RDPREV
  056F'   DA 0585'              	JC	RWNDON
  0572'   22 0000*              	SHLD	TXTBEG
  0575'   CD 01F4'              	CALL	TLFSUB		; (appended) its line feeds are back in the
                                				;   window
  0578'   E5                    	PUSH	H
  0579'   2A 081C'              	LHLD	PGTOPM		; (appended) the window's top moved: 'u' reads
  057C'   23                    	INX	H		;   this to know its offsets have shifted
  057D'   22 081C'              	SHLD	PGTOPM
  0580'   E1                    	POP	H
  0581'   0D                    	DCR	C
  0582'   C2 0562'              	JNZ	RWNLP
  0585'                         RWNDON:				 ; WM 4779
  0585'   B7                    	ORA	A
  0586'                         RWNRET:				 ; WM 4782
  0586'   C3 0000*              	JMP	POPRET
                                
                                ;MARKGB -- WM 4886: UPDMARK only when HL points at GAPBEG (falls into UPDMARK).
  0589'                         MARKGB:				; WM 4886
  0589'   D5                    	PUSH	D
  058A'   11 0000*              	LXI	D,GAPBEG
  058D'   CD 0000*              	CALL	CMP16
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0590'   D1                    	POP	D
  0591'   C0                    	RNZ
                                ;UPDMARK -- WM 4898: after the gap moves, recompute the record marks that say
                                ;which records are in RAM: OUTREC (TXTBEG/output side, only rises) and SRCREC /
                                ;BAKREC (GAPEND/input side, only fall), via PTRREC + RECBASE.
  0592'                         UPDMARK:			; WM 4898
  0592'   C5                    	PUSH	B
  0593'   D5                    	PUSH	D
  0594'   E5                    	PUSH	H
  0595'   F5                    	PUSH	PSW
  0596'   21 0000*              	LXI	H,TXTBEG
  0599'   CD 05EB'              	CALL	PTRREC
  059C'   2A 07E6'              	LHLD	OUTPOS
  059F'   19                    	DAD	D
  05A0'   EB                    	XCHG
  05A1'   2A 081E'              	LHLD	OUTREC
  05A4'   CD 0000*              	CALL	CMP16
  05A7'   EB                    	XCHG
  05A8'   D2 05AE'              	JNC	UMKGAP
  05AB'   22 081E'              	SHLD	OUTREC
  05AE'                         UMKGAP:				 ; WM 4914 -- update the GAPEND-side marks
  05AE'   21 0000*              	LXI	H,GAPEND
  05B1'   CD 05EB'              	CALL	PTRREC
  05B4'   CD 05DA'              	CALL	RECBASE
  05B7'   CD 0000*              	CALL	SUBHD
  05BA'   EB                    	XCHG
  05BB'   2A 0820'              	LHLD	SRCREC
  05BE'   CD 0000*              	CALL	CMP16
  05C1'   EB                    	XCHG
  05C2'   DA 05C8'              	JC	UMKBAK
  05C5'   22 0820'              	SHLD	SRCREC
  05C8'                         UMKBAK:				 ; WM 4926 -- lower BAKREC if needed
  05C8'   EB                    	XCHG
  05C9'   2A 0822'              	LHLD	BAKREC
  05CC'   CD 0000*              	CALL	CMP16
  05CF'   EB                    	XCHG
  05D0'   DA 05D6'              	JC	UMKDON
  05D3'   22 0822'              	SHLD	BAKREC
  05D6'                         UMKDON:				 ; WM 4934
  05D6'   F1                    	POP	PSW
  05D7'   C3 0000*              	JMP	POPRET
                                
                                ;RECBASE -- WM 4939: disk record base for the buffer (BAKPOS - source_rec + 7FFF).
                                ;7EH is the source FCB's random-record word (FCB 005C + 22H).
  05DA'                         RECBASE:			; WM 4939
  05DA'   D5                    	PUSH	D
  05DB'   2A 080C'              	LHLD	BAKPOS
  05DE'   EB                    	XCHG
  05DF'   2A 007E               	LHLD	7EH
  05E2'   CD 0000*              	CALL	SUBHD
  05E5'   11 7FFF               	LXI	D,7FFFH
  05E8'   19                    	DAD	D
  05E9'   D1                    	POP	D
  05EA'   C9                    	RET
                                
                                ;PTRREC -- WM 4951: DE = record number (128-byte) for the pointer pair at HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  05EB'                         PTRREC:				; WM 4951
  05EB'   CD 0000*              	CALL	PRSPAN
  05EE'   60                    	MOV	H,B
  05EF'   69                    	MOV	L,C
  05F0'   29                    	DAD	H
  05F1'   5C                    	MOV	E,H
  05F2'   16 00                 	MVI	D,0H
  05F4'   D2 05F8'              	JNC	PTRRET
  05F7'   14                    	INR	D
  05F8'                         PTRRET:				 ; WM 4961
  05F8'   C9                    	RET
                                
                                ;SUBHA -- WM 2066: HL := HL - A.
  05F9'                         SUBHA:				; WM 2066
  05F9'   E5                    	PUSH	H
  05FA'   67                    	MOV	H,A
  05FB'   7D                    	MOV	A,L
  05FC'   94                    	SUB	H
  05FD'   E1                    	POP	H
  05FE'   6F                    	MOV	L,A
  05FF'   7C                    	MOV	A,H
  0600'   DE 00                 	SBI	0H
  0602'   67                    	MOV	H,A
  0603'   C9                    	RET
                                
