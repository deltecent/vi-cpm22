                                ;INRDY -- WM 4733: NZ while any input data is still unread.
  03B6'                         INRDY:				; WM 4733
  03B6'   E5                    	PUSH	H
  03B7'   3A 005B               	LDA	5BH
  03BA'   21 0000*              	LXI	H,BAKRDY
  03BD'   B6                    	ORA	M
  03BE'   37                    	STC
  03BF'   E1                    	POP	H
  03C0'   C9                    	RET
                                
                                ;MOREIN -- WM 4743: NZ if more input remains in the current direction
                                ;(WM's L26AA is OUTACT, the byte before OUTFCB).
  03C1'                         MOREIN:				; WM 4743
  03C1'   3A 0000*              	LDA	DIRFLG
  03C4'   B7                    	ORA	A
  03C5'   3A 0000*              	LDA	OUTACT
  03C8'   F4 03B6'              	CP	INRDY
  03CB'   B7                    	ORA	A
  03CC'   C9                    	RET
                                
