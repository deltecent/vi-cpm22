  0725'   4C 00                 
                                
                                ;WRSEC -- WM 5646: BDOS write-seq one record from [HL]; return disk status.
  0727'                         WRSEC:				; WM 5646
  0727'   CD 076D'              	CALL	SETRCW
  072A'   CD 060D'              	CALL	BDOSC
  072D'   15                    	DB	15H
  072E'   FE 01                 	CPI	1H
  0730'   C8                    	RZ
  0731'   FE FF                 	CPI	0FFH
  0733'   C8                    	RZ
  0734'   FE 02                 	CPI	2H
  0736'   C9                    	RET
                                
                                ;WRRECP -- WM 5674: poll ^C-break, then WRREC; WRRECA writes then advances.
  0737'                         WRRECP:				; WM 5674
  0737'   CD 07BC'              	CALL	POLLBRK
  073A'                         WRRECA:				; WM 5678
  073A'   CD 06E3'              	CALL	WRREC
                                ;RECINC -- WM 5682: FCB random-record number += 1.
  073D'                         RECINC:				; WM 5682
  073D'   C5                    	PUSH	B
  073E'   01 0001               	LXI	B,1H
  0741'   C3 0748'              	JMP	RECADJ
                                ;RECDEC -- WM 5688: FCB random-record number += -1.
  0744'                         RECDEC:				; WM 5688
  0744'   C5                    	PUSH	B
  0745'   01 FFFF               	LXI	B,0FFFFH
  0748'                         RECADJ:				 ; WM 5692 -- adjust FCB+22/23 by BC
  0748'   D5                    	PUSH	D
  0749'   E5                    	PUSH	H
  074A'   1B                    	DCX	D
  074B'   3E FF                 	MVI	A,0FFH
  074D'   12                    	STAX	D
  074E'   21 0023               	LXI	H,23H
  0751'   19                    	DAD	D
  0752'   E5                    	PUSH	H
  0753'   CD 0000*              	CALL	LDHLI
