  0401'   CD 0432'              	CALL	BUFFREE
  0404'   FE 08                 	CPI	BS
  0406'   DA 040C'              	JC	FRECOK
  0409'   D6 04                 	SUI	4H
  040B'   4F                    	MOV	C,A
  040C'                         FRECOK:				 ; WM 4813
  040C'   B7                    	ORA	A
  040D'   C0                    	RNZ
  040E'                         MEMSHT:				 ; WM 4817
  040E'   CD 0000*              	CALL	ERRMSG
  0411'   4D 45 4D 20           	DB	'MEM SHORTAGE, TRY CLEARING QBUF',0H
  0415'   53 48 4F 52           
  0419'   54 41 47 45           
  041D'   2C 20 54 52           
  0421'   59 20 43 4C           
  0425'   45 41 52 49           
  0429'   4E 47 20 51           
  042D'   42 55 46 00           
                                
                                ;DISPKEY -- WM 2846: PCHL trampoline (call the reserve routine held in HL).
  0431'                         DISPKEY:			; WM 2846
  0431'   E9                    	PCHL
                                
                                ;BUFFREE -- WM 4827: collapse the gap and report free bytes (A/C = pages).
  0432'                         BUFFREE:			; WM 4827
  0432'   CD 0000*              	CALL	PUTHOLE
  0435'   D5                    	PUSH	D
  0436'   CD 0000*              	CALL	BUFSUM
  0439'   E1                    	POP	H
  043A'   CD 0000*              	CALL	SUBCP2
  043D'   EB                    	XCHG
  043E'   29                    	DAD	H
  043F'                         BFRLP:				; WM 4836
  043F'   DA 043F'              	JC	BFRLP
  0442'   EB                    	XCHG
  0443'   7A                    	MOV	A,D
  0444'   4A                    	MOV	C,D
  0445'   C9                    	RET
                                
                                ;============================================================
                                ; SAVCLO -- WM 4846: flush all buffered text to OUTFCB and close it.
                                ;============================================================
  0446'                         SAVCLO:				; WM 4846
  0446'   CD 0355'              	CALL	FILLBF2
  0449'                         SAVLP:				; WM 4849 -- flush all, refill, repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0449'   CD 02EF'              	CALL	FLUSHTX
  044C'   CD 0355'              	CALL	FILLBF2
  044F'   D2 0449'              	JNC	SAVLP
  0452'   21 0000*              	LXI	H,TXTBEG
  0455'   CD 0000*              	CALL	PRSPAN
  0458'   CD 0000*              	CALL	LDHLI
  045B'   79                    	MOV	A,C
  045C'   CD 030D'              	CALL	STAGSEC
  045F'   11 07F0'              	LXI	D,OUTFCB
  0462'   CD 0763'              	CALL	WRRECP
  0465'   2A 0812'              	LHLD	OUTPOS		; DEVIATION (not WM): WM closes here.  Text
  0468'   EB                    	XCHG			;   that was paged out, rewound and then cut
  0469'   2A 084C'              	LHLD	OUTHI		;   short leaves the old records after the
  046C'   CD 0000*              	CALL	CMP16		;   last one, and CP/M cannot drop them.  A
  046F'   11 07F0'              	LXI	D,OUTFCB	;   part-filled last record hides them behind
  0472'   D2 0665'              	JNC	CLOSEF		;   its ^Z padding; a full one has none, and
  0475'   AF                    	XRA	A		;   the old text was read back as the file's
  0476'   CD 030D'              	CALL	STAGSEC		;   end.  So a record of ^Z goes over the
  0479'   CD 0763'              	CALL	WRRECP		;   first of them.  It is there already:
  047C'   C3 0665'              	JMP	CLOSEF		;   this write cannot fill the disk.
                                
                                ;CKWRLIM -- WM 4863: CY if GAPBEG is below the PAGEOUT write limit.
  047F'                         CKWRLIM:			; WM 4863
  047F'   E5                    	PUSH	H
  0480'   2A 0887'              	LHLD	WRLIM
  0483'   EB                    	XCHG
  0484'   2A 0000*              	LHLD	GAPBEG
  0487'   CD 0000*              	CALL	SUBHD
  048A'   EB                    	XCHG
  048B'   E1                    	POP	H
  048C'   C3 0000*              	JMP	CMP16
                                
                                ;CKRDLIM -- WM 4874: compare GAPEND against the read limit (PAGEBOT guard).
  048F'                         CKRDLIM:			; WM 4874
  048F'   E5                    	PUSH	H
  0490'   2A 0889'              	LHLD	RDLIM
  0493'   EB                    	XCHG
  0494'   2A 0000*              	LHLD	GAPEND
  0497'   19                    	DAD	D
  0498'   D1                    	POP	D
  0499'   CD 0000*              	CALL	CMP16
  049C'   EB                    	XCHG
  049D'   C9                    	RET
                                
                                ;============================================================
                                ; EVICTION SEAM + DEQUE MARKS.  Transcribed VERBATIM (WM 4335-4962).
                                ; MKGAP (BUF.MAC) reaches disk only here: MKROOM evicts a window edge (SPILL the
                                ; TXTBEG side to OUTFCB when scrolling forward, SPILLB the TXTEND side back to
                                ; the input/backup side when scrolling back).  UPDMARK keeps the three record
                                ; marks (OUTREC / SRCREC / BAKREC) that let PAGEOUT and PAGEBOT tell "already on
                                ; disk" from "must transfer", so nothing is written twice or lost.
                                ; PAGEDIR / PAGEWIN / PGNEED (scroll- and search-time paging) are real below:
                                ; PAGEDIR picks REWIND (backward, re-read spilled text) vs FILLBUF (forward),
                                ; and PGNEED / PAGEWIN keep PGMARGN bytes of text resident on the active edge.
                                ; The editor reaches them through BUF.MAC's PAGESTP and SCRLST (the line moves,
                                ; the line kill and the search sweep); PGBKTST drives PAGEDIR directly.
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;============================================================
                                
                                ;PAGEDIR -- WM 4320: page more text into the window in the current scroll
                                ;direction -- REWIND (re-read text previously spilled to OUTFCB) when DIRFLG is
                                ;backward, else FILLBUF (read more of the input) when forward.
  049E'                         PAGEDIR:			; WM 4320
  049E'   CD 07E8'              	CALL	POLLBRK
  04A1'   3A 0857'              	LDA	DIRFLG
  04A4'   B7                    	ORA	A
  04A5'   FA 0577'              	JM	REWIND
  04A8'   C3 036F'              	JMP	FILLBUF
                                
                                ;MKROOM -- WM 4335: free gap space by evicting a window edge (DIRFLG picks).
  04AB'                         MKROOM:				; WM 4335
  04AB'   3A 0857'              	LDA	DIRFLG
  04AE'   B7                    	ORA	A
  04AF'   37                    	STC
  04B0'   FC 04EA'              	CM	SPILLB
  04B3'   D0                    	RNC
  04B4'   CD 026E'              	CALL	SPILL
  04B7'   D0                    	RNC
  04B8'   C3 04EA'              	JMP	SPILLB
                                
                                ;PAGEWIN -- WM 4350: keep PGMARGN bytes of text buffered around the cursor on
                                ;the active edge (for a whole-file search); PAGEDIR one increment at a time
                                ;until PGNEED is satisfied or the source runs out.
  04BB'                         PAGEWIN:			; WM 4350
  04BB'   CD 04CB'              	CALL	PGNEED
  04BE'   D8                    	RC
  04BF'   CD 049E'              	CALL	PAGEDIR
  04C2'   D8                    	RC
  04C3'   CD 04CB'              	CALL	PGNEED
  04C6'   D4 049E'              	CNC	PAGEDIR
  04C9'   B7                    	ORA	A
  04CA'   C9                    	RET
                                
                                ;PGNEED -- WM 4361: CY if the active edge (TXTBEG scanning back, GAPEND scanning
                                ;forward) is still within PGMARGN*256 bytes -- i.e. the resident text on that
                                ;side is shorter than the margin, so more must be paged in.  LHLD MARGLO reads
                                ;the word whose high byte is PGMARGN and whose low byte (MARGLO) is a fixed 0,
                                ;yielding PGMARGN*256 (WM does this as LHLD 272F).
  04CB'                         PGNEED:				; WM 4361
  04CB'   C5                    	PUSH	B
  04CC'   D5                    	PUSH	D
  04CD'   E5                    	PUSH	H
  04CE'   3A 0857'              	LDA	DIRFLG
  04D1'   B7                    	ORA	A
  04D2'   11 0000*              	LXI	D,TXTBEG
  04D5'   FA 04DB'              	JM	PGNCMP
  04D8'   11 0000*              	LXI	D,GAPEND
  04DB'                         PGNCMP:				 ; WM 4371 -- span the active edge, compare to margin
  04DB'   2A 0891'              	LHLD	MARGLO
  04DE'   EB                    	XCHG
  04DF'   CD 0000*              	CALL	PRSPAN
  04E2'   60                    	MOV	H,B
  04E3'   69                    	MOV	L,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  04E4'   CD 0000*              	CALL	CMP16
  04E7'   C3 0000*              	JMP	POPRET
                                
                                ;SPILLB -- WM 4491: evict a batch of bottom (TXTEND-side) sectors via PAGEBOT.
  04EA'                         SPILLB:				; WM 4491
  04EA'   C5                    	PUSH	B
  04EB'   D5                    	PUSH	D
  04EC'   E5                    	PUSH	H
  04ED'   CD 050A'              	CALL	PAGEBOT
  04F0'   DA 0000*              	JC	POPRET
  04F3'   3A 0893'              	LDA	IOBATCH
  04F6'   47                    	MOV	B,A
  04F7'   05                    	DCR	B
  04F8'   87                    	ADD	A
  04F9'   4F                    	MOV	C,A
  04FA'   0D                    	DCR	C
  04FB'                         SPBLP:				; WM 4504 -- evict-batch loop
  04FB'   CD 050A'              	CALL	PAGEBOT
  04FE'   05                    	DCR	B
  04FF'   CA 0506'              	JZ	SPBDON
  0502'   0D                    	DCR	C
  0503'   C2 04FB'              	JNZ	SPBLP
  0506'                         SPBDON:				 ; WM 4511
  0506'   B7                    	ORA	A
  0507'   C3 0000*              	JMP	POPRET
                                
                                ;PAGEBOT -- WM 4520: evict the window's bottom sector back to the input side.
                                ;If it still aligns with the original, un-read the source (RECDEC); otherwise
                                ;write it to VIBACKUP$$$ -- SRCREC/BAKREC decide which.  Then TXTEND -= 128.
  050A'                         PAGEBOT:			; WM 4520
  050A'   2A 0000*              	LHLD	TXTEND
  050D'   CD 03D0'              	CALL	INRDY
  0510'   C2 0522'              	JNZ	PBSTEP
  0513'   3A 0852'              	LDA	INLEN
  0516'   57                    	MOV	D,A
  0517'   CD 0625'              	CALL	SUBHA
  051A'   E5                    	PUSH	H
  051B'   7A                    	MOV	A,D
  051C'   CD 030D'              	CALL	STAGSEC
  051F'   C3 0527'              	JMP	PBRDLM
  0522'                         PBSTEP:				 ; WM 4532 -- step back one sector at TXTEND
  0522'   11 FF80               	LXI	D,0FF80H
  0525'   19                    	DAD	D
  0526'   E5                    	PUSH	H
  0527'                         PBRDLM:				 ; WM 4537 -- check the read limit
  0527'   E3                    	XTHL
  0528'   CD 048F'              	CALL	CKRDLIM
  052B'   E3                    	XTHL
  052C'   D2 0531'              	JNC	PBSRC
  052F'   E1                    	POP	H
  0530'   C9                    	RET
  0531'                         PBSRC:				; WM 4545 -- read from the source if its rec is due
  0531'   E5                    	PUSH	H
  0532'   2A 084E'              	LHLD	SRCREC
  0535'   EB                    	XCHG
  0536'   CD 0606'              	CALL	RECBASE
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0539'   CD 0000*              	CALL	CMP16
  053C'   E1                    	POP	H
  053D'   D2 0549'              	JNC	PBBAK
  0540'   11 005C               	LXI	D,5CH
  0543'   CD 0770'              	CALL	RECDEC
  0546'   C3 056E'              	JMP	PBFIN
  0549'                         PBBAK:				; WM 4557 -- else read / recycle from the backup
  0549'   E5                    	PUSH	H
  054A'   2A 0850'              	LHLD	BAKREC
  054D'   EB                    	XCHG
  054E'   CD 0606'              	CALL	RECBASE
  0551'   CD 0000*              	CALL	CMP16
  0554'   E1                    	POP	H
  0555'   11 0816'              	LXI	D,BAKFCB
  0558'   D2 0561'              	JNC	PBWBAK
  055B'   CD 0769'              	CALL	RECINC
  055E'   C3 056E'              	JMP	PBFIN
  0561'                         PBWBAK:				 ; WM 4569 -- write back a backup record; step BAKREC
  0561'   CD 0763'              	CALL	WRRECP
  0564'   E5                    	PUSH	H
  0565'   2A 0850'              	LHLD	BAKREC
  0568'   2B                    	DCX	H
  0569'   22 0850'              	SHLD	BAKREC
  056C'   E1                    	POP	H
  056D'   04                    	INR	B
  056E'                         PBFIN:				; WM 4578 -- store new TXTEND; note input remaining
  056E'   CD 03D0'              	CALL	INRDY
  0571'   B7                    	ORA	A
  0572'   E1                    	POP	H
  0573'   22 0000*              	SHLD	TXTEND
  0576'   C9                    	RET
                                
                                ;REWIND -- WM 4755: scrolling back, re-read sectors previously spilled to
                                ;OUTFCB (by random record, stepping backward) and prepend them at TXTBEG.
                                ;Enabled only when OUTACT marks that text has actually been written out.
  0577'                         REWIND:				; WM 4755
  0577'   C5                    	PUSH	B
  0578'   D5                    	PUSH	D
  0579'   E5                    	PUSH	H
  057A'   3A 07EF'              	LDA	OUTACT
  057D'   B7                    	ORA	A
  057E'   37                    	STC
  057F'   CA 05B2'              	JZ	RWNRET
  0582'   11 04EA'              	LXI	D,SPILLB
  0585'   21 0000*              	LXI	H,TXTBEG
  0588'   CD 03EA'              	CALL	RESVBUF
  058B'   2A 0000*              	LHLD	TXTBEG
  058E'                         RWNLP:				; WM 4768 -- re-read one output record backward
  058E'   CD 07E8'              	CALL	POLLBRK
  0591'   11 FF80               	LXI	D,0FF80H
  0594'   19                    	DAD	D
  0595'   11 07F0'              	LXI	D,OUTFCB
  0598'   CD 06F4'              	CALL	RDPREV
  059B'   DA 05B1'              	JC	RWNDON
  059E'   22 0000*              	SHLD	TXTBEG
  05A1'   CD 01F7'              	CALL	TLFSUB		; (appended) its line feeds are back in the
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                				;   window
  05A4'   E5                    	PUSH	H
  05A5'   2A 0848'              	LHLD	PGTOPM		; (appended) the window's top moved: 'u' reads
  05A8'   23                    	INX	H		;   this to know its offsets have shifted
  05A9'   22 0848'              	SHLD	PGTOPM
  05AC'   E1                    	POP	H
  05AD'   0D                    	DCR	C
  05AE'   C2 058E'              	JNZ	RWNLP
  05B1'                         RWNDON:				 ; WM 4779
  05B1'   B7                    	ORA	A
  05B2'                         RWNRET:				 ; WM 4782
  05B2'   C3 0000*              	JMP	POPRET
                                
                                ;MARKGB -- WM 4886: UPDMARK only when HL points at GAPBEG (falls into UPDMARK).
  05B5'                         MARKGB:				; WM 4886
  05B5'   D5                    	PUSH	D
  05B6'   11 0000*              	LXI	D,GAPBEG
  05B9'   CD 0000*              	CALL	CMP16
  05BC'   D1                    	POP	D
  05BD'   C0                    	RNZ
                                ;UPDMARK -- WM 4898: after the gap moves, recompute the record marks that say
                                ;which records are in RAM: OUTREC (TXTBEG/output side, only rises) and SRCREC /
                                ;BAKREC (GAPEND/input side, only fall), via PTRREC + RECBASE.
  05BE'                         UPDMARK:			; WM 4898
  05BE'   C5                    	PUSH	B
  05BF'   D5                    	PUSH	D
  05C0'   E5                    	PUSH	H
  05C1'   F5                    	PUSH	PSW
  05C2'   21 0000*              	LXI	H,TXTBEG
  05C5'   CD 0617'              	CALL	PTRREC
  05C8'   2A 0812'              	LHLD	OUTPOS
  05CB'   19                    	DAD	D
  05CC'   EB                    	XCHG
  05CD'   2A 084A'              	LHLD	OUTREC
  05D0'   CD 0000*              	CALL	CMP16
  05D3'   EB                    	XCHG
  05D4'   D2 05DA'              	JNC	UMKGAP
  05D7'   22 084A'              	SHLD	OUTREC
  05DA'                         UMKGAP:				 ; WM 4914 -- update the GAPEND-side marks
  05DA'   21 0000*              	LXI	H,GAPEND
  05DD'   CD 0617'              	CALL	PTRREC
  05E0'   CD 0606'              	CALL	RECBASE
  05E3'   CD 0000*              	CALL	SUBHD
  05E6'   EB                    	XCHG
  05E7'   2A 084E'              	LHLD	SRCREC
  05EA'   CD 0000*              	CALL	CMP16
  05ED'   EB                    	XCHG
  05EE'   DA 05F4'              	JC	UMKBAK
  05F1'   22 084E'              	SHLD	SRCREC
  05F4'                         UMKBAK:				 ; WM 4926 -- lower BAKREC if needed
  05F4'   EB                    	XCHG
  05F5'   2A 0850'              	LHLD	BAKREC
  05F8'   CD 0000*              	CALL	CMP16
  05FB'   EB                    	XCHG
  05FC'   DA 0602'              	JC	UMKDON
  05FF'   22 0850'              	SHLD	BAKREC
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0602'                         UMKDON:				 ; WM 4934
  0602'   F1                    	POP	PSW
  0603'   C3 0000*              	JMP	POPRET
                                
                                ;RECBASE -- WM 4939: disk record base for the buffer (BAKPOS - source_rec + 7FFF).
                                ;7EH is the source FCB's random-record word (FCB 005C + 22H).
  0606'                         RECBASE:			; WM 4939
  0606'   D5                    	PUSH	D
  0607'   2A 0838'              	LHLD	BAKPOS
  060A'   EB                    	XCHG
  060B'   2A 007E               	LHLD	7EH
  060E'   CD 0000*              	CALL	SUBHD
  0611'   11 7FFF               	LXI	D,7FFFH
  0614'   19                    	DAD	D
  0615'   D1                    	POP	D
  0616'   C9                    	RET
                                
                                ;PTRREC -- WM 4951: DE = record number (128-byte) for the pointer pair at HL.
  0617'                         PTRREC:				; WM 4951
  0617'   CD 0000*              	CALL	PRSPAN
  061A'   60                    	MOV	H,B
  061B'   69                    	MOV	L,C
  061C'   29                    	DAD	H
  061D'   5C                    	MOV	E,H
  061E'   16 00                 	MVI	D,0H
  0620'   D2 0624'              	JNC	PTRRET
  0623'   14                    	INR	D
  0624'                         PTRRET:				 ; WM 4961
  0624'   C9                    	RET
                                
                                ;SUBHA -- WM 2066: HL := HL - A.
  0625'                         SUBHA:				; WM 2066
  0625'   E5                    	PUSH	H
