                                ;OPENF -- WM 5438: BDOS-open the FCB at DE, then zero its random-record bytes.
  061E'                         OPENF:				; WM 5438
  061E'   CD 0604'              	CALL	BDOSFN
  0621'   0F                    	DB	0FH
  0622'   3C                    	INR	A
