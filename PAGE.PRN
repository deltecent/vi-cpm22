  0407'   59 20 43 4C           
  040B'   45 41 52 49           
  040F'   4E 47 20 51           
  0413'   42 55 46 00           
                                
                                ;DISPKEY -- WM 2846: PCHL trampoline (call the reserve routine held in HL).
  0417'                         DISPKEY:			; WM 2846
  0417'   E9                    	PCHL
                                
                                ;BUFFREE -- WM 4827: collapse the gap and report free bytes (A/C = pages).
  0418'                         BUFFREE:			; WM 4827
  0418'   CD 0000*              	CALL	PUTHOLE
  041B'   D5                    	PUSH	D
  041C'   CD 0000*              	CALL	BUFSUM
  041F'   E1                    	POP	H
  0420'   CD 0000*              	CALL	SUBCP2
  0423'   EB                    	XCHG
  0424'   29                    	DAD	H
  0425'                         BFRLP:				; WM 4836
  0425'   DA 0425'              	JC	BFRLP
  0428'   EB                    	XCHG
  0429'   7A                    	MOV	A,D
  042A'   4A                    	MOV	C,D
  042B'   C9                    	RET
                                
                                ;============================================================
                                ; SAVCLO -- WM 4846: flush all buffered text to OUTFCB and close it.
                                ;============================================================
  042C'                         SAVCLO:				; WM 4846
  042C'   CD 033B'              	CALL	FILLBF2
  042F'                         SAVLP:				; WM 4849 -- flush all, refill, repeat
  042F'   CD 02D5'              	CALL	FLUSHTX
  0432'   CD 033B'              	CALL	FILLBF2
  0435'   D2 042F'              	JNC	SAVLP
  0438'   21 0000*              	LXI	H,TXTBEG
  043B'   CD 0000*              	CALL	PRSPAN
  043E'   CD 0000*              	CALL	LDHLI
  0441'   79                    	MOV	A,C
  0442'   CD 02F3'              	CALL	STAGSEC
  0445'   11 0000*              	LXI	D,OUTFCB
  0448'   CD 0749'              	CALL	WRRECP
  044B'   2A 0000*              	LHLD	OUTPOS		; DEVIATION (not WM): WM closes here.  Text
  044E'   EB                    	XCHG			;   that was paged out, rewound and then cut
  044F'   2A 0000*              	LHLD	OUTHI		;   short leaves the old records after the
  0452'   CD 0000*              	CALL	CMP16		;   last one, and CP/M cannot drop them.  A
  0455'   11 0000*              	LXI	D,OUTFCB	;   part-filled last record hides them behind
  0458'   D2 064B'              	JNC	CLOSEF		;   its ^Z padding; a full one has none, and
  045B'   AF                    	XRA	A		;   the old text was read back as the file's
  045C'   CD 02F3'              	CALL	STAGSEC		;   end.  So a record of ^Z goes over the
  045F'   CD 0749'              	CALL	WRRECP		;   first of them.  It is there already:
  0462'   C3 064B'              	JMP	CLOSEF		;   this write cannot fill the disk.
                                
                                ;CKWRLIM -- WM 4863: CY if GAPBEG is below the PAGEOUT write limit.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0465'                         CKWRLIM:			; WM 4863
  0465'   E5                    	PUSH	H
  0466'   2A 0000*              	LHLD	WRLIM
  0469'   EB                    	XCHG
  046A'   2A 0000*              	LHLD	GAPBEG
  046D'   CD 0000*              	CALL	SUBHD
  0470'   EB                    	XCHG
  0471'   E1                    	POP	H
  0472'   C3 0000*              	JMP	CMP16
                                
                                ;CKRDLIM -- WM 4874: compare GAPEND against the read limit (PAGEBOT guard).
  0475'                         CKRDLIM:			; WM 4874
  0475'   E5                    	PUSH	H
  0476'   2A 0000*              	LHLD	RDLIM
  0479'   EB                    	XCHG
  047A'   2A 0000*              	LHLD	GAPEND
  047D'   19                    	DAD	D
  047E'   D1                    	POP	D
  047F'   CD 0000*              	CALL	CMP16
  0482'   EB                    	XCHG
  0483'   C9                    	RET
                                
                                ;============================================================
                                ; EVICTION SEAM + DEQUE MARKS.  Transcribed VERBATIM (WM 4335-4962).
                                ; MKGAP (BUF.MAC) reaches disk only here: MKROOM evicts a window edge (SPILL the
                                ; TXTBEG side to OUTFCB when scrolling forward, SPILLB the TXTEND side back to
                                ; the input/backup side when scrolling back).  UPDMARK keeps the three record
                                ; marks (OUTREC / SRCREC / BAKREC) that let PAGEOUT and PAGEBOT tell "already on
                                ; disk" from "must transfer", so nothing is written twice or lost.
                                ; PAGEDIR / PAGEWIN / PGNEED (scroll- and search-time paging) are real below:
                                ; PAGEDIR picks REWIND (backward, re-read spilled text) vs FILLBUF (forward),
                                ; and PGNEED / PAGEWIN keep PGMARGN bytes of text resident on the active edge.
                                ; The editor reaches them through BUF.MAC's PAGESTP and SCRLST (the line moves,
                                ; the line kill and the search sweep); PGBKTST drives PAGEDIR directly.
                                ;============================================================
                                
                                ;PAGEDIR -- WM 4320: page more text into the window in the current scroll
                                ;direction -- REWIND (re-read text previously spilled to OUTFCB) when DIRFLG is
                                ;backward, else FILLBUF (read more of the input) when forward.
  0484'                         PAGEDIR:			; WM 4320
  0484'   CD 07CE'              	CALL	POLLBRK
  0487'   3A 0000*              	LDA	DIRFLG
  048A'   B7                    	ORA	A
  048B'   FA 055D'              	JM	REWIND
  048E'   C3 0355'              	JMP	FILLBUF
                                
                                ;MKROOM -- WM 4335: free gap space by evicting a window edge (DIRFLG picks).
  0491'                         MKROOM:				; WM 4335
  0491'   3A 0000*              	LDA	DIRFLG
  0494'   B7                    	ORA	A
  0495'   37                    	STC
  0496'   FC 04D0'              	CM	SPILLB
  0499'   D0                    	RNC
  049A'   CD 0254'              	CALL	SPILL
  049D'   D0                    	RNC
  049E'   C3 04D0'              	JMP	SPILLB
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                
                                ;PAGEWIN -- WM 4350: keep PGMARGN bytes of text buffered around the cursor on
                                ;the active edge (for a whole-file search); PAGEDIR one increment at a time
                                ;until PGNEED is satisfied or the source runs out.
  04A1'                         PAGEWIN:			; WM 4350
  04A1'   CD 04B1'              	CALL	PGNEED
  04A4'   D8                    	RC
  04A5'   CD 0484'              	CALL	PAGEDIR
  04A8'   D8                    	RC
  04A9'   CD 04B1'              	CALL	PGNEED
  04AC'   D4 0484'              	CNC	PAGEDIR
  04AF'   B7                    	ORA	A
  04B0'   C9                    	RET
                                
                                ;PGNEED -- WM 4361: CY if the active edge (TXTBEG scanning back, GAPEND scanning
                                ;forward) is still within PGMARGN*256 bytes -- i.e. the resident text on that
                                ;side is shorter than the margin, so more must be paged in.  LHLD MARGLO reads
                                ;the word whose high byte is PGMARGN and whose low byte (MARGLO) is a fixed 0,
                                ;yielding PGMARGN*256 (WM does this as LHLD 272F).
  04B1'                         PGNEED:				; WM 4361
  04B1'   C5                    	PUSH	B
  04B2'   D5                    	PUSH	D
  04B3'   E5                    	PUSH	H
  04B4'   3A 0000*              	LDA	DIRFLG
  04B7'   B7                    	ORA	A
  04B8'   11 0000*              	LXI	D,TXTBEG
  04BB'   FA 04C1'              	JM	PGNCMP
  04BE'   11 0000*              	LXI	D,GAPEND
  04C1'                         PGNCMP:				 ; WM 4371 -- span the active edge, compare to margin
  04C1'   2A 0000*              	LHLD	MARGLO
  04C4'   EB                    	XCHG
  04C5'   CD 0000*              	CALL	PRSPAN
  04C8'   60                    	MOV	H,B
  04C9'   69                    	MOV	L,C
  04CA'   CD 0000*              	CALL	CMP16
  04CD'   C3 0000*              	JMP	POPRET
                                
                                ;SPILLB -- WM 4491: evict a batch of bottom (TXTEND-side) sectors via PAGEBOT.
  04D0'                         SPILLB:				; WM 4491
  04D0'   C5                    	PUSH	B
  04D1'   D5                    	PUSH	D
  04D2'   E5                    	PUSH	H
  04D3'   CD 04F0'              	CALL	PAGEBOT
  04D6'   DA 0000*              	JC	POPRET
  04D9'   3A 0000*              	LDA	IOBATCH
  04DC'   47                    	MOV	B,A
  04DD'   05                    	DCR	B
  04DE'   87                    	ADD	A
  04DF'   4F                    	MOV	C,A
  04E0'   0D                    	DCR	C
  04E1'                         SPBLP:				; WM 4504 -- evict-batch loop
  04E1'   CD 04F0'              	CALL	PAGEBOT
  04E4'   05                    	DCR	B
  04E5'   CA 04EC'              	JZ	SPBDON
  04E8'   0D                    	DCR	C
  04E9'   C2 04E1'              	JNZ	SPBLP
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  04EC'                         SPBDON:				 ; WM 4511
  04EC'   B7                    	ORA	A
  04ED'   C3 0000*              	JMP	POPRET
                                
                                ;PAGEBOT -- WM 4520: evict the window's bottom sector back to the input side.
                                ;If it still aligns with the original, un-read the source (RECDEC); otherwise
                                ;write it to VIBACKUP$$$ -- SRCREC/BAKREC decide which.  Then TXTEND -= 128.
  04F0'                         PAGEBOT:			; WM 4520
  04F0'   2A 0000*              	LHLD	TXTEND
  04F3'   CD 03B6'              	CALL	INRDY
  04F6'   C2 0508'              	JNZ	PBSTEP
  04F9'   3A 0000*              	LDA	INLEN
  04FC'   57                    	MOV	D,A
  04FD'   CD 060B'              	CALL	SUBHA
  0500'   E5                    	PUSH	H
  0501'   7A                    	MOV	A,D
  0502'   CD 02F3'              	CALL	STAGSEC
  0505'   C3 050D'              	JMP	PBRDLM
  0508'                         PBSTEP:				 ; WM 4532 -- step back one sector at TXTEND
  0508'   11 FF80               	LXI	D,0FF80H
  050B'   19                    	DAD	D
  050C'   E5                    	PUSH	H
  050D'                         PBRDLM:				 ; WM 4537 -- check the read limit
  050D'   E3                    	XTHL
  050E'   CD 0475'              	CALL	CKRDLIM
  0511'   E3                    	XTHL
  0512'   D2 0517'              	JNC	PBSRC
  0515'   E1                    	POP	H
  0516'   C9                    	RET
  0517'                         PBSRC:				; WM 4545 -- read from the source if its rec is due
  0517'   E5                    	PUSH	H
  0518'   2A 0000*              	LHLD	SRCREC
  051B'   EB                    	XCHG
  051C'   CD 05EC'              	CALL	RECBASE
  051F'   CD 0000*              	CALL	CMP16
  0522'   E1                    	POP	H
  0523'   D2 052F'              	JNC	PBBAK
  0526'   11 005C               	LXI	D,5CH
  0529'   CD 0756'              	CALL	RECDEC
  052C'   C3 0554'              	JMP	PBFIN
  052F'                         PBBAK:				; WM 4557 -- else read / recycle from the backup
  052F'   E5                    	PUSH	H
  0530'   2A 0000*              	LHLD	BAKREC
  0533'   EB                    	XCHG
  0534'   CD 05EC'              	CALL	RECBASE
  0537'   CD 0000*              	CALL	CMP16
  053A'   E1                    	POP	H
  053B'   11 0000*              	LXI	D,BAKFCB
  053E'   D2 0547'              	JNC	PBWBAK
  0541'   CD 074F'              	CALL	RECINC
  0544'   C3 0554'              	JMP	PBFIN
  0547'                         PBWBAK:				 ; WM 4569 -- write back a backup record; step BAKREC
  0547'   CD 0749'              	CALL	WRRECP
  054A'   E5                    	PUSH	H
  054B'   2A 0000*              	LHLD	BAKREC
  054E'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  054F'   22 0000*              	SHLD	BAKREC
  0552'   E1                    	POP	H
  0553'   04                    	INR	B
  0554'                         PBFIN:				; WM 4578 -- store new TXTEND; note input remaining
  0554'   CD 03B6'              	CALL	INRDY
  0557'   B7                    	ORA	A
  0558'   E1                    	POP	H
  0559'   22 0000*              	SHLD	TXTEND
  055C'   C9                    	RET
                                
                                ;REWIND -- WM 4755: scrolling back, re-read sectors previously spilled to
                                ;OUTFCB (by random record, stepping backward) and prepend them at TXTBEG.
                                ;Enabled only when OUTACT marks that text has actually been written out.
  055D'                         REWIND:				; WM 4755
  055D'   C5                    	PUSH	B
  055E'   D5                    	PUSH	D
  055F'   E5                    	PUSH	H
  0560'   3A 0000*              	LDA	OUTACT
  0563'   B7                    	ORA	A
  0564'   37                    	STC
  0565'   CA 0598'              	JZ	RWNRET
  0568'   11 04D0'              	LXI	D,SPILLB
  056B'   21 0000*              	LXI	H,TXTBEG
  056E'   CD 03D0'              	CALL	RESVBUF
  0571'   2A 0000*              	LHLD	TXTBEG
  0574'                         RWNLP:				; WM 4768 -- re-read one output record backward
  0574'   CD 07CE'              	CALL	POLLBRK
  0577'   11 FF80               	LXI	D,0FF80H
  057A'   19                    	DAD	D
  057B'   11 0000*              	LXI	D,OUTFCB
  057E'   CD 06DA'              	CALL	RDPREV
  0581'   DA 0597'              	JC	RWNDON
  0584'   22 0000*              	SHLD	TXTBEG
  0587'   CD 01DD'              	CALL	TLFSUB		; (appended) its line feeds are back in the
                                				;   window
  058A'   E5                    	PUSH	H
  058B'   2A 0000*              	LHLD	PGTOPM		; (appended) the window's top moved: 'u' reads
  058E'   23                    	INX	H		;   this to know its offsets have shifted
  058F'   22 0000*              	SHLD	PGTOPM
  0592'   E1                    	POP	H
  0593'   0D                    	DCR	C
  0594'   C2 0574'              	JNZ	RWNLP
  0597'                         RWNDON:				 ; WM 4779
  0597'   B7                    	ORA	A
  0598'                         RWNRET:				 ; WM 4782
  0598'   C3 0000*              	JMP	POPRET
                                
                                ;MARKGB -- WM 4886: UPDMARK only when HL points at GAPBEG (falls into UPDMARK).
  059B'                         MARKGB:				; WM 4886
  059B'   D5                    	PUSH	D
  059C'   11 0000*              	LXI	D,GAPBEG
  059F'   CD 0000*              	CALL	CMP16
  05A2'   D1                    	POP	D
  05A3'   C0                    	RNZ
                                ;UPDMARK -- WM 4898: after the gap moves, recompute the record marks that say
                                ;which records are in RAM: OUTREC (TXTBEG/output side, only rises) and SRCREC /
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                ;BAKREC (GAPEND/input side, only fall), via PTRREC + RECBASE.
  05A4'                         UPDMARK:			; WM 4898
  05A4'   C5                    	PUSH	B
  05A5'   D5                    	PUSH	D
  05A6'   E5                    	PUSH	H
  05A7'   F5                    	PUSH	PSW
  05A8'   21 0000*              	LXI	H,TXTBEG
  05AB'   CD 05FD'              	CALL	PTRREC
  05AE'   2A 0000*              	LHLD	OUTPOS
  05B1'   19                    	DAD	D
  05B2'   EB                    	XCHG
  05B3'   2A 0000*              	LHLD	OUTREC
  05B6'   CD 0000*              	CALL	CMP16
  05B9'   EB                    	XCHG
  05BA'   D2 05C0'              	JNC	UMKGAP
  05BD'   22 0000*              	SHLD	OUTREC
  05C0'                         UMKGAP:				 ; WM 4914 -- update the GAPEND-side marks
  05C0'   21 0000*              	LXI	H,GAPEND
  05C3'   CD 05FD'              	CALL	PTRREC
  05C6'   CD 05EC'              	CALL	RECBASE
  05C9'   CD 0000*              	CALL	SUBHD
  05CC'   EB                    	XCHG
  05CD'   2A 0000*              	LHLD	SRCREC
  05D0'   CD 0000*              	CALL	CMP16
  05D3'   EB                    	XCHG
  05D4'   DA 05DA'              	JC	UMKBAK
  05D7'   22 0000*              	SHLD	SRCREC
  05DA'                         UMKBAK:				 ; WM 4926 -- lower BAKREC if needed
  05DA'   EB                    	XCHG
  05DB'   2A 0000*              	LHLD	BAKREC
  05DE'   CD 0000*              	CALL	CMP16
  05E1'   EB                    	XCHG
  05E2'   DA 05E8'              	JC	UMKDON
  05E5'   22 0000*              	SHLD	BAKREC
  05E8'                         UMKDON:				 ; WM 4934
  05E8'   F1                    	POP	PSW
  05E9'   C3 0000*              	JMP	POPRET
                                
                                ;RECBASE -- WM 4939: disk record base for the buffer (BAKPOS - source_rec + 7FFF).
                                ;7EH is the source FCB's random-record word (FCB 005C + 22H).
  05EC'                         RECBASE:			; WM 4939
  05EC'   D5                    	PUSH	D
  05ED'   2A 0000*              	LHLD	BAKPOS
  05F0'   EB                    	XCHG
  05F1'   2A 007E               	LHLD	7EH
  05F4'   CD 0000*              	CALL	SUBHD
  05F7'   11 7FFF               	LXI	D,7FFFH
  05FA'   19                    	DAD	D
  05FB'   D1                    	POP	D
  05FC'   C9                    	RET
                                
                                ;PTRREC -- WM 4951: DE = record number (128-byte) for the pointer pair at HL.
  05FD'                         PTRREC:				; WM 4951
  05FD'   CD 0000*              	CALL	PRSPAN
  0600'   60                    	MOV	H,B
  0601'   69                    	MOV	L,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0602'   29                    	DAD	H
  0603'   5C                    	MOV	E,H
  0604'   16 00                 	MVI	D,0H
  0606'   D2 060A'              	JNC	PTRRET
  0609'   14                    	INR	D
  060A'                         PTRRET:				 ; WM 4961
  060A'   C9                    	RET
                                
                                ;SUBHA -- WM 2066: HL := HL - A.
  060B'                         SUBHA:				; WM 2066
  060B'   E5                    	PUSH	H
  060C'   67                    	MOV	H,A
  060D'   7D                    	MOV	A,L
  060E'   94                    	SUB	H
  060F'   E1                    	POP	H
  0610'   6F                    	MOV	L,A
  0611'   7C                    	MOV	A,H
  0612'   DE 00                 	SBI	0H
  0614'   67                    	MOV	H,A
  0615'   C9                    	RET
                                
