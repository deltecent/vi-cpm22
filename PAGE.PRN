  02A3'   D8                    	RC
  02A4'   E5                    	PUSH	H
  02A5'   2A 0812'              	LHLD	OUTPOS
  02A8'   EB                    	XCHG
  02A9'   2A 084A'              	LHLD	OUTREC
  02AC'   CD 0000*              	CALL	CMP16
  02AF'   E1                    	POP	H
  02B0'   11 07F0'              	LXI	D,OUTFCB
  02B3'   D2 02BC'              	JNC	POFRSH
  02B6'   CD 0769'              	CALL	RECINC
  02B9'   C3 02DB'              	JMP	POADV
  02BC'                         POFRSH:				 ; WM 4454 -- write a fresh output record
  02BC'   CD 0763'              	CALL	WRRECP
  02BF'   EB                    	XCHG
  02C0'   2A 084A'              	LHLD	OUTREC
  02C3'   23                    	INX	H
  02C4'   22 084A'              	SHLD	OUTREC
  02C7'   D5                    	PUSH	D		; (appended) OUTHI follows the most records
  02C8'   2A 084C'              	LHLD	OUTHI		;   name.$$$ has ever held; OUTREC cannot
  02CB'   EB                    	XCHG			;   say, an edit behind it brings it down
  02CC'   2A 0812'              	LHLD	OUTPOS
  02CF'   CD 0000*              	CALL	CMP16
  02D2'   D2 02D8'              	JNC	POHI
  02D5'   22 084C'              	SHLD	OUTHI
  02D8'   D1                    POHI:	POP	D
  02D9'   EB                    	XCHG
  02DA'   04                    	INR	B
  02DB'                         POADV:				; WM 4463 -- advance TXTBEG past the sector
  02DB'   CD 01E9'              	CALL	TLFADD		; (appended) its line feeds are behind the
                                				;   window now
  02DE'   11 0080               	LXI	D,80H
  02E1'   19                    	DAD	D
  02E2'   22 0000*              	SHLD	TXTBEG
  02E5'   E5                    	PUSH	H
  02E6'   2A 0848'              	LHLD	PGTOPM		; (appended) the window's top moved: 'u' reads
  02E9'   23                    	INX	H		;   this to know its offsets have shifted
  02EA'   22 0848'              	SHLD	PGTOPM
  02ED'   E1                    	POP	H
  02EE'   C9                    	RET
                                
                                ;FLUSHTX -- WM 4471: collapse the gap and PAGEOUT every remaining sector.
  02EF'                         FLUSHTX:			; WM 4471
  02EF'   C5                    	PUSH	B
  02F0'   D5                    	PUSH	D
  02F1'   E5                    	PUSH	H
  02F2'   21 0081               	LXI	H,81H
  02F5'   22 0887'              	SHLD	WRLIM
  02F8'   21 0000*              	LXI	H,BUFEND
  02FB'   CD 0000*              	CALL	PUTHOLE
  02FE'   2A 0000*              	LHLD	TXTEND
  0301'   CD 0000*              	CALL	PUTCUR
  0304'                         FLXLP:				; WM 4482 -- flush loop
  0304'   CD 029D'              	CALL	PAGEOUT
  0307'   D2 0304'              	JNC	FLXLP
  030A'   C3 0000*              	JMP	POPRET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ;STAGSEC -- WM 4588: stage a short final record into SECBUF, ^Z-pad the tail.
  030D'                         STAGSEC:			; WM 4588
  030D'   C5                    	PUSH	B
  030E'   D5                    	PUSH	D
  030F'   11 0000*              	LXI	D,SECBUF
  0312'   D5                    	PUSH	D
  0313'   47                    	MOV	B,A
  0314'   0E 82                 	MVI	C,82H
  0316'   04                    	INR	B
  0317'   2B                    	DCX	H
  0318'   1B                    	DCX	D
  0319'                         STGCPY:				 ; WM 4599 -- copy the partial sector
  0319'   7E                    	MOV	A,M
  031A'   12                    	STAX	D
  031B'   23                    	INX	H
  031C'   13                    	INX	D
  031D'   0D                    	DCR	C
  031E'   05                    	DCR	B
  031F'   C2 0319'              	JNZ	STGCPY
  0322'                         STGPAD:				 ; WM 4608 -- pad the rest with ^Z
  0322'   3E 1A                 	MVI	A,EOF
  0324'   12                    	STAX	D
  0325'   13                    	INX	D
  0326'   0D                    	DCR	C
  0327'   C2 0322'              	JNZ	STGPAD
  032A'   C3 0000*              	JMP	POPRET
                                
                                ;============================================================
                                ; FILLBUF / RDIN / CLNSEC -- the input (read) side.
                                ;============================================================
                                
                                ;NEEDIN -- WM 4617: page input in when the forward read (RGET) runs dry.
                                ;SPILL first if free space is under a record, then reserve and fill.
  032D'                         NEEDIN:				; WM 4617
  032D'   CD 03D0'              	CALL	INRDY
  0330'   C8                    	RZ
  0331'   C5                    	PUSH	B
  0332'   D5                    	PUSH	D
  0333'   E5                    	PUSH	H
  0334'   CD 0000*              	CALL	BUFSUM
  0337'   21 0080               	LXI	H,80H
