  077A'   E6 7F                 	ANI	7FH
  077C'   4F                    	MOV	C,A
  077D'   29                    	DAD	H
  077E'   7C                    	MOV	A,H
  077F'   21 000C               	LXI	H,0CH
  0782'   19                    	DAD	D
  0783'   BE                    	CMP	M
  0784'   CA 07A8'              	JZ	SETRCR
  0787'   E5                    	PUSH	H
  0788'   F5                    	PUSH	PSW
  0789'   21 0021               	LXI	H,21H
  078C'   19                    	DAD	D
  078D'   7E                    	MOV	A,M
  078E'   B7                    	ORA	A
