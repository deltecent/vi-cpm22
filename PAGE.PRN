  0213'   23                    	INX	H
  0214'   22 0000*              	SHLD	CLCNT
  0217'   E1                    	POP	H
  0218'   C3 0204'              	JMP	CLBYTS
                                
                                ;============================================================
                                ; PAGING CONSTANTS -- WM 412-447.  From A/H = high byte of BUFEND, derive the
                                ; batch/margin sizing and the free-space water marks the load/spill path reads.
                                ;============================================================
  021B'                         PGCONST:			; WM 412
  021B'   7C                    	MOV	A,H
  021C'   B7                    	ORA	A
  021D'   1F                    	RAR
  021E'   1F                    	RAR
  021F'   1F                    	RAR
  0220'   3C                    	INR	A
  0221'   3C                    	INR	A
  0222'   E6 3C                 	ANI	3CH
  0224'   47                    	MOV	B,A
  0225'   32 0000*              	STA	PGSCAL
  0228'   07                    	RLC
  0229'   32 0000*              	STA	PGSCL2
  022C'   78                    	MOV	A,B
  022D'   FE 08                 	CPI	BS
  022F'   D2 0234'              	JNC	PGCON1
  0232'   3E 08                 	MVI	A,BS
  0234'                         PGCON1:				 ; WM 430
  0234'   32 0000*              	STA	PGMARGN
  0237'   7C                    	MOV	A,H
  0238'   FE 64                 	CPI	64H
  023A'   21 0400               	LXI	H,400H
  023D'   22 0000*              	SHLD	BUFLO
  0240'   DA 0244'              	JC	PGCON2
  0243'   29                    	DAD	H
  0244'                         PGCON2:				 ; WM 439
  0244'   22 0000*              	SHLD	BUFHI
  0247'   3E 08                 	MVI	A,BS
  0249'   32 0000*              	STA	PGSCRA
  024C'   DA 0250'              	JC	PGCON3
  024F'   87                    	ADD	A
  0250'                         PGCON3:				 ; WM 446
  0250'   32 0000*              	STA	IOBATCH
  0253'   C9                    	RET
                                
