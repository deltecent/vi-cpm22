  0771'   01 FFFF               	LXI	B,0FFFFH
  0774'                         RECADJ:				 ; WM 5692 -- adjust FCB+22/23 by BC
  0774'   D5                    	PUSH	D
  0775'   E5                    	PUSH	H
  0776'   1B                    	DCX	D
  0777'   3E FF                 	MVI	A,0FFH
  0779'   12                    	STAX	D
  077A'   21 0023               	LXI	H,23H
  077D'   19                    	DAD	D
  077E'   E5                    	PUSH	H
  077F'   CD 0000*              	CALL	LDHLI
  0782'   09                    	DAD	B
  0783'   7C                    	MOV	A,H
  0784'   A5                    	ANA	L
  0785'   3C                    	INR	A
  0786'   CA 0792'              	JZ	RECWRP
  0789'   EB                    	XCHG
  078A'   E1                    	POP	H
  078B'   73                    	MOV	M,E
  078C'   23                    	INX	H
  078D'   72                    	MOV	M,D
