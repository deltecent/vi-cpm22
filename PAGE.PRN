  0385'   11 0000*              	LXI	D,BAKRDY
  0388'   1A                    	LDAX	D
  0389'   13                    	INX	D
  038A'   B7                    	ORA	A
  038B'   37                    	STC
  038C'   C4 06DA'              	CNZ	RDPREV
  038F'   D0                    	RNC
  0390'   11 005B               	LXI	D,5BH
  0393'   1A                    	LDAX	D
  0394'   13                    	INX	D
  0395'   B7                    	ORA	A
  0396'   37                    	STC
  0397'   C4 06D3'              	CNZ	RDNEXT
  039A'   C9                    	RET
                                
