  078C'   E6 7F                 	ANI	7FH
  078E'   4F                    	MOV	C,A
  078F'   29                    	DAD	H
  0790'   7C                    	MOV	A,H
  0791'   21 000C               	LXI	H,0CH
  0794'   19                    	DAD	D
  0795'   BE                    	CMP	M
  0796'   CA 07BA'              	JZ	SETRCR
  0799'   E5                    	PUSH	H
  079A'   F5                    	PUSH	PSW
  079B'   21 0021               	LXI	H,21H
  079E'   19                    	DAD	D
  079F'   7E                    	MOV	A,M
  07A0'   B7                    	ORA	A
  07A1'   C4 064B'              	CNZ	CLOSEF
  07A4'   36 00                 	MVI	M,0H
  07A6'   F1                    	POP	PSW
  07A7'   E1                    	POP	H
  07A8'   77                    	MOV	M,A
  07A9'   CD 0616'              	CALL	BDOSFN
  07AC'   0F                    	DB	0FH
  07AD'   3C                    	INR	A
  07AE'   C2 07BA'              	JNZ	SETRCR
  07B1'   78                    	MOV	A,B
  07B2'   B7                    	ORA	A
  07B3'   37                    	STC
  07B4'   CA 07C3'              	JZ	SETDMA
  07B7'   CD 0676'              	CALL	MAKEF
  07BA'                         SETRCR:				; WM 5771 -- extent already open: set CR + DMA
  07BA'   21 0020               	LXI	H,20H
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  07BD'   19                    	DAD	D
  07BE'   71                    	MOV	M,C
  07BF'   23                    	INX	H
  07C0'   7E                    	MOV	A,M
  07C1'   B0                    	ORA	B
  07C2'   77                    	MOV	M,A
  07C3'                         SETDMA:				 ; WM 5780 -- set the DMA address (BDOS 1A)
  07C3'   E1                    	POP	H
  07C4'   F5                    	PUSH	PSW
  07C5'   EB                    	XCHG
  07C6'   CD 061F'              	CALL	BDOSC
  07C9'   1A                    	DB	1AH
  07CA'   EB                    	XCHG
  07CB'   F1                    	POP	PSW
  07CC'   C1                    	POP	B
  07CD'   C9                    	RET
                                
                                ;============================================================
                                ; TYPE-AHEAD POLL -- WM 6199 (POLLBRK).
                                ;============================================================
                                ;POLLBRK -- WM 6199: drain type-ahead during long operations so keys typed at
                                ;9600 baud are queued, not lost.  WM's CALL GETKEY is KEY.MAC's KBPOLL (the
                                ;ring lives there).  Only WM's non-interruptible path (L26A5 = 0) is kept;
                                ;the ^C 'INTERRUPTED' path (L23E3/CKBRK) belongs to WM's command language.
  07CE'                         POLLBRK:			; WM 6199
  07CE'   F5                    	PUSH	PSW
  07CF'   CD 0000*              	CALL	KBPOLL
  07D2'   F1                    	POP	PSW
  07D3'   C9                    	RET
                                
                                ;============================================================
                                ; DATA -- what the image carries: the two names and one flag.
                                ;============================================================
                                ;The cells that start at zero are not in the image: RSV.MAC names them, in
                                ;the RAM just above it, and BUF.MAC's ZINIT clears them before anything runs.
                                ;Their order there is the order they had here, and code depends on it.
                                ;The three FCBs, each with its two flag bytes below it, the pager's marks and
                                ;its constants are there.
                                	EXTRN	OUTACT, OUTFCB, OUTTYP, OUTPOS, BAKRDY, BAKFCB
                                	EXTRN	BAKPOS, PGTOPM, OUTREC, OUTHI, SRCREC, BAKREC
                                	EXTRN	INLEN, DSTDRV, NEWFIL, AUXCNT, DIRFLG, WRKMAD
                                	EXTRN	SKREC, SKBYT, TOPLF, CLCNT, TFCB, WRLIM
                                	EXTRN	RDLIM, BUFLO, BUFHI, PGSCAL, PGSCL2, MARGLO
                                	EXTRN	PGMARGN, IOBATCH, PGSCRA, SPLCNT
                                
  07D4'   56 49 42 41           BAKNAM:	 DB	 'VIBACKUP$$$'	  ; WM 520 -- BAKFCB name (WM: WMBACKUP$$$)
  07D8'   43 4B 55 50           
  07DC'   24 24 24              
  07DC'                         BAKTYP	EQU	BAKNAM+8	 ; the '$$$' substring (WM BAKTYP EQU 443H)
  07DF'   42 41 4B              BAKEXT: DB	'BAK'		; WM 5245 -- the .BAK rename type
                                
  07E2'   FF                    CPMNEW: DB	0FFH		; nonzero = CP/M 2.x+ (tolerant rename)
                                
                                	END
