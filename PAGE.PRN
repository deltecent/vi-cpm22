                                ;RDSEC -- WM 5588: read one record into [HL] (CY on EOF).
  08C9'                         RDSEC:				; WM 5588
  08C9'   CD 0000*              	CALL	KBPOLL		; WM: CALL GETKEY
  08CC'   AF                    	XRA	A
  08CD'   CD 0982'              	CALL	SETREC
  08D0'   DA 08DA'              	JC	IOEOF
  08D3'   CD 080A'              	CALL	BDOSC
  08D6'   14                    	DB	14H
  08D7'   B7                    	ORA	A
  08D8'   3D                    	DCR	A
  08D9'   C0                    	RNZ
                                ;IOEOF -- WM 5600: mark an I/O read as EOF (zero count, set carry).
  08DA'                         IOEOF:				; WM 5600
  08DA'   1B                    	DCX	D
  08DB'   AF                    	XRA	A
  08DC'   12                    	STAX	D
  08DD'   13                    	INX	D
  08DE'   37                    	STC
  08DF'   C9                    	RET
                                
                                ;WRREC -- WM 5609: write one record with extent / DISK FULL handling.
  08E0'                         WRREC:				; WM 5609
  08E0'   E5                    	PUSH	H
