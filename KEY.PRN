                                ;============================================================
                                ; FILE:    KEY.MAC
                                ; PROJECT: VI
                                ; MODULE:  The keyboard -- one byte a key, over the type-ahead ring.
                                ;------------------------------------------------------------
                                ; GETKEY -- blocking key read.  C = A = the byte, bit 7 off.
                                ;   Console I/O: BCONST / BCONIN (EXTRN).  In the editor these are SCRN.MAC's
                                ;   BIOS-direct console leaves; the CMDTST/MOTTST harnesses supply scripted
                                ;   versions so the whole read+dispatch path runs headless.
                                ;     BCONST: A=FFH char ready, A=00H not ready (non-blocking)
                                ;     BCONIN: A=char (blocks until ready)
                                ;
                                ; A key is a byte.  ESC is the byte 1BH and nothing more: it is never held back
                                ; to see whether a '[' follows, so it acts at once, and the keys a terminal
                                ; sends as an ESC sequence -- the arrows, Home, End, PgUp, PgDn, Ins, Del --
                                ; are NOT decoded.  Their bytes are keystrokes like any others: an up-arrow
                                ; is ESC, '[', 'A'.  That is the price of ESC being the key that stops a long
                                ; command (KBBRK): one byte cannot both mean "stop" the moment it arrives and
                                ; wait to find out whether it begins an arrow.
                                ;------------------------------------------------------------
                                ; TYPE-AHEAD RING (WordMaster's input mechanism; see RENDER.md).
                                ; A KBRSIZ-byte ring (KBRING, 31 usable slots) sits over BCONIN.  The
                                ; PRODUCER (KBPUMP) drains every byte the BIOS already has waiting into the ring
                                ; without blocking; the CONSUMER (KBGETB) takes the oldest byte,
                                ; blocking on BCONIN only when the ring is empty.  KBRDY pumps then reports
                                ; whether a byte is waiting -- SCRN.MAC's paint loop polls it (RPOLL) so a slow
                                ; repaint yields to pending keys.  The ring is transparent to a headless harness
                                ; whose BCONST always returns 0: KBPUMP pumps nothing, KBTAKE finds it empty, and
                                ; KBGETB falls through to the blocking BCONIN exactly as before.
                                ;------------------------------------------------------------
                                ; EXPORTS: GETKEY, KBRDY, KBPOLL, KBBRK, KBFLSH     EXTRNS: BCONST, BCONIN
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
  0024                   C      SREPMX	EQU	EXMAX-4		; ':s' replacement -- bounded by the ex line
                         C      				;   itself, so SCOPY can never truncate a line
                         C      				;   anyone is able to type: the shortest
                         C      				;   substitute is 's' '/' + one pattern char +
                         C      				;   '/' before the replacement starts, and
                         C      				;   RDLINE stores at most EXMAX.  Tied to
                         C      				;   EXMAX rather than written out, so the two
                         C      				;   cannot drift apart.
                         C      
                                
                                	EXTRN	KBRING			; RSV.MAC -- the ring, above the image
                                
                                	PUBLIC	GETKEY, KBRDY, KBPOLL
                                	PUBLIC	KBBRK, KBFLSH
                                	EXTRN	BCONST, BCONIN
                                
  0000'                         	CSEG
                                
  0000'                         GETKEY:
  0000'   CD 0007'              	CALL	KBGETB		; next byte: ring first, else block on BCONIN
  0003'   E6 7F                 	ANI	7FH
  0005'   4F                    	MOV	C,A
  0006'   C9                    	RET
                                
                                ;------------------------------------------------------------
                                ; TYPE-AHEAD RING PRIMITIVES
                                ;------------------------------------------------------------
                                ; KBGETB - consumer: return the next byte in A, blocking only if none is ready.
                                ; Drains any waiting bytes into the ring first, so a burst is captured, then
                                ; takes the oldest; an empty ring falls through to the blocking BIOS read.
  0007'                         KBGETB:
  0007'   CD 005E'              	CALL	KBPUMP		; capture anything already waiting
  000A'   CD 0088'              	CALL	KBTAKE		; oldest ring byte -> A (CY=1 if empty)
  000D'   D0                    	RNC
  000E'   C3 0000*              	JMP	BCONIN		; ring empty -> block for the next byte
                                
                                ; KBRDY - pump the ring, then A=0FFH if it holds a byte, else A=00H.  Peeks
                                ; only (takes nothing), so the byte stays for the next KBGETB.  This is
                                ; RPOLL: the paint loop calls it to yield to type-ahead.  Clobbers HL,DE,BC.
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0011'                         KBRDY:
  0011'   CD 005E'              	CALL	KBPUMP
  0014'   3A 0000*              	LDA	KBHEAD
  0017'   47                    	MOV	B,A
  0018'   3A 0000*              	LDA	KBTAIL
  001B'   B8                    	CMP	B
  001C'   CA 0022'              	JZ	KR_NO
  001F'   3E FF                 	MVI	A,0FFH
  0021'   C9                    	RET
  0022'                         KR_NO:
  0022'   AF                    	XRA	A
  0023'   C9                    	RET
                                
                                ; KBPOLL - WordMaster's GETKEY contract (WM 6094) for the engine's long loops
                                ; (GOLINE scan, RDSEC disk read, POLLBRK): drain waiting BIOS bytes into the
                                ; ring without blocking; BC, DE, HL preserved; NZ if a byte is queued.
  0024'                         KBPOLL:
  0024'   C5                    	PUSH	B
  0025'   D5                    	PUSH	D
  0026'   E5                    	PUSH	H
  0027'   CD 0011'              	CALL	KBRDY
  002A'   B7                    	ORA	A
  002B'   E1                    	POP	H
  002C'   D1                    	POP	D
  002D'   C1                    	POP	B
  002E'   C9                    	RET
                                
                                ; KBBRK - is an ESC waiting?  Pumps the ring, then looks through what it holds:
                                ; NZ and A=0FFH if an ESC is there -- and the ring is emptied, the ESC and all
                                ; that was typed round it -- else Z.  A long command that can be abandoned
                                ; asks this as it pages (CMD.MAC CNTTST).  The ring is searched, not a flag
                                ; kept as the bytes come in, so an ESC typed when nothing was running is only
                                ; ever a key: it is taken in its turn like any other.  An ESC ANYWHERE in the
                                ; ring counts, so an insert typed ahead of a long move stops the move with the
                                ; ESC that ends it.  Clobbers HL,DE,BC.
  002F'                         KBBRK:
  002F'   CD 005E'              	CALL	KBPUMP
  0032'   3A 0000*              	LDA	KBTAIL
  0035'   4F                    	MOV	C,A
  0036'   3A 0000*              	LDA	KBHEAD
  0039'                         KBK_LP:
  0039'   B9                    	CMP	C
  003A'   C8                    	RZ			; looked at all of it: none
  003B'   5F                    	MOV	E,A
  003C'   16 00                 	MVI	D,0
  003E'   21 0000*              	LXI	H,KBRING
  0041'   19                    	DAD	D		; HL = &KBRING[index]
  0042'   3C                    	INR	A
  0043'   E6 1F                 	ANI	KBRSIZ-1
  0045'   47                    	MOV	B,A		; B = the next index
  0046'   7E                    	MOV	A,M
  0047'   FE 1B                 	CPI	ESC
  0049'   78                    	MOV	A,B
  004A'   C2 0039'              	JNZ	KBK_LP
  004D'   79                    	MOV	A,C
  004E'   32 0000*              	STA	KBHEAD		; head = tail: empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0051'   F6 FF                 	ORI	0FFH
  0053'   C9                    	RET
                                
                                ; KBFLSH - throw away everything typed so far: what the ring holds and what
                                ; the BIOS still has waiting.  Clobbers HL,DE,BC,A.
  0054'                         KBFLSH:
  0054'   CD 005E'              	CALL	KBPUMP
  0057'   3A 0000*              	LDA	KBTAIL
  005A'   32 0000*              	STA	KBHEAD
  005D'   C9                    	RET
                                
                                ; KBPUMP - producer: move every byte the BIOS already has into the ring, without
                                ; blocking; stop when the BIOS has none waiting or the ring is full.  Clobbers
                                ; HL,DE,BC,A.
  005E'                         KBPUMP:
  005E'                         KP_LP:
  005E'   CD 00A6'              	CALL	KBFULL		; A=0FFH if full
  0061'   B7                    	ORA	A
  0062'   C0                    	RNZ
  0063'   CD 0000*              	CALL	BCONST		; byte waiting at the BIOS?
  0066'   B7                    	ORA	A
  0067'   C8                    	RZ
  0068'   CD 0000*              	CALL	BCONIN		; A = the byte (does not block: status said ready)
  006B'   CD 0071'              	CALL	KBPUT		; append it to the ring
  006E'   C3 005E'              	JMP	KP_LP
                                
                                ; KBPUT - append the byte in A to the ring (caller guarantees not full).
  0071'                         KBPUT:
  0071'   F5                    	PUSH	PSW		; save the byte
  0072'   3A 0000*              	LDA	KBTAIL
  0075'   5F                    	MOV	E,A
  0076'   16 00                 	MVI	D,0
  0078'   21 0000*              	LXI	H,KBRING
  007B'   19                    	DAD	D		; HL = &KBRING[tail]
  007C'   F1                    	POP	PSW
  007D'   77                    	MOV	M,A		; store
  007E'   3A 0000*              	LDA	KBTAIL
  0081'   3C                    	INR	A
  0082'   E6 1F                 	ANI	KBRSIZ-1	; wrap (mask = size-1)
  0084'   32 0000*              	STA	KBTAIL
  0087'   C9                    	RET
                                
                                ; KBTAKE - remove the oldest ring byte.  CY=1 (ring empty) or CY=0 with A=byte.
  0088'                         KBTAKE:
  0088'   3A 0000*              	LDA	KBHEAD
  008B'   47                    	MOV	B,A
  008C'   3A 0000*              	LDA	KBTAIL
  008F'   B8                    	CMP	B
  0090'   CA 00A4'              	JZ	KTK_EMP		; head == tail -> empty
  0093'   58                    	MOV	E,B
  0094'   16 00                 	MVI	D,0
  0096'   21 0000*              	LXI	H,KBRING
  0099'   19                    	DAD	D		; HL = &KBRING[head]
  009A'   4E                    	MOV	C,M		; C = byte
  009B'   78                    	MOV	A,B
  009C'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  009D'   E6 1F                 	ANI	KBRSIZ-1
  009F'   32 0000*              	STA	KBHEAD
  00A2'   79                    	MOV	A,C		; A = byte, CY=0 (from ANI)
  00A3'   C9                    	RET
  00A4'                         KTK_EMP:
  00A4'   37                    	STC
  00A5'   C9                    	RET
                                
                                ; KBFULL - A=0FFH if the ring is full ((tail+1) wraps onto head), else A=00H.
  00A6'                         KBFULL:
  00A6'   3A 0000*              	LDA	KBTAIL
  00A9'   3C                    	INR	A
  00AA'   E6 1F                 	ANI	KBRSIZ-1
  00AC'   47                    	MOV	B,A
  00AD'   3A 0000*              	LDA	KBHEAD
  00B0'   B8                    	CMP	B
  00B1'   CA 00B6'              	JZ	KF_YES
  00B4'   AF                    	XRA	A
  00B5'   C9                    	RET
  00B6'                         KF_YES:
  00B6'   3E FF                 	MVI	A,0FFH
  00B8'   C9                    	RET
                                
  00B9'                         	CSEG
                                ;The ring's two indexes start at zero, so RSV.MAC holds them, above the
                                ;image, and BUF.MAC's ZINIT clears them.
                                	EXTRN	KBHEAD, KBTAIL
                                
                                	END
