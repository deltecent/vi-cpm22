	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    KEY.MAC
                                ; PROJECT: VI
                                ; MODULE:  Key decoder -- synchronous VT100 ESC-sequence parser.
                                ;------------------------------------------------------------
                                ; GETKEY -- blocking key read with a VT100 ESC-sequence decoder.
                                ;   Console I/O: BCONST / BCONIN (EXTRN).  In the editor these are SCRN.MAC's
                                ;   BIOS-direct console leaves; the CMDTST/MOTTST harnesses supply scripted
                                ;   versions so the whole decode+dispatch path runs headless.
                                ;     BCONST: A=FFH char ready, A=00H not ready (non-blocking)
                                ;     BCONIN: A=char (blocks until ready)
                                ;
                                ; GETKEY blocks until a char is available, then returns:
                                ;   B=KT_CHAR, C=byte    for any non-ESC byte (printable or control)
                                ;   B=KT_ACT,  C=ACT_xxx for a recognised ESC sequence or lone ESC
                                ;   B=KT_NONE, C=0       for an unrecognised ESC sequence (discarded)
                                ;
                                ; ESC + unknown byte: returns ACT_ESC for the ESC; the unknown byte is saved in
                                ; KPEND and returned as KT_CHAR on the next GETKEY call.  GK_POLL uses HL as a
                                ; 16-bit countdown (ESCTMO=500 > 255), saved across each BIOS call because the
                                ; BIOS console routines have no register contract.
                                ;------------------------------------------------------------
                                ; TYPE-AHEAD RING (WordMaster's input mechanism; see RENDER.md).
                                ; A KBRSIZ-byte ring (KBRING, 31 usable slots) sits over BCONIN.  The
                                ; PRODUCER (KBPUMP) drains every byte the BIOS already has waiting into the ring
                                ; without blocking; the CONSUMER path (KBGETB / GK_POLL) takes the oldest byte,
                                ; blocking on BCONIN only when the ring is empty.  KBRDY pumps then reports
                                ; whether a byte is waiting -- SCRN.MAC's paint loop polls it (RPOLL) so a slow
                                ; repaint yields to pending keys.  The ring is transparent to a headless harness
                                ; whose BCONST always returns 0: KBPUMP pumps nothing, KBTAKE finds it empty, and
                                ; KBGETB falls through to the blocking BCONIN exactly as before.
                                ;------------------------------------------------------------
                                ; EXPORTS: GETKEY, KBRDY, KBPOLL     EXTRNS: BCONST, BCONIN
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	EXTRN	KBRING			; RSV.MAC -- the ring, above the image
                                
                                	PUBLIC	GETKEY, KBRDY, KBPOLL
                                	EXTRN	BCONST, BCONIN
                                
  0000'                         	CSEG
                                
  0000'                         GETKEY:
                                	; Return any pending byte saved from ESC+unknown
  0000'   3A 0192'              	LDA	KPEND
  0003'   B7                    	ORA	A
  0004'   C2 00E1'              	JNZ	GK_PEND
                                
  0007'   CD 010E'              	CALL	KBGETB		; next byte: ring first, else block on BCONIN
  000A'   FE 1B                 	CPI	ESC
  000C'   C2 00EA'              	JNZ	GK_CHAR
                                
                                	;--- ESC: poll for sequence continuation ---
  000F'   CD 00F3'              	CALL	GK_POLL		; A = next byte, 0 = timeout
  0012'   B7                    	ORA	A
  0013'   CA 0023'              	JZ	GK_ESC_LN	; timeout: standalone ESC
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0016'   FE 5B                 	CPI	'['
  0018'   CA 0028'              	JZ	GK_CSI
  001B'   FE 4F                 	CPI	'O'
  001D'   CA 0091'              	JZ	GK_SS3
                                	; unknown follow-on: ACT_ESC now, save the byte for next call
  0020'   32 0192'              	STA	KPEND
  0023'                         GK_ESC_LN:
  0023'   06 01                 	MVI	B,KT_ACT
  0025'   0E 0B                 	MVI	C,ACT_ESC
  0027'   C9                    	RET
                                
                                	;--- ESC [ sequence (CSI) ---
  0028'                         GK_CSI:
  0028'   3E 00                 	MVI	A,0
  002A'   32 0191'              	STA	KPARAM
  002D'   CD 00F3'              	CALL	GK_POLL
  0030'   B7                    	ORA	A
  0031'   CA 00EE'              	JZ	GK_NONE
  0034'   FE 30                 	CPI	'0'
  0036'   DA 004A'              	JC	GKCSIF
  0039'   FE 3A                 	CPI	'9'+1
  003B'   D2 004A'              	JNC	GKCSIF
                                	; single digit parameter: save and read the final byte
  003E'   D6 30                 	SUI	'0'
  0040'   32 0191'              	STA	KPARAM
  0043'   CD 00F3'              	CALL	GK_POLL
  0046'   B7                    	ORA	A
  0047'   CA 00EE'              	JZ	GK_NONE
  004A'                         GKCSIF:
  004A'   FE 41                 	CPI	'A'
  004C'   CA 00AF'              	JZ	GKCUUP
  004F'   FE 42                 	CPI	'B'
  0051'   CA 00B4'              	JZ	GKCUDN
  0054'   FE 43                 	CPI	'C'
  0056'   CA 00B9'              	JZ	GKCURT
  0059'   FE 44                 	CPI	'D'
  005B'   CA 00BE'              	JZ	GKCULT
  005E'   FE 48                 	CPI	'H'
  0060'   CA 00C3'              	JZ	GKLNST
  0063'   FE 46                 	CPI	'F'
  0065'   CA 00C8'              	JZ	GKLNEN
  0068'   FE 7E                 	CPI	'~'
  006A'   C2 00EE'              	JNZ	GK_NONE
                                	; '~': dispatch on KPARAM
  006D'   3A 0191'              	LDA	KPARAM
  0070'   FE 01                 	CPI	1
  0072'   CA 00C3'              	JZ	GKLNST	      ; ESC[1~ = Home
  0075'   FE 02                 	CPI	2
  0077'   CA 00CD'              	JZ	GK_INS		; ESC[2~ = Insert
  007A'   FE 03                 	CPI	3
  007C'   CA 00D2'              	JZ	GK_DEL		; ESC[3~ = Delete
  007F'   FE 04                 	CPI	4
  0081'   CA 00C8'              	JZ	GKLNEN	      ; ESC[4~ = End
  0084'   FE 05                 	CPI	5
  0086'   CA 00D7'              	JZ	GK_PGUP		; ESC[5~ = PgUp
  0089'   FE 06                 	CPI	6
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  008B'   CA 00DC'              	JZ	GK_PGDN		; ESC[6~ = PgDn
  008E'   C3 00EE'              	JMP	GK_NONE
                                
                                	;--- ESC O sequence (SS3) ---
  0091'                         GK_SS3:
  0091'   CD 00F3'              	CALL	GK_POLL
  0094'   B7                    	ORA	A
  0095'   CA 00EE'              	JZ	GK_NONE
  0098'   FE 41                 	CPI	'A'
  009A'   CA 00AF'              	JZ	GKCUUP
  009D'   FE 42                 	CPI	'B'
  009F'   CA 00B4'              	JZ	GKCUDN
  00A2'   FE 43                 	CPI	'C'
  00A4'   CA 00B9'              	JZ	GKCURT
  00A7'   FE 44                 	CPI	'D'
  00A9'   CA 00BE'              	JZ	GKCULT
  00AC'   C3 00EE'              	JMP	GK_NONE
                                
                                	;--- ACT_xxx return paths ---
  00AF'                         GKCUUP:
  00AF'   0E 01                 	MVI	C,ACT_CURUP
  00B1'   C3 00DE'              	JMP	GK_ACT
  00B4'                         GKCUDN:
  00B4'   0E 02                 	MVI	C,ACT_CURDN
  00B6'   C3 00DE'              	JMP	GK_ACT
  00B9'                         GKCURT:
  00B9'   0E 03                 	MVI	C,ACT_CURRT
  00BB'   C3 00DE'              	JMP	GK_ACT
  00BE'                         GKCULT:
  00BE'   0E 04                 	MVI	C,ACT_CURLT
  00C0'   C3 00DE'              	JMP	GK_ACT
  00C3'                         GKLNST:
  00C3'   0E 05                 	MVI	C,ACT_LINST
  00C5'   C3 00DE'              	JMP	GK_ACT
  00C8'                         GKLNEN:
  00C8'   0E 06                 	MVI	C,ACT_LINEN
  00CA'   C3 00DE'              	JMP	GK_ACT
  00CD'                         GK_INS:
  00CD'   0E 09                 	MVI	C,ACT_INS
  00CF'   C3 00DE'              	JMP	GK_ACT
  00D2'                         GK_DEL:
  00D2'   0E 0A                 	MVI	C,ACT_DEL
  00D4'   C3 00DE'              	JMP	GK_ACT
  00D7'                         GK_PGUP:
  00D7'   0E 07                 	MVI	C,ACT_PGUP
  00D9'   C3 00DE'              	JMP	GK_ACT
  00DC'                         GK_PGDN:
  00DC'   0E 08                 	MVI	C,ACT_PGDN
  00DE'                         GK_ACT:
  00DE'   06 01                 	MVI	B,KT_ACT
  00E0'   C9                    	RET
                                
  00E1'                         GK_PEND:
  00E1'   4F                    	MOV	C,A
  00E2'   3E 00                 	MVI	A,0
  00E4'   32 0192'              	STA	KPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  00E7'   06 02                 	MVI	B,KT_CHAR
  00E9'   C9                    	RET
                                
  00EA'                         GK_CHAR:
  00EA'   4F                    	MOV	C,A
  00EB'   06 02                 	MVI	B,KT_CHAR
  00ED'   C9                    	RET
                                
  00EE'                         GK_NONE:
  00EE'   06 00                 	MVI	B,KT_NONE
  00F0'   0E 00                 	MVI	C,0
  00F2'   C9                    	RET
                                
                                ;------------------------------------------------------------
                                ; GK_POLL - poll up to ESCTMO times for one console byte (from the ring).
                                ; Exit: A = byte read; A = 0 on timeout (NUL also treated as timeout).
                                ; HL is the 16-bit countdown, saved across each ring call (KBRDY pumps via the
                                ; BIOS and clobbers HL) -- otherwise the countdown is destroyed and a lone ESC
                                ; spins.  A type-ahead ESC sequence is already buffered, so KBRDY returns it at
                                ; once; a lone ESC finds the ring empty and rides the countdown to timeout.
                                ;------------------------------------------------------------
  00F3'                         GK_POLL:
  00F3'   21 01F4               	LXI	H,ESCTMO
  00F6'                         GKP_LP:
  00F6'   7C                    	MOV	A,H
  00F7'   B5                    	ORA	L
  00F8'   CA 010C'              	JZ	GKP_TO
  00FB'   2B                    	DCX	H
  00FC'   E5                    	PUSH	H
  00FD'   CD 0118'              	CALL	KBRDY		; pump the ring; A=FF if a byte is waiting
  0100'   E1                    	POP	H
  0101'   B7                    	ORA	A
  0102'   CA 00F6'              	JZ	GKP_LP
  0105'   E5                    	PUSH	H
  0106'   CD 0160'              	CALL	KBTAKE		; consume it (KBRDY confirmed non-empty)
  0109'   E1                    	POP	H
  010A'   B7                    	ORA	A
  010B'   C0                    	RNZ
  010C'                         GKP_TO:
  010C'   AF                    	XRA	A
  010D'   C9                    	RET
                                
                                ;------------------------------------------------------------
                                ; TYPE-AHEAD RING PRIMITIVES
                                ;------------------------------------------------------------
                                ; KBGETB - consumer: return the next byte in A, blocking only if none is ready.
                                ; Drains any waiting bytes into the ring first, so a burst is captured, then
                                ; takes the oldest; an empty ring falls through to the blocking BIOS read.
  010E'                         KBGETB:
  010E'   CD 0136'              	CALL	KBPUMP		; capture anything already waiting
  0111'   CD 0160'              	CALL	KBTAKE		; oldest ring byte -> A (CY=1 if empty)
  0114'   D0                    	RNC
  0115'   C3 0000*              	JMP	BCONIN		; ring empty -> block for the next byte
                                
                                ; KBRDY - pump the ring, then A=0FFH if it holds a byte, else A=00H.  Peeks
                                ; only (takes nothing), so the byte stays for the next KBGETB/GK_POLL.  This is
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


                                ; RPOLL: the paint loop calls it to yield to type-ahead.  Clobbers HL,DE,BC.
  0118'                         KBRDY:
  0118'   CD 0136'              	CALL	KBPUMP
  011B'   3A 0193'              	LDA	KBHEAD
  011E'   47                    	MOV	B,A
  011F'   3A 0194'              	LDA	KBTAIL
  0122'   B8                    	CMP	B
  0123'   CA 0129'              	JZ	KR_NO
  0126'   3E FF                 	MVI	A,0FFH
  0128'   C9                    	RET
  0129'                         KR_NO:
  0129'   AF                    	XRA	A
  012A'   C9                    	RET
                                
                                ; KBPOLL - WordMaster's GETKEY contract (WM 6094) for the engine's long loops
                                ; (GOLINE scan, RDSEC disk read, POLLBRK): drain waiting BIOS bytes into the
                                ; ring without blocking; BC, DE, HL preserved; NZ if a byte is queued.
  012B'                         KBPOLL:
  012B'   C5                    	PUSH	B
  012C'   D5                    	PUSH	D
  012D'   E5                    	PUSH	H
  012E'   CD 0118'              	CALL	KBRDY
  0131'   B7                    	ORA	A
  0132'   E1                    	POP	H
  0133'   D1                    	POP	D
  0134'   C1                    	POP	B
  0135'   C9                    	RET
                                
                                ; KBPUMP - producer: move every byte the BIOS already has into the ring, without
                                ; blocking; stop when the BIOS has none waiting or the ring is full.  Clobbers
                                ; HL,DE,BC,A.
  0136'                         KBPUMP:
  0136'                         KP_LP:
  0136'   CD 017E'              	CALL	KBFULL		; A=0FFH if full
  0139'   B7                    	ORA	A
  013A'   C0                    	RNZ
  013B'   CD 0000*              	CALL	BCONST		; byte waiting at the BIOS?
  013E'   B7                    	ORA	A
  013F'   C8                    	RZ
  0140'   CD 0000*              	CALL	BCONIN		; A = the byte (does not block: status said ready)
  0143'   CD 0149'              	CALL	KBPUT		; append it to the ring
  0146'   C3 0136'              	JMP	KP_LP
                                
                                ; KBPUT - append the byte in A to the ring (caller guarantees not full).
  0149'                         KBPUT:
  0149'   F5                    	PUSH	PSW		; save the byte
  014A'   3A 0194'              	LDA	KBTAIL
  014D'   5F                    	MOV	E,A
  014E'   16 00                 	MVI	D,0
  0150'   21 0000*              	LXI	H,KBRING
  0153'   19                    	DAD	D		; HL = &KBRING[tail]
  0154'   F1                    	POP	PSW
  0155'   77                    	MOV	M,A		; store
  0156'   3A 0194'              	LDA	KBTAIL
  0159'   3C                    	INR	A
  015A'   E6 1F                 	ANI	KBRSIZ-1	; wrap (mask = size-1)
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  015C'   32 0194'              	STA	KBTAIL
  015F'   C9                    	RET
                                
                                ; KBTAKE - remove the oldest ring byte.  CY=1 (ring empty) or CY=0 with A=byte.
  0160'                         KBTAKE:
  0160'   3A 0193'              	LDA	KBHEAD
  0163'   47                    	MOV	B,A
  0164'   3A 0194'              	LDA	KBTAIL
  0167'   B8                    	CMP	B
  0168'   CA 017C'              	JZ	KTK_EMP		; head == tail -> empty
  016B'   58                    	MOV	E,B
  016C'   16 00                 	MVI	D,0
  016E'   21 0000*              	LXI	H,KBRING
  0171'   19                    	DAD	D		; HL = &KBRING[head]
  0172'   4E                    	MOV	C,M		; C = byte
  0173'   78                    	MOV	A,B
  0174'   3C                    	INR	A
  0175'   E6 1F                 	ANI	KBRSIZ-1
  0177'   32 0193'              	STA	KBHEAD
  017A'   79                    	MOV	A,C		; A = byte, CY=0 (from ANI)
  017B'   C9                    	RET
  017C'                         KTK_EMP:
  017C'   37                    	STC
  017D'   C9                    	RET
                                
                                ; KBFULL - A=0FFH if the ring is full ((tail+1) wraps onto head), else A=00H.
  017E'                         KBFULL:
  017E'   3A 0194'              	LDA	KBTAIL
  0181'   3C                    	INR	A
  0182'   E6 1F                 	ANI	KBRSIZ-1
  0184'   47                    	MOV	B,A
  0185'   3A 0193'              	LDA	KBHEAD
  0188'   B8                    	CMP	B
  0189'   CA 018E'              	JZ	KF_YES
  018C'   AF                    	XRA	A
  018D'   C9                    	RET
  018E'                         KF_YES:
  018E'   3E FF                 	MVI	A,0FFH
  0190'   C9                    	RET
                                
  0191'                         	CSEG
