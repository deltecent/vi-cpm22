;============================================================
; FILE:    CMDTST.MAC
; PROJECT: VI
; MODULE:  Command-layer exerciser (test harness -- NOT editor code).
;
; Drives KEY.MAC + CMD.MAC headlessly: it supplies scripted BCONST/BCONIN so the
; whole GETKEY-decode + VICMD-dispatch + edit + ex + search path runs without a
; terminal, exactly as SCRN.MAC's BIOS console feeds it live.
;
;   BCONST always reports "not ready" -> every ESC is a lone ESC (GK_POLL times
;   out).  So arrow ESC-sequences are not exercised here (they need real console
;   timing), and no harness here exercises the CSI/SS3 decoder.
;   BCONIN replays KSCRIPT byte by byte.  A 01H byte in the script is a SNAPSHOT
;   sentinel: BCONIN calls QSNAP (freezing TOFFV/TLINEV/TCOLV at that instant --
;   BEFORE a following :w tears the buffer down) and returns the next real byte.
;
; The scripted session, over CMDIN.TXT:
;   x      delete 'h'      -> line0 "ello world"
;   j      down to line1
;   dd     delete line1    ("second line here")
;   G 0    last line, col0
;   i X ESC  insert 'X'    -> "Xlast line xyz"   (cursor steps back onto 'X')
;   <snap> freeze cursor   -> TOFF=21 LINE=3 COL=0
;   :wq    save + quit
; cmdtst.py byte-compares the saved file against the expected edited text and
; checks the frozen cursor snapshot.
;============================================================
	INCLUDE VI.INC

	EXTRN	BINIT			; BUF.MAC
	EXTRN	FOPEN			; CMD.MAC
	EXTRN	CMDRUN, QSNAP		; CMD.MAC

	PUBLIC	BCONST, BCONIN, BCONOU	; KEY.MAC's + CMD.MAC's console EXTRNs
	PUBLIC	NEDIT, WINROW		; CMD.MAC's screen EXTRNs (no renderer here)
	PUBLIC	SCBOT, SCEOF, SCBOF, WFILL
	PUBLIC	EXPRM, EXRUB, OUTCH	; CMD.MAC's ':' line echo (no renderer here)
	PUBLIC	EXMSG, OUTSTR		; CMD.MAC's ex message (no renderer here)
	PUBLIC	SCURS			; CMD.MAC's '^G' cursor restore
	PUBLIC	CBOL, CURDCL		; CMD.MAC's '^G' cursor column
	PUBLIC	DONE

	CSEG

START:	LXI	SP,STACK
	CALL	BINIT
	CALL	FOPEN		; load CMDIN.TXT (staged at 005CH by CP/M)
	CALL	CMDRUN		; run the scripted session to :q
	MVI	A,0FFH
	STA	DONE
	JMP	WBOOT

;------------------------------------------------------------
; Scripted console.  BCONST: never ready.  BCONIN: next KSCRIPT byte, with 01H
; as the QSNAP sentinel; running off the end warm-boots (safety net -- the
; script always quits first).
;------------------------------------------------------------
BCONST:
	XRA	A
	RET

SCURS:				; nothing is on a screen here
EXPRM:				; CMD.MAC's ':' line echo -- swallowed here
EXMSG:
OUTSTR:
EXRUB:
OUTCH:
BCONOU:				; CMD.MAC's miss bell -- swallowed headlessly
	RET

CBOL:	DW	0		; the renderer's cursor column, absent here
CURDCL: DW	0		;   ... and the one a TAB expands it to

BCONIN:
	LHLD	KIDX
	LXI	D,KLEN
	MOV	A,L
	SUB	E
	MOV	A,H
	SBB	D
	JNC	BCI_EOF		; idx >= KLEN
	LHLD	KIDX
	LXI	D,KSCRIPT
	DAD	D
	MOV	A,M		; A = script byte
	LHLD	KIDX
	INX	H
	SHLD	KIDX
	CPI	01H
	JZ	BCI_SNAP
	RET
BCI_SNAP:
	CALL	QSNAP
	JMP	BCONIN
BCI_EOF:
	JMP	WBOOT

;------------------------------------------------------------
; Data
;------------------------------------------------------------
KSCRIPT:
	DB	'x','j','d','d','G','0','i','X',1BH,01H,':','w','q',0DH
KLEN	EQU	$-KSCRIPT

KIDX:	DW	0
NEDIT:	DB	23		; CMD.MAC EXTRN stub (no screen motions scripted)
WINROW: DW	0		; SCRN.MAC stubs: row 0 at the top of the file
SCBOT:	DB	22		; last text row
SCEOF:	DB	1		; the whole file is on the screen
SCBOF:	DB	1
WFILL:	DB	0
DONE:	DB	0

	DS	64
STACK:

	END	START
