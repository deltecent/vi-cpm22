  0A23'   C9                    	RET
  0A24'                         LQ_NO:
  0A24'   3C                    	INR	A
  0A25'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A26'                         FLINE:
  0A26'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A29'   DA 0A66'              	JC	FL_EOF
  0A2C'   32 1050'              	STA	LYLAST
  0A2F'   FE 0A                 	CPI	LF
  0A31'   CA 0A64'              	JZ	FL_LF
  0A34'   FE 0D                 	CPI	CR
  0A36'   CA 0A26'              	JZ	FLINE		; CR contributes no display column
  0A39'   FE 09                 	CPI	TAB
  0A3B'   CA 0A47'              	JZ	FL_TAB
  0A3E'   CD 0A69'              	CALL	FL_CEL
  0A41'   C2 0A26'              	JNZ	FLINE
  0A44'                         FL_OVR:
  0A44'   3E 01                 	MVI	A,1
  0A46'   C9                    	RET
  0A47'                         FL_TAB:
  0A47'   3A 1045'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0A4A'   83                    	ADD	E
  0A4B'   E6 07                 	ANI	TABWID-1
  0A4D'   2F                    	CMA
  0A4E'   C6 09                 	ADI	TABWID+1
  0A50'   E5                    	PUSH	H
  0A51'   6F                    	MOV	L,A
  0A52'                         FT_LP:
  0A52'   CD 0A69'              	CALL	FL_CEL
  0A55'   CA 0A60'              	JZ	FT_OVR
  0A58'   2D                    	DCR	L
  0A59'   C2 0A52'              	JNZ	FT_LP
  0A5C'   E1                    	POP	H
  0A5D'   C3 0A26'              	JMP	FLINE
  0A60'                         FT_OVR:
