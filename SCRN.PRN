  0684'   3E 01                 	MVI	A,1		; the table is the screen's own, and LYQK may go
  0686'   32 0D59'              	STA	LYOK		;   by it while the text stays where it is
  0689'   CD 092C'              	CALL	LYTOPP
  068C'   EB                    	XCHG
  068D'   2A 0000*              	LHLD	TXTBEG
  0690'   EB                    	XCHG
