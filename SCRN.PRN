  0BD7'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0BD9'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0BDA'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0BDB'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0BDC'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0BDD'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0BDE'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0BDF'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0BE0'   00                    LYXE:	DB	0		; HTBLD: WR_EOL+1 when the cursor has its own row
  0BE1'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
