  0836'   35 6C 00              
  0839'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  083D'   35 68 00              
  0840'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0844'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0848'   4E 53 45 52           
