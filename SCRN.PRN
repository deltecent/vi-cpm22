  0ADB'   DA 0AE5'              	JC	LM_U		;   many, when above goes first)
  0ADE'   CD 0B05'              	CALL	LMBLW
  0AE1'   D2 0ACF'              	JNC	LM_LP
  0AE4'   C9                    	RET
  0AE5'                         LM_U:
  0AE5'   CD 0B33'              	CALL	LMABV
  0AE8'   D2 0ACF'              	JNC	LM_LP
  0AEB'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0AEC'                         LYINI:
  0AEC'   AF                    	XRA	A
  0AED'   32 1053'              	STA	LYROW
  0AF0'   32 105A'              	STA	LYMAB
  0AF3'   32 105B'              	STA	LYMBL
  0AF6'   3A 0000*              	LDA	HTCUR
  0AF9'   CD 0B4F'              	CALL	HTE
  0AFC'   7E                    	MOV	A,M
  0AFD'   32 1059'              	STA	LYUSE
  0B00'   23                    	INX	H
  0B01'   22 1054'              	SHLD	LYIB
  0B04'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0B05'                         LMBLW:
  0B05'   3A 0000*              	LDA	HTN
  0B08'   CD 0B4F'              	CALL	HTE
  0B0B'   EB                    	XCHG
  0B0C'   2A 1054'              	LHLD	LYIB
  0B0F'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0B12'   C2 0B21'              	JNZ	LB_1
  0B15'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0B18'   B7                    	ORA	A
  0B19'   37                    	STC
  0B1A'   C8                    	RZ
  0B1B'   21 105B'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0B1E'   34                    	INR	M
  0B1F'   B7                    	ORA	A
