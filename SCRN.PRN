  0BD2'   00                    SNULL:	DB	0
  0BD3'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0BD7'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0BD8'   50                    NCOLS:	DB	80		; runtime columns
  0BD9'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0BDA'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0BDC'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0BDE'   00                    SROW:	DB	0		; computed cursor screen row
  0BDF'   00                    SCOL:	DB	0		; computed cursor screen column
  0BE0'   01                    TXEND:	DB	1		; the first row with no text on it
  0BE1'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0BE2'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0BE3'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0BE5'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0BE6'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0BE7'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0BE8'   0000                  OLDWR:	DW	0
  0BEA'   0000                  OLDSK:	DW	0
  0BEC'   0000                  OLDSC:	DW	0
  0BEE'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0BF0'   00                    OLDBOT:	DB	0
  0BF1'   0000                  OLDAB:	DW	0
  0BF3'   00                    OLDCS:	DB	0
  0BF4'   00                    OLDCR:	DB	0
  0BF5'   00                    OLDNR:	DB	0
                                
  0BF6'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0BF7'   00                    OPM:	DB	0		; ... or gained there
  0BF8'   00                    EDA:	DB	0		; the edit: the rows it had
  0BF9'   00                    EDB:	DB	0		; ... and has
  0BFA'   00                    EDR:	DB	0		; ... its first row
  0BFB'   00                    EDP:	DB	0		; ... the first of them to draw
  0BFC'   00                    PEND:	DB	0		; PRNG: the row to stop before
  0BFD'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0BFE'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0C00'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  0C01'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0C02'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0C03'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0C04'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0C05'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0C06'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0C08'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C0A'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0C0C'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0C0E'   00                    LYROW:	DB	0		; LAYOUT: working row
  0C0F'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0C11'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0C12'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0C14'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0C15'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0C16'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0C17'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0C18'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0C19'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0C1A'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0C1B'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0C1C'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0C1D'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0C1F'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0C21'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0C22'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0C24'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0C26'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0C28'   0000                  RDBC:	DW	0		; reader: RGET count
  0C2A'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0C2B'   00                    SKPN:	DB	0		; RDSKIP line count
  0C2C'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0C2D'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0C2F'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0C30'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0C31'   0000                  TMPR:	DW	0		; DSR parse: rows
  0C33'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
