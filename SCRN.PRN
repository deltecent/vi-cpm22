  0A0B'   FE 02                 	CPI	PL_MID
  0A0D'   C8                    	RZ
  0A0E'   3A 103E'              	LDA	LYND
  0A11'   B7                    	ORA	A
  0A12'   CA 0A17'              	JZ	LQ_NO
  0A15'   AF                    	XRA	A
  0A16'   C9                    	RET
  0A17'                         LQ_NO:
  0A17'   3C                    	INR	A
  0A18'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A19'                         FLINE:
  0A19'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A1C'   DA 0A59'              	JC	FL_EOF
  0A1F'   32 1043'              	STA	LYLAST
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A22'   FE 0A                 	CPI	LF
  0A24'   CA 0A57'              	JZ	FL_LF
  0A27'   FE 0D                 	CPI	CR
  0A29'   CA 0A19'              	JZ	FLINE		; CR contributes no display column
  0A2C'   FE 09                 	CPI	TAB
  0A2E'   CA 0A3A'              	JZ	FL_TAB
  0A31'   CD 0A5C'              	CALL	FL_CEL
  0A34'   C2 0A19'              	JNZ	FLINE
  0A37'                         FL_OVR:
  0A37'   3E 01                 	MVI	A,1
  0A39'   C9                    	RET
  0A3A'                         FL_TAB:
