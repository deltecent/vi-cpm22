  096D'   B7                    	ORA	A
  096E'   37                    	STC
  096F'   C8                    	RZ
  0970'   21 0E4F'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0973'   34                    	INR	M
  0974'   B7                    	ORA	A
  0975'   C9                    	RET
  0976'                         LB_1:
  0976'   7E                    	MOV	A,M
  0977'   CD 09AC'              	CALL	LM_ADD
  097A'   D8                    	RC
  097B'   21 0E4F'              	LXI	H,LYMBL
  097E'   86                    	ADD	M
  097F'   77                    	MOV	M,A
  0980'   2A 0E48'              	LHLD	LYIB
  0983'   23                    	INX	H
  0984'   22 0E48'              	SHLD	LYIB
  0987'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
