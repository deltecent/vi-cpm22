  06A9'   22 0000*              	SHLD	AUXCNT
  06AC'   3A 0D80'              	LDA	SVDIR
  06AF'   32 0000*              	STA	DIRFLG
  06B2'   C9                    	RET
                                
                                ;LYQK -- the layout of a key that left every line on the screen the rows it
                                ; had: the row table stands, and the screen is not read again.
                                ; A key that only moved the cursor, in command mode, to a line the screen
                                ; shows whole already: what moves with the cursor is found from the cursor --
                                ; the lines above it (WINROW), the table's entry for its line (HTCUR), the
                                ; rows over it (LYABV), where the top line is from here (TOPLEN, WRLIM), and
                                ; its column, for which its own line is measured as far as the cursor and no
                                ; farther.
                                ; A key that changed the cursor's line and no other (R_ICH, R_DCH, R_LINE; a
                                ; move in insert mode goes this way too, the cursor there being free to stand
                                ; past the line's end): that one line is measured whole, and if it takes the
                                ; rows it took, that is the layout.
                                ;   out: CY when that was the layout; NC when the screen has to be measured:
                                ;        the table is not the screen's (LYOK), the pager moved the text
                                ;        (PGTOPM), the key did more than that (RINTENT), the command placed
                                ;        the line (PLACE), the cursor's line is off the screen or cut, the top
                                ;        line is taller than the screen, or the line changed takes other rows
                                ;        than it did.  (What is set by then LAYOUT sets again.)
  06B3'                         LYQK:
  06B3'   3A 0D59'              	LDA	LYOK
  06B6'   B7                    	ORA	A
  06B7'   C8                    	RZ
  06B8'   CD 07C1'              	CALL	LQMV
  06BB'   CA 06DD'              	JZ	LQK_G
  06BE'   2A 0000*              	LHLD	LNDLT		; an edit: of the line the cursor was on
  06C1'   7C                    	MOV	A,H
  06C2'   B5                    	ORA	L
  06C3'   C2 07BF'              	JNZ	LQK_N
  06C6'   3A 0000*              	LDA	RINTENT
  06C9'   FE 01                 	CPI	R_MOVE
  06CB'   CA 06DD'              	JZ	LQK_G
  06CE'   FE 02                 	CPI	R_LINE
  06D0'   CA 06DD'              	JZ	LQK_G
  06D3'   FE 04                 	CPI	R_ICH
  06D5'   CA 06DD'              	JZ	LQK_G
  06D8'   FE 07                 	CPI	R_DCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  06DA'   C2 07BF'              	JNZ	LQK_N
  06DD'                         LQK_G:
  06DD'   2A 0D35'              	LHLD	SKIPR
  06E0'   3A 0D63'              	LDA	PLACE
  06E3'   B4                    	ORA	H
  06E4'   B5                    	ORA	L
  06E5'   21 0D7A'              	LXI	H,LYXE
  06E8'   B6                    	ORA	M
  06E9'   21 0D56'              	LXI	H,TALLF
  06EC'   B6                    	ORA	M
  06ED'   C2 07BF'              	JNZ	LQK_N
  06F0'   2A 0000*              	LHLD	PGTOPM		; (and the text in memory starts where it did:
  06F3'   EB                    	XCHG			;   the pager has not moved the window since)
  06F4'   2A 0D5D'              	LHLD	LYPG
  06F7'   CD 0000*              	CALL	CMP16
  06FA'   C2 07BF'              	JNZ	LQK_N
  06FD'   2A 0D33'              	LHLD	WINROW
  0700'   EB                    	XCHG
  0701'   2A 0000*              	LHLD	LNDLT
  0704'   19                    	DAD	D		; HL = the lines that would be above it
  0705'   7C                    	MOV	A,H
  0706'   B7                    	ORA	A
  0707'   C2 07BF'              	JNZ	LQK_N		; over the top line, or far under the last
  070A'   3A 0D3B'              	LDA	SCBOT
  070D'   BD                    	CMP	L		; CY iff it is under the last line shown
  070E'   DA 07BF'              	JC	LQK_N
  0711'   22 0D33'              	SHLD	WINROW
  0714'   2A 0000*              	LHLD	LNDLT
  0717'   22 0D6B'              	SHLD	LYDLT
  071A'   3A 0000*              	LDA	HTCUR
  071D'   85                    	ADD	L
  071E'   32 0000*              	STA	HTCUR
  0721'   21 0000               	LXI	H,0
  0724'   22 0000*              	SHLD	LNDLT
  0727'   22 0D57'              	SHLD	SCRLN
  072A'   2A 0000*              	LHLD	TXTBEG		; the top line is as far into the text in
  072D'   EB                    	XCHG			;   memory as it was
  072E'   2A 0D5B'              	LHLD	LYTOP
  0731'   19                    	DAD	D
  0732'   CD 0931'              	CALL	G2P
  0735'   22 0D65'              	SHLD	TOPLEN
  0738'   24                    	INR	H
  0739'   22 0000*              	SHLD	WRLIM
  073C'   21 0000               	LXI	H,0		; the cursor's line, as far as the cursor
  073F'   CD 0000*              	CALL	LINPSB
  0742'   E5                    	PUSH	H
  0743'   CD 0931'              	CALL	G2P
  0746'   22 0D67'              	SHLD	CBOL
  0749'   44                    	MOV	B,H
  074A'   4D                    	MOV	C,L
  074B'   E1                    	POP	H
  074C'   CD 0938'              	CALL	LNW
  074F'   EB                    	XCHG
  0750'   22 0D69'              	SHLD	CURDCL
  0753'   CD 052C'              	CALL	DIVN
  0756'   32 0D5A'              	STA	LQKC		; (the cells before it on that row)
