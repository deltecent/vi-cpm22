  0B3A'   21 0000               	LXI	H,0
  0B3D'                         MH_LP:
  0B3D'   19                    	DAD	D
  0B3E'   3D                    	DCR	A
  0B3F'   C2 0B3D'              	JNZ	MH_LP
  0B42'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0B43'                         TABN:
  0B43'   3A 0CB8'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0B46'   E6 07                 	ANI	7
  0B48'   4F                    	MOV	C,A
  0B49'   3E 08                 	MVI	A,8
