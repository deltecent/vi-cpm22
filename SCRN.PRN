  0A9C'   00                    LYMEOF: DB	0		; LYMID: the text has ended
  0A9D'   00                    LYXE:	DB	0		; LAYOUT: WR_EOL+1 when the cursor has its own row
  0A9E'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0A9F'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0AA1'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0AA3'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0AA4'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0AA6'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0AA8'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0AAA'   0000                  RDBC:	DW	0		; reader: RGET count
  0AAC'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0AAD'   00                    SKPN:	DB	0		; RDSKIP line count
  0AAE'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0AAF'   00                    SCLN:	DB	0		; region-scroll line count (N, 1..NEDIT-1)
  0AB0'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0AB1'   00                    XC:	DB	0		; cells used in the row being painted
  0AB2'   00                    ROWCT:	DB	0		; RI count (SCBWD)
  0AB3'   00                    ILLAST: DB	0		; ... and the last screen row it draws
                                
  0AB4'   00                    SROW:	DB	0		; computed cursor screen row
  0AB5'   00                    SCOL:	DB	0		; computed cursor screen column
  0AB6'   0000                  TMPR:	DW	0		; DSR parse: rows
  0AB8'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
