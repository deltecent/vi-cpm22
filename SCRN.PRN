  1066'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  1068'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  106A'   00                    LYROW:	DB	0		; LAYOUT: working row
  106B'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  106D'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  106E'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  1070'   00                    LYUSE:	DB	0		; LYMID: rows taken
  1071'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  1072'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  1073'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  1074'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  1075'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  1076'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  1077'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  1078'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  1079'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  107B'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  107D'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  107E'   0000                  RDP:	DW	0		; reader: next before-gap byte
  1080'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  1082'   0000                  RDHL:	DW	0		; reader: RGET pointer
  1084'   0000                  RDBC:	DW	0		; reader: RGET count
  1086'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  1087'   00                    SKPN:	DB	0		; RDSKIP line count
  1088'   00                    PROWN:	DB	0		; screen row being painted (0-based)
