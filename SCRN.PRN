  0AF4'   C2 0B03'              	JNZ	LB_1
  0AF7'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0AFA'   B7                    	ORA	A
  0AFB'   37                    	STC
  0AFC'   C8                    	RZ
  0AFD'   21 103D'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0B00'   34                    	INR	M
  0B01'   B7                    	ORA	A
  0B02'   C9                    	RET
  0B03'                         LB_1:
  0B03'   7E                    	MOV	A,M
  0B04'   CD 0B39'              	CALL	LM_ADD
  0B07'   D8                    	RC
  0B08'   21 103D'              	LXI	H,LYMBL
  0B0B'   86                    	ADD	M
  0B0C'   77                    	MOV	M,A
  0B0D'   2A 1036'              	LHLD	LYIB
  0B10'   23                    	INX	H
  0B11'   22 1036'              	SHLD	LYIB
  0B14'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0B15'                         LMABV:
  0B15'   21 1035'              	LXI	H,LYROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B18'   3A 0000*              	LDA	HTCUR
  0B1B'   96                    	SUB	M
  0B1C'   37                    	STC
  0B1D'   C8                    	RZ
  0B1E'   3D                    	DCR	A
  0B1F'   CD 0B31'              	CALL	HTE
  0B22'   7E                    	MOV	A,M
  0B23'   CD 0B39'              	CALL	LM_ADD
  0B26'   D8                    	RC
  0B27'   21 103C'              	LXI	H,LYMAB
  0B2A'   86                    	ADD	M
  0B2B'   77                    	MOV	M,A
  0B2C'   21 1035'              	LXI	H,LYROW
  0B2F'   34                    	INR	M
  0B30'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B31'                         HTE:
  0B31'   5F                    	MOV	E,A
  0B32'   16 00                 	MVI	D,0
  0B34'   21 0000*              	LXI	H,HTAB
  0B37'   19                    	DAD	D
  0B38'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0B39'                         LM_ADD:
  0B39'   47                    	MOV	B,A
  0B3A'   3A 103B'              	LDA	LYUSE
  0B3D'   80                    	ADD	B
  0B3E'   D8                    	RC
  0B3F'   4F                    	MOV	C,A
  0B40'   3A 0FF8'              	LDA	NEDIT
  0B43'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B44'   D8                    	RC
  0B45'   79                    	MOV	A,C
  0B46'   32 103B'              	STA	LYUSE
  0B49'   78                    	MOV	A,B
  0B4A'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ; A line that is in memory to its LF is measured where it lies (LNW), as the
                                ; lines above the cursor's are; FLINE, a char at a time through RDGET, reads
                                ; the one the bytes run out in, and the one taller than the screen.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B4B'                         LM_NX:
  0B4B'   AF                    	XRA	A
  0B4C'   32 1038'              	STA	LYVB
  0B4F'   2A 104F'              	LHLD	RDBC
  0B52'   44                    	MOV	B,H
  0B53'   4D                    	MOV	C,L
  0B54'   2A 104D'              	LHLD	RDHL
  0B57'   E5                    	PUSH	H
  0B58'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B59'   CD 0B9E'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0B5C'   D2 0B80'              	JNC	LN_SL
  0B5F'   E5                    	PUSH	H
  0B60'   C5                    	PUSH	B
  0B61'   EB                    	XCHG
  0B62'   CD 05D3'              	CALL	XTRA		; BC = its rows past the first
  0B65'   78                    	MOV	A,B
  0B66'   B7                    	ORA	A
  0B67'   51                    	MOV	D,C
  0B68'   C1                    	POP	B
  0B69'   E1                    	POP	H
