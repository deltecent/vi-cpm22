  0B54'                         G2P:
  0B54'   EB                    	XCHG
  0B55'   2A 0000*              	LHLD	GAPBEG
  0B58'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0B5B'                         LNW:
  0B5B'   11 0000               	LXI	D,0
  0B5E'                         LNW_LP:
  0B5E'   78                    	MOV	A,B
  0B5F'   B1                    	ORA	C
  0B60'   C8                    	RZ
  0B61'   7E                    	MOV	A,M
  0B62'   23                    	INX	H
  0B63'   0B                    	DCX	B
  0B64'   FE 0A                 	CPI	LF
  0B66'   CA 0B7B'              	JZ	LNW_LF
  0B69'   FE 0D                 	CPI	CR
  0B6B'   CA 0B5E'              	JZ	LNW_LP		; CR contributes no display column
  0B6E'   FE 09                 	CPI	TAB
  0B70'   C2 0B77'              	JNZ	LNW_1
  0B73'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0B74'   F6 07                 	ORI	TABWID-1
  0B76'   5F                    	MOV	E,A
  0B77'                         LNW_1:
  0B77'   13                    	INX	D
  0B78'   C3 0B5E'              	JMP	LNW_LP
  0B7B'                         LNW_LF:
  0B7B'   37                    	STC
  0B7C'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0B7D'                         LYFAR:
  0B7D'   2A 0F82'              	LHLD	WINROW
  0B80'   EB                    	XCHG
  0B81'   2A 0000*              	LHLD	LNDLT
  0B84'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0B85'   7C                    	MOV	A,H
  0B86'   B7                    	ORA	A
  0B87'   F2 0B9E'              	JP	LF_DN
  0B8A'   3A 0F81'              	LDA	NEDIT
  0B8D'   B7                    	ORA	A
  0B8E'   1F                    	RAR
  0B8F'   D6 02                 	SUI	2
  0B91'   5F                    	MOV	E,A
  0B92'   16 00                 	MVI	D,0
  0B94'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0B95'   7C                    	MOV	A,H
  0B96'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B97'   F0                    	RP
  0B98'                         LF_FAR:
  0B98'   3E 02                 	MVI	A,PL_MID
  0B9A'   32 0FB2'              	STA	PLACE
  0B9D'   C9                    	RET
  0B9E'                         LF_DN:
  0B9E'   3A 0F8A'              	LDA	SCBOT
  0BA1'   3C                    	INR	A
  0BA2'   5F                    	MOV	E,A
  0BA3'   16 00                 	MVI	D,0
  0BA5'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0BA8'   7C                    	MOV	A,H		;   less one
  0BA9'   B7                    	ORA	A
  0BAA'   F8                    	RM			; on the screen
  0BAB'   C2 0B98'              	JNZ	LF_FAR
  0BAE'   3A 0F81'              	LDA	NEDIT
  0BB1'   BD                    	CMP	L		; CY iff NEDIT < that
  0BB2'   DA 0B98'              	JC	LF_FAR
  0BB5'   7D                    	MOV	A,L
  0BB6'   32 0FC5'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0BB9'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0BBA'                         HTBLD:
  0BBA'   79                    	MOV	A,C
  0BBB'   32 0FC8'              	STA	HTLIM
  0BBE'   AF                    	XRA	A
  0BBF'   32 0000*              	STA	HTN
  0BC2'   32 0FA8'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0BC5'   32 0000*              	STA	HTEOF
  0BC8'   32 0000*              	STA	HTBOF
  0BCB'   32 0FC9'              	STA	LYXE
  0BCE'   32 0FA5'              	STA	TALLF
  0BD1'   68                    	MOV	L,B
  0BD2'   67                    	MOV	H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BD3'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0BD6'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0BD7'   E5                    	PUSH	H
  0BD8'   CD 0A5C'              	CALL	ISBOF
  0BDB'   C2 0BE2'              	JNZ	HB_1
  0BDE'   3C                    	INR	A
  0BDF'   32 0000*              	STA	HTBOF
  0BE2'                         HB_1:
  0BE2'   E1                    	POP	H
  0BE3'   E5                    	PUSH	H
  0BE4'   CD 0B54'              	CALL	G2P		; HL = the bytes from there to the cursor
  0BE7'   E5                    	PUSH	H
  0BE8'   3A 0F80'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0BEB'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0BED'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0BEE'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0BF0'   3A 0F81'              	LDA	NEDIT		;   leave no room to read down
  0BF3'   CD 0E52'              	CALL	MULHA
  0BF6'   D1                    	POP	D
  0BF7'   42                    	MOV	B,D
  0BF8'   4B                    	MOV	C,E
  0BF9'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0BFC'   D2 0C00'              	JNC	HB_LM
  0BFF'   EB                    	XCHG
  0C00'                         HB_LM:
  0C00'   22 0FC0'              	SHLD	LYLIM
  0C03'   E1                    	POP	H
  0C04'   F1                    	POP	PSW
  0C05'   D2 0C0F'              	JNC	HB_AB
  0C08'   3A 0000*              	LDA	HTBOF
  0C0B'   B7                    	ORA	A
  0C0C'   CC 0B5B'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C0F'                         HB_AB:
  0C0F'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C10'   CD 0B5B'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0C13'   D2 0C36'              	JNC	HB_CU
  0C16'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0C17'   C5                    	PUSH	B
  0C18'   EB                    	XCHG
  0C19'   CD 05D3'              	CALL	XTRA		; BC = its rows past the first
  0C1C'   78                    	MOV	A,B
  0C1D'   B7                    	ORA	A
  0C1E'   C2 0C2B'              	JNZ	HB_TA
  0C21'   3A 0F81'              	LDA	NEDIT
  0C24'   3D                    	DCR	A
  0C25'   B9                    	CMP	C		; CY iff more rows than the screen has
  0C26'   79                    	MOV	A,C
  0C27'   3C                    	INR	A
  0C28'   D2 0C2E'              	JNC	HB_PA
  0C2B'                         HB_TA:
  0C2B'   3A 0F81'              	LDA	NEDIT
  0C2E'                         HB_PA:
  0C2E'   CD 0D47'              	CALL	HTPUT
  0C31'   C1                    	POP	B
  0C32'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C33'   C3 0C0F'              	JMP	HB_AB
  0C36'                         HB_CU:
  0C36'   EB                    	XCHG
  0C37'   22 0FB8'              	SHLD	CURDCL
  0C3A'   E1                    	POP	H
  0C3B'   22 0FB6'              	SHLD	CBOL
  0C3E'   EB                    	XCHG			; none of it spilled while reading down: the
  0C3F'   2A 0FC0'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0C42'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0C45'   DA 0C49'              	JC	HB_WL
  0C48'   EB                    	XCHG
  0C49'                         HB_WL:
  0C49'   24                    	INR	H
  0C4A'   22 0000*              	SHLD	WRLIM
  0C4D'   3A 0000*              	LDA	HTN
  0C50'   32 0000*              	STA	HTCUR
  0C53'   2A 0FB8'              	LHLD	CURDCL
  0C56'   CD 05DA'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0C59'   5F                    	MOV	E,A
  0C5A'   3A 0FB8'              	LDA	CURDCL
  0C5D'   93                    	SUB	E
  0C5E'   32 0FBF'              	STA	LYVB		; the column the cursor's row starts at
  0C61'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0C62'   2A 0F84'              	LHLD	SKIPR
  0C65'   50                    	MOV	D,B
  0C66'   59                    	MOV	E,C
  0C67'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0C6A'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0C6B'   DA 0C89'              	JC	HB_SS		; then that is the first
  0C6E'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0C71'   7C                    	MOV	A,H
  0C72'   B7                    	ORA	A
  0C73'   C2 0C7F'              	JNZ	HB_SD
  0C76'   3A 0F81'              	LDA	NEDIT
  0C79'   3D                    	DCR	A
  0C7A'   BD                    	CMP	L		; CY iff that is under the last edit row
  0C7B'   EB                    	XCHG			; HL = SKIPR, as it was
  0C7C'   D2 0C89'              	JNC	HB_SS
  0C7F'                         HB_SD:
  0C7F'   3A 0F81'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0C82'   2F                    	CMA
  0C83'   6F                    	MOV	L,A
  0C84'   26 FF                 	MVI	H,0FFH
  0C86'   23                    	INX	H
  0C87'   23                    	INX	H
  0C88'   09                    	DAD	B
  0C89'                         HB_SS:
  0C89'   22 0F84'              	SHLD	SKIPR
  0C8C'   EB                    	XCHG
  0C8D'   60                    	MOV	H,B
  0C8E'   69                    	MOV	L,C
  0C8F'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0C92'   7D                    	MOV	A,L
  0C93'   32 0F8D'              	STA	CSRAW
  0C96'   D1                    	POP	D
  0C97'   57                    	MOV	D,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C98'   CD 0000*              	CALL	RGET0
  0C9B'   CD 0B42'              	CALL	LM_FL		; the rest of the line: D = its last row
  0C9E'   F5                    	PUSH	PSW
  0C9F'   FE 01                 	CPI	1
  0CA1'   CA 0D30'              	JZ	HB_TO		; more rows than the screen has
  0CA4'   2A 0F84'              	LHLD	SKIPR
  0CA7'   7C                    	MOV	A,H
  0CA8'   B5                    	ORA	L
  0CA9'   CA 0CCC'              	JZ	HB_E2
  0CAC'   7C                    	MOV	A,H
  0CAD'   B7                    	ORA	A
  0CAE'   C2 0CC7'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0CB1'   7D                    	MOV	A,L
  0CB2'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0CB3'   DA 0CC7'              	JC	HB_TE
  0CB6'   21 0F81'              	LXI	H,NEDIT
  0CB9'   BE                    	CMP	M
  0CBA'   D2 0CC7'              	JNC	HB_TE		; more than NEDIT of them
  0CBD'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0CBE'   21 0000               	LXI	H,0
  0CC1'   22 0F84'              	SHLD	SKIPR
  0CC4'   C3 0CCC'              	JMP	HB_E2
  0CC7'                         HB_TE:
  0CC7'   3E 01                 	MVI	A,1
  0CC9'   32 0FA5'              	STA	TALLF
  0CCC'                         HB_E2:
  0CCC'   7B                    	MOV	A,E
  0CCD'   B7                    	ORA	A
  0CCE'   C2 0CDA'              	JNZ	HB_E3
  0CD1'   B2                    	ORA	D
  0CD2'   CA 0CDA'              	JZ	HB_E3		; (its first row: an empty line)
  0CD5'   3E 01                 	MVI	A,1
  0CD7'   32 0FC9'              	STA	LYXE
  0CDA'                         HB_E3:
  0CDA'   7A                    	MOV	A,D
  0CDB'   3C                    	INR	A
  0CDC'   32 0F8E'              	STA	LYTSH
  0CDF'   3A 0FA5'              	LDA	TALLF
  0CE2'   B7                    	ORA	A
  0CE3'   C2 0D3B'              	JNZ	HB_TX
  0CE6'   F1                    	POP	PSW
  0CE7'   FA 0D0C'              	JM	HB_LS		; the text ends with it
  0CEA'                         HB_PT:
  0CEA'   7A                    	MOV	A,D
  0CEB'   3C                    	INR	A
  0CEC'   CD 0D47'              	CALL	HTPUT
  0CEF'   47                    	MOV	B,A
  0CF0'   3A 0FC8'              	LDA	HTLIM
  0CF3'   90                    	SUB	B
  0CF4'   32 0FC8'              	STA	HTLIM
  0CF7'   D8                    	RC
  0CF8'   CA 0D17'              	JZ	HB_PK		; rows enough
  0CFB'                         HB_NX:
  0CFB'   CD 0B33'              	CALL	LM_NX		; the next line down
  0CFE'   CA 0CEA'              	JZ	HB_PT
  0D01'   F2 0D44'              	JP	HB_TL		; one taller than the screen
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0D04'   3A 0FCA'              	LDA	LYLAST		; the text ended: was that a line?
  0D07'   FE 0A                 	CPI	LF
  0D09'   CA 0D11'              	JZ	HB_EF
  0D0C'                         HB_LS:
  0D0C'   7A                    	MOV	A,D
  0D0D'   3C                    	INR	A
  0D0E'   CD 0D47'              	CALL	HTPUT
  0D11'                         HB_EF:
  0D11'   3E 01                 	MVI	A,1
  0D13'   32 0000*              	STA	HTEOF
  0D16'   C9                    	RET
  0D17'                         HB_PK:
  0D17'   2A 0FD6'              	LHLD	RDBC		; just the rows asked for: is the text over
  0D1A'   44                    	MOV	B,H		;   right there?
  0D1B'   4D                    	MOV	C,L
  0D1C'   2A 0FD4'              	LHLD	RDHL
  0D1F'   CD 0000*              	CALL	RDGET
  0D22'   D0                    	RNC
  0D23'   C3 0D11'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0D26'                         HBMOR:
  0D26'   32 0FC8'              	STA	HTLIM
  0D29'   B7                    	ORA	A
  0D2A'   CA 0D17'              	JZ	HB_PK
  0D2D'   C3 0CFB'              	JMP	HB_NX
  0D30'                         HB_TO:
  0D30'   3E 01                 	MVI	A,1
  0D32'   32 0FA5'              	STA	TALLF
  0D35'   3A 0F81'              	LDA	NEDIT
  0D38'   32 0F8E'              	STA	LYTSH
  0D3B'                         HB_TX:
  0D3B'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0D3C'   F2 0D44'              	JP	HB_TL		;   with it, and on the screen)
  0D3F'   3E 01                 	MVI	A,1
  0D41'   32 0000*              	STA	HTEOF
  0D44'                         HB_TL:
  0D44'   3A 0F81'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0D47'                         HTPUT:
  0D47'   E5                    	PUSH	H
  0D48'   D5                    	PUSH	D
  0D49'   21 0000*              	LXI	H,HTN
  0D4C'   5E                    	MOV	E,M
  0D4D'   1C                    	INR	E
  0D4E'   CA 0D5A'              	JZ	HP_1
  0D51'   73                    	MOV	M,E
  0D52'   1D                    	DCR	E
  0D53'   16 00                 	MVI	D,0
  0D55'   21 0000*              	LXI	H,HTAB
  0D58'   19                    	DAD	D
  0D59'   77                    	MOV	M,A
  0D5A'                         HP_1:
  0D5A'   D1                    	POP	D
  0D5B'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D5C'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0D5D'                         TABCUR:
  0D5D'   3A 0000*              	LDA	EDMODE
  0D60'   FE 00                 	CPI	EM_CMD
  0D62'   C0                    	RNZ
  0D63'   2A 0000*              	LHLD	TXTEND
  0D66'   EB                    	XCHG
  0D67'   2A 0000*              	LHLD	GAPEND
  0D6A'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0D6D'   C8                    	RZ
  0D6E'   7E                    	MOV	A,M
  0D6F'   FE 09                 	CPI	TAB
  0D71'   C0                    	RNZ
  0D72'   2A 0FB8'              	LHLD	CURDCL
  0D75'   7D                    	MOV	A,L
  0D76'   F6 07                 	ORI	TABWID-1
  0D78'   6F                    	MOV	L,A
  0D79'   22 0FB8'              	SHLD	CURDCL
  0D7C'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0D7D'                         RDTOP:
  0D7D'   2A 0FB4'              	LHLD	TOPLEN
  0D80'   C3 0D86'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0D83'                         RDBOL:
  0D83'   2A 0FB6'              	LHLD	CBOL
  0D86'                         RDSET:
  0D86'   22 0FD2'              	SHLD	RDN
  0D89'   EB                    	XCHG
  0D8A'   2A 0000*              	LHLD	GAPBEG
  0D8D'   CD 0000*              	CALL	SUBHD
  0D90'   22 0FD0'              	SHLD	RDP
  0D93'   AF                    	XRA	A
  0D94'   32 0FD8'              	STA	RDSEG
  0D97'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0D98'                         RDCH:
  0D98'   C5                    	PUSH	B
  0D99'   D5                    	PUSH	D
  0D9A'   E5                    	PUSH	H
  0D9B'   2A 0FD2'              	LHLD	RDN		; before-gap bytes left?
  0D9E'   7C                    	MOV	A,H
  0D9F'   B5                    	ORA	L
  0DA0'   CA 0DB3'              	JZ	RDC_AF
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0DA3'   2B                    	DCX	H
  0DA4'   22 0FD2'              	SHLD	RDN
  0DA7'   2A 0FD0'              	LHLD	RDP
  0DAA'   7E                    	MOV	A,M
  0DAB'   23                    	INX	H
  0DAC'   22 0FD0'              	SHLD	RDP
  0DAF'   B7                    	ORA	A		; CY=0
  0DB0'   C3 0DD7'              	JMP	RDC_RT
  0DB3'                         RDC_AF:
  0DB3'   3A 0FD8'              	LDA	RDSEG
  0DB6'   B7                    	ORA	A
  0DB7'   C2 0DC4'              	JNZ	RDC_NX
  0DBA'   3C                    	INR	A		; first after-gap byte: start RGET
  0DBB'   32 0FD8'              	STA	RDSEG
  0DBE'   CD 0000*              	CALL	RGET0
  0DC1'   C3 0DCC'              	JMP	RDC_GT
  0DC4'                         RDC_NX:
  0DC4'   2A 0FD6'              	LHLD	RDBC
  0DC7'   44                    	MOV	B,H
  0DC8'   4D                    	MOV	C,L
  0DC9'   2A 0FD4'              	LHLD	RDHL
  0DCC'                         RDC_GT:
  0DCC'   CD 0000*              	CALL	RDGET
  0DCF'   22 0FD4'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0DD2'   60                    	MOV	H,B
  0DD3'   69                    	MOV	L,C
  0DD4'   22 0FD6'              	SHLD	RDBC
  0DD7'                         RDC_RT:
  0DD7'   E1                    	POP	H
  0DD8'   D1                    	POP	D
  0DD9'   C1                    	POP	B
  0DDA'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0DDB'                         RDSKIP:
  0DDB'   B7                    	ORA	A
  0DDC'   C8                    	RZ
  0DDD'   32 0FD9'              	STA	SKPN
  0DE0'   2A 0FD2'              	LHLD	RDN		; what lies before the gap is passed over where
  0DE3'   44                    	MOV	B,H		;   it lies
  0DE4'   4D                    	MOV	C,L
  0DE5'   2A 0FD0'              	LHLD	RDP
  0DE8'                         RSK_F:
  0DE8'   78                    	MOV	A,B
  0DE9'   B1                    	ORA	C
  0DEA'   CA 0DFF'              	JZ	RSK_S
  0DED'   7E                    	MOV	A,M
  0DEE'   23                    	INX	H
  0DEF'   0B                    	DCX	B
  0DF0'   FE 0A                 	CPI	LF
  0DF2'   C2 0DE8'              	JNZ	RSK_F
  0DF5'   3A 0FD9'              	LDA	SKPN
  0DF8'   3D                    	DCR	A
  0DF9'   32 0FD9'              	STA	SKPN
  0DFC'   C2 0DE8'              	JNZ	RSK_F
  0DFF'                         RSK_S:
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0DFF'   22 0FD0'              	SHLD	RDP
  0E02'   60                    	MOV	H,B
  0E03'   69                    	MOV	L,C
  0E04'   22 0FD2'              	SHLD	RDN
  0E07'   3A 0FD9'              	LDA	SKPN
  0E0A'   B7                    	ORA	A
  0E0B'   C8                    	RZ
  0E0C'                         RSK_LP:
  0E0C'   CD 0D98'              	CALL	RDCH
  0E0F'   D8                    	RC
  0E10'   FE 0A                 	CPI	LF
  0E12'   C2 0E0C'              	JNZ	RSK_LP
  0E15'   3A 0FD9'              	LDA	SKPN
  0E18'   3D                    	DCR	A
  0E19'   32 0FD9'              	STA	SKPN
  0E1C'   C2 0E0C'              	JNZ	RSK_LP
  0E1F'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0E20'                         PSKIP:
  0E20'   3A 0F80'              	LDA	NCOLS
  0E23'   CD 0E52'              	CALL	MULHA		; HL = the cells to pass over
  0E26'   EB                    	XCHG
  0E27'   21 0000               	LXI	H,0
  0E2A'   22 0FDB'              	SHLD	PSKN
  0E2D'                         PS_LP:
  0E2D'   7A                    	MOV	A,D
  0E2E'   B3                    	ORA	E
  0E2F'   CA 0E86'              	JZ	PR_LP
  0E32'   CD 0D98'              	CALL	RDCH
  0E35'   FE 0D                 	CPI	CR
  0E37'   CA 0E2D'              	JZ	PS_LP
  0E3A'   0E 01                 	MVI	C,1
  0E3C'   FE 09                 	CPI	TAB
  0E3E'   CC 0E5C'              	CZ	TABN
  0E41'                         PS_CL:
  0E41'   7A                    	MOV	A,D
  0E42'   B3                    	ORA	E
  0E43'   CA 0EA0'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0E46'   1B                    	DCX	D
  0E47'   21 0FDD'              	LXI	H,DCOL
  0E4A'   34                    	INR	M
  0E4B'   0D                    	DCR	C
  0E4C'   C2 0E41'              	JNZ	PS_CL
  0E4F'   C3 0E2D'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0E52'                         MULHA:
  0E52'   EB                    	XCHG
  0E53'   21 0000               	LXI	H,0
  0E56'                         MH_LP:
  0E56'   19                    	DAD	D
  0E57'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E58'   C2 0E56'              	JNZ	MH_LP
  0E5B'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0E5C'                         TABN:
  0E5C'   3A 0FDD'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0E5F'   E6 07                 	ANI	7
  0E61'   4F                    	MOV	C,A
  0E62'   3E 08                 	MVI	A,8
  0E64'   91                    	SUB	C
  0E65'   4F                    	MOV	C,A
  0E66'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0E67'                         PAINTR:
  0E67'   3A 0FDA'              	LDA	PROWN
  0E6A'   21 0F88'              	LXI	H,TXEND
  0E6D'   BE                    	CMP	M		; CY iff the row holds text
  0E6E'   DA 0E77'              	JC	PROW
  0E71'   3A 0F89'              	LDA	FILCH
  0E74'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0E77'                         PROW:
  0E77'   AF                    	XRA	A
  0E78'   32 0FDD'              	STA	DCOL
  0E7B'   32 0FDE'              	STA	XC
  0E7E'   2A 0FDB'              	LHLD	PSKN
  0E81'   7C                    	MOV	A,H
  0E82'   B5                    	ORA	L
  0E83'   C2 0E20'              	JNZ	PSKIP
  0E86'                         PR_LP:
  0E86'   CD 0D98'              	CALL	RDCH
  0E89'   D8                    	RC			; end of text -> line done
  0E8A'   FE 0A                 	CPI	LF
  0E8C'   C8                    	RZ			; consumed the LF -> next line start
  0E8D'   FE 0D                 	CPI	CR
  0E8F'   CA 0E86'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0E92'   FE 09                 	CPI	TAB
  0E94'   CA 0E9D'              	JZ	PR_TAB
  0E97'   CD 0EAC'              	CALL	PCELL
  0E9A'   C3 0E86'              	JMP	PR_LP
  0E9D'                         PR_TAB:
  0E9D'   CD 0E5C'              	CALL	TABN		; C = space count (1..8)
  0EA0'                         PRTBLP:
  0EA0'   3E 20                 	MVI	A,' '
  0EA2'   CD 0EAC'              	CALL	PCELL		; (keeps C)
  0EA5'   0D                    	DCR	C
  0EA6'   C2 0EA0'              	JNZ	PRTBLP
  0EA9'   C3 0E86'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0EAC'                         PCELL:
  0EAC'   47                    	MOV	B,A
  0EAD'   21 0FDD'              	LXI	H,DCOL
  0EB0'   34                    	INR	M
  0EB1'   3A 0F80'              	LDA	NCOLS
  0EB4'   21 0FDE'              	LXI	H,XC
  0EB7'   BE                    	CMP	M
  0EB8'   CC 0EC0'              	CZ	PWRAP		; the row is full: this one starts the next
  0EBB'   34                    	INR	M
  0EBC'   78                    	MOV	A,B
  0EBD'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0EC0'                         PWRAP:
  0EC0'   36 00                 	MVI	M,0
  0EC2'   3A 0FA4'              	LDA	PEND
  0EC5'   3D                    	DCR	A
  0EC6'   21 0FDA'              	LXI	H,PROWN
  0EC9'   BE                    	CMP	M
  0ECA'   CA 0EDF'              	JZ	PW_END
  0ECD'   34                    	INR	M
  0ECE'   3E 0D                 	MVI	A,CR
  0ED0'   CD 0018'              	CALL	OUTCH
  0ED3'   3E 0A                 	MVI	A,LF
  0ED5'   CD 0018'              	CALL	OUTCH
  0ED8'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0EDB'   21 0FDE'              	LXI	H,XC
  0EDE'   C9                    	RET
  0EDF'                         PW_END:
  0EDF'   E1                    	POP	H		; PCELL's return, and PROW's
  0EE0'   E1                    	POP	H
  0EE1'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0EE2'                         MODEMS:
  0EE2'   3A 0000*              	LDA	EDMODE
  0EE5'   47                    	MOV	B,A
  0EE6'   3A 0FAF'              	LDA	OEDMOD
  0EE9'   B8                    	CMP	B
  0EEA'   C8                    	RZ			; the row already shows this mode
  0EEB'   78                    	MOV	A,B
  0EEC'   32 0FAF'              	STA	OEDMOD
  0EEF'   21 0F5F'              	LXI	H,SINSM
  0EF2'   FE 01                 	CPI	EM_INS
  0EF4'   CA 0F02'              	JZ	MD_DRW
  0EF7'   21 0F6C'              	LXI	H,SREPM
  0EFA'   FE 02                 	CPI	EM_REP
  0EFC'   CA 0F02'              	JZ	MD_DRW
  0EFF'   21 0F7A'              	LXI	H,SNULL		; command mode: the row goes blank
  0F02'                         MD_DRW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0F02'   E5                    	PUSH	H
  0F03'   3A 0F7F'              	LDA	NROWS
  0F06'   CD 008C'              	CALL	GOROW1
  0F09'   E1                    	POP	H
  0F0A'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0F0D'                         SCURS:
  0F0D'   3A 0F86'              	LDA	SROW
  0F10'   47                    	MOV	B,A
  0F11'   3A 0F87'              	LDA	SCOL
  0F14'   4F                    	MOV	C,A
  0F15'   CD 0064'              	CALL	GOTOXY
  0F18'   21 0F54'              	LXI	H,SSHOW
  0F1B'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0F1E'                         SCDONE:
  0F1E'   CD 0086'              	CALL	CRGRS
  0F21'   21 0F54'              	LXI	H,SSHOW
  0F24'   CD 0025'              	CALL	OUTSTR
  0F27'   3A 0F7F'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0F2A'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0F2D'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0F31'   39 3B 39 39           
  0F35'   39 48                 
  0F37'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0F3B'   00                    
  0F3C'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0F40'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0F43'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0F47'   00                    
  0F48'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0F4C'   00                    
  0F4D'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0F51'   35 6C 00              
  0F54'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0F58'   35 68 00              
  0F5B'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0F5F'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0F63'   4E 53 45 52           
  0F67'   54 20 2D 2D           
  0F6B'   00                    
  0F6C'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0F70'   45 50 4C 41           
  0F74'   43 45 20 2D           
  0F78'   2D 00                 
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0F7A'   00                    SNULL:	DB	0
  0F7B'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0F7F'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0F80'   50                    NCOLS:	DB	80		; runtime columns
  0F81'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0F82'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0F84'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0F86'   00                    SROW:	DB	0		; computed cursor screen row
  0F87'   00                    SCOL:	DB	0		; computed cursor screen column
  0F88'   01                    TXEND:	DB	1		; the first row with no text on it
  0F89'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0F8A'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0F8B'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0F8D'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0F8E'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0F8F'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0F90'   0000                  OLDWR:	DW	0
  0F92'   0000                  OLDSK:	DW	0
  0F94'   0000                  OLDSC:	DW	0
  0F96'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0F98'   00                    OLDBOT:	DB	0
  0F99'   0000                  OLDAB:	DW	0
  0F9B'   00                    OLDCS:	DB	0
  0F9C'   00                    OLDCR:	DB	0
  0F9D'   00                    OLDNR:	DB	0
                                
  0F9E'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0F9F'   00                    OPM:	DB	0		; ... or gained there
  0FA0'   00                    EDA:	DB	0		; the edit: the rows it had
  0FA1'   00                    EDB:	DB	0		; ... and has
  0FA2'   00                    EDR:	DB	0		; ... its first row
  0FA3'   00                    EDP:	DB	0		; ... the first of them to draw
  0FA4'   00                    PEND:	DB	0		; PRNG: the row to stop before
  0FA5'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0FA6'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0FA8'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  0FA9'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  0FAA'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  0FAC'   0000                  LYPG:	DW	0		; ... and PGTOPM
  0FAE'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  0FAF'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0FB0'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0FB1'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0FB2'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0FB3'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0FB4'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0FB6'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0FB8'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0FBA'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0FBC'   00                    LYROW:	DB	0		; LAYOUT: working row
  0FBD'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0FBF'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0FC0'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0FC2'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0FC3'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0FC4'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0FC5'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0FC6'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0FC7'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0FC8'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0FC9'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0FCA'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0FCB'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0FCD'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0FCF'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0FD0'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0FD2'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0FD4'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0FD6'   0000                  RDBC:	DW	0		; reader: RGET count
  0FD8'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0FD9'   00                    SKPN:	DB	0		; RDSKIP line count
  0FDA'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0FDB'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0FDD'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0FDE'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0FDF'   0000                  TMPR:	DW	0		; DSR parse: rows
  0FE1'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
