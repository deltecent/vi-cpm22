  09B0'   34                    	INR	M
  09B1'   AF                    	XRA	A
  09B2'   32 0000*              	STA	HTCUR
  09B5'   32 0000*              	STA	HTBOF
  09B8'   2A 0FB6'              	LHLD	CBOL
  09BB'   CD 0B54'              	CALL	G2P
  09BE'   CD 0A5C'              	CALL	ISBOF
  09C1'   37                    	STC
  09C2'   C0                    	RNZ
