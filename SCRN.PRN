  08D5'                         LT_3:
  08D5'   7D                    	MOV	A,L
  08D6'   BB                    	CMP	E
  08D7'   C2 08DF'              	JNZ	LT_4
  08DA'   7C                    	MOV	A,H
  08DB'   BA                    	CMP	D
  08DC'   CA 08E9'              	JZ	LT_NO		; (the gap: not as it should be)
  08DF'                         LT_4:
  08DF'   7E                    	MOV	A,M
