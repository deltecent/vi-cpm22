	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0BBD'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0BBF'   00                    FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
  0BC0'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0BC1'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0BC2'   01                    TXEND:	DB	1		; the first row with no text on it
  0BC3'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0BC4'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0BC5'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0BC6'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0BC7'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0BC8'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0BCA'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0BCC'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0BCE'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0BD0'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0BD2'   00                    LYROW:	DB	0		; LAYOUT: working row
  0BD3'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0BD4'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0BD6'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
