	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the cheap paints the
                                ; RINTENT asks for, the RPOLL repaint abort, and the message row.  A cheap
                                ; paint is counted in ROWS: the rows the screen gave up or gained at the top,
                                ; the rows the edit at the cursor had and has.  The terminal moves what stands
                                ; (IL/DL in a scroll region) and only the rows that are new are sent.
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	PGTOPM			; PAGE.MAC -- times the pager moved the text
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	DCHN			; CMD.MAC -- cells an R_DCH deletes
                                	EXTRN	DCHBS			; CMD.MAC -- 1 = left of the cursor
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   78                    	MOV	A,B
  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0CFE'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0D0C'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0CED'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PRNG -- paint the edit rows from B up to (not including) C, counted from 0:
                                ; each cleared (ESC[K), the text on as many rows as its lines take, the fill
                                ; char on the rows past it.  The row table says which line row B is in and
                                ; how many of that line's rows are above it, and the reader is put there.
                                ; The one row a line may own with nothing on it -- the cursor's, past text
                                ; that filled the row above (LYXE) -- is cleared in its turn.  An empty range
                                ; sends nothing.  During a full repaint (FORCEF) a key that is waiting
                                ; abandons the frame, and the return from here is SCDRAW's own.
  0098'                         PRNG:
  0098'   78                    	MOV	A,B
  0099'   B9                    	CMP	C
  009A'   D0                    	RNC
  009B'   32 0D8B'              	STA	PROWN
  009E'   79                    	MOV	A,C
  009F'   32 0D55'              	STA	PEND
  00A2'   3A 0D39'              	LDA	TXEND
  00A5'   3D                    	DCR	A
  00A6'   B8                    	CMP	B		; CY iff row B is past the text
  00A7'   DA 00DB'              	JC	PG_GO
  00AA'   C5                    	PUSH	B
  00AB'   CD 0B5A'              	CALL	RDTOP
  00AE'   CD 04B2'              	CALL	HTTOP		; HL -> the top line's entry
  00B1'   C1                    	POP	B
  00B2'   11 0000               	LXI	D,0		; D = the rows above the line, E = the lines
  00B5'                         PG_F:
  00B5'   7A                    	MOV	A,D
  00B6'   86                    	ADD	M
  00B7'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00B8'   DA 00BE'              	JC	PG_N
  00BB'   C2 00C4'              	JNZ	PG_H		; row B is one of this line's
  00BE'                         PG_N:
  00BE'   57                    	MOV	D,A
  00BF'   1C                    	INR	E
  00C0'   23                    	INX	H
  00C1'   C3 00B5'              	JMP	PG_F
  00C4'                         PG_H:
  00C4'   78                    	MOV	A,B
  00C5'   92                    	SUB	D
  00C6'   4F                    	MOV	C,A
  00C7'   06 00                 	MVI	B,0		; BC = the rows of it above row B ...
  00C9'   7B                    	MOV	A,E
  00CA'   21 0000               	LXI	H,0
  00CD'   B7                    	ORA	A
  00CE'   C2 00D4'              	JNZ	PG_K
  00D1'   2A 0D35'              	LHLD	SKIPR		; ... and, for the top line, those off the top
  00D4'                         PG_K:
  00D4'   09                    	DAD	B
  00D5'   22 0D8C'              	SHLD	PSKN
  00D8'   CD 0BB8'              	CALL	RDSKIP		; the reader at that line (A lines down)
  00DB'                         PG_GO:
  00DB'   3A 0D8B'              	LDA	PROWN
  00DE'   3C                    	INR	A
  00DF'   47                    	MOV	B,A
  00E0'   0E 01                 	MVI	C,1
  00E2'   CD 0064'              	CALL	GOTOXY
  00E5'                         PG_LP:
  00E5'   3A 0D5F'              	LDA	FORCEF
  00E8'   B7                    	ORA	A
  00E9'   CA 00F5'              	JZ	PG_P
  00EC'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abandon the repaint
  00EF'   B7                    	ORA	A
  00F0'   CA 00F5'              	JZ	PG_P
  00F3'   E1                    	POP	H		; (the cursor stays hidden: no flash in a burst)
  00F4'   C9                    	RET
  00F5'                         PG_P:
  00F5'   CD 0092'              	CALL	CEKL
  00F8'   CD 0C18'              	CALL	PAINTR
  00FB'   3A 0D7A'              	LDA	LYXE
  00FE'   B7                    	ORA	A
  00FF'   CA 0114'              	JZ	PG_1
  0102'   3A 0D37'              	LDA	SROW		; was that the row over the cursor's own?
  0105'   D6 02                 	SUI	2
  0107'   21 0D8B'              	LXI	H,PROWN
  010A'   BE                    	CMP	M
  010B'   C2 0114'              	JNZ	PG_1
  010E'   CD 0124'              	CALL	PT_NL
  0111'   CD 0092'              	CALL	CEKL
  0114'                         PG_1:
  0114'   3A 0D55'              	LDA	PEND
  0117'   3D                    	DCR	A
  0118'   21 0D8B'              	LXI	H,PROWN
  011B'   BE                    	CMP	M
  011C'   C8                    	RZ
  011D'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  011E'   CD 0124'              	CALL	PT_NL
  0121'   C3 00E5'              	JMP	PG_LP
                                ;PT_NL -- CR, LF: down a row, and count it.
  0124'                         PT_NL:
  0124'   3E 0D                 	MVI	A,CR
  0126'   CD 0018'              	CALL	OUTCH
  0129'   3E 0A                 	MVI	A,LF
  012B'   CD 0018'              	CALL	OUTCH
  012E'   21 0D8B'              	LXI	H,PROWN
  0131'   34                    	INR	M
  0132'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  0133'                         GOTOP:
  0133'   06 01                 	MVI	B,1
  0135'   0E 01                 	MVI	C,1
  0137'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  013A'                         SCINIT:
  013A'   21 0000               	LXI	H,0
  013D'   22 0D33'              	SHLD	WINROW
  0140'   21 0CDE'              	LXI	H,SPROBE
  0143'   CD 0025'              	CALL	OUTSTR
  0146'   CD 0191'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  0149'   3A 0D30'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  014C'   3D                    	DCR	A
  014D'   32 0D32'              	STA	NEDIT
  0150'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  0151'                         RDB:
  0151'   21 0000               	LXI	H,0
  0154'                         RDB_LP:
  0154'   E5                    	PUSH	H
  0155'   CD 0000'              	CALL	BCONST
  0158'   E1                    	POP	H
  0159'   B7                    	ORA	A
  015A'   C2 0165'              	JNZ	RDB_GO
  015D'   2B                    	DCX	H
  015E'   7C                    	MOV	A,H
  015F'   B5                    	ORA	L
  0160'   C2 0154'              	JNZ	RDB_LP
  0163'   37                    	STC			; timeout
  0164'   C9                    	RET
  0165'                         RDB_GO:
  0165'   CD 0008'              	CALL	BCONIN
  0168'   B7                    	ORA	A		; CY=0, A=byte
  0169'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  016A'                         RDNUM:
  016A'   11 0000               	LXI	D,0
  016D'                         RN_LP:
  016D'   D5                    	PUSH	D
  016E'   CD 0151'              	CALL	RDB
  0171'   D1                    	POP	D
  0172'   D8                    	RC
  0173'   FE 30                 	CPI	'0'
  0175'   DA 018F'              	JC	RN_DN
  0178'   FE 3A                 	CPI	'9'+1
  017A'   D2 018F'              	JNC	RN_DN
  017D'   D6 30                 	SUI	'0'
  017F'   4F                    	MOV	C,A		; C = this digit
  0180'   62                    	MOV	H,D		; HL = value
  0181'   6B                    	MOV	L,E
  0182'   29                    	DAD	H		; 2x
  0183'   54                    	MOV	D,H
  0184'   5D                    	MOV	E,L		; DE = 2x
  0185'   29                    	DAD	H		; 4x
  0186'   29                    	DAD	H		; 8x
  0187'   19                    	DAD	D		; 10x
  0188'   06 00                 	MVI	B,0		; BC = digit
  018A'   09                    	DAD	B		; HL = 10x + digit
  018B'   EB                    	XCHG			; DE = new value
  018C'   C3 016D'              	JMP	RN_LP
  018F'                         RN_DN:
  018F'   B7                    	ORA	A		; CY=0, A = terminator
  0190'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0191'                         RDNUMS:
  0191'   CD 0151'              	CALL	RDB
  0194'   D8                    	RC
  0195'   FE 1B                 	CPI	ESC
  0197'   C0                    	RNZ			; not what a DSR reply looks like
  0198'   CD 0151'              	CALL	RDB
  019B'   D8                    	RC
  019C'   FE 5B                 	CPI	'['
  019E'   C0                    	RNZ			; not what a DSR reply looks like
  019F'   CD 016A'              	CALL	RDNUM		; DE = rows
  01A2'   D8                    	RC
  01A3'   FE 3B                 	CPI	';'
  01A5'   C0                    	RNZ			; not what a DSR reply looks like
  01A6'   EB                    	XCHG
  01A7'   22 0D90'              	SHLD	TMPR
  01AA'   CD 016A'              	CALL	RDNUM		; DE = cols
  01AD'   D8                    	RC
  01AE'   FE 52                 	CPI	'R'
  01B0'   C0                    	RNZ			; not what a DSR reply looks like
  01B1'   EB                    	XCHG
  01B2'   22 0D92'              	SHLD	TMPC
  01B5'   2A 0D90'              	LHLD	TMPR		; rows -> clamp [24,200]
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B8'   06 18                 	MVI	B,24
  01BA'   0E C8                 	MVI	C,200
  01BC'   CD 01D0'              	CALL	CLAMP
  01BF'   32 0D30'              	STA	NROWS
  01C2'   2A 0D92'              	LHLD	TMPC		; cols -> clamp [80,132]
  01C5'   06 50                 	MVI	B,80
  01C7'   0E 84                 	MVI	C,132
  01C9'   CD 01D0'              	CALL	CLAMP
  01CC'   32 0D31'              	STA	NCOLS
  01CF'                         RS_BAD:
  01CF'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  01D0'                         CLAMP:
  01D0'   7C                    	MOV	A,H
  01D1'   B7                    	ORA	A
  01D2'   C2 01E3'              	JNZ	CLP_MAX		; value > 255 -> max
  01D5'   7D                    	MOV	A,L
  01D6'   B8                    	CMP	B
  01D7'   DA 01E1'              	JC	CLP_MIN		; value < min
  01DA'   79                    	MOV	A,C
  01DB'   BD                    	CMP	L		; CY iff max < value
  01DC'   DA 01E3'              	JC	CLP_MAX
  01DF'   7D                    	MOV	A,L
  01E0'   C9                    	RET
  01E1'                         CLP_MIN:
  01E1'   78                    	MOV	A,B
  01E2'   C9                    	RET
  01E3'                         CLP_MAX:
  01E3'   79                    	MOV	A,C
  01E4'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- keep what is on the screen: the frame's facts (WINROW .. NXTR) are
                                ; copied to the OLD ones.  The main loop calls this after reading a key and
                                ; before dispatch, so SCDRAW can tell what the key changed.
  01E5'                         SCPRE:
  01E5'   21 0D33'              	LXI	H,WINROW
  01E8'   11 0D41'              	LXI	D,OLDWR
  01EB'   06 0E                 	MVI	B,FRMLEN
  01ED'                         SP_LP:
  01ED'   7E                    	MOV	A,M
  01EE'   12                    	STAX	D
  01EF'   23                    	INX	H
  01F0'   13                    	INX	D
  01F1'   05                    	DCR	B
  01F2'   C2 01ED'              	JNZ	SP_LP
  01F5'   C9                    	RET
                                
                                ;SCDRAW -- lay the screen out and paint it the cheapest way that is right.
                                ; A cheap paint is two changes, each "this many rows were here, that many
                                ; are": one at the top row (the screen gave rows up, OPN, or gained them,
                                ; OPM, as the text scrolled) and one at the cursor (EDR: EDA rows before, EDB
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; now, to be drawn from row EDP).  The terminal moves the rows that stand,
                                ; the rows that are new are sent, and so is whatever the move left wrong at
                                ; the bottom.  When nothing moves and nothing is new, only the cursor goes.
                                ; Whatever does not fit that is a full repaint.
  01F6'                         SCDRAW:
  01F6'   CD 0541'              	CALL	LAYOUT		; (no output)
  01F9'   CD 04FA'              	CALL	CURSC		; SROW/SCOL
  01FC'   3A 0D5F'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  01FF'   B7                    	ORA	A
  0200'   C2 042D'              	JNZ	SCFULL
  0203'   2A 0D43'              	LHLD	OLDSK		; the top line starts on another of its rows:
  0206'   EB                    	XCHG			;   every row on the screen is a different one
  0207'   2A 0D35'              	LHLD	SKIPR
  020A'   CD 0000*              	CALL	CMP16
  020D'   C2 042D'              	JNZ	SCFULL
  0210'   21 0000               	LXI	H,0
  0213'   22 0D4F'              	SHLD	OPN		; (and OPM)
  0216'   3A 0D3C'              	LDA	LYABV
  0219'   47                    	MOV	B,A		; B = the edit's first row: the cursor line's
  021A'   3A 0D4C'              	LDA	OLDCS		; C = the first row of it that can have changed:
  021D'   21 0D3E'              	LXI	H,CSRAW		;   the one the cursor was on, or the one it is
  0220'   BE                    	CMP	M
  0221'   DA 0225'              	JC	SD_1
  0224'   7E                    	MOV	A,M
  0225'                         SD_1:
  0225'   80                    	ADD	B
  0226'   4F                    	MOV	C,A
  0227'   2A 0D4D'              	LHLD	OLDCR		; E = the rows the line had (H: the line's under)
  022A'   5D                    	MOV	E,L
  022B'   3A 0D3F'              	LDA	LYTSH
  022E'   57                    	MOV	D,A		; D = the rows it has
  022F'   3A 0000*              	LDA	RINTENT
  0232'   B7                    	ORA	A
  0233'   CA 042D'              	JZ	SCFULL		; R_FULL
  0236'   FE 05                 	CPI	R_ILIN
  0238'   CA 026B'              	JZ	SD_IL
  023B'   E5                    	PUSH	H
  023C'   2A 0D6B'              	LHLD	LYDLT
  023F'   7C                    	MOV	A,H
  0240'   B5                    	ORA	L
  0241'   E1                    	POP	H
  0242'   3A 0000*              	LDA	RINTENT		; (keeps the flags)
  0245'   C2 02B6'              	JNZ	SD_OL		; the cursor is on another line
  0248'   FE 01                 	CPI	R_MOVE
  024A'   C2 024F'              	JNZ	SD_2
  024D'   0E FF                 	MVI	C,0FFH		; a move: none of the line to draw
  024F'                         SD_2:
  024F'   FE 03                 	CPI	R_DLIN
  0251'   C2 0256'              	JNZ	SD_3
  0254'   16 00                 	MVI	D,0		; the line went
  0256'                         SD_3:
  0256'   FE 06                 	CPI	R_JOIN
  0258'   C2 025E'              	JNZ	SD_AN
  025B'   7B                    	MOV	A,E		; the line under it went into it
  025C'   84                    	ADD	H
  025D'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  025E'                         SD_AN:
  025E'   3A 0D4A'              	LDA	OLDAB		; where the edit starts was that much lower: the
  0261'   90                    	SUB	B		;   rows the screen gave up at the top.  Higher,
  0262'   DA 042D'              	JC	SCFULL		;   and it is no paint of these
  0265'   32 0D4F'              	STA	OPN
  0268'   C3 02FD'              	JMP	SD_GO
                                
                                	;--- R_ILIN: ILN lines opened at the cursor ---
  026B'                         SD_IL:
  026B'   2A 0D6B'              	LHLD	LYDLT
  026E'   7C                    	MOV	A,H
  026F'   B7                    	ORA	A
  0270'   C2 042D'              	JNZ	SCFULL
  0273'   48                    	MOV	C,B		; drawn from the cursor's row, the first opened
  0274'   57                    	MOV	D,A		; (no rows yet)
  0275'   5F                    	MOV	E,A		; (none were there)
  0276'   B5                    	ORA	L
  0277'   CA 02A0'              	JZ	SI_2		; opened where the cursor's line was: 'O', 'P'
  027A'   3D                    	DCR	A
  027B'   C2 042D'              	JNZ	SCFULL
  027E'   3A 0D33'              	LDA	WINROW		; opened under it: it is the line above now, and
  0281'   B7                    	ORA	A		;   has to be on the screen
  0282'   CA 042D'              	JZ	SCFULL
  0285'   3A 0000*              	LDA	HTCUR
  0288'   3D                    	DCR	A
  0289'   CD 08F6'              	CALL	HTE
  028C'   56                    	MOV	D,M		; D = that line's rows now
  028D'   78                    	MOV	A,B
  028E'   92                    	SUB	D
  028F'   47                    	MOV	B,A		; the edit starts with it
  0290'   3A 0D4D'              	LDA	OLDCR
  0293'   5F                    	MOV	E,A
  0294'   3A 0000*              	LDA	ILABOV		; text came off it: drawn from the row the
  0297'   B7                    	ORA	A		;   cursor was on
  0298'   CA 02A0'              	JZ	SI_2
  029B'   3A 0D4C'              	LDA	OLDCS
  029E'   80                    	ADD	B
  029F'   4F                    	MOV	C,A
  02A0'                         SI_2:
  02A0'   C5                    	PUSH	B
  02A1'   D5                    	PUSH	D
  02A2'   3A 0000*              	LDA	ILN
  02A5'   47                    	MOV	B,A
  02A6'   3A 0000*              	LDA	HTCUR
  02A9'   CD 04C0'              	CALL	SUMX		; A = the rows the opened lines take
  02AC'   D1                    	POP	D
  02AD'   C1                    	POP	B
  02AE'   DA 042D'              	JC	SCFULL		; (more than the screen shows)
  02B1'   82                    	ADD	D
  02B2'   57                    	MOV	D,A
  02B3'   C3 025E'              	JMP	SD_AN
                                
                                	;--- a move to another line: the text scrolled SCRLN lines ---
  02B6'                         SD_OL:
  02B6'   FE 01                 	CPI	R_MOVE
  02B8'   C2 042D'              	JNZ	SCFULL
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02BB'   2A 0D57'              	LHLD	SCRLN
  02BE'   7C                    	MOV	A,H
  02BF'   B5                    	ORA	L
  02C0'   CA 0CBE'              	JZ	SCURS		; it stood still: the cursor alone
  02C3'   7C                    	MOV	A,H
  02C4'   B7                    	ORA	A
  02C5'   CA 02DC'              	JZ	SO_UP
  02C8'   3C                    	INR	A
  02C9'   C2 042D'              	JNZ	SCFULL
  02CC'   95                    	SUB	L		; down: the new lines at the top, and their rows
  02CD'   CA 042D'              	JZ	SCFULL
  02D0'   CD 04BC'              	CALL	SUMT
  02D3'   DA 042D'              	JC	SCFULL
  02D6'   32 0D50'              	STA	OPM
  02D9'   C3 02F8'              	JMP	SO_GO
  02DC'                         SO_UP:
  02DC'   3A 0D49'              	LDA	OLDBOT		; up: the last line that showed is that many
  02DF'   95                    	SUB	L		;   lines higher.  The row after it was OLDTX,
  02E0'   DA 042D'              	JC	SCFULL		;   and is the rows down to it now
  02E3'   3C                    	INR	A
  02E4'   CD 04BC'              	CALL	SUMT
  02E7'   DA 042D'              	JC	SCFULL
  02EA'   47                    	MOV	B,A
  02EB'   3A 0D47'              	LDA	OLDTX
  02EE'   90                    	SUB	B
  02EF'   DA 042D'              	JC	SCFULL
  02F2'   CA 042D'              	JZ	SCFULL
  02F5'   32 0D4F'              	STA	OPN
  02F8'                         SO_GO:
  02F8'   11 0000               	LXI	D,0		; no edit
  02FB'   0E FF                 	MVI	C,0FFH
                                
                                	;--- B = the edit's first row, C = the first to draw, D = its rows
                                	;    now, E = its rows before ---
  02FD'                         SD_GO:
  02FD'   78                    	MOV	A,B
  02FE'   32 0D53'              	STA	EDR
  0301'   82                    	ADD	D
  0302'   47                    	MOV	B,A		; B = the row after its last
  0303'   3A 0D32'              	LDA	NEDIT
  0306'   B8                    	CMP	B
  0307'   DA 042D'              	JC	SCFULL		; (it runs off the screen)
  030A'   79                    	MOV	A,C
  030B'   32 0D54'              	STA	EDP
  030E'   EB                    	XCHG
  030F'   22 0D51'              	SHLD	EDA		; (and EDB)
  0312'   EB                    	XCHG
  0313'   2A 0D4F'              	LHLD	OPN
  0316'   7C                    	MOV	A,H
  0317'   B5                    	ORA	L
  0318'   C2 0337'              	JNZ	SD_PT
  031B'   7A                    	MOV	A,D
  031C'   BB                    	CMP	E
  031D'   C2 0337'              	JNZ	SD_PT
  0320'   79                    	MOV	A,C		; nothing moves.  Nothing to draw either: the
  0321'   B8                    	CMP	B		;   cursor alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  0322'   D2 0CBE'              	JNC	SCURS
  0325'   3C                    	INR	A
  0326'   B8                    	CMP	B
  0327'   C2 0337'              	JNZ	SD_PT
  032A'   3A 0000*              	LDA	RINTENT		; the line's last row, the cursor on it before
  032D'   FE 04                 	CPI	R_ICH		;   and after: a cell opened or closed there is
  032F'   CA 03DC'              	JZ	SC_ICH		;   the whole of it
  0332'   FE 07                 	CPI	R_DCH
  0334'   CA 0400'              	JZ	SC_DCH
  0337'                         SD_PT:
  0337'   2A 0D35'              	LHLD	SKIPR		; ('<<<' on the top row is not theirs to keep)
  033A'   7C                    	MOV	A,H
  033B'   B5                    	ORA	L
  033C'   C2 042D'              	JNZ	SCFULL
  033F'   CD 0080'              	CALL	CHIDE
  0342'   2A 0D4F'              	LHLD	OPN
  0345'   EB                    	XCHG
  0346'   2A 0D51'              	LHLD	EDA
  0349'   7A                    	MOV	A,D
  034A'   B3                    	ORA	E
  034B'   C2 0353'              	JNZ	SD_SH
  034E'   7C                    	MOV	A,H
  034F'   BD                    	CMP	L
  0350'   CA 036B'              	JZ	SD_NS
  0353'                         SD_SH:
  0353'   CD 04E9'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0356'   2A 0D4F'              	LHLD	OPN
  0359'   06 00                 	MVI	B,0
  035B'   CD 0487'              	CALL	SHFT
  035E'   2A 0D51'              	LHLD	EDA
  0361'   3A 0D53'              	LDA	EDR
  0364'   47                    	MOV	B,A
  0365'   CD 0487'              	CALL	SHFT
  0368'   CD 0086'              	CALL	CRGRS
  036B'                         SD_NS:
  036B'   06 00                 	MVI	B,0
  036D'   3A 0D50'              	LDA	OPM
  0370'   4F                    	MOV	C,A
  0371'   CD 0098'              	CALL	PRNG		; the rows opened at the top
  0374'   2A 0D51'              	LHLD	EDA
  0377'   3A 0D53'              	LDA	EDR
  037A'   84                    	ADD	H
  037B'   4F                    	MOV	C,A
  037C'   3A 0D54'              	LDA	EDP
  037F'   47                    	MOV	B,A
  0380'   CD 0098'              	CALL	PRNG		; the edit's own
                                	;--- the bottom.  The rows that were good to the end of the screen
                                	;    (all of them, or as far as the '@' rows) moved with the text; what
                                	;    lies between where they end now and where good rows should end is
                                	;    drawn, and so are the rows a move up left bare ---
  0383'   2A 0D47'              	LHLD	OLDTX
  0386'   CD 04E0'              	CALL	TEV
  0389'   47                    	MOV	B,A
  038A'   2A 0D39'              	LHLD	TXEND
  038D'   CD 04E0'              	CALL	TEV
  0390'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0391'   2A 0D4F'              	LHLD	OPN
  0394'   EB                    	XCHG			; E = OPN, D = OPM
  0395'   2A 0D51'              	LHLD	EDA		; L = EDA, H = EDB
  0398'   7A                    	MOV	A,D
  0399'   84                    	ADD	H
  039A'   57                    	MOV	D,A		; D = the rows that came
  039B'   7B                    	MOV	A,E
  039C'   85                    	ADD	L
  039D'   92                    	SUB	D		; A = the rows that went, less those
  039E'   21 0D32'              	LXI	H,NEDIT
  03A1'   5E                    	MOV	E,M
  03A2'   DA 03B2'              	JC	SB_DN
  03A5'   57                    	MOV	D,A		; the text under them moved up D rows
  03A6'   7B                    	MOV	A,E
  03A7'   92                    	SUB	D
  03A8'   5F                    	MOV	E,A		; E = the first row that left bare
  03A9'   78                    	MOV	A,B
  03AA'   92                    	SUB	D
  03AB'   D2 03BD'              	JNC	SB_1
  03AE'   AF                    	XRA	A
  03AF'   C3 03BD'              	JMP	SB_1
  03B2'                         SB_DN:
  03B2'   2F                    	CMA
  03B3'   3C                    	INR	A		; ... or down that many
  03B4'   80                    	ADD	B
  03B5'   DA 03BC'              	JC	SB_0
  03B8'   BB                    	CMP	E
  03B9'   DA 03BD'              	JC	SB_1
  03BC'                         SB_0:
  03BC'   7B                    	MOV	A,E
  03BD'                         SB_1:
  03BD'   B9                    	CMP	C		; A = where the old good rows end now
  03BE'   47                    	MOV	B,A
  03BF'   DA 03C4'              	JC	SB_2
  03C2'   41                    	MOV	B,C
  03C3'   4F                    	MOV	C,A
  03C4'                         SB_2:
  03C4'   C5                    	PUSH	B
  03C5'   D5                    	PUSH	D
  03C6'   CD 0098'              	CALL	PRNG
  03C9'   D1                    	POP	D
  03CA'   C1                    	POP	B
  03CB'   79                    	MOV	A,C
  03CC'   BB                    	CMP	E
  03CD'   D2 03D1'              	JNC	SB_3
  03D0'   7B                    	MOV	A,E
  03D1'                         SB_3:
  03D1'   47                    	MOV	B,A
  03D2'   3A 0D32'              	LDA	NEDIT
  03D5'   4F                    	MOV	C,A
  03D6'   CD 0098'              	CALL	PRNG
  03D9'   C3 0CBE'              	JMP	SCURS
                                
                                ;SC_ICH -- R_ICH: a char was typed at the cell the cursor was on, which is
                                ; where the terminal's cursor still is.  ICH (ESC[1@) opens a cell there and
                                ; the char fills it; appended at the row's end (ICHAPP) the cell is blank and
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ; nothing follows it, so the char alone is the whole frame.  Either way the
                                ; terminal leaves the cursor at SCOL, where insert mode wants it.
                                ; ICHAPP = 2 is 'r': the char took the place of the one under the cursor and
                                ; is under it still, so it is sent and the cursor put back on it.
  03DC'                         SC_ICH:
  03DC'   3A 0000*              	LDA	ICHAPP
  03DF'   FE 02                 	CPI	2
  03E1'   C2 03EE'              	JNZ	SC_IC1
  03E4'   2A 0000*              	LHLD	GAPEND
  03E7'   7E                    	MOV	A,M
  03E8'   CD 0018'              	CALL	OUTCH
  03EB'   C3 0CBE'              	JMP	SCURS
  03EE'                         SC_IC1:
  03EE'   B7                    	ORA	A
  03EF'   C2 03F8'              	JNZ	SC_ICC
  03F2'   21 0CF4'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  03F5'   CD 0025'              	CALL	OUTSTR
  03F8'                         SC_ICC:
  03F8'   2A 0000*              	LHLD	GAPBEG		; the byte typed is right before the gap
  03FB'   2B                    	DCX	H
  03FC'   7E                    	MOV	A,M
  03FD'   C3 0018'              	JMP	OUTCH
                                
                                ;SC_DCH -- R_DCH: DCHN cells went at the cell the cursor was on, which is
                                ; where the terminal's cursor still is: delete-character (ESC[<n>P) there
                                ; draws the rest of the row up, and the cursor is moved only if the delete
                                ; took the line's last char from under it.
                                ; DCHBS: the cell was the one left of the cursor (insert's BS).  The cursor
                                ; steps back onto it first, and is then where it belongs.
  0400'                         SC_DCH:
  0400'   3A 0000*              	LDA	DCHBS
  0403'   B7                    	ORA	A
  0404'   3E 08                 	MVI	A,BS
  0406'   C4 0018'              	CNZ	OUTCH
  0409'   21 0CF1'              	LXI	H,SCSI
  040C'   CD 0025'              	CALL	OUTSTR
  040F'   3A 0000*              	LDA	DCHN
  0412'   CD 002F'              	CALL	EMITB
  0415'   3E 50                 	MVI	A,'P'
  0417'   CD 0018'              	CALL	OUTCH
  041A'   3A 0000*              	LDA	DCHBS
  041D'   B7                    	ORA	A
  041E'   C0                    	RNZ
  041F'   2A 0D45'              	LHLD	OLDSC
  0422'   EB                    	XCHG
  0423'   2A 0D37'              	LHLD	SROW
  0426'   CD 0000*              	CALL	CMP16
  0429'   C8                    	RZ
  042A'   C3 0CBE'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place, each cleared with ESC[K; a line
                                ; takes as many rows as it is wide, and the rows past the text show '~' (or
                                ; '@').  No ESC[2J (no blank flash).  Message row last; cursor hidden
                                ; throughout, then addressed and shown.
                                ; FORCEF is set until the frame is whole.  A key that arrives part-way cuts it
                                ; short (PRNG): the pending key is dispatched, and the next SCDRAW repaints in
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ; FULL even if that key is a pure motion (RENDER.md: an aborted frame stays
                                ; dirty -- no cheap paint over a half-painted screen).
  042D'                         SCFULL:
  042D'   CD 0080'              	CALL	CHIDE
  0430'   3E 01                 	MVI	A,1
  0432'   32 0D5F'              	STA	FORCEF
  0435'   06 00                 	MVI	B,0
  0437'   3A 0D32'              	LDA	NEDIT
  043A'   4F                    	MOV	C,A
  043B'   CD 0098'              	CALL	PRNG
  043E'   CD 0124'              	CALL	PT_NL
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  0441'   CD 0092'              	CALL	CEKL
  0444'   2A 0D35'              	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
  0447'   7C                    	MOV	A,H		;   over its first cells says so, as vim's does
  0448'   B5                    	ORA	L
  0449'   CA 0455'              	JZ	ROWS_M
  044C'   CD 0133'              	CALL	GOTOP
  044F'   21 0D2C'              	LXI	H,SSKIP
  0452'   CD 0025'              	CALL	OUTSTR
  0455'                         ROWS_M:
  0455'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  0457'   32 0D60'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  045A'   CD 0CBE'              	CALL	SCURS
  045D'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  045E'   32 0D5F'              	STA	FORCEF
  0461'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  0462'                         EXPRM:
  0462'   F5                    	PUSH	PSW
  0463'   3A 0000*              	LDA	EDMODE
  0466'   32 0D60'              	STA	OEDMOD
  0469'   3A 0D30'              	LDA	NROWS
  046C'   CD 008C'              	CALL	GOROW1
  046F'   F1                    	POP	PSW
  0470'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  0473'                         EXRUB:
  0473'   21 0479'              	LXI	H,SRUB
  0476'   C3 0025'              	JMP	OUTSTR
  0479'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  047D'                         EXMSG:
  047D'   7E                    	MOV	A,M
  047E'   23                    	INX	H
  047F'   E5                    	PUSH	H
  0480'   CD 0462'              	CALL	EXPRM
  0483'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0484'   C3 0025'              	JMP	OUTSTR
                                
                                ;SHFT -- B = a row (from 0), L = the rows that were there, H = the rows that
                                ; are: open rows under those that were (IL), or delete under those that stay
                                ; (DL), so that everything below is where it belongs.  In a scroll region.
  0487'                         SHFT:
  0487'   7C                    	MOV	A,H
  0488'   95                    	SUB	L
  0489'   C8                    	RZ
  048A'   1E 4C                 	MVI	E,'L'
  048C'   57                    	MOV	D,A
  048D'   7D                    	MOV	A,L
  048E'   D2 0497'              	JNC	SH_1
  0491'   7D                    	MOV	A,L
  0492'   94                    	SUB	H
  0493'   57                    	MOV	D,A
  0494'   1E 4D                 	MVI	E,'M'
  0496'   7C                    	MOV	A,H
  0497'                         SH_1:
  0497'   80                    	ADD	B
  0498'   21 0D32'              	LXI	H,NEDIT
  049B'   BE                    	CMP	M
  049C'   D0                    	RNC			; (under the last edit row: nothing there to move)
  049D'   3C                    	INR	A
  049E'   47                    	MOV	B,A
  049F'   0E 01                 	MVI	C,1
  04A1'   CD 0064'              	CALL	GOTOXY
  04A4'   21 0CF1'              	LXI	H,SCSI
  04A7'   CD 0025'              	CALL	OUTSTR
  04AA'   7A                    	MOV	A,D
  04AB'   CD 002F'              	CALL	EMITB
  04AE'   7B                    	MOV	A,E
  04AF'   C3 0018'              	JMP	OUTCH
                                
                                ;HTTOP -- HL -> the row table's entry for the top line, A = which it is.
  04B2'                         HTTOP:
  04B2'   3A 0000*              	LDA	HTCUR
  04B5'   21 0D33'              	LXI	H,WINROW
  04B8'   96                    	SUB	M
  04B9'   C3 08F6'              	JMP	HTE
                                
                                ;SUMT -- A = a count of lines from the top one: A = the rows they take.
                                ;SUMX -- the same for the B lines from the table's entry A.
                                ; CY if the table has not so many, or they are a screenful and more.
  04BC'                         SUMT:
  04BC'   47                    	MOV	B,A
  04BD'   CD 04B2'              	CALL	HTTOP
  04C0'                         SUMX:
  04C0'   4F                    	MOV	C,A
  04C1'   80                    	ADD	B
  04C2'   5F                    	MOV	E,A
  04C3'   3A 0000*              	LDA	HTN
  04C6'   BB                    	CMP	E
  04C7'   D8                    	RC
  04C8'   79                    	MOV	A,C
  04C9'   CD 08F6'              	CALL	HTE
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  04CC'   AF                    	XRA	A
  04CD'   04                    	INR	B
  04CE'                         SM_LP:
  04CE'   05                    	DCR	B
  04CF'   CA 04D8'              	JZ	SM_DN
  04D2'   86                    	ADD	M
  04D3'   D8                    	RC
  04D4'   23                    	INX	H
  04D5'   C3 04CE'              	JMP	SM_LP
  04D8'                         SM_DN:
  04D8'   47                    	MOV	B,A
  04D9'   3A 0D32'              	LDA	NEDIT
  04DC'   3D                    	DCR	A
  04DD'   B8                    	CMP	B
  04DE'   78                    	MOV	A,B
  04DF'   C9                    	RET
                                
                                ;TEV -- HL = a frame's TXEND and FILCH: A = the row its good rows end at.
                                ; Rows of '~' are as good as text (they stay '~' wherever they move); rows of
                                ; '@' are not.
  04E0'                         TEV:
  04E0'   7C                    	MOV	A,H
  04E1'   FE 40                 	CPI	'@'
  04E3'   7D                    	MOV	A,L
  04E4'   C8                    	RZ
  04E5'   3A 0D32'              	LDA	NEDIT
  04E8'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  04E9'                         SRGN:
  04E9'   21 0CF9'              	LXI	H,SRGP
  04EC'   CD 0025'              	CALL	OUTSTR
  04EF'   3A 0D32'              	LDA	NEDIT
  04F2'   CD 002F'              	CALL	EMITB
  04F5'   3E 72                 	MVI	A,'r'
  04F7'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  04FA'                         CURSC:
  04FA'   2A 0D69'              	LHLD	CURDCL
  04FD'   CD 052C'              	CALL	DIVN		; BC = rows into the line, A = the column
  0500'   3C                    	INR	A
  0501'   32 0D38'              	STA	SCOL
  0504'   79                    	MOV	A,C
  0505'   32 0D64'              	STA	CSUB
  0508'   2A 0D35'              	LHLD	SKIPR
  050B'   EB                    	XCHG
  050C'   2A 0D3C'              	LHLD	LYABV
  050F'   09                    	DAD	B
  0510'   23                    	INX	H
  0511'   CD 0000*              	CALL	SUBHD		; (less the rows of it that are off the top)
  0514'   7C                    	MOV	A,H		; (never past the edit rows)
  0515'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0516'   3A 0D32'              	LDA	NEDIT
  0519'   C2 0521'              	JNZ	CS_SET
  051C'   BD                    	CMP	L		; CY iff NEDIT < the row
  051D'   DA 0521'              	JC	CS_SET
  0520'   7D                    	MOV	A,L
  0521'                         CS_SET:
  0521'   32 0D37'              	STA	SROW
  0524'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  0525'                         XTRA:
  0525'   01 0000               	LXI	B,0
  0528'   7C                    	MOV	A,H
  0529'   B5                    	ORA	L
  052A'   C8                    	RZ			; an empty line is one row
  052B'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  052C'                         DIVN:
  052C'   3A 0D31'              	LDA	NCOLS
  052F'   2F                    	CMA
  0530'   5F                    	MOV	E,A
  0531'   16 FF                 	MVI	D,0FFH
  0533'   13                    	INX	D		; DE = -NCOLS
  0534'   01 FFFF               	LXI	B,0FFFFH
  0537'                         DV_LP:
  0537'   03                    	INX	B
  0538'   19                    	DAD	D		; CY while NCOLS still went into it
  0539'   DA 0537'              	JC	DV_LP
  053C'   3A 0D31'              	LDA	NCOLS
  053F'   85                    	ADD	L
  0540'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- where the cursor's line sits on the screen and what the screen
                                ; holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
                                ;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
                                ;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
                                ;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
                                ;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
                                ;        what they show), SCBOT, SCEOF, SCBOF, NXTR, TALLF; the row table
                                ;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
                                ;        LNDLT and PLACE cleared.
                                ; The lines are measured once, into the row table (HTBLD): as many above the
                                ; cursor's as the placement could want, and a screenful of rows from it on.
                                ; Everything after that is arithmetic on the table: which line is the top one
                                ; (as many of the lines wanted above as leave the cursor's whole line room),
                                ; and how far down the text goes.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  0541'                         LAYOUT:
  0541'   2A 0000*              	LHLD	CMDCNT
  0544'   22 0D7C'              	SHLD	SVCNT
  0547'   2A 0000*              	LHLD	AUXCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  054A'   22 0D7E'              	SHLD	SVAUX
  054D'   3A 0000*              	LDA	DIRFLG
  0550'   32 0D80'              	STA	SVDIR
  0553'   CD 06B3'              	CALL	LYQK		; a move about a screen that stands: no more to do
  0556'   DA 069D'              	JC	LY_TC
  0559'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  055C'   32 0D6D'              	STA	LYROW
  055F'   32 0D78'              	STA	LYSVR
  0562'   AF                    	XRA	A
  0563'   32 0D76'              	STA	LYND
  0566'   32 0D77'              	STA	LYPRF
  0569'   3A 0D63'              	LDA	PLACE		; a line the command placed stays where it was
  056C'   B7                    	ORA	A		;   put; one that only moved is asked about
  056D'   CC 095A'              	CZ	LYFAR
  0570'   2A 0000*              	LHLD	LNDLT
  0573'   22 0D6B'              	SHLD	LYDLT
  0576'   7C                    	MOV	A,H
  0577'   B5                    	ORA	L
  0578'   21 0000               	LXI	H,0
  057B'   22 0000*              	SHLD	LNDLT
  057E'   47                    	MOV	B,A
  057F'   3A 0D63'              	LDA	PLACE		; the cursor on another line, or its line put
  0582'   B0                    	ORA	B		;   somewhere by the command: a line starts with
  0583'   CA 0589'              	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
  0586'   22 0D35'              	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
  0589'                         LY_SAM:
                                	;--- the lines to measure above the cursor's: those it has over it now,
                                	;    or all a screen could show when it is to be placed afresh (but no
                                	;    more than leaves the table room for the rows under it) ---
  0589'   3A 0D32'              	LDA	NEDIT
  058C'   4F                    	MOV	C,A		; C = a screenful of rows from the cursor's line on
  058D'   3D                    	DCR	A
  058E'   47                    	MOV	B,A
  058F'   3E FE                 	MVI	A,254
  0591'   91                    	SUB	C
  0592'   B8                    	CMP	B
  0593'   D2 0597'              	JNC	LY_B1
  0596'   47                    	MOV	B,A
  0597'                         LY_B1:
  0597'   CD 07CD'              	CALL	LYMQ
  059A'   CA 05A1'              	JZ	LY_BLD
  059D'   3A 0D6D'              	LDA	LYROW
  05A0'   47                    	MOV	B,A
  05A1'                         LY_BLD:
  05A1'   CD 0997'              	CALL	HTBLD
                                	;--- a line taller than the screen whose end is on it: the lines under
                                	;    that end, as far as the rows go ---
  05A4'   3A 0D56'              	LDA	TALLF
  05A7'   B7                    	ORA	A
  05A8'   CA 05BD'              	JZ	LY_NT
  05AB'   3A 0000*              	LDA	HTEOF
  05AE'   B7                    	ORA	A
  05AF'   C2 05BD'              	JNZ	LY_NT
  05B2'   3A 0D3F'              	LDA	LYTSH
  05B5'   47                    	MOV	B,A
  05B6'   3A 0D32'              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  05B9'   90                    	SUB	B
  05BA'   CD 0B03'              	CALL	HBMOR
  05BD'                         LY_NT:
  05BD'   CD 07CD'              	CALL	LYMQ
  05C0'   CC 0847'              	CZ	LYMID		; LYROW = the lines that puts above it
  05C3'   AF                    	XRA	A
  05C4'   32 0D63'              	STA	PLACE
                                	;--- of the LYROW lines wanted above, as many as leave the cursor's
                                	;    whole line room (and the table has: the file may start sooner) ---
  05C7'   3A 0D6D'              	LDA	LYROW
  05CA'   47                    	MOV	B,A
  05CB'   CD 0893'              	CALL	LYINI
  05CE'                         LY_FT:
  05CE'   78                    	MOV	A,B
  05CF'   B7                    	ORA	A
  05D0'   CA 05DC'              	JZ	LY_FD
  05D3'   05                    	DCR	B
  05D4'   C5                    	PUSH	B
  05D5'   CD 08DA'              	CALL	LMABV
  05D8'   C1                    	POP	B
  05D9'   D2 05CE'              	JNC	LY_FT
  05DC'                         LY_FD:
  05DC'   3A 0D74'              	LDA	LYMAB
  05DF'   6F                    	MOV	L,A
  05E0'   26 00                 	MVI	H,0
  05E2'   22 0D3C'              	SHLD	LYABV
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  05E5'   3A 0D6D'              	LDA	LYROW
  05E8'   6F                    	MOV	L,A		; (H is 0 still)
  05E9'   CD 0000*              	CALL	LINPSB		; HL = that line's start
  05EC'   EB                    	XCHG
  05ED'   2A 0000*              	LHLD	GAPBEG
  05F0'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  05F3'   22 0D65'              	SHLD	TOPLEN
  05F6'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  05F7'   22 0000*              	SHLD	WRLIM
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  05FA'   AF                    	XRA	A
  05FB'   32 0D62'              	STA	SCBOF
  05FE'   CD 092C'              	CALL	LYTOPP		; HL = top
  0601'   CD 0839'              	CALL	ISBOF
  0604'   C2 060B'              	JNZ	LY_BW
  0607'   3C                    	INR	A
  0608'   32 0D62'              	STA	SCBOF
  060B'                         LY_BW:
                                	;--- down the table from the cursor's line: the lines under it that fit
                                	;    whole.  C = the rows taken, D = those lines. ---
  060B'   3E 7E                 	MVI	A,'~'
  060D'   32 0D3A'              	STA	FILCH
  0610'   AF                    	XRA	A
  0611'   32 0D61'              	STA	SCEOF
  0614'   57                    	MOV	D,A
  0615'   3A 0000*              	LDA	HTCUR
  0618'   47                    	MOV	B,A
  0619'   CD 08F6'              	CALL	HTE		; HL -> the cursor line's entry
  061C'   3A 0000*              	LDA	HTN
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  061F'   90                    	SUB	B
  0620'   47                    	MOV	B,A		; B = the entries from it on
  0621'   3A 0D74'              	LDA	LYMAB
  0624'   4F                    	MOV	C,A
  0625'   3A 0D3F'              	LDA	LYTSH
  0628'   81                    	ADD	C
  0629'   4F                    	MOV	C,A
  062A'                         LY_WK:
  062A'   23                    	INX	H
  062B'   05                    	DCR	B
  062C'   CA 0649'              	JZ	LY_WE
  062F'   3A 0D32'              	LDA	NEDIT
  0632'   91                    	SUB	C		; A = the rows left
  0633'   CA 064F'              	JZ	LY_END		; none: what is under them is not cut off
  0636'   BE                    	CMP	M		; CY iff the line takes more
  0637'   DA 0641'              	JC	LY_CUT
  063A'   79                    	MOV	A,C
  063B'   86                    	ADD	M
  063C'   4F                    	MOV	C,A
  063D'   14                    	INR	D
  063E'   C3 062A'              	JMP	LY_WK
  0641'                         LY_CUT:
  0641'   3E 40                 	MVI	A,'@'		; a line that does not fit is not shown, and the
  0643'   32 0D3A'              	STA	FILCH		;   rows it would have started on say so
  0646'   C3 064F'              	JMP	LY_END
  0649'                         LY_WE:
  0649'   3A 0000*              	LDA	HTEOF		; the table ended: with the text, or with the rows
  064C'   32 0D61'              	STA	SCEOF
  064F'                         LY_END:
  064F'   79                    	MOV	A,C
  0650'   32 0D39'              	STA	TXEND		; the first row with no text on it
  0653'   AF                    	XRA	A		; NXTR = the rows of the line under the cursor's,
  0654'   B2                    	ORA	D		;   if it shows
  0655'   CA 0662'              	JZ	LY_NX
  0658'   D5                    	PUSH	D
  0659'   3A 0000*              	LDA	HTCUR
  065C'   3C                    	INR	A
  065D'   CD 08F6'              	CALL	HTE
