  07A8'   CA 07BA'              	JZ	LQK_G
  07AB'   FE 02                 	CPI	R_LINE
  07AD'   CA 07BA'              	JZ	LQK_G
  07B0'   FE 04                 	CPI	R_ICH
  07B2'   CA 07BA'              	JZ	LQK_G
  07B5'   FE 07                 	CPI	R_DCH
