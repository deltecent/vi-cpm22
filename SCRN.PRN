  09E1'   0B                    	DCX	B
  09E2'   FE 0A                 	CPI	LF
  09E4'   CA 09F9'              	JZ	LNW_LF
  09E7'   FE 0D                 	CPI	CR
  09E9'   CA 09DC'              	JZ	LNW_LP		; CR contributes no display column
  09EC'   FE 09                 	CPI	TAB
  09EE'   C2 09F5'              	JNZ	LNW_1
  09F1'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  09F2'   F6 07                 	ORI	TABWID-1
  09F4'   5F                    	MOV	E,A
  09F5'                         LNW_1:
  09F5'   13                    	INX	D
  09F6'   C3 09DC'              	JMP	LNW_LP
  09F9'                         LNW_LF:
  09F9'   37                    	STC
  09FA'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  09FB'                         LYFAR:
  09FB'   2A 0DD4'              	LHLD	WINROW
  09FE'   EB                    	XCHG
  09FF'   2A 0000*              	LHLD	LNDLT
  0A02'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0A03'   7C                    	MOV	A,H
  0A04'   B7                    	ORA	A
  0A05'   F2 0A1C'              	JP	LF_DN
  0A08'   3A 0DD3'              	LDA	NEDIT
  0A0B'   B7                    	ORA	A
  0A0C'   1F                    	RAR
  0A0D'   D6 02                 	SUI	2
  0A0F'   5F                    	MOV	E,A
  0A10'   16 00                 	MVI	D,0
  0A12'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0A13'   7C                    	MOV	A,H
  0A14'   B7                    	ORA	A
  0A15'   F0                    	RP
  0A16'                         LF_FAR:
  0A16'   3E 02                 	MVI	A,PL_MID
  0A18'   32 0E04'              	STA	PLACE
  0A1B'   C9                    	RET
  0A1C'                         LF_DN:
  0A1C'   3A 0DDC'              	LDA	SCBOT
  0A1F'   3C                    	INR	A
  0A20'   5F                    	MOV	E,A
  0A21'   16 00                 	MVI	D,0
  0A23'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0A26'   7C                    	MOV	A,H		;   less one
  0A27'   B7                    	ORA	A
  0A28'   F8                    	RM			; on the screen
  0A29'   C2 0A16'              	JNZ	LF_FAR
  0A2C'   3A 0DD3'              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A2F'   BD                    	CMP	L		; CY iff NEDIT < that
  0A30'   DA 0A16'              	JC	LF_FAR
  0A33'   7D                    	MOV	A,L
  0A34'   32 0E17'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0A37'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0A38'                         HTBLD:
  0A38'   79                    	MOV	A,C
  0A39'   32 0E1A'              	STA	HTLIM
  0A3C'   AF                    	XRA	A
  0A3D'   32 0000*              	STA	HTN
  0A40'   32 0DFA'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0A43'   32 0000*              	STA	HTEOF
  0A46'   32 0000*              	STA	HTBOF
  0A49'   32 0E1B'              	STA	LYXE
  0A4C'   32 0DF7'              	STA	TALLF
  0A4F'   68                    	MOV	L,B
  0A50'   67                    	MOV	H,A
  0A51'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0A54'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0A55'   E5                    	PUSH	H
  0A56'   CD 08DA'              	CALL	ISBOF
  0A59'   C2 0A60'              	JNZ	HB_1
  0A5C'   3C                    	INR	A
  0A5D'   32 0000*              	STA	HTBOF
  0A60'                         HB_1:
  0A60'   E1                    	POP	H
  0A61'   E5                    	PUSH	H
  0A62'   CD 09D2'              	CALL	G2P		; HL = the bytes from there to the cursor
  0A65'   E5                    	PUSH	H
  0A66'   3A 0DD2'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0A69'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0A6B'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0A6C'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0A6E'   3A 0DD3'              	LDA	NEDIT		;   leave no room to read down
  0A71'   CD 0CA4'              	CALL	MULHA
  0A74'   D1                    	POP	D
  0A75'   42                    	MOV	B,D
  0A76'   4B                    	MOV	C,E
  0A77'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0A7A'   D2 0A7E'              	JNC	HB_LM
  0A7D'   EB                    	XCHG
