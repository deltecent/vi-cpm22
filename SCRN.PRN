                                ;============================================================
                                ; DATA
                                ;============================================================
  1003'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  1004'   50                    NCOLS:	DB	80		; runtime columns
  1005'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  1006'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  1008'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  100A'   00                    SROW:	DB	0		; computed cursor screen row
  100B'   00                    SCOL:	DB	0		; computed cursor screen column
  100C'   01                    TXEND:	DB	1		; the first row with no text on it
  100D'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  100E'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  100F'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  1011'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  1012'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  1013'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  1014'   0000                  OLDWR:	DW	0
