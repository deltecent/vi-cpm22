  0A36'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A37'                         FLINE:
  0A37'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A3A'   DA 0A77'              	JC	FL_EOF
  0A3D'   32 1061'              	STA	LYLAST
  0A40'   FE 0A                 	CPI	LF
  0A42'   CA 0A75'              	JZ	FL_LF
  0A45'   FE 0D                 	CPI	CR
  0A47'   CA 0A37'              	JZ	FLINE		; CR contributes no display column
  0A4A'   FE 09                 	CPI	TAB
  0A4C'   CA 0A58'              	JZ	FL_TAB
  0A4F'   CD 0A7A'              	CALL	FL_CEL
  0A52'   C2 0A37'              	JNZ	FLINE
  0A55'                         FL_OVR:
  0A55'   3E 01                 	MVI	A,1
  0A57'   C9                    	RET
  0A58'                         FL_TAB:
  0A58'   3A 1056'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0A5B'   83                    	ADD	E
  0A5C'   E6 07                 	ANI	TABWID-1
  0A5E'   2F                    	CMA
  0A5F'   C6 09                 	ADI	TABWID+1
  0A61'   E5                    	PUSH	H
  0A62'   6F                    	MOV	L,A
  0A63'                         FT_LP:
  0A63'   CD 0A7A'              	CALL	FL_CEL
  0A66'   CA 0A71'              	JZ	FT_OVR
  0A69'   2D                    	DCR	L
  0A6A'   C2 0A63'              	JNZ	FT_LP
