                                ;============================================================
                                ; DATA
                                ;============================================================
  0D30'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0D31'   50                    NCOLS:	DB	80		; runtime columns
  0D32'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0D33'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0D35'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0D37'   00                    SROW:	DB	0		; computed cursor screen row
  0D38'   00                    SCOL:	DB	0		; computed cursor screen column
  0D39'   01                    TXEND:	DB	1		; the first row with no text on it
  0D3A'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0D3B'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0D3C'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0D3E'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0D3F'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0D40'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0D41'   0000                  OLDWR:	DW	0
  0D43'   0000                  OLDSK:	DW	0
  0D45'   0000                  OLDSC:	DW	0
  0D47'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0D49'   00                    OLDBOT:	DB	0
  0D4A'   0000                  OLDAB:	DW	0
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D4C'   00                    OLDCS:	DB	0
  0D4D'   00                    OLDCR:	DB	0
  0D4E'   00                    OLDNR:	DB	0
                                
  0D4F'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0D50'   00                    OPM:	DB	0		; ... or gained there
  0D51'   00                    EDA:	DB	0		; the edit: the rows it had
  0D52'   00                    EDB:	DB	0		; ... and has
  0D53'   00                    EDR:	DB	0		; ... its first row
  0D54'   00                    EDP:	DB	0		; ... the first of them to draw
  0D55'   00                    PEND:	DB	0		; PRNG: the row to stop before
  0D56'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0D57'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0D59'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  0D5A'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  0D5B'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  0D5D'   0000                  LYPG:	DW	0		; ... and PGTOPM
  0D5F'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  0D60'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0D61'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0D62'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0D63'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0D64'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0D65'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0D67'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0D69'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0D6B'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0D6D'   00                    LYROW:	DB	0		; LAYOUT: working row
  0D6E'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0D70'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0D71'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0D73'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0D74'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0D75'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0D76'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0D77'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0D78'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0D79'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0D7A'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0D7B'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0D7C'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0D7E'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0D80'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0D81'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0D83'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0D85'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0D87'   0000                  RDBC:	DW	0		; reader: RGET count
  0D89'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0D8A'   00                    SKPN:	DB	0		; RDSKIP line count
  0D8B'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0D8C'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D8E'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0D8F'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0D90'   0000                  TMPR:	DW	0		; DSR parse: rows
  0D92'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
