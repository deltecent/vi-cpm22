  0888'   AF                    	XRA	A
  0889'   C9                    	RET
  088A'                         LQ_NO:
  088A'   3C                    	INR	A
  088B'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  088C'                         FLINE:
  088C'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  088F'   DA 08CC'              	JC	FL_EOF
  0892'   32 0E55'              	STA	LYLAST
  0895'   FE 0A                 	CPI	LF
  0897'   CA 08CA'              	JZ	FL_LF
  089A'   FE 0D                 	CPI	CR
  089C'   CA 088C'              	JZ	FLINE		; CR contributes no display column
  089F'   FE 09                 	CPI	TAB
  08A1'   CA 08AD'              	JZ	FL_TAB
  08A4'   CD 08CF'              	CALL	FL_CEL
  08A7'   C2 088C'              	JNZ	FLINE
  08AA'                         FL_OVR:
  08AA'   3E 01                 	MVI	A,1
  08AC'   C9                    	RET
  08AD'                         FL_TAB:
  08AD'   3A 0E4A'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  08B0'   83                    	ADD	E
  08B1'   E6 07                 	ANI	TABWID-1
  08B3'   2F                    	CMA
  08B4'   C6 09                 	ADI	TABWID+1
  08B6'   E5                    	PUSH	H
  08B7'   6F                    	MOV	L,A
  08B8'                         FT_LP:
  08B8'   CD 08CF'              	CALL	FL_CEL
  08BB'   CA 08C6'              	JZ	FT_OVR
