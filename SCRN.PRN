  0A2D'   5F                    	MOV	E,A
  0A2E'   16 00                 	MVI	D,0
  0A30'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0A33'   7C                    	MOV	A,H		;   less one
  0A34'   B7                    	ORA	A
  0A35'   F8                    	RM			; on the screen
  0A36'   C2 0A23'              	JNZ	LF_FAR
  0A39'   3A 0E0C'              	LDA	NEDIT
  0A3C'   BD                    	CMP	L		; CY iff NEDIT < that
