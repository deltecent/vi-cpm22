  0882'   37                    	STC
  0883'   C9                    	RET
  0884'                         LQK_N:
  0884'   AF                    	XRA	A
  0885'   C9                    	RET
                                
                                ;LYTP -- L = the lines to be above the cursor's (H = 0): HL = the start of
                                ; the top line.  WM's line move (LINPSB) would find it, walking back over all
                                ; of them; but HTBLD has walked back already, to the table's first line
                                ; (HTTOPC), and the top line is that one or some lines down from it.  With a
                                ; table that was kept (LYSTP): no lines above, and it is the cursor's line;
                                ; else the top line is the old one, or some lines down from it, and the old
                                ; one is where LYTOP says while the pager has left the text alone.
  0886'                         LYTP:
  0886'   3A 1093'              	LDA	LYOK
  0889'   B7                    	ORA	A
  088A'   C2 08B6'              	JNZ	LT_0
  088D'   45                    	MOV	B,L
  088E'   3A 0000*              	LDA	HTCUR
  0891'   90                    	SUB	B
  0892'   DA 0909'              	JC	LT_NO
  0895'   4F                    	MOV	C,A		; C = the lines the top is under the table's first
  0896'   2A 0000*              	LHLD	TXTBEG		; ... if that line is in memory still: HTBLD
  0899'   EB                    	XCHG			;   pins a screenful back from the cursor and
  089A'   2A 0000*              	LHLD	GAPBEG		;   no more, and reading down for the lines
  089D'   CD 0000*              	CALL	SUBHD		;   under it may have paged the rest out
  08A0'   EB                    	XCHG
  08A1'   2A 1097'              	LHLD	HTTOPC
  08A4'   CD 0000*              	CALL	CMP16		; CY iff fewer bytes are there than it is back
  08A7'   DA 0909'              	JC	LT_NO
  08AA'   CD 0BD5'              	CALL	G2P
  08AD'   EB                    	XCHG
  08AE'   2A 0000*              	LHLD	GAPBEG
  08B1'   EB                    	XCHG			; HL = the table's first line, DE = the gap
  08B2'   0C                    	INR	C
  08B3'   C3 08F3'              	JMP	LT_2
  08B6'                         LT_0:
  08B6'   7D                    	MOV	A,L
  08B7'   B7                    	ORA	A
  08B8'   C2 08C1'              	JNZ	LT_1
  08BB'   2A 10A3'              	LHLD	CBOL
  08BE'   C3 0BD5'              	JMP	G2P
  08C1'                         LT_1:
  08C1'   E5                    	PUSH	H
  08C2'   2A 0000*              	LHLD	PGTOPM
  08C5'   EB                    	XCHG
  08C6'   2A 1099'              	LHLD	LYPG
  08C9'   CD 0000*              	CALL	CMP16
