  08F5'   DA 090C'              	JC	LM_P
  08F8'   CD 094D'              	CALL	LMBLW
  08FB'   DA 090C'              	JC	LM_P
  08FE'   21 0E17'              	LXI	H,LYND
  0901'   35                    	DCR	M
  0902'   C2 08F2'              	JNZ	LM_NR
  0905'   3A 0E19'              	LDA	LYSVR		; the screen holds them: scroll to it
  0908'   32 0E0E'              	STA	LYROW
  090B'   C9                    	RET
  090C'                         LM_P:
  090C'   AF                    	XRA	A		; it does not: the middle, above first
  090D'   32 0E17'              	STA	LYND
  0910'   3C                    	INR	A
  0911'   32 0E18'              	STA	LYPRF
  0914'   C3 08E8'              	JMP	LYMID
