  093E'   3D                    	DCR	A
  093F'   21 0000*              	LXI	H,HTN
  0942'   BE                    	CMP	M
  0943'   CA 095C'              	JZ	LS_M		; the line under its last
  0946'   CD 0B19'              	CALL	HTE
  0949'   7E                    	MOV	A,M
  094A'   21 0F81'              	LXI	H,NEDIT
  094D'   BE                    	CMP	M
  094E'   D2 0857'              	JNC	LQK_N		; (a screenful: it may be taller)
  0951'   32 0F8E'              	STA	LYTSH
  0954'   CD 0000*              	CALL	RGET0		; the char under the cursor in memory (TABCUR)
  0957'   CD 0000*              	CALL	RDGET
  095A'   37                    	STC
  095B'   C9                    	RET
                                	;--- not in the table: the rest of the line, as HTBLD reads it ---
