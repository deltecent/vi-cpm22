  07ED'   3A 1075'              	LDA	SCBOT
  07F0'   BD                    	CMP	L		; CY iff it is under the last line shown
  07F1'   DA 0884'              	JC	LQK_N
  07F4'   22 106D'              	SHLD	WINROW
  07F7'   2A 0000*              	LHLD	LNDLT
  07FA'   22 10A7'              	SHLD	LYDLT
