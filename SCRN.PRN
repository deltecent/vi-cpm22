  0C8A'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0C8C'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0C8E'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0C90'   00                    LYROW:	DB	0		; LAYOUT: working row
  0C91'   0000                  LYNEED: DW	0		; LAYOUT: rows to free at the top
  0C93'   00                    LYBLW:	DB	0		; LAYOUT: lines shown below the cursor's
  0C94'   00                    LYEND:	DB	0		; LAYOUT: lines that ended in the forward read
  0C95'   00                    LYLST:	DB	0		; LAYOUT: the row the line being read starts on
  0C96'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0C97'   0000                  LYLIM:	DW	0		; LYMID: bytes back to the highest line there is
  0C99'   0000                  LYUP:	DW	0		; LYMID: bytes back to the highest line taken
  0C9B'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0C9C'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0C9D'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0C9E'   00                    LYMEOF: DB	0		; LYMID: the text has ended
  0C9F'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0CA0'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0CA1'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0CA2'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0CA3'   00                    LYXE:	DB	0		; LAYOUT: WR_EOL+1 when the cursor has its own row
  0CA4'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0CA5'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0CA7'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0CA9'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0CAA'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0CAC'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0CAE'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0CB0'   0000                  RDBC:	DW	0		; reader: RGET count
  0CB2'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0CB3'   00                    SKPN:	DB	0		; RDSKIP line count
  0CB4'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0CB5'   00                    SCLN:	DB	0		; region-scroll line count (N, 1..NEDIT-1)
  0CB6'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0CB8'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0CB9'   00                    XC:	DB	0		; cells used in the row being painted
  0CBA'   00                    ROWCT:	DB	0		; RI count (SCBWD)
  0CBB'   00                    ILLAST: DB	0		; ... and the last screen row it draws
                                
  0CBC'   00                    SROW:	DB	0		; computed cursor screen row
  0CBD'   00                    SCOL:	DB	0		; computed cursor screen column
  0CBE'   0000                  TMPR:	DW	0		; DSR parse: rows
