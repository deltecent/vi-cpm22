  105C'   0000                  RDBC:	DW	0		; reader: RGET count
  105E'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  105F'   00                    SKPN:	DB	0		; RDSKIP line count
  1060'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  1061'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  1063'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  1064'   00                    XC:	DB	0		; cells used in the row being painted
                                
  1065'   0000                  TMPR:	DW	0		; DSR parse: rows
