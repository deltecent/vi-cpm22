  1016'   0000                  OLDSK:	DW	0
  1018'   0000                  OLDSC:	DW	0
  101A'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  101C'   00                    OLDBOT:	DB	0
  101D'   0000                  OLDAB:	DW	0
  101F'   00                    OLDCS:	DB	0
  1020'   00                    OLDCR:	DB	0
  1021'   00                    OLDNR:	DB	0
                                
  1022'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  1023'   00                    OPM:	DB	0		; ... or gained there
  1024'   00                    EDA:	DB	0		; the edit: the rows it had
  1025'   00                    EDB:	DB	0		; ... and has
  1026'   00                    EDR:	DB	0		; ... its first row
  1027'   00                    EDP:	DB	0		; ... the first of them to draw
  1028'   00                    PEND:	DB	0		; PRNG: the row to stop before
  1029'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  102A'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  102C'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  102D'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  102E'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  1030'   0000                  HTTOPC: DW	0		; HTBLD: the bytes from the table's first line to
                                				;   the cursor
  1032'   0000                  LYPG:	DW	0		; ... and PGTOPM
  1034'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  1035'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  1036'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  1037'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  1038'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  1039'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  103A'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  103C'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  103E'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  1040'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  1042'   00                    LYROW:	DB	0		; LAYOUT: working row
  1043'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  1045'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  1046'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  1048'   00                    LYUSE:	DB	0		; LYMID: rows taken
  1049'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  104A'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  104B'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  104C'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  104D'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  104E'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  104F'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  1050'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  1051'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  1053'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  1055'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  1056'   0000                  RDP:	DW	0		; reader: next before-gap byte
