  09E7'   FE 01                 	CPI	R_MOVE
  09E9'   C0                    	RNZ
  09EA'   3A 0000*              	LDA	EDMODE
  09ED'   FE 00                 	CPI	EM_CMD
  09EF'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  09F0'                         LYMQ:
  09F0'   3A 0FB2'              	LDA	PLACE
  09F3'   FE 02                 	CPI	PL_MID
  09F5'   C8                    	RZ
  09F6'   3A 0FC5'              	LDA	LYND
  09F9'   B7                    	ORA	A
  09FA'   CA 09FF'              	JZ	LQ_NO
  09FD'   AF                    	XRA	A
  09FE'   C9                    	RET
  09FF'                         LQ_NO:
  09FF'   3C                    	INR	A
  0A00'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A01'                         FLINE:
  0A01'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A04'   DA 0A41'              	JC	FL_EOF
  0A07'   32 0FCA'              	STA	LYLAST
  0A0A'   FE 0A                 	CPI	LF
  0A0C'   CA 0A3F'              	JZ	FL_LF
  0A0F'   FE 0D                 	CPI	CR
  0A11'   CA 0A01'              	JZ	FLINE		; CR contributes no display column
  0A14'   FE 09                 	CPI	TAB
  0A16'   CA 0A22'              	JZ	FL_TAB
  0A19'   CD 0A44'              	CALL	FL_CEL
  0A1C'   C2 0A01'              	JNZ	FLINE
  0A1F'                         FL_OVR:
  0A1F'   3E 01                 	MVI	A,1
  0A21'   C9                    	RET
  0A22'                         FL_TAB:
  0A22'   3A 0FBF'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0A25'   83                    	ADD	E
