  0903'   EB                    	XCHG			;   the pager has not moved the window since)
  0904'   2A 1043'              	LHLD	LYPG
  0907'   C3 0000*              	JMP	CMP16
                                
                                ;LQCU -- the cursor's line, as far as the cursor: CBOL, CURDCL, the row of
                                ; the line it is on (CSRAW, and A) and the cells before it there (LQKC).
