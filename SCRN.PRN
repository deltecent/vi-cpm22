  0D5A'                         HB_E2:
  0D5A'   7B                    	MOV	A,E
  0D5B'   B7                    	ORA	A
  0D5C'   C2 0D68'              	JNZ	HB_E3
  0D5F'   B2                    	ORA	D
  0D60'   CA 0D68'              	JZ	HB_E3		; (its first row: an empty line)
  0D63'   3E 01                 	MVI	A,1
  0D65'   32 10B6'              	STA	LYXE
  0D68'                         HB_E3:
  0D68'   7A                    	MOV	A,D
  0D69'   3C                    	INR	A
  0D6A'   32 1079'              	STA	LYTSH
  0D6D'   3A 1090'              	LDA	TALLF
  0D70'   B7                    	ORA	A
  0D71'   C2 0DC9'              	JNZ	HB_TX
  0D74'   F1                    	POP	PSW
  0D75'   FA 0D9A'              	JM	HB_LS		; the text ends with it
  0D78'                         HB_PT:
  0D78'   7A                    	MOV	A,D
  0D79'   3C                    	INR	A
  0D7A'   CD 0DD5'              	CALL	HTPUT
  0D7D'   47                    	MOV	B,A
  0D7E'   3A 10B5'              	LDA	HTLIM
  0D81'   90                    	SUB	B
  0D82'   32 10B5'              	STA	HTLIM
  0D85'   D8                    	RC
  0D86'   CA 0DA5'              	JZ	HB_PK		; rows enough
  0D89'                         HB_NX:
  0D89'   CD 0B89'              	CALL	LM_NX		; the next line down
  0D8C'   CA 0D78'              	JZ	HB_PT
  0D8F'   F2 0DD2'              	JP	HB_TL		; one taller than the screen
  0D92'   3A 10B7'              	LDA	LYLAST		; the text ended: was that a line?
  0D95'   FE 0A                 	CPI	LF
  0D97'   CA 0D9F'              	JZ	HB_EF
  0D9A'                         HB_LS:
  0D9A'   7A                    	MOV	A,D
  0D9B'   3C                    	INR	A
  0D9C'   CD 0DD5'              	CALL	HTPUT
  0D9F'                         HB_EF:
  0D9F'   3E 01                 	MVI	A,1
  0DA1'   32 0000*              	STA	HTEOF
  0DA4'   C9                    	RET
  0DA5'                         HB_PK:
  0DA5'   2A 10C3'              	LHLD	RDBC		; just the rows asked for: is the text over
  0DA8'   44                    	MOV	B,H		;   right there?
  0DA9'   4D                    	MOV	C,L
  0DAA'   2A 10C1'              	LHLD	RDHL
  0DAD'   CD 0000*              	CALL	RDGET
  0DB0'   D0                    	RNC
  0DB1'   C3 0D9F'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0DB4'                         HBMOR:
  0DB4'   32 10B5'              	STA	HTLIM
  0DB7'   B7                    	ORA	A
  0DB8'   CA 0DA5'              	JZ	HB_PK
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0DBB'   C3 0D89'              	JMP	HB_NX
  0DBE'                         HB_TO:
  0DBE'   3E 01                 	MVI	A,1
  0DC0'   32 1090'              	STA	TALLF
  0DC3'   3A 106C'              	LDA	NEDIT
  0DC6'   32 1079'              	STA	LYTSH
  0DC9'                         HB_TX:
  0DC9'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0DCA'   F2 0DD2'              	JP	HB_TL		;   with it, and on the screen)
  0DCD'   3E 01                 	MVI	A,1
  0DCF'   32 0000*              	STA	HTEOF
  0DD2'                         HB_TL:
  0DD2'   3A 106C'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0DD5'                         HTPUT:
  0DD5'   E5                    	PUSH	H
  0DD6'   D5                    	PUSH	D
  0DD7'   21 0000*              	LXI	H,HTN
  0DDA'   5E                    	MOV	E,M
  0DDB'   1C                    	INR	E
  0DDC'   CA 0DE8'              	JZ	HP_1
  0DDF'   73                    	MOV	M,E
  0DE0'   1D                    	DCR	E
  0DE1'   16 00                 	MVI	D,0
  0DE3'   21 0000*              	LXI	H,HTAB
  0DE6'   19                    	DAD	D
  0DE7'   77                    	MOV	M,A
  0DE8'                         HP_1:
  0DE8'   D1                    	POP	D
  0DE9'   E1                    	POP	H
  0DEA'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0DEB'                         TABCUR:
  0DEB'   3A 0000*              	LDA	EDMODE
  0DEE'   FE 00                 	CPI	EM_CMD
  0DF0'   C0                    	RNZ
  0DF1'   2A 0000*              	LHLD	TXTEND
  0DF4'   EB                    	XCHG
  0DF5'   2A 0000*              	LHLD	GAPEND
  0DF8'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0DFB'   C8                    	RZ
  0DFC'   7E                    	MOV	A,M
  0DFD'   FE 09                 	CPI	TAB
  0DFF'   C0                    	RNZ
  0E00'   2A 10A5'              	LHLD	CURDCL
  0E03'   7D                    	MOV	A,L
  0E04'   F6 07                 	ORI	TABWID-1
  0E06'   6F                    	MOV	L,A
  0E07'   22 10A5'              	SHLD	CURDCL
  0E0A'   C9                    	RET
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0E0B'                         RDTOP:
  0E0B'   2A 10A1'              	LHLD	TOPLEN
  0E0E'   C3 0E14'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0E11'                         RDBOL:
  0E11'   2A 10A3'              	LHLD	CBOL
  0E14'                         RDSET:
  0E14'   22 10BF'              	SHLD	RDN
  0E17'   EB                    	XCHG
  0E18'   2A 0000*              	LHLD	GAPBEG
  0E1B'   CD 0000*              	CALL	SUBHD
  0E1E'   22 10BD'              	SHLD	RDP
  0E21'   AF                    	XRA	A
  0E22'   32 10C5'              	STA	RDSEG
  0E25'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0E26'                         RDCH:
  0E26'   C5                    	PUSH	B
  0E27'   D5                    	PUSH	D
  0E28'   E5                    	PUSH	H
  0E29'   2A 10BF'              	LHLD	RDN		; before-gap bytes left?
  0E2C'   7C                    	MOV	A,H
  0E2D'   B5                    	ORA	L
  0E2E'   CA 0E41'              	JZ	RDC_AF
  0E31'   2B                    	DCX	H
  0E32'   22 10BF'              	SHLD	RDN
  0E35'   2A 10BD'              	LHLD	RDP
  0E38'   7E                    	MOV	A,M
  0E39'   23                    	INX	H
  0E3A'   22 10BD'              	SHLD	RDP
  0E3D'   B7                    	ORA	A		; CY=0
  0E3E'   C3 0E65'              	JMP	RDC_RT
  0E41'                         RDC_AF:
  0E41'   3A 10C5'              	LDA	RDSEG
  0E44'   B7                    	ORA	A
  0E45'   C2 0E52'              	JNZ	RDC_NX
  0E48'   3C                    	INR	A		; first after-gap byte: start RGET
  0E49'   32 10C5'              	STA	RDSEG
  0E4C'   CD 0000*              	CALL	RGET0
  0E4F'   C3 0E5A'              	JMP	RDC_GT
  0E52'                         RDC_NX:
  0E52'   2A 10C3'              	LHLD	RDBC
  0E55'   44                    	MOV	B,H
  0E56'   4D                    	MOV	C,L
  0E57'   2A 10C1'              	LHLD	RDHL
  0E5A'                         RDC_GT:
  0E5A'   CD 0000*              	CALL	RDGET
  0E5D'   22 10C1'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0E60'   60                    	MOV	H,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E61'   69                    	MOV	L,C
  0E62'   22 10C3'              	SHLD	RDBC
  0E65'                         RDC_RT:
  0E65'   E1                    	POP	H
  0E66'   D1                    	POP	D
  0E67'   C1                    	POP	B
  0E68'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).  What is in
                                ; memory is passed over where it lies, before the gap and after it; RDCH
                                ; reads on only when those bytes run out with lines still to pass.
  0E69'                         RDSKIP:
  0E69'   B7                    	ORA	A
  0E6A'   C8                    	RZ
  0E6B'   32 10C6'              	STA	SKPN
  0E6E'   2A 10BF'              	LHLD	RDN
  0E71'   44                    	MOV	B,H
  0E72'   4D                    	MOV	C,L
  0E73'   2A 10BD'              	LHLD	RDP
  0E76'   CD 0EBB'              	CALL	RSK_M
  0E79'   22 10BD'              	SHLD	RDP
  0E7C'   60                    	MOV	H,B
  0E7D'   69                    	MOV	L,C
  0E7E'   22 10BF'              	SHLD	RDN
  0E81'   C8                    	RZ
  0E82'   3A 10C5'              	LDA	RDSEG
  0E85'   B7                    	ORA	A
  0E86'   C2 0E93'              	JNZ	RSK_A
  0E89'   3C                    	INR	A		; first after-gap byte: start RGET
  0E8A'   32 10C5'              	STA	RDSEG
  0E8D'   CD 0000*              	CALL	RGET0
  0E90'   C3 0E9B'              	JMP	RSK_B
  0E93'                         RSK_A:
  0E93'   2A 10C3'              	LHLD	RDBC
  0E96'   44                    	MOV	B,H
  0E97'   4D                    	MOV	C,L
  0E98'   2A 10C1'              	LHLD	RDHL
  0E9B'                         RSK_B:
  0E9B'   CD 0EBB'              	CALL	RSK_M
  0E9E'   22 10C1'              	SHLD	RDHL
  0EA1'   60                    	MOV	H,B
  0EA2'   69                    	MOV	L,C
  0EA3'   22 10C3'              	SHLD	RDBC
  0EA6'   C8                    	RZ
  0EA7'                         RSK_LP:
  0EA7'   CD 0E26'              	CALL	RDCH
  0EAA'   D8                    	RC
  0EAB'   FE 0A                 	CPI	LF
  0EAD'   C2 0EA7'              	JNZ	RSK_LP
  0EB0'   3A 10C6'              	LDA	SKPN
  0EB3'   3D                    	DCR	A
  0EB4'   32 10C6'              	STA	SKPN
  0EB7'   C2 0EA7'              	JNZ	RSK_LP
  0EBA'   C9                    	RET
                                ;RSK_M -- pass over SKPN lines in the BC bytes at HL.  Z when that was all of
                                ; them; NZ when the bytes ran out first (SKPN = the lines still to pass).
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0EBB'                         RSK_M:
  0EBB'   78                    	MOV	A,B
  0EBC'   B1                    	ORA	C
  0EBD'   CA 0ED3'              	JZ	RSK_E
  0EC0'   7E                    	MOV	A,M
  0EC1'   23                    	INX	H
  0EC2'   0B                    	DCX	B
  0EC3'   FE 0A                 	CPI	LF
  0EC5'   C2 0EBB'              	JNZ	RSK_M
  0EC8'   3A 10C6'              	LDA	SKPN
  0ECB'   3D                    	DCR	A
  0ECC'   32 10C6'              	STA	SKPN
  0ECF'   C2 0EBB'              	JNZ	RSK_M
  0ED2'   C9                    	RET
  0ED3'                         RSK_E:
  0ED3'   3C                    	INR	A		; (NZ)
  0ED4'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0ED5'                         PSKIP:
  0ED5'   3A 106B'              	LDA	NCOLS
  0ED8'   CD 0F07'              	CALL	MULHA		; HL = the cells to pass over
  0EDB'   EB                    	XCHG
  0EDC'   21 0000               	LXI	H,0
  0EDF'   22 10C8'              	SHLD	PSKN
  0EE2'                         PS_LP:
  0EE2'   7A                    	MOV	A,D
  0EE3'   B3                    	ORA	E
  0EE4'   CA 0F3B'              	JZ	PR_LP
  0EE7'   CD 0E26'              	CALL	RDCH
  0EEA'   FE 0D                 	CPI	CR
  0EEC'   CA 0EE2'              	JZ	PS_LP
  0EEF'   0E 01                 	MVI	C,1
  0EF1'   FE 09                 	CPI	TAB
  0EF3'   CC 0F11'              	CZ	TABN
  0EF6'                         PS_CL:
  0EF6'   7A                    	MOV	A,D
  0EF7'   B3                    	ORA	E
  0EF8'   CA 0F55'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0EFB'   1B                    	DCX	D
  0EFC'   21 10CA'              	LXI	H,DCOL
  0EFF'   34                    	INR	M
  0F00'   0D                    	DCR	C
  0F01'   C2 0EF6'              	JNZ	PS_CL
  0F04'   C3 0EE2'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0F07'                         MULHA:
  0F07'   EB                    	XCHG
  0F08'   21 0000               	LXI	H,0
  0F0B'                         MH_LP:
  0F0B'   19                    	DAD	D
  0F0C'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0F0D'   C2 0F0B'              	JNZ	MH_LP
  0F10'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0F11'                         TABN:
  0F11'   3A 10CA'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0F14'   E6 07                 	ANI	7
  0F16'   4F                    	MOV	C,A
  0F17'   3E 08                 	MVI	A,8
  0F19'   91                    	SUB	C
  0F1A'   4F                    	MOV	C,A
  0F1B'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0F1C'                         PAINTR:
  0F1C'   3A 10C7'              	LDA	PROWN
  0F1F'   21 1073'              	LXI	H,TXEND
  0F22'   BE                    	CMP	M		; CY iff the row holds text
  0F23'   DA 0F2C'              	JC	PROW
  0F26'   3A 1074'              	LDA	FILCH
  0F29'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0F2C'                         PROW:
  0F2C'   AF                    	XRA	A
  0F2D'   32 10CA'              	STA	DCOL
  0F30'   32 10CB'              	STA	XC
  0F33'   2A 10C8'              	LHLD	PSKN
  0F36'   7C                    	MOV	A,H
  0F37'   B5                    	ORA	L
  0F38'   C2 0ED5'              	JNZ	PSKIP
  0F3B'                         PR_LP:
  0F3B'   CD 0E26'              	CALL	RDCH
  0F3E'   D8                    	RC			; end of text -> line done
  0F3F'   FE 0A                 	CPI	LF
  0F41'   C8                    	RZ			; consumed the LF -> next line start
  0F42'   FE 0D                 	CPI	CR
  0F44'   CA 0F3B'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0F47'   FE 09                 	CPI	TAB
  0F49'   CA 0F52'              	JZ	PR_TAB
  0F4C'   CD 0F61'              	CALL	PCELL
  0F4F'   C3 0F3B'              	JMP	PR_LP
  0F52'                         PR_TAB:
  0F52'   CD 0F11'              	CALL	TABN		; C = space count (1..8)
  0F55'                         PRTBLP:
  0F55'   3E 20                 	MVI	A,' '
  0F57'   CD 0F61'              	CALL	PCELL		; (keeps C)
  0F5A'   0D                    	DCR	C
  0F5B'   C2 0F55'              	JNZ	PRTBLP
  0F5E'   C3 0F3B'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0F61'                         PCELL:
  0F61'   47                    	MOV	B,A
  0F62'   21 10CA'              	LXI	H,DCOL
  0F65'   34                    	INR	M
  0F66'   3A 106B'              	LDA	NCOLS
  0F69'   21 10CB'              	LXI	H,XC
  0F6C'   BE                    	CMP	M
  0F6D'   CC 0F75'              	CZ	PWRAP		; the row is full: this one starts the next
  0F70'   34                    	INR	M
  0F71'   78                    	MOV	A,B
  0F72'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0F75'                         PWRAP:
  0F75'   36 00                 	MVI	M,0
  0F77'   3A 108F'              	LDA	PEND
  0F7A'   3D                    	DCR	A
  0F7B'   21 10C7'              	LXI	H,PROWN
  0F7E'   BE                    	CMP	M
  0F7F'   CA 0F94'              	JZ	PW_END
  0F82'   34                    	INR	M
  0F83'   3E 0D                 	MVI	A,CR
  0F85'   CD 0018'              	CALL	OUTCH
  0F88'   3E 0A                 	MVI	A,LF
  0F8A'   CD 0018'              	CALL	OUTCH
  0F8D'   CD 009B'              	CALL	CEKL		; (keeps BC)
  0F90'   21 10CB'              	LXI	H,XC
  0F93'   C9                    	RET
  0F94'                         PW_END:
  0F94'   E1                    	POP	H		; PCELL's return, and PROW's
  0F95'   E1                    	POP	H
  0F96'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0F97'                         MODEMS:
  0F97'   3A 0000*              	LDA	EDMODE
  0F9A'   47                    	MOV	B,A
  0F9B'   3A 109C'              	LDA	OEDMOD
  0F9E'   B8                    	CMP	B
  0F9F'   C8                    	RZ			; the row already shows this mode
  0FA0'   78                    	MOV	A,B
  0FA1'   32 109C'              	STA	OEDMOD
  0FA4'   21 104A'              	LXI	H,SINSM
  0FA7'   FE 01                 	CPI	EM_INS
  0FA9'   CA 0FB7'              	JZ	MD_DRW
  0FAC'   21 1057'              	LXI	H,SREPM
  0FAF'   FE 02                 	CPI	EM_REP
  0FB1'   CA 0FB7'              	JZ	MD_DRW
  0FB4'   21 1065'              	LXI	H,SNULL		; command mode: the row goes blank
  0FB7'                         MD_DRW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0FB7'   E5                    	PUSH	H
  0FB8'   3A 106A'              	LDA	NROWS
  0FBB'   CD 0095'              	CALL	GOROW1
  0FBE'   E1                    	POP	H
  0FBF'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
                                ; The cursor is shown only if a paint hid it (CHID).
  0FC2'                         SCURS:
  0FC2'   3A 1071'              	LDA	SROW
  0FC5'   47                    	MOV	B,A
  0FC6'   3A 1072'              	LDA	SCOL
  0FC9'   4F                    	MOV	C,A
  0FCA'   C5                    	PUSH	B
  0FCB'   CD 0064'              	CALL	GOTOXY
  0FCE'   E1                    	POP	H
  0FCF'   22 1036'              	SHLD	TCPOS		; where the terminal's cursor is, until the next
  0FD2'   3E 01                 	MVI	A,1		;   GOTOXY says otherwise
  0FD4'   32 1034'              	STA	TCOK
  0FD7'   21 1035'              	LXI	H,CHID
  0FDA'   7E                    	MOV	A,M
  0FDB'   B7                    	ORA	A
  0FDC'   C8                    	RZ
  0FDD'   36 00                 	MVI	M,0
  0FDF'   21 103F'              	LXI	H,SSHOW
  0FE2'   C3 0025'              	JMP	OUTSTR
                                
                                ;SCSTL -- SCURS for a frame that drew nothing: when the terminal's cursor is
                                ; where SCURS last put it, and that is where it belongs, nothing is sent (a
                                ; count digit, an operator waiting for its motion, a key that failed).
  0FE5'                         SCSTL:
  0FE5'   3A 1034'              	LDA	TCOK
  0FE8'   B7                    	ORA	A
  0FE9'   CA 0FC2'              	JZ	SCURS
  0FEC'   3A 1035'              	LDA	CHID
  0FEF'   B7                    	ORA	A
  0FF0'   C2 0FC2'              	JNZ	SCURS
  0FF3'   2A 1036'              	LHLD	TCPOS
  0FF6'   3A 1072'              	LDA	SCOL
  0FF9'   BD                    	CMP	L
  0FFA'   C2 0FC2'              	JNZ	SCURS
  0FFD'   3A 1071'              	LDA	SROW
  1000'   BC                    	CMP	H
  1001'   C2 0FC2'              	JNZ	SCURS
  1004'   C9                    	RET
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  1005'                         SCDONE:
  1005'   CD 008F'              	CALL	CRGRS
  1008'   21 103F'              	LXI	H,SSHOW
  100B'   CD 0025'              	CALL	OUTSTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  100E'   3A 106A'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  1011'   C3 0095'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  1014'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  1018'   39 3B 39 39           
  101C'   39 48                 
  101E'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  1022'   00                    
  1023'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  1027'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  102A'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  102E'   00                    
  102F'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  1033'   00                    
  1034'   00                    TCOK:	DB	0		; TCPOS is where the terminal's cursor is
  1035'   01                    CHID:	DB	1		; the cursor is hidden, or may be (the first frame)
  1036'   0000                  TCPOS:	DW	0		; SCOL, SROW as SCURS last sent them
  1038'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  103C'   35 6C 00              
  103F'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  1043'   35 68 00              
  1046'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  104A'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  104E'   4E 53 45 52           
  1052'   54 20 2D 2D           
  1056'   00                    
  1057'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  105B'   45 50 4C 41           
  105F'   43 45 20 2D           
  1063'   2D 00                 
  1065'   00                    SNULL:	DB	0
  1066'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  106A'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  106B'   50                    NCOLS:	DB	80		; runtime columns
  106C'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  106D'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  106F'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  1071'   00                    SROW:	DB	0		; computed cursor screen row
  1072'   00                    SCOL:	DB	0		; computed cursor screen column
  1073'   01                    TXEND:	DB	1		; the first row with no text on it
  1074'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  1075'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  1076'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  1078'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  1079'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  107A'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  000E                          FRMLEN	EQU	$-WINROW
  107B'   0000                  OLDWR:	DW	0
  107D'   0000                  OLDSK:	DW	0
  107F'   0000                  OLDSC:	DW	0
  1081'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  1083'   00                    OLDBOT:	DB	0
  1084'   0000                  OLDAB:	DW	0
  1086'   00                    OLDCS:	DB	0
  1087'   00                    OLDCR:	DB	0
  1088'   00                    OLDNR:	DB	0
                                
  1089'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  108A'   00                    OPM:	DB	0		; ... or gained there
  108B'   00                    EDA:	DB	0		; the edit: the rows it had
  108C'   00                    EDB:	DB	0		; ... and has
  108D'   00                    EDR:	DB	0		; ... its first row
  108E'   00                    EDP:	DB	0		; ... the first of them to draw
  108F'   00                    PEND:	DB	0		; PRNG: the row to stop before
  1090'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  1091'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  1093'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  1094'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  1095'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  1097'   0000                  HTTOPC: DW	0		; HTBLD: the bytes from the table's first line to
                                				;   the cursor
  1099'   0000                  LYPG:	DW	0		; ... and PGTOPM
  109B'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  109C'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  109D'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  109E'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  109F'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  10A0'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  10A1'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  10A3'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  10A5'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  10A7'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  10A9'   00                    LYROW:	DB	0		; LAYOUT: working row
  10AA'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  10AC'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  10AD'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  10AF'   00                    LYUSE:	DB	0		; LYMID: rows taken
  10B0'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  10B1'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  10B2'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  10B3'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  10B4'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  10B5'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  10B6'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  10B7'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  10B8'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  10BA'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  10BC'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                
  10BD'   0000                  RDP:	DW	0		; reader: next before-gap byte
  10BF'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  10C1'   0000                  RDHL:	DW	0		; reader: RGET pointer
  10C3'   0000                  RDBC:	DW	0		; reader: RGET count
  10C5'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  10C6'   00                    SKPN:	DB	0		; RDSKIP line count
  10C7'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  10C8'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  10CA'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  10CB'   00                    XC:	DB	0		; cells used in the row being painted
                                
  10CC'   0000                  TMPR:	DW	0		; DSR parse: rows
  10CE'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
