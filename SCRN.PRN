  0A7D'   BA                    	CMP	D
  0A7E'   C8                    	RZ
  0A7F'                         FC_1:
  0A7F'   1C                    	INR	E		; (NZ)
  0A80'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  0A81'                         ISBOF:
  0A81'   EB                    	XCHG
  0A82'   2A 0000*              	LHLD	TXTBEG
  0A85'   CD 0000*              	CALL	CMP16
  0A88'   C0                    	RNZ
  0A89'   2A 0000*              	LHLD	OUTPOS
  0A8C'   7C                    	MOV	A,H
  0A8D'   B5                    	ORA	L
  0A8E'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  0A8F'                         LYMID:
  0A8F'   CD 0ADB'              	CALL	LYINI
  0A92'   3A 104B'              	LDA	LYND
  0A95'   B7                    	ORA	A
  0A96'   CA 0ABE'              	JZ	LM_LP
  0A99'                         LM_NR:
  0A99'   CD 0B22'              	CALL	LMABV		; a line above and a line below, LYND times
  0A9C'   DA 0AB3'              	JC	LM_P
  0A9F'   CD 0AF4'              	CALL	LMBLW
  0AA2'   DA 0AB3'              	JC	LM_P
  0AA5'   21 104B'              	LXI	H,LYND
  0AA8'   35                    	DCR	M
  0AA9'   C2 0A99'              	JNZ	LM_NR
  0AAC'   3A 104D'              	LDA	LYSVR		; the screen holds them: scroll to it
  0AAF'   32 1042'              	STA	LYROW
  0AB2'   C9                    	RET
  0AB3'                         LM_P:
  0AB3'   AF                    	XRA	A		; it does not: the middle, above first
  0AB4'   32 104B'              	STA	LYND
  0AB7'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0AB8'   32 104C'              	STA	LYPRF
  0ABB'   C3 0A8F'              	JMP	LYMID
  0ABE'                         LM_LP:
  0ABE'   3A 104A'              	LDA	LYMBL
  0AC1'   21 104C'              	LXI	H,LYPRF
  0AC4'   86                    	ADD	M
  0AC5'   47                    	MOV	B,A
  0AC6'   3A 1049'              	LDA	LYMAB
  0AC9'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0ACA'   DA 0AD4'              	JC	LM_U		;   many, when above goes first)
  0ACD'   CD 0AF4'              	CALL	LMBLW
  0AD0'   D2 0ABE'              	JNC	LM_LP
  0AD3'   C9                    	RET
  0AD4'                         LM_U:
  0AD4'   CD 0B22'              	CALL	LMABV
  0AD7'   D2 0ABE'              	JNC	LM_LP
  0ADA'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0ADB'                         LYINI:
  0ADB'   AF                    	XRA	A
  0ADC'   32 1042'              	STA	LYROW
  0ADF'   32 1049'              	STA	LYMAB
  0AE2'   32 104A'              	STA	LYMBL
  0AE5'   3A 0000*              	LDA	HTCUR
  0AE8'   CD 0B3E'              	CALL	HTE
  0AEB'   7E                    	MOV	A,M
  0AEC'   32 1048'              	STA	LYUSE
  0AEF'   23                    	INX	H
  0AF0'   22 1043'              	SHLD	LYIB
  0AF3'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0AF4'                         LMBLW:
  0AF4'   3A 0000*              	LDA	HTN
  0AF7'   CD 0B3E'              	CALL	HTE
  0AFA'   EB                    	XCHG
  0AFB'   2A 1043'              	LHLD	LYIB
  0AFE'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0B01'   C2 0B10'              	JNZ	LB_1
  0B04'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0B07'   B7                    	ORA	A
  0B08'   37                    	STC
  0B09'   C8                    	RZ
  0B0A'   21 104A'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0B0D'   34                    	INR	M
  0B0E'   B7                    	ORA	A
  0B0F'   C9                    	RET
  0B10'                         LB_1:
  0B10'   7E                    	MOV	A,M
  0B11'   CD 0B46'              	CALL	LM_ADD
  0B14'   D8                    	RC
  0B15'   21 104A'              	LXI	H,LYMBL
  0B18'   86                    	ADD	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B19'   77                    	MOV	M,A
  0B1A'   2A 1043'              	LHLD	LYIB
  0B1D'   23                    	INX	H
  0B1E'   22 1043'              	SHLD	LYIB
  0B21'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0B22'                         LMABV:
  0B22'   21 1042'              	LXI	H,LYROW
  0B25'   3A 0000*              	LDA	HTCUR
  0B28'   96                    	SUB	M
  0B29'   37                    	STC
  0B2A'   C8                    	RZ
  0B2B'   3D                    	DCR	A
  0B2C'   CD 0B3E'              	CALL	HTE
  0B2F'   7E                    	MOV	A,M
  0B30'   CD 0B46'              	CALL	LM_ADD
  0B33'   D8                    	RC
  0B34'   21 1049'              	LXI	H,LYMAB
  0B37'   86                    	ADD	M
  0B38'   77                    	MOV	M,A
  0B39'   21 1042'              	LXI	H,LYROW
  0B3C'   34                    	INR	M
  0B3D'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B3E'                         HTE:
  0B3E'   5F                    	MOV	E,A
  0B3F'   16 00                 	MVI	D,0
  0B41'   21 0000*              	LXI	H,HTAB
  0B44'   19                    	DAD	D
  0B45'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0B46'                         LM_ADD:
  0B46'   47                    	MOV	B,A
  0B47'   3A 1048'              	LDA	LYUSE
  0B4A'   80                    	ADD	B
  0B4B'   D8                    	RC
  0B4C'   4F                    	MOV	C,A
  0B4D'   3A 1005'              	LDA	NEDIT
  0B50'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B51'   D8                    	RC
  0B52'   79                    	MOV	A,C
  0B53'   32 1048'              	STA	LYUSE
  0B56'   78                    	MOV	A,B
  0B57'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ; A line that is in memory to its LF is measured where it lies (LNW), as the
                                ; lines above the cursor's are; FLINE, a char at a time through RDGET, reads
                                ; the one the bytes run out in, and the one taller than the screen.
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B58'                         LM_NX:
  0B58'   AF                    	XRA	A
  0B59'   32 1045'              	STA	LYVB
  0B5C'   2A 105C'              	LHLD	RDBC
  0B5F'   44                    	MOV	B,H
  0B60'   4D                    	MOV	C,L
  0B61'   2A 105A'              	LHLD	RDHL
  0B64'   E5                    	PUSH	H
  0B65'   C5                    	PUSH	B
  0B66'   CD 0BAB'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0B69'   D2 0B8D'              	JNC	LN_SL
  0B6C'   E5                    	PUSH	H
  0B6D'   C5                    	PUSH	B
  0B6E'   EB                    	XCHG
  0B6F'   CD 05E0'              	CALL	XTRA		; BC = its rows past the first
  0B72'   78                    	MOV	A,B
  0B73'   B7                    	ORA	A
  0B74'   51                    	MOV	D,C
  0B75'   C1                    	POP	B
  0B76'   E1                    	POP	H
  0B77'   C2 0B8D'              	JNZ	LN_SL
  0B7A'   3A 1005'              	LDA	NEDIT
  0B7D'   3D                    	DCR	A
  0B7E'   BA                    	CMP	D		; CY iff more rows than the screen has
  0B7F'   DA 0B8D'              	JC	LN_SL
  0B82'   F1                    	POP	PSW		; (the line's start is not wanted)
  0B83'   F1                    	POP	PSW
  0B84'   3E 0A                 	MVI	A,LF
  0B86'   32 1050'              	STA	LYLAST
  0B89'   AF                    	XRA	A
  0B8A'   C3 0B95'              	JMP	LM_ST
  0B8D'                         LN_SL:
  0B8D'   C1                    	POP	B
  0B8E'   E1                    	POP	H
  0B8F'   11 0000               	LXI	D,0
  0B92'                         LM_FL:
  0B92'   CD 0A26'              	CALL	FLINE
  0B95'                         LM_ST:
  0B95'   22 105A'              	SHLD	RDHL
  0B98'   60                    	MOV	H,B
  0B99'   69                    	MOV	L,C
  0B9A'   22 105C'              	SHLD	RDBC
  0B9D'   B7                    	ORA	A
  0B9E'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0B9F'                         LYTOPP:
  0B9F'   2A 103A'              	LHLD	TOPLEN
  0BA2'   44                    	MOV	B,H
  0BA3'   4D                    	MOV	C,L
  0BA4'                         G2P:
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0BA4'   EB                    	XCHG
  0BA5'   2A 0000*              	LHLD	GAPBEG
  0BA8'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0BAB'                         LNW:
  0BAB'   11 0000               	LXI	D,0
  0BAE'                         LNW_LP:
  0BAE'   78                    	MOV	A,B
  0BAF'   B1                    	ORA	C
  0BB0'   C8                    	RZ
  0BB1'   7E                    	MOV	A,M
  0BB2'   23                    	INX	H
  0BB3'   0B                    	DCX	B
  0BB4'   FE 20                 	CPI	' '
  0BB6'   D2 0BCC'              	JNC	LNW_1		; (nearly all of them: asked first)
  0BB9'   FE 0A                 	CPI	LF
  0BBB'   CA 0BD0'              	JZ	LNW_LF
  0BBE'   FE 0D                 	CPI	CR
  0BC0'   CA 0BAE'              	JZ	LNW_LP		; CR contributes no display column
  0BC3'   FE 09                 	CPI	TAB
  0BC5'   C2 0BCC'              	JNZ	LNW_1
  0BC8'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0BC9'   F6 07                 	ORI	TABWID-1
  0BCB'   5F                    	MOV	E,A
  0BCC'                         LNW_1:
  0BCC'   13                    	INX	D
  0BCD'   C3 0BAE'              	JMP	LNW_LP
  0BD0'                         LNW_LF:
  0BD0'   37                    	STC
  0BD1'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0BD2'                         LYFAR:
  0BD2'   2A 1006'              	LHLD	WINROW
  0BD5'   EB                    	XCHG
  0BD6'   2A 0000*              	LHLD	LNDLT
  0BD9'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0BDA'   7C                    	MOV	A,H
  0BDB'   B7                    	ORA	A
  0BDC'   F2 0BF3'              	JP	LF_DN
  0BDF'   3A 1005'              	LDA	NEDIT
  0BE2'   B7                    	ORA	A
  0BE3'   1F                    	RAR
  0BE4'   D6 02                 	SUI	2
  0BE6'   5F                    	MOV	E,A
  0BE7'   16 00                 	MVI	D,0
  0BE9'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0BEA'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BEB'   B7                    	ORA	A
  0BEC'   F0                    	RP
  0BED'                         LF_FAR:
  0BED'   3E 02                 	MVI	A,PL_MID
  0BEF'   32 1038'              	STA	PLACE
  0BF2'   C9                    	RET
  0BF3'                         LF_DN:
  0BF3'   3A 100E'              	LDA	SCBOT
  0BF6'   3C                    	INR	A
  0BF7'   5F                    	MOV	E,A
  0BF8'   16 00                 	MVI	D,0
  0BFA'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0BFD'   7C                    	MOV	A,H		;   less one
  0BFE'   B7                    	ORA	A
  0BFF'   F8                    	RM			; on the screen
  0C00'   C2 0BED'              	JNZ	LF_FAR
  0C03'   3A 1005'              	LDA	NEDIT
  0C06'   BD                    	CMP	L		; CY iff NEDIT < that
  0C07'   DA 0BED'              	JC	LF_FAR
  0C0A'   7D                    	MOV	A,L
  0C0B'   32 104B'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0C0E'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0C0F'                         HTBLD:
  0C0F'   79                    	MOV	A,C
  0C10'   32 104E'              	STA	HTLIM
  0C13'   AF                    	XRA	A
  0C14'   32 0000*              	STA	HTN
  0C17'   32 102C'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0C1A'   32 0000*              	STA	HTEOF
  0C1D'   32 0000*              	STA	HTBOF
  0C20'   32 104F'              	STA	LYXE
  0C23'   32 1029'              	STA	TALLF
  0C26'   68                    	MOV	L,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C27'   67                    	MOV	H,A
  0C28'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0C2B'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0C2C'   E5                    	PUSH	H
  0C2D'   CD 0A81'              	CALL	ISBOF
  0C30'   C2 0C37'              	JNZ	HB_1
  0C33'   3C                    	INR	A
  0C34'   32 0000*              	STA	HTBOF
  0C37'                         HB_1:
  0C37'   E1                    	POP	H
  0C38'   E5                    	PUSH	H
  0C39'   CD 0BA4'              	CALL	G2P		; HL = the bytes from there to the cursor
  0C3C'   E5                    	PUSH	H
  0C3D'   3A 1004'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0C40'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0C42'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0C43'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0C45'   3A 1005'              	LDA	NEDIT		;   leave no room to read down
  0C48'   CD 0ED6'              	CALL	MULHA
  0C4B'   D1                    	POP	D
  0C4C'   42                    	MOV	B,D
  0C4D'   4B                    	MOV	C,E
  0C4E'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0C51'   D2 0C55'              	JNC	HB_LM
  0C54'   EB                    	XCHG
  0C55'                         HB_LM:
  0C55'   22 1046'              	SHLD	LYLIM
  0C58'   E1                    	POP	H
  0C59'   F1                    	POP	PSW
  0C5A'   D2 0C64'              	JNC	HB_A0
  0C5D'   3A 0000*              	LDA	HTBOF
  0C60'   B7                    	ORA	A
  0C61'   CC 0BAB'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C64'                         HB_A0:
  0C64'   E5                    	PUSH	H
  0C65'   CD 0BA4'              	CALL	G2P
  0C68'   22 1030'              	SHLD	HTTOPC		; (LYTP: the top line is found from here)
  0C6B'   E1                    	POP	H
  0C6C'                         HB_AB:
  0C6C'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C6D'   CD 0BAB'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0C70'   D2 0C93'              	JNC	HB_CU
  0C73'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0C74'   C5                    	PUSH	B
  0C75'   EB                    	XCHG
  0C76'   CD 05E0'              	CALL	XTRA		; BC = its rows past the first
  0C79'   78                    	MOV	A,B
  0C7A'   B7                    	ORA	A
  0C7B'   C2 0C88'              	JNZ	HB_TA
  0C7E'   3A 1005'              	LDA	NEDIT
  0C81'   3D                    	DCR	A
  0C82'   B9                    	CMP	C		; CY iff more rows than the screen has
  0C83'   79                    	MOV	A,C
  0C84'   3C                    	INR	A
  0C85'   D2 0C8B'              	JNC	HB_PA
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C88'                         HB_TA:
  0C88'   3A 1005'              	LDA	NEDIT
  0C8B'                         HB_PA:
  0C8B'   CD 0DA4'              	CALL	HTPUT
  0C8E'   C1                    	POP	B
  0C8F'   E1                    	POP	H
  0C90'   C3 0C6C'              	JMP	HB_AB
  0C93'                         HB_CU:
  0C93'   EB                    	XCHG
  0C94'   22 103E'              	SHLD	CURDCL
  0C97'   E1                    	POP	H
  0C98'   22 103C'              	SHLD	CBOL
  0C9B'   EB                    	XCHG			; none of it spilled while reading down: the
  0C9C'   2A 1046'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0C9F'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0CA2'   DA 0CA6'              	JC	HB_WL
  0CA5'   EB                    	XCHG
  0CA6'                         HB_WL:
  0CA6'   24                    	INR	H
  0CA7'   22 0000*              	SHLD	WRLIM
  0CAA'   3A 0000*              	LDA	HTN
  0CAD'   32 0000*              	STA	HTCUR
  0CB0'   2A 103E'              	LHLD	CURDCL
  0CB3'   CD 05E7'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0CB6'   5F                    	MOV	E,A
  0CB7'   3A 103E'              	LDA	CURDCL
  0CBA'   93                    	SUB	E
  0CBB'   32 1045'              	STA	LYVB		; the column the cursor's row starts at
  0CBE'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0CBF'   2A 1008'              	LHLD	SKIPR
  0CC2'   50                    	MOV	D,B
  0CC3'   59                    	MOV	E,C
  0CC4'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0CC7'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0CC8'   DA 0CE6'              	JC	HB_SS		; then that is the first
  0CCB'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0CCE'   7C                    	MOV	A,H
  0CCF'   B7                    	ORA	A
  0CD0'   C2 0CDC'              	JNZ	HB_SD
  0CD3'   3A 1005'              	LDA	NEDIT
  0CD6'   3D                    	DCR	A
  0CD7'   BD                    	CMP	L		; CY iff that is under the last edit row
  0CD8'   EB                    	XCHG			; HL = SKIPR, as it was
  0CD9'   D2 0CE6'              	JNC	HB_SS
  0CDC'                         HB_SD:
  0CDC'   3A 1005'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0CDF'   2F                    	CMA
  0CE0'   6F                    	MOV	L,A
  0CE1'   26 FF                 	MVI	H,0FFH
  0CE3'   23                    	INX	H
  0CE4'   23                    	INX	H
  0CE5'   09                    	DAD	B
  0CE6'                         HB_SS:
  0CE6'   22 1008'              	SHLD	SKIPR
  0CE9'   EB                    	XCHG
  0CEA'   60                    	MOV	H,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CEB'   69                    	MOV	L,C
  0CEC'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0CEF'   7D                    	MOV	A,L
  0CF0'   32 1011'              	STA	CSRAW
  0CF3'   D1                    	POP	D
  0CF4'   57                    	MOV	D,A
  0CF5'   CD 0000*              	CALL	RGET0
  0CF8'   CD 0B92'              	CALL	LM_FL		; the rest of the line: D = its last row
  0CFB'   F5                    	PUSH	PSW
  0CFC'   FE 01                 	CPI	1
  0CFE'   CA 0D8D'              	JZ	HB_TO		; more rows than the screen has
  0D01'   2A 1008'              	LHLD	SKIPR
  0D04'   7C                    	MOV	A,H
  0D05'   B5                    	ORA	L
  0D06'   CA 0D29'              	JZ	HB_E2
  0D09'   7C                    	MOV	A,H
  0D0A'   B7                    	ORA	A
  0D0B'   C2 0D24'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0D0E'   7D                    	MOV	A,L
  0D0F'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0D10'   DA 0D24'              	JC	HB_TE
  0D13'   21 1005'              	LXI	H,NEDIT
  0D16'   BE                    	CMP	M
  0D17'   D2 0D24'              	JNC	HB_TE		; more than NEDIT of them
  0D1A'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0D1B'   21 0000               	LXI	H,0
  0D1E'   22 1008'              	SHLD	SKIPR
  0D21'   C3 0D29'              	JMP	HB_E2
  0D24'                         HB_TE:
  0D24'   3E 01                 	MVI	A,1
  0D26'   32 1029'              	STA	TALLF
  0D29'                         HB_E2:
  0D29'   7B                    	MOV	A,E
  0D2A'   B7                    	ORA	A
  0D2B'   C2 0D37'              	JNZ	HB_E3
  0D2E'   B2                    	ORA	D
  0D2F'   CA 0D37'              	JZ	HB_E3		; (its first row: an empty line)
  0D32'   3E 01                 	MVI	A,1
  0D34'   32 104F'              	STA	LYXE
  0D37'                         HB_E3:
  0D37'   7A                    	MOV	A,D
  0D38'   3C                    	INR	A
  0D39'   32 1012'              	STA	LYTSH
  0D3C'   3A 1029'              	LDA	TALLF
  0D3F'   B7                    	ORA	A
  0D40'   C2 0D98'              	JNZ	HB_TX
  0D43'   F1                    	POP	PSW
  0D44'   FA 0D69'              	JM	HB_LS		; the text ends with it
  0D47'                         HB_PT:
  0D47'   7A                    	MOV	A,D
  0D48'   3C                    	INR	A
  0D49'   CD 0DA4'              	CALL	HTPUT
  0D4C'   47                    	MOV	B,A
  0D4D'   3A 104E'              	LDA	HTLIM
  0D50'   90                    	SUB	B
  0D51'   32 104E'              	STA	HTLIM
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D54'   D8                    	RC
  0D55'   CA 0D74'              	JZ	HB_PK		; rows enough
  0D58'                         HB_NX:
  0D58'   CD 0B58'              	CALL	LM_NX		; the next line down
  0D5B'   CA 0D47'              	JZ	HB_PT
  0D5E'   F2 0DA1'              	JP	HB_TL		; one taller than the screen
  0D61'   3A 1050'              	LDA	LYLAST		; the text ended: was that a line?
  0D64'   FE 0A                 	CPI	LF
  0D66'   CA 0D6E'              	JZ	HB_EF
  0D69'                         HB_LS:
  0D69'   7A                    	MOV	A,D
  0D6A'   3C                    	INR	A
  0D6B'   CD 0DA4'              	CALL	HTPUT
  0D6E'                         HB_EF:
  0D6E'   3E 01                 	MVI	A,1
  0D70'   32 0000*              	STA	HTEOF
  0D73'   C9                    	RET
  0D74'                         HB_PK:
  0D74'   2A 105C'              	LHLD	RDBC		; just the rows asked for: is the text over
  0D77'   44                    	MOV	B,H		;   right there?
  0D78'   4D                    	MOV	C,L
  0D79'   2A 105A'              	LHLD	RDHL
  0D7C'   CD 0000*              	CALL	RDGET
  0D7F'   D0                    	RNC
  0D80'   C3 0D6E'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0D83'                         HBMOR:
  0D83'   32 104E'              	STA	HTLIM
  0D86'   B7                    	ORA	A
  0D87'   CA 0D74'              	JZ	HB_PK
  0D8A'   C3 0D58'              	JMP	HB_NX
  0D8D'                         HB_TO:
  0D8D'   3E 01                 	MVI	A,1
  0D8F'   32 1029'              	STA	TALLF
  0D92'   3A 1005'              	LDA	NEDIT
  0D95'   32 1012'              	STA	LYTSH
  0D98'                         HB_TX:
  0D98'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0D99'   F2 0DA1'              	JP	HB_TL		;   with it, and on the screen)
  0D9C'   3E 01                 	MVI	A,1
  0D9E'   32 0000*              	STA	HTEOF
  0DA1'                         HB_TL:
  0DA1'   3A 1005'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0DA4'                         HTPUT:
  0DA4'   E5                    	PUSH	H
  0DA5'   D5                    	PUSH	D
  0DA6'   21 0000*              	LXI	H,HTN
  0DA9'   5E                    	MOV	E,M
  0DAA'   1C                    	INR	E
  0DAB'   CA 0DB7'              	JZ	HP_1
  0DAE'   73                    	MOV	M,E
  0DAF'   1D                    	DCR	E
  0DB0'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0DB2'   21 0000*              	LXI	H,HTAB
  0DB5'   19                    	DAD	D
  0DB6'   77                    	MOV	M,A
  0DB7'                         HP_1:
  0DB7'   D1                    	POP	D
  0DB8'   E1                    	POP	H
  0DB9'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0DBA'                         TABCUR:
  0DBA'   3A 0000*              	LDA	EDMODE
  0DBD'   FE 00                 	CPI	EM_CMD
  0DBF'   C0                    	RNZ
  0DC0'   2A 0000*              	LHLD	TXTEND
  0DC3'   EB                    	XCHG
  0DC4'   2A 0000*              	LHLD	GAPEND
  0DC7'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0DCA'   C8                    	RZ
  0DCB'   7E                    	MOV	A,M
  0DCC'   FE 09                 	CPI	TAB
  0DCE'   C0                    	RNZ
  0DCF'   2A 103E'              	LHLD	CURDCL
  0DD2'   7D                    	MOV	A,L
  0DD3'   F6 07                 	ORI	TABWID-1
  0DD5'   6F                    	MOV	L,A
  0DD6'   22 103E'              	SHLD	CURDCL
  0DD9'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0DDA'                         RDTOP:
  0DDA'   2A 103A'              	LHLD	TOPLEN
  0DDD'   C3 0DE3'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0DE0'                         RDBOL:
  0DE0'   2A 103C'              	LHLD	CBOL
  0DE3'                         RDSET:
  0DE3'   22 1058'              	SHLD	RDN
  0DE6'   EB                    	XCHG
  0DE7'   2A 0000*              	LHLD	GAPBEG
  0DEA'   CD 0000*              	CALL	SUBHD
  0DED'   22 1056'              	SHLD	RDP
  0DF0'   AF                    	XRA	A
  0DF1'   32 105E'              	STA	RDSEG
  0DF4'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0DF5'                         RDCH:
  0DF5'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0DF6'   D5                    	PUSH	D
  0DF7'   E5                    	PUSH	H
  0DF8'   2A 1058'              	LHLD	RDN		; before-gap bytes left?
  0DFB'   7C                    	MOV	A,H
  0DFC'   B5                    	ORA	L
  0DFD'   CA 0E10'              	JZ	RDC_AF
  0E00'   2B                    	DCX	H
  0E01'   22 1058'              	SHLD	RDN
  0E04'   2A 1056'              	LHLD	RDP
  0E07'   7E                    	MOV	A,M
  0E08'   23                    	INX	H
  0E09'   22 1056'              	SHLD	RDP
  0E0C'   B7                    	ORA	A		; CY=0
  0E0D'   C3 0E34'              	JMP	RDC_RT
  0E10'                         RDC_AF:
  0E10'   3A 105E'              	LDA	RDSEG
  0E13'   B7                    	ORA	A
  0E14'   C2 0E21'              	JNZ	RDC_NX
  0E17'   3C                    	INR	A		; first after-gap byte: start RGET
  0E18'   32 105E'              	STA	RDSEG
  0E1B'   CD 0000*              	CALL	RGET0
  0E1E'   C3 0E29'              	JMP	RDC_GT
  0E21'                         RDC_NX:
  0E21'   2A 105C'              	LHLD	RDBC
  0E24'   44                    	MOV	B,H
  0E25'   4D                    	MOV	C,L
  0E26'   2A 105A'              	LHLD	RDHL
  0E29'                         RDC_GT:
  0E29'   CD 0000*              	CALL	RDGET
  0E2C'   22 105A'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0E2F'   60                    	MOV	H,B
  0E30'   69                    	MOV	L,C
  0E31'   22 105C'              	SHLD	RDBC
  0E34'                         RDC_RT:
  0E34'   E1                    	POP	H
  0E35'   D1                    	POP	D
  0E36'   C1                    	POP	B
  0E37'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).  What is in
                                ; memory is passed over where it lies, before the gap and after it; RDCH
                                ; reads on only when those bytes run out with lines still to pass.
  0E38'                         RDSKIP:
  0E38'   B7                    	ORA	A
  0E39'   C8                    	RZ
  0E3A'   32 105F'              	STA	SKPN
  0E3D'   2A 1058'              	LHLD	RDN
  0E40'   44                    	MOV	B,H
  0E41'   4D                    	MOV	C,L
  0E42'   2A 1056'              	LHLD	RDP
  0E45'   CD 0E8A'              	CALL	RSK_M
  0E48'   22 1056'              	SHLD	RDP
  0E4B'   60                    	MOV	H,B
  0E4C'   69                    	MOV	L,C
  0E4D'   22 1058'              	SHLD	RDN
  0E50'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E51'   3A 105E'              	LDA	RDSEG
  0E54'   B7                    	ORA	A
  0E55'   C2 0E62'              	JNZ	RSK_A
  0E58'   3C                    	INR	A		; first after-gap byte: start RGET
  0E59'   32 105E'              	STA	RDSEG
  0E5C'   CD 0000*              	CALL	RGET0
  0E5F'   C3 0E6A'              	JMP	RSK_B
  0E62'                         RSK_A:
  0E62'   2A 105C'              	LHLD	RDBC
  0E65'   44                    	MOV	B,H
  0E66'   4D                    	MOV	C,L
  0E67'   2A 105A'              	LHLD	RDHL
  0E6A'                         RSK_B:
  0E6A'   CD 0E8A'              	CALL	RSK_M
  0E6D'   22 105A'              	SHLD	RDHL
  0E70'   60                    	MOV	H,B
  0E71'   69                    	MOV	L,C
  0E72'   22 105C'              	SHLD	RDBC
  0E75'   C8                    	RZ
  0E76'                         RSK_LP:
  0E76'   CD 0DF5'              	CALL	RDCH
  0E79'   D8                    	RC
  0E7A'   FE 0A                 	CPI	LF
  0E7C'   C2 0E76'              	JNZ	RSK_LP
  0E7F'   3A 105F'              	LDA	SKPN
  0E82'   3D                    	DCR	A
  0E83'   32 105F'              	STA	SKPN
  0E86'   C2 0E76'              	JNZ	RSK_LP
  0E89'   C9                    	RET
                                ;RSK_M -- pass over SKPN lines in the BC bytes at HL.  Z when that was all of
                                ; them; NZ when the bytes ran out first (SKPN = the lines still to pass).
  0E8A'                         RSK_M:
  0E8A'   78                    	MOV	A,B
  0E8B'   B1                    	ORA	C
  0E8C'   CA 0EA2'              	JZ	RSK_E
  0E8F'   7E                    	MOV	A,M
  0E90'   23                    	INX	H
  0E91'   0B                    	DCX	B
  0E92'   FE 0A                 	CPI	LF
  0E94'   C2 0E8A'              	JNZ	RSK_M
  0E97'   3A 105F'              	LDA	SKPN
  0E9A'   3D                    	DCR	A
  0E9B'   32 105F'              	STA	SKPN
  0E9E'   C2 0E8A'              	JNZ	RSK_M
  0EA1'   C9                    	RET
  0EA2'                         RSK_E:
  0EA2'   3C                    	INR	A		; (NZ)
  0EA3'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0EA4'                         PSKIP:
  0EA4'   3A 1004'              	LDA	NCOLS
  0EA7'   CD 0ED6'              	CALL	MULHA		; HL = the cells to pass over
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0EAA'   EB                    	XCHG
  0EAB'   21 0000               	LXI	H,0
  0EAE'   22 1061'              	SHLD	PSKN
  0EB1'                         PS_LP:
  0EB1'   7A                    	MOV	A,D
  0EB2'   B3                    	ORA	E
  0EB3'   CA 0F0A'              	JZ	PR_LP
  0EB6'   CD 0DF5'              	CALL	RDCH
  0EB9'   FE 0D                 	CPI	CR
  0EBB'   CA 0EB1'              	JZ	PS_LP
  0EBE'   0E 01                 	MVI	C,1
  0EC0'   FE 09                 	CPI	TAB
  0EC2'   CC 0EE0'              	CZ	TABN
  0EC5'                         PS_CL:
  0EC5'   7A                    	MOV	A,D
  0EC6'   B3                    	ORA	E
  0EC7'   CA 0F24'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0ECA'   1B                    	DCX	D
  0ECB'   21 1063'              	LXI	H,DCOL
  0ECE'   34                    	INR	M
  0ECF'   0D                    	DCR	C
  0ED0'   C2 0EC5'              	JNZ	PS_CL
  0ED3'   C3 0EB1'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0ED6'                         MULHA:
  0ED6'   EB                    	XCHG
  0ED7'   21 0000               	LXI	H,0
  0EDA'                         MH_LP:
  0EDA'   19                    	DAD	D
  0EDB'   3D                    	DCR	A
  0EDC'   C2 0EDA'              	JNZ	MH_LP
  0EDF'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0EE0'                         TABN:
  0EE0'   3A 1063'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0EE3'   E6 07                 	ANI	7
  0EE5'   4F                    	MOV	C,A
  0EE6'   3E 08                 	MVI	A,8
  0EE8'   91                    	SUB	C
  0EE9'   4F                    	MOV	C,A
  0EEA'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0EEB'                         PAINTR:
  0EEB'   3A 1060'              	LDA	PROWN
  0EEE'   21 100C'              	LXI	H,TXEND
  0EF1'   BE                    	CMP	M		; CY iff the row holds text
  0EF2'   DA 0EFB'              	JC	PROW
  0EF5'   3A 100D'              	LDA	FILCH
  0EF8'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0EFB'                         PROW:
  0EFB'   AF                    	XRA	A
  0EFC'   32 1063'              	STA	DCOL
  0EFF'   32 1064'              	STA	XC
  0F02'   2A 1061'              	LHLD	PSKN
  0F05'   7C                    	MOV	A,H
  0F06'   B5                    	ORA	L
  0F07'   C2 0EA4'              	JNZ	PSKIP
  0F0A'                         PR_LP:
  0F0A'   CD 0DF5'              	CALL	RDCH
  0F0D'   D8                    	RC			; end of text -> line done
  0F0E'   FE 0A                 	CPI	LF
  0F10'   C8                    	RZ			; consumed the LF -> next line start
  0F11'   FE 0D                 	CPI	CR
  0F13'   CA 0F0A'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0F16'   FE 09                 	CPI	TAB
  0F18'   CA 0F21'              	JZ	PR_TAB
  0F1B'   CD 0F30'              	CALL	PCELL
  0F1E'   C3 0F0A'              	JMP	PR_LP
  0F21'                         PR_TAB:
  0F21'   CD 0EE0'              	CALL	TABN		; C = space count (1..8)
  0F24'                         PRTBLP:
  0F24'   3E 20                 	MVI	A,' '
  0F26'   CD 0F30'              	CALL	PCELL		; (keeps C)
  0F29'   0D                    	DCR	C
  0F2A'   C2 0F24'              	JNZ	PRTBLP
  0F2D'   C3 0F0A'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0F30'                         PCELL:
  0F30'   47                    	MOV	B,A
  0F31'   21 1063'              	LXI	H,DCOL
  0F34'   34                    	INR	M
  0F35'   3A 1004'              	LDA	NCOLS
  0F38'   21 1064'              	LXI	H,XC
  0F3B'   BE                    	CMP	M
  0F3C'   CC 0F44'              	CZ	PWRAP		; the row is full: this one starts the next
  0F3F'   34                    	INR	M
  0F40'   78                    	MOV	A,B
  0F41'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0F44'                         PWRAP:
  0F44'   36 00                 	MVI	M,0
  0F46'   3A 1028'              	LDA	PEND
  0F49'   3D                    	DCR	A
  0F4A'   21 1060'              	LXI	H,PROWN
  0F4D'   BE                    	CMP	M
  0F4E'   CA 0F63'              	JZ	PW_END
  0F51'   34                    	INR	M
  0F52'   3E 0D                 	MVI	A,CR
  0F54'   CD 0018'              	CALL	OUTCH
  0F57'   3E 0A                 	MVI	A,LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0F59'   CD 0018'              	CALL	OUTCH
  0F5C'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0F5F'   21 1064'              	LXI	H,XC
  0F62'   C9                    	RET
  0F63'                         PW_END:
  0F63'   E1                    	POP	H		; PCELL's return, and PROW's
  0F64'   E1                    	POP	H
  0F65'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0F66'                         MODEMS:
  0F66'   3A 0000*              	LDA	EDMODE
  0F69'   47                    	MOV	B,A
  0F6A'   3A 1035'              	LDA	OEDMOD
  0F6D'   B8                    	CMP	B
  0F6E'   C8                    	RZ			; the row already shows this mode
  0F6F'   78                    	MOV	A,B
  0F70'   32 1035'              	STA	OEDMOD
  0F73'   21 0FE3'              	LXI	H,SINSM
  0F76'   FE 01                 	CPI	EM_INS
  0F78'   CA 0F86'              	JZ	MD_DRW
  0F7B'   21 0FF0'              	LXI	H,SREPM
  0F7E'   FE 02                 	CPI	EM_REP
  0F80'   CA 0F86'              	JZ	MD_DRW
  0F83'   21 0FFE'              	LXI	H,SNULL		; command mode: the row goes blank
  0F86'                         MD_DRW:
  0F86'   E5                    	PUSH	H
  0F87'   3A 1003'              	LDA	NROWS
  0F8A'   CD 008C'              	CALL	GOROW1
  0F8D'   E1                    	POP	H
  0F8E'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0F91'                         SCURS:
  0F91'   3A 100A'              	LDA	SROW
  0F94'   47                    	MOV	B,A
  0F95'   3A 100B'              	LDA	SCOL
  0F98'   4F                    	MOV	C,A
  0F99'   CD 0064'              	CALL	GOTOXY
  0F9C'   21 0FD8'              	LXI	H,SSHOW
  0F9F'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0FA2'                         SCDONE:
  0FA2'   CD 0086'              	CALL	CRGRS
  0FA5'   21 0FD8'              	LXI	H,SSHOW
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0FA8'   CD 0025'              	CALL	OUTSTR
  0FAB'   3A 1003'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0FAE'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0FB1'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0FB5'   39 3B 39 39           
