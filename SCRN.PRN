  0B82'   3A 0E1C'              	LDA	LYLAST		; the text ended: was that a line?
  0B85'   FE 0A                 	CPI	LF
  0B87'   CA 0B8F'              	JZ	HB_EF
  0B8A'                         HB_LS:
  0B8A'   7A                    	MOV	A,D
  0B8B'   3C                    	INR	A
  0B8C'   CD 0BC5'              	CALL	HTPUT
  0B8F'                         HB_EF:
  0B8F'   3E 01                 	MVI	A,1
  0B91'   32 0000*              	STA	HTEOF
  0B94'   C9                    	RET
  0B95'                         HB_PK:
  0B95'   2A 0E28'              	LHLD	RDBC		; just the rows asked for: is the text over
  0B98'   44                    	MOV	B,H		;   right there?
  0B99'   4D                    	MOV	C,L
  0B9A'   2A 0E26'              	LHLD	RDHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B9D'   CD 0000*              	CALL	RDGET
  0BA0'   D0                    	RNC
  0BA1'   C3 0B8F'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0BA4'                         HBMOR:
  0BA4'   32 0E1A'              	STA	HTLIM
  0BA7'   B7                    	ORA	A
  0BA8'   CA 0B95'              	JZ	HB_PK
  0BAB'   C3 0B79'              	JMP	HB_NX
  0BAE'                         HB_TO:
  0BAE'   3E 01                 	MVI	A,1
  0BB0'   32 0DF7'              	STA	TALLF
  0BB3'   3A 0DD3'              	LDA	NEDIT
  0BB6'   32 0DE0'              	STA	LYTSH
  0BB9'                         HB_TX:
  0BB9'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0BBA'   F2 0BC2'              	JP	HB_TL		;   with it, and on the screen)
  0BBD'   3E 01                 	MVI	A,1
  0BBF'   32 0000*              	STA	HTEOF
  0BC2'                         HB_TL:
  0BC2'   3A 0DD3'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0BC5'                         HTPUT:
  0BC5'   E5                    	PUSH	H
  0BC6'   D5                    	PUSH	D
  0BC7'   21 0000*              	LXI	H,HTN
  0BCA'   5E                    	MOV	E,M
  0BCB'   1C                    	INR	E
  0BCC'   CA 0BD8'              	JZ	HP_1
  0BCF'   73                    	MOV	M,E
  0BD0'   1D                    	DCR	E
  0BD1'   16 00                 	MVI	D,0
  0BD3'   21 0000*              	LXI	H,HTAB
  0BD6'   19                    	DAD	D
  0BD7'   77                    	MOV	M,A
  0BD8'                         HP_1:
  0BD8'   D1                    	POP	D
  0BD9'   E1                    	POP	H
  0BDA'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0BDB'                         TABCUR:
  0BDB'   3A 0000*              	LDA	EDMODE
  0BDE'   FE 00                 	CPI	EM_CMD
  0BE0'   C0                    	RNZ
  0BE1'   2A 0000*              	LHLD	TXTEND
  0BE4'   EB                    	XCHG
  0BE5'   2A 0000*              	LHLD	GAPEND
  0BE8'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0BEB'   C8                    	RZ
  0BEC'   7E                    	MOV	A,M
  0BED'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BEF'   C0                    	RNZ
  0BF0'   2A 0E0A'              	LHLD	CURDCL
  0BF3'   7D                    	MOV	A,L
  0BF4'   F6 07                 	ORI	TABWID-1
  0BF6'   6F                    	MOV	L,A
  0BF7'   22 0E0A'              	SHLD	CURDCL
  0BFA'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0BFB'                         RDTOP:
  0BFB'   2A 0E06'              	LHLD	TOPLEN
  0BFE'   C3 0C04'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0C01'                         RDBOL:
  0C01'   2A 0E08'              	LHLD	CBOL
  0C04'                         RDSET:
  0C04'   22 0E24'              	SHLD	RDN
  0C07'   EB                    	XCHG
  0C08'   2A 0000*              	LHLD	GAPBEG
  0C0B'   CD 0000*              	CALL	SUBHD
  0C0E'   22 0E22'              	SHLD	RDP
  0C11'   AF                    	XRA	A
  0C12'   32 0E2A'              	STA	RDSEG
  0C15'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0C16'                         RDCH:
  0C16'   C5                    	PUSH	B
  0C17'   D5                    	PUSH	D
  0C18'   E5                    	PUSH	H
  0C19'   2A 0E24'              	LHLD	RDN		; before-gap bytes left?
  0C1C'   7C                    	MOV	A,H
  0C1D'   B5                    	ORA	L
  0C1E'   CA 0C31'              	JZ	RDC_AF
  0C21'   2B                    	DCX	H
  0C22'   22 0E24'              	SHLD	RDN
  0C25'   2A 0E22'              	LHLD	RDP
  0C28'   7E                    	MOV	A,M
  0C29'   23                    	INX	H
  0C2A'   22 0E22'              	SHLD	RDP
  0C2D'   B7                    	ORA	A		; CY=0
  0C2E'   C3 0C55'              	JMP	RDC_RT
  0C31'                         RDC_AF:
  0C31'   3A 0E2A'              	LDA	RDSEG
  0C34'   B7                    	ORA	A
  0C35'   C2 0C42'              	JNZ	RDC_NX
  0C38'   3C                    	INR	A		; first after-gap byte: start RGET
  0C39'   32 0E2A'              	STA	RDSEG
  0C3C'   CD 0000*              	CALL	RGET0
  0C3F'   C3 0C4A'              	JMP	RDC_GT
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C42'                         RDC_NX:
  0C42'   2A 0E28'              	LHLD	RDBC
  0C45'   44                    	MOV	B,H
  0C46'   4D                    	MOV	C,L
  0C47'   2A 0E26'              	LHLD	RDHL
  0C4A'                         RDC_GT:
  0C4A'   CD 0000*              	CALL	RDGET
  0C4D'   22 0E26'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0C50'   60                    	MOV	H,B
  0C51'   69                    	MOV	L,C
  0C52'   22 0E28'              	SHLD	RDBC
  0C55'                         RDC_RT:
  0C55'   E1                    	POP	H
  0C56'   D1                    	POP	D
  0C57'   C1                    	POP	B
  0C58'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0C59'                         RDSKIP:
  0C59'   B7                    	ORA	A
  0C5A'   C8                    	RZ
  0C5B'   32 0E2B'              	STA	SKPN
  0C5E'                         RSK_LP:
  0C5E'   CD 0C16'              	CALL	RDCH
  0C61'   D8                    	RC
  0C62'   FE 0A                 	CPI	LF
  0C64'   C2 0C5E'              	JNZ	RSK_LP
  0C67'   3A 0E2B'              	LDA	SKPN
  0C6A'   3D                    	DCR	A
  0C6B'   32 0E2B'              	STA	SKPN
  0C6E'   C2 0C5E'              	JNZ	RSK_LP
  0C71'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0C72'                         PSKIP:
  0C72'   3A 0DD2'              	LDA	NCOLS
  0C75'   CD 0CA4'              	CALL	MULHA		; HL = the cells to pass over
  0C78'   EB                    	XCHG
  0C79'   21 0000               	LXI	H,0
  0C7C'   22 0E2D'              	SHLD	PSKN
  0C7F'                         PS_LP:
  0C7F'   7A                    	MOV	A,D
  0C80'   B3                    	ORA	E
  0C81'   CA 0CD8'              	JZ	PR_LP
  0C84'   CD 0C16'              	CALL	RDCH
  0C87'   FE 0D                 	CPI	CR
  0C89'   CA 0C7F'              	JZ	PS_LP
  0C8C'   0E 01                 	MVI	C,1
  0C8E'   FE 09                 	CPI	TAB
  0C90'   CC 0CAE'              	CZ	TABN
  0C93'                         PS_CL:
  0C93'   7A                    	MOV	A,D
  0C94'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C95'   CA 0CF2'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0C98'   1B                    	DCX	D
  0C99'   21 0E2F'              	LXI	H,DCOL
  0C9C'   34                    	INR	M
  0C9D'   0D                    	DCR	C
  0C9E'   C2 0C93'              	JNZ	PS_CL
  0CA1'   C3 0C7F'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0CA4'                         MULHA:
  0CA4'   EB                    	XCHG
  0CA5'   21 0000               	LXI	H,0
  0CA8'                         MH_LP:
  0CA8'   19                    	DAD	D
  0CA9'   3D                    	DCR	A
  0CAA'   C2 0CA8'              	JNZ	MH_LP
  0CAD'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0CAE'                         TABN:
  0CAE'   3A 0E2F'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0CB1'   E6 07                 	ANI	7
  0CB3'   4F                    	MOV	C,A
  0CB4'   3E 08                 	MVI	A,8
  0CB6'   91                    	SUB	C
  0CB7'   4F                    	MOV	C,A
  0CB8'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0CB9'                         PAINTR:
  0CB9'   3A 0E2C'              	LDA	PROWN
  0CBC'   21 0DDA'              	LXI	H,TXEND
  0CBF'   BE                    	CMP	M		; CY iff the row holds text
  0CC0'   DA 0CC9'              	JC	PROW
  0CC3'   3A 0DDB'              	LDA	FILCH
  0CC6'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0CC9'                         PROW:
  0CC9'   AF                    	XRA	A
  0CCA'   32 0E2F'              	STA	DCOL
  0CCD'   32 0E30'              	STA	XC
  0CD0'   2A 0E2D'              	LHLD	PSKN
  0CD3'   7C                    	MOV	A,H
  0CD4'   B5                    	ORA	L
  0CD5'   C2 0C72'              	JNZ	PSKIP
  0CD8'                         PR_LP:
  0CD8'   CD 0C16'              	CALL	RDCH
  0CDB'   D8                    	RC			; end of text -> line done
  0CDC'   FE 0A                 	CPI	LF
  0CDE'   C8                    	RZ			; consumed the LF -> next line start
  0CDF'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CE1'   CA 0CD8'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0CE4'   FE 09                 	CPI	TAB
  0CE6'   CA 0CEF'              	JZ	PR_TAB
  0CE9'   CD 0CFE'              	CALL	PCELL
  0CEC'   C3 0CD8'              	JMP	PR_LP
  0CEF'                         PR_TAB:
  0CEF'   CD 0CAE'              	CALL	TABN		; C = space count (1..8)
  0CF2'                         PRTBLP:
  0CF2'   3E 20                 	MVI	A,' '
  0CF4'   CD 0CFE'              	CALL	PCELL		; (keeps C)
  0CF7'   0D                    	DCR	C
  0CF8'   C2 0CF2'              	JNZ	PRTBLP
  0CFB'   C3 0CD8'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0CFE'                         PCELL:
  0CFE'   47                    	MOV	B,A
  0CFF'   21 0E2F'              	LXI	H,DCOL
  0D02'   34                    	INR	M
  0D03'   3A 0DD2'              	LDA	NCOLS
  0D06'   21 0E30'              	LXI	H,XC
  0D09'   BE                    	CMP	M
  0D0A'   CC 0D12'              	CZ	PWRAP		; the row is full: this one starts the next
  0D0D'   34                    	INR	M
  0D0E'   78                    	MOV	A,B
  0D0F'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0D12'                         PWRAP:
  0D12'   36 00                 	MVI	M,0
  0D14'   3A 0DF6'              	LDA	PEND
  0D17'   3D                    	DCR	A
  0D18'   21 0E2C'              	LXI	H,PROWN
  0D1B'   BE                    	CMP	M
  0D1C'   CA 0D31'              	JZ	PW_END
  0D1F'   34                    	INR	M
  0D20'   3E 0D                 	MVI	A,CR
  0D22'   CD 0018'              	CALL	OUTCH
  0D25'   3E 0A                 	MVI	A,LF
  0D27'   CD 0018'              	CALL	OUTCH
  0D2A'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0D2D'   21 0E30'              	LXI	H,XC
  0D30'   C9                    	RET
  0D31'                         PW_END:
  0D31'   E1                    	POP	H		; PCELL's return, and PROW's
  0D32'   E1                    	POP	H
  0D33'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0D34'                         MODEMS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D34'   3A 0000*              	LDA	EDMODE
  0D37'   47                    	MOV	B,A
  0D38'   3A 0E01'              	LDA	OEDMOD
  0D3B'   B8                    	CMP	B
  0D3C'   C8                    	RZ			; the row already shows this mode
  0D3D'   78                    	MOV	A,B
  0D3E'   32 0E01'              	STA	OEDMOD
  0D41'   21 0DB1'              	LXI	H,SINSM
  0D44'   FE 01                 	CPI	EM_INS
  0D46'   CA 0D54'              	JZ	MD_DRW
  0D49'   21 0DBE'              	LXI	H,SREPM
  0D4C'   FE 02                 	CPI	EM_REP
  0D4E'   CA 0D54'              	JZ	MD_DRW
  0D51'   21 0DCC'              	LXI	H,SNULL		; command mode: the row goes blank
  0D54'                         MD_DRW:
  0D54'   E5                    	PUSH	H
  0D55'   3A 0DD1'              	LDA	NROWS
  0D58'   CD 008C'              	CALL	GOROW1
  0D5B'   E1                    	POP	H
  0D5C'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0D5F'                         SCURS:
  0D5F'   3A 0DD8'              	LDA	SROW
  0D62'   47                    	MOV	B,A
  0D63'   3A 0DD9'              	LDA	SCOL
  0D66'   4F                    	MOV	C,A
  0D67'   CD 0064'              	CALL	GOTOXY
  0D6A'   21 0DA6'              	LXI	H,SSHOW
  0D6D'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0D70'                         SCDONE:
  0D70'   CD 0086'              	CALL	CRGRS
  0D73'   21 0DA6'              	LXI	H,SSHOW
  0D76'   CD 0025'              	CALL	OUTSTR
  0D79'   3A 0DD1'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0D7C'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0D7F'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0D83'   39 3B 39 39           
  0D87'   39 48                 
  0D89'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0D8D'   00                    
  0D8E'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0D92'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0D95'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0D99'   00                    
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D9A'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0D9E'   00                    
  0D9F'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0DA3'   35 6C 00              
  0DA6'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0DAA'   35 68 00              
  0DAD'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0DB1'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0DB5'   4E 53 45 52           
  0DB9'   54 20 2D 2D           
  0DBD'   00                    
  0DBE'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0DC2'   45 50 4C 41           
  0DC6'   43 45 20 2D           
  0DCA'   2D 00                 
  0DCC'   00                    SNULL:	DB	0
  0DCD'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0DD1'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0DD2'   50                    NCOLS:	DB	80		; runtime columns
  0DD3'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0DD4'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0DD6'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0DD8'   00                    SROW:	DB	0		; computed cursor screen row
  0DD9'   00                    SCOL:	DB	0		; computed cursor screen column
  0DDA'   01                    TXEND:	DB	1		; the first row with no text on it
  0DDB'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0DDC'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0DDD'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0DDF'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0DE0'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0DE1'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0DE2'   0000                  OLDWR:	DW	0
  0DE4'   0000                  OLDSK:	DW	0
  0DE6'   0000                  OLDSC:	DW	0
  0DE8'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0DEA'   00                    OLDBOT:	DB	0
  0DEB'   0000                  OLDAB:	DW	0
  0DED'   00                    OLDCS:	DB	0
  0DEE'   00                    OLDCR:	DB	0
  0DEF'   00                    OLDNR:	DB	0
                                
  0DF0'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0DF1'   00                    OPM:	DB	0		; ... or gained there
  0DF2'   00                    EDA:	DB	0		; the edit: the rows it had
  0DF3'   00                    EDB:	DB	0		; ... and has
  0DF4'   00                    EDR:	DB	0		; ... its first row
  0DF5'   00                    EDP:	DB	0		; ... the first of them to draw
  0DF6'   00                    PEND:	DB	0		; PRNG: the row to stop before
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0DF7'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0DF8'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0DFA'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  0DFB'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  0DFC'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  0DFE'   0000                  LYPG:	DW	0		; ... and PGTOPM
  0E00'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  0E01'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0E02'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0E03'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0E04'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0E05'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0E06'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0E08'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0E0A'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0E0C'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0E0E'   00                    LYROW:	DB	0		; LAYOUT: working row
  0E0F'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0E11'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0E12'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0E14'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0E15'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0E16'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0E17'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0E18'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0E19'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0E1A'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0E1B'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0E1C'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0E1D'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0E1F'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0E21'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0E22'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0E24'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0E26'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0E28'   0000                  RDBC:	DW	0		; reader: RGET count
  0E2A'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0E2B'   00                    SKPN:	DB	0		; RDSKIP line count
  0E2C'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0E2D'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0E2F'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0E30'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0E31'   0000                  TMPR:	DW	0		; DSR parse: rows
  0E33'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
