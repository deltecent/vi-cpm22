  065D'   B7                    	ORA	A
  065E'   FA 06A9'              	JM	LY_EOF
  0661'   CA 068D'              	JZ	LY_FLF
  0664'   3A 0C94'              	LDA	LYEND		; a row the screen has not got:
  0667'   B7                    	ORA	A
  0668'   C2 0677'              	JNZ	LY_CUT
  066B'   21 0C90'              	LXI	H,LYROW		; the cursor's own line needs it: give up a
  066E'   7E                    	MOV	A,M		;   line at the top and measure again
  066F'   B7                    	ORA	A
  0670'   CA 0682'              	JZ	LY_TAL
  0673'   35                    	DCR	M
  0674'   C3 0541'              	JMP	LY_TOP
  0677'                         LY_CUT:
  0677'   3E 40                 	MVI	A,'@'		; a line under it does not: it is not shown, and
  0679'   32 0C81'              	STA	FILCH		;   the rows it would have started on say so
  067C'   3A 0C95'              	LDA	LYLST
  067F'   C3 06C4'              	JMP	LY_END
  0682'                         LY_TAL:
  0682'   3E 01                 	MVI	A,1		; a line taller than the screen: as many rows of
  0684'   32 0C7A'              	STA	TALLF		;   it as there are
  0687'   3A 0C6F'              	LDA	NEDIT
  068A'   C3 06C4'              	JMP	LY_END
  068D'                         LY_FLF:
  068D'   CD 0725'              	CALL	LYTLQ
  0690'   CD 0965'              	CALL	LYLEND		; that line's rows are counted
  0693'   3A 0C6F'              	LDA	NEDIT
  0696'   BA                    	CMP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0697'   C2 065A'              	JNZ	LY_FWD
  069A'   CD 0000*              	CALL	RDGET		; rows full: is the text over right there?
  069D'   D2 06A5'              	JNC	LY_FUL
  06A0'   3E 01                 	MVI	A,1
  06A2'   32 0C82'              	STA	SCEOF
  06A5'                         LY_FUL:
  06A5'   7A                    	MOV	A,D
  06A6'   C3 06C4'              	JMP	LY_END
  06A9'                         LY_EOF:
  06A9'   CD 0725'              	CALL	LYTLQ
  06AC'   3E 01                 	MVI	A,1
  06AE'   32 0C82'              	STA	SCEOF
  06B1'   3A 0C94'              	LDA	LYEND		; text after the last line end -- or no line end
  06B4'   B7                    	ORA	A		;   at all -- is a line too
  06B5'   CA 06C0'              	JZ	LY_EO1
  06B8'   3A 0CA4'              	LDA	LYLAST
  06BB'   FE 0A                 	CPI	LF
  06BD'   CA 06C3'              	JZ	LY_EO2
  06C0'                         LY_EO1:
  06C0'   CD 0965'              	CALL	LYLEND
  06C3'                         LY_EO2:
  06C3'   7A                    	MOV	A,D
  06C4'                         LY_END:
  06C4'   32 0C80'              	STA	TXEND		; the first row with no text on it
  06C7'   3A 0C94'              	LDA	LYEND		; below = the lines that ended, less the cursor's
  06CA'   D6 01                 	SUI	1
  06CC'   CE 00                 	ACI	0
  06CE'   32 0C93'              	STA	LYBLW
  06D1'   3A 0C90'              	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
  06D4'   21 0C93'              	LXI	H,LYBLW
  06D7'   86                    	ADD	M
  06D8'   32 0C7F'              	STA	SCBOT
                                	;--- WRAPF: more rows of text than lines, or a line cut off ---
  06DB'   3C                    	INR	A
  06DC'   21 0C80'              	LXI	H,TXEND
  06DF'   96                    	SUB	M
  06E0'   21 0C81'              	LXI	H,FILCH
  06E3'   C2 06EE'              	JNZ	LY_W1
  06E6'   7E                    	MOV	A,M
  06E7'   FE 7E                 	CPI	'~'
  06E9'   3E 00                 	MVI	A,0
  06EB'   CA 06F0'              	JZ	LY_W2
  06EE'                         LY_W1:
  06EE'   3E 01                 	MVI	A,1
  06F0'                         LY_W2:
  06F0'   21 0CA3'              	LXI	H,LYXE
  06F3'   B6                    	ORA	M
  06F4'   32 0C74'              	STA	WRAPF
  06F7'   3A 0C90'              	LDA	LYROW		; WINROW = row
  06FA'   6F                    	MOV	L,A
  06FB'   26 00                 	MVI	H,0
  06FD'   22 0C70'              	SHLD	WINROW
  0700'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  0701'   2A 0C8E'              	LHLD	LYDLT
  0704'   CD 0000*              	CALL	SUBHD
  0707'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  0708'   2A 0C72'              	LHLD	OLDWR
  070B'   19                    	DAD	D
  070C'   22 0C7B'              	SHLD	SCRLN
  070F'   CD 0A70'              	CALL	TABCUR
  0712'   2A 0CA5'              	LHLD	SVCNT
  0715'   22 0000*              	SHLD	CMDCNT
  0718'   2A 0CA7'              	LHLD	SVAUX
  071B'   22 0000*              	SHLD	AUXCNT
  071E'   3A 0CA9'              	LDA	SVDIR
  0721'   32 0000*              	STA	DIRFLG
  0724'   C9                    	RET
                                
                                ;LYTLQ -- a line has ended on row D.  If it is the cursor's, shown from a row
                                ; of its own (SKIPR), and yet no taller than the screen -- it was, before an
                                ; edit -- it is shown whole after all: SKIPR = 0, and the layout starts over
                                ; (the return is dropped).  Keeps HL, BC, DE otherwise.
  0725'                         LYTLQ:
  0725'   3A 0C94'              	LDA	LYEND
  0728'   B7                    	ORA	A
  0729'   C0                    	RNZ			; a line under the cursor's
  072A'   E5                    	PUSH	H
  072B'   2A 0C76'              	LHLD	SKIPR
  072E'   7C                    	MOV	A,H
  072F'   B7                    	ORA	A
  0730'   C2 074D'              	JNZ	LQ_TL		; (256 rows off the top and more: it is taller)
  0733'   B5                    	ORA	L
  0734'   CA 0752'              	JZ	LQ_RET
  0737'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0738'   DA 074D'              	JC	LQ_TL
  073B'   21 0C6F'              	LXI	H,NEDIT
  073E'   BE                    	CMP	M
  073F'   D2 074D'              	JNC	LQ_TL		; more than NEDIT of them
  0742'   E1                    	POP	H
  0743'   E1                    	POP	H
  0744'   21 0000               	LXI	H,0
  0747'   22 0C76'              	SHLD	SKIPR
  074A'   C3 0541'              	JMP	LY_TOP
  074D'                         LQ_TL:
  074D'   3E 01                 	MVI	A,1
  074F'   32 0C7A'              	STA	TALLF
  0752'                         LQ_RET:
  0752'   E1                    	POP	H
  0753'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0754'                         FLINE:
  0754'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0757'   DA 0794'              	JC	FL_EOF
  075A'   32 0CA4'              	STA	LYLAST
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  075D'   FE 0A                 	CPI	LF
  075F'   CA 0792'              	JZ	FL_LF
  0762'   FE 0D                 	CPI	CR
  0764'   CA 0754'              	JZ	FLINE		; CR contributes no display column
  0767'   FE 09                 	CPI	TAB
  0769'   CA 0775'              	JZ	FL_TAB
  076C'   CD 0797'              	CALL	FL_CEL
  076F'   C2 0754'              	JNZ	FLINE
  0772'                         FL_OVR:
  0772'   3E 01                 	MVI	A,1
  0774'   C9                    	RET
  0775'                         FL_TAB:
  0775'   3A 0C96'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0778'   83                    	ADD	E
  0779'   E6 07                 	ANI	TABWID-1
  077B'   2F                    	CMA
  077C'   C6 09                 	ADI	TABWID+1
  077E'   E5                    	PUSH	H
  077F'   6F                    	MOV	L,A
  0780'                         FT_LP:
  0780'   CD 0797'              	CALL	FL_CEL
  0783'   CA 078E'              	JZ	FT_OVR
  0786'   2D                    	DCR	L
  0787'   C2 0780'              	JNZ	FT_LP
  078A'   E1                    	POP	H
  078B'   C3 0754'              	JMP	FLINE
  078E'                         FT_OVR:
  078E'   E1                    	POP	H
  078F'   C3 0772'              	JMP	FL_OVR
  0792'                         FL_LF:
  0792'   AF                    	XRA	A
  0793'   C9                    	RET
  0794'                         FL_EOF:
  0794'   3E FF                 	MVI	A,0FFH
  0796'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  0797'                         FL_CEL:
  0797'   3A 0C6E'              	LDA	NCOLS
  079A'   BB                    	CMP	E
  079B'   C2 07AD'              	JNZ	FC_1
  079E'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  07A0'   14                    	INR	D
  07A1'   E5                    	PUSH	H
  07A2'   21 0C96'              	LXI	H,LYVB
  07A5'   86                    	ADD	M
  07A6'   77                    	MOV	M,A
  07A7'   E1                    	POP	H
  07A8'   3A 0C6F'              	LDA	NEDIT
  07AB'   BA                    	CMP	D
  07AC'   C8                    	RZ
  07AD'                         FC_1:
  07AD'   1C                    	INR	E		; (NZ)
  07AE'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ; there -- it is the first byte in memory and no record went out before it.
  07AF'                         ISBOF:
  07AF'   EB                    	XCHG
  07B0'   2A 0000*              	LHLD	TXTBEG
  07B3'   CD 0000*              	CALL	CMP16
  07B6'   C0                    	RNZ
  07B7'   2A 0000*              	LHLD	OUTPOS
  07BA'   7C                    	MOV	A,H
  07BB'   B5                    	ORA	L
  07BC'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (WFILL =
                                ; WF_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  07BD'                         LYMID:
  07BD'   AF                    	XRA	A
  07BE'   32 0C90'              	STA	LYROW
  07C1'   32 0C9C'              	STA	LYMAB
  07C4'   32 0C9D'              	STA	LYMBL
  07C7'   32 0C9E'              	STA	LYMEOF
  07CA'   3A 0C6F'              	LDA	NEDIT
  07CD'   3D                    	DCR	A
  07CE'   6F                    	MOV	L,A
  07CF'   26 00                 	MVI	H,0
  07D1'   CD 0000*              	CALL	LINPSB		; as far up as the screen could ever reach
  07D4'   CD 093C'              	CALL	G2P
  07D7'   E5                    	PUSH	H
  07D8'   3A 0C6E'              	LDA	NCOLS		; ... which is no more bytes than its rows hold,
  07DB'   C6 02                 	ADI	2		;   a line end to each: lines above that are
  07DD'   6F                    	MOV	L,A		;   bigger are no use here, and held in memory
  07DE'   26 00                 	MVI	H,0		;   they would leave no room to read down
  07E0'   3A 0C6F'              	LDA	NEDIT
  07E3'   CD 0B39'              	CALL	MULHA
  07E6'   D1                    	POP	D
  07E7'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  07EA'   D2 07EE'              	JNC	LM_LIM
  07ED'   EB                    	XCHG
  07EE'                         LM_LIM:
  07EE'   22 0C97'              	SHLD	LYLIM
  07F1'   24                    	INR	H
  07F2'   22 0000*              	SHLD	WRLIM		; (and none of it spilled while reading down)
  07F5'   2A 0000*              	LHLD	GAPBEG
  07F8'   CD 0915'              	CALL	PRVL0		; HL = the cursor line's start, BC = bytes to here
  07FB'   CD 08FB'              	CALL	LM_LNW		; DE = the columns before the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  07FE'   CD 08AA'              	CALL	LCROW		; ... and the rest of it: D = its last row
  0801'   D8                    	RC			; (taller than the screen)
  0802'   F2 0808'              	JP	LM_1
  0805'   32 0C9E'              	STA	LYMEOF		; the text ends with it
  0808'                         LM_1:
  0808'   7A                    	MOV	A,D
  0809'   3C                    	INR	A
  080A'   32 0C9B'              	STA	LYUSE		; the rows taken so far: its own
  080D'   3A 0C9F'              	LDA	LYND
  0810'   B7                    	ORA	A
  0811'   CA 0839'              	JZ	LM_LP
  0814'                         LM_NR:
  0814'   CD 0883'              	CALL	LMABV		; a line above and a line below, LYND times
  0817'   DA 082E'              	JC	LM_P
  081A'   CD 0856'              	CALL	LMBLW
  081D'   DA 082E'              	JC	LM_P
  0820'   21 0C9F'              	LXI	H,LYND
  0823'   35                    	DCR	M
  0824'   C2 0814'              	JNZ	LM_NR
  0827'   3A 0CA1'              	LDA	LYSVR		; the screen holds them: scroll to it
  082A'   32 0C90'              	STA	LYROW
  082D'   C9                    	RET
  082E'                         LM_P:
  082E'   AF                    	XRA	A		; it does not: the middle, above first
  082F'   32 0C9F'              	STA	LYND
  0832'   3C                    	INR	A
  0833'   32 0CA0'              	STA	LYPRF
  0836'   C3 07BD'              	JMP	LYMID
  0839'                         LM_LP:
  0839'   3A 0C9D'              	LDA	LYMBL
  083C'   21 0CA0'              	LXI	H,LYPRF
  083F'   86                    	ADD	M
  0840'   47                    	MOV	B,A
  0841'   3A 0C9C'              	LDA	LYMAB
  0844'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0845'   DA 084F'              	JC	LM_U		;   many, when above goes first)
  0848'   CD 0856'              	CALL	LMBLW
  084B'   D2 0839'              	JNC	LM_LP
  084E'   C9                    	RET
  084F'                         LM_U:
  084F'   CD 0883'              	CALL	LMABV
  0852'   D2 0839'              	JNC	LM_LP
  0855'   C9                    	RET
                                
                                ;LMBLW -- LYMID: take the next line below the ones taken -- a '~' row, once
                                ; the text has ended.  CY if the screen has no room for it.
  0856'                         LMBLW:
  0856'   3A 0C9E'              	LDA	LYMEOF
  0859'   B7                    	ORA	A
  085A'   C2 087D'              	JNZ	LB_TL
  085D'   CD 08DF'              	CALL	LM_NX
  0860'   F2 086F'              	JP	LB_1
  0863'   32 0C9E'              	STA	LYMEOF		; the text ended: was that a line?
  0866'   3A 0CA4'              	LDA	LYLAST
  0869'   FE 0A                 	CPI	LF
  086B'   CA 087D'              	JZ	LB_TL
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  086E'   AF                    	XRA	A
  086F'                         LB_1:
  086F'   37                    	STC
  0870'   C0                    	RNZ			; one taller than the screen
  0871'   7A                    	MOV	A,D
  0872'   3C                    	INR	A		; its rows
  0873'   CD 08CD'              	CALL	LM_ADD
  0876'   D8                    	RC
  0877'   21 0C9D'              	LXI	H,LYMBL
  087A'   86                    	ADD	M
  087B'   77                    	MOV	M,A
  087C'   C9                    	RET
  087D'                         LB_TL:
  087D'   21 0C9D'              	LXI	H,LYMBL		; a '~' row
  0880'   34                    	INR	M
  0881'   B7                    	ORA	A
  0882'   C9                    	RET
                                
                                ;LMABV -- LYMID: take the next line above the ones taken (LYROW counts them).
                                ; CY if there is none, or the screen has no room for it.
  0883'                         LMABV:
  0883'   2A 0C99'              	LHLD	LYUP
  0886'   CD 093C'              	CALL	G2P
  0889'   CD 0906'              	CALL	PRVLN
  088C'   D8                    	RC			; the start of the file
  088D'   CD 08FB'              	CALL	LM_LNW
  0890'   EB                    	XCHG
  0891'   CD 04CC'              	CALL	XTRA		; BC = its rows, less one
  0894'   78                    	MOV	A,B
  0895'   B7                    	ORA	A
  0896'   37                    	STC
  0897'   C0                    	RNZ
  0898'   79                    	MOV	A,C
  0899'   3C                    	INR	A
  089A'   37                    	STC
  089B'   C8                    	RZ
  089C'   CD 08CD'              	CALL	LM_ADD
  089F'   D8                    	RC
  08A0'   21 0C9C'              	LXI	H,LYMAB
  08A3'   86                    	ADD	M
  08A4'   77                    	MOV	M,A
  08A5'   21 0C90'              	LXI	H,LYROW
  08A8'   34                    	INR	M
  08A9'   C9                    	RET
                                
                                ;LCROW -- DE = the columns before the cursor on its line: read the rest of
                                ; the line (LM_FL).  D = its last row, counted from 0.  CY if it is taller
                                ; than the screen; else M if the text ended with it.
  08AA'                         LCROW:
  08AA'   EB                    	XCHG
  08AB'   E5                    	PUSH	H
  08AC'   CD 04D3'              	CALL	DIVN		; BC = rows into the line, A = cells in that row
  08AF'   E1                    	POP	H
  08B0'   5F                    	MOV	E,A
  08B1'   7D                    	MOV	A,L
  08B2'   93                    	SUB	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  08B3'   32 0C96'              	STA	LYVB
  08B6'   78                    	MOV	A,B
  08B7'   B7                    	ORA	A
  08B8'   37                    	STC
  08B9'   C0                    	RNZ
  08BA'   51                    	MOV	D,C
  08BB'   3A 0C6F'              	LDA	NEDIT
  08BE'   3D                    	DCR	A
  08BF'   BA                    	CMP	D
  08C0'   D8                    	RC
  08C1'   CD 0000*              	CALL	RGET0
  08C4'   CD 08EE'              	CALL	LM_FL
  08C7'   FE 01                 	CPI	1
  08C9'   37                    	STC
  08CA'   C8                    	RZ
  08CB'   B7                    	ORA	A
  08CC'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  08CD'                         LM_ADD:
  08CD'   47                    	MOV	B,A
  08CE'   3A 0C9B'              	LDA	LYUSE
  08D1'   80                    	ADD	B
  08D2'   D8                    	RC
  08D3'   4F                    	MOV	C,A
  08D4'   3A 0C6F'              	LDA	NEDIT
  08D7'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  08D8'   D8                    	RC
  08D9'   79                    	MOV	A,C
  08DA'   32 0C9B'              	STA	LYUSE
  08DD'   78                    	MOV	A,B
  08DE'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  08DF'                         LM_NX:
  08DF'   11 0000               	LXI	D,0
  08E2'   AF                    	XRA	A
  08E3'   32 0C96'              	STA	LYVB
  08E6'   2A 0CB0'              	LHLD	RDBC
  08E9'   44                    	MOV	B,H
  08EA'   4D                    	MOV	C,L
  08EB'   2A 0CAE'              	LHLD	RDHL
  08EE'                         LM_FL:
  08EE'   CD 0754'              	CALL	FLINE
  08F1'   22 0CAE'              	SHLD	RDHL
  08F4'   60                    	MOV	H,B
  08F5'   69                    	MOV	L,C
  08F6'   22 0CB0'              	SHLD	RDBC
  08F9'   B7                    	ORA	A
  08FA'   C9                    	RET
                                
                                ;LM_LNW -- HL = the start of a line above (or the cursor's), BC = its bytes:
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; note it as the highest line taken (LYUP) and measure it (LNW).
  08FB'                         LM_LNW:
  08FB'   E5                    	PUSH	H
  08FC'   CD 093C'              	CALL	G2P
  08FF'   22 0C99'              	SHLD	LYUP
  0902'   E1                    	POP	H
  0903'   C3 0943'              	JMP	LNW
                                
                                ;PRVLN -- HL = the start of a line: HL = the start of the line before it, BC
                                ; = that line's bytes.  CY if there is none (LYLIM: the text ends there).
                                ;PRVL0 -- the same from inside a line, back to its own start.
  0906'                         PRVLN:
  0906'   CD 092D'              	CALL	PVLIM
  0909'   CD 0000*              	CALL	CMP16
  090C'   37                    	STC
  090D'   C8                    	RZ
  090E'   2B                    	DCX	H		; its LF
  090F'   01 0001               	LXI	B,1
  0912'   C3 091B'              	JMP	PV_LP
  0915'                         PRVL0:
  0915'   CD 092D'              	CALL	PVLIM
  0918'   01 0000               	LXI	B,0
  091B'                         PV_LP:
  091B'   CD 0000*              	CALL	CMP16
  091E'   C8                    	RZ			; (NC) as far up as the text goes
  091F'   2B                    	DCX	H
  0920'   7E                    	MOV	A,M
  0921'   FE 0A                 	CPI	LF
  0923'   CA 092A'              	JZ	PV_DN
  0926'   03                    	INX	B
  0927'   C3 091B'              	JMP	PV_LP
  092A'                         PV_DN:
  092A'   23                    	INX	H
  092B'   B7                    	ORA	A
  092C'   C9                    	RET
                                ;PVLIM -- DE = the address LYLIM stands for.  Keeps HL.
  092D'                         PVLIM:
  092D'   E5                    	PUSH	H
  092E'   2A 0C97'              	LHLD	LYLIM
  0931'   CD 093C'              	CALL	G2P
  0934'   EB                    	XCHG
  0935'   E1                    	POP	H
  0936'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0937'                         LYTOPP:
  0937'   2A 0C86'              	LHLD	TOPLEN
  093A'   44                    	MOV	B,H
  093B'   4D                    	MOV	C,L
  093C'                         G2P:
  093C'   EB                    	XCHG
  093D'   2A 0000*              	LHLD	GAPBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0940'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0943'                         LNW:
  0943'   11 0000               	LXI	D,0
  0946'                         LNW_LP:
  0946'   78                    	MOV	A,B
  0947'   B1                    	ORA	C
  0948'   C8                    	RZ
  0949'   7E                    	MOV	A,M
  094A'   23                    	INX	H
  094B'   0B                    	DCX	B
  094C'   FE 0A                 	CPI	LF
  094E'   CA 0963'              	JZ	LNW_LF
  0951'   FE 0D                 	CPI	CR
  0953'   CA 0946'              	JZ	LNW_LP		; CR contributes no display column
  0956'   FE 09                 	CPI	TAB
  0958'   C2 095F'              	JNZ	LNW_1
  095B'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  095C'   F6 07                 	ORI	TABWID-1
  095E'   5F                    	MOV	E,A
  095F'                         LNW_1:
  095F'   13                    	INX	D
  0960'   C3 0946'              	JMP	LNW_LP
  0963'                         LNW_LF:
  0963'   37                    	STC
  0964'   C9                    	RET
                                
                                ;LYLEND -- LAYOUT's forward read: a line ended on row D.  The next starts on
                                ; the row under it.  A line that ends with a row it has put nothing on is the
                                ; cursor's, standing past text that filled the row above (an insert at the
                                ; end of a line just as wide as the screen): WR_EOL.  Keeps HL, BC.
  0965'                         LYLEND:
  0965'   7B                    	MOV	A,E
  0966'   B7                    	ORA	A
  0967'   C2 0976'              	JNZ	LE_1
  096A'   3A 0C95'              	LDA	LYLST
  096D'   BA                    	CMP	D
  096E'   CA 0976'              	JZ	LE_1		; (its first row: an empty line)
  0971'   3E 03                 	MVI	A,WR_EOL+1
  0973'   32 0CA3'              	STA	LYXE
  0976'                         LE_1:
  0976'   14                    	INR	D
  0977'   7A                    	MOV	A,D
  0978'   32 0C95'              	STA	LYLST
  097B'   AF                    	XRA	A
  097C'   5F                    	MOV	E,A
  097D'   32 0C96'              	STA	LYVB
  0980'   3A 0C94'              	LDA	LYEND
  0983'   3C                    	INR	A
  0984'   32 0C94'              	STA	LYEND
  0987'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (WF_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0988'                         LYFAR:
  0988'   2A 0C70'              	LHLD	WINROW
  098B'   EB                    	XCHG
  098C'   2A 0000*              	LHLD	LNDLT
  098F'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0990'   7C                    	MOV	A,H
  0991'   B7                    	ORA	A
  0992'   F2 09A9'              	JP	LF_DN
  0995'   3A 0C6F'              	LDA	NEDIT
  0998'   B7                    	ORA	A
  0999'   1F                    	RAR
  099A'   D6 02                 	SUI	2
  099C'   5F                    	MOV	E,A
  099D'   16 00                 	MVI	D,0
  099F'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  09A0'   7C                    	MOV	A,H
  09A1'   B7                    	ORA	A
  09A2'   F0                    	RP
  09A3'                         LF_FAR:
  09A3'   3E 02                 	MVI	A,WF_MID
  09A5'   32 0C84'              	STA	WFILL
  09A8'   C9                    	RET
  09A9'                         LF_DN:
  09A9'   3A 0C7F'              	LDA	SCBOT
  09AC'   3C                    	INR	A
  09AD'   5F                    	MOV	E,A
  09AE'   16 00                 	MVI	D,0
  09B0'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  09B3'   7C                    	MOV	A,H		;   less one
  09B4'   B7                    	ORA	A
  09B5'   F8                    	RM			; on the screen
  09B6'   C2 09A3'              	JNZ	LF_FAR
  09B9'   3A 0C6F'              	LDA	NEDIT
  09BC'   BD                    	CMP	L		; CY iff NEDIT < that
  09BD'   DA 09A3'              	JC	LF_FAR
  09C0'   7D                    	MOV	A,L
  09C1'   32 0C9F'              	STA	LYND		; (0: the line right under it only ever scrolls)
  09C4'   C9                    	RET
                                
                                ;HTBLD -- for the scrolls, which count screen rows: the rows each line about
                                ; the cursor takes, in file order, in HTAB[0..HTN).
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  09C5'                         HTBLD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09C5'   79                    	MOV	A,C
  09C6'   32 0CA2'              	STA	HTLIM
  09C9'   AF                    	XRA	A
  09CA'   32 0000*              	STA	HTN
  09CD'   32 0000*              	STA	HTEOF
  09D0'   32 0000*              	STA	HTBOF
  09D3'   68                    	MOV	L,B
  09D4'   67                    	MOV	H,A
  09D5'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  09D8'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  09D9'   E5                    	PUSH	H
  09DA'   CD 07AF'              	CALL	ISBOF
  09DD'   C2 09E4'              	JNZ	HB_1
  09E0'   3C                    	INR	A
  09E1'   32 0000*              	STA	HTBOF
  09E4'                         HB_1:
  09E4'   E1                    	POP	H
  09E5'   E5                    	PUSH	H
  09E6'   CD 093C'              	CALL	G2P		; HL = the bytes from there to the cursor
  09E9'   44                    	MOV	B,H
  09EA'   4D                    	MOV	C,L
  09EB'   E1                    	POP	H
  09EC'   F1                    	POP	PSW
  09ED'   D2 09F7'              	JNC	HB_AB
  09F0'   3A 0000*              	LDA	HTBOF
  09F3'   B7                    	ORA	A
  09F4'   CC 0943'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  09F7'                         HB_AB:
  09F7'   CD 0943'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  09FA'   D2 0A1D'              	JNC	HB_CU
  09FD'   E5                    	PUSH	H
  09FE'   C5                    	PUSH	B
  09FF'   EB                    	XCHG
  0A00'   CD 04CC'              	CALL	XTRA		; BC = its rows past the first
  0A03'   78                    	MOV	A,B
  0A04'   B7                    	ORA	A
  0A05'   C2 0A12'              	JNZ	HB_TA
  0A08'   3A 0C6F'              	LDA	NEDIT
  0A0B'   3D                    	DCR	A
  0A0C'   B9                    	CMP	C		; CY iff more rows than the screen has
  0A0D'   79                    	MOV	A,C
  0A0E'   3C                    	INR	A
  0A0F'   D2 0A15'              	JNC	HB_PA
  0A12'                         HB_TA:
  0A12'   3A 0C6F'              	LDA	NEDIT
  0A15'                         HB_PA:
  0A15'   CD 0A5A'              	CALL	HTPUT
  0A18'   C1                    	POP	B
  0A19'   E1                    	POP	H
  0A1A'   C3 09F7'              	JMP	HB_AB
  0A1D'                         HB_CU:
  0A1D'   3A 0000*              	LDA	HTN
  0A20'   32 0000*              	STA	HTCUR
  0A23'   CD 08AA'              	CALL	LCROW		; the cursor's own line: D = its last row
  0A26'   DA 0A57'              	JC	HB_TL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A29'   FA 0A4C'              	JM	HB_LS		; the text ends with it
  0A2C'                         HB_PT:
  0A2C'   7A                    	MOV	A,D
  0A2D'   3C                    	INR	A
  0A2E'   CD 0A5A'              	CALL	HTPUT
  0A31'   47                    	MOV	B,A
  0A32'   3A 0CA2'              	LDA	HTLIM
  0A35'   90                    	SUB	B
  0A36'   32 0CA2'              	STA	HTLIM
  0A39'   D8                    	RC
  0A3A'   C8                    	RZ			; rows enough
  0A3B'   CD 08DF'              	CALL	LM_NX		; the next line down
  0A3E'   CA 0A2C'              	JZ	HB_PT
  0A41'   F2 0A57'              	JP	HB_TL		; one taller than the screen
  0A44'   3A 0CA4'              	LDA	LYLAST		; the text ended: was that a line?
  0A47'   FE 0A                 	CPI	LF
  0A49'   CA 0A51'              	JZ	HB_EF
  0A4C'                         HB_LS:
  0A4C'   7A                    	MOV	A,D
  0A4D'   3C                    	INR	A
  0A4E'   CD 0A5A'              	CALL	HTPUT
  0A51'                         HB_EF:
  0A51'   3E 01                 	MVI	A,1
  0A53'   32 0000*              	STA	HTEOF
  0A56'   C9                    	RET
  0A57'                         HB_TL:
  0A57'   3A 0C6F'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0A5A'                         HTPUT:
  0A5A'   E5                    	PUSH	H
  0A5B'   D5                    	PUSH	D
  0A5C'   21 0000*              	LXI	H,HTN
  0A5F'   5E                    	MOV	E,M
  0A60'   1C                    	INR	E
  0A61'   CA 0A6D'              	JZ	HP_1
  0A64'   73                    	MOV	M,E
  0A65'   1D                    	DCR	E
  0A66'   16 00                 	MVI	D,0
  0A68'   21 0000*              	LXI	H,HTAB
  0A6B'   19                    	DAD	D
  0A6C'   77                    	MOV	M,A
  0A6D'                         HP_1:
  0A6D'   D1                    	POP	D
  0A6E'   E1                    	POP	H
  0A6F'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0A70'                         TABCUR:
  0A70'   3A 0000*              	LDA	EDMODE
  0A73'   FE 00                 	CPI	EM_CMD
  0A75'   C0                    	RNZ
  0A76'   2A 0000*              	LHLD	TXTEND
  0A79'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A7A'   2A 0000*              	LHLD	GAPEND
  0A7D'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0A80'   C8                    	RZ
  0A81'   7E                    	MOV	A,M
  0A82'   FE 09                 	CPI	TAB
  0A84'   C0                    	RNZ
  0A85'   2A 0C8A'              	LHLD	CURDCL
  0A88'   7D                    	MOV	A,L
  0A89'   F6 07                 	ORI	TABWID-1
  0A8B'   6F                    	MOV	L,A
  0A8C'   22 0C8A'              	SHLD	CURDCL
  0A8F'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0A90'                         RDTOP:
  0A90'   2A 0C86'              	LHLD	TOPLEN
  0A93'   C3 0A99'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0A96'                         RDBOL:
  0A96'   2A 0C88'              	LHLD	CBOL
  0A99'                         RDSET:
  0A99'   22 0CAC'              	SHLD	RDN
  0A9C'   EB                    	XCHG
  0A9D'   2A 0000*              	LHLD	GAPBEG
  0AA0'   CD 0000*              	CALL	SUBHD
  0AA3'   22 0CAA'              	SHLD	RDP
  0AA6'   AF                    	XRA	A
  0AA7'   32 0CB2'              	STA	RDSEG
  0AAA'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0AAB'                         RDCH:
  0AAB'   C5                    	PUSH	B
  0AAC'   D5                    	PUSH	D
  0AAD'   E5                    	PUSH	H
  0AAE'   2A 0CAC'              	LHLD	RDN		; before-gap bytes left?
  0AB1'   7C                    	MOV	A,H
  0AB2'   B5                    	ORA	L
  0AB3'   CA 0AC6'              	JZ	RDC_AF
  0AB6'   2B                    	DCX	H
  0AB7'   22 0CAC'              	SHLD	RDN
  0ABA'   2A 0CAA'              	LHLD	RDP
  0ABD'   7E                    	MOV	A,M
  0ABE'   23                    	INX	H
  0ABF'   22 0CAA'              	SHLD	RDP
  0AC2'   B7                    	ORA	A		; CY=0
  0AC3'   C3 0AEA'              	JMP	RDC_RT
  0AC6'                         RDC_AF:
  0AC6'   3A 0CB2'              	LDA	RDSEG
  0AC9'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0ACA'   C2 0AD7'              	JNZ	RDC_NX
  0ACD'   3C                    	INR	A		; first after-gap byte: start RGET
  0ACE'   32 0CB2'              	STA	RDSEG
  0AD1'   CD 0000*              	CALL	RGET0
  0AD4'   C3 0ADF'              	JMP	RDC_GT
  0AD7'                         RDC_NX:
  0AD7'   2A 0CB0'              	LHLD	RDBC
  0ADA'   44                    	MOV	B,H
  0ADB'   4D                    	MOV	C,L
  0ADC'   2A 0CAE'              	LHLD	RDHL
  0ADF'                         RDC_GT:
  0ADF'   CD 0000*              	CALL	RDGET
  0AE2'   22 0CAE'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0AE5'   60                    	MOV	H,B
  0AE6'   69                    	MOV	L,C
  0AE7'   22 0CB0'              	SHLD	RDBC
  0AEA'                         RDC_RT:
  0AEA'   E1                    	POP	H
  0AEB'   D1                    	POP	D
  0AEC'   C1                    	POP	B
  0AED'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0AEE'                         RDSKIP:
  0AEE'   B7                    	ORA	A
  0AEF'   C8                    	RZ
  0AF0'   32 0CB3'              	STA	SKPN
  0AF3'                         RSK_LP:
  0AF3'   CD 0AAB'              	CALL	RDCH
  0AF6'   D8                    	RC
  0AF7'   FE 0A                 	CPI	LF
  0AF9'   C2 0AF3'              	JNZ	RSK_LP
  0AFC'   3A 0CB3'              	LDA	SKPN
  0AFF'   3D                    	DCR	A
  0B00'   32 0CB3'              	STA	SKPN
  0B03'   C2 0AF3'              	JNZ	RSK_LP
  0B06'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0B07'                         PSKIP:
  0B07'   3A 0C6E'              	LDA	NCOLS
  0B0A'   CD 0B39'              	CALL	MULHA		; HL = the cells to pass over
  0B0D'   EB                    	XCHG
  0B0E'   21 0000               	LXI	H,0
  0B11'   22 0CB6'              	SHLD	PSKN
  0B14'                         PS_LP:
  0B14'   7A                    	MOV	A,D
  0B15'   B3                    	ORA	E
  0B16'   CA 0B6D'              	JZ	PR_LP
  0B19'   CD 0AAB'              	CALL	RDCH
  0B1C'   FE 0D                 	CPI	CR
  0B1E'   CA 0B14'              	JZ	PS_LP
  0B21'   0E 01                 	MVI	C,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B23'   FE 09                 	CPI	TAB
  0B25'   CC 0B43'              	CZ	TABN
  0B28'                         PS_CL:
  0B28'   7A                    	MOV	A,D
  0B29'   B3                    	ORA	E
  0B2A'   CA 0B87'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0B2D'   1B                    	DCX	D
  0B2E'   21 0CB8'              	LXI	H,DCOL
  0B31'   34                    	INR	M
  0B32'   0D                    	DCR	C
  0B33'   C2 0B28'              	JNZ	PS_CL
  0B36'   C3 0B14'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
