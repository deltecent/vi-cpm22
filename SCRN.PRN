	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the cheap paints the
                                ; RINTENT asks for, the RPOLL repaint abort, and the message row.  A cheap
                                ; paint is counted in ROWS: the rows the screen gave up or gained at the top,
                                ; the rows the edit at the cursor had and has.  The terminal moves what stands
                                ; (IL/DL in a scroll region) and only the rows that are new are sent.
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	PGTOPM			; PAGE.MAC -- times the pager moved the text
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	LNALL			; CMD.MAC -- 1 = an R_LINE from its first row
                                	EXTRN	DCHN			; CMD.MAC -- cells an R_DCH deletes
                                	EXTRN	DCHBS			; CMD.MAC -- 1 = left of the cursor
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0FE2'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0FF0'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0FD1'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PRNG -- paint the edit rows from B up to (not including) C, counted from 0:
                                ; each cleared (ESC[K), the text on as many rows as its lines take, the fill
                                ; char on the rows past it.  The row table says which line row B is in and
                                ; how many of that line's rows are above it, and the reader is put there.
                                ; The one row a line may own with nothing on it -- the cursor's, past text
                                ; that filled the row above (LYXE) -- is cleared in its turn.  An empty range
                                ; sends nothing.  During a full repaint (FORCEF) a key that is waiting
                                ; abandons the frame, and the return from here is SCDRAW's own.
  0098'                         PRNG:
  0098'   78                    	MOV	A,B
  0099'   B9                    	CMP	C
  009A'   D0                    	RNC
  009B'   32 1071'              	STA	PROWN
  009E'   79                    	MOV	A,C
  009F'   32 1039'              	STA	PEND
  00A2'   3A 101D'              	LDA	TXEND
  00A5'   3D                    	DCR	A
  00A6'   B8                    	CMP	B		; CY iff row B is past the text
  00A7'   DA 00E8'              	JC	PG_GO
  00AA'   C5                    	PUSH	B
  00AB'   CD 0DEB'              	CALL	RDTOP
  00AE'   CD 056D'              	CALL	HTTOP		; HL -> the top line's entry
  00B1'   C1                    	POP	B
  00B2'   11 0000               	LXI	D,0		; D = the rows above the line, E = the lines
  00B5'                         PG_F:
  00B5'   7A                    	MOV	A,D
  00B6'   86                    	ADD	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00B7'   B8                    	CMP	B
  00B8'   DA 00BE'              	JC	PG_N
  00BB'   C2 00C4'              	JNZ	PG_H		; row B is one of this line's
  00BE'                         PG_N:
  00BE'   57                    	MOV	D,A
  00BF'   1C                    	INR	E
  00C0'   23                    	INX	H
  00C1'   C3 00B5'              	JMP	PG_F
  00C4'                         PG_H:
  00C4'   78                    	MOV	A,B
  00C5'   92                    	SUB	D
  00C6'   4F                    	MOV	C,A
  00C7'   06 00                 	MVI	B,0		; BC = the rows of it above row B ...
  00C9'   7B                    	MOV	A,E
  00CA'   21 0000               	LXI	H,0
  00CD'   B7                    	ORA	A
  00CE'   C2 00D4'              	JNZ	PG_K
  00D1'   2A 1019'              	LHLD	SKIPR		; ... and, for the top line, those off the top
  00D4'                         PG_K:
  00D4'   09                    	DAD	B
  00D5'   22 1072'              	SHLD	PSKN
  00D8'   21 1017'              	LXI	H,WINROW	; at the cursor's line or under it: read on from
  00DB'   BE                    	CMP	M		;   that line, not down the screen to it
  00DC'   DA 00E5'              	JC	PG_S
  00DF'   96                    	SUB	M
  00E0'   F5                    	PUSH	PSW
  00E1'   CD 0DF1'              	CALL	RDBOL
  00E4'   F1                    	POP	PSW
  00E5'                         PG_S:
  00E5'   CD 0E49'              	CALL	RDSKIP		; the reader at that line (A lines down)
  00E8'                         PG_GO:
  00E8'   3A 1071'              	LDA	PROWN
  00EB'   3C                    	INR	A
  00EC'   47                    	MOV	B,A
  00ED'   0E 01                 	MVI	C,1
  00EF'   CD 0064'              	CALL	GOTOXY
  00F2'                         PG_LP:
  00F2'   3A 1045'              	LDA	FORCEF
  00F5'   B7                    	ORA	A
  00F6'   CA 0102'              	JZ	PG_P
  00F9'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abandon the repaint
  00FC'   B7                    	ORA	A
  00FD'   CA 0102'              	JZ	PG_P
  0100'   E1                    	POP	H		; (the cursor stays hidden: no flash in a burst)
  0101'   C9                    	RET
  0102'                         PG_P:
  0102'   CD 0092'              	CALL	CEKL
  0105'   CD 0EFC'              	CALL	PAINTR
  0108'   3A 1060'              	LDA	LYXE
  010B'   B7                    	ORA	A
  010C'   CA 0121'              	JZ	PG_1
  010F'   3A 101B'              	LDA	SROW		; was that the row over the cursor's own?
  0112'   D6 02                 	SUI	2
  0114'   21 1071'              	LXI	H,PROWN
  0117'   BE                    	CMP	M
  0118'   C2 0121'              	JNZ	PG_1
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  011B'   CD 0131'              	CALL	PT_NL
  011E'   CD 0092'              	CALL	CEKL
  0121'                         PG_1:
  0121'   3A 1039'              	LDA	PEND
  0124'   3D                    	DCR	A
  0125'   21 1071'              	LXI	H,PROWN
  0128'   BE                    	CMP	M
  0129'   C8                    	RZ
  012A'   D8                    	RC
  012B'   CD 0131'              	CALL	PT_NL
  012E'   C3 00F2'              	JMP	PG_LP
                                ;PT_NL -- CR, LF: down a row, and count it.
  0131'                         PT_NL:
  0131'   3E 0D                 	MVI	A,CR
  0133'   CD 0018'              	CALL	OUTCH
  0136'   3E 0A                 	MVI	A,LF
  0138'   CD 0018'              	CALL	OUTCH
  013B'   21 1071'              	LXI	H,PROWN
  013E'   34                    	INR	M
  013F'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  0140'                         GOTOP:
  0140'   06 01                 	MVI	B,1
  0142'   0E 01                 	MVI	C,1
  0144'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  0147'                         SCINIT:
  0147'   21 0000               	LXI	H,0
  014A'   22 1017'              	SHLD	WINROW
  014D'   21 0FC2'              	LXI	H,SPROBE
  0150'   CD 0025'              	CALL	OUTSTR
  0153'   CD 019E'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  0156'   3A 1014'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  0159'   3D                    	DCR	A
  015A'   32 1016'              	STA	NEDIT
  015D'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  015E'                         RDB:
  015E'   21 0000               	LXI	H,0
  0161'                         RDB_LP:
  0161'   E5                    	PUSH	H
  0162'   CD 0000'              	CALL	BCONST
  0165'   E1                    	POP	H
  0166'   B7                    	ORA	A
  0167'   C2 0172'              	JNZ	RDB_GO
  016A'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  016B'   7C                    	MOV	A,H
  016C'   B5                    	ORA	L
  016D'   C2 0161'              	JNZ	RDB_LP
  0170'   37                    	STC			; timeout
  0171'   C9                    	RET
  0172'                         RDB_GO:
  0172'   CD 0008'              	CALL	BCONIN
  0175'   B7                    	ORA	A		; CY=0, A=byte
  0176'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  0177'                         RDNUM:
  0177'   11 0000               	LXI	D,0
  017A'                         RN_LP:
  017A'   D5                    	PUSH	D
  017B'   CD 015E'              	CALL	RDB
  017E'   D1                    	POP	D
  017F'   D8                    	RC
  0180'   FE 30                 	CPI	'0'
  0182'   DA 019C'              	JC	RN_DN
  0185'   FE 3A                 	CPI	'9'+1
  0187'   D2 019C'              	JNC	RN_DN
  018A'   D6 30                 	SUI	'0'
  018C'   4F                    	MOV	C,A		; C = this digit
  018D'   62                    	MOV	H,D		; HL = value
  018E'   6B                    	MOV	L,E
  018F'   29                    	DAD	H		; 2x
  0190'   54                    	MOV	D,H
  0191'   5D                    	MOV	E,L		; DE = 2x
  0192'   29                    	DAD	H		; 4x
  0193'   29                    	DAD	H		; 8x
  0194'   19                    	DAD	D		; 10x
  0195'   06 00                 	MVI	B,0		; BC = digit
  0197'   09                    	DAD	B		; HL = 10x + digit
  0198'   EB                    	XCHG			; DE = new value
  0199'   C3 017A'              	JMP	RN_LP
  019C'                         RN_DN:
  019C'   B7                    	ORA	A		; CY=0, A = terminator
  019D'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  019E'                         RDNUMS:
  019E'   CD 015E'              	CALL	RDB
  01A1'   D8                    	RC
  01A2'   FE 1B                 	CPI	ESC
  01A4'   C0                    	RNZ			; not what a DSR reply looks like
  01A5'   CD 015E'              	CALL	RDB
  01A8'   D8                    	RC
  01A9'   FE 5B                 	CPI	'['
  01AB'   C0                    	RNZ			; not what a DSR reply looks like
  01AC'   CD 0177'              	CALL	RDNUM		; DE = rows
  01AF'   D8                    	RC
  01B0'   FE 3B                 	CPI	';'
  01B2'   C0                    	RNZ			; not what a DSR reply looks like
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B3'   EB                    	XCHG
  01B4'   22 1076'              	SHLD	TMPR
  01B7'   CD 0177'              	CALL	RDNUM		; DE = cols
  01BA'   D8                    	RC
  01BB'   FE 52                 	CPI	'R'
  01BD'   C0                    	RNZ			; not what a DSR reply looks like
  01BE'   EB                    	XCHG
  01BF'   22 1078'              	SHLD	TMPC
  01C2'   2A 1076'              	LHLD	TMPR		; rows -> clamp [24,200]
  01C5'   06 18                 	MVI	B,24
  01C7'   0E C8                 	MVI	C,200
  01C9'   CD 01DD'              	CALL	CLAMP
  01CC'   32 1014'              	STA	NROWS
  01CF'   2A 1078'              	LHLD	TMPC		; cols -> clamp [80,132]
  01D2'   06 50                 	MVI	B,80
  01D4'   0E 84                 	MVI	C,132
  01D6'   CD 01DD'              	CALL	CLAMP
  01D9'   32 1015'              	STA	NCOLS
  01DC'                         RS_BAD:
  01DC'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  01DD'                         CLAMP:
  01DD'   7C                    	MOV	A,H
  01DE'   B7                    	ORA	A
  01DF'   C2 01F0'              	JNZ	CLP_MAX		; value > 255 -> max
  01E2'   7D                    	MOV	A,L
  01E3'   B8                    	CMP	B
  01E4'   DA 01EE'              	JC	CLP_MIN		; value < min
  01E7'   79                    	MOV	A,C
  01E8'   BD                    	CMP	L		; CY iff max < value
  01E9'   DA 01F0'              	JC	CLP_MAX
  01EC'   7D                    	MOV	A,L
  01ED'   C9                    	RET
  01EE'                         CLP_MIN:
  01EE'   78                    	MOV	A,B
  01EF'   C9                    	RET
  01F0'                         CLP_MAX:
  01F0'   79                    	MOV	A,C
  01F1'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- keep what is on the screen: the frame's facts (WINROW .. NXTR) are
                                ; copied to the OLD ones.  The main loop calls this after reading a key and
                                ; before dispatch, so SCDRAW can tell what the key changed.
  01F2'                         SCPRE:
  01F2'   21 1017'              	LXI	H,WINROW
  01F5'   11 1025'              	LXI	D,OLDWR
  01F8'   06 0E                 	MVI	B,FRMLEN
  01FA'                         SP_LP:
  01FA'   7E                    	MOV	A,M
  01FB'   12                    	STAX	D
  01FC'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01FD'   13                    	INX	D
  01FE'   05                    	DCR	B
  01FF'   C2 01FA'              	JNZ	SP_LP
  0202'   C9                    	RET
                                
                                ;SCDRAW -- lay the screen out and paint it the cheapest way that is right.
                                ; A cheap paint is two changes, each "this many rows were here, that many
                                ; are": one at the top row (the screen gave rows up, OPN, or gained them,
                                ; OPM, as the text scrolled) and one at the cursor (EDR: EDA rows before, EDB
                                ; now, to be drawn from row EDP).  The terminal moves the rows that stand,
                                ; the rows that are new are sent, and so is whatever the move left wrong at
                                ; the bottom.  When nothing moves and nothing is new, only the cursor goes.
                                ; Whatever does not fit that is a full repaint.
  0203'                         SCDRAW:
  0203'   CD 05FC'              	CALL	LAYOUT		; (no output)
  0206'   CD 05B5'              	CALL	CURSC		; SROW/SCOL
  0209'   3A 1045'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  020C'   B7                    	ORA	A
  020D'   C2 04E8'              	JNZ	SCFULL
  0210'   2A 1027'              	LHLD	OLDSK		; the top line starts on another of its rows:
  0213'   EB                    	XCHG			;   every row on the screen is a different one
  0214'   2A 1019'              	LHLD	SKIPR
  0217'   CD 0000*              	CALL	CMP16
  021A'   C2 04E8'              	JNZ	SCFULL
  021D'   21 0000               	LXI	H,0
  0220'   22 1033'              	SHLD	OPN		; (and OPM)
  0223'   3A 1020'              	LDA	LYABV
  0226'   47                    	MOV	B,A		; B = the edit's first row: the cursor line's
  0227'   3A 1030'              	LDA	OLDCS		; C = the first row of it that can have changed:
  022A'   21 1022'              	LXI	H,CSRAW		;   the one the cursor was on, or the one it is
  022D'   BE                    	CMP	M
  022E'   DA 0232'              	JC	SD_1
  0231'   7E                    	MOV	A,M
  0232'                         SD_1:
  0232'   4F                    	MOV	C,A
  0233'   21 0000*              	LXI	H,LNALL		; ... or the line's first, when the change may
  0236'   7E                    	MOV	A,M		;   lie before both ('u')
  0237'   36 00                 	MVI	M,0
  0239'   B7                    	ORA	A
  023A'   79                    	MOV	A,C
  023B'   CA 023F'              	JZ	SD_1A
  023E'   AF                    	XRA	A
  023F'                         SD_1A:
  023F'   80                    	ADD	B
  0240'   4F                    	MOV	C,A
  0241'   2A 1031'              	LHLD	OLDCR		; E = the rows the line had (H: the line's under)
  0244'   5D                    	MOV	E,L
  0245'   3A 1023'              	LDA	LYTSH
  0248'   57                    	MOV	D,A		; D = the rows it has
  0249'   3A 0000*              	LDA	RINTENT
  024C'   B7                    	ORA	A
  024D'   CA 04E8'              	JZ	SCFULL		; R_FULL
  0250'   FE 05                 	CPI	R_ILIN
  0252'   CA 0285'              	JZ	SD_IL
  0255'   E5                    	PUSH	H
  0256'   2A 1051'              	LHLD	LYDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0259'   7C                    	MOV	A,H
  025A'   B5                    	ORA	L
  025B'   E1                    	POP	H
  025C'   3A 0000*              	LDA	RINTENT		; (keeps the flags)
  025F'   C2 02D0'              	JNZ	SD_OL		; the cursor is on another line
  0262'   FE 01                 	CPI	R_MOVE
  0264'   C2 0269'              	JNZ	SD_2
  0267'   0E FF                 	MVI	C,0FFH		; a move: none of the line to draw
  0269'                         SD_2:
  0269'   FE 03                 	CPI	R_DLIN
  026B'   C2 0270'              	JNZ	SD_3
  026E'   16 00                 	MVI	D,0		; the line went
  0270'                         SD_3:
  0270'   FE 06                 	CPI	R_JOIN
  0272'   C2 0278'              	JNZ	SD_AN
  0275'   7B                    	MOV	A,E		; the line under it went into it
  0276'   84                    	ADD	H
  0277'   5F                    	MOV	E,A
  0278'                         SD_AN:
  0278'   3A 102E'              	LDA	OLDAB		; where the edit starts was that much lower: the
  027B'   90                    	SUB	B		;   rows the screen gave up at the top.  Higher,
  027C'   DA 04E8'              	JC	SCFULL		;   and it is no paint of these
  027F'   32 1033'              	STA	OPN
  0282'   C3 0317'              	JMP	SD_GO
                                
                                	;--- R_ILIN: ILN lines opened at the cursor ---
  0285'                         SD_IL:
  0285'   2A 1051'              	LHLD	LYDLT
  0288'   7C                    	MOV	A,H
  0289'   B7                    	ORA	A
  028A'   C2 04E8'              	JNZ	SCFULL
  028D'   48                    	MOV	C,B		; drawn from the cursor's row, the first opened
  028E'   57                    	MOV	D,A		; (no rows yet)
  028F'   5F                    	MOV	E,A		; (none were there)
  0290'   B5                    	ORA	L
  0291'   CA 02BA'              	JZ	SI_2		; opened where the cursor's line was: 'O', 'P'
  0294'   3D                    	DCR	A
  0295'   C2 04E8'              	JNZ	SCFULL
  0298'   3A 1017'              	LDA	WINROW		; opened under it: it is the line above now, and
  029B'   B7                    	ORA	A		;   has to be on the screen
  029C'   CA 04E8'              	JZ	SCFULL
  029F'   3A 0000*              	LDA	HTCUR
  02A2'   3D                    	DCR	A
  02A3'   CD 0B4F'              	CALL	HTE
  02A6'   56                    	MOV	D,M		; D = that line's rows now
  02A7'   78                    	MOV	A,B
  02A8'   92                    	SUB	D
  02A9'   47                    	MOV	B,A		; the edit starts with it
  02AA'   3A 1031'              	LDA	OLDCR
  02AD'   5F                    	MOV	E,A
  02AE'   3A 0000*              	LDA	ILABOV		; text came off it: drawn from the row the
  02B1'   B7                    	ORA	A		;   cursor was on
  02B2'   CA 02BA'              	JZ	SI_2
  02B5'   3A 1030'              	LDA	OLDCS
  02B8'   80                    	ADD	B
  02B9'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02BA'                         SI_2:
  02BA'   C5                    	PUSH	B
  02BB'   D5                    	PUSH	D
  02BC'   3A 0000*              	LDA	ILN
  02BF'   47                    	MOV	B,A
  02C0'   3A 0000*              	LDA	HTCUR
  02C3'   CD 057B'              	CALL	SUMX		; A = the rows the opened lines take
  02C6'   D1                    	POP	D
  02C7'   C1                    	POP	B
  02C8'   DA 04E8'              	JC	SCFULL		; (more than the screen shows)
  02CB'   82                    	ADD	D
  02CC'   57                    	MOV	D,A
  02CD'   C3 0278'              	JMP	SD_AN
                                
                                	;--- a move to another line: the text scrolled SCRLN lines ---
  02D0'                         SD_OL:
  02D0'   FE 01                 	CPI	R_MOVE
  02D2'   C2 04E8'              	JNZ	SCFULL
  02D5'   2A 103B'              	LHLD	SCRLN
  02D8'   7C                    	MOV	A,H
  02D9'   B5                    	ORA	L
  02DA'   CA 0FA2'              	JZ	SCURS		; it stood still: the cursor alone
  02DD'   7C                    	MOV	A,H
  02DE'   B7                    	ORA	A
  02DF'   CA 02F6'              	JZ	SO_UP
  02E2'   3C                    	INR	A
  02E3'   C2 04E8'              	JNZ	SCFULL
  02E6'   95                    	SUB	L		; down: the new lines at the top, and their rows
  02E7'   CA 04E8'              	JZ	SCFULL
  02EA'   CD 0577'              	CALL	SUMT
  02ED'   DA 04E8'              	JC	SCFULL
  02F0'   32 1034'              	STA	OPM
  02F3'   C3 0312'              	JMP	SO_GO
  02F6'                         SO_UP:
  02F6'   3A 102D'              	LDA	OLDBOT		; up: the last line that showed is that many
  02F9'   95                    	SUB	L		;   lines higher.  The row after it was OLDTX,
  02FA'   DA 04E8'              	JC	SCFULL		;   and is the rows down to it now
  02FD'   3C                    	INR	A
  02FE'   CD 0577'              	CALL	SUMT
  0301'   DA 04E8'              	JC	SCFULL
  0304'   47                    	MOV	B,A
  0305'   3A 102B'              	LDA	OLDTX
  0308'   90                    	SUB	B
  0309'   DA 04E8'              	JC	SCFULL
  030C'   CA 04E8'              	JZ	SCFULL
  030F'   32 1033'              	STA	OPN
  0312'                         SO_GO:
  0312'   11 0000               	LXI	D,0		; no edit
  0315'   0E FF                 	MVI	C,0FFH
                                
                                	;--- B = the edit's first row, C = the first to draw, D = its rows
                                	;    now, E = its rows before ---
  0317'                         SD_GO:
  0317'   78                    	MOV	A,B
  0318'   32 1037'              	STA	EDR
  031B'   82                    	ADD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  031C'   47                    	MOV	B,A		; B = the row after its last
  031D'   3A 1016'              	LDA	NEDIT
  0320'   B8                    	CMP	B
  0321'   DA 04E8'              	JC	SCFULL		; (it runs off the screen)
  0324'   79                    	MOV	A,C
  0325'   32 1038'              	STA	EDP
  0328'   EB                    	XCHG
  0329'   22 1035'              	SHLD	EDA		; (and EDB)
  032C'   EB                    	XCHG
  032D'   2A 1033'              	LHLD	OPN
  0330'   7C                    	MOV	A,H
  0331'   B5                    	ORA	L
  0332'   C2 0351'              	JNZ	SD_PT
  0335'   7A                    	MOV	A,D
  0336'   BB                    	CMP	E
  0337'   C2 0351'              	JNZ	SD_PT
  033A'   79                    	MOV	A,C		; nothing moves.  Nothing to draw either: the
  033B'   B8                    	CMP	B		;   cursor alone
  033C'   D2 0FA2'              	JNC	SCURS
  033F'   3C                    	INR	A
  0340'   B8                    	CMP	B
  0341'   C2 0351'              	JNZ	SD_PT
  0344'   3A 0000*              	LDA	RINTENT		; the line's last row, the cursor on it before
  0347'   FE 04                 	CPI	R_ICH		;   and after: a cell opened or closed there is
  0349'   CA 03F6'              	JZ	SC_ICH		;   the whole of it
  034C'   FE 07                 	CPI	R_DCH
  034E'   CA 0432'              	JZ	SC_DCH
  0351'                         SD_PT:
  0351'   2A 1019'              	LHLD	SKIPR		; ('<<<' on the top row is not theirs to keep)
  0354'   7C                    	MOV	A,H
  0355'   B5                    	ORA	L
  0356'   C2 04E8'              	JNZ	SCFULL
  0359'   CD 0080'              	CALL	CHIDE
  035C'   2A 1033'              	LHLD	OPN
  035F'   EB                    	XCHG
  0360'   2A 1035'              	LHLD	EDA
  0363'   7A                    	MOV	A,D
  0364'   B3                    	ORA	E
  0365'   C2 036D'              	JNZ	SD_SH
  0368'   7C                    	MOV	A,H
  0369'   BD                    	CMP	L
  036A'   CA 0385'              	JZ	SD_NS
  036D'                         SD_SH:
  036D'   CD 05A4'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0370'   2A 1033'              	LHLD	OPN
  0373'   06 00                 	MVI	B,0
  0375'   CD 0542'              	CALL	SHFT
  0378'   2A 1035'              	LHLD	EDA
  037B'   3A 1037'              	LDA	EDR
  037E'   47                    	MOV	B,A
  037F'   CD 0542'              	CALL	SHFT
  0382'   CD 0086'              	CALL	CRGRS
  0385'                         SD_NS:
  0385'   06 00                 	MVI	B,0
  0387'   3A 1034'              	LDA	OPM
  038A'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  038B'   CD 0098'              	CALL	PRNG		; the rows opened at the top
  038E'   2A 1035'              	LHLD	EDA
  0391'   3A 1037'              	LDA	EDR
  0394'   84                    	ADD	H
  0395'   4F                    	MOV	C,A
  0396'   3A 1038'              	LDA	EDP
  0399'   47                    	MOV	B,A
  039A'   CD 0098'              	CALL	PRNG		; the edit's own
                                	;--- the bottom.  The rows that were good to the end of the screen
                                	;    (all of them, or as far as the '@' rows) moved with the text; what
                                	;    lies between where they end now and where good rows should end is
                                	;    drawn, and so are the rows a move up left bare ---
  039D'   2A 102B'              	LHLD	OLDTX
  03A0'   CD 059B'              	CALL	TEV
  03A3'   47                    	MOV	B,A
  03A4'   2A 101D'              	LHLD	TXEND
  03A7'   CD 059B'              	CALL	TEV
  03AA'   4F                    	MOV	C,A
  03AB'   2A 1033'              	LHLD	OPN
  03AE'   EB                    	XCHG			; E = OPN, D = OPM
  03AF'   2A 1035'              	LHLD	EDA		; L = EDA, H = EDB
  03B2'   7A                    	MOV	A,D
  03B3'   84                    	ADD	H
  03B4'   57                    	MOV	D,A		; D = the rows that came
  03B5'   7B                    	MOV	A,E
  03B6'   85                    	ADD	L
  03B7'   92                    	SUB	D		; A = the rows that went, less those
  03B8'   21 1016'              	LXI	H,NEDIT
  03BB'   5E                    	MOV	E,M
  03BC'   DA 03CC'              	JC	SB_DN
  03BF'   57                    	MOV	D,A		; the text under them moved up D rows
  03C0'   7B                    	MOV	A,E
  03C1'   92                    	SUB	D
  03C2'   5F                    	MOV	E,A		; E = the first row that left bare
  03C3'   78                    	MOV	A,B
  03C4'   92                    	SUB	D
  03C5'   D2 03D7'              	JNC	SB_1
  03C8'   AF                    	XRA	A
  03C9'   C3 03D7'              	JMP	SB_1
  03CC'                         SB_DN:
  03CC'   2F                    	CMA
  03CD'   3C                    	INR	A		; ... or down that many
  03CE'   80                    	ADD	B
  03CF'   DA 03D6'              	JC	SB_0
  03D2'   BB                    	CMP	E
  03D3'   DA 03D7'              	JC	SB_1
  03D6'                         SB_0:
  03D6'   7B                    	MOV	A,E
  03D7'                         SB_1:
  03D7'   B9                    	CMP	C		; A = where the old good rows end now
  03D8'   47                    	MOV	B,A
  03D9'   DA 03DE'              	JC	SB_2
  03DC'   41                    	MOV	B,C
  03DD'   4F                    	MOV	C,A
  03DE'                         SB_2:
  03DE'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  03DF'   D5                    	PUSH	D
  03E0'   CD 0098'              	CALL	PRNG
  03E3'   D1                    	POP	D
  03E4'   C1                    	POP	B
  03E5'   79                    	MOV	A,C
  03E6'   BB                    	CMP	E
  03E7'   D2 03EB'              	JNC	SB_3
  03EA'   7B                    	MOV	A,E
  03EB'                         SB_3:
  03EB'   47                    	MOV	B,A
  03EC'   3A 1016'              	LDA	NEDIT
  03EF'   4F                    	MOV	C,A
  03F0'   CD 0098'              	CALL	PRNG
  03F3'   C3 0FA2'              	JMP	SCURS
                                
                                ;SC_ICH -- R_ICH: a char was typed at the cell the cursor was on, which is
                                ; where the terminal's cursor still is.  ICH (ESC[1@) opens a cell there and
                                ; the char fills it; appended at the row's end (ICHAPP) the cell is blank and
                                ; nothing follows it, so the char alone is the whole frame.  Either way the
                                ; terminal leaves the cursor at SCOL, where insert mode wants it.
                                ; ICHAPP = 2 is 'r': the char took the place of the one under the cursor and
                                ; is under it still, so it is sent and the cursor put back on it.
  03F6'                         SC_ICH:
  03F6'   3A 0000*              	LDA	ICHAPP
  03F9'   FE 03                 	CPI	3
  03FB'   C2 0411'              	JNZ	SC_IC0
  03FE'   16 FF                 	MVI	D,0FFH		; a TAB follows, and went right one
  0400'   3A 101C'              	LDA	SCOL
  0403'   CD 0485'              	CALL	SEGQ
  0406'   2A 0000*              	LHLD	GAPBEG
  0409'   2B                    	DCX	H
  040A'   7E                    	MOV	A,M
  040B'   CD 0018'              	CALL	OUTCH
  040E'   C3 04CB'              	JMP	SEGO
  0411'                         SC_IC0:
  0411'   FE 02                 	CPI	2
  0413'   C2 0420'              	JNZ	SC_IC1
  0416'   2A 0000*              	LHLD	GAPEND
  0419'   7E                    	MOV	A,M
  041A'   CD 0018'              	CALL	OUTCH
  041D'   C3 0FA2'              	JMP	SCURS
  0420'                         SC_IC1:
  0420'   B7                    	ORA	A
  0421'   C2 042A'              	JNZ	SC_ICC
  0424'   21 0FD8'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  0427'   CD 0025'              	CALL	OUTSTR
  042A'                         SC_ICC:
  042A'   2A 0000*              	LHLD	GAPBEG		; the byte typed is right before the gap
  042D'   2B                    	DCX	H
  042E'   7E                    	MOV	A,M
  042F'   C3 0018'              	JMP	OUTCH
                                
                                ;SC_DCH -- R_DCH: DCHN cells went at the cell the cursor was on, which is
                                ; where the terminal's cursor still is: delete-character (ESC[<n>P) there
                                ; draws the rest of the row up, and the cursor is moved only if the delete
                                ; took the line's last char from under it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ; DCHBS: the cell was the one left of the cursor (insert's BS).  The cursor
                                ; steps back onto it first, and is then where it belongs.
  0432'                         SC_DCH:
  0432'   3A 0000*              	LDA	DCHBS
  0435'   E6 02                 	ANI	2
  0437'   CA 0458'              	JZ	SC_DC1
  043A'   3A 0000*              	LDA	DCHN		; a TAB follows, and came left that many
  043D'   57                    	MOV	D,A
  043E'   3A 0000*              	LDA	DCHBS
  0441'   1F                    	RAR
  0442'   3A 102A'              	LDA	OLDSC+1
  0445'   D2 0449'              	JNC	SC_DC0
  0448'   3D                    	DCR	A
  0449'                         SC_DC0:
  0449'   CD 0485'              	CALL	SEGQ
  044C'   3A 0000*              	LDA	DCHBS
  044F'   1F                    	RAR
  0450'   3E 08                 	MVI	A,BS
  0452'   DC 0018'              	CC	OUTCH
  0455'   C3 04CB'              	JMP	SEGO
  0458'                         SC_DC1:
  0458'   3A 0000*              	LDA	DCHBS
  045B'   B7                    	ORA	A
  045C'   3E 08                 	MVI	A,BS
  045E'   C4 0018'              	CNZ	OUTCH
  0461'   21 0FD5'              	LXI	H,SCSI
  0464'   CD 0025'              	CALL	OUTSTR
  0467'   3A 0000*              	LDA	DCHN
  046A'   CD 002F'              	CALL	EMITB
  046D'   3E 50                 	MVI	A,'P'
  046F'   CD 0018'              	CALL	OUTCH
  0472'   3A 0000*              	LDA	DCHBS
  0475'   B7                    	ORA	A
  0476'   C0                    	RNZ
  0477'   2A 1029'              	LHLD	OLDSC
  047A'   EB                    	XCHG
  047B'   2A 101B'              	LHLD	SROW
  047E'   CD 0000*              	CALL	CMP16
  0481'   C8                    	RZ
  0482'   C3 0FA2'              	JMP	SCURS
                                
                                ;SEGQ -- a TAB follows the edit, and nothing past it has moved if it ends
                                ; where it did.  A = the screen column of the first char after the edit, D =
                                ; the cells the TAB came left (0FFH: it went right one).  If it ends there
                                ; still, B = the chars before it and C = the cells it takes now: all there is
                                ; to paint.  If not -- or the chars before it are not plain ones, or it runs
                                ; past the row -- the row is painted, and the return is not taken.
  0485'                         SEGQ:
  0485'   4F                    	MOV	C,A
  0486'   3A 1015'              	LDA	NCOLS
  0489'   91                    	SUB	C
  048A'   3C                    	INR	A
  048B'   47                    	MOV	B,A		; B = the cells from there to the row's end
  048C'   21 101C'              	LXI	H,SCOL
  048F'   3A 104F'              	LDA	CURDCL
  0492'   96                    	SUB	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0493'   81                    	ADD	C
  0494'   5F                    	MOV	E,A		; E = its column in the line (the low bits)
  0495'   2A 0000*              	LHLD	GAPEND
  0498'   0E 00                 	MVI	C,0
  049A'                         SQ_1:
  049A'   7E                    	MOV	A,M
  049B'   FE 09                 	CPI	TAB
  049D'   CA 04B4'              	JZ	SQ_2
  04A0'   FE 20                 	CPI	' '
  04A2'   DA 04B0'              	JC	SQ_NO
  04A5'   FE 7F                 	CPI	DEL
  04A7'   D2 04B0'              	JNC	SQ_NO
  04AA'   23                    	INX	H
  04AB'   1C                    	INR	E
  04AC'   0C                    	INR	C
  04AD'   C2 049A'              	JNZ	SQ_1
  04B0'                         SQ_NO:
  04B0'   E1                    	POP	H
  04B1'   C3 0351'              	JMP	SD_PT
  04B4'                         SQ_2:
  04B4'   7B                    	MOV	A,E
  04B5'   E6 07                 	ANI	7
  04B7'   5F                    	MOV	E,A
  04B8'   82                    	ADD	D		; where it was: under the same stop?
  04B9'   FE 08                 	CPI	8
  04BB'   D2 04B0'              	JNC	SQ_NO
  04BE'   3E 08                 	MVI	A,8
  04C0'   93                    	SUB	E
  04C1'   5F                    	MOV	E,A		; E = the TAB's cells
  04C2'   81                    	ADD	C
  04C3'   3D                    	DCR	A
  04C4'   B8                    	CMP	B
  04C5'   D2 04B0'              	JNC	SQ_NO
  04C8'   41                    	MOV	B,C
  04C9'   4B                    	MOV	C,E
  04CA'   C9                    	RET
                                
                                ;SEGO -- send them: the B chars after the cursor and C blanks, and the cursor
                                ; back where it belongs.
  04CB'                         SEGO:
  04CB'   2A 0000*              	LHLD	GAPEND
  04CE'                         SE_1:
  04CE'   78                    	MOV	A,B
  04CF'   B7                    	ORA	A
  04D0'   CA 04DC'              	JZ	SE_2
  04D3'   7E                    	MOV	A,M
  04D4'   CD 0018'              	CALL	OUTCH
  04D7'   23                    	INX	H
  04D8'   05                    	DCR	B
  04D9'   C3 04CE'              	JMP	SE_1
  04DC'                         SE_2:
  04DC'   3E 20                 	MVI	A,' '
  04DE'   CD 0018'              	CALL	OUTCH
  04E1'   0D                    	DCR	C
  04E2'   C2 04DC'              	JNZ	SE_2
  04E5'   C3 0FA2'              	JMP	SCURS
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place, each cleared with ESC[K; a line
                                ; takes as many rows as it is wide, and the rows past the text show '~' (or
                                ; '@').  No ESC[2J (no blank flash).  Message row last; cursor hidden
                                ; throughout, then addressed and shown.
                                ; FORCEF is set until the frame is whole.  A key that arrives part-way cuts it
                                ; short (PRNG): the pending key is dispatched, and the next SCDRAW repaints in
                                ; FULL even if that key is a pure motion (RENDER.md: an aborted frame stays
                                ; dirty -- no cheap paint over a half-painted screen).
  04E8'                         SCFULL:
  04E8'   CD 0080'              	CALL	CHIDE
  04EB'   3E 01                 	MVI	A,1
  04ED'   32 1045'              	STA	FORCEF
  04F0'   06 00                 	MVI	B,0
  04F2'   3A 1016'              	LDA	NEDIT
  04F5'   4F                    	MOV	C,A
  04F6'   CD 0098'              	CALL	PRNG
  04F9'   CD 0131'              	CALL	PT_NL
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  04FC'   CD 0092'              	CALL	CEKL
  04FF'   2A 1019'              	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
  0502'   7C                    	MOV	A,H		;   over its first cells says so, as vim's does
  0503'   B5                    	ORA	L
  0504'   CA 0510'              	JZ	ROWS_M
  0507'   CD 0140'              	CALL	GOTOP
  050A'   21 1010'              	LXI	H,SSKIP
  050D'   CD 0025'              	CALL	OUTSTR
  0510'                         ROWS_M:
  0510'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  0512'   32 1046'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  0515'   CD 0FA2'              	CALL	SCURS
  0518'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  0519'   32 1045'              	STA	FORCEF
  051C'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  051D'                         EXPRM:
  051D'   F5                    	PUSH	PSW
  051E'   3A 0000*              	LDA	EDMODE
  0521'   32 1046'              	STA	OEDMOD
  0524'   3A 1014'              	LDA	NROWS
  0527'   CD 008C'              	CALL	GOROW1
  052A'   F1                    	POP	PSW
  052B'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  052E'                         EXRUB:
  052E'   21 0534'              	LXI	H,SRUB
  0531'   C3 0025'              	JMP	OUTSTR
  0534'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  0538'                         EXMSG:
  0538'   7E                    	MOV	A,M
  0539'   23                    	INX	H
  053A'   E5                    	PUSH	H
  053B'   CD 051D'              	CALL	EXPRM
  053E'   E1                    	POP	H
  053F'   C3 0025'              	JMP	OUTSTR
                                
                                ;SHFT -- B = a row (from 0), L = the rows that were there, H = the rows that
                                ; are: open rows under those that were (IL), or delete under those that stay
                                ; (DL), so that everything below is where it belongs.  In a scroll region.
  0542'                         SHFT:
  0542'   7C                    	MOV	A,H
  0543'   95                    	SUB	L
  0544'   C8                    	RZ
  0545'   1E 4C                 	MVI	E,'L'
  0547'   57                    	MOV	D,A
  0548'   7D                    	MOV	A,L
  0549'   D2 0552'              	JNC	SH_1
  054C'   7D                    	MOV	A,L
  054D'   94                    	SUB	H
  054E'   57                    	MOV	D,A
  054F'   1E 4D                 	MVI	E,'M'
  0551'   7C                    	MOV	A,H
  0552'                         SH_1:
  0552'   80                    	ADD	B
  0553'   21 1016'              	LXI	H,NEDIT
  0556'   BE                    	CMP	M
  0557'   D0                    	RNC			; (under the last edit row: nothing there to move)
  0558'   3C                    	INR	A
  0559'   47                    	MOV	B,A
  055A'   0E 01                 	MVI	C,1
  055C'   CD 0064'              	CALL	GOTOXY
  055F'   21 0FD5'              	LXI	H,SCSI
  0562'   CD 0025'              	CALL	OUTSTR
  0565'   7A                    	MOV	A,D
  0566'   CD 002F'              	CALL	EMITB
  0569'   7B                    	MOV	A,E
  056A'   C3 0018'              	JMP	OUTCH
                                
                                ;HTTOP -- HL -> the row table's entry for the top line, A = which it is.
  056D'                         HTTOP:
  056D'   3A 0000*              	LDA	HTCUR
  0570'   21 1017'              	LXI	H,WINROW
  0573'   96                    	SUB	M
  0574'   C3 0B4F'              	JMP	HTE
                                
                                ;SUMT -- A = a count of lines from the top one: A = the rows they take.
                                ;SUMX -- the same for the B lines from the table's entry A.
                                ; CY if the table has not so many, or they are a screenful and more.
  0577'                         SUMT:
  0577'   47                    	MOV	B,A
  0578'   CD 056D'              	CALL	HTTOP
  057B'                         SUMX:
  057B'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  057C'   80                    	ADD	B
  057D'   5F                    	MOV	E,A
  057E'   3A 0000*              	LDA	HTN
  0581'   BB                    	CMP	E
  0582'   D8                    	RC
  0583'   79                    	MOV	A,C
  0584'   CD 0B4F'              	CALL	HTE
  0587'   AF                    	XRA	A
  0588'   04                    	INR	B
  0589'                         SM_LP:
  0589'   05                    	DCR	B
  058A'   CA 0593'              	JZ	SM_DN
  058D'   86                    	ADD	M
  058E'   D8                    	RC
  058F'   23                    	INX	H
  0590'   C3 0589'              	JMP	SM_LP
  0593'                         SM_DN:
  0593'   47                    	MOV	B,A
  0594'   3A 1016'              	LDA	NEDIT
  0597'   3D                    	DCR	A
  0598'   B8                    	CMP	B
  0599'   78                    	MOV	A,B
  059A'   C9                    	RET
                                
                                ;TEV -- HL = a frame's TXEND and FILCH: A = the row its good rows end at.
                                ; Rows of '~' are as good as text (they stay '~' wherever they move); rows of
                                ; '@' are not.
  059B'                         TEV:
  059B'   7C                    	MOV	A,H
  059C'   FE 40                 	CPI	'@'
  059E'   7D                    	MOV	A,L
  059F'   C8                    	RZ
  05A0'   3A 1016'              	LDA	NEDIT
  05A3'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  05A4'                         SRGN:
  05A4'   21 0FDD'              	LXI	H,SRGP
  05A7'   CD 0025'              	CALL	OUTSTR
  05AA'   3A 1016'              	LDA	NEDIT
  05AD'   CD 002F'              	CALL	EMITB
  05B0'   3E 72                 	MVI	A,'r'
  05B2'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  05B5'                         CURSC:
  05B5'   2A 104F'              	LHLD	CURDCL
  05B8'   CD 05E7'              	CALL	DIVN		; BC = rows into the line, A = the column
  05BB'   3C                    	INR	A
  05BC'   32 101C'              	STA	SCOL
  05BF'   79                    	MOV	A,C
  05C0'   32 104A'              	STA	CSUB
  05C3'   2A 1019'              	LHLD	SKIPR
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  05C6'   EB                    	XCHG
  05C7'   2A 1020'              	LHLD	LYABV
  05CA'   09                    	DAD	B
  05CB'   23                    	INX	H
  05CC'   CD 0000*              	CALL	SUBHD		; (less the rows of it that are off the top)
  05CF'   7C                    	MOV	A,H		; (never past the edit rows)
  05D0'   B7                    	ORA	A
  05D1'   3A 1016'              	LDA	NEDIT
  05D4'   C2 05DC'              	JNZ	CS_SET
  05D7'   BD                    	CMP	L		; CY iff NEDIT < the row
  05D8'   DA 05DC'              	JC	CS_SET
  05DB'   7D                    	MOV	A,L
  05DC'                         CS_SET:
  05DC'   32 101B'              	STA	SROW
  05DF'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  05E0'                         XTRA:
  05E0'   01 0000               	LXI	B,0
  05E3'   7C                    	MOV	A,H
  05E4'   B5                    	ORA	L
  05E5'   C8                    	RZ			; an empty line is one row
  05E6'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  05E7'                         DIVN:
  05E7'   3A 1015'              	LDA	NCOLS
  05EA'   2F                    	CMA
  05EB'   5F                    	MOV	E,A
  05EC'   16 FF                 	MVI	D,0FFH
  05EE'   13                    	INX	D		; DE = -NCOLS
  05EF'   01 FFFF               	LXI	B,0FFFFH
  05F2'                         DV_LP:
  05F2'   03                    	INX	B
  05F3'   19                    	DAD	D		; CY while NCOLS still went into it
  05F4'   DA 05F2'              	JC	DV_LP
  05F7'   3A 1015'              	LDA	NCOLS
  05FA'   85                    	ADD	L
  05FB'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- where the cursor's line sits on the screen and what the screen
                                ; holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
                                ;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
                                ;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
                                ;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
                                ;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
                                ;        what they show), SCBOT, SCEOF, SCBOF, NXTR, TALLF; the row table
                                ;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
                                ;        LNDLT and PLACE cleared.
                                ; The lines are measured once, into the row table (HTBLD): as many above the
                                ; cursor's as the placement could want, and a screenful of rows from it on.
                                ; Everything after that is arithmetic on the table: which line is the top one
                                ; (as many of the lines wanted above as leave the cursor's whole line room),
                                ; and how far down the text goes.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  05FC'                         LAYOUT:
  05FC'   2A 0000*              	LHLD	CMDCNT
  05FF'   22 1062'              	SHLD	SVCNT
  0602'   2A 0000*              	LHLD	AUXCNT
  0605'   22 1064'              	SHLD	SVAUX
  0608'   3A 0000*              	LDA	DIRFLG
  060B'   32 1066'              	STA	SVDIR
  060E'   CD 0790'              	CALL	LYQK		; a move about a screen that stands: no more to do
  0611'   DA 077A'              	JC	LY_TC
  0614'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  0617'   32 1053'              	STA	LYROW
  061A'   32 105E'              	STA	LYSVR
  061D'   AF                    	XRA	A
  061E'   32 105C'              	STA	LYND
  0621'   32 105D'              	STA	LYPRF
  0624'   3A 1049'              	LDA	PLACE		; a line the command placed stays where it was
  0627'   B7                    	ORA	A		;   put; one that only moved is asked about
  0628'   CC 0BE3'              	CZ	LYFAR
  062B'   2A 0000*              	LHLD	LNDLT
  062E'   22 1051'              	SHLD	LYDLT
  0631'   7C                    	MOV	A,H
  0632'   B5                    	ORA	L
  0633'   21 0000               	LXI	H,0
  0636'   22 0000*              	SHLD	LNDLT
  0639'   47                    	MOV	B,A
  063A'   3A 1049'              	LDA	PLACE		; the cursor on another line, or its line put
  063D'   B0                    	ORA	B		;   somewhere by the command: a line starts with
  063E'   CA 0644'              	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
  0641'   22 1019'              	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
  0644'                         LY_SAM:
                                	;--- the lines to measure above the cursor's: those it has over it now,
                                	;    or all a screen could show when it is to be placed afresh (but no
                                	;    more than leaves the table room for the rows under it) ---
  0644'   3A 1016'              	LDA	NEDIT
  0647'   4F                    	MOV	C,A		; C = a screenful of rows from the cursor's line on
  0648'   3D                    	DCR	A
  0649'   47                    	MOV	B,A
  064A'   3E FE                 	MVI	A,254
  064C'   91                    	SUB	C
  064D'   B8                    	CMP	B
  064E'   D2 0652'              	JNC	LY_B1
  0651'   47                    	MOV	B,A
  0652'                         LY_B1:
  0652'   CD 0A26'              	CALL	LYMQ
  0655'   CA 065C'              	JZ	LY_BLD
  0658'   3A 1053'              	LDA	LYROW
  065B'   47                    	MOV	B,A
  065C'                         LY_BLD:
  065C'   CD 092C'              	CALL	LYSTP		; a step past the screen's edge: the table stands
  065F'   D4 0C20'              	CNC	HTBLD
