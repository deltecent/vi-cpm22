  0BED'   0000                  RDBC:	DW	0		; reader: RGET count
  0BEF'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0BF0'   00                    SKPN:	DB	0		; RDSKIP line count
  0BF1'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0BF2'   00                    SCLN:	DB	0		; region-scroll line count (N, 1..NEDIT-1)
  0BF3'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0BF5'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
