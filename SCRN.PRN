  0771'   CA 077E'              	JZ	LQK_G
  0774'   FE 04                 	CPI	R_ICH
  0776'   CA 077E'              	JZ	LQK_G
  0779'   FE 07                 	CPI	R_DCH
  077B'   C2 0860'              	JNZ	LQK_N
