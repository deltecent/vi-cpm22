  08B8'   19                    	DAD	D		; HL = the lines over it, from the old top line
  08B9'   7C                    	MOV	A,H
  08BA'   B7                    	ORA	A
  08BB'   C2 08E9'              	JNZ	LT_NO
  08BE'   7D                    	MOV	A,L
  08BF'   90                    	SUB	B
  08C0'   DA 08E9'              	JC	LT_NO
  08C3'   4F                    	MOV	C,A		; C = the lines the top goes down
  08C4'   2A 0000*              	LHLD	GAPBEG
  08C7'   EB                    	XCHG
  08C8'   D5                    	PUSH	D
  08C9'   2A 0000*              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  08CC'   EB                    	XCHG
