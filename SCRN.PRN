  0B77'   CD 0BD2'              	CALL	HTPUT
  0B7A'   47                    	MOV	B,A
  0B7B'   3A 0E53'              	LDA	HTLIM
  0B7E'   90                    	SUB	B
  0B7F'   32 0E53'              	STA	HTLIM
  0B82'   D8                    	RC
  0B83'   CA 0BA2'              	JZ	HB_PK		; rows enough
  0B86'                         HB_NX:
  0B86'   CD 09BE'              	CALL	LM_NX		; the next line down
  0B89'   CA 0B75'              	JZ	HB_PT
  0B8C'   F2 0BCF'              	JP	HB_TL		; one taller than the screen
  0B8F'   3A 0E55'              	LDA	LYLAST		; the text ended: was that a line?
  0B92'   FE 0A                 	CPI	LF
  0B94'   CA 0B9C'              	JZ	HB_EF
  0B97'                         HB_LS:
  0B97'   7A                    	MOV	A,D
  0B98'   3C                    	INR	A
  0B99'   CD 0BD2'              	CALL	HTPUT
  0B9C'                         HB_EF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B9C'   3E 01                 	MVI	A,1
  0B9E'   32 0000*              	STA	HTEOF
  0BA1'   C9                    	RET
  0BA2'                         HB_PK:
  0BA2'   2A 0E61'              	LHLD	RDBC		; just the rows asked for: is the text over
  0BA5'   44                    	MOV	B,H		;   right there?
  0BA6'   4D                    	MOV	C,L
  0BA7'   2A 0E5F'              	LHLD	RDHL
  0BAA'   CD 0000*              	CALL	RDGET
  0BAD'   D0                    	RNC
  0BAE'   C3 0B9C'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0BB1'                         HBMOR:
  0BB1'   32 0E53'              	STA	HTLIM
  0BB4'   B7                    	ORA	A
  0BB5'   CA 0BA2'              	JZ	HB_PK
  0BB8'   C3 0B86'              	JMP	HB_NX
  0BBB'                         HB_TO:
  0BBB'   3E 01                 	MVI	A,1
  0BBD'   32 0E30'              	STA	TALLF
  0BC0'   3A 0E0C'              	LDA	NEDIT
  0BC3'   32 0E19'              	STA	LYTSH
  0BC6'                         HB_TX:
  0BC6'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0BC7'   F2 0BCF'              	JP	HB_TL		;   with it, and on the screen)
  0BCA'   3E 01                 	MVI	A,1
  0BCC'   32 0000*              	STA	HTEOF
  0BCF'                         HB_TL:
  0BCF'   3A 0E0C'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0BD2'                         HTPUT:
  0BD2'   E5                    	PUSH	H
  0BD3'   D5                    	PUSH	D
  0BD4'   21 0000*              	LXI	H,HTN
  0BD7'   5E                    	MOV	E,M
  0BD8'   1C                    	INR	E
  0BD9'   CA 0BE5'              	JZ	HP_1
  0BDC'   73                    	MOV	M,E
  0BDD'   1D                    	DCR	E
  0BDE'   16 00                 	MVI	D,0
  0BE0'   21 0000*              	LXI	H,HTAB
  0BE3'   19                    	DAD	D
  0BE4'   77                    	MOV	M,A
  0BE5'                         HP_1:
  0BE5'   D1                    	POP	D
  0BE6'   E1                    	POP	H
  0BE7'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0BE8'                         TABCUR:
  0BE8'   3A 0000*              	LDA	EDMODE
  0BEB'   FE 00                 	CPI	EM_CMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BED'   C0                    	RNZ
  0BEE'   2A 0000*              	LHLD	TXTEND
  0BF1'   EB                    	XCHG
  0BF2'   2A 0000*              	LHLD	GAPEND
  0BF5'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0BF8'   C8                    	RZ
  0BF9'   7E                    	MOV	A,M
  0BFA'   FE 09                 	CPI	TAB
  0BFC'   C0                    	RNZ
  0BFD'   2A 0E43'              	LHLD	CURDCL
  0C00'   7D                    	MOV	A,L
  0C01'   F6 07                 	ORI	TABWID-1
  0C03'   6F                    	MOV	L,A
  0C04'   22 0E43'              	SHLD	CURDCL
  0C07'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0C08'                         RDTOP:
  0C08'   2A 0E3F'              	LHLD	TOPLEN
  0C0B'   C3 0C11'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0C0E'                         RDBOL:
  0C0E'   2A 0E41'              	LHLD	CBOL
  0C11'                         RDSET:
  0C11'   22 0E5D'              	SHLD	RDN
  0C14'   EB                    	XCHG
  0C15'   2A 0000*              	LHLD	GAPBEG
  0C18'   CD 0000*              	CALL	SUBHD
  0C1B'   22 0E5B'              	SHLD	RDP
  0C1E'   AF                    	XRA	A
  0C1F'   32 0E63'              	STA	RDSEG
  0C22'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0C23'                         RDCH:
  0C23'   C5                    	PUSH	B
  0C24'   D5                    	PUSH	D
  0C25'   E5                    	PUSH	H
  0C26'   2A 0E5D'              	LHLD	RDN		; before-gap bytes left?
  0C29'   7C                    	MOV	A,H
  0C2A'   B5                    	ORA	L
  0C2B'   CA 0C3E'              	JZ	RDC_AF
  0C2E'   2B                    	DCX	H
  0C2F'   22 0E5D'              	SHLD	RDN
  0C32'   2A 0E5B'              	LHLD	RDP
  0C35'   7E                    	MOV	A,M
  0C36'   23                    	INX	H
  0C37'   22 0E5B'              	SHLD	RDP
  0C3A'   B7                    	ORA	A		; CY=0
  0C3B'   C3 0C62'              	JMP	RDC_RT
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C3E'                         RDC_AF:
  0C3E'   3A 0E63'              	LDA	RDSEG
  0C41'   B7                    	ORA	A
  0C42'   C2 0C4F'              	JNZ	RDC_NX
  0C45'   3C                    	INR	A		; first after-gap byte: start RGET
  0C46'   32 0E63'              	STA	RDSEG
  0C49'   CD 0000*              	CALL	RGET0
  0C4C'   C3 0C57'              	JMP	RDC_GT
  0C4F'                         RDC_NX:
  0C4F'   2A 0E61'              	LHLD	RDBC
  0C52'   44                    	MOV	B,H
  0C53'   4D                    	MOV	C,L
  0C54'   2A 0E5F'              	LHLD	RDHL
  0C57'                         RDC_GT:
  0C57'   CD 0000*              	CALL	RDGET
  0C5A'   22 0E5F'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0C5D'   60                    	MOV	H,B
  0C5E'   69                    	MOV	L,C
  0C5F'   22 0E61'              	SHLD	RDBC
  0C62'                         RDC_RT:
  0C62'   E1                    	POP	H
  0C63'   D1                    	POP	D
  0C64'   C1                    	POP	B
  0C65'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0C66'                         RDSKIP:
  0C66'   B7                    	ORA	A
  0C67'   C8                    	RZ
  0C68'   32 0E64'              	STA	SKPN
  0C6B'   2A 0E5D'              	LHLD	RDN		; what lies before the gap is passed over where
  0C6E'   44                    	MOV	B,H		;   it lies
  0C6F'   4D                    	MOV	C,L
  0C70'   2A 0E5B'              	LHLD	RDP
  0C73'                         RSK_F:
  0C73'   78                    	MOV	A,B
  0C74'   B1                    	ORA	C
  0C75'   CA 0C8A'              	JZ	RSK_S
  0C78'   7E                    	MOV	A,M
  0C79'   23                    	INX	H
  0C7A'   0B                    	DCX	B
  0C7B'   FE 0A                 	CPI	LF
  0C7D'   C2 0C73'              	JNZ	RSK_F
  0C80'   3A 0E64'              	LDA	SKPN
  0C83'   3D                    	DCR	A
  0C84'   32 0E64'              	STA	SKPN
  0C87'   C2 0C73'              	JNZ	RSK_F
  0C8A'                         RSK_S:
  0C8A'   22 0E5B'              	SHLD	RDP
  0C8D'   60                    	MOV	H,B
  0C8E'   69                    	MOV	L,C
  0C8F'   22 0E5D'              	SHLD	RDN
  0C92'   3A 0E64'              	LDA	SKPN
  0C95'   B7                    	ORA	A
  0C96'   C8                    	RZ
  0C97'                         RSK_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C97'   CD 0C23'              	CALL	RDCH
  0C9A'   D8                    	RC
  0C9B'   FE 0A                 	CPI	LF
  0C9D'   C2 0C97'              	JNZ	RSK_LP
  0CA0'   3A 0E64'              	LDA	SKPN
  0CA3'   3D                    	DCR	A
  0CA4'   32 0E64'              	STA	SKPN
  0CA7'   C2 0C97'              	JNZ	RSK_LP
  0CAA'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0CAB'                         PSKIP:
  0CAB'   3A 0E0B'              	LDA	NCOLS
  0CAE'   CD 0CDD'              	CALL	MULHA		; HL = the cells to pass over
  0CB1'   EB                    	XCHG
  0CB2'   21 0000               	LXI	H,0
  0CB5'   22 0E66'              	SHLD	PSKN
  0CB8'                         PS_LP:
  0CB8'   7A                    	MOV	A,D
  0CB9'   B3                    	ORA	E
  0CBA'   CA 0D11'              	JZ	PR_LP
  0CBD'   CD 0C23'              	CALL	RDCH
  0CC0'   FE 0D                 	CPI	CR
  0CC2'   CA 0CB8'              	JZ	PS_LP
  0CC5'   0E 01                 	MVI	C,1
  0CC7'   FE 09                 	CPI	TAB
  0CC9'   CC 0CE7'              	CZ	TABN
  0CCC'                         PS_CL:
  0CCC'   7A                    	MOV	A,D
  0CCD'   B3                    	ORA	E
  0CCE'   CA 0D2B'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0CD1'   1B                    	DCX	D
  0CD2'   21 0E68'              	LXI	H,DCOL
  0CD5'   34                    	INR	M
  0CD6'   0D                    	DCR	C
  0CD7'   C2 0CCC'              	JNZ	PS_CL
  0CDA'   C3 0CB8'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0CDD'                         MULHA:
  0CDD'   EB                    	XCHG
  0CDE'   21 0000               	LXI	H,0
  0CE1'                         MH_LP:
  0CE1'   19                    	DAD	D
  0CE2'   3D                    	DCR	A
  0CE3'   C2 0CE1'              	JNZ	MH_LP
  0CE6'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0CE7'                         TABN:
  0CE7'   3A 0E68'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0CEA'   E6 07                 	ANI	7
  0CEC'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CED'   3E 08                 	MVI	A,8
  0CEF'   91                    	SUB	C
  0CF0'   4F                    	MOV	C,A
  0CF1'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0CF2'                         PAINTR:
  0CF2'   3A 0E65'              	LDA	PROWN
  0CF5'   21 0E13'              	LXI	H,TXEND
  0CF8'   BE                    	CMP	M		; CY iff the row holds text
  0CF9'   DA 0D02'              	JC	PROW
  0CFC'   3A 0E14'              	LDA	FILCH
  0CFF'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0D02'                         PROW:
  0D02'   AF                    	XRA	A
  0D03'   32 0E68'              	STA	DCOL
  0D06'   32 0E69'              	STA	XC
  0D09'   2A 0E66'              	LHLD	PSKN
  0D0C'   7C                    	MOV	A,H
  0D0D'   B5                    	ORA	L
  0D0E'   C2 0CAB'              	JNZ	PSKIP
  0D11'                         PR_LP:
  0D11'   CD 0C23'              	CALL	RDCH
  0D14'   D8                    	RC			; end of text -> line done
  0D15'   FE 0A                 	CPI	LF
  0D17'   C8                    	RZ			; consumed the LF -> next line start
  0D18'   FE 0D                 	CPI	CR
  0D1A'   CA 0D11'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0D1D'   FE 09                 	CPI	TAB
  0D1F'   CA 0D28'              	JZ	PR_TAB
  0D22'   CD 0D37'              	CALL	PCELL
  0D25'   C3 0D11'              	JMP	PR_LP
  0D28'                         PR_TAB:
  0D28'   CD 0CE7'              	CALL	TABN		; C = space count (1..8)
  0D2B'                         PRTBLP:
  0D2B'   3E 20                 	MVI	A,' '
  0D2D'   CD 0D37'              	CALL	PCELL		; (keeps C)
  0D30'   0D                    	DCR	C
  0D31'   C2 0D2B'              	JNZ	PRTBLP
  0D34'   C3 0D11'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0D37'                         PCELL:
  0D37'   47                    	MOV	B,A
  0D38'   21 0E68'              	LXI	H,DCOL
  0D3B'   34                    	INR	M
  0D3C'   3A 0E0B'              	LDA	NCOLS
  0D3F'   21 0E69'              	LXI	H,XC
  0D42'   BE                    	CMP	M
  0D43'   CC 0D4B'              	CZ	PWRAP		; the row is full: this one starts the next
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D46'   34                    	INR	M
  0D47'   78                    	MOV	A,B
  0D48'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0D4B'                         PWRAP:
  0D4B'   36 00                 	MVI	M,0
  0D4D'   3A 0E2F'              	LDA	PEND
  0D50'   3D                    	DCR	A
  0D51'   21 0E65'              	LXI	H,PROWN
  0D54'   BE                    	CMP	M
  0D55'   CA 0D6A'              	JZ	PW_END
  0D58'   34                    	INR	M
  0D59'   3E 0D                 	MVI	A,CR
  0D5B'   CD 0018'              	CALL	OUTCH
  0D5E'   3E 0A                 	MVI	A,LF
  0D60'   CD 0018'              	CALL	OUTCH
  0D63'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0D66'   21 0E69'              	LXI	H,XC
  0D69'   C9                    	RET
  0D6A'                         PW_END:
  0D6A'   E1                    	POP	H		; PCELL's return, and PROW's
  0D6B'   E1                    	POP	H
  0D6C'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0D6D'                         MODEMS:
  0D6D'   3A 0000*              	LDA	EDMODE
  0D70'   47                    	MOV	B,A
  0D71'   3A 0E3A'              	LDA	OEDMOD
  0D74'   B8                    	CMP	B
  0D75'   C8                    	RZ			; the row already shows this mode
  0D76'   78                    	MOV	A,B
  0D77'   32 0E3A'              	STA	OEDMOD
  0D7A'   21 0DEA'              	LXI	H,SINSM
  0D7D'   FE 01                 	CPI	EM_INS
  0D7F'   CA 0D8D'              	JZ	MD_DRW
  0D82'   21 0DF7'              	LXI	H,SREPM
  0D85'   FE 02                 	CPI	EM_REP
  0D87'   CA 0D8D'              	JZ	MD_DRW
  0D8A'   21 0E05'              	LXI	H,SNULL		; command mode: the row goes blank
  0D8D'                         MD_DRW:
  0D8D'   E5                    	PUSH	H
  0D8E'   3A 0E0A'              	LDA	NROWS
  0D91'   CD 008C'              	CALL	GOROW1
  0D94'   E1                    	POP	H
  0D95'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0D98'                         SCURS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D98'   3A 0E11'              	LDA	SROW
  0D9B'   47                    	MOV	B,A
  0D9C'   3A 0E12'              	LDA	SCOL
  0D9F'   4F                    	MOV	C,A
  0DA0'   CD 0064'              	CALL	GOTOXY
  0DA3'   21 0DDF'              	LXI	H,SSHOW
  0DA6'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0DA9'                         SCDONE:
  0DA9'   CD 0086'              	CALL	CRGRS
  0DAC'   21 0DDF'              	LXI	H,SSHOW
  0DAF'   CD 0025'              	CALL	OUTSTR
  0DB2'   3A 0E0A'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0DB5'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0DB8'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0DBC'   39 3B 39 39           
  0DC0'   39 48                 
  0DC2'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0DC6'   00                    
  0DC7'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0DCB'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0DCE'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0DD2'   00                    
  0DD3'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0DD7'   00                    
  0DD8'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0DDC'   35 6C 00              
  0DDF'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0DE3'   35 68 00              
  0DE6'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0DEA'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0DEE'   4E 53 45 52           
  0DF2'   54 20 2D 2D           
  0DF6'   00                    
  0DF7'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0DFB'   45 50 4C 41           
  0DFF'   43 45 20 2D           
  0E03'   2D 00                 
  0E05'   00                    SNULL:	DB	0
  0E06'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0E0A'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0E0B'   50                    NCOLS:	DB	80		; runtime columns
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0E0C'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0E0D'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0E0F'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0E11'   00                    SROW:	DB	0		; computed cursor screen row
  0E12'   00                    SCOL:	DB	0		; computed cursor screen column
  0E13'   01                    TXEND:	DB	1		; the first row with no text on it
  0E14'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0E15'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0E16'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0E18'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0E19'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0E1A'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0E1B'   0000                  OLDWR:	DW	0
  0E1D'   0000                  OLDSK:	DW	0
  0E1F'   0000                  OLDSC:	DW	0
  0E21'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0E23'   00                    OLDBOT:	DB	0
  0E24'   0000                  OLDAB:	DW	0
  0E26'   00                    OLDCS:	DB	0
  0E27'   00                    OLDCR:	DB	0
  0E28'   00                    OLDNR:	DB	0
                                
  0E29'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0E2A'   00                    OPM:	DB	0		; ... or gained there
  0E2B'   00                    EDA:	DB	0		; the edit: the rows it had
  0E2C'   00                    EDB:	DB	0		; ... and has
  0E2D'   00                    EDR:	DB	0		; ... its first row
  0E2E'   00                    EDP:	DB	0		; ... the first of them to draw
  0E2F'   00                    PEND:	DB	0		; PRNG: the row to stop before
  0E30'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0E31'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0E33'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  0E34'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  0E35'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  0E37'   0000                  LYPG:	DW	0		; ... and PGTOPM
  0E39'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  0E3A'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0E3B'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0E3C'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0E3D'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0E3E'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0E3F'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0E41'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0E43'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0E45'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0E47'   00                    LYROW:	DB	0		; LAYOUT: working row
  0E48'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0E4A'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E4B'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0E4D'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0E4E'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0E4F'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0E50'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0E51'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0E52'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0E53'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0E54'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0E55'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0E56'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0E58'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0E5A'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0E5B'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0E5D'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0E5F'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0E61'   0000                  RDBC:	DW	0		; reader: RGET count
  0E63'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0E64'   00                    SKPN:	DB	0		; RDSKIP line count
  0E65'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0E66'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0E68'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0E69'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0E6A'   0000                  TMPR:	DW	0		; DSR parse: rows
  0E6C'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
