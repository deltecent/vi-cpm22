	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the RINTENT fast paths
                                ; (cursor-only, region scroll up/down, one-row redraw, ICH insert, DL line
                                ; delete), the RPOLL repaint abort, and the message row.  The region scrolls
                                ; take their line count from SCRLN, the number of lines the text moved up this
                                ; frame.  Every fast path but the cursor-only one takes a line to be a row, so
                                ; none is used while a wrapped line is on the screen (WRAPF).
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, WFILL  (last layout's facts; fill request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	WFILL			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0002                          WR_EOL	EQU	2		; WRAPF from here up: the cursor has a row to itself
  0002                          WF_MID	EQU	2		; WFILL: the cursor's line in the middle of the screen
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0B28'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0B36'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0B10'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PTROW -- paint the line at row PROWN and step to the row under it: clear the
                                ; row, write the line (on as many rows as it takes), CR/LF (the last LF of a
                                ; full repaint lands on the message row, and a backward scroll's N <= NEDIT-1
                                ; keeps it inside the region), and count the row off.  Both paint loops are
                                ; this, once each.  When the cursor has a row to itself (WR_EOL) that row is
                                ; the one under its line's text, and is cleared and counted here as well.
  0098'                         PTROW:
  0098'   CD 0092'              	CALL	CEKL		; ESC[K -- clear the row
  009B'   CD 0A3C'              	CALL	PAINTR
  009E'   CD 00B3'              	CALL	PT_NL
  00A1'   3A 0B5D'              	LDA	WRAPF
  00A4'   FE 02                 	CPI	WR_EOL
  00A6'   D8                    	RC
  00A7'   3A 0B9E'              	LDA	SROW
  00AA'   3D                    	DCR	A
  00AB'   21 0B98'              	LXI	H,PROWN
  00AE'   BE                    	CMP	M
  00AF'   C0                    	RNZ
  00B0'   CD 0092'              	CALL	CEKL
  00B3'                         PT_NL:
  00B3'   3E 0D                 	MVI	A,CR
  00B5'   CD 0018'              	CALL	OUTCH
  00B8'   3E 0A                 	MVI	A,LF
  00BA'   CD 0018'              	CALL	OUTCH
  00BD'   21 0B98'              	LXI	H,PROWN
  00C0'   34                    	INR	M
  00C1'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  00C2'                         GOTOP:
  00C2'   06 01                 	MVI	B,1
  00C4'   0E 01                 	MVI	C,1
  00C6'   C3 0064'              	JMP	GOTOXY
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  00C9'                         SCINIT:
  00C9'   21 0000               	LXI	H,0
  00CC'   22 0B59'              	SHLD	WINROW
  00CF'   21 0B01'              	LXI	H,SPROBE
  00D2'   CD 0025'              	CALL	OUTSTR
  00D5'   CD 0120'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  00D8'   3A 0B56'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  00DB'   3D                    	DCR	A
  00DC'   32 0B58'              	STA	NEDIT
  00DF'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  00E0'                         RDB:
  00E0'   21 0000               	LXI	H,0
  00E3'                         RDB_LP:
  00E3'   E5                    	PUSH	H
  00E4'   CD 0000'              	CALL	BCONST
  00E7'   E1                    	POP	H
  00E8'   B7                    	ORA	A
  00E9'   C2 00F4'              	JNZ	RDB_GO
  00EC'   2B                    	DCX	H
  00ED'   7C                    	MOV	A,H
  00EE'   B5                    	ORA	L
  00EF'   C2 00E3'              	JNZ	RDB_LP
  00F2'   37                    	STC			; timeout
  00F3'   C9                    	RET
  00F4'                         RDB_GO:
  00F4'   CD 0008'              	CALL	BCONIN
  00F7'   B7                    	ORA	A		; CY=0, A=byte
  00F8'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  00F9'                         RDNUM:
  00F9'   11 0000               	LXI	D,0
  00FC'                         RN_LP:
  00FC'   D5                    	PUSH	D
  00FD'   CD 00E0'              	CALL	RDB
  0100'   D1                    	POP	D
  0101'   D8                    	RC
  0102'   FE 30                 	CPI	'0'
  0104'   DA 011E'              	JC	RN_DN
  0107'   FE 3A                 	CPI	'9'+1
  0109'   D2 011E'              	JNC	RN_DN
  010C'   D6 30                 	SUI	'0'
  010E'   4F                    	MOV	C,A		; C = this digit
  010F'   62                    	MOV	H,D		; HL = value
  0110'   6B                    	MOV	L,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0111'   29                    	DAD	H		; 2x
  0112'   54                    	MOV	D,H
  0113'   5D                    	MOV	E,L		; DE = 2x
  0114'   29                    	DAD	H		; 4x
  0115'   29                    	DAD	H		; 8x
  0116'   19                    	DAD	D		; 10x
  0117'   06 00                 	MVI	B,0		; BC = digit
  0119'   09                    	DAD	B		; HL = 10x + digit
  011A'   EB                    	XCHG			; DE = new value
  011B'   C3 00FC'              	JMP	RN_LP
  011E'                         RN_DN:
  011E'   B7                    	ORA	A		; CY=0, A = terminator
  011F'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0120'                         RDNUMS:
  0120'   CD 00E0'              	CALL	RDB
  0123'   D8                    	RC
  0124'   FE 1B                 	CPI	ESC
  0126'   C0                    	RNZ			; not what a DSR reply looks like
  0127'   CD 00E0'              	CALL	RDB
  012A'   D8                    	RC
  012B'   FE 5B                 	CPI	'['
  012D'   C0                    	RNZ			; not what a DSR reply looks like
  012E'   CD 00F9'              	CALL	RDNUM		; DE = rows
  0131'   D8                    	RC
  0132'   FE 3B                 	CPI	';'
  0134'   C0                    	RNZ			; not what a DSR reply looks like
  0135'   EB                    	XCHG
  0136'   22 0BA0'              	SHLD	TMPR
  0139'   CD 00F9'              	CALL	RDNUM		; DE = cols
  013C'   D8                    	RC
  013D'   FE 52                 	CPI	'R'
  013F'   C0                    	RNZ			; not what a DSR reply looks like
  0140'   EB                    	XCHG
  0141'   22 0BA2'              	SHLD	TMPC
  0144'   2A 0BA0'              	LHLD	TMPR		; rows -> clamp [24,200]
  0147'   06 18                 	MVI	B,24
  0149'   0E C8                 	MVI	C,200
  014B'   CD 015F'              	CALL	CLAMP
  014E'   32 0B56'              	STA	NROWS
  0151'   2A 0BA2'              	LHLD	TMPC		; cols -> clamp [80,132]
  0154'   06 50                 	MVI	B,80
  0156'   0E 84                 	MVI	C,132
  0158'   CD 015F'              	CALL	CLAMP
  015B'   32 0B57'              	STA	NCOLS
  015E'                         RS_BAD:
  015E'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  015F'                         CLAMP:
  015F'   7C                    	MOV	A,H
  0160'   B7                    	ORA	A
  0161'   C2 0172'              	JNZ	CLP_MAX		; value > 255 -> max
  0164'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0165'   B8                    	CMP	B
  0166'   DA 0170'              	JC	CLP_MIN		; value < min
  0169'   79                    	MOV	A,C
  016A'   BD                    	CMP	L		; CY iff max < value
  016B'   DA 0172'              	JC	CLP_MAX
  016E'   7D                    	MOV	A,L
  016F'   C9                    	RET
  0170'                         CLP_MIN:
  0170'   78                    	MOV	A,B
  0171'   C9                    	RET
  0172'                         CLP_MAX:
  0172'   79                    	MOV	A,C
  0173'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- snapshot what is on the screen (WINROW/WRAPF) into OLDWR/OLDWF.  The
                                ; main loop calls this after reading a key and before dispatch, so SCDRAW can
                                ; tell how far the text moved (SCRLN) and whether a line was wrapped.
  0174'                         SCPRE:
  0174'   2A 0B59'              	LHLD	WINROW
  0177'   22 0B5B'              	SHLD	OLDWR
  017A'   3A 0B5D'              	LDA	WRAPF
  017D'   32 0B5E'              	STA	OLDWF
  0180'   C9                    	RET
                                
  0181'                         SCDRAW:
  0181'   CD 04BD'              	CALL	LAYOUT		; WINROW/SCRLN/SCBOT/CURDCL/WRAPF (no output)
  0184'   CD 0477'              	CALL	CURSC		; SROW/SCOL
  0187'   3A 0B61'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  018A'   B7                    	ORA	A
  018B'   C2 0272'              	JNZ	SCFULL
  018E'   3A 0B5D'              	LDA	WRAPF		; the wrapping on this screen, or on the last
  0191'   21 0B5E'              	LXI	H,OLDWF
  0194'   B6                    	ORA	M
  0195'   47                    	MOV	B,A
  0196'   FE 02                 	CPI	WR_EOL		; a row only the cursor holds came or went: the
  0198'   D2 0272'              	JNC	SCFULL		;   lines under it moved, whatever the key was
  019B'   3A 0000*              	LDA	RINTENT
  019E'   FE 01                 	CPI	R_MOVE
  01A0'   C2 01AB'              	JNZ	SC_WR
  01A3'   2A 0B5F'              	LHLD	SCRLN
  01A6'   7C                    	MOV	A,H
  01A7'   B5                    	ORA	L
  01A8'   CA 0AE1'              	JZ	SCURS		; text still -> cursor only, wrapped or not
  01AB'                         SC_WR:
  01AB'   78                    	MOV	A,B		; every paint from here on takes a line to be a
  01AC'   B7                    	ORA	A		;   row: a wrapped one on the screen -> repaint
  01AD'   C2 0272'              	JNZ	SCFULL
  01B0'   3A 0000*              	LDA	RINTENT
  01B3'   FE 01                 	CPI	R_MOVE
  01B5'   CA 01FB'              	JZ	SC_MV
  01B8'   FE 02                 	CPI	R_LINE
  01BA'   CA 01D1'              	JZ	SC_ED
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BD'   FE 04                 	CPI	R_ICH
  01BF'   CA 01D1'              	JZ	SC_ED
  01C2'   FE 05                 	CPI	R_ILIN
  01C4'   CA 03B2'              	JZ	SC_ILQ		; (its own test: it moves the cursor's row, and
  01C7'   FE 03                 	CPI	R_DLIN		;   on the bottom row it scrolls the text too)
  01C9'   CA 01D1'              	JZ	SC_ED
  01CC'   FE 06                 	CPI	R_JOIN
  01CE'   C2 0272'              	JNZ	SCFULL		; anything else -> full repaint
  01D1'                         SC_ED:
                                	;--- the in-place edit paints need the text to have stayed put ---
  01D1'   2A 0B5F'              	LHLD	SCRLN
  01D4'   7C                    	MOV	A,H
  01D5'   B5                    	ORA	L
  01D6'   C2 0272'              	JNZ	SCFULL
  01D9'   2A 0B5B'              	LHLD	OLDWR
  01DC'   EB                    	XCHG
  01DD'   2A 0B59'              	LHLD	WINROW
  01E0'   CD 0000*              	CALL	CMP16		; Z iff the cursor kept its row
  01E3'   C2 0272'              	JNZ	SCFULL
  01E6'   3A 0000*              	LDA	RINTENT
  01E9'   FE 02                 	CPI	R_LINE
  01EB'   CA 0260'              	JZ	SC_LNBD
  01EE'   FE 04                 	CPI	R_ICH
  01F0'   CA 0222'              	JZ	SC_ICH
  01F3'   FE 06                 	CPI	R_JOIN
  01F5'   CA 035A'              	JZ	SC_JN
  01F8'   C3 0381'              	JMP	SCDL
  01FB'                         SC_MV:
                                	;--- R_MOVE: the text moved up SCRLN lines (down if negative) ---
  01FB'   2A 0B5F'              	LHLD	SCRLN
  01FE'   7C                    	MOV	A,H
  01FF'   B7                    	ORA	A
  0200'   F2 0216'              	JP	SC_FWD
  0203'   EB                    	XCHG
  0204'   21 0000               	LXI	H,0
  0207'   CD 0000*              	CALL	SUBHD		; HL = -SCRLN
  020A'   CD 044D'              	CALL	SCRNOK		; A = N (CY=0) if 1..NEDIT-1, else CY=1
  020D'   DA 0272'              	JC	SCFULL
  0210'   32 0B99'              	STA	SCLN
  0213'   C3 0313'              	JMP	SCBWD
  0216'                         SC_FWD:
  0216'   CD 044D'              	CALL	SCRNOK
  0219'   DA 0272'              	JC	SCFULL
  021C'   32 0B99'              	STA	SCLN		; N in 1..NEDIT-1 -> region scroll
  021F'   C3 02CC'              	JMP	SCFWD
  0222'                         SC_ICH:
                                	;--- the inserted char sits at screen column SCOL-1; it must be a real
                                	;    on-screen cell (SCOL >= 2), else fall back to the whole-line redraw ---
  0222'   3A 0B9F'              	LDA	SCOL
  0225'   FE 02                 	CPI	2
  0227'   DA 0260'              	JC	SC_LNBD
                                	;--- appended at the row's end (ICHAPP): the cell is blank and nothing
                                	;    follows it, so the char alone is the whole frame -- no ICH to open a
                                	;    cell for it, and no hide/show, there being nothing to see happen
                                	;    between the address and the byte.  The terminal leaves the cursor at
                                	;    SCOL, where insert mode wants it, exactly as the ICH path does. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  022A'   3A 0000*              	LDA	ICHAPP
  022D'   B7                    	ORA	A
  022E'   C2 0246'              	JNZ	SC_ICA
  0231'   CD 0080'              	CALL	CHIDE
  0234'   CD 024C'              	CALL	SC_ICG		; address the inserted char's cell (SROW, SCOL-1)
  0237'   21 0B1E'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  023A'   CD 0025'              	CALL	OUTSTR
  023D'   CD 0258'              	CALL	SC_ICC		; fills the opened cell; cursor advances to SCOL
  0240'   21 0B2F'              	LXI	H,SSHOW
  0243'   C3 0025'              	JMP	OUTSTR
  0246'                         SC_ICA:
  0246'   CD 024C'              	CALL	SC_ICG
  0249'   C3 0258'              	JMP	SC_ICC
                                ;SC_ICG -- address the inserted char's cell, (SROW, SCOL-1).
  024C'                         SC_ICG:
  024C'   3A 0B9E'              	LDA	SROW
  024F'   47                    	MOV	B,A
  0250'   3A 0B9F'              	LDA	SCOL
  0253'   3D                    	DCR	A
  0254'   4F                    	MOV	C,A
  0255'   C3 0064'              	JMP	GOTOXY
                                ;SC_ICC -- emit the just-inserted byte, which is right before the gap.
  0258'                         SC_ICC:
  0258'   2A 0000*              	LHLD	GAPBEG
  025B'   2B                    	DCX	H
  025C'   7E                    	MOV	A,M
  025D'   C3 0018'              	JMP	OUTCH
  0260'                         SC_LNBD:
                                	;--- R_LINE: redraw only the cursor's row (tabs re-expanded), then
                                	;    re-address and show the cursor ---
  0260'   CD 0080'              	CALL	CHIDE
  0263'   3A 0B9E'              	LDA	SROW
  0266'   CD 008C'              	CALL	GOROW1		; column 1 of the current row, cleared
  0269'   CD 09CB'              	CALL	RDBOL		; read from the cursor line's first byte
  026C'   CD 0A4C'              	CALL	PROW
  026F'   C3 0AE1'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place (home + CR,LF stepping), each
                                ; cleared with ESC[K; a line takes as many rows as it is wide, and the rows
                                ; past the text show '~' (or '@').  No ESC[2J (no blank flash).
                                ; Message row last; cursor hidden throughout, then addressed and shown.
  0272'                         SCFULL:
  0272'   CD 0080'              	CALL	CHIDE
  0275'   CD 09C5'              	CALL	RDTOP
  0278'   CD 00C2'              	CALL	GOTOP		; home to row 1
  027B'   AF                    	XRA	A
  027C'   32 0B98'              	STA	PROWN
  027F'                         ROW_LP:
  027F'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abort this repaint
  0282'   B7                    	ORA	A
  0283'   C2 04B7'              	JNZ	SCABRT
  0286'   3A 0B58'              	LDA	NEDIT
  0289'   47                    	MOV	B,A
  028A'   3A 0B98'              	LDA	PROWN
  028D'   B8                    	CMP	B
  028E'   D2 0297'              	JNC	ROWS_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0291'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0294'   C3 027F'              	JMP	ROW_LP
  0297'                         ROWS_DN:
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  0297'   CD 0092'              	CALL	CEKL
  029A'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  029C'   32 0B62'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  029F'   CD 0AE1'              	CALL	SCURS
  02A2'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  02A3'   32 0B61'              	STA	FORCEF
  02A6'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  02A7'                         EXPRM:
  02A7'   F5                    	PUSH	PSW
  02A8'   3A 0000*              	LDA	EDMODE
  02AB'   32 0B62'              	STA	OEDMOD
  02AE'   3A 0B56'              	LDA	NROWS
  02B1'   CD 008C'              	CALL	GOROW1
  02B4'   F1                    	POP	PSW
  02B5'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  02B8'                         EXRUB:
  02B8'   21 02BE'              	LXI	H,SRUB
  02BB'   C3 0025'              	JMP	OUTSTR
  02BE'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  02C2'                         EXMSG:
  02C2'   7E                    	MOV	A,M
  02C3'   23                    	INX	H
  02C4'   E5                    	PUSH	H
  02C5'   CD 02A7'              	CALL	EXPRM
  02C8'   E1                    	POP	H
  02C9'   C3 0025'              	JMP	OUTSTR
                                
                                ;SCFWD -- the text moved up N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows (message row protected), then N times:
                                ; delete the top region row (ESC[M) -- the terminal scrolls the region up one
                                ; line -- and draw the newly exposed row into row NEDIT.  Only the N exposed
                                ; rows (NEDIT-N .. NEDIT-1) are drawn; the overlap the terminal shifted is never
                                ; re-sent.  Short and bounded, so it runs to completion (no RPOLL abort).
  02CC'                         SCFWD:
  02CC'   CD 0080'              	CALL	CHIDE
  02CF'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  02D2'   CD 09C5'              	CALL	RDTOP
  02D5'   3A 0B99'              	LDA	SCLN
  02D8'   47                    	MOV	B,A
  02D9'   3A 0B58'              	LDA	NEDIT
  02DC'   90                    	SUB	B		; A = NEDIT - N = first exposed row
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02DD'   32 0B98'              	STA	PROWN
  02E0'   CD 0A23'              	CALL	RDSKIP		; reader at that row's line
  02E3'                         SFW_LP:
  02E3'   3A 0B99'              	LDA	SCLN
  02E6'   B7                    	ORA	A
  02E7'   CA 030D'              	JZ	SFW_DN
  02EA'   CD 00C2'              	CALL	GOTOP		; region top row
  02ED'   21 0B14'              	LXI	H,SDL		; ESC[M (DL) at the top: region scrolls up 1
  02F0'   CD 0025'              	CALL	OUTSTR
  02F3'   3A 0B58'              	LDA	NEDIT		; draw the exposed row into the bottom edit row
  02F6'   CD 008C'              	CALL	GOROW1		; ... addressed and cleared
  02F9'   CD 0A3C'              	CALL	PAINTR
  02FC'   3A 0B98'              	LDA	PROWN
  02FF'   3C                    	INR	A
  0300'   32 0B98'              	STA	PROWN
  0303'   3A 0B99'              	LDA	SCLN
  0306'   3D                    	DCR	A
  0307'   32 0B99'              	STA	SCLN
  030A'   C3 02E3'              	JMP	SFW_LP
  030D'                         SFW_DN:
  030D'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0310'   C3 0AE1'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCBWD -- the text moved down N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows, Reverse-Index (ESC M) N times at the
                                ; region top -- the terminal scrolls the region down, opening N blank rows at
                                ; the top -- then draw rows 0..N-1 from the top line down.
  0313'                         SCBWD:
  0313'   CD 0080'              	CALL	CHIDE
  0316'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0319'   3A 0B99'              	LDA	SCLN
  031C'   32 0B9C'              	STA	ROWCT
  031F'                         SBW_RI:
  031F'   3A 0B9C'              	LDA	ROWCT
  0322'   B7                    	ORA	A
  0323'   CA 0339'              	JZ	SBW_PT
  0326'   CD 00C2'              	CALL	GOTOP		; region top row
  0329'   21 0B1B'              	LXI	H,SRI		; ESC M (RI) at the top: region scrolls down 1
  032C'   CD 0025'              	CALL	OUTSTR
  032F'   3A 0B9C'              	LDA	ROWCT
  0332'   3D                    	DCR	A
  0333'   32 0B9C'              	STA	ROWCT
  0336'   C3 031F'              	JMP	SBW_RI
  0339'                         SBW_PT:
  0339'   CD 09C5'              	CALL	RDTOP
  033C'   AF                    	XRA	A
  033D'   32 0B98'              	STA	PROWN
  0340'   CD 00C2'              	CALL	GOTOP
  0343'                         SBW_LP:
  0343'   3A 0B99'              	LDA	SCLN
  0346'   47                    	MOV	B,A
  0347'   3A 0B98'              	LDA	PROWN
  034A'   B8                    	CMP	B
  034B'   D2 0354'              	JNC	SBW_DN
  034E'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0351'   C3 0343'              	JMP	SBW_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  0354'                         SBW_DN:
  0354'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0357'   C3 0AE1'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCDL -- R_DLIN: a single line was deleted at the cursor's row (dd, not the last
                                ; line).  Delete that screen row (ESC[M at SROW, region-clamped so the message row
                                ; is safe) -- the rows below shift up and a blank opens at row NEDIT -- then draw
                                ; the bottom row and re-address the cursor (which kept
                                ; its row, now at the BOL of the line that shifted up).
                                ;SC_JN -- R_JOIN: the line below was joined onto the cursor's.  That row now
                                ; holds both, and the row under it is gone -- so redraw the cursor's row, then
                                ; hand the rest to SCDL, which deletes a row and draws the one the shift
                                ; exposes at the bottom.  With the cursor on the LAST edit row there is no row
                                ; under it on the screen at all: the join took a line that was never shown, and
                                ; only the cursor's own row is stale (vim redraws just that row there too).
  035A'                         SC_JN:
  035A'   3A 0B9E'              	LDA	SROW
  035D'   47                    	MOV	B,A
  035E'   3A 0B58'              	LDA	NEDIT
  0361'   B8                    	CMP	B		; CY iff NEDIT < SROW; Z iff the bottom edit row
  0362'   CA 0260'              	JZ	SC_LNBD
  0365'   DA 0260'              	JC	SC_LNBD
  0368'   CD 0080'              	CALL	CHIDE
  036B'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  036E'   3A 0B9E'              	LDA	SROW		; the joined line, redrawn where it stands
  0371'   CD 008C'              	CALL	GOROW1
  0374'   CD 09CB'              	CALL	RDBOL
  0377'   CD 0A4C'              	CALL	PROW
  037A'   3A 0B9E'              	LDA	SROW
  037D'   3C                    	INR	A		; ... and the row under it goes
  037E'   C3 038A'              	JMP	SCDL2
                                
  0381'                         SCDL:
  0381'   CD 0080'              	CALL	CHIDE
  0384'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0387'   3A 0B9E'              	LDA	SROW		; delete the cursor's row
  038A'                         SCDL2:
  038A'   47                    	MOV	B,A
  038B'   0E 01                 	MVI	C,1
  038D'   CD 0064'              	CALL	GOTOXY
  0390'   21 0B14'              	LXI	H,SDL		; ESC[M (DL): rows below shift up, blank at NEDIT
  0393'   CD 0025'              	CALL	OUTSTR
  0396'   CD 09C5'              	CALL	RDTOP
  0399'   3A 0B58'              	LDA	NEDIT
  039C'   3D                    	DCR	A
  039D'   32 0B98'              	STA	PROWN		; the bottom row
  03A0'   CD 0A23'              	CALL	RDSKIP
  03A3'   3A 0B58'              	LDA	NEDIT
  03A6'   CD 008C'              	CALL	GOROW1		; bottom edit row, cleared
  03A9'   CD 0A3C'              	CALL	PAINTR
  03AC'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  03AF'   C3 0AE1'              	JMP	SCURS
                                
                                ;SC_IL -- R_ILIN: one line was opened at the cursor's row.  Open a row there
                                ; (ESC[L, region-clamped so the message row is safe) -- the rows below shift
                                ; down and the bottom one falls out of the region -- then draw the cursor's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ; and the one above it: a <CR> (and 'r<CR>') split that one, 'o' and 'O' leave
                                ; it as it was.  Everything else on the screen is already right where it is.
                                ;SC_ILQ -- which of the two forms this is.  A line that opened ON the screen
                                ; leaves the text where it stands (SCRLN = 0); one opened on the bottom row
                                ; has nowhere to put itself, so the screen scrolls up a row to make room
                                ; (SCRLN = 1) -- vim does the same, and it is what every <CR> does once you
                                ; are typing at the end of a file.  Both then draw the same two rows.
  03B2'                         SC_ILQ:
  03B2'   2A 0B5F'              	LHLD	SCRLN
  03B5'   7C                    	MOV	A,H
  03B6'   B5                    	ORA	L
  03B7'   CA 03DA'              	JZ	SC_IL		; the text stood still
  03BA'   2B                    	DCX	H
  03BB'   7C                    	MOV	A,H
  03BC'   B5                    	ORA	L
  03BD'   C2 0272'              	JNZ	SCFULL		; moved by more than a row: not ours
  03C0'   3A 0000*              	LDA	ILN		; and only ONE line can open into one scroll --
  03C3'   FE 01                 	CPI	1		;   a put of several at the bottom needs as many
  03C5'   C2 0272'              	JNZ	SCFULL		;   scrolls as it has lines, which is a repaint
  03C8'   CD 0080'              	CALL	CHIDE
  03CB'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03CE'   CD 00C2'              	CALL	GOTOP
  03D1'   21 0B14'              	LXI	H,SDL		; ESC[M at the top: the region scrolls up one,
  03D4'   CD 0025'              	CALL	OUTSTR		;   opening the bottom row for the new line
  03D7'   C3 03FA'              	JMP	SC_ILT
                                
  03DA'                         SC_IL:
  03DA'   CD 0080'              	CALL	CHIDE
  03DD'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03E0'   3A 0B9E'              	LDA	SROW
  03E3'   47                    	MOV	B,A
  03E4'   0E 01                 	MVI	C,1
  03E6'   CD 0064'              	CALL	GOTOXY
  03E9'   21 0B18'              	LXI	H,SCSI		; ESC[<ILN>L (IL): ILN blank rows here, the rest
  03EC'   CD 0025'              	CALL	OUTSTR		;   shift down, and what falls past the region's
  03EF'   3A 0000*              	LDA	ILN		;   bottom row has scrolled off, which is right
  03F2'   CD 002F'              	CALL	EMITB
  03F5'   3E 4C                 	MVI	A,'L'
  03F7'   CD 0018'              	CALL	OUTCH
  03FA'                         SC_ILT:
                                	;--- the first row to draw.  IL opened ILN rows AT the cursor's row and
                                	;    everything above it stands, so the cursor's own row (0-based SROW-1)
                                	;    is where the drawing starts -- 'o', 'O' and a put leave the line
                                	;    above untouched.  ILABOV says the edit took text off that line (a
                                	;    mid-line <CR>, 'r<CR>'), and then it is drawn too. ---
  03FA'   3A 0B9E'              	LDA	SROW
  03FD'   3D                    	DCR	A		; B = the cursor's own row, the first opened one
  03FE'   47                    	MOV	B,A
  03FF'   3A 0000*              	LDA	ILABOV
  0402'   B7                    	ORA	A
  0403'   78                    	MOV	A,B
  0404'   CA 0408'              	JZ	SC_IL0
  0407'   3D                    	DCR	A		; the row above the cursor's, when it is stale
  0408'                         SC_IL0:
  0408'   B7                    	ORA	A		; ... clamped: the cursor may be on the top row
  0409'   F2 040D'              	JP	SC_IL1
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  040C'   AF                    	XRA	A
  040D'                         SC_IL1:
  040D'   32 0B98'              	STA	PROWN
  0410'   78                    	MOV	A,B		; the last row to draw: the opened ones start at
  0411'   21 0000*              	LXI	H,ILN		;   the cursor's row and there are ILN of them
  0414'   86                    	ADD	M
  0415'   3D                    	DCR	A
  0416'   47                    	MOV	B,A
  0417'   3A 0B58'              	LDA	NEDIT
  041A'   3D                    	DCR	A		; ... but never past the bottom edit row, which
  041B'   B8                    	CMP	B		;   is as far as the opened rows can be seen
  041C'   DA 0420'              	JC	SC_IL2
  041F'   78                    	MOV	A,B
  0420'                         SC_IL2:
  0420'   32 0B9D'              	STA	ILLAST
  0423'   CD 09C5'              	CALL	RDTOP
  0426'   3A 0B98'              	LDA	PROWN
  0429'   CD 0A23'              	CALL	RDSKIP		; the reader at that row's line
  042C'                         SC_ILL:
  042C'   CD 0443'              	CALL	SC_ILR
  042F'   3A 0B9D'              	LDA	ILLAST
  0432'   21 0B98'              	LXI	H,PROWN
  0435'   BE                    	CMP	M
  0436'   CA 043D'              	JZ	SC_ILD
  0439'   34                    	INR	M
  043A'   C3 042C'              	JMP	SC_ILL
  043D'                         SC_ILD:
  043D'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0440'   C3 0AE1'              	JMP	SCURS		; the cursor back on the text, and shown
                                
                                ;SC_ILR -- draw screen row PROWN from where the reader stands, cleared first.
  0443'                         SC_ILR:
  0443'   3A 0B98'              	LDA	PROWN
  0446'   3C                    	INR	A
  0447'   CD 008C'              	CALL	GOROW1
  044A'   C3 0A3C'              	JMP	PAINTR
                                
                                ;SCRNOK -- HL = candidate scroll count N.  Return A=N with CY=0 if N is in
                                ; 1..NEDIT-1 (there is on-screen overlap worth preserving); else CY=1 so the
                                ; caller full-repaints.  Clobbers A,B.
  044D'                         SCRNOK:
  044D'   7C                    	MOV	A,H
  044E'   B7                    	ORA	A
  044F'   C2 0464'              	JNZ	SRN_NO		; N >= 256
  0452'   7D                    	MOV	A,L
  0453'   B7                    	ORA	A
  0454'   CA 0464'              	JZ	SRN_NO		; N == 0
  0457'   47                    	MOV	B,A		; B = N
  0458'   3A 0B58'              	LDA	NEDIT
  045B'   B8                    	CMP	B		; CY iff NEDIT < N ; Z iff NEDIT == N
  045C'   DA 0464'              	JC	SRN_NO		; N > NEDIT
  045F'   CA 0464'              	JZ	SRN_NO		; N == NEDIT -> no overlap
  0462'   78                    	MOV	A,B		; A = N, CY=0 (from CMP: NEDIT > N)
  0463'   C9                    	RET
  0464'                         SRN_NO:
  0464'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0465'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  0466'                         SRGN:
  0466'   21 0B23'              	LXI	H,SRGP
  0469'   CD 0025'              	CALL	OUTSTR
  046C'   3A 0B58'              	LDA	NEDIT
  046F'   CD 002F'              	CALL	EMITB
  0472'   3E 72                 	MVI	A,'r'
  0474'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  0477'                         CURSC:
  0477'   2A 0B6E'              	LHLD	CURDCL
  047A'   CD 04A2'              	CALL	DIVN		; BC = rows into the line, A = the column
  047D'   3C                    	INR	A
  047E'   32 0B9F'              	STA	SCOL
  0481'   79                    	MOV	A,C
  0482'   32 0B69'              	STA	CSUB
  0485'   2A 0B70'              	LHLD	LYABV
  0488'   09                    	DAD	B
  0489'   23                    	INX	H
  048A'   7C                    	MOV	A,H		; (never past the edit rows: a line taller than
  048B'   B7                    	ORA	A		;   the screen shows its first rows only)
  048C'   3A 0B58'              	LDA	NEDIT
  048F'   C2 0497'              	JNZ	CS_SET
  0492'   BD                    	CMP	L		; CY iff NEDIT < the row
  0493'   DA 0497'              	JC	CS_SET
  0496'   7D                    	MOV	A,L
  0497'                         CS_SET:
  0497'   32 0B9E'              	STA	SROW
  049A'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  049B'                         XTRA:
  049B'   01 0000               	LXI	B,0
  049E'   7C                    	MOV	A,H
  049F'   B5                    	ORA	L
  04A0'   C8                    	RZ			; an empty line is one row
  04A1'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  04A2'                         DIVN:
  04A2'   3A 0B57'              	LDA	NCOLS
  04A5'   2F                    	CMA
  04A6'   5F                    	MOV	E,A
  04A7'   16 FF                 	MVI	D,0FFH
  04A9'   13                    	INX	D		; DE = -NCOLS
  04AA'   01 FFFF               	LXI	B,0FFFFH
  04AD'                         DV_LP:
  04AD'   03                    	INX	B
  04AE'   19                    	DAD	D		; CY while NCOLS still went into it
  04AF'   DA 04AD'              	JC	DV_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  04B2'   3A 0B57'              	LDA	NCOLS
  04B5'   85                    	ADD	L
  04B6'   C9                    	RET
                                
                                ;SCABRT -- RPOLL abort: a key arrived mid-repaint.  Leave the cursor hidden (the
                                ; SHIDE at SCFULL's head still holds) and return WITHOUT positioning/showing it,
                                ; so no cursor flash during a type-ahead burst.  The pending key is dispatched
                                ; next, then SCDRAW runs again and (when the ring finally drains) paints in full
                                ; and shows the cursor -- the aborted frame is simply superseded.
                                ; FORCEF is latched so the next SCDRAW repaints in FULL even if the pending key
                                ; is a pure motion (RENDER.md: an aborted frame stays dirty -- the fast path must
                                ; not be taken over a half-painted screen).
  04B7'                         SCABRT:
  04B7'   3E 01                 	MVI	A,1
  04B9'   32 0B61'              	STA	FORCEF
  04BC'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- WM MEASURE's placement (WM.ASM 3762): where the cursor's line sits
                                ; on the screen and what the screen holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), WFILL
                                ;   out: WINROW (clamped), SCRLN (lines the text moved up), TOPLEN (bytes from
                                ;        the top line's start to the cursor), CBOL (bytes from the cursor
                                ;        line's start), CURDCL, LYABV (rows above the cursor's line), TXEND and
                                ;        FILCH (the rows with no text, and what they show), SCBOT, SCEOF,
                                ;        SCBOF, WRAPF; WRLIM raised past the top (WM 3784); LNDLT and WFILL
                                ;        cleared.
                                ; WINROW is a count of LINES.  The rows come from measuring them: [top,
                                ; cursor) by pointer, the rest read forward until the rows are full -- never
                                ; to the end of a line the screen cannot hold.  When the lines above leave the
                                ; cursor's line no room, lines are given up at the top until it fits.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  04BD'                         LAYOUT:
  04BD'   2A 0000*              	LHLD	CMDCNT
  04C0'   22 0B89'              	SHLD	SVCNT
  04C3'   2A 0000*              	LHLD	AUXCNT
  04C6'   22 0B8B'              	SHLD	SVAUX
  04C9'   3A 0000*              	LDA	DIRFLG
  04CC'   32 0B8D'              	STA	SVDIR
  04CF'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  04D2'   32 0B74'              	STA	LYROW
  04D5'   32 0B85'              	STA	LYSVR
  04D8'   AF                    	XRA	A
  04D9'   32 0B83'              	STA	LYND
  04DC'   32 0B84'              	STA	LYPRF
  04DF'   3A 0B68'              	LDA	WFILL		; a line the command placed stays where it was
  04E2'   B7                    	ORA	A		;   put; one that only moved is asked about
  04E3'   CC 08BD'              	CZ	LYFAR
  04E6'   2A 0000*              	LHLD	LNDLT
  04E9'   22 0B72'              	SHLD	LYDLT
  04EC'   21 0000               	LXI	H,0
  04EF'   22 0000*              	SHLD	LNDLT
  04F2'   3A 0B68'              	LDA	WFILL
  04F5'   FE 02                 	CPI	WF_MID
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  04F7'   CA 0501'              	JZ	LY_MD
  04FA'   3A 0B83'              	LDA	LYND
  04FD'   B7                    	ORA	A
  04FE'   CA 0504'              	JZ	LY_NM
  0501'                         LY_MD:
  0501'   CD 0709'              	CALL	LYMID		; LYROW = the lines that puts above it
  0504'                         LY_NM:
  0504'   AF                    	XRA	A
  0505'   32 0B68'              	STA	WFILL
  0508'                         LY_TOP:
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  0508'   3A 0B74'              	LDA	LYROW
  050B'   6F                    	MOV	L,A
  050C'   26 00                 	MVI	H,0
  050E'   CD 0000*              	CALL	LINPSB		; HL = that line's start (paged back if needed)
  0511'   EB                    	XCHG
  0512'   2A 0000*              	LHLD	GAPBEG
  0515'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  0518'   22 0B6A'              	SHLD	TOPLEN
  051B'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  051C'   22 0000*              	SHLD	WRLIM
                                	;--- [top, GAPBEG): the lines above, each as many rows as it is wide;
                                	;    what is left over is the cursor's line, up to the cursor ---
  051F'   21 0000               	LXI	H,0
  0522'   22 0B70'              	SHLD	LYABV
  0525'   AF                    	XRA	A
  0526'   32 0B74'              	STA	LYROW		; (counted again: the file may start sooner)
  0529'   CD 086C'              	CALL	LYTOPP		; HL = top, BC = bytes to the cursor
  052C'                         LY_ABV:
  052C'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  052D'   CD 0878'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0530'   D2 054A'              	JNC	LY_ABD
  0533'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0534'   C5                    	PUSH	B
  0535'   EB                    	XCHG
  0536'   CD 049B'              	CALL	XTRA		; BC = the rows it takes past its first
  0539'   2A 0B70'              	LHLD	LYABV
  053C'   09                    	DAD	B
  053D'   23                    	INX	H
  053E'   22 0B70'              	SHLD	LYABV
  0541'   21 0B74'              	LXI	H,LYROW
  0544'   34                    	INR	M
  0545'   C1                    	POP	B
  0546'   E1                    	POP	H
  0547'   C3 052C'              	JMP	LY_ABV
  054A'                         LY_ABD:
  054A'   EB                    	XCHG
  054B'   22 0B6E'              	SHLD	CURDCL
  054E'   E1                    	POP	H
  054F'   22 0B6C'              	SHLD	CBOL
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  0552'   AF                    	XRA	A
  0553'   32 0B67'              	STA	SCBOF
  0556'   CD 086C'              	CALL	LYTOPP		; HL = top
  0559'   CD 06FB'              	CALL	ISBOF
  055C'   C2 0563'              	JNZ	LY_CUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  055F'   3C                    	INR	A
  0560'   32 0B67'              	STA	SCBOF
  0563'                         LY_CUR:
                                	;--- the cursor's own row: LYABV + the rows of its line before it ---
  0563'   AF                    	XRA	A
  0564'   32 0B66'              	STA	SCEOF
  0567'   32 0B78'              	STA	LYEND
  056A'   32 0B87'              	STA	LYXE
  056D'   3E 7E                 	MVI	A,'~'
  056F'   32 0B65'              	STA	FILCH
  0572'   2A 0B6E'              	LHLD	CURDCL
  0575'   CD 04A2'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0578'   5F                    	MOV	E,A
  0579'   3A 0B6E'              	LDA	CURDCL
  057C'   93                    	SUB	E
  057D'   32 0B7A'              	STA	LYVB		; the column the cursor's row starts at
  0580'   2A 0B70'              	LHLD	LYABV
  0583'   7D                    	MOV	A,L
  0584'   32 0B79'              	STA	LYLST		; (its line starts on this row)
  0587'   09                    	DAD	B		; HL = the cursor's row
  0588'   3A 0B58'              	LDA	NEDIT
  058B'   4F                    	MOV	C,A
  058C'   7C                    	MOV	A,H
  058D'   B7                    	ORA	A
  058E'   C2 0596'              	JNZ	LY_OFF
  0591'   7D                    	MOV	A,L
  0592'   B9                    	CMP	C		; CY iff it is one of the edit rows
  0593'   DA 05DC'              	JC	LY_FW0
  0596'                         LY_OFF:
                                	;--- it is below them: give up lines at the top, as few as will do ---
  0596'   3A 0B74'              	LDA	LYROW
  0599'   B7                    	ORA	A
  059A'   CA 0608'              	JZ	LY_TAL		; there are none: the line is taller than the screen
  059D'   59                    	MOV	E,C
  059E'   1D                    	DCR	E
  059F'   16 00                 	MVI	D,0
  05A1'   CD 0000*              	CALL	SUBHD		; HL = the rows too many
  05A4'   22 0B75'              	SHLD	LYNEED
  05A7'   CD 086C'              	CALL	LYTOPP
  05AA'                         LY_DRP:
  05AA'   CD 0878'              	CALL	LNW		; the top line: DE = its width
  05AD'   E5                    	PUSH	H
  05AE'   C5                    	PUSH	B
  05AF'   EB                    	XCHG
  05B0'   CD 049B'              	CALL	XTRA
  05B3'   03                    	INX	B		; BC = its rows
  05B4'   2A 0B75'              	LHLD	LYNEED
  05B7'   7D                    	MOV	A,L
  05B8'   91                    	SUB	C
  05B9'   6F                    	MOV	L,A
  05BA'   7C                    	MOV	A,H
  05BB'   98                    	SBB	B
  05BC'   67                    	MOV	H,A
  05BD'   22 0B75'              	SHLD	LYNEED
  05C0'   C1                    	POP	B
  05C1'   21 0B74'              	LXI	H,LYROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  05C4'   35                    	DCR	M		; one line fewer above the cursor's
  05C5'   E1                    	POP	H		; (keeps the flags)
  05C6'   CA 0508'              	JZ	LY_TOP		; that was the last of them
  05C9'   3A 0B76'              	LDA	LYNEED+1
  05CC'   B7                    	ORA	A
  05CD'   FA 0508'              	JM	LY_TOP		; room enough
  05D0'   E5                    	PUSH	H
  05D1'   2A 0B75'              	LHLD	LYNEED
  05D4'   B5                    	ORA	L
  05D5'   E1                    	POP	H
  05D6'   C2 05AA'              	JNZ	LY_DRP
  05D9'   C3 0508'              	JMP	LY_TOP
  05DC'                         LY_FW0:
                                	;--- forward: the rest of the cursor's line and the lines below, until
                                	;    the rows are full.  D = the row being filled, E = cells used in it. ---
  05DC'   55                    	MOV	D,L
  05DD'   CD 0000*              	CALL	RGET0
  05E0'                         LY_FWD:
  05E0'   CD 06A0'              	CALL	FLINE
  05E3'   B7                    	ORA	A
  05E4'   FA 0627'              	JM	LY_EOF
  05E7'   CA 060E'              	JZ	LY_FLF
  05EA'   3A 0B78'              	LDA	LYEND		; a row the screen has not got:
  05ED'   B7                    	ORA	A
  05EE'   C2 05FD'              	JNZ	LY_CUT
  05F1'   21 0B74'              	LXI	H,LYROW		; the cursor's own line needs it: give up a
  05F4'   7E                    	MOV	A,M		;   line at the top and measure again
  05F5'   B7                    	ORA	A
  05F6'   CA 0608'              	JZ	LY_TAL
  05F9'   35                    	DCR	M
  05FA'   C3 0508'              	JMP	LY_TOP
  05FD'                         LY_CUT:
  05FD'   3E 40                 	MVI	A,'@'		; a line under it does not: it is not shown, and
  05FF'   32 0B65'              	STA	FILCH		;   the rows it would have started on say so
  0602'   3A 0B79'              	LDA	LYLST
  0605'   C3 063F'              	JMP	LY_END
  0608'                         LY_TAL:
  0608'   3A 0B58'              	LDA	NEDIT		; a line taller than the screen: its first rows
  060B'   C3 063F'              	JMP	LY_END
  060E'                         LY_FLF:
  060E'   CD 089A'              	CALL	LYLEND		; that line's rows are counted
  0611'   3A 0B58'              	LDA	NEDIT
  0614'   BA                    	CMP	D
  0615'   C2 05E0'              	JNZ	LY_FWD
  0618'   CD 0000*              	CALL	RDGET		; rows full: is the text over right there?
  061B'   D2 0623'              	JNC	LY_FUL
  061E'   3E 01                 	MVI	A,1
  0620'   32 0B66'              	STA	SCEOF
  0623'                         LY_FUL:
  0623'   7A                    	MOV	A,D
  0624'   C3 063F'              	JMP	LY_END
  0627'                         LY_EOF:
  0627'   3E 01                 	MVI	A,1
  0629'   32 0B66'              	STA	SCEOF
  062C'   3A 0B78'              	LDA	LYEND		; text after the last line end -- or no line end
  062F'   B7                    	ORA	A		;   at all -- is a line too
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0630'   CA 063B'              	JZ	LY_EO1
  0633'   3A 0B88'              	LDA	LYLAST
  0636'   FE 0A                 	CPI	LF
  0638'   CA 063E'              	JZ	LY_EO2
  063B'                         LY_EO1:
  063B'   CD 089A'              	CALL	LYLEND
  063E'                         LY_EO2:
  063E'   7A                    	MOV	A,D
  063F'                         LY_END:
  063F'   32 0B64'              	STA	TXEND		; the first row with no text on it
  0642'   3A 0B78'              	LDA	LYEND		; below = the lines that ended, less the cursor's
  0645'   D6 01                 	SUI	1
  0647'   CE 00                 	ACI	0
  0649'   32 0B77'              	STA	LYBLW
  064C'   3A 0B74'              	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
  064F'   21 0B77'              	LXI	H,LYBLW
  0652'   86                    	ADD	M
  0653'   32 0B63'              	STA	SCBOT
                                	;--- WRAPF: more rows of text than lines, or a line cut off ---
  0656'   3C                    	INR	A
  0657'   21 0B64'              	LXI	H,TXEND
  065A'   96                    	SUB	M
  065B'   21 0B65'              	LXI	H,FILCH
  065E'   C2 0669'              	JNZ	LY_W1
  0661'   7E                    	MOV	A,M
  0662'   FE 7E                 	CPI	'~'
