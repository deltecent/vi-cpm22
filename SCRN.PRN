  0759'   79                    	MOV	A,C
  075A'   32 0D3E'              	STA	CSRAW		; the row of its line the cursor is on
  075D'   3A 0D33'              	LDA	WINROW
  0760'   CD 04BC'              	CALL	SUMT
  0763'   6F                    	MOV	L,A
  0764'   26 00                 	MVI	H,0
  0766'   22 0D3C'              	SHLD	LYABV
  0769'   3A 0000*              	LDA	HTCUR
  076C'   CD 08F6'              	CALL	HTE
  076F'   7E                    	MOV	A,M
  0770'   32 0D3F'              	STA	LYTSH
  0773'   23                    	INX	H
  0774'   46                    	MOV	B,M
  0775'   3A 0D33'              	LDA	WINROW
  0778'   21 0D3B'              	LXI	H,SCBOT
  077B'   BE                    	CMP	M		; CY iff a line shows under it
  077C'   3E 00                 	MVI	A,0
  077E'   D2 0782'              	JNC	LQK_1
  0781'   78                    	MOV	A,B
  0782'                         LQK_1:
  0782'   32 0D40'              	STA	NXTR
  0785'   CD 0000*              	CALL	RGET0		; the char under the cursor in memory (TABCUR)
  0788'   E5                    	PUSH	H
  0789'   CD 07C1'              	CALL	LQMV
  078C'   E1                    	POP	H
  078D'   C2 0795'              	JNZ	LQK_E
  0790'   CD 0000*              	CALL	RDGET
  0793'   37                    	STC
  0794'   C9                    	RET
                                	;--- the line changed: the rest of it, as HTBLD reads it ---
  0795'                         LQK_E:
  0795'   3A 0D5A'              	LDA	LQKC
  0798'   5F                    	MOV	E,A
  0799'   3A 0D69'              	LDA	CURDCL
  079C'   93                    	SUB	E
  079D'   32 0D70'              	STA	LYVB
  07A0'   3A 0D3E'              	LDA	CSRAW
  07A3'   57                    	MOV	D,A
