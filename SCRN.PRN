  095F'   3C                    	INR	A
  0960'   CA 0857'              	JZ	LQK_N		; (no room for it)
  0963'   3A 0FA9'              	LDA	LQKC
  0966'   5F                    	MOV	E,A
  0967'   3A 0FB8'              	LDA	CURDCL
  096A'   93                    	SUB	E
  096B'   32 0FBF'              	STA	LYVB
  096E'   3A 0F8D'              	LDA	CSRAW
  0971'   57                    	MOV	D,A
  0972'   CD 0000*              	CALL	RGET0
  0975'   CD 0B42'              	CALL	LM_FL		; D = its last row
  0978'   F5                    	PUSH	PSW
  0979'   FE 01                 	CPI	1
