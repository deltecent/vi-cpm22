	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the RINTENT fast paths
                                ; (cursor-only, region scroll up/down, one-row redraw, ICH insert, DL line
                                ; delete), the RPOLL repaint abort, and the message row.  The region scrolls
                                ; take their line count from SCRLN, the number of lines the text moved up this
                                ; frame.  Every fast path but the cursor-only one takes a line to be a row, so
                                ; none is used while a wrapped line is on the screen (WRAPF).
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, WFILL  (last layout's facts; fill request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	WFILL			; request: pull text down rather than show '~'
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                
  0002                          WR_EOL	EQU	2		; WRAPF from here up: the cursor has a row to itself
  0002                          WF_MID	EQU	2		; WFILL: the cursor's line in the middle of the screen
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0A43'              	LXI	H,SHIDE
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0A51'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0A2B'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PTROW -- paint the line at row PROWN and step to the row under it: clear the
                                ; row, write the line (on as many rows as it takes), CR/LF (the last LF of a
                                ; full repaint lands on the message row, and a backward scroll's N <= NEDIT-1
                                ; keeps it inside the region), and count the row off.  Both paint loops are
                                ; this, once each.  When the cursor has a row to itself (WR_EOL) that row is
                                ; the one under its line's text, and is cleared and counted here as well.
  0098'                         PTROW:
  0098'   CD 0092'              	CALL	CEKL		; ESC[K -- clear the row
  009B'   CD 0957'              	CALL	PAINTR
  009E'   CD 00B3'              	CALL	PT_NL
  00A1'   3A 0A78'              	LDA	WRAPF
  00A4'   FE 02                 	CPI	WR_EOL
  00A6'   D8                    	RC
  00A7'   3A 0AB4'              	LDA	SROW
  00AA'   3D                    	DCR	A
  00AB'   21 0AAE'              	LXI	H,PROWN
  00AE'   BE                    	CMP	M
  00AF'   C0                    	RNZ
  00B0'   CD 0092'              	CALL	CEKL
  00B3'                         PT_NL:
  00B3'   3E 0D                 	MVI	A,CR
  00B5'   CD 0018'              	CALL	OUTCH
  00B8'   3E 0A                 	MVI	A,LF
  00BA'   CD 0018'              	CALL	OUTCH
  00BD'   21 0AAE'              	LXI	H,PROWN
  00C0'   34                    	INR	M
  00C1'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  00C2'                         GOTOP:
  00C2'   06 01                 	MVI	B,1
  00C4'   0E 01                 	MVI	C,1
  00C6'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  00C9'                         SCINIT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'   21 0000               	LXI	H,0
  00CC'   22 0A74'              	SHLD	WINROW
  00CF'   21 0A1C'              	LXI	H,SPROBE
  00D2'   CD 0025'              	CALL	OUTSTR
  00D5'   CD 0120'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  00D8'   3A 0A71'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  00DB'   3D                    	DCR	A
  00DC'   32 0A73'              	STA	NEDIT
  00DF'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  00E0'                         RDB:
  00E0'   21 0000               	LXI	H,0
  00E3'                         RDB_LP:
  00E3'   E5                    	PUSH	H
  00E4'   CD 0000'              	CALL	BCONST
  00E7'   E1                    	POP	H
  00E8'   B7                    	ORA	A
  00E9'   C2 00F4'              	JNZ	RDB_GO
  00EC'   2B                    	DCX	H
  00ED'   7C                    	MOV	A,H
  00EE'   B5                    	ORA	L
  00EF'   C2 00E3'              	JNZ	RDB_LP
  00F2'   37                    	STC			; timeout
  00F3'   C9                    	RET
  00F4'                         RDB_GO:
  00F4'   CD 0008'              	CALL	BCONIN
  00F7'   B7                    	ORA	A		; CY=0, A=byte
  00F8'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  00F9'                         RDNUM:
  00F9'   11 0000               	LXI	D,0
  00FC'                         RN_LP:
  00FC'   D5                    	PUSH	D
  00FD'   CD 00E0'              	CALL	RDB
  0100'   D1                    	POP	D
  0101'   D8                    	RC
  0102'   FE 30                 	CPI	'0'
  0104'   DA 011E'              	JC	RN_DN
  0107'   FE 3A                 	CPI	'9'+1
  0109'   D2 011E'              	JNC	RN_DN
  010C'   D6 30                 	SUI	'0'
  010E'   4F                    	MOV	C,A		; C = this digit
  010F'   62                    	MOV	H,D		; HL = value
  0110'   6B                    	MOV	L,E
  0111'   29                    	DAD	H		; 2x
  0112'   54                    	MOV	D,H
  0113'   5D                    	MOV	E,L		; DE = 2x
  0114'   29                    	DAD	H		; 4x
  0115'   29                    	DAD	H		; 8x
  0116'   19                    	DAD	D		; 10x
  0117'   06 00                 	MVI	B,0		; BC = digit
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0119'   09                    	DAD	B		; HL = 10x + digit
  011A'   EB                    	XCHG			; DE = new value
  011B'   C3 00FC'              	JMP	RN_LP
  011E'                         RN_DN:
  011E'   B7                    	ORA	A		; CY=0, A = terminator
  011F'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0120'                         RDNUMS:
  0120'   CD 00E0'              	CALL	RDB
  0123'   D8                    	RC
  0124'   FE 1B                 	CPI	ESC
  0126'   C0                    	RNZ			; not what a DSR reply looks like
  0127'   CD 00E0'              	CALL	RDB
  012A'   D8                    	RC
  012B'   FE 5B                 	CPI	'['
  012D'   C0                    	RNZ			; not what a DSR reply looks like
  012E'   CD 00F9'              	CALL	RDNUM		; DE = rows
  0131'   D8                    	RC
  0132'   FE 3B                 	CPI	';'
  0134'   C0                    	RNZ			; not what a DSR reply looks like
  0135'   EB                    	XCHG
  0136'   22 0AB6'              	SHLD	TMPR
  0139'   CD 00F9'              	CALL	RDNUM		; DE = cols
  013C'   D8                    	RC
  013D'   FE 52                 	CPI	'R'
  013F'   C0                    	RNZ			; not what a DSR reply looks like
  0140'   EB                    	XCHG
  0141'   22 0AB8'              	SHLD	TMPC
  0144'   2A 0AB6'              	LHLD	TMPR		; rows -> clamp [24,200]
  0147'   06 18                 	MVI	B,24
  0149'   0E C8                 	MVI	C,200
  014B'   CD 015F'              	CALL	CLAMP
  014E'   32 0A71'              	STA	NROWS
  0151'   2A 0AB8'              	LHLD	TMPC		; cols -> clamp [80,132]
  0154'   06 50                 	MVI	B,80
  0156'   0E 84                 	MVI	C,132
  0158'   CD 015F'              	CALL	CLAMP
  015B'   32 0A72'              	STA	NCOLS
  015E'                         RS_BAD:
  015E'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  015F'                         CLAMP:
  015F'   7C                    	MOV	A,H
  0160'   B7                    	ORA	A
  0161'   C2 0172'              	JNZ	CLP_MAX		; value > 255 -> max
  0164'   7D                    	MOV	A,L
  0165'   B8                    	CMP	B
  0166'   DA 0170'              	JC	CLP_MIN		; value < min
  0169'   79                    	MOV	A,C
  016A'   BD                    	CMP	L		; CY iff max < value
  016B'   DA 0172'              	JC	CLP_MAX
  016E'   7D                    	MOV	A,L
  016F'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0170'                         CLP_MIN:
  0170'   78                    	MOV	A,B
  0171'   C9                    	RET
  0172'                         CLP_MAX:
  0172'   79                    	MOV	A,C
  0173'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- snapshot what is on the screen (WINROW/WRAPF) into OLDWR/OLDWF.  The
                                ; main loop calls this after reading a key and before dispatch, so SCDRAW can
                                ; tell how far the text moved (SCRLN) and whether a line was wrapped.
  0174'                         SCPRE:
  0174'   2A 0A74'              	LHLD	WINROW
  0177'   22 0A76'              	SHLD	OLDWR
  017A'   3A 0A78'              	LDA	WRAPF
  017D'   32 0A79'              	STA	OLDWF
  0180'   C9                    	RET
                                
  0181'                         SCDRAW:
  0181'   CD 04B9'              	CALL	LAYOUT		; WINROW/SCRLN/SCBOT/CURDCL/WRAPF (no output)
  0184'   CD 0477'              	CALL	CURSC		; SROW/SCOL
  0187'   3A 0A7C'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  018A'   B7                    	ORA	A
  018B'   C2 0272'              	JNZ	SCFULL
  018E'   3A 0A78'              	LDA	WRAPF		; the wrapping on this screen, or on the last
  0191'   21 0A79'              	LXI	H,OLDWF
  0194'   B6                    	ORA	M
  0195'   47                    	MOV	B,A
  0196'   FE 02                 	CPI	WR_EOL		; a row only the cursor holds came or went: the
  0198'   D2 0272'              	JNC	SCFULL		;   lines under it moved, whatever the key was
  019B'   3A 0000*              	LDA	RINTENT
  019E'   FE 01                 	CPI	R_MOVE
  01A0'   C2 01AB'              	JNZ	SC_WR
  01A3'   2A 0A7A'              	LHLD	SCRLN
  01A6'   7C                    	MOV	A,H
  01A7'   B5                    	ORA	L
  01A8'   CA 09FC'              	JZ	SCURS		; text still -> cursor only, wrapped or not
  01AB'                         SC_WR:
  01AB'   78                    	MOV	A,B		; every paint from here on takes a line to be a
  01AC'   B7                    	ORA	A		;   row: a wrapped one on the screen -> repaint
  01AD'   C2 0272'              	JNZ	SCFULL
  01B0'   3A 0000*              	LDA	RINTENT
  01B3'   FE 01                 	CPI	R_MOVE
  01B5'   CA 01FB'              	JZ	SC_MV
  01B8'   FE 02                 	CPI	R_LINE
  01BA'   CA 01D1'              	JZ	SC_ED
  01BD'   FE 04                 	CPI	R_ICH
  01BF'   CA 01D1'              	JZ	SC_ED
  01C2'   FE 05                 	CPI	R_ILIN
  01C4'   CA 03B2'              	JZ	SC_ILQ		; (its own test: it moves the cursor's row, and
  01C7'   FE 03                 	CPI	R_DLIN		;   on the bottom row it scrolls the text too)
  01C9'   CA 01D1'              	JZ	SC_ED
  01CC'   FE 06                 	CPI	R_JOIN
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01CE'   C2 0272'              	JNZ	SCFULL		; anything else -> full repaint
  01D1'                         SC_ED:
                                	;--- the in-place edit paints need the text to have stayed put ---
  01D1'   2A 0A7A'              	LHLD	SCRLN
  01D4'   7C                    	MOV	A,H
  01D5'   B5                    	ORA	L
  01D6'   C2 0272'              	JNZ	SCFULL
  01D9'   2A 0A76'              	LHLD	OLDWR
  01DC'   EB                    	XCHG
  01DD'   2A 0A74'              	LHLD	WINROW
  01E0'   CD 0000*              	CALL	CMP16		; Z iff the cursor kept its row
  01E3'   C2 0272'              	JNZ	SCFULL
  01E6'   3A 0000*              	LDA	RINTENT
  01E9'   FE 02                 	CPI	R_LINE
  01EB'   CA 0260'              	JZ	SC_LNBD
  01EE'   FE 04                 	CPI	R_ICH
  01F0'   CA 0222'              	JZ	SC_ICH
  01F3'   FE 06                 	CPI	R_JOIN
  01F5'   CA 035A'              	JZ	SC_JN
  01F8'   C3 0381'              	JMP	SCDL
  01FB'                         SC_MV:
                                	;--- R_MOVE: the text moved up SCRLN lines (down if negative) ---
  01FB'   2A 0A7A'              	LHLD	SCRLN
  01FE'   7C                    	MOV	A,H
  01FF'   B7                    	ORA	A
  0200'   F2 0216'              	JP	SC_FWD
  0203'   EB                    	XCHG
  0204'   21 0000               	LXI	H,0
  0207'   CD 0000*              	CALL	SUBHD		; HL = -SCRLN
  020A'   CD 044D'              	CALL	SCRNOK		; A = N (CY=0) if 1..NEDIT-1, else CY=1
  020D'   DA 0272'              	JC	SCFULL
  0210'   32 0AAF'              	STA	SCLN
  0213'   C3 0313'              	JMP	SCBWD
  0216'                         SC_FWD:
  0216'   CD 044D'              	CALL	SCRNOK
  0219'   DA 0272'              	JC	SCFULL
  021C'   32 0AAF'              	STA	SCLN		; N in 1..NEDIT-1 -> region scroll
  021F'   C3 02CC'              	JMP	SCFWD
  0222'                         SC_ICH:
                                	;--- the inserted char sits at screen column SCOL-1; it must be a real
                                	;    on-screen cell (SCOL >= 2), else fall back to the whole-line redraw ---
  0222'   3A 0AB5'              	LDA	SCOL
  0225'   FE 02                 	CPI	2
  0227'   DA 0260'              	JC	SC_LNBD
                                	;--- appended at the row's end (ICHAPP): the cell is blank and nothing
                                	;    follows it, so the char alone is the whole frame -- no ICH to open a
                                	;    cell for it, and no hide/show, there being nothing to see happen
                                	;    between the address and the byte.  The terminal leaves the cursor at
                                	;    SCOL, where insert mode wants it, exactly as the ICH path does. ---
  022A'   3A 0000*              	LDA	ICHAPP
  022D'   B7                    	ORA	A
  022E'   C2 0246'              	JNZ	SC_ICA
  0231'   CD 0080'              	CALL	CHIDE
  0234'   CD 024C'              	CALL	SC_ICG		; address the inserted char's cell (SROW, SCOL-1)
  0237'   21 0A39'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  023A'   CD 0025'              	CALL	OUTSTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  023D'   CD 0258'              	CALL	SC_ICC		; fills the opened cell; cursor advances to SCOL
  0240'   21 0A4A'              	LXI	H,SSHOW
  0243'   C3 0025'              	JMP	OUTSTR
  0246'                         SC_ICA:
  0246'   CD 024C'              	CALL	SC_ICG
  0249'   C3 0258'              	JMP	SC_ICC
                                ;SC_ICG -- address the inserted char's cell, (SROW, SCOL-1).
  024C'                         SC_ICG:
  024C'   3A 0AB4'              	LDA	SROW
  024F'   47                    	MOV	B,A
  0250'   3A 0AB5'              	LDA	SCOL
  0253'   3D                    	DCR	A
  0254'   4F                    	MOV	C,A
  0255'   C3 0064'              	JMP	GOTOXY
                                ;SC_ICC -- emit the just-inserted byte, which is right before the gap.
  0258'                         SC_ICC:
  0258'   2A 0000*              	LHLD	GAPBEG
  025B'   2B                    	DCX	H
  025C'   7E                    	MOV	A,M
  025D'   C3 0018'              	JMP	OUTCH
  0260'                         SC_LNBD:
                                	;--- R_LINE: redraw only the cursor's row (tabs re-expanded), then
                                	;    re-address and show the cursor ---
  0260'   CD 0080'              	CALL	CHIDE
  0263'   3A 0AB4'              	LDA	SROW
  0266'   CD 008C'              	CALL	GOROW1		; column 1 of the current row, cleared
  0269'   CD 08E6'              	CALL	RDBOL		; read from the cursor line's first byte
  026C'   CD 0967'              	CALL	PROW
  026F'   C3 09FC'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place (home + CR,LF stepping), each
                                ; cleared with ESC[K; a line takes as many rows as it is wide, and the rows
                                ; past the text show '~' (or '@').  No ESC[2J (no blank flash).
                                ; Message row last; cursor hidden throughout, then addressed and shown.
  0272'                         SCFULL:
  0272'   CD 0080'              	CALL	CHIDE
  0275'   CD 08E0'              	CALL	RDTOP
  0278'   CD 00C2'              	CALL	GOTOP		; home to row 1
  027B'   AF                    	XRA	A
  027C'   32 0AAE'              	STA	PROWN
  027F'                         ROW_LP:
  027F'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abort this repaint
  0282'   B7                    	ORA	A
  0283'   C2 04B3'              	JNZ	SCABRT
  0286'   3A 0A73'              	LDA	NEDIT
  0289'   47                    	MOV	B,A
  028A'   3A 0AAE'              	LDA	PROWN
  028D'   B8                    	CMP	B
  028E'   D2 0297'              	JNC	ROWS_DN
  0291'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0294'   C3 027F'              	JMP	ROW_LP
  0297'                         ROWS_DN:
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  0297'   CD 0092'              	CALL	CEKL
  029A'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  029C'   32 0A7D'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  029F'   CD 09FC'              	CALL	SCURS
  02A2'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  02A3'   32 0A7C'              	STA	FORCEF
  02A6'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  02A7'                         EXPRM:
  02A7'   F5                    	PUSH	PSW
  02A8'   3A 0000*              	LDA	EDMODE
  02AB'   32 0A7D'              	STA	OEDMOD
  02AE'   3A 0A71'              	LDA	NROWS
  02B1'   CD 008C'              	CALL	GOROW1
  02B4'   F1                    	POP	PSW
  02B5'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  02B8'                         EXRUB:
  02B8'   21 02BE'              	LXI	H,SRUB
  02BB'   C3 0025'              	JMP	OUTSTR
  02BE'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  02C2'                         EXMSG:
  02C2'   7E                    	MOV	A,M
  02C3'   23                    	INX	H
  02C4'   E5                    	PUSH	H
  02C5'   CD 02A7'              	CALL	EXPRM
  02C8'   E1                    	POP	H
  02C9'   C3 0025'              	JMP	OUTSTR
                                
                                ;SCFWD -- the text moved up N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows (message row protected), then N times:
                                ; delete the top region row (ESC[M) -- the terminal scrolls the region up one
                                ; line -- and draw the newly exposed row into row NEDIT.  Only the N exposed
                                ; rows (NEDIT-N .. NEDIT-1) are drawn; the overlap the terminal shifted is never
                                ; re-sent.  Short and bounded, so it runs to completion (no RPOLL abort).
  02CC'                         SCFWD:
  02CC'   CD 0080'              	CALL	CHIDE
  02CF'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  02D2'   CD 08E0'              	CALL	RDTOP
  02D5'   3A 0AAF'              	LDA	SCLN
  02D8'   47                    	MOV	B,A
  02D9'   3A 0A73'              	LDA	NEDIT
  02DC'   90                    	SUB	B		; A = NEDIT - N = first exposed row
  02DD'   32 0AAE'              	STA	PROWN
  02E0'   CD 093E'              	CALL	RDSKIP		; reader at that row's line
  02E3'                         SFW_LP:
  02E3'   3A 0AAF'              	LDA	SCLN
  02E6'   B7                    	ORA	A
  02E7'   CA 030D'              	JZ	SFW_DN
  02EA'   CD 00C2'              	CALL	GOTOP		; region top row
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02ED'   21 0A2F'              	LXI	H,SDL		; ESC[M (DL) at the top: region scrolls up 1
  02F0'   CD 0025'              	CALL	OUTSTR
  02F3'   3A 0A73'              	LDA	NEDIT		; draw the exposed row into the bottom edit row
  02F6'   CD 008C'              	CALL	GOROW1		; ... addressed and cleared
  02F9'   CD 0957'              	CALL	PAINTR
  02FC'   3A 0AAE'              	LDA	PROWN
  02FF'   3C                    	INR	A
  0300'   32 0AAE'              	STA	PROWN
  0303'   3A 0AAF'              	LDA	SCLN
  0306'   3D                    	DCR	A
  0307'   32 0AAF'              	STA	SCLN
  030A'   C3 02E3'              	JMP	SFW_LP
  030D'                         SFW_DN:
  030D'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0310'   C3 09FC'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCBWD -- the text moved down N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows, Reverse-Index (ESC M) N times at the
                                ; region top -- the terminal scrolls the region down, opening N blank rows at
                                ; the top -- then draw rows 0..N-1 from the top line down.
  0313'                         SCBWD:
  0313'   CD 0080'              	CALL	CHIDE
  0316'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0319'   3A 0AAF'              	LDA	SCLN
  031C'   32 0AB2'              	STA	ROWCT
  031F'                         SBW_RI:
  031F'   3A 0AB2'              	LDA	ROWCT
  0322'   B7                    	ORA	A
  0323'   CA 0339'              	JZ	SBW_PT
  0326'   CD 00C2'              	CALL	GOTOP		; region top row
  0329'   21 0A36'              	LXI	H,SRI		; ESC M (RI) at the top: region scrolls down 1
  032C'   CD 0025'              	CALL	OUTSTR
  032F'   3A 0AB2'              	LDA	ROWCT
  0332'   3D                    	DCR	A
  0333'   32 0AB2'              	STA	ROWCT
  0336'   C3 031F'              	JMP	SBW_RI
  0339'                         SBW_PT:
  0339'   CD 08E0'              	CALL	RDTOP
  033C'   AF                    	XRA	A
  033D'   32 0AAE'              	STA	PROWN
  0340'   CD 00C2'              	CALL	GOTOP
  0343'                         SBW_LP:
  0343'   3A 0AAF'              	LDA	SCLN
  0346'   47                    	MOV	B,A
  0347'   3A 0AAE'              	LDA	PROWN
  034A'   B8                    	CMP	B
  034B'   D2 0354'              	JNC	SBW_DN
  034E'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0351'   C3 0343'              	JMP	SBW_LP
  0354'                         SBW_DN:
  0354'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0357'   C3 09FC'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCDL -- R_DLIN: a single line was deleted at the cursor's row (dd, not the last
                                ; line).  Delete that screen row (ESC[M at SROW, region-clamped so the message row
                                ; is safe) -- the rows below shift up and a blank opens at row NEDIT -- then draw
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


                                ; the bottom row and re-address the cursor (which kept
                                ; its row, now at the BOL of the line that shifted up).
                                ;SC_JN -- R_JOIN: the line below was joined onto the cursor's.  That row now
                                ; holds both, and the row under it is gone -- so redraw the cursor's row, then
                                ; hand the rest to SCDL, which deletes a row and draws the one the shift
                                ; exposes at the bottom.  With the cursor on the LAST edit row there is no row
                                ; under it on the screen at all: the join took a line that was never shown, and
                                ; only the cursor's own row is stale (vim redraws just that row there too).
  035A'                         SC_JN:
  035A'   3A 0AB4'              	LDA	SROW
  035D'   47                    	MOV	B,A
  035E'   3A 0A73'              	LDA	NEDIT
  0361'   B8                    	CMP	B		; CY iff NEDIT < SROW; Z iff the bottom edit row
  0362'   CA 0260'              	JZ	SC_LNBD
  0365'   DA 0260'              	JC	SC_LNBD
  0368'   CD 0080'              	CALL	CHIDE
  036B'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  036E'   3A 0AB4'              	LDA	SROW		; the joined line, redrawn where it stands
  0371'   CD 008C'              	CALL	GOROW1
  0374'   CD 08E6'              	CALL	RDBOL
  0377'   CD 0967'              	CALL	PROW
  037A'   3A 0AB4'              	LDA	SROW
  037D'   3C                    	INR	A		; ... and the row under it goes
  037E'   C3 038A'              	JMP	SCDL2
                                
  0381'                         SCDL:
  0381'   CD 0080'              	CALL	CHIDE
  0384'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0387'   3A 0AB4'              	LDA	SROW		; delete the cursor's row
  038A'                         SCDL2:
  038A'   47                    	MOV	B,A
  038B'   0E 01                 	MVI	C,1
  038D'   CD 0064'              	CALL	GOTOXY
  0390'   21 0A2F'              	LXI	H,SDL		; ESC[M (DL): rows below shift up, blank at NEDIT
  0393'   CD 0025'              	CALL	OUTSTR
  0396'   CD 08E0'              	CALL	RDTOP
  0399'   3A 0A73'              	LDA	NEDIT
  039C'   3D                    	DCR	A
  039D'   32 0AAE'              	STA	PROWN		; the bottom row
  03A0'   CD 093E'              	CALL	RDSKIP
  03A3'   3A 0A73'              	LDA	NEDIT
  03A6'   CD 008C'              	CALL	GOROW1		; bottom edit row, cleared
  03A9'   CD 0957'              	CALL	PAINTR
  03AC'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  03AF'   C3 09FC'              	JMP	SCURS
                                
                                ;SC_IL -- R_ILIN: one line was opened at the cursor's row.  Open a row there
                                ; (ESC[L, region-clamped so the message row is safe) -- the rows below shift
                                ; down and the bottom one falls out of the region -- then draw the cursor's row
                                ; and the one above it: a <CR> (and 'r<CR>') split that one, 'o' and 'O' leave
                                ; it as it was.  Everything else on the screen is already right where it is.
                                ;SC_ILQ -- which of the two forms this is.  A line that opened ON the screen
                                ; leaves the text where it stands (SCRLN = 0); one opened on the bottom row
                                ; has nowhere to put itself, so the screen scrolls up a row to make room
                                ; (SCRLN = 1) -- vim does the same, and it is what every <CR> does once you
                                ; are typing at the end of a file.  Both then draw the same two rows.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  03B2'                         SC_ILQ:
  03B2'   2A 0A7A'              	LHLD	SCRLN
  03B5'   7C                    	MOV	A,H
  03B6'   B5                    	ORA	L
  03B7'   CA 03DA'              	JZ	SC_IL		; the text stood still
  03BA'   2B                    	DCX	H
  03BB'   7C                    	MOV	A,H
  03BC'   B5                    	ORA	L
  03BD'   C2 0272'              	JNZ	SCFULL		; moved by more than a row: not ours
  03C0'   3A 0000*              	LDA	ILN		; and only ONE line can open into one scroll --
  03C3'   FE 01                 	CPI	1		;   a put of several at the bottom needs as many
  03C5'   C2 0272'              	JNZ	SCFULL		;   scrolls as it has lines, which is a repaint
  03C8'   CD 0080'              	CALL	CHIDE
  03CB'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03CE'   CD 00C2'              	CALL	GOTOP
  03D1'   21 0A2F'              	LXI	H,SDL		; ESC[M at the top: the region scrolls up one,
  03D4'   CD 0025'              	CALL	OUTSTR		;   opening the bottom row for the new line
  03D7'   C3 03FA'              	JMP	SC_ILT
                                
  03DA'                         SC_IL:
  03DA'   CD 0080'              	CALL	CHIDE
  03DD'   CD 0466'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03E0'   3A 0AB4'              	LDA	SROW
  03E3'   47                    	MOV	B,A
  03E4'   0E 01                 	MVI	C,1
  03E6'   CD 0064'              	CALL	GOTOXY
  03E9'   21 0A33'              	LXI	H,SCSI		; ESC[<ILN>L (IL): ILN blank rows here, the rest
  03EC'   CD 0025'              	CALL	OUTSTR		;   shift down, and what falls past the region's
  03EF'   3A 0000*              	LDA	ILN		;   bottom row has scrolled off, which is right
  03F2'   CD 002F'              	CALL	EMITB
  03F5'   3E 4C                 	MVI	A,'L'
  03F7'   CD 0018'              	CALL	OUTCH
  03FA'                         SC_ILT:
                                	;--- the first row to draw.  IL opened ILN rows AT the cursor's row and
                                	;    everything above it stands, so the cursor's own row (0-based SROW-1)
                                	;    is where the drawing starts -- 'o', 'O' and a put leave the line
                                	;    above untouched.  ILABOV says the edit took text off that line (a
                                	;    mid-line <CR>, 'r<CR>'), and then it is drawn too. ---
  03FA'   3A 0AB4'              	LDA	SROW
  03FD'   3D                    	DCR	A		; B = the cursor's own row, the first opened one
  03FE'   47                    	MOV	B,A
  03FF'   3A 0000*              	LDA	ILABOV
  0402'   B7                    	ORA	A
  0403'   78                    	MOV	A,B
  0404'   CA 0408'              	JZ	SC_IL0
  0407'   3D                    	DCR	A		; the row above the cursor's, when it is stale
  0408'                         SC_IL0:
  0408'   B7                    	ORA	A		; ... clamped: the cursor may be on the top row
  0409'   F2 040D'              	JP	SC_IL1
  040C'   AF                    	XRA	A
  040D'                         SC_IL1:
  040D'   32 0AAE'              	STA	PROWN
  0410'   78                    	MOV	A,B		; the last row to draw: the opened ones start at
  0411'   21 0000*              	LXI	H,ILN		;   the cursor's row and there are ILN of them
  0414'   86                    	ADD	M
  0415'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0416'   47                    	MOV	B,A
  0417'   3A 0A73'              	LDA	NEDIT
  041A'   3D                    	DCR	A		; ... but never past the bottom edit row, which
  041B'   B8                    	CMP	B		;   is as far as the opened rows can be seen
  041C'   DA 0420'              	JC	SC_IL2
  041F'   78                    	MOV	A,B
  0420'                         SC_IL2:
  0420'   32 0AB3'              	STA	ILLAST
  0423'   CD 08E0'              	CALL	RDTOP
  0426'   3A 0AAE'              	LDA	PROWN
  0429'   CD 093E'              	CALL	RDSKIP		; the reader at that row's line
  042C'                         SC_ILL:
  042C'   CD 0443'              	CALL	SC_ILR
  042F'   3A 0AB3'              	LDA	ILLAST
  0432'   21 0AAE'              	LXI	H,PROWN
  0435'   BE                    	CMP	M
  0436'   CA 043D'              	JZ	SC_ILD
  0439'   34                    	INR	M
  043A'   C3 042C'              	JMP	SC_ILL
  043D'                         SC_ILD:
  043D'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0440'   C3 09FC'              	JMP	SCURS		; the cursor back on the text, and shown
                                
                                ;SC_ILR -- draw screen row PROWN from where the reader stands, cleared first.
  0443'                         SC_ILR:
  0443'   3A 0AAE'              	LDA	PROWN
  0446'   3C                    	INR	A
  0447'   CD 008C'              	CALL	GOROW1
  044A'   C3 0957'              	JMP	PAINTR
                                
                                ;SCRNOK -- HL = candidate scroll count N.  Return A=N with CY=0 if N is in
                                ; 1..NEDIT-1 (there is on-screen overlap worth preserving); else CY=1 so the
                                ; caller full-repaints.  Clobbers A,B.
  044D'                         SCRNOK:
  044D'   7C                    	MOV	A,H
  044E'   B7                    	ORA	A
  044F'   C2 0464'              	JNZ	SRN_NO		; N >= 256
  0452'   7D                    	MOV	A,L
  0453'   B7                    	ORA	A
  0454'   CA 0464'              	JZ	SRN_NO		; N == 0
  0457'   47                    	MOV	B,A		; B = N
  0458'   3A 0A73'              	LDA	NEDIT
  045B'   B8                    	CMP	B		; CY iff NEDIT < N ; Z iff NEDIT == N
  045C'   DA 0464'              	JC	SRN_NO		; N > NEDIT
  045F'   CA 0464'              	JZ	SRN_NO		; N == NEDIT -> no overlap
  0462'   78                    	MOV	A,B		; A = N, CY=0 (from CMP: NEDIT > N)
  0463'   C9                    	RET
  0464'                         SRN_NO:
  0464'   37                    	STC
  0465'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  0466'                         SRGN:
  0466'   21 0A3E'              	LXI	H,SRGP
  0469'   CD 0025'              	CALL	OUTSTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  046C'   3A 0A73'              	LDA	NEDIT
  046F'   CD 002F'              	CALL	EMITB
  0472'   3E 72                 	MVI	A,'r'
  0474'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  0477'                         CURSC:
  0477'   2A 0A88'              	LHLD	CURDCL
  047A'   CD 049E'              	CALL	DIVN		; BC = rows into the line, A = the column
  047D'   3C                    	INR	A
  047E'   32 0AB5'              	STA	SCOL
  0481'   2A 0A8A'              	LHLD	LYABV
  0484'   09                    	DAD	B
  0485'   23                    	INX	H
  0486'   7C                    	MOV	A,H		; (never past the edit rows: a line taller than
  0487'   B7                    	ORA	A		;   the screen shows its first rows only)
  0488'   3A 0A73'              	LDA	NEDIT
  048B'   C2 0493'              	JNZ	CS_SET
  048E'   BD                    	CMP	L		; CY iff NEDIT < the row
  048F'   DA 0493'              	JC	CS_SET
  0492'   7D                    	MOV	A,L
  0493'                         CS_SET:
  0493'   32 0AB4'              	STA	SROW
  0496'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  0497'                         XTRA:
  0497'   01 0000               	LXI	B,0
  049A'   7C                    	MOV	A,H
  049B'   B5                    	ORA	L
  049C'   C8                    	RZ			; an empty line is one row
  049D'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  049E'                         DIVN:
  049E'   3A 0A72'              	LDA	NCOLS
  04A1'   2F                    	CMA
  04A2'   5F                    	MOV	E,A
  04A3'   16 FF                 	MVI	D,0FFH
  04A5'   13                    	INX	D		; DE = -NCOLS
  04A6'   01 FFFF               	LXI	B,0FFFFH
  04A9'                         DV_LP:
  04A9'   03                    	INX	B
  04AA'   19                    	DAD	D		; CY while NCOLS still went into it
  04AB'   DA 04A9'              	JC	DV_LP
  04AE'   3A 0A72'              	LDA	NCOLS
  04B1'   85                    	ADD	L
  04B2'   C9                    	RET
                                
                                ;SCABRT -- RPOLL abort: a key arrived mid-repaint.  Leave the cursor hidden (the
                                ; SHIDE at SCFULL's head still holds) and return WITHOUT positioning/showing it,
                                ; so no cursor flash during a type-ahead burst.  The pending key is dispatched
                                ; next, then SCDRAW runs again and (when the ring finally drains) paints in full
                                ; and shows the cursor -- the aborted frame is simply superseded.
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


                                ; FORCEF is latched so the next SCDRAW repaints in FULL even if the pending key
                                ; is a pure motion (RENDER.md: an aborted frame stays dirty -- the fast path must
                                ; not be taken over a half-painted screen).
  04B3'                         SCABRT:
  04B3'   3E 01                 	MVI	A,1
  04B5'   32 0A7C'              	STA	FORCEF
  04B8'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- WM MEASURE's placement (WM.ASM 3762): where the cursor's line sits
                                ; on the screen and what the screen holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), WFILL
                                ;   out: WINROW (clamped), SCRLN (lines the text moved up), TOPLEN (bytes from
                                ;        the top line's start to the cursor), CBOL (bytes from the cursor
                                ;        line's start), CURDCL, LYABV (rows above the cursor's line), TXEND and
                                ;        FILCH (the rows with no text, and what they show), SCBOT, SCEOF,
                                ;        SCBOF, WRAPF; WRLIM raised past the top (WM 3784); LNDLT and WFILL
                                ;        cleared.
                                ; WINROW is a count of LINES.  The rows come from measuring them: [top,
                                ; cursor) by pointer, the rest read forward until the rows are full -- never
                                ; to the end of a line the screen cannot hold.  When the lines above leave the
                                ; cursor's line no room, lines are given up at the top until it fits.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  04B9'                         LAYOUT:
  04B9'   2A 0000*              	LHLD	CMDCNT
  04BC'   22 0A9F'              	SHLD	SVCNT
  04BF'   2A 0000*              	LHLD	AUXCNT
  04C2'   22 0AA1'              	SHLD	SVAUX
  04C5'   3A 0000*              	LDA	DIRFLG
  04C8'   32 0AA3'              	STA	SVDIR
  04CB'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  04CE'   32 0A8E'              	STA	LYROW
  04D1'   CD 088E'              	CALL	LYFAR		; far off the screen: the middle of it
  04D4'   2A 0000*              	LHLD	LNDLT
  04D7'   22 0A8C'              	SHLD	LYDLT
  04DA'   21 0000               	LXI	H,0
  04DD'   22 0000*              	SHLD	LNDLT
  04E0'   3A 0A83'              	LDA	WFILL
  04E3'   FE 02                 	CPI	WF_MID
  04E5'   CC 0716'              	CZ	LYMID		; LYROW = the lines that puts above it
  04E8'                         LY_TOP:
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  04E8'   3A 0A8E'              	LDA	LYROW
  04EB'   6F                    	MOV	L,A
  04EC'   26 00                 	MVI	H,0
  04EE'   CD 0000*              	CALL	LINPSB		; HL = that line's start (paged back if needed)
  04F1'   EB                    	XCHG
  04F2'   2A 0000*              	LHLD	GAPBEG
  04F5'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  04F8'   22 0A84'              	SHLD	TOPLEN
  04FB'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  04FC'   22 0000*              	SHLD	WRLIM
                                	;--- [top, GAPBEG): the lines above, each as many rows as it is wide;
                                	;    what is left over is the cursor's line, up to the cursor ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  04FF'   21 0000               	LXI	H,0
  0502'   22 0A8A'              	SHLD	LYABV
  0505'   AF                    	XRA	A
  0506'   32 0A8E'              	STA	LYROW		; (counted again: the file may start sooner)
  0509'   CD 083D'              	CALL	LYTOPP		; HL = top, BC = bytes to the cursor
  050C'                         LY_ABV:
  050C'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  050D'   CD 0849'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0510'   D2 052A'              	JNC	LY_ABD
  0513'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0514'   C5                    	PUSH	B
  0515'   EB                    	XCHG
  0516'   CD 0497'              	CALL	XTRA		; BC = the rows it takes past its first
  0519'   2A 0A8A'              	LHLD	LYABV
  051C'   09                    	DAD	B
  051D'   23                    	INX	H
  051E'   22 0A8A'              	SHLD	LYABV
  0521'   21 0A8E'              	LXI	H,LYROW
  0524'   34                    	INR	M
  0525'   C1                    	POP	B
  0526'   E1                    	POP	H
  0527'   C3 050C'              	JMP	LY_ABV
  052A'                         LY_ABD:
  052A'   EB                    	XCHG
  052B'   22 0A88'              	SHLD	CURDCL
  052E'   E1                    	POP	H
  052F'   22 0A86'              	SHLD	CBOL
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  0532'   AF                    	XRA	A
  0533'   32 0A82'              	STA	SCBOF
  0536'   CD 083D'              	CALL	LYTOPP		; HL = top
  0539'   EB                    	XCHG
  053A'   2A 0000*              	LHLD	TXTBEG
  053D'   CD 0000*              	CALL	CMP16		; Z iff top == TXTBEG
  0540'   C2 054F'              	JNZ	LY_CUR
  0543'   2A 0000*              	LHLD	OUTPOS		; no records before TXTBEG
  0546'   7C                    	MOV	A,H
  0547'   B5                    	ORA	L
  0548'   C2 054F'              	JNZ	LY_CUR
  054B'   3C                    	INR	A
  054C'   32 0A82'              	STA	SCBOF
  054F'                         LY_CUR:
                                	;--- the cursor's own row: LYABV + the rows of its line before it ---
  054F'   AF                    	XRA	A
  0550'   32 0A81'              	STA	SCEOF
  0553'   32 0A92'              	STA	LYEND
  0556'   32 0A9D'              	STA	LYXE
  0559'   3E 7E                 	MVI	A,'~'
  055B'   32 0A80'              	STA	FILCH
  055E'   2A 0A88'              	LHLD	CURDCL
  0561'   CD 049E'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0564'   5F                    	MOV	E,A
  0565'   3A 0A88'              	LDA	CURDCL
  0568'   93                    	SUB	E
  0569'   32 0A94'              	STA	LYVB		; the column the cursor's row starts at
  056C'   2A 0A8A'              	LHLD	LYABV
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  056F'   7D                    	MOV	A,L
  0570'   32 0A93'              	STA	LYLST		; (its line starts on this row)
  0573'   09                    	DAD	B		; HL = the cursor's row
  0574'   3A 0A73'              	LDA	NEDIT
  0577'   4F                    	MOV	C,A
  0578'   7C                    	MOV	A,H
  0579'   B7                    	ORA	A
  057A'   C2 0582'              	JNZ	LY_OFF
  057D'   7D                    	MOV	A,L
  057E'   B9                    	CMP	C		; CY iff it is one of the edit rows
  057F'   DA 05C8'              	JC	LY_FW0
  0582'                         LY_OFF:
                                	;--- it is below them: give up lines at the top, as few as will do ---
  0582'   3A 0A8E'              	LDA	LYROW
  0585'   B7                    	ORA	A
  0586'   CA 05F4'              	JZ	LY_TAL		; there are none: the line is taller than the screen
  0589'   59                    	MOV	E,C
  058A'   1D                    	DCR	E
  058B'   16 00                 	MVI	D,0
  058D'   CD 0000*              	CALL	SUBHD		; HL = the rows too many
  0590'   22 0A8F'              	SHLD	LYNEED
  0593'   CD 083D'              	CALL	LYTOPP
  0596'                         LY_DRP:
  0596'   CD 0849'              	CALL	LNW		; the top line: DE = its width
  0599'   E5                    	PUSH	H
  059A'   C5                    	PUSH	B
  059B'   EB                    	XCHG
  059C'   CD 0497'              	CALL	XTRA
  059F'   03                    	INX	B		; BC = its rows
  05A0'   2A 0A8F'              	LHLD	LYNEED
  05A3'   7D                    	MOV	A,L
  05A4'   91                    	SUB	C
  05A5'   6F                    	MOV	L,A
  05A6'   7C                    	MOV	A,H
  05A7'   98                    	SBB	B
  05A8'   67                    	MOV	H,A
  05A9'   22 0A8F'              	SHLD	LYNEED
  05AC'   C1                    	POP	B
  05AD'   21 0A8E'              	LXI	H,LYROW
  05B0'   35                    	DCR	M		; one line fewer above the cursor's
  05B1'   E1                    	POP	H		; (keeps the flags)
  05B2'   CA 04E8'              	JZ	LY_TOP		; that was the last of them
  05B5'   3A 0A90'              	LDA	LYNEED+1
  05B8'   B7                    	ORA	A
  05B9'   FA 04E8'              	JM	LY_TOP		; room enough
  05BC'   E5                    	PUSH	H
  05BD'   2A 0A8F'              	LHLD	LYNEED
  05C0'   B5                    	ORA	L
  05C1'   E1                    	POP	H
  05C2'   C2 0596'              	JNZ	LY_DRP
  05C5'   C3 04E8'              	JMP	LY_TOP
  05C8'                         LY_FW0:
                                	;--- forward: the rest of the cursor's line and the lines below, until
                                	;    the rows are full.  D = the row being filled, E = cells used in it. ---
  05C8'   55                    	MOV	D,L
  05C9'   CD 0000*              	CALL	RGET0
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  05CC'                         LY_FWD:
  05CC'   CD 06BB'              	CALL	FLINE
  05CF'   B7                    	ORA	A
  05D0'   FA 0613'              	JM	LY_EOF
  05D3'   CA 05FA'              	JZ	LY_FLF
  05D6'   3A 0A92'              	LDA	LYEND		; a row the screen has not got:
  05D9'   B7                    	ORA	A
  05DA'   C2 05E9'              	JNZ	LY_CUT
  05DD'   21 0A8E'              	LXI	H,LYROW		; the cursor's own line needs it: give up a
  05E0'   7E                    	MOV	A,M		;   line at the top and measure again
  05E1'   B7                    	ORA	A
  05E2'   CA 05F4'              	JZ	LY_TAL
  05E5'   35                    	DCR	M
  05E6'   C3 04E8'              	JMP	LY_TOP
  05E9'                         LY_CUT:
  05E9'   3E 40                 	MVI	A,'@'		; a line under it does not: it is not shown, and
  05EB'   32 0A80'              	STA	FILCH		;   the rows it would have started on say so
  05EE'   3A 0A93'              	LDA	LYLST
  05F1'   C3 062B'              	JMP	LY_END
  05F4'                         LY_TAL:
  05F4'   3A 0A73'              	LDA	NEDIT		; a line taller than the screen: its first rows
  05F7'   C3 062B'              	JMP	LY_END
  05FA'                         LY_FLF:
  05FA'   CD 086B'              	CALL	LYLEND		; that line's rows are counted
  05FD'   3A 0A73'              	LDA	NEDIT
  0600'   BA                    	CMP	D
  0601'   C2 05CC'              	JNZ	LY_FWD
  0604'   CD 0000*              	CALL	RDGET		; rows full: is the text over right there?
  0607'   D2 060F'              	JNC	LY_FUL
  060A'   3E 01                 	MVI	A,1
  060C'   32 0A81'              	STA	SCEOF
  060F'                         LY_FUL:
  060F'   7A                    	MOV	A,D
  0610'   C3 062B'              	JMP	LY_END
  0613'                         LY_EOF:
  0613'   3E 01                 	MVI	A,1
  0615'   32 0A81'              	STA	SCEOF
  0618'   3A 0A92'              	LDA	LYEND		; text after the last line end -- or no line end
  061B'   B7                    	ORA	A		;   at all -- is a line too
  061C'   CA 0627'              	JZ	LY_EO1
  061F'   3A 0A9E'              	LDA	LYLAST
  0622'   FE 0A                 	CPI	LF
  0624'   CA 062A'              	JZ	LY_EO2
  0627'                         LY_EO1:
  0627'   CD 086B'              	CALL	LYLEND
  062A'                         LY_EO2:
  062A'   7A                    	MOV	A,D
  062B'                         LY_END:
  062B'   32 0A7F'              	STA	TXEND		; the first row with no text on it
  062E'   3A 0A92'              	LDA	LYEND		; below = the lines that ended, less the cursor's
  0631'   D6 01                 	SUI	1
  0633'   CE 00                 	ACI	0
  0635'   32 0A91'              	STA	LYBLW
                                	;--- WFILL: '~' rows showing while text above could fill them -> move the
                                	;    cursor's line down by the shortfall and lay out again ---
  0638'   3A 0A83'              	LDA	WFILL
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  063B'   B7                    	ORA	A
  063C'   CA 0667'              	JZ	LY_SET
  063F'   AF                    	XRA	A
  0640'   32 0A83'              	STA	WFILL
  0643'   3A 0A82'              	LDA	SCBOF
  0646'   B7                    	ORA	A
  0647'   C2 0667'              	JNZ	LY_SET
  064A'   3A 0A80'              	LDA	FILCH
  064D'   FE 7E                 	CPI	'~'
  064F'   C2 0667'              	JNZ	LY_SET
  0652'   3A 0A73'              	LDA	NEDIT
  0655'   21 0A7F'              	LXI	H,TXEND
  0658'   96                    	SUB	M		; shortfall
  0659'   CA 0667'              	JZ	LY_SET
  065C'   DA 0667'              	JC	LY_SET
  065F'   21 0A8E'              	LXI	H,LYROW
  0662'   86                    	ADD	M
  0663'   77                    	MOV	M,A
  0664'   C3 04E8'              	JMP	LY_TOP
  0667'                         LY_SET:
  0667'   3A 0A8E'              	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
  066A'   21 0A91'              	LXI	H,LYBLW
  066D'   86                    	ADD	M
  066E'   32 0A7E'              	STA	SCBOT
                                	;--- WRAPF: more rows of text than lines, or a line cut off ---
  0671'   3C                    	INR	A
  0672'   21 0A7F'              	LXI	H,TXEND
  0675'   96                    	SUB	M
  0676'   21 0A80'              	LXI	H,FILCH
  0679'   C2 0684'              	JNZ	LY_W1
  067C'   7E                    	MOV	A,M
  067D'   FE 7E                 	CPI	'~'
  067F'   3E 00                 	MVI	A,0
  0681'   CA 0686'              	JZ	LY_W2
  0684'                         LY_W1:
  0684'   3E 01                 	MVI	A,1
  0686'                         LY_W2:
  0686'   21 0A9D'              	LXI	H,LYXE
  0689'   B6                    	ORA	M
  068A'   32 0A78'              	STA	WRAPF
  068D'   3A 0A8E'              	LDA	LYROW		; WINROW = row
  0690'   6F                    	MOV	L,A
  0691'   26 00                 	MVI	H,0
  0693'   22 0A74'              	SHLD	WINROW
  0696'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  0697'   2A 0A8C'              	LHLD	LYDLT
  069A'   CD 0000*              	CALL	SUBHD
  069D'   EB                    	XCHG
  069E'   2A 0A76'              	LHLD	OLDWR
  06A1'   19                    	DAD	D
  06A2'   22 0A7A'              	SHLD	SCRLN
  06A5'   CD 08C0'              	CALL	TABCUR
  06A8'   2A 0A9F'              	LHLD	SVCNT
  06AB'   22 0000*              	SHLD	CMDCNT
  06AE'   2A 0AA1'              	LHLD	SVAUX
  06B1'   22 0000*              	SHLD	AUXCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  06B4'   3A 0AA3'              	LDA	SVDIR
  06B7'   32 0000*              	STA	DIRFLG
  06BA'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  06BB'                         FLINE:
  06BB'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  06BE'   DA 06FB'              	JC	FL_EOF
  06C1'   32 0A9E'              	STA	LYLAST
  06C4'   FE 0A                 	CPI	LF
  06C6'   CA 06F9'              	JZ	FL_LF
  06C9'   FE 0D                 	CPI	CR
  06CB'   CA 06BB'              	JZ	FLINE		; CR contributes no display column
  06CE'   FE 09                 	CPI	TAB
  06D0'   CA 06DC'              	JZ	FL_TAB
  06D3'   CD 06FE'              	CALL	FL_CEL
  06D6'   C2 06BB'              	JNZ	FLINE
  06D9'                         FL_OVR:
  06D9'   3E 01                 	MVI	A,1
  06DB'   C9                    	RET
  06DC'                         FL_TAB:
  06DC'   3A 0A94'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  06DF'   83                    	ADD	E
  06E0'   E6 07                 	ANI	TABWID-1
  06E2'   2F                    	CMA
  06E3'   C6 09                 	ADI	TABWID+1
  06E5'   E5                    	PUSH	H
  06E6'   6F                    	MOV	L,A
  06E7'                         FT_LP:
  06E7'   CD 06FE'              	CALL	FL_CEL
  06EA'   CA 06F5'              	JZ	FT_OVR
  06ED'   2D                    	DCR	L
  06EE'   C2 06E7'              	JNZ	FT_LP
  06F1'   E1                    	POP	H
  06F2'   C3 06BB'              	JMP	FLINE
  06F5'                         FT_OVR:
  06F5'   E1                    	POP	H
  06F6'   C3 06D9'              	JMP	FL_OVR
  06F9'                         FL_LF:
  06F9'   AF                    	XRA	A
  06FA'   C9                    	RET
  06FB'                         FL_EOF:
  06FB'   3E FF                 	MVI	A,0FFH
  06FD'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  06FE'                         FL_CEL:
  06FE'   3A 0A72'              	LDA	NCOLS
  0701'   BB                    	CMP	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  0702'   C2 0714'              	JNZ	FC_1
  0705'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  0707'   14                    	INR	D
  0708'   E5                    	PUSH	H
  0709'   21 0A94'              	LXI	H,LYVB
  070C'   86                    	ADD	M
  070D'   77                    	MOV	M,A
  070E'   E1                    	POP	H
  070F'   3A 0A73'              	LDA	NEDIT
  0712'   BA                    	CMP	D
  0713'   C8                    	RZ
  0714'                         FC_1:
  0714'   1C                    	INR	E		; (NZ)
  0715'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (WFILL =
                                ; WF_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, then
                                ; a line above while there are fewer above than below, until a line will not
                                ; fit.  Past the end of the file a '~' row counts as a row below that costs
                                ; nothing, so there the screen fills from above; at the start of the file it
                                ; stops.  Clears WFILL.
  0716'                         LYMID:
  0716'   AF                    	XRA	A
  0717'   32 0A83'              	STA	WFILL
  071A'   32 0A8E'              	STA	LYROW
  071D'   32 0A9A'              	STA	LYMAB
  0720'   32 0A9B'              	STA	LYMBL
  0723'   32 0A9C'              	STA	LYMEOF
  0726'   3A 0A73'              	LDA	NEDIT
  0729'   3D                    	DCR	A
  072A'   6F                    	MOV	L,A
  072B'   26 00                 	MVI	H,0
  072D'   CD 0000*              	CALL	LINPSB		; as far up as the screen could ever reach
  0730'   CD 0842'              	CALL	G2P
  0733'   22 0A95'              	SHLD	LYLIM
  0736'   24                    	INR	H
  0737'   22 0000*              	SHLD	WRLIM		; (and none of it spilled while reading down)
  073A'   2A 0000*              	LHLD	GAPBEG
  073D'   CD 081B'              	CALL	PRVL0		; HL = the cursor line's start, BC = bytes to here
  0740'   CD 0801'              	CALL	LM_LNW		; DE = the columns before the cursor
  0743'   EB                    	XCHG
  0744'   E5                    	PUSH	H
  0745'   CD 049E'              	CALL	DIVN		; BC = rows into the line, A = cells in that row
  0748'   E1                    	POP	H
  0749'   5F                    	MOV	E,A
  074A'   7D                    	MOV	A,L
  074B'   93                    	SUB	E
  074C'   32 0A94'              	STA	LYVB
  074F'   78                    	MOV	A,B
  0750'   B7                    	ORA	A
  0751'   C0                    	RNZ			; (taller than the screen)
  0752'   51                    	MOV	D,C
  0753'   3A 0A73'              	LDA	NEDIT
  0756'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0757'   BA                    	CMP	D
  0758'   D8                    	RC			; (taller than the screen)
  0759'   CD 0000*              	CALL	RGET0
  075C'   CD 07F4'              	CALL	LM_FL		; ... and the rest of it
  075F'   F2 0766'              	JP	LM_1
  0762'   32 0A9C'              	STA	LYMEOF		; the text ends with it
  0765'   AF                    	XRA	A
  0766'                         LM_1:
  0766'   C0                    	RNZ			; (taller than the screen)
  0767'   7A                    	MOV	A,D
  0768'   3C                    	INR	A
  0769'   32 0A99'              	STA	LYUSE		; the rows taken so far: its own
  076C'                         LM_LP:
  076C'   3A 0A9A'              	LDA	LYMAB
  076F'   21 0A9B'              	LXI	H,LYMBL
  0772'   BE                    	CMP	M
  0773'   DA 07AC'              	JC	LM_UP		; more below than above
  0776'   3A 0A9C'              	LDA	LYMEOF
  0779'   B7                    	ORA	A
  077A'   C2 079E'              	JNZ	LM_TL
  077D'   CD 07E5'              	CALL	LM_NX		; the next line below
  0780'   F2 078F'              	JP	LM_B1
  0783'   32 0A9C'              	STA	LYMEOF		; the text ended: was that a line?
  0786'   3A 0A9E'              	LDA	LYLAST
  0789'   FE 0A                 	CPI	LF
  078B'   CA 079E'              	JZ	LM_TL
  078E'   AF                    	XRA	A
  078F'                         LM_B1:
  078F'   C0                    	RNZ			; one taller than the screen: nothing more fits
  0790'   7A                    	MOV	A,D
  0791'   3C                    	INR	A		; its rows
  0792'   CD 07D3'              	CALL	LM_ADD
  0795'   D8                    	RC
  0796'   21 0A9B'              	LXI	H,LYMBL
  0799'   86                    	ADD	M
  079A'   77                    	MOV	M,A
  079B'   C3 07A2'              	JMP	LM_AB
  079E'                         LM_TL:
  079E'   21 0A9B'              	LXI	H,LYMBL		; a '~' row
  07A1'   34                    	INR	M
  07A2'                         LM_AB:
  07A2'   3A 0A9A'              	LDA	LYMAB
  07A5'   21 0A9B'              	LXI	H,LYMBL
  07A8'   BE                    	CMP	M
  07A9'   D2 076C'              	JNC	LM_LP
  07AC'                         LM_UP:
  07AC'   2A 0A97'              	LHLD	LYUP		; the next line above
  07AF'   CD 0842'              	CALL	G2P
  07B2'   CD 080C'              	CALL	PRVLN
  07B5'   D8                    	RC			; the start of the file
  07B6'   CD 0801'              	CALL	LM_LNW
  07B9'   EB                    	XCHG
  07BA'   CD 0497'              	CALL	XTRA		; BC = its rows, less one
  07BD'   78                    	MOV	A,B
  07BE'   B7                    	ORA	A
  07BF'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  07C0'   79                    	MOV	A,C
  07C1'   3C                    	INR	A
  07C2'   C8                    	RZ
  07C3'   CD 07D3'              	CALL	LM_ADD
  07C6'   D8                    	RC
  07C7'   21 0A9A'              	LXI	H,LYMAB
  07CA'   86                    	ADD	M
  07CB'   77                    	MOV	M,A
  07CC'   21 0A8E'              	LXI	H,LYROW
  07CF'   34                    	INR	M
  07D0'   C3 076C'              	JMP	LM_LP
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  07D3'                         LM_ADD:
  07D3'   47                    	MOV	B,A
  07D4'   3A 0A99'              	LDA	LYUSE
  07D7'   80                    	ADD	B
  07D8'   D8                    	RC
  07D9'   4F                    	MOV	C,A
  07DA'   3A 0A73'              	LDA	NEDIT
  07DD'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  07DE'   D8                    	RC
  07DF'   79                    	MOV	A,C
  07E0'   32 0A99'              	STA	LYUSE
  07E3'   78                    	MOV	A,B
  07E4'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  07E5'                         LM_NX:
  07E5'   11 0000               	LXI	D,0
  07E8'   AF                    	XRA	A
  07E9'   32 0A94'              	STA	LYVB
  07EC'   2A 0AAA'              	LHLD	RDBC
  07EF'   44                    	MOV	B,H
  07F0'   4D                    	MOV	C,L
  07F1'   2A 0AA8'              	LHLD	RDHL
  07F4'                         LM_FL:
  07F4'   CD 06BB'              	CALL	FLINE
  07F7'   22 0AA8'              	SHLD	RDHL
  07FA'   60                    	MOV	H,B
  07FB'   69                    	MOV	L,C
  07FC'   22 0AAA'              	SHLD	RDBC
  07FF'   B7                    	ORA	A
  0800'   C9                    	RET
                                
                                ;LM_LNW -- HL = the start of a line above (or the cursor's), BC = its bytes:
                                ; note it as the highest line taken (LYUP) and measure it (LNW).
  0801'                         LM_LNW:
  0801'   E5                    	PUSH	H
  0802'   CD 0842'              	CALL	G2P
  0805'   22 0A97'              	SHLD	LYUP
  0808'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  0809'   C3 0849'              	JMP	LNW
                                
                                ;PRVLN -- HL = the start of a line: HL = the start of the line before it, BC
                                ; = that line's bytes.  CY if there is none (LYLIM: the text ends there).
                                ;PRVL0 -- the same from inside a line, back to its own start.
  080C'                         PRVLN:
  080C'   CD 0833'              	CALL	PVLIM
  080F'   CD 0000*              	CALL	CMP16
  0812'   37                    	STC
  0813'   C8                    	RZ
  0814'   2B                    	DCX	H		; its LF
  0815'   01 0001               	LXI	B,1
  0818'   C3 0821'              	JMP	PV_LP
  081B'                         PRVL0:
  081B'   CD 0833'              	CALL	PVLIM
  081E'   01 0000               	LXI	B,0
  0821'                         PV_LP:
  0821'   CD 0000*              	CALL	CMP16
  0824'   C8                    	RZ			; (NC) as far up as the text goes
  0825'   2B                    	DCX	H
  0826'   7E                    	MOV	A,M
  0827'   FE 0A                 	CPI	LF
  0829'   CA 0830'              	JZ	PV_DN
  082C'   03                    	INX	B
  082D'   C3 0821'              	JMP	PV_LP
  0830'                         PV_DN:
  0830'   23                    	INX	H
  0831'   B7                    	ORA	A
  0832'   C9                    	RET
                                ;PVLIM -- DE = the address LYLIM stands for.  Keeps HL.
  0833'                         PVLIM:
  0833'   E5                    	PUSH	H
  0834'   2A 0A95'              	LHLD	LYLIM
  0837'   CD 0842'              	CALL	G2P
  083A'   EB                    	XCHG
  083B'   E1                    	POP	H
  083C'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  083D'                         LYTOPP:
  083D'   2A 0A84'              	LHLD	TOPLEN
  0840'   44                    	MOV	B,H
  0841'   4D                    	MOV	C,L
  0842'                         G2P:
  0842'   EB                    	XCHG
  0843'   2A 0000*              	LHLD	GAPBEG
  0846'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0849'                         LNW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0849'   11 0000               	LXI	D,0
  084C'                         LNW_LP:
  084C'   78                    	MOV	A,B
  084D'   B1                    	ORA	C
  084E'   C8                    	RZ
  084F'   7E                    	MOV	A,M
  0850'   23                    	INX	H
  0851'   0B                    	DCX	B
  0852'   FE 0A                 	CPI	LF
  0854'   CA 0869'              	JZ	LNW_LF
  0857'   FE 0D                 	CPI	CR
  0859'   CA 084C'              	JZ	LNW_LP		; CR contributes no display column
  085C'   FE 09                 	CPI	TAB
  085E'   C2 0865'              	JNZ	LNW_1
  0861'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0862'   F6 07                 	ORI	TABWID-1
  0864'   5F                    	MOV	E,A
  0865'                         LNW_1:
  0865'   13                    	INX	D
  0866'   C3 084C'              	JMP	LNW_LP
  0869'                         LNW_LF:
  0869'   37                    	STC
  086A'   C9                    	RET
                                
                                ;LYLEND -- LAYOUT's forward read: a line ended on row D.  The next starts on
                                ; the row under it.  A line that ends with a row it has put nothing on is the
                                ; cursor's, standing past text that filled the row above (an insert at the
                                ; end of a line just as wide as the screen): WR_EOL.  Keeps HL, BC.
  086B'                         LYLEND:
  086B'   7B                    	MOV	A,E
  086C'   B7                    	ORA	A
  086D'   C2 087C'              	JNZ	LE_1
  0870'   3A 0A93'              	LDA	LYLST
  0873'   BA                    	CMP	D
  0874'   CA 087C'              	JZ	LE_1		; (its first row: an empty line)
  0877'   3E 03                 	MVI	A,WR_EOL+1
  0879'   32 0A9D'              	STA	LYXE
  087C'                         LE_1:
  087C'   14                    	INR	D
  087D'   7A                    	MOV	A,D
  087E'   32 0A93'              	STA	LYLST
  0881'   AF                    	XRA	A
  0882'   5F                    	MOV	E,A
  0883'   32 0A94'              	STA	LYVB
  0886'   3A 0A92'              	LDA	LYEND
  0889'   3C                    	INR	A
  088A'   32 0A92'              	STA	LYEND
  088D'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster) for a cursor line that left the screen,
                                ; measured on vim 9.1 with a 23-row window: up to NEDIT/2+1 lines below the
                                ; bottom row or NEDIT/2-2 above the top row, the screen scrolls to it (CURRW's
                                ; clamp); farther, it goes in the middle of the screen (LYMID).
  088E'                         LYFAR:
  088E'   2A 0A74'              	LHLD	WINROW
  0891'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0892'   2A 0000*              	LHLD	LNDLT
  0895'   19                    	DAD	D		; HL = the row it would take (signed)
  0896'   3A 0A73'              	LDA	NEDIT
  0899'   B7                    	ORA	A
  089A'   1F                    	RAR
  089B'   5F                    	MOV	E,A
  089C'   16 00                 	MVI	D,0		; DE = NEDIT/2
  089E'   7C                    	MOV	A,H
  089F'   B7                    	ORA	A
  08A0'   F2 08AC'              	JP	LF_DN
  08A3'   1B                    	DCX	D
  08A4'   1B                    	DCX	D
  08A5'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  08A6'   7C                    	MOV	A,H
  08A7'   B7                    	ORA	A
  08A8'   F0                    	RP
  08A9'   C3 08BA'              	JMP	LF_FAR
  08AC'                         LF_DN:
  08AC'   E5                    	PUSH	H
  08AD'   3A 0A73'              	LDA	NEDIT
  08B0'   6F                    	MOV	L,A
  08B1'   26 00                 	MVI	H,0
  08B3'   19                    	DAD	D		; HL = NEDIT + NEDIT/2: the last row that scrolls
  08B4'   D1                    	POP	D		; DE = row
  08B5'   CD 0000*              	CALL	CMP16		; CY iff row < that, Z iff equal
  08B8'   D8                    	RC
  08B9'   C8                    	RZ
  08BA'                         LF_FAR:
  08BA'   3E 02                 	MVI	A,WF_MID
  08BC'   32 0A83'              	STA	WFILL
  08BF'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  08C0'                         TABCUR:
  08C0'   3A 0000*              	LDA	EDMODE
  08C3'   FE 00                 	CPI	EM_CMD
  08C5'   C0                    	RNZ
  08C6'   2A 0000*              	LHLD	TXTEND
  08C9'   EB                    	XCHG
  08CA'   2A 0000*              	LHLD	GAPEND
  08CD'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  08D0'   C8                    	RZ
  08D1'   7E                    	MOV	A,M
  08D2'   FE 09                 	CPI	TAB
  08D4'   C0                    	RNZ
  08D5'   2A 0A88'              	LHLD	CURDCL
  08D8'   7D                    	MOV	A,L
  08D9'   F6 07                 	ORI	TABWID-1
  08DB'   6F                    	MOV	L,A
  08DC'   22 0A88'              	SHLD	CURDCL
  08DF'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  08E0'                         RDTOP:
  08E0'   2A 0A84'              	LHLD	TOPLEN
  08E3'   C3 08E9'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  08E6'                         RDBOL:
  08E6'   2A 0A86'              	LHLD	CBOL
  08E9'                         RDSET:
  08E9'   22 0AA6'              	SHLD	RDN
  08EC'   EB                    	XCHG
  08ED'   2A 0000*              	LHLD	GAPBEG
  08F0'   CD 0000*              	CALL	SUBHD
  08F3'   22 0AA4'              	SHLD	RDP
  08F6'   AF                    	XRA	A
  08F7'   32 0AAC'              	STA	RDSEG
  08FA'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  08FB'                         RDCH:
  08FB'   C5                    	PUSH	B
  08FC'   D5                    	PUSH	D
  08FD'   E5                    	PUSH	H
  08FE'   2A 0AA6'              	LHLD	RDN		; before-gap bytes left?
  0901'   7C                    	MOV	A,H
  0902'   B5                    	ORA	L
  0903'   CA 0916'              	JZ	RDC_AF
  0906'   2B                    	DCX	H
  0907'   22 0AA6'              	SHLD	RDN
  090A'   2A 0AA4'              	LHLD	RDP
  090D'   7E                    	MOV	A,M
  090E'   23                    	INX	H
  090F'   22 0AA4'              	SHLD	RDP
  0912'   B7                    	ORA	A		; CY=0
  0913'   C3 093A'              	JMP	RDC_RT
  0916'                         RDC_AF:
  0916'   3A 0AAC'              	LDA	RDSEG
  0919'   B7                    	ORA	A
  091A'   C2 0927'              	JNZ	RDC_NX
  091D'   3C                    	INR	A		; first after-gap byte: start RGET
  091E'   32 0AAC'              	STA	RDSEG
  0921'   CD 0000*              	CALL	RGET0
  0924'   C3 092F'              	JMP	RDC_GT
  0927'                         RDC_NX:
  0927'   2A 0AAA'              	LHLD	RDBC
  092A'   44                    	MOV	B,H
  092B'   4D                    	MOV	C,L
  092C'   2A 0AA8'              	LHLD	RDHL
  092F'                         RDC_GT:
  092F'   CD 0000*              	CALL	RDGET
  0932'   22 0AA8'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0935'   60                    	MOV	H,B
  0936'   69                    	MOV	L,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0937'   22 0AAA'              	SHLD	RDBC
  093A'                         RDC_RT:
  093A'   E1                    	POP	H
  093B'   D1                    	POP	D
  093C'   C1                    	POP	B
  093D'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  093E'                         RDSKIP:
  093E'   B7                    	ORA	A
  093F'   C8                    	RZ
  0940'   32 0AAD'              	STA	SKPN
  0943'                         RSK_LP:
  0943'   CD 08FB'              	CALL	RDCH
  0946'   D8                    	RC
  0947'   FE 0A                 	CPI	LF
  0949'   C2 0943'              	JNZ	RSK_LP
  094C'   3A 0AAD'              	LDA	SKPN
  094F'   3D                    	DCR	A
  0950'   32 0AAD'              	STA	SKPN
  0953'   C2 0943'              	JNZ	RSK_LP
  0956'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0957'                         PAINTR:
  0957'   3A 0AAE'              	LDA	PROWN
  095A'   21 0A7F'              	LXI	H,TXEND
  095D'   BE                    	CMP	M		; CY iff the row holds text
  095E'   DA 0967'              	JC	PROW
  0961'   3A 0A80'              	LDA	FILCH
  0964'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0967'                         PROW:
  0967'   AF                    	XRA	A
  0968'   32 0AB0'              	STA	DCOL
  096B'   32 0AB1'              	STA	XC
  096E'                         PR_LP:
  096E'   CD 08FB'              	CALL	RDCH
  0971'   D8                    	RC			; end of text -> line done
  0972'   FE 0A                 	CPI	LF
  0974'   C8                    	RZ			; consumed the LF -> next line start
  0975'   FE 0D                 	CPI	CR
  0977'   CA 096E'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  097A'   FE 09                 	CPI	TAB
  097C'   CA 0985'              	JZ	PR_TAB
  097F'   CD 099B'              	CALL	PCELL
  0982'   C3 096E'              	JMP	PR_LP
  0985'                         PR_TAB:
  0985'   3A 0AB0'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0988'   E6 07                 	ANI	7
  098A'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  098B'   3E 08                 	MVI	A,8
  098D'   91                    	SUB	C
  098E'   4F                    	MOV	C,A		; C = space count (1..8)
  098F'                         PRTBLP:
  098F'   3E 20                 	MVI	A,' '
  0991'   CD 099B'              	CALL	PCELL		; (keeps C)
  0994'   0D                    	DCR	C
  0995'   C2 098F'              	JNZ	PRTBLP
  0998'   C3 096E'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  099B'                         PCELL:
  099B'   47                    	MOV	B,A
  099C'   21 0AB0'              	LXI	H,DCOL
  099F'   34                    	INR	M
  09A0'   3A 0A72'              	LDA	NCOLS
  09A3'   21 0AB1'              	LXI	H,XC
  09A6'   BE                    	CMP	M
  09A7'   CC 09AF'              	CZ	PWRAP		; the row is full: this one starts the next
  09AA'   34                    	INR	M
  09AB'   78                    	MOV	A,B
  09AC'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last edit row there is nowhere to go: the rest of the
                                ; line is not shown, and PROW returns to its caller from here.
  09AF'                         PWRAP:
  09AF'   36 00                 	MVI	M,0
  09B1'   3A 0A73'              	LDA	NEDIT
  09B4'   3D                    	DCR	A
  09B5'   21 0AAE'              	LXI	H,PROWN
  09B8'   BE                    	CMP	M
  09B9'   CA 09CE'              	JZ	PW_END
  09BC'   34                    	INR	M
  09BD'   3E 0D                 	MVI	A,CR
  09BF'   CD 0018'              	CALL	OUTCH
  09C2'   3E 0A                 	MVI	A,LF
  09C4'   CD 0018'              	CALL	OUTCH
  09C7'   CD 0092'              	CALL	CEKL		; (keeps BC)
  09CA'   21 0AB1'              	LXI	H,XC
  09CD'   C9                    	RET
  09CE'                         PW_END:
  09CE'   E1                    	POP	H		; PCELL's return, and PROW's
  09CF'   E1                    	POP	H
  09D0'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  09D1'                         MODEMS:
  09D1'   3A 0000*              	LDA	EDMODE
  09D4'   47                    	MOV	B,A
  09D5'   3A 0A7D'              	LDA	OEDMOD
  09D8'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09D9'   C8                    	RZ			; the row already shows this mode
  09DA'   78                    	MOV	A,B
  09DB'   32 0A7D'              	STA	OEDMOD
  09DE'   21 0A55'              	LXI	H,SINSM
  09E1'   FE 01                 	CPI	EM_INS
  09E3'   CA 09F1'              	JZ	MD_DRW
  09E6'   21 0A62'              	LXI	H,SREPM
  09E9'   FE 02                 	CPI	EM_REP
  09EB'   CA 09F1'              	JZ	MD_DRW
  09EE'   21 0A70'              	LXI	H,SNULL		; command mode: the row goes blank
  09F1'                         MD_DRW:
  09F1'   E5                    	PUSH	H
  09F2'   3A 0A71'              	LDA	NROWS
  09F5'   CD 008C'              	CALL	GOROW1
  09F8'   E1                    	POP	H
  09F9'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  09FC'                         SCURS:
  09FC'   3A 0AB4'              	LDA	SROW
  09FF'   47                    	MOV	B,A
  0A00'   3A 0AB5'              	LDA	SCOL
  0A03'   4F                    	MOV	C,A
  0A04'   CD 0064'              	CALL	GOTOXY
  0A07'   21 0A4A'              	LXI	H,SSHOW
  0A0A'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0A0D'                         SCDONE:
  0A0D'   CD 0086'              	CALL	CRGRS
  0A10'   21 0A4A'              	LXI	H,SSHOW
  0A13'   CD 0025'              	CALL	OUTSTR
  0A16'   3A 0A71'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0A19'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0A1C'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0A20'   39 3B 39 39           
  0A24'   39 48                 
  0A26'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0A2A'   00                    
  0A2B'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0A2F'   1B 5B 4D 00           SDL:	DB	ESC,'[','M',0		; DL -- delete line (scroll region up 1)
  0A33'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0A36'   1B 4D 00              SRI:	DB	ESC,'M',0		; RI -- reverse index (scroll region down 1)
  0A39'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0A3D'   00                    
  0A3E'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0A42'   00                    
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A43'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0A47'   35 6C 00              
  0A4A'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0A4E'   35 68 00              
  0A51'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0A55'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0A59'   4E 53 45 52           
  0A5D'   54 20 2D 2D           
  0A61'   00                    
  0A62'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0A66'   45 50 4C 41           
  0A6A'   43 45 20 2D           
  0A6E'   2D 00                 
  0A70'   00                    SNULL:	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0A71'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0A72'   50                    NCOLS:	DB	80		; runtime columns
  0A73'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
  0A74'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0A76'   0000                  OLDWR:	DW	0		; WINROW as displayed before this frame
  0A78'   00                    WRAPF:	DB	0		; this frame: 0, 1 = a line wraps, WR_EOL and up =
                                				;   ... and the cursor has a row to itself
  0A79'   00                    OLDWF:	DB	0		; WRAPF as displayed before this frame
  0A7A'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0A7C'   00                    FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
  0A7D'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0A7E'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0A7F'   01                    TXEND:	DB	1		; the first row with no text on it
  0A80'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0A81'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0A82'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0A83'   00                    WFILL:	DB	0		; 1 = fill '~' rows from above (one layout);
                                				;   WF_MID = put the cursor's line mid-screen
                                
  0A84'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0A86'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0A88'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0A8A'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0A8C'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0A8E'   00                    LYROW:	DB	0		; LAYOUT: working row
  0A8F'   0000                  LYNEED: DW	0		; LAYOUT: rows to free at the top
  0A91'   00                    LYBLW:	DB	0		; LAYOUT: lines shown below the cursor's
  0A92'   00                    LYEND:	DB	0		; LAYOUT: lines that ended in the forward read
  0A93'   00                    LYLST:	DB	0		; LAYOUT: the row the line being read starts on
  0A94'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0A95'   0000                  LYLIM:	DW	0		; LYMID: bytes back to the highest line there is
  0A97'   0000                  LYUP:	DW	0		; LYMID: bytes back to the highest line taken
  0A99'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0A9A'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0A9B'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
