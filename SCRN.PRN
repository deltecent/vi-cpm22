  0AC0'   CD 0AE7'              	CALL	LMBLW
  0AC3'   D2 0AB1'              	JNC	LM_LP
  0AC6'   C9                    	RET
  0AC7'                         LM_U:
  0AC7'   CD 0B15'              	CALL	LMABV
  0ACA'   D2 0AB1'              	JNC	LM_LP
  0ACD'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0ACE'                         LYINI:
  0ACE'   AF                    	XRA	A
  0ACF'   32 1035'              	STA	LYROW
  0AD2'   32 103C'              	STA	LYMAB
  0AD5'   32 103D'              	STA	LYMBL
  0AD8'   3A 0000*              	LDA	HTCUR
  0ADB'   CD 0B31'              	CALL	HTE
  0ADE'   7E                    	MOV	A,M
  0ADF'   32 103B'              	STA	LYUSE
  0AE2'   23                    	INX	H
  0AE3'   22 1036'              	SHLD	LYIB
  0AE6'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0AE7'                         LMBLW:
  0AE7'   3A 0000*              	LDA	HTN
  0AEA'   CD 0B31'              	CALL	HTE
  0AED'   EB                    	XCHG
  0AEE'   2A 1036'              	LHLD	LYIB
