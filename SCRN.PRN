                                ;LYTP -- L = the lines to be above the cursor's (H = 0): HL = the start of
                                ; the top line.  WM's line move (LINPSB) would find it, walking back over all
                                ; of them; but HTBLD has walked back already, to the table's first line
                                ; (HTTOPC), and the top line is that one or some lines down from it.  With a
                                ; table that was kept (LYSTP): no lines above, and it is the cursor's line;
                                ; else the top line is the old one, or some lines down from it, and the old
                                ; one is where LYTOP says while the pager has left the text alone.
  087D'                         LYTP:
  087D'   3A 1054'              	LDA	LYOK
  0880'   B7                    	ORA	A
  0881'   C2 08AD'              	JNZ	LT_0
  0884'   45                    	MOV	B,L
  0885'   3A 0000*              	LDA	HTCUR
  0888'   90                    	SUB	B
  0889'   DA 0900'              	JC	LT_NO
  088C'   4F                    	MOV	C,A		; C = the lines the top is under the table's first
  088D'   2A 0000*              	LHLD	TXTBEG		; ... if that line is in memory still: HTBLD
  0890'   EB                    	XCHG			;   pins a screenful back from the cursor and
  0891'   2A 0000*              	LHLD	GAPBEG		;   no more, and reading down for the lines
  0894'   CD 0000*              	CALL	SUBHD		;   under it may have paged the rest out
  0897'   EB                    	XCHG
  0898'   2A 1058'              	LHLD	HTTOPC
  089B'   CD 0000*              	CALL	CMP16		; CY iff fewer bytes are there than it is back
  089E'   DA 0900'              	JC	LT_NO
  08A1'   CD 0BCC'              	CALL	G2P
  08A4'   EB                    	XCHG
  08A5'   2A 0000*              	LHLD	GAPBEG
  08A8'   EB                    	XCHG			; HL = the table's first line, DE = the gap
  08A9'   0C                    	INR	C
  08AA'   C3 08EA'              	JMP	LT_2
  08AD'                         LT_0:
  08AD'   7D                    	MOV	A,L
  08AE'   B7                    	ORA	A
  08AF'   C2 08B8'              	JNZ	LT_1
  08B2'   2A 1064'              	LHLD	CBOL
