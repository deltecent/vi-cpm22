  0B81'   E1                    	POP	H
  0B82'   11 0000               	LXI	D,0
  0B85'                         LM_FL:
  0B85'   CD 0A19'              	CALL	FLINE
  0B88'                         LM_ST:
  0B88'   22 104D'              	SHLD	RDHL
  0B8B'   60                    	MOV	H,B
  0B8C'   69                    	MOV	L,C
  0B8D'   22 104F'              	SHLD	RDBC
  0B90'   B7                    	ORA	A
  0B91'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0B92'                         LYTOPP:
  0B92'   2A 102D'              	LHLD	TOPLEN
  0B95'   44                    	MOV	B,H
  0B96'   4D                    	MOV	C,L
  0B97'                         G2P:
  0B97'   EB                    	XCHG
  0B98'   2A 0000*              	LHLD	GAPBEG
  0B9B'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0B9E'                         LNW:
  0B9E'   11 0000               	LXI	D,0
  0BA1'                         LNW_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0BA1'   78                    	MOV	A,B
  0BA2'   B1                    	ORA	C
  0BA3'   C8                    	RZ
  0BA4'   7E                    	MOV	A,M
  0BA5'   23                    	INX	H
  0BA6'   0B                    	DCX	B
  0BA7'   FE 20                 	CPI	' '
  0BA9'   D2 0BBF'              	JNC	LNW_1		; (nearly all of them: asked first)
  0BAC'   FE 0A                 	CPI	LF
  0BAE'   CA 0BC3'              	JZ	LNW_LF
  0BB1'   FE 0D                 	CPI	CR
  0BB3'   CA 0BA1'              	JZ	LNW_LP		; CR contributes no display column
  0BB6'   FE 09                 	CPI	TAB
  0BB8'   C2 0BBF'              	JNZ	LNW_1
  0BBB'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0BBC'   F6 07                 	ORI	TABWID-1
  0BBE'   5F                    	MOV	E,A
  0BBF'                         LNW_1:
  0BBF'   13                    	INX	D
  0BC0'   C3 0BA1'              	JMP	LNW_LP
  0BC3'                         LNW_LF:
  0BC3'   37                    	STC
  0BC4'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0BC5'                         LYFAR:
  0BC5'   2A 0FF9'              	LHLD	WINROW
  0BC8'   EB                    	XCHG
  0BC9'   2A 0000*              	LHLD	LNDLT
  0BCC'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0BCD'   7C                    	MOV	A,H
  0BCE'   B7                    	ORA	A
  0BCF'   F2 0BE6'              	JP	LF_DN
  0BD2'   3A 0FF8'              	LDA	NEDIT
  0BD5'   B7                    	ORA	A
  0BD6'   1F                    	RAR
  0BD7'   D6 02                 	SUI	2
  0BD9'   5F                    	MOV	E,A
  0BDA'   16 00                 	MVI	D,0
  0BDC'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0BDD'   7C                    	MOV	A,H
  0BDE'   B7                    	ORA	A
  0BDF'   F0                    	RP
  0BE0'                         LF_FAR:
  0BE0'   3E 02                 	MVI	A,PL_MID
  0BE2'   32 102B'              	STA	PLACE
  0BE5'   C9                    	RET
  0BE6'                         LF_DN:
  0BE6'   3A 1001'              	LDA	SCBOT
  0BE9'   3C                    	INR	A
  0BEA'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BEB'   16 00                 	MVI	D,0
  0BED'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0BF0'   7C                    	MOV	A,H		;   less one
  0BF1'   B7                    	ORA	A
  0BF2'   F8                    	RM			; on the screen
  0BF3'   C2 0BE0'              	JNZ	LF_FAR
  0BF6'   3A 0FF8'              	LDA	NEDIT
  0BF9'   BD                    	CMP	L		; CY iff NEDIT < that
  0BFA'   DA 0BE0'              	JC	LF_FAR
  0BFD'   7D                    	MOV	A,L
  0BFE'   32 103E'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0C01'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0C02'                         HTBLD:
  0C02'   79                    	MOV	A,C
  0C03'   32 1041'              	STA	HTLIM
  0C06'   AF                    	XRA	A
  0C07'   32 0000*              	STA	HTN
  0C0A'   32 101F'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0C0D'   32 0000*              	STA	HTEOF
  0C10'   32 0000*              	STA	HTBOF
  0C13'   32 1042'              	STA	LYXE
  0C16'   32 101C'              	STA	TALLF
  0C19'   68                    	MOV	L,B
  0C1A'   67                    	MOV	H,A
  0C1B'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0C1E'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0C1F'   E5                    	PUSH	H
  0C20'   CD 0A74'              	CALL	ISBOF
  0C23'   C2 0C2A'              	JNZ	HB_1
  0C26'   3C                    	INR	A
  0C27'   32 0000*              	STA	HTBOF
  0C2A'                         HB_1:
  0C2A'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C2B'   E5                    	PUSH	H
  0C2C'   CD 0B97'              	CALL	G2P		; HL = the bytes from there to the cursor
  0C2F'   E5                    	PUSH	H
  0C30'   3A 0FF7'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0C33'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0C35'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0C36'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0C38'   3A 0FF8'              	LDA	NEDIT		;   leave no room to read down
  0C3B'   CD 0EC9'              	CALL	MULHA
  0C3E'   D1                    	POP	D
  0C3F'   42                    	MOV	B,D
  0C40'   4B                    	MOV	C,E
  0C41'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0C44'   D2 0C48'              	JNC	HB_LM
  0C47'   EB                    	XCHG
  0C48'                         HB_LM:
  0C48'   22 1039'              	SHLD	LYLIM
  0C4B'   E1                    	POP	H
  0C4C'   F1                    	POP	PSW
  0C4D'   D2 0C57'              	JNC	HB_A0
  0C50'   3A 0000*              	LDA	HTBOF
  0C53'   B7                    	ORA	A
  0C54'   CC 0B9E'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C57'                         HB_A0:
  0C57'   E5                    	PUSH	H
  0C58'   CD 0B97'              	CALL	G2P
  0C5B'   22 1023'              	SHLD	HTTOPC		; (LYTP: the top line is found from here)
  0C5E'   E1                    	POP	H
  0C5F'                         HB_AB:
  0C5F'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C60'   CD 0B9E'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0C63'   D2 0C86'              	JNC	HB_CU
  0C66'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0C67'   C5                    	PUSH	B
  0C68'   EB                    	XCHG
  0C69'   CD 05D3'              	CALL	XTRA		; BC = its rows past the first
  0C6C'   78                    	MOV	A,B
  0C6D'   B7                    	ORA	A
  0C6E'   C2 0C7B'              	JNZ	HB_TA
  0C71'   3A 0FF8'              	LDA	NEDIT
  0C74'   3D                    	DCR	A
  0C75'   B9                    	CMP	C		; CY iff more rows than the screen has
  0C76'   79                    	MOV	A,C
  0C77'   3C                    	INR	A
  0C78'   D2 0C7E'              	JNC	HB_PA
  0C7B'                         HB_TA:
  0C7B'   3A 0FF8'              	LDA	NEDIT
  0C7E'                         HB_PA:
  0C7E'   CD 0D97'              	CALL	HTPUT
  0C81'   C1                    	POP	B
  0C82'   E1                    	POP	H
  0C83'   C3 0C5F'              	JMP	HB_AB
  0C86'                         HB_CU:
  0C86'   EB                    	XCHG
  0C87'   22 1031'              	SHLD	CURDCL
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C8A'   E1                    	POP	H
  0C8B'   22 102F'              	SHLD	CBOL
  0C8E'   EB                    	XCHG			; none of it spilled while reading down: the
  0C8F'   2A 1039'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0C92'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0C95'   DA 0C99'              	JC	HB_WL
  0C98'   EB                    	XCHG
  0C99'                         HB_WL:
  0C99'   24                    	INR	H
  0C9A'   22 0000*              	SHLD	WRLIM
  0C9D'   3A 0000*              	LDA	HTN
  0CA0'   32 0000*              	STA	HTCUR
  0CA3'   2A 1031'              	LHLD	CURDCL
  0CA6'   CD 05DA'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0CA9'   5F                    	MOV	E,A
  0CAA'   3A 1031'              	LDA	CURDCL
  0CAD'   93                    	SUB	E
  0CAE'   32 1038'              	STA	LYVB		; the column the cursor's row starts at
  0CB1'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0CB2'   2A 0FFB'              	LHLD	SKIPR
  0CB5'   50                    	MOV	D,B
  0CB6'   59                    	MOV	E,C
  0CB7'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0CBA'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0CBB'   DA 0CD9'              	JC	HB_SS		; then that is the first
  0CBE'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0CC1'   7C                    	MOV	A,H
  0CC2'   B7                    	ORA	A
  0CC3'   C2 0CCF'              	JNZ	HB_SD
  0CC6'   3A 0FF8'              	LDA	NEDIT
  0CC9'   3D                    	DCR	A
  0CCA'   BD                    	CMP	L		; CY iff that is under the last edit row
  0CCB'   EB                    	XCHG			; HL = SKIPR, as it was
  0CCC'   D2 0CD9'              	JNC	HB_SS
  0CCF'                         HB_SD:
  0CCF'   3A 0FF8'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0CD2'   2F                    	CMA
  0CD3'   6F                    	MOV	L,A
  0CD4'   26 FF                 	MVI	H,0FFH
  0CD6'   23                    	INX	H
  0CD7'   23                    	INX	H
  0CD8'   09                    	DAD	B
  0CD9'                         HB_SS:
  0CD9'   22 0FFB'              	SHLD	SKIPR
  0CDC'   EB                    	XCHG
  0CDD'   60                    	MOV	H,B
  0CDE'   69                    	MOV	L,C
  0CDF'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0CE2'   7D                    	MOV	A,L
  0CE3'   32 1004'              	STA	CSRAW
  0CE6'   D1                    	POP	D
  0CE7'   57                    	MOV	D,A
  0CE8'   CD 0000*              	CALL	RGET0
  0CEB'   CD 0B85'              	CALL	LM_FL		; the rest of the line: D = its last row
  0CEE'   F5                    	PUSH	PSW
  0CEF'   FE 01                 	CPI	1
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CF1'   CA 0D80'              	JZ	HB_TO		; more rows than the screen has
  0CF4'   2A 0FFB'              	LHLD	SKIPR
  0CF7'   7C                    	MOV	A,H
  0CF8'   B5                    	ORA	L
  0CF9'   CA 0D1C'              	JZ	HB_E2
  0CFC'   7C                    	MOV	A,H
  0CFD'   B7                    	ORA	A
  0CFE'   C2 0D17'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0D01'   7D                    	MOV	A,L
  0D02'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0D03'   DA 0D17'              	JC	HB_TE
  0D06'   21 0FF8'              	LXI	H,NEDIT
  0D09'   BE                    	CMP	M
  0D0A'   D2 0D17'              	JNC	HB_TE		; more than NEDIT of them
  0D0D'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0D0E'   21 0000               	LXI	H,0
  0D11'   22 0FFB'              	SHLD	SKIPR
  0D14'   C3 0D1C'              	JMP	HB_E2
  0D17'                         HB_TE:
  0D17'   3E 01                 	MVI	A,1
  0D19'   32 101C'              	STA	TALLF
  0D1C'                         HB_E2:
  0D1C'   7B                    	MOV	A,E
  0D1D'   B7                    	ORA	A
  0D1E'   C2 0D2A'              	JNZ	HB_E3
  0D21'   B2                    	ORA	D
  0D22'   CA 0D2A'              	JZ	HB_E3		; (its first row: an empty line)
  0D25'   3E 01                 	MVI	A,1
  0D27'   32 1042'              	STA	LYXE
  0D2A'                         HB_E3:
  0D2A'   7A                    	MOV	A,D
  0D2B'   3C                    	INR	A
  0D2C'   32 1005'              	STA	LYTSH
  0D2F'   3A 101C'              	LDA	TALLF
  0D32'   B7                    	ORA	A
  0D33'   C2 0D8B'              	JNZ	HB_TX
  0D36'   F1                    	POP	PSW
  0D37'   FA 0D5C'              	JM	HB_LS		; the text ends with it
  0D3A'                         HB_PT:
  0D3A'   7A                    	MOV	A,D
  0D3B'   3C                    	INR	A
  0D3C'   CD 0D97'              	CALL	HTPUT
  0D3F'   47                    	MOV	B,A
  0D40'   3A 1041'              	LDA	HTLIM
  0D43'   90                    	SUB	B
  0D44'   32 1041'              	STA	HTLIM
  0D47'   D8                    	RC
  0D48'   CA 0D67'              	JZ	HB_PK		; rows enough
  0D4B'                         HB_NX:
  0D4B'   CD 0B4B'              	CALL	LM_NX		; the next line down
  0D4E'   CA 0D3A'              	JZ	HB_PT
  0D51'   F2 0D94'              	JP	HB_TL		; one taller than the screen
  0D54'   3A 1043'              	LDA	LYLAST		; the text ended: was that a line?
  0D57'   FE 0A                 	CPI	LF
  0D59'   CA 0D61'              	JZ	HB_EF
  0D5C'                         HB_LS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D5C'   7A                    	MOV	A,D
  0D5D'   3C                    	INR	A
  0D5E'   CD 0D97'              	CALL	HTPUT
  0D61'                         HB_EF:
  0D61'   3E 01                 	MVI	A,1
  0D63'   32 0000*              	STA	HTEOF
  0D66'   C9                    	RET
  0D67'                         HB_PK:
  0D67'   2A 104F'              	LHLD	RDBC		; just the rows asked for: is the text over
  0D6A'   44                    	MOV	B,H		;   right there?
  0D6B'   4D                    	MOV	C,L
  0D6C'   2A 104D'              	LHLD	RDHL
  0D6F'   CD 0000*              	CALL	RDGET
  0D72'   D0                    	RNC
  0D73'   C3 0D61'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0D76'                         HBMOR:
  0D76'   32 1041'              	STA	HTLIM
  0D79'   B7                    	ORA	A
  0D7A'   CA 0D67'              	JZ	HB_PK
  0D7D'   C3 0D4B'              	JMP	HB_NX
  0D80'                         HB_TO:
  0D80'   3E 01                 	MVI	A,1
  0D82'   32 101C'              	STA	TALLF
  0D85'   3A 0FF8'              	LDA	NEDIT
  0D88'   32 1005'              	STA	LYTSH
  0D8B'                         HB_TX:
  0D8B'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0D8C'   F2 0D94'              	JP	HB_TL		;   with it, and on the screen)
  0D8F'   3E 01                 	MVI	A,1
  0D91'   32 0000*              	STA	HTEOF
  0D94'                         HB_TL:
  0D94'   3A 0FF8'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0D97'                         HTPUT:
  0D97'   E5                    	PUSH	H
  0D98'   D5                    	PUSH	D
  0D99'   21 0000*              	LXI	H,HTN
  0D9C'   5E                    	MOV	E,M
  0D9D'   1C                    	INR	E
  0D9E'   CA 0DAA'              	JZ	HP_1
  0DA1'   73                    	MOV	M,E
  0DA2'   1D                    	DCR	E
  0DA3'   16 00                 	MVI	D,0
  0DA5'   21 0000*              	LXI	H,HTAB
  0DA8'   19                    	DAD	D
  0DA9'   77                    	MOV	M,A
  0DAA'                         HP_1:
  0DAA'   D1                    	POP	D
  0DAB'   E1                    	POP	H
  0DAC'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0DAD'                         TABCUR:
  0DAD'   3A 0000*              	LDA	EDMODE
  0DB0'   FE 00                 	CPI	EM_CMD
  0DB2'   C0                    	RNZ
  0DB3'   2A 0000*              	LHLD	TXTEND
  0DB6'   EB                    	XCHG
  0DB7'   2A 0000*              	LHLD	GAPEND
  0DBA'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0DBD'   C8                    	RZ
  0DBE'   7E                    	MOV	A,M
  0DBF'   FE 09                 	CPI	TAB
  0DC1'   C0                    	RNZ
  0DC2'   2A 1031'              	LHLD	CURDCL
  0DC5'   7D                    	MOV	A,L
  0DC6'   F6 07                 	ORI	TABWID-1
  0DC8'   6F                    	MOV	L,A
  0DC9'   22 1031'              	SHLD	CURDCL
  0DCC'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0DCD'                         RDTOP:
  0DCD'   2A 102D'              	LHLD	TOPLEN
  0DD0'   C3 0DD6'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0DD3'                         RDBOL:
  0DD3'   2A 102F'              	LHLD	CBOL
  0DD6'                         RDSET:
  0DD6'   22 104B'              	SHLD	RDN
  0DD9'   EB                    	XCHG
  0DDA'   2A 0000*              	LHLD	GAPBEG
  0DDD'   CD 0000*              	CALL	SUBHD
  0DE0'   22 1049'              	SHLD	RDP
  0DE3'   AF                    	XRA	A
  0DE4'   32 1051'              	STA	RDSEG
  0DE7'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0DE8'                         RDCH:
  0DE8'   C5                    	PUSH	B
  0DE9'   D5                    	PUSH	D
  0DEA'   E5                    	PUSH	H
  0DEB'   2A 104B'              	LHLD	RDN		; before-gap bytes left?
  0DEE'   7C                    	MOV	A,H
  0DEF'   B5                    	ORA	L
  0DF0'   CA 0E03'              	JZ	RDC_AF
  0DF3'   2B                    	DCX	H
  0DF4'   22 104B'              	SHLD	RDN
  0DF7'   2A 1049'              	LHLD	RDP
  0DFA'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0DFB'   23                    	INX	H
  0DFC'   22 1049'              	SHLD	RDP
  0DFF'   B7                    	ORA	A		; CY=0
  0E00'   C3 0E27'              	JMP	RDC_RT
  0E03'                         RDC_AF:
  0E03'   3A 1051'              	LDA	RDSEG
  0E06'   B7                    	ORA	A
  0E07'   C2 0E14'              	JNZ	RDC_NX
  0E0A'   3C                    	INR	A		; first after-gap byte: start RGET
  0E0B'   32 1051'              	STA	RDSEG
  0E0E'   CD 0000*              	CALL	RGET0
  0E11'   C3 0E1C'              	JMP	RDC_GT
  0E14'                         RDC_NX:
  0E14'   2A 104F'              	LHLD	RDBC
  0E17'   44                    	MOV	B,H
  0E18'   4D                    	MOV	C,L
  0E19'   2A 104D'              	LHLD	RDHL
  0E1C'                         RDC_GT:
  0E1C'   CD 0000*              	CALL	RDGET
  0E1F'   22 104D'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0E22'   60                    	MOV	H,B
  0E23'   69                    	MOV	L,C
  0E24'   22 104F'              	SHLD	RDBC
  0E27'                         RDC_RT:
  0E27'   E1                    	POP	H
  0E28'   D1                    	POP	D
  0E29'   C1                    	POP	B
  0E2A'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).  What is in
                                ; memory is passed over where it lies, before the gap and after it; RDCH
                                ; reads on only when those bytes run out with lines still to pass.
  0E2B'                         RDSKIP:
  0E2B'   B7                    	ORA	A
  0E2C'   C8                    	RZ
  0E2D'   32 1052'              	STA	SKPN
  0E30'   2A 104B'              	LHLD	RDN
  0E33'   44                    	MOV	B,H
  0E34'   4D                    	MOV	C,L
  0E35'   2A 1049'              	LHLD	RDP
  0E38'   CD 0E7D'              	CALL	RSK_M
  0E3B'   22 1049'              	SHLD	RDP
  0E3E'   60                    	MOV	H,B
  0E3F'   69                    	MOV	L,C
  0E40'   22 104B'              	SHLD	RDN
  0E43'   C8                    	RZ
  0E44'   3A 1051'              	LDA	RDSEG
  0E47'   B7                    	ORA	A
  0E48'   C2 0E55'              	JNZ	RSK_A
  0E4B'   3C                    	INR	A		; first after-gap byte: start RGET
  0E4C'   32 1051'              	STA	RDSEG
  0E4F'   CD 0000*              	CALL	RGET0
  0E52'   C3 0E5D'              	JMP	RSK_B
  0E55'                         RSK_A:
  0E55'   2A 104F'              	LHLD	RDBC
  0E58'   44                    	MOV	B,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E59'   4D                    	MOV	C,L
  0E5A'   2A 104D'              	LHLD	RDHL
  0E5D'                         RSK_B:
  0E5D'   CD 0E7D'              	CALL	RSK_M
  0E60'   22 104D'              	SHLD	RDHL
  0E63'   60                    	MOV	H,B
  0E64'   69                    	MOV	L,C
  0E65'   22 104F'              	SHLD	RDBC
  0E68'   C8                    	RZ
  0E69'                         RSK_LP:
  0E69'   CD 0DE8'              	CALL	RDCH
  0E6C'   D8                    	RC
  0E6D'   FE 0A                 	CPI	LF
  0E6F'   C2 0E69'              	JNZ	RSK_LP
  0E72'   3A 1052'              	LDA	SKPN
  0E75'   3D                    	DCR	A
  0E76'   32 1052'              	STA	SKPN
  0E79'   C2 0E69'              	JNZ	RSK_LP
  0E7C'   C9                    	RET
                                ;RSK_M -- pass over SKPN lines in the BC bytes at HL.  Z when that was all of
                                ; them; NZ when the bytes ran out first (SKPN = the lines still to pass).
  0E7D'                         RSK_M:
  0E7D'   78                    	MOV	A,B
  0E7E'   B1                    	ORA	C
  0E7F'   CA 0E95'              	JZ	RSK_E
  0E82'   7E                    	MOV	A,M
  0E83'   23                    	INX	H
  0E84'   0B                    	DCX	B
  0E85'   FE 0A                 	CPI	LF
  0E87'   C2 0E7D'              	JNZ	RSK_M
  0E8A'   3A 1052'              	LDA	SKPN
  0E8D'   3D                    	DCR	A
  0E8E'   32 1052'              	STA	SKPN
  0E91'   C2 0E7D'              	JNZ	RSK_M
  0E94'   C9                    	RET
  0E95'                         RSK_E:
  0E95'   3C                    	INR	A		; (NZ)
  0E96'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0E97'                         PSKIP:
  0E97'   3A 0FF7'              	LDA	NCOLS
  0E9A'   CD 0EC9'              	CALL	MULHA		; HL = the cells to pass over
  0E9D'   EB                    	XCHG
  0E9E'   21 0000               	LXI	H,0
  0EA1'   22 1054'              	SHLD	PSKN
  0EA4'                         PS_LP:
  0EA4'   7A                    	MOV	A,D
  0EA5'   B3                    	ORA	E
  0EA6'   CA 0EFD'              	JZ	PR_LP
  0EA9'   CD 0DE8'              	CALL	RDCH
  0EAC'   FE 0D                 	CPI	CR
  0EAE'   CA 0EA4'              	JZ	PS_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0EB1'   0E 01                 	MVI	C,1
  0EB3'   FE 09                 	CPI	TAB
  0EB5'   CC 0ED3'              	CZ	TABN
  0EB8'                         PS_CL:
  0EB8'   7A                    	MOV	A,D
  0EB9'   B3                    	ORA	E
  0EBA'   CA 0F17'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0EBD'   1B                    	DCX	D
  0EBE'   21 1056'              	LXI	H,DCOL
  0EC1'   34                    	INR	M
  0EC2'   0D                    	DCR	C
  0EC3'   C2 0EB8'              	JNZ	PS_CL
  0EC6'   C3 0EA4'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0EC9'                         MULHA:
  0EC9'   EB                    	XCHG
  0ECA'   21 0000               	LXI	H,0
  0ECD'                         MH_LP:
  0ECD'   19                    	DAD	D
  0ECE'   3D                    	DCR	A
  0ECF'   C2 0ECD'              	JNZ	MH_LP
  0ED2'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0ED3'                         TABN:
  0ED3'   3A 1056'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0ED6'   E6 07                 	ANI	7
  0ED8'   4F                    	MOV	C,A
  0ED9'   3E 08                 	MVI	A,8
  0EDB'   91                    	SUB	C
  0EDC'   4F                    	MOV	C,A
  0EDD'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0EDE'                         PAINTR:
  0EDE'   3A 1053'              	LDA	PROWN
  0EE1'   21 0FFF'              	LXI	H,TXEND
  0EE4'   BE                    	CMP	M		; CY iff the row holds text
  0EE5'   DA 0EEE'              	JC	PROW
  0EE8'   3A 1000'              	LDA	FILCH
  0EEB'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0EEE'                         PROW:
  0EEE'   AF                    	XRA	A
  0EEF'   32 1056'              	STA	DCOL
  0EF2'   32 1057'              	STA	XC
  0EF5'   2A 1054'              	LHLD	PSKN
  0EF8'   7C                    	MOV	A,H
  0EF9'   B5                    	ORA	L
  0EFA'   C2 0E97'              	JNZ	PSKIP
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0EFD'                         PR_LP:
  0EFD'   CD 0DE8'              	CALL	RDCH
  0F00'   D8                    	RC			; end of text -> line done
  0F01'   FE 0A                 	CPI	LF
  0F03'   C8                    	RZ			; consumed the LF -> next line start
  0F04'   FE 0D                 	CPI	CR
  0F06'   CA 0EFD'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0F09'   FE 09                 	CPI	TAB
  0F0B'   CA 0F14'              	JZ	PR_TAB
  0F0E'   CD 0F23'              	CALL	PCELL
  0F11'   C3 0EFD'              	JMP	PR_LP
  0F14'                         PR_TAB:
  0F14'   CD 0ED3'              	CALL	TABN		; C = space count (1..8)
  0F17'                         PRTBLP:
  0F17'   3E 20                 	MVI	A,' '
  0F19'   CD 0F23'              	CALL	PCELL		; (keeps C)
  0F1C'   0D                    	DCR	C
  0F1D'   C2 0F17'              	JNZ	PRTBLP
  0F20'   C3 0EFD'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0F23'                         PCELL:
  0F23'   47                    	MOV	B,A
  0F24'   21 1056'              	LXI	H,DCOL
  0F27'   34                    	INR	M
  0F28'   3A 0FF7'              	LDA	NCOLS
  0F2B'   21 1057'              	LXI	H,XC
  0F2E'   BE                    	CMP	M
  0F2F'   CC 0F37'              	CZ	PWRAP		; the row is full: this one starts the next
  0F32'   34                    	INR	M
  0F33'   78                    	MOV	A,B
  0F34'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0F37'                         PWRAP:
  0F37'   36 00                 	MVI	M,0
  0F39'   3A 101B'              	LDA	PEND
  0F3C'   3D                    	DCR	A
  0F3D'   21 1053'              	LXI	H,PROWN
  0F40'   BE                    	CMP	M
  0F41'   CA 0F56'              	JZ	PW_END
  0F44'   34                    	INR	M
  0F45'   3E 0D                 	MVI	A,CR
  0F47'   CD 0018'              	CALL	OUTCH
  0F4A'   3E 0A                 	MVI	A,LF
  0F4C'   CD 0018'              	CALL	OUTCH
  0F4F'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0F52'   21 1057'              	LXI	H,XC
  0F55'   C9                    	RET
  0F56'                         PW_END:
  0F56'   E1                    	POP	H		; PCELL's return, and PROW's
  0F57'   E1                    	POP	H
  0F58'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0F59'                         MODEMS:
  0F59'   3A 0000*              	LDA	EDMODE
  0F5C'   47                    	MOV	B,A
  0F5D'   3A 1028'              	LDA	OEDMOD
  0F60'   B8                    	CMP	B
  0F61'   C8                    	RZ			; the row already shows this mode
  0F62'   78                    	MOV	A,B
  0F63'   32 1028'              	STA	OEDMOD
  0F66'   21 0FD6'              	LXI	H,SINSM
  0F69'   FE 01                 	CPI	EM_INS
  0F6B'   CA 0F79'              	JZ	MD_DRW
  0F6E'   21 0FE3'              	LXI	H,SREPM
  0F71'   FE 02                 	CPI	EM_REP
  0F73'   CA 0F79'              	JZ	MD_DRW
  0F76'   21 0FF1'              	LXI	H,SNULL		; command mode: the row goes blank
  0F79'                         MD_DRW:
  0F79'   E5                    	PUSH	H
  0F7A'   3A 0FF6'              	LDA	NROWS
  0F7D'   CD 008C'              	CALL	GOROW1
  0F80'   E1                    	POP	H
  0F81'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0F84'                         SCURS:
  0F84'   3A 0FFD'              	LDA	SROW
  0F87'   47                    	MOV	B,A
  0F88'   3A 0FFE'              	LDA	SCOL
  0F8B'   4F                    	MOV	C,A
  0F8C'   CD 0064'              	CALL	GOTOXY
  0F8F'   21 0FCB'              	LXI	H,SSHOW
  0F92'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0F95'                         SCDONE:
  0F95'   CD 0086'              	CALL	CRGRS
  0F98'   21 0FCB'              	LXI	H,SSHOW
  0F9B'   CD 0025'              	CALL	OUTSTR
  0F9E'   3A 0FF6'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0FA1'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0FA4'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0FA8'   39 3B 39 39           
  0FAC'   39 48                 
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0FAE'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0FB2'   00                    
  0FB3'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0FB7'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0FBA'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0FBE'   00                    
  0FBF'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0FC3'   00                    
  0FC4'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0FC8'   35 6C 00              
  0FCB'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0FCF'   35 68 00              
  0FD2'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0FD6'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0FDA'   4E 53 45 52           
  0FDE'   54 20 2D 2D           
  0FE2'   00                    
  0FE3'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0FE7'   45 50 4C 41           
  0FEB'   43 45 20 2D           
  0FEF'   2D 00                 
  0FF1'   00                    SNULL:	DB	0
  0FF2'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0FF6'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0FF7'   50                    NCOLS:	DB	80		; runtime columns
  0FF8'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0FF9'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0FFB'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0FFD'   00                    SROW:	DB	0		; computed cursor screen row
  0FFE'   00                    SCOL:	DB	0		; computed cursor screen column
  0FFF'   01                    TXEND:	DB	1		; the first row with no text on it
  1000'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  1001'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  1002'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  1004'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  1005'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  1006'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  1007'   0000                  OLDWR:	DW	0
  1009'   0000                  OLDSK:	DW	0
  100B'   0000                  OLDSC:	DW	0
  100D'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  100F'   00                    OLDBOT:	DB	0
  1010'   0000                  OLDAB:	DW	0
  1012'   00                    OLDCS:	DB	0
  1013'   00                    OLDCR:	DB	0
  1014'   00                    OLDNR:	DB	0
                                
  1015'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  1016'   00                    OPM:	DB	0		; ... or gained there
  1017'   00                    EDA:	DB	0		; the edit: the rows it had
  1018'   00                    EDB:	DB	0		; ... and has
  1019'   00                    EDR:	DB	0		; ... its first row
  101A'   00                    EDP:	DB	0		; ... the first of them to draw
  101B'   00                    PEND:	DB	0		; PRNG: the row to stop before
  101C'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  101D'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  101F'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  1020'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  1021'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  1023'   0000                  HTTOPC: DW	0		; HTBLD: the bytes from the table's first line to
                                				;   the cursor
  1025'   0000                  LYPG:	DW	0		; ... and PGTOPM
  1027'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  1028'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  1029'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  102A'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  102B'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  102C'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  102D'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  102F'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  1031'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  1033'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  1035'   00                    LYROW:	DB	0		; LAYOUT: working row
  1036'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  1038'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  1039'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  103B'   00                    LYUSE:	DB	0		; LYMID: rows taken
  103C'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  103D'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  103E'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  103F'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  1040'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  1041'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  1042'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  1043'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  1044'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  1046'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  1048'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  1049'   0000                  RDP:	DW	0		; reader: next before-gap byte
  104B'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  104D'   0000                  RDHL:	DW	0		; reader: RGET pointer
  104F'   0000                  RDBC:	DW	0		; reader: RGET count
  1051'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  1052'   00                    SKPN:	DB	0		; RDSKIP line count
  1053'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  1054'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  1056'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  1057'   00                    XC:	DB	0		; cells used in the row being painted
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  1058'   0000                  TMPR:	DW	0		; DSR parse: rows
  105A'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
