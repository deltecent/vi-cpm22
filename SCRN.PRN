  07A7'   FE 01                 	CPI	1
  07A9'   CA 07BF'              	JZ	LQK_N		; more rows than the screen has
  07AC'   7B                    	MOV	A,E
  07AD'   B7                    	ORA	A
  07AE'   C2 07B5'              	JNZ	LQK_2
  07B1'   B2                    	ORA	D
  07B2'   C2 07BF'              	JNZ	LQK_N		; the cursor has a row to itself (LYXE)
  07B5'                         LQK_2:
  07B5'   3A 0D3F'              	LDA	LYTSH
  07B8'   3D                    	DCR	A
  07B9'   BA                    	CMP	D
  07BA'   C2 07BF'              	JNZ	LQK_N		; other rows than it had
  07BD'   37                    	STC
  07BE'   C9                    	RET
  07BF'                         LQK_N:
  07BF'   AF                    	XRA	A
  07C0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                
                                ;LQMV -- Z iff the key only moved the cursor, in command mode.  Keeps BC, DE.
  07C1'                         LQMV:
  07C1'   3A 0000*              	LDA	RINTENT
  07C4'   FE 01                 	CPI	R_MOVE
  07C6'   C0                    	RNZ
  07C7'   3A 0000*              	LDA	EDMODE
  07CA'   FE 00                 	CPI	EM_CMD
  07CC'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  07CD'                         LYMQ:
  07CD'   3A 0D63'              	LDA	PLACE
  07D0'   FE 02                 	CPI	PL_MID
  07D2'   C8                    	RZ
  07D3'   3A 0D76'              	LDA	LYND
  07D6'   B7                    	ORA	A
  07D7'   CA 07DC'              	JZ	LQ_NO
  07DA'   AF                    	XRA	A
  07DB'   C9                    	RET
  07DC'                         LQ_NO:
  07DC'   3C                    	INR	A
  07DD'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  07DE'                         FLINE:
  07DE'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  07E1'   DA 081E'              	JC	FL_EOF
  07E4'   32 0D7B'              	STA	LYLAST
  07E7'   FE 0A                 	CPI	LF
  07E9'   CA 081C'              	JZ	FL_LF
  07EC'   FE 0D                 	CPI	CR
  07EE'   CA 07DE'              	JZ	FLINE		; CR contributes no display column
  07F1'   FE 09                 	CPI	TAB
  07F3'   CA 07FF'              	JZ	FL_TAB
  07F6'   CD 0821'              	CALL	FL_CEL
  07F9'   C2 07DE'              	JNZ	FLINE
  07FC'                         FL_OVR:
  07FC'   3E 01                 	MVI	A,1
  07FE'   C9                    	RET
  07FF'                         FL_TAB:
  07FF'   3A 0D70'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0802'   83                    	ADD	E
  0803'   E6 07                 	ANI	TABWID-1
  0805'   2F                    	CMA
  0806'   C6 09                 	ADI	TABWID+1
  0808'   E5                    	PUSH	H
  0809'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  080A'                         FT_LP:
  080A'   CD 0821'              	CALL	FL_CEL
  080D'   CA 0818'              	JZ	FT_OVR
  0810'   2D                    	DCR	L
  0811'   C2 080A'              	JNZ	FT_LP
  0814'   E1                    	POP	H
  0815'   C3 07DE'              	JMP	FLINE
  0818'                         FT_OVR:
  0818'   E1                    	POP	H
  0819'   C3 07FC'              	JMP	FL_OVR
  081C'                         FL_LF:
  081C'   AF                    	XRA	A
  081D'   C9                    	RET
  081E'                         FL_EOF:
  081E'   3E FF                 	MVI	A,0FFH
  0820'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  0821'                         FL_CEL:
  0821'   3A 0D31'              	LDA	NCOLS
  0824'   BB                    	CMP	E
  0825'   C2 0837'              	JNZ	FC_1
  0828'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  082A'   14                    	INR	D
  082B'   E5                    	PUSH	H
  082C'   21 0D70'              	LXI	H,LYVB
  082F'   86                    	ADD	M
  0830'   77                    	MOV	M,A
  0831'   E1                    	POP	H
  0832'   3A 0D32'              	LDA	NEDIT
  0835'   BA                    	CMP	D
  0836'   C8                    	RZ
  0837'                         FC_1:
  0837'   1C                    	INR	E		; (NZ)
  0838'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  0839'                         ISBOF:
  0839'   EB                    	XCHG
  083A'   2A 0000*              	LHLD	TXTBEG
  083D'   CD 0000*              	CALL	CMP16
  0840'   C0                    	RNZ
  0841'   2A 0000*              	LHLD	OUTPOS
  0844'   7C                    	MOV	A,H
  0845'   B5                    	ORA	L
  0846'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  0847'                         LYMID:
  0847'   CD 0893'              	CALL	LYINI
  084A'   3A 0D76'              	LDA	LYND
  084D'   B7                    	ORA	A
  084E'   CA 0876'              	JZ	LM_LP
  0851'                         LM_NR:
  0851'   CD 08DA'              	CALL	LMABV		; a line above and a line below, LYND times
  0854'   DA 086B'              	JC	LM_P
  0857'   CD 08AC'              	CALL	LMBLW
  085A'   DA 086B'              	JC	LM_P
  085D'   21 0D76'              	LXI	H,LYND
  0860'   35                    	DCR	M
  0861'   C2 0851'              	JNZ	LM_NR
  0864'   3A 0D78'              	LDA	LYSVR		; the screen holds them: scroll to it
  0867'   32 0D6D'              	STA	LYROW
  086A'   C9                    	RET
  086B'                         LM_P:
  086B'   AF                    	XRA	A		; it does not: the middle, above first
  086C'   32 0D76'              	STA	LYND
  086F'   3C                    	INR	A
  0870'   32 0D77'              	STA	LYPRF
  0873'   C3 0847'              	JMP	LYMID
  0876'                         LM_LP:
  0876'   3A 0D75'              	LDA	LYMBL
  0879'   21 0D77'              	LXI	H,LYPRF
  087C'   86                    	ADD	M
  087D'   47                    	MOV	B,A
  087E'   3A 0D74'              	LDA	LYMAB
  0881'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0882'   DA 088C'              	JC	LM_U		;   many, when above goes first)
  0885'   CD 08AC'              	CALL	LMBLW
  0888'   D2 0876'              	JNC	LM_LP
  088B'   C9                    	RET
  088C'                         LM_U:
  088C'   CD 08DA'              	CALL	LMABV
  088F'   D2 0876'              	JNC	LM_LP
  0892'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0893'                         LYINI:
  0893'   AF                    	XRA	A
  0894'   32 0D6D'              	STA	LYROW
  0897'   32 0D74'              	STA	LYMAB
  089A'   32 0D75'              	STA	LYMBL
  089D'   3A 0000*              	LDA	HTCUR
  08A0'   CD 08F6'              	CALL	HTE
  08A3'   7E                    	MOV	A,M
  08A4'   32 0D73'              	STA	LYUSE
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  08A7'   23                    	INX	H
  08A8'   22 0D6E'              	SHLD	LYIB
  08AB'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  08AC'                         LMBLW:
  08AC'   3A 0000*              	LDA	HTN
  08AF'   CD 08F6'              	CALL	HTE
  08B2'   EB                    	XCHG
  08B3'   2A 0D6E'              	LHLD	LYIB
  08B6'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  08B9'   C2 08C8'              	JNZ	LB_1
  08BC'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  08BF'   B7                    	ORA	A
  08C0'   37                    	STC
  08C1'   C8                    	RZ
  08C2'   21 0D75'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  08C5'   34                    	INR	M
  08C6'   B7                    	ORA	A
  08C7'   C9                    	RET
  08C8'                         LB_1:
  08C8'   7E                    	MOV	A,M
  08C9'   CD 08FE'              	CALL	LM_ADD
  08CC'   D8                    	RC
  08CD'   21 0D75'              	LXI	H,LYMBL
  08D0'   86                    	ADD	M
  08D1'   77                    	MOV	M,A
  08D2'   2A 0D6E'              	LHLD	LYIB
  08D5'   23                    	INX	H
  08D6'   22 0D6E'              	SHLD	LYIB
  08D9'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  08DA'                         LMABV:
  08DA'   21 0D6D'              	LXI	H,LYROW
  08DD'   3A 0000*              	LDA	HTCUR
  08E0'   96                    	SUB	M
  08E1'   37                    	STC
  08E2'   C8                    	RZ
  08E3'   3D                    	DCR	A
  08E4'   CD 08F6'              	CALL	HTE
  08E7'   7E                    	MOV	A,M
  08E8'   CD 08FE'              	CALL	LM_ADD
  08EB'   D8                    	RC
  08EC'   21 0D74'              	LXI	H,LYMAB
  08EF'   86                    	ADD	M
  08F0'   77                    	MOV	M,A
  08F1'   21 0D6D'              	LXI	H,LYROW
  08F4'   34                    	INR	M
  08F5'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  08F6'                         HTE:
  08F6'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  08F7'   16 00                 	MVI	D,0
  08F9'   21 0000*              	LXI	H,HTAB
  08FC'   19                    	DAD	D
  08FD'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  08FE'                         LM_ADD:
  08FE'   47                    	MOV	B,A
  08FF'   3A 0D73'              	LDA	LYUSE
  0902'   80                    	ADD	B
  0903'   D8                    	RC
  0904'   4F                    	MOV	C,A
  0905'   3A 0D32'              	LDA	NEDIT
  0908'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0909'   D8                    	RC
  090A'   79                    	MOV	A,C
  090B'   32 0D73'              	STA	LYUSE
  090E'   78                    	MOV	A,B
  090F'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0910'                         LM_NX:
  0910'   11 0000               	LXI	D,0
  0913'   AF                    	XRA	A
  0914'   32 0D70'              	STA	LYVB
  0917'   2A 0D87'              	LHLD	RDBC
  091A'   44                    	MOV	B,H
  091B'   4D                    	MOV	C,L
  091C'   2A 0D85'              	LHLD	RDHL
  091F'                         LM_FL:
  091F'   CD 07DE'              	CALL	FLINE
  0922'   22 0D85'              	SHLD	RDHL
  0925'   60                    	MOV	H,B
  0926'   69                    	MOV	L,C
  0927'   22 0D87'              	SHLD	RDBC
  092A'   B7                    	ORA	A
  092B'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  092C'                         LYTOPP:
  092C'   2A 0D65'              	LHLD	TOPLEN
  092F'   44                    	MOV	B,H
  0930'   4D                    	MOV	C,L
  0931'                         G2P:
  0931'   EB                    	XCHG
  0932'   2A 0000*              	LHLD	GAPBEG
  0935'   C3 0000*              	JMP	SUBHD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0938'                         LNW:
  0938'   11 0000               	LXI	D,0
  093B'                         LNW_LP:
  093B'   78                    	MOV	A,B
  093C'   B1                    	ORA	C
  093D'   C8                    	RZ
  093E'   7E                    	MOV	A,M
  093F'   23                    	INX	H
  0940'   0B                    	DCX	B
  0941'   FE 0A                 	CPI	LF
  0943'   CA 0958'              	JZ	LNW_LF
  0946'   FE 0D                 	CPI	CR
  0948'   CA 093B'              	JZ	LNW_LP		; CR contributes no display column
  094B'   FE 09                 	CPI	TAB
  094D'   C2 0954'              	JNZ	LNW_1
  0950'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0951'   F6 07                 	ORI	TABWID-1
  0953'   5F                    	MOV	E,A
  0954'                         LNW_1:
  0954'   13                    	INX	D
  0955'   C3 093B'              	JMP	LNW_LP
  0958'                         LNW_LF:
  0958'   37                    	STC
  0959'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  095A'                         LYFAR:
  095A'   2A 0D33'              	LHLD	WINROW
  095D'   EB                    	XCHG
  095E'   2A 0000*              	LHLD	LNDLT
  0961'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0962'   7C                    	MOV	A,H
  0963'   B7                    	ORA	A
  0964'   F2 097B'              	JP	LF_DN
  0967'   3A 0D32'              	LDA	NEDIT
  096A'   B7                    	ORA	A
  096B'   1F                    	RAR
  096C'   D6 02                 	SUI	2
  096E'   5F                    	MOV	E,A
  096F'   16 00                 	MVI	D,0
  0971'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0972'   7C                    	MOV	A,H
  0973'   B7                    	ORA	A
  0974'   F0                    	RP
  0975'                         LF_FAR:
  0975'   3E 02                 	MVI	A,PL_MID
  0977'   32 0D63'              	STA	PLACE
  097A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  097B'                         LF_DN:
  097B'   3A 0D3B'              	LDA	SCBOT
  097E'   3C                    	INR	A
  097F'   5F                    	MOV	E,A
  0980'   16 00                 	MVI	D,0
  0982'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0985'   7C                    	MOV	A,H		;   less one
  0986'   B7                    	ORA	A
  0987'   F8                    	RM			; on the screen
  0988'   C2 0975'              	JNZ	LF_FAR
  098B'   3A 0D32'              	LDA	NEDIT
  098E'   BD                    	CMP	L		; CY iff NEDIT < that
  098F'   DA 0975'              	JC	LF_FAR
  0992'   7D                    	MOV	A,L
  0993'   32 0D76'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0996'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0997'                         HTBLD:
  0997'   79                    	MOV	A,C
  0998'   32 0D79'              	STA	HTLIM
  099B'   AF                    	XRA	A
  099C'   32 0000*              	STA	HTN
  099F'   32 0D59'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  09A2'   32 0000*              	STA	HTEOF
  09A5'   32 0000*              	STA	HTBOF
  09A8'   32 0D7A'              	STA	LYXE
  09AB'   32 0D56'              	STA	TALLF
  09AE'   68                    	MOV	L,B
  09AF'   67                    	MOV	H,A
  09B0'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  09B3'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  09B4'   E5                    	PUSH	H
  09B5'   CD 0839'              	CALL	ISBOF
  09B8'   C2 09BF'              	JNZ	HB_1
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  09BB'   3C                    	INR	A
  09BC'   32 0000*              	STA	HTBOF
  09BF'                         HB_1:
  09BF'   E1                    	POP	H
  09C0'   E5                    	PUSH	H
  09C1'   CD 0931'              	CALL	G2P		; HL = the bytes from there to the cursor
  09C4'   E5                    	PUSH	H
  09C5'   3A 0D31'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  09C8'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  09CA'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  09CB'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  09CD'   3A 0D32'              	LDA	NEDIT		;   leave no room to read down
  09D0'   CD 0C03'              	CALL	MULHA
  09D3'   D1                    	POP	D
  09D4'   42                    	MOV	B,D
  09D5'   4B                    	MOV	C,E
  09D6'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  09D9'   D2 09DD'              	JNC	HB_LM
  09DC'   EB                    	XCHG
  09DD'                         HB_LM:
  09DD'   22 0D71'              	SHLD	LYLIM
  09E0'   E1                    	POP	H
  09E1'   F1                    	POP	PSW
  09E2'   D2 09EC'              	JNC	HB_AB
  09E5'   3A 0000*              	LDA	HTBOF
  09E8'   B7                    	ORA	A
  09E9'   CC 0938'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  09EC'                         HB_AB:
  09EC'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  09ED'   CD 0938'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  09F0'   D2 0A13'              	JNC	HB_CU
  09F3'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  09F4'   C5                    	PUSH	B
  09F5'   EB                    	XCHG
  09F6'   CD 0525'              	CALL	XTRA		; BC = its rows past the first
  09F9'   78                    	MOV	A,B
  09FA'   B7                    	ORA	A
  09FB'   C2 0A08'              	JNZ	HB_TA
  09FE'   3A 0D32'              	LDA	NEDIT
  0A01'   3D                    	DCR	A
  0A02'   B9                    	CMP	C		; CY iff more rows than the screen has
  0A03'   79                    	MOV	A,C
  0A04'   3C                    	INR	A
  0A05'   D2 0A0B'              	JNC	HB_PA
  0A08'                         HB_TA:
  0A08'   3A 0D32'              	LDA	NEDIT
  0A0B'                         HB_PA:
  0A0B'   CD 0B24'              	CALL	HTPUT
  0A0E'   C1                    	POP	B
  0A0F'   E1                    	POP	H
  0A10'   C3 09EC'              	JMP	HB_AB
  0A13'                         HB_CU:
  0A13'   EB                    	XCHG
  0A14'   22 0D69'              	SHLD	CURDCL
  0A17'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A18'   22 0D67'              	SHLD	CBOL
  0A1B'   EB                    	XCHG			; none of it spilled while reading down: the
  0A1C'   2A 0D71'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0A1F'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0A22'   DA 0A26'              	JC	HB_WL
  0A25'   EB                    	XCHG
  0A26'                         HB_WL:
  0A26'   24                    	INR	H
  0A27'   22 0000*              	SHLD	WRLIM
  0A2A'   3A 0000*              	LDA	HTN
  0A2D'   32 0000*              	STA	HTCUR
  0A30'   2A 0D69'              	LHLD	CURDCL
  0A33'   CD 052C'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0A36'   5F                    	MOV	E,A
  0A37'   3A 0D69'              	LDA	CURDCL
  0A3A'   93                    	SUB	E
  0A3B'   32 0D70'              	STA	LYVB		; the column the cursor's row starts at
  0A3E'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0A3F'   2A 0D35'              	LHLD	SKIPR
  0A42'   50                    	MOV	D,B
  0A43'   59                    	MOV	E,C
  0A44'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0A47'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0A48'   DA 0A66'              	JC	HB_SS		; then that is the first
  0A4B'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0A4E'   7C                    	MOV	A,H
  0A4F'   B7                    	ORA	A
  0A50'   C2 0A5C'              	JNZ	HB_SD
  0A53'   3A 0D32'              	LDA	NEDIT
  0A56'   3D                    	DCR	A
  0A57'   BD                    	CMP	L		; CY iff that is under the last edit row
  0A58'   EB                    	XCHG			; HL = SKIPR, as it was
  0A59'   D2 0A66'              	JNC	HB_SS
  0A5C'                         HB_SD:
  0A5C'   3A 0D32'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0A5F'   2F                    	CMA
  0A60'   6F                    	MOV	L,A
  0A61'   26 FF                 	MVI	H,0FFH
  0A63'   23                    	INX	H
  0A64'   23                    	INX	H
  0A65'   09                    	DAD	B
  0A66'                         HB_SS:
  0A66'   22 0D35'              	SHLD	SKIPR
  0A69'   EB                    	XCHG
  0A6A'   60                    	MOV	H,B
  0A6B'   69                    	MOV	L,C
  0A6C'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0A6F'   7D                    	MOV	A,L
  0A70'   32 0D3E'              	STA	CSRAW
  0A73'   D1                    	POP	D
  0A74'   57                    	MOV	D,A
  0A75'   CD 0000*              	CALL	RGET0
  0A78'   CD 091F'              	CALL	LM_FL		; the rest of the line: D = its last row
  0A7B'   F5                    	PUSH	PSW
  0A7C'   FE 01                 	CPI	1
  0A7E'   CA 0B0D'              	JZ	HB_TO		; more rows than the screen has
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0A81'   2A 0D35'              	LHLD	SKIPR
  0A84'   7C                    	MOV	A,H
  0A85'   B5                    	ORA	L
  0A86'   CA 0AA9'              	JZ	HB_E2
  0A89'   7C                    	MOV	A,H
  0A8A'   B7                    	ORA	A
  0A8B'   C2 0AA4'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0A8E'   7D                    	MOV	A,L
  0A8F'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0A90'   DA 0AA4'              	JC	HB_TE
  0A93'   21 0D32'              	LXI	H,NEDIT
  0A96'   BE                    	CMP	M
  0A97'   D2 0AA4'              	JNC	HB_TE		; more than NEDIT of them
  0A9A'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0A9B'   21 0000               	LXI	H,0
  0A9E'   22 0D35'              	SHLD	SKIPR
  0AA1'   C3 0AA9'              	JMP	HB_E2
  0AA4'                         HB_TE:
  0AA4'   3E 01                 	MVI	A,1
  0AA6'   32 0D56'              	STA	TALLF
  0AA9'                         HB_E2:
  0AA9'   7B                    	MOV	A,E
  0AAA'   B7                    	ORA	A
  0AAB'   C2 0AB7'              	JNZ	HB_E3
  0AAE'   B2                    	ORA	D
  0AAF'   CA 0AB7'              	JZ	HB_E3		; (its first row: an empty line)
  0AB2'   3E 01                 	MVI	A,1
  0AB4'   32 0D7A'              	STA	LYXE
  0AB7'                         HB_E3:
  0AB7'   7A                    	MOV	A,D
  0AB8'   3C                    	INR	A
  0AB9'   32 0D3F'              	STA	LYTSH
  0ABC'   3A 0D56'              	LDA	TALLF
  0ABF'   B7                    	ORA	A
  0AC0'   C2 0B18'              	JNZ	HB_TX
  0AC3'   F1                    	POP	PSW
  0AC4'   FA 0AE9'              	JM	HB_LS		; the text ends with it
  0AC7'                         HB_PT:
  0AC7'   7A                    	MOV	A,D
  0AC8'   3C                    	INR	A
  0AC9'   CD 0B24'              	CALL	HTPUT
  0ACC'   47                    	MOV	B,A
  0ACD'   3A 0D79'              	LDA	HTLIM
  0AD0'   90                    	SUB	B
  0AD1'   32 0D79'              	STA	HTLIM
  0AD4'   D8                    	RC
  0AD5'   CA 0AF4'              	JZ	HB_PK		; rows enough
  0AD8'                         HB_NX:
  0AD8'   CD 0910'              	CALL	LM_NX		; the next line down
  0ADB'   CA 0AC7'              	JZ	HB_PT
  0ADE'   F2 0B21'              	JP	HB_TL		; one taller than the screen
  0AE1'   3A 0D7B'              	LDA	LYLAST		; the text ended: was that a line?
  0AE4'   FE 0A                 	CPI	LF
  0AE6'   CA 0AEE'              	JZ	HB_EF
  0AE9'                         HB_LS:
  0AE9'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0AEA'   3C                    	INR	A
  0AEB'   CD 0B24'              	CALL	HTPUT
  0AEE'                         HB_EF:
  0AEE'   3E 01                 	MVI	A,1
  0AF0'   32 0000*              	STA	HTEOF
  0AF3'   C9                    	RET
  0AF4'                         HB_PK:
  0AF4'   2A 0D87'              	LHLD	RDBC		; just the rows asked for: is the text over
  0AF7'   44                    	MOV	B,H		;   right there?
  0AF8'   4D                    	MOV	C,L
  0AF9'   2A 0D85'              	LHLD	RDHL
  0AFC'   CD 0000*              	CALL	RDGET
  0AFF'   D0                    	RNC
  0B00'   C3 0AEE'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0B03'                         HBMOR:
  0B03'   32 0D79'              	STA	HTLIM
  0B06'   B7                    	ORA	A
  0B07'   CA 0AF4'              	JZ	HB_PK
  0B0A'   C3 0AD8'              	JMP	HB_NX
  0B0D'                         HB_TO:
  0B0D'   3E 01                 	MVI	A,1
  0B0F'   32 0D56'              	STA	TALLF
  0B12'   3A 0D32'              	LDA	NEDIT
  0B15'   32 0D3F'              	STA	LYTSH
  0B18'                         HB_TX:
  0B18'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0B19'   F2 0B21'              	JP	HB_TL		;   with it, and on the screen)
  0B1C'   3E 01                 	MVI	A,1
  0B1E'   32 0000*              	STA	HTEOF
  0B21'                         HB_TL:
  0B21'   3A 0D32'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0B24'                         HTPUT:
  0B24'   E5                    	PUSH	H
  0B25'   D5                    	PUSH	D
  0B26'   21 0000*              	LXI	H,HTN
  0B29'   5E                    	MOV	E,M
  0B2A'   1C                    	INR	E
  0B2B'   CA 0B37'              	JZ	HP_1
  0B2E'   73                    	MOV	M,E
  0B2F'   1D                    	DCR	E
  0B30'   16 00                 	MVI	D,0
  0B32'   21 0000*              	LXI	H,HTAB
  0B35'   19                    	DAD	D
  0B36'   77                    	MOV	M,A
  0B37'                         HP_1:
  0B37'   D1                    	POP	D
  0B38'   E1                    	POP	H
  0B39'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B3A'                         TABCUR:
  0B3A'   3A 0000*              	LDA	EDMODE
  0B3D'   FE 00                 	CPI	EM_CMD
  0B3F'   C0                    	RNZ
  0B40'   2A 0000*              	LHLD	TXTEND
  0B43'   EB                    	XCHG
  0B44'   2A 0000*              	LHLD	GAPEND
  0B47'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0B4A'   C8                    	RZ
  0B4B'   7E                    	MOV	A,M
  0B4C'   FE 09                 	CPI	TAB
  0B4E'   C0                    	RNZ
  0B4F'   2A 0D69'              	LHLD	CURDCL
  0B52'   7D                    	MOV	A,L
  0B53'   F6 07                 	ORI	TABWID-1
  0B55'   6F                    	MOV	L,A
  0B56'   22 0D69'              	SHLD	CURDCL
  0B59'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0B5A'                         RDTOP:
  0B5A'   2A 0D65'              	LHLD	TOPLEN
  0B5D'   C3 0B63'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0B60'                         RDBOL:
  0B60'   2A 0D67'              	LHLD	CBOL
  0B63'                         RDSET:
  0B63'   22 0D83'              	SHLD	RDN
  0B66'   EB                    	XCHG
  0B67'   2A 0000*              	LHLD	GAPBEG
  0B6A'   CD 0000*              	CALL	SUBHD
  0B6D'   22 0D81'              	SHLD	RDP
  0B70'   AF                    	XRA	A
  0B71'   32 0D89'              	STA	RDSEG
  0B74'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0B75'                         RDCH:
  0B75'   C5                    	PUSH	B
  0B76'   D5                    	PUSH	D
  0B77'   E5                    	PUSH	H
  0B78'   2A 0D83'              	LHLD	RDN		; before-gap bytes left?
  0B7B'   7C                    	MOV	A,H
  0B7C'   B5                    	ORA	L
  0B7D'   CA 0B90'              	JZ	RDC_AF
  0B80'   2B                    	DCX	H
  0B81'   22 0D83'              	SHLD	RDN
  0B84'   2A 0D81'              	LHLD	RDP
  0B87'   7E                    	MOV	A,M
  0B88'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B89'   22 0D81'              	SHLD	RDP
  0B8C'   B7                    	ORA	A		; CY=0
  0B8D'   C3 0BB4'              	JMP	RDC_RT
  0B90'                         RDC_AF:
  0B90'   3A 0D89'              	LDA	RDSEG
  0B93'   B7                    	ORA	A
  0B94'   C2 0BA1'              	JNZ	RDC_NX
  0B97'   3C                    	INR	A		; first after-gap byte: start RGET
  0B98'   32 0D89'              	STA	RDSEG
  0B9B'   CD 0000*              	CALL	RGET0
  0B9E'   C3 0BA9'              	JMP	RDC_GT
  0BA1'                         RDC_NX:
  0BA1'   2A 0D87'              	LHLD	RDBC
  0BA4'   44                    	MOV	B,H
  0BA5'   4D                    	MOV	C,L
  0BA6'   2A 0D85'              	LHLD	RDHL
  0BA9'                         RDC_GT:
  0BA9'   CD 0000*              	CALL	RDGET
  0BAC'   22 0D85'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0BAF'   60                    	MOV	H,B
  0BB0'   69                    	MOV	L,C
  0BB1'   22 0D87'              	SHLD	RDBC
  0BB4'                         RDC_RT:
  0BB4'   E1                    	POP	H
  0BB5'   D1                    	POP	D
  0BB6'   C1                    	POP	B
  0BB7'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0BB8'                         RDSKIP:
  0BB8'   B7                    	ORA	A
  0BB9'   C8                    	RZ
  0BBA'   32 0D8A'              	STA	SKPN
  0BBD'                         RSK_LP:
  0BBD'   CD 0B75'              	CALL	RDCH
  0BC0'   D8                    	RC
  0BC1'   FE 0A                 	CPI	LF
  0BC3'   C2 0BBD'              	JNZ	RSK_LP
  0BC6'   3A 0D8A'              	LDA	SKPN
  0BC9'   3D                    	DCR	A
  0BCA'   32 0D8A'              	STA	SKPN
  0BCD'   C2 0BBD'              	JNZ	RSK_LP
  0BD0'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0BD1'                         PSKIP:
  0BD1'   3A 0D31'              	LDA	NCOLS
  0BD4'   CD 0C03'              	CALL	MULHA		; HL = the cells to pass over
  0BD7'   EB                    	XCHG
  0BD8'   21 0000               	LXI	H,0
  0BDB'   22 0D8C'              	SHLD	PSKN
  0BDE'                         PS_LP:
  0BDE'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BDF'   B3                    	ORA	E
  0BE0'   CA 0C37'              	JZ	PR_LP
  0BE3'   CD 0B75'              	CALL	RDCH
  0BE6'   FE 0D                 	CPI	CR
  0BE8'   CA 0BDE'              	JZ	PS_LP
  0BEB'   0E 01                 	MVI	C,1
  0BED'   FE 09                 	CPI	TAB
  0BEF'   CC 0C0D'              	CZ	TABN
  0BF2'                         PS_CL:
  0BF2'   7A                    	MOV	A,D
  0BF3'   B3                    	ORA	E
  0BF4'   CA 0C51'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0BF7'   1B                    	DCX	D
  0BF8'   21 0D8E'              	LXI	H,DCOL
  0BFB'   34                    	INR	M
  0BFC'   0D                    	DCR	C
  0BFD'   C2 0BF2'              	JNZ	PS_CL
  0C00'   C3 0BDE'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0C03'                         MULHA:
  0C03'   EB                    	XCHG
  0C04'   21 0000               	LXI	H,0
  0C07'                         MH_LP:
  0C07'   19                    	DAD	D
  0C08'   3D                    	DCR	A
  0C09'   C2 0C07'              	JNZ	MH_LP
  0C0C'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0C0D'                         TABN:
  0C0D'   3A 0D8E'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0C10'   E6 07                 	ANI	7
  0C12'   4F                    	MOV	C,A
  0C13'   3E 08                 	MVI	A,8
  0C15'   91                    	SUB	C
  0C16'   4F                    	MOV	C,A
  0C17'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0C18'                         PAINTR:
  0C18'   3A 0D8B'              	LDA	PROWN
  0C1B'   21 0D39'              	LXI	H,TXEND
  0C1E'   BE                    	CMP	M		; CY iff the row holds text
  0C1F'   DA 0C28'              	JC	PROW
  0C22'   3A 0D3A'              	LDA	FILCH
  0C25'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0C28'                         PROW:
  0C28'   AF                    	XRA	A
  0C29'   32 0D8E'              	STA	DCOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C2C'   32 0D8F'              	STA	XC
  0C2F'   2A 0D8C'              	LHLD	PSKN
  0C32'   7C                    	MOV	A,H
  0C33'   B5                    	ORA	L
  0C34'   C2 0BD1'              	JNZ	PSKIP
  0C37'                         PR_LP:
  0C37'   CD 0B75'              	CALL	RDCH
  0C3A'   D8                    	RC			; end of text -> line done
  0C3B'   FE 0A                 	CPI	LF
  0C3D'   C8                    	RZ			; consumed the LF -> next line start
  0C3E'   FE 0D                 	CPI	CR
  0C40'   CA 0C37'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0C43'   FE 09                 	CPI	TAB
  0C45'   CA 0C4E'              	JZ	PR_TAB
  0C48'   CD 0C5D'              	CALL	PCELL
  0C4B'   C3 0C37'              	JMP	PR_LP
  0C4E'                         PR_TAB:
  0C4E'   CD 0C0D'              	CALL	TABN		; C = space count (1..8)
  0C51'                         PRTBLP:
  0C51'   3E 20                 	MVI	A,' '
  0C53'   CD 0C5D'              	CALL	PCELL		; (keeps C)
  0C56'   0D                    	DCR	C
  0C57'   C2 0C51'              	JNZ	PRTBLP
  0C5A'   C3 0C37'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0C5D'                         PCELL:
  0C5D'   47                    	MOV	B,A
  0C5E'   21 0D8E'              	LXI	H,DCOL
  0C61'   34                    	INR	M
  0C62'   3A 0D31'              	LDA	NCOLS
  0C65'   21 0D8F'              	LXI	H,XC
  0C68'   BE                    	CMP	M
  0C69'   CC 0C71'              	CZ	PWRAP		; the row is full: this one starts the next
  0C6C'   34                    	INR	M
  0C6D'   78                    	MOV	A,B
  0C6E'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0C71'                         PWRAP:
  0C71'   36 00                 	MVI	M,0
  0C73'   3A 0D55'              	LDA	PEND
  0C76'   3D                    	DCR	A
  0C77'   21 0D8B'              	LXI	H,PROWN
  0C7A'   BE                    	CMP	M
  0C7B'   CA 0C90'              	JZ	PW_END
  0C7E'   34                    	INR	M
  0C7F'   3E 0D                 	MVI	A,CR
  0C81'   CD 0018'              	CALL	OUTCH
  0C84'   3E 0A                 	MVI	A,LF
  0C86'   CD 0018'              	CALL	OUTCH
  0C89'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0C8C'   21 0D8F'              	LXI	H,XC
  0C8F'   C9                    	RET
  0C90'                         PW_END:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C90'   E1                    	POP	H		; PCELL's return, and PROW's
  0C91'   E1                    	POP	H
  0C92'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0C93'                         MODEMS:
  0C93'   3A 0000*              	LDA	EDMODE
  0C96'   47                    	MOV	B,A
  0C97'   3A 0D60'              	LDA	OEDMOD
  0C9A'   B8                    	CMP	B
  0C9B'   C8                    	RZ			; the row already shows this mode
  0C9C'   78                    	MOV	A,B
  0C9D'   32 0D60'              	STA	OEDMOD
  0CA0'   21 0D10'              	LXI	H,SINSM
  0CA3'   FE 01                 	CPI	EM_INS
  0CA5'   CA 0CB3'              	JZ	MD_DRW
  0CA8'   21 0D1D'              	LXI	H,SREPM
  0CAB'   FE 02                 	CPI	EM_REP
  0CAD'   CA 0CB3'              	JZ	MD_DRW
  0CB0'   21 0D2B'              	LXI	H,SNULL		; command mode: the row goes blank
  0CB3'                         MD_DRW:
  0CB3'   E5                    	PUSH	H
  0CB4'   3A 0D30'              	LDA	NROWS
  0CB7'   CD 008C'              	CALL	GOROW1
  0CBA'   E1                    	POP	H
  0CBB'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0CBE'                         SCURS:
  0CBE'   3A 0D37'              	LDA	SROW
  0CC1'   47                    	MOV	B,A
  0CC2'   3A 0D38'              	LDA	SCOL
  0CC5'   4F                    	MOV	C,A
  0CC6'   CD 0064'              	CALL	GOTOXY
  0CC9'   21 0D05'              	LXI	H,SSHOW
  0CCC'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0CCF'                         SCDONE:
  0CCF'   CD 0086'              	CALL	CRGRS
  0CD2'   21 0D05'              	LXI	H,SSHOW
  0CD5'   CD 0025'              	CALL	OUTSTR
  0CD8'   3A 0D30'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0CDB'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ; STRINGS (0-terminated)
                                ;============================================================
  0CDE'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0CE2'   39 3B 39 39           
  0CE6'   39 48                 
  0CE8'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0CEC'   00                    
  0CED'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0CF1'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0CF4'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0CF8'   00                    
  0CF9'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0CFD'   00                    
  0CFE'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0D02'   35 6C 00              
  0D05'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0D09'   35 68 00              
  0D0C'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0D10'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0D14'   4E 53 45 52           
  0D18'   54 20 2D 2D           
  0D1C'   00                    
  0D1D'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0D21'   45 50 4C 41           
  0D25'   43 45 20 2D           
  0D29'   2D 00                 
