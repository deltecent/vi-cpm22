  087E'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  087F'                         FLINE:
  087F'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0882'   DA 08BF'              	JC	FL_EOF
  0885'   32 0E1C'              	STA	LYLAST
  0888'   FE 0A                 	CPI	LF
  088A'   CA 08BD'              	JZ	FL_LF
  088D'   FE 0D                 	CPI	CR
  088F'   CA 087F'              	JZ	FLINE		; CR contributes no display column
  0892'   FE 09                 	CPI	TAB
  0894'   CA 08A0'              	JZ	FL_TAB
  0897'   CD 08C2'              	CALL	FL_CEL
  089A'   C2 087F'              	JNZ	FLINE
  089D'                         FL_OVR:
  089D'   3E 01                 	MVI	A,1
  089F'   C9                    	RET
  08A0'                         FL_TAB:
  08A0'   3A 0E11'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  08A3'   83                    	ADD	E
  08A4'   E6 07                 	ANI	TABWID-1
  08A6'   2F                    	CMA
  08A7'   C6 09                 	ADI	TABWID+1
  08A9'   E5                    	PUSH	H
  08AA'   6F                    	MOV	L,A
