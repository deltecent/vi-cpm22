  0627'   E5                    	PUSH	H
  0628'   C5                    	PUSH	B
  0629'   EB                    	XCHG
  062A'   CD 04CC'              	CALL	XTRA
  062D'   03                    	INX	B		; BC = its rows
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  062E'   2A 0C91'              	LHLD	LYNEED
  0631'   7D                    	MOV	A,L
  0632'   91                    	SUB	C
  0633'   6F                    	MOV	L,A
  0634'   7C                    	MOV	A,H
  0635'   98                    	SBB	B
  0636'   67                    	MOV	H,A
  0637'   22 0C91'              	SHLD	LYNEED
  063A'   C1                    	POP	B
  063B'   21 0C90'              	LXI	H,LYROW
  063E'   35                    	DCR	M		; one line fewer above the cursor's
  063F'   E1                    	POP	H		; (keeps the flags)
  0640'   CA 0541'              	JZ	LY_TOP		; that was the last of them
  0643'   3A 0C92'              	LDA	LYNEED+1
  0646'   B7                    	ORA	A
  0647'   FA 0541'              	JM	LY_TOP		; room enough
  064A'   E5                    	PUSH	H
  064B'   2A 0C91'              	LHLD	LYNEED
  064E'   B5                    	ORA	L
  064F'   E1                    	POP	H
  0650'   C2 0624'              	JNZ	LY_DRP
  0653'   C3 0541'              	JMP	LY_TOP
  0656'                         LY_FW0:
                                	;--- forward: the rest of the cursor's line and the lines below, until
                                	;    the rows are full.  D = the row being filled, E = cells used in it. ---
  0656'   55                    	MOV	D,L
  0657'   CD 0000*              	CALL	RGET0
  065A'                         LY_FWD:
