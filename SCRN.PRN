  0A10'   7C                    	MOV	A,H
  0A11'   B7                    	ORA	A
  0A12'   F2 0A29'              	JP	LF_DN
  0A15'   3A 0E0C'              	LDA	NEDIT
  0A18'   B7                    	ORA	A
  0A19'   1F                    	RAR
  0A1A'   D6 02                 	SUI	2
  0A1C'   5F                    	MOV	E,A
  0A1D'   16 00                 	MVI	D,0
  0A1F'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0A20'   7C                    	MOV	A,H
  0A21'   B7                    	ORA	A
