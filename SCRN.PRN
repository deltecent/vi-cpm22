                                ;LQGD -- Z iff the table and the text are as the last frame left them, with
                                ; nothing about that frame out of the ordinary: no line placed by the command,
                                ; none taller than the screen or cut at the top, the pager's window where it
                                ; was.
  08DE'                         LQGD:
  08DE'   2A 1008'              	LHLD	SKIPR
