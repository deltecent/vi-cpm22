	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the cheap paints the
                                ; RINTENT asks for, the RPOLL repaint abort, and the message row.  A cheap
                                ; paint is counted in ROWS: the rows the screen gave up or gained at the top,
                                ; the rows the edit at the cursor had and has.  The terminal moves what stands
                                ; (IL/DL in a scroll region) and only the rows that are new are sent.
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	PGTOPM			; PAGE.MAC -- times the pager moved the text
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	DCHN			; CMD.MAC -- cells an R_DCH deletes
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0C8B'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0C99'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0C7A'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PRNG -- paint the edit rows from B up to (not including) C, counted from 0:
                                ; each cleared (ESC[K), the text on as many rows as its lines take, the fill
                                ; char on the rows past it.  The row table says which line row B is in and
                                ; how many of that line's rows are above it, and the reader is put there.
                                ; The one row a line may own with nothing on it -- the cursor's, past text
                                ; that filled the row above (LYXE) -- is cleared in its turn.  An empty range
                                ; sends nothing.  During a full repaint (FORCEF) a key that is waiting
                                ; abandons the frame, and the return from here is SCDRAW's own.
  0098'                         PRNG:
  0098'   78                    	MOV	A,B
  0099'   B9                    	CMP	C
  009A'   D0                    	RNC
  009B'   32 0D17'              	STA	PROWN
  009E'   79                    	MOV	A,C
  009F'   32 0CE2'              	STA	PEND
  00A2'   3A 0CC6'              	LDA	TXEND
  00A5'   3D                    	DCR	A
  00A6'   B8                    	CMP	B		; CY iff row B is past the text
  00A7'   DA 00DB'              	JC	PG_GO
  00AA'   C5                    	PUSH	B
  00AB'   CD 0AE7'              	CALL	RDTOP
  00AE'   CD 0495'              	CALL	HTTOP		; HL -> the top line's entry
  00B1'   C1                    	POP	B
  00B2'   11 0000               	LXI	D,0		; D = the rows above the line, E = the lines
  00B5'                         PG_F:
  00B5'   7A                    	MOV	A,D
  00B6'   86                    	ADD	M
  00B7'   B8                    	CMP	B
  00B8'   DA 00BE'              	JC	PG_N
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00BB'   C2 00C4'              	JNZ	PG_H		; row B is one of this line's
  00BE'                         PG_N:
  00BE'   57                    	MOV	D,A
  00BF'   1C                    	INR	E
  00C0'   23                    	INX	H
  00C1'   C3 00B5'              	JMP	PG_F
  00C4'                         PG_H:
  00C4'   78                    	MOV	A,B
  00C5'   92                    	SUB	D
  00C6'   4F                    	MOV	C,A
  00C7'   06 00                 	MVI	B,0		; BC = the rows of it above row B ...
  00C9'   7B                    	MOV	A,E
  00CA'   21 0000               	LXI	H,0
  00CD'   B7                    	ORA	A
  00CE'   C2 00D4'              	JNZ	PG_K
  00D1'   2A 0CC2'              	LHLD	SKIPR		; ... and, for the top line, those off the top
  00D4'                         PG_K:
  00D4'   09                    	DAD	B
  00D5'   22 0D18'              	SHLD	PSKN
  00D8'   CD 0B45'              	CALL	RDSKIP		; the reader at that line (A lines down)
  00DB'                         PG_GO:
  00DB'   3A 0D17'              	LDA	PROWN
  00DE'   3C                    	INR	A
  00DF'   47                    	MOV	B,A
  00E0'   0E 01                 	MVI	C,1
  00E2'   CD 0064'              	CALL	GOTOXY
  00E5'                         PG_LP:
  00E5'   3A 0CEB'              	LDA	FORCEF
  00E8'   B7                    	ORA	A
  00E9'   CA 00F5'              	JZ	PG_P
  00EC'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abandon the repaint
  00EF'   B7                    	ORA	A
  00F0'   CA 00F5'              	JZ	PG_P
  00F3'   E1                    	POP	H		; (the cursor stays hidden: no flash in a burst)
  00F4'   C9                    	RET
  00F5'                         PG_P:
  00F5'   CD 0092'              	CALL	CEKL
  00F8'   CD 0BA5'              	CALL	PAINTR
  00FB'   3A 0D06'              	LDA	LYXE
  00FE'   B7                    	ORA	A
  00FF'   CA 0114'              	JZ	PG_1
  0102'   3A 0CC4'              	LDA	SROW		; was that the row over the cursor's own?
  0105'   D6 02                 	SUI	2
  0107'   21 0D17'              	LXI	H,PROWN
  010A'   BE                    	CMP	M
  010B'   C2 0114'              	JNZ	PG_1
  010E'   CD 0124'              	CALL	PT_NL
  0111'   CD 0092'              	CALL	CEKL
  0114'                         PG_1:
  0114'   3A 0CE2'              	LDA	PEND
  0117'   3D                    	DCR	A
  0118'   21 0D17'              	LXI	H,PROWN
  011B'   BE                    	CMP	M
  011C'   C8                    	RZ
  011D'   D8                    	RC
  011E'   CD 0124'              	CALL	PT_NL
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0121'   C3 00E5'              	JMP	PG_LP
                                ;PT_NL -- CR, LF: down a row, and count it.
  0124'                         PT_NL:
  0124'   3E 0D                 	MVI	A,CR
  0126'   CD 0018'              	CALL	OUTCH
  0129'   3E 0A                 	MVI	A,LF
  012B'   CD 0018'              	CALL	OUTCH
  012E'   21 0D17'              	LXI	H,PROWN
  0131'   34                    	INR	M
  0132'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  0133'                         GOTOP:
  0133'   06 01                 	MVI	B,1
  0135'   0E 01                 	MVI	C,1
  0137'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  013A'                         SCINIT:
  013A'   21 0000               	LXI	H,0
  013D'   22 0CC0'              	SHLD	WINROW
  0140'   21 0C6B'              	LXI	H,SPROBE
  0143'   CD 0025'              	CALL	OUTSTR
  0146'   CD 0191'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  0149'   3A 0CBD'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  014C'   3D                    	DCR	A
  014D'   32 0CBF'              	STA	NEDIT
  0150'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  0151'                         RDB:
  0151'   21 0000               	LXI	H,0
  0154'                         RDB_LP:
  0154'   E5                    	PUSH	H
  0155'   CD 0000'              	CALL	BCONST
  0158'   E1                    	POP	H
  0159'   B7                    	ORA	A
  015A'   C2 0165'              	JNZ	RDB_GO
  015D'   2B                    	DCX	H
  015E'   7C                    	MOV	A,H
  015F'   B5                    	ORA	L
  0160'   C2 0154'              	JNZ	RDB_LP
  0163'   37                    	STC			; timeout
  0164'   C9                    	RET
  0165'                         RDB_GO:
  0165'   CD 0008'              	CALL	BCONIN
  0168'   B7                    	ORA	A		; CY=0, A=byte
  0169'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  016A'                         RDNUM:
  016A'   11 0000               	LXI	D,0
  016D'                         RN_LP:
  016D'   D5                    	PUSH	D
  016E'   CD 0151'              	CALL	RDB
  0171'   D1                    	POP	D
  0172'   D8                    	RC
  0173'   FE 30                 	CPI	'0'
  0175'   DA 018F'              	JC	RN_DN
  0178'   FE 3A                 	CPI	'9'+1
  017A'   D2 018F'              	JNC	RN_DN
  017D'   D6 30                 	SUI	'0'
  017F'   4F                    	MOV	C,A		; C = this digit
  0180'   62                    	MOV	H,D		; HL = value
  0181'   6B                    	MOV	L,E
  0182'   29                    	DAD	H		; 2x
  0183'   54                    	MOV	D,H
  0184'   5D                    	MOV	E,L		; DE = 2x
  0185'   29                    	DAD	H		; 4x
  0186'   29                    	DAD	H		; 8x
  0187'   19                    	DAD	D		; 10x
  0188'   06 00                 	MVI	B,0		; BC = digit
  018A'   09                    	DAD	B		; HL = 10x + digit
  018B'   EB                    	XCHG			; DE = new value
  018C'   C3 016D'              	JMP	RN_LP
  018F'                         RN_DN:
  018F'   B7                    	ORA	A		; CY=0, A = terminator
  0190'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0191'                         RDNUMS:
  0191'   CD 0151'              	CALL	RDB
  0194'   D8                    	RC
  0195'   FE 1B                 	CPI	ESC
  0197'   C0                    	RNZ			; not what a DSR reply looks like
  0198'   CD 0151'              	CALL	RDB
  019B'   D8                    	RC
  019C'   FE 5B                 	CPI	'['
  019E'   C0                    	RNZ			; not what a DSR reply looks like
  019F'   CD 016A'              	CALL	RDNUM		; DE = rows
  01A2'   D8                    	RC
  01A3'   FE 3B                 	CPI	';'
  01A5'   C0                    	RNZ			; not what a DSR reply looks like
  01A6'   EB                    	XCHG
  01A7'   22 0D1C'              	SHLD	TMPR
  01AA'   CD 016A'              	CALL	RDNUM		; DE = cols
  01AD'   D8                    	RC
  01AE'   FE 52                 	CPI	'R'
  01B0'   C0                    	RNZ			; not what a DSR reply looks like
  01B1'   EB                    	XCHG
  01B2'   22 0D1E'              	SHLD	TMPC
  01B5'   2A 0D1C'              	LHLD	TMPR		; rows -> clamp [24,200]
  01B8'   06 18                 	MVI	B,24
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BA'   0E C8                 	MVI	C,200
  01BC'   CD 01D0'              	CALL	CLAMP
  01BF'   32 0CBD'              	STA	NROWS
  01C2'   2A 0D1E'              	LHLD	TMPC		; cols -> clamp [80,132]
  01C5'   06 50                 	MVI	B,80
  01C7'   0E 84                 	MVI	C,132
  01C9'   CD 01D0'              	CALL	CLAMP
  01CC'   32 0CBE'              	STA	NCOLS
  01CF'                         RS_BAD:
  01CF'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  01D0'                         CLAMP:
  01D0'   7C                    	MOV	A,H
  01D1'   B7                    	ORA	A
  01D2'   C2 01E3'              	JNZ	CLP_MAX		; value > 255 -> max
  01D5'   7D                    	MOV	A,L
  01D6'   B8                    	CMP	B
  01D7'   DA 01E1'              	JC	CLP_MIN		; value < min
  01DA'   79                    	MOV	A,C
  01DB'   BD                    	CMP	L		; CY iff max < value
  01DC'   DA 01E3'              	JC	CLP_MAX
  01DF'   7D                    	MOV	A,L
  01E0'   C9                    	RET
  01E1'                         CLP_MIN:
  01E1'   78                    	MOV	A,B
  01E2'   C9                    	RET
  01E3'                         CLP_MAX:
  01E3'   79                    	MOV	A,C
  01E4'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- keep what is on the screen: the frame's facts (WINROW .. NXTR) are
                                ; copied to the OLD ones.  The main loop calls this after reading a key and
                                ; before dispatch, so SCDRAW can tell what the key changed.
  01E5'                         SCPRE:
  01E5'   21 0CC0'              	LXI	H,WINROW
  01E8'   11 0CCE'              	LXI	D,OLDWR
  01EB'   06 0E                 	MVI	B,FRMLEN
  01ED'                         SP_LP:
  01ED'   7E                    	MOV	A,M
  01EE'   12                    	STAX	D
  01EF'   23                    	INX	H
  01F0'   13                    	INX	D
  01F1'   05                    	DCR	B
  01F2'   C2 01ED'              	JNZ	SP_LP
  01F5'   C9                    	RET
                                
                                ;SCDRAW -- lay the screen out and paint it the cheapest way that is right.
                                ; A cheap paint is two changes, each "this many rows were here, that many
                                ; are": one at the top row (the screen gave rows up, OPN, or gained them,
                                ; OPM, as the text scrolled) and one at the cursor (EDR: EDA rows before, EDB
                                ; now, to be drawn from row EDP).  The terminal moves the rows that stand,
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; the rows that are new are sent, and so is whatever the move left wrong at
                                ; the bottom.  When nothing moves and nothing is new, only the cursor goes.
                                ; Whatever does not fit that is a full repaint.
  01F6'                         SCDRAW:
  01F6'   CD 0524'              	CALL	LAYOUT		; (no output)
  01F9'   CD 04DD'              	CALL	CURSC		; SROW/SCOL
  01FC'   3A 0CEB'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  01FF'   B7                    	ORA	A
  0200'   C2 0410'              	JNZ	SCFULL
  0203'   2A 0CD0'              	LHLD	OLDSK		; the top line starts on another of its rows:
  0206'   EB                    	XCHG			;   every row on the screen is a different one
  0207'   2A 0CC2'              	LHLD	SKIPR
  020A'   CD 0000*              	CALL	CMP16
  020D'   C2 0410'              	JNZ	SCFULL
  0210'   21 0000               	LXI	H,0
  0213'   22 0CDC'              	SHLD	OPN		; (and OPM)
  0216'   3A 0CC9'              	LDA	LYABV
  0219'   47                    	MOV	B,A		; B = the edit's first row: the cursor line's
  021A'   3A 0CD9'              	LDA	OLDCS		; C = the first row of it that can have changed:
  021D'   21 0CCB'              	LXI	H,CSRAW		;   the one the cursor was on, or the one it is
  0220'   BE                    	CMP	M
  0221'   DA 0225'              	JC	SD_1
  0224'   7E                    	MOV	A,M
  0225'                         SD_1:
  0225'   80                    	ADD	B
  0226'   4F                    	MOV	C,A
  0227'   2A 0CDA'              	LHLD	OLDCR		; E = the rows the line had (H: the line's under)
  022A'   5D                    	MOV	E,L
  022B'   3A 0CCC'              	LDA	LYTSH
  022E'   57                    	MOV	D,A		; D = the rows it has
  022F'   3A 0000*              	LDA	RINTENT
  0232'   B7                    	ORA	A
  0233'   CA 0410'              	JZ	SCFULL		; R_FULL
  0236'   FE 05                 	CPI	R_ILIN
  0238'   CA 026B'              	JZ	SD_IL
  023B'   E5                    	PUSH	H
  023C'   2A 0CF7'              	LHLD	LYDLT
  023F'   7C                    	MOV	A,H
  0240'   B5                    	ORA	L
  0241'   E1                    	POP	H
  0242'   3A 0000*              	LDA	RINTENT		; (keeps the flags)
  0245'   C2 02B6'              	JNZ	SD_OL		; the cursor is on another line
  0248'   FE 01                 	CPI	R_MOVE
  024A'   C2 024F'              	JNZ	SD_2
  024D'   0E FF                 	MVI	C,0FFH		; a move: none of the line to draw
  024F'                         SD_2:
  024F'   FE 03                 	CPI	R_DLIN
  0251'   C2 0256'              	JNZ	SD_3
  0254'   16 00                 	MVI	D,0		; the line went
  0256'                         SD_3:
  0256'   FE 06                 	CPI	R_JOIN
  0258'   C2 025E'              	JNZ	SD_AN
  025B'   7B                    	MOV	A,E		; the line under it went into it
  025C'   84                    	ADD	H
  025D'   5F                    	MOV	E,A
  025E'                         SD_AN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  025E'   3A 0CD7'              	LDA	OLDAB		; where the edit starts was that much lower: the
  0261'   90                    	SUB	B		;   rows the screen gave up at the top.  Higher,
  0262'   DA 0410'              	JC	SCFULL		;   and it is no paint of these
  0265'   32 0CDC'              	STA	OPN
  0268'   C3 02FD'              	JMP	SD_GO
                                
                                	;--- R_ILIN: ILN lines opened at the cursor ---
  026B'                         SD_IL:
  026B'   2A 0CF7'              	LHLD	LYDLT
  026E'   7C                    	MOV	A,H
  026F'   B7                    	ORA	A
  0270'   C2 0410'              	JNZ	SCFULL
  0273'   48                    	MOV	C,B		; drawn from the cursor's row, the first opened
  0274'   57                    	MOV	D,A		; (no rows yet)
  0275'   5F                    	MOV	E,A		; (none were there)
  0276'   B5                    	ORA	L
  0277'   CA 02A0'              	JZ	SI_2		; opened where the cursor's line was: 'O', 'P'
  027A'   3D                    	DCR	A
  027B'   C2 0410'              	JNZ	SCFULL
  027E'   3A 0CC0'              	LDA	WINROW		; opened under it: it is the line above now, and
  0281'   B7                    	ORA	A		;   has to be on the screen
  0282'   CA 0410'              	JZ	SCFULL
  0285'   3A 0000*              	LDA	HTCUR
  0288'   3D                    	DCR	A
  0289'   CD 0883'              	CALL	HTE
  028C'   56                    	MOV	D,M		; D = that line's rows now
  028D'   78                    	MOV	A,B
  028E'   92                    	SUB	D
  028F'   47                    	MOV	B,A		; the edit starts with it
  0290'   3A 0CDA'              	LDA	OLDCR
  0293'   5F                    	MOV	E,A
  0294'   3A 0000*              	LDA	ILABOV		; text came off it: drawn from the row the
  0297'   B7                    	ORA	A		;   cursor was on
  0298'   CA 02A0'              	JZ	SI_2
  029B'   3A 0CD9'              	LDA	OLDCS
  029E'   80                    	ADD	B
  029F'   4F                    	MOV	C,A
  02A0'                         SI_2:
  02A0'   C5                    	PUSH	B
  02A1'   D5                    	PUSH	D
  02A2'   3A 0000*              	LDA	ILN
  02A5'   47                    	MOV	B,A
  02A6'   3A 0000*              	LDA	HTCUR
  02A9'   CD 04A3'              	CALL	SUMX		; A = the rows the opened lines take
  02AC'   D1                    	POP	D
  02AD'   C1                    	POP	B
  02AE'   DA 0410'              	JC	SCFULL		; (more than the screen shows)
  02B1'   82                    	ADD	D
  02B2'   57                    	MOV	D,A
  02B3'   C3 025E'              	JMP	SD_AN
                                
                                	;--- a move to another line: the text scrolled SCRLN lines ---
  02B6'                         SD_OL:
  02B6'   FE 01                 	CPI	R_MOVE
  02B8'   C2 0410'              	JNZ	SCFULL
  02BB'   2A 0CE4'              	LHLD	SCRLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02BE'   7C                    	MOV	A,H
  02BF'   B5                    	ORA	L
  02C0'   CA 0C4B'              	JZ	SCURS		; it stood still: the cursor alone
  02C3'   7C                    	MOV	A,H
  02C4'   B7                    	ORA	A
  02C5'   CA 02DC'              	JZ	SO_UP
  02C8'   3C                    	INR	A
  02C9'   C2 0410'              	JNZ	SCFULL
  02CC'   95                    	SUB	L		; down: the new lines at the top, and their rows
  02CD'   CA 0410'              	JZ	SCFULL
  02D0'   CD 049F'              	CALL	SUMT
  02D3'   DA 0410'              	JC	SCFULL
  02D6'   32 0CDD'              	STA	OPM
  02D9'   C3 02F8'              	JMP	SO_GO
  02DC'                         SO_UP:
  02DC'   3A 0CD6'              	LDA	OLDBOT		; up: the last line that showed is that many
  02DF'   95                    	SUB	L		;   lines higher.  The row after it was OLDTX,
  02E0'   DA 0410'              	JC	SCFULL		;   and is the rows down to it now
  02E3'   3C                    	INR	A
  02E4'   CD 049F'              	CALL	SUMT
  02E7'   DA 0410'              	JC	SCFULL
  02EA'   47                    	MOV	B,A
  02EB'   3A 0CD4'              	LDA	OLDTX
  02EE'   90                    	SUB	B
  02EF'   DA 0410'              	JC	SCFULL
  02F2'   CA 0410'              	JZ	SCFULL
  02F5'   32 0CDC'              	STA	OPN
  02F8'                         SO_GO:
  02F8'   11 0000               	LXI	D,0		; no edit
  02FB'   0E FF                 	MVI	C,0FFH
                                
                                	;--- B = the edit's first row, C = the first to draw, D = its rows
                                	;    now, E = its rows before ---
  02FD'                         SD_GO:
  02FD'   78                    	MOV	A,B
  02FE'   32 0CE0'              	STA	EDR
  0301'   82                    	ADD	D
  0302'   47                    	MOV	B,A		; B = the row after its last
  0303'   3A 0CBF'              	LDA	NEDIT
  0306'   B8                    	CMP	B
  0307'   DA 0410'              	JC	SCFULL		; (it runs off the screen)
  030A'   79                    	MOV	A,C
  030B'   32 0CE1'              	STA	EDP
  030E'   EB                    	XCHG
  030F'   22 0CDE'              	SHLD	EDA		; (and EDB)
  0312'   EB                    	XCHG
  0313'   2A 0CDC'              	LHLD	OPN
  0316'   7C                    	MOV	A,H
  0317'   B5                    	ORA	L
  0318'   C2 0337'              	JNZ	SD_PT
  031B'   7A                    	MOV	A,D
  031C'   BB                    	CMP	E
  031D'   C2 0337'              	JNZ	SD_PT
  0320'   79                    	MOV	A,C		; nothing moves.  Nothing to draw either: the
  0321'   B8                    	CMP	B		;   cursor alone
  0322'   D2 0C4B'              	JNC	SCURS
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  0325'   3C                    	INR	A
  0326'   B8                    	CMP	B
  0327'   C2 0337'              	JNZ	SD_PT
  032A'   3A 0000*              	LDA	RINTENT		; the line's last row, the cursor on it before
  032D'   FE 04                 	CPI	R_ICH		;   and after: a cell opened or closed there is
  032F'   CA 03DC'              	JZ	SC_ICH		;   the whole of it
  0332'   FE 07                 	CPI	R_DCH
  0334'   CA 03F1'              	JZ	SC_DCH
  0337'                         SD_PT:
  0337'   2A 0CC2'              	LHLD	SKIPR		; ('<<<' on the top row is not theirs to keep)
  033A'   7C                    	MOV	A,H
  033B'   B5                    	ORA	L
  033C'   C2 0410'              	JNZ	SCFULL
  033F'   CD 0080'              	CALL	CHIDE
  0342'   2A 0CDC'              	LHLD	OPN
  0345'   EB                    	XCHG
  0346'   2A 0CDE'              	LHLD	EDA
  0349'   7A                    	MOV	A,D
  034A'   B3                    	ORA	E
  034B'   C2 0353'              	JNZ	SD_SH
  034E'   7C                    	MOV	A,H
  034F'   BD                    	CMP	L
  0350'   CA 036B'              	JZ	SD_NS
  0353'                         SD_SH:
  0353'   CD 04CC'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0356'   2A 0CDC'              	LHLD	OPN
  0359'   06 00                 	MVI	B,0
  035B'   CD 046A'              	CALL	SHFT
  035E'   2A 0CDE'              	LHLD	EDA
  0361'   3A 0CE0'              	LDA	EDR
  0364'   47                    	MOV	B,A
  0365'   CD 046A'              	CALL	SHFT
  0368'   CD 0086'              	CALL	CRGRS
  036B'                         SD_NS:
  036B'   06 00                 	MVI	B,0
  036D'   3A 0CDD'              	LDA	OPM
  0370'   4F                    	MOV	C,A
  0371'   CD 0098'              	CALL	PRNG		; the rows opened at the top
  0374'   2A 0CDE'              	LHLD	EDA
  0377'   3A 0CE0'              	LDA	EDR
  037A'   84                    	ADD	H
  037B'   4F                    	MOV	C,A
  037C'   3A 0CE1'              	LDA	EDP
  037F'   47                    	MOV	B,A
  0380'   CD 0098'              	CALL	PRNG		; the edit's own
                                	;--- the bottom.  The rows that were good to the end of the screen
                                	;    (all of them, or as far as the '@' rows) moved with the text; what
                                	;    lies between where they end now and where good rows should end is
                                	;    drawn, and so are the rows a move up left bare ---
  0383'   2A 0CD4'              	LHLD	OLDTX
  0386'   CD 04C3'              	CALL	TEV
  0389'   47                    	MOV	B,A
  038A'   2A 0CC6'              	LHLD	TXEND
  038D'   CD 04C3'              	CALL	TEV
  0390'   4F                    	MOV	C,A
  0391'   2A 0CDC'              	LHLD	OPN
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0394'   EB                    	XCHG			; E = OPN, D = OPM
  0395'   2A 0CDE'              	LHLD	EDA		; L = EDA, H = EDB
  0398'   7A                    	MOV	A,D
  0399'   84                    	ADD	H
  039A'   57                    	MOV	D,A		; D = the rows that came
  039B'   7B                    	MOV	A,E
  039C'   85                    	ADD	L
  039D'   92                    	SUB	D		; A = the rows that went, less those
  039E'   21 0CBF'              	LXI	H,NEDIT
  03A1'   5E                    	MOV	E,M
  03A2'   DA 03B2'              	JC	SB_DN
  03A5'   57                    	MOV	D,A		; the text under them moved up D rows
  03A6'   7B                    	MOV	A,E
  03A7'   92                    	SUB	D
  03A8'   5F                    	MOV	E,A		; E = the first row that left bare
  03A9'   78                    	MOV	A,B
  03AA'   92                    	SUB	D
  03AB'   D2 03BD'              	JNC	SB_1
  03AE'   AF                    	XRA	A
  03AF'   C3 03BD'              	JMP	SB_1
  03B2'                         SB_DN:
  03B2'   2F                    	CMA
  03B3'   3C                    	INR	A		; ... or down that many
  03B4'   80                    	ADD	B
  03B5'   DA 03BC'              	JC	SB_0
  03B8'   BB                    	CMP	E
  03B9'   DA 03BD'              	JC	SB_1
  03BC'                         SB_0:
  03BC'   7B                    	MOV	A,E
  03BD'                         SB_1:
  03BD'   B9                    	CMP	C		; A = where the old good rows end now
  03BE'   47                    	MOV	B,A
  03BF'   DA 03C4'              	JC	SB_2
  03C2'   41                    	MOV	B,C
  03C3'   4F                    	MOV	C,A
  03C4'                         SB_2:
  03C4'   C5                    	PUSH	B
  03C5'   D5                    	PUSH	D
  03C6'   CD 0098'              	CALL	PRNG
  03C9'   D1                    	POP	D
  03CA'   C1                    	POP	B
  03CB'   79                    	MOV	A,C
  03CC'   BB                    	CMP	E
  03CD'   D2 03D1'              	JNC	SB_3
  03D0'   7B                    	MOV	A,E
  03D1'                         SB_3:
  03D1'   47                    	MOV	B,A
  03D2'   3A 0CBF'              	LDA	NEDIT
  03D5'   4F                    	MOV	C,A
  03D6'   CD 0098'              	CALL	PRNG
  03D9'   C3 0C4B'              	JMP	SCURS
                                
                                ;SC_ICH -- R_ICH: a char was typed at the cell the cursor was on, which is
                                ; where the terminal's cursor still is.  ICH (ESC[1@) opens a cell there and
                                ; the char fills it; appended at the row's end (ICHAPP) the cell is blank and
                                ; nothing follows it, so the char alone is the whole frame.  Either way the
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ; terminal leaves the cursor at SCOL, where insert mode wants it.
  03DC'                         SC_ICH:
  03DC'   3A 0000*              	LDA	ICHAPP
  03DF'   B7                    	ORA	A
  03E0'   C2 03E9'              	JNZ	SC_ICC
  03E3'   21 0C81'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  03E6'   CD 0025'              	CALL	OUTSTR
  03E9'                         SC_ICC:
  03E9'   2A 0000*              	LHLD	GAPBEG		; the byte typed is right before the gap
  03EC'   2B                    	DCX	H
  03ED'   7E                    	MOV	A,M
  03EE'   C3 0018'              	JMP	OUTCH
                                
                                ;SC_DCH -- R_DCH: DCHN cells went at the cell the cursor was on, which is
                                ; where the terminal's cursor still is: delete-character (ESC[<n>P) there
                                ; draws the rest of the row up, and the cursor is moved only if the delete
                                ; took the line's last char from under it.
  03F1'                         SC_DCH:
  03F1'   21 0C7E'              	LXI	H,SCSI
  03F4'   CD 0025'              	CALL	OUTSTR
  03F7'   3A 0000*              	LDA	DCHN
  03FA'   CD 002F'              	CALL	EMITB
  03FD'   3E 50                 	MVI	A,'P'
  03FF'   CD 0018'              	CALL	OUTCH
  0402'   2A 0CD2'              	LHLD	OLDSC
  0405'   EB                    	XCHG
  0406'   2A 0CC4'              	LHLD	SROW
  0409'   CD 0000*              	CALL	CMP16
  040C'   C8                    	RZ
  040D'   C3 0C4B'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place, each cleared with ESC[K; a line
                                ; takes as many rows as it is wide, and the rows past the text show '~' (or
                                ; '@').  No ESC[2J (no blank flash).  Message row last; cursor hidden
                                ; throughout, then addressed and shown.
                                ; FORCEF is set until the frame is whole.  A key that arrives part-way cuts it
                                ; short (PRNG): the pending key is dispatched, and the next SCDRAW repaints in
                                ; FULL even if that key is a pure motion (RENDER.md: an aborted frame stays
                                ; dirty -- no cheap paint over a half-painted screen).
  0410'                         SCFULL:
  0410'   CD 0080'              	CALL	CHIDE
  0413'   3E 01                 	MVI	A,1
  0415'   32 0CEB'              	STA	FORCEF
  0418'   06 00                 	MVI	B,0
  041A'   3A 0CBF'              	LDA	NEDIT
  041D'   4F                    	MOV	C,A
  041E'   CD 0098'              	CALL	PRNG
  0421'   CD 0124'              	CALL	PT_NL
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  0424'   CD 0092'              	CALL	CEKL
  0427'   2A 0CC2'              	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
  042A'   7C                    	MOV	A,H		;   over its first cells says so, as vim's does
  042B'   B5                    	ORA	L
  042C'   CA 0438'              	JZ	ROWS_M
  042F'   CD 0133'              	CALL	GOTOP
  0432'   21 0CB9'              	LXI	H,SSKIP
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0435'   CD 0025'              	CALL	OUTSTR
  0438'                         ROWS_M:
  0438'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  043A'   32 0CEC'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  043D'   CD 0C4B'              	CALL	SCURS
  0440'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  0441'   32 0CEB'              	STA	FORCEF
  0444'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  0445'                         EXPRM:
  0445'   F5                    	PUSH	PSW
  0446'   3A 0000*              	LDA	EDMODE
  0449'   32 0CEC'              	STA	OEDMOD
  044C'   3A 0CBD'              	LDA	NROWS
  044F'   CD 008C'              	CALL	GOROW1
  0452'   F1                    	POP	PSW
  0453'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  0456'                         EXRUB:
  0456'   21 045C'              	LXI	H,SRUB
  0459'   C3 0025'              	JMP	OUTSTR
  045C'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  0460'                         EXMSG:
  0460'   7E                    	MOV	A,M
  0461'   23                    	INX	H
  0462'   E5                    	PUSH	H
  0463'   CD 0445'              	CALL	EXPRM
  0466'   E1                    	POP	H
  0467'   C3 0025'              	JMP	OUTSTR
                                
                                ;SHFT -- B = a row (from 0), L = the rows that were there, H = the rows that
                                ; are: open rows under those that were (IL), or delete under those that stay
                                ; (DL), so that everything below is where it belongs.  In a scroll region.
  046A'                         SHFT:
  046A'   7C                    	MOV	A,H
  046B'   95                    	SUB	L
  046C'   C8                    	RZ
  046D'   1E 4C                 	MVI	E,'L'
  046F'   57                    	MOV	D,A
  0470'   7D                    	MOV	A,L
  0471'   D2 047A'              	JNC	SH_1
  0474'   7D                    	MOV	A,L
  0475'   94                    	SUB	H
  0476'   57                    	MOV	D,A
  0477'   1E 4D                 	MVI	E,'M'
  0479'   7C                    	MOV	A,H
  047A'                         SH_1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  047A'   80                    	ADD	B
  047B'   21 0CBF'              	LXI	H,NEDIT
  047E'   BE                    	CMP	M
  047F'   D0                    	RNC			; (under the last edit row: nothing there to move)
  0480'   3C                    	INR	A
  0481'   47                    	MOV	B,A
  0482'   0E 01                 	MVI	C,1
  0484'   CD 0064'              	CALL	GOTOXY
  0487'   21 0C7E'              	LXI	H,SCSI
  048A'   CD 0025'              	CALL	OUTSTR
  048D'   7A                    	MOV	A,D
  048E'   CD 002F'              	CALL	EMITB
  0491'   7B                    	MOV	A,E
  0492'   C3 0018'              	JMP	OUTCH
                                
                                ;HTTOP -- HL -> the row table's entry for the top line, A = which it is.
  0495'                         HTTOP:
  0495'   3A 0000*              	LDA	HTCUR
  0498'   21 0CC0'              	LXI	H,WINROW
  049B'   96                    	SUB	M
  049C'   C3 0883'              	JMP	HTE
                                
                                ;SUMT -- A = a count of lines from the top one: A = the rows they take.
                                ;SUMX -- the same for the B lines from the table's entry A.
                                ; CY if the table has not so many, or they are a screenful and more.
  049F'                         SUMT:
  049F'   47                    	MOV	B,A
  04A0'   CD 0495'              	CALL	HTTOP
  04A3'                         SUMX:
  04A3'   4F                    	MOV	C,A
  04A4'   80                    	ADD	B
  04A5'   5F                    	MOV	E,A
  04A6'   3A 0000*              	LDA	HTN
  04A9'   BB                    	CMP	E
  04AA'   D8                    	RC
  04AB'   79                    	MOV	A,C
  04AC'   CD 0883'              	CALL	HTE
  04AF'   AF                    	XRA	A
  04B0'   04                    	INR	B
  04B1'                         SM_LP:
  04B1'   05                    	DCR	B
  04B2'   CA 04BB'              	JZ	SM_DN
  04B5'   86                    	ADD	M
  04B6'   D8                    	RC
  04B7'   23                    	INX	H
  04B8'   C3 04B1'              	JMP	SM_LP
  04BB'                         SM_DN:
  04BB'   47                    	MOV	B,A
  04BC'   3A 0CBF'              	LDA	NEDIT
  04BF'   3D                    	DCR	A
  04C0'   B8                    	CMP	B
  04C1'   78                    	MOV	A,B
  04C2'   C9                    	RET
                                
                                ;TEV -- HL = a frame's TXEND and FILCH: A = the row its good rows end at.
                                ; Rows of '~' are as good as text (they stay '~' wherever they move); rows of
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                ; '@' are not.
  04C3'                         TEV:
  04C3'   7C                    	MOV	A,H
  04C4'   FE 40                 	CPI	'@'
  04C6'   7D                    	MOV	A,L
  04C7'   C8                    	RZ
  04C8'   3A 0CBF'              	LDA	NEDIT
  04CB'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  04CC'                         SRGN:
  04CC'   21 0C86'              	LXI	H,SRGP
  04CF'   CD 0025'              	CALL	OUTSTR
  04D2'   3A 0CBF'              	LDA	NEDIT
  04D5'   CD 002F'              	CALL	EMITB
  04D8'   3E 72                 	MVI	A,'r'
  04DA'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  04DD'                         CURSC:
  04DD'   2A 0CF5'              	LHLD	CURDCL
  04E0'   CD 050F'              	CALL	DIVN		; BC = rows into the line, A = the column
  04E3'   3C                    	INR	A
  04E4'   32 0CC5'              	STA	SCOL
  04E7'   79                    	MOV	A,C
  04E8'   32 0CF0'              	STA	CSUB
  04EB'   2A 0CC2'              	LHLD	SKIPR
  04EE'   EB                    	XCHG
  04EF'   2A 0CC9'              	LHLD	LYABV
  04F2'   09                    	DAD	B
  04F3'   23                    	INX	H
  04F4'   CD 0000*              	CALL	SUBHD		; (less the rows of it that are off the top)
  04F7'   7C                    	MOV	A,H		; (never past the edit rows)
  04F8'   B7                    	ORA	A
  04F9'   3A 0CBF'              	LDA	NEDIT
  04FC'   C2 0504'              	JNZ	CS_SET
  04FF'   BD                    	CMP	L		; CY iff NEDIT < the row
  0500'   DA 0504'              	JC	CS_SET
  0503'   7D                    	MOV	A,L
  0504'                         CS_SET:
  0504'   32 0CC4'              	STA	SROW
  0507'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  0508'                         XTRA:
  0508'   01 0000               	LXI	B,0
  050B'   7C                    	MOV	A,H
  050C'   B5                    	ORA	L
  050D'   C8                    	RZ			; an empty line is one row
  050E'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  050F'                         DIVN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  050F'   3A 0CBE'              	LDA	NCOLS
  0512'   2F                    	CMA
  0513'   5F                    	MOV	E,A
  0514'   16 FF                 	MVI	D,0FFH
  0516'   13                    	INX	D		; DE = -NCOLS
  0517'   01 FFFF               	LXI	B,0FFFFH
  051A'                         DV_LP:
  051A'   03                    	INX	B
  051B'   19                    	DAD	D		; CY while NCOLS still went into it
  051C'   DA 051A'              	JC	DV_LP
  051F'   3A 0CBE'              	LDA	NCOLS
  0522'   85                    	ADD	L
  0523'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- where the cursor's line sits on the screen and what the screen
                                ; holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
                                ;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
                                ;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
                                ;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
                                ;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
                                ;        what they show), SCBOT, SCEOF, SCBOF, NXTR, TALLF; the row table
                                ;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
                                ;        LNDLT and PLACE cleared.
                                ; The lines are measured once, into the row table (HTBLD): as many above the
                                ; cursor's as the placement could want, and a screenful of rows from it on.
                                ; Everything after that is arithmetic on the table: which line is the top one
                                ; (as many of the lines wanted above as leave the cursor's whole line room),
                                ; and how far down the text goes.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  0524'                         LAYOUT:
  0524'   2A 0000*              	LHLD	CMDCNT
  0527'   22 0D08'              	SHLD	SVCNT
  052A'   2A 0000*              	LHLD	AUXCNT
  052D'   22 0D0A'              	SHLD	SVAUX
  0530'   3A 0000*              	LDA	DIRFLG
  0533'   32 0D0C'              	STA	SVDIR
  0536'   CD 0696'              	CALL	LYQK		; a move about a screen that stands: no more to do
  0539'   DA 0680'              	JC	LY_TC
  053C'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  053F'   32 0CF9'              	STA	LYROW
  0542'   32 0D04'              	STA	LYSVR
  0545'   AF                    	XRA	A
  0546'   32 0D02'              	STA	LYND
  0549'   32 0D03'              	STA	LYPRF
  054C'   3A 0CEF'              	LDA	PLACE		; a line the command placed stays where it was
  054F'   B7                    	ORA	A		;   put; one that only moved is asked about
  0550'   CC 08E7'              	CZ	LYFAR
  0553'   2A 0000*              	LHLD	LNDLT
  0556'   22 0CF7'              	SHLD	LYDLT
  0559'   7C                    	MOV	A,H
  055A'   B5                    	ORA	L
  055B'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  055E'   22 0000*              	SHLD	LNDLT
  0561'   47                    	MOV	B,A
  0562'   3A 0CEF'              	LDA	PLACE		; the cursor on another line, or its line put
  0565'   B0                    	ORA	B		;   somewhere by the command: a line starts with
  0566'   CA 056C'              	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
  0569'   22 0CC2'              	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
  056C'                         LY_SAM:
                                	;--- the lines to measure above the cursor's: those it has over it now,
                                	;    or all a screen could show when it is to be placed afresh (but no
                                	;    more than leaves the table room for the rows under it) ---
  056C'   3A 0CBF'              	LDA	NEDIT
  056F'   4F                    	MOV	C,A		; C = a screenful of rows from the cursor's line on
  0570'   3D                    	DCR	A
  0571'   47                    	MOV	B,A
  0572'   3E FE                 	MVI	A,254
  0574'   91                    	SUB	C
  0575'   B8                    	CMP	B
  0576'   D2 057A'              	JNC	LY_B1
  0579'   47                    	MOV	B,A
  057A'                         LY_B1:
  057A'   CD 075A'              	CALL	LYMQ
  057D'   CA 0584'              	JZ	LY_BLD
  0580'   3A 0CF9'              	LDA	LYROW
  0583'   47                    	MOV	B,A
  0584'                         LY_BLD:
  0584'   CD 0924'              	CALL	HTBLD
                                	;--- a line taller than the screen whose end is on it: the lines under
                                	;    that end, as far as the rows go ---
  0587'   3A 0CE3'              	LDA	TALLF
  058A'   B7                    	ORA	A
  058B'   CA 05A0'              	JZ	LY_NT
  058E'   3A 0000*              	LDA	HTEOF
  0591'   B7                    	ORA	A
  0592'   C2 05A0'              	JNZ	LY_NT
  0595'   3A 0CCC'              	LDA	LYTSH
  0598'   47                    	MOV	B,A
  0599'   3A 0CBF'              	LDA	NEDIT
  059C'   90                    	SUB	B
  059D'   CD 0A90'              	CALL	HBMOR
  05A0'                         LY_NT:
  05A0'   CD 075A'              	CALL	LYMQ
  05A3'   CC 07D4'              	CZ	LYMID		; LYROW = the lines that puts above it
  05A6'   AF                    	XRA	A
  05A7'   32 0CEF'              	STA	PLACE
                                	;--- of the LYROW lines wanted above, as many as leave the cursor's
                                	;    whole line room (and the table has: the file may start sooner) ---
  05AA'   3A 0CF9'              	LDA	LYROW
  05AD'   47                    	MOV	B,A
  05AE'   CD 0820'              	CALL	LYINI
  05B1'                         LY_FT:
  05B1'   78                    	MOV	A,B
  05B2'   B7                    	ORA	A
  05B3'   CA 05BF'              	JZ	LY_FD
  05B6'   05                    	DCR	B
  05B7'   C5                    	PUSH	B
  05B8'   CD 0867'              	CALL	LMABV
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  05BB'   C1                    	POP	B
  05BC'   D2 05B1'              	JNC	LY_FT
  05BF'                         LY_FD:
  05BF'   3A 0D00'              	LDA	LYMAB
  05C2'   6F                    	MOV	L,A
  05C3'   26 00                 	MVI	H,0
  05C5'   22 0CC9'              	SHLD	LYABV
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  05C8'   3A 0CF9'              	LDA	LYROW
  05CB'   6F                    	MOV	L,A		; (H is 0 still)
  05CC'   CD 0000*              	CALL	LINPSB		; HL = that line's start
  05CF'   EB                    	XCHG
  05D0'   2A 0000*              	LHLD	GAPBEG
  05D3'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  05D6'   22 0CF1'              	SHLD	TOPLEN
  05D9'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  05DA'   22 0000*              	SHLD	WRLIM
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  05DD'   AF                    	XRA	A
  05DE'   32 0CEE'              	STA	SCBOF
  05E1'   CD 08B9'              	CALL	LYTOPP		; HL = top
  05E4'   CD 07C6'              	CALL	ISBOF
  05E7'   C2 05EE'              	JNZ	LY_BW
  05EA'   3C                    	INR	A
  05EB'   32 0CEE'              	STA	SCBOF
  05EE'                         LY_BW:
                                	;--- down the table from the cursor's line: the lines under it that fit
                                	;    whole.  C = the rows taken, D = those lines. ---
  05EE'   3E 7E                 	MVI	A,'~'
  05F0'   32 0CC7'              	STA	FILCH
  05F3'   AF                    	XRA	A
  05F4'   32 0CED'              	STA	SCEOF
  05F7'   57                    	MOV	D,A
  05F8'   3A 0000*              	LDA	HTCUR
  05FB'   47                    	MOV	B,A
  05FC'   CD 0883'              	CALL	HTE		; HL -> the cursor line's entry
  05FF'   3A 0000*              	LDA	HTN
  0602'   90                    	SUB	B
  0603'   47                    	MOV	B,A		; B = the entries from it on
  0604'   3A 0D00'              	LDA	LYMAB
  0607'   4F                    	MOV	C,A
  0608'   3A 0CCC'              	LDA	LYTSH
  060B'   81                    	ADD	C
  060C'   4F                    	MOV	C,A
  060D'                         LY_WK:
  060D'   23                    	INX	H
  060E'   05                    	DCR	B
  060F'   CA 062C'              	JZ	LY_WE
  0612'   3A 0CBF'              	LDA	NEDIT
  0615'   91                    	SUB	C		; A = the rows left
  0616'   CA 0632'              	JZ	LY_END		; none: what is under them is not cut off
  0619'   BE                    	CMP	M		; CY iff the line takes more
  061A'   DA 0624'              	JC	LY_CUT
  061D'   79                    	MOV	A,C
  061E'   86                    	ADD	M
  061F'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0620'   14                    	INR	D
  0621'   C3 060D'              	JMP	LY_WK
  0624'                         LY_CUT:
  0624'   3E 40                 	MVI	A,'@'		; a line that does not fit is not shown, and the
  0626'   32 0CC7'              	STA	FILCH		;   rows it would have started on say so
  0629'   C3 0632'              	JMP	LY_END
  062C'                         LY_WE:
  062C'   3A 0000*              	LDA	HTEOF		; the table ended: with the text, or with the rows
  062F'   32 0CED'              	STA	SCEOF
  0632'                         LY_END:
  0632'   79                    	MOV	A,C
  0633'   32 0CC6'              	STA	TXEND		; the first row with no text on it
  0636'   AF                    	XRA	A		; NXTR = the rows of the line under the cursor's,
  0637'   B2                    	ORA	D		;   if it shows
  0638'   CA 0645'              	JZ	LY_NX
  063B'   D5                    	PUSH	D
  063C'   3A 0000*              	LDA	HTCUR
  063F'   3C                    	INR	A
  0640'   CD 0883'              	CALL	HTE
  0643'   D1                    	POP	D
  0644'   7E                    	MOV	A,M
  0645'                         LY_NX:
  0645'   32 0CCD'              	STA	NXTR
  0648'   3A 0CF9'              	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
  064B'   82                    	ADD	D
  064C'   32 0CC8'              	STA	SCBOT
  064F'   3A 0CF9'              	LDA	LYROW		; WINROW = row
  0652'   6F                    	MOV	L,A
  0653'   26 00                 	MVI	H,0
  0655'   22 0CC0'              	SHLD	WINROW
  0658'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  0659'   2A 0CF7'              	LHLD	LYDLT
  065C'   CD 0000*              	CALL	SUBHD
  065F'   EB                    	XCHG
  0660'   2A 0CCE'              	LHLD	OLDWR
  0663'   19                    	DAD	D
  0664'   22 0CE4'              	SHLD	SCRLN
  0667'   3E 01                 	MVI	A,1		; the table is the screen's own, and LYQK may go
  0669'   32 0CE6'              	STA	LYOK		;   by it while the text stays where it is
  066C'   CD 08B9'              	CALL	LYTOPP
  066F'   EB                    	XCHG
  0670'   2A 0000*              	LHLD	TXTBEG
  0673'   EB                    	XCHG
  0674'   CD 0000*              	CALL	SUBHD		; (kept from TXTBEG: the text is moved about)
  0677'   22 0CE7'              	SHLD	LYTOP
  067A'   2A 0000*              	LHLD	PGTOPM
  067D'   22 0CE9'              	SHLD	LYPG
  0680'                         LY_TC:
  0680'   CD 0AC7'              	CALL	TABCUR
  0683'   2A 0D08'              	LHLD	SVCNT
  0686'   22 0000*              	SHLD	CMDCNT
  0689'   2A 0D0A'              	LHLD	SVAUX
  068C'   22 0000*              	SHLD	AUXCNT
  068F'   3A 0D0C'              	LDA	SVDIR
  0692'   32 0000*              	STA	DIRFLG
  0695'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;LYQK -- the layout of a key that only moved the cursor, in command mode, to
                                ; a line the screen shows whole already: the text on every row is what it
                                ; was, so the row table is too, and none of it is read again.  What moves
                                ; with the cursor is found from the cursor: the lines above it (WINROW), the
                                ; table's entry for its line (HTCUR), the rows over it (LYABV), where the top
                                ; line is from here (TOPLEN, WRLIM), and its column, for which its own line is
                                ; measured as far as the cursor and no farther.
                                ;   out: CY when that was the layout; NC, and nothing changed, when the screen
                                ;        has to be measured: the table is not the screen's (LYOK), the pager
                                ;        moved the text (PGTOPM), the key did more than move (RINTENT), the command placed the line (PLACE), the
                                ;        cursor's line is off the screen or cut, or the top line is taller
                                ;        than the screen.
  0696'                         LYQK:
  0696'   3A 0CE6'              	LDA	LYOK
  0699'   B7                    	ORA	A
  069A'   C8                    	RZ
  069B'   3A 0000*              	LDA	RINTENT
  069E'   FE 01                 	CPI	R_MOVE
  06A0'   C2 0758'              	JNZ	LQK_N
  06A3'   3A 0000*              	LDA	EDMODE
  06A6'   FE 00                 	CPI	EM_CMD
  06A8'   C2 0758'              	JNZ	LQK_N
  06AB'   2A 0CC2'              	LHLD	SKIPR
  06AE'   3A 0CEF'              	LDA	PLACE
  06B1'   B4                    	ORA	H
  06B2'   B5                    	ORA	L
  06B3'   21 0D06'              	LXI	H,LYXE
  06B6'   B6                    	ORA	M
  06B7'   21 0CE3'              	LXI	H,TALLF
  06BA'   B6                    	ORA	M
  06BB'   C2 0758'              	JNZ	LQK_N
  06BE'   2A 0000*              	LHLD	PGTOPM		; (and the text in memory starts where it did:
  06C1'   EB                    	XCHG			;   the pager has not moved the window since)
  06C2'   2A 0CE9'              	LHLD	LYPG
  06C5'   CD 0000*              	CALL	CMP16
  06C8'   C2 0758'              	JNZ	LQK_N
  06CB'   2A 0CC0'              	LHLD	WINROW
  06CE'   EB                    	XCHG
  06CF'   2A 0000*              	LHLD	LNDLT
  06D2'   19                    	DAD	D		; HL = the lines that would be above it
  06D3'   7C                    	MOV	A,H
  06D4'   B7                    	ORA	A
  06D5'   C2 0758'              	JNZ	LQK_N		; over the top line, or far under the last
  06D8'   3A 0CC8'              	LDA	SCBOT
  06DB'   BD                    	CMP	L		; CY iff it is under the last line shown
  06DC'   DA 0758'              	JC	LQK_N
  06DF'   22 0CC0'              	SHLD	WINROW
  06E2'   2A 0000*              	LHLD	LNDLT
  06E5'   22 0CF7'              	SHLD	LYDLT
  06E8'   3A 0000*              	LDA	HTCUR
  06EB'   85                    	ADD	L
  06EC'   32 0000*              	STA	HTCUR
  06EF'   21 0000               	LXI	H,0
  06F2'   22 0000*              	SHLD	LNDLT
  06F5'   22 0CE4'              	SHLD	SCRLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  06F8'   2A 0000*              	LHLD	TXTBEG		; the top line is as far into the text in
  06FB'   EB                    	XCHG			;   memory as it was
  06FC'   2A 0CE7'              	LHLD	LYTOP
  06FF'   19                    	DAD	D
  0700'   CD 08BE'              	CALL	G2P
  0703'   22 0CF1'              	SHLD	TOPLEN
  0706'   24                    	INR	H
  0707'   22 0000*              	SHLD	WRLIM
  070A'   21 0000               	LXI	H,0		; the cursor's line, as far as the cursor
  070D'   CD 0000*              	CALL	LINPSB
  0710'   E5                    	PUSH	H
  0711'   CD 08BE'              	CALL	G2P
  0714'   22 0CF3'              	SHLD	CBOL
  0717'   44                    	MOV	B,H
  0718'   4D                    	MOV	C,L
  0719'   E1                    	POP	H
  071A'   CD 08C5'              	CALL	LNW
  071D'   EB                    	XCHG
  071E'   22 0CF5'              	SHLD	CURDCL
  0721'   CD 050F'              	CALL	DIVN
  0724'   79                    	MOV	A,C
  0725'   32 0CCB'              	STA	CSRAW		; the row of its line the cursor is on
  0728'   3A 0CC0'              	LDA	WINROW
  072B'   CD 049F'              	CALL	SUMT
  072E'   6F                    	MOV	L,A
  072F'   26 00                 	MVI	H,0
  0731'   22 0CC9'              	SHLD	LYABV
  0734'   3A 0000*              	LDA	HTCUR
  0737'   CD 0883'              	CALL	HTE
  073A'   7E                    	MOV	A,M
  073B'   32 0CCC'              	STA	LYTSH
  073E'   23                    	INX	H
  073F'   46                    	MOV	B,M
  0740'   3A 0CC0'              	LDA	WINROW
  0743'   21 0CC8'              	LXI	H,SCBOT
  0746'   BE                    	CMP	M		; CY iff a line shows under it
  0747'   3E 00                 	MVI	A,0
  0749'   D2 074D'              	JNC	LQK_1
  074C'   78                    	MOV	A,B
  074D'                         LQK_1:
  074D'   32 0CCD'              	STA	NXTR
  0750'   CD 0000*              	CALL	RGET0		; the char under the cursor in memory (TABCUR)
  0753'   CD 0000*              	CALL	RDGET
  0756'   37                    	STC
  0757'   C9                    	RET
  0758'                         LQK_N:
  0758'   AF                    	XRA	A
  0759'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  075A'                         LYMQ:
  075A'   3A 0CEF'              	LDA	PLACE
  075D'   FE 02                 	CPI	PL_MID
  075F'   C8                    	RZ
  0760'   3A 0D02'              	LDA	LYND
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0763'   B7                    	ORA	A
  0764'   CA 0769'              	JZ	LQ_NO
  0767'   AF                    	XRA	A
  0768'   C9                    	RET
  0769'                         LQ_NO:
  0769'   3C                    	INR	A
  076A'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  076B'                         FLINE:
  076B'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  076E'   DA 07AB'              	JC	FL_EOF
  0771'   32 0D07'              	STA	LYLAST
  0774'   FE 0A                 	CPI	LF
  0776'   CA 07A9'              	JZ	FL_LF
  0779'   FE 0D                 	CPI	CR
  077B'   CA 076B'              	JZ	FLINE		; CR contributes no display column
  077E'   FE 09                 	CPI	TAB
  0780'   CA 078C'              	JZ	FL_TAB
  0783'   CD 07AE'              	CALL	FL_CEL
  0786'   C2 076B'              	JNZ	FLINE
  0789'                         FL_OVR:
  0789'   3E 01                 	MVI	A,1
  078B'   C9                    	RET
  078C'                         FL_TAB:
  078C'   3A 0CFC'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  078F'   83                    	ADD	E
  0790'   E6 07                 	ANI	TABWID-1
  0792'   2F                    	CMA
  0793'   C6 09                 	ADI	TABWID+1
  0795'   E5                    	PUSH	H
  0796'   6F                    	MOV	L,A
  0797'                         FT_LP:
  0797'   CD 07AE'              	CALL	FL_CEL
  079A'   CA 07A5'              	JZ	FT_OVR
  079D'   2D                    	DCR	L
  079E'   C2 0797'              	JNZ	FT_LP
  07A1'   E1                    	POP	H
  07A2'   C3 076B'              	JMP	FLINE
  07A5'                         FT_OVR:
  07A5'   E1                    	POP	H
  07A6'   C3 0789'              	JMP	FL_OVR
  07A9'                         FL_LF:
  07A9'   AF                    	XRA	A
  07AA'   C9                    	RET
  07AB'                         FL_EOF:
  07AB'   3E FF                 	MVI	A,0FFH
  07AD'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ; not got.  Keeps HL, BC.
  07AE'                         FL_CEL:
  07AE'   3A 0CBE'              	LDA	NCOLS
  07B1'   BB                    	CMP	E
  07B2'   C2 07C4'              	JNZ	FC_1
  07B5'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  07B7'   14                    	INR	D
  07B8'   E5                    	PUSH	H
  07B9'   21 0CFC'              	LXI	H,LYVB
  07BC'   86                    	ADD	M
  07BD'   77                    	MOV	M,A
  07BE'   E1                    	POP	H
  07BF'   3A 0CBF'              	LDA	NEDIT
  07C2'   BA                    	CMP	D
  07C3'   C8                    	RZ
  07C4'                         FC_1:
  07C4'   1C                    	INR	E		; (NZ)
  07C5'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  07C6'                         ISBOF:
  07C6'   EB                    	XCHG
  07C7'   2A 0000*              	LHLD	TXTBEG
  07CA'   CD 0000*              	CALL	CMP16
  07CD'   C0                    	RNZ
  07CE'   2A 0000*              	LHLD	OUTPOS
  07D1'   7C                    	MOV	A,H
  07D2'   B5                    	ORA	L
  07D3'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  07D4'                         LYMID:
  07D4'   CD 0820'              	CALL	LYINI
  07D7'   3A 0D02'              	LDA	LYND
  07DA'   B7                    	ORA	A
  07DB'   CA 0803'              	JZ	LM_LP
  07DE'                         LM_NR:
  07DE'   CD 0867'              	CALL	LMABV		; a line above and a line below, LYND times
  07E1'   DA 07F8'              	JC	LM_P
  07E4'   CD 0839'              	CALL	LMBLW
  07E7'   DA 07F8'              	JC	LM_P
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  07EA'   21 0D02'              	LXI	H,LYND
  07ED'   35                    	DCR	M
  07EE'   C2 07DE'              	JNZ	LM_NR
  07F1'   3A 0D04'              	LDA	LYSVR		; the screen holds them: scroll to it
  07F4'   32 0CF9'              	STA	LYROW
  07F7'   C9                    	RET
  07F8'                         LM_P:
  07F8'   AF                    	XRA	A		; it does not: the middle, above first
  07F9'   32 0D02'              	STA	LYND
  07FC'   3C                    	INR	A
  07FD'   32 0D03'              	STA	LYPRF
  0800'   C3 07D4'              	JMP	LYMID
  0803'                         LM_LP:
  0803'   3A 0D01'              	LDA	LYMBL
  0806'   21 0D03'              	LXI	H,LYPRF
  0809'   86                    	ADD	M
  080A'   47                    	MOV	B,A
  080B'   3A 0D00'              	LDA	LYMAB
  080E'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  080F'   DA 0819'              	JC	LM_U		;   many, when above goes first)
  0812'   CD 0839'              	CALL	LMBLW
  0815'   D2 0803'              	JNC	LM_LP
  0818'   C9                    	RET
  0819'                         LM_U:
  0819'   CD 0867'              	CALL	LMABV
  081C'   D2 0803'              	JNC	LM_LP
  081F'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0820'                         LYINI:
  0820'   AF                    	XRA	A
  0821'   32 0CF9'              	STA	LYROW
  0824'   32 0D00'              	STA	LYMAB
  0827'   32 0D01'              	STA	LYMBL
  082A'   3A 0000*              	LDA	HTCUR
  082D'   CD 0883'              	CALL	HTE
  0830'   7E                    	MOV	A,M
  0831'   32 0CFF'              	STA	LYUSE
  0834'   23                    	INX	H
  0835'   22 0CFA'              	SHLD	LYIB
  0838'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0839'                         LMBLW:
  0839'   3A 0000*              	LDA	HTN
  083C'   CD 0883'              	CALL	HTE
  083F'   EB                    	XCHG
  0840'   2A 0CFA'              	LHLD	LYIB
  0843'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0846'   C2 0855'              	JNZ	LB_1
  0849'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  084C'   B7                    	ORA	A
  084D'   37                    	STC
  084E'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  084F'   21 0D01'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0852'   34                    	INR	M
  0853'   B7                    	ORA	A
  0854'   C9                    	RET
  0855'                         LB_1:
  0855'   7E                    	MOV	A,M
  0856'   CD 088B'              	CALL	LM_ADD
  0859'   D8                    	RC
  085A'   21 0D01'              	LXI	H,LYMBL
  085D'   86                    	ADD	M
  085E'   77                    	MOV	M,A
  085F'   2A 0CFA'              	LHLD	LYIB
  0862'   23                    	INX	H
  0863'   22 0CFA'              	SHLD	LYIB
  0866'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0867'                         LMABV:
  0867'   21 0CF9'              	LXI	H,LYROW
  086A'   3A 0000*              	LDA	HTCUR
  086D'   96                    	SUB	M
  086E'   37                    	STC
  086F'   C8                    	RZ
  0870'   3D                    	DCR	A
  0871'   CD 0883'              	CALL	HTE
  0874'   7E                    	MOV	A,M
  0875'   CD 088B'              	CALL	LM_ADD
  0878'   D8                    	RC
  0879'   21 0D00'              	LXI	H,LYMAB
  087C'   86                    	ADD	M
  087D'   77                    	MOV	M,A
  087E'   21 0CF9'              	LXI	H,LYROW
  0881'   34                    	INR	M
  0882'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0883'                         HTE:
  0883'   5F                    	MOV	E,A
  0884'   16 00                 	MVI	D,0
  0886'   21 0000*              	LXI	H,HTAB
  0889'   19                    	DAD	D
  088A'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  088B'                         LM_ADD:
  088B'   47                    	MOV	B,A
  088C'   3A 0CFF'              	LDA	LYUSE
  088F'   80                    	ADD	B
  0890'   D8                    	RC
  0891'   4F                    	MOV	C,A
  0892'   3A 0CBF'              	LDA	NEDIT
  0895'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0896'   D8                    	RC
  0897'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0898'   32 0CFF'              	STA	LYUSE
  089B'   78                    	MOV	A,B
  089C'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  089D'                         LM_NX:
  089D'   11 0000               	LXI	D,0
  08A0'   AF                    	XRA	A
  08A1'   32 0CFC'              	STA	LYVB
  08A4'   2A 0D13'              	LHLD	RDBC
  08A7'   44                    	MOV	B,H
  08A8'   4D                    	MOV	C,L
  08A9'   2A 0D11'              	LHLD	RDHL
  08AC'                         LM_FL:
  08AC'   CD 076B'              	CALL	FLINE
  08AF'   22 0D11'              	SHLD	RDHL
  08B2'   60                    	MOV	H,B
  08B3'   69                    	MOV	L,C
  08B4'   22 0D13'              	SHLD	RDBC
  08B7'   B7                    	ORA	A
  08B8'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  08B9'                         LYTOPP:
  08B9'   2A 0CF1'              	LHLD	TOPLEN
  08BC'   44                    	MOV	B,H
  08BD'   4D                    	MOV	C,L
  08BE'                         G2P:
  08BE'   EB                    	XCHG
  08BF'   2A 0000*              	LHLD	GAPBEG
  08C2'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  08C5'                         LNW:
  08C5'   11 0000               	LXI	D,0
  08C8'                         LNW_LP:
  08C8'   78                    	MOV	A,B
  08C9'   B1                    	ORA	C
  08CA'   C8                    	RZ
  08CB'   7E                    	MOV	A,M
  08CC'   23                    	INX	H
  08CD'   0B                    	DCX	B
  08CE'   FE 0A                 	CPI	LF
  08D0'   CA 08E5'              	JZ	LNW_LF
  08D3'   FE 0D                 	CPI	CR
  08D5'   CA 08C8'              	JZ	LNW_LP		; CR contributes no display column
  08D8'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  08DA'   C2 08E1'              	JNZ	LNW_1
  08DD'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  08DE'   F6 07                 	ORI	TABWID-1
  08E0'   5F                    	MOV	E,A
  08E1'                         LNW_1:
  08E1'   13                    	INX	D
  08E2'   C3 08C8'              	JMP	LNW_LP
  08E5'                         LNW_LF:
  08E5'   37                    	STC
  08E6'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  08E7'                         LYFAR:
  08E7'   2A 0CC0'              	LHLD	WINROW
  08EA'   EB                    	XCHG
  08EB'   2A 0000*              	LHLD	LNDLT
  08EE'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  08EF'   7C                    	MOV	A,H
  08F0'   B7                    	ORA	A
  08F1'   F2 0908'              	JP	LF_DN
  08F4'   3A 0CBF'              	LDA	NEDIT
  08F7'   B7                    	ORA	A
  08F8'   1F                    	RAR
  08F9'   D6 02                 	SUI	2
  08FB'   5F                    	MOV	E,A
  08FC'   16 00                 	MVI	D,0
  08FE'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  08FF'   7C                    	MOV	A,H
  0900'   B7                    	ORA	A
  0901'   F0                    	RP
  0902'                         LF_FAR:
  0902'   3E 02                 	MVI	A,PL_MID
  0904'   32 0CEF'              	STA	PLACE
  0907'   C9                    	RET
  0908'                         LF_DN:
  0908'   3A 0CC8'              	LDA	SCBOT
  090B'   3C                    	INR	A
  090C'   5F                    	MOV	E,A
  090D'   16 00                 	MVI	D,0
  090F'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0912'   7C                    	MOV	A,H		;   less one
  0913'   B7                    	ORA	A
  0914'   F8                    	RM			; on the screen
  0915'   C2 0902'              	JNZ	LF_FAR
  0918'   3A 0CBF'              	LDA	NEDIT
  091B'   BD                    	CMP	L		; CY iff NEDIT < that
  091C'   DA 0902'              	JC	LF_FAR
  091F'   7D                    	MOV	A,L
  0920'   32 0D02'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0923'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0924'                         HTBLD:
  0924'   79                    	MOV	A,C
  0925'   32 0D05'              	STA	HTLIM
  0928'   AF                    	XRA	A
  0929'   32 0000*              	STA	HTN
  092C'   32 0CE6'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  092F'   32 0000*              	STA	HTEOF
  0932'   32 0000*              	STA	HTBOF
  0935'   32 0D06'              	STA	LYXE
  0938'   32 0CE3'              	STA	TALLF
  093B'   68                    	MOV	L,B
  093C'   67                    	MOV	H,A
  093D'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0940'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0941'   E5                    	PUSH	H
  0942'   CD 07C6'              	CALL	ISBOF
  0945'   C2 094C'              	JNZ	HB_1
  0948'   3C                    	INR	A
  0949'   32 0000*              	STA	HTBOF
  094C'                         HB_1:
  094C'   E1                    	POP	H
  094D'   E5                    	PUSH	H
  094E'   CD 08BE'              	CALL	G2P		; HL = the bytes from there to the cursor
  0951'   E5                    	PUSH	H
  0952'   3A 0CBE'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0955'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0957'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0958'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  095A'   3A 0CBF'              	LDA	NEDIT		;   leave no room to read down
  095D'   CD 0B90'              	CALL	MULHA
  0960'   D1                    	POP	D
  0961'   42                    	MOV	B,D
  0962'   4B                    	MOV	C,E
  0963'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0966'   D2 096A'              	JNC	HB_LM
  0969'   EB                    	XCHG
  096A'                         HB_LM:
  096A'   22 0CFD'              	SHLD	LYLIM
  096D'   E1                    	POP	H
  096E'   F1                    	POP	PSW
  096F'   D2 0979'              	JNC	HB_AB
  0972'   3A 0000*              	LDA	HTBOF
  0975'   B7                    	ORA	A
  0976'   CC 08C5'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0979'                         HB_AB:
  0979'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  097A'   CD 08C5'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  097D'   D2 09A0'              	JNC	HB_CU
  0980'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0981'   C5                    	PUSH	B
  0982'   EB                    	XCHG
  0983'   CD 0508'              	CALL	XTRA		; BC = its rows past the first
  0986'   78                    	MOV	A,B
  0987'   B7                    	ORA	A
  0988'   C2 0995'              	JNZ	HB_TA
  098B'   3A 0CBF'              	LDA	NEDIT
  098E'   3D                    	DCR	A
  098F'   B9                    	CMP	C		; CY iff more rows than the screen has
  0990'   79                    	MOV	A,C
  0991'   3C                    	INR	A
  0992'   D2 0998'              	JNC	HB_PA
  0995'                         HB_TA:
  0995'   3A 0CBF'              	LDA	NEDIT
  0998'                         HB_PA:
  0998'   CD 0AB1'              	CALL	HTPUT
  099B'   C1                    	POP	B
  099C'   E1                    	POP	H
  099D'   C3 0979'              	JMP	HB_AB
  09A0'                         HB_CU:
  09A0'   EB                    	XCHG
  09A1'   22 0CF5'              	SHLD	CURDCL
  09A4'   E1                    	POP	H
  09A5'   22 0CF3'              	SHLD	CBOL
  09A8'   EB                    	XCHG			; none of it spilled while reading down: the
  09A9'   2A 0CFD'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  09AC'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  09AF'   DA 09B3'              	JC	HB_WL
  09B2'   EB                    	XCHG
  09B3'                         HB_WL:
  09B3'   24                    	INR	H
  09B4'   22 0000*              	SHLD	WRLIM
  09B7'   3A 0000*              	LDA	HTN
  09BA'   32 0000*              	STA	HTCUR
  09BD'   2A 0CF5'              	LHLD	CURDCL
  09C0'   CD 050F'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  09C3'   5F                    	MOV	E,A
  09C4'   3A 0CF5'              	LDA	CURDCL
  09C7'   93                    	SUB	E
  09C8'   32 0CFC'              	STA	LYVB		; the column the cursor's row starts at
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  09CB'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  09CC'   2A 0CC2'              	LHLD	SKIPR
  09CF'   50                    	MOV	D,B
  09D0'   59                    	MOV	E,C
  09D1'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  09D4'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  09D5'   DA 09F3'              	JC	HB_SS		; then that is the first
  09D8'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  09DB'   7C                    	MOV	A,H
  09DC'   B7                    	ORA	A
  09DD'   C2 09E9'              	JNZ	HB_SD
  09E0'   3A 0CBF'              	LDA	NEDIT
  09E3'   3D                    	DCR	A
  09E4'   BD                    	CMP	L		; CY iff that is under the last edit row
  09E5'   EB                    	XCHG			; HL = SKIPR, as it was
  09E6'   D2 09F3'              	JNC	HB_SS
  09E9'                         HB_SD:
  09E9'   3A 0CBF'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  09EC'   2F                    	CMA
  09ED'   6F                    	MOV	L,A
  09EE'   26 FF                 	MVI	H,0FFH
  09F0'   23                    	INX	H
  09F1'   23                    	INX	H
  09F2'   09                    	DAD	B
  09F3'                         HB_SS:
  09F3'   22 0CC2'              	SHLD	SKIPR
  09F6'   EB                    	XCHG
  09F7'   60                    	MOV	H,B
  09F8'   69                    	MOV	L,C
  09F9'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  09FC'   7D                    	MOV	A,L
  09FD'   32 0CCB'              	STA	CSRAW
  0A00'   D1                    	POP	D
  0A01'   57                    	MOV	D,A
  0A02'   CD 0000*              	CALL	RGET0
  0A05'   CD 08AC'              	CALL	LM_FL		; the rest of the line: D = its last row
  0A08'   F5                    	PUSH	PSW
  0A09'   FE 01                 	CPI	1
  0A0B'   CA 0A9A'              	JZ	HB_TO		; more rows than the screen has
  0A0E'   2A 0CC2'              	LHLD	SKIPR
  0A11'   7C                    	MOV	A,H
  0A12'   B5                    	ORA	L
  0A13'   CA 0A36'              	JZ	HB_E2
  0A16'   7C                    	MOV	A,H
  0A17'   B7                    	ORA	A
  0A18'   C2 0A31'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0A1B'   7D                    	MOV	A,L
  0A1C'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0A1D'   DA 0A31'              	JC	HB_TE
  0A20'   21 0CBF'              	LXI	H,NEDIT
  0A23'   BE                    	CMP	M
  0A24'   D2 0A31'              	JNC	HB_TE		; more than NEDIT of them
  0A27'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0A28'   21 0000               	LXI	H,0
  0A2B'   22 0CC2'              	SHLD	SKIPR
  0A2E'   C3 0A36'              	JMP	HB_E2
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A31'                         HB_TE:
  0A31'   3E 01                 	MVI	A,1
  0A33'   32 0CE3'              	STA	TALLF
  0A36'                         HB_E2:
  0A36'   7B                    	MOV	A,E
  0A37'   B7                    	ORA	A
  0A38'   C2 0A44'              	JNZ	HB_E3
  0A3B'   B2                    	ORA	D
  0A3C'   CA 0A44'              	JZ	HB_E3		; (its first row: an empty line)
  0A3F'   3E 01                 	MVI	A,1
  0A41'   32 0D06'              	STA	LYXE
  0A44'                         HB_E3:
  0A44'   7A                    	MOV	A,D
  0A45'   3C                    	INR	A
  0A46'   32 0CCC'              	STA	LYTSH
  0A49'   3A 0CE3'              	LDA	TALLF
  0A4C'   B7                    	ORA	A
  0A4D'   C2 0AA5'              	JNZ	HB_TX
  0A50'   F1                    	POP	PSW
  0A51'   FA 0A76'              	JM	HB_LS		; the text ends with it
  0A54'                         HB_PT:
  0A54'   7A                    	MOV	A,D
  0A55'   3C                    	INR	A
  0A56'   CD 0AB1'              	CALL	HTPUT
  0A59'   47                    	MOV	B,A
  0A5A'   3A 0D05'              	LDA	HTLIM
  0A5D'   90                    	SUB	B
  0A5E'   32 0D05'              	STA	HTLIM
  0A61'   D8                    	RC
  0A62'   CA 0A81'              	JZ	HB_PK		; rows enough
  0A65'                         HB_NX:
  0A65'   CD 089D'              	CALL	LM_NX		; the next line down
  0A68'   CA 0A54'              	JZ	HB_PT
  0A6B'   F2 0AAE'              	JP	HB_TL		; one taller than the screen
  0A6E'   3A 0D07'              	LDA	LYLAST		; the text ended: was that a line?
  0A71'   FE 0A                 	CPI	LF
  0A73'   CA 0A7B'              	JZ	HB_EF
  0A76'                         HB_LS:
  0A76'   7A                    	MOV	A,D
  0A77'   3C                    	INR	A
  0A78'   CD 0AB1'              	CALL	HTPUT
  0A7B'                         HB_EF:
  0A7B'   3E 01                 	MVI	A,1
  0A7D'   32 0000*              	STA	HTEOF
  0A80'   C9                    	RET
  0A81'                         HB_PK:
  0A81'   2A 0D13'              	LHLD	RDBC		; just the rows asked for: is the text over
  0A84'   44                    	MOV	B,H		;   right there?
  0A85'   4D                    	MOV	C,L
  0A86'   2A 0D11'              	LHLD	RDHL
  0A89'   CD 0000*              	CALL	RDGET
  0A8C'   D0                    	RNC
  0A8D'   C3 0A7B'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0A90'                         HBMOR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0A90'   32 0D05'              	STA	HTLIM
  0A93'   B7                    	ORA	A
  0A94'   CA 0A81'              	JZ	HB_PK
  0A97'   C3 0A65'              	JMP	HB_NX
  0A9A'                         HB_TO:
  0A9A'   3E 01                 	MVI	A,1
  0A9C'   32 0CE3'              	STA	TALLF
  0A9F'   3A 0CBF'              	LDA	NEDIT
  0AA2'   32 0CCC'              	STA	LYTSH
  0AA5'                         HB_TX:
  0AA5'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0AA6'   F2 0AAE'              	JP	HB_TL		;   with it, and on the screen)
  0AA9'   3E 01                 	MVI	A,1
  0AAB'   32 0000*              	STA	HTEOF
  0AAE'                         HB_TL:
  0AAE'   3A 0CBF'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0AB1'                         HTPUT:
  0AB1'   E5                    	PUSH	H
  0AB2'   D5                    	PUSH	D
  0AB3'   21 0000*              	LXI	H,HTN
  0AB6'   5E                    	MOV	E,M
  0AB7'   1C                    	INR	E
  0AB8'   CA 0AC4'              	JZ	HP_1
  0ABB'   73                    	MOV	M,E
  0ABC'   1D                    	DCR	E
  0ABD'   16 00                 	MVI	D,0
  0ABF'   21 0000*              	LXI	H,HTAB
  0AC2'   19                    	DAD	D
  0AC3'   77                    	MOV	M,A
  0AC4'                         HP_1:
  0AC4'   D1                    	POP	D
  0AC5'   E1                    	POP	H
  0AC6'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0AC7'                         TABCUR:
  0AC7'   3A 0000*              	LDA	EDMODE
  0ACA'   FE 00                 	CPI	EM_CMD
  0ACC'   C0                    	RNZ
  0ACD'   2A 0000*              	LHLD	TXTEND
  0AD0'   EB                    	XCHG
  0AD1'   2A 0000*              	LHLD	GAPEND
  0AD4'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0AD7'   C8                    	RZ
  0AD8'   7E                    	MOV	A,M
  0AD9'   FE 09                 	CPI	TAB
  0ADB'   C0                    	RNZ
  0ADC'   2A 0CF5'              	LHLD	CURDCL
  0ADF'   7D                    	MOV	A,L
  0AE0'   F6 07                 	ORI	TABWID-1
  0AE2'   6F                    	MOV	L,A
  0AE3'   22 0CF5'              	SHLD	CURDCL
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0AE6'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0AE7'                         RDTOP:
  0AE7'   2A 0CF1'              	LHLD	TOPLEN
  0AEA'   C3 0AF0'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0AED'                         RDBOL:
  0AED'   2A 0CF3'              	LHLD	CBOL
  0AF0'                         RDSET:
  0AF0'   22 0D0F'              	SHLD	RDN
  0AF3'   EB                    	XCHG
  0AF4'   2A 0000*              	LHLD	GAPBEG
  0AF7'   CD 0000*              	CALL	SUBHD
  0AFA'   22 0D0D'              	SHLD	RDP
  0AFD'   AF                    	XRA	A
  0AFE'   32 0D15'              	STA	RDSEG
  0B01'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0B02'                         RDCH:
  0B02'   C5                    	PUSH	B
  0B03'   D5                    	PUSH	D
  0B04'   E5                    	PUSH	H
  0B05'   2A 0D0F'              	LHLD	RDN		; before-gap bytes left?
  0B08'   7C                    	MOV	A,H
  0B09'   B5                    	ORA	L
  0B0A'   CA 0B1D'              	JZ	RDC_AF
  0B0D'   2B                    	DCX	H
  0B0E'   22 0D0F'              	SHLD	RDN
  0B11'   2A 0D0D'              	LHLD	RDP
  0B14'   7E                    	MOV	A,M
  0B15'   23                    	INX	H
  0B16'   22 0D0D'              	SHLD	RDP
  0B19'   B7                    	ORA	A		; CY=0
  0B1A'   C3 0B41'              	JMP	RDC_RT
  0B1D'                         RDC_AF:
  0B1D'   3A 0D15'              	LDA	RDSEG
  0B20'   B7                    	ORA	A
  0B21'   C2 0B2E'              	JNZ	RDC_NX
  0B24'   3C                    	INR	A		; first after-gap byte: start RGET
  0B25'   32 0D15'              	STA	RDSEG
  0B28'   CD 0000*              	CALL	RGET0
  0B2B'   C3 0B36'              	JMP	RDC_GT
  0B2E'                         RDC_NX:
  0B2E'   2A 0D13'              	LHLD	RDBC
  0B31'   44                    	MOV	B,H
  0B32'   4D                    	MOV	C,L
  0B33'   2A 0D11'              	LHLD	RDHL
  0B36'                         RDC_GT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B36'   CD 0000*              	CALL	RDGET
  0B39'   22 0D11'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0B3C'   60                    	MOV	H,B
  0B3D'   69                    	MOV	L,C
  0B3E'   22 0D13'              	SHLD	RDBC
  0B41'                         RDC_RT:
  0B41'   E1                    	POP	H
  0B42'   D1                    	POP	D
  0B43'   C1                    	POP	B
  0B44'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0B45'                         RDSKIP:
  0B45'   B7                    	ORA	A
  0B46'   C8                    	RZ
  0B47'   32 0D16'              	STA	SKPN
  0B4A'                         RSK_LP:
  0B4A'   CD 0B02'              	CALL	RDCH
  0B4D'   D8                    	RC
  0B4E'   FE 0A                 	CPI	LF
  0B50'   C2 0B4A'              	JNZ	RSK_LP
  0B53'   3A 0D16'              	LDA	SKPN
  0B56'   3D                    	DCR	A
  0B57'   32 0D16'              	STA	SKPN
  0B5A'   C2 0B4A'              	JNZ	RSK_LP
  0B5D'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0B5E'                         PSKIP:
  0B5E'   3A 0CBE'              	LDA	NCOLS
  0B61'   CD 0B90'              	CALL	MULHA		; HL = the cells to pass over
  0B64'   EB                    	XCHG
  0B65'   21 0000               	LXI	H,0
  0B68'   22 0D18'              	SHLD	PSKN
  0B6B'                         PS_LP:
  0B6B'   7A                    	MOV	A,D
  0B6C'   B3                    	ORA	E
  0B6D'   CA 0BC4'              	JZ	PR_LP
  0B70'   CD 0B02'              	CALL	RDCH
  0B73'   FE 0D                 	CPI	CR
  0B75'   CA 0B6B'              	JZ	PS_LP
  0B78'   0E 01                 	MVI	C,1
  0B7A'   FE 09                 	CPI	TAB
  0B7C'   CC 0B9A'              	CZ	TABN
  0B7F'                         PS_CL:
  0B7F'   7A                    	MOV	A,D
  0B80'   B3                    	ORA	E
  0B81'   CA 0BDE'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0B84'   1B                    	DCX	D
  0B85'   21 0D1A'              	LXI	H,DCOL
  0B88'   34                    	INR	M
  0B89'   0D                    	DCR	C
  0B8A'   C2 0B7F'              	JNZ	PS_CL
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B8D'   C3 0B6B'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0B90'                         MULHA:
  0B90'   EB                    	XCHG
  0B91'   21 0000               	LXI	H,0
  0B94'                         MH_LP:
  0B94'   19                    	DAD	D
  0B95'   3D                    	DCR	A
  0B96'   C2 0B94'              	JNZ	MH_LP
  0B99'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0B9A'                         TABN:
  0B9A'   3A 0D1A'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0B9D'   E6 07                 	ANI	7
  0B9F'   4F                    	MOV	C,A
  0BA0'   3E 08                 	MVI	A,8
  0BA2'   91                    	SUB	C
  0BA3'   4F                    	MOV	C,A
  0BA4'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0BA5'                         PAINTR:
  0BA5'   3A 0D17'              	LDA	PROWN
  0BA8'   21 0CC6'              	LXI	H,TXEND
  0BAB'   BE                    	CMP	M		; CY iff the row holds text
  0BAC'   DA 0BB5'              	JC	PROW
  0BAF'   3A 0CC7'              	LDA	FILCH
  0BB2'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0BB5'                         PROW:
  0BB5'   AF                    	XRA	A
  0BB6'   32 0D1A'              	STA	DCOL
  0BB9'   32 0D1B'              	STA	XC
  0BBC'   2A 0D18'              	LHLD	PSKN
  0BBF'   7C                    	MOV	A,H
  0BC0'   B5                    	ORA	L
  0BC1'   C2 0B5E'              	JNZ	PSKIP
  0BC4'                         PR_LP:
  0BC4'   CD 0B02'              	CALL	RDCH
  0BC7'   D8                    	RC			; end of text -> line done
  0BC8'   FE 0A                 	CPI	LF
  0BCA'   C8                    	RZ			; consumed the LF -> next line start
  0BCB'   FE 0D                 	CPI	CR
  0BCD'   CA 0BC4'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0BD0'   FE 09                 	CPI	TAB
  0BD2'   CA 0BDB'              	JZ	PR_TAB
  0BD5'   CD 0BEA'              	CALL	PCELL
  0BD8'   C3 0BC4'              	JMP	PR_LP
  0BDB'                         PR_TAB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BDB'   CD 0B9A'              	CALL	TABN		; C = space count (1..8)
  0BDE'                         PRTBLP:
  0BDE'   3E 20                 	MVI	A,' '
  0BE0'   CD 0BEA'              	CALL	PCELL		; (keeps C)
  0BE3'   0D                    	DCR	C
  0BE4'   C2 0BDE'              	JNZ	PRTBLP
  0BE7'   C3 0BC4'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0BEA'                         PCELL:
  0BEA'   47                    	MOV	B,A
  0BEB'   21 0D1A'              	LXI	H,DCOL
  0BEE'   34                    	INR	M
  0BEF'   3A 0CBE'              	LDA	NCOLS
  0BF2'   21 0D1B'              	LXI	H,XC
  0BF5'   BE                    	CMP	M
  0BF6'   CC 0BFE'              	CZ	PWRAP		; the row is full: this one starts the next
  0BF9'   34                    	INR	M
  0BFA'   78                    	MOV	A,B
  0BFB'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0BFE'                         PWRAP:
  0BFE'   36 00                 	MVI	M,0
  0C00'   3A 0CE2'              	LDA	PEND
  0C03'   3D                    	DCR	A
  0C04'   21 0D17'              	LXI	H,PROWN
  0C07'   BE                    	CMP	M
  0C08'   CA 0C1D'              	JZ	PW_END
  0C0B'   34                    	INR	M
  0C0C'   3E 0D                 	MVI	A,CR
  0C0E'   CD 0018'              	CALL	OUTCH
  0C11'   3E 0A                 	MVI	A,LF
  0C13'   CD 0018'              	CALL	OUTCH
  0C16'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0C19'   21 0D1B'              	LXI	H,XC
  0C1C'   C9                    	RET
  0C1D'                         PW_END:
  0C1D'   E1                    	POP	H		; PCELL's return, and PROW's
  0C1E'   E1                    	POP	H
  0C1F'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0C20'                         MODEMS:
  0C20'   3A 0000*              	LDA	EDMODE
  0C23'   47                    	MOV	B,A
  0C24'   3A 0CEC'              	LDA	OEDMOD
  0C27'   B8                    	CMP	B
  0C28'   C8                    	RZ			; the row already shows this mode
  0C29'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C2A'   32 0CEC'              	STA	OEDMOD
  0C2D'   21 0C9D'              	LXI	H,SINSM
  0C30'   FE 01                 	CPI	EM_INS
  0C32'   CA 0C40'              	JZ	MD_DRW
  0C35'   21 0CAA'              	LXI	H,SREPM
  0C38'   FE 02                 	CPI	EM_REP
  0C3A'   CA 0C40'              	JZ	MD_DRW
  0C3D'   21 0CB8'              	LXI	H,SNULL		; command mode: the row goes blank
  0C40'                         MD_DRW:
  0C40'   E5                    	PUSH	H
  0C41'   3A 0CBD'              	LDA	NROWS
  0C44'   CD 008C'              	CALL	GOROW1
  0C47'   E1                    	POP	H
  0C48'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0C4B'                         SCURS:
  0C4B'   3A 0CC4'              	LDA	SROW
  0C4E'   47                    	MOV	B,A
  0C4F'   3A 0CC5'              	LDA	SCOL
  0C52'   4F                    	MOV	C,A
  0C53'   CD 0064'              	CALL	GOTOXY
  0C56'   21 0C92'              	LXI	H,SSHOW
  0C59'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0C5C'                         SCDONE:
  0C5C'   CD 0086'              	CALL	CRGRS
  0C5F'   21 0C92'              	LXI	H,SSHOW
  0C62'   CD 0025'              	CALL	OUTSTR
  0C65'   3A 0CBD'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0C68'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0C6B'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0C6F'   39 3B 39 39           
  0C73'   39 48                 
  0C75'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0C79'   00                    
  0C7A'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0C7E'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0C81'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0C85'   00                    
  0C86'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0C8A'   00                    
  0C8B'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0C8F'   35 6C 00              
  0C92'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0C96'   35 68 00              
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C99'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0C9D'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0CA1'   4E 53 45 52           
  0CA5'   54 20 2D 2D           
  0CA9'   00                    
  0CAA'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0CAE'   45 50 4C 41           
  0CB2'   43 45 20 2D           
  0CB6'   2D 00                 
  0CB8'   00                    SNULL:	DB	0
  0CB9'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0CBD'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0CBE'   50                    NCOLS:	DB	80		; runtime columns
  0CBF'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  0CC0'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0CC2'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0CC4'   00                    SROW:	DB	0		; computed cursor screen row
  0CC5'   00                    SCOL:	DB	0		; computed cursor screen column
  0CC6'   01                    TXEND:	DB	1		; the first row with no text on it
  0CC7'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0CC8'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0CC9'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0CCB'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  0CCC'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  0CCD'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  0CCE'   0000                  OLDWR:	DW	0
  0CD0'   0000                  OLDSK:	DW	0
  0CD2'   0000                  OLDSC:	DW	0
  0CD4'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  0CD6'   00                    OLDBOT:	DB	0
  0CD7'   0000                  OLDAB:	DW	0
  0CD9'   00                    OLDCS:	DB	0
  0CDA'   00                    OLDCR:	DB	0
  0CDB'   00                    OLDNR:	DB	0
                                
  0CDC'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  0CDD'   00                    OPM:	DB	0		; ... or gained there
  0CDE'   00                    EDA:	DB	0		; the edit: the rows it had
  0CDF'   00                    EDB:	DB	0		; ... and has
  0CE0'   00                    EDR:	DB	0		; ... its first row
  0CE1'   00                    EDP:	DB	0		; ... the first of them to draw
  0CE2'   00                    PEND:	DB	0		; PRNG: the row to stop before
  0CE3'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0CE4'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0CE6'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  0CE7'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  0CE9'   0000                  LYPG:	DW	0		; ... and PGTOPM
  0CEB'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CEC'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0CED'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0CEE'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0CEF'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  0CF0'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0CF1'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0CF3'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0CF5'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  0CF7'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0CF9'   00                    LYROW:	DB	0		; LAYOUT: working row
  0CFA'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  0CFC'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0CFD'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  0CFF'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0D00'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0D01'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0D02'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0D03'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0D04'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0D05'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0D06'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  0D07'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0D08'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0D0A'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0D0C'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0D0D'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0D0F'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0D11'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0D13'   0000                  RDBC:	DW	0		; reader: RGET count
  0D15'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0D16'   00                    SKPN:	DB	0		; RDSKIP line count
  0D17'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0D18'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  0D1A'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0D1B'   00                    XC:	DB	0		; cells used in the row being painted
                                
  0D1C'   0000                  TMPR:	DW	0		; DSR parse: rows
  0D1E'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
