  0B4C'   4F                    	MOV	C,A
  0B4D'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0B4E'                         PAINTR:
  0B4E'   3A 0CB4'              	LDA	PROWN
  0B51'   21 0C80'              	LXI	H,TXEND
  0B54'   BE                    	CMP	M		; CY iff the row holds text
  0B55'   DA 0B5E'              	JC	PROW
  0B58'   3A 0C81'              	LDA	FILCH
  0B5B'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0B5E'                         PROW:
  0B5E'   AF                    	XRA	A
  0B5F'   32 0CB8'              	STA	DCOL
  0B62'   32 0CB9'              	STA	XC
  0B65'   2A 0CB6'              	LHLD	PSKN
  0B68'   7C                    	MOV	A,H
  0B69'   B5                    	ORA	L
  0B6A'   C2 0B07'              	JNZ	PSKIP
  0B6D'                         PR_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B6D'   CD 0AAB'              	CALL	RDCH
  0B70'   D8                    	RC			; end of text -> line done
  0B71'   FE 0A                 	CPI	LF
  0B73'   C8                    	RZ			; consumed the LF -> next line start
  0B74'   FE 0D                 	CPI	CR
  0B76'   CA 0B6D'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0B79'   FE 09                 	CPI	TAB
  0B7B'   CA 0B84'              	JZ	PR_TAB
  0B7E'   CD 0B93'              	CALL	PCELL
  0B81'   C3 0B6D'              	JMP	PR_LP
  0B84'                         PR_TAB:
  0B84'   CD 0B43'              	CALL	TABN		; C = space count (1..8)
  0B87'                         PRTBLP:
  0B87'   3E 20                 	MVI	A,' '
  0B89'   CD 0B93'              	CALL	PCELL		; (keeps C)
  0B8C'   0D                    	DCR	C
  0B8D'   C2 0B87'              	JNZ	PRTBLP
  0B90'   C3 0B6D'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0B93'                         PCELL:
  0B93'   47                    	MOV	B,A
  0B94'   21 0CB8'              	LXI	H,DCOL
  0B97'   34                    	INR	M
  0B98'   3A 0C6E'              	LDA	NCOLS
  0B9B'   21 0CB9'              	LXI	H,XC
  0B9E'   BE                    	CMP	M
  0B9F'   CC 0BA7'              	CZ	PWRAP		; the row is full: this one starts the next
  0BA2'   34                    	INR	M
  0BA3'   78                    	MOV	A,B
  0BA4'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last edit row there is nowhere to go: the rest of the
                                ; line is not shown, and PROW returns to its caller from here.
  0BA7'                         PWRAP:
  0BA7'   36 00                 	MVI	M,0
  0BA9'   3A 0C6F'              	LDA	NEDIT
  0BAC'   3D                    	DCR	A
  0BAD'   21 0CB4'              	LXI	H,PROWN
  0BB0'   BE                    	CMP	M
  0BB1'   CA 0BC6'              	JZ	PW_END
  0BB4'   34                    	INR	M
  0BB5'   3E 0D                 	MVI	A,CR
  0BB7'   CD 0018'              	CALL	OUTCH
  0BBA'   3E 0A                 	MVI	A,LF
  0BBC'   CD 0018'              	CALL	OUTCH
  0BBF'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0BC2'   21 0CB9'              	LXI	H,XC
  0BC5'   C9                    	RET
  0BC6'                         PW_END:
  0BC6'   E1                    	POP	H		; PCELL's return, and PROW's
  0BC7'   E1                    	POP	H
  0BC8'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0BC9'                         MODEMS:
  0BC9'   3A 0000*              	LDA	EDMODE
  0BCC'   47                    	MOV	B,A
  0BCD'   3A 0C7E'              	LDA	OEDMOD
  0BD0'   B8                    	CMP	B
  0BD1'   C8                    	RZ			; the row already shows this mode
  0BD2'   78                    	MOV	A,B
  0BD3'   32 0C7E'              	STA	OEDMOD
  0BD6'   21 0C4D'              	LXI	H,SINSM
  0BD9'   FE 01                 	CPI	EM_INS
  0BDB'   CA 0BE9'              	JZ	MD_DRW
  0BDE'   21 0C5A'              	LXI	H,SREPM
  0BE1'   FE 02                 	CPI	EM_REP
  0BE3'   CA 0BE9'              	JZ	MD_DRW
  0BE6'   21 0C68'              	LXI	H,SNULL		; command mode: the row goes blank
  0BE9'                         MD_DRW:
  0BE9'   E5                    	PUSH	H
  0BEA'   3A 0C6D'              	LDA	NROWS
  0BED'   CD 008C'              	CALL	GOROW1
  0BF0'   E1                    	POP	H
  0BF1'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0BF4'                         SCURS:
  0BF4'   3A 0CBC'              	LDA	SROW
  0BF7'   47                    	MOV	B,A
  0BF8'   3A 0CBD'              	LDA	SCOL
  0BFB'   4F                    	MOV	C,A
  0BFC'   CD 0064'              	CALL	GOTOXY
  0BFF'   21 0C42'              	LXI	H,SSHOW
  0C02'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0C05'                         SCDONE:
  0C05'   CD 0086'              	CALL	CRGRS
  0C08'   21 0C42'              	LXI	H,SSHOW
  0C0B'   CD 0025'              	CALL	OUTSTR
  0C0E'   3A 0C6D'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0C11'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0C14'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0C18'   39 3B 39 39           
  0C1C'   39 48                 
  0C1E'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0C22'   00                    
  0C23'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0C27'   1B 5B 4D 00           SDL:	DB	ESC,'[','M',0		; DL -- delete line (scroll region up 1)
  0C2B'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0C2E'   1B 4D 00              SRI:	DB	ESC,'M',0		; RI -- reverse index (scroll region down 1)
  0C31'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0C35'   00                    
  0C36'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0C3A'   00                    
  0C3B'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0C3F'   35 6C 00              
  0C42'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0C46'   35 68 00              
  0C49'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0C4D'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0C51'   4E 53 45 52           
  0C55'   54 20 2D 2D           
  0C59'   00                    
  0C5A'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0C5E'   45 50 4C 41           
  0C62'   43 45 20 2D           
  0C66'   2D 00                 
  0C68'   00                    SNULL:	DB	0
  0C69'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0C6D'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0C6E'   50                    NCOLS:	DB	80		; runtime columns
  0C6F'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
  0C70'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0C72'   0000                  OLDWR:	DW	0		; WINROW as displayed before this frame
  0C74'   00                    WRAPF:	DB	0		; this frame: 0, 1 = a line wraps, WR_EOL and up =
                                				;   ... and the cursor has a row to itself
  0C75'   00                    OLDWF:	DB	0		; WRAPF as displayed before this frame
  0C76'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  0C78'   0000                  OLDSK:	DW	0		; SKIPR as displayed before this frame
  0C7A'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  0C7B'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0C7D'   00                    FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
  0C7E'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0C7F'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0C80'   01                    TXEND:	DB	1		; the first row with no text on it
  0C81'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0C82'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0C83'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0C84'   00                    WFILL:	DB	0		; one layout: 1 = the command placed the cursor's
                                				;   line (WINROW), WF_MID = put it mid-screen
  0C85'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0C86'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0C88'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
