                                ; DATA
                                ;============================================================
  0846'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0847'   50                    NCOLS:	DB	80		; runtime columns
  0848'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
  0849'   0000                  WINROW: DW	0		; cursor line's screen row, 0-based (WM WINROW)
  084B'   0000                  HSCROL: DW	0		; 0-based first visible display column (h-pan)
