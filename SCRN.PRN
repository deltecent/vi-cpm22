  0871'   90                    	SUB	B
  0872'   DA 08E9'              	JC	LT_NO
  0875'   4F                    	MOV	C,A		; C = the lines the top is under the table's first
  0876'   2A 0000*              	LHLD	TXTBEG		; ... if that line is in memory still: HTBLD
  0879'   EB                    	XCHG			;   pins a screenful back from the cursor and
  087A'   2A 0000*              	LHLD	GAPBEG		;   no more, and reading down for the lines
  087D'   CD 0000*              	CALL	SUBHD		;   under it may have paged the rest out
  0880'   EB                    	XCHG
  0881'   2A 1041'              	LHLD	HTTOPC
  0884'   CD 0000*              	CALL	CMP16		; CY iff fewer bytes are there than it is back
  0887'   DA 08E9'              	JC	LT_NO
  088A'   CD 0BB5'              	CALL	G2P
  088D'   EB                    	XCHG
  088E'   2A 0000*              	LHLD	GAPBEG
  0891'   EB                    	XCHG			; HL = the table's first line, DE = the gap
  0892'   0C                    	INR	C
  0893'   C3 08D3'              	JMP	LT_2
  0896'                         LT_0:
  0896'   7D                    	MOV	A,L
  0897'   B7                    	ORA	A
  0898'   C2 08A1'              	JNZ	LT_1
  089B'   2A 104D'              	LHLD	CBOL
  089E'   C3 0BB5'              	JMP	G2P
  08A1'                         LT_1:
  08A1'   E5                    	PUSH	H
