  0991'   3D                    	DCR	A
  0992'   CD 09A4'              	CALL	HTE
  0995'   7E                    	MOV	A,M
  0996'   CD 09AC'              	CALL	LM_ADD
  0999'   D8                    	RC
  099A'   21 0E4E'              	LXI	H,LYMAB
  099D'   86                    	ADD	M
  099E'   77                    	MOV	M,A
  099F'   21 0E47'              	LXI	H,LYROW
  09A2'   34                    	INR	M
  09A3'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
