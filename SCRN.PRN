	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the RINTENT fast paths
                                ; (cursor-only, region scroll up/down, one-row redraw, ICH insert, DL line
                                ; delete), the RPOLL repaint abort, and the message row.  The region scrolls
                                ; take their line count from SCRLN, the number of lines the text moved up this
                                ; frame.  Every fast path but the cursor-only one takes a line to be a row, so
                                ; none is used while a wrapped line is on the screen (WRAPF).
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
  0002                          WR_EOL	EQU	2		; WRAPF from here up: the cursor has a row to itself
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0B7D'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0B8B'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0B65'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PTROW -- paint the line at row PROWN and step to the row under it: clear the
                                ; row, write the line (on as many rows as it takes), CR/LF (the last LF of a
                                ; full repaint lands on the message row, and a backward scroll's N <= NEDIT-1
                                ; keeps it inside the region), and count the row off.  Both paint loops are
                                ; this, once each.  When the cursor has a row to itself (WR_EOL) that row is
                                ; the one under its line's text, and is cleared and counted here as well.
  0098'                         PTROW:
  0098'   CD 0092'              	CALL	CEKL		; ESC[K -- clear the row
  009B'   CD 0A90'              	CALL	PAINTR
  009E'   CD 00B3'              	CALL	PT_NL
  00A1'   3A 0BB6'              	LDA	WRAPF
  00A4'   FE 02                 	CPI	WR_EOL
  00A6'   D8                    	RC
  00A7'   3A 0BF9'              	LDA	SROW
  00AA'   3D                    	DCR	A
  00AB'   21 0BF1'              	LXI	H,PROWN
  00AE'   BE                    	CMP	M
  00AF'   C0                    	RNZ
  00B0'   CD 0092'              	CALL	CEKL
  00B3'                         PT_NL:
  00B3'   3E 0D                 	MVI	A,CR
  00B5'   CD 0018'              	CALL	OUTCH
  00B8'   3E 0A                 	MVI	A,LF
  00BA'   CD 0018'              	CALL	OUTCH
  00BD'   21 0BF1'              	LXI	H,PROWN
  00C0'   34                    	INR	M
  00C1'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C2'                         GOTOP:
  00C2'   06 01                 	MVI	B,1
  00C4'   0E 01                 	MVI	C,1
  00C6'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  00C9'                         SCINIT:
  00C9'   21 0000               	LXI	H,0
  00CC'   22 0BB2'              	SHLD	WINROW
  00CF'   21 0B56'              	LXI	H,SPROBE
  00D2'   CD 0025'              	CALL	OUTSTR
  00D5'   CD 0120'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  00D8'   3A 0BAF'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  00DB'   3D                    	DCR	A
  00DC'   32 0BB1'              	STA	NEDIT
  00DF'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  00E0'                         RDB:
  00E0'   21 0000               	LXI	H,0
  00E3'                         RDB_LP:
  00E3'   E5                    	PUSH	H
  00E4'   CD 0000'              	CALL	BCONST
  00E7'   E1                    	POP	H
  00E8'   B7                    	ORA	A
  00E9'   C2 00F4'              	JNZ	RDB_GO
  00EC'   2B                    	DCX	H
  00ED'   7C                    	MOV	A,H
  00EE'   B5                    	ORA	L
  00EF'   C2 00E3'              	JNZ	RDB_LP
  00F2'   37                    	STC			; timeout
  00F3'   C9                    	RET
  00F4'                         RDB_GO:
  00F4'   CD 0008'              	CALL	BCONIN
  00F7'   B7                    	ORA	A		; CY=0, A=byte
  00F8'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  00F9'                         RDNUM:
  00F9'   11 0000               	LXI	D,0
  00FC'                         RN_LP:
  00FC'   D5                    	PUSH	D
  00FD'   CD 00E0'              	CALL	RDB
  0100'   D1                    	POP	D
  0101'   D8                    	RC
  0102'   FE 30                 	CPI	'0'
  0104'   DA 011E'              	JC	RN_DN
  0107'   FE 3A                 	CPI	'9'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0109'   D2 011E'              	JNC	RN_DN
  010C'   D6 30                 	SUI	'0'
  010E'   4F                    	MOV	C,A		; C = this digit
  010F'   62                    	MOV	H,D		; HL = value
  0110'   6B                    	MOV	L,E
  0111'   29                    	DAD	H		; 2x
  0112'   54                    	MOV	D,H
  0113'   5D                    	MOV	E,L		; DE = 2x
  0114'   29                    	DAD	H		; 4x
  0115'   29                    	DAD	H		; 8x
  0116'   19                    	DAD	D		; 10x
  0117'   06 00                 	MVI	B,0		; BC = digit
  0119'   09                    	DAD	B		; HL = 10x + digit
  011A'   EB                    	XCHG			; DE = new value
  011B'   C3 00FC'              	JMP	RN_LP
  011E'                         RN_DN:
  011E'   B7                    	ORA	A		; CY=0, A = terminator
  011F'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0120'                         RDNUMS:
  0120'   CD 00E0'              	CALL	RDB
  0123'   D8                    	RC
  0124'   FE 1B                 	CPI	ESC
  0126'   C0                    	RNZ			; not what a DSR reply looks like
  0127'   CD 00E0'              	CALL	RDB
  012A'   D8                    	RC
  012B'   FE 5B                 	CPI	'['
  012D'   C0                    	RNZ			; not what a DSR reply looks like
  012E'   CD 00F9'              	CALL	RDNUM		; DE = rows
  0131'   D8                    	RC
  0132'   FE 3B                 	CPI	';'
  0134'   C0                    	RNZ			; not what a DSR reply looks like
  0135'   EB                    	XCHG
  0136'   22 0BFB'              	SHLD	TMPR
  0139'   CD 00F9'              	CALL	RDNUM		; DE = cols
  013C'   D8                    	RC
  013D'   FE 52                 	CPI	'R'
  013F'   C0                    	RNZ			; not what a DSR reply looks like
  0140'   EB                    	XCHG
  0141'   22 0BFD'              	SHLD	TMPC
  0144'   2A 0BFB'              	LHLD	TMPR		; rows -> clamp [24,200]
  0147'   06 18                 	MVI	B,24
  0149'   0E C8                 	MVI	C,200
  014B'   CD 015F'              	CALL	CLAMP
  014E'   32 0BAF'              	STA	NROWS
  0151'   2A 0BFD'              	LHLD	TMPC		; cols -> clamp [80,132]
  0154'   06 50                 	MVI	B,80
  0156'   0E 84                 	MVI	C,132
  0158'   CD 015F'              	CALL	CLAMP
  015B'   32 0BB0'              	STA	NCOLS
  015E'                         RS_BAD:
  015E'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  015F'                         CLAMP:
  015F'   7C                    	MOV	A,H
  0160'   B7                    	ORA	A
  0161'   C2 0172'              	JNZ	CLP_MAX		; value > 255 -> max
  0164'   7D                    	MOV	A,L
  0165'   B8                    	CMP	B
  0166'   DA 0170'              	JC	CLP_MIN		; value < min
  0169'   79                    	MOV	A,C
  016A'   BD                    	CMP	L		; CY iff max < value
  016B'   DA 0172'              	JC	CLP_MAX
  016E'   7D                    	MOV	A,L
  016F'   C9                    	RET
  0170'                         CLP_MIN:
  0170'   78                    	MOV	A,B
  0171'   C9                    	RET
  0172'                         CLP_MAX:
  0172'   79                    	MOV	A,C
  0173'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- snapshot what is on the screen (WINROW/WRAPF) into OLDWR/OLDWF.  The
                                ; main loop calls this after reading a key and before dispatch, so SCDRAW can
                                ; tell how far the text moved (SCRLN) and whether a line was wrapped.
  0174'                         SCPRE:
  0174'   2A 0BB2'              	LHLD	WINROW
  0177'   22 0BB4'              	SHLD	OLDWR
  017A'   3A 0BB6'              	LDA	WRAPF
  017D'   32 0BB7'              	STA	OLDWF
  0180'   2A 0BB8'              	LHLD	SKIPR
  0183'   22 0BBA'              	SHLD	OLDSK
  0186'   C9                    	RET
                                
  0187'                         SCDRAW:
  0187'   CD 04EE'              	CALL	LAYOUT		; WINROW/SCRLN/SCBOT/CURDCL/WRAPF (no output)
  018A'   CD 04A1'              	CALL	CURSC		; SROW/SCOL
  018D'   3A 0BBF'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  0190'   B7                    	ORA	A
  0191'   C2 0285'              	JNZ	SCFULL
  0194'   2A 0BBA'              	LHLD	OLDSK		; the top line starts on another of its rows:
  0197'   EB                    	XCHG			;   every row on the screen is a different one
  0198'   2A 0BB8'              	LHLD	SKIPR
  019B'   CD 0000*              	CALL	CMP16
  019E'   C2 0285'              	JNZ	SCFULL
  01A1'   3A 0BB6'              	LDA	WRAPF		; the wrapping on this screen, or on the last
  01A4'   21 0BB7'              	LXI	H,OLDWF
  01A7'   B6                    	ORA	M
  01A8'   47                    	MOV	B,A
  01A9'   FE 02                 	CPI	WR_EOL		; a row only the cursor holds came or went: the
  01AB'   D2 0285'              	JNC	SCFULL		;   lines under it moved, whatever the key was
  01AE'   3A 0000*              	LDA	RINTENT
  01B1'   FE 01                 	CPI	R_MOVE
  01B3'   C2 01BE'              	JNZ	SC_WR
  01B6'   2A 0BBD'              	LHLD	SCRLN
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B9'   7C                    	MOV	A,H
  01BA'   B5                    	ORA	L
  01BB'   CA 0B36'              	JZ	SCURS		; text still -> cursor only, wrapped or not
  01BE'                         SC_WR:
  01BE'   78                    	MOV	A,B		; every paint from here on takes a line to be a
  01BF'   B7                    	ORA	A		;   row: a wrapped one on the screen -> repaint
  01C0'   C2 0285'              	JNZ	SCFULL
  01C3'   3A 0000*              	LDA	RINTENT
  01C6'   FE 01                 	CPI	R_MOVE
  01C8'   CA 020E'              	JZ	SC_MV
  01CB'   FE 02                 	CPI	R_LINE
  01CD'   CA 01E4'              	JZ	SC_ED
  01D0'   FE 04                 	CPI	R_ICH
  01D2'   CA 01E4'              	JZ	SC_ED
  01D5'   FE 05                 	CPI	R_ILIN
  01D7'   CA 03DC'              	JZ	SC_ILQ		; (its own test: it moves the cursor's row, and
  01DA'   FE 03                 	CPI	R_DLIN		;   on the bottom row it scrolls the text too)
  01DC'   CA 01E4'              	JZ	SC_ED
  01DF'   FE 06                 	CPI	R_JOIN
  01E1'   C2 0285'              	JNZ	SCFULL		; anything else -> full repaint
  01E4'                         SC_ED:
                                	;--- the in-place edit paints need the text to have stayed put ---
  01E4'   2A 0BBD'              	LHLD	SCRLN
  01E7'   7C                    	MOV	A,H
  01E8'   B5                    	ORA	L
  01E9'   C2 0285'              	JNZ	SCFULL
  01EC'   2A 0BB4'              	LHLD	OLDWR
  01EF'   EB                    	XCHG
  01F0'   2A 0BB2'              	LHLD	WINROW
  01F3'   CD 0000*              	CALL	CMP16		; Z iff the cursor kept its row
  01F6'   C2 0285'              	JNZ	SCFULL
  01F9'   3A 0000*              	LDA	RINTENT
  01FC'   FE 02                 	CPI	R_LINE
  01FE'   CA 0273'              	JZ	SC_LNBD
  0201'   FE 04                 	CPI	R_ICH
  0203'   CA 0235'              	JZ	SC_ICH
  0206'   FE 06                 	CPI	R_JOIN
  0208'   CA 0384'              	JZ	SC_JN
  020B'   C3 03AB'              	JMP	SCDL
  020E'                         SC_MV:
                                	;--- R_MOVE: the text moved up SCRLN lines (down if negative) ---
  020E'   2A 0BBD'              	LHLD	SCRLN
  0211'   7C                    	MOV	A,H
  0212'   B7                    	ORA	A
  0213'   F2 0229'              	JP	SC_FWD
  0216'   EB                    	XCHG
  0217'   21 0000               	LXI	H,0
  021A'   CD 0000*              	CALL	SUBHD		; HL = -SCRLN
  021D'   CD 0477'              	CALL	SCRNOK		; A = N (CY=0) if 1..NEDIT-1, else CY=1
  0220'   DA 0285'              	JC	SCFULL
  0223'   32 0BF2'              	STA	SCLN
  0226'   C3 033D'              	JMP	SCBWD
  0229'                         SC_FWD:
  0229'   CD 0477'              	CALL	SCRNOK
  022C'   DA 0285'              	JC	SCFULL
  022F'   32 0BF2'              	STA	SCLN		; N in 1..NEDIT-1 -> region scroll
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  0232'   C3 02F6'              	JMP	SCFWD
  0235'                         SC_ICH:
                                	;--- the inserted char sits at screen column SCOL-1; it must be a real
                                	;    on-screen cell (SCOL >= 2), else fall back to the whole-line redraw ---
  0235'   3A 0BFA'              	LDA	SCOL
  0238'   FE 02                 	CPI	2
  023A'   DA 0273'              	JC	SC_LNBD
                                	;--- appended at the row's end (ICHAPP): the cell is blank and nothing
                                	;    follows it, so the char alone is the whole frame -- no ICH to open a
                                	;    cell for it, and no hide/show, there being nothing to see happen
                                	;    between the address and the byte.  The terminal leaves the cursor at
                                	;    SCOL, where insert mode wants it, exactly as the ICH path does. ---
  023D'   3A 0000*              	LDA	ICHAPP
  0240'   B7                    	ORA	A
  0241'   C2 0259'              	JNZ	SC_ICA
  0244'   CD 0080'              	CALL	CHIDE
  0247'   CD 025F'              	CALL	SC_ICG		; address the inserted char's cell (SROW, SCOL-1)
  024A'   21 0B73'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  024D'   CD 0025'              	CALL	OUTSTR
  0250'   CD 026B'              	CALL	SC_ICC		; fills the opened cell; cursor advances to SCOL
  0253'   21 0B84'              	LXI	H,SSHOW
  0256'   C3 0025'              	JMP	OUTSTR
  0259'                         SC_ICA:
  0259'   CD 025F'              	CALL	SC_ICG
  025C'   C3 026B'              	JMP	SC_ICC
                                ;SC_ICG -- address the inserted char's cell, (SROW, SCOL-1).
  025F'                         SC_ICG:
  025F'   3A 0BF9'              	LDA	SROW
  0262'   47                    	MOV	B,A
  0263'   3A 0BFA'              	LDA	SCOL
  0266'   3D                    	DCR	A
  0267'   4F                    	MOV	C,A
  0268'   C3 0064'              	JMP	GOTOXY
                                ;SC_ICC -- emit the just-inserted byte, which is right before the gap.
  026B'                         SC_ICC:
  026B'   2A 0000*              	LHLD	GAPBEG
  026E'   2B                    	DCX	H
  026F'   7E                    	MOV	A,M
  0270'   C3 0018'              	JMP	OUTCH
  0273'                         SC_LNBD:
                                	;--- R_LINE: redraw only the cursor's row (tabs re-expanded), then
                                	;    re-address and show the cursor ---
  0273'   CD 0080'              	CALL	CHIDE
  0276'   3A 0BF9'              	LDA	SROW
  0279'   CD 008C'              	CALL	GOROW1		; column 1 of the current row, cleared
  027C'   CD 09D8'              	CALL	RDBOL		; read from the cursor line's first byte
  027F'   CD 0AA0'              	CALL	PROW
  0282'   C3 0B36'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place (home + CR,LF stepping), each
                                ; cleared with ESC[K; a line takes as many rows as it is wide, and the rows
                                ; past the text show '~' (or '@').  No ESC[2J (no blank flash).
                                ; Message row last; cursor hidden throughout, then addressed and shown.
  0285'                         SCFULL:
  0285'   CD 0080'              	CALL	CHIDE
  0288'   CD 09D2'              	CALL	RDTOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  028B'   CD 00C2'              	CALL	GOTOP		; home to row 1
  028E'   AF                    	XRA	A
  028F'   32 0BF1'              	STA	PROWN
  0292'   2A 0BB8'              	LHLD	SKIPR		; a line taller than the screen: from the row of
  0295'   22 0BF3'              	SHLD	PSKN		;   it that keeps the cursor on the screen
  0298'                         ROW_LP:
  0298'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abort this repaint
  029B'   B7                    	ORA	A
  029C'   C2 04E8'              	JNZ	SCABRT
  029F'   3A 0BB1'              	LDA	NEDIT
  02A2'   47                    	MOV	B,A
  02A3'   3A 0BF1'              	LDA	PROWN
  02A6'   B8                    	CMP	B
  02A7'   D2 02B0'              	JNC	ROWS_DN
  02AA'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  02AD'   C3 0298'              	JMP	ROW_LP
  02B0'                         ROWS_DN:
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  02B0'   CD 0092'              	CALL	CEKL
  02B3'   2A 0BB8'              	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
  02B6'   7C                    	MOV	A,H		;   over its first cells says so, as vim's does
  02B7'   B5                    	ORA	L
  02B8'   CA 02C4'              	JZ	ROWS_M
  02BB'   CD 00C2'              	CALL	GOTOP
  02BE'   21 0BAB'              	LXI	H,SSKIP
  02C1'   CD 0025'              	CALL	OUTSTR
  02C4'                         ROWS_M:
  02C4'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  02C6'   32 0BC0'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  02C9'   CD 0B36'              	CALL	SCURS
  02CC'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  02CD'   32 0BBF'              	STA	FORCEF
  02D0'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  02D1'                         EXPRM:
  02D1'   F5                    	PUSH	PSW
  02D2'   3A 0000*              	LDA	EDMODE
  02D5'   32 0BC0'              	STA	OEDMOD
  02D8'   3A 0BAF'              	LDA	NROWS
  02DB'   CD 008C'              	CALL	GOROW1
  02DE'   F1                    	POP	PSW
  02DF'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  02E2'                         EXRUB:
  02E2'   21 02E8'              	LXI	H,SRUB
  02E5'   C3 0025'              	JMP	OUTSTR
  02E8'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02EC'                         EXMSG:
  02EC'   7E                    	MOV	A,M
  02ED'   23                    	INX	H
  02EE'   E5                    	PUSH	H
  02EF'   CD 02D1'              	CALL	EXPRM
  02F2'   E1                    	POP	H
  02F3'   C3 0025'              	JMP	OUTSTR
                                
                                ;SCFWD -- the text moved up N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows (message row protected), then N times:
                                ; delete the top region row (ESC[M) -- the terminal scrolls the region up one
                                ; line -- and draw the newly exposed row into row NEDIT.  Only the N exposed
                                ; rows (NEDIT-N .. NEDIT-1) are drawn; the overlap the terminal shifted is never
                                ; re-sent.  Short and bounded, so it runs to completion (no RPOLL abort).
  02F6'                         SCFWD:
  02F6'   CD 0080'              	CALL	CHIDE
  02F9'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  02FC'   CD 09D2'              	CALL	RDTOP
  02FF'   3A 0BF2'              	LDA	SCLN
  0302'   47                    	MOV	B,A
  0303'   3A 0BB1'              	LDA	NEDIT
  0306'   90                    	SUB	B		; A = NEDIT - N = first exposed row
  0307'   32 0BF1'              	STA	PROWN
  030A'   CD 0A30'              	CALL	RDSKIP		; reader at that row's line
  030D'                         SFW_LP:
  030D'   3A 0BF2'              	LDA	SCLN
  0310'   B7                    	ORA	A
  0311'   CA 0337'              	JZ	SFW_DN
  0314'   CD 00C2'              	CALL	GOTOP		; region top row
  0317'   21 0B69'              	LXI	H,SDL		; ESC[M (DL) at the top: region scrolls up 1
  031A'   CD 0025'              	CALL	OUTSTR
  031D'   3A 0BB1'              	LDA	NEDIT		; draw the exposed row into the bottom edit row
  0320'   CD 008C'              	CALL	GOROW1		; ... addressed and cleared
  0323'   CD 0A90'              	CALL	PAINTR
  0326'   3A 0BF1'              	LDA	PROWN
  0329'   3C                    	INR	A
  032A'   32 0BF1'              	STA	PROWN
  032D'   3A 0BF2'              	LDA	SCLN
  0330'   3D                    	DCR	A
  0331'   32 0BF2'              	STA	SCLN
  0334'   C3 030D'              	JMP	SFW_LP
  0337'                         SFW_DN:
  0337'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  033A'   C3 0B36'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCBWD -- the text moved down N rows (SCLN, 1..NEDIT-1), no line wrapped.
                                ; Clamp the scroll region to the edit rows, Reverse-Index (ESC M) N times at the
                                ; region top -- the terminal scrolls the region down, opening N blank rows at
                                ; the top -- then draw rows 0..N-1 from the top line down.
  033D'                         SCBWD:
  033D'   CD 0080'              	CALL	CHIDE
  0340'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0343'   3A 0BF2'              	LDA	SCLN
  0346'   32 0BF7'              	STA	ROWCT
  0349'                         SBW_RI:
  0349'   3A 0BF7'              	LDA	ROWCT
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  034C'   B7                    	ORA	A
  034D'   CA 0363'              	JZ	SBW_PT
  0350'   CD 00C2'              	CALL	GOTOP		; region top row
  0353'   21 0B70'              	LXI	H,SRI		; ESC M (RI) at the top: region scrolls down 1
  0356'   CD 0025'              	CALL	OUTSTR
  0359'   3A 0BF7'              	LDA	ROWCT
  035C'   3D                    	DCR	A
  035D'   32 0BF7'              	STA	ROWCT
  0360'   C3 0349'              	JMP	SBW_RI
  0363'                         SBW_PT:
  0363'   CD 09D2'              	CALL	RDTOP
  0366'   AF                    	XRA	A
  0367'   32 0BF1'              	STA	PROWN
  036A'   CD 00C2'              	CALL	GOTOP
  036D'                         SBW_LP:
  036D'   3A 0BF2'              	LDA	SCLN
  0370'   47                    	MOV	B,A
  0371'   3A 0BF1'              	LDA	PROWN
  0374'   B8                    	CMP	B
  0375'   D2 037E'              	JNC	SBW_DN
  0378'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  037B'   C3 036D'              	JMP	SBW_LP
  037E'                         SBW_DN:
  037E'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0381'   C3 0B36'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCDL -- R_DLIN: a single line was deleted at the cursor's row (dd, not the last
                                ; line).  Delete that screen row (ESC[M at SROW, region-clamped so the message row
                                ; is safe) -- the rows below shift up and a blank opens at row NEDIT -- then draw
                                ; the bottom row and re-address the cursor (which kept
                                ; its row, now at the BOL of the line that shifted up).
                                ;SC_JN -- R_JOIN: the line below was joined onto the cursor's.  That row now
                                ; holds both, and the row under it is gone -- so redraw the cursor's row, then
                                ; hand the rest to SCDL, which deletes a row and draws the one the shift
                                ; exposes at the bottom.  With the cursor on the LAST edit row there is no row
                                ; under it on the screen at all: the join took a line that was never shown, and
                                ; only the cursor's own row is stale (vim redraws just that row there too).
  0384'                         SC_JN:
  0384'   3A 0BF9'              	LDA	SROW
  0387'   47                    	MOV	B,A
  0388'   3A 0BB1'              	LDA	NEDIT
  038B'   B8                    	CMP	B		; CY iff NEDIT < SROW; Z iff the bottom edit row
  038C'   CA 0273'              	JZ	SC_LNBD
  038F'   DA 0273'              	JC	SC_LNBD
  0392'   CD 0080'              	CALL	CHIDE
  0395'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0398'   3A 0BF9'              	LDA	SROW		; the joined line, redrawn where it stands
  039B'   CD 008C'              	CALL	GOROW1
  039E'   CD 09D8'              	CALL	RDBOL
  03A1'   CD 0AA0'              	CALL	PROW
  03A4'   3A 0BF9'              	LDA	SROW
  03A7'   3C                    	INR	A		; ... and the row under it goes
  03A8'   C3 03B4'              	JMP	SCDL2
                                
  03AB'                         SCDL:
  03AB'   CD 0080'              	CALL	CHIDE
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  03AE'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03B1'   3A 0BF9'              	LDA	SROW		; delete the cursor's row
  03B4'                         SCDL2:
  03B4'   47                    	MOV	B,A
  03B5'   0E 01                 	MVI	C,1
  03B7'   CD 0064'              	CALL	GOTOXY
  03BA'   21 0B69'              	LXI	H,SDL		; ESC[M (DL): rows below shift up, blank at NEDIT
  03BD'   CD 0025'              	CALL	OUTSTR
  03C0'   CD 09D2'              	CALL	RDTOP
  03C3'   3A 0BB1'              	LDA	NEDIT
  03C6'   3D                    	DCR	A
  03C7'   32 0BF1'              	STA	PROWN		; the bottom row
  03CA'   CD 0A30'              	CALL	RDSKIP
  03CD'   3A 0BB1'              	LDA	NEDIT
  03D0'   CD 008C'              	CALL	GOROW1		; bottom edit row, cleared
  03D3'   CD 0A90'              	CALL	PAINTR
  03D6'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  03D9'   C3 0B36'              	JMP	SCURS
                                
                                ;SC_IL -- R_ILIN: one line was opened at the cursor's row.  Open a row there
                                ; (ESC[L, region-clamped so the message row is safe) -- the rows below shift
                                ; down and the bottom one falls out of the region -- then draw the cursor's row
                                ; and the one above it: a <CR> (and 'r<CR>') split that one, 'o' and 'O' leave
                                ; it as it was.  Everything else on the screen is already right where it is.
                                ;SC_ILQ -- which of the two forms this is.  A line that opened ON the screen
                                ; leaves the text where it stands (SCRLN = 0); one opened on the bottom row
                                ; has nowhere to put itself, so the screen scrolls up a row to make room
                                ; (SCRLN = 1) -- vim does the same, and it is what every <CR> does once you
                                ; are typing at the end of a file.  Both then draw the same two rows.
  03DC'                         SC_ILQ:
  03DC'   2A 0BBD'              	LHLD	SCRLN
  03DF'   7C                    	MOV	A,H
  03E0'   B5                    	ORA	L
  03E1'   CA 0404'              	JZ	SC_IL		; the text stood still
  03E4'   2B                    	DCX	H
  03E5'   7C                    	MOV	A,H
  03E6'   B5                    	ORA	L
  03E7'   C2 0285'              	JNZ	SCFULL		; moved by more than a row: not ours
  03EA'   3A 0000*              	LDA	ILN		; and only ONE line can open into one scroll --
  03ED'   FE 01                 	CPI	1		;   a put of several at the bottom needs as many
  03EF'   C2 0285'              	JNZ	SCFULL		;   scrolls as it has lines, which is a repaint
  03F2'   CD 0080'              	CALL	CHIDE
  03F5'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03F8'   CD 00C2'              	CALL	GOTOP
  03FB'   21 0B69'              	LXI	H,SDL		; ESC[M at the top: the region scrolls up one,
  03FE'   CD 0025'              	CALL	OUTSTR		;   opening the bottom row for the new line
  0401'   C3 0424'              	JMP	SC_ILT
                                
  0404'                         SC_IL:
  0404'   CD 0080'              	CALL	CHIDE
  0407'   CD 0490'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  040A'   3A 0BF9'              	LDA	SROW
  040D'   47                    	MOV	B,A
  040E'   0E 01                 	MVI	C,1
  0410'   CD 0064'              	CALL	GOTOXY
  0413'   21 0B6D'              	LXI	H,SCSI		; ESC[<ILN>L (IL): ILN blank rows here, the rest
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0416'   CD 0025'              	CALL	OUTSTR		;   shift down, and what falls past the region's
  0419'   3A 0000*              	LDA	ILN		;   bottom row has scrolled off, which is right
  041C'   CD 002F'              	CALL	EMITB
  041F'   3E 4C                 	MVI	A,'L'
  0421'   CD 0018'              	CALL	OUTCH
  0424'                         SC_ILT:
                                	;--- the first row to draw.  IL opened ILN rows AT the cursor's row and
                                	;    everything above it stands, so the cursor's own row (0-based SROW-1)
                                	;    is where the drawing starts -- 'o', 'O' and a put leave the line
                                	;    above untouched.  ILABOV says the edit took text off that line (a
                                	;    mid-line <CR>, 'r<CR>'), and then it is drawn too. ---
  0424'   3A 0BF9'              	LDA	SROW
  0427'   3D                    	DCR	A		; B = the cursor's own row, the first opened one
  0428'   47                    	MOV	B,A
  0429'   3A 0000*              	LDA	ILABOV
  042C'   B7                    	ORA	A
  042D'   78                    	MOV	A,B
  042E'   CA 0432'              	JZ	SC_IL0
  0431'   3D                    	DCR	A		; the row above the cursor's, when it is stale
  0432'                         SC_IL0:
  0432'   B7                    	ORA	A		; ... clamped: the cursor may be on the top row
  0433'   F2 0437'              	JP	SC_IL1
  0436'   AF                    	XRA	A
  0437'                         SC_IL1:
  0437'   32 0BF1'              	STA	PROWN
  043A'   78                    	MOV	A,B		; the last row to draw: the opened ones start at
  043B'   21 0000*              	LXI	H,ILN		;   the cursor's row and there are ILN of them
  043E'   86                    	ADD	M
  043F'   3D                    	DCR	A
  0440'   47                    	MOV	B,A
  0441'   3A 0BB1'              	LDA	NEDIT
  0444'   3D                    	DCR	A		; ... but never past the bottom edit row, which
  0445'   B8                    	CMP	B		;   is as far as the opened rows can be seen
  0446'   DA 044A'              	JC	SC_IL2
  0449'   78                    	MOV	A,B
  044A'                         SC_IL2:
  044A'   32 0BF8'              	STA	ILLAST
  044D'   CD 09D2'              	CALL	RDTOP
  0450'   3A 0BF1'              	LDA	PROWN
  0453'   CD 0A30'              	CALL	RDSKIP		; the reader at that row's line
  0456'                         SC_ILL:
  0456'   CD 046D'              	CALL	SC_ILR
  0459'   3A 0BF8'              	LDA	ILLAST
  045C'   21 0BF1'              	LXI	H,PROWN
  045F'   BE                    	CMP	M
  0460'   CA 0467'              	JZ	SC_ILD
  0463'   34                    	INR	M
  0464'   C3 0456'              	JMP	SC_ILL
  0467'                         SC_ILD:
  0467'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  046A'   C3 0B36'              	JMP	SCURS		; the cursor back on the text, and shown
                                
                                ;SC_ILR -- draw screen row PROWN from where the reader stands, cleared first.
  046D'                         SC_ILR:
  046D'   3A 0BF1'              	LDA	PROWN
  0470'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0471'   CD 008C'              	CALL	GOROW1
  0474'   C3 0A90'              	JMP	PAINTR
                                
                                ;SCRNOK -- HL = candidate scroll count N.  Return A=N with CY=0 if N is in
                                ; 1..NEDIT-1 (there is on-screen overlap worth preserving); else CY=1 so the
                                ; caller full-repaints.  Clobbers A,B.
  0477'                         SCRNOK:
  0477'   7C                    	MOV	A,H
  0478'   B7                    	ORA	A
  0479'   C2 048E'              	JNZ	SRN_NO		; N >= 256
  047C'   7D                    	MOV	A,L
  047D'   B7                    	ORA	A
  047E'   CA 048E'              	JZ	SRN_NO		; N == 0
  0481'   47                    	MOV	B,A		; B = N
  0482'   3A 0BB1'              	LDA	NEDIT
  0485'   B8                    	CMP	B		; CY iff NEDIT < N ; Z iff NEDIT == N
  0486'   DA 048E'              	JC	SRN_NO		; N > NEDIT
  0489'   CA 048E'              	JZ	SRN_NO		; N == NEDIT -> no overlap
  048C'   78                    	MOV	A,B		; A = N, CY=0 (from CMP: NEDIT > N)
  048D'   C9                    	RET
  048E'                         SRN_NO:
  048E'   37                    	STC
  048F'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  0490'                         SRGN:
  0490'   21 0B78'              	LXI	H,SRGP
  0493'   CD 0025'              	CALL	OUTSTR
  0496'   3A 0BB1'              	LDA	NEDIT
  0499'   CD 002F'              	CALL	EMITB
  049C'   3E 72                 	MVI	A,'r'
  049E'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  04A1'                         CURSC:
  04A1'   2A 0BCC'              	LHLD	CURDCL
  04A4'   CD 04D3'              	CALL	DIVN		; BC = rows into the line, A = the column
  04A7'   3C                    	INR	A
  04A8'   32 0BFA'              	STA	SCOL
  04AB'   79                    	MOV	A,C
  04AC'   32 0BC7'              	STA	CSUB
  04AF'   2A 0BB8'              	LHLD	SKIPR
  04B2'   EB                    	XCHG
  04B3'   2A 0BCE'              	LHLD	LYABV
  04B6'   09                    	DAD	B
  04B7'   23                    	INX	H
  04B8'   CD 0000*              	CALL	SUBHD		; (less the rows of it that are off the top)
  04BB'   7C                    	MOV	A,H		; (never past the edit rows)
  04BC'   B7                    	ORA	A
  04BD'   3A 0BB1'              	LDA	NEDIT
  04C0'   C2 04C8'              	JNZ	CS_SET
  04C3'   BD                    	CMP	L		; CY iff NEDIT < the row
  04C4'   DA 04C8'              	JC	CS_SET
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  04C7'   7D                    	MOV	A,L
  04C8'                         CS_SET:
  04C8'   32 0BF9'              	STA	SROW
  04CB'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  04CC'                         XTRA:
  04CC'   01 0000               	LXI	B,0
  04CF'   7C                    	MOV	A,H
  04D0'   B5                    	ORA	L
  04D1'   C8                    	RZ			; an empty line is one row
  04D2'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  04D3'                         DIVN:
  04D3'   3A 0BB0'              	LDA	NCOLS
  04D6'   2F                    	CMA
  04D7'   5F                    	MOV	E,A
  04D8'   16 FF                 	MVI	D,0FFH
  04DA'   13                    	INX	D		; DE = -NCOLS
  04DB'   01 FFFF               	LXI	B,0FFFFH
  04DE'                         DV_LP:
  04DE'   03                    	INX	B
  04DF'   19                    	DAD	D		; CY while NCOLS still went into it
  04E0'   DA 04DE'              	JC	DV_LP
  04E3'   3A 0BB0'              	LDA	NCOLS
  04E6'   85                    	ADD	L
  04E7'   C9                    	RET
                                
                                ;SCABRT -- RPOLL abort: a key arrived mid-repaint.  Leave the cursor hidden (the
                                ; SHIDE at SCFULL's head still holds) and return WITHOUT positioning/showing it,
                                ; so no cursor flash during a type-ahead burst.  The pending key is dispatched
                                ; next, then SCDRAW runs again and (when the ring finally drains) paints in full
                                ; and shows the cursor -- the aborted frame is simply superseded.
                                ; FORCEF is latched so the next SCDRAW repaints in FULL even if the pending key
                                ; is a pure motion (RENDER.md: an aborted frame stays dirty -- the fast path must
                                ; not be taken over a half-painted screen).
  04E8'                         SCABRT:
  04E8'   3E 01                 	MVI	A,1
  04EA'   32 0BBF'              	STA	FORCEF
  04ED'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- where the cursor's line sits on the screen and what the screen
                                ; holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
                                ;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
                                ;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
                                ;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
                                ;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
                                ;        what they show), SCBOT, SCEOF, SCBOF, WRAPF, TALLF; the row table
                                ;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
                                ;        LNDLT and PLACE cleared.
                                ; The lines are measured once, into the row table (HTBLD): as many above the
                                ; cursor's as the placement could want, and a screenful of rows from it on.
                                ; Everything after that is arithmetic on the table: which line is the top one
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                ; (as many of the lines wanted above as leave the cursor's whole line room),
                                ; and how far down the text goes.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  04EE'                         LAYOUT:
  04EE'   2A 0000*              	LHLD	CMDCNT
  04F1'   22 0BE2'              	SHLD	SVCNT
  04F4'   2A 0000*              	LHLD	AUXCNT
  04F7'   22 0BE4'              	SHLD	SVAUX
  04FA'   3A 0000*              	LDA	DIRFLG
  04FD'   32 0BE6'              	STA	SVDIR
  0500'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  0503'   32 0BD2'              	STA	LYROW
  0506'   32 0BDE'              	STA	LYSVR
  0509'   AF                    	XRA	A
  050A'   32 0BDC'              	STA	LYND
  050D'   32 0BDD'              	STA	LYPRF
  0510'   3A 0BC6'              	LDA	PLACE		; a line the command placed stays where it was
  0513'   B7                    	ORA	A		;   put; one that only moved is asked about
  0514'   CC 07D8'              	CZ	LYFAR
  0517'   2A 0000*              	LHLD	LNDLT
  051A'   22 0BD0'              	SHLD	LYDLT
  051D'   7C                    	MOV	A,H
  051E'   B5                    	ORA	L
  051F'   21 0000               	LXI	H,0
  0522'   22 0000*              	SHLD	LNDLT
  0525'   47                    	MOV	B,A
  0526'   3A 0BC6'              	LDA	PLACE		; the cursor on another line, or its line put
  0529'   B0                    	ORA	B		;   somewhere by the command: a line starts with
  052A'   CA 0530'              	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
  052D'   22 0BB8'              	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
  0530'                         LY_SAM:
                                	;--- the lines to measure above the cursor's: those it has over it now,
                                	;    or all a screen could show when it is to be placed afresh (but no
                                	;    more than leaves the table room for the rows under it) ---
  0530'   3A 0BB1'              	LDA	NEDIT
  0533'   4F                    	MOV	C,A		; C = a screenful of rows from the cursor's line on
  0534'   3D                    	DCR	A
  0535'   47                    	MOV	B,A
  0536'   3E FE                 	MVI	A,254
  0538'   91                    	SUB	C
  0539'   B8                    	CMP	B
  053A'   D2 053E'              	JNC	LY_B1
  053D'   47                    	MOV	B,A
  053E'                         LY_B1:
  053E'   CD 064B'              	CALL	LYMQ
  0541'   CA 0548'              	JZ	LY_BLD
  0544'   3A 0BD2'              	LDA	LYROW
  0547'   47                    	MOV	B,A
  0548'                         LY_BLD:
  0548'   CD 0815'              	CALL	HTBLD
                                	;--- a line taller than the screen whose end is on it: the lines under
                                	;    that end, as far as the rows go ---
  054B'   3A 0BBC'              	LDA	TALLF
  054E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  054F'   CA 0564'              	JZ	LY_NT
  0552'   3A 0000*              	LDA	HTEOF
  0555'   B7                    	ORA	A
  0556'   C2 0564'              	JNZ	LY_NT
  0559'   3A 0BD3'              	LDA	LYTSH
  055C'   47                    	MOV	B,A
  055D'   3A 0BB1'              	LDA	NEDIT
  0560'   90                    	SUB	B
  0561'   CD 097B'              	CALL	HBMOR
  0564'                         LY_NT:
  0564'   CD 064B'              	CALL	LYMQ
  0567'   CC 06C5'              	CZ	LYMID		; LYROW = the lines that puts above it
  056A'   AF                    	XRA	A
  056B'   32 0BC6'              	STA	PLACE
                                	;--- of the LYROW lines wanted above, as many as leave the cursor's
                                	;    whole line room (and the table has: the file may start sooner) ---
  056E'   3A 0BD2'              	LDA	LYROW
  0571'   47                    	MOV	B,A
  0572'   CD 0711'              	CALL	LYINI
  0575'                         LY_FT:
  0575'   78                    	MOV	A,B
  0576'   B7                    	ORA	A
  0577'   CA 0583'              	JZ	LY_FD
  057A'   05                    	DCR	B
  057B'   C5                    	PUSH	B
  057C'   CD 0758'              	CALL	LMABV
  057F'   C1                    	POP	B
  0580'   D2 0575'              	JNC	LY_FT
  0583'                         LY_FD:
  0583'   3A 0BDA'              	LDA	LYMAB
  0586'   6F                    	MOV	L,A
  0587'   26 00                 	MVI	H,0
  0589'   22 0BCE'              	SHLD	LYABV
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  058C'   3A 0BD2'              	LDA	LYROW
  058F'   6F                    	MOV	L,A		; (H is 0 still)
  0590'   CD 0000*              	CALL	LINPSB		; HL = that line's start
  0593'   EB                    	XCHG
  0594'   2A 0000*              	LHLD	GAPBEG
  0597'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  059A'   22 0BC8'              	SHLD	TOPLEN
  059D'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  059E'   22 0000*              	SHLD	WRLIM
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  05A1'   AF                    	XRA	A
  05A2'   32 0BC5'              	STA	SCBOF
  05A5'   CD 07AA'              	CALL	LYTOPP		; HL = top
  05A8'   CD 06B7'              	CALL	ISBOF
  05AB'   C2 05B2'              	JNZ	LY_BW
  05AE'   3C                    	INR	A
  05AF'   32 0BC5'              	STA	SCBOF
  05B2'                         LY_BW:
                                	;--- down the table from the cursor's line: the lines under it that fit
                                	;    whole.  C = the rows taken, D = those lines. ---
  05B2'   3E 7E                 	MVI	A,'~'
  05B4'   32 0BC3'              	STA	FILCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  05B7'   AF                    	XRA	A
  05B8'   32 0BC4'              	STA	SCEOF
  05BB'   57                    	MOV	D,A
  05BC'   3A 0000*              	LDA	HTCUR
  05BF'   47                    	MOV	B,A
  05C0'   CD 0774'              	CALL	HTE		; HL -> the cursor line's entry
  05C3'   3A 0000*              	LDA	HTN
  05C6'   90                    	SUB	B
  05C7'   47                    	MOV	B,A		; B = the entries from it on
  05C8'   3A 0BDA'              	LDA	LYMAB
  05CB'   4F                    	MOV	C,A
  05CC'   3A 0BD3'              	LDA	LYTSH
  05CF'   81                    	ADD	C
  05D0'   4F                    	MOV	C,A
  05D1'                         LY_WK:
  05D1'   23                    	INX	H
  05D2'   05                    	DCR	B
  05D3'   CA 05F0'              	JZ	LY_WE
  05D6'   3A 0BB1'              	LDA	NEDIT
  05D9'   91                    	SUB	C		; A = the rows left
  05DA'   CA 05F6'              	JZ	LY_END		; none: what is under them is not cut off
  05DD'   BE                    	CMP	M		; CY iff the line takes more
  05DE'   DA 05E8'              	JC	LY_CUT
  05E1'   79                    	MOV	A,C
  05E2'   86                    	ADD	M
  05E3'   4F                    	MOV	C,A
  05E4'   14                    	INR	D
  05E5'   C3 05D1'              	JMP	LY_WK
  05E8'                         LY_CUT:
  05E8'   3E 40                 	MVI	A,'@'		; a line that does not fit is not shown, and the
  05EA'   32 0BC3'              	STA	FILCH		;   rows it would have started on say so
  05ED'   C3 05F6'              	JMP	LY_END
  05F0'                         LY_WE:
  05F0'   3A 0000*              	LDA	HTEOF		; the table ended: with the text, or with the rows
  05F3'   32 0BC4'              	STA	SCEOF
  05F6'                         LY_END:
  05F6'   79                    	MOV	A,C
  05F7'   32 0BC2'              	STA	TXEND		; the first row with no text on it
  05FA'   3A 0BD2'              	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
  05FD'   82                    	ADD	D
  05FE'   32 0BC1'              	STA	SCBOT
                                	;--- WRAPF: more rows of text than lines, or a line cut off ---
  0601'   3C                    	INR	A
  0602'   21 0BC2'              	LXI	H,TXEND
  0605'   96                    	SUB	M
  0606'   21 0BC3'              	LXI	H,FILCH
  0609'   C2 0614'              	JNZ	LY_W1
  060C'   7E                    	MOV	A,M
  060D'   FE 7E                 	CPI	'~'
  060F'   3E 00                 	MVI	A,0
  0611'   CA 0616'              	JZ	LY_W2
  0614'                         LY_W1:
  0614'   3E 01                 	MVI	A,1
  0616'                         LY_W2:
  0616'   21 0BE0'              	LXI	H,LYXE
  0619'   B6                    	ORA	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  061A'   32 0BB6'              	STA	WRAPF
  061D'   3A 0BD2'              	LDA	LYROW		; WINROW = row
  0620'   6F                    	MOV	L,A
  0621'   26 00                 	MVI	H,0
  0623'   22 0BB2'              	SHLD	WINROW
  0626'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  0627'   2A 0BD0'              	LHLD	LYDLT
  062A'   CD 0000*              	CALL	SUBHD
  062D'   EB                    	XCHG
  062E'   2A 0BB4'              	LHLD	OLDWR
  0631'   19                    	DAD	D
  0632'   22 0BBD'              	SHLD	SCRLN
  0635'   CD 09B2'              	CALL	TABCUR
  0638'   2A 0BE2'              	LHLD	SVCNT
  063B'   22 0000*              	SHLD	CMDCNT
  063E'   2A 0BE4'              	LHLD	SVAUX
  0641'   22 0000*              	SHLD	AUXCNT
  0644'   3A 0BE6'              	LDA	SVDIR
  0647'   32 0000*              	STA	DIRFLG
  064A'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  064B'                         LYMQ:
  064B'   3A 0BC6'              	LDA	PLACE
  064E'   FE 02                 	CPI	PL_MID
  0650'   C8                    	RZ
  0651'   3A 0BDC'              	LDA	LYND
  0654'   B7                    	ORA	A
  0655'   CA 065A'              	JZ	LQ_NO
  0658'   AF                    	XRA	A
  0659'   C9                    	RET
  065A'                         LQ_NO:
  065A'   3C                    	INR	A
  065B'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  065C'                         FLINE:
  065C'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  065F'   DA 069C'              	JC	FL_EOF
  0662'   32 0BE1'              	STA	LYLAST
  0665'   FE 0A                 	CPI	LF
  0667'   CA 069A'              	JZ	FL_LF
  066A'   FE 0D                 	CPI	CR
  066C'   CA 065C'              	JZ	FLINE		; CR contributes no display column
  066F'   FE 09                 	CPI	TAB
  0671'   CA 067D'              	JZ	FL_TAB
  0674'   CD 069F'              	CALL	FL_CEL
  0677'   C2 065C'              	JNZ	FLINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  067A'                         FL_OVR:
  067A'   3E 01                 	MVI	A,1
  067C'   C9                    	RET
  067D'                         FL_TAB:
  067D'   3A 0BD6'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0680'   83                    	ADD	E
  0681'   E6 07                 	ANI	TABWID-1
  0683'   2F                    	CMA
  0684'   C6 09                 	ADI	TABWID+1
  0686'   E5                    	PUSH	H
  0687'   6F                    	MOV	L,A
  0688'                         FT_LP:
  0688'   CD 069F'              	CALL	FL_CEL
  068B'   CA 0696'              	JZ	FT_OVR
  068E'   2D                    	DCR	L
  068F'   C2 0688'              	JNZ	FT_LP
  0692'   E1                    	POP	H
  0693'   C3 065C'              	JMP	FLINE
  0696'                         FT_OVR:
  0696'   E1                    	POP	H
  0697'   C3 067A'              	JMP	FL_OVR
  069A'                         FL_LF:
  069A'   AF                    	XRA	A
  069B'   C9                    	RET
  069C'                         FL_EOF:
  069C'   3E FF                 	MVI	A,0FFH
  069E'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  069F'                         FL_CEL:
  069F'   3A 0BB0'              	LDA	NCOLS
  06A2'   BB                    	CMP	E
  06A3'   C2 06B5'              	JNZ	FC_1
  06A6'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  06A8'   14                    	INR	D
  06A9'   E5                    	PUSH	H
  06AA'   21 0BD6'              	LXI	H,LYVB
  06AD'   86                    	ADD	M
  06AE'   77                    	MOV	M,A
  06AF'   E1                    	POP	H
  06B0'   3A 0BB1'              	LDA	NEDIT
  06B3'   BA                    	CMP	D
  06B4'   C8                    	RZ
  06B5'                         FC_1:
  06B5'   1C                    	INR	E		; (NZ)
  06B6'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  06B7'                         ISBOF:
  06B7'   EB                    	XCHG
  06B8'   2A 0000*              	LHLD	TXTBEG
  06BB'   CD 0000*              	CALL	CMP16
  06BE'   C0                    	RNZ
  06BF'   2A 0000*              	LHLD	OUTPOS
  06C2'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  06C3'   B5                    	ORA	L
  06C4'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  06C5'                         LYMID:
  06C5'   CD 0711'              	CALL	LYINI
  06C8'   3A 0BDC'              	LDA	LYND
  06CB'   B7                    	ORA	A
  06CC'   CA 06F4'              	JZ	LM_LP
  06CF'                         LM_NR:
  06CF'   CD 0758'              	CALL	LMABV		; a line above and a line below, LYND times
  06D2'   DA 06E9'              	JC	LM_P
  06D5'   CD 072A'              	CALL	LMBLW
  06D8'   DA 06E9'              	JC	LM_P
  06DB'   21 0BDC'              	LXI	H,LYND
  06DE'   35                    	DCR	M
  06DF'   C2 06CF'              	JNZ	LM_NR
  06E2'   3A 0BDE'              	LDA	LYSVR		; the screen holds them: scroll to it
  06E5'   32 0BD2'              	STA	LYROW
  06E8'   C9                    	RET
  06E9'                         LM_P:
  06E9'   AF                    	XRA	A		; it does not: the middle, above first
  06EA'   32 0BDC'              	STA	LYND
  06ED'   3C                    	INR	A
  06EE'   32 0BDD'              	STA	LYPRF
  06F1'   C3 06C5'              	JMP	LYMID
  06F4'                         LM_LP:
  06F4'   3A 0BDB'              	LDA	LYMBL
  06F7'   21 0BDD'              	LXI	H,LYPRF
  06FA'   86                    	ADD	M
  06FB'   47                    	MOV	B,A
  06FC'   3A 0BDA'              	LDA	LYMAB
  06FF'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0700'   DA 070A'              	JC	LM_U		;   many, when above goes first)
  0703'   CD 072A'              	CALL	LMBLW
  0706'   D2 06F4'              	JNC	LM_LP
  0709'   C9                    	RET
  070A'                         LM_U:
  070A'   CD 0758'              	CALL	LMABV
  070D'   D2 06F4'              	JNC	LM_LP
  0710'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0711'                         LYINI:
  0711'   AF                    	XRA	A
  0712'   32 0BD2'              	STA	LYROW
  0715'   32 0BDA'              	STA	LYMAB
  0718'   32 0BDB'              	STA	LYMBL
  071B'   3A 0000*              	LDA	HTCUR
  071E'   CD 0774'              	CALL	HTE
  0721'   7E                    	MOV	A,M
  0722'   32 0BD9'              	STA	LYUSE
  0725'   23                    	INX	H
  0726'   22 0BD4'              	SHLD	LYIB
  0729'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  072A'                         LMBLW:
  072A'   3A 0000*              	LDA	HTN
  072D'   CD 0774'              	CALL	HTE
  0730'   EB                    	XCHG
  0731'   2A 0BD4'              	LHLD	LYIB
  0734'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0737'   C2 0746'              	JNZ	LB_1
  073A'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  073D'   B7                    	ORA	A
  073E'   37                    	STC
  073F'   C8                    	RZ
  0740'   21 0BDB'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0743'   34                    	INR	M
  0744'   B7                    	ORA	A
  0745'   C9                    	RET
  0746'                         LB_1:
  0746'   7E                    	MOV	A,M
  0747'   CD 077C'              	CALL	LM_ADD
  074A'   D8                    	RC
  074B'   21 0BDB'              	LXI	H,LYMBL
  074E'   86                    	ADD	M
  074F'   77                    	MOV	M,A
  0750'   2A 0BD4'              	LHLD	LYIB
  0753'   23                    	INX	H
  0754'   22 0BD4'              	SHLD	LYIB
  0757'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0758'                         LMABV:
  0758'   21 0BD2'              	LXI	H,LYROW
  075B'   3A 0000*              	LDA	HTCUR
  075E'   96                    	SUB	M
  075F'   37                    	STC
  0760'   C8                    	RZ
  0761'   3D                    	DCR	A
  0762'   CD 0774'              	CALL	HTE
  0765'   7E                    	MOV	A,M
  0766'   CD 077C'              	CALL	LM_ADD
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0769'   D8                    	RC
  076A'   21 0BDA'              	LXI	H,LYMAB
  076D'   86                    	ADD	M
  076E'   77                    	MOV	M,A
  076F'   21 0BD2'              	LXI	H,LYROW
  0772'   34                    	INR	M
  0773'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0774'                         HTE:
  0774'   5F                    	MOV	E,A
  0775'   16 00                 	MVI	D,0
  0777'   21 0000*              	LXI	H,HTAB
  077A'   19                    	DAD	D
  077B'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  077C'                         LM_ADD:
  077C'   47                    	MOV	B,A
  077D'   3A 0BD9'              	LDA	LYUSE
  0780'   80                    	ADD	B
  0781'   D8                    	RC
  0782'   4F                    	MOV	C,A
  0783'   3A 0BB1'              	LDA	NEDIT
  0786'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0787'   D8                    	RC
  0788'   79                    	MOV	A,C
  0789'   32 0BD9'              	STA	LYUSE
  078C'   78                    	MOV	A,B
  078D'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  078E'                         LM_NX:
  078E'   11 0000               	LXI	D,0
  0791'   AF                    	XRA	A
  0792'   32 0BD6'              	STA	LYVB
  0795'   2A 0BED'              	LHLD	RDBC
  0798'   44                    	MOV	B,H
  0799'   4D                    	MOV	C,L
  079A'   2A 0BEB'              	LHLD	RDHL
  079D'                         LM_FL:
  079D'   CD 065C'              	CALL	FLINE
  07A0'   22 0BEB'              	SHLD	RDHL
  07A3'   60                    	MOV	H,B
  07A4'   69                    	MOV	L,C
  07A5'   22 0BED'              	SHLD	RDBC
  07A8'   B7                    	ORA	A
  07A9'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  07AA'                         LYTOPP:
  07AA'   2A 0BC8'              	LHLD	TOPLEN
  07AD'   44                    	MOV	B,H
  07AE'   4D                    	MOV	C,L
  07AF'                         G2P:
  07AF'   EB                    	XCHG
  07B0'   2A 0000*              	LHLD	GAPBEG
  07B3'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  07B6'                         LNW:
  07B6'   11 0000               	LXI	D,0
  07B9'                         LNW_LP:
  07B9'   78                    	MOV	A,B
  07BA'   B1                    	ORA	C
  07BB'   C8                    	RZ
  07BC'   7E                    	MOV	A,M
  07BD'   23                    	INX	H
  07BE'   0B                    	DCX	B
  07BF'   FE 0A                 	CPI	LF
  07C1'   CA 07D6'              	JZ	LNW_LF
  07C4'   FE 0D                 	CPI	CR
  07C6'   CA 07B9'              	JZ	LNW_LP		; CR contributes no display column
  07C9'   FE 09                 	CPI	TAB
  07CB'   C2 07D2'              	JNZ	LNW_1
  07CE'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  07CF'   F6 07                 	ORI	TABWID-1
  07D1'   5F                    	MOV	E,A
  07D2'                         LNW_1:
  07D2'   13                    	INX	D
  07D3'   C3 07B9'              	JMP	LNW_LP
  07D6'                         LNW_LF:
  07D6'   37                    	STC
  07D7'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  07D8'                         LYFAR:
  07D8'   2A 0BB2'              	LHLD	WINROW
  07DB'   EB                    	XCHG
  07DC'   2A 0000*              	LHLD	LNDLT
  07DF'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  07E0'   7C                    	MOV	A,H
  07E1'   B7                    	ORA	A
  07E2'   F2 07F9'              	JP	LF_DN
  07E5'   3A 0BB1'              	LDA	NEDIT
  07E8'   B7                    	ORA	A
  07E9'   1F                    	RAR
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  07EA'   D6 02                 	SUI	2
  07EC'   5F                    	MOV	E,A
  07ED'   16 00                 	MVI	D,0
  07EF'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  07F0'   7C                    	MOV	A,H
  07F1'   B7                    	ORA	A
  07F2'   F0                    	RP
  07F3'                         LF_FAR:
  07F3'   3E 02                 	MVI	A,PL_MID
  07F5'   32 0BC6'              	STA	PLACE
  07F8'   C9                    	RET
  07F9'                         LF_DN:
  07F9'   3A 0BC1'              	LDA	SCBOT
  07FC'   3C                    	INR	A
  07FD'   5F                    	MOV	E,A
  07FE'   16 00                 	MVI	D,0
  0800'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0803'   7C                    	MOV	A,H		;   less one
  0804'   B7                    	ORA	A
  0805'   F8                    	RM			; on the screen
  0806'   C2 07F3'              	JNZ	LF_FAR
  0809'   3A 0BB1'              	LDA	NEDIT
  080C'   BD                    	CMP	L		; CY iff NEDIT < that
  080D'   DA 07F3'              	JC	LF_FAR
  0810'   7D                    	MOV	A,L
  0811'   32 0BDC'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0814'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0815'                         HTBLD:
  0815'   79                    	MOV	A,C
  0816'   32 0BDF'              	STA	HTLIM
  0819'   AF                    	XRA	A
  081A'   32 0000*              	STA	HTN
  081D'   32 0000*              	STA	HTEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0820'   32 0000*              	STA	HTBOF
  0823'   32 0BE0'              	STA	LYXE
  0826'   32 0BBC'              	STA	TALLF
  0829'   68                    	MOV	L,B
  082A'   67                    	MOV	H,A
  082B'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  082E'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  082F'   E5                    	PUSH	H
  0830'   CD 06B7'              	CALL	ISBOF
  0833'   C2 083A'              	JNZ	HB_1
  0836'   3C                    	INR	A
  0837'   32 0000*              	STA	HTBOF
  083A'                         HB_1:
  083A'   E1                    	POP	H
  083B'   E5                    	PUSH	H
  083C'   CD 07AF'              	CALL	G2P		; HL = the bytes from there to the cursor
  083F'   E5                    	PUSH	H
  0840'   3A 0BB0'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0843'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0845'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0846'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0848'   3A 0BB1'              	LDA	NEDIT		;   leave no room to read down
  084B'   CD 0A7B'              	CALL	MULHA
  084E'   D1                    	POP	D
  084F'   42                    	MOV	B,D
  0850'   4B                    	MOV	C,E
  0851'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0854'   D2 0858'              	JNC	HB_LM
  0857'   EB                    	XCHG
  0858'                         HB_LM:
  0858'   22 0BD7'              	SHLD	LYLIM
  085B'   E1                    	POP	H
  085C'   F1                    	POP	PSW
  085D'   D2 0867'              	JNC	HB_AB
  0860'   3A 0000*              	LDA	HTBOF
  0863'   B7                    	ORA	A
  0864'   CC 07B6'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0867'                         HB_AB:
  0867'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0868'   CD 07B6'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  086B'   D2 088E'              	JNC	HB_CU
  086E'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  086F'   C5                    	PUSH	B
  0870'   EB                    	XCHG
  0871'   CD 04CC'              	CALL	XTRA		; BC = its rows past the first
  0874'   78                    	MOV	A,B
  0875'   B7                    	ORA	A
  0876'   C2 0883'              	JNZ	HB_TA
  0879'   3A 0BB1'              	LDA	NEDIT
  087C'   3D                    	DCR	A
  087D'   B9                    	CMP	C		; CY iff more rows than the screen has
  087E'   79                    	MOV	A,C
  087F'   3C                    	INR	A
  0880'   D2 0886'              	JNC	HB_PA
  0883'                         HB_TA:
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0883'   3A 0BB1'              	LDA	NEDIT
  0886'                         HB_PA:
  0886'   CD 099C'              	CALL	HTPUT
  0889'   C1                    	POP	B
  088A'   E1                    	POP	H
  088B'   C3 0867'              	JMP	HB_AB
  088E'                         HB_CU:
  088E'   EB                    	XCHG
  088F'   22 0BCC'              	SHLD	CURDCL
  0892'   E1                    	POP	H
  0893'   22 0BCA'              	SHLD	CBOL
  0896'   EB                    	XCHG			; none of it spilled while reading down: the
  0897'   2A 0BD7'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  089A'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  089D'   DA 08A1'              	JC	HB_WL
  08A0'   EB                    	XCHG
  08A1'                         HB_WL:
  08A1'   24                    	INR	H
  08A2'   22 0000*              	SHLD	WRLIM
  08A5'   3A 0000*              	LDA	HTN
  08A8'   32 0000*              	STA	HTCUR
  08AB'   2A 0BCC'              	LHLD	CURDCL
  08AE'   CD 04D3'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  08B1'   5F                    	MOV	E,A
  08B2'   3A 0BCC'              	LDA	CURDCL
  08B5'   93                    	SUB	E
  08B6'   32 0BD6'              	STA	LYVB		; the column the cursor's row starts at
  08B9'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  08BA'   2A 0BB8'              	LHLD	SKIPR
  08BD'   50                    	MOV	D,B
  08BE'   59                    	MOV	E,C
  08BF'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  08C2'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  08C3'   DA 08E1'              	JC	HB_SS		; then that is the first
  08C6'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  08C9'   7C                    	MOV	A,H
  08CA'   B7                    	ORA	A
  08CB'   C2 08D7'              	JNZ	HB_SD
  08CE'   3A 0BB1'              	LDA	NEDIT
  08D1'   3D                    	DCR	A
  08D2'   BD                    	CMP	L		; CY iff that is under the last edit row
  08D3'   EB                    	XCHG			; HL = SKIPR, as it was
  08D4'   D2 08E1'              	JNC	HB_SS
  08D7'                         HB_SD:
  08D7'   3A 0BB1'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  08DA'   2F                    	CMA
  08DB'   6F                    	MOV	L,A
  08DC'   26 FF                 	MVI	H,0FFH
  08DE'   23                    	INX	H
  08DF'   23                    	INX	H
  08E0'   09                    	DAD	B
  08E1'                         HB_SS:
  08E1'   22 0BB8'              	SHLD	SKIPR
  08E4'   EB                    	XCHG
  08E5'   60                    	MOV	H,B
  08E6'   69                    	MOV	L,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  08E7'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  08EA'   7D                    	MOV	A,L
  08EB'   D1                    	POP	D
  08EC'   57                    	MOV	D,A
  08ED'   CD 0000*              	CALL	RGET0
  08F0'   CD 079D'              	CALL	LM_FL		; the rest of the line: D = its last row
  08F3'   F5                    	PUSH	PSW
  08F4'   FE 01                 	CPI	1
  08F6'   CA 0985'              	JZ	HB_TO		; more rows than the screen has
  08F9'   2A 0BB8'              	LHLD	SKIPR
  08FC'   7C                    	MOV	A,H
  08FD'   B5                    	ORA	L
  08FE'   CA 0921'              	JZ	HB_E2
  0901'   7C                    	MOV	A,H
  0902'   B7                    	ORA	A
  0903'   C2 091C'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0906'   7D                    	MOV	A,L
  0907'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0908'   DA 091C'              	JC	HB_TE
  090B'   21 0BB1'              	LXI	H,NEDIT
  090E'   BE                    	CMP	M
  090F'   D2 091C'              	JNC	HB_TE		; more than NEDIT of them
  0912'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0913'   21 0000               	LXI	H,0
  0916'   22 0BB8'              	SHLD	SKIPR
  0919'   C3 0921'              	JMP	HB_E2
  091C'                         HB_TE:
  091C'   3E 01                 	MVI	A,1
  091E'   32 0BBC'              	STA	TALLF
  0921'                         HB_E2:
  0921'   7B                    	MOV	A,E
  0922'   B7                    	ORA	A
  0923'   C2 092F'              	JNZ	HB_E3
  0926'   B2                    	ORA	D
  0927'   CA 092F'              	JZ	HB_E3		; (its first row: an empty line)
  092A'   3E 03                 	MVI	A,WR_EOL+1
  092C'   32 0BE0'              	STA	LYXE
  092F'                         HB_E3:
  092F'   7A                    	MOV	A,D
  0930'   3C                    	INR	A
  0931'   32 0BD3'              	STA	LYTSH
  0934'   3A 0BBC'              	LDA	TALLF
  0937'   B7                    	ORA	A
  0938'   C2 0990'              	JNZ	HB_TX
  093B'   F1                    	POP	PSW
  093C'   FA 0961'              	JM	HB_LS		; the text ends with it
  093F'                         HB_PT:
  093F'   7A                    	MOV	A,D
  0940'   3C                    	INR	A
  0941'   CD 099C'              	CALL	HTPUT
  0944'   47                    	MOV	B,A
  0945'   3A 0BDF'              	LDA	HTLIM
  0948'   90                    	SUB	B
  0949'   32 0BDF'              	STA	HTLIM
  094C'   D8                    	RC
  094D'   CA 096C'              	JZ	HB_PK		; rows enough
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0950'                         HB_NX:
  0950'   CD 078E'              	CALL	LM_NX		; the next line down
  0953'   CA 093F'              	JZ	HB_PT
  0956'   F2 0999'              	JP	HB_TL		; one taller than the screen
  0959'   3A 0BE1'              	LDA	LYLAST		; the text ended: was that a line?
  095C'   FE 0A                 	CPI	LF
  095E'   CA 0966'              	JZ	HB_EF
  0961'                         HB_LS:
  0961'   7A                    	MOV	A,D
  0962'   3C                    	INR	A
  0963'   CD 099C'              	CALL	HTPUT
  0966'                         HB_EF:
  0966'   3E 01                 	MVI	A,1
  0968'   32 0000*              	STA	HTEOF
  096B'   C9                    	RET
  096C'                         HB_PK:
  096C'   2A 0BED'              	LHLD	RDBC		; just the rows asked for: is the text over
  096F'   44                    	MOV	B,H		;   right there?
  0970'   4D                    	MOV	C,L
  0971'   2A 0BEB'              	LHLD	RDHL
  0974'   CD 0000*              	CALL	RDGET
  0977'   D0                    	RNC
  0978'   C3 0966'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  097B'                         HBMOR:
  097B'   32 0BDF'              	STA	HTLIM
  097E'   B7                    	ORA	A
  097F'   CA 096C'              	JZ	HB_PK
  0982'   C3 0950'              	JMP	HB_NX
  0985'                         HB_TO:
  0985'   3E 01                 	MVI	A,1
  0987'   32 0BBC'              	STA	TALLF
  098A'   3A 0BB1'              	LDA	NEDIT
  098D'   32 0BD3'              	STA	LYTSH
  0990'                         HB_TX:
  0990'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0991'   F2 0999'              	JP	HB_TL		;   with it, and on the screen)
  0994'   3E 01                 	MVI	A,1
  0996'   32 0000*              	STA	HTEOF
  0999'                         HB_TL:
  0999'   3A 0BB1'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  099C'                         HTPUT:
  099C'   E5                    	PUSH	H
  099D'   D5                    	PUSH	D
  099E'   21 0000*              	LXI	H,HTN
  09A1'   5E                    	MOV	E,M
  09A2'   1C                    	INR	E
  09A3'   CA 09AF'              	JZ	HP_1
  09A6'   73                    	MOV	M,E
  09A7'   1D                    	DCR	E
  09A8'   16 00                 	MVI	D,0
  09AA'   21 0000*              	LXI	H,HTAB
  09AD'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09AE'   77                    	MOV	M,A
  09AF'                         HP_1:
  09AF'   D1                    	POP	D
  09B0'   E1                    	POP	H
  09B1'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  09B2'                         TABCUR:
  09B2'   3A 0000*              	LDA	EDMODE
  09B5'   FE 00                 	CPI	EM_CMD
  09B7'   C0                    	RNZ
  09B8'   2A 0000*              	LHLD	TXTEND
  09BB'   EB                    	XCHG
  09BC'   2A 0000*              	LHLD	GAPEND
  09BF'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  09C2'   C8                    	RZ
  09C3'   7E                    	MOV	A,M
  09C4'   FE 09                 	CPI	TAB
  09C6'   C0                    	RNZ
  09C7'   2A 0BCC'              	LHLD	CURDCL
  09CA'   7D                    	MOV	A,L
  09CB'   F6 07                 	ORI	TABWID-1
  09CD'   6F                    	MOV	L,A
  09CE'   22 0BCC'              	SHLD	CURDCL
  09D1'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  09D2'                         RDTOP:
  09D2'   2A 0BC8'              	LHLD	TOPLEN
  09D5'   C3 09DB'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  09D8'                         RDBOL:
  09D8'   2A 0BCA'              	LHLD	CBOL
  09DB'                         RDSET:
  09DB'   22 0BE9'              	SHLD	RDN
  09DE'   EB                    	XCHG
  09DF'   2A 0000*              	LHLD	GAPBEG
  09E2'   CD 0000*              	CALL	SUBHD
  09E5'   22 0BE7'              	SHLD	RDP
  09E8'   AF                    	XRA	A
  09E9'   32 0BEF'              	STA	RDSEG
  09EC'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  09ED'                         RDCH:
  09ED'   C5                    	PUSH	B
  09EE'   D5                    	PUSH	D
  09EF'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  09F0'   2A 0BE9'              	LHLD	RDN		; before-gap bytes left?
  09F3'   7C                    	MOV	A,H
  09F4'   B5                    	ORA	L
  09F5'   CA 0A08'              	JZ	RDC_AF
  09F8'   2B                    	DCX	H
  09F9'   22 0BE9'              	SHLD	RDN
  09FC'   2A 0BE7'              	LHLD	RDP
  09FF'   7E                    	MOV	A,M
  0A00'   23                    	INX	H
  0A01'   22 0BE7'              	SHLD	RDP
  0A04'   B7                    	ORA	A		; CY=0
  0A05'   C3 0A2C'              	JMP	RDC_RT
  0A08'                         RDC_AF:
  0A08'   3A 0BEF'              	LDA	RDSEG
  0A0B'   B7                    	ORA	A
  0A0C'   C2 0A19'              	JNZ	RDC_NX
  0A0F'   3C                    	INR	A		; first after-gap byte: start RGET
  0A10'   32 0BEF'              	STA	RDSEG
  0A13'   CD 0000*              	CALL	RGET0
  0A16'   C3 0A21'              	JMP	RDC_GT
  0A19'                         RDC_NX:
  0A19'   2A 0BED'              	LHLD	RDBC
  0A1C'   44                    	MOV	B,H
  0A1D'   4D                    	MOV	C,L
  0A1E'   2A 0BEB'              	LHLD	RDHL
  0A21'                         RDC_GT:
  0A21'   CD 0000*              	CALL	RDGET
  0A24'   22 0BEB'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0A27'   60                    	MOV	H,B
  0A28'   69                    	MOV	L,C
  0A29'   22 0BED'              	SHLD	RDBC
  0A2C'                         RDC_RT:
  0A2C'   E1                    	POP	H
  0A2D'   D1                    	POP	D
  0A2E'   C1                    	POP	B
  0A2F'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0A30'                         RDSKIP:
  0A30'   B7                    	ORA	A
  0A31'   C8                    	RZ
  0A32'   32 0BF0'              	STA	SKPN
  0A35'                         RSK_LP:
  0A35'   CD 09ED'              	CALL	RDCH
  0A38'   D8                    	RC
  0A39'   FE 0A                 	CPI	LF
  0A3B'   C2 0A35'              	JNZ	RSK_LP
  0A3E'   3A 0BF0'              	LDA	SKPN
  0A41'   3D                    	DCR	A
  0A42'   32 0BF0'              	STA	SKPN
  0A45'   C2 0A35'              	JNZ	RSK_LP
  0A48'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ; the first row shown.
  0A49'                         PSKIP:
  0A49'   3A 0BB0'              	LDA	NCOLS
  0A4C'   CD 0A7B'              	CALL	MULHA		; HL = the cells to pass over
  0A4F'   EB                    	XCHG
  0A50'   21 0000               	LXI	H,0
  0A53'   22 0BF3'              	SHLD	PSKN
  0A56'                         PS_LP:
  0A56'   7A                    	MOV	A,D
  0A57'   B3                    	ORA	E
  0A58'   CA 0AAF'              	JZ	PR_LP
  0A5B'   CD 09ED'              	CALL	RDCH
  0A5E'   FE 0D                 	CPI	CR
  0A60'   CA 0A56'              	JZ	PS_LP
  0A63'   0E 01                 	MVI	C,1
  0A65'   FE 09                 	CPI	TAB
  0A67'   CC 0A85'              	CZ	TABN
  0A6A'                         PS_CL:
  0A6A'   7A                    	MOV	A,D
  0A6B'   B3                    	ORA	E
  0A6C'   CA 0AC9'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0A6F'   1B                    	DCX	D
  0A70'   21 0BF5'              	LXI	H,DCOL
  0A73'   34                    	INR	M
  0A74'   0D                    	DCR	C
  0A75'   C2 0A6A'              	JNZ	PS_CL
  0A78'   C3 0A56'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0A7B'                         MULHA:
  0A7B'   EB                    	XCHG
  0A7C'   21 0000               	LXI	H,0
  0A7F'                         MH_LP:
  0A7F'   19                    	DAD	D
  0A80'   3D                    	DCR	A
  0A81'   C2 0A7F'              	JNZ	MH_LP
  0A84'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0A85'                         TABN:
  0A85'   3A 0BF5'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0A88'   E6 07                 	ANI	7
  0A8A'   4F                    	MOV	C,A
  0A8B'   3E 08                 	MVI	A,8
  0A8D'   91                    	SUB	C
  0A8E'   4F                    	MOV	C,A
  0A8F'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0A90'                         PAINTR:
  0A90'   3A 0BF1'              	LDA	PROWN
  0A93'   21 0BC2'              	LXI	H,TXEND
  0A96'   BE                    	CMP	M		; CY iff the row holds text
  0A97'   DA 0AA0'              	JC	PROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0A9A'   3A 0BC3'              	LDA	FILCH
  0A9D'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0AA0'                         PROW:
  0AA0'   AF                    	XRA	A
  0AA1'   32 0BF5'              	STA	DCOL
  0AA4'   32 0BF6'              	STA	XC
  0AA7'   2A 0BF3'              	LHLD	PSKN
  0AAA'   7C                    	MOV	A,H
  0AAB'   B5                    	ORA	L
  0AAC'   C2 0A49'              	JNZ	PSKIP
  0AAF'                         PR_LP:
  0AAF'   CD 09ED'              	CALL	RDCH
  0AB2'   D8                    	RC			; end of text -> line done
  0AB3'   FE 0A                 	CPI	LF
  0AB5'   C8                    	RZ			; consumed the LF -> next line start
  0AB6'   FE 0D                 	CPI	CR
  0AB8'   CA 0AAF'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0ABB'   FE 09                 	CPI	TAB
  0ABD'   CA 0AC6'              	JZ	PR_TAB
  0AC0'   CD 0AD5'              	CALL	PCELL
  0AC3'   C3 0AAF'              	JMP	PR_LP
  0AC6'                         PR_TAB:
  0AC6'   CD 0A85'              	CALL	TABN		; C = space count (1..8)
  0AC9'                         PRTBLP:
  0AC9'   3E 20                 	MVI	A,' '
  0ACB'   CD 0AD5'              	CALL	PCELL		; (keeps C)
  0ACE'   0D                    	DCR	C
  0ACF'   C2 0AC9'              	JNZ	PRTBLP
  0AD2'   C3 0AAF'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0AD5'                         PCELL:
  0AD5'   47                    	MOV	B,A
  0AD6'   21 0BF5'              	LXI	H,DCOL
  0AD9'   34                    	INR	M
  0ADA'   3A 0BB0'              	LDA	NCOLS
  0ADD'   21 0BF6'              	LXI	H,XC
  0AE0'   BE                    	CMP	M
  0AE1'   CC 0AE9'              	CZ	PWRAP		; the row is full: this one starts the next
  0AE4'   34                    	INR	M
  0AE5'   78                    	MOV	A,B
  0AE6'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last edit row there is nowhere to go: the rest of the
                                ; line is not shown, and PROW returns to its caller from here.
  0AE9'                         PWRAP:
  0AE9'   36 00                 	MVI	M,0
  0AEB'   3A 0BB1'              	LDA	NEDIT
  0AEE'   3D                    	DCR	A
  0AEF'   21 0BF1'              	LXI	H,PROWN
  0AF2'   BE                    	CMP	M
  0AF3'   CA 0B08'              	JZ	PW_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0AF6'   34                    	INR	M
  0AF7'   3E 0D                 	MVI	A,CR
  0AF9'   CD 0018'              	CALL	OUTCH
  0AFC'   3E 0A                 	MVI	A,LF
  0AFE'   CD 0018'              	CALL	OUTCH
  0B01'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0B04'   21 0BF6'              	LXI	H,XC
  0B07'   C9                    	RET
  0B08'                         PW_END:
  0B08'   E1                    	POP	H		; PCELL's return, and PROW's
  0B09'   E1                    	POP	H
  0B0A'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0B0B'                         MODEMS:
  0B0B'   3A 0000*              	LDA	EDMODE
  0B0E'   47                    	MOV	B,A
  0B0F'   3A 0BC0'              	LDA	OEDMOD
  0B12'   B8                    	CMP	B
  0B13'   C8                    	RZ			; the row already shows this mode
  0B14'   78                    	MOV	A,B
  0B15'   32 0BC0'              	STA	OEDMOD
  0B18'   21 0B8F'              	LXI	H,SINSM
  0B1B'   FE 01                 	CPI	EM_INS
  0B1D'   CA 0B2B'              	JZ	MD_DRW
  0B20'   21 0B9C'              	LXI	H,SREPM
  0B23'   FE 02                 	CPI	EM_REP
  0B25'   CA 0B2B'              	JZ	MD_DRW
  0B28'   21 0BAA'              	LXI	H,SNULL		; command mode: the row goes blank
  0B2B'                         MD_DRW:
  0B2B'   E5                    	PUSH	H
  0B2C'   3A 0BAF'              	LDA	NROWS
  0B2F'   CD 008C'              	CALL	GOROW1
  0B32'   E1                    	POP	H
  0B33'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0B36'                         SCURS:
  0B36'   3A 0BF9'              	LDA	SROW
  0B39'   47                    	MOV	B,A
  0B3A'   3A 0BFA'              	LDA	SCOL
  0B3D'   4F                    	MOV	C,A
  0B3E'   CD 0064'              	CALL	GOTOXY
  0B41'   21 0B84'              	LXI	H,SSHOW
  0B44'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                ;============================================================
  0B47'                         SCDONE:
  0B47'   CD 0086'              	CALL	CRGRS
  0B4A'   21 0B84'              	LXI	H,SSHOW
  0B4D'   CD 0025'              	CALL	OUTSTR
  0B50'   3A 0BAF'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0B53'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0B56'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0B5A'   39 3B 39 39           
  0B5E'   39 48                 
  0B60'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0B64'   00                    
