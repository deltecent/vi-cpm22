	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
                                ; under it.  So WINROW counts LINES -- how many are on the screen above the
                                ; cursor's -- and the layout turns that into rows by measuring each of them.
                                ; The top row is always the start of a line; a line the bottom has no room
                                ; for is not shown, its rows hold '@'.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe), the cheap paints the
                                ; RINTENT asks for, the RPOLL repaint abort, and the message row.  A cheap
                                ; paint is counted in ROWS: the rows the screen gave up or gained at the top,
                                ; the rows the edit at the cursor had and has.  The terminal moves what stands
                                ; (IL/DL in a scroll region) and only the rows that are new are sent.
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (lines on the screen above the cursor's;
                                ;                                       CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; lines above the cursor's (signed word)
                                	PUBLIC	SCBOT			; WINROW of the last line shown
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
                                	PUBLIC	TXEND			; the first row with no text on it ('M')
                                	PUBLIC	CSUB			; the row of its line the cursor is on
                                	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
                                	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	PGTOPM			; PAGE.MAC -- times the pager moved the text
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	LNALL			; CMD.MAC -- 1 = an R_LINE from its first row
                                	EXTRN	DCHN			; CMD.MAC -- cells an R_DCH deletes
                                	EXTRN	DCHBS			; CMD.MAC -- 1 = left of the cursor
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
                                	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
                                	EXTRN	HTAB			; RSV.MAC -- the row table itself
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   AF                    	XRA	A
  0065'   32 1034'              	STA	TCOK		; the cursor is somewhere else now
  0068'   3E 1B                 	MVI	A,ESC
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006A'   CD 0018'              	CALL	OUTCH
  006D'   3E 5B                 	MVI	A,'['
  006F'   CD 0018'              	CALL	OUTCH
  0072'   78                    	MOV	A,B
  0073'   CD 002F'              	CALL	EMITB
  0076'   3E 3B                 	MVI	A,';'
  0078'   CD 0018'              	CALL	OUTCH
  007B'   79                    	MOV	A,C
  007C'   CD 002F'              	CALL	EMITB
  007F'   3E 48                 	MVI	A,'H'
  0081'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0084'                         CHIDE:
  0084'   3E 01                 	MVI	A,1
  0086'   32 1035'              	STA	CHID
  0089'   21 1038'              	LXI	H,SHIDE
  008C'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  008F'                         CRGRS:
  008F'   21 1046'              	LXI	H,SREGRS
  0092'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  0095'                         GOROW1:
  0095'   47                    	MOV	B,A
  0096'   0E 01                 	MVI	C,1
  0098'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  009B'                         CEKL:
  009B'   21 1023'              	LXI	H,SEK
  009E'   C3 0025'              	JMP	OUTSTR
                                ;PRNG -- paint the edit rows from B up to (not including) C, counted from 0:
                                ; each cleared (ESC[K), the text on as many rows as its lines take, the fill
                                ; char on the rows past it.  The row table says which line row B is in and
                                ; how many of that line's rows are above it, and the reader is put there.
                                ; The one row a line may own with nothing on it -- the cursor's, past text
                                ; that filled the row above (LYXE) -- is cleared in its turn.  An empty range
                                ; sends nothing.  During a full repaint (FORCEF) a key that is waiting
                                ; abandons the frame, and the return from here is SCDRAW's own.
  00A1'                         PRNG:
  00A1'   78                    	MOV	A,B
  00A2'   B9                    	CMP	C
  00A3'   D0                    	RNC
  00A4'   32 10C7'              	STA	PROWN
  00A7'   79                    	MOV	A,C
  00A8'   32 108F'              	STA	PEND
  00AB'   3A 1073'              	LDA	TXEND
  00AE'   3D                    	DCR	A
  00AF'   B8                    	CMP	B		; CY iff row B is past the text
  00B0'   DA 00F1'              	JC	PG_GO
  00B3'   C5                    	PUSH	B
  00B4'   CD 0E0B'              	CALL	RDTOP
  00B7'   CD 058D'              	CALL	HTTOP		; HL -> the top line's entry
  00BA'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00BB'   11 0000               	LXI	D,0		; D = the rows above the line, E = the lines
  00BE'                         PG_F:
  00BE'   7A                    	MOV	A,D
  00BF'   86                    	ADD	M
  00C0'   B8                    	CMP	B
  00C1'   DA 00C7'              	JC	PG_N
  00C4'   C2 00CD'              	JNZ	PG_H		; row B is one of this line's
  00C7'                         PG_N:
  00C7'   57                    	MOV	D,A
  00C8'   1C                    	INR	E
  00C9'   23                    	INX	H
  00CA'   C3 00BE'              	JMP	PG_F
  00CD'                         PG_H:
  00CD'   78                    	MOV	A,B
  00CE'   92                    	SUB	D
  00CF'   4F                    	MOV	C,A
  00D0'   06 00                 	MVI	B,0		; BC = the rows of it above row B ...
  00D2'   7B                    	MOV	A,E
  00D3'   21 0000               	LXI	H,0
  00D6'   B7                    	ORA	A
  00D7'   C2 00DD'              	JNZ	PG_K
  00DA'   2A 106F'              	LHLD	SKIPR		; ... and, for the top line, those off the top
  00DD'                         PG_K:
  00DD'   09                    	DAD	B
  00DE'   22 10C8'              	SHLD	PSKN
  00E1'   21 106D'              	LXI	H,WINROW	; at the cursor's line or under it: read on from
  00E4'   BE                    	CMP	M		;   that line, not down the screen to it
  00E5'   DA 00EE'              	JC	PG_S
  00E8'   96                    	SUB	M
  00E9'   F5                    	PUSH	PSW
  00EA'   CD 0E11'              	CALL	RDBOL
  00ED'   F1                    	POP	PSW
  00EE'                         PG_S:
  00EE'   CD 0E69'              	CALL	RDSKIP		; the reader at that line (A lines down)
  00F1'                         PG_GO:
  00F1'   3A 10C7'              	LDA	PROWN
  00F4'   3C                    	INR	A
  00F5'   47                    	MOV	B,A
  00F6'   0E 01                 	MVI	C,1
  00F8'   CD 0064'              	CALL	GOTOXY
  00FB'                         PG_LP:
  00FB'   3A 109B'              	LDA	FORCEF
  00FE'   B7                    	ORA	A
  00FF'   CA 010B'              	JZ	PG_P
  0102'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abandon the repaint
  0105'   B7                    	ORA	A
  0106'   CA 010B'              	JZ	PG_P
  0109'   E1                    	POP	H		; (the cursor stays hidden: no flash in a burst)
  010A'   C9                    	RET
  010B'                         PG_P:
  010B'   CD 009B'              	CALL	CEKL
  010E'   CD 0F1C'              	CALL	PAINTR
  0111'   3A 10B6'              	LDA	LYXE
  0114'   B7                    	ORA	A
  0115'   CA 012A'              	JZ	PG_1
  0118'   3A 1071'              	LDA	SROW		; was that the row over the cursor's own?
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  011B'   D6 02                 	SUI	2
  011D'   21 10C7'              	LXI	H,PROWN
  0120'   BE                    	CMP	M
  0121'   C2 012A'              	JNZ	PG_1
  0124'   CD 013A'              	CALL	PT_NL
  0127'   CD 009B'              	CALL	CEKL
  012A'                         PG_1:
  012A'   3A 108F'              	LDA	PEND
  012D'   3D                    	DCR	A
  012E'   21 10C7'              	LXI	H,PROWN
  0131'   BE                    	CMP	M
  0132'   C8                    	RZ
  0133'   D8                    	RC
  0134'   CD 013A'              	CALL	PT_NL
  0137'   C3 00FB'              	JMP	PG_LP
                                ;PT_NL -- CR, LF: down a row, and count it.
  013A'                         PT_NL:
  013A'   3E 0D                 	MVI	A,CR
  013C'   CD 0018'              	CALL	OUTCH
  013F'   3E 0A                 	MVI	A,LF
  0141'   CD 0018'              	CALL	OUTCH
  0144'   21 10C7'              	LXI	H,PROWN
  0147'   34                    	INR	M
  0148'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  0149'                         GOTOP:
  0149'   06 01                 	MVI	B,1
  014B'   0E 01                 	MVI	C,1
  014D'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  0150'                         SCINIT:
  0150'   21 0000               	LXI	H,0
  0153'   22 106D'              	SHLD	WINROW
  0156'   21 1014'              	LXI	H,SPROBE
  0159'   CD 0025'              	CALL	OUTSTR
  015C'   CD 01A7'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  015F'   3A 106A'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  0162'   3D                    	DCR	A
  0163'   32 106C'              	STA	NEDIT
  0166'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  0167'                         RDB:
  0167'   21 0000               	LXI	H,0
  016A'                         RDB_LP:
  016A'   E5                    	PUSH	H
  016B'   CD 0000'              	CALL	BCONST
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  016E'   E1                    	POP	H
  016F'   B7                    	ORA	A
  0170'   C2 017B'              	JNZ	RDB_GO
  0173'   2B                    	DCX	H
  0174'   7C                    	MOV	A,H
  0175'   B5                    	ORA	L
  0176'   C2 016A'              	JNZ	RDB_LP
  0179'   37                    	STC			; timeout
  017A'   C9                    	RET
  017B'                         RDB_GO:
  017B'   CD 0008'              	CALL	BCONIN
  017E'   B7                    	ORA	A		; CY=0, A=byte
  017F'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  0180'                         RDNUM:
  0180'   11 0000               	LXI	D,0
  0183'                         RN_LP:
  0183'   D5                    	PUSH	D
  0184'   CD 0167'              	CALL	RDB
  0187'   D1                    	POP	D
  0188'   D8                    	RC
  0189'   FE 30                 	CPI	'0'
  018B'   DA 01A5'              	JC	RN_DN
  018E'   FE 3A                 	CPI	'9'+1
  0190'   D2 01A5'              	JNC	RN_DN
  0193'   D6 30                 	SUI	'0'
  0195'   4F                    	MOV	C,A		; C = this digit
  0196'   62                    	MOV	H,D		; HL = value
  0197'   6B                    	MOV	L,E
  0198'   29                    	DAD	H		; 2x
  0199'   54                    	MOV	D,H
  019A'   5D                    	MOV	E,L		; DE = 2x
  019B'   29                    	DAD	H		; 4x
  019C'   29                    	DAD	H		; 8x
  019D'   19                    	DAD	D		; 10x
  019E'   06 00                 	MVI	B,0		; BC = digit
  01A0'   09                    	DAD	B		; HL = 10x + digit
  01A1'   EB                    	XCHG			; DE = new value
  01A2'   C3 0183'              	JMP	RN_LP
  01A5'                         RN_DN:
  01A5'   B7                    	ORA	A		; CY=0, A = terminator
  01A6'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  01A7'                         RDNUMS:
  01A7'   CD 0167'              	CALL	RDB
  01AA'   D8                    	RC
  01AB'   FE 1B                 	CPI	ESC
  01AD'   C0                    	RNZ			; not what a DSR reply looks like
  01AE'   CD 0167'              	CALL	RDB
  01B1'   D8                    	RC
  01B2'   FE 5B                 	CPI	'['
  01B4'   C0                    	RNZ			; not what a DSR reply looks like
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B5'   CD 0180'              	CALL	RDNUM		; DE = rows
  01B8'   D8                    	RC
  01B9'   FE 3B                 	CPI	';'
  01BB'   C0                    	RNZ			; not what a DSR reply looks like
  01BC'   EB                    	XCHG
  01BD'   22 10CC'              	SHLD	TMPR
  01C0'   CD 0180'              	CALL	RDNUM		; DE = cols
  01C3'   D8                    	RC
  01C4'   FE 52                 	CPI	'R'
  01C6'   C0                    	RNZ			; not what a DSR reply looks like
  01C7'   EB                    	XCHG
  01C8'   22 10CE'              	SHLD	TMPC
  01CB'   2A 10CC'              	LHLD	TMPR		; rows -> clamp [24,200]
  01CE'   06 18                 	MVI	B,24
  01D0'   0E C8                 	MVI	C,200
  01D2'   CD 01E6'              	CALL	CLAMP
  01D5'   32 106A'              	STA	NROWS
  01D8'   2A 10CE'              	LHLD	TMPC		; cols -> clamp [80,132]
  01DB'   06 50                 	MVI	B,80
  01DD'   0E 84                 	MVI	C,132
  01DF'   CD 01E6'              	CALL	CLAMP
  01E2'   32 106B'              	STA	NCOLS
  01E5'                         RS_BAD:
  01E5'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  01E6'                         CLAMP:
  01E6'   7C                    	MOV	A,H
  01E7'   B7                    	ORA	A
  01E8'   C2 01F9'              	JNZ	CLP_MAX		; value > 255 -> max
  01EB'   7D                    	MOV	A,L
  01EC'   B8                    	CMP	B
  01ED'   DA 01F7'              	JC	CLP_MIN		; value < min
  01F0'   79                    	MOV	A,C
  01F1'   BD                    	CMP	L		; CY iff max < value
  01F2'   DA 01F9'              	JC	CLP_MAX
  01F5'   7D                    	MOV	A,L
  01F6'   C9                    	RET
  01F7'                         CLP_MIN:
  01F7'   78                    	MOV	A,B
  01F8'   C9                    	RET
  01F9'                         CLP_MAX:
  01F9'   79                    	MOV	A,C
  01FA'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- keep what is on the screen: the frame's facts (WINROW .. NXTR) are
                                ; copied to the OLD ones.  The main loop calls this after reading a key and
                                ; before dispatch, so SCDRAW can tell what the key changed.
  01FB'                         SCPRE:
  01FB'   21 106D'              	LXI	H,WINROW
  01FE'   11 107B'              	LXI	D,OLDWR
  0201'   06 0E                 	MVI	B,FRMLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  0203'                         SP_LP:
  0203'   7E                    	MOV	A,M
  0204'   12                    	STAX	D
  0205'   23                    	INX	H
  0206'   13                    	INX	D
  0207'   05                    	DCR	B
  0208'   C2 0203'              	JNZ	SP_LP
  020B'   C9                    	RET
                                
                                ;SCDRAW -- lay the screen out and paint it the cheapest way that is right.
                                ; A cheap paint is two changes, each "this many rows were here, that many
                                ; are": one at the top row (the screen gave rows up, OPN, or gained them,
                                ; OPM, as the text scrolled) and one at the cursor (EDR: EDA rows before, EDB
                                ; now, to be drawn from row EDP).  The terminal moves the rows that stand,
                                ; the rows that are new are sent, and so is whatever the move left wrong at
                                ; the bottom.  When nothing moves and nothing is new, only the cursor goes.
                                ; Whatever does not fit that is a full repaint.
  020C'                         SCDRAW:
  020C'   CD 061C'              	CALL	LAYOUT		; (no output)
  020F'   CD 05D5'              	CALL	CURSC		; SROW/SCOL
  0212'   3A 109B'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  0215'   B7                    	ORA	A
  0216'   C2 0508'              	JNZ	SCFULL
  0219'   2A 107D'              	LHLD	OLDSK		; the top line starts on another of its rows:
  021C'   EB                    	XCHG			;   every row on the screen is a different one
  021D'   2A 106F'              	LHLD	SKIPR
  0220'   CD 0000*              	CALL	CMP16
  0223'   C2 0508'              	JNZ	SCFULL
  0226'   21 0000               	LXI	H,0
  0229'   22 1089'              	SHLD	OPN		; (and OPM)
  022C'   3A 1076'              	LDA	LYABV
  022F'   47                    	MOV	B,A		; B = the edit's first row: the cursor line's
  0230'   3A 1086'              	LDA	OLDCS		; C = the first row of it that can have changed:
  0233'   21 1078'              	LXI	H,CSRAW		;   the one the cursor was on, or the one it is
  0236'   BE                    	CMP	M
  0237'   DA 023B'              	JC	SD_1
  023A'   7E                    	MOV	A,M
  023B'                         SD_1:
  023B'   4F                    	MOV	C,A
  023C'   21 0000*              	LXI	H,LNALL		; ... or the line's first, when the change may
  023F'   7E                    	MOV	A,M		;   lie before both ('u')
  0240'   36 00                 	MVI	M,0
  0242'   B7                    	ORA	A
  0243'   79                    	MOV	A,C
  0244'   CA 0248'              	JZ	SD_1A
  0247'   AF                    	XRA	A
  0248'                         SD_1A:
  0248'   80                    	ADD	B
  0249'   4F                    	MOV	C,A
  024A'   2A 1087'              	LHLD	OLDCR		; E = the rows the line had (H: the line's under)
  024D'   5D                    	MOV	E,L
  024E'   3A 1079'              	LDA	LYTSH
  0251'   57                    	MOV	D,A		; D = the rows it has
  0252'   3A 0000*              	LDA	RINTENT
  0255'   B7                    	ORA	A
  0256'   CA 0508'              	JZ	SCFULL		; R_FULL
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0259'   FE 05                 	CPI	R_ILIN
  025B'   CA 028E'              	JZ	SD_IL
  025E'   E5                    	PUSH	H
  025F'   2A 10A7'              	LHLD	LYDLT
  0262'   7C                    	MOV	A,H
  0263'   B5                    	ORA	L
  0264'   E1                    	POP	H
  0265'   3A 0000*              	LDA	RINTENT		; (keeps the flags)
  0268'   C2 02D9'              	JNZ	SD_OL		; the cursor is on another line
  026B'   FE 01                 	CPI	R_MOVE
  026D'   C2 0272'              	JNZ	SD_2
  0270'   0E FF                 	MVI	C,0FFH		; a move: none of the line to draw
  0272'                         SD_2:
  0272'   FE 03                 	CPI	R_DLIN
  0274'   C2 0279'              	JNZ	SD_3
  0277'   16 00                 	MVI	D,0		; the line went
  0279'                         SD_3:
  0279'   FE 06                 	CPI	R_JOIN
  027B'   C2 0281'              	JNZ	SD_AN
  027E'   7B                    	MOV	A,E		; the line under it went into it
  027F'   84                    	ADD	H
  0280'   5F                    	MOV	E,A
  0281'                         SD_AN:
  0281'   3A 1084'              	LDA	OLDAB		; where the edit starts was that much lower: the
  0284'   90                    	SUB	B		;   rows the screen gave up at the top.  Higher,
  0285'   DA 0508'              	JC	SCFULL		;   and it is no paint of these
  0288'   32 1089'              	STA	OPN
  028B'   C3 0337'              	JMP	SD_GO
                                
                                	;--- R_ILIN: ILN lines opened at the cursor ---
  028E'                         SD_IL:
  028E'   2A 10A7'              	LHLD	LYDLT
  0291'   7C                    	MOV	A,H
  0292'   B7                    	ORA	A
  0293'   C2 0508'              	JNZ	SCFULL
  0296'   48                    	MOV	C,B		; drawn from the cursor's row, the first opened
  0297'   57                    	MOV	D,A		; (no rows yet)
  0298'   5F                    	MOV	E,A		; (none were there)
  0299'   B5                    	ORA	L
  029A'   CA 02C3'              	JZ	SI_2		; opened where the cursor's line was: 'O', 'P'
  029D'   3D                    	DCR	A
  029E'   C2 0508'              	JNZ	SCFULL
  02A1'   3A 106D'              	LDA	WINROW		; opened under it: it is the line above now, and
  02A4'   B7                    	ORA	A		;   has to be on the screen
  02A5'   CA 0508'              	JZ	SCFULL
  02A8'   3A 0000*              	LDA	HTCUR
  02AB'   3D                    	DCR	A
  02AC'   CD 0B6F'              	CALL	HTE
  02AF'   56                    	MOV	D,M		; D = that line's rows now
  02B0'   78                    	MOV	A,B
  02B1'   92                    	SUB	D
  02B2'   47                    	MOV	B,A		; the edit starts with it
  02B3'   3A 1087'              	LDA	OLDCR
  02B6'   5F                    	MOV	E,A
  02B7'   3A 0000*              	LDA	ILABOV		; text came off it: drawn from the row the
  02BA'   B7                    	ORA	A		;   cursor was on
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  02BB'   CA 02C3'              	JZ	SI_2
  02BE'   3A 1086'              	LDA	OLDCS
  02C1'   80                    	ADD	B
  02C2'   4F                    	MOV	C,A
  02C3'                         SI_2:
  02C3'   C5                    	PUSH	B
  02C4'   D5                    	PUSH	D
  02C5'   3A 0000*              	LDA	ILN
  02C8'   47                    	MOV	B,A
  02C9'   3A 0000*              	LDA	HTCUR
  02CC'   CD 059B'              	CALL	SUMX		; A = the rows the opened lines take
  02CF'   D1                    	POP	D
  02D0'   C1                    	POP	B
  02D1'   DA 0508'              	JC	SCFULL		; (more than the screen shows)
  02D4'   82                    	ADD	D
  02D5'   57                    	MOV	D,A
  02D6'   C3 0281'              	JMP	SD_AN
                                
                                	;--- a move to another line: the text scrolled SCRLN lines ---
  02D9'                         SD_OL:
  02D9'   FE 01                 	CPI	R_MOVE
  02DB'   CA 02F5'              	JZ	SD_OM
  02DE'   FE 03                 	CPI	R_DLIN		; the line went, and the cursor is on the one
  02E0'   C2 0508'              	JNZ	SCFULL		;   over it ('u' of a 'p'): the edit starts
  02E3'   2A 10A7'              	LHLD	LYDLT		;   under that line's rows
  02E6'   23                    	INX	H
  02E7'   7C                    	MOV	A,H
  02E8'   B5                    	ORA	L
  02E9'   C2 0508'              	JNZ	SCFULL
  02EC'   78                    	MOV	A,B
  02ED'   82                    	ADD	D
  02EE'   47                    	MOV	B,A
  02EF'   4F                    	MOV	C,A
  02F0'   16 00                 	MVI	D,0
  02F2'   C3 0281'              	JMP	SD_AN
  02F5'                         SD_OM:
  02F5'   2A 1091'              	LHLD	SCRLN
  02F8'   7C                    	MOV	A,H
  02F9'   B5                    	ORA	L
  02FA'   CA 0FE5'              	JZ	SCSTL		; it stood still: the cursor alone
  02FD'   7C                    	MOV	A,H
  02FE'   B7                    	ORA	A
  02FF'   CA 0316'              	JZ	SO_UP
  0302'   3C                    	INR	A
  0303'   C2 0508'              	JNZ	SCFULL
  0306'   95                    	SUB	L		; down: the new lines at the top, and their rows
  0307'   CA 0508'              	JZ	SCFULL
  030A'   CD 0597'              	CALL	SUMT
  030D'   DA 0508'              	JC	SCFULL
  0310'   32 108A'              	STA	OPM
  0313'   C3 0332'              	JMP	SO_GO
  0316'                         SO_UP:
  0316'   3A 1083'              	LDA	OLDBOT		; up: the last line that showed is that many
  0319'   95                    	SUB	L		;   lines higher.  The row after it was OLDTX,
  031A'   DA 0508'              	JC	SCFULL		;   and is the rows down to it now
  031D'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  031E'   CD 0597'              	CALL	SUMT
  0321'   DA 0508'              	JC	SCFULL
  0324'   47                    	MOV	B,A
  0325'   3A 1081'              	LDA	OLDTX
  0328'   90                    	SUB	B
  0329'   DA 0508'              	JC	SCFULL
  032C'   CA 0508'              	JZ	SCFULL
  032F'   32 1089'              	STA	OPN
  0332'                         SO_GO:
  0332'   11 0000               	LXI	D,0		; no edit
  0335'   0E FF                 	MVI	C,0FFH
                                
                                	;--- B = the edit's first row, C = the first to draw, D = its rows
                                	;    now, E = its rows before ---
  0337'                         SD_GO:
  0337'   78                    	MOV	A,B
  0338'   32 108D'              	STA	EDR
  033B'   82                    	ADD	D
  033C'   47                    	MOV	B,A		; B = the row after its last
  033D'   3A 106C'              	LDA	NEDIT
  0340'   B8                    	CMP	B
  0341'   DA 0508'              	JC	SCFULL		; (it runs off the screen)
  0344'   79                    	MOV	A,C
  0345'   32 108E'              	STA	EDP
  0348'   EB                    	XCHG
  0349'   22 108B'              	SHLD	EDA		; (and EDB)
  034C'   EB                    	XCHG
  034D'   2A 1089'              	LHLD	OPN
  0350'   7C                    	MOV	A,H
  0351'   B5                    	ORA	L
  0352'   C2 0371'              	JNZ	SD_PT
  0355'   7A                    	MOV	A,D
  0356'   BB                    	CMP	E
  0357'   C2 0371'              	JNZ	SD_PT
  035A'   79                    	MOV	A,C		; nothing moves.  Nothing to draw either: the
  035B'   B8                    	CMP	B		;   cursor alone
  035C'   D2 0FE5'              	JNC	SCSTL
  035F'   3C                    	INR	A
  0360'   B8                    	CMP	B
  0361'   C2 0371'              	JNZ	SD_PT
  0364'   3A 0000*              	LDA	RINTENT		; the line's last row, the cursor on it before
  0367'   FE 04                 	CPI	R_ICH		;   and after: a cell opened or closed there is
  0369'   CA 0416'              	JZ	SC_ICH		;   the whole of it
  036C'   FE 07                 	CPI	R_DCH
  036E'   CA 0452'              	JZ	SC_DCH
  0371'                         SD_PT:
  0371'   2A 106F'              	LHLD	SKIPR		; ('<<<' on the top row is not theirs to keep)
  0374'   7C                    	MOV	A,H
  0375'   B5                    	ORA	L
  0376'   C2 0508'              	JNZ	SCFULL
  0379'   CD 0084'              	CALL	CHIDE
  037C'   2A 1089'              	LHLD	OPN
  037F'   EB                    	XCHG
  0380'   2A 108B'              	LHLD	EDA
  0383'   7A                    	MOV	A,D
  0384'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0385'   C2 038D'              	JNZ	SD_SH
  0388'   7C                    	MOV	A,H
  0389'   BD                    	CMP	L
  038A'   CA 03A5'              	JZ	SD_NS
  038D'                         SD_SH:
  038D'   CD 05C4'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0390'   2A 1089'              	LHLD	OPN
  0393'   06 00                 	MVI	B,0
  0395'   CD 0562'              	CALL	SHFT
  0398'   2A 108B'              	LHLD	EDA
  039B'   3A 108D'              	LDA	EDR
  039E'   47                    	MOV	B,A
  039F'   CD 0562'              	CALL	SHFT
  03A2'   CD 008F'              	CALL	CRGRS
  03A5'                         SD_NS:
  03A5'   06 00                 	MVI	B,0
  03A7'   3A 108A'              	LDA	OPM
  03AA'   4F                    	MOV	C,A
  03AB'   CD 00A1'              	CALL	PRNG		; the rows opened at the top
  03AE'   2A 108B'              	LHLD	EDA
  03B1'   3A 108D'              	LDA	EDR
  03B4'   84                    	ADD	H
  03B5'   4F                    	MOV	C,A
  03B6'   3A 108E'              	LDA	EDP
  03B9'   47                    	MOV	B,A
  03BA'   CD 00A1'              	CALL	PRNG		; the edit's own
                                	;--- the bottom.  The rows that were good to the end of the screen
                                	;    (all of them, or as far as the '@' rows) moved with the text; what
                                	;    lies between where they end now and where good rows should end is
                                	;    drawn, and so are the rows a move up left bare ---
  03BD'   2A 1081'              	LHLD	OLDTX
  03C0'   CD 05BB'              	CALL	TEV
  03C3'   47                    	MOV	B,A
  03C4'   2A 1073'              	LHLD	TXEND
  03C7'   CD 05BB'              	CALL	TEV
  03CA'   4F                    	MOV	C,A
  03CB'   2A 1089'              	LHLD	OPN
  03CE'   EB                    	XCHG			; E = OPN, D = OPM
  03CF'   2A 108B'              	LHLD	EDA		; L = EDA, H = EDB
  03D2'   7A                    	MOV	A,D
  03D3'   84                    	ADD	H
  03D4'   57                    	MOV	D,A		; D = the rows that came
  03D5'   7B                    	MOV	A,E
  03D6'   85                    	ADD	L
  03D7'   92                    	SUB	D		; A = the rows that went, less those
  03D8'   21 106C'              	LXI	H,NEDIT
  03DB'   5E                    	MOV	E,M
  03DC'   DA 03EC'              	JC	SB_DN
  03DF'   57                    	MOV	D,A		; the text under them moved up D rows
  03E0'   7B                    	MOV	A,E
  03E1'   92                    	SUB	D
  03E2'   5F                    	MOV	E,A		; E = the first row that left bare
  03E3'   78                    	MOV	A,B
  03E4'   92                    	SUB	D
  03E5'   D2 03F7'              	JNC	SB_1
  03E8'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  03E9'   C3 03F7'              	JMP	SB_1
  03EC'                         SB_DN:
  03EC'   2F                    	CMA
  03ED'   3C                    	INR	A		; ... or down that many
  03EE'   80                    	ADD	B
  03EF'   DA 03F6'              	JC	SB_0
  03F2'   BB                    	CMP	E
  03F3'   DA 03F7'              	JC	SB_1
  03F6'                         SB_0:
  03F6'   7B                    	MOV	A,E
  03F7'                         SB_1:
  03F7'   B9                    	CMP	C		; A = where the old good rows end now
  03F8'   47                    	MOV	B,A
  03F9'   DA 03FE'              	JC	SB_2
  03FC'   41                    	MOV	B,C
  03FD'   4F                    	MOV	C,A
  03FE'                         SB_2:
  03FE'   C5                    	PUSH	B
  03FF'   D5                    	PUSH	D
  0400'   CD 00A1'              	CALL	PRNG
  0403'   D1                    	POP	D
  0404'   C1                    	POP	B
  0405'   79                    	MOV	A,C
  0406'   BB                    	CMP	E
  0407'   D2 040B'              	JNC	SB_3
  040A'   7B                    	MOV	A,E
  040B'                         SB_3:
  040B'   47                    	MOV	B,A
  040C'   3A 106C'              	LDA	NEDIT
  040F'   4F                    	MOV	C,A
  0410'   CD 00A1'              	CALL	PRNG
  0413'   C3 0FC2'              	JMP	SCURS
                                
                                ;SC_ICH -- R_ICH: a char was typed at the cell the cursor was on, which is
                                ; where the terminal's cursor still is.  ICH (ESC[1@) opens a cell there and
                                ; the char fills it; appended at the row's end (ICHAPP) the cell is blank and
                                ; nothing follows it, so the char alone is the whole frame.  Either way the
                                ; terminal leaves the cursor at SCOL, where insert mode wants it.
                                ; ICHAPP = 2 is 'r': the char took the place of the one under the cursor and
                                ; is under it still, so it is sent and the cursor put back on it.
  0416'                         SC_ICH:
  0416'   3A 0000*              	LDA	ICHAPP
  0419'   FE 03                 	CPI	3
  041B'   C2 0431'              	JNZ	SC_IC0
  041E'   16 FF                 	MVI	D,0FFH		; a TAB follows, and went right one
  0420'   3A 1072'              	LDA	SCOL
  0423'   CD 04A5'              	CALL	SEGQ
  0426'   2A 0000*              	LHLD	GAPBEG
  0429'   2B                    	DCX	H
  042A'   7E                    	MOV	A,M
  042B'   CD 0018'              	CALL	OUTCH
  042E'   C3 04EB'              	JMP	SEGO
  0431'                         SC_IC0:
  0431'   FE 02                 	CPI	2
  0433'   C2 0440'              	JNZ	SC_IC1
  0436'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0439'   7E                    	MOV	A,M
  043A'   CD 0018'              	CALL	OUTCH
  043D'   C3 0FC2'              	JMP	SCURS
  0440'                         SC_IC1:
  0440'   B7                    	ORA	A
  0441'   C2 044A'              	JNZ	SC_ICC
  0444'   21 102A'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  0447'   CD 0025'              	CALL	OUTSTR
  044A'                         SC_ICC:
  044A'   2A 0000*              	LHLD	GAPBEG		; the byte typed is right before the gap
  044D'   2B                    	DCX	H
  044E'   7E                    	MOV	A,M
  044F'   C3 0018'              	JMP	OUTCH
                                
                                ;SC_DCH -- R_DCH: DCHN cells went at the cell the cursor was on, which is
                                ; where the terminal's cursor still is: delete-character (ESC[<n>P) there
                                ; draws the rest of the row up, and the cursor is moved only if the delete
                                ; took the line's last char from under it.
                                ; DCHBS: the cell was the one left of the cursor (insert's BS).  The cursor
                                ; steps back onto it first, and is then where it belongs.
  0452'                         SC_DCH:
  0452'   3A 0000*              	LDA	DCHBS
  0455'   E6 02                 	ANI	2
  0457'   CA 0478'              	JZ	SC_DC1
  045A'   3A 0000*              	LDA	DCHN		; a TAB follows, and came left that many
  045D'   57                    	MOV	D,A
  045E'   3A 0000*              	LDA	DCHBS
  0461'   1F                    	RAR
  0462'   3A 1080'              	LDA	OLDSC+1
  0465'   D2 0469'              	JNC	SC_DC0
  0468'   3D                    	DCR	A
  0469'                         SC_DC0:
  0469'   CD 04A5'              	CALL	SEGQ
  046C'   3A 0000*              	LDA	DCHBS
  046F'   1F                    	RAR
  0470'   3E 08                 	MVI	A,BS
  0472'   DC 0018'              	CC	OUTCH
  0475'   C3 04EB'              	JMP	SEGO
  0478'                         SC_DC1:
  0478'   3A 0000*              	LDA	DCHBS
  047B'   B7                    	ORA	A
  047C'   3E 08                 	MVI	A,BS
  047E'   C4 0018'              	CNZ	OUTCH
  0481'   21 1027'              	LXI	H,SCSI
  0484'   CD 0025'              	CALL	OUTSTR
  0487'   3A 0000*              	LDA	DCHN
  048A'   CD 002F'              	CALL	EMITB
  048D'   3E 50                 	MVI	A,'P'
  048F'   CD 0018'              	CALL	OUTCH
  0492'   3A 0000*              	LDA	DCHBS
  0495'   B7                    	ORA	A
  0496'   C0                    	RNZ
  0497'   2A 107F'              	LHLD	OLDSC
  049A'   EB                    	XCHG
  049B'   2A 1071'              	LHLD	SROW
  049E'   CD 0000*              	CALL	CMP16
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  04A1'   C8                    	RZ
  04A2'   C3 0FC2'              	JMP	SCURS
                                
                                ;SEGQ -- a TAB follows the edit, and nothing past it has moved if it ends
                                ; where it did.  A = the screen column of the first char after the edit, D =
                                ; the cells the TAB came left (0FFH: it went right one).  If it ends there
                                ; still, B = the chars before it and C = the cells it takes now: all there is
                                ; to paint.  If not -- or the chars before it are not plain ones, or it runs
                                ; past the row -- the row is painted, and the return is not taken.
  04A5'                         SEGQ:
  04A5'   4F                    	MOV	C,A
  04A6'   3A 106B'              	LDA	NCOLS
  04A9'   91                    	SUB	C
  04AA'   3C                    	INR	A
  04AB'   47                    	MOV	B,A		; B = the cells from there to the row's end
  04AC'   21 1072'              	LXI	H,SCOL
  04AF'   3A 10A5'              	LDA	CURDCL
  04B2'   96                    	SUB	M
  04B3'   81                    	ADD	C
  04B4'   5F                    	MOV	E,A		; E = its column in the line (the low bits)
  04B5'   2A 0000*              	LHLD	GAPEND
  04B8'   0E 00                 	MVI	C,0
  04BA'                         SQ_1:
  04BA'   7E                    	MOV	A,M
  04BB'   FE 09                 	CPI	TAB
  04BD'   CA 04D4'              	JZ	SQ_2
  04C0'   FE 20                 	CPI	' '
  04C2'   DA 04D0'              	JC	SQ_NO
  04C5'   FE 7F                 	CPI	DEL
  04C7'   D2 04D0'              	JNC	SQ_NO
  04CA'   23                    	INX	H
  04CB'   1C                    	INR	E
  04CC'   0C                    	INR	C
  04CD'   C2 04BA'              	JNZ	SQ_1
  04D0'                         SQ_NO:
  04D0'   E1                    	POP	H
  04D1'   C3 0371'              	JMP	SD_PT
  04D4'                         SQ_2:
  04D4'   7B                    	MOV	A,E
  04D5'   E6 07                 	ANI	7
  04D7'   5F                    	MOV	E,A
  04D8'   82                    	ADD	D		; where it was: under the same stop?
  04D9'   FE 08                 	CPI	8
  04DB'   D2 04D0'              	JNC	SQ_NO
  04DE'   3E 08                 	MVI	A,8
  04E0'   93                    	SUB	E
  04E1'   5F                    	MOV	E,A		; E = the TAB's cells
  04E2'   81                    	ADD	C
  04E3'   3D                    	DCR	A
  04E4'   B8                    	CMP	B
  04E5'   D2 04D0'              	JNC	SQ_NO
  04E8'   41                    	MOV	B,C
  04E9'   4B                    	MOV	C,E
  04EA'   C9                    	RET
                                
                                ;SEGO -- send them: the B chars after the cursor and C blanks, and the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                ; back where it belongs.
  04EB'                         SEGO:
  04EB'   2A 0000*              	LHLD	GAPEND
  04EE'                         SE_1:
  04EE'   78                    	MOV	A,B
  04EF'   B7                    	ORA	A
  04F0'   CA 04FC'              	JZ	SE_2
  04F3'   7E                    	MOV	A,M
  04F4'   CD 0018'              	CALL	OUTCH
  04F7'   23                    	INX	H
  04F8'   05                    	DCR	B
  04F9'   C3 04EE'              	JMP	SE_1
  04FC'                         SE_2:
  04FC'   3E 20                 	MVI	A,' '
  04FE'   CD 0018'              	CALL	OUTCH
  0501'   0D                    	DCR	C
  0502'   C2 04FC'              	JNZ	SE_2
  0505'   C3 0FC2'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place, each cleared with ESC[K; a line
                                ; takes as many rows as it is wide, and the rows past the text show '~' (or
                                ; '@').  No ESC[2J (no blank flash).  Message row last; cursor hidden
                                ; throughout, then addressed and shown.
                                ; FORCEF is set until the frame is whole.  A key that arrives part-way cuts it
                                ; short (PRNG): the pending key is dispatched, and the next SCDRAW repaints in
                                ; FULL even if that key is a pure motion (RENDER.md: an aborted frame stays
                                ; dirty -- no cheap paint over a half-painted screen).
  0508'                         SCFULL:
  0508'   CD 0084'              	CALL	CHIDE
  050B'   3E 01                 	MVI	A,1
  050D'   32 109B'              	STA	FORCEF
  0510'   06 00                 	MVI	B,0
  0512'   3A 106C'              	LDA	NEDIT
  0515'   4F                    	MOV	C,A
  0516'   CD 00A1'              	CALL	PRNG
  0519'   CD 013A'              	CALL	PT_NL
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  051C'   CD 009B'              	CALL	CEKL
  051F'   2A 106F'              	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
  0522'   7C                    	MOV	A,H		;   over its first cells says so, as vim's does
  0523'   B5                    	ORA	L
  0524'   CA 0530'              	JZ	ROWS_M
  0527'   CD 0149'              	CALL	GOTOP
  052A'   21 1066'              	LXI	H,SSKIP
  052D'   CD 0025'              	CALL	OUTSTR
  0530'                         ROWS_M:
  0530'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  0532'   32 109C'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  0535'   CD 0FC2'              	CALL	SCURS
  0538'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  0539'   32 109B'              	STA	FORCEF
  053C'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


                                ; MODEMS does not blank it out from under the message on the next frame.
  053D'                         EXPRM:
  053D'   F5                    	PUSH	PSW
  053E'   3A 0000*              	LDA	EDMODE
  0541'   32 109C'              	STA	OEDMOD
  0544'   3A 106A'              	LDA	NROWS
  0547'   CD 0095'              	CALL	GOROW1
  054A'   F1                    	POP	PSW
  054B'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  054E'                         EXRUB:
  054E'   21 0554'              	LXI	H,SRUB
  0551'   C3 0025'              	JMP	OUTSTR
  0554'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  0558'                         EXMSG:
  0558'   7E                    	MOV	A,M
  0559'   23                    	INX	H
  055A'   E5                    	PUSH	H
  055B'   CD 053D'              	CALL	EXPRM
  055E'   E1                    	POP	H
  055F'   C3 0025'              	JMP	OUTSTR
                                
                                ;SHFT -- B = a row (from 0), L = the rows that were there, H = the rows that
                                ; are: open rows under those that were (IL), or delete under those that stay
                                ; (DL), so that everything below is where it belongs.  In a scroll region.
  0562'                         SHFT:
  0562'   7C                    	MOV	A,H
  0563'   95                    	SUB	L
  0564'   C8                    	RZ
  0565'   1E 4C                 	MVI	E,'L'
  0567'   57                    	MOV	D,A
  0568'   7D                    	MOV	A,L
  0569'   D2 0572'              	JNC	SH_1
  056C'   7D                    	MOV	A,L
  056D'   94                    	SUB	H
  056E'   57                    	MOV	D,A
  056F'   1E 4D                 	MVI	E,'M'
  0571'   7C                    	MOV	A,H
  0572'                         SH_1:
  0572'   80                    	ADD	B
  0573'   21 106C'              	LXI	H,NEDIT
  0576'   BE                    	CMP	M
  0577'   D0                    	RNC			; (under the last edit row: nothing there to move)
  0578'   3C                    	INR	A
  0579'   47                    	MOV	B,A
  057A'   0E 01                 	MVI	C,1
  057C'   CD 0064'              	CALL	GOTOXY
  057F'   21 1027'              	LXI	H,SCSI
  0582'   CD 0025'              	CALL	OUTSTR
  0585'   7A                    	MOV	A,D
  0586'   CD 002F'              	CALL	EMITB
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  0589'   7B                    	MOV	A,E
  058A'   C3 0018'              	JMP	OUTCH
                                
                                ;HTTOP -- HL -> the row table's entry for the top line, A = which it is.
  058D'                         HTTOP:
  058D'   3A 0000*              	LDA	HTCUR
  0590'   21 106D'              	LXI	H,WINROW
  0593'   96                    	SUB	M
  0594'   C3 0B6F'              	JMP	HTE
                                
                                ;SUMT -- A = a count of lines from the top one: A = the rows they take.
                                ;SUMX -- the same for the B lines from the table's entry A.
                                ; CY if the table has not so many, or they are a screenful and more.
  0597'                         SUMT:
  0597'   47                    	MOV	B,A
  0598'   CD 058D'              	CALL	HTTOP
  059B'                         SUMX:
  059B'   4F                    	MOV	C,A
  059C'   80                    	ADD	B
  059D'   5F                    	MOV	E,A
  059E'   3A 0000*              	LDA	HTN
  05A1'   BB                    	CMP	E
  05A2'   D8                    	RC
  05A3'   79                    	MOV	A,C
  05A4'   CD 0B6F'              	CALL	HTE
  05A7'   AF                    	XRA	A
  05A8'   04                    	INR	B
  05A9'                         SM_LP:
  05A9'   05                    	DCR	B
  05AA'   CA 05B3'              	JZ	SM_DN
  05AD'   86                    	ADD	M
  05AE'   D8                    	RC
  05AF'   23                    	INX	H
  05B0'   C3 05A9'              	JMP	SM_LP
  05B3'                         SM_DN:
  05B3'   47                    	MOV	B,A
  05B4'   3A 106C'              	LDA	NEDIT
  05B7'   3D                    	DCR	A
  05B8'   B8                    	CMP	B
  05B9'   78                    	MOV	A,B
  05BA'   C9                    	RET
                                
                                ;TEV -- HL = a frame's TXEND and FILCH: A = the row its good rows end at.
                                ; Rows of '~' are as good as text (they stay '~' wherever they move); rows of
                                ; '@' are not.
  05BB'                         TEV:
  05BB'   7C                    	MOV	A,H
  05BC'   FE 40                 	CPI	'@'
  05BE'   7D                    	MOV	A,L
  05BF'   C8                    	RZ
  05C0'   3A 106C'              	LDA	NEDIT
  05C3'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  05C4'                         SRGN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  05C4'   21 102F'              	LXI	H,SRGP
  05C7'   CD 0025'              	CALL	OUTSTR
  05CA'   3A 106C'              	LDA	NEDIT
  05CD'   CD 002F'              	CALL	EMITB
  05D0'   3E 72                 	MVI	A,'r'
  05D2'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
                                ; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
                                ; above take, at column CURDCL mod NCOLS.  Emits nothing.
  05D5'                         CURSC:
  05D5'   2A 10A5'              	LHLD	CURDCL
  05D8'   CD 0607'              	CALL	DIVN		; BC = rows into the line, A = the column
  05DB'   3C                    	INR	A
  05DC'   32 1072'              	STA	SCOL
  05DF'   79                    	MOV	A,C
  05E0'   32 10A0'              	STA	CSUB
  05E3'   2A 106F'              	LHLD	SKIPR
  05E6'   EB                    	XCHG
  05E7'   2A 1076'              	LHLD	LYABV
  05EA'   09                    	DAD	B
  05EB'   23                    	INX	H
  05EC'   CD 0000*              	CALL	SUBHD		; (less the rows of it that are off the top)
  05EF'   7C                    	MOV	A,H		; (never past the edit rows)
  05F0'   B7                    	ORA	A
  05F1'   3A 106C'              	LDA	NEDIT
  05F4'   C2 05FC'              	JNZ	CS_SET
  05F7'   BD                    	CMP	L		; CY iff NEDIT < the row
  05F8'   DA 05FC'              	JC	CS_SET
  05FB'   7D                    	MOV	A,L
  05FC'                         CS_SET:
  05FC'   32 1071'              	STA	SROW
  05FF'   C9                    	RET
                                
                                ;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
                                ; Falls into DIVN.
  0600'                         XTRA:
  0600'   01 0000               	LXI	B,0
  0603'   7C                    	MOV	A,H
  0604'   B5                    	ORA	L
  0605'   C8                    	RZ			; an empty line is one row
  0606'   2B                    	DCX	H
                                ;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
  0607'                         DIVN:
  0607'   3A 106B'              	LDA	NCOLS
  060A'   2F                    	CMA
  060B'   5F                    	MOV	E,A
  060C'   16 FF                 	MVI	D,0FFH
  060E'   13                    	INX	D		; DE = -NCOLS
  060F'   01 FFFF               	LXI	B,0FFFFH
  0612'                         DV_LP:
  0612'   03                    	INX	B
  0613'   19                    	DAD	D		; CY while NCOLS still went into it
  0614'   DA 0612'              	JC	DV_LP
  0617'   3A 106B'              	LDA	NCOLS
  061A'   85                    	ADD	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  061B'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- where the cursor's line sits on the screen and what the screen
                                ; holds.  Emits nothing.
                                ;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
                                ;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
                                ;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
                                ;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
                                ;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
                                ;        what they show), SCBOT, SCEOF, SCBOF, NXTR, TALLF; the row table
                                ;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
                                ;        LNDLT and PLACE cleared.
                                ; The lines are measured once, into the row table (HTBLD): as many above the
                                ; cursor's as the placement could want, and a screenful of rows from it on.
                                ; Everything after that is arithmetic on the table: which line is the top one
                                ; (as many of the lines wanted above as leave the cursor's whole line room),
                                ; and how far down the text goes.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  061C'                         LAYOUT:
  061C'   2A 0000*              	LHLD	CMDCNT
  061F'   22 10B8'              	SHLD	SVCNT
  0622'   2A 0000*              	LHLD	AUXCNT
  0625'   22 10BA'              	SHLD	SVAUX
  0628'   3A 0000*              	LDA	DIRFLG
  062B'   32 10BC'              	STA	SVDIR
  062E'   CD 07B0'              	CALL	LYQK		; a move about a screen that stands: no more to do
  0631'   DA 079A'              	JC	LY_TC
  0634'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  0637'   32 10A9'              	STA	LYROW
  063A'   32 10B4'              	STA	LYSVR
  063D'   AF                    	XRA	A
  063E'   32 10B2'              	STA	LYND
  0641'   32 10B3'              	STA	LYPRF
  0644'   3A 109F'              	LDA	PLACE		; a line the command placed stays where it was
  0647'   B7                    	ORA	A		;   put; one that only moved is asked about
  0648'   CC 0C03'              	CZ	LYFAR
  064B'   2A 0000*              	LHLD	LNDLT
  064E'   22 10A7'              	SHLD	LYDLT
  0651'   7C                    	MOV	A,H
  0652'   B5                    	ORA	L
  0653'   21 0000               	LXI	H,0
  0656'   22 0000*              	SHLD	LNDLT
  0659'   47                    	MOV	B,A
  065A'   3A 109F'              	LDA	PLACE		; the cursor on another line, or its line put
  065D'   B0                    	ORA	B		;   somewhere by the command: a line starts with
  065E'   CA 0664'              	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
  0661'   22 106F'              	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
  0664'                         LY_SAM:
                                	;--- the lines to measure above the cursor's: those it has over it now,
                                	;    or all a screen could show when it is to be placed afresh (but no
