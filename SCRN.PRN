  0CF4'   59                    	MOV	E,C
  0CF5'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0CF8'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0CF9'   DA 0D17'              	JC	HB_SS		; then that is the first
  0CFC'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0CFF'   7C                    	MOV	A,H
  0D00'   B7                    	ORA	A
  0D01'   C2 0D0D'              	JNZ	HB_SD
  0D04'   3A 106C'              	LDA	NEDIT
  0D07'   3D                    	DCR	A
  0D08'   BD                    	CMP	L		; CY iff that is under the last edit row
  0D09'   EB                    	XCHG			; HL = SKIPR, as it was
  0D0A'   D2 0D17'              	JNC	HB_SS
  0D0D'                         HB_SD:
  0D0D'   3A 106C'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0D10'   2F                    	CMA
  0D11'   6F                    	MOV	L,A
  0D12'   26 FF                 	MVI	H,0FFH
  0D14'   23                    	INX	H
  0D15'   23                    	INX	H
  0D16'   09                    	DAD	B
  0D17'                         HB_SS:
  0D17'   22 106F'              	SHLD	SKIPR
  0D1A'   EB                    	XCHG
  0D1B'   60                    	MOV	H,B
  0D1C'   69                    	MOV	L,C
  0D1D'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0D20'   7D                    	MOV	A,L
  0D21'   32 1078'              	STA	CSRAW
  0D24'   D1                    	POP	D
  0D25'   57                    	MOV	D,A
  0D26'   CD 0000*              	CALL	RGET0
  0D29'   CD 0BC3'              	CALL	LM_FL		; the rest of the line: D = its last row
  0D2C'   F5                    	PUSH	PSW
  0D2D'   FE 01                 	CPI	1
  0D2F'   CA 0DBE'              	JZ	HB_TO		; more rows than the screen has
  0D32'   2A 106F'              	LHLD	SKIPR
  0D35'   7C                    	MOV	A,H
  0D36'   B5                    	ORA	L
  0D37'   CA 0D5A'              	JZ	HB_E2
  0D3A'   7C                    	MOV	A,H
  0D3B'   B7                    	ORA	A
  0D3C'   C2 0D55'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0D3F'   7D                    	MOV	A,L
  0D40'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0D41'   DA 0D55'              	JC	HB_TE
  0D44'   21 106C'              	LXI	H,NEDIT
  0D47'   BE                    	CMP	M
  0D48'   D2 0D55'              	JNC	HB_TE		; more than NEDIT of them
  0D4B'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0D4C'   21 0000               	LXI	H,0
  0D4F'   22 106F'              	SHLD	SKIPR
  0D52'   C3 0D5A'              	JMP	HB_E2
  0D55'                         HB_TE:
  0D55'   3E 01                 	MVI	A,1
  0D57'   32 1090'              	STA	TALLF
