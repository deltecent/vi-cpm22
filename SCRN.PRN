  0B0A'   EB                    	XCHG
  0B0B'   60                    	MOV	H,B
  0B0C'   69                    	MOV	L,C
  0B0D'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0B10'   7D                    	MOV	A,L
  0B11'   32 0DDF'              	STA	CSRAW
  0B14'   D1                    	POP	D
  0B15'   57                    	MOV	D,A
  0B16'   CD 0000*              	CALL	RGET0
