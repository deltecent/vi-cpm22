  0917'   3A 0E16'              	LDA	LYMBL
  091A'   21 0E18'              	LXI	H,LYPRF
  091D'   86                    	ADD	M
  091E'   47                    	MOV	B,A
  091F'   3A 0E15'              	LDA	LYMAB
  0922'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0923'   DA 092D'              	JC	LM_U		;   many, when above goes first)
  0926'   CD 094D'              	CALL	LMBLW
  0929'   D2 0917'              	JNC	LM_LP
  092C'   C9                    	RET
  092D'                         LM_U:
  092D'   CD 097B'              	CALL	LMABV
  0930'   D2 0917'              	JNC	LM_LP
  0933'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0934'                         LYINI:
  0934'   AF                    	XRA	A
  0935'   32 0E0E'              	STA	LYROW
  0938'   32 0E15'              	STA	LYMAB
  093B'   32 0E16'              	STA	LYMBL
  093E'   3A 0000*              	LDA	HTCUR
  0941'   CD 0997'              	CALL	HTE
  0944'   7E                    	MOV	A,M
  0945'   32 0E14'              	STA	LYUSE
  0948'   23                    	INX	H
  0949'   22 0E0F'              	SHLD	LYIB
  094C'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  094D'                         LMBLW:
  094D'   3A 0000*              	LDA	HTN
  0950'   CD 0997'              	CALL	HTE
  0953'   EB                    	XCHG
  0954'   2A 0E0F'              	LHLD	LYIB
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0957'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  095A'   C2 0969'              	JNZ	LB_1
  095D'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0960'   B7                    	ORA	A
  0961'   37                    	STC
  0962'   C8                    	RZ
  0963'   21 0E16'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0966'   34                    	INR	M
  0967'   B7                    	ORA	A
  0968'   C9                    	RET
  0969'                         LB_1:
  0969'   7E                    	MOV	A,M
  096A'   CD 099F'              	CALL	LM_ADD
  096D'   D8                    	RC
  096E'   21 0E16'              	LXI	H,LYMBL
  0971'   86                    	ADD	M
  0972'   77                    	MOV	M,A
  0973'   2A 0E0F'              	LHLD	LYIB
  0976'   23                    	INX	H
  0977'   22 0E0F'              	SHLD	LYIB
  097A'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  097B'                         LMABV:
  097B'   21 0E0E'              	LXI	H,LYROW
  097E'   3A 0000*              	LDA	HTCUR
  0981'   96                    	SUB	M
  0982'   37                    	STC
  0983'   C8                    	RZ
  0984'   3D                    	DCR	A
  0985'   CD 0997'              	CALL	HTE
  0988'   7E                    	MOV	A,M
  0989'   CD 099F'              	CALL	LM_ADD
  098C'   D8                    	RC
  098D'   21 0E15'              	LXI	H,LYMAB
  0990'   86                    	ADD	M
  0991'   77                    	MOV	M,A
  0992'   21 0E0E'              	LXI	H,LYROW
  0995'   34                    	INR	M
  0996'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0997'                         HTE:
  0997'   5F                    	MOV	E,A
  0998'   16 00                 	MVI	D,0
  099A'   21 0000*              	LXI	H,HTAB
  099D'   19                    	DAD	D
  099E'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  099F'                         LM_ADD:
  099F'   47                    	MOV	B,A
  09A0'   3A 0E14'              	LDA	LYUSE
  09A3'   80                    	ADD	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09A4'   D8                    	RC
  09A5'   4F                    	MOV	C,A
  09A6'   3A 0DD3'              	LDA	NEDIT
  09A9'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  09AA'   D8                    	RC
  09AB'   79                    	MOV	A,C
  09AC'   32 0E14'              	STA	LYUSE
  09AF'   78                    	MOV	A,B
  09B0'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  09B1'                         LM_NX:
  09B1'   11 0000               	LXI	D,0
  09B4'   AF                    	XRA	A
  09B5'   32 0E11'              	STA	LYVB
  09B8'   2A 0E28'              	LHLD	RDBC
  09BB'   44                    	MOV	B,H
  09BC'   4D                    	MOV	C,L
  09BD'   2A 0E26'              	LHLD	RDHL
  09C0'                         LM_FL:
  09C0'   CD 087F'              	CALL	FLINE
  09C3'   22 0E26'              	SHLD	RDHL
  09C6'   60                    	MOV	H,B
  09C7'   69                    	MOV	L,C
  09C8'   22 0E28'              	SHLD	RDBC
  09CB'   B7                    	ORA	A
  09CC'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  09CD'                         LYTOPP:
  09CD'   2A 0E06'              	LHLD	TOPLEN
  09D0'   44                    	MOV	B,H
  09D1'   4D                    	MOV	C,L
  09D2'                         G2P:
  09D2'   EB                    	XCHG
  09D3'   2A 0000*              	LHLD	GAPBEG
  09D6'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  09D9'                         LNW:
  09D9'   11 0000               	LXI	D,0
  09DC'                         LNW_LP:
  09DC'   78                    	MOV	A,B
  09DD'   B1                    	ORA	C
  09DE'   C8                    	RZ
  09DF'   7E                    	MOV	A,M
  09E0'   23                    	INX	H
