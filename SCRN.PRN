                                ;LYSTP -- a move, in command mode, to a line the row table holds or the one
                                ; next past either end of it -- 'j' on the bottom line, 'k' on the top one.
                                ; The lines the table has are not read again: the cursor's line is found in
                                ; it, or measured (that line alone) and put on the end it belongs at.  What
                                ; HTBLD leaves for the cursor's line is left the same: HTCUR, CBOL, CURDCL,
                                ; CSRAW, LYTSH, and the table's ends (HTBOF, HTEOF).  LAYOUT then places the
                                ; screen by the table as it would have.
                                ;   out: CY when that is done; NC (BC kept) when HTBLD must: the table is not
                                ;        the screen's, the line is farther off, taller than the screen, or
                                ;        any of what LQGD looks for.
  0943'                         LYSTP:
  0943'   C5                    	PUSH	B
  0944'   CD 0949'              	CALL	LS_GO
  0947'   C1                    	POP	B
  0948'   C9                    	RET
  0949'                         LS_GO:
  0949'   3A 1054'              	LDA	LYOK
  094C'   B7                    	ORA	A
  094D'   C8                    	RZ
  094E'   CD 0A31'              	CALL	LQMV
  0951'   C2 087B'              	JNZ	LQK_N
  0954'   CD 0906'              	CALL	LQGD
  0957'   C2 087B'              	JNZ	LQK_N
  095A'   3A 1073'              	LDA	LYND
  095D'   B7                    	ORA	A
  095E'   C2 087B'              	JNZ	LQK_N
  0961'   2A 1068'              	LHLD	LYDLT
  0964'   3A 0000*              	LDA	HTCUR
  0967'   5F                    	MOV	E,A
  0968'   16 00                 	MVI	D,0
  096A'   19                    	DAD	D		; HL = its place in the table
  096B'   7C                    	MOV	A,H
  096C'   A5                    	ANA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  096D'   3C                    	INR	A
  096E'   CA 097D'              	JZ	LS_C		; -1: the line over the table's first
  0971'   7C                    	MOV	A,H
  0972'   B7                    	ORA	A
  0973'   C2 087B'              	JNZ	LQK_N
  0976'   3A 0000*              	LDA	HTN
  0979'   BD                    	CMP	L
  097A'   DA 087B'              	JC	LQK_N
  097D'                         LS_C:
  097D'   7D                    	MOV	A,L
  097E'   32 0000*              	STA	HTCUR
  0981'   CD 0921'              	CALL	LQCU
  0984'   3A 0000*              	LDA	HTCUR
  0987'   3C                    	INR	A
  0988'   CA 09A9'              	JZ	LS_M
  098B'   3D                    	DCR	A
  098C'   21 0000*              	LXI	H,HTN
  098F'   BE                    	CMP	M
  0990'   CA 09A9'              	JZ	LS_M		; the line under its last
  0993'   CD 0B66'              	CALL	HTE
  0996'   7E                    	MOV	A,M
  0997'   21 102D'              	LXI	H,NEDIT
  099A'   BE                    	CMP	M
  099B'   D2 087B'              	JNC	LQK_N		; (a screenful: it may be taller)
  099E'   32 103A'              	STA	LYTSH
  09A1'   CD 0000*              	CALL	RGET0		; the char under the cursor in memory (TABCUR)
  09A4'   CD 0000*              	CALL	RDGET
  09A7'   37                    	STC
  09A8'   C9                    	RET
                                	;--- not in the table: the rest of the line, as HTBLD reads it ---
  09A9'                         LS_M:
  09A9'   3A 0000*              	LDA	HTN
  09AC'   3C                    	INR	A
  09AD'   CA 087B'              	JZ	LQK_N		; (no room for it)
  09B0'   3A 1055'              	LDA	LQKC
  09B3'   5F                    	MOV	E,A
  09B4'   3A 1066'              	LDA	CURDCL
  09B7'   93                    	SUB	E
  09B8'   32 106D'              	STA	LYVB
  09BB'   3A 1039'              	LDA	CSRAW
  09BE'   57                    	MOV	D,A
  09BF'   CD 0000*              	CALL	RGET0
  09C2'   CD 0BBA'              	CALL	LM_FL		; D = its last row
  09C5'   F5                    	PUSH	PSW
  09C6'   FE 01                 	CPI	1
  09C8'   CA 0A2D'              	JZ	LS_F		; more rows than the screen has
  09CB'   7B                    	MOV	A,E
  09CC'   B7                    	ORA	A
  09CD'   C2 09D4'              	JNZ	LS_1
  09D0'   B2                    	ORA	D
  09D1'   C2 0A2D'              	JNZ	LS_F		; the cursor has a row to itself (LYXE)
  09D4'                         LS_1:
  09D4'   7A                    	MOV	A,D
  09D5'   3C                    	INR	A
  09D6'   32 103A'              	STA	LYTSH
  09D9'   3A 0000*              	LDA	HTCUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09DC'   3C                    	INR	A
  09DD'   C2 0A17'              	JNZ	LS_AP
  09E0'   F1                    	POP	PSW
  09E1'   3A 0000*              	LDA	HTN		; over the first: the rest move down one
  09E4'   47                    	MOV	B,A
  09E5'   CD 0B66'              	CALL	HTE
  09E8'                         LS_S:
  09E8'   78                    	MOV	A,B
  09E9'   B7                    	ORA	A
  09EA'   CA 09F6'              	JZ	LS_S1
  09ED'   2B                    	DCX	H
  09EE'   7E                    	MOV	A,M
  09EF'   23                    	INX	H
  09F0'   77                    	MOV	M,A
  09F1'   2B                    	DCX	H
  09F2'   05                    	DCR	B
  09F3'   C3 09E8'              	JMP	LS_S
  09F6'                         LS_S1:
  09F6'   3A 103A'              	LDA	LYTSH
  09F9'   77                    	MOV	M,A
  09FA'   21 0000*              	LXI	H,HTN
  09FD'   34                    	INR	M
  09FE'   AF                    	XRA	A
  09FF'   32 0000*              	STA	HTCUR
  0A02'   32 0000*              	STA	HTBOF
  0A05'   2A 1064'              	LHLD	CBOL
  0A08'   CD 0BCC'              	CALL	G2P
  0A0B'   CD 0AA9'              	CALL	ISBOF
  0A0E'   37                    	STC
  0A0F'   C0                    	RNZ
  0A10'   3E 01                 	MVI	A,1
  0A12'   32 0000*              	STA	HTBOF
  0A15'   37                    	STC
  0A16'   C9                    	RET
  0A17'                         LS_AP:
  0A17'   3A 103A'              	LDA	LYTSH
  0A1A'   CD 0DCC'              	CALL	HTPUT
  0A1D'   F1                    	POP	PSW
  0A1E'   FA 0A26'              	JM	LS_E		; the text ends with it
  0A21'   CD 0D9C'              	CALL	HB_PK		; ... or right after it
  0A24'   37                    	STC
  0A25'   C9                    	RET
  0A26'                         LS_E:
  0A26'   3E 01                 	MVI	A,1
  0A28'   32 0000*              	STA	HTEOF
  0A2B'   37                    	STC
  0A2C'   C9                    	RET
  0A2D'                         LS_F:
  0A2D'   F1                    	POP	PSW
  0A2E'   C3 087B'              	JMP	LQK_N
                                
                                ;LQMV -- Z iff the key only moved the cursor, in command mode.  Keeps BC, DE.
  0A31'                         LQMV:
  0A31'   3A 0000*              	LDA	RINTENT
  0A34'   FE 01                 	CPI	R_MOVE
  0A36'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A37'   3A 0000*              	LDA	EDMODE
  0A3A'   FE 00                 	CPI	EM_CMD
  0A3C'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  0A3D'                         LYMQ:
  0A3D'   3A 1060'              	LDA	PLACE
  0A40'   FE 02                 	CPI	PL_MID
  0A42'   C8                    	RZ
  0A43'   3A 1073'              	LDA	LYND
  0A46'   B7                    	ORA	A
  0A47'   CA 0A4C'              	JZ	LQ_NO
  0A4A'   AF                    	XRA	A
  0A4B'   C9                    	RET
  0A4C'                         LQ_NO:
  0A4C'   3C                    	INR	A
  0A4D'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A4E'                         FLINE:
  0A4E'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A51'   DA 0A8E'              	JC	FL_EOF
  0A54'   32 1078'              	STA	LYLAST
  0A57'   FE 0A                 	CPI	LF
  0A59'   CA 0A8C'              	JZ	FL_LF
  0A5C'   FE 0D                 	CPI	CR
  0A5E'   CA 0A4E'              	JZ	FLINE		; CR contributes no display column
  0A61'   FE 09                 	CPI	TAB
  0A63'   CA 0A6F'              	JZ	FL_TAB
  0A66'   CD 0A91'              	CALL	FL_CEL
  0A69'   C2 0A4E'              	JNZ	FLINE
  0A6C'                         FL_OVR:
  0A6C'   3E 01                 	MVI	A,1
  0A6E'   C9                    	RET
  0A6F'                         FL_TAB:
  0A6F'   3A 106D'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0A72'   83                    	ADD	E
  0A73'   E6 07                 	ANI	TABWID-1
  0A75'   2F                    	CMA
  0A76'   C6 09                 	ADI	TABWID+1
  0A78'   E5                    	PUSH	H
  0A79'   6F                    	MOV	L,A
  0A7A'                         FT_LP:
  0A7A'   CD 0A91'              	CALL	FL_CEL
  0A7D'   CA 0A88'              	JZ	FT_OVR
  0A80'   2D                    	DCR	L
  0A81'   C2 0A7A'              	JNZ	FT_LP
  0A84'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A85'   C3 0A4E'              	JMP	FLINE
  0A88'                         FT_OVR:
  0A88'   E1                    	POP	H
  0A89'   C3 0A6C'              	JMP	FL_OVR
  0A8C'                         FL_LF:
  0A8C'   AF                    	XRA	A
  0A8D'   C9                    	RET
  0A8E'                         FL_EOF:
  0A8E'   3E FF                 	MVI	A,0FFH
  0A90'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  0A91'                         FL_CEL:
  0A91'   3A 102C'              	LDA	NCOLS
  0A94'   BB                    	CMP	E
  0A95'   C2 0AA7'              	JNZ	FC_1
  0A98'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  0A9A'   14                    	INR	D
  0A9B'   E5                    	PUSH	H
  0A9C'   21 106D'              	LXI	H,LYVB
  0A9F'   86                    	ADD	M
  0AA0'   77                    	MOV	M,A
  0AA1'   E1                    	POP	H
  0AA2'   3A 102D'              	LDA	NEDIT
  0AA5'   BA                    	CMP	D
  0AA6'   C8                    	RZ
  0AA7'                         FC_1:
  0AA7'   1C                    	INR	E		; (NZ)
  0AA8'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  0AA9'                         ISBOF:
  0AA9'   EB                    	XCHG
  0AAA'   2A 0000*              	LHLD	TXTBEG
  0AAD'   CD 0000*              	CALL	CMP16
  0AB0'   C0                    	RNZ
  0AB1'   2A 0000*              	LHLD	OUTPOS
  0AB4'   7C                    	MOV	A,H
  0AB5'   B5                    	ORA	L
  0AB6'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ; prefer_above), which is not the same place once lines differ in height.
  0AB7'                         LYMID:
  0AB7'   CD 0B03'              	CALL	LYINI
  0ABA'   3A 1073'              	LDA	LYND
  0ABD'   B7                    	ORA	A
  0ABE'   CA 0AE6'              	JZ	LM_LP
  0AC1'                         LM_NR:
  0AC1'   CD 0B4A'              	CALL	LMABV		; a line above and a line below, LYND times
  0AC4'   DA 0ADB'              	JC	LM_P
  0AC7'   CD 0B1C'              	CALL	LMBLW
  0ACA'   DA 0ADB'              	JC	LM_P
  0ACD'   21 1073'              	LXI	H,LYND
  0AD0'   35                    	DCR	M
  0AD1'   C2 0AC1'              	JNZ	LM_NR
  0AD4'   3A 1075'              	LDA	LYSVR		; the screen holds them: scroll to it
  0AD7'   32 106A'              	STA	LYROW
  0ADA'   C9                    	RET
  0ADB'                         LM_P:
  0ADB'   AF                    	XRA	A		; it does not: the middle, above first
  0ADC'   32 1073'              	STA	LYND
  0ADF'   3C                    	INR	A
  0AE0'   32 1074'              	STA	LYPRF
  0AE3'   C3 0AB7'              	JMP	LYMID
  0AE6'                         LM_LP:
  0AE6'   3A 1072'              	LDA	LYMBL
  0AE9'   21 1074'              	LXI	H,LYPRF
  0AEC'   86                    	ADD	M
  0AED'   47                    	MOV	B,A
  0AEE'   3A 1071'              	LDA	LYMAB
  0AF1'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0AF2'   DA 0AFC'              	JC	LM_U		;   many, when above goes first)
  0AF5'   CD 0B1C'              	CALL	LMBLW
  0AF8'   D2 0AE6'              	JNC	LM_LP
  0AFB'   C9                    	RET
  0AFC'                         LM_U:
  0AFC'   CD 0B4A'              	CALL	LMABV
  0AFF'   D2 0AE6'              	JNC	LM_LP
  0B02'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0B03'                         LYINI:
  0B03'   AF                    	XRA	A
  0B04'   32 106A'              	STA	LYROW
  0B07'   32 1071'              	STA	LYMAB
  0B0A'   32 1072'              	STA	LYMBL
  0B0D'   3A 0000*              	LDA	HTCUR
  0B10'   CD 0B66'              	CALL	HTE
  0B13'   7E                    	MOV	A,M
  0B14'   32 1070'              	STA	LYUSE
  0B17'   23                    	INX	H
  0B18'   22 106B'              	SHLD	LYIB
  0B1B'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B1C'                         LMBLW:
  0B1C'   3A 0000*              	LDA	HTN
  0B1F'   CD 0B66'              	CALL	HTE
  0B22'   EB                    	XCHG
  0B23'   2A 106B'              	LHLD	LYIB
  0B26'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0B29'   C2 0B38'              	JNZ	LB_1
  0B2C'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0B2F'   B7                    	ORA	A
  0B30'   37                    	STC
  0B31'   C8                    	RZ
  0B32'   21 1072'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0B35'   34                    	INR	M
  0B36'   B7                    	ORA	A
  0B37'   C9                    	RET
  0B38'                         LB_1:
  0B38'   7E                    	MOV	A,M
  0B39'   CD 0B6E'              	CALL	LM_ADD
  0B3C'   D8                    	RC
  0B3D'   21 1072'              	LXI	H,LYMBL
  0B40'   86                    	ADD	M
  0B41'   77                    	MOV	M,A
  0B42'   2A 106B'              	LHLD	LYIB
  0B45'   23                    	INX	H
  0B46'   22 106B'              	SHLD	LYIB
  0B49'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0B4A'                         LMABV:
  0B4A'   21 106A'              	LXI	H,LYROW
  0B4D'   3A 0000*              	LDA	HTCUR
  0B50'   96                    	SUB	M
  0B51'   37                    	STC
  0B52'   C8                    	RZ
  0B53'   3D                    	DCR	A
  0B54'   CD 0B66'              	CALL	HTE
  0B57'   7E                    	MOV	A,M
  0B58'   CD 0B6E'              	CALL	LM_ADD
  0B5B'   D8                    	RC
  0B5C'   21 1071'              	LXI	H,LYMAB
  0B5F'   86                    	ADD	M
  0B60'   77                    	MOV	M,A
  0B61'   21 106A'              	LXI	H,LYROW
  0B64'   34                    	INR	M
  0B65'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B66'                         HTE:
  0B66'   5F                    	MOV	E,A
  0B67'   16 00                 	MVI	D,0
  0B69'   21 0000*              	LXI	H,HTAB
  0B6C'   19                    	DAD	D
  0B6D'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                ; they are taken (LYUSE) and A is kept.
  0B6E'                         LM_ADD:
  0B6E'   47                    	MOV	B,A
  0B6F'   3A 1070'              	LDA	LYUSE
  0B72'   80                    	ADD	B
  0B73'   D8                    	RC
  0B74'   4F                    	MOV	C,A
  0B75'   3A 102D'              	LDA	NEDIT
  0B78'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B79'   D8                    	RC
  0B7A'   79                    	MOV	A,C
  0B7B'   32 1070'              	STA	LYUSE
  0B7E'   78                    	MOV	A,B
  0B7F'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ; A line that is in memory to its LF is measured where it lies (LNW), as the
                                ; lines above the cursor's are; FLINE, a char at a time through RDGET, reads
                                ; the one the bytes run out in, and the one taller than the screen.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B80'                         LM_NX:
  0B80'   AF                    	XRA	A
  0B81'   32 106D'              	STA	LYVB
  0B84'   2A 1084'              	LHLD	RDBC
  0B87'   44                    	MOV	B,H
  0B88'   4D                    	MOV	C,L
  0B89'   2A 1082'              	LHLD	RDHL
  0B8C'   E5                    	PUSH	H
  0B8D'   C5                    	PUSH	B
  0B8E'   CD 0BD3'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0B91'   D2 0BB5'              	JNC	LN_SL
  0B94'   E5                    	PUSH	H
  0B95'   C5                    	PUSH	B
  0B96'   EB                    	XCHG
  0B97'   CD 05F7'              	CALL	XTRA		; BC = its rows past the first
  0B9A'   78                    	MOV	A,B
  0B9B'   B7                    	ORA	A
  0B9C'   51                    	MOV	D,C
  0B9D'   C1                    	POP	B
  0B9E'   E1                    	POP	H
  0B9F'   C2 0BB5'              	JNZ	LN_SL
  0BA2'   3A 102D'              	LDA	NEDIT
  0BA5'   3D                    	DCR	A
  0BA6'   BA                    	CMP	D		; CY iff more rows than the screen has
  0BA7'   DA 0BB5'              	JC	LN_SL
  0BAA'   F1                    	POP	PSW		; (the line's start is not wanted)
  0BAB'   F1                    	POP	PSW
  0BAC'   3E 0A                 	MVI	A,LF
  0BAE'   32 1078'              	STA	LYLAST
  0BB1'   AF                    	XRA	A
  0BB2'   C3 0BBD'              	JMP	LM_ST
  0BB5'                         LN_SL:
  0BB5'   C1                    	POP	B
  0BB6'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0BB7'   11 0000               	LXI	D,0
  0BBA'                         LM_FL:
  0BBA'   CD 0A4E'              	CALL	FLINE
  0BBD'                         LM_ST:
  0BBD'   22 1082'              	SHLD	RDHL
  0BC0'   60                    	MOV	H,B
  0BC1'   69                    	MOV	L,C
  0BC2'   22 1084'              	SHLD	RDBC
  0BC5'   B7                    	ORA	A
  0BC6'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0BC7'                         LYTOPP:
  0BC7'   2A 1062'              	LHLD	TOPLEN
  0BCA'   44                    	MOV	B,H
  0BCB'   4D                    	MOV	C,L
  0BCC'                         G2P:
  0BCC'   EB                    	XCHG
  0BCD'   2A 0000*              	LHLD	GAPBEG
  0BD0'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0BD3'                         LNW:
  0BD3'   11 0000               	LXI	D,0
  0BD6'                         LNW_LP:
  0BD6'   78                    	MOV	A,B
  0BD7'   B1                    	ORA	C
  0BD8'   C8                    	RZ
  0BD9'   7E                    	MOV	A,M
  0BDA'   23                    	INX	H
  0BDB'   0B                    	DCX	B
  0BDC'   FE 20                 	CPI	' '
  0BDE'   D2 0BF4'              	JNC	LNW_1		; (nearly all of them: asked first)
  0BE1'   FE 0A                 	CPI	LF
  0BE3'   CA 0BF8'              	JZ	LNW_LF
  0BE6'   FE 0D                 	CPI	CR
  0BE8'   CA 0BD6'              	JZ	LNW_LP		; CR contributes no display column
  0BEB'   FE 09                 	CPI	TAB
  0BED'   C2 0BF4'              	JNZ	LNW_1
  0BF0'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0BF1'   F6 07                 	ORI	TABWID-1
  0BF3'   5F                    	MOV	E,A
  0BF4'                         LNW_1:
  0BF4'   13                    	INX	D
  0BF5'   C3 0BD6'              	JMP	LNW_LP
  0BF8'                         LNW_LF:
  0BF8'   37                    	STC
  0BF9'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0BFA'                         LYFAR:
  0BFA'   2A 102E'              	LHLD	WINROW
  0BFD'   EB                    	XCHG
  0BFE'   2A 0000*              	LHLD	LNDLT
  0C01'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0C02'   7C                    	MOV	A,H
  0C03'   B7                    	ORA	A
  0C04'   F2 0C1B'              	JP	LF_DN
  0C07'   3A 102D'              	LDA	NEDIT
  0C0A'   B7                    	ORA	A
  0C0B'   1F                    	RAR
  0C0C'   D6 02                 	SUI	2
  0C0E'   5F                    	MOV	E,A
  0C0F'   16 00                 	MVI	D,0
  0C11'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0C12'   7C                    	MOV	A,H
  0C13'   B7                    	ORA	A
  0C14'   F0                    	RP
  0C15'                         LF_FAR:
  0C15'   3E 02                 	MVI	A,PL_MID
  0C17'   32 1060'              	STA	PLACE
  0C1A'   C9                    	RET
  0C1B'                         LF_DN:
  0C1B'   3A 1036'              	LDA	SCBOT
  0C1E'   3C                    	INR	A
  0C1F'   5F                    	MOV	E,A
  0C20'   16 00                 	MVI	D,0
  0C22'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0C25'   7C                    	MOV	A,H		;   less one
  0C26'   B7                    	ORA	A
  0C27'   F8                    	RM			; on the screen
  0C28'   C2 0C15'              	JNZ	LF_FAR
  0C2B'   3A 102D'              	LDA	NEDIT
  0C2E'   BD                    	CMP	L		; CY iff NEDIT < that
  0C2F'   DA 0C15'              	JC	LF_FAR
  0C32'   7D                    	MOV	A,L
  0C33'   32 1073'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0C36'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0C37'                         HTBLD:
  0C37'   79                    	MOV	A,C
  0C38'   32 1076'              	STA	HTLIM
  0C3B'   AF                    	XRA	A
  0C3C'   32 0000*              	STA	HTN
  0C3F'   32 1054'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0C42'   32 0000*              	STA	HTEOF
  0C45'   32 0000*              	STA	HTBOF
  0C48'   32 1077'              	STA	LYXE
  0C4B'   32 1051'              	STA	TALLF
  0C4E'   68                    	MOV	L,B
  0C4F'   67                    	MOV	H,A
  0C50'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0C53'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0C54'   E5                    	PUSH	H
  0C55'   CD 0AA9'              	CALL	ISBOF
  0C58'   C2 0C5F'              	JNZ	HB_1
  0C5B'   3C                    	INR	A
  0C5C'   32 0000*              	STA	HTBOF
  0C5F'                         HB_1:
  0C5F'   E1                    	POP	H
  0C60'   E5                    	PUSH	H
  0C61'   CD 0BCC'              	CALL	G2P		; HL = the bytes from there to the cursor
  0C64'   E5                    	PUSH	H
  0C65'   3A 102C'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0C68'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0C6A'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0C6B'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0C6D'   3A 102D'              	LDA	NEDIT		;   leave no room to read down
  0C70'   CD 0EFE'              	CALL	MULHA
  0C73'   D1                    	POP	D
  0C74'   42                    	MOV	B,D
  0C75'   4B                    	MOV	C,E
  0C76'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0C79'   D2 0C7D'              	JNC	HB_LM
  0C7C'   EB                    	XCHG
  0C7D'                         HB_LM:
  0C7D'   22 106E'              	SHLD	LYLIM
  0C80'   E1                    	POP	H
  0C81'   F1                    	POP	PSW
  0C82'   D2 0C8C'              	JNC	HB_A0
  0C85'   3A 0000*              	LDA	HTBOF
  0C88'   B7                    	ORA	A
  0C89'   CC 0BD3'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C8C'                         HB_A0:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C8C'   E5                    	PUSH	H
  0C8D'   CD 0BCC'              	CALL	G2P
  0C90'   22 1058'              	SHLD	HTTOPC		; (LYTP: the top line is found from here)
  0C93'   E1                    	POP	H
  0C94'                         HB_AB:
  0C94'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C95'   CD 0BD3'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0C98'   D2 0CBB'              	JNC	HB_CU
  0C9B'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0C9C'   C5                    	PUSH	B
  0C9D'   EB                    	XCHG
  0C9E'   CD 05F7'              	CALL	XTRA		; BC = its rows past the first
  0CA1'   78                    	MOV	A,B
  0CA2'   B7                    	ORA	A
  0CA3'   C2 0CB0'              	JNZ	HB_TA
  0CA6'   3A 102D'              	LDA	NEDIT
  0CA9'   3D                    	DCR	A
  0CAA'   B9                    	CMP	C		; CY iff more rows than the screen has
  0CAB'   79                    	MOV	A,C
  0CAC'   3C                    	INR	A
  0CAD'   D2 0CB3'              	JNC	HB_PA
  0CB0'                         HB_TA:
  0CB0'   3A 102D'              	LDA	NEDIT
  0CB3'                         HB_PA:
  0CB3'   CD 0DCC'              	CALL	HTPUT
  0CB6'   C1                    	POP	B
  0CB7'   E1                    	POP	H
  0CB8'   C3 0C94'              	JMP	HB_AB
  0CBB'                         HB_CU:
  0CBB'   EB                    	XCHG
  0CBC'   22 1066'              	SHLD	CURDCL
  0CBF'   E1                    	POP	H
  0CC0'   22 1064'              	SHLD	CBOL
  0CC3'   EB                    	XCHG			; none of it spilled while reading down: the
  0CC4'   2A 106E'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0CC7'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0CCA'   DA 0CCE'              	JC	HB_WL
  0CCD'   EB                    	XCHG
  0CCE'                         HB_WL:
  0CCE'   24                    	INR	H
  0CCF'   22 0000*              	SHLD	WRLIM
  0CD2'   3A 0000*              	LDA	HTN
  0CD5'   32 0000*              	STA	HTCUR
  0CD8'   2A 1066'              	LHLD	CURDCL
  0CDB'   CD 05FE'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0CDE'   5F                    	MOV	E,A
  0CDF'   3A 1066'              	LDA	CURDCL
  0CE2'   93                    	SUB	E
  0CE3'   32 106D'              	STA	LYVB		; the column the cursor's row starts at
  0CE6'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0CE7'   2A 1030'              	LHLD	SKIPR
  0CEA'   50                    	MOV	D,B
  0CEB'   59                    	MOV	E,C
  0CEC'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0CEF'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0CF0'   DA 0D0E'              	JC	HB_SS		; then that is the first
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CF3'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0CF6'   7C                    	MOV	A,H
  0CF7'   B7                    	ORA	A
  0CF8'   C2 0D04'              	JNZ	HB_SD
  0CFB'   3A 102D'              	LDA	NEDIT
  0CFE'   3D                    	DCR	A
  0CFF'   BD                    	CMP	L		; CY iff that is under the last edit row
  0D00'   EB                    	XCHG			; HL = SKIPR, as it was
  0D01'   D2 0D0E'              	JNC	HB_SS
  0D04'                         HB_SD:
  0D04'   3A 102D'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0D07'   2F                    	CMA
  0D08'   6F                    	MOV	L,A
  0D09'   26 FF                 	MVI	H,0FFH
  0D0B'   23                    	INX	H
  0D0C'   23                    	INX	H
  0D0D'   09                    	DAD	B
  0D0E'                         HB_SS:
  0D0E'   22 1030'              	SHLD	SKIPR
  0D11'   EB                    	XCHG
  0D12'   60                    	MOV	H,B
  0D13'   69                    	MOV	L,C
  0D14'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0D17'   7D                    	MOV	A,L
  0D18'   32 1039'              	STA	CSRAW
  0D1B'   D1                    	POP	D
  0D1C'   57                    	MOV	D,A
  0D1D'   CD 0000*              	CALL	RGET0
  0D20'   CD 0BBA'              	CALL	LM_FL		; the rest of the line: D = its last row
  0D23'   F5                    	PUSH	PSW
  0D24'   FE 01                 	CPI	1
  0D26'   CA 0DB5'              	JZ	HB_TO		; more rows than the screen has
  0D29'   2A 1030'              	LHLD	SKIPR
  0D2C'   7C                    	MOV	A,H
  0D2D'   B5                    	ORA	L
  0D2E'   CA 0D51'              	JZ	HB_E2
  0D31'   7C                    	MOV	A,H
  0D32'   B7                    	ORA	A
  0D33'   C2 0D4C'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0D36'   7D                    	MOV	A,L
  0D37'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0D38'   DA 0D4C'              	JC	HB_TE
  0D3B'   21 102D'              	LXI	H,NEDIT
  0D3E'   BE                    	CMP	M
  0D3F'   D2 0D4C'              	JNC	HB_TE		; more than NEDIT of them
  0D42'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0D43'   21 0000               	LXI	H,0
  0D46'   22 1030'              	SHLD	SKIPR
  0D49'   C3 0D51'              	JMP	HB_E2
  0D4C'                         HB_TE:
  0D4C'   3E 01                 	MVI	A,1
  0D4E'   32 1051'              	STA	TALLF
  0D51'                         HB_E2:
  0D51'   7B                    	MOV	A,E
  0D52'   B7                    	ORA	A
  0D53'   C2 0D5F'              	JNZ	HB_E3
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D56'   B2                    	ORA	D
  0D57'   CA 0D5F'              	JZ	HB_E3		; (its first row: an empty line)
  0D5A'   3E 01                 	MVI	A,1
  0D5C'   32 1077'              	STA	LYXE
  0D5F'                         HB_E3:
  0D5F'   7A                    	MOV	A,D
  0D60'   3C                    	INR	A
  0D61'   32 103A'              	STA	LYTSH
  0D64'   3A 1051'              	LDA	TALLF
  0D67'   B7                    	ORA	A
  0D68'   C2 0DC0'              	JNZ	HB_TX
  0D6B'   F1                    	POP	PSW
  0D6C'   FA 0D91'              	JM	HB_LS		; the text ends with it
  0D6F'                         HB_PT:
  0D6F'   7A                    	MOV	A,D
  0D70'   3C                    	INR	A
  0D71'   CD 0DCC'              	CALL	HTPUT
  0D74'   47                    	MOV	B,A
  0D75'   3A 1076'              	LDA	HTLIM
  0D78'   90                    	SUB	B
  0D79'   32 1076'              	STA	HTLIM
  0D7C'   D8                    	RC
  0D7D'   CA 0D9C'              	JZ	HB_PK		; rows enough
  0D80'                         HB_NX:
  0D80'   CD 0B80'              	CALL	LM_NX		; the next line down
  0D83'   CA 0D6F'              	JZ	HB_PT
  0D86'   F2 0DC9'              	JP	HB_TL		; one taller than the screen
  0D89'   3A 1078'              	LDA	LYLAST		; the text ended: was that a line?
  0D8C'   FE 0A                 	CPI	LF
  0D8E'   CA 0D96'              	JZ	HB_EF
  0D91'                         HB_LS:
  0D91'   7A                    	MOV	A,D
  0D92'   3C                    	INR	A
  0D93'   CD 0DCC'              	CALL	HTPUT
  0D96'                         HB_EF:
  0D96'   3E 01                 	MVI	A,1
  0D98'   32 0000*              	STA	HTEOF
  0D9B'   C9                    	RET
  0D9C'                         HB_PK:
  0D9C'   2A 1084'              	LHLD	RDBC		; just the rows asked for: is the text over
  0D9F'   44                    	MOV	B,H		;   right there?
  0DA0'   4D                    	MOV	C,L
  0DA1'   2A 1082'              	LHLD	RDHL
  0DA4'   CD 0000*              	CALL	RDGET
  0DA7'   D0                    	RNC
  0DA8'   C3 0D96'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0DAB'                         HBMOR:
  0DAB'   32 1076'              	STA	HTLIM
  0DAE'   B7                    	ORA	A
  0DAF'   CA 0D9C'              	JZ	HB_PK
  0DB2'   C3 0D80'              	JMP	HB_NX
  0DB5'                         HB_TO:
  0DB5'   3E 01                 	MVI	A,1
  0DB7'   32 1051'              	STA	TALLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0DBA'   3A 102D'              	LDA	NEDIT
  0DBD'   32 103A'              	STA	LYTSH
  0DC0'                         HB_TX:
  0DC0'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0DC1'   F2 0DC9'              	JP	HB_TL		;   with it, and on the screen)
  0DC4'   3E 01                 	MVI	A,1
  0DC6'   32 0000*              	STA	HTEOF
  0DC9'                         HB_TL:
  0DC9'   3A 102D'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0DCC'                         HTPUT:
  0DCC'   E5                    	PUSH	H
  0DCD'   D5                    	PUSH	D
  0DCE'   21 0000*              	LXI	H,HTN
  0DD1'   5E                    	MOV	E,M
  0DD2'   1C                    	INR	E
  0DD3'   CA 0DDF'              	JZ	HP_1
  0DD6'   73                    	MOV	M,E
  0DD7'   1D                    	DCR	E
  0DD8'   16 00                 	MVI	D,0
  0DDA'   21 0000*              	LXI	H,HTAB
  0DDD'   19                    	DAD	D
  0DDE'   77                    	MOV	M,A
  0DDF'                         HP_1:
  0DDF'   D1                    	POP	D
  0DE0'   E1                    	POP	H
  0DE1'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0DE2'                         TABCUR:
  0DE2'   3A 0000*              	LDA	EDMODE
  0DE5'   FE 00                 	CPI	EM_CMD
  0DE7'   C0                    	RNZ
  0DE8'   2A 0000*              	LHLD	TXTEND
  0DEB'   EB                    	XCHG
  0DEC'   2A 0000*              	LHLD	GAPEND
  0DEF'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0DF2'   C8                    	RZ
  0DF3'   7E                    	MOV	A,M
  0DF4'   FE 09                 	CPI	TAB
  0DF6'   C0                    	RNZ
  0DF7'   2A 1066'              	LHLD	CURDCL
  0DFA'   7D                    	MOV	A,L
  0DFB'   F6 07                 	ORI	TABWID-1
  0DFD'   6F                    	MOV	L,A
  0DFE'   22 1066'              	SHLD	CURDCL
  0E01'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                
                                ;RDTOP -- start reading at the top line.
  0E02'                         RDTOP:
  0E02'   2A 1062'              	LHLD	TOPLEN
  0E05'   C3 0E0B'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0E08'                         RDBOL:
  0E08'   2A 1064'              	LHLD	CBOL
  0E0B'                         RDSET:
  0E0B'   22 1080'              	SHLD	RDN
  0E0E'   EB                    	XCHG
  0E0F'   2A 0000*              	LHLD	GAPBEG
  0E12'   CD 0000*              	CALL	SUBHD
  0E15'   22 107E'              	SHLD	RDP
  0E18'   AF                    	XRA	A
  0E19'   32 1086'              	STA	RDSEG
  0E1C'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0E1D'                         RDCH:
  0E1D'   C5                    	PUSH	B
  0E1E'   D5                    	PUSH	D
  0E1F'   E5                    	PUSH	H
  0E20'   2A 1080'              	LHLD	RDN		; before-gap bytes left?
  0E23'   7C                    	MOV	A,H
  0E24'   B5                    	ORA	L
  0E25'   CA 0E38'              	JZ	RDC_AF
  0E28'   2B                    	DCX	H
  0E29'   22 1080'              	SHLD	RDN
  0E2C'   2A 107E'              	LHLD	RDP
  0E2F'   7E                    	MOV	A,M
  0E30'   23                    	INX	H
  0E31'   22 107E'              	SHLD	RDP
  0E34'   B7                    	ORA	A		; CY=0
  0E35'   C3 0E5C'              	JMP	RDC_RT
  0E38'                         RDC_AF:
  0E38'   3A 1086'              	LDA	RDSEG
  0E3B'   B7                    	ORA	A
  0E3C'   C2 0E49'              	JNZ	RDC_NX
  0E3F'   3C                    	INR	A		; first after-gap byte: start RGET
  0E40'   32 1086'              	STA	RDSEG
  0E43'   CD 0000*              	CALL	RGET0
  0E46'   C3 0E51'              	JMP	RDC_GT
  0E49'                         RDC_NX:
  0E49'   2A 1084'              	LHLD	RDBC
  0E4C'   44                    	MOV	B,H
  0E4D'   4D                    	MOV	C,L
  0E4E'   2A 1082'              	LHLD	RDHL
  0E51'                         RDC_GT:
  0E51'   CD 0000*              	CALL	RDGET
  0E54'   22 1082'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0E57'   60                    	MOV	H,B
  0E58'   69                    	MOV	L,C
  0E59'   22 1084'              	SHLD	RDBC
  0E5C'                         RDC_RT:
  0E5C'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E5D'   D1                    	POP	D
  0E5E'   C1                    	POP	B
  0E5F'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).  What is in
                                ; memory is passed over where it lies, before the gap and after it; RDCH
                                ; reads on only when those bytes run out with lines still to pass.
  0E60'                         RDSKIP:
  0E60'   B7                    	ORA	A
  0E61'   C8                    	RZ
  0E62'   32 1087'              	STA	SKPN
  0E65'   2A 1080'              	LHLD	RDN
  0E68'   44                    	MOV	B,H
  0E69'   4D                    	MOV	C,L
  0E6A'   2A 107E'              	LHLD	RDP
  0E6D'   CD 0EB2'              	CALL	RSK_M
  0E70'   22 107E'              	SHLD	RDP
  0E73'   60                    	MOV	H,B
  0E74'   69                    	MOV	L,C
  0E75'   22 1080'              	SHLD	RDN
  0E78'   C8                    	RZ
  0E79'   3A 1086'              	LDA	RDSEG
  0E7C'   B7                    	ORA	A
  0E7D'   C2 0E8A'              	JNZ	RSK_A
  0E80'   3C                    	INR	A		; first after-gap byte: start RGET
  0E81'   32 1086'              	STA	RDSEG
  0E84'   CD 0000*              	CALL	RGET0
  0E87'   C3 0E92'              	JMP	RSK_B
  0E8A'                         RSK_A:
  0E8A'   2A 1084'              	LHLD	RDBC
  0E8D'   44                    	MOV	B,H
  0E8E'   4D                    	MOV	C,L
  0E8F'   2A 1082'              	LHLD	RDHL
  0E92'                         RSK_B:
  0E92'   CD 0EB2'              	CALL	RSK_M
  0E95'   22 1082'              	SHLD	RDHL
  0E98'   60                    	MOV	H,B
  0E99'   69                    	MOV	L,C
  0E9A'   22 1084'              	SHLD	RDBC
  0E9D'   C8                    	RZ
  0E9E'                         RSK_LP:
  0E9E'   CD 0E1D'              	CALL	RDCH
  0EA1'   D8                    	RC
  0EA2'   FE 0A                 	CPI	LF
  0EA4'   C2 0E9E'              	JNZ	RSK_LP
  0EA7'   3A 1087'              	LDA	SKPN
  0EAA'   3D                    	DCR	A
  0EAB'   32 1087'              	STA	SKPN
  0EAE'   C2 0E9E'              	JNZ	RSK_LP
  0EB1'   C9                    	RET
                                ;RSK_M -- pass over SKPN lines in the BC bytes at HL.  Z when that was all of
                                ; them; NZ when the bytes ran out first (SKPN = the lines still to pass).
  0EB2'                         RSK_M:
  0EB2'   78                    	MOV	A,B
  0EB3'   B1                    	ORA	C
  0EB4'   CA 0ECA'              	JZ	RSK_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0EB7'   7E                    	MOV	A,M
  0EB8'   23                    	INX	H
  0EB9'   0B                    	DCX	B
  0EBA'   FE 0A                 	CPI	LF
  0EBC'   C2 0EB2'              	JNZ	RSK_M
  0EBF'   3A 1087'              	LDA	SKPN
  0EC2'   3D                    	DCR	A
  0EC3'   32 1087'              	STA	SKPN
  0EC6'   C2 0EB2'              	JNZ	RSK_M
  0EC9'   C9                    	RET
  0ECA'                         RSK_E:
  0ECA'   3C                    	INR	A		; (NZ)
  0ECB'   C9                    	RET
                                
                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0ECC'                         PSKIP:
  0ECC'   3A 102C'              	LDA	NCOLS
  0ECF'   CD 0EFE'              	CALL	MULHA		; HL = the cells to pass over
  0ED2'   EB                    	XCHG
  0ED3'   21 0000               	LXI	H,0
  0ED6'   22 1089'              	SHLD	PSKN
  0ED9'                         PS_LP:
  0ED9'   7A                    	MOV	A,D
  0EDA'   B3                    	ORA	E
  0EDB'   CA 0F32'              	JZ	PR_LP
  0EDE'   CD 0E1D'              	CALL	RDCH
  0EE1'   FE 0D                 	CPI	CR
  0EE3'   CA 0ED9'              	JZ	PS_LP
  0EE6'   0E 01                 	MVI	C,1
  0EE8'   FE 09                 	CPI	TAB
  0EEA'   CC 0F08'              	CZ	TABN
  0EED'                         PS_CL:
  0EED'   7A                    	MOV	A,D
  0EEE'   B3                    	ORA	E
  0EEF'   CA 0F4C'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0EF2'   1B                    	DCX	D
  0EF3'   21 108B'              	LXI	H,DCOL
  0EF6'   34                    	INR	M
  0EF7'   0D                    	DCR	C
  0EF8'   C2 0EED'              	JNZ	PS_CL
  0EFB'   C3 0ED9'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0EFE'                         MULHA:
  0EFE'   EB                    	XCHG
  0EFF'   21 0000               	LXI	H,0
  0F02'                         MH_LP:
  0F02'   19                    	DAD	D
  0F03'   3D                    	DCR	A
  0F04'   C2 0F02'              	JNZ	MH_LP
  0F07'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0F08'                         TABN:
  0F08'   3A 108B'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0F0B'   E6 07                 	ANI	7
  0F0D'   4F                    	MOV	C,A
  0F0E'   3E 08                 	MVI	A,8
  0F10'   91                    	SUB	C
  0F11'   4F                    	MOV	C,A
  0F12'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0F13'                         PAINTR:
  0F13'   3A 1088'              	LDA	PROWN
  0F16'   21 1034'              	LXI	H,TXEND
  0F19'   BE                    	CMP	M		; CY iff the row holds text
  0F1A'   DA 0F23'              	JC	PROW
  0F1D'   3A 1035'              	LDA	FILCH
  0F20'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0F23'                         PROW:
  0F23'   AF                    	XRA	A
  0F24'   32 108B'              	STA	DCOL
  0F27'   32 108C'              	STA	XC
  0F2A'   2A 1089'              	LHLD	PSKN
  0F2D'   7C                    	MOV	A,H
  0F2E'   B5                    	ORA	L
  0F2F'   C2 0ECC'              	JNZ	PSKIP
  0F32'                         PR_LP:
  0F32'   CD 0E1D'              	CALL	RDCH
  0F35'   D8                    	RC			; end of text -> line done
  0F36'   FE 0A                 	CPI	LF
  0F38'   C8                    	RZ			; consumed the LF -> next line start
  0F39'   FE 0D                 	CPI	CR
  0F3B'   CA 0F32'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0F3E'   FE 09                 	CPI	TAB
  0F40'   CA 0F49'              	JZ	PR_TAB
  0F43'   CD 0F58'              	CALL	PCELL
  0F46'   C3 0F32'              	JMP	PR_LP
  0F49'                         PR_TAB:
  0F49'   CD 0F08'              	CALL	TABN		; C = space count (1..8)
  0F4C'                         PRTBLP:
  0F4C'   3E 20                 	MVI	A,' '
  0F4E'   CD 0F58'              	CALL	PCELL		; (keeps C)
  0F51'   0D                    	DCR	C
  0F52'   C2 0F4C'              	JNZ	PRTBLP
  0F55'   C3 0F32'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0F58'                         PCELL:
  0F58'   47                    	MOV	B,A
  0F59'   21 108B'              	LXI	H,DCOL
  0F5C'   34                    	INR	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0F5D'   3A 102C'              	LDA	NCOLS
  0F60'   21 108C'              	LXI	H,XC
  0F63'   BE                    	CMP	M
  0F64'   CC 0F6C'              	CZ	PWRAP		; the row is full: this one starts the next
  0F67'   34                    	INR	M
  0F68'   78                    	MOV	A,B
  0F69'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0F6C'                         PWRAP:
  0F6C'   36 00                 	MVI	M,0
  0F6E'   3A 1050'              	LDA	PEND
  0F71'   3D                    	DCR	A
  0F72'   21 1088'              	LXI	H,PROWN
  0F75'   BE                    	CMP	M
  0F76'   CA 0F8B'              	JZ	PW_END
  0F79'   34                    	INR	M
  0F7A'   3E 0D                 	MVI	A,CR
  0F7C'   CD 0018'              	CALL	OUTCH
  0F7F'   3E 0A                 	MVI	A,LF
  0F81'   CD 0018'              	CALL	OUTCH
  0F84'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0F87'   21 108C'              	LXI	H,XC
  0F8A'   C9                    	RET
  0F8B'                         PW_END:
  0F8B'   E1                    	POP	H		; PCELL's return, and PROW's
  0F8C'   E1                    	POP	H
  0F8D'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0F8E'                         MODEMS:
  0F8E'   3A 0000*              	LDA	EDMODE
  0F91'   47                    	MOV	B,A
  0F92'   3A 105D'              	LDA	OEDMOD
  0F95'   B8                    	CMP	B
  0F96'   C8                    	RZ			; the row already shows this mode
  0F97'   78                    	MOV	A,B
  0F98'   32 105D'              	STA	OEDMOD
  0F9B'   21 100B'              	LXI	H,SINSM
  0F9E'   FE 01                 	CPI	EM_INS
  0FA0'   CA 0FAE'              	JZ	MD_DRW
  0FA3'   21 1018'              	LXI	H,SREPM
  0FA6'   FE 02                 	CPI	EM_REP
  0FA8'   CA 0FAE'              	JZ	MD_DRW
  0FAB'   21 1026'              	LXI	H,SNULL		; command mode: the row goes blank
  0FAE'                         MD_DRW:
  0FAE'   E5                    	PUSH	H
  0FAF'   3A 102B'              	LDA	NROWS
  0FB2'   CD 008C'              	CALL	GOROW1
  0FB5'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0FB6'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0FB9'                         SCURS:
  0FB9'   3A 1032'              	LDA	SROW
  0FBC'   47                    	MOV	B,A
  0FBD'   3A 1033'              	LDA	SCOL
  0FC0'   4F                    	MOV	C,A
  0FC1'   CD 0064'              	CALL	GOTOXY
  0FC4'   21 1000'              	LXI	H,SSHOW
  0FC7'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0FCA'                         SCDONE:
  0FCA'   CD 0086'              	CALL	CRGRS
  0FCD'   21 1000'              	LXI	H,SSHOW
  0FD0'   CD 0025'              	CALL	OUTSTR
  0FD3'   3A 102B'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0FD6'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0FD9'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0FDD'   39 3B 39 39           
  0FE1'   39 48                 
  0FE3'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0FE7'   00                    
  0FE8'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0FEC'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0FEF'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0FF3'   00                    
  0FF4'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0FF8'   00                    
  0FF9'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0FFD'   35 6C 00              
  1000'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  1004'   35 68 00              
  1007'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  100B'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  100F'   4E 53 45 52           
  1013'   54 20 2D 2D           
  1017'   00                    
  1018'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  101C'   45 50 4C 41           
  1020'   43 45 20 2D           
  1024'   2D 00                 
  1026'   00                    SNULL:	DB	0
  1027'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; DATA
                                ;============================================================
  102B'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  102C'   50                    NCOLS:	DB	80		; runtime columns
  102D'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  102E'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  1030'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  1032'   00                    SROW:	DB	0		; computed cursor screen row
  1033'   00                    SCOL:	DB	0		; computed cursor screen column
  1034'   01                    TXEND:	DB	1		; the first row with no text on it
  1035'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  1036'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  1037'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  1039'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  103A'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  103B'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  103C'   0000                  OLDWR:	DW	0
  103E'   0000                  OLDSK:	DW	0
  1040'   0000                  OLDSC:	DW	0
  1042'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  1044'   00                    OLDBOT:	DB	0
  1045'   0000                  OLDAB:	DW	0
  1047'   00                    OLDCS:	DB	0
  1048'   00                    OLDCR:	DB	0
  1049'   00                    OLDNR:	DB	0
                                
  104A'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  104B'   00                    OPM:	DB	0		; ... or gained there
  104C'   00                    EDA:	DB	0		; the edit: the rows it had
  104D'   00                    EDB:	DB	0		; ... and has
  104E'   00                    EDR:	DB	0		; ... its first row
  104F'   00                    EDP:	DB	0		; ... the first of them to draw
  1050'   00                    PEND:	DB	0		; PRNG: the row to stop before
  1051'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  1052'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  1054'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  1055'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  1056'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  1058'   0000                  HTTOPC: DW	0		; HTBLD: the bytes from the table's first line to
                                				;   the cursor
  105A'   0000                  LYPG:	DW	0		; ... and PGTOPM
  105C'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  105D'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  105E'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  105F'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  1060'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  1061'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  1062'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  1064'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
