  08F2'   EB                    	XCHG			;   the pager has not moved the window since)
  08F3'   2A 1032'              	LHLD	LYPG
  08F6'   C3 0000*              	JMP	CMP16
                                
                                ;LQCU -- the cursor's line, as far as the cursor: CBOL, CURDCL, the row of
