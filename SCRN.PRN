  0B20'   C9                    	RET
  0B21'                         LB_1:
  0B21'   7E                    	MOV	A,M
  0B22'   CD 0B57'              	CALL	LM_ADD
  0B25'   D8                    	RC
  0B26'   21 105B'              	LXI	H,LYMBL
  0B29'   86                    	ADD	M
  0B2A'   77                    	MOV	M,A
  0B2B'   2A 1054'              	LHLD	LYIB
  0B2E'   23                    	INX	H
  0B2F'   22 1054'              	SHLD	LYIB
  0B32'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0B33'                         LMABV:
  0B33'   21 1053'              	LXI	H,LYROW
  0B36'   3A 0000*              	LDA	HTCUR
  0B39'   96                    	SUB	M
  0B3A'   37                    	STC
  0B3B'   C8                    	RZ
  0B3C'   3D                    	DCR	A
  0B3D'   CD 0B4F'              	CALL	HTE
  0B40'   7E                    	MOV	A,M
  0B41'   CD 0B57'              	CALL	LM_ADD
  0B44'   D8                    	RC
  0B45'   21 105A'              	LXI	H,LYMAB
  0B48'   86                    	ADD	M
  0B49'   77                    	MOV	M,A
  0B4A'   21 1053'              	LXI	H,LYROW
  0B4D'   34                    	INR	M
  0B4E'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B4F'                         HTE:
  0B4F'   5F                    	MOV	E,A
  0B50'   16 00                 	MVI	D,0
  0B52'   21 0000*              	LXI	H,HTAB
  0B55'   19                    	DAD	D
  0B56'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0B57'                         LM_ADD:
  0B57'   47                    	MOV	B,A
  0B58'   3A 1059'              	LDA	LYUSE
  0B5B'   80                    	ADD	B
  0B5C'   D8                    	RC
  0B5D'   4F                    	MOV	C,A
  0B5E'   3A 1016'              	LDA	NEDIT
  0B61'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B62'   D8                    	RC
  0B63'   79                    	MOV	A,C
  0B64'   32 1059'              	STA	LYUSE
  0B67'   78                    	MOV	A,B
  0B68'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ; A line that is in memory to its LF is measured where it lies (LNW), as the
                                ; lines above the cursor's are; FLINE, a char at a time through RDGET, reads
                                ; the one the bytes run out in, and the one taller than the screen.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B69'                         LM_NX:
  0B69'   AF                    	XRA	A
  0B6A'   32 1056'              	STA	LYVB
  0B6D'   2A 106D'              	LHLD	RDBC
  0B70'   44                    	MOV	B,H
  0B71'   4D                    	MOV	C,L
  0B72'   2A 106B'              	LHLD	RDHL
  0B75'   E5                    	PUSH	H
  0B76'   C5                    	PUSH	B
  0B77'   CD 0BBC'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0B7A'   D2 0B9E'              	JNC	LN_SL
  0B7D'   E5                    	PUSH	H
  0B7E'   C5                    	PUSH	B
  0B7F'   EB                    	XCHG
  0B80'   CD 05E0'              	CALL	XTRA		; BC = its rows past the first
  0B83'   78                    	MOV	A,B
  0B84'   B7                    	ORA	A
  0B85'   51                    	MOV	D,C
  0B86'   C1                    	POP	B
  0B87'   E1                    	POP	H
  0B88'   C2 0B9E'              	JNZ	LN_SL
  0B8B'   3A 1016'              	LDA	NEDIT
  0B8E'   3D                    	DCR	A
  0B8F'   BA                    	CMP	D		; CY iff more rows than the screen has
  0B90'   DA 0B9E'              	JC	LN_SL
  0B93'   F1                    	POP	PSW		; (the line's start is not wanted)
  0B94'   F1                    	POP	PSW
  0B95'   3E 0A                 	MVI	A,LF
  0B97'   32 1061'              	STA	LYLAST
  0B9A'   AF                    	XRA	A
  0B9B'   C3 0BA6'              	JMP	LM_ST
  0B9E'                         LN_SL:
  0B9E'   C1                    	POP	B
  0B9F'   E1                    	POP	H
  0BA0'   11 0000               	LXI	D,0
  0BA3'                         LM_FL:
  0BA3'   CD 0A37'              	CALL	FLINE
  0BA6'                         LM_ST:
  0BA6'   22 106B'              	SHLD	RDHL
  0BA9'   60                    	MOV	H,B
  0BAA'   69                    	MOV	L,C
  0BAB'   22 106D'              	SHLD	RDBC
  0BAE'   B7                    	ORA	A
  0BAF'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0BB0'                         LYTOPP:
  0BB0'   2A 104B'              	LHLD	TOPLEN
  0BB3'   44                    	MOV	B,H
  0BB4'   4D                    	MOV	C,L
  0BB5'                         G2P:
  0BB5'   EB                    	XCHG
  0BB6'   2A 0000*              	LHLD	GAPBEG
  0BB9'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0BBC'                         LNW:
  0BBC'   11 0000               	LXI	D,0
  0BBF'                         LNW_LP:
  0BBF'   78                    	MOV	A,B
  0BC0'   B1                    	ORA	C
  0BC1'   C8                    	RZ
  0BC2'   7E                    	MOV	A,M
  0BC3'   23                    	INX	H
  0BC4'   0B                    	DCX	B
  0BC5'   FE 20                 	CPI	' '
  0BC7'   D2 0BDD'              	JNC	LNW_1		; (nearly all of them: asked first)
  0BCA'   FE 0A                 	CPI	LF
  0BCC'   CA 0BE1'              	JZ	LNW_LF
  0BCF'   FE 0D                 	CPI	CR
  0BD1'   CA 0BBF'              	JZ	LNW_LP		; CR contributes no display column
  0BD4'   FE 09                 	CPI	TAB
  0BD6'   C2 0BDD'              	JNZ	LNW_1
  0BD9'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0BDA'   F6 07                 	ORI	TABWID-1
  0BDC'   5F                    	MOV	E,A
  0BDD'                         LNW_1:
  0BDD'   13                    	INX	D
  0BDE'   C3 0BBF'              	JMP	LNW_LP
  0BE1'                         LNW_LF:
  0BE1'   37                    	STC
  0BE2'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0BE3'                         LYFAR:
  0BE3'   2A 1017'              	LHLD	WINROW
  0BE6'   EB                    	XCHG
  0BE7'   2A 0000*              	LHLD	LNDLT
  0BEA'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0BEB'   7C                    	MOV	A,H
  0BEC'   B7                    	ORA	A
  0BED'   F2 0C04'              	JP	LF_DN
  0BF0'   3A 1016'              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0BF3'   B7                    	ORA	A
  0BF4'   1F                    	RAR
  0BF5'   D6 02                 	SUI	2
  0BF7'   5F                    	MOV	E,A
  0BF8'   16 00                 	MVI	D,0
  0BFA'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0BFB'   7C                    	MOV	A,H
  0BFC'   B7                    	ORA	A
  0BFD'   F0                    	RP
  0BFE'                         LF_FAR:
  0BFE'   3E 02                 	MVI	A,PL_MID
  0C00'   32 1049'              	STA	PLACE
  0C03'   C9                    	RET
  0C04'                         LF_DN:
  0C04'   3A 101F'              	LDA	SCBOT
  0C07'   3C                    	INR	A
  0C08'   5F                    	MOV	E,A
  0C09'   16 00                 	MVI	D,0
  0C0B'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0C0E'   7C                    	MOV	A,H		;   less one
  0C0F'   B7                    	ORA	A
  0C10'   F8                    	RM			; on the screen
  0C11'   C2 0BFE'              	JNZ	LF_FAR
  0C14'   3A 1016'              	LDA	NEDIT
  0C17'   BD                    	CMP	L		; CY iff NEDIT < that
  0C18'   DA 0BFE'              	JC	LF_FAR
  0C1B'   7D                    	MOV	A,L
  0C1C'   32 105C'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0C1F'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0C20'                         HTBLD:
  0C20'   79                    	MOV	A,C
  0C21'   32 105F'              	STA	HTLIM
  0C24'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0C25'   32 0000*              	STA	HTN
  0C28'   32 103D'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0C2B'   32 0000*              	STA	HTEOF
  0C2E'   32 0000*              	STA	HTBOF
  0C31'   32 1060'              	STA	LYXE
  0C34'   32 103A'              	STA	TALLF
  0C37'   68                    	MOV	L,B
  0C38'   67                    	MOV	H,A
  0C39'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0C3C'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0C3D'   E5                    	PUSH	H
  0C3E'   CD 0A92'              	CALL	ISBOF
  0C41'   C2 0C48'              	JNZ	HB_1
  0C44'   3C                    	INR	A
  0C45'   32 0000*              	STA	HTBOF
  0C48'                         HB_1:
  0C48'   E1                    	POP	H
  0C49'   E5                    	PUSH	H
  0C4A'   CD 0BB5'              	CALL	G2P		; HL = the bytes from there to the cursor
  0C4D'   E5                    	PUSH	H
  0C4E'   3A 1015'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0C51'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0C53'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0C54'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0C56'   3A 1016'              	LDA	NEDIT		;   leave no room to read down
  0C59'   CD 0EE7'              	CALL	MULHA
  0C5C'   D1                    	POP	D
  0C5D'   42                    	MOV	B,D
  0C5E'   4B                    	MOV	C,E
  0C5F'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0C62'   D2 0C66'              	JNC	HB_LM
  0C65'   EB                    	XCHG
  0C66'                         HB_LM:
  0C66'   22 1057'              	SHLD	LYLIM
  0C69'   E1                    	POP	H
  0C6A'   F1                    	POP	PSW
  0C6B'   D2 0C75'              	JNC	HB_A0
  0C6E'   3A 0000*              	LDA	HTBOF
  0C71'   B7                    	ORA	A
  0C72'   CC 0BBC'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C75'                         HB_A0:
  0C75'   E5                    	PUSH	H
  0C76'   CD 0BB5'              	CALL	G2P
  0C79'   22 1041'              	SHLD	HTTOPC		; (LYTP: the top line is found from here)
  0C7C'   E1                    	POP	H
  0C7D'                         HB_AB:
  0C7D'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C7E'   CD 0BBC'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0C81'   D2 0CA4'              	JNC	HB_CU
  0C84'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0C85'   C5                    	PUSH	B
  0C86'   EB                    	XCHG
  0C87'   CD 05E0'              	CALL	XTRA		; BC = its rows past the first
  0C8A'   78                    	MOV	A,B
  0C8B'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C8C'   C2 0C99'              	JNZ	HB_TA
  0C8F'   3A 1016'              	LDA	NEDIT
  0C92'   3D                    	DCR	A
  0C93'   B9                    	CMP	C		; CY iff more rows than the screen has
  0C94'   79                    	MOV	A,C
  0C95'   3C                    	INR	A
  0C96'   D2 0C9C'              	JNC	HB_PA
  0C99'                         HB_TA:
  0C99'   3A 1016'              	LDA	NEDIT
  0C9C'                         HB_PA:
  0C9C'   CD 0DB5'              	CALL	HTPUT
  0C9F'   C1                    	POP	B
  0CA0'   E1                    	POP	H
  0CA1'   C3 0C7D'              	JMP	HB_AB
  0CA4'                         HB_CU:
  0CA4'   EB                    	XCHG
  0CA5'   22 104F'              	SHLD	CURDCL
  0CA8'   E1                    	POP	H
  0CA9'   22 104D'              	SHLD	CBOL
  0CAC'   EB                    	XCHG			; none of it spilled while reading down: the
  0CAD'   2A 1057'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0CB0'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0CB3'   DA 0CB7'              	JC	HB_WL
  0CB6'   EB                    	XCHG
  0CB7'                         HB_WL:
  0CB7'   24                    	INR	H
  0CB8'   22 0000*              	SHLD	WRLIM
  0CBB'   3A 0000*              	LDA	HTN
  0CBE'   32 0000*              	STA	HTCUR
  0CC1'   2A 104F'              	LHLD	CURDCL
  0CC4'   CD 05E7'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0CC7'   5F                    	MOV	E,A
  0CC8'   3A 104F'              	LDA	CURDCL
  0CCB'   93                    	SUB	E
  0CCC'   32 1056'              	STA	LYVB		; the column the cursor's row starts at
  0CCF'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0CD0'   2A 1019'              	LHLD	SKIPR
  0CD3'   50                    	MOV	D,B
  0CD4'   59                    	MOV	E,C
  0CD5'   CD 0000*              	CALL	CMP16		; CY iff the cursor's row is above the first shown
  0CD8'   EB                    	XCHG			; HL = the cursor's row of the line, DE = SKIPR
  0CD9'   DA 0CF7'              	JC	HB_SS		; then that is the first
  0CDC'   CD 0000*              	CALL	SUBHD		; HL = the rows from the first shown to it
  0CDF'   7C                    	MOV	A,H
  0CE0'   B7                    	ORA	A
  0CE1'   C2 0CED'              	JNZ	HB_SD
  0CE4'   3A 1016'              	LDA	NEDIT
  0CE7'   3D                    	DCR	A
  0CE8'   BD                    	CMP	L		; CY iff that is under the last edit row
  0CE9'   EB                    	XCHG			; HL = SKIPR, as it was
  0CEA'   D2 0CF7'              	JNC	HB_SS
  0CED'                         HB_SD:
  0CED'   3A 1016'              	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
  0CF0'   2F                    	CMA
  0CF1'   6F                    	MOV	L,A
  0CF2'   26 FF                 	MVI	H,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0CF4'   23                    	INX	H
  0CF5'   23                    	INX	H
  0CF6'   09                    	DAD	B
  0CF7'                         HB_SS:
  0CF7'   22 1019'              	SHLD	SKIPR
  0CFA'   EB                    	XCHG
  0CFB'   60                    	MOV	H,B
  0CFC'   69                    	MOV	L,C
  0CFD'   CD 0000*              	CALL	SUBHD		; HL = the cursor's row of what is shown of it
  0D00'   7D                    	MOV	A,L
  0D01'   32 1022'              	STA	CSRAW
  0D04'   D1                    	POP	D
  0D05'   57                    	MOV	D,A
  0D06'   CD 0000*              	CALL	RGET0
  0D09'   CD 0BA3'              	CALL	LM_FL		; the rest of the line: D = its last row
  0D0C'   F5                    	PUSH	PSW
  0D0D'   FE 01                 	CPI	1
  0D0F'   CA 0D9E'              	JZ	HB_TO		; more rows than the screen has
  0D12'   2A 1019'              	LHLD	SKIPR
  0D15'   7C                    	MOV	A,H
  0D16'   B5                    	ORA	L
  0D17'   CA 0D3A'              	JZ	HB_E2
  0D1A'   7C                    	MOV	A,H
  0D1B'   B7                    	ORA	A
  0D1C'   C2 0D35'              	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
  0D1F'   7D                    	MOV	A,L
  0D20'   82                    	ADD	D		; SKIPR + D = its rows, less one
  0D21'   DA 0D35'              	JC	HB_TE
  0D24'   21 1016'              	LXI	H,NEDIT
  0D27'   BE                    	CMP	M
  0D28'   D2 0D35'              	JNC	HB_TE		; more than NEDIT of them
  0D2B'   57                    	MOV	D,A		; no taller than the screen after all: whole
  0D2C'   21 0000               	LXI	H,0
  0D2F'   22 1019'              	SHLD	SKIPR
  0D32'   C3 0D3A'              	JMP	HB_E2
  0D35'                         HB_TE:
  0D35'   3E 01                 	MVI	A,1
  0D37'   32 103A'              	STA	TALLF
  0D3A'                         HB_E2:
  0D3A'   7B                    	MOV	A,E
  0D3B'   B7                    	ORA	A
  0D3C'   C2 0D48'              	JNZ	HB_E3
  0D3F'   B2                    	ORA	D
  0D40'   CA 0D48'              	JZ	HB_E3		; (its first row: an empty line)
  0D43'   3E 01                 	MVI	A,1
  0D45'   32 1060'              	STA	LYXE
  0D48'                         HB_E3:
  0D48'   7A                    	MOV	A,D
  0D49'   3C                    	INR	A
  0D4A'   32 1023'              	STA	LYTSH
  0D4D'   3A 103A'              	LDA	TALLF
  0D50'   B7                    	ORA	A
  0D51'   C2 0DA9'              	JNZ	HB_TX
  0D54'   F1                    	POP	PSW
  0D55'   FA 0D7A'              	JM	HB_LS		; the text ends with it
  0D58'                         HB_PT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0D58'   7A                    	MOV	A,D
  0D59'   3C                    	INR	A
  0D5A'   CD 0DB5'              	CALL	HTPUT
  0D5D'   47                    	MOV	B,A
  0D5E'   3A 105F'              	LDA	HTLIM
  0D61'   90                    	SUB	B
  0D62'   32 105F'              	STA	HTLIM
  0D65'   D8                    	RC
  0D66'   CA 0D85'              	JZ	HB_PK		; rows enough
  0D69'                         HB_NX:
  0D69'   CD 0B69'              	CALL	LM_NX		; the next line down
  0D6C'   CA 0D58'              	JZ	HB_PT
  0D6F'   F2 0DB2'              	JP	HB_TL		; one taller than the screen
  0D72'   3A 1061'              	LDA	LYLAST		; the text ended: was that a line?
  0D75'   FE 0A                 	CPI	LF
  0D77'   CA 0D7F'              	JZ	HB_EF
  0D7A'                         HB_LS:
  0D7A'   7A                    	MOV	A,D
  0D7B'   3C                    	INR	A
  0D7C'   CD 0DB5'              	CALL	HTPUT
  0D7F'                         HB_EF:
  0D7F'   3E 01                 	MVI	A,1
  0D81'   32 0000*              	STA	HTEOF
  0D84'   C9                    	RET
  0D85'                         HB_PK:
  0D85'   2A 106D'              	LHLD	RDBC		; just the rows asked for: is the text over
  0D88'   44                    	MOV	B,H		;   right there?
  0D89'   4D                    	MOV	C,L
  0D8A'   2A 106B'              	LHLD	RDHL
  0D8D'   CD 0000*              	CALL	RDGET
  0D90'   D0                    	RNC
  0D91'   C3 0D7F'              	JMP	HB_EF
                                ;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
                                ; (LAYOUT: under a line taller than the screen, which ends the table).
  0D94'                         HBMOR:
  0D94'   32 105F'              	STA	HTLIM
  0D97'   B7                    	ORA	A
  0D98'   CA 0D85'              	JZ	HB_PK
  0D9B'   C3 0D69'              	JMP	HB_NX
  0D9E'                         HB_TO:
  0D9E'   3E 01                 	MVI	A,1
  0DA0'   32 103A'              	STA	TALLF
  0DA3'   3A 1016'              	LDA	NEDIT
  0DA6'   32 1023'              	STA	LYTSH
  0DA9'                         HB_TX:
  0DA9'   F1                    	POP	PSW		; (taller than the screen: M if the text ends
  0DAA'   F2 0DB2'              	JP	HB_TL		;   with it, and on the screen)
  0DAD'   3E 01                 	MVI	A,1
  0DAF'   32 0000*              	STA	HTEOF
  0DB2'                         HB_TL:
  0DB2'   3A 1016'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  0DB5'                         HTPUT:
  0DB5'   E5                    	PUSH	H
  0DB6'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0DB7'   21 0000*              	LXI	H,HTN
  0DBA'   5E                    	MOV	E,M
  0DBB'   1C                    	INR	E
  0DBC'   CA 0DC8'              	JZ	HP_1
  0DBF'   73                    	MOV	M,E
  0DC0'   1D                    	DCR	E
  0DC1'   16 00                 	MVI	D,0
  0DC3'   21 0000*              	LXI	H,HTAB
  0DC6'   19                    	DAD	D
  0DC7'   77                    	MOV	M,A
  0DC8'                         HP_1:
  0DC8'   D1                    	POP	D
  0DC9'   E1                    	POP	H
  0DCA'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0DCB'                         TABCUR:
  0DCB'   3A 0000*              	LDA	EDMODE
  0DCE'   FE 00                 	CPI	EM_CMD
  0DD0'   C0                    	RNZ
  0DD1'   2A 0000*              	LHLD	TXTEND
  0DD4'   EB                    	XCHG
  0DD5'   2A 0000*              	LHLD	GAPEND
  0DD8'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0DDB'   C8                    	RZ
  0DDC'   7E                    	MOV	A,M
  0DDD'   FE 09                 	CPI	TAB
  0DDF'   C0                    	RNZ
  0DE0'   2A 104F'              	LHLD	CURDCL
  0DE3'   7D                    	MOV	A,L
  0DE4'   F6 07                 	ORI	TABWID-1
  0DE6'   6F                    	MOV	L,A
  0DE7'   22 104F'              	SHLD	CURDCL
  0DEA'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  0DEB'                         RDTOP:
  0DEB'   2A 104B'              	LHLD	TOPLEN
  0DEE'   C3 0DF4'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  0DF1'                         RDBOL:
  0DF1'   2A 104D'              	LHLD	CBOL
  0DF4'                         RDSET:
  0DF4'   22 1069'              	SHLD	RDN
  0DF7'   EB                    	XCHG
  0DF8'   2A 0000*              	LHLD	GAPBEG
  0DFB'   CD 0000*              	CALL	SUBHD
  0DFE'   22 1067'              	SHLD	RDP
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0E01'   AF                    	XRA	A
  0E02'   32 106F'              	STA	RDSEG
  0E05'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  0E06'                         RDCH:
  0E06'   C5                    	PUSH	B
  0E07'   D5                    	PUSH	D
  0E08'   E5                    	PUSH	H
  0E09'   2A 1069'              	LHLD	RDN		; before-gap bytes left?
  0E0C'   7C                    	MOV	A,H
  0E0D'   B5                    	ORA	L
  0E0E'   CA 0E21'              	JZ	RDC_AF
  0E11'   2B                    	DCX	H
  0E12'   22 1069'              	SHLD	RDN
  0E15'   2A 1067'              	LHLD	RDP
  0E18'   7E                    	MOV	A,M
  0E19'   23                    	INX	H
  0E1A'   22 1067'              	SHLD	RDP
  0E1D'   B7                    	ORA	A		; CY=0
  0E1E'   C3 0E45'              	JMP	RDC_RT
  0E21'                         RDC_AF:
  0E21'   3A 106F'              	LDA	RDSEG
  0E24'   B7                    	ORA	A
  0E25'   C2 0E32'              	JNZ	RDC_NX
  0E28'   3C                    	INR	A		; first after-gap byte: start RGET
  0E29'   32 106F'              	STA	RDSEG
  0E2C'   CD 0000*              	CALL	RGET0
  0E2F'   C3 0E3A'              	JMP	RDC_GT
  0E32'                         RDC_NX:
  0E32'   2A 106D'              	LHLD	RDBC
  0E35'   44                    	MOV	B,H
  0E36'   4D                    	MOV	C,L
  0E37'   2A 106B'              	LHLD	RDHL
  0E3A'                         RDC_GT:
  0E3A'   CD 0000*              	CALL	RDGET
  0E3D'   22 106B'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0E40'   60                    	MOV	H,B
  0E41'   69                    	MOV	L,C
  0E42'   22 106D'              	SHLD	RDBC
  0E45'                         RDC_RT:
  0E45'   E1                    	POP	H
  0E46'   D1                    	POP	D
  0E47'   C1                    	POP	B
  0E48'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).  What is in
                                ; memory is passed over where it lies, before the gap and after it; RDCH
                                ; reads on only when those bytes run out with lines still to pass.
  0E49'                         RDSKIP:
  0E49'   B7                    	ORA	A
  0E4A'   C8                    	RZ
  0E4B'   32 1070'              	STA	SKPN
  0E4E'   2A 1069'              	LHLD	RDN
  0E51'   44                    	MOV	B,H
  0E52'   4D                    	MOV	C,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0E53'   2A 1067'              	LHLD	RDP
  0E56'   CD 0E9B'              	CALL	RSK_M
  0E59'   22 1067'              	SHLD	RDP
  0E5C'   60                    	MOV	H,B
  0E5D'   69                    	MOV	L,C
  0E5E'   22 1069'              	SHLD	RDN
  0E61'   C8                    	RZ
  0E62'   3A 106F'              	LDA	RDSEG
  0E65'   B7                    	ORA	A
  0E66'   C2 0E73'              	JNZ	RSK_A
  0E69'   3C                    	INR	A		; first after-gap byte: start RGET
  0E6A'   32 106F'              	STA	RDSEG
  0E6D'   CD 0000*              	CALL	RGET0
  0E70'   C3 0E7B'              	JMP	RSK_B
  0E73'                         RSK_A:
  0E73'   2A 106D'              	LHLD	RDBC
  0E76'   44                    	MOV	B,H
  0E77'   4D                    	MOV	C,L
  0E78'   2A 106B'              	LHLD	RDHL
  0E7B'                         RSK_B:
  0E7B'   CD 0E9B'              	CALL	RSK_M
  0E7E'   22 106B'              	SHLD	RDHL
  0E81'   60                    	MOV	H,B
  0E82'   69                    	MOV	L,C
  0E83'   22 106D'              	SHLD	RDBC
  0E86'   C8                    	RZ
  0E87'                         RSK_LP:
  0E87'   CD 0E06'              	CALL	RDCH
  0E8A'   D8                    	RC
  0E8B'   FE 0A                 	CPI	LF
  0E8D'   C2 0E87'              	JNZ	RSK_LP
  0E90'   3A 1070'              	LDA	SKPN
  0E93'   3D                    	DCR	A
  0E94'   32 1070'              	STA	SKPN
  0E97'   C2 0E87'              	JNZ	RSK_LP
  0E9A'   C9                    	RET
                                ;RSK_M -- pass over SKPN lines in the BC bytes at HL.  Z when that was all of
                                ; them; NZ when the bytes ran out first (SKPN = the lines still to pass).
  0E9B'                         RSK_M:
  0E9B'   78                    	MOV	A,B
  0E9C'   B1                    	ORA	C
  0E9D'   CA 0EB3'              	JZ	RSK_E
  0EA0'   7E                    	MOV	A,M
  0EA1'   23                    	INX	H
  0EA2'   0B                    	DCX	B
  0EA3'   FE 0A                 	CPI	LF
  0EA5'   C2 0E9B'              	JNZ	RSK_M
  0EA8'   3A 1070'              	LDA	SKPN
  0EAB'   3D                    	DCR	A
  0EAC'   32 1070'              	STA	SKPN
  0EAF'   C2 0E9B'              	JNZ	RSK_M
  0EB2'   C9                    	RET
  0EB3'                         RSK_E:
  0EB3'   3C                    	INR	A		; (NZ)
  0EB4'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
                                ; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
                                ; rest of the line.  A TAB across the last of them leaves its other cells on
                                ; the first row shown.
  0EB5'                         PSKIP:
  0EB5'   3A 1015'              	LDA	NCOLS
  0EB8'   CD 0EE7'              	CALL	MULHA		; HL = the cells to pass over
  0EBB'   EB                    	XCHG
  0EBC'   21 0000               	LXI	H,0
  0EBF'   22 1072'              	SHLD	PSKN
  0EC2'                         PS_LP:
  0EC2'   7A                    	MOV	A,D
  0EC3'   B3                    	ORA	E
  0EC4'   CA 0F1B'              	JZ	PR_LP
  0EC7'   CD 0E06'              	CALL	RDCH
  0ECA'   FE 0D                 	CPI	CR
  0ECC'   CA 0EC2'              	JZ	PS_LP
  0ECF'   0E 01                 	MVI	C,1
  0ED1'   FE 09                 	CPI	TAB
  0ED3'   CC 0EF1'              	CZ	TABN
  0ED6'                         PS_CL:
  0ED6'   7A                    	MOV	A,D
  0ED7'   B3                    	ORA	E
  0ED8'   CA 0F35'              	JZ	PRTBLP		; (only a TAB gets here with cells to go)
  0EDB'   1B                    	DCX	D
  0EDC'   21 1074'              	LXI	H,DCOL
  0EDF'   34                    	INR	M
  0EE0'   0D                    	DCR	C
  0EE1'   C2 0ED6'              	JNZ	PS_CL
  0EE4'   C3 0EC2'              	JMP	PS_LP
                                
                                ;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
  0EE7'                         MULHA:
  0EE7'   EB                    	XCHG
  0EE8'   21 0000               	LXI	H,0
  0EEB'                         MH_LP:
  0EEB'   19                    	DAD	D
  0EEC'   3D                    	DCR	A
  0EED'   C2 0EEB'              	JNZ	MH_LP
  0EF0'   C9                    	RET
                                
                                ;TABN -- C = the cells a TAB at column DCOL takes (1..8).
  0EF1'                         TABN:
  0EF1'   3A 1074'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0EF4'   E6 07                 	ANI	7
  0EF6'   4F                    	MOV	C,A
  0EF7'   3E 08                 	MVI	A,8
  0EF9'   91                    	SUB	C
  0EFA'   4F                    	MOV	C,A
  0EFB'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0EFC'                         PAINTR:
  0EFC'   3A 1071'              	LDA	PROWN
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0EFF'   21 101D'              	LXI	H,TXEND
  0F02'   BE                    	CMP	M		; CY iff the row holds text
  0F03'   DA 0F0C'              	JC	PROW
  0F06'   3A 101E'              	LDA	FILCH
  0F09'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0F0C'                         PROW:
  0F0C'   AF                    	XRA	A
  0F0D'   32 1074'              	STA	DCOL
  0F10'   32 1075'              	STA	XC
  0F13'   2A 1072'              	LHLD	PSKN
  0F16'   7C                    	MOV	A,H
  0F17'   B5                    	ORA	L
  0F18'   C2 0EB5'              	JNZ	PSKIP
  0F1B'                         PR_LP:
  0F1B'   CD 0E06'              	CALL	RDCH
  0F1E'   D8                    	RC			; end of text -> line done
  0F1F'   FE 0A                 	CPI	LF
  0F21'   C8                    	RZ			; consumed the LF -> next line start
  0F22'   FE 0D                 	CPI	CR
  0F24'   CA 0F1B'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0F27'   FE 09                 	CPI	TAB
  0F29'   CA 0F32'              	JZ	PR_TAB
  0F2C'   CD 0F41'              	CALL	PCELL
  0F2F'   C3 0F1B'              	JMP	PR_LP
  0F32'                         PR_TAB:
  0F32'   CD 0EF1'              	CALL	TABN		; C = space count (1..8)
  0F35'                         PRTBLP:
  0F35'   3E 20                 	MVI	A,' '
  0F37'   CD 0F41'              	CALL	PCELL		; (keeps C)
  0F3A'   0D                    	DCR	C
  0F3B'   C2 0F35'              	JNZ	PRTBLP
  0F3E'   C3 0F1B'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0F41'                         PCELL:
  0F41'   47                    	MOV	B,A
  0F42'   21 1074'              	LXI	H,DCOL
  0F45'   34                    	INR	M
  0F46'   3A 1015'              	LDA	NCOLS
  0F49'   21 1075'              	LXI	H,XC
  0F4C'   BE                    	CMP	M
  0F4D'   CC 0F55'              	CZ	PWRAP		; the row is full: this one starts the next
  0F50'   34                    	INR	M
  0F51'   78                    	MOV	A,B
  0F52'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last row to paint (PEND) there is nowhere to go: the
                                ; rest of the line is not shown, and PROW returns to its caller from here.
  0F55'                         PWRAP:
  0F55'   36 00                 	MVI	M,0
  0F57'   3A 1039'              	LDA	PEND
  0F5A'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0F5B'   21 1071'              	LXI	H,PROWN
  0F5E'   BE                    	CMP	M
  0F5F'   CA 0F74'              	JZ	PW_END
  0F62'   34                    	INR	M
  0F63'   3E 0D                 	MVI	A,CR
  0F65'   CD 0018'              	CALL	OUTCH
  0F68'   3E 0A                 	MVI	A,LF
  0F6A'   CD 0018'              	CALL	OUTCH
  0F6D'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0F70'   21 1075'              	LXI	H,XC
  0F73'   C9                    	RET
  0F74'                         PW_END:
  0F74'   E1                    	POP	H		; PCELL's return, and PROW's
  0F75'   E1                    	POP	H
  0F76'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0F77'                         MODEMS:
  0F77'   3A 0000*              	LDA	EDMODE
  0F7A'   47                    	MOV	B,A
  0F7B'   3A 1046'              	LDA	OEDMOD
  0F7E'   B8                    	CMP	B
  0F7F'   C8                    	RZ			; the row already shows this mode
  0F80'   78                    	MOV	A,B
  0F81'   32 1046'              	STA	OEDMOD
  0F84'   21 0FF4'              	LXI	H,SINSM
  0F87'   FE 01                 	CPI	EM_INS
  0F89'   CA 0F97'              	JZ	MD_DRW
  0F8C'   21 1001'              	LXI	H,SREPM
  0F8F'   FE 02                 	CPI	EM_REP
  0F91'   CA 0F97'              	JZ	MD_DRW
  0F94'   21 100F'              	LXI	H,SNULL		; command mode: the row goes blank
  0F97'                         MD_DRW:
  0F97'   E5                    	PUSH	H
  0F98'   3A 1014'              	LDA	NROWS
  0F9B'   CD 008C'              	CALL	GOROW1
  0F9E'   E1                    	POP	H
  0F9F'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0FA2'                         SCURS:
  0FA2'   3A 101B'              	LDA	SROW
  0FA5'   47                    	MOV	B,A
  0FA6'   3A 101C'              	LDA	SCOL
  0FA9'   4F                    	MOV	C,A
  0FAA'   CD 0064'              	CALL	GOTOXY
  0FAD'   21 0FE9'              	LXI	H,SSHOW
  0FB0'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0FB3'                         SCDONE:
  0FB3'   CD 0086'              	CALL	CRGRS
  0FB6'   21 0FE9'              	LXI	H,SSHOW
  0FB9'   CD 0025'              	CALL	OUTSTR
  0FBC'   3A 1014'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0FBF'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  0FC2'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0FC6'   39 3B 39 39           
  0FCA'   39 48                 
  0FCC'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0FD0'   00                    
  0FD1'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0FD5'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0FD8'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0FDC'   00                    
  0FDD'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0FE1'   00                    
  0FE2'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0FE6'   35 6C 00              
  0FE9'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0FED'   35 68 00              
  0FF0'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0FF4'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0FF8'   4E 53 45 52           
  0FFC'   54 20 2D 2D           
  1000'   00                    
  1001'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  1005'   45 50 4C 41           
  1009'   43 45 20 2D           
  100D'   2D 00                 
  100F'   00                    SNULL:	DB	0
  1010'   3C 3C 3C 00           SSKIP:	DB	'<','<','<',0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  1014'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  1015'   50                    NCOLS:	DB	80		; runtime columns
  1016'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
                                ;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
  1017'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  1019'   0000                  SKIPR:	DW	0		; rows of the top line that are off the top (a
                                				;   line taller than the screen; vim's w_skipcol)
  101B'   00                    SROW:	DB	0		; computed cursor screen row
  101C'   00                    SCOL:	DB	0		; computed cursor screen column
  101D'   01                    TXEND:	DB	1		; the first row with no text on it
  101E'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  101F'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  1020'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  1022'   00                    CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
  1023'   00                    LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
  1024'   00                    NXTR:	DB	0		; ... and of the line under it (0: not shown)
  000E                          FRMLEN	EQU	$-WINROW
  1025'   0000                  OLDWR:	DW	0
  1027'   0000                  OLDSK:	DW	0
  1029'   0000                  OLDSC:	DW	0
  102B'   0000                  OLDTX:	DW	0		; (TXEND, and FILCH)
  102D'   00                    OLDBOT:	DB	0
  102E'   0000                  OLDAB:	DW	0
  1030'   00                    OLDCS:	DB	0
  1031'   00                    OLDCR:	DB	0
  1032'   00                    OLDNR:	DB	0
                                
  1033'   00                    OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
  1034'   00                    OPM:	DB	0		; ... or gained there
  1035'   00                    EDA:	DB	0		; the edit: the rows it had
  1036'   00                    EDB:	DB	0		; ... and has
  1037'   00                    EDR:	DB	0		; ... its first row
  1038'   00                    EDP:	DB	0		; ... the first of them to draw
  1039'   00                    PEND:	DB	0		; PRNG: the row to stop before
  103A'   00                    TALLF:	DB	0		; 1 = the top line is taller than the screen
  103B'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  103D'   00                    LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
  103E'   00                    LQKC:	DB	0		; LYQK: the cells before the cursor on its row
  103F'   0000                  LYTOP:	DW	0		; ... the bytes in memory before the top line then
  1041'   0000                  HTTOPC: DW	0		; HTBLD: the bytes from the table's first line to
                                				;   the cursor
  1043'   0000                  LYPG:	DW	0		; ... and PGTOPM
  1045'   00                    FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
  1046'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  1047'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  1048'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  1049'   00                    PLACE:	DB	0		; the command's request of the next layout (VI.INC
                                				;   PL_ASK / PL_SET / PL_MID)
  104A'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  104B'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  104D'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  104F'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
  1051'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  1053'   00                    LYROW:	DB	0		; LAYOUT: working row
  1054'   0000                  LYIB:	DW	0		; LYMID: -> the entry of the next line below
  1056'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  1057'   0000                  LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
  1059'   00                    LYUSE:	DB	0		; LYMID: rows taken
  105A'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  105B'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  105C'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  105D'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  105E'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  105F'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  1060'   00                    LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
  1061'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  1062'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  1064'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  1066'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  1067'   0000                  RDP:	DW	0		; reader: next before-gap byte
  1069'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  106B'   0000                  RDHL:	DW	0		; reader: RGET pointer
  106D'   0000                  RDBC:	DW	0		; reader: RGET count
  106F'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  1070'   00                    SKPN:	DB	0		; RDSKIP line count
  1071'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  1072'   0000                  PSKN:	DW	0		; PROW: rows of the line to pass over first
  1074'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  1075'   00                    XC:	DB	0		; cells used in the row being painted
                                
  1076'   0000                  TMPR:	DW	0		; DSR parse: rows
  1078'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
