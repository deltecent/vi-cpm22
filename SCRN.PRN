  0934'   22 10A3'              	SHLD	CBOL
  0937'   44                    	MOV	B,H
  0938'   4D                    	MOV	C,L
  0939'   E1                    	POP	H
  093A'   CD 0BDC'              	CALL	LNW
  093D'   EB                    	XCHG
  093E'   22 10A5'              	SHLD	CURDCL
  0941'   CD 0607'              	CALL	DIVN
  0944'   32 1094'              	STA	LQKC
  0947'   79                    	MOV	A,C
  0948'   32 1078'              	STA	CSRAW
  094B'   C9                    	RET
                                
                                ;LYSTP -- a move, in command mode, to a line the row table holds or the one
                                ; next past either end of it -- 'j' on the bottom line, 'k' on the top one.
                                ; The lines the table has are not read again: the cursor's line is found in
                                ; it, or measured (that line alone) and put on the end it belongs at.  What
                                ; HTBLD leaves for the cursor's line is left the same: HTCUR, CBOL, CURDCL,
                                ; CSRAW, LYTSH, and the table's ends (HTBOF, HTEOF).  LAYOUT then places the
                                ; screen by the table as it would have.
                                ;   out: CY when that is done; NC (BC kept) when HTBLD must: the table is not
                                ;        the screen's, the line is farther off, taller than the screen, or
                                ;        any of what LQGD looks for.
  094C'                         LYSTP:
  094C'   C5                    	PUSH	B
  094D'   CD 0952'              	CALL	LS_GO
  0950'   C1                    	POP	B
  0951'   C9                    	RET
  0952'                         LS_GO:
  0952'   3A 1093'              	LDA	LYOK
  0955'   B7                    	ORA	A
  0956'   C8                    	RZ
  0957'   CD 0A3A'              	CALL	LQMV
  095A'   C2 0884'              	JNZ	LQK_N
  095D'   CD 090F'              	CALL	LQGD
  0960'   C2 0884'              	JNZ	LQK_N
  0963'   3A 10B2'              	LDA	LYND
  0966'   B7                    	ORA	A
  0967'   C2 0884'              	JNZ	LQK_N
  096A'   2A 10A7'              	LHLD	LYDLT
  096D'   3A 0000*              	LDA	HTCUR
  0970'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0971'   16 00                 	MVI	D,0
  0973'   19                    	DAD	D		; HL = its place in the table
  0974'   7C                    	MOV	A,H
  0975'   A5                    	ANA	L
  0976'   3C                    	INR	A
  0977'   CA 0986'              	JZ	LS_C		; -1: the line over the table's first
  097A'   7C                    	MOV	A,H
  097B'   B7                    	ORA	A
  097C'   C2 0884'              	JNZ	LQK_N
  097F'   3A 0000*              	LDA	HTN
  0982'   BD                    	CMP	L
  0983'   DA 0884'              	JC	LQK_N
  0986'                         LS_C:
  0986'   7D                    	MOV	A,L
  0987'   32 0000*              	STA	HTCUR
  098A'   CD 092A'              	CALL	LQCU
  098D'   3A 0000*              	LDA	HTCUR
  0990'   3C                    	INR	A
  0991'   CA 09B2'              	JZ	LS_M
  0994'   3D                    	DCR	A
  0995'   21 0000*              	LXI	H,HTN
  0998'   BE                    	CMP	M
  0999'   CA 09B2'              	JZ	LS_M		; the line under its last
  099C'   CD 0B6F'              	CALL	HTE
  099F'   7E                    	MOV	A,M
  09A0'   21 106C'              	LXI	H,NEDIT
  09A3'   BE                    	CMP	M
  09A4'   D2 0884'              	JNC	LQK_N		; (a screenful: it may be taller)
  09A7'   32 1079'              	STA	LYTSH
  09AA'   CD 0000*              	CALL	RGET0		; the char under the cursor in memory (TABCUR)
  09AD'   CD 0000*              	CALL	RDGET
  09B0'   37                    	STC
  09B1'   C9                    	RET
                                	;--- not in the table: the rest of the line, as HTBLD reads it ---
  09B2'                         LS_M:
  09B2'   3A 0000*              	LDA	HTN
  09B5'   3C                    	INR	A
  09B6'   CA 0884'              	JZ	LQK_N		; (no room for it)
  09B9'   3A 1094'              	LDA	LQKC
  09BC'   5F                    	MOV	E,A
  09BD'   3A 10A5'              	LDA	CURDCL
  09C0'   93                    	SUB	E
  09C1'   32 10AC'              	STA	LYVB
  09C4'   3A 1078'              	LDA	CSRAW
  09C7'   57                    	MOV	D,A
  09C8'   CD 0000*              	CALL	RGET0
  09CB'   CD 0BC3'              	CALL	LM_FL		; D = its last row
  09CE'   F5                    	PUSH	PSW
  09CF'   FE 01                 	CPI	1
  09D1'   CA 0A36'              	JZ	LS_F		; more rows than the screen has
  09D4'   7B                    	MOV	A,E
  09D5'   B7                    	ORA	A
  09D6'   C2 09DD'              	JNZ	LS_1
  09D9'   B2                    	ORA	D
  09DA'   C2 0A36'              	JNZ	LS_F		; the cursor has a row to itself (LYXE)
  09DD'                         LS_1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09DD'   7A                    	MOV	A,D
  09DE'   3C                    	INR	A
  09DF'   32 1079'              	STA	LYTSH
  09E2'   3A 0000*              	LDA	HTCUR
  09E5'   3C                    	INR	A
  09E6'   C2 0A20'              	JNZ	LS_AP
  09E9'   F1                    	POP	PSW
  09EA'   3A 0000*              	LDA	HTN		; over the first: the rest move down one
  09ED'   47                    	MOV	B,A
  09EE'   CD 0B6F'              	CALL	HTE
  09F1'                         LS_S:
  09F1'   78                    	MOV	A,B
  09F2'   B7                    	ORA	A
  09F3'   CA 09FF'              	JZ	LS_S1
  09F6'   2B                    	DCX	H
  09F7'   7E                    	MOV	A,M
  09F8'   23                    	INX	H
  09F9'   77                    	MOV	M,A
  09FA'   2B                    	DCX	H
  09FB'   05                    	DCR	B
  09FC'   C3 09F1'              	JMP	LS_S
  09FF'                         LS_S1:
  09FF'   3A 1079'              	LDA	LYTSH
  0A02'   77                    	MOV	M,A
  0A03'   21 0000*              	LXI	H,HTN
  0A06'   34                    	INR	M
  0A07'   AF                    	XRA	A
  0A08'   32 0000*              	STA	HTCUR
  0A0B'   32 0000*              	STA	HTBOF
  0A0E'   2A 10A3'              	LHLD	CBOL
  0A11'   CD 0BD5'              	CALL	G2P
  0A14'   CD 0AB2'              	CALL	ISBOF
  0A17'   37                    	STC
  0A18'   C0                    	RNZ
  0A19'   3E 01                 	MVI	A,1
  0A1B'   32 0000*              	STA	HTBOF
  0A1E'   37                    	STC
  0A1F'   C9                    	RET
  0A20'                         LS_AP:
  0A20'   3A 1079'              	LDA	LYTSH
  0A23'   CD 0DD5'              	CALL	HTPUT
  0A26'   F1                    	POP	PSW
  0A27'   FA 0A2F'              	JM	LS_E		; the text ends with it
  0A2A'   CD 0DA5'              	CALL	HB_PK		; ... or right after it
  0A2D'   37                    	STC
  0A2E'   C9                    	RET
  0A2F'                         LS_E:
  0A2F'   3E 01                 	MVI	A,1
  0A31'   32 0000*              	STA	HTEOF
  0A34'   37                    	STC
  0A35'   C9                    	RET
  0A36'                         LS_F:
  0A36'   F1                    	POP	PSW
  0A37'   C3 0884'              	JMP	LQK_N
                                
                                ;LQMV -- Z iff the key only moved the cursor, in command mode.  Keeps BC, DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A3A'                         LQMV:
  0A3A'   3A 0000*              	LDA	RINTENT
  0A3D'   FE 01                 	CPI	R_MOVE
  0A3F'   C0                    	RNZ
  0A40'   3A 0000*              	LDA	EDMODE
  0A43'   FE 00                 	CPI	EM_CMD
  0A45'   C9                    	RET
                                
                                ;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
                                ; PL_MID), or by the rows about it (LYND).  Keeps BC.
  0A46'                         LYMQ:
  0A46'   3A 109F'              	LDA	PLACE
  0A49'   FE 02                 	CPI	PL_MID
  0A4B'   C8                    	RZ
  0A4C'   3A 10B2'              	LDA	LYND
  0A4F'   B7                    	ORA	A
  0A50'   CA 0A55'              	JZ	LQ_NO
  0A53'   AF                    	XRA	A
  0A54'   C9                    	RET
  0A55'                         LQ_NO:
  0A55'   3C                    	INR	A
  0A56'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  0A57'                         FLINE:
  0A57'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A5A'   DA 0A97'              	JC	FL_EOF
  0A5D'   32 10B7'              	STA	LYLAST
  0A60'   FE 0A                 	CPI	LF
  0A62'   CA 0A95'              	JZ	FL_LF
  0A65'   FE 0D                 	CPI	CR
  0A67'   CA 0A57'              	JZ	FLINE		; CR contributes no display column
  0A6A'   FE 09                 	CPI	TAB
  0A6C'   CA 0A78'              	JZ	FL_TAB
  0A6F'   CD 0A9A'              	CALL	FL_CEL
  0A72'   C2 0A57'              	JNZ	FLINE
  0A75'                         FL_OVR:
  0A75'   3E 01                 	MVI	A,1
  0A77'   C9                    	RET
  0A78'                         FL_TAB:
  0A78'   3A 10AC'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  0A7B'   83                    	ADD	E
  0A7C'   E6 07                 	ANI	TABWID-1
  0A7E'   2F                    	CMA
  0A7F'   C6 09                 	ADI	TABWID+1
  0A81'   E5                    	PUSH	H
  0A82'   6F                    	MOV	L,A
  0A83'                         FT_LP:
  0A83'   CD 0A9A'              	CALL	FL_CEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A86'   CA 0A91'              	JZ	FT_OVR
  0A89'   2D                    	DCR	L
  0A8A'   C2 0A83'              	JNZ	FT_LP
  0A8D'   E1                    	POP	H
  0A8E'   C3 0A57'              	JMP	FLINE
  0A91'                         FT_OVR:
  0A91'   E1                    	POP	H
  0A92'   C3 0A75'              	JMP	FL_OVR
  0A95'                         FL_LF:
  0A95'   AF                    	XRA	A
  0A96'   C9                    	RET
  0A97'                         FL_EOF:
  0A97'   3E FF                 	MVI	A,0FFH
  0A99'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  0A9A'                         FL_CEL:
  0A9A'   3A 106B'              	LDA	NCOLS
  0A9D'   BB                    	CMP	E
  0A9E'   C2 0AB0'              	JNZ	FC_1
  0AA1'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  0AA3'   14                    	INR	D
  0AA4'   E5                    	PUSH	H
  0AA5'   21 10AC'              	LXI	H,LYVB
  0AA8'   86                    	ADD	M
  0AA9'   77                    	MOV	M,A
  0AAA'   E1                    	POP	H
  0AAB'   3A 106C'              	LDA	NEDIT
  0AAE'   BA                    	CMP	D
  0AAF'   C8                    	RZ
  0AB0'                         FC_1:
  0AB0'   1C                    	INR	E		; (NZ)
  0AB1'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  0AB2'                         ISBOF:
  0AB2'   EB                    	XCHG
  0AB3'   2A 0000*              	LHLD	TXTBEG
  0AB6'   CD 0000*              	CALL	CMP16
  0AB9'   C0                    	RNZ
  0ABA'   2A 0000*              	LHLD	OUTPOS
  0ABD'   7C                    	MOV	A,H
  0ABE'   B5                    	ORA	L
  0ABF'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  0AC0'                         LYMID:
  0AC0'   CD 0B0C'              	CALL	LYINI
  0AC3'   3A 10B2'              	LDA	LYND
  0AC6'   B7                    	ORA	A
  0AC7'   CA 0AEF'              	JZ	LM_LP
  0ACA'                         LM_NR:
  0ACA'   CD 0B53'              	CALL	LMABV		; a line above and a line below, LYND times
  0ACD'   DA 0AE4'              	JC	LM_P
  0AD0'   CD 0B25'              	CALL	LMBLW
  0AD3'   DA 0AE4'              	JC	LM_P
  0AD6'   21 10B2'              	LXI	H,LYND
  0AD9'   35                    	DCR	M
  0ADA'   C2 0ACA'              	JNZ	LM_NR
  0ADD'   3A 10B4'              	LDA	LYSVR		; the screen holds them: scroll to it
  0AE0'   32 10A9'              	STA	LYROW
  0AE3'   C9                    	RET
  0AE4'                         LM_P:
  0AE4'   AF                    	XRA	A		; it does not: the middle, above first
  0AE5'   32 10B2'              	STA	LYND
  0AE8'   3C                    	INR	A
  0AE9'   32 10B3'              	STA	LYPRF
  0AEC'   C3 0AC0'              	JMP	LYMID
  0AEF'                         LM_LP:
  0AEF'   3A 10B1'              	LDA	LYMBL
  0AF2'   21 10B3'              	LXI	H,LYPRF
  0AF5'   86                    	ADD	M
  0AF6'   47                    	MOV	B,A
  0AF7'   3A 10B0'              	LDA	LYMAB
  0AFA'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0AFB'   DA 0B05'              	JC	LM_U		;   many, when above goes first)
  0AFE'   CD 0B25'              	CALL	LMBLW
  0B01'   D2 0AEF'              	JNC	LM_LP
  0B04'   C9                    	RET
  0B05'                         LM_U:
  0B05'   CD 0B53'              	CALL	LMABV
  0B08'   D2 0AEF'              	JNC	LM_LP
  0B0B'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0B0C'                         LYINI:
  0B0C'   AF                    	XRA	A
  0B0D'   32 10A9'              	STA	LYROW
  0B10'   32 10B0'              	STA	LYMAB
  0B13'   32 10B1'              	STA	LYMBL
  0B16'   3A 0000*              	LDA	HTCUR
  0B19'   CD 0B6F'              	CALL	HTE
  0B1C'   7E                    	MOV	A,M
  0B1D'   32 10AF'              	STA	LYUSE
  0B20'   23                    	INX	H
  0B21'   22 10AA'              	SHLD	LYIB
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B24'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0B25'                         LMBLW:
  0B25'   3A 0000*              	LDA	HTN
  0B28'   CD 0B6F'              	CALL	HTE
  0B2B'   EB                    	XCHG
  0B2C'   2A 10AA'              	LHLD	LYIB
  0B2F'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0B32'   C2 0B41'              	JNZ	LB_1
  0B35'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0B38'   B7                    	ORA	A
  0B39'   37                    	STC
  0B3A'   C8                    	RZ
  0B3B'   21 10B1'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0B3E'   34                    	INR	M
  0B3F'   B7                    	ORA	A
  0B40'   C9                    	RET
  0B41'                         LB_1:
  0B41'   7E                    	MOV	A,M
  0B42'   CD 0B77'              	CALL	LM_ADD
  0B45'   D8                    	RC
  0B46'   21 10B1'              	LXI	H,LYMBL
  0B49'   86                    	ADD	M
  0B4A'   77                    	MOV	M,A
  0B4B'   2A 10AA'              	LHLD	LYIB
  0B4E'   23                    	INX	H
  0B4F'   22 10AA'              	SHLD	LYIB
  0B52'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0B53'                         LMABV:
  0B53'   21 10A9'              	LXI	H,LYROW
  0B56'   3A 0000*              	LDA	HTCUR
  0B59'   96                    	SUB	M
  0B5A'   37                    	STC
  0B5B'   C8                    	RZ
  0B5C'   3D                    	DCR	A
  0B5D'   CD 0B6F'              	CALL	HTE
  0B60'   7E                    	MOV	A,M
  0B61'   CD 0B77'              	CALL	LM_ADD
  0B64'   D8                    	RC
  0B65'   21 10B0'              	LXI	H,LYMAB
  0B68'   86                    	ADD	M
  0B69'   77                    	MOV	M,A
  0B6A'   21 10A9'              	LXI	H,LYROW
  0B6D'   34                    	INR	M
  0B6E'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B6F'                         HTE:
  0B6F'   5F                    	MOV	E,A
  0B70'   16 00                 	MVI	D,0
  0B72'   21 0000*              	LXI	H,HTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B75'   19                    	DAD	D
  0B76'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0B77'                         LM_ADD:
  0B77'   47                    	MOV	B,A
  0B78'   3A 10AF'              	LDA	LYUSE
  0B7B'   80                    	ADD	B
  0B7C'   D8                    	RC
  0B7D'   4F                    	MOV	C,A
  0B7E'   3A 106C'              	LDA	NEDIT
  0B81'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B82'   D8                    	RC
  0B83'   79                    	MOV	A,C
  0B84'   32 10AF'              	STA	LYUSE
  0B87'   78                    	MOV	A,B
  0B88'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ; A line that is in memory to its LF is measured where it lies (LNW), as the
                                ; lines above the cursor's are; FLINE, a char at a time through RDGET, reads
                                ; the one the bytes run out in, and the one taller than the screen.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B89'                         LM_NX:
  0B89'   AF                    	XRA	A
  0B8A'   32 10AC'              	STA	LYVB
  0B8D'   2A 10C3'              	LHLD	RDBC
  0B90'   44                    	MOV	B,H
  0B91'   4D                    	MOV	C,L
  0B92'   2A 10C1'              	LHLD	RDHL
  0B95'   E5                    	PUSH	H
  0B96'   C5                    	PUSH	B
  0B97'   CD 0BDC'              	CALL	LNW		; DE = its width; CY: it ended, LF and all
  0B9A'   D2 0BBE'              	JNC	LN_SL
  0B9D'   E5                    	PUSH	H
  0B9E'   C5                    	PUSH	B
  0B9F'   EB                    	XCHG
  0BA0'   CD 0600'              	CALL	XTRA		; BC = its rows past the first
  0BA3'   78                    	MOV	A,B
  0BA4'   B7                    	ORA	A
  0BA5'   51                    	MOV	D,C
  0BA6'   C1                    	POP	B
  0BA7'   E1                    	POP	H
  0BA8'   C2 0BBE'              	JNZ	LN_SL
  0BAB'   3A 106C'              	LDA	NEDIT
  0BAE'   3D                    	DCR	A
  0BAF'   BA                    	CMP	D		; CY iff more rows than the screen has
  0BB0'   DA 0BBE'              	JC	LN_SL
  0BB3'   F1                    	POP	PSW		; (the line's start is not wanted)
  0BB4'   F1                    	POP	PSW
  0BB5'   3E 0A                 	MVI	A,LF
  0BB7'   32 10B7'              	STA	LYLAST
  0BBA'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0BBB'   C3 0BC6'              	JMP	LM_ST
  0BBE'                         LN_SL:
  0BBE'   C1                    	POP	B
  0BBF'   E1                    	POP	H
  0BC0'   11 0000               	LXI	D,0
  0BC3'                         LM_FL:
  0BC3'   CD 0A57'              	CALL	FLINE
  0BC6'                         LM_ST:
  0BC6'   22 10C1'              	SHLD	RDHL
  0BC9'   60                    	MOV	H,B
  0BCA'   69                    	MOV	L,C
  0BCB'   22 10C3'              	SHLD	RDBC
  0BCE'   B7                    	ORA	A
  0BCF'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0BD0'                         LYTOPP:
  0BD0'   2A 10A1'              	LHLD	TOPLEN
  0BD3'   44                    	MOV	B,H
  0BD4'   4D                    	MOV	C,L
  0BD5'                         G2P:
  0BD5'   EB                    	XCHG
  0BD6'   2A 0000*              	LHLD	GAPBEG
  0BD9'   C3 0000*              	JMP	SUBHD
                                
                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0BDC'                         LNW:
  0BDC'   11 0000               	LXI	D,0
  0BDF'                         LNW_LP:
  0BDF'   78                    	MOV	A,B
  0BE0'   B1                    	ORA	C
  0BE1'   C8                    	RZ
  0BE2'   7E                    	MOV	A,M
  0BE3'   23                    	INX	H
  0BE4'   0B                    	DCX	B
  0BE5'   FE 20                 	CPI	' '
  0BE7'   D2 0BFD'              	JNC	LNW_1		; (nearly all of them: asked first)
  0BEA'   FE 0A                 	CPI	LF
  0BEC'   CA 0C01'              	JZ	LNW_LF
  0BEF'   FE 0D                 	CPI	CR
  0BF1'   CA 0BDF'              	JZ	LNW_LP		; CR contributes no display column
  0BF4'   FE 09                 	CPI	TAB
  0BF6'   C2 0BFD'              	JNZ	LNW_1
  0BF9'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0BFA'   F6 07                 	ORI	TABWID-1
  0BFC'   5F                    	MOV	E,A
  0BFD'                         LNW_1:
  0BFD'   13                    	INX	D
  0BFE'   C3 0BDF'              	JMP	LNW_LP
  0C01'                         LNW_LF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0C01'   37                    	STC
  0C02'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
                                ; and it goes in the middle (PL_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  0C03'                         LYFAR:
  0C03'   2A 106D'              	LHLD	WINROW
  0C06'   EB                    	XCHG
  0C07'   2A 0000*              	LHLD	LNDLT
  0C0A'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  0C0B'   7C                    	MOV	A,H
  0C0C'   B7                    	ORA	A
  0C0D'   F2 0C24'              	JP	LF_DN
  0C10'   3A 106C'              	LDA	NEDIT
  0C13'   B7                    	ORA	A
  0C14'   1F                    	RAR
  0C15'   D6 02                 	SUI	2
  0C17'   5F                    	MOV	E,A
  0C18'   16 00                 	MVI	D,0
  0C1A'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0C1B'   7C                    	MOV	A,H
  0C1C'   B7                    	ORA	A
  0C1D'   F0                    	RP
  0C1E'                         LF_FAR:
  0C1E'   3E 02                 	MVI	A,PL_MID
  0C20'   32 109F'              	STA	PLACE
  0C23'   C9                    	RET
  0C24'                         LF_DN:
  0C24'   3A 1075'              	LDA	SCBOT
  0C27'   3C                    	INR	A
  0C28'   5F                    	MOV	E,A
  0C29'   16 00                 	MVI	D,0
  0C2B'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  0C2E'   7C                    	MOV	A,H		;   less one
  0C2F'   B7                    	ORA	A
  0C30'   F8                    	RM			; on the screen
  0C31'   C2 0C1E'              	JNZ	LF_FAR
  0C34'   3A 106C'              	LDA	NEDIT
  0C37'   BD                    	CMP	L		; CY iff NEDIT < that
  0C38'   DA 0C1E'              	JC	LF_FAR
  0C3B'   7D                    	MOV	A,L
  0C3C'   32 10B2'              	STA	LYND		; (0: the line right under it only ever scrolls)
  0C3F'   C9                    	RET
                                
                                ;HTBLD -- the rows each line about the cursor takes, in file order, in
                                ; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
                                ; count screen rows, move it by.
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ;
                                ; The cursor's own line is read from the row of it the cursor is on.  When it
                                ; is taller than the screen (TALLF) it is the top line, shown from its row
                                ; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
                                ; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
                                ; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
                                ; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
                                ; past text that filled the row above (an insert at the end of a line just as
                                ; wide as the screen).
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  0C40'                         HTBLD:
  0C40'   79                    	MOV	A,C
  0C41'   32 10B5'              	STA	HTLIM
  0C44'   AF                    	XRA	A
  0C45'   32 0000*              	STA	HTN
  0C48'   32 1093'              	STA	LYOK		; (not the screen's until LAYOUT says so)
  0C4B'   32 0000*              	STA	HTEOF
  0C4E'   32 0000*              	STA	HTBOF
  0C51'   32 10B6'              	STA	LYXE
  0C54'   32 1090'              	STA	TALLF
  0C57'   68                    	MOV	L,B
  0C58'   67                    	MOV	H,A
  0C59'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  0C5C'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  0C5D'   E5                    	PUSH	H
  0C5E'   CD 0AB2'              	CALL	ISBOF
  0C61'   C2 0C68'              	JNZ	HB_1
  0C64'   3C                    	INR	A
  0C65'   32 0000*              	STA	HTBOF
  0C68'                         HB_1:
  0C68'   E1                    	POP	H
  0C69'   E5                    	PUSH	H
  0C6A'   CD 0BD5'              	CALL	G2P		; HL = the bytes from there to the cursor
  0C6D'   E5                    	PUSH	H
  0C6E'   3A 106B'              	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
  0C71'   C6 02                 	ADI	2		;   hold, a line end to each, if that is fewer:
  0C73'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0C74'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0C76'   3A 106C'              	LDA	NEDIT		;   leave no room to read down
  0C79'   CD 0F07'              	CALL	MULHA
  0C7C'   D1                    	POP	D
  0C7D'   42                    	MOV	B,D
  0C7E'   4B                    	MOV	C,E
  0C7F'   CD 0000*              	CALL	CMP16		; CY iff there are fewer than that
  0C82'   D2 0C86'              	JNC	HB_LM
  0C85'   EB                    	XCHG
  0C86'                         HB_LM:
  0C86'   22 10AD'              	SHLD	LYLIM
  0C89'   E1                    	POP	H
  0C8A'   F1                    	POP	PSW
  0C8B'   D2 0C95'              	JNC	HB_A0
  0C8E'   3A 0000*              	LDA	HTBOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C91'   B7                    	ORA	A
  0C92'   CC 0BDC'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  0C95'                         HB_A0:
  0C95'   E5                    	PUSH	H
  0C96'   CD 0BD5'              	CALL	G2P
  0C99'   22 1097'              	SHLD	HTTOPC		; (LYTP: the top line is found from here)
  0C9C'   E1                    	POP	H
  0C9D'                         HB_AB:
  0C9D'   C5                    	PUSH	B		; (CBOL, if this turns out to be the cursor's)
  0C9E'   CD 0BDC'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  0CA1'   D2 0CC4'              	JNC	HB_CU
  0CA4'   E3                    	XTHL			; (that count is not wanted; the pointer is)
  0CA5'   C5                    	PUSH	B
  0CA6'   EB                    	XCHG
  0CA7'   CD 0600'              	CALL	XTRA		; BC = its rows past the first
  0CAA'   78                    	MOV	A,B
  0CAB'   B7                    	ORA	A
  0CAC'   C2 0CB9'              	JNZ	HB_TA
  0CAF'   3A 106C'              	LDA	NEDIT
  0CB2'   3D                    	DCR	A
  0CB3'   B9                    	CMP	C		; CY iff more rows than the screen has
  0CB4'   79                    	MOV	A,C
  0CB5'   3C                    	INR	A
  0CB6'   D2 0CBC'              	JNC	HB_PA
  0CB9'                         HB_TA:
  0CB9'   3A 106C'              	LDA	NEDIT
  0CBC'                         HB_PA:
  0CBC'   CD 0DD5'              	CALL	HTPUT
  0CBF'   C1                    	POP	B
  0CC0'   E1                    	POP	H
  0CC1'   C3 0C9D'              	JMP	HB_AB
  0CC4'                         HB_CU:
  0CC4'   EB                    	XCHG
  0CC5'   22 10A5'              	SHLD	CURDCL
  0CC8'   E1                    	POP	H
  0CC9'   22 10A3'              	SHLD	CBOL
  0CCC'   EB                    	XCHG			; none of it spilled while reading down: the
  0CCD'   2A 10AD'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0CD0'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0CD3'   DA 0CD7'              	JC	HB_WL
  0CD6'   EB                    	XCHG
  0CD7'                         HB_WL:
  0CD7'   24                    	INR	H
  0CD8'   22 0000*              	SHLD	WRLIM
  0CDB'   3A 0000*              	LDA	HTN
  0CDE'   32 0000*              	STA	HTCUR
  0CE1'   2A 10A5'              	LHLD	CURDCL
  0CE4'   CD 0607'              	CALL	DIVN		; BC = rows into the line, A = cells used there
  0CE7'   5F                    	MOV	E,A
  0CE8'   3A 10A5'              	LDA	CURDCL
  0CEB'   93                    	SUB	E
  0CEC'   32 10AC'              	STA	LYVB		; the column the cursor's row starts at
  0CEF'   D5                    	PUSH	D		; (E: the cells used in the cursor's row)
  0CF0'   2A 106F'              	LHLD	SKIPR
  0CF3'   50                    	MOV	D,B
