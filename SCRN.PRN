  0A3D'   83                    	ADD	E
  0A3E'   E6 07                 	ANI	TABWID-1
  0A40'   2F                    	CMA
  0A41'   C6 09                 	ADI	TABWID+1
  0A43'   E5                    	PUSH	H
  0A44'   6F                    	MOV	L,A
  0A45'                         FT_LP:
  0A45'   CD 0A5C'              	CALL	FL_CEL
  0A48'   CA 0A53'              	JZ	FT_OVR
  0A4B'   2D                    	DCR	L
  0A4C'   C2 0A45'              	JNZ	FT_LP
