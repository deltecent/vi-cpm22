  0FD5'   35 6C 00              
  0FD8'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0FDC'   35 68 00              
  0FDF'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0FE3'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0FE7'   4E 53 45 52           
  0FEB'   54 20 2D 2D           
  0FEF'   00                    
  0FF0'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
