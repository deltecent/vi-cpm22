  0A26'   E6 07                 	ANI	TABWID-1
  0A28'   2F                    	CMA
  0A29'   C6 09                 	ADI	TABWID+1
  0A2B'   E5                    	PUSH	H
  0A2C'   6F                    	MOV	L,A
  0A2D'                         FT_LP:
  0A2D'   CD 0A44'              	CALL	FL_CEL
  0A30'   CA 0A3B'              	JZ	FT_OVR
  0A33'   2D                    	DCR	L
  0A34'   C2 0A2D'              	JNZ	FT_LP
  0A37'   E1                    	POP	H
