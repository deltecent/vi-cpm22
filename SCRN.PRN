  0A3B'   E1                    	POP	H
  0A3C'   C3 0A1F'              	JMP	FL_OVR
  0A3F'                         FL_LF:
  0A3F'   AF                    	XRA	A
  0A40'   C9                    	RET
  0A41'                         FL_EOF:
  0A41'   3E FF                 	MVI	A,0FFH
  0A43'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  0A44'                         FL_CEL:
  0A44'   3A 0F80'              	LDA	NCOLS
  0A47'   BB                    	CMP	E
  0A48'   C2 0A5A'              	JNZ	FC_1
  0A4B'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  0A4D'   14                    	INR	D
  0A4E'   E5                    	PUSH	H
  0A4F'   21 0FBF'              	LXI	H,LYVB
  0A52'   86                    	ADD	M
  0A53'   77                    	MOV	M,A
  0A54'   E1                    	POP	H
  0A55'   3A 0F81'              	LDA	NEDIT
  0A58'   BA                    	CMP	D
  0A59'   C8                    	RZ
  0A5A'                         FC_1:
  0A5A'   1C                    	INR	E		; (NZ)
  0A5B'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  0A5C'                         ISBOF:
  0A5C'   EB                    	XCHG
  0A5D'   2A 0000*              	LHLD	TXTBEG
  0A60'   CD 0000*              	CALL	CMP16
  0A63'   C0                    	RNZ
  0A64'   2A 0000*              	LHLD	OUTPOS
  0A67'   7C                    	MOV	A,H
  0A68'   B5                    	ORA	L
  0A69'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
                                ; PL_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.  The rows are the row table's.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  0A6A'                         LYMID:
  0A6A'   CD 0AB6'              	CALL	LYINI
  0A6D'   3A 0FC5'              	LDA	LYND
  0A70'   B7                    	ORA	A
  0A71'   CA 0A99'              	JZ	LM_LP
  0A74'                         LM_NR:
  0A74'   CD 0AFD'              	CALL	LMABV		; a line above and a line below, LYND times
  0A77'   DA 0A8E'              	JC	LM_P
  0A7A'   CD 0ACF'              	CALL	LMBLW
  0A7D'   DA 0A8E'              	JC	LM_P
  0A80'   21 0FC5'              	LXI	H,LYND
  0A83'   35                    	DCR	M
  0A84'   C2 0A74'              	JNZ	LM_NR
  0A87'   3A 0FC7'              	LDA	LYSVR		; the screen holds them: scroll to it
  0A8A'   32 0FBC'              	STA	LYROW
  0A8D'   C9                    	RET
  0A8E'                         LM_P:
  0A8E'   AF                    	XRA	A		; it does not: the middle, above first
  0A8F'   32 0FC5'              	STA	LYND
  0A92'   3C                    	INR	A
  0A93'   32 0FC6'              	STA	LYPRF
  0A96'   C3 0A6A'              	JMP	LYMID
  0A99'                         LM_LP:
  0A99'   3A 0FC4'              	LDA	LYMBL
  0A9C'   21 0FC6'              	LXI	H,LYPRF
  0A9F'   86                    	ADD	M
  0AA0'   47                    	MOV	B,A
  0AA1'   3A 0FC3'              	LDA	LYMAB
  0AA4'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  0AA5'   DA 0AAF'              	JC	LM_U		;   many, when above goes first)
  0AA8'   CD 0ACF'              	CALL	LMBLW
  0AAB'   D2 0A99'              	JNC	LM_LP
  0AAE'   C9                    	RET
  0AAF'                         LM_U:
  0AAF'   CD 0AFD'              	CALL	LMABV
  0AB2'   D2 0A99'              	JNC	LM_LP
  0AB5'   C9                    	RET
                                
                                ;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
                                ; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
  0AB6'                         LYINI:
  0AB6'   AF                    	XRA	A
  0AB7'   32 0FBC'              	STA	LYROW
  0ABA'   32 0FC3'              	STA	LYMAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0ABD'   32 0FC4'              	STA	LYMBL
  0AC0'   3A 0000*              	LDA	HTCUR
  0AC3'   CD 0B19'              	CALL	HTE
  0AC6'   7E                    	MOV	A,M
  0AC7'   32 0FC2'              	STA	LYUSE
  0ACA'   23                    	INX	H
  0ACB'   22 0FBD'              	SHLD	LYIB
  0ACE'   C9                    	RET
                                
                                ;LMBLW -- take the next line below the ones taken -- a '~' row, once the
                                ; text has ended.  CY if the screen has no room for it.
  0ACF'                         LMBLW:
  0ACF'   3A 0000*              	LDA	HTN
  0AD2'   CD 0B19'              	CALL	HTE
  0AD5'   EB                    	XCHG
  0AD6'   2A 0FBD'              	LHLD	LYIB
  0AD9'   CD 0000*              	CALL	CMP16		; Z iff the table has no more
  0ADC'   C2 0AEB'              	JNZ	LB_1
  0ADF'   3A 0000*              	LDA	HTEOF		; ... because the rows ran out: no room
  0AE2'   B7                    	ORA	A
  0AE3'   37                    	STC
  0AE4'   C8                    	RZ
  0AE5'   21 0FC4'              	LXI	H,LYMBL		; ... because the text did: a '~' row
  0AE8'   34                    	INR	M
  0AE9'   B7                    	ORA	A
  0AEA'   C9                    	RET
  0AEB'                         LB_1:
  0AEB'   7E                    	MOV	A,M
  0AEC'   CD 0B21'              	CALL	LM_ADD
  0AEF'   D8                    	RC
  0AF0'   21 0FC4'              	LXI	H,LYMBL
  0AF3'   86                    	ADD	M
  0AF4'   77                    	MOV	M,A
  0AF5'   2A 0FBD'              	LHLD	LYIB
  0AF8'   23                    	INX	H
  0AF9'   22 0FBD'              	SHLD	LYIB
  0AFC'   C9                    	RET
                                
                                ;LMABV -- take the next line above the ones taken (LYROW counts them).
                                ; CY if the table has none, or the screen has no room for it.
  0AFD'                         LMABV:
  0AFD'   21 0FBC'              	LXI	H,LYROW
  0B00'   3A 0000*              	LDA	HTCUR
  0B03'   96                    	SUB	M
  0B04'   37                    	STC
  0B05'   C8                    	RZ
  0B06'   3D                    	DCR	A
  0B07'   CD 0B19'              	CALL	HTE
  0B0A'   7E                    	MOV	A,M
  0B0B'   CD 0B21'              	CALL	LM_ADD
  0B0E'   D8                    	RC
  0B0F'   21 0FC3'              	LXI	H,LYMAB
  0B12'   86                    	ADD	M
  0B13'   77                    	MOV	M,A
  0B14'   21 0FBC'              	LXI	H,LYROW
  0B17'   34                    	INR	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B18'   C9                    	RET
                                
                                ;HTE -- HL -> the row table's entry A.  Keeps A, BC.
  0B19'                         HTE:
  0B19'   5F                    	MOV	E,A
  0B1A'   16 00                 	MVI	D,0
  0B1C'   21 0000*              	LXI	H,HTAB
  0B1F'   19                    	DAD	D
  0B20'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0B21'                         LM_ADD:
  0B21'   47                    	MOV	B,A
  0B22'   3A 0FC2'              	LDA	LYUSE
  0B25'   80                    	ADD	B
  0B26'   D8                    	RC
  0B27'   4F                    	MOV	C,A
  0B28'   3A 0F81'              	LDA	NEDIT
  0B2B'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  0B2C'   D8                    	RC
  0B2D'   79                    	MOV	A,C
  0B2E'   32 0FC2'              	STA	LYUSE
  0B31'   78                    	MOV	A,B
  0B32'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0B33'                         LM_NX:
  0B33'   11 0000               	LXI	D,0
  0B36'   AF                    	XRA	A
  0B37'   32 0FBF'              	STA	LYVB
  0B3A'   2A 0FD6'              	LHLD	RDBC
  0B3D'   44                    	MOV	B,H
  0B3E'   4D                    	MOV	C,L
  0B3F'   2A 0FD4'              	LHLD	RDHL
  0B42'                         LM_FL:
  0B42'   CD 0A01'              	CALL	FLINE
  0B45'   22 0FD4'              	SHLD	RDHL
  0B48'   60                    	MOV	H,B
  0B49'   69                    	MOV	L,C
  0B4A'   22 0FD6'              	SHLD	RDBC
  0B4D'   B7                    	ORA	A
  0B4E'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  0B4F'                         LYTOPP:
  0B4F'   2A 0FB4'              	LHLD	TOPLEN
  0B52'   44                    	MOV	B,H
  0B53'   4D                    	MOV	C,L
