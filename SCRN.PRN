  08F5'   7D                    	MOV	A,L
  08F6'   BB                    	CMP	E
  08F7'   C2 08FF'              	JNZ	LT_4
  08FA'   7C                    	MOV	A,H
  08FB'   BA                    	CMP	D
  08FC'   CA 0909'              	JZ	LT_NO		; (the gap: not as it should be)
  08FF'                         LT_4:
