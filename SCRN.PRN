  0A9A'   78                    	MOV	A,B
  0A9B'   B7                    	ORA	A
  0A9C'   C2 0AA9'              	JNZ	HB_TA
  0A9F'   3A 0DD3'              	LDA	NEDIT
  0AA2'   3D                    	DCR	A
  0AA3'   B9                    	CMP	C		; CY iff more rows than the screen has
  0AA4'   79                    	MOV	A,C
  0AA5'   3C                    	INR	A
  0AA6'   D2 0AAC'              	JNC	HB_PA
  0AA9'                         HB_TA:
  0AA9'   3A 0DD3'              	LDA	NEDIT
  0AAC'                         HB_PA:
  0AAC'   CD 0BC5'              	CALL	HTPUT
  0AAF'   C1                    	POP	B
  0AB0'   E1                    	POP	H
  0AB1'   C3 0A8D'              	JMP	HB_AB
  0AB4'                         HB_CU:
  0AB4'   EB                    	XCHG
  0AB5'   22 0E0A'              	SHLD	CURDCL
  0AB8'   E1                    	POP	H
  0AB9'   22 0E08'              	SHLD	CBOL
  0ABC'   EB                    	XCHG			; none of it spilled while reading down: the
  0ABD'   2A 0E12'              	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
  0AC0'   CD 0000*              	CALL	CMP16		;   cursor's own up to here
  0AC3'   DA 0AC7'              	JC	HB_WL
  0AC6'   EB                    	XCHG
  0AC7'                         HB_WL:
  0AC7'   24                    	INR	H
  0AC8'   22 0000*              	SHLD	WRLIM
  0ACB'   3A 0000*              	LDA	HTN
  0ACE'   32 0000*              	STA	HTCUR
