                                ;============================================================
  0860'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0861'   50                    NCOLS:	DB	80		; runtime columns
  0862'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
  0863'   0000                  WINROW: DW	0		; cursor line's screen row, 0-based (WM WINROW)
  0865'   0000                  HSCROL: DW	0		; 0-based first visible display column (h-pan)
  0867'   0000                  OLDWR:	DW	0		; WINROW as displayed before this frame
  0869'   0000                  OLDHS:	DW	0		; HSCROL as displayed before this frame
  086B'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  086D'   00                    FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
  086E'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  086F'   00                    SCBOT:	DB	0		; last row holding text
  0870'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0871'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0872'   00                    WFILL:	DB	0		; 1 = fill '~' rows from above (one layout)
                                
