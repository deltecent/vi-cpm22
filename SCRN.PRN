	MACRO-80 3.44	09-Dec-81	PAGE	1


                                ;============================================================
                                ; FILE:    SCRN.MAC
                                ; PROJECT: VI
                                ; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
                                ;------------------------------------------------------------
                                ; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
                                ; the screen is placed relative to the CURSOR, never counted from the start of
                                ; the window.  WINROW is the cursor line's screen row.  Each frame:
                                ;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
                                ;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
                                ;     edit rows;
                                ;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
                                ;     cursor's -- the top of the screen -- paging back if it is on disk;
                                ;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
                                ;     screen is never spilled;
                                ;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
                                ;     demand (WM NEEDIN).
                                ; So a frame costs one screenful of text however deep the cursor is.  The
                                ; bytes are read straight from the gap buffer: before the gap by pointer (kept
                                ; relative to GAPBEG, since a refill can move the text), after it by RGET.
                                ;
                                ; Also here (RENDER.md): runtime geometry (DSR probe),
                                ; horizontal pan, the RINTENT fast paths (cursor-only, region scroll up/down,
                                ; one-row redraw, ICH insert, DL line delete), the RPOLL repaint abort, and the
                                ; message row.  The region scrolls take their line count from SCRLN, the number
                                ; of lines the text moved up this frame.
                                ;
                                ; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
                                ;          SCINIT, SCDRAW, SCDONE, SCPRE
                                ;          NROWS, NCOLS, NEDIT         (runtime geometry)
                                ;          WINROW                      (cursor line's screen row; CMD.MAC sets it)
                                ;          SCBOT, SCEOF, SCBOF, WFILL  (last layout's facts; fill request)
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	BCONST, BCONIN, BCONOU
                                	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE
                                	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
                                	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
                                	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
                                	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
                                	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
                                	PUBLIC	NROWS, NCOLS, NEDIT
                                	PUBLIC	WINROW			; cursor line's screen row (signed word)
                                	PUBLIC	SCBOT			; last row holding text
                                	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
                                	PUBLIC	HSCROL			; first visible display column (tests)
                                	PUBLIC	WFILL			; request: pull text down rather than show '~'
                                
                                	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
                                	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
                                	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
                                	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
                                	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
                                	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
                                	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
                                	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
                                	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
                                	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
                                	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
                                	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
                                	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
                                	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; BIOS-DIRECT CONSOLE (WM BIOSC).
                                ; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
                                ; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
                                ; no cached vector, no self-modifying target -- exactly as WM does.
                                ;============================================================
                                
                                ;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
  0000'                         BCONST:
  0000'   2A 0001               	LHLD	1
  0003'   11 0003               	LXI	D,3
  0006'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


  0007'   E9                    	PCHL			; -> BIOS CONST, RETs to our caller
                                
                                ;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
  0008'                         BCONIN:
  0008'   2A 0001               	LHLD	1
  000B'   11 0006               	LXI	D,6
  000E'   19                    	DAD	D
  000F'   E9                    	PCHL			; -> BIOS CONIN
                                
                                ;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
  0010'                         BCONOU:
  0010'   2A 0001               	LHLD	1
  0013'   11 0009               	LXI	D,9
  0016'   19                    	DAD	D
  0017'   E9                    	PCHL			; -> BIOS CONOUT (char in C)
                                
                                ;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
                                ; The paint loops keep their pointers in HL/DE across emits, so this must be
                                ; register-transparent.
  0018'                         OUTCH:
  0018'   F5                    	PUSH	PSW
  0019'   C5                    	PUSH	B
  001A'   D5                    	PUSH	D
  001B'   E5                    	PUSH	H
  001C'   4F                    	MOV	C,A
  001D'   CD 0010'              	CALL	BCONOU
  0020'   E1                    	POP	H
  0021'   D1                    	POP	D
  0022'   C1                    	POP	B
  0023'   F1                    	POP	PSW
  0024'   C9                    	RET
                                
                                ;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
  0025'                         OUTSTR:
  0025'   7E                    	MOV	A,M
  0026'   B7                    	ORA	A
  0027'   C8                    	RZ
  0028'   CD 0018'              	CALL	OUTCH		; preserves HL
  002B'   23                    	INX	H
  002C'   C3 0025'              	JMP	OUTSTR
                                
                                ;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
                                ; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
  002F'                         EMITB:
  002F'   C5                    	PUSH	B
  0030'   D5                    	PUSH	D
  0031'   5F                    	MOV	E,A		; E = value
  0032'   06 00                 	MVI	B,0		; B = "a digit has been printed" flag
  0034'   16 64                 	MVI	D,100
  0036'   CD 0047'              	CALL	EMDIG
  0039'   16 0A                 	MVI	D,10
  003B'   CD 0047'              	CALL	EMDIG
  003E'   7B                    	MOV	A,E		; ones digit: always printed
  003F'   C6 30                 	ADI	'0'
  0041'   CD 0018'              	CALL	OUTCH
  0044'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0045'   C1                    	POP	B
  0046'   C9                    	RET
                                ;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
  0047'                         EMDIG:
  0047'   0E 00                 	MVI	C,0
  0049'                         EMD_LP:
  0049'   7B                    	MOV	A,E
  004A'   92                    	SUB	D
  004B'   DA 0053'              	JC	EMD_DN
  004E'   5F                    	MOV	E,A
  004F'   0C                    	INR	C
  0050'   C3 0049'              	JMP	EMD_LP
  0053'                         EMD_DN:
  0053'   79                    	MOV	A,C
  0054'   B7                    	ORA	A
  0055'   C2 005B'              	JNZ	EMD_PR		; nonzero digit -> print
  0058'   78                    	MOV	A,B
  0059'   B7                    	ORA	A
  005A'   C8                    	RZ			; leading zero -> skip
  005B'                         EMD_PR:
  005B'   79                    	MOV	A,C
  005C'   C6 30                 	ADI	'0'
  005E'   CD 0018'              	CALL	OUTCH		; preserves B,C,D,E
  0061'   06 01                 	MVI	B,1
  0063'                         EMD_RT:
  0063'   C9                    	RET
                                
                                ;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
  0064'                         GOTOXY:
  0064'   3E 1B                 	MVI	A,ESC
  0066'   CD 0018'              	CALL	OUTCH
  0069'   3E 5B                 	MVI	A,'['
  006B'   CD 0018'              	CALL	OUTCH
  006E'   78                    	MOV	A,B
  006F'   CD 002F'              	CALL	EMITB
  0072'   3E 3B                 	MVI	A,';'
  0074'   CD 0018'              	CALL	OUTCH
  0077'   79                    	MOV	A,C
  0078'   CD 002F'              	CALL	EMITB
  007B'   3E 48                 	MVI	A,'H'
  007D'   C3 0018'              	JMP	OUTCH
                                
                                ;--- the four things every paint does, each written once ------------------
                                ;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
  0080'                         CHIDE:
  0080'   21 0818'              	LXI	H,SHIDE
  0083'   C3 0025'              	JMP	OUTSTR
                                ;CRGRS -- put the scroll region back to the whole screen.
  0086'                         CRGRS:
  0086'   21 0826'              	LXI	H,SREGRS
  0089'   C3 0025'              	JMP	OUTSTR
                                ;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
                                ; through to CEKL, which is that clear on its own.
  008C'                         GOROW1:
  008C'   47                    	MOV	B,A
  008D'   0E 01                 	MVI	C,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  008F'   CD 0064'              	CALL	GOTOXY
                                ;CEKL -- clear from the cursor to the end of its row (ESC[K).
  0092'                         CEKL:
  0092'   21 0800'              	LXI	H,SEK
  0095'   C3 0025'              	JMP	OUTSTR
                                ;PTROW -- paint the row PROWN names and step to the next: clear it, write it,
                                ; CR/LF (the last LF of a full repaint lands on the message row, and a backward
                                ; scroll's N <= NEDIT-1 keeps it inside the region), and count the row off.
                                ; Both paint loops are this, once each.
  0098'                         PTROW:
  0098'   CD 0092'              	CALL	CEKL		; ESC[K -- clear the row
  009B'   CD 0720'              	CALL	PAINTR
  009E'   3E 0D                 	MVI	A,CR
  00A0'   CD 0018'              	CALL	OUTCH
  00A3'   3E 0A                 	MVI	A,LF
  00A5'   CD 0018'              	CALL	OUTCH
  00A8'   3A 0874'              	LDA	PROWN
  00AB'   3C                    	INR	A
  00AC'   32 0874'              	STA	PROWN
  00AF'   C9                    	RET
                                
                                ;GOTOP -- address row 1, column 1 (the scroll region's top row).
  00B0'                         GOTOP:
  00B0'   06 01                 	MVI	B,1
  00B2'   0E 01                 	MVI	C,1
  00B4'   C3 0064'              	JMP	GOTOXY
                                
                                ;============================================================
                                ; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
                                ; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
                                ; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
                                ; malformed byte -> keep the 24x80 defaults.
                                ;============================================================
  00B7'                         SCINIT:
  00B7'   21 0000               	LXI	H,0
  00BA'   22 0849'              	SHLD	WINROW
  00BD'   22 084B'              	SHLD	HSCROL
  00C0'   21 07F1'              	LXI	H,SPROBE
  00C3'   CD 0025'              	CALL	OUTSTR
  00C6'   CD 0111'              	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
  00C9'   3A 0846'              	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
  00CC'   3D                    	DCR	A
  00CD'   32 0848'              	STA	NEDIT
  00D0'   C9                    	RET
                                
                                ;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
                                ; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
                                ; falls back to defaults rather than hanging.  Clobbers HL.
  00D1'                         RDB:
  00D1'   21 0000               	LXI	H,0
  00D4'                         RDB_LP:
  00D4'   E5                    	PUSH	H
  00D5'   CD 0000'              	CALL	BCONST
  00D8'   E1                    	POP	H
  00D9'   B7                    	ORA	A
  00DA'   C2 00E5'              	JNZ	RDB_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00DD'   2B                    	DCX	H
  00DE'   7C                    	MOV	A,H
  00DF'   B5                    	ORA	L
  00E0'   C2 00D4'              	JNZ	RDB_LP
  00E3'   37                    	STC			; timeout
  00E4'   C9                    	RET
  00E5'                         RDB_GO:
  00E5'   CD 0008'              	CALL	BCONIN
  00E8'   B7                    	ORA	A		; CY=0, A=byte
  00E9'   C9                    	RET
                                
                                ;RDNUM -- read ASCII digits into DE until a non-digit terminator.
                                ; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
  00EA'                         RDNUM:
  00EA'   11 0000               	LXI	D,0
  00ED'                         RN_LP:
  00ED'   D5                    	PUSH	D
  00EE'   CD 00D1'              	CALL	RDB
  00F1'   D1                    	POP	D
  00F2'   D8                    	RC
  00F3'   FE 30                 	CPI	'0'
  00F5'   DA 010F'              	JC	RN_DN
  00F8'   FE 3A                 	CPI	'9'+1
  00FA'   D2 010F'              	JNC	RN_DN
  00FD'   D6 30                 	SUI	'0'
  00FF'   4F                    	MOV	C,A		; C = this digit
  0100'   62                    	MOV	H,D		; HL = value
  0101'   6B                    	MOV	L,E
  0102'   29                    	DAD	H		; 2x
  0103'   54                    	MOV	D,H
  0104'   5D                    	MOV	E,L		; DE = 2x
  0105'   29                    	DAD	H		; 4x
  0106'   29                    	DAD	H		; 8x
  0107'   19                    	DAD	D		; 10x
  0108'   06 00                 	MVI	B,0		; BC = digit
  010A'   09                    	DAD	B		; HL = 10x + digit
  010B'   EB                    	XCHG			; DE = new value
  010C'   C3 00ED'              	JMP	RN_LP
  010F'                         RN_DN:
  010F'   B7                    	ORA	A		; CY=0, A = terminator
  0110'   C9                    	RET
                                
                                ;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
                                ; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
  0111'                         RDNUMS:
  0111'   CD 00D1'              	CALL	RDB
  0114'   D8                    	RC
  0115'   FE 1B                 	CPI	ESC
  0117'   C0                    	RNZ			; not what a DSR reply looks like
  0118'   CD 00D1'              	CALL	RDB
  011B'   D8                    	RC
  011C'   FE 5B                 	CPI	'['
  011E'   C0                    	RNZ			; not what a DSR reply looks like
  011F'   CD 00EA'              	CALL	RDNUM		; DE = rows
  0122'   D8                    	RC
  0123'   FE 3B                 	CPI	';'
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  0125'   C0                    	RNZ			; not what a DSR reply looks like
  0126'   EB                    	XCHG
  0127'   22 087E'              	SHLD	TMPR
  012A'   CD 00EA'              	CALL	RDNUM		; DE = cols
  012D'   D8                    	RC
  012E'   FE 52                 	CPI	'R'
  0130'   C0                    	RNZ			; not what a DSR reply looks like
  0131'   EB                    	XCHG
  0132'   22 0880'              	SHLD	TMPC
  0135'   2A 087E'              	LHLD	TMPR		; rows -> clamp [24,200]
  0138'   06 18                 	MVI	B,24
  013A'   0E C8                 	MVI	C,200
  013C'   CD 0150'              	CALL	CLAMP
  013F'   32 0846'              	STA	NROWS
  0142'   2A 0880'              	LHLD	TMPC		; cols -> clamp [80,132]
  0145'   06 50                 	MVI	B,80
  0147'   0E 84                 	MVI	C,132
  0149'   CD 0150'              	CALL	CLAMP
  014C'   32 0847'              	STA	NCOLS
  014F'                         RS_BAD:
  014F'   C9                    	RET
                                
                                ;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
  0150'                         CLAMP:
  0150'   7C                    	MOV	A,H
  0151'   B7                    	ORA	A
  0152'   C2 0163'              	JNZ	CLP_MAX		; value > 255 -> max
  0155'   7D                    	MOV	A,L
  0156'   B8                    	CMP	B
  0157'   DA 0161'              	JC	CLP_MIN		; value < min
  015A'   79                    	MOV	A,C
  015B'   BD                    	CMP	L		; CY iff max < value
  015C'   DA 0163'              	JC	CLP_MAX
  015F'   7D                    	MOV	A,L
  0160'   C9                    	RET
  0161'                         CLP_MIN:
  0161'   78                    	MOV	A,B
  0162'   C9                    	RET
  0163'                         CLP_MAX:
  0163'   79                    	MOV	A,C
  0164'   C9                    	RET
                                
                                ;============================================================
                                ; FRAME -- lay out, then pick the cheapest correct paint.
                                ;============================================================
                                
                                ;SCPRE -- snapshot what is on the screen (WINROW/HSCROL) into OLDWR/OLDHS.  The
                                ; main loop calls this after reading a key and before dispatch, so SCDRAW can
                                ; tell how far the text moved (SCRLN) and whether it panned.
  0165'                         SCPRE:
  0165'   2A 0849'              	LHLD	WINROW
  0168'   22 084D'              	SHLD	OLDWR
  016B'   2A 084B'              	LHLD	HSCROL
  016E'   22 084F'              	SHLD	OLDHS
  0171'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0172'                         SCDRAW:
  0172'   CD 0478'              	CALL	LAYOUT		; WINROW/SCRLN/SCBOT/CURDCL/HSCROL (no output)
  0175'   CD 045B'              	CALL	CURSC		; SROW/SCOL
  0178'   3A 0853'              	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
  017B'   B7                    	ORA	A
  017C'   C2 0256'              	JNZ	SCFULL
  017F'   2A 084F'              	LHLD	OLDHS		; panned horizontally -> full repaint
  0182'   EB                    	XCHG
  0183'   2A 084B'              	LHLD	HSCROL
  0186'   CD 0000*              	CALL	CMP16		; Z iff HSCROL == OLDHS
  0189'   C2 0256'              	JNZ	SCFULL
  018C'   3A 0000*              	LDA	RINTENT
  018F'   FE 01                 	CPI	R_MOVE
  0191'   CA 01D7'              	JZ	SC_MV
  0194'   FE 02                 	CPI	R_LINE
  0196'   CA 01AD'              	JZ	SC_ED
  0199'   FE 04                 	CPI	R_ICH
  019B'   CA 01AD'              	JZ	SC_ED
  019E'   FE 05                 	CPI	R_ILIN
  01A0'   CA 0396'              	JZ	SC_ILQ		; (its own test: it moves the cursor's row, and
  01A3'   FE 03                 	CPI	R_DLIN		;   on the bottom row it scrolls the text too)
  01A5'   CA 01AD'              	JZ	SC_ED
  01A8'   FE 06                 	CPI	R_JOIN
  01AA'   C2 0256'              	JNZ	SCFULL		; anything else -> full repaint
  01AD'                         SC_ED:
                                	;--- the in-place edit paints need the text to have stayed put ---
  01AD'   2A 0851'              	LHLD	SCRLN
  01B0'   7C                    	MOV	A,H
  01B1'   B5                    	ORA	L
  01B2'   C2 0256'              	JNZ	SCFULL
  01B5'   2A 084D'              	LHLD	OLDWR
  01B8'   EB                    	XCHG
  01B9'   2A 0849'              	LHLD	WINROW
  01BC'   CD 0000*              	CALL	CMP16		; Z iff the cursor kept its row
  01BF'   C2 0256'              	JNZ	SCFULL
  01C2'   3A 0000*              	LDA	RINTENT
  01C5'   FE 02                 	CPI	R_LINE
  01C7'   CA 0244'              	JZ	SC_LNBD
  01CA'   FE 04                 	CPI	R_ICH
  01CC'   CA 0206'              	JZ	SC_ICH
  01CF'   FE 06                 	CPI	R_JOIN
  01D1'   CA 033E'              	JZ	SC_JN
  01D4'   C3 0365'              	JMP	SCDL
  01D7'                         SC_MV:
                                	;--- R_MOVE: the text moved up SCRLN lines (down if negative) ---
  01D7'   2A 0851'              	LHLD	SCRLN
  01DA'   7C                    	MOV	A,H
  01DB'   B5                    	ORA	L
  01DC'   CA 0203'              	JZ	SC_MOVE		; text still -> cursor only
  01DF'   7C                    	MOV	A,H
  01E0'   B7                    	ORA	A
  01E1'   F2 01F7'              	JP	SC_FWD
  01E4'   EB                    	XCHG
  01E5'   21 0000               	LXI	H,0
  01E8'   CD 0000*              	CALL	SUBHD		; HL = -SCRLN
  01EB'   CD 0431'              	CALL	SCRNOK		; A = N (CY=0) if 1..NEDIT-1, else CY=1
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01EE'   DA 0256'              	JC	SCFULL
  01F1'   32 0875'              	STA	SCLN
  01F4'   C3 02F7'              	JMP	SCBWD
  01F7'                         SC_FWD:
  01F7'   CD 0431'              	CALL	SCRNOK
  01FA'   DA 0256'              	JC	SCFULL
  01FD'   32 0875'              	STA	SCLN		; N in 1..NEDIT-1 -> region scroll
  0200'   C3 02B0'              	JMP	SCFWD
  0203'                         SC_MOVE:
                                	;--- R_MOVE fast path: reposition the (shown) cursor, redraw nothing ---
  0203'   C3 07D1'              	JMP	SCURS		; ensure shown (recovers from an aborted frame)
  0206'                         SC_ICH:
                                	;--- the inserted char sits at screen column SCOL-1; it must be a real
                                	;    on-screen cell (SCOL >= 2), else fall back to the whole-line redraw ---
  0206'   3A 087D'              	LDA	SCOL
  0209'   FE 02                 	CPI	2
  020B'   DA 0244'              	JC	SC_LNBD
                                	;--- appended at the row's end (ICHAPP): the cell is blank and nothing
                                	;    follows it, so the char alone is the whole frame -- no ICH to open a
                                	;    cell for it, and no hide/show, there being nothing to see happen
                                	;    between the address and the byte.  The terminal leaves the cursor at
                                	;    SCOL, where insert mode wants it, exactly as the ICH path does. ---
  020E'   3A 0000*              	LDA	ICHAPP
  0211'   B7                    	ORA	A
  0212'   C2 022A'              	JNZ	SC_ICA
  0215'   CD 0080'              	CALL	CHIDE
  0218'   CD 0230'              	CALL	SC_ICG		; address the inserted char's cell (SROW, SCOL-1)
  021B'   21 080E'              	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
  021E'   CD 0025'              	CALL	OUTSTR
  0221'   CD 023C'              	CALL	SC_ICC		; fills the opened cell; cursor advances to SCOL
  0224'   21 081F'              	LXI	H,SSHOW
  0227'   C3 0025'              	JMP	OUTSTR
  022A'                         SC_ICA:
  022A'   CD 0230'              	CALL	SC_ICG
  022D'   C3 023C'              	JMP	SC_ICC
                                ;SC_ICG -- address the inserted char's cell, (SROW, SCOL-1).
  0230'                         SC_ICG:
  0230'   3A 087C'              	LDA	SROW
  0233'   47                    	MOV	B,A
  0234'   3A 087D'              	LDA	SCOL
  0237'   3D                    	DCR	A
  0238'   4F                    	MOV	C,A
  0239'   C3 0064'              	JMP	GOTOXY
                                ;SC_ICC -- emit the just-inserted byte, which is right before the gap.
  023C'                         SC_ICC:
  023C'   2A 0000*              	LHLD	GAPBEG
  023F'   2B                    	DCX	H
  0240'   7E                    	MOV	A,M
  0241'   C3 0018'              	JMP	OUTCH
  0244'                         SC_LNBD:
                                	;--- R_LINE: redraw only the cursor's row (tabs re-expanded, panned and
                                	;    clipped to the window), then re-address and show the cursor ---
  0244'   CD 0080'              	CALL	CHIDE
  0247'   3A 087C'              	LDA	SROW
  024A'   CD 008C'              	CALL	GOROW1		; column 1 of the current row, cleared
  024D'   CD 06AF'              	CALL	RDBOL		; read from the cursor line's first byte
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  0250'   CD 0733'              	CALL	PROW
  0253'   C3 07D1'              	JMP	SCURS
                                
                                ;SCFULL -- paint edit rows 1..NEDIT in place (home + CR,LF stepping), each
                                ; cleared with ESC[K; rows past the text show '~'.  No ESC[2J (no blank flash).
                                ; Message row last; cursor hidden throughout, then addressed and shown.
  0256'                         SCFULL:
  0256'   CD 0080'              	CALL	CHIDE
  0259'   CD 06A9'              	CALL	RDTOP
  025C'   CD 00B0'              	CALL	GOTOP		; home to row 1
  025F'   AF                    	XRA	A
  0260'   32 0874'              	STA	PROWN
  0263'                         ROW_LP:
  0263'   CD 0000*              	CALL	KBRDY		; RPOLL: a key is waiting -> abort this repaint
  0266'   B7                    	ORA	A
  0267'   C2 0472'              	JNZ	SCABRT
  026A'   3A 0848'              	LDA	NEDIT
  026D'   47                    	MOV	B,A
  026E'   3A 0874'              	LDA	PROWN
  0271'   B8                    	CMP	B
  0272'   D2 027B'              	JNC	ROWS_DN
  0275'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0278'   C3 0263'              	JMP	ROW_LP
  027B'                         ROWS_DN:
                                	;--- message row (now at NROWS, col 1): vim leaves it blank ---
  027B'   CD 0092'              	CALL	CEKL
  027E'   3E FF                 	MVI	A,0FFH		; the row is blank now, so whatever message was
  0280'   32 0854'              	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
                                	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
  0283'   CD 07D1'              	CALL	SCURS
  0286'   AF                    	XRA	A		; a full frame completed -> clear the abort latch
  0287'   32 0853'              	STA	FORCEF
  028A'   C9                    	RET
                                
                                ;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
                                ; shown.  The message owns the row from here: OEDMOD is marked up to date so
                                ; MODEMS does not blank it out from under the message on the next frame.
  028B'                         EXPRM:
  028B'   F5                    	PUSH	PSW
  028C'   3A 0000*              	LDA	EDMODE
  028F'   32 0854'              	STA	OEDMOD
  0292'   3A 0846'              	LDA	NROWS
  0295'   CD 008C'              	CALL	GOROW1
  0298'   F1                    	POP	PSW
  0299'   C3 0018'              	JMP	OUTCH
                                
                                ;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
                                ; space, left).
  029C'                         EXRUB:
  029C'   21 02A2'              	LXI	H,SRUB
  029F'   C3 0025'              	JMP	OUTSTR
  02A2'   08 20 08 00           SRUB:	DB	BS,' ',BS,0
                                
                                ;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
                                ; an error there.  It stays until the mode changes or a full repaint clears it.
  02A6'                         EXMSG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  02A6'   7E                    	MOV	A,M
  02A7'   23                    	INX	H
  02A8'   E5                    	PUSH	H
  02A9'   CD 028B'              	CALL	EXPRM
  02AC'   E1                    	POP	H
  02AD'   C3 0025'              	JMP	OUTSTR
                                
                                ;SCFWD -- the text moved up N rows (SCLN, 1..NEDIT-1) with HSCROL unchanged.
                                ; Clamp the scroll region to the edit rows (message row protected), then N times:
                                ; delete the top region row (ESC[M) -- the terminal scrolls the region up one
                                ; line -- and draw the newly exposed row into row NEDIT.  Only the N exposed
                                ; rows (NEDIT-N .. NEDIT-1) are drawn; the overlap the terminal shifted is never
                                ; re-sent.  Short and bounded, so it runs to completion (no RPOLL abort).
  02B0'                         SCFWD:
  02B0'   CD 0080'              	CALL	CHIDE
  02B3'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  02B6'   CD 06A9'              	CALL	RDTOP
  02B9'   3A 0875'              	LDA	SCLN
  02BC'   47                    	MOV	B,A
  02BD'   3A 0848'              	LDA	NEDIT
  02C0'   90                    	SUB	B		; A = NEDIT - N = first exposed row
  02C1'   32 0874'              	STA	PROWN
  02C4'   CD 0707'              	CALL	RDSKIP		; reader at that row's line
  02C7'                         SFW_LP:
  02C7'   3A 0875'              	LDA	SCLN
  02CA'   B7                    	ORA	A
  02CB'   CA 02F1'              	JZ	SFW_DN
  02CE'   CD 00B0'              	CALL	GOTOP		; region top row
  02D1'   21 0804'              	LXI	H,SDL		; ESC[M (DL) at the top: region scrolls up 1
  02D4'   CD 0025'              	CALL	OUTSTR
  02D7'   3A 0848'              	LDA	NEDIT		; draw the exposed row into the bottom edit row
  02DA'   CD 008C'              	CALL	GOROW1		; ... addressed and cleared
  02DD'   CD 0720'              	CALL	PAINTR
  02E0'   3A 0874'              	LDA	PROWN
  02E3'   3C                    	INR	A
  02E4'   32 0874'              	STA	PROWN
  02E7'   3A 0875'              	LDA	SCLN
  02EA'   3D                    	DCR	A
  02EB'   32 0875'              	STA	SCLN
  02EE'   C3 02C7'              	JMP	SFW_LP
  02F1'                         SFW_DN:
  02F1'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  02F4'   C3 07D1'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCBWD -- the text moved down N rows (SCLN, 1..NEDIT-1) with HSCROL unchanged.
                                ; Clamp the scroll region to the edit rows, Reverse-Index (ESC M) N times at the
                                ; region top -- the terminal scrolls the region down, opening N blank rows at
                                ; the top -- then draw rows 0..N-1 from the top line down.
  02F7'                         SCBWD:
  02F7'   CD 0080'              	CALL	CHIDE
  02FA'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  02FD'   3A 0875'              	LDA	SCLN
  0300'   32 087A'              	STA	ROWCT
  0303'                         SBW_RI:
  0303'   3A 087A'              	LDA	ROWCT
  0306'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0307'   CA 031D'              	JZ	SBW_PT
  030A'   CD 00B0'              	CALL	GOTOP		; region top row
  030D'   21 080B'              	LXI	H,SRI		; ESC M (RI) at the top: region scrolls down 1
  0310'   CD 0025'              	CALL	OUTSTR
  0313'   3A 087A'              	LDA	ROWCT
  0316'   3D                    	DCR	A
  0317'   32 087A'              	STA	ROWCT
  031A'   C3 0303'              	JMP	SBW_RI
  031D'                         SBW_PT:
  031D'   CD 06A9'              	CALL	RDTOP
  0320'   AF                    	XRA	A
  0321'   32 0874'              	STA	PROWN
  0324'   CD 00B0'              	CALL	GOTOP
  0327'                         SBW_LP:
  0327'   3A 0875'              	LDA	SCLN
  032A'   47                    	MOV	B,A
  032B'   3A 0874'              	LDA	PROWN
  032E'   B8                    	CMP	B
  032F'   D2 0338'              	JNC	SBW_DN
  0332'   CD 0098'              	CALL	PTROW		; the row, then down to the next one
  0335'   C3 0327'              	JMP	SBW_LP
  0338'                         SBW_DN:
  0338'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  033B'   C3 07D1'              	JMP	SCURS		; address and show the cursor at its new cell
                                
                                ;SCDL -- R_DLIN: a single line was deleted at the cursor's row (dd, not the last
                                ; line).  Delete that screen row (ESC[M at SROW, region-clamped so the message row
                                ; is safe) -- the rows below shift up and a blank opens at row NEDIT -- then draw
                                ; the bottom row and re-address the cursor (which kept
                                ; its row, now at the BOL of the line that shifted up).
                                ;SC_JN -- R_JOIN: the line below was joined onto the cursor's.  That row now
                                ; holds both, and the row under it is gone -- so redraw the cursor's row, then
                                ; hand the rest to SCDL, which deletes a row and draws the one the shift
                                ; exposes at the bottom.  With the cursor on the LAST edit row there is no row
                                ; under it on the screen at all: the join took a line that was never shown, and
                                ; only the cursor's own row is stale (vim redraws just that row there too).
  033E'                         SC_JN:
  033E'   3A 087C'              	LDA	SROW
  0341'   47                    	MOV	B,A
  0342'   3A 0848'              	LDA	NEDIT
  0345'   B8                    	CMP	B		; CY iff NEDIT < SROW; Z iff the bottom edit row
  0346'   CA 0244'              	JZ	SC_LNBD
  0349'   DA 0244'              	JC	SC_LNBD
  034C'   CD 0080'              	CALL	CHIDE
  034F'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  0352'   3A 087C'              	LDA	SROW		; the joined line, redrawn where it stands
  0355'   CD 008C'              	CALL	GOROW1
  0358'   CD 06AF'              	CALL	RDBOL
  035B'   CD 0733'              	CALL	PROW
  035E'   3A 087C'              	LDA	SROW
  0361'   3C                    	INR	A		; ... and the row under it goes
  0362'   C3 036E'              	JMP	SCDL2
                                
  0365'                         SCDL:
  0365'   CD 0080'              	CALL	CHIDE
  0368'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  036B'   3A 087C'              	LDA	SROW		; delete the cursor's row
  036E'                         SCDL2:
  036E'   47                    	MOV	B,A
  036F'   0E 01                 	MVI	C,1
  0371'   CD 0064'              	CALL	GOTOXY
  0374'   21 0804'              	LXI	H,SDL		; ESC[M (DL): rows below shift up, blank at NEDIT
  0377'   CD 0025'              	CALL	OUTSTR
  037A'   CD 06A9'              	CALL	RDTOP
  037D'   3A 0848'              	LDA	NEDIT
  0380'   3D                    	DCR	A
  0381'   32 0874'              	STA	PROWN		; the bottom row
  0384'   CD 0707'              	CALL	RDSKIP
  0387'   3A 0848'              	LDA	NEDIT
  038A'   CD 008C'              	CALL	GOROW1		; bottom edit row, cleared
  038D'   CD 0720'              	CALL	PAINTR
  0390'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0393'   C3 07D1'              	JMP	SCURS
                                
                                ;SC_IL -- R_ILIN: one line was opened at the cursor's row.  Open a row there
                                ; (ESC[L, region-clamped so the message row is safe) -- the rows below shift
                                ; down and the bottom one falls out of the region -- then draw the cursor's row
                                ; and the one above it: a <CR> (and 'r<CR>') split that one, 'o' and 'O' leave
                                ; it as it was.  Everything else on the screen is already right where it is.
                                ;SC_ILQ -- which of the two forms this is.  A line that opened ON the screen
                                ; leaves the text where it stands (SCRLN = 0); one opened on the bottom row
                                ; has nowhere to put itself, so the screen scrolls up a row to make room
                                ; (SCRLN = 1) -- vim does the same, and it is what every <CR> does once you
                                ; are typing at the end of a file.  Both then draw the same two rows.
  0396'                         SC_ILQ:
  0396'   2A 0851'              	LHLD	SCRLN
  0399'   7C                    	MOV	A,H
  039A'   B5                    	ORA	L
  039B'   CA 03BE'              	JZ	SC_IL		; the text stood still
  039E'   2B                    	DCX	H
  039F'   7C                    	MOV	A,H
  03A0'   B5                    	ORA	L
  03A1'   C2 0256'              	JNZ	SCFULL		; moved by more than a row: not ours
  03A4'   3A 0000*              	LDA	ILN		; and only ONE line can open into one scroll --
  03A7'   FE 01                 	CPI	1		;   a put of several at the bottom needs as many
  03A9'   C2 0256'              	JNZ	SCFULL		;   scrolls as it has lines, which is a repaint
  03AC'   CD 0080'              	CALL	CHIDE
  03AF'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03B2'   CD 00B0'              	CALL	GOTOP
  03B5'   21 0804'              	LXI	H,SDL		; ESC[M at the top: the region scrolls up one,
  03B8'   CD 0025'              	CALL	OUTSTR		;   opening the bottom row for the new line
  03BB'   C3 03DE'              	JMP	SC_ILT
                                
  03BE'                         SC_IL:
  03BE'   CD 0080'              	CALL	CHIDE
  03C1'   CD 044A'              	CALL	SRGN		; scroll region = rows 1..NEDIT
  03C4'   3A 087C'              	LDA	SROW
  03C7'   47                    	MOV	B,A
  03C8'   0E 01                 	MVI	C,1
  03CA'   CD 0064'              	CALL	GOTOXY
  03CD'   21 0808'              	LXI	H,SCSI		; ESC[<ILN>L (IL): ILN blank rows here, the rest
  03D0'   CD 0025'              	CALL	OUTSTR		;   shift down, and what falls past the region's
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  03D3'   3A 0000*              	LDA	ILN		;   bottom row has scrolled off, which is right
  03D6'   CD 002F'              	CALL	EMITB
  03D9'   3E 4C                 	MVI	A,'L'
  03DB'   CD 0018'              	CALL	OUTCH
  03DE'                         SC_ILT:
                                	;--- the first row to draw.  IL opened ILN rows AT the cursor's row and
                                	;    everything above it stands, so the cursor's own row (0-based SROW-1)
                                	;    is where the drawing starts -- 'o', 'O' and a put leave the line
                                	;    above untouched.  ILABOV says the edit took text off that line (a
                                	;    mid-line <CR>, 'r<CR>'), and then it is drawn too. ---
  03DE'   3A 087C'              	LDA	SROW
  03E1'   3D                    	DCR	A		; B = the cursor's own row, the first opened one
  03E2'   47                    	MOV	B,A
  03E3'   3A 0000*              	LDA	ILABOV
  03E6'   B7                    	ORA	A
  03E7'   78                    	MOV	A,B
  03E8'   CA 03EC'              	JZ	SC_IL0
  03EB'   3D                    	DCR	A		; the row above the cursor's, when it is stale
  03EC'                         SC_IL0:
  03EC'   B7                    	ORA	A		; ... clamped: the cursor may be on the top row
  03ED'   F2 03F1'              	JP	SC_IL1
  03F0'   AF                    	XRA	A
  03F1'                         SC_IL1:
  03F1'   32 0874'              	STA	PROWN
  03F4'   78                    	MOV	A,B		; the last row to draw: the opened ones start at
  03F5'   21 0000*              	LXI	H,ILN		;   the cursor's row and there are ILN of them
  03F8'   86                    	ADD	M
  03F9'   3D                    	DCR	A
  03FA'   47                    	MOV	B,A
  03FB'   3A 0848'              	LDA	NEDIT
  03FE'   3D                    	DCR	A		; ... but never past the bottom edit row, which
  03FF'   B8                    	CMP	B		;   is as far as the opened rows can be seen
  0400'   DA 0404'              	JC	SC_IL2
  0403'   78                    	MOV	A,B
  0404'                         SC_IL2:
  0404'   32 087B'              	STA	ILLAST
  0407'   CD 06A9'              	CALL	RDTOP
  040A'   3A 0874'              	LDA	PROWN
  040D'   CD 0707'              	CALL	RDSKIP		; the reader at that row's line
  0410'                         SC_ILL:
  0410'   CD 0427'              	CALL	SC_ILR
  0413'   3A 087B'              	LDA	ILLAST
  0416'   21 0874'              	LXI	H,PROWN
  0419'   BE                    	CMP	M
  041A'   CA 0421'              	JZ	SC_ILD
  041D'   34                    	INR	M
  041E'   C3 0410'              	JMP	SC_ILL
  0421'                         SC_ILD:
  0421'   CD 0086'              	CALL	CRGRS		; restore full-screen region
  0424'   C3 07D1'              	JMP	SCURS		; the cursor back on the text, and shown
                                
                                ;SC_ILR -- draw screen row PROWN from where the reader stands, cleared first.
  0427'                         SC_ILR:
  0427'   3A 0874'              	LDA	PROWN
  042A'   3C                    	INR	A
  042B'   CD 008C'              	CALL	GOROW1
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  042E'   C3 0720'              	JMP	PAINTR
                                
                                ;SCRNOK -- HL = candidate scroll count N.  Return A=N with CY=0 if N is in
                                ; 1..NEDIT-1 (there is on-screen overlap worth preserving); else CY=1 so the
                                ; caller full-repaints.  Clobbers A,B.
  0431'                         SCRNOK:
  0431'   7C                    	MOV	A,H
  0432'   B7                    	ORA	A
  0433'   C2 0448'              	JNZ	SRN_NO		; N >= 256
  0436'   7D                    	MOV	A,L
  0437'   B7                    	ORA	A
  0438'   CA 0448'              	JZ	SRN_NO		; N == 0
  043B'   47                    	MOV	B,A		; B = N
  043C'   3A 0848'              	LDA	NEDIT
  043F'   B8                    	CMP	B		; CY iff NEDIT < N ; Z iff NEDIT == N
  0440'   DA 0448'              	JC	SRN_NO		; N > NEDIT
  0443'   CA 0448'              	JZ	SRN_NO		; N == NEDIT -> no overlap
  0446'   78                    	MOV	A,B		; A = N, CY=0 (from CMP: NEDIT > N)
  0447'   C9                    	RET
  0448'                         SRN_NO:
  0448'   37                    	STC
  0449'   C9                    	RET
                                
                                ;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
                                ; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
  044A'                         SRGN:
  044A'   21 0813'              	LXI	H,SRGP
  044D'   CD 0025'              	CALL	OUTSTR
  0450'   3A 0848'              	LDA	NEDIT
  0453'   CD 002F'              	CALL	EMITB
  0456'   3E 72                 	MVI	A,'r'
  0458'   C3 0018'              	JMP	OUTCH
                                
                                ;CURSC -- the cursor's screen cell (1-based): SROW = WINROW + 1,
                                ; SCOL = CURDCL - HSCROL + 1.  Emits nothing.
  045B'                         CURSC:
  045B'   3A 0849'              	LDA	WINROW
  045E'   3C                    	INR	A
  045F'   32 087C'              	STA	SROW
  0462'   2A 084B'              	LHLD	HSCROL
  0465'   EB                    	XCHG
  0466'   2A 085D'              	LHLD	CURDCL
  0469'   CD 0000*              	CALL	SUBHD		; HL = CURDCL - HSCROL
  046C'   23                    	INX	H
  046D'   7D                    	MOV	A,L
  046E'   32 087D'              	STA	SCOL
  0471'   C9                    	RET
                                
                                ;SCABRT -- RPOLL abort: a key arrived mid-repaint.  Leave the cursor hidden (the
                                ; SHIDE at SCFULL's head still holds) and return WITHOUT positioning/showing it,
                                ; so no cursor flash during a type-ahead burst.  The pending key is dispatched
                                ; next, then SCDRAW runs again and (when the ring finally drains) paints in full
                                ; and shows the cursor -- the aborted frame is simply superseded.
                                ; FORCEF is latched so the next SCDRAW repaints in FULL even if the pending key
                                ; is a pure motion (RENDER.md: an aborted frame stays dirty -- the fast path must
                                ; not be taken over a half-painted screen).
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  0472'                         SCABRT:
  0472'   3E 01                 	MVI	A,1
  0474'   32 0853'              	STA	FORCEF
  0477'   C9                    	RET
                                
                                ;============================================================
                                ; LAYOUT -- WM MEASURE's placement (WM.ASM 3762): where the cursor's line sits
                                ; on the screen and what the screen holds.  Emits nothing.
                                ;   in : WINROW (last frame's row), LNDLT (lines moved since), WFILL
                                ;   out: WINROW (clamped), SCRLN (lines the text moved up), TOPLEN (bytes from
                                ;        the top line's start to the cursor), CBOL (bytes from the cursor
                                ;        line's start), CURDCL, SCBOT, SCEOF, SCBOF, HSCROL/WINRT; WRLIM
                                ;        raised past the top (WM 3784); LNDLT and WFILL cleared.
                                ; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
                                ; (AUXCNT, DIRFLG) are saved and restored around the layout.
                                ;============================================================
  0478'                         LAYOUT:
  0478'   2A 0000*              	LHLD	CMDCNT
  047B'   22 0865'              	SHLD	SVCNT
  047E'   2A 0000*              	LHLD	AUXCNT
  0481'   22 0867'              	SHLD	SVAUX
  0484'   3A 0000*              	LDA	DIRFLG
  0487'   32 0869'              	STA	SVDIR
  048A'   CD 0000*              	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
  048D'   32 0861'              	STA	LYROW
  0490'   CD 05FF'              	CALL	LYFAR		; far off the screen: the middle row
  0493'   2A 0000*              	LHLD	LNDLT
  0496'   22 085F'              	SHLD	LYDLT
  0499'   21 0000               	LXI	H,0
  049C'   22 0000*              	SHLD	LNDLT
  049F'                         LY_TOP:
                                	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
  049F'   3A 0861'              	LDA	LYROW
  04A2'   6F                    	MOV	L,A
  04A3'   26 00                 	MVI	H,0
  04A5'   CD 0000*              	CALL	LINPSB		; HL = that line's start (paged back if needed)
  04A8'   EB                    	XCHG
  04A9'   2A 0000*              	LHLD	GAPBEG
  04AC'   CD 0000*              	CALL	SUBHD		; HL = GAPBEG - top
  04AF'   22 0859'              	SHLD	TOPLEN
  04B2'   24                    	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
  04B3'   22 0000*              	SHLD	WRLIM
                                	;--- [top, GAPBEG): count the lines above; CBOL = bytes after the last LF ---
  04B6'   2A 0859'              	LHLD	TOPLEN
  04B9'   22 085B'              	SHLD	CBOL		; no LF: the cursor's line is the top line
  04BC'   44                    	MOV	B,H
  04BD'   4D                    	MOV	C,L		; BC = bytes
  04BE'   EB                    	XCHG
  04BF'   2A 0000*              	LHLD	GAPBEG
  04C2'   CD 0000*              	CALL	SUBHD		; HL = top
  04C5'   1E 00                 	MVI	E,0		; E = LFs (at most LYROW)
  04C7'                         LY_ABV:
  04C7'   78                    	MOV	A,B
  04C8'   B1                    	ORA	C
  04C9'   CA 04DF'              	JZ	LY_ABD
  04CC'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  04CD'   23                    	INX	H
  04CE'   0B                    	DCX	B
  04CF'   FE 0A                 	CPI	LF
  04D1'   C2 04C7'              	JNZ	LY_ABV
  04D4'   1C                    	INR	E
  04D5'   E5                    	PUSH	H
  04D6'   60                    	MOV	H,B
  04D7'   69                    	MOV	L,C
  04D8'   22 085B'              	SHLD	CBOL		; the cursor's line starts after this LF
  04DB'   E1                    	POP	H
  04DC'   C3 04C7'              	JMP	LY_ABV
  04DF'                         LY_ABD:
  04DF'   3A 0861'              	LDA	LYROW		; fewer lines above (start of file): row = their count
  04E2'   BB                    	CMP	E
  04E3'   DA 04EA'              	JC	LY_BOF
  04E6'   7B                    	MOV	A,E
  04E7'   32 0861'              	STA	LYROW
  04EA'                         LY_BOF:
                                	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
  04EA'   AF                    	XRA	A
  04EB'   32 0857'              	STA	SCBOF
  04EE'   2A 0859'              	LHLD	TOPLEN
  04F1'   EB                    	XCHG
  04F2'   2A 0000*              	LHLD	GAPBEG
  04F5'   CD 0000*              	CALL	SUBHD		; HL = top
  04F8'   EB                    	XCHG
  04F9'   2A 0000*              	LHLD	TXTBEG
  04FC'   CD 0000*              	CALL	CMP16		; Z iff top == TXTBEG
  04FF'   C2 050E'              	JNZ	LYCOL0
  0502'   2A 0000*              	LHLD	OUTPOS		; no records before TXTBEG
  0505'   7C                    	MOV	A,H
  0506'   B5                    	ORA	L
  0507'   C2 050E'              	JNZ	LYCOL0
  050A'   3C                    	INR	A
  050B'   32 0857'              	STA	SCBOF
  050E'                         LYCOL0:
                                	;--- CURDCL = display width of the cursor's line up to the cursor ---
  050E'   21 0000               	LXI	H,0
  0511'   22 085D'              	SHLD	CURDCL
  0514'   2A 085B'              	LHLD	CBOL
  0517'   44                    	MOV	B,H
  0518'   4D                    	MOV	C,L
  0519'   EB                    	XCHG
  051A'   2A 0000*              	LHLD	GAPBEG
  051D'   CD 0000*              	CALL	SUBHD		; HL = line start, BC = bytes to the cursor
  0520'                         LY_COL:
  0520'   78                    	MOV	A,B
  0521'   B1                    	ORA	C
  0522'   CA 0542'              	JZ	LY_FW0
  0525'   7E                    	MOV	A,M
  0526'   23                    	INX	H
  0527'   0B                    	DCX	B
  0528'   FE 0D                 	CPI	CR
  052A'   CA 0520'              	JZ	LY_COL		; CR contributes no display column
  052D'   E5                    	PUSH	H
  052E'   2A 085D'              	LHLD	CURDCL
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0531'   FE 09                 	CPI	TAB
  0533'   C2 053A'              	JNZ	LY_C1
  0536'   7D                    	MOV	A,L		; TAB: to the next multiple of TABWID
  0537'   F6 07                 	ORI	TABWID-1
  0539'   6F                    	MOV	L,A
  053A'                         LY_C1:
  053A'   23                    	INX	H
  053B'   22 085D'              	SHLD	CURDCL
  053E'   E1                    	POP	H
  053F'   C3 0520'              	JMP	LY_COL
  0542'                         LY_FW0:
                                	;--- forward: the cursor's line and the lines below, to the bottom row ---
  0542'   AF                    	XRA	A
  0543'   32 0856'              	STA	SCEOF
  0546'   3A 0861'              	LDA	LYROW
  0549'   47                    	MOV	B,A
  054A'   3A 0848'              	LDA	NEDIT
  054D'   90                    	SUB	B		; A = NEDIT - row = LFs that fill the rows
  054E'   32 0862'              	STA	LYNEED
  0551'   57                    	MOV	D,A
  0552'   1E 00                 	MVI	E,0		; E = LFs seen
  0554'   CD 0000*              	CALL	RGET0
  0557'                         LY_FWD:
  0557'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  055A'   DA 057B'              	JC	LY_EOF
  055D'   32 0864'              	STA	LYLAST
  0560'   FE 0A                 	CPI	LF
  0562'   C2 0557'              	JNZ	LY_FWD
  0565'   1C                    	INR	E
  0566'   7B                    	MOV	A,E
  0567'   BA                    	CMP	D
  0568'   C2 0557'              	JNZ	LY_FWD
  056B'   CD 0000*              	CALL	RDGET		; rows full: is the text over right there?
  056E'   D2 0576'              	JNC	LY_FUL
  0571'   3E 01                 	MVI	A,1
  0573'   32 0856'              	STA	SCEOF
  0576'                         LY_FUL:
  0576'   7A                    	MOV	A,D
  0577'   3D                    	DCR	A		; below = the rows under the cursor's
  0578'   C3 058F'              	JMP	LY_BLW
  057B'                         LY_EOF:
  057B'   3E 01                 	MVI	A,1
  057D'   32 0856'              	STA	SCEOF
  0580'   7B                    	MOV	A,E		; below = LFs, less a final LF (no line after it)
  0581'   B7                    	ORA	A
  0582'   CA 058F'              	JZ	LY_BLW
  0585'   3A 0864'              	LDA	LYLAST
  0588'   FE 0A                 	CPI	LF
  058A'   7B                    	MOV	A,E
  058B'   C2 058F'              	JNZ	LY_BLW
  058E'   3D                    	DCR	A
  058F'                         LY_BLW:
  058F'   32 0863'              	STA	LYBLW
                                	;--- WFILL: '~' rows showing while text above could fill them -> move the
                                	;    cursor's line down by the shortfall and lay out again ---
  0592'   3A 0858'              	LDA	WFILL
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0595'   B7                    	ORA	A
  0596'   CA 05BA'              	JZ	LY_SET
  0599'   AF                    	XRA	A
  059A'   32 0858'              	STA	WFILL
  059D'   3A 0857'              	LDA	SCBOF
  05A0'   B7                    	ORA	A
  05A1'   C2 05BA'              	JNZ	LY_SET
  05A4'   3A 0862'              	LDA	LYNEED
  05A7'   3D                    	DCR	A		; rows under the cursor's
  05A8'   21 0863'              	LXI	H,LYBLW
  05AB'   96                    	SUB	M		; shortfall
  05AC'   CA 05BA'              	JZ	LY_SET
  05AF'   DA 05BA'              	JC	LY_SET
  05B2'   21 0861'              	LXI	H,LYROW
  05B5'   86                    	ADD	M
  05B6'   77                    	MOV	M,A
  05B7'   C3 049F'              	JMP	LY_TOP
  05BA'                         LY_SET:
  05BA'   3A 0861'              	LDA	LYROW		; SCBOT = min(row + below, NEDIT-1)
  05BD'   21 0863'              	LXI	H,LYBLW
  05C0'   86                    	ADD	M
  05C1'   47                    	MOV	B,A
  05C2'   3A 0848'              	LDA	NEDIT
  05C5'   3D                    	DCR	A
  05C6'   B8                    	CMP	B		; CY iff NEDIT-1 < row+below
  05C7'   DA 05CB'              	JC	LY_BOT
  05CA'   78                    	MOV	A,B
  05CB'                         LY_BOT:
  05CB'   32 0855'              	STA	SCBOT
  05CE'   3A 0861'              	LDA	LYROW		; WINROW = row
  05D1'   6F                    	MOV	L,A
  05D2'   26 00                 	MVI	H,0
  05D4'   22 0849'              	SHLD	WINROW
  05D7'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  05D8'   2A 085F'              	LHLD	LYDLT
  05DB'   CD 0000*              	CALL	SUBHD
  05DE'   EB                    	XCHG
  05DF'   2A 084D'              	LHLD	OLDWR
  05E2'   19                    	DAD	D
  05E3'   22 0851'              	SHLD	SCRLN
  05E6'   CD 0639'              	CALL	TABCUR
  05E9'   CD 0659'              	CALL	HPAN
  05EC'   2A 0865'              	LHLD	SVCNT
  05EF'   22 0000*              	SHLD	CMDCNT
  05F2'   2A 0867'              	LHLD	SVAUX
  05F5'   22 0000*              	SHLD	AUXCNT
  05F8'   3A 0869'              	LDA	SVDIR
  05FB'   32 0000*              	STA	DIRFLG
  05FE'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster) for a cursor line that left the screen,
                                ; measured on vim 9.1 with a 23-row window: up to NEDIT/2+1 lines below the
                                ; bottom row or NEDIT/2-2 above the top row, the screen scrolls to it (CURRW's
                                ; clamp); farther, it goes on the middle row, the rows filled from above at
                                ; the end of the file (WFILL) and clamped at its start.
  05FF'                         LYFAR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  05FF'   2A 0849'              	LHLD	WINROW
  0602'   EB                    	XCHG
  0603'   2A 0000*              	LHLD	LNDLT
  0606'   19                    	DAD	D		; HL = the row it would take (signed)
  0607'   3A 0848'              	LDA	NEDIT
  060A'   B7                    	ORA	A
  060B'   1F                    	RAR
  060C'   5F                    	MOV	E,A
  060D'   16 00                 	MVI	D,0		; DE = NEDIT/2
  060F'   7C                    	MOV	A,H
  0610'   B7                    	ORA	A
  0611'   F2 061D'              	JP	LF_DN
  0614'   1B                    	DCX	D
  0615'   1B                    	DCX	D
  0616'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  0617'   7C                    	MOV	A,H
  0618'   B7                    	ORA	A
  0619'   F0                    	RP
  061A'   C3 062B'              	JMP	LF_FAR
  061D'                         LF_DN:
  061D'   E5                    	PUSH	H
  061E'   3A 0848'              	LDA	NEDIT
  0621'   6F                    	MOV	L,A
  0622'   26 00                 	MVI	H,0
  0624'   19                    	DAD	D		; HL = NEDIT + NEDIT/2: the last row that scrolls
  0625'   D1                    	POP	D		; DE = row
  0626'   CD 0000*              	CALL	CMP16		; CY iff row < that, Z iff equal
  0629'   D8                    	RC
  062A'   C8                    	RZ
  062B'                         LF_FAR:
  062B'   3A 0848'              	LDA	NEDIT
  062E'   B7                    	ORA	A
  062F'   1F                    	RAR
  0630'   32 0861'              	STA	LYROW
  0633'   3E 01                 	MVI	A,1
  0635'   32 0858'              	STA	WFILL
  0638'   C9                    	RET
                                
                                ;HPAN -- adjust HSCROL so the cursor's display column is on screen; set WINRT.
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  0639'                         TABCUR:
  0639'   3A 0000*              	LDA	EDMODE
  063C'   FE 00                 	CPI	EM_CMD
  063E'   C0                    	RNZ
  063F'   2A 0000*              	LHLD	TXTEND
  0642'   EB                    	XCHG
  0643'   2A 0000*              	LHLD	GAPEND
  0646'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
  0649'   C8                    	RZ
  064A'   7E                    	MOV	A,M
  064B'   FE 09                 	CPI	TAB
  064D'   C0                    	RNZ
  064E'   2A 085D'              	LHLD	CURDCL
  0651'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0652'   F6 07                 	ORI	TABWID-1
  0654'   6F                    	MOV	L,A
  0655'   22 085D'              	SHLD	CURDCL
  0658'   C9                    	RET
                                
  0659'                         HPAN:
  0659'   2A 085D'              	LHLD	CURDCL		; if CURDCL < HSCROL -> HSCROL = CURDCL
  065C'   EB                    	XCHG
  065D'   2A 084B'              	LHLD	HSCROL
  0660'   CD 0000*              	CALL	CMP16
  0663'   D2 066F'              	JNC	HP_HI
  0666'   2A 085D'              	LHLD	CURDCL
  0669'   22 084B'              	SHLD	HSCROL
  066C'   C3 069A'              	JMP	HP_WR
