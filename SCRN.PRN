  066F'   26 00                 	MVI	H,0
  0671'   3A 0847'              	LDA	NCOLS
  0674'   6F                    	MOV	L,A
  0675'   EB                    	XCHG			; DE = NCOLS
  0676'   2A 084B'              	LHLD	HSCROL
  0679'   19                    	DAD	D
  067A'   EB                    	XCHG			; DE = HSCROL + NCOLS
  067B'   2A 085D'              	LHLD	CURDCL
  067E'   CD 0000*              	CALL	CMP16
  0681'   DA 068A'              	JC	HP_SCR
  0684'   CA 068A'              	JZ	HP_SCR
  0687'   C3 069A'              	JMP	HP_WR
  068A'                         HP_SCR:
  068A'   3A 0847'              	LDA	NCOLS		; HSCROL = CURDCL - (NCOLS-1)
  068D'   3D                    	DCR	A
  068E'   5F                    	MOV	E,A
  068F'   16 00                 	MVI	D,0
  0691'   2A 085D'              	LHLD	CURDCL
  0694'   CD 0000*              	CALL	SUBHD
  0697'   22 084B'              	SHLD	HSCROL
  069A'                         HP_WR:
  069A'   26 00                 	MVI	H,0		; WINRT = HSCROL + NCOLS (right edge, exclusive)
  069C'   3A 0847'              	LDA	NCOLS
  069F'   6F                    	MOV	L,A
  06A0'   EB                    	XCHG
  06A1'   2A 084B'              	LHLD	HSCROL
  06A4'   19                    	DAD	D
  06A5'   22 0878'              	SHLD	WINRT
  06A8'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  06A9'                         RDTOP:
  06A9'   2A 0859'              	LHLD	TOPLEN
  06AC'   C3 06B2'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  06AF'                         RDBOL:
  06AF'   2A 085B'              	LHLD	CBOL
  06B2'                         RDSET:
  06B2'   22 086C'              	SHLD	RDN
  06B5'   EB                    	XCHG
  06B6'   2A 0000*              	LHLD	GAPBEG
  06B9'   CD 0000*              	CALL	SUBHD
  06BC'   22 086A'              	SHLD	RDP
  06BF'   AF                    	XRA	A
  06C0'   32 0872'              	STA	RDSEG
  06C3'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  06C4'                         RDCH:
  06C4'   C5                    	PUSH	B
  06C5'   D5                    	PUSH	D
  06C6'   E5                    	PUSH	H
  06C7'   2A 086C'              	LHLD	RDN		; before-gap bytes left?
  06CA'   7C                    	MOV	A,H
  06CB'   B5                    	ORA	L
  06CC'   CA 06DF'              	JZ	RDC_AF
  06CF'   2B                    	DCX	H
  06D0'   22 086C'              	SHLD	RDN
  06D3'   2A 086A'              	LHLD	RDP
  06D6'   7E                    	MOV	A,M
  06D7'   23                    	INX	H
  06D8'   22 086A'              	SHLD	RDP
  06DB'   B7                    	ORA	A		; CY=0
  06DC'   C3 0703'              	JMP	RDC_RT
  06DF'                         RDC_AF:
  06DF'   3A 0872'              	LDA	RDSEG
  06E2'   B7                    	ORA	A
  06E3'   C2 06F0'              	JNZ	RDC_NX
  06E6'   3C                    	INR	A		; first after-gap byte: start RGET
  06E7'   32 0872'              	STA	RDSEG
  06EA'   CD 0000*              	CALL	RGET0
  06ED'   C3 06F8'              	JMP	RDC_GT
  06F0'                         RDC_NX:
  06F0'   2A 0870'              	LHLD	RDBC
  06F3'   44                    	MOV	B,H
  06F4'   4D                    	MOV	C,L
  06F5'   2A 086E'              	LHLD	RDHL
  06F8'                         RDC_GT:
  06F8'   CD 0000*              	CALL	RDGET
  06FB'   22 086E'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  06FE'   60                    	MOV	H,B
  06FF'   69                    	MOV	L,C
  0700'   22 0870'              	SHLD	RDBC
  0703'                         RDC_RT:
  0703'   E1                    	POP	H
  0704'   D1                    	POP	D
  0705'   C1                    	POP	B
  0706'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0707'                         RDSKIP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  0707'   B7                    	ORA	A
  0708'   C8                    	RZ
  0709'   32 0873'              	STA	SKPN
  070C'                         RSK_LP:
  070C'   CD 06C4'              	CALL	RDCH
  070F'   D8                    	RC
  0710'   FE 0A                 	CPI	LF
  0712'   C2 070C'              	JNZ	RSK_LP
  0715'   3A 0873'              	LDA	SKPN
  0718'   3D                    	DCR	A
  0719'   32 0873'              	STA	SKPN
  071C'   C2 070C'              	JNZ	RSK_LP
  071F'   C9                    	RET
                                
                                ;PAINTR -- paint screen row PROWN: its text, or '~' past the last text row.
                                ; The reader must be at that row's line.  Row already cleared by ESC[K.
  0720'                         PAINTR:
  0720'   3A 0855'              	LDA	SCBOT
  0723'   47                    	MOV	B,A
  0724'   3A 0874'              	LDA	PROWN
  0727'   B8                    	CMP	B		; CY iff row < SCBOT; Z iff equal
  0728'   DA 0733'              	JC	PROW
  072B'   CA 0733'              	JZ	PROW
  072E'   3E 7E                 	MVI	A,'~'
  0730'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: expand tabs, pan by HSCROL, clip to the
                                ; [HSCROL,WINRT) window; the reader ends past the line's LF (or at the end).
  0733'                         PROW:
  0733'   21 0000               	LXI	H,0
  0736'   22 0876'              	SHLD	DCOL
  0739'                         PR_LP:
  0739'   CD 06C4'              	CALL	RDCH
  073C'   D8                    	RC			; end of text -> line done
  073D'   FE 0A                 	CPI	LF
  073F'   C8                    	RZ			; consumed the LF -> next line start
  0740'   FE 0D                 	CPI	CR
  0742'   CA 0739'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0745'   FE 09                 	CPI	TAB
  0747'   CA 0760'              	JZ	PR_TAB
  074A'   47                    	MOV	B,A
  074B'   CD 0787'              	CALL	VISOK		; printable
  074E'   B7                    	ORA	A
  074F'   CA 0756'              	JZ	PR_NOEM
  0752'   78                    	MOV	A,B
  0753'   CD 0018'              	CALL	OUTCH
  0756'                         PR_NOEM:
  0756'   2A 0876'              	LHLD	DCOL
  0759'   23                    	INX	H
  075A'   22 0876'              	SHLD	DCOL
  075D'   C3 0739'              	JMP	PR_LP
  0760'                         PR_TAB:
  0760'   2A 0876'              	LHLD	DCOL		; spaces = 8 - (dcol mod 8)
  0763'   7D                    	MOV	A,L
  0764'   E6 07                 	ANI	7
  0766'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0767'   3E 08                 	MVI	A,8
  0769'   91                    	SUB	C
  076A'   4F                    	MOV	C,A		; C = space count (1..8)
  076B'                         PRTBLP:
  076B'   79                    	MOV	A,C
  076C'   B7                    	ORA	A
  076D'   CA 0739'              	JZ	PR_LP
  0770'   CD 0787'              	CALL	VISOK		; preserves BC
  0773'   B7                    	ORA	A
  0774'   CA 077C'              	JZ	PR_TNOEM
  0777'   3E 20                 	MVI	A,' '
  0779'   CD 0018'              	CALL	OUTCH
  077C'                         PR_TNOEM:
  077C'   2A 0876'              	LHLD	DCOL
  077F'   23                    	INX	H
  0780'   22 0876'              	SHLD	DCOL
  0783'   0D                    	DCR	C
  0784'   C3 076B'              	JMP	PRTBLP
                                
                                ;VISOK -- A = 1 if DCOL is inside [HSCROL, WINRT), else 0.  Preserves BC.
  0787'                         VISOK:
  0787'   2A 0876'              	LHLD	DCOL
  078A'   EB                    	XCHG
  078B'   2A 084B'              	LHLD	HSCROL
  078E'   CD 0000*              	CALL	CMP16		; CY iff dcol < hscrol
  0791'   DA 07A4'              	JC	VIS_NO
  0794'   2A 0876'              	LHLD	DCOL
  0797'   EB                    	XCHG
  0798'   2A 0878'              	LHLD	WINRT
  079B'   CD 0000*              	CALL	CMP16		; CY iff dcol < winrt (visible)
  079E'   D2 07A4'              	JNC	VIS_NO
  07A1'   3E 01                 	MVI	A,1
  07A3'   C9                    	RET
  07A4'                         VIS_NO:
  07A4'   AF                    	XRA	A
  07A5'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  07A6'                         MODEMS:
  07A6'   3A 0000*              	LDA	EDMODE
  07A9'   47                    	MOV	B,A
  07AA'   3A 0854'              	LDA	OEDMOD
  07AD'   B8                    	CMP	B
  07AE'   C8                    	RZ			; the row already shows this mode
  07AF'   78                    	MOV	A,B
  07B0'   32 0854'              	STA	OEDMOD
  07B3'   21 082A'              	LXI	H,SINSM
  07B6'   FE 01                 	CPI	EM_INS
  07B8'   CA 07C6'              	JZ	MD_DRW
  07BB'   21 0837'              	LXI	H,SREPM
  07BE'   FE 02                 	CPI	EM_REP
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  07C0'   CA 07C6'              	JZ	MD_DRW
  07C3'   21 0845'              	LXI	H,SNULL		; command mode: the row goes blank
  07C6'                         MD_DRW:
  07C6'   E5                    	PUSH	H
  07C7'   3A 0846'              	LDA	NROWS
  07CA'   CD 008C'              	CALL	GOROW1
  07CD'   E1                    	POP	H
  07CE'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  07D1'                         SCURS:
  07D1'   3A 087C'              	LDA	SROW
  07D4'   47                    	MOV	B,A
  07D5'   3A 087D'              	LDA	SCOL
  07D8'   4F                    	MOV	C,A
  07D9'   CD 0064'              	CALL	GOTOXY
  07DC'   21 081F'              	LXI	H,SSHOW
  07DF'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  07E2'                         SCDONE:
  07E2'   CD 0086'              	CALL	CRGRS
  07E5'   21 081F'              	LXI	H,SSHOW
  07E8'   CD 0025'              	CALL	OUTSTR
  07EB'   3A 0846'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  07EE'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
  07F1'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  07F5'   39 3B 39 39           
  07F9'   39 48                 
  07FB'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  07FF'   00                    
  0800'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0804'   1B 5B 4D 00           SDL:	DB	ESC,'[','M',0		; DL -- delete line (scroll region up 1)
  0808'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  080B'   1B 4D 00              SRI:	DB	ESC,'M',0		; RI -- reverse index (scroll region down 1)
  080E'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0812'   00                    
  0813'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0817'   00                    
  0818'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  081C'   35 6C 00              
  081F'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0823'   35 68 00              
  0826'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  082A'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  082E'   4E 53 45 52           
  0832'   54 20 2D 2D           
