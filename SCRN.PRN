  0A78'   6F                    	MOV	L,A		;   lines farther up are too big to be shown with
  0A79'   26 00                 	MVI	H,0		;   the cursor's, and held in memory they would
  0A7B'   3A 0E0C'              	LDA	NEDIT		;   leave no room to read down
