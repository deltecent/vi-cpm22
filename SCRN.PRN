  0675'   6F                    	MOV	L,A
  0676'   26 00                 	MVI	H,0
  0678'   22 0B59'              	SHLD	WINROW
  067B'   EB                    	XCHG			; SCRLN = LNDLT - (row - OLDWR)
  067C'   2A 0B72'              	LHLD	LYDLT
  067F'   CD 0000*              	CALL	SUBHD
  0682'   EB                    	XCHG
  0683'   2A 0B5B'              	LHLD	OLDWR
  0686'   19                    	DAD	D
  0687'   22 0B5F'              	SHLD	SCRLN
  068A'   CD 09A5'              	CALL	TABCUR
  068D'   2A 0B89'              	LHLD	SVCNT
  0690'   22 0000*              	SHLD	CMDCNT
  0693'   2A 0B8B'              	LHLD	SVAUX
  0696'   22 0000*              	SHLD	AUXCNT
  0699'   3A 0B8D'              	LDA	SVDIR
  069C'   32 0000*              	STA	DIRFLG
  069F'   C9                    	RET
                                
                                ;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
                                ; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                ; the column that row starts at; all three are kept up.  A row is left only
                                ; when there is a cell more to put, so a line just as wide as the screen is
                                ; one row.
                                ;   A = 0    the line ended, its LF read
                                ;   A = 1    it needs a row the screen has not got (D = NEDIT)
                                ;   A = 0FFH the text ended
  06A0'                         FLINE:
  06A0'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  06A3'   DA 06E0'              	JC	FL_EOF
  06A6'   32 0B88'              	STA	LYLAST
  06A9'   FE 0A                 	CPI	LF
  06AB'   CA 06DE'              	JZ	FL_LF
  06AE'   FE 0D                 	CPI	CR
  06B0'   CA 06A0'              	JZ	FLINE		; CR contributes no display column
  06B3'   FE 09                 	CPI	TAB
  06B5'   CA 06C1'              	JZ	FL_TAB
  06B8'   CD 06E3'              	CALL	FL_CEL
  06BB'   C2 06A0'              	JNZ	FLINE
  06BE'                         FL_OVR:
  06BE'   3E 01                 	MVI	A,1
  06C0'   C9                    	RET
  06C1'                         FL_TAB:
  06C1'   3A 0B7A'              	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
  06C4'   83                    	ADD	E
  06C5'   E6 07                 	ANI	TABWID-1
  06C7'   2F                    	CMA
  06C8'   C6 09                 	ADI	TABWID+1
  06CA'   E5                    	PUSH	H
  06CB'   6F                    	MOV	L,A
  06CC'                         FT_LP:
  06CC'   CD 06E3'              	CALL	FL_CEL
  06CF'   CA 06DA'              	JZ	FT_OVR
  06D2'   2D                    	DCR	L
  06D3'   C2 06CC'              	JNZ	FT_LP
  06D6'   E1                    	POP	H
  06D7'   C3 06A0'              	JMP	FLINE
  06DA'                         FT_OVR:
  06DA'   E1                    	POP	H
  06DB'   C3 06BE'              	JMP	FL_OVR
  06DE'                         FL_LF:
  06DE'   AF                    	XRA	A
  06DF'   C9                    	RET
  06E0'                         FL_EOF:
  06E0'   3E FF                 	MVI	A,0FFH
  06E2'   C9                    	RET
                                ;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
                                ; not got.  Keeps HL, BC.
  06E3'                         FL_CEL:
  06E3'   3A 0B57'              	LDA	NCOLS
  06E6'   BB                    	CMP	E
  06E7'   C2 06F9'              	JNZ	FC_1
  06EA'   1E 00                 	MVI	E,0		; the row is full: the next one, starting NCOLS on
  06EC'   14                    	INR	D
  06ED'   E5                    	PUSH	H
  06EE'   21 0B7A'              	LXI	H,LYVB
  06F1'   86                    	ADD	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  06F2'   77                    	MOV	M,A
  06F3'   E1                    	POP	H
  06F4'   3A 0B58'              	LDA	NEDIT
  06F7'   BA                    	CMP	D
  06F8'   C8                    	RZ
  06F9'                         FC_1:
  06F9'   1C                    	INR	E		; (NZ)
  06FA'   C9                    	RET
                                
                                ;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
                                ; there -- it is the first byte in memory and no record went out before it.
  06FB'                         ISBOF:
  06FB'   EB                    	XCHG
  06FC'   2A 0000*              	LHLD	TXTBEG
  06FF'   CD 0000*              	CALL	CMP16
  0702'   C0                    	RNZ
  0703'   2A 0000*              	LHLD	OUTPOS
  0706'   7C                    	MOV	A,H
  0707'   B5                    	ORA	L
  0708'   C9                    	RET
                                
                                ;LYMID -- the cursor's line is to go in the middle of the screen (WFILL =
                                ; WF_MID): LYROW = the lines that leaves above it.  This is vim's
                                ; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
                                ; take a line below while the rows below are no more than those above, else a
                                ; line above, until a line will not fit.  Past the end of the file a '~' row
                                ; counts as a row below that costs nothing, so there the screen fills from
                                ; above; at the start of the file it stops.
                                ;
                                ; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
                                ; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
                                ; cursor's line, the LYND lines over it and as many under it -- if the screen
                                ; holds them all, the text only scrolls up to the line (LYROW as it was, and
                                ; LAYOUT gives up what lines it must).  If not, it is the middle after all,
                                ; but taking the line above first when the rows are even (LYPRF: vim's
                                ; prefer_above), which is not the same place once lines differ in height.
  0709'                         LYMID:
  0709'   AF                    	XRA	A
  070A'   32 0B74'              	STA	LYROW
  070D'   32 0B80'              	STA	LYMAB
  0710'   32 0B81'              	STA	LYMBL
  0713'   32 0B82'              	STA	LYMEOF
  0716'   3A 0B58'              	LDA	NEDIT
  0719'   3D                    	DCR	A
  071A'   6F                    	MOV	L,A
  071B'   26 00                 	MVI	H,0
  071D'   CD 0000*              	CALL	LINPSB		; as far up as the screen could ever reach
  0720'   CD 0871'              	CALL	G2P
  0723'   22 0B7B'              	SHLD	LYLIM
  0726'   24                    	INR	H
  0727'   22 0000*              	SHLD	WRLIM		; (and none of it spilled while reading down)
  072A'   2A 0000*              	LHLD	GAPBEG
  072D'   CD 084A'              	CALL	PRVL0		; HL = the cursor line's start, BC = bytes to here
  0730'   CD 0830'              	CALL	LM_LNW		; DE = the columns before the cursor
  0733'   CD 07DF'              	CALL	LCROW		; ... and the rest of it: D = its last row
  0736'   D8                    	RC			; (taller than the screen)
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0737'   F2 073D'              	JP	LM_1
  073A'   32 0B82'              	STA	LYMEOF		; the text ends with it
  073D'                         LM_1:
  073D'   7A                    	MOV	A,D
  073E'   3C                    	INR	A
  073F'   32 0B7F'              	STA	LYUSE		; the rows taken so far: its own
  0742'   3A 0B83'              	LDA	LYND
  0745'   B7                    	ORA	A
  0746'   CA 076E'              	JZ	LM_LP
  0749'                         LM_NR:
  0749'   CD 07B8'              	CALL	LMABV		; a line above and a line below, LYND times
  074C'   DA 0763'              	JC	LM_P
  074F'   CD 078B'              	CALL	LMBLW
  0752'   DA 0763'              	JC	LM_P
  0755'   21 0B83'              	LXI	H,LYND
  0758'   35                    	DCR	M
  0759'   C2 0749'              	JNZ	LM_NR
  075C'   3A 0B85'              	LDA	LYSVR		; the screen holds them: scroll to it
  075F'   32 0B74'              	STA	LYROW
  0762'   C9                    	RET
  0763'                         LM_P:
  0763'   AF                    	XRA	A		; it does not: the middle, above first
  0764'   32 0B83'              	STA	LYND
  0767'   3C                    	INR	A
  0768'   32 0B84'              	STA	LYPRF
  076B'   C3 0709'              	JMP	LYMID
  076E'                         LM_LP:
  076E'   3A 0B81'              	LDA	LYMBL
  0771'   21 0B84'              	LXI	H,LYPRF
  0774'   86                    	ADD	M
  0775'   47                    	MOV	B,A
  0776'   3A 0B80'              	LDA	LYMAB
  0779'   B8                    	CMP	B		; CY iff fewer rows above than below (or as
  077A'   DA 0784'              	JC	LM_U		;   many, when above goes first)
  077D'   CD 078B'              	CALL	LMBLW
  0780'   D2 076E'              	JNC	LM_LP
  0783'   C9                    	RET
  0784'                         LM_U:
  0784'   CD 07B8'              	CALL	LMABV
  0787'   D2 076E'              	JNC	LM_LP
  078A'   C9                    	RET
                                
                                ;LMBLW -- LYMID: take the next line below the ones taken -- a '~' row, once
                                ; the text has ended.  CY if the screen has no room for it.
  078B'                         LMBLW:
  078B'   3A 0B82'              	LDA	LYMEOF
  078E'   B7                    	ORA	A
  078F'   C2 07B2'              	JNZ	LB_TL
  0792'   CD 0814'              	CALL	LM_NX
  0795'   F2 07A4'              	JP	LB_1
  0798'   32 0B82'              	STA	LYMEOF		; the text ended: was that a line?
  079B'   3A 0B88'              	LDA	LYLAST
  079E'   FE 0A                 	CPI	LF
  07A0'   CA 07B2'              	JZ	LB_TL
  07A3'   AF                    	XRA	A
  07A4'                         LB_1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  07A4'   37                    	STC
  07A5'   C0                    	RNZ			; one taller than the screen
  07A6'   7A                    	MOV	A,D
  07A7'   3C                    	INR	A		; its rows
  07A8'   CD 0802'              	CALL	LM_ADD
  07AB'   D8                    	RC
  07AC'   21 0B81'              	LXI	H,LYMBL
  07AF'   86                    	ADD	M
  07B0'   77                    	MOV	M,A
  07B1'   C9                    	RET
  07B2'                         LB_TL:
  07B2'   21 0B81'              	LXI	H,LYMBL		; a '~' row
  07B5'   34                    	INR	M
  07B6'   B7                    	ORA	A
  07B7'   C9                    	RET
                                
                                ;LMABV -- LYMID: take the next line above the ones taken (LYROW counts them).
                                ; CY if there is none, or the screen has no room for it.
  07B8'                         LMABV:
  07B8'   2A 0B7D'              	LHLD	LYUP
  07BB'   CD 0871'              	CALL	G2P
  07BE'   CD 083B'              	CALL	PRVLN
  07C1'   D8                    	RC			; the start of the file
  07C2'   CD 0830'              	CALL	LM_LNW
  07C5'   EB                    	XCHG
  07C6'   CD 049B'              	CALL	XTRA		; BC = its rows, less one
  07C9'   78                    	MOV	A,B
  07CA'   B7                    	ORA	A
  07CB'   37                    	STC
  07CC'   C0                    	RNZ
  07CD'   79                    	MOV	A,C
  07CE'   3C                    	INR	A
  07CF'   37                    	STC
  07D0'   C8                    	RZ
  07D1'   CD 0802'              	CALL	LM_ADD
  07D4'   D8                    	RC
  07D5'   21 0B80'              	LXI	H,LYMAB
  07D8'   86                    	ADD	M
  07D9'   77                    	MOV	M,A
  07DA'   21 0B74'              	LXI	H,LYROW
  07DD'   34                    	INR	M
  07DE'   C9                    	RET
                                
                                ;LCROW -- DE = the columns before the cursor on its line: read the rest of
                                ; the line (LM_FL).  D = its last row, counted from 0.  CY if it is taller
                                ; than the screen; else M if the text ended with it.
  07DF'                         LCROW:
  07DF'   EB                    	XCHG
  07E0'   E5                    	PUSH	H
  07E1'   CD 04A2'              	CALL	DIVN		; BC = rows into the line, A = cells in that row
  07E4'   E1                    	POP	H
  07E5'   5F                    	MOV	E,A
  07E6'   7D                    	MOV	A,L
  07E7'   93                    	SUB	E
  07E8'   32 0B7A'              	STA	LYVB
  07EB'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  07EC'   B7                    	ORA	A
  07ED'   37                    	STC
  07EE'   C0                    	RNZ
  07EF'   51                    	MOV	D,C
  07F0'   3A 0B58'              	LDA	NEDIT
  07F3'   3D                    	DCR	A
  07F4'   BA                    	CMP	D
  07F5'   D8                    	RC
  07F6'   CD 0000*              	CALL	RGET0
  07F9'   CD 0823'              	CALL	LM_FL
  07FC'   FE 01                 	CPI	1
  07FE'   37                    	STC
  07FF'   C8                    	RZ
  0800'   B7                    	ORA	A
  0801'   C9                    	RET
                                
                                ;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
                                ; they are taken (LYUSE) and A is kept.
  0802'                         LM_ADD:
  0802'   47                    	MOV	B,A
  0803'   3A 0B7F'              	LDA	LYUSE
  0806'   80                    	ADD	B
  0807'   D8                    	RC
  0808'   4F                    	MOV	C,A
  0809'   3A 0B58'              	LDA	NEDIT
  080C'   B9                    	CMP	C		; CY iff NEDIT < the rows that would make
  080D'   D8                    	RC
  080E'   79                    	MOV	A,C
  080F'   32 0B7F'              	STA	LYUSE
  0812'   78                    	MOV	A,B
  0813'   C9                    	RET
                                
                                ;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
                                ; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
                                ; lines, the registers being wanted for the lines above.
                                ;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
  0814'                         LM_NX:
  0814'   11 0000               	LXI	D,0
  0817'   AF                    	XRA	A
  0818'   32 0B7A'              	STA	LYVB
  081B'   2A 0B94'              	LHLD	RDBC
  081E'   44                    	MOV	B,H
  081F'   4D                    	MOV	C,L
  0820'   2A 0B92'              	LHLD	RDHL
  0823'                         LM_FL:
  0823'   CD 06A0'              	CALL	FLINE
  0826'   22 0B92'              	SHLD	RDHL
  0829'   60                    	MOV	H,B
  082A'   69                    	MOV	L,C
  082B'   22 0B94'              	SHLD	RDBC
  082E'   B7                    	ORA	A
  082F'   C9                    	RET
                                
                                ;LM_LNW -- HL = the start of a line above (or the cursor's), BC = its bytes:
                                ; note it as the highest line taken (LYUP) and measure it (LNW).
  0830'                         LM_LNW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0830'   E5                    	PUSH	H
  0831'   CD 0871'              	CALL	G2P
  0834'   22 0B7D'              	SHLD	LYUP
  0837'   E1                    	POP	H
  0838'   C3 0878'              	JMP	LNW
                                
                                ;PRVLN -- HL = the start of a line: HL = the start of the line before it, BC
                                ; = that line's bytes.  CY if there is none (LYLIM: the text ends there).
                                ;PRVL0 -- the same from inside a line, back to its own start.
  083B'                         PRVLN:
  083B'   CD 0862'              	CALL	PVLIM
  083E'   CD 0000*              	CALL	CMP16
  0841'   37                    	STC
  0842'   C8                    	RZ
  0843'   2B                    	DCX	H		; its LF
  0844'   01 0001               	LXI	B,1
  0847'   C3 0850'              	JMP	PV_LP
  084A'                         PRVL0:
  084A'   CD 0862'              	CALL	PVLIM
  084D'   01 0000               	LXI	B,0
  0850'                         PV_LP:
  0850'   CD 0000*              	CALL	CMP16
  0853'   C8                    	RZ			; (NC) as far up as the text goes
  0854'   2B                    	DCX	H
  0855'   7E                    	MOV	A,M
  0856'   FE 0A                 	CPI	LF
  0858'   CA 085F'              	JZ	PV_DN
  085B'   03                    	INX	B
  085C'   C3 0850'              	JMP	PV_LP
  085F'                         PV_DN:
  085F'   23                    	INX	H
  0860'   B7                    	ORA	A
  0861'   C9                    	RET
                                ;PVLIM -- DE = the address LYLIM stands for.  Keeps HL.
  0862'                         PVLIM:
  0862'   E5                    	PUSH	H
  0863'   2A 0B7B'              	LHLD	LYLIM
  0866'   CD 0871'              	CALL	G2P
  0869'   EB                    	XCHG
  086A'   E1                    	POP	H
  086B'   C9                    	RET
                                
                                ;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
                                ; the cursor.
                                ;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
                                ; the other way about: an address in, its count out.  A refill moves the text,
                                ; so anything kept across a forward read is kept as the count.  Keeps BC.
  086C'                         LYTOPP:
  086C'   2A 0B6A'              	LHLD	TOPLEN
  086F'   44                    	MOV	B,H
  0870'   4D                    	MOV	C,L
  0871'                         G2P:
  0871'   EB                    	XCHG
  0872'   2A 0000*              	LHLD	GAPBEG
  0875'   C3 0000*              	JMP	SUBHD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
                                ; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
                                ; LF, NC when the bytes ran out first.
  0878'                         LNW:
  0878'   11 0000               	LXI	D,0
  087B'                         LNW_LP:
  087B'   78                    	MOV	A,B
  087C'   B1                    	ORA	C
  087D'   C8                    	RZ
  087E'   7E                    	MOV	A,M
  087F'   23                    	INX	H
  0880'   0B                    	DCX	B
  0881'   FE 0A                 	CPI	LF
  0883'   CA 0898'              	JZ	LNW_LF
  0886'   FE 0D                 	CPI	CR
  0888'   CA 087B'              	JZ	LNW_LP		; CR contributes no display column
  088B'   FE 09                 	CPI	TAB
  088D'   C2 0894'              	JNZ	LNW_1
  0890'   7B                    	MOV	A,E		; TAB: to the next multiple of TABWID
  0891'   F6 07                 	ORI	TABWID-1
  0893'   5F                    	MOV	E,A
  0894'                         LNW_1:
  0894'   13                    	INX	D
  0895'   C3 087B'              	JMP	LNW_LP
  0898'                         LNW_LF:
  0898'   37                    	STC
  0899'   C9                    	RET
                                
                                ;LYLEND -- LAYOUT's forward read: a line ended on row D.  The next starts on
                                ; the row under it.  A line that ends with a row it has put nothing on is the
                                ; cursor's, standing past text that filled the row above (an insert at the
                                ; end of a line just as wide as the screen): WR_EOL.  Keeps HL, BC.
  089A'                         LYLEND:
  089A'   7B                    	MOV	A,E
  089B'   B7                    	ORA	A
  089C'   C2 08AB'              	JNZ	LE_1
  089F'   3A 0B79'              	LDA	LYLST
  08A2'   BA                    	CMP	D
  08A3'   CA 08AB'              	JZ	LE_1		; (its first row: an empty line)
  08A6'   3E 03                 	MVI	A,WR_EOL+1
  08A8'   32 0B87'              	STA	LYXE
  08AB'                         LE_1:
  08AB'   14                    	INR	D
  08AC'   7A                    	MOV	A,D
  08AD'   32 0B79'              	STA	LYLST
  08B0'   AF                    	XRA	A
  08B1'   5F                    	MOV	E,A
  08B2'   32 0B7A'              	STA	LYVB
  08B5'   3A 0B78'              	LDA	LYEND
  08B8'   3C                    	INR	A
  08B9'   32 0B78'              	STA	LYEND
  08BC'   C9                    	RET
                                
                                ;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
                                ; line that moved off the screen.  Above the top line it counts LINES: up to
                                ; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; and it goes in the middle (WF_MID).  Below, the line is some lines under the
                                ; last one that showed whole (SCBOT): more than NEDIT of them is the middle
                                ; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
  08BD'                         LYFAR:
  08BD'   2A 0B59'              	LHLD	WINROW
  08C0'   EB                    	XCHG
  08C1'   2A 0000*              	LHLD	LNDLT
  08C4'   19                    	DAD	D		; HL = the lines from the top line to it (signed)
  08C5'   7C                    	MOV	A,H
  08C6'   B7                    	ORA	A
  08C7'   F2 08DE'              	JP	LF_DN
  08CA'   3A 0B58'              	LDA	NEDIT
  08CD'   B7                    	ORA	A
  08CE'   1F                    	RAR
  08CF'   D6 02                 	SUI	2
  08D1'   5F                    	MOV	E,A
  08D2'   16 00                 	MVI	D,0
  08D4'   19                    	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
  08D5'   7C                    	MOV	A,H
  08D6'   B7                    	ORA	A
  08D7'   F0                    	RP
  08D8'                         LF_FAR:
  08D8'   3E 02                 	MVI	A,WF_MID
  08DA'   32 0B68'              	STA	WFILL
  08DD'   C9                    	RET
  08DE'                         LF_DN:
  08DE'   3A 0B63'              	LDA	SCBOT
  08E1'   3C                    	INR	A
  08E2'   5F                    	MOV	E,A
  08E3'   16 00                 	MVI	D,0
  08E5'   CD 0000*              	CALL	SUBHD		; HL = the lines it is under the last one shown,
  08E8'   7C                    	MOV	A,H		;   less one
  08E9'   B7                    	ORA	A
  08EA'   F8                    	RM			; on the screen
  08EB'   C2 08D8'              	JNZ	LF_FAR
  08EE'   3A 0B58'              	LDA	NEDIT
  08F1'   BD                    	CMP	L		; CY iff NEDIT < that
  08F2'   DA 08D8'              	JC	LF_FAR
  08F5'   7D                    	MOV	A,L
  08F6'   32 0B83'              	STA	LYND		; (0: the line right under it only ever scrolls)
  08F9'   C9                    	RET
                                
                                ;HTBLD -- for the scrolls, which count screen rows: the rows each line about
                                ; the cursor takes, in file order, in HTAB[0..HTN).
                                ;   in : B = the lines above the cursor's to take (fewer if the file starts
                                ;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
                                ;        that line, then the ones under it until they come to as many, or the
                                ;        text ends (HTEOF)
                                ;   out: HTCUR = the cursor line's place in the table
                                ; A line taller than the screen counts as a screenful, and ends the table.
                                ; Lines above that memory will not hold all at once are simply not in it: the
                                ; table then starts lower, at a line's start, with HTBOF clear.
                                ; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
  08FA'                         HTBLD:
  08FA'   79                    	MOV	A,C
  08FB'   32 0B86'              	STA	HTLIM
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  08FE'   AF                    	XRA	A
  08FF'   32 0000*              	STA	HTN
  0902'   32 0000*              	STA	HTEOF
  0905'   32 0000*              	STA	HTBOF
  0908'   68                    	MOV	L,B
  0909'   67                    	MOV	H,A
  090A'   CD 0000*              	CALL	LINPSB		; HL = the highest of them (paged back if needed);
  090D'   F5                    	PUSH	PSW		;   CY: memory would not hold them all
  090E'   E5                    	PUSH	H
  090F'   CD 06FB'              	CALL	ISBOF
  0912'   C2 0919'              	JNZ	HB_1
  0915'   3C                    	INR	A
  0916'   32 0000*              	STA	HTBOF
  0919'                         HB_1:
  0919'   E1                    	POP	H
  091A'   E5                    	PUSH	H
  091B'   CD 0871'              	CALL	G2P		; HL = the bytes from there to the cursor
  091E'   44                    	MOV	B,H
  091F'   4D                    	MOV	C,L
  0920'   E1                    	POP	H
  0921'   F1                    	POP	PSW
  0922'   D2 092C'              	JNC	HB_AB
  0925'   3A 0000*              	LDA	HTBOF
  0928'   B7                    	ORA	A
  0929'   CC 0878'              	CZ	LNW		; ... and what it does hold need not start with
                                				;   a line: the table starts at the next one
  092C'                         HB_AB:
  092C'   CD 0878'              	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
  092F'   D2 0952'              	JNC	HB_CU
  0932'   E5                    	PUSH	H
  0933'   C5                    	PUSH	B
  0934'   EB                    	XCHG
  0935'   CD 049B'              	CALL	XTRA		; BC = its rows past the first
  0938'   78                    	MOV	A,B
  0939'   B7                    	ORA	A
  093A'   C2 0947'              	JNZ	HB_TA
  093D'   3A 0B58'              	LDA	NEDIT
  0940'   3D                    	DCR	A
  0941'   B9                    	CMP	C		; CY iff more rows than the screen has
  0942'   79                    	MOV	A,C
  0943'   3C                    	INR	A
  0944'   D2 094A'              	JNC	HB_PA
  0947'                         HB_TA:
  0947'   3A 0B58'              	LDA	NEDIT
  094A'                         HB_PA:
  094A'   CD 098F'              	CALL	HTPUT
  094D'   C1                    	POP	B
  094E'   E1                    	POP	H
  094F'   C3 092C'              	JMP	HB_AB
  0952'                         HB_CU:
  0952'   3A 0000*              	LDA	HTN
  0955'   32 0000*              	STA	HTCUR
  0958'   CD 07DF'              	CALL	LCROW		; the cursor's own line: D = its last row
  095B'   DA 098C'              	JC	HB_TL
  095E'   FA 0981'              	JM	HB_LS		; the text ends with it
  0961'                         HB_PT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0961'   7A                    	MOV	A,D
  0962'   3C                    	INR	A
  0963'   CD 098F'              	CALL	HTPUT
  0966'   47                    	MOV	B,A
  0967'   3A 0B86'              	LDA	HTLIM
  096A'   90                    	SUB	B
  096B'   32 0B86'              	STA	HTLIM
  096E'   D8                    	RC
  096F'   C8                    	RZ			; rows enough
  0970'   CD 0814'              	CALL	LM_NX		; the next line down
  0973'   CA 0961'              	JZ	HB_PT
  0976'   F2 098C'              	JP	HB_TL		; one taller than the screen
  0979'   3A 0B88'              	LDA	LYLAST		; the text ended: was that a line?
  097C'   FE 0A                 	CPI	LF
  097E'   CA 0986'              	JZ	HB_EF
  0981'                         HB_LS:
  0981'   7A                    	MOV	A,D
  0982'   3C                    	INR	A
  0983'   CD 098F'              	CALL	HTPUT
  0986'                         HB_EF:
  0986'   3E 01                 	MVI	A,1
  0988'   32 0000*              	STA	HTEOF
  098B'   C9                    	RET
  098C'                         HB_TL:
  098C'   3A 0B58'              	LDA	NEDIT
                                ;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
                                ; Keeps A, BC, DE, HL.
  098F'                         HTPUT:
  098F'   E5                    	PUSH	H
  0990'   D5                    	PUSH	D
  0991'   21 0000*              	LXI	H,HTN
  0994'   5E                    	MOV	E,M
  0995'   1C                    	INR	E
  0996'   CA 09A2'              	JZ	HP_1
  0999'   73                    	MOV	M,E
  099A'   1D                    	DCR	E
  099B'   16 00                 	MVI	D,0
  099D'   21 0000*              	LXI	H,HTAB
  09A0'   19                    	DAD	D
  09A1'   77                    	MOV	M,A
  09A2'                         HP_1:
  09A2'   D1                    	POP	D
  09A3'   E1                    	POP	H
  09A4'   C9                    	RET
                                
                                ;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
                                ; as vi does (insert mode keeps it at the tab's first column, where the next
                                ; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
  09A5'                         TABCUR:
  09A5'   3A 0000*              	LDA	EDMODE
  09A8'   FE 00                 	CPI	EM_CMD
  09AA'   C0                    	RNZ
  09AB'   2A 0000*              	LHLD	TXTEND
  09AE'   EB                    	XCHG
  09AF'   2A 0000*              	LHLD	GAPEND
  09B2'   CD 0000*              	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  09B5'   C8                    	RZ
  09B6'   7E                    	MOV	A,M
  09B7'   FE 09                 	CPI	TAB
  09B9'   C0                    	RNZ
  09BA'   2A 0B6E'              	LHLD	CURDCL
  09BD'   7D                    	MOV	A,L
  09BE'   F6 07                 	ORI	TABWID-1
  09C0'   6F                    	MOV	L,A
  09C1'   22 0B6E'              	SHLD	CURDCL
  09C4'   C9                    	RET
                                
                                ;============================================================
                                ; TEXT READER -- the screen's text, straight from the gap buffer.  After
                                ; LAYOUT everything on the screen is resident.  Bytes before the gap are read
                                ; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
                                ;============================================================
                                
                                ;RDTOP -- start reading at the top line.
  09C5'                         RDTOP:
  09C5'   2A 0B6A'              	LHLD	TOPLEN
  09C8'   C3 09CE'              	JMP	RDSET
                                ;RDBOL -- start reading at the cursor line's start.
  09CB'                         RDBOL:
  09CB'   2A 0B6C'              	LHLD	CBOL
  09CE'                         RDSET:
  09CE'   22 0B90'              	SHLD	RDN
  09D1'   EB                    	XCHG
  09D2'   2A 0000*              	LHLD	GAPBEG
  09D5'   CD 0000*              	CALL	SUBHD
  09D8'   22 0B8E'              	SHLD	RDP
  09DB'   AF                    	XRA	A
  09DC'   32 0B96'              	STA	RDSEG
  09DF'   C9                    	RET
                                
                                ;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
  09E0'                         RDCH:
  09E0'   C5                    	PUSH	B
  09E1'   D5                    	PUSH	D
  09E2'   E5                    	PUSH	H
  09E3'   2A 0B90'              	LHLD	RDN		; before-gap bytes left?
  09E6'   7C                    	MOV	A,H
  09E7'   B5                    	ORA	L
  09E8'   CA 09FB'              	JZ	RDC_AF
  09EB'   2B                    	DCX	H
  09EC'   22 0B90'              	SHLD	RDN
  09EF'   2A 0B8E'              	LHLD	RDP
  09F2'   7E                    	MOV	A,M
  09F3'   23                    	INX	H
  09F4'   22 0B8E'              	SHLD	RDP
  09F7'   B7                    	ORA	A		; CY=0
  09F8'   C3 0A1F'              	JMP	RDC_RT
  09FB'                         RDC_AF:
  09FB'   3A 0B96'              	LDA	RDSEG
  09FE'   B7                    	ORA	A
  09FF'   C2 0A0C'              	JNZ	RDC_NX
  0A02'   3C                    	INR	A		; first after-gap byte: start RGET
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0A03'   32 0B96'              	STA	RDSEG
  0A06'   CD 0000*              	CALL	RGET0
  0A09'   C3 0A14'              	JMP	RDC_GT
  0A0C'                         RDC_NX:
  0A0C'   2A 0B94'              	LHLD	RDBC
  0A0F'   44                    	MOV	B,H
  0A10'   4D                    	MOV	C,L
  0A11'   2A 0B92'              	LHLD	RDHL
  0A14'                         RDC_GT:
  0A14'   CD 0000*              	CALL	RDGET
  0A17'   22 0B92'              	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
  0A1A'   60                    	MOV	H,B
  0A1B'   69                    	MOV	L,C
  0A1C'   22 0B94'              	SHLD	RDBC
  0A1F'                         RDC_RT:
  0A1F'   E1                    	POP	H
  0A20'   D1                    	POP	D
  0A21'   C1                    	POP	B
  0A22'   C9                    	RET
                                
                                ;RDSKIP -- skip A lines (stops early at the end of the text).
  0A23'                         RDSKIP:
  0A23'   B7                    	ORA	A
  0A24'   C8                    	RZ
  0A25'   32 0B97'              	STA	SKPN
  0A28'                         RSK_LP:
  0A28'   CD 09E0'              	CALL	RDCH
  0A2B'   D8                    	RC
  0A2C'   FE 0A                 	CPI	LF
  0A2E'   C2 0A28'              	JNZ	RSK_LP
  0A31'   3A 0B97'              	LDA	SKPN
  0A34'   3D                    	DCR	A
  0A35'   32 0B97'              	STA	SKPN
  0A38'   C2 0A28'              	JNZ	RSK_LP
  0A3B'   C9                    	RET
                                
                                ;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
                                ; it takes, or the fill char on a row past the text ('~'; '@' where a line did
                                ; not fit).  The reader must be at that row's line.  Row already cleared.
  0A3C'                         PAINTR:
  0A3C'   3A 0B98'              	LDA	PROWN
  0A3F'   21 0B64'              	LXI	H,TXEND
  0A42'   BE                    	CMP	M		; CY iff the row holds text
  0A43'   DA 0A4C'              	JC	PROW
  0A46'   3A 0B65'              	LDA	FILCH
  0A49'   C3 0018'              	JMP	OUTCH
                                
                                ;PROW -- paint the reader's line: tabs expanded, and on to the next row when
                                ; this one is full and there is more (PROWN follows it down).  The reader ends
                                ; past the line's LF (or at the end).
  0A4C'                         PROW:
  0A4C'   AF                    	XRA	A
  0A4D'   32 0B9A'              	STA	DCOL
  0A50'   32 0B9B'              	STA	XC
  0A53'                         PR_LP:
  0A53'   CD 09E0'              	CALL	RDCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0A56'   D8                    	RC			; end of text -> line done
  0A57'   FE 0A                 	CPI	LF
  0A59'   C8                    	RZ			; consumed the LF -> next line start
  0A5A'   FE 0D                 	CPI	CR
  0A5C'   CA 0A53'              	JZ	PR_LP		; drop CR (part of the CR,LF break)
  0A5F'   FE 09                 	CPI	TAB
  0A61'   CA 0A6A'              	JZ	PR_TAB
  0A64'   CD 0A80'              	CALL	PCELL
  0A67'   C3 0A53'              	JMP	PR_LP
  0A6A'                         PR_TAB:
  0A6A'   3A 0B9A'              	LDA	DCOL		; spaces = 8 - (dcol mod 8)
  0A6D'   E6 07                 	ANI	7
  0A6F'   4F                    	MOV	C,A
  0A70'   3E 08                 	MVI	A,8
  0A72'   91                    	SUB	C
  0A73'   4F                    	MOV	C,A		; C = space count (1..8)
  0A74'                         PRTBLP:
  0A74'   3E 20                 	MVI	A,' '
  0A76'   CD 0A80'              	CALL	PCELL		; (keeps C)
  0A79'   0D                    	DCR	C
  0A7A'   C2 0A74'              	JNZ	PRTBLP
  0A7D'   C3 0A53'              	JMP	PR_LP
                                
                                ;PCELL -- put the char in A on the next cell of the line.  Keeps C.
  0A80'                         PCELL:
  0A80'   47                    	MOV	B,A
  0A81'   21 0B9A'              	LXI	H,DCOL
  0A84'   34                    	INR	M
  0A85'   3A 0B57'              	LDA	NCOLS
  0A88'   21 0B9B'              	LXI	H,XC
  0A8B'   BE                    	CMP	M
  0A8C'   CC 0A94'              	CZ	PWRAP		; the row is full: this one starts the next
  0A8F'   34                    	INR	M
  0A90'   78                    	MOV	A,B
  0A91'   C3 0018'              	JMP	OUTCH
                                ;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
                                ; relied on).  From the last edit row there is nowhere to go: the rest of the
                                ; line is not shown, and PROW returns to its caller from here.
  0A94'                         PWRAP:
  0A94'   36 00                 	MVI	M,0
  0A96'   3A 0B58'              	LDA	NEDIT
  0A99'   3D                    	DCR	A
  0A9A'   21 0B98'              	LXI	H,PROWN
  0A9D'   BE                    	CMP	M
  0A9E'   CA 0AB3'              	JZ	PW_END
  0AA1'   34                    	INR	M
  0AA2'   3E 0D                 	MVI	A,CR
  0AA4'   CD 0018'              	CALL	OUTCH
  0AA7'   3E 0A                 	MVI	A,LF
  0AA9'   CD 0018'              	CALL	OUTCH
  0AAC'   CD 0092'              	CALL	CEKL		; (keeps BC)
  0AAF'   21 0B9B'              	LXI	H,XC
  0AB2'   C9                    	RET
  0AB3'                         PW_END:
  0AB3'   E1                    	POP	H		; PCELL's return, and PROW's
  0AB4'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0AB5'   C9                    	RET
                                
                                ;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
                                ; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
                                ; command mode.  It is drawn only when the mode differs from what the row last
                                ; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
                                ; so an ex message stays put until the mode really changes, the way vim's load
                                ; message survives every motion.  The cursor goes back where SCDRAW left it.
  0AB6'                         MODEMS:
  0AB6'   3A 0000*              	LDA	EDMODE
  0AB9'   47                    	MOV	B,A
  0ABA'   3A 0B62'              	LDA	OEDMOD
  0ABD'   B8                    	CMP	B
  0ABE'   C8                    	RZ			; the row already shows this mode
  0ABF'   78                    	MOV	A,B
  0AC0'   32 0B62'              	STA	OEDMOD
  0AC3'   21 0B3A'              	LXI	H,SINSM
  0AC6'   FE 01                 	CPI	EM_INS
  0AC8'   CA 0AD6'              	JZ	MD_DRW
  0ACB'   21 0B47'              	LXI	H,SREPM
  0ACE'   FE 02                 	CPI	EM_REP
  0AD0'   CA 0AD6'              	JZ	MD_DRW
  0AD3'   21 0B55'              	LXI	H,SNULL		; command mode: the row goes blank
  0AD6'                         MD_DRW:
  0AD6'   E5                    	PUSH	H
  0AD7'   3A 0B56'              	LDA	NROWS
  0ADA'   CD 008C'              	CALL	GOROW1
  0ADD'   E1                    	POP	H
  0ADE'   CD 0025'              	CALL	OUTSTR
                                ;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
                                ; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
  0AE1'                         SCURS:
  0AE1'   3A 0B9E'              	LDA	SROW
  0AE4'   47                    	MOV	B,A
  0AE5'   3A 0B9F'              	LDA	SCOL
  0AE8'   4F                    	MOV	C,A
  0AE9'   CD 0064'              	CALL	GOTOXY
  0AEC'   21 0B2F'              	LXI	H,SSHOW
  0AEF'   C3 0025'              	JMP	OUTSTR
                                
                                ;============================================================
                                ; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
                                ; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
                                ; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
                                ; the bottom row.  Emitting one here too cost a second row for nothing.
                                ;============================================================
  0AF2'                         SCDONE:
  0AF2'   CD 0086'              	CALL	CRGRS
  0AF5'   21 0B2F'              	LXI	H,SSHOW
  0AF8'   CD 0025'              	CALL	OUTSTR
  0AFB'   3A 0B56'              	LDA	NROWS		; bottom left, over the message row -- and blank:
  0AFE'   C3 008C'              	JMP	GOROW1		;   the CCP prompt lands here
                                
                                ;============================================================
                                ; STRINGS (0-terminated)
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0B01'   1B 5B 39 39           SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
  0B05'   39 3B 39 39           
  0B09'   39 48                 
  0B0B'   1B 5B 36 6E           	DB	ESC,'[','6','n',0
  0B0F'   00                    
  0B10'   1B 5B 4B 00           SEK:	DB	ESC,'[','K',0
  0B14'   1B 5B 4D 00           SDL:	DB	ESC,'[','M',0		; DL -- delete line (scroll region up 1)
  0B18'   1B 5B 00              SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
  0B1B'   1B 4D 00              SRI:	DB	ESC,'M',0		; RI -- reverse index (scroll region down 1)
  0B1E'   1B 5B 31 40           SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
  0B22'   00                    
  0B23'   1B 5B 31 3B           SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
  0B27'   00                    
  0B28'   1B 5B 3F 32           SHIDE:	DB	ESC,'[','?','2','5','l',0
  0B2C'   35 6C 00              
  0B2F'   1B 5B 3F 32           SSHOW:	DB	ESC,'[','?','2','5','h',0
  0B33'   35 68 00              
  0B36'   1B 5B 72 00           SREGRS: DB	ESC,'[','r',0
  0B3A'   2D 2D 20 49           SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
  0B3E'   4E 53 45 52           
  0B42'   54 20 2D 2D           
  0B46'   00                    
  0B47'   2D 2D 20 52           SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
  0B4B'   45 50 4C 41           
  0B4F'   43 45 20 2D           
  0B53'   2D 00                 
  0B55'   00                    SNULL:	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  0B56'   18                    NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
  0B57'   50                    NCOLS:	DB	80		; runtime columns
  0B58'   17                    NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)
                                
  0B59'   0000                  WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
  0B5B'   0000                  OLDWR:	DW	0		; WINROW as displayed before this frame
  0B5D'   00                    WRAPF:	DB	0		; this frame: 0, 1 = a line wraps, WR_EOL and up =
                                				;   ... and the cursor has a row to itself
  0B5E'   00                    OLDWF:	DB	0		; WRAPF as displayed before this frame
  0B5F'   0000                  SCRLN:	DW	0		; lines the text moved up this frame (signed)
  0B61'   00                    FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
  0B62'   00                    OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)
                                
  0B63'   00                    SCBOT:	DB	0		; WINROW of the last line shown
  0B64'   01                    TXEND:	DB	1		; the first row with no text on it
  0B65'   7E                    FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
  0B66'   00                    SCEOF:	DB	0		; 1 = the end of the file is on the screen
  0B67'   00                    SCBOF:	DB	0		; 1 = the top row is the file's first line
  0B68'   00                    WFILL:	DB	0		; one layout: 1 = the command placed the cursor's
                                				;   line (WINROW), WF_MID = put it mid-screen
  0B69'   00                    CSUB:	DB	0		; the row of its line the cursor is on (0 = first)
                                
  0B6A'   0000                  TOPLEN: DW	0		; bytes from the top line's start to the cursor
  0B6C'   0000                  CBOL:	DW	0		; bytes from the cursor line's start to the cursor
  0B6E'   0000                  CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0B70'   0000                  LYABV:	DW	0		; rows the lines above the cursor's take
  0B72'   0000                  LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
  0B74'   00                    LYROW:	DB	0		; LAYOUT: working row
  0B75'   0000                  LYNEED: DW	0		; LAYOUT: rows to free at the top
  0B77'   00                    LYBLW:	DB	0		; LAYOUT: lines shown below the cursor's
  0B78'   00                    LYEND:	DB	0		; LAYOUT: lines that ended in the forward read
  0B79'   00                    LYLST:	DB	0		; LAYOUT: the row the line being read starts on
  0B7A'   00                    LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
                                				;   byte: TAB stops)
  0B7B'   0000                  LYLIM:	DW	0		; LYMID: bytes back to the highest line there is
  0B7D'   0000                  LYUP:	DW	0		; LYMID: bytes back to the highest line taken
  0B7F'   00                    LYUSE:	DB	0		; LYMID: rows taken
  0B80'   00                    LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
  0B81'   00                    LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
  0B82'   00                    LYMEOF: DB	0		; LYMID: the text has ended
  0B83'   00                    LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
  0B84'   00                    LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
  0B85'   00                    LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
  0B86'   00                    HTLIM:	DB	0		; HTBLD: rows still to gather
  0B87'   00                    LYXE:	DB	0		; LAYOUT: WR_EOL+1 when the cursor has its own row
  0B88'   00                    LYLAST: DB	0		; LAYOUT: last byte read forward
  0B89'   0000                  SVCNT:	DW	0		; LAYOUT: saved CMDCNT
  0B8B'   0000                  SVAUX:	DW	0		; LAYOUT: saved AUXCNT
  0B8D'   00                    SVDIR:	DB	0		; LAYOUT: saved DIRFLG
                                
  0B8E'   0000                  RDP:	DW	0		; reader: next before-gap byte
  0B90'   0000                  RDN:	DW	0		; reader: before-gap bytes left
  0B92'   0000                  RDHL:	DW	0		; reader: RGET pointer
  0B94'   0000                  RDBC:	DW	0		; reader: RGET count
  0B96'   00                    RDSEG:	DB	0		; reader: 1 once reading after the gap
  0B97'   00                    SKPN:	DB	0		; RDSKIP line count
  0B98'   00                    PROWN:	DB	0		; screen row being painted (0-based)
  0B99'   00                    SCLN:	DB	0		; region-scroll line count (N, 1..NEDIT-1)
  0B9A'   00                    DCOL:	DB	0		; column in the line while painting (low byte)
  0B9B'   00                    XC:	DB	0		; cells used in the row being painted
  0B9C'   00                    ROWCT:	DB	0		; RI count (SCBWD)
  0B9D'   00                    ILLAST: DB	0		; ... and the last screen row it draws
                                
  0B9E'   00                    SROW:	DB	0		; computed cursor screen row
  0B9F'   00                    SCOL:	DB	0		; computed cursor screen column
  0BA0'   0000                  TMPR:	DW	0		; DSR parse: rows
  0BA2'   0000                  TMPC:	DW	0		; DSR parse: cols
                                
                                	END
