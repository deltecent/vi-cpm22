;============================================================
; FILE:    SCRN.MAC
; PROJECT: VI
; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
;------------------------------------------------------------
; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
; the screen is placed relative to the CURSOR, never counted from the start of
; the window.  WINROW is the cursor line's screen row.  Each frame:
;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
;     edit rows;
;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
;     cursor's -- the top of the screen -- paging back if it is on disk;
;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
;     screen is never spilled;
;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
;     demand (WM NEEDIN).
; So a frame costs one screenful of text however deep the cursor is.  The
; bytes are read straight from the gap buffer: before the gap by pointer (kept
; relative to GAPBEG, since a refill can move the text), after it by RGET.
;
; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
; under it.  So WINROW counts LINES -- how many are on the screen above the
; cursor's -- and the layout turns that into rows by measuring each of them.
; The top row is always the start of a line; a line the bottom has no room
; for is not shown, its rows hold '@'.
;
; Also here (RENDER.md): runtime geometry (DSR probe), the RINTENT fast paths
; (cursor-only, region scroll up/down, one-row redraw, ICH insert, DL line
; delete), the RPOLL repaint abort, and the message row.  The region scrolls
; take their line count from SCRLN, the number of lines the text moved up this
; frame.  Every fast path but the cursor-only one takes a line to be a row, so
; none is used while a wrapped line is on the screen (WRAPF).
;
; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
;          SCINIT, SCDRAW, SCDONE, SCPRE
;          NROWS, NCOLS, NEDIT         (runtime geometry)
;          WINROW                      (lines on the screen above the cursor's;
;                                       CMD.MAC sets it)
;          SCBOT, SCEOF, SCBOF, WFILL  (last layout's facts; fill request)
;============================================================
	INCLUDE VI.INC

	PUBLIC	BCONST, BCONIN, BCONOU
	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE
	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
	PUBLIC	NROWS, NCOLS, NEDIT
	PUBLIC	WINROW			; lines above the cursor's (signed word)
	PUBLIC	SCBOT			; WINROW of the last line shown
	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
	PUBLIC	WFILL			; request: the cursor's line placed / mid-screen
	PUBLIC	TXEND			; the first row with no text on it ('M')
	PUBLIC	CSUB			; the row of its line the cursor is on
	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')

	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
	EXTRN	HTAB			; RSV.MAC -- the row table itself

WR_EOL	EQU	2		; WRAPF from here up: the cursor has a row to itself
WF_MID	EQU	2		; WFILL: the cursor's line in the middle of the screen

	CSEG

;============================================================
; BIOS-DIRECT CONSOLE (WM BIOSC).
; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
; no cached vector, no self-modifying target -- exactly as WM does.
;============================================================

;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
BCONST:
	LHLD	1
	LXI	D,3
	DAD	D
	PCHL			; -> BIOS CONST, RETs to our caller

;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
BCONIN:
	LHLD	1
	LXI	D,6
	DAD	D
	PCHL			; -> BIOS CONIN

;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
BCONOU:
	LHLD	1
	LXI	D,9
	DAD	D
	PCHL			; -> BIOS CONOUT (char in C)

;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
; The paint loops keep their pointers in HL/DE across emits, so this must be
; register-transparent.
OUTCH:
	PUSH	PSW
	PUSH	B
	PUSH	D
	PUSH	H
	MOV	C,A
	CALL	BCONOU
	POP	H
	POP	D
	POP	B
	POP	PSW
	RET

;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
OUTSTR:
	MOV	A,M
	ORA	A
	RZ
	CALL	OUTCH		; preserves HL
	INX	H
	JMP	OUTSTR

;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
EMITB:
	PUSH	B
	PUSH	D
	MOV	E,A		; E = value
	MVI	B,0		; B = "a digit has been printed" flag
	MVI	D,100
	CALL	EMDIG
	MVI	D,10
	CALL	EMDIG
	MOV	A,E		; ones digit: always printed
	ADI	'0'
	CALL	OUTCH
	POP	D
	POP	B
	RET
;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
EMDIG:
	MVI	C,0
EMD_LP:
	MOV	A,E
	SUB	D
	JC	EMD_DN
	MOV	E,A
	INR	C
	JMP	EMD_LP
EMD_DN:
	MOV	A,C
	ORA	A
	JNZ	EMD_PR		; nonzero digit -> print
	MOV	A,B
	ORA	A
	RZ			; leading zero -> skip
EMD_PR:
	MOV	A,C
	ADI	'0'
	CALL	OUTCH		; preserves B,C,D,E
	MVI	B,1
EMD_RT:
	RET

;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
GOTOXY:
	MVI	A,ESC
	CALL	OUTCH
	MVI	A,'['
	CALL	OUTCH
	MOV	A,B
	CALL	EMITB
	MVI	A,';'
	CALL	OUTCH
	MOV	A,C
	CALL	EMITB
	MVI	A,'H'
	JMP	OUTCH

;--- the four things every paint does, each written once ------------------
;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
CHIDE:
	LXI	H,SHIDE
	JMP	OUTSTR
;CRGRS -- put the scroll region back to the whole screen.
CRGRS:
	LXI	H,SREGRS
	JMP	OUTSTR
;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
; through to CEKL, which is that clear on its own.
GOROW1:
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
;CEKL -- clear from the cursor to the end of its row (ESC[K).
CEKL:
	LXI	H,SEK
	JMP	OUTSTR
;PTROW -- paint the line at row PROWN and step to the row under it: clear the
; row, write the line (on as many rows as it takes), CR/LF (the last LF of a
; full repaint lands on the message row, and a backward scroll's N <= NEDIT-1
; keeps it inside the region), and count the row off.  Both paint loops are
; this, once each.  When the cursor has a row to itself (WR_EOL) that row is
; the one under its line's text, and is cleared and counted here as well.
PTROW:
	CALL	CEKL		; ESC[K -- clear the row
	CALL	PAINTR
	CALL	PT_NL
	LDA	WRAPF
	CPI	WR_EOL
	RC
	LDA	SROW
	DCR	A
	LXI	H,PROWN
	CMP	M
	RNZ
	CALL	CEKL
PT_NL:
	MVI	A,CR
	CALL	OUTCH
	MVI	A,LF
	CALL	OUTCH
	LXI	H,PROWN
	INR	M
	RET

;GOTOP -- address row 1, column 1 (the scroll region's top row).
GOTOP:
	MVI	B,1
	MVI	C,1
	JMP	GOTOXY

;============================================================
; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
; malformed byte -> keep the 24x80 defaults.
;============================================================
SCINIT:
	LXI	H,0
	SHLD	WINROW
	LXI	H,SPROBE
	CALL	OUTSTR
	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
	DCR	A
	STA	NEDIT
	RET

;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
; falls back to defaults rather than hanging.  Clobbers HL.
RDB:
	LXI	H,0
RDB_LP:
	PUSH	H
	CALL	BCONST
	POP	H
	ORA	A
	JNZ	RDB_GO
	DCX	H
	MOV	A,H
	ORA	L
	JNZ	RDB_LP
	STC			; timeout
	RET
RDB_GO:
	CALL	BCONIN
	ORA	A		; CY=0, A=byte
	RET

;RDNUM -- read ASCII digits into DE until a non-digit terminator.
; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
RDNUM:
	LXI	D,0
RN_LP:
	PUSH	D
	CALL	RDB
	POP	D
	RC
	CPI	'0'
	JC	RN_DN
	CPI	'9'+1
	JNC	RN_DN
	SUI	'0'
	MOV	C,A		; C = this digit
	MOV	H,D		; HL = value
	MOV	L,E
	DAD	H		; 2x
	MOV	D,H
	MOV	E,L		; DE = 2x
	DAD	H		; 4x
	DAD	H		; 8x
	DAD	D		; 10x
	MVI	B,0		; BC = digit
	DAD	B		; HL = 10x + digit
	XCHG			; DE = new value
	JMP	RN_LP
RN_DN:
	ORA	A		; CY=0, A = terminator
	RET

;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
RDNUMS:
	CALL	RDB
	RC
	CPI	ESC
	RNZ			; not what a DSR reply looks like
	CALL	RDB
	RC
	CPI	'['
	RNZ			; not what a DSR reply looks like
	CALL	RDNUM		; DE = rows
	RC
	CPI	';'
	RNZ			; not what a DSR reply looks like
	XCHG
	SHLD	TMPR
	CALL	RDNUM		; DE = cols
	RC
	CPI	'R'
	RNZ			; not what a DSR reply looks like
	XCHG
	SHLD	TMPC
	LHLD	TMPR		; rows -> clamp [24,200]
	MVI	B,24
	MVI	C,200
	CALL	CLAMP
	STA	NROWS
	LHLD	TMPC		; cols -> clamp [80,132]
	MVI	B,80
	MVI	C,132
	CALL	CLAMP
	STA	NCOLS
RS_BAD:
	RET

;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
CLAMP:
	MOV	A,H
	ORA	A
	JNZ	CLP_MAX		; value > 255 -> max
	MOV	A,L
	CMP	B
	JC	CLP_MIN		; value < min
	MOV	A,C
	CMP	L		; CY iff max < value
	JC	CLP_MAX
	MOV	A,L
	RET
CLP_MIN:
	MOV	A,B
	RET
CLP_MAX:
	MOV	A,C
	RET

;============================================================
; FRAME -- lay out, then pick the cheapest correct paint.
;============================================================

;SCPRE -- snapshot what is on the screen (WINROW/WRAPF) into OLDWR/OLDWF.  The
; main loop calls this after reading a key and before dispatch, so SCDRAW can
; tell how far the text moved (SCRLN) and whether a line was wrapped.
SCPRE:
	LHLD	WINROW
	SHLD	OLDWR
	LDA	WRAPF
	STA	OLDWF
	RET

SCDRAW:
	CALL	LAYOUT		; WINROW/SCRLN/SCBOT/CURDCL/WRAPF (no output)
	CALL	CURSC		; SROW/SCOL
	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
	ORA	A
	JNZ	SCFULL
	LDA	WRAPF		; the wrapping on this screen, or on the last
	LXI	H,OLDWF
	ORA	M
	MOV	B,A
	CPI	WR_EOL		; a row only the cursor holds came or went: the
	JNC	SCFULL		;   lines under it moved, whatever the key was
	LDA	RINTENT
	CPI	R_MOVE
	JNZ	SC_WR
	LHLD	SCRLN
	MOV	A,H
	ORA	L
	JZ	SCURS		; text still -> cursor only, wrapped or not
SC_WR:
	MOV	A,B		; every paint from here on takes a line to be a
	ORA	A		;   row: a wrapped one on the screen -> repaint
	JNZ	SCFULL
	LDA	RINTENT
	CPI	R_MOVE
	JZ	SC_MV
	CPI	R_LINE
	JZ	SC_ED
	CPI	R_ICH
	JZ	SC_ED
	CPI	R_ILIN
	JZ	SC_ILQ		; (its own test: it moves the cursor's row, and
	CPI	R_DLIN		;   on the bottom row it scrolls the text too)
	JZ	SC_ED
	CPI	R_JOIN
	JNZ	SCFULL		; anything else -> full repaint
SC_ED:
	;--- the in-place edit paints need the text to have stayed put ---
	LHLD	SCRLN
	MOV	A,H
	ORA	L
	JNZ	SCFULL
	LHLD	OLDWR
	XCHG
	LHLD	WINROW
	CALL	CMP16		; Z iff the cursor kept its row
	JNZ	SCFULL
	LDA	RINTENT
	CPI	R_LINE
	JZ	SC_LNBD
	CPI	R_ICH
	JZ	SC_ICH
	CPI	R_JOIN
	JZ	SC_JN
	JMP	SCDL
SC_MV:
	;--- R_MOVE: the text moved up SCRLN lines (down if negative) ---
	LHLD	SCRLN
	MOV	A,H
	ORA	A
	JP	SC_FWD
	XCHG
	LXI	H,0
	CALL	SUBHD		; HL = -SCRLN
	CALL	SCRNOK		; A = N (CY=0) if 1..NEDIT-1, else CY=1
	JC	SCFULL
	STA	SCLN
	JMP	SCBWD
SC_FWD:
	CALL	SCRNOK
	JC	SCFULL
	STA	SCLN		; N in 1..NEDIT-1 -> region scroll
	JMP	SCFWD
SC_ICH:
	;--- the inserted char sits at screen column SCOL-1; it must be a real
	;    on-screen cell (SCOL >= 2), else fall back to the whole-line redraw ---
	LDA	SCOL
	CPI	2
	JC	SC_LNBD
	;--- appended at the row's end (ICHAPP): the cell is blank and nothing
	;    follows it, so the char alone is the whole frame -- no ICH to open a
	;    cell for it, and no hide/show, there being nothing to see happen
	;    between the address and the byte.  The terminal leaves the cursor at
	;    SCOL, where insert mode wants it, exactly as the ICH path does. ---
	LDA	ICHAPP
	ORA	A
	JNZ	SC_ICA
	CALL	CHIDE
	CALL	SC_ICG		; address the inserted char's cell (SROW, SCOL-1)
	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
	CALL	OUTSTR
	CALL	SC_ICC		; fills the opened cell; cursor advances to SCOL
	LXI	H,SSHOW
	JMP	OUTSTR
SC_ICA:
	CALL	SC_ICG
	JMP	SC_ICC
;SC_ICG -- address the inserted char's cell, (SROW, SCOL-1).
SC_ICG:
	LDA	SROW
	MOV	B,A
	LDA	SCOL
	DCR	A
	MOV	C,A
	JMP	GOTOXY
;SC_ICC -- emit the just-inserted byte, which is right before the gap.
SC_ICC:
	LHLD	GAPBEG
	DCX	H
	MOV	A,M
	JMP	OUTCH
SC_LNBD:
	;--- R_LINE: redraw only the cursor's row (tabs re-expanded), then
	;    re-address and show the cursor ---
	CALL	CHIDE
	LDA	SROW
	CALL	GOROW1		; column 1 of the current row, cleared
	CALL	RDBOL		; read from the cursor line's first byte
	CALL	PROW
	JMP	SCURS

;SCFULL -- paint edit rows 1..NEDIT in place (home + CR,LF stepping), each
; cleared with ESC[K; a line takes as many rows as it is wide, and the rows
; past the text show '~' (or '@').  No ESC[2J (no blank flash).
; Message row last; cursor hidden throughout, then addressed and shown.
SCFULL:
	CALL	CHIDE
	CALL	RDTOP
	CALL	GOTOP		; home to row 1
	XRA	A
	STA	PROWN
ROW_LP:
	CALL	KBRDY		; RPOLL: a key is waiting -> abort this repaint
	ORA	A
	JNZ	SCABRT
	LDA	NEDIT
	MOV	B,A
	LDA	PROWN
	CMP	B
	JNC	ROWS_DN
	CALL	PTROW		; the row, then down to the next one
	JMP	ROW_LP
ROWS_DN:
	;--- message row (now at NROWS, col 1): vim leaves it blank ---
	CALL	CEKL
	MVI	A,0FFH		; the row is blank now, so whatever message was
	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
	CALL	SCURS
	XRA	A		; a full frame completed -> clear the abort latch
	STA	FORCEF
	RET

;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
; shown.  The message owns the row from here: OEDMOD is marked up to date so
; MODEMS does not blank it out from under the message on the next frame.
EXPRM:
	PUSH	PSW
	LDA	EDMODE
	STA	OEDMOD
	LDA	NROWS
	CALL	GOROW1
	POP	PSW
	JMP	OUTCH

;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
; space, left).
EXRUB:
	LXI	H,SRUB
	JMP	OUTSTR
SRUB:	DB	BS,' ',BS,0

;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
; an error there.  It stays until the mode changes or a full repaint clears it.
EXMSG:
	MOV	A,M
	INX	H
	PUSH	H
	CALL	EXPRM
	POP	H
	JMP	OUTSTR

;SCFWD -- the text moved up N rows (SCLN, 1..NEDIT-1), no line wrapped.
; Clamp the scroll region to the edit rows (message row protected), then N times:
; delete the top region row (ESC[M) -- the terminal scrolls the region up one
; line -- and draw the newly exposed row into row NEDIT.  Only the N exposed
; rows (NEDIT-N .. NEDIT-1) are drawn; the overlap the terminal shifted is never
; re-sent.  Short and bounded, so it runs to completion (no RPOLL abort).
SCFWD:
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	CALL	RDTOP
	LDA	SCLN
	MOV	B,A
	LDA	NEDIT
	SUB	B		; A = NEDIT - N = first exposed row
	STA	PROWN
	CALL	RDSKIP		; reader at that row's line
SFW_LP:
	LDA	SCLN
	ORA	A
	JZ	SFW_DN
	CALL	GOTOP		; region top row
	LXI	H,SDL		; ESC[M (DL) at the top: region scrolls up 1
	CALL	OUTSTR
	LDA	NEDIT		; draw the exposed row into the bottom edit row
	CALL	GOROW1		; ... addressed and cleared
	CALL	PAINTR
	LDA	PROWN
	INR	A
	STA	PROWN
	LDA	SCLN
	DCR	A
	STA	SCLN
	JMP	SFW_LP
SFW_DN:
	CALL	CRGRS		; restore full-screen region
	JMP	SCURS		; address and show the cursor at its new cell

;SCBWD -- the text moved down N rows (SCLN, 1..NEDIT-1), no line wrapped.
; Clamp the scroll region to the edit rows, Reverse-Index (ESC M) N times at the
; region top -- the terminal scrolls the region down, opening N blank rows at
; the top -- then draw rows 0..N-1 from the top line down.
SCBWD:
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	LDA	SCLN
	STA	ROWCT
SBW_RI:
	LDA	ROWCT
	ORA	A
	JZ	SBW_PT
	CALL	GOTOP		; region top row
	LXI	H,SRI		; ESC M (RI) at the top: region scrolls down 1
	CALL	OUTSTR
	LDA	ROWCT
	DCR	A
	STA	ROWCT
	JMP	SBW_RI
SBW_PT:
	CALL	RDTOP
	XRA	A
	STA	PROWN
	CALL	GOTOP
SBW_LP:
	LDA	SCLN
	MOV	B,A
	LDA	PROWN
	CMP	B
	JNC	SBW_DN
	CALL	PTROW		; the row, then down to the next one
	JMP	SBW_LP
SBW_DN:
	CALL	CRGRS		; restore full-screen region
	JMP	SCURS		; address and show the cursor at its new cell

;SCDL -- R_DLIN: a single line was deleted at the cursor's row (dd, not the last
; line).  Delete that screen row (ESC[M at SROW, region-clamped so the message row
; is safe) -- the rows below shift up and a blank opens at row NEDIT -- then draw
; the bottom row and re-address the cursor (which kept
; its row, now at the BOL of the line that shifted up).
;SC_JN -- R_JOIN: the line below was joined onto the cursor's.  That row now
; holds both, and the row under it is gone -- so redraw the cursor's row, then
; hand the rest to SCDL, which deletes a row and draws the one the shift
; exposes at the bottom.  With the cursor on the LAST edit row there is no row
; under it on the screen at all: the join took a line that was never shown, and
; only the cursor's own row is stale (vim redraws just that row there too).
SC_JN:
	LDA	SROW
	MOV	B,A
	LDA	NEDIT
	CMP	B		; CY iff NEDIT < SROW; Z iff the bottom edit row
	JZ	SC_LNBD
	JC	SC_LNBD
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	LDA	SROW		; the joined line, redrawn where it stands
	CALL	GOROW1
	CALL	RDBOL
	CALL	PROW
	LDA	SROW
	INR	A		; ... and the row under it goes
	JMP	SCDL2

SCDL:
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	LDA	SROW		; delete the cursor's row
SCDL2:
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
	LXI	H,SDL		; ESC[M (DL): rows below shift up, blank at NEDIT
	CALL	OUTSTR
	CALL	RDTOP
	LDA	NEDIT
	DCR	A
	STA	PROWN		; the bottom row
	CALL	RDSKIP
	LDA	NEDIT
	CALL	GOROW1		; bottom edit row, cleared
	CALL	PAINTR
	CALL	CRGRS		; restore full-screen region
	JMP	SCURS

;SC_IL -- R_ILIN: one line was opened at the cursor's row.  Open a row there
; (ESC[L, region-clamped so the message row is safe) -- the rows below shift
; down and the bottom one falls out of the region -- then draw the cursor's row
; and the one above it: a <CR> (and 'r<CR>') split that one, 'o' and 'O' leave
; it as it was.  Everything else on the screen is already right where it is.
;SC_ILQ -- which of the two forms this is.  A line that opened ON the screen
; leaves the text where it stands (SCRLN = 0); one opened on the bottom row
; has nowhere to put itself, so the screen scrolls up a row to make room
; (SCRLN = 1) -- vim does the same, and it is what every <CR> does once you
; are typing at the end of a file.  Both then draw the same two rows.
SC_ILQ:
	LHLD	SCRLN
	MOV	A,H
	ORA	L
	JZ	SC_IL		; the text stood still
	DCX	H
	MOV	A,H
	ORA	L
	JNZ	SCFULL		; moved by more than a row: not ours
	LDA	ILN		; and only ONE line can open into one scroll --
	CPI	1		;   a put of several at the bottom needs as many
	JNZ	SCFULL		;   scrolls as it has lines, which is a repaint
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	CALL	GOTOP
	LXI	H,SDL		; ESC[M at the top: the region scrolls up one,
	CALL	OUTSTR		;   opening the bottom row for the new line
	JMP	SC_ILT

SC_IL:
	CALL	CHIDE
	CALL	SRGN		; scroll region = rows 1..NEDIT
	LDA	SROW
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
	LXI	H,SCSI		; ESC[<ILN>L (IL): ILN blank rows here, the rest
	CALL	OUTSTR		;   shift down, and what falls past the region's
	LDA	ILN		;   bottom row has scrolled off, which is right
	CALL	EMITB
	MVI	A,'L'
	CALL	OUTCH
SC_ILT:
	;--- the first row to draw.  IL opened ILN rows AT the cursor's row and
	;    everything above it stands, so the cursor's own row (0-based SROW-1)
	;    is where the drawing starts -- 'o', 'O' and a put leave the line
	;    above untouched.  ILABOV says the edit took text off that line (a
	;    mid-line <CR>, 'r<CR>'), and then it is drawn too. ---
	LDA	SROW
	DCR	A		; B = the cursor's own row, the first opened one
	MOV	B,A
	LDA	ILABOV
	ORA	A
	MOV	A,B
	JZ	SC_IL0
	DCR	A		; the row above the cursor's, when it is stale
SC_IL0:
	ORA	A		; ... clamped: the cursor may be on the top row
	JP	SC_IL1
	XRA	A
SC_IL1:
	STA	PROWN
	MOV	A,B		; the last row to draw: the opened ones start at
	LXI	H,ILN		;   the cursor's row and there are ILN of them
	ADD	M
	DCR	A
	MOV	B,A
	LDA	NEDIT
	DCR	A		; ... but never past the bottom edit row, which
	CMP	B		;   is as far as the opened rows can be seen
	JC	SC_IL2
	MOV	A,B
SC_IL2:
	STA	ILLAST
	CALL	RDTOP
	LDA	PROWN
	CALL	RDSKIP		; the reader at that row's line
SC_ILL:
	CALL	SC_ILR
	LDA	ILLAST
	LXI	H,PROWN
	CMP	M
	JZ	SC_ILD
	INR	M
	JMP	SC_ILL
SC_ILD:
	CALL	CRGRS		; restore full-screen region
	JMP	SCURS		; the cursor back on the text, and shown

;SC_ILR -- draw screen row PROWN from where the reader stands, cleared first.
SC_ILR:
	LDA	PROWN
	INR	A
	CALL	GOROW1
	JMP	PAINTR

;SCRNOK -- HL = candidate scroll count N.  Return A=N with CY=0 if N is in
; 1..NEDIT-1 (there is on-screen overlap worth preserving); else CY=1 so the
; caller full-repaints.  Clobbers A,B.
SCRNOK:
	MOV	A,H
	ORA	A
	JNZ	SRN_NO		; N >= 256
	MOV	A,L
	ORA	A
	JZ	SRN_NO		; N == 0
	MOV	B,A		; B = N
	LDA	NEDIT
	CMP	B		; CY iff NEDIT < N ; Z iff NEDIT == N
	JC	SRN_NO		; N > NEDIT
	JZ	SRN_NO		; N == NEDIT -> no overlap
	MOV	A,B		; A = N, CY=0 (from CMP: NEDIT > N)
	RET
SRN_NO:
	STC
	RET

;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
SRGN:
	LXI	H,SRGP
	CALL	OUTSTR
	LDA	NEDIT
	CALL	EMITB
	MVI	A,'r'
	JMP	OUTCH

;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
; above take, at column CURDCL mod NCOLS.  Emits nothing.
CURSC:
	LHLD	CURDCL
	CALL	DIVN		; BC = rows into the line, A = the column
	INR	A
	STA	SCOL
	MOV	A,C
	STA	CSUB
	LHLD	LYABV
	DAD	B
	INX	H
	MOV	A,H		; (never past the edit rows: a line taller than
	ORA	A		;   the screen shows its first rows only)
	LDA	NEDIT
	JNZ	CS_SET
	CMP	L		; CY iff NEDIT < the row
	JC	CS_SET
	MOV	A,L
CS_SET:
	STA	SROW
	RET

;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
; Falls into DIVN.
XTRA:
	LXI	B,0
	MOV	A,H
	ORA	L
	RZ			; an empty line is one row
	DCX	H
;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
DIVN:
	LDA	NCOLS
	CMA
	MOV	E,A
	MVI	D,0FFH
	INX	D		; DE = -NCOLS
	LXI	B,0FFFFH
DV_LP:
	INX	B
	DAD	D		; CY while NCOLS still went into it
	JC	DV_LP
	LDA	NCOLS
	ADD	L
	RET

;SCABRT -- RPOLL abort: a key arrived mid-repaint.  Leave the cursor hidden (the
; SHIDE at SCFULL's head still holds) and return WITHOUT positioning/showing it,
; so no cursor flash during a type-ahead burst.  The pending key is dispatched
; next, then SCDRAW runs again and (when the ring finally drains) paints in full
; and shows the cursor -- the aborted frame is simply superseded.
; FORCEF is latched so the next SCDRAW repaints in FULL even if the pending key
; is a pure motion (RENDER.md: an aborted frame stays dirty -- the fast path must
; not be taken over a half-painted screen).
SCABRT:
	MVI	A,1
	STA	FORCEF
	RET

;============================================================
; LAYOUT -- WM MEASURE's placement (WM.ASM 3762): where the cursor's line sits
; on the screen and what the screen holds.  Emits nothing.
;   in : WINROW (last frame's), LNDLT (lines moved since), WFILL
;   out: WINROW (clamped), SCRLN (lines the text moved up), TOPLEN (bytes from
;        the top line's start to the cursor), CBOL (bytes from the cursor
;        line's start), CURDCL, LYABV (rows above the cursor's line), TXEND and
;        FILCH (the rows with no text, and what they show), SCBOT, SCEOF,
;        SCBOF, WRAPF; WRLIM raised past the top (WM 3784); LNDLT and WFILL
;        cleared.
; WINROW is a count of LINES.  The rows come from measuring them: [top,
; cursor) by pointer, the rest read forward until the rows are full -- never
; to the end of a line the screen cannot hold.  When the lines above leave the
; cursor's line no room, lines are given up at the top until it fits.
; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
; (AUXCNT, DIRFLG) are saved and restored around the layout.
;============================================================
LAYOUT:
	LHLD	CMDCNT
	SHLD	SVCNT
	LHLD	AUXCNT
	SHLD	SVAUX
	LDA	DIRFLG
	STA	SVDIR
	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
	STA	LYROW
	STA	LYSVR
	XRA	A
	STA	LYND
	STA	LYPRF
	LDA	WFILL		; a line the command placed stays where it was
	ORA	A		;   put; one that only moved is asked about
	CZ	LYFAR
	LHLD	LNDLT
	SHLD	LYDLT
	LXI	H,0
	SHLD	LNDLT
	LDA	WFILL
	CPI	WF_MID
	JZ	LY_MD
	LDA	LYND
	ORA	A
	JZ	LY_NM
LY_MD:
	CALL	LYMID		; LYROW = the lines that puts above it
LY_NM:
	XRA	A
	STA	WFILL
LY_TOP:
	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
	LDA	LYROW
	MOV	L,A
	MVI	H,0
	CALL	LINPSB		; HL = that line's start (paged back if needed)
	XCHG
	LHLD	GAPBEG
	CALL	SUBHD		; HL = GAPBEG - top
	SHLD	TOPLEN
	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
	SHLD	WRLIM
	;--- [top, GAPBEG): the lines above, each as many rows as it is wide;
	;    what is left over is the cursor's line, up to the cursor ---
	LXI	H,0
	SHLD	LYABV
	XRA	A
	STA	LYROW		; (counted again: the file may start sooner)
	CALL	LYTOPP		; HL = top, BC = bytes to the cursor
LY_ABV:
	PUSH	B		; (CBOL, if this turns out to be the cursor's)
	CALL	LNW		; DE = its width; CY: it ended, LF and all
	JNC	LY_ABD
	XTHL			; (that count is not wanted; the pointer is)
	PUSH	B
	XCHG
	CALL	XTRA		; BC = the rows it takes past its first
	LHLD	LYABV
	DAD	B
	INX	H
	SHLD	LYABV
	LXI	H,LYROW
	INR	M
	POP	B
	POP	H
	JMP	LY_ABV
LY_ABD:
	XCHG
	SHLD	CURDCL
	POP	H
	SHLD	CBOL
	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
	XRA	A
	STA	SCBOF
	CALL	LYTOPP		; HL = top
	CALL	ISBOF
	JNZ	LY_CUR
	INR	A
	STA	SCBOF
LY_CUR:
	;--- the cursor's own row: LYABV + the rows of its line before it ---
	XRA	A
	STA	SCEOF
	STA	LYEND
	STA	LYXE
	MVI	A,'~'
	STA	FILCH
	LHLD	CURDCL
	CALL	DIVN		; BC = rows into the line, A = cells used there
	MOV	E,A
	LDA	CURDCL
	SUB	E
	STA	LYVB		; the column the cursor's row starts at
	LHLD	LYABV
	MOV	A,L
	STA	LYLST		; (its line starts on this row)
	DAD	B		; HL = the cursor's row
	LDA	NEDIT
	MOV	C,A
	MOV	A,H
	ORA	A
	JNZ	LY_OFF
	MOV	A,L
	CMP	C		; CY iff it is one of the edit rows
	JC	LY_FW0
LY_OFF:
	;--- it is below them: give up lines at the top, as few as will do ---
	LDA	LYROW
	ORA	A
	JZ	LY_TAL		; there are none: the line is taller than the screen
	MOV	E,C
	DCR	E
	MVI	D,0
	CALL	SUBHD		; HL = the rows too many
	SHLD	LYNEED
	CALL	LYTOPP
LY_DRP:
	CALL	LNW		; the top line: DE = its width
	PUSH	H
	PUSH	B
	XCHG
	CALL	XTRA
	INX	B		; BC = its rows
	LHLD	LYNEED
	MOV	A,L
	SUB	C
	MOV	L,A
	MOV	A,H
	SBB	B
	MOV	H,A
	SHLD	LYNEED
	POP	B
	LXI	H,LYROW
	DCR	M		; one line fewer above the cursor's
	POP	H		; (keeps the flags)
	JZ	LY_TOP		; that was the last of them
	LDA	LYNEED+1
	ORA	A
	JM	LY_TOP		; room enough
	PUSH	H
	LHLD	LYNEED
	ORA	L
	POP	H
	JNZ	LY_DRP
	JMP	LY_TOP
LY_FW0:
	;--- forward: the rest of the cursor's line and the lines below, until
	;    the rows are full.  D = the row being filled, E = cells used in it. ---
	MOV	D,L
	CALL	RGET0
LY_FWD:
	CALL	FLINE
	ORA	A
	JM	LY_EOF
	JZ	LY_FLF
	LDA	LYEND		; a row the screen has not got:
	ORA	A
	JNZ	LY_CUT
	LXI	H,LYROW		; the cursor's own line needs it: give up a
	MOV	A,M		;   line at the top and measure again
	ORA	A
	JZ	LY_TAL
	DCR	M
	JMP	LY_TOP
LY_CUT:
	MVI	A,'@'		; a line under it does not: it is not shown, and
	STA	FILCH		;   the rows it would have started on say so
	LDA	LYLST
	JMP	LY_END
LY_TAL:
	LDA	NEDIT		; a line taller than the screen: its first rows
	JMP	LY_END
LY_FLF:
	CALL	LYLEND		; that line's rows are counted
	LDA	NEDIT
	CMP	D
	JNZ	LY_FWD
	CALL	RDGET		; rows full: is the text over right there?
	JNC	LY_FUL
	MVI	A,1
	STA	SCEOF
LY_FUL:
	MOV	A,D
	JMP	LY_END
LY_EOF:
	MVI	A,1
	STA	SCEOF
	LDA	LYEND		; text after the last line end -- or no line end
	ORA	A		;   at all -- is a line too
	JZ	LY_EO1
	LDA	LYLAST
	CPI	LF
	JZ	LY_EO2
LY_EO1:
	CALL	LYLEND
LY_EO2:
	MOV	A,D
LY_END:
	STA	TXEND		; the first row with no text on it
	LDA	LYEND		; below = the lines that ended, less the cursor's
	SUI	1
	ACI	0
	STA	LYBLW
	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
	LXI	H,LYBLW
	ADD	M
	STA	SCBOT
	;--- WRAPF: more rows of text than lines, or a line cut off ---
	INR	A
	LXI	H,TXEND
	SUB	M
	LXI	H,FILCH
	JNZ	LY_W1
	MOV	A,M
	CPI	'~'
	MVI	A,0
	JZ	LY_W2
LY_W1:
	MVI	A,1
LY_W2:
	LXI	H,LYXE
	ORA	M
	STA	WRAPF
	LDA	LYROW		; WINROW = row
	MOV	L,A
	MVI	H,0
	SHLD	WINROW
	XCHG			; SCRLN = LNDLT - (row - OLDWR)
	LHLD	LYDLT
	CALL	SUBHD
	XCHG
	LHLD	OLDWR
	DAD	D
	SHLD	SCRLN
	CALL	TABCUR
	LHLD	SVCNT
	SHLD	CMDCNT
	LHLD	SVAUX
	SHLD	AUXCNT
	LDA	SVDIR
	STA	DIRFLG
	RET

;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
; the column that row starts at; all three are kept up.  A row is left only
; when there is a cell more to put, so a line just as wide as the screen is
; one row.
;   A = 0    the line ended, its LF read
;   A = 1    it needs a row the screen has not got (D = NEDIT)
;   A = 0FFH the text ended
FLINE:
	CALL	RDGET		; (pages in on demand; keeps DE)
	JC	FL_EOF
	STA	LYLAST
	CPI	LF
	JZ	FL_LF
	CPI	CR
	JZ	FLINE		; CR contributes no display column
	CPI	TAB
	JZ	FL_TAB
	CALL	FL_CEL
	JNZ	FLINE
FL_OVR:
	MVI	A,1
	RET
FL_TAB:
	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
	ADD	E
	ANI	TABWID-1
	CMA
	ADI	TABWID+1
	PUSH	H
	MOV	L,A
FT_LP:
	CALL	FL_CEL
	JZ	FT_OVR
	DCR	L
	JNZ	FT_LP
	POP	H
	JMP	FLINE
FT_OVR:
	POP	H
	JMP	FL_OVR
FL_LF:
	XRA	A
	RET
FL_EOF:
	MVI	A,0FFH
	RET
;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
; not got.  Keeps HL, BC.
FL_CEL:
	LDA	NCOLS
	CMP	E
	JNZ	FC_1
	MVI	E,0		; the row is full: the next one, starting NCOLS on
	INR	D
	PUSH	H
	LXI	H,LYVB
	ADD	M
	MOV	M,A
	POP	H
	LDA	NEDIT
	CMP	D
	RZ
FC_1:
	INR	E		; (NZ)
	RET

;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
; there -- it is the first byte in memory and no record went out before it.
ISBOF:
	XCHG
	LHLD	TXTBEG
	CALL	CMP16
	RNZ
	LHLD	OUTPOS
	MOV	A,H
	ORA	L
	RET

;LYMID -- the cursor's line is to go in the middle of the screen (WFILL =
; WF_MID): LYROW = the lines that leaves above it.  This is vim's
; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
; take a line below while the rows below are no more than those above, else a
; line above, until a line will not fit.  Past the end of the file a '~' row
; counts as a row below that costs nothing, so there the screen fills from
; above; at the start of the file it stops.
;
; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
; cursor's line, the LYND lines over it and as many under it -- if the screen
; holds them all, the text only scrolls up to the line (LYROW as it was, and
; LAYOUT gives up what lines it must).  If not, it is the middle after all,
; but taking the line above first when the rows are even (LYPRF: vim's
; prefer_above), which is not the same place once lines differ in height.
LYMID:
	XRA	A
	STA	LYROW
	STA	LYMAB
	STA	LYMBL
	STA	LYMEOF
	LDA	NEDIT
	DCR	A
	MOV	L,A
	MVI	H,0
	CALL	LINPSB		; as far up as the screen could ever reach
	CALL	G2P
	SHLD	LYLIM
	INR	H
	SHLD	WRLIM		; (and none of it spilled while reading down)
	LHLD	GAPBEG
	CALL	PRVL0		; HL = the cursor line's start, BC = bytes to here
	CALL	LM_LNW		; DE = the columns before the cursor
	CALL	LCROW		; ... and the rest of it: D = its last row
	RC			; (taller than the screen)
	JP	LM_1
	STA	LYMEOF		; the text ends with it
LM_1:
	MOV	A,D
	INR	A
	STA	LYUSE		; the rows taken so far: its own
	LDA	LYND
	ORA	A
	JZ	LM_LP
LM_NR:
	CALL	LMABV		; a line above and a line below, LYND times
	JC	LM_P
	CALL	LMBLW
	JC	LM_P
	LXI	H,LYND
	DCR	M
	JNZ	LM_NR
	LDA	LYSVR		; the screen holds them: scroll to it
	STA	LYROW
	RET
LM_P:
	XRA	A		; it does not: the middle, above first
	STA	LYND
	INR	A
	STA	LYPRF
	JMP	LYMID
LM_LP:
	LDA	LYMBL
	LXI	H,LYPRF
	ADD	M
	MOV	B,A
	LDA	LYMAB
	CMP	B		; CY iff fewer rows above than below (or as
	JC	LM_U		;   many, when above goes first)
	CALL	LMBLW
	JNC	LM_LP
	RET
LM_U:
	CALL	LMABV
	JNC	LM_LP
	RET

;LMBLW -- LYMID: take the next line below the ones taken -- a '~' row, once
; the text has ended.  CY if the screen has no room for it.
LMBLW:
	LDA	LYMEOF
	ORA	A
	JNZ	LB_TL
	CALL	LM_NX
	JP	LB_1
	STA	LYMEOF		; the text ended: was that a line?
	LDA	LYLAST
	CPI	LF
	JZ	LB_TL
	XRA	A
LB_1:
	STC
	RNZ			; one taller than the screen
	MOV	A,D
	INR	A		; its rows
	CALL	LM_ADD
	RC
	LXI	H,LYMBL
	ADD	M
	MOV	M,A
	RET
LB_TL:
	LXI	H,LYMBL		; a '~' row
	INR	M
	ORA	A
	RET

;LMABV -- LYMID: take the next line above the ones taken (LYROW counts them).
; CY if there is none, or the screen has no room for it.
LMABV:
	LHLD	LYUP
	CALL	G2P
	CALL	PRVLN
	RC			; the start of the file
	CALL	LM_LNW
	XCHG
	CALL	XTRA		; BC = its rows, less one
	MOV	A,B
	ORA	A
	STC
	RNZ
	MOV	A,C
	INR	A
	STC
	RZ
	CALL	LM_ADD
	RC
	LXI	H,LYMAB
	ADD	M
	MOV	M,A
	LXI	H,LYROW
	INR	M
	RET

;LCROW -- DE = the columns before the cursor on its line: read the rest of
; the line (LM_FL).  D = its last row, counted from 0.  CY if it is taller
; than the screen; else M if the text ended with it.
LCROW:
	XCHG
	PUSH	H
	CALL	DIVN		; BC = rows into the line, A = cells in that row
	POP	H
	MOV	E,A
	MOV	A,L
	SUB	E
	STA	LYVB
	MOV	A,B
	ORA	A
	STC
	RNZ
	MOV	D,C
	LDA	NEDIT
	DCR	A
	CMP	D
	RC
	CALL	RGET0
	CALL	LM_FL
	CPI	1
	STC
	RZ
	ORA	A
	RET

;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
; they are taken (LYUSE) and A is kept.
LM_ADD:
	MOV	B,A
	LDA	LYUSE
	ADD	B
	RC
	MOV	C,A
	LDA	NEDIT
	CMP	C		; CY iff NEDIT < the rows that would make
	RC
	MOV	A,C
	STA	LYUSE
	MOV	A,B
	RET

;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
; lines, the registers being wanted for the lines above.
;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
LM_NX:
	LXI	D,0
	XRA	A
	STA	LYVB
	LHLD	RDBC
	MOV	B,H
	MOV	C,L
	LHLD	RDHL
LM_FL:
	CALL	FLINE
	SHLD	RDHL
	MOV	H,B
	MOV	L,C
	SHLD	RDBC
	ORA	A
	RET

;LM_LNW -- HL = the start of a line above (or the cursor's), BC = its bytes:
; note it as the highest line taken (LYUP) and measure it (LNW).
LM_LNW:
	PUSH	H
	CALL	G2P
	SHLD	LYUP
	POP	H
	JMP	LNW

;PRVLN -- HL = the start of a line: HL = the start of the line before it, BC
; = that line's bytes.  CY if there is none (LYLIM: the text ends there).
;PRVL0 -- the same from inside a line, back to its own start.
PRVLN:
	CALL	PVLIM
	CALL	CMP16
	STC
	RZ
	DCX	H		; its LF
	LXI	B,1
	JMP	PV_LP
PRVL0:
	CALL	PVLIM
	LXI	B,0
PV_LP:
	CALL	CMP16
	RZ			; (NC) as far up as the text goes
	DCX	H
	MOV	A,M
	CPI	LF
	JZ	PV_DN
	INX	B
	JMP	PV_LP
PV_DN:
	INX	H
	ORA	A
	RET
;PVLIM -- DE = the address LYLIM stands for.  Keeps HL.
PVLIM:
	PUSH	H
	LHLD	LYLIM
	CALL	G2P
	XCHG
	POP	H
	RET

;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
; the cursor.
;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
; the other way about: an address in, its count out.  A refill moves the text,
; so anything kept across a forward read is kept as the count.  Keeps BC.
LYTOPP:
	LHLD	TOPLEN
	MOV	B,H
	MOV	C,L
G2P:
	XCHG
	LHLD	GAPBEG
	JMP	SUBHD

;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
; LF, NC when the bytes ran out first.
LNW:
	LXI	D,0
LNW_LP:
	MOV	A,B
	ORA	C
	RZ
	MOV	A,M
	INX	H
	DCX	B
	CPI	LF
	JZ	LNW_LF
	CPI	CR
	JZ	LNW_LP		; CR contributes no display column
	CPI	TAB
	JNZ	LNW_1
	MOV	A,E		; TAB: to the next multiple of TABWID
	ORI	TABWID-1
	MOV	E,A
LNW_1:
	INX	D
	JMP	LNW_LP
LNW_LF:
	STC
	RET

;LYLEND -- LAYOUT's forward read: a line ended on row D.  The next starts on
; the row under it.  A line that ends with a row it has put nothing on is the
; cursor's, standing past text that filled the row above (an insert at the
; end of a line just as wide as the screen): WR_EOL.  Keeps HL, BC.
LYLEND:
	MOV	A,E
	ORA	A
	JNZ	LE_1
	LDA	LYLST
	CMP	D
	JZ	LE_1		; (its first row: an empty line)
	MVI	A,WR_EOL+1
	STA	LYXE
LE_1:
	INR	D
	MOV	A,D
	STA	LYLST
	XRA	A
	MOV	E,A
	STA	LYVB
	LDA	LYEND
	INR	A
	STA	LYEND
	RET

;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
; line that moved off the screen.  Above the top line it counts LINES: up to
; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
; and it goes in the middle (WF_MID).  Below, the line is some lines under the
; last one that showed whole (SCBOT): more than NEDIT of them is the middle
; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
LYFAR:
	LHLD	WINROW
	XCHG
	LHLD	LNDLT
	DAD	D		; HL = the lines from the top line to it (signed)
	MOV	A,H
	ORA	A
	JP	LF_DN
	LDA	NEDIT
	ORA	A
	RAR
	SUI	2
	MOV	E,A
	MVI	D,0
	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
	MOV	A,H
	ORA	A
	RP
LF_FAR:
	MVI	A,WF_MID
	STA	WFILL
	RET
LF_DN:
	LDA	SCBOT
	INR	A
	MOV	E,A
	MVI	D,0
	CALL	SUBHD		; HL = the lines it is under the last one shown,
	MOV	A,H		;   less one
	ORA	A
	RM			; on the screen
	JNZ	LF_FAR
	LDA	NEDIT
	CMP	L		; CY iff NEDIT < that
	JC	LF_FAR
	MOV	A,L
	STA	LYND		; (0: the line right under it only ever scrolls)
	RET

;HTBLD -- for the scrolls, which count screen rows: the rows each line about
; the cursor takes, in file order, in HTAB[0..HTN).
;   in : B = the lines above the cursor's to take (fewer if the file starts
;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
;        that line, then the ones under it until they come to as many, or the
;        text ends (HTEOF)
;   out: HTCUR = the cursor line's place in the table
; A line taller than the screen counts as a screenful, and ends the table.
; Lines above that memory will not hold all at once are simply not in it: the
; table then starts lower, at a line's start, with HTBOF clear.
; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
HTBLD:
	MOV	A,C
	STA	HTLIM
	XRA	A
	STA	HTN
	STA	HTEOF
	STA	HTBOF
	MOV	L,B
	MOV	H,A
	CALL	LINPSB		; HL = the highest of them (paged back if needed);
	PUSH	PSW		;   CY: memory would not hold them all
	PUSH	H
	CALL	ISBOF
	JNZ	HB_1
	INR	A
	STA	HTBOF
HB_1:
	POP	H
	PUSH	H
	CALL	G2P		; HL = the bytes from there to the cursor
	MOV	B,H
	MOV	C,L
	POP	H
	POP	PSW
	JNC	HB_AB
	LDA	HTBOF
	ORA	A
	CZ	LNW		; ... and what it does hold need not start with
				;   a line: the table starts at the next one
HB_AB:
	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
	JNC	HB_CU
	PUSH	H
	PUSH	B
	XCHG
	CALL	XTRA		; BC = its rows past the first
	MOV	A,B
	ORA	A
	JNZ	HB_TA
	LDA	NEDIT
	DCR	A
	CMP	C		; CY iff more rows than the screen has
	MOV	A,C
	INR	A
	JNC	HB_PA
HB_TA:
	LDA	NEDIT
HB_PA:
	CALL	HTPUT
	POP	B
	POP	H
	JMP	HB_AB
HB_CU:
	LDA	HTN
	STA	HTCUR
	CALL	LCROW		; the cursor's own line: D = its last row
	JC	HB_TL
	JM	HB_LS		; the text ends with it
HB_PT:
	MOV	A,D
	INR	A
	CALL	HTPUT
	MOV	B,A
	LDA	HTLIM
	SUB	B
	STA	HTLIM
	RC
	RZ			; rows enough
	CALL	LM_NX		; the next line down
	JZ	HB_PT
	JP	HB_TL		; one taller than the screen
	LDA	LYLAST		; the text ended: was that a line?
	CPI	LF
	JZ	HB_EF
HB_LS:
	MOV	A,D
	INR	A
	CALL	HTPUT
HB_EF:
	MVI	A,1
	STA	HTEOF
	RET
HB_TL:
	LDA	NEDIT
;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
; Keeps A, BC, DE, HL.
HTPUT:
	PUSH	H
	PUSH	D
	LXI	H,HTN
	MOV	E,M
	INR	E
	JZ	HP_1
	MOV	M,E
	DCR	E
	MVI	D,0
	LXI	H,HTAB
	DAD	D
	MOV	M,A
HP_1:
	POP	D
	POP	H
	RET

;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
; as vi does (insert mode keeps it at the tab's first column, where the next
; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
TABCUR:
	LDA	EDMODE
	CPI	EM_CMD
	RNZ
	LHLD	TXTEND
	XCHG
	LHLD	GAPEND
	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
	RZ
	MOV	A,M
	CPI	TAB
	RNZ
	LHLD	CURDCL
	MOV	A,L
	ORI	TABWID-1
	MOV	L,A
	SHLD	CURDCL
	RET

;============================================================
; TEXT READER -- the screen's text, straight from the gap buffer.  After
; LAYOUT everything on the screen is resident.  Bytes before the gap are read
; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
;============================================================

;RDTOP -- start reading at the top line.
RDTOP:
	LHLD	TOPLEN
	JMP	RDSET
;RDBOL -- start reading at the cursor line's start.
RDBOL:
	LHLD	CBOL
RDSET:
	SHLD	RDN
	XCHG
	LHLD	GAPBEG
	CALL	SUBHD
	SHLD	RDP
	XRA	A
	STA	RDSEG
	RET

;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
RDCH:
	PUSH	B
	PUSH	D
	PUSH	H
	LHLD	RDN		; before-gap bytes left?
	MOV	A,H
	ORA	L
	JZ	RDC_AF
	DCX	H
	SHLD	RDN
	LHLD	RDP
	MOV	A,M
	INX	H
	SHLD	RDP
	ORA	A		; CY=0
	JMP	RDC_RT
RDC_AF:
	LDA	RDSEG
	ORA	A
	JNZ	RDC_NX
	INR	A		; first after-gap byte: start RGET
	STA	RDSEG
	CALL	RGET0
	JMP	RDC_GT
RDC_NX:
	LHLD	RDBC
	MOV	B,H
	MOV	C,L
	LHLD	RDHL
RDC_GT:
	CALL	RDGET
	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
	MOV	H,B
	MOV	L,C
	SHLD	RDBC
RDC_RT:
	POP	H
	POP	D
	POP	B
	RET

;RDSKIP -- skip A lines (stops early at the end of the text).
RDSKIP:
	ORA	A
	RZ
	STA	SKPN
RSK_LP:
	CALL	RDCH
	RC
	CPI	LF
	JNZ	RSK_LP
	LDA	SKPN
	DCR	A
	STA	SKPN
	JNZ	RSK_LP
	RET

;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
; it takes, or the fill char on a row past the text ('~'; '@' where a line did
; not fit).  The reader must be at that row's line.  Row already cleared.
PAINTR:
	LDA	PROWN
	LXI	H,TXEND
	CMP	M		; CY iff the row holds text
	JC	PROW
	LDA	FILCH
	JMP	OUTCH

;PROW -- paint the reader's line: tabs expanded, and on to the next row when
; this one is full and there is more (PROWN follows it down).  The reader ends
; past the line's LF (or at the end).
PROW:
	XRA	A
	STA	DCOL
	STA	XC
PR_LP:
	CALL	RDCH
	RC			; end of text -> line done
	CPI	LF
	RZ			; consumed the LF -> next line start
	CPI	CR
	JZ	PR_LP		; drop CR (part of the CR,LF break)
	CPI	TAB
	JZ	PR_TAB
	CALL	PCELL
	JMP	PR_LP
PR_TAB:
	LDA	DCOL		; spaces = 8 - (dcol mod 8)
	ANI	7
	MOV	C,A
	MVI	A,8
	SUB	C
	MOV	C,A		; C = space count (1..8)
PRTBLP:
	MVI	A,' '
	CALL	PCELL		; (keeps C)
	DCR	C
	JNZ	PRTBLP
	JMP	PR_LP

;PCELL -- put the char in A on the next cell of the line.  Keeps C.
PCELL:
	MOV	B,A
	LXI	H,DCOL
	INR	M
	LDA	NCOLS
	LXI	H,XC
	CMP	M
	CZ	PWRAP		; the row is full: this one starts the next
	INR	M
	MOV	A,B
	JMP	OUTCH
;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
; relied on).  From the last edit row there is nowhere to go: the rest of the
; line is not shown, and PROW returns to its caller from here.
PWRAP:
	MVI	M,0
	LDA	NEDIT
	DCR	A
	LXI	H,PROWN
	CMP	M
	JZ	PW_END
	INR	M
	MVI	A,CR
	CALL	OUTCH
	MVI	A,LF
	CALL	OUTCH
	CALL	CEKL		; (keeps BC)
	LXI	H,XC
	RET
PW_END:
	POP	H		; PCELL's return, and PROW's
	POP	H
	RET

;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
; command mode.  It is drawn only when the mode differs from what the row last
; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
; so an ex message stays put until the mode really changes, the way vim's load
; message survives every motion.  The cursor goes back where SCDRAW left it.
MODEMS:
	LDA	EDMODE
	MOV	B,A
	LDA	OEDMOD
	CMP	B
	RZ			; the row already shows this mode
	MOV	A,B
	STA	OEDMOD
	LXI	H,SINSM
	CPI	EM_INS
	JZ	MD_DRW
	LXI	H,SREPM
	CPI	EM_REP
	JZ	MD_DRW
	LXI	H,SNULL		; command mode: the row goes blank
MD_DRW:
	PUSH	H
	LDA	NROWS
	CALL	GOROW1
	POP	H
	CALL	OUTSTR
;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
SCURS:
	LDA	SROW
	MOV	B,A
	LDA	SCOL
	MOV	C,A
	CALL	GOTOXY
	LXI	H,SSHOW
	JMP	OUTSTR

;============================================================
; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
; the bottom row.  Emitting one here too cost a second row for nothing.
;============================================================
SCDONE:
	CALL	CRGRS
	LXI	H,SSHOW
	CALL	OUTSTR
	LDA	NROWS		; bottom left, over the message row -- and blank:
	JMP	GOROW1		;   the CCP prompt lands here

;============================================================
; STRINGS (0-terminated)
;============================================================
SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
	DB	ESC,'[','6','n',0
SEK:	DB	ESC,'[','K',0
SDL:	DB	ESC,'[','M',0		; DL -- delete line (scroll region up 1)
SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
SRI:	DB	ESC,'M',0		; RI -- reverse index (scroll region down 1)
SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
SHIDE:	DB	ESC,'[','?','2','5','l',0
SSHOW:	DB	ESC,'[','?','2','5','h',0
SREGRS: DB	ESC,'[','r',0
SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
SNULL:	DB	0

;============================================================
; DATA
;============================================================
NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
NCOLS:	DB	80		; runtime columns
NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)

WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
OLDWR:	DW	0		; WINROW as displayed before this frame
WRAPF:	DB	0		; this frame: 0, 1 = a line wraps, WR_EOL and up =
				;   ... and the cursor has a row to itself
OLDWF:	DB	0		; WRAPF as displayed before this frame
SCRLN:	DW	0		; lines the text moved up this frame (signed)
FORCEF: DB	0		; 1 = an aborted frame is pending -> force full repaint
OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)

SCBOT:	DB	0		; WINROW of the last line shown
TXEND:	DB	1		; the first row with no text on it
FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
SCEOF:	DB	0		; 1 = the end of the file is on the screen
SCBOF:	DB	0		; 1 = the top row is the file's first line
WFILL:	DB	0		; one layout: 1 = the command placed the cursor's
				;   line (WINROW), WF_MID = put it mid-screen
CSUB:	DB	0		; the row of its line the cursor is on (0 = first)

TOPLEN: DW	0		; bytes from the top line's start to the cursor
CBOL:	DW	0		; bytes from the cursor line's start to the cursor
CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
LYABV:	DW	0		; rows the lines above the cursor's take
LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
LYROW:	DB	0		; LAYOUT: working row
LYNEED: DW	0		; LAYOUT: rows to free at the top
LYBLW:	DB	0		; LAYOUT: lines shown below the cursor's
LYEND:	DB	0		; LAYOUT: lines that ended in the forward read
LYLST:	DB	0		; LAYOUT: the row the line being read starts on
LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
				;   byte: TAB stops)
LYLIM:	DW	0		; LYMID: bytes back to the highest line there is
LYUP:	DW	0		; LYMID: bytes back to the highest line taken
LYUSE:	DB	0		; LYMID: rows taken
LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
LYMEOF: DB	0		; LYMID: the text has ended
LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
HTLIM:	DB	0		; HTBLD: rows still to gather
LYXE:	DB	0		; LAYOUT: WR_EOL+1 when the cursor has its own row
LYLAST: DB	0		; LAYOUT: last byte read forward
SVCNT:	DW	0		; LAYOUT: saved CMDCNT
SVAUX:	DW	0		; LAYOUT: saved AUXCNT
SVDIR:	DB	0		; LAYOUT: saved DIRFLG

RDP:	DW	0		; reader: next before-gap byte
RDN:	DW	0		; reader: before-gap bytes left
RDHL:	DW	0		; reader: RGET pointer
RDBC:	DW	0		; reader: RGET count
RDSEG:	DB	0		; reader: 1 once reading after the gap
SKPN:	DB	0		; RDSKIP line count
PROWN:	DB	0		; screen row being painted (0-based)
SCLN:	DB	0		; region-scroll line count (N, 1..NEDIT-1)
DCOL:	DB	0		; column in the line while painting (low byte)
XC:	DB	0		; cells used in the row being painted
ROWCT:	DB	0		; RI count (SCBWD)
ILLAST: DB	0		; ... and the last screen row it draws

SROW:	DB	0		; computed cursor screen row
SCOL:	DB	0		; computed cursor screen column
TMPR:	DW	0		; DSR parse: rows
TMPC:	DW	0		; DSR parse: cols

	END
