;============================================================
; FILE:    SCRN.MAC
; PROJECT: VI
; MODULE:  Screen layer -- VT100 renderer + BIOS-direct console.
;------------------------------------------------------------
; The layout follows WordMaster's display model (WM MEASURE, WM.ASM 3762):
; the screen is placed relative to the CURSOR, never counted from the start of
; the window.  WINROW is the cursor line's screen row.  Each frame:
;   * WINROW moves by LNDLT, the lines the cursor crossed since the last frame
;     (BUF.MAC GOTO/DELPRV and the CMD.MAC line moves keep it), clamped to the
;     edit rows;
;   * LINPSB (WM LINPOSB) finds the start of the line WINROW lines above the
;     cursor's -- the top of the screen -- paging back if it is on disk;
;   * WRLIM is raised past the top (as WM MEASURE does) so the text on the
;     screen is never spilled;
;   * RGET (WM) reads forward from the cursor to the bottom row, paging in on
;     demand (WM NEEDIN).
; So a frame costs one screenful of text however deep the cursor is.  The
; bytes are read straight from the gap buffer: before the gap by pointer (kept
; relative to GAPBEG, since a refill can move the text), after it by RGET.
;
; A line wider than the screen WRAPS, as vi's does: it goes on down the rows
; under it.  So WINROW counts LINES -- how many are on the screen above the
; cursor's -- and the layout turns that into rows by measuring each of them.
; The top row is always the start of a line; a line the bottom has no room
; for is not shown, its rows hold '@'.
;
; Also here (RENDER.md): runtime geometry (DSR probe), the cheap paints the
; RINTENT asks for, the RPOLL repaint abort, and the message row.  A cheap
; paint is counted in ROWS: the rows the screen gave up or gained at the top,
; the rows the edit at the cursor had and has.  The terminal moves what stands
; (IL/DL in a scroll region) and only the rows that are new are sent.
;
; EXPORTS: BCONST, BCONIN, BCONOU      (BIOS-direct console leaves)
;          SCINIT, SCDRAW, SCDONE, SCPRE
;          NROWS, NCOLS, NEDIT         (runtime geometry)
;          WINROW                      (lines on the screen above the cursor's;
;                                       CMD.MAC sets it)
;          SCBOT, SCEOF, SCBOF, PLACE  (last layout's facts; the request)
;============================================================
	INCLUDE VI.INC

	PUBLIC	BCONST, BCONIN, BCONOU
	PUBLIC	SCINIT, SCDRAW, SCDONE, SCPRE, SKIPR, TALLF
	PUBLIC	EXPRM, EXRUB, OUTCH	; ':' / '/' line echo (CMD.MAC RDLINE)
	PUBLIC	EXMSG, OUTSTR		; ex error message on the bottom row
	PUBLIC	MODEMS			; the mode message ('-- INSERT --')
	PUBLIC	SCURS			; the cursor, back where SCDRAW left it
	PUBLIC	CBOL, CURDCL		; cursor column: bytes / display (^G)
	PUBLIC	NROWS, NCOLS, NEDIT
	PUBLIC	WINROW			; lines above the cursor's (signed word)
	PUBLIC	SCBOT			; WINROW of the last line shown
	PUBLIC	SCEOF, SCBOF		; end / start of the file is on the screen
	PUBLIC	PLACE			; request: the cursor's line placed / mid-screen
	PUBLIC	TXEND			; the first row with no text on it ('M')
	PUBLIC	CSUB			; the row of its line the cursor is on
	PUBLIC	HTBLD			; the rows each line takes (the scrolls)
	PUBLIC	LAYOUT			; the layout alone (VI.MAC, before '+{n}')

	EXTRN	CMP16, SUBHD		; BUF.MAC 16-bit helpers
	EXTRN	GAPBEG, TXTBEG		; BUF.MAC pointer row (read only)
	EXTRN	LINPSB, RGET0, RDGET	; BUF.MAC -- WM LINPOSB / RGET0, RGET + EOF check
	EXTRN	LNDLT			; BUF.MAC -- lines the cursor moved since the last frame
	EXTRN	WRLIM, OUTPOS		; PAGE.MAC -- spill limit / records before TXTBEG
	EXTRN	PGTOPM			; PAGE.MAC -- times the pager moved the text
	EXTRN	AUXCNT, DIRFLG		; PAGE.MAC -- line-move state LINPSB writes
	EXTRN	CMDCNT, CURRW		; CMD.MAC -- vi count (LINPSB writes it) / clamped row
	EXTRN	EDMODE			; CMD.MAC -- command / insert mode (tab cursor)
	EXTRN	GAPEND, TXTEND		; BUF.MAC -- the char under the cursor
	EXTRN	RINTENT			; CMD.MAC -- render intent for the last key
	EXTRN	ILN			; CMD.MAC -- lines an R_ILIN paint opens
	EXTRN	ICHAPP			; CMD.MAC -- 1 = an R_ICH needs no ICH
	EXTRN	ILABOV			; CMD.MAC -- 1 = an R_ILIN's row above is stale
	EXTRN	DCHN			; CMD.MAC -- cells an R_DCH deletes
	EXTRN	DCHBS			; CMD.MAC -- 1 = left of the cursor
	EXTRN	KBRDY			; KEY.MAC -- RPOLL: key waiting in the ring?
	EXTRN	HTN, HTCUR		; CMD.MAC -- the row table: entries / cursor's
	EXTRN	HTEOF, HTBOF		; ... and whether it reaches the file's ends
	EXTRN	HTAB			; RSV.MAC -- the row table itself

	CSEG

;============================================================
; BIOS-DIRECT CONSOLE (WM BIOSC).
; LHLD 1 = the page-zero warm-boot vector = BIOS jump table entry for WBOOT
; (BIOS+3); CONST=+3, CONIN=+6, CONOUT=+9 from there.  Recomputed per call --
; no cached vector, no self-modifying target -- exactly as WM does.
;============================================================

;BCONST -- A = 0FFH if a console char is ready, 00H if not.  Clobbers HL,DE.
BCONST:
	LHLD	1
	LXI	D,3
	DAD	D
	PCHL			; -> BIOS CONST, RETs to our caller

;BCONIN -- A = console char (blocks).  Clobbers HL,DE.
BCONIN:
	LHLD	1
	LXI	D,6
	DAD	D
	PCHL			; -> BIOS CONIN

;BCONOU -- output the char in C.  Clobbers HL,DE (and whatever CONOUT clobbers).
BCONOU:
	LHLD	1
	LXI	D,9
	DAD	D
	PCHL			; -> BIOS CONOUT (char in C)

;OUTCH -- output the char in A, preserving ALL registers (PSW/BC/DE/HL).
; The paint loops keep their pointers in HL/DE across emits, so this must be
; register-transparent.
OUTCH:
	PUSH	PSW
	PUSH	B
	PUSH	D
	PUSH	H
	MOV	C,A
	CALL	BCONOU
	POP	H
	POP	D
	POP	B
	POP	PSW
	RET

;OUTSTR -- output the 0-terminated string at HL.  Preserves BC/DE.
OUTSTR:
	MOV	A,M
	ORA	A
	RZ
	CALL	OUTCH		; preserves HL
	INX	H
	JMP	OUTSTR

;EMITB -- emit the byte in A as decimal (no leading zeros, >=1 digit).
; Preserves BC/DE (used inside GOTOXY, which holds row/col in B/C).
EMITB:
	PUSH	B
	PUSH	D
	MOV	E,A		; E = value
	MVI	B,0		; B = "a digit has been printed" flag
	MVI	D,100
	CALL	EMDIG
	MVI	D,10
	CALL	EMDIG
	MOV	A,E		; ones digit: always printed
	ADI	'0'
	CALL	OUTCH
	POP	D
	POP	B
	RET
;EMDIG -- emit one digit for divisor D; E = remaining value, B = printed flag.
EMDIG:
	MVI	C,0
EMD_LP:
	MOV	A,E
	SUB	D
	JC	EMD_DN
	MOV	E,A
	INR	C
	JMP	EMD_LP
EMD_DN:
	MOV	A,C
	ORA	A
	JNZ	EMD_PR		; nonzero digit -> print
	MOV	A,B
	ORA	A
	RZ			; leading zero -> skip
EMD_PR:
	MOV	A,C
	ADI	'0'
	CALL	OUTCH		; preserves B,C,D,E
	MVI	B,1
EMD_RT:
	RET

;GOTOXY -- CUP to (B=row, C=col), 1-based.  Preserves nothing of note.
GOTOXY:
	MVI	A,ESC
	CALL	OUTCH
	MVI	A,'['
	CALL	OUTCH
	MOV	A,B
	CALL	EMITB
	MVI	A,';'
	CALL	OUTCH
	MOV	A,C
	CALL	EMITB
	MVI	A,'H'
	JMP	OUTCH

;--- the four things every paint does, each written once ------------------
;CHIDE -- hide the cursor (a paint brackets itself in CHIDE .. SCURS).
CHIDE:
	LXI	H,SHIDE
	JMP	OUTSTR
;CRGRS -- put the scroll region back to the whole screen.
CRGRS:
	LXI	H,SREGRS
	JMP	OUTSTR
;GOROW1 -- A = a 1-based row: address its column 1 and clear it.  Falls
; through to CEKL, which is that clear on its own.
GOROW1:
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
;CEKL -- clear from the cursor to the end of its row (ESC[K).
CEKL:
	LXI	H,SEK
	JMP	OUTSTR
;PRNG -- paint the edit rows from B up to (not including) C, counted from 0:
; each cleared (ESC[K), the text on as many rows as its lines take, the fill
; char on the rows past it.  The row table says which line row B is in and
; how many of that line's rows are above it, and the reader is put there.
; The one row a line may own with nothing on it -- the cursor's, past text
; that filled the row above (LYXE) -- is cleared in its turn.  An empty range
; sends nothing.  During a full repaint (FORCEF) a key that is waiting
; abandons the frame, and the return from here is SCDRAW's own.
PRNG:
	MOV	A,B
	CMP	C
	RNC
	STA	PROWN
	MOV	A,C
	STA	PEND
	LDA	TXEND
	DCR	A
	CMP	B		; CY iff row B is past the text
	JC	PG_GO
	PUSH	B
	CALL	RDTOP
	CALL	HTTOP		; HL -> the top line's entry
	POP	B
	LXI	D,0		; D = the rows above the line, E = the lines
PG_F:
	MOV	A,D
	ADD	M
	CMP	B
	JC	PG_N
	JNZ	PG_H		; row B is one of this line's
PG_N:
	MOV	D,A
	INR	E
	INX	H
	JMP	PG_F
PG_H:
	MOV	A,B
	SUB	D
	MOV	C,A
	MVI	B,0		; BC = the rows of it above row B ...
	MOV	A,E
	LXI	H,0
	ORA	A
	JNZ	PG_K
	LHLD	SKIPR		; ... and, for the top line, those off the top
PG_K:
	DAD	B
	SHLD	PSKN
	LXI	H,WINROW	; at the cursor's line or under it: read on from
	CMP	M		;   that line, not down the screen to it
	JC	PG_S
	SUB	M
	PUSH	PSW
	CALL	RDBOL
	POP	PSW
PG_S:
	CALL	RDSKIP		; the reader at that line (A lines down)
PG_GO:
	LDA	PROWN
	INR	A
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
PG_LP:
	LDA	FORCEF
	ORA	A
	JZ	PG_P
	CALL	KBRDY		; RPOLL: a key is waiting -> abandon the repaint
	ORA	A
	JZ	PG_P
	POP	H		; (the cursor stays hidden: no flash in a burst)
	RET
PG_P:
	CALL	CEKL
	CALL	PAINTR
	LDA	LYXE
	ORA	A
	JZ	PG_1
	LDA	SROW		; was that the row over the cursor's own?
	SUI	2
	LXI	H,PROWN
	CMP	M
	JNZ	PG_1
	CALL	PT_NL
	CALL	CEKL
PG_1:
	LDA	PEND
	DCR	A
	LXI	H,PROWN
	CMP	M
	RZ
	RC
	CALL	PT_NL
	JMP	PG_LP
;PT_NL -- CR, LF: down a row, and count it.
PT_NL:
	MVI	A,CR
	CALL	OUTCH
	MVI	A,LF
	CALL	OUTCH
	LXI	H,PROWN
	INR	M
	RET

;GOTOP -- address row 1, column 1 (the scroll region's top row).
GOTOP:
	MVI	B,1
	MVI	C,1
	JMP	GOTOXY

;============================================================
; GEOMETRY AUTODETECT (RENDER.md "Screen layout and runtime geometry").
; Emit ESC[999;999H (park at far corner) + ESC[6n (DSR); parse the reply
; ESC[<rows>;<cols>R; clamp rows [24..200], cols [80..132].  Any timeout or
; malformed byte -> keep the 24x80 defaults.
;============================================================
SCINIT:
	LXI	H,0
	SHLD	WINROW
	LXI	H,SPROBE
	CALL	OUTSTR
	CALL	RDNUMS		; sets NROWS/NCOLS on a clean reply; else no-op
	LDA	NROWS		; NEDIT = NROWS - 1 (message row is the last)
	DCR	A
	STA	NEDIT
	RET

;RDB -- read one console byte with a bounded poll.  CY=1 on timeout; else CY=0,
; A = byte.  A finite spin (65536 polls) so a terminal that never answers ESC[6n
; falls back to defaults rather than hanging.  Clobbers HL.
RDB:
	LXI	H,0
RDB_LP:
	PUSH	H
	CALL	BCONST
	POP	H
	ORA	A
	JNZ	RDB_GO
	DCX	H
	MOV	A,H
	ORA	L
	JNZ	RDB_LP
	STC			; timeout
	RET
RDB_GO:
	CALL	BCONIN
	ORA	A		; CY=0, A=byte
	RET

;RDNUM -- read ASCII digits into DE until a non-digit terminator.
; Exit: CY=1 on timeout; else CY=0, DE=value, A=terminator byte.
RDNUM:
	LXI	D,0
RN_LP:
	PUSH	D
	CALL	RDB
	POP	D
	RC
	CPI	'0'
	JC	RN_DN
	CPI	'9'+1
	JNC	RN_DN
	SUI	'0'
	MOV	C,A		; C = this digit
	MOV	H,D		; HL = value
	MOV	L,E
	DAD	H		; 2x
	MOV	D,H
	MOV	E,L		; DE = 2x
	DAD	H		; 4x
	DAD	H		; 8x
	DAD	D		; 10x
	MVI	B,0		; BC = digit
	DAD	B		; HL = 10x + digit
	XCHG			; DE = new value
	JMP	RN_LP
RN_DN:
	ORA	A		; CY=0, A = terminator
	RET

;RDNUMS -- parse ESC [ <rows> ; <cols> R and store the clamped geometry.
; Any deviation -> RET with NROWS/NCOLS untouched (24x80 default holds).
RDNUMS:
	CALL	RDB
	RC
	CPI	ESC
	RNZ			; not what a DSR reply looks like
	CALL	RDB
	RC
	CPI	'['
	RNZ			; not what a DSR reply looks like
	CALL	RDNUM		; DE = rows
	RC
	CPI	';'
	RNZ			; not what a DSR reply looks like
	XCHG
	SHLD	TMPR
	CALL	RDNUM		; DE = cols
	RC
	CPI	'R'
	RNZ			; not what a DSR reply looks like
	XCHG
	SHLD	TMPC
	LHLD	TMPR		; rows -> clamp [24,200]
	MVI	B,24
	MVI	C,200
	CALL	CLAMP
	STA	NROWS
	LHLD	TMPC		; cols -> clamp [80,132]
	MVI	B,80
	MVI	C,132
	CALL	CLAMP
	STA	NCOLS
RS_BAD:
	RET

;CLAMP -- HL = value (16-bit), B = min byte, C = max byte -> A = clamped byte.
CLAMP:
	MOV	A,H
	ORA	A
	JNZ	CLP_MAX		; value > 255 -> max
	MOV	A,L
	CMP	B
	JC	CLP_MIN		; value < min
	MOV	A,C
	CMP	L		; CY iff max < value
	JC	CLP_MAX
	MOV	A,L
	RET
CLP_MIN:
	MOV	A,B
	RET
CLP_MAX:
	MOV	A,C
	RET

;============================================================
; FRAME -- lay out, then pick the cheapest correct paint.
;============================================================

;SCPRE -- keep what is on the screen: the frame's facts (WINROW .. NXTR) are
; copied to the OLD ones.  The main loop calls this after reading a key and
; before dispatch, so SCDRAW can tell what the key changed.
SCPRE:
	LXI	H,WINROW
	LXI	D,OLDWR
	MVI	B,FRMLEN
SP_LP:
	MOV	A,M
	STAX	D
	INX	H
	INX	D
	DCR	B
	JNZ	SP_LP
	RET

;SCDRAW -- lay the screen out and paint it the cheapest way that is right.
; A cheap paint is two changes, each "this many rows were here, that many
; are": one at the top row (the screen gave rows up, OPN, or gained them,
; OPM, as the text scrolled) and one at the cursor (EDR: EDA rows before, EDB
; now, to be drawn from row EDP).  The terminal moves the rows that stand,
; the rows that are new are sent, and so is whatever the move left wrong at
; the bottom.  When nothing moves and nothing is new, only the cursor goes.
; Whatever does not fit that is a full repaint.
SCDRAW:
	CALL	LAYOUT		; (no output)
	CALL	CURSC		; SROW/SCOL
	LDA	FORCEF		; a prior repaint aborted -> must repaint in full
	ORA	A
	JNZ	SCFULL
	LHLD	OLDSK		; the top line starts on another of its rows:
	XCHG			;   every row on the screen is a different one
	LHLD	SKIPR
	CALL	CMP16
	JNZ	SCFULL
	LXI	H,0
	SHLD	OPN		; (and OPM)
	LDA	LYABV
	MOV	B,A		; B = the edit's first row: the cursor line's
	LDA	OLDCS		; C = the first row of it that can have changed:
	LXI	H,CSRAW		;   the one the cursor was on, or the one it is
	CMP	M
	JC	SD_1
	MOV	A,M
SD_1:
	ADD	B
	MOV	C,A
	LHLD	OLDCR		; E = the rows the line had (H: the line's under)
	MOV	E,L
	LDA	LYTSH
	MOV	D,A		; D = the rows it has
	LDA	RINTENT
	ORA	A
	JZ	SCFULL		; R_FULL
	CPI	R_ILIN
	JZ	SD_IL
	PUSH	H
	LHLD	LYDLT
	MOV	A,H
	ORA	L
	POP	H
	LDA	RINTENT		; (keeps the flags)
	JNZ	SD_OL		; the cursor is on another line
	CPI	R_MOVE
	JNZ	SD_2
	MVI	C,0FFH		; a move: none of the line to draw
SD_2:
	CPI	R_DLIN
	JNZ	SD_3
	MVI	D,0		; the line went
SD_3:
	CPI	R_JOIN
	JNZ	SD_AN
	MOV	A,E		; the line under it went into it
	ADD	H
	MOV	E,A
SD_AN:
	LDA	OLDAB		; where the edit starts was that much lower: the
	SUB	B		;   rows the screen gave up at the top.  Higher,
	JC	SCFULL		;   and it is no paint of these
	STA	OPN
	JMP	SD_GO

	;--- R_ILIN: ILN lines opened at the cursor ---
SD_IL:
	LHLD	LYDLT
	MOV	A,H
	ORA	A
	JNZ	SCFULL
	MOV	C,B		; drawn from the cursor's row, the first opened
	MOV	D,A		; (no rows yet)
	MOV	E,A		; (none were there)
	ORA	L
	JZ	SI_2		; opened where the cursor's line was: 'O', 'P'
	DCR	A
	JNZ	SCFULL
	LDA	WINROW		; opened under it: it is the line above now, and
	ORA	A		;   has to be on the screen
	JZ	SCFULL
	LDA	HTCUR
	DCR	A
	CALL	HTE
	MOV	D,M		; D = that line's rows now
	MOV	A,B
	SUB	D
	MOV	B,A		; the edit starts with it
	LDA	OLDCR
	MOV	E,A
	LDA	ILABOV		; text came off it: drawn from the row the
	ORA	A		;   cursor was on
	JZ	SI_2
	LDA	OLDCS
	ADD	B
	MOV	C,A
SI_2:
	PUSH	B
	PUSH	D
	LDA	ILN
	MOV	B,A
	LDA	HTCUR
	CALL	SUMX		; A = the rows the opened lines take
	POP	D
	POP	B
	JC	SCFULL		; (more than the screen shows)
	ADD	D
	MOV	D,A
	JMP	SD_AN

	;--- a move to another line: the text scrolled SCRLN lines ---
SD_OL:
	CPI	R_MOVE
	JNZ	SCFULL
	LHLD	SCRLN
	MOV	A,H
	ORA	L
	JZ	SCURS		; it stood still: the cursor alone
	MOV	A,H
	ORA	A
	JZ	SO_UP
	INR	A
	JNZ	SCFULL
	SUB	L		; down: the new lines at the top, and their rows
	JZ	SCFULL
	CALL	SUMT
	JC	SCFULL
	STA	OPM
	JMP	SO_GO
SO_UP:
	LDA	OLDBOT		; up: the last line that showed is that many
	SUB	L		;   lines higher.  The row after it was OLDTX,
	JC	SCFULL		;   and is the rows down to it now
	INR	A
	CALL	SUMT
	JC	SCFULL
	MOV	B,A
	LDA	OLDTX
	SUB	B
	JC	SCFULL
	JZ	SCFULL
	STA	OPN
SO_GO:
	LXI	D,0		; no edit
	MVI	C,0FFH

	;--- B = the edit's first row, C = the first to draw, D = its rows
	;    now, E = its rows before ---
SD_GO:
	MOV	A,B
	STA	EDR
	ADD	D
	MOV	B,A		; B = the row after its last
	LDA	NEDIT
	CMP	B
	JC	SCFULL		; (it runs off the screen)
	MOV	A,C
	STA	EDP
	XCHG
	SHLD	EDA		; (and EDB)
	XCHG
	LHLD	OPN
	MOV	A,H
	ORA	L
	JNZ	SD_PT
	MOV	A,D
	CMP	E
	JNZ	SD_PT
	MOV	A,C		; nothing moves.  Nothing to draw either: the
	CMP	B		;   cursor alone
	JNC	SCURS
	INR	A
	CMP	B
	JNZ	SD_PT
	LDA	RINTENT		; the line's last row, the cursor on it before
	CPI	R_ICH		;   and after: a cell opened or closed there is
	JZ	SC_ICH		;   the whole of it
	CPI	R_DCH
	JZ	SC_DCH
SD_PT:
	LHLD	SKIPR		; ('<<<' on the top row is not theirs to keep)
	MOV	A,H
	ORA	L
	JNZ	SCFULL
	CALL	CHIDE
	LHLD	OPN
	XCHG
	LHLD	EDA
	MOV	A,D
	ORA	E
	JNZ	SD_SH
	MOV	A,H
	CMP	L
	JZ	SD_NS
SD_SH:
	CALL	SRGN		; scroll region = rows 1..NEDIT
	LHLD	OPN
	MVI	B,0
	CALL	SHFT
	LHLD	EDA
	LDA	EDR
	MOV	B,A
	CALL	SHFT
	CALL	CRGRS
SD_NS:
	MVI	B,0
	LDA	OPM
	MOV	C,A
	CALL	PRNG		; the rows opened at the top
	LHLD	EDA
	LDA	EDR
	ADD	H
	MOV	C,A
	LDA	EDP
	MOV	B,A
	CALL	PRNG		; the edit's own
	;--- the bottom.  The rows that were good to the end of the screen
	;    (all of them, or as far as the '@' rows) moved with the text; what
	;    lies between where they end now and where good rows should end is
	;    drawn, and so are the rows a move up left bare ---
	LHLD	OLDTX
	CALL	TEV
	MOV	B,A
	LHLD	TXEND
	CALL	TEV
	MOV	C,A
	LHLD	OPN
	XCHG			; E = OPN, D = OPM
	LHLD	EDA		; L = EDA, H = EDB
	MOV	A,D
	ADD	H
	MOV	D,A		; D = the rows that came
	MOV	A,E
	ADD	L
	SUB	D		; A = the rows that went, less those
	LXI	H,NEDIT
	MOV	E,M
	JC	SB_DN
	MOV	D,A		; the text under them moved up D rows
	MOV	A,E
	SUB	D
	MOV	E,A		; E = the first row that left bare
	MOV	A,B
	SUB	D
	JNC	SB_1
	XRA	A
	JMP	SB_1
SB_DN:
	CMA
	INR	A		; ... or down that many
	ADD	B
	JC	SB_0
	CMP	E
	JC	SB_1
SB_0:
	MOV	A,E
SB_1:
	CMP	C		; A = where the old good rows end now
	MOV	B,A
	JC	SB_2
	MOV	B,C
	MOV	C,A
SB_2:
	PUSH	B
	PUSH	D
	CALL	PRNG
	POP	D
	POP	B
	MOV	A,C
	CMP	E
	JNC	SB_3
	MOV	A,E
SB_3:
	MOV	B,A
	LDA	NEDIT
	MOV	C,A
	CALL	PRNG
	JMP	SCURS

;SC_ICH -- R_ICH: a char was typed at the cell the cursor was on, which is
; where the terminal's cursor still is.  ICH (ESC[1@) opens a cell there and
; the char fills it; appended at the row's end (ICHAPP) the cell is blank and
; nothing follows it, so the char alone is the whole frame.  Either way the
; terminal leaves the cursor at SCOL, where insert mode wants it.
; ICHAPP = 2 is 'r': the char took the place of the one under the cursor and
; is under it still, so it is sent and the cursor put back on it.
SC_ICH:
	LDA	ICHAPP
	CPI	3
	JNZ	SC_IC0
	MVI	D,0FFH		; a TAB follows, and went right one
	LDA	SCOL
	CALL	SEGQ
	LHLD	GAPBEG
	DCX	H
	MOV	A,M
	CALL	OUTCH
	JMP	SEGO
SC_IC0:
	CPI	2
	JNZ	SC_IC1
	LHLD	GAPEND
	MOV	A,M
	CALL	OUTCH
	JMP	SCURS
SC_IC1:
	ORA	A
	JNZ	SC_ICC
	LXI	H,SICH		; ESC[1@ -- open one cell, shift the tail right
	CALL	OUTSTR
SC_ICC:
	LHLD	GAPBEG		; the byte typed is right before the gap
	DCX	H
	MOV	A,M
	JMP	OUTCH

;SC_DCH -- R_DCH: DCHN cells went at the cell the cursor was on, which is
; where the terminal's cursor still is: delete-character (ESC[<n>P) there
; draws the rest of the row up, and the cursor is moved only if the delete
; took the line's last char from under it.
; DCHBS: the cell was the one left of the cursor (insert's BS).  The cursor
; steps back onto it first, and is then where it belongs.
SC_DCH:
	LDA	DCHBS
	ANI	2
	JZ	SC_DC1
	LDA	DCHN		; a TAB follows, and came left that many
	MOV	D,A
	LDA	DCHBS
	RAR
	LDA	OLDSC+1
	JNC	SC_DC0
	DCR	A
SC_DC0:
	CALL	SEGQ
	LDA	DCHBS
	RAR
	MVI	A,BS
	CC	OUTCH
	JMP	SEGO
SC_DC1:
	LDA	DCHBS
	ORA	A
	MVI	A,BS
	CNZ	OUTCH
	LXI	H,SCSI
	CALL	OUTSTR
	LDA	DCHN
	CALL	EMITB
	MVI	A,'P'
	CALL	OUTCH
	LDA	DCHBS
	ORA	A
	RNZ
	LHLD	OLDSC
	XCHG
	LHLD	SROW
	CALL	CMP16
	RZ
	JMP	SCURS

;SEGQ -- a TAB follows the edit, and nothing past it has moved if it ends
; where it did.  A = the screen column of the first char after the edit, D =
; the cells the TAB came left (0FFH: it went right one).  If it ends there
; still, B = the chars before it and C = the cells it takes now: all there is
; to paint.  If not -- or the chars before it are not plain ones, or it runs
; past the row -- the row is painted, and the return is not taken.
SEGQ:
	MOV	C,A
	LDA	NCOLS
	SUB	C
	INR	A
	MOV	B,A		; B = the cells from there to the row's end
	LXI	H,SCOL
	LDA	CURDCL
	SUB	M
	ADD	C
	MOV	E,A		; E = its column in the line (the low bits)
	LHLD	GAPEND
	MVI	C,0
SQ_1:
	MOV	A,M
	CPI	TAB
	JZ	SQ_2
	CPI	' '
	JC	SQ_NO
	CPI	DEL
	JNC	SQ_NO
	INX	H
	INR	E
	INR	C
	JNZ	SQ_1
SQ_NO:
	POP	H
	JMP	SD_PT
SQ_2:
	MOV	A,E
	ANI	7
	MOV	E,A
	ADD	D		; where it was: under the same stop?
	CPI	8
	JNC	SQ_NO
	MVI	A,8
	SUB	E
	MOV	E,A		; E = the TAB's cells
	ADD	C
	DCR	A
	CMP	B
	JNC	SQ_NO
	MOV	B,C
	MOV	C,E
	RET

;SEGO -- send them: the B chars after the cursor and C blanks, and the cursor
; back where it belongs.
SEGO:
	LHLD	GAPEND
SE_1:
	MOV	A,B
	ORA	A
	JZ	SE_2
	MOV	A,M
	CALL	OUTCH
	INX	H
	DCR	B
	JMP	SE_1
SE_2:
	MVI	A,' '
	CALL	OUTCH
	DCR	C
	JNZ	SE_2
	JMP	SCURS

;SCFULL -- paint edit rows 1..NEDIT in place, each cleared with ESC[K; a line
; takes as many rows as it is wide, and the rows past the text show '~' (or
; '@').  No ESC[2J (no blank flash).  Message row last; cursor hidden
; throughout, then addressed and shown.
; FORCEF is set until the frame is whole.  A key that arrives part-way cuts it
; short (PRNG): the pending key is dispatched, and the next SCDRAW repaints in
; FULL even if that key is a pure motion (RENDER.md: an aborted frame stays
; dirty -- no cheap paint over a half-painted screen).
SCFULL:
	CALL	CHIDE
	MVI	A,1
	STA	FORCEF
	MVI	B,0
	LDA	NEDIT
	MOV	C,A
	CALL	PRNG
	CALL	PT_NL
	;--- message row (now at NROWS, col 1): vim leaves it blank ---
	CALL	CEKL
	LHLD	SKIPR		; rows of the top line are off the top: '<<<'
	MOV	A,H		;   over its first cells says so, as vim's does
	ORA	L
	JZ	ROWS_M
	CALL	GOTOP
	LXI	H,SSKIP
	CALL	OUTSTR
ROWS_M:
	MVI	A,0FFH		; the row is blank now, so whatever message was
	STA	OEDMOD		;   on it is gone: MODEMS must draw its own again
	;--- address the real cursor (SROW/SCOL precomputed by CURSC) and show ---
	CALL	SCURS
	XRA	A		; a full frame completed -> clear the abort latch
	STA	FORCEF
	RET

;EXPRM -- open the ':' / '/' line: bottom row, cleared, the prompt char in A
; shown.  The message owns the row from here: OEDMOD is marked up to date so
; MODEMS does not blank it out from under the message on the next frame.
EXPRM:
	PUSH	PSW
	LDA	EDMODE
	STA	OEDMOD
	LDA	NROWS
	CALL	GOROW1
	POP	PSW
	JMP	OUTCH

;EXRUB -- erase the char left of the cursor on that line (WM BSCOL: left,
; space, left).
EXRUB:
	LXI	H,SRUB
	JMP	OUTSTR
SRUB:	DB	BS,' ',BS,0

;EXMSG -- show the 0-terminated message at HL on the bottom row, as vim shows
; an error there.  It stays until the mode changes or a full repaint clears it.
EXMSG:
	MOV	A,M
	INX	H
	PUSH	H
	CALL	EXPRM
	POP	H
	JMP	OUTSTR

;SHFT -- B = a row (from 0), L = the rows that were there, H = the rows that
; are: open rows under those that were (IL), or delete under those that stay
; (DL), so that everything below is where it belongs.  In a scroll region.
SHFT:
	MOV	A,H
	SUB	L
	RZ
	MVI	E,'L'
	MOV	D,A
	MOV	A,L
	JNC	SH_1
	MOV	A,L
	SUB	H
	MOV	D,A
	MVI	E,'M'
	MOV	A,H
SH_1:
	ADD	B
	LXI	H,NEDIT
	CMP	M
	RNC			; (under the last edit row: nothing there to move)
	INR	A
	MOV	B,A
	MVI	C,1
	CALL	GOTOXY
	LXI	H,SCSI
	CALL	OUTSTR
	MOV	A,D
	CALL	EMITB
	MOV	A,E
	JMP	OUTCH

;HTTOP -- HL -> the row table's entry for the top line, A = which it is.
HTTOP:
	LDA	HTCUR
	LXI	H,WINROW
	SUB	M
	JMP	HTE

;SUMT -- A = a count of lines from the top one: A = the rows they take.
;SUMX -- the same for the B lines from the table's entry A.
; CY if the table has not so many, or they are a screenful and more.
SUMT:
	MOV	B,A
	CALL	HTTOP
SUMX:
	MOV	C,A
	ADD	B
	MOV	E,A
	LDA	HTN
	CMP	E
	RC
	MOV	A,C
	CALL	HTE
	XRA	A
	INR	B
SM_LP:
	DCR	B
	JZ	SM_DN
	ADD	M
	RC
	INX	H
	JMP	SM_LP
SM_DN:
	MOV	B,A
	LDA	NEDIT
	DCR	A
	CMP	B
	MOV	A,B
	RET

;TEV -- HL = a frame's TXEND and FILCH: A = the row its good rows end at.
; Rows of '~' are as good as text (they stay '~' wherever they move); rows of
; '@' are not.
TEV:
	MOV	A,H
	CPI	'@'
	MOV	A,L
	RZ
	LDA	NEDIT
	RET

;SRGN -- set the scroll region to rows 1..NEDIT (ESC[1;<NEDIT>r) so a native
; scroll/DL/RI leaves the message row (NROWS) untouched.  Reset with SREGRS.
SRGN:
	LXI	H,SRGP
	CALL	OUTSTR
	LDA	NEDIT
	CALL	EMITB
	MVI	A,'r'
	JMP	OUTCH

;CURSC -- the cursor's screen cell (1-based).  CURDCL is its column in the
; LINE, so it is CURDCL / NCOLS rows into it, under the LYABV rows the lines
; above take, at column CURDCL mod NCOLS.  Emits nothing.
CURSC:
	LHLD	CURDCL
	CALL	DIVN		; BC = rows into the line, A = the column
	INR	A
	STA	SCOL
	MOV	A,C
	STA	CSUB
	LHLD	SKIPR
	XCHG
	LHLD	LYABV
	DAD	B
	INX	H
	CALL	SUBHD		; (less the rows of it that are off the top)
	MOV	A,H		; (never past the edit rows)
	ORA	A
	LDA	NEDIT
	JNZ	CS_SET
	CMP	L		; CY iff NEDIT < the row
	JC	CS_SET
	MOV	A,L
CS_SET:
	STA	SROW
	RET

;XTRA -- HL = a line's width in columns: BC = the rows it takes past its first.
; Falls into DIVN.
XTRA:
	LXI	B,0
	MOV	A,H
	ORA	L
	RZ			; an empty line is one row
	DCX	H
;DIVN -- HL / NCOLS: BC = the quotient, A = the remainder.  Clobbers DE, HL.
DIVN:
	LDA	NCOLS
	CMA
	MOV	E,A
	MVI	D,0FFH
	INX	D		; DE = -NCOLS
	LXI	B,0FFFFH
DV_LP:
	INX	B
	DAD	D		; CY while NCOLS still went into it
	JC	DV_LP
	LDA	NCOLS
	ADD	L
	RET

;============================================================
; LAYOUT -- where the cursor's line sits on the screen and what the screen
; holds.  Emits nothing.
;   in : WINROW (last frame's), LNDLT (lines moved since), PLACE, SKIPR
;   out: WINROW (the lines above the cursor's), SCRLN (lines the text moved
;        up), TOPLEN (bytes from the top line's start to the cursor), CBOL
;        (bytes from the cursor line's start), CURDCL, LYABV (rows above the
;        cursor's line), SKIPR, TXEND and FILCH (the rows with no text, and
;        what they show), SCBOT, SCEOF, SCBOF, NXTR, TALLF; the row table
;        (HTAB) of the lines measured; WRLIM raised past the top (WM 3784);
;        LNDLT and PLACE cleared.
; The lines are measured once, into the row table (HTBLD): as many above the
; cursor's as the placement could want, and a screenful of rows from it on.
; Everything after that is arithmetic on the table: which line is the top one
; (as many of the lines wanted above as leave the cursor's whole line room),
; and how far down the text goes.
; LINPSB runs WM's SETCNT, so the vi count (CMDCNT) and the line-move state
; (AUXCNT, DIRFLG) are saved and restored around the layout.
;============================================================
LAYOUT:
	LHLD	CMDCNT
	SHLD	SVCNT
	LHLD	AUXCNT
	SHLD	SVAUX
	LDA	DIRFLG
	STA	SVDIR
	CALL	LYQK		; a move about a screen that stands: no more to do
	JC	LY_TC
	CALL	CURRW		; A = WINROW + LNDLT, clamped to the edit rows
	STA	LYROW
	STA	LYSVR
	XRA	A
	STA	LYND
	STA	LYPRF
	LDA	PLACE		; a line the command placed stays where it was
	ORA	A		;   put; one that only moved is asked about
	CZ	LYFAR
	LHLD	LNDLT
	SHLD	LYDLT
	MOV	A,H
	ORA	L
	LXI	H,0
	SHLD	LNDLT
	MOV	B,A
	LDA	PLACE		; the cursor on another line, or its line put
	ORA	B		;   somewhere by the command: a line starts with
	JZ	LY_SAM		;   its first row.  (The one place SKIPR is
	SHLD	SKIPR		;   given up; HTBLD's rule moves it.)
LY_SAM:
	;--- the lines to measure above the cursor's: those it has over it now,
	;    or all a screen could show when it is to be placed afresh (but no
	;    more than leaves the table room for the rows under it) ---
	LDA	NEDIT
	MOV	C,A		; C = a screenful of rows from the cursor's line on
	DCR	A
	MOV	B,A
	MVI	A,254
	SUB	C
	CMP	B
	JNC	LY_B1
	MOV	B,A
LY_B1:
	CALL	LYMQ
	JZ	LY_BLD
	LDA	LYROW
	MOV	B,A
LY_BLD:
	CALL	HTBLD
	;--- a line taller than the screen whose end is on it: the lines under
	;    that end, as far as the rows go ---
	LDA	TALLF
	ORA	A
	JZ	LY_NT
	LDA	HTEOF
	ORA	A
	JNZ	LY_NT
	LDA	LYTSH
	MOV	B,A
	LDA	NEDIT
	SUB	B
	CALL	HBMOR
LY_NT:
	CALL	LYMQ
	CZ	LYMID		; LYROW = the lines that puts above it
	XRA	A
	STA	PLACE
	;--- of the LYROW lines wanted above, as many as leave the cursor's
	;    whole line room (and the table has: the file may start sooner) ---
	LDA	LYROW
	MOV	B,A
	CALL	LYINI
LY_FT:
	MOV	A,B
	ORA	A
	JZ	LY_FD
	DCR	B
	PUSH	B
	CALL	LMABV
	POP	B
	JNC	LY_FT
LY_FD:
	LDA	LYMAB
	MOV	L,A
	MVI	H,0
	SHLD	LYABV
	;--- the top line: LYROW lines above the cursor's (WM MEASLO) ---
	LDA	LYROW
	MOV	L,A		; (H is 0 still)
	CALL	LINPSB		; HL = that line's start
	XCHG
	LHLD	GAPBEG
	CALL	SUBHD		; HL = GAPBEG - top
	SHLD	TOPLEN
	INR	H		; WM 3784-3788: PAGEOUT never spills the screen
	SHLD	WRLIM
	;--- SCBOF: the top line is the file's first (nothing before it on disk) ---
	XRA	A
	STA	SCBOF
	CALL	LYTOPP		; HL = top
	CALL	ISBOF
	JNZ	LY_BW
	INR	A
	STA	SCBOF
LY_BW:
	;--- down the table from the cursor's line: the lines under it that fit
	;    whole.  C = the rows taken, D = those lines. ---
	MVI	A,'~'
	STA	FILCH
	XRA	A
	STA	SCEOF
	MOV	D,A
	LDA	HTCUR
	MOV	B,A
	CALL	HTE		; HL -> the cursor line's entry
	LDA	HTN
	SUB	B
	MOV	B,A		; B = the entries from it on
	LDA	LYMAB
	MOV	C,A
	LDA	LYTSH
	ADD	C
	MOV	C,A
LY_WK:
	INX	H
	DCR	B
	JZ	LY_WE
	LDA	NEDIT
	SUB	C		; A = the rows left
	JZ	LY_END		; none: what is under them is not cut off
	CMP	M		; CY iff the line takes more
	JC	LY_CUT
	MOV	A,C
	ADD	M
	MOV	C,A
	INR	D
	JMP	LY_WK
LY_CUT:
	MVI	A,'@'		; a line that does not fit is not shown, and the
	STA	FILCH		;   rows it would have started on say so
	JMP	LY_END
LY_WE:
	LDA	HTEOF		; the table ended: with the text, or with the rows
	STA	SCEOF
LY_END:
	MOV	A,C
	STA	TXEND		; the first row with no text on it
	XRA	A		; NXTR = the rows of the line under the cursor's,
	ORA	D		;   if it shows
	JZ	LY_NX
	PUSH	D
	LDA	HTCUR
	INR	A
	CALL	HTE
	POP	D
	MOV	A,M
LY_NX:
	STA	NXTR
	LDA	LYROW		; SCBOT = the last line shown, counted as WINROW is
	ADD	D
	STA	SCBOT
	LDA	LYROW		; WINROW = row
	MOV	L,A
	MVI	H,0
	SHLD	WINROW
	XCHG			; SCRLN = LNDLT - (row - OLDWR)
	LHLD	LYDLT
	CALL	SUBHD
	XCHG
	LHLD	OLDWR
	DAD	D
	SHLD	SCRLN
	MVI	A,1		; the table is the screen's own, and LYQK may go
	STA	LYOK		;   by it while the text stays where it is
	CALL	LYTOPP
	XCHG
	LHLD	TXTBEG
	XCHG
	CALL	SUBHD		; (kept from TXTBEG: the text is moved about)
	SHLD	LYTOP
	LHLD	PGTOPM
	SHLD	LYPG
LY_TC:
	CALL	TABCUR
	LHLD	SVCNT
	SHLD	CMDCNT
	LHLD	SVAUX
	SHLD	AUXCNT
	LDA	SVDIR
	STA	DIRFLG
	RET

;LYQK -- the layout of a key that left every line on the screen the rows it
; had: the row table stands, and the screen is not read again.
; A key that only moved the cursor, in command mode, to a line the screen
; shows whole already: what moves with the cursor is found from the cursor --
; the lines above it (WINROW), the table's entry for its line (HTCUR), the
; rows over it (LYABV), where the top line is from here (TOPLEN, WRLIM), and
; its column, for which its own line is measured as far as the cursor and no
; farther.
; A key that changed the cursor's line and no other (R_ICH, R_DCH, R_LINE; a
; move in insert mode goes this way too, the cursor there being free to stand
; past the line's end): that one line is measured whole, and if it takes the
; rows it took, that is the layout.
;   out: CY when that was the layout; NC when the screen has to be measured:
;        the table is not the screen's (LYOK), the pager moved the text
;        (PGTOPM), the key did more than that (RINTENT), the command placed
;        the line (PLACE), the cursor's line is off the screen or cut, the top
;        line is taller than the screen, or the line changed takes other rows
;        than it did.  (What is set by then LAYOUT sets again.)
LYQK:
	LDA	LYOK
	ORA	A
	RZ
	CALL	LQMV
	JZ	LQK_G
	LHLD	LNDLT		; an edit: of the line the cursor was on
	MOV	A,H
	ORA	L
	JNZ	LQK_N
	LDA	RINTENT
	CPI	R_MOVE
	JZ	LQK_G
	CPI	R_LINE
	JZ	LQK_G
	CPI	R_ICH
	JZ	LQK_G
	CPI	R_DCH
	JNZ	LQK_N
LQK_G:
	LHLD	SKIPR
	LDA	PLACE
	ORA	H
	ORA	L
	LXI	H,LYXE
	ORA	M
	LXI	H,TALLF
	ORA	M
	JNZ	LQK_N
	LHLD	PGTOPM		; (and the text in memory starts where it did:
	XCHG			;   the pager has not moved the window since)
	LHLD	LYPG
	CALL	CMP16
	JNZ	LQK_N
	LHLD	WINROW
	XCHG
	LHLD	LNDLT
	DAD	D		; HL = the lines that would be above it
	MOV	A,H
	ORA	A
	JNZ	LQK_N		; over the top line, or far under the last
	LDA	SCBOT
	CMP	L		; CY iff it is under the last line shown
	JC	LQK_N
	SHLD	WINROW
	LHLD	LNDLT
	SHLD	LYDLT
	LDA	HTCUR
	ADD	L
	STA	HTCUR
	LXI	H,0
	SHLD	LNDLT
	SHLD	SCRLN
	LHLD	TXTBEG		; the top line is as far into the text in
	XCHG			;   memory as it was
	LHLD	LYTOP
	DAD	D
	CALL	G2P
	SHLD	TOPLEN
	INR	H
	SHLD	WRLIM
	LXI	H,0		; the cursor's line, as far as the cursor
	CALL	LINPSB
	PUSH	H
	CALL	G2P
	SHLD	CBOL
	MOV	B,H
	MOV	C,L
	POP	H
	CALL	LNW
	XCHG
	SHLD	CURDCL
	CALL	DIVN
	STA	LQKC		; (the cells before it on that row)
	MOV	A,C
	STA	CSRAW		; the row of its line the cursor is on
	LDA	WINROW
	CALL	SUMT
	MOV	L,A
	MVI	H,0
	SHLD	LYABV
	LDA	HTCUR
	CALL	HTE
	MOV	A,M
	STA	LYTSH
	INX	H
	MOV	B,M
	LDA	WINROW
	LXI	H,SCBOT
	CMP	M		; CY iff a line shows under it
	MVI	A,0
	JNC	LQK_1
	MOV	A,B
LQK_1:
	STA	NXTR
	CALL	RGET0		; the char under the cursor in memory (TABCUR)
	PUSH	H
	CALL	LQMV
	POP	H
	JNZ	LQK_E
	CALL	RDGET
	STC
	RET
	;--- the line changed: the rest of it, as HTBLD reads it ---
LQK_E:
	LDA	LQKC
	MOV	E,A
	LDA	CURDCL
	SUB	E
	STA	LYVB
	LDA	CSRAW
	MOV	D,A
	CALL	LM_FL		; D = its last row
	CPI	1
	JZ	LQK_N		; more rows than the screen has
	MOV	A,E
	ORA	A
	JNZ	LQK_2
	ORA	D
	JNZ	LQK_N		; the cursor has a row to itself (LYXE)
LQK_2:
	LDA	LYTSH
	DCR	A
	CMP	D
	JNZ	LQK_N		; other rows than it had
	STC
	RET
LQK_N:
	XRA	A
	RET

;LQMV -- Z iff the key only moved the cursor, in command mode.  Keeps BC, DE.
LQMV:
	LDA	RINTENT
	CPI	R_MOVE
	RNZ
	LDA	EDMODE
	CPI	EM_CMD
	RET

;LYMQ -- Z iff the cursor's line is to be placed afresh: mid-screen (PLACE =
; PL_MID), or by the rows about it (LYND).  Keeps BC.
LYMQ:
	LDA	PLACE
	CPI	PL_MID
	RZ
	LDA	LYND
	ORA	A
	JZ	LQ_NO
	XRA	A
	RET
LQ_NO:
	INR	A
	RET

;FLINE -- read forward to the end of the line the reader (HL/BC, as RDGET
; keeps them) is in.  D = the row being filled, E = the cells used in it, LYVB
; the column that row starts at; all three are kept up.  A row is left only
; when there is a cell more to put, so a line just as wide as the screen is
; one row.
;   A = 0    the line ended, its LF read
;   A = 1    it needs a row the screen has not got (D = NEDIT)
;   A = 0FFH the text ended
FLINE:
	CALL	RDGET		; (pages in on demand; keeps DE)
	JC	FL_EOF
	STA	LYLAST
	CPI	LF
	JZ	FL_LF
	CPI	CR
	JZ	FLINE		; CR contributes no display column
	CPI	TAB
	JZ	FL_TAB
	CALL	FL_CEL
	JNZ	FLINE
FL_OVR:
	MVI	A,1
	RET
FL_TAB:
	LDA	LYVB		; TAB: the cells to the next multiple of TABWID
	ADD	E
	ANI	TABWID-1
	CMA
	ADI	TABWID+1
	PUSH	H
	MOV	L,A
FT_LP:
	CALL	FL_CEL
	JZ	FT_OVR
	DCR	L
	JNZ	FT_LP
	POP	H
	JMP	FLINE
FT_OVR:
	POP	H
	JMP	FL_OVR
FL_LF:
	XRA	A
	RET
FL_EOF:
	MVI	A,0FFH
	RET
;FL_CEL -- one more cell on the line.  Z if that takes a row the screen has
; not got.  Keeps HL, BC.
FL_CEL:
	LDA	NCOLS
	CMP	E
	JNZ	FC_1
	MVI	E,0		; the row is full: the next one, starting NCOLS on
	INR	D
	PUSH	H
	LXI	H,LYVB
	ADD	M
	MOV	M,A
	POP	H
	LDA	NEDIT
	CMP	D
	RZ
FC_1:
	INR	E		; (NZ)
	RET

;ISBOF -- HL = an address in the text: Z (and A = 0) iff the file starts
; there -- it is the first byte in memory and no record went out before it.
ISBOF:
	XCHG
	LHLD	TXTBEG
	CALL	CMP16
	RNZ
	LHLD	OUTPOS
	MOV	A,H
	ORA	L
	RET

;LYMID -- the cursor's line is to go in the middle of the screen (PLACE =
; PL_MID): LYROW = the lines that leaves above it.  This is vim's
; scroll_cursor_halfway, which counts ROWS: starting with the cursor's line,
; take a line below while the rows below are no more than those above, else a
; line above, until a line will not fit.  Past the end of the file a '~' row
; counts as a row below that costs nothing, so there the screen fills from
; above; at the start of the file it stops.  The rows are the row table's.
;
; With LYND set (LYFAR: the line is LYND lines under the last one shown) it
; first asks vim's scroll_cursor_bot whether to go to the middle at all: the
; cursor's line, the LYND lines over it and as many under it -- if the screen
; holds them all, the text only scrolls up to the line (LYROW as it was, and
; LAYOUT gives up what lines it must).  If not, it is the middle after all,
; but taking the line above first when the rows are even (LYPRF: vim's
; prefer_above), which is not the same place once lines differ in height.
LYMID:
	CALL	LYINI
	LDA	LYND
	ORA	A
	JZ	LM_LP
LM_NR:
	CALL	LMABV		; a line above and a line below, LYND times
	JC	LM_P
	CALL	LMBLW
	JC	LM_P
	LXI	H,LYND
	DCR	M
	JNZ	LM_NR
	LDA	LYSVR		; the screen holds them: scroll to it
	STA	LYROW
	RET
LM_P:
	XRA	A		; it does not: the middle, above first
	STA	LYND
	INR	A
	STA	LYPRF
	JMP	LYMID
LM_LP:
	LDA	LYMBL
	LXI	H,LYPRF
	ADD	M
	MOV	B,A
	LDA	LYMAB
	CMP	B		; CY iff fewer rows above than below (or as
	JC	LM_U		;   many, when above goes first)
	CALL	LMBLW
	JNC	LM_LP
	RET
LM_U:
	CALL	LMABV
	JNC	LM_LP
	RET

;LYINI -- the cursor's line alone: no line taken above it (LYROW) or below
; (LYIB: the next one's entry), LYUSE = its rows.  Keeps BC.
LYINI:
	XRA	A
	STA	LYROW
	STA	LYMAB
	STA	LYMBL
	LDA	HTCUR
	CALL	HTE
	MOV	A,M
	STA	LYUSE
	INX	H
	SHLD	LYIB
	RET

;LMBLW -- take the next line below the ones taken -- a '~' row, once the
; text has ended.  CY if the screen has no room for it.
LMBLW:
	LDA	HTN
	CALL	HTE
	XCHG
	LHLD	LYIB
	CALL	CMP16		; Z iff the table has no more
	JNZ	LB_1
	LDA	HTEOF		; ... because the rows ran out: no room
	ORA	A
	STC
	RZ
	LXI	H,LYMBL		; ... because the text did: a '~' row
	INR	M
	ORA	A
	RET
LB_1:
	MOV	A,M
	CALL	LM_ADD
	RC
	LXI	H,LYMBL
	ADD	M
	MOV	M,A
	LHLD	LYIB
	INX	H
	SHLD	LYIB
	RET

;LMABV -- take the next line above the ones taken (LYROW counts them).
; CY if the table has none, or the screen has no room for it.
LMABV:
	LXI	H,LYROW
	LDA	HTCUR
	SUB	M
	STC
	RZ
	DCR	A
	CALL	HTE
	MOV	A,M
	CALL	LM_ADD
	RC
	LXI	H,LYMAB
	ADD	M
	MOV	M,A
	LXI	H,LYROW
	INR	M
	RET

;HTE -- HL -> the row table's entry A.  Keeps A, BC.
HTE:
	MOV	E,A
	MVI	D,0
	LXI	H,HTAB
	DAD	D
	RET

;LM_ADD -- A = a line's rows: CY if the screen has not that many left, else
; they are taken (LYUSE) and A is kept.
LM_ADD:
	MOV	B,A
	LDA	LYUSE
	ADD	B
	RC
	MOV	C,A
	LDA	NEDIT
	CMP	C		; CY iff NEDIT < the rows that would make
	RC
	MOV	A,C
	STA	LYUSE
	MOV	A,B
	RET

;LM_NX -- read the next line below: D = its last row, counted from 0.  A and
; the flags are FLINE's answer.  The reader is kept in RDHL/RDBC between
; lines, the registers being wanted for the lines above.
;LM_FL -- the same, from where D, E, LYVB and the reader (HL/BC) stand.
LM_NX:
	LXI	D,0
	XRA	A
	STA	LYVB
	LHLD	RDBC
	MOV	B,H
	MOV	C,L
	LHLD	RDHL
LM_FL:
	CALL	FLINE
	SHLD	RDHL
	MOV	H,B
	MOV	L,C
	SHLD	RDBC
	ORA	A
	RET

;LYTOPP -- HL = the top line's start, BC = TOPLEN, the bytes from there to
; the cursor.
;G2P -- HL = a count of bytes back from the cursor: HL = that address.  And
; the other way about: an address in, its count out.  A refill moves the text,
; so anything kept across a forward read is kept as the count.  Keeps BC.
LYTOPP:
	LHLD	TOPLEN
	MOV	B,H
	MOV	C,L
G2P:
	XCHG
	LHLD	GAPBEG
	JMP	SUBHD

;LNW -- measure one line.  HL = its text, BC = the bytes there are: DE = its
; width in columns (tabs expanded), HL/BC past it.  CY when it ended with its
; LF, NC when the bytes ran out first.
LNW:
	LXI	D,0
LNW_LP:
	MOV	A,B
	ORA	C
	RZ
	MOV	A,M
	INX	H
	DCX	B
	CPI	LF
	JZ	LNW_LF
	CPI	CR
	JZ	LNW_LP		; CR contributes no display column
	CPI	TAB
	JNZ	LNW_1
	MOV	A,E		; TAB: to the next multiple of TABWID
	ORI	TABWID-1
	MOV	E,A
LNW_1:
	INX	D
	JMP	LNW_LP
LNW_LF:
	STC
	RET

;LYFAR -- vim's rule (NOT WordMaster, vim 9.1's update_topline) for a cursor
; line that moved off the screen.  Above the top line it counts LINES: up to
; NEDIT/2-2 of them and the screen scrolls down to it (CURRW's clamp), farther
; and it goes in the middle (PL_MID).  Below, the line is some lines under the
; last one that showed whole (SCBOT): more than NEDIT of them is the middle
; too; fewer, and it is a matter of ROWS, which LYMID settles (LYND).
LYFAR:
	LHLD	WINROW
	XCHG
	LHLD	LNDLT
	DAD	D		; HL = the lines from the top line to it (signed)
	MOV	A,H
	ORA	A
	JP	LF_DN
	LDA	NEDIT
	ORA	A
	RAR
	SUI	2
	MOV	E,A
	MVI	D,0
	DAD	D		; above: row + NEDIT/2 - 2 < 0 is far
	MOV	A,H
	ORA	A
	RP
LF_FAR:
	MVI	A,PL_MID
	STA	PLACE
	RET
LF_DN:
	LDA	SCBOT
	INR	A
	MOV	E,A
	MVI	D,0
	CALL	SUBHD		; HL = the lines it is under the last one shown,
	MOV	A,H		;   less one
	ORA	A
	RM			; on the screen
	JNZ	LF_FAR
	LDA	NEDIT
	CMP	L		; CY iff NEDIT < that
	JC	LF_FAR
	MOV	A,L
	STA	LYND		; (0: the line right under it only ever scrolls)
	RET

;HTBLD -- the rows each line about the cursor takes, in file order, in
; HTAB[0..HTN): what the layout places the screen by, and the scrolls, which
; count screen rows, move it by.
;   in : B = the lines above the cursor's to take (fewer if the file starts
;        sooner: HTBOF), C = the rows to gather from the cursor's line on --
;        that line, then the ones under it until they come to as many, or the
;        text ends (HTEOF)
;   out: HTCUR = the cursor line's place in the table; CBOL, CURDCL; SKIPR,
;        TALLF, LYTSH, LYXE, CSRAW (below); WRLIM past what was measured
; A line taller than the screen counts as a screenful, and ends the table.
; Lines above that memory will not hold all at once are simply not in it: the
; table then starts lower, at a line's start, with HTBOF clear.
;
; The cursor's own line is read from the row of it the cursor is on.  When it
; is taller than the screen (TALLF) it is the top line, shown from its row
; SKIPR -- vim's curs_columns with 'scrolloff' 0: that row moves only as far
; as keeps the cursor's on the screen -- and LYTSH is the rows of it that
; show.  One that was taller, before an edit, is whole again (SKIPR = 0).
; LYXE: the line ends on a row it has put nothing on -- the cursor's, standing
; past text that filled the row above (an insert at the end of a line just as
; wide as the screen).
; LINPSB runs WM's SETCNT: the caller keeps the count (CMD.MAC ZSAVE).
HTBLD:
	MOV	A,C
	STA	HTLIM
	XRA	A
	STA	HTN
	STA	LYOK		; (not the screen's until LAYOUT says so)
	STA	HTEOF
	STA	HTBOF
	STA	LYXE
	STA	TALLF
	MOV	L,B
	MOV	H,A
	CALL	LINPSB		; HL = the highest of them (paged back if needed);
	PUSH	PSW		;   CY: memory would not hold them all
	PUSH	H
	CALL	ISBOF
	JNZ	HB_1
	INR	A
	STA	HTBOF
HB_1:
	POP	H
	PUSH	H
	CALL	G2P		; HL = the bytes from there to the cursor
	PUSH	H
	LDA	NCOLS		; LYLIM = those, or the bytes a screen's rows
	ADI	2		;   hold, a line end to each, if that is fewer:
	MOV	L,A		;   lines farther up are too big to be shown with
	MVI	H,0		;   the cursor's, and held in memory they would
	LDA	NEDIT		;   leave no room to read down
	CALL	MULHA
	POP	D
	MOV	B,D
	MOV	C,E
	CALL	CMP16		; CY iff there are fewer than that
	JNC	HB_LM
	XCHG
HB_LM:
	SHLD	LYLIM
	POP	H
	POP	PSW
	JNC	HB_AB
	LDA	HTBOF
	ORA	A
	CZ	LNW		; ... and what it does hold need not start with
				;   a line: the table starts at the next one
HB_AB:
	PUSH	B		; (CBOL, if this turns out to be the cursor's)
	CALL	LNW		; DE = a line's width; CY: it ended, LF and all
	JNC	HB_CU
	XTHL			; (that count is not wanted; the pointer is)
	PUSH	B
	XCHG
	CALL	XTRA		; BC = its rows past the first
	MOV	A,B
	ORA	A
	JNZ	HB_TA
	LDA	NEDIT
	DCR	A
	CMP	C		; CY iff more rows than the screen has
	MOV	A,C
	INR	A
	JNC	HB_PA
HB_TA:
	LDA	NEDIT
HB_PA:
	CALL	HTPUT
	POP	B
	POP	H
	JMP	HB_AB
HB_CU:
	XCHG
	SHLD	CURDCL
	POP	H
	SHLD	CBOL
	XCHG			; none of it spilled while reading down: the
	LHLD	LYLIM		;   lines measured (LYLIM), and all of the
	CALL	CMP16		;   cursor's own up to here
	JC	HB_WL
	XCHG
HB_WL:
	INR	H
	SHLD	WRLIM
	LDA	HTN
	STA	HTCUR
	LHLD	CURDCL
	CALL	DIVN		; BC = rows into the line, A = cells used there
	MOV	E,A
	LDA	CURDCL
	SUB	E
	STA	LYVB		; the column the cursor's row starts at
	PUSH	D		; (E: the cells used in the cursor's row)
	LHLD	SKIPR
	MOV	D,B
	MOV	E,C
	CALL	CMP16		; CY iff the cursor's row is above the first shown
	XCHG			; HL = the cursor's row of the line, DE = SKIPR
	JC	HB_SS		; then that is the first
	CALL	SUBHD		; HL = the rows from the first shown to it
	MOV	A,H
	ORA	A
	JNZ	HB_SD
	LDA	NEDIT
	DCR	A
	CMP	L		; CY iff that is under the last edit row
	XCHG			; HL = SKIPR, as it was
	JNC	HB_SS
HB_SD:
	LDA	NEDIT		; then it is the last: SKIPR = its row - NEDIT + 1
	CMA
	MOV	L,A
	MVI	H,0FFH
	INX	H
	INX	H
	DAD	B
HB_SS:
	SHLD	SKIPR
	XCHG
	MOV	H,B
	MOV	L,C
	CALL	SUBHD		; HL = the cursor's row of what is shown of it
	MOV	A,L
	STA	CSRAW
	POP	D
	MOV	D,A
	CALL	RGET0
	CALL	LM_FL		; the rest of the line: D = its last row
	PUSH	PSW
	CPI	1
	JZ	HB_TO		; more rows than the screen has
	LHLD	SKIPR
	MOV	A,H
	ORA	L
	JZ	HB_E2
	MOV	A,H
	ORA	A
	JNZ	HB_TE		; (256 rows off the top and more: it is taller)
	MOV	A,L
	ADD	D		; SKIPR + D = its rows, less one
	JC	HB_TE
	LXI	H,NEDIT
	CMP	M
	JNC	HB_TE		; more than NEDIT of them
	MOV	D,A		; no taller than the screen after all: whole
	LXI	H,0
	SHLD	SKIPR
	JMP	HB_E2
HB_TE:
	MVI	A,1
	STA	TALLF
HB_E2:
	MOV	A,E
	ORA	A
	JNZ	HB_E3
	ORA	D
	JZ	HB_E3		; (its first row: an empty line)
	MVI	A,1
	STA	LYXE
HB_E3:
	MOV	A,D
	INR	A
	STA	LYTSH
	LDA	TALLF
	ORA	A
	JNZ	HB_TX
	POP	PSW
	JM	HB_LS		; the text ends with it
HB_PT:
	MOV	A,D
	INR	A
	CALL	HTPUT
	MOV	B,A
	LDA	HTLIM
	SUB	B
	STA	HTLIM
	RC
	JZ	HB_PK		; rows enough
HB_NX:
	CALL	LM_NX		; the next line down
	JZ	HB_PT
	JP	HB_TL		; one taller than the screen
	LDA	LYLAST		; the text ended: was that a line?
	CPI	LF
	JZ	HB_EF
HB_LS:
	MOV	A,D
	INR	A
	CALL	HTPUT
HB_EF:
	MVI	A,1
	STA	HTEOF
	RET
HB_PK:
	LHLD	RDBC		; just the rows asked for: is the text over
	MOV	B,H		;   right there?
	MOV	C,L
	LHLD	RDHL
	CALL	RDGET
	RNC
	JMP	HB_EF
;HBMOR -- on with the table from where HTBLD left the reader, for A rows more
; (LAYOUT: under a line taller than the screen, which ends the table).
HBMOR:
	STA	HTLIM
	ORA	A
	JZ	HB_PK
	JMP	HB_NX
HB_TO:
	MVI	A,1
	STA	TALLF
	LDA	NEDIT
	STA	LYTSH
HB_TX:
	POP	PSW		; (taller than the screen: M if the text ends
	JP	HB_TL		;   with it, and on the screen)
	MVI	A,1
	STA	HTEOF
HB_TL:
	LDA	NEDIT
;HTPUT -- A = a line's rows: the table's next entry (a 256th is dropped).
; Keeps A, BC, DE, HL.
HTPUT:
	PUSH	H
	PUSH	D
	LXI	H,HTN
	MOV	E,M
	INR	E
	JZ	HP_1
	MOV	M,E
	DCR	E
	MVI	D,0
	LXI	H,HTAB
	DAD	D
	MOV	M,A
HP_1:
	POP	D
	POP	H
	RET

;TABCUR -- in command mode a cursor on a TAB shows on the tab's last column,
; as vi does (insert mode keeps it at the tab's first column, where the next
; char goes).  The char is resident at GAPEND after LAYOUT's forward read.
TABCUR:
	LDA	EDMODE
	CPI	EM_CMD
	RNZ
	LHLD	TXTEND
	XCHG
	LHLD	GAPEND
	CALL	CMP16		; Z iff GAPEND == TXTEND: no char under the cursor
	RZ
	MOV	A,M
	CPI	TAB
	RNZ
	LHLD	CURDCL
	MOV	A,L
	ORI	TABWID-1
	MOV	L,A
	SHLD	CURDCL
	RET

;============================================================
; TEXT READER -- the screen's text, straight from the gap buffer.  After
; LAYOUT everything on the screen is resident.  Bytes before the gap are read
; by pointer, taken from GAPBEG when the read starts; bytes after it by RGET.
;============================================================

;RDTOP -- start reading at the top line.
RDTOP:
	LHLD	TOPLEN
	JMP	RDSET
;RDBOL -- start reading at the cursor line's start.
RDBOL:
	LHLD	CBOL
RDSET:
	SHLD	RDN
	XCHG
	LHLD	GAPBEG
	CALL	SUBHD
	SHLD	RDP
	XRA	A
	STA	RDSEG
	RET

;RDCH -- next screen byte in A; CY at the end of the text.  Preserves BC/DE/HL.
RDCH:
	PUSH	B
	PUSH	D
	PUSH	H
	LHLD	RDN		; before-gap bytes left?
	MOV	A,H
	ORA	L
	JZ	RDC_AF
	DCX	H
	SHLD	RDN
	LHLD	RDP
	MOV	A,M
	INX	H
	SHLD	RDP
	ORA	A		; CY=0
	JMP	RDC_RT
RDC_AF:
	LDA	RDSEG
	ORA	A
	JNZ	RDC_NX
	INR	A		; first after-gap byte: start RGET
	STA	RDSEG
	CALL	RGET0
	JMP	RDC_GT
RDC_NX:
	LHLD	RDBC
	MOV	B,H
	MOV	C,L
	LHLD	RDHL
RDC_GT:
	CALL	RDGET
	SHLD	RDHL		; (SHLD/MOV keep RDGET's flags)
	MOV	H,B
	MOV	L,C
	SHLD	RDBC
RDC_RT:
	POP	H
	POP	D
	POP	B
	RET

;RDSKIP -- skip A lines (stops early at the end of the text).
RDSKIP:
	ORA	A
	RZ
	STA	SKPN
	LHLD	RDN		; what lies before the gap is passed over where
	MOV	B,H		;   it lies
	MOV	C,L
	LHLD	RDP
RSK_F:
	MOV	A,B
	ORA	C
	JZ	RSK_S
	MOV	A,M
	INX	H
	DCX	B
	CPI	LF
	JNZ	RSK_F
	LDA	SKPN
	DCR	A
	STA	SKPN
	JNZ	RSK_F
RSK_S:
	SHLD	RDP
	MOV	H,B
	MOV	L,C
	SHLD	RDN
	LDA	SKPN
	ORA	A
	RZ
RSK_LP:
	CALL	RDCH
	RC
	CPI	LF
	JNZ	RSK_LP
	LDA	SKPN
	DCR	A
	STA	SKPN
	JNZ	RSK_LP
	RET

;PSKIP -- PROW, for the top line of a full repaint when rows of it are off
; the top (HL = PSKN = SKIPR, not 0): pass over that many rows, and paint the
; rest of the line.  A TAB across the last of them leaves its other cells on
; the first row shown.
PSKIP:
	LDA	NCOLS
	CALL	MULHA		; HL = the cells to pass over
	XCHG
	LXI	H,0
	SHLD	PSKN
PS_LP:
	MOV	A,D
	ORA	E
	JZ	PR_LP
	CALL	RDCH
	CPI	CR
	JZ	PS_LP
	MVI	C,1
	CPI	TAB
	CZ	TABN
PS_CL:
	MOV	A,D
	ORA	E
	JZ	PRTBLP		; (only a TAB gets here with cells to go)
	DCX	D
	LXI	H,DCOL
	INR	M
	DCR	C
	JNZ	PS_CL
	JMP	PS_LP

;MULHA -- HL = HL * A (A not 0).  Clobbers DE.
MULHA:
	XCHG
	LXI	H,0
MH_LP:
	DAD	D
	DCR	A
	JNZ	MH_LP
	RET

;TABN -- C = the cells a TAB at column DCOL takes (1..8).
TABN:
	LDA	DCOL		; spaces = 8 - (dcol mod 8)
	ANI	7
	MOV	C,A
	MVI	A,8
	SUB	C
	MOV	C,A
	RET

;PAINTR -- paint from screen row PROWN: the reader's line, on as many rows as
; it takes, or the fill char on a row past the text ('~'; '@' where a line did
; not fit).  The reader must be at that row's line.  Row already cleared.
PAINTR:
	LDA	PROWN
	LXI	H,TXEND
	CMP	M		; CY iff the row holds text
	JC	PROW
	LDA	FILCH
	JMP	OUTCH

;PROW -- paint the reader's line: tabs expanded, and on to the next row when
; this one is full and there is more (PROWN follows it down).  The reader ends
; past the line's LF (or at the end).
PROW:
	XRA	A
	STA	DCOL
	STA	XC
	LHLD	PSKN
	MOV	A,H
	ORA	L
	JNZ	PSKIP
PR_LP:
	CALL	RDCH
	RC			; end of text -> line done
	CPI	LF
	RZ			; consumed the LF -> next line start
	CPI	CR
	JZ	PR_LP		; drop CR (part of the CR,LF break)
	CPI	TAB
	JZ	PR_TAB
	CALL	PCELL
	JMP	PR_LP
PR_TAB:
	CALL	TABN		; C = space count (1..8)
PRTBLP:
	MVI	A,' '
	CALL	PCELL		; (keeps C)
	DCR	C
	JNZ	PRTBLP
	JMP	PR_LP

;PCELL -- put the char in A on the next cell of the line.  Keeps C.
PCELL:
	MOV	B,A
	LXI	H,DCOL
	INR	M
	LDA	NCOLS
	LXI	H,XC
	CMP	M
	CZ	PWRAP		; the row is full: this one starts the next
	INR	M
	MOV	A,B
	JMP	OUTCH
;PWRAP -- on to the next row, cleared (CR,LF: the terminal's own wrap is not
; relied on).  From the last row to paint (PEND) there is nowhere to go: the
; rest of the line is not shown, and PROW returns to its caller from here.
PWRAP:
	MVI	M,0
	LDA	PEND
	DCR	A
	LXI	H,PROWN
	CMP	M
	JZ	PW_END
	INR	M
	MVI	A,CR
	CALL	OUTCH
	MVI	A,LF
	CALL	OUTCH
	CALL	CEKL		; (keeps BC)
	LXI	H,XC
	RET
PW_END:
	POP	H		; PCELL's return, and PROW's
	POP	H
	RET

;MODEMS -- the mode message on the bottom row, as vim writes it: '-- INSERT --'
; while an insert is open, '-- REPLACE --' for 'R', and nothing at all in
; command mode.  It is drawn only when the mode differs from what the row last
; showed (OEDMOD) -- which a full repaint spoils, since that blanks the row --
; so an ex message stays put until the mode really changes, the way vim's load
; message survives every motion.  The cursor goes back where SCDRAW left it.
MODEMS:
	LDA	EDMODE
	MOV	B,A
	LDA	OEDMOD
	CMP	B
	RZ			; the row already shows this mode
	MOV	A,B
	STA	OEDMOD
	LXI	H,SINSM
	CPI	EM_INS
	JZ	MD_DRW
	LXI	H,SREPM
	CPI	EM_REP
	JZ	MD_DRW
	LXI	H,SNULL		; command mode: the row goes blank
MD_DRW:
	PUSH	H
	LDA	NROWS
	CALL	GOROW1
	POP	H
	CALL	OUTSTR
;SCURS -- put the cursor back on the text, where SCDRAW left it.  Anything that
; writes the bottom row after a frame (MODEMS, CMD.MAC's messages) ends here.
SCURS:
	LDA	SROW
	MOV	B,A
	LDA	SCOL
	MOV	C,A
	CALL	GOTOXY
	LXI	H,SSHOW
	JMP	OUTSTR

;============================================================
; TEARDOWN -- reset the scroll region, show the cursor, and leave the cursor at
; the bottom left with that row cleared.  No CR,LF: the CCP prints its own
; CR,LF before "A>", which scrolls the text up one row and puts the prompt on
; the bottom row.  Emitting one here too cost a second row for nothing.
;============================================================
SCDONE:
	CALL	CRGRS
	LXI	H,SSHOW
	CALL	OUTSTR
	LDA	NROWS		; bottom left, over the message row -- and blank:
	JMP	GOROW1		;   the CCP prompt lands here

;============================================================
; STRINGS (0-terminated)
;============================================================
SPROBE: DB	ESC,'[','9','9','9',';','9','9','9','H'
	DB	ESC,'[','6','n',0
SEK:	DB	ESC,'[','K',0
SCSI:	DB	ESC,'[',0		; CSI -- the prefix a counted ESC[<n>X needs
SICH:	DB	ESC,'[','1','@',0	; ICH -- insert one cell at the cursor
SRGP:	DB	ESC,'[','1',';',0	; region prefix "ESC[1;" (EMITB + 'r' follow)
SHIDE:	DB	ESC,'[','?','2','5','l',0
SSHOW:	DB	ESC,'[','?','2','5','h',0
SREGRS: DB	ESC,'[','r',0
SINSM:	DB	'-','-',' ','I','N','S','E','R','T',' ','-','-',0
SREPM:	DB	'-','-',' ','R','E','P','L','A','C','E',' ','-','-',0
SNULL:	DB	0
SSKIP:	DB	'<','<','<',0

;============================================================
; DATA
;============================================================
NROWS:	DB	24		; runtime rows    (default; DSR may enlarge)
NCOLS:	DB	80		; runtime columns
NEDIT:	DB	23		; edit rows = NROWS-1 (messages take the last)

;--- a frame's facts, and (SCPRE) the same of the frame before, in one order
WINROW: DW	0		; lines on the screen above the cursor's (WM WINROW)
SKIPR:	DW	0		; rows of the top line that are off the top (a
				;   line taller than the screen; vim's w_skipcol)
SROW:	DB	0		; computed cursor screen row
SCOL:	DB	0		; computed cursor screen column
TXEND:	DB	1		; the first row with no text on it
FILCH:	DB	'~'		; what such a row shows: '~', or '@' for a line cut
SCBOT:	DB	0		; WINROW of the last line shown
LYABV:	DW	0		; rows the lines above the cursor's take
CSRAW:	DB	0		; the row of its line (as shown) the cursor is on
LYTSH:	DB	0		; HTBLD: the rows of the cursor's line that show
NXTR:	DB	0		; ... and of the line under it (0: not shown)
FRMLEN	EQU	$-WINROW
OLDWR:	DW	0
OLDSK:	DW	0
OLDSC:	DW	0
OLDTX:	DW	0		; (TXEND, and FILCH)
OLDBOT:	DB	0
OLDAB:	DW	0
OLDCS:	DB	0
OLDCR:	DB	0
OLDNR:	DB	0

OPN:	DB	0		; SCDRAW: rows the screen gave up at the top
OPM:	DB	0		; ... or gained there
EDA:	DB	0		; the edit: the rows it had
EDB:	DB	0		; ... and has
EDR:	DB	0		; ... its first row
EDP:	DB	0		; ... the first of them to draw
PEND:	DB	0		; PRNG: the row to stop before
TALLF:	DB	0		; 1 = the top line is taller than the screen
SCRLN:	DW	0		; lines the text moved up this frame (signed)
LYOK:	DB	0		; 1 = the row table is the screen's, as it stands
LQKC:	DB	0		; LYQK: the cells before the cursor on its row
LYTOP:	DW	0		; ... the bytes in memory before the top line then
LYPG:	DW	0		; ... and PGTOPM
FORCEF: DB	0		; 1 = a full frame is not finished -> repaint in full
OEDMOD: DB	EM_CMD		; the mode the bottom row last showed (0FFH: unknown)

SCEOF:	DB	0		; 1 = the end of the file is on the screen
SCBOF:	DB	0		; 1 = the top row is the file's first line
PLACE:	DB	0		; the command's request of the next layout (VI.INC
				;   PL_ASK / PL_SET / PL_MID)
CSUB:	DB	0		; the row of its line the cursor is on (0 = first)

TOPLEN: DW	0		; bytes from the top line's start to the cursor
CBOL:	DW	0		; bytes from the cursor line's start to the cursor
CURDCL: DW	0		; cursor display column (0-based, tabs expanded)
LYDLT:	DW	0		; LAYOUT: LNDLT taken for this frame
LYROW:	DB	0		; LAYOUT: working row
LYIB:	DW	0		; LYMID: -> the entry of the next line below
LYVB:	DB	0		; LAYOUT: the column its current row starts at (low
				;   byte: TAB stops)
LYLIM:	DW	0		; HTBLD: bytes back to pin while reading down
LYUSE:	DB	0		; LYMID: rows taken
LYMAB:	DB	0		; LYMID: ... of them above the cursor's line
LYMBL:	DB	0		; LYMID: ... and below it ('~' rows too)
LYND:	DB	0		; LYMID: lines under the last one shown (LYFAR)
LYPRF:	DB	0		; LYMID: 1 = a line above first when rows are even
LYSVR:	DB	0		; LAYOUT: LYROW as CURRW gave it
HTLIM:	DB	0		; HTBLD: rows still to gather
LYXE:	DB	0		; HTBLD: 1 when the cursor has a row to itself
LYLAST: DB	0		; LAYOUT: last byte read forward
SVCNT:	DW	0		; LAYOUT: saved CMDCNT
SVAUX:	DW	0		; LAYOUT: saved AUXCNT
SVDIR:	DB	0		; LAYOUT: saved DIRFLG

RDP:	DW	0		; reader: next before-gap byte
RDN:	DW	0		; reader: before-gap bytes left
RDHL:	DW	0		; reader: RGET pointer
RDBC:	DW	0		; reader: RGET count
RDSEG:	DB	0		; reader: 1 once reading after the gap
SKPN:	DB	0		; RDSKIP line count
PROWN:	DB	0		; screen row being painted (0-based)
PSKN:	DW	0		; PROW: rows of the line to pass over first
DCOL:	DB	0		; column in the line while painting (low byte)
XC:	DB	0		; cells used in the row being painted

TMPR:	DW	0		; DSR parse: rows
TMPC:	DW	0		; DSR parse: cols

	END
