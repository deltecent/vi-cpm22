;============================================================
; FILE:    KEY.MAC
; PROJECT: VI
; MODULE:  The keyboard -- one byte a key, over the type-ahead ring.
;------------------------------------------------------------
; GETKEY -- blocking key read.  C = A = the byte, bit 7 off.
;   Console I/O: BCONST / BCONIN (EXTRN).  In the editor these are SCRN.MAC's
;   BIOS-direct console leaves; the CMDTST/MOTTST harnesses supply scripted
;   versions so the whole read+dispatch path runs headless.
;     BCONST: A=FFH char ready, A=00H not ready (non-blocking)
;     BCONIN: A=char (blocks until ready)
;
; A key is a byte.  ESC is the byte 1BH and nothing more: it is never held back
; to see whether a '[' follows, so it acts at once, and the keys a terminal
; sends as an ESC sequence -- the arrows, Home, End, PgUp, PgDn, Ins, Del --
; are NOT decoded.  Their bytes are keystrokes like any others: an up-arrow
; is ESC, '[', 'A'.  That is the price of ESC being the key that stops a long
; command (KBBRK): one byte cannot both mean "stop" the moment it arrives and
; wait to find out whether it begins an arrow.
;------------------------------------------------------------
; TYPE-AHEAD RING (WordMaster's input mechanism; see RENDER.md).
; A KBRSIZ-byte ring (KBRING, 31 usable slots) sits over BCONIN.  The
; PRODUCER (KBPUMP) drains every byte the BIOS already has waiting into the ring
; without blocking; the CONSUMER (KBGETB) takes the oldest byte,
; blocking on BCONIN only when the ring is empty.  KBRDY pumps then reports
; whether a byte is waiting -- SCRN.MAC's paint loop polls it (RPOLL) so a slow
; repaint yields to pending keys.  The ring is transparent to a headless harness
; whose BCONST always returns 0: KBPUMP pumps nothing, KBTAKE finds it empty, and
; KBGETB falls through to the blocking BCONIN exactly as before.
;------------------------------------------------------------
; EXPORTS: GETKEY, KBRDY, KBPOLL, KBBRK, KBFLSH     EXTRNS: BCONST, BCONIN
;============================================================
	INCLUDE VI.INC

	EXTRN	KBRING			; RSV.MAC -- the ring, above the image

	PUBLIC	GETKEY, KBRDY, KBPOLL
	PUBLIC	KBBRK, KBFLSH
	EXTRN	BCONST, BCONIN

	CSEG

GETKEY:
	CALL	KBGETB		; next byte: ring first, else block on BCONIN
	ANI	7FH
	MOV	C,A
	RET

;------------------------------------------------------------
; TYPE-AHEAD RING PRIMITIVES
;------------------------------------------------------------
; KBGETB - consumer: return the next byte in A, blocking only if none is ready.
; Drains any waiting bytes into the ring first, so a burst is captured, then
; takes the oldest; an empty ring falls through to the blocking BIOS read.
KBGETB:
	CALL	KBPUMP		; capture anything already waiting
	CALL	KBTAKE		; oldest ring byte -> A (CY=1 if empty)
	RNC
	JMP	BCONIN		; ring empty -> block for the next byte

; KBRDY - pump the ring, then A=0FFH if it holds a byte, else A=00H.  Peeks
; only (takes nothing), so the byte stays for the next KBGETB.  This is
; RPOLL: the paint loop calls it to yield to type-ahead.  Clobbers HL,DE,BC.
KBRDY:
	CALL	KBPUMP
	LDA	KBHEAD
	MOV	B,A
	LDA	KBTAIL
	CMP	B
	JZ	KR_NO
	MVI	A,0FFH
	RET
KR_NO:
	XRA	A
	RET

; KBPOLL - WordMaster's GETKEY contract (WM 6094) for the engine's long loops
; (GOLINE scan, RDSEC disk read, POLLBRK): drain waiting BIOS bytes into the
; ring without blocking; BC, DE, HL preserved; NZ if a byte is queued.
KBPOLL:
	PUSH	B
	PUSH	D
	PUSH	H
	CALL	KBRDY
	ORA	A
	POP	H
	POP	D
	POP	B
	RET

; KBBRK - is an ESC waiting?  Pumps the ring, then looks through what it holds:
; NZ and A=0FFH if an ESC is there -- and the ring is emptied, the ESC and all
; that was typed round it -- else Z.  A long command that can be abandoned
; asks this as it pages (CMD.MAC CNTTST).  The ring is searched, not a flag
; kept as the bytes come in, so an ESC typed when nothing was running is only
; ever a key: it is taken in its turn like any other.  An ESC ANYWHERE in the
; ring counts, so an insert typed ahead of a long move stops the move with the
; ESC that ends it.  Clobbers HL,DE,BC.
KBBRK:
	CALL	KBPUMP
	LDA	KBTAIL
	MOV	C,A
	LDA	KBHEAD
KBK_LP:
	CMP	C
	RZ			; looked at all of it: none
	MOV	E,A
	MVI	D,0
	LXI	H,KBRING
	DAD	D		; HL = &KBRING[index]
	INR	A
	ANI	KBRSIZ-1
	MOV	B,A		; B = the next index
	MOV	A,M
	CPI	ESC
	MOV	A,B
	JNZ	KBK_LP
	MOV	A,C
	STA	KBHEAD		; head = tail: empty
	ORI	0FFH
	RET

; KBFLSH - throw away everything typed so far: what the ring holds and what
; the BIOS still has waiting.  Clobbers HL,DE,BC,A.
KBFLSH:
	CALL	KBPUMP
	LDA	KBTAIL
	STA	KBHEAD
	RET

; KBPUMP - producer: move every byte the BIOS already has into the ring, without
; blocking; stop when the BIOS has none waiting or the ring is full.  Clobbers
; HL,DE,BC,A.
KBPUMP:
KP_LP:
	CALL	KBFULL		; A=0FFH if full
	ORA	A
	RNZ
	CALL	BCONST		; byte waiting at the BIOS?
	ORA	A
	RZ
	CALL	BCONIN		; A = the byte (does not block: status said ready)
	CALL	KBPUT		; append it to the ring
	JMP	KP_LP

; KBPUT - append the byte in A to the ring (caller guarantees not full).
KBPUT:
	PUSH	PSW		; save the byte
	LDA	KBTAIL
	MOV	E,A
	MVI	D,0
	LXI	H,KBRING
	DAD	D		; HL = &KBRING[tail]
	POP	PSW
	MOV	M,A		; store
	LDA	KBTAIL
	INR	A
	ANI	KBRSIZ-1	; wrap (mask = size-1)
	STA	KBTAIL
	RET

; KBTAKE - remove the oldest ring byte.  CY=1 (ring empty) or CY=0 with A=byte.
KBTAKE:
	LDA	KBHEAD
	MOV	B,A
	LDA	KBTAIL
	CMP	B
	JZ	KTK_EMP		; head == tail -> empty
	MOV	E,B
	MVI	D,0
	LXI	H,KBRING
	DAD	D		; HL = &KBRING[head]
	MOV	C,M		; C = byte
	MOV	A,B
	INR	A
	ANI	KBRSIZ-1
	STA	KBHEAD
	MOV	A,C		; A = byte, CY=0 (from ANI)
	RET
KTK_EMP:
	STC
	RET

; KBFULL - A=0FFH if the ring is full ((tail+1) wraps onto head), else A=00H.
KBFULL:
	LDA	KBTAIL
	INR	A
	ANI	KBRSIZ-1
	MOV	B,A
	LDA	KBHEAD
	CMP	B
	JZ	KF_YES
	XRA	A
	RET
KF_YES:
	MVI	A,0FFH
	RET

	CSEG
;The ring's two indexes start at zero, so RSV.MAC holds them, above the
;image, and BUF.MAC's ZINIT clears them.
	EXTRN	KBHEAD, KBTAIL

	END
