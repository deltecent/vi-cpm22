  1CA6'                         MSGNFN:
  1CA6'   21 1CF3'              	LXI	H,SNFN
  1CA9'   C3 1CDE'              	JMP	EXERR
  1CAC'                         MSGEXI:
  1CAC'   21 1D0D'              	LXI	H,SEXI
  1CAF'   C3 1CBB'              	JMP	EXBNG
  1CB2'                         MSGRO:
  1CB2'   21 1D19'              	LXI	H,SRO
  1CB5'   C3 1CBB'              	JMP	EXBNG
  1CB8'                         MSGNWR:
  1CB8'   21 1D00'              	LXI	H,SNWR
  1CBB'                         EXBNG:
  1CBB'   CD 1CDE'              	CALL	EXERR
  1CBE'   21 1D25'              	LXI	H,SBNG
  1CC1'   C3 1CD9'              	JMP	EXOUT
  1CC4'                         EX_INV:
  1CC4'   21 1D33'              	LXI	H,SINV
  1CC7'   C3 1CDE'              	JMP	EXERR
  1CCA'                         EX_V:				; :ve -- the version, on the bottom row
  1CCA'   21 1CEE'              	LXI	H,SVER
  1CCD'   C3 1CDE'              	JMP	EXERR
  1CD0'                         EX_TRL:
  1CD0'   21 1D45'              	LXI	H,STRL
  1CD3'                         EXERT:				; the message, then the text at EXCMD
  1CD3'   CD 1CDE'              	CALL	EXERR
  1CD6'   2A 2430'              	LHLD	EXCMD
  1CD9'                         EXOUT:
  1CD9'   CD 0000*              	CALL	OUTSTR
  1CDC'   37                    	STC
  1CDD'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1CDE'                         EXERR:
  1CDE'   E5                    	PUSH	H
  1CDF'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1CE0'   32 243E'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1CE3'   E1                    	POP	H
  1CE4'   CD 0000*              	CALL	EXMSG
  1CE7'   3E 01                 	MVI	A,R_MOVE
  1CE9'   32 23E3'              	STA	RINTENT
  1CEC'   37                    	STC
  1CED'   C9                    	RET
                                
