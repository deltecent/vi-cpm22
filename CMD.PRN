  05E5'   FE 01                 	CPI	1
  05E7'   CA 27B6'              	JZ	EXERR
  05EA'   21 28AD'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  05ED'   C3 27B6'              	JMP	EXERR
  05F0'                         UNDBEL:
  05F0'   0E 07                 	MVI	C,BEL
  05F2'   CD 0000*              	CALL	BCONOU
  05F5'   C3 0852'              	JMP	SETMOV
                                
