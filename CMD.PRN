  0770'   2A 0000*              	LHLD	WKBOL
  0773'   C9                    	RET
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0774'                         ATENDQ:
  0774'   CD 0000*              	CALL	CUROFF
  0777'   E5                    	PUSH	H
  0778'   CD 0000*              	CALL	LOGLEN
  077B'   D1                    	POP	D		; DE = cur
  077C'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  077F'                         CURCHR:
  077F'   CD 0000*              	CALL	CUROFF
  0782'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0785'                         MOVCNT:
  0785'   CD 086D'              	CALL	SETMOV
  0788'   C3 0798'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  078B'                         CNTOFF:
  078B'   CD 0798'              	CALL	GETCNT
  078E'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0791'                         GBSUB:
  0791'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0792'   2A 0000*              	LHLD	GAPBEG
  0795'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0798'                         GETCNT:
  0798'   2A 0000*              	LHLD	CMDCNT
  079B'   7C                    	MOV	A,H
  079C'   B5                    	ORA	L
  079D'   C2 07A4'              	JNZ	GC_HAVE
  07A0'   21 0001               	LXI	H,1
  07A3'   C9                    	RET
  07A4'                         GC_HAVE:
  07A4'   E5                    	PUSH	H
  07A5'   21 0000               	LXI	H,0
  07A8'   22 0000*              	SHLD	CMDCNT
  07AB'   E1                    	POP	H
  07AC'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  07AD'                         CNTTST:				; WM 1175
  07AD'   3A 0000*              	LDA	BRKARM
  07B0'   B7                    	ORA	A
  07B1'   C4 07DB'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  07B4'   E5                    	PUSH	H
  07B5'   2A 0000*              	LHLD	CMDCNT
  07B8'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  07BB'   B4                    	ORA	H
  07BC'   B5                    	ORA	L
  07BD'   E1                    	POP	H
  07BE'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07C1'                         BRKON:
  07C1'   21 0000*              	LXI	H,SOFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C4'   CD 0444'              	CALL	FPSTO
  07C7'   2A 0000*              	LHLD	LNDLT
  07CA'   22 0000*              	SHLD	SLDLT
  07CD'   AF                    	XRA	A
  07CE'   32 0000*              	STA	BRKHIT
  07D1'   3A 0000*              	LDA	PSAVE
  07D4'   B7                    	ORA	A
  07D5'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07D6'   3C                    	INR	A
  07D7'   32 0000*              	STA	BRKARM
  07DA'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07DB'                         BRKTST:
  07DB'   C5                    	PUSH	B
  07DC'   D5                    	PUSH	D
  07DD'   E5                    	PUSH	H
  07DE'   CD 0000*              	CALL	KBBRK
  07E1'   CA 07FA'              	JZ	BT_NO
  07E4'   32 0000*              	STA	BRKHIT		; (A = FFH)
  07E7'   21 292A'              	LXI	H,SINTG
  07EA'   CD 0000*              	CALL	EXMSG
  07ED'   AF                    	XRA	A
  07EE'   32 0000*              	STA	BRKARM		; the way back is not stopped in its turn
  07F1'   32 0000*              	STA	AUXCNT
  07F4'   21 0000               	LXI	H,0
  07F7'   22 0000*              	SHLD	CMDCNT
  07FA'                         BT_NO:
  07FA'   E1                    	POP	H
  07FB'   D1                    	POP	D
  07FC'   C1                    	POP	B
  07FD'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07FE'                         BRKOFF:
  07FE'   AF                    	XRA	A
  07FF'   32 0000*              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  0802'                         BRKQ:
  0802'   3A 0000*              	LDA	BRKHIT
  0805'   B7                    	ORA	A
  0806'   C8                    	RZ
  0807'   37                    	STC
  0808'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  0809'                         RSTPL:
  0809'   21 0000*              	LXI	H,SOFF
  080C'   CD 03EF'              	CALL	BACKTO
  080F'   2A 0000*              	LHLD	SLDLT
  0812'   22 0000*              	SHLD	LNDLT
  0815'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0816'                         BRKBAK:
  0816'   CD 0809'              	CALL	RSTPL
  0819'   CD 0000*              	CALL	KBFLSH
  081C'   21 291E'              	LXI	H,SINTR
  081F'   C3 287D'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0822'                         CLASSF:
  0822'   47                    	MOV	B,A
  0823'   FE 20                 	CPI	' '
  0825'   CA 0865'              	JZ	CLS0
  0828'   FE 09                 	CPI	TAB
  082A'   CA 0865'              	JZ	CLS0
  082D'   FE 0A                 	CPI	LF
  082F'   CA 0865'              	JZ	CLS0
  0832'   FE 0D                 	CPI	CR
  0834'   CA 0865'              	JZ	CLS0
  0837'   3A 0000*              	LDA	WBIG
  083A'   B7                    	ORA	A
  083B'   C2 0867'              	JNZ	CLS1
  083E'   78                    	MOV	A,B
  083F'   FE 5F                 	CPI	'_'
  0841'   CA 0867'              	JZ	CLS1
  0844'   FE 30                 	CPI	'0'
  0846'   DA 086A'              	JC	CLS2
  0849'   FE 3A                 	CPI	'9'+1
  084B'   DA 0867'              	JC	CLS1
  084E'   FE 41                 	CPI	'A'
  0850'   DA 086A'              	JC	CLS2
  0853'   FE 5B                 	CPI	'Z'+1
  0855'   DA 0867'              	JC	CLS1
  0858'   FE 61                 	CPI	'a'
  085A'   DA 086A'              	JC	CLS2
  085D'   FE 7B                 	CPI	'z'+1
  085F'   DA 0867'              	JC	CLS1
  0862'   C3 086A'              	JMP	CLS2
  0865'   AF                    CLS0:	XRA	A
  0866'   C9                    	RET
  0867'   3E 01                 CLS1:	MVI	A,1
  0869'   C9                    	RET
  086A'   3E 02                 CLS2:	MVI	A,2
  086C'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  086D'                         SETMOV:
  086D'   3E 01                 	MVI	A,R_MOVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  086F'   32 0000*              	STA	RINTENT
  0872'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0873'                         SETLIN:
  0873'   3E 02                 	MVI	A,R_LINE
  0875'   32 0000*              	STA	RINTENT
  0878'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  0879'                         SETCEL:
  0879'   CD 088E'              	CALL	PLAINQ
  087C'   D0                    	RNC
  087D'   3A 0000*              	LDA	VRCH
  0880'   CD 088E'              	CALL	PLAINQ
  0883'   D0                    	RNC
  0884'   78                    	MOV	A,B
  0885'   32 0000*              	STA	ICHAPP
  0888'   3E 04                 	MVI	A,R_ICH
  088A'   32 0000*              	STA	RINTENT
  088D'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  088E'                         PLAINQ:
  088E'   FE 20                 	CPI	' '
  0890'   3F                    	CMC
  0891'   D0                    	RNC
  0892'   FE 7F                 	CPI	DEL
  0894'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0895'                         SETILN:
  0895'   3E 01                 	MVI	A,1
  0897'   32 322E'              	STA	ILN		; one line, unless a put overwrites it below
  089A'   3E 05                 	MVI	A,R_ILIN
  089C'   32 0000*              	STA	RINTENT
  089F'   AF                    	XRA	A
  08A0'   32 0000*              	STA	ILABOV		; the row above the opened ones is untouched
  08A3'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  08A4'                         SETJON:
  08A4'   3E 06                 	MVI	A,R_JOIN
  08A6'   32 0000*              	STA	RINTENT
  08A9'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  08AA'                         SETFUL:
  08AA'   3E 00                 	MVI	A,R_FULL
  08AC'   32 0000*              	STA	RINTENT
  08AF'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  08B0'                         TAILTAB:
  08B0'   C5                    	PUSH	B
  08B1'   CD 0000*              	CALL	CUROFF
  08B4'   E5                    	PUSH	H
  08B5'   2A 0000*              	LHLD	TXTEND
  08B8'   44                    	MOV	B,H
  08B9'   4D                    	MOV	C,L
  08BA'   2A 0000*              	LHLD	GAPEND
  08BD'   D1                    	POP	D		; DE = the offset of the byte at HL
  08BE'                         TT_LP:
  08BE'   7D                    	MOV	A,L
  08BF'   91                    	SUB	C
  08C0'   7C                    	MOV	A,H
  08C1'   98                    	SBB	B
  08C2'   D2 08E2'              	JNC	TT_NO		; reached end of text -> no tab
  08C5'   7E                    	MOV	A,M
  08C6'   FE 0A                 	CPI	LF
  08C8'   CA 08E2'              	JZ	TT_NO		; end of line -> no tab
  08CB'   FE 0D                 	CPI	CR
  08CD'   CA 08D5'              	JZ	TT_NX		; (the line end's own)
  08D0'   FE 20                 	CPI	' '
  08D2'   DA 08DA'              	JC	TT_YES
  08D5'                         TT_NX:
  08D5'   23                    	INX	H
  08D6'   13                    	INX	D
  08D7'   C3 08BE'              	JMP	TT_LP
  08DA'                         TT_YES:
  08DA'   EB                    	XCHG
  08DB'   22 0000*              	SHLD	TTI
  08DE'   C1                    	POP	B
  08DF'   3E 01                 	MVI	A,1
  08E1'   C9                    	RET
  08E2'                         TT_NO:
  08E2'   C1                    	POP	B
  08E3'   AF                    	XRA	A
  08E4'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                
                                ;VC_H -- left, count times, stopping at BOL.
  08E5'                         VC_H:
  08E5'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  08E8'   22 0000*              	SHLD	CNTV
  08EB'                         VCH_LP:
  08EB'   2A 0000*              	LHLD	CNTV
  08EE'   7C                    	MOV	A,H
  08EF'   B5                    	ORA	L
  08F0'   C8                    	RZ
  08F1'   2B                    	DCX	H
  08F2'   22 0000*              	SHLD	CNTV
  08F5'   CD 08FB'              	CALL	HSTEP
  08F8'   C3 08EB'              	JMP	VCH_LP
  08FB'                         HSTEP:
  08FB'   CD 0000*              	CALL	CUROFF		; HL = cur
  08FE'   7C                    	MOV	A,H
  08FF'   B5                    	ORA	L
  0900'   C8                    	RZ			; at 0
  0901'   E5                    	PUSH	H
  0902'   CD 0693'              	CALL	BOL		; HL = bol
  0905'   D1                    	POP	D		; DE = cur
  0906'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  0909'   C8                    	RZ			; at BOL, cannot go left
  090A'   EB                    	XCHG			; HL = cur
  090B'   2B                    	DCX	H
  090C'   C3 0629'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  090F'                         VC_L:
  090F'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0912'   22 0000*              	SHLD	CNTV
  0915'                         VCL_LP:
  0915'   2A 0000*              	LHLD	CNTV
  0918'   7C                    	MOV	A,H
  0919'   B5                    	ORA	L
  091A'   C8                    	RZ
  091B'   2B                    	DCX	H
  091C'   22 0000*              	SHLD	CNTV
  091F'   CD 0925'              	CALL	LSTEP
  0922'   C3 0915'              	JMP	VCL_LP
  0925'                         LSTEP:
  0925'   CD 0000*              	CALL	CUROFF		; HL = cur
  0928'   E5                    	PUSH	H
  0929'   CD 0739'              	CALL	EOLC		; HL = eolc
  092C'   D1                    	POP	D		; DE = cur
  092D'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0930'   D2 0938'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0933'   EB                    	XCHG			; HL = cur
  0934'   23                    	INX	H
  0935'   C3 0629'              	JMP	GOSET
  0938'                         LS_NO:				; on the line's last char.  An operator waiting on
  0938'   CD 0DAB'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  093B'   C8                    	RZ			;   motion inclusive when it falls short), which
  093C'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  093E'   32 0000*              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0941'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0942'                         VC_0:
  0942'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0945'   CD 094F'              	CALL	LNSTRT
  0948'   21 0000               	LXI	H,0
  094B'   22 3230'              	SHLD	GOALCOL
  094E'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  094F'                         LNSTRT:
  094F'   CD 13DB'              	CALL	ZSAVE
  0952'   21 0000               	LXI	H,0
  0955'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0958'   E5                    	PUSH	H
  0959'   CD 13EE'              	CALL	ZREST
  095C'   E1                    	POP	H
  095D'   C3 0000*              	JMP	PUTCUR
                                
                                ;LNEND -- the cursor's line whole in the window: read on from the cursor to
                                ; its LF with WM's RGET, which pages in what the window does not hold yet.
                                ; The window ends on a record, not a line, so its last line is cut short, and
                                ; a measure that stops at the window's end (NLSTART at LOGLEN) takes a piece
                                ; of a line for the whole of it (issue #38).  The cursor stays where it is;
                                ; text behind it may page out, so an offset taken before this is stale.
  0960'                         LNEND:
  0960'   CD 0000*              	CALL	RGET0
  0963'                         LNE_LP:
  0963'   CD 0000*              	CALL	RDGET
  0966'   D8                    	RC			; the end of the file
  0967'   FE 0A                 	CPI	LF
  0969'   C2 0963'              	JNZ	LNE_LP
  096C'   C9                    	RET
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  096D'                         VC_CRT:
  096D'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0970'   C3 0973'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0973'                         FNBLNK:
  0973'   CD 094F'              	CALL	LNSTRT
  0976'   CD 0000*              	CALL	RGET0
  0979'   11 0000               	LXI	D,0		; DE = blanks skipped
  097C'                         FN_LP:
  097C'   CD 0000*              	CALL	RDGET
  097F'   DA 09A2'              	JC	FN_GO		; the end of the file
  0982'   FE 20                 	CPI	' '
  0984'   CA 098C'              	JZ	FN_WH
  0987'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0989'   C2 09A2'              	JNZ	FN_GO		; a non-blank, or the line's end
  098C'                         FN_WH:
  098C'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  098F'   DA 09A2'              	JC	FN_GO
  0992'   FE 0D                 	CPI	CR
  0994'   CA 09A2'              	JZ	FN_GO
  0997'   FE 0A                 	CPI	LF
  0999'   CA 09A2'              	JZ	FN_GO
  099C'   2B                    	DCX	H		; not yet: read that char again
  099D'   03                    	INX	B
  099E'   13                    	INX	D
  099F'   C3 097C'              	JMP	FN_LP
  09A2'                         FN_GO:
  09A2'   D5                    	PUSH	D
  09A3'   CD 0000*              	CALL	CUROFF
  09A6'   D1                    	POP	D
  09A7'   19                    	DAD	D
  09A8'   C3 0629'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  09AB'                         VC_EOL:
  09AB'   CD 086D'              	CALL	SETMOV
  09AE'   21 FFFF               	LXI	H,0FFFFH
  09B1'   22 3230'              	SHLD	GOALCOL
  09B4'   CD 0798'              	CALL	GETCNT
  09B7'   2B                    	DCX	H		; count-1
  09B8'   7C                    	MOV	A,H
  09B9'   B5                    	ORA	L
  09BA'   CA 09C9'              	JZ	VEOL_0
  09BD'   E5                    	PUSH	H
  09BE'   CD 09DE'              	CALL	ONLAST
  09C1'   E1                    	POP	H
  09C2'   D8                    	RC			; the last line: no move (vim)
  09C3'   CD 0A2E'              	CALL	JCORE
  09C6'   C3 0C17'              	JMP	JKLAND
  09C9'                         VEOL_0:
  09C9'   CD 094F'              	CALL	LNSTRT
  09CC'   C3 0C17'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09CF'                         VC_CR:
  09CF'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  09D2'   E5                    	PUSH	H
  09D3'   CD 09DE'              	CALL	ONLAST
  09D6'   E1                    	POP	H
  09D7'   D8                    	RC
  09D8'   CD 0A2E'              	CALL	JCORE
  09DB'   C3 0973'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09DE'                         ONLAST:
  09DE'   CD 0000*              	CALL	RGET0
  09E1'                         OL_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E1'   CD 0000*              	CALL	RDGET
  09E4'   D8                    	RC			; the file ends on this line
  09E5'   FE 0A                 	CPI	LF
  09E7'   C2 09E1'              	JNZ	OL_LP
  09EA'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09ED'                         VC_J:
  09ED'   CD 086D'              	CALL	SETMOV
  09F0'   CD 0A18'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09F3'   CD 0798'              	CALL	GETCNT		; HL = count
  09F6'   CD 0A2E'              	CALL	JCORE
  09F9'   CD 0A11'              	CALL	JKDRP
  09FC'   C3 0C17'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  09FF'                         VC_K:
  09FF'   CD 086D'              	CALL	SETMOV
  0A02'   CD 0A18'              	CALL	GLCHK
  0A05'   CD 0798'              	CALL	GETCNT
  0A08'   CD 0B0E'              	CALL	KCORE
  0A0B'   CD 0A11'              	CALL	JKDRP
  0A0E'   C3 0C17'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  0A11'                         JKDRP:
  0A11'   7A                    	MOV	A,D
  0A12'   B3                    	ORA	E
  0A13'   C0                    	RNZ
  0A14'   32 0000*              	STA	PSAVE
  0A17'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0A18'                         GLCHK:
  0A18'   2A 3230'              	LHLD	GOALCOL
  0A1B'   7C                    	MOV	A,H
  0A1C'   3C                    	INR	A
  0A1D'   C0                    	RNZ
  0A1E'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A1F'   FE FE                 	CPI	0FEH
  0A21'   C0                    	RNZ
  0A22'   C3 062C'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0A25'                         GLSTAL:
  0A25'   E5                    	PUSH	H
  0A26'   21 FFFE               	LXI	H,0FFFEH
  0A29'   22 3230'              	SHLD	GOALCOL
  0A2C'   E1                    	POP	H
  0A2D'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A2E'                         JCORE:
  0A2E'   7C                    	MOV	A,H
  0A2F'   B5                    	ORA	L
  0A30'   C8                    	RZ
  0A31'   22 0000*              	SHLD	JKCNT
  0A34'   CD 0EDA'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A37'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A38'   3A 0000*              	LDA	NEDIT
  0A3B'   3C                    	INR	A
  0A3C'   90                    	SUB	B
  0A3D'   5F                    	MOV	E,A
  0A3E'   16 00                 	MVI	D,0
  0A40'   3A 0000*              	LDA	NEDIT
  0A43'   6F                    	MOV	L,A
  0A44'   26 00                 	MVI	H,0
  0A46'   19                    	DAD	D
  0A47'   EB                    	XCHG			; DE = limit
  0A48'   2A 0000*              	LHLD	JKCNT
  0A4B'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A4E'   D2 0A9C'              	JNC	JC_QK
  0A51'   EB                    	XCHG			; HL = limit
  0A52'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0A55'                         JC_SL:
  0A55'   2A 0000*              	LHLD	JKN
  0A58'   EB                    	XCHG			; DE = LFs to find
  0A59'   CD 0000*              	CALL	RGET0
  0A5C'                         JC_SC:
  0A5C'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A5F'   DA 0A7E'              	JC	JC_EOF
  0A62'   32 0000*              	STA	JKLST
  0A65'   FE 0A                 	CPI	LF
  0A67'   C2 0A5C'              	JNZ	JC_SC
  0A6A'   1B                    	DCX	D
  0A6B'   7A                    	MOV	A,D
  0A6C'   B3                    	ORA	E
  0A6D'   C2 0A5C'              	JNZ	JC_SC
  0A70'   2A 0000*              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A73'   22 0000*              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A76'   3E 01                 	MVI	A,1
  0A78'   32 0000*              	STA	JKPHN
  0A7B'   C3 0AD9'              	JMP	JC_MV
  0A7E'                         JC_EOF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0A7E'   2A 0000*              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A81'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A84'   7C                    	MOV	A,H
  0A85'   B5                    	ORA	L
  0A86'   CA 0A92'              	JZ	JC_AV
  0A89'   3A 0000*              	LDA	JKLST
  0A8C'   FE 0A                 	CPI	LF
  0A8E'   C2 0A92'              	JNZ	JC_AV
  0A91'   2B                    	DCX	H
  0A92'                         JC_AV:
  0A92'   22 0000*              	SHLD	JKMOV
  0A95'   AF                    	XRA	A
  0A96'   32 0000*              	STA	JKPHN
  0A99'   C3 0AD9'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0A9C'                         JC_QK:
  0A9C'   22 0000*              	SHLD	JKN		; N = the count
  0A9F'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0AA2'   3A 0000*              	LDA	JKN
  0AA5'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0AA6'   16 0A                 	MVI	D,LF
  0AA8'   04                    	INR	B
  0AA9'   0C                    	INR	C
  0AAA'                         JQ_LP:
  0AAA'   0D                    	DCR	C
  0AAB'   C2 0AB2'              	JNZ	JQ_CH
  0AAE'   05                    	DCR	B
  0AAF'   CA 0A55'              	JZ	JC_SL
  0AB2'                         JQ_CH:
  0AB2'   7E                    	MOV	A,M
  0AB3'   23                    	INX	H
  0AB4'   BA                    	CMP	D
  0AB5'   C2 0AAA'              	JNZ	JQ_LP
  0AB8'   1D                    	DCR	E
  0AB9'   C2 0AAA'              	JNZ	JQ_LP
  0ABC'   EB                    	XCHG			; DE = the line's start
  0ABD'   2A 0000*              	LHLD	TXTEND
  0AC0'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0AC3'   D2 0A55'              	JNC	JC_SL
  0AC6'   EB                    	XCHG
  0AC7'   CD 0000*              	CALL	PUTCUR
  0ACA'   21 0000               	LXI	H,0
  0ACD'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AD0'   2A 0000*              	LHLD	JKCNT
  0AD3'   22 0000*              	SHLD	JKMOV
  0AD6'   C3 0AF7'              	JMP	JC_DN
  0AD9'                         JC_MV:
  0AD9'   2A 0000*              	LHLD	JKCNT
  0ADC'   AF                    	XRA	A
  0ADD'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0AE0'   CD 0BF6'              	CALL	ATEOF
  0AE3'   D2 0AF7'              	JNC	JC_DN
  0AE6'   CD 0BFC'              	CALL	LASTLN		; ran past the last line: back onto it
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0AE9'   3A 0000*              	LDA	JKPHN
  0AEC'   B7                    	ORA	A
  0AED'   CA 0AF7'              	JZ	JC_DN
  0AF0'   2A 0000*              	LHLD	JKMOV
  0AF3'   2B                    	DCX	H
  0AF4'   22 0000*              	SHLD	JKMOV
  0AF7'                         JC_DN:
  0AF7'   2A 0000*              	LHLD	JKN		; LNDLT += min(moved, N)
  0AFA'   EB                    	XCHG
  0AFB'   2A 0000*              	LHLD	JKMOV
  0AFE'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0B01'   D2 0B05'              	JNC	JC_AD
  0B04'   EB                    	XCHG
  0B05'                         JC_AD:
  0B05'   EB                    	XCHG			; DE = lines moved
  0B06'   2A 0000*              	LHLD	LNDLT
  0B09'   19                    	DAD	D
  0B0A'   22 0000*              	SHLD	LNDLT
  0B0D'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0B0E'                         KCORE:
  0B0E'   7C                    	MOV	A,H
  0B0F'   B5                    	ORA	L
  0B10'   C8                    	RZ
  0B11'   22 0000*              	SHLD	JKCNT
  0B14'   CD 0EDA'              	CALL	CURRW		; limit = row + NEDIT
  0B17'   5F                    	MOV	E,A
  0B18'   16 00                 	MVI	D,0
  0B1A'   3A 0000*              	LDA	NEDIT
  0B1D'   6F                    	MOV	L,A
  0B1E'   26 00                 	MVI	H,0
  0B20'   19                    	DAD	D
  0B21'   EB                    	XCHG			; DE = limit
  0B22'   2A 0000*              	LHLD	JKCNT
  0B25'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0B28'   D2 0BA2'              	JNC	KC_QK
  0B2B'   EB                    	XCHG			; HL = limit
  0B2C'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0B2F'                         KC_SL:
  0B2F'   2A 0000*              	LHLD	JKN
  0B32'   EB                    	XCHG			; DE = LFs to find
  0B33'   21 0000               	LXI	H,0
  0B36'   22 0000*              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0B39'                         KC_ED:
  0B39'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0B3A'   2A 0000*              	LHLD	JKBK
  0B3D'   CD 0791'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B40'   E5                    	PUSH	H
  0B41'   EB                    	XCHG
  0B42'   2A 0000*              	LHLD	TXTBEG
  0B45'   EB                    	XCHG
  0B46'   CD 0000*              	CALL	SUBHD
  0B49'   44                    	MOV	B,H
  0B4A'   4D                    	MOV	C,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B4B'   E1                    	POP	H
  0B4C'   D1                    	POP	D
  0B4D'                         KC_SC:
  0B4D'   78                    	MOV	A,B
  0B4E'   B1                    	ORA	C
  0B4F'   CA 0B66'              	JZ	KC_TB
  0B52'   2B                    	DCX	H
  0B53'   0B                    	DCX	B
  0B54'   7E                    	MOV	A,M
  0B55'   FE 0A                 	CPI	LF
  0B57'   C2 0B4D'              	JNZ	KC_SC
  0B5A'   1B                    	DCX	D
  0B5B'   7A                    	MOV	A,D
  0B5C'   B3                    	ORA	E
  0B5D'   C2 0B4D'              	JNZ	KC_SC
  0B60'   2A 0000*              	LHLD	JKCNT		; N lines above: the move is count lines
  0B63'   C3 0B86'              	JMP	KC_MV
  0B66'                         KC_TB:
  0B66'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B67'   CD 0791'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B6A'   22 0000*              	SHLD	JKBK
  0B6D'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B70'   7C                    	MOV	A,H
  0B71'   B5                    	ORA	L
  0B72'   CA 0B7F'              	JZ	KC_B0
  0B75'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B78'   D1                    	POP	D
  0B79'   DA 0B80'              	JC	KC_BOF
  0B7C'   C3 0B39'              	JMP	KC_ED
  0B7F'                         KC_B0:
  0B7F'   D1                    	POP	D
  0B80'                         KC_BOF:
  0B80'   2A 0000*              	LHLD	JKN		; moved = LFs found
  0B83'   CD 0000*              	CALL	SUBHD
  0B86'                         KC_MV:
  0B86'   E5                    	PUSH	H
  0B87'   2A 0000*              	LHLD	JKCNT
  0B8A'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B8D'   D1                    	POP	D		; DE = moved
  0B8E'   2A 0000*              	LHLD	JKN
  0B91'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B94'   DA 0B98'              	JC	KC_AD
  0B97'   EB                    	XCHG			; DE = N
  0B98'                         KC_AD:
  0B98'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B9B'   CD 0000*              	CALL	SUBHD
  0B9E'   22 0000*              	SHLD	LNDLT
  0BA1'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0BA2'                         KC_QK:
  0BA2'   22 0000*              	SHLD	JKN		; N = the count
  0BA5'   2A 0000*              	LHLD	TXTBEG
  0BA8'   EB                    	XCHG
  0BA9'   2A 0000*              	LHLD	GAPBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BAC'   E5                    	PUSH	H
  0BAD'   CD 0000*              	CALL	SUBHD
  0BB0'   44                    	MOV	B,H
  0BB1'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0BB2'   E1                    	POP	H
  0BB3'   3A 0000*              	LDA	JKN
  0BB6'   3C                    	INR	A
  0BB7'   5F                    	MOV	E,A		; E = LFs to find
  0BB8'   16 0A                 	MVI	D,LF
  0BBA'   04                    	INR	B
  0BBB'   0C                    	INR	C
  0BBC'                         KQ_LP:
  0BBC'   0D                    	DCR	C
  0BBD'   C2 0BC4'              	JNZ	KQ_CH
  0BC0'   05                    	DCR	B
  0BC1'   CA 0BE4'              	JZ	KQ_TB
  0BC4'                         KQ_CH:
  0BC4'   2B                    	DCX	H
  0BC5'   7E                    	MOV	A,M
  0BC6'   BA                    	CMP	D
  0BC7'   C2 0BBC'              	JNZ	KQ_LP
  0BCA'   1D                    	DCR	E
  0BCB'   C2 0BBC'              	JNZ	KQ_LP
  0BCE'   23                    	INX	H
  0BCF'                         KQ_GO:
  0BCF'   CD 0000*              	CALL	PUTCUR
  0BD2'   21 0000               	LXI	H,0
  0BD5'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BD8'   3E FF                 	MVI	A,0FFH
  0BDA'   32 0000*              	STA	DIRFLG
  0BDD'   2A 0000*              	LHLD	JKCNT
  0BE0'   EB                    	XCHG			; DE = the lines moved
  0BE1'   C3 0B98'              	JMP	KC_AD
  0BE4'                         KQ_TB:
  0BE4'   1D                    	DCR	E
  0BE5'   C2 0B2F'              	JNZ	KC_SL
  0BE8'   2A 0000*              	LHLD	OUTPOS
  0BEB'   7C                    	MOV	A,H
  0BEC'   B5                    	ORA	L
  0BED'   C2 0B2F'              	JNZ	KC_SL
  0BF0'   2A 0000*              	LHLD	TXTBEG
  0BF3'   C3 0BCF'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BF6'                         ATEOF:
  0BF6'   CD 0000*              	CALL	RGET0
  0BF9'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0BFC'                         LASTLN:
  0BFC'   2A 0000*              	LHLD	GAPBEG
  0BFF'   EB                    	XCHG
  0C00'   2A 0000*              	LHLD	TXTBEG
  0C03'   CD 0000*              	CALL	CMP16
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C06'   21 0000               	LXI	H,0
  0C09'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0C0C'   1B                    	DCX	D
  0C0D'   1A                    	LDAX	D
  0C0E'   FE 0A                 	CPI	LF
  0C10'   C2 0000*              	JNZ	SETBWD
  0C13'   23                    	INX	H
  0C14'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0C17'                         JKLAND:
  0C17'   21 0000               	LXI	H,0
  0C1A'   22 0000*              	SHLD	JKVC		; screen column
  0C1D'   2B                    	DCX	H
  0C1E'   22 0000*              	SHLD	JKLS		; last content char: none yet
  0C21'   CD 0000*              	CALL	RGET0
  0C24'   11 0000               	LXI	D,0		; DE = chars read
  0C27'                         JL_RD:
  0C27'   CD 0000*              	CALL	RDGET
  0C2A'   DA 0C64'              	JC	JL_END
  0C2D'   FE 0A                 	CPI	LF
  0C2F'   CA 0C64'              	JZ	JL_END
  0C32'   E5                    	PUSH	H
  0C33'   C5                    	PUSH	B
  0C34'   2A 0000*              	LHLD	JKVC
  0C37'   CD 0680'              	CALL	CWID
  0C3A'   B7                    	ORA	A
  0C3B'   CA 0C5E'              	JZ	JL_NX		; a CR
  0C3E'   EB                    	XCHG
  0C3F'   22 0000*              	SHLD	JKLS		; the last content char so far
  0C42'   EB                    	XCHG
  0C43'   4F                    	MOV	C,A
  0C44'   06 00                 	MVI	B,0
  0C46'   09                    	DAD	B		; HL = the column after this char
  0C47'   22 0000*              	SHLD	JKVC
  0C4A'   D5                    	PUSH	D
  0C4B'   EB                    	XCHG
  0C4C'   2A 3230'              	LHLD	GOALCOL
  0C4F'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C52'   D1                    	POP	D
  0C53'   DA 0C5E'              	JC	JL_NX
  0C56'   CA 0C5E'              	JZ	JL_NX
  0C59'   C1                    	POP	B		; this char holds the goal column
  0C5A'   E1                    	POP	H
  0C5B'   C3 0C6F'              	JMP	JL_GO
  0C5E'                         JL_NX:
  0C5E'   C1                    	POP	B
  0C5F'   E1                    	POP	H
  0C60'   13                    	INX	D
  0C61'   C3 0C27'              	JMP	JL_RD
  0C64'                         JL_END:
  0C64'   2A 0000*              	LHLD	JKLS		; past the line's end: its last content char
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C67'   7C                    	MOV	A,H
  0C68'   A5                    	ANA	L
  0C69'   3C                    	INR	A
  0C6A'   C2 0C6E'              	JNZ	JL_LS
  0C6D'   23                    	INX	H		; no content: the line's start
  0C6E'                         JL_LS:
  0C6E'   EB                    	XCHG
  0C6F'                         JL_GO:
  0C6F'   D5                    	PUSH	D		; DE = step from the line start
  0C70'   CD 0000*              	CALL	CUROFF
  0C73'   D1                    	POP	D
  0C74'   19                    	DAD	D
  0C75'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C78'   AF                    VC_W:	XRA	A
  0C79'   32 0000*              	STA	WBIG
  0C7C'   C3 0C84'              	JMP	WDO
  0C7F'   3E 01                 VCBGW:	MVI	A,1
  0C81'   32 0000*              	STA	WBIG
  0C84'   CD 086D'              WDO:	CALL	SETMOV
  0C87'   AF                    	XRA	A
  0C88'   32 0000*              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C8B'   CD 0798'              	CALL	GETCNT
  0C8E'   22 0000*              	SHLD	CNTV
  0C91'   2A 0000*              WDO_LP: LHLD	CNTV
  0C94'   7C                    	MOV	A,H
  0C95'   B5                    	ORA	L
  0C96'   CA 0CA3'              	JZ	WDO_DN
  0C99'   2B                    	DCX	H
  0C9A'   22 0000*              	SHLD	CNTV
  0C9D'   CD 0D00'              	CALL	FWD1
  0CA0'   D2 0C91'              	JNC	WDO_LP
  0CA3'                         WDO_DN:
  0CA3'   CD 0BF6'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0CA6'   DA 0CB3'              	JC	WDO_NL
  0CA9'   FE 0D                 	CPI	CR
  0CAB'   CA 0CB3'              	JZ	WDO_NL
  0CAE'   FE 0A                 	CPI	LF
  0CB0'   C2 062C'              	JNZ	SETGL
  0CB3'                         WDO_NL:
  0CB3'   CD 0000*              	CALL	PEEKL
  0CB6'   DA 062C'              	JC	SETGL
  0CB9'   FE 0A                 	CPI	LF
  0CBB'   CA 062C'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CBE'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0CC0'   32 0000*              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0CC3'   CD 0E1F'              	CALL	DECC		; back onto its last char
  0CC6'   C3 062C'              	JMP	SETGL
                                
  0CC9'   AF                    VC_B:	XRA	A
  0CCA'   32 0000*              	STA	WBIG
  0CCD'   C3 0CD5'              	JMP	BDO
  0CD0'   3E 01                 VCBGB:	MVI	A,1
  0CD2'   32 0000*              	STA	WBIG
  0CD5'   CD 086D'              BDO:	CALL	SETMOV
  0CD8'   CD 0798'              	CALL	GETCNT
  0CDB'   22 0000*              	SHLD	CNTV
  0CDE'   CD 0D70'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CE1'   D2 0CF1'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CE4'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CE5'   32 0000*              	STA	PSAVE		;   first char opened an insert).  A count that
  0CE8'   C3 062C'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CEB'                         BDO_LP:				;   its operator stands -- both as vim
  0CEB'   CD 0D70'              	CALL	BCK1
  0CEE'   DA 062C'              	JC	SETGL
  0CF1'   2A 0000*              BDO_NX: LHLD	CNTV
  0CF4'   2B                    	DCX	H
  0CF5'   22 0000*              	SHLD	CNTV
  0CF8'   7C                    	MOV	A,H
  0CF9'   B5                    	ORA	L
  0CFA'   C2 0CEB'              	JNZ	BDO_LP
  0CFD'   C3 062C'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0D00'                         FWD1:
  0D00'   CD 0DA3'              	CALL	CCLS
  0D03'   32 0000*              	STA	WKCLS		; the starting class
  0D06'   CD 0DDD'              	CALL	INCC
  0D09'   B7                    	ORA	A
  0D0A'   CA 0D23'              	JZ	FW_WD
  0D0D'   37                    	STC
  0D0E'   F8                    	RM			; -1: already at the end
  0D0F'   CD 0D5B'              	CALL	WLAST
  0D12'   C8                    	RZ
  0D13'   FE 02                 	CPI	2
  0D15'   C2 0D23'              	JNZ	FW_WD		; 1: a next line was reached
  0D18'   CD 0BF6'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0D1B'   D4 0DC4'              	CNC	NXLN
  0D1E'   D2 0D23'              	JNC	FW_WD
  0D21'   37                    	STC			; yes: failed
  0D22'   C9                    	RET
  0D23'                         FW_WD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D23'   3A 0000*              	LDA	WKCLS		; go past the rest of this word
  0D26'   B7                    	ORA	A
  0D27'   CA 0D43'              	JZ	FW_WS
  0D2A'                         FW_WLP:
  0D2A'   CD 0DA3'              	CALL	CCLS
  0D2D'   21 0000*              	LXI	H,WKCLS
  0D30'   BE                    	CMP	M
  0D31'   C2 0D43'              	JNZ	FW_WS
  0D34'   CD 0DDD'              	CALL	INCC
  0D37'   B7                    	ORA	A
  0D38'   F8                    	RM			; the end of the file (NC)
  0D39'   CA 0D2A'              	JZ	FW_WLP
  0D3C'   CD 0D5B'              	CALL	WLAST
  0D3F'   C8                    	RZ
  0D40'   C3 0D2A'              	JMP	FW_WLP
  0D43'                         FW_WS:
  0D43'   CD 0DA3'              	CALL	CCLS		; then over blanks to the next word
  0D46'   B7                    	ORA	A
  0D47'   C0                    	RNZ
  0D48'   CD 0DAB'              	CALL	EMPTY
  0D4B'   C8                    	RZ			; an empty line is a word
  0D4C'   CD 0DDD'              	CALL	INCC
  0D4F'   B7                    	ORA	A
  0D50'   F8                    	RM
  0D51'   CA 0D43'              	JZ	FW_WS
  0D54'   CD 0D5B'              	CALL	WLAST
  0D57'   C8                    	RZ
  0D58'   C3 0D43'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D5B'                         WLAST:
  0D5B'   47                    	MOV	B,A
  0D5C'   2A 0000*              	LHLD	CNTV
  0D5F'   7C                    	MOV	A,H
  0D60'   B5                    	ORA	L
  0D61'   C2 0D6C'              	JNZ	WL_X		; words still owed
  0D64'   3A 0000*              	LDA	PSAVE
  0D67'   B7                    	ORA	A
  0D68'   CA 0D6E'              	JZ	WL_NO		; a plain 'w'
  0D6B'   AF                    	XRA	A
  0D6C'   78                    WL_X:	MOV	A,B
  0D6D'   C9                    	RET
  0D6E'   B0                    WL_NO:	ORA	B
  0D6F'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D70'                         BCK1:
  0D70'   CD 0E1F'              	CALL	DECC
  0D73'   B7                    	ORA	A
  0D74'   37                    	STC
  0D75'   F8                    	RM
  0D76'                         BK_WS:
  0D76'   CD 0DA3'              	CALL	CCLS		; back over blanks
  0D79'   B7                    	ORA	A
  0D7A'   C2 0D8A'              	JNZ	BK_WD
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D7D'   CD 0DAB'              	CALL	EMPTY
  0D80'   C8                    	RZ			; an empty line is a word
  0D81'   CD 0E1F'              	CALL	DECC
  0D84'   B7                    	ORA	A
  0D85'   F2 0D76'              	JP	BK_WS
  0D88'   AF                    	XRA	A		; the start of the file (NC)
  0D89'   C9                    	RET
  0D8A'                         BK_WD:
  0D8A'   32 0000*              	STA	WKCLS		; back to the start of this word
  0D8D'                         BK_WLP:
  0D8D'   CD 0E1F'              	CALL	DECC
  0D90'   B7                    	ORA	A
  0D91'   FA 0DA1'              	JM	BK_OK		; the start of the file
  0D94'   CD 0DA3'              	CALL	CCLS
  0D97'   21 0000*              	LXI	H,WKCLS
  0D9A'   BE                    	CMP	M
  0D9B'   CA 0D8D'              	JZ	BK_WLP
  0D9E'   CD 0DDD'              	CALL	INCC		; overshot: forward one
  0DA1'                         BK_OK:
  0DA1'   AF                    	XRA	A
  0DA2'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0DA3'                         CCLS:
  0DA3'   CD 0BF6'              	CALL	ATEOF
  0DA6'   D2 0822'              	JNC	CLASSF
  0DA9'   AF                    	XRA	A
  0DAA'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0DAB'                         EMPTY:
  0DAB'   CD 0BF6'              	CALL	ATEOF
  0DAE'   DA 0DB9'              	JC	EM_ST
  0DB1'   FE 0D                 	CPI	CR
  0DB3'   CA 0DB9'              	JZ	EM_ST
  0DB6'   FE 0A                 	CPI	LF
  0DB8'   C0                    	RNZ
  0DB9'                         EM_ST:
  0DB9'   CD 0000*              	CALL	PEEKL
  0DBC'   DA 0DC2'              	JC	EM_Y
  0DBF'   FE 0A                 	CPI	LF
  0DC1'   C9                    	RET
  0DC2'                         EM_Y:
  0DC2'   AF                    	XRA	A
  0DC3'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0DC4'                         NXLN:
  0DC4'   FE 0A                 	CPI	LF
  0DC6'   CA 0DD5'              	JZ	NX_LF
  0DC9'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DCC'   D8                    	RC
  0DCD'   FE 0A                 	CPI	LF
  0DCF'   CA 0DD5'              	JZ	NX_LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD2'   2B                    	DCX	H		; a lone CR
  0DD3'   AF                    	XRA	A
  0DD4'   C9                    	RET
  0DD5'                         NX_LF:
  0DD5'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DD8'   D8                    	RC
  0DD9'   2B                    	DCX	H
  0DDA'   3E 01                 	MVI	A,1
  0DDC'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DDD'                         INCC:
  0DDD'   CD 0BF6'              	CALL	ATEOF
  0DE0'   DA 0E1B'              	JC	IC_END
  0DE3'   FE 0D                 	CPI	CR
  0DE5'   CA 0E06'              	JZ	IC_NL
  0DE8'   FE 0A                 	CPI	LF
  0DEA'   CA 0E06'              	JZ	IC_NL
  0DED'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DF0'                         IC_CH:
  0DF0'   CD 0BF6'              	CALL	ATEOF
  0DF3'   DA 0E02'              	JC	IC_2
  0DF6'   FE 0D                 	CPI	CR
  0DF8'   CA 0E02'              	JZ	IC_2
  0DFB'   FE 0A                 	CPI	LF
  0DFD'   CA 0E02'              	JZ	IC_2
  0E00'   AF                    	XRA	A
  0E01'   C9                    	RET
  0E02'                         IC_2:
  0E02'   3E 02                 	MVI	A,2
  0E04'   B7                    	ORA	A
  0E05'   C9                    	RET
  0E06'                         IC_NL:
  0E06'   CD 0DC4'              	CALL	NXLN
  0E09'   DA 0E1B'              	JC	IC_END
  0E0C'   F5                    	PUSH	PSW
  0E0D'   CD 0000*              	CALL	PUTCUR
  0E10'   F1                    	POP	PSW
  0E11'   B7                    	ORA	A
  0E12'   CA 0DF0'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0E15'   CD 0E41'              	CALL	LNINC
  0E18'   3E 01                 	MVI	A,1
  0E1A'   C9                    	RET
  0E1B'                         IC_END:
  0E1B'   3E FF                 	MVI	A,0FFH
  0E1D'   B7                    	ORA	A
  0E1E'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0E1F'                         DECC:
  0E1F'   CD 0000*              	CALL	PEEKL
  0E22'   DA 0E1B'              	JC	IC_END
  0E25'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E26'   CD 0000*              	CALL	PUTCUR
  0E29'   F1                    	POP	PSW
  0E2A'   FE 0A                 	CPI	LF
  0E2C'   3E 00                 	MVI	A,0
  0E2E'   C0                    	RNZ
  0E2F'   CD 0E4F'              	CALL	LNDEC
  0E32'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E35'   DA 0E3D'              	JC	DC_1
  0E38'   FE 0D                 	CPI	CR
  0E3A'   CC 0000*              	CZ	PUTCUR
  0E3D'                         DC_1:
  0E3D'   3E 01                 	MVI	A,1
  0E3F'   B7                    	ORA	A
  0E40'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E41'                         LNINC:
  0E41'   E5                    	PUSH	H
  0E42'   2A 0000*              	LHLD	LNDLT
  0E45'   7C                    	MOV	A,H
  0E46'   FE 40                 	CPI	40H
  0E48'   CA 0E5D'              	JZ	LN_X
  0E4B'   23                    	INX	H
  0E4C'   C3 0E5A'              	JMP	LN_ST
  0E4F'                         LNDEC:
  0E4F'   E5                    	PUSH	H
  0E50'   2A 0000*              	LHLD	LNDLT
  0E53'   7C                    	MOV	A,H
  0E54'   FE C0                 	CPI	0C0H
  0E56'   CA 0E5D'              	JZ	LN_X
  0E59'   2B                    	DCX	H
  0E5A'                         LN_ST:
  0E5A'   22 0000*              	SHLD	LNDLT
  0E5D'                         LN_X:
  0E5D'   E1                    	POP	H
  0E5E'   C9                    	RET
                                
  0E5F'   AF                    VC_E:	XRA	A
  0E60'   32 0000*              	STA	WBIG
  0E63'   C3 0E6B'              	JMP	EDO
  0E66'   3E 01                 VCBGE:	MVI	A,1
  0E68'   32 0000*              	STA	WBIG
  0E6B'   CD 086D'              EDO:	CALL	SETMOV
  0E6E'   CD 0798'              	CALL	GETCNT
  0E71'   22 0000*              	SHLD	CNTV
  0E74'   2A 0000*              EDO_LP: LHLD	CNTV
  0E77'   7C                    	MOV	A,H
  0E78'   B5                    	ORA	L
  0E79'   CA 0CA3'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E7C'   2B                    	DCX	H
  0E7D'   22 0000*              	SHLD	CNTV
  0E80'   CD 0E8E'              	CALL	ESTEP
  0E83'   21 0000*              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E86'   36 00                 	MVI	M,0
  0E88'   D2 0E74'              	JNC	EDO_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E8B'   C3 0CA3'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E8E'                         ESTEP:
  0E8E'   CD 0DA3'              	CALL	CCLS
  0E91'   32 0000*              	STA	WKCLS		; the starting class
  0E94'   CD 0DDD'              	CALL	INCC
  0E97'   B7                    	ORA	A
  0E98'   FA 0EBE'              	JM	ES_F
  0E9B'   CD 0DA3'              	CALL	CCLS
  0E9E'   B7                    	ORA	A
  0E9F'   CA 0EA9'              	JZ	ES_ST
  0EA2'   21 0000*              	LXI	H,WKCLS
  0EA5'   BE                    	CMP	M
  0EA6'   CA 0EC0'              	JZ	ES_SK		; still in the word it started in: on to its end
  0EA9'                         ES_ST:
  0EA9'   3A 0000*              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0EAC'   B7                    	ORA	A		;   that char is the word's end already, and
  0EAD'   C2 0ED7'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0EB0'                         ES_WS:
  0EB0'   CD 0DA3'              	CALL	CCLS		; over blanks, line ends and empty lines
  0EB3'   B7                    	ORA	A
  0EB4'   C2 0EC0'              	JNZ	ES_SK
  0EB7'   CD 0DDD'              	CALL	INCC
  0EBA'   B7                    	ORA	A
  0EBB'   F2 0EB0'              	JP	ES_WS
  0EBE'                         ES_F:
  0EBE'   37                    	STC
  0EBF'   C9                    	RET
  0EC0'                         ES_SK:
  0EC0'   CD 0DA3'              	CALL	CCLS		; past the rest of this word ...
  0EC3'   32 0000*              	STA	WKCLS
  0EC6'                         ES_SL:
  0EC6'   CD 0DDD'              	CALL	INCC
  0EC9'   B7                    	ORA	A
  0ECA'   FA 0EBE'              	JM	ES_F
  0ECD'   CD 0DA3'              	CALL	CCLS
  0ED0'   21 0000*              	LXI	H,WKCLS
  0ED3'   BE                    	CMP	M
  0ED4'   CA 0EC6'              	JZ	ES_SL
  0ED7'   C3 0E1F'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EDA'                         CURRW:
  0EDA'   2A 0000*              	LHLD	WINROW
  0EDD'   EB                    	XCHG
  0EDE'   2A 0000*              	LHLD	LNDLT
  0EE1'   19                    	DAD	D		; HL = row (signed)
  0EE2'   7C                    	MOV	A,H
  0EE3'   B7                    	ORA	A
  0EE4'   FA 0EF7'              	JM	CRW_0		; above the screen -> top row
  0EE7'   C2 0EF2'              	JNZ	CRW_BT		; far below -> bottom row
  0EEA'   3A 0000*              	LDA	NEDIT
  0EED'   3D                    	DCR	A		; A = bottom row
  0EEE'   BD                    	CMP	L		; CY iff bottom < row
  0EEF'   D8                    	RC
  0EF0'   7D                    	MOV	A,L
  0EF1'   C9                    	RET
  0EF2'                         CRW_BT:
  0EF2'   3A 0000*              	LDA	NEDIT
  0EF5'   3D                    	DCR	A
  0EF6'   C9                    	RET
  0EF7'                         CRW_0:
  0EF7'   AF                    	XRA	A
  0EF8'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0EF9'                         SETRWT:
  0EF9'   2A 0000*              	LHLD	LNDLT
  0EFC'   EB                    	XCHG
  0EFD'   6F                    	MOV	L,A
  0EFE'   26 00                 	MVI	H,0
  0F00'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0F03'   22 0000*              	SHLD	WINROW
  0F06'   3E 01                 	MVI	A,PL_SET
  0F08'   32 0000*              	STA	PLACE
  0F0B'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0F0C'                         MVROW:
  0F0C'   47                    	MOV	B,A
  0F0D'   CD 0EDA'              	CALL	CURRW
  0F10'   90                    	SUB	B		; A = row now - target
  0F11'                         MR_GO:
  0F11'   C8                    	RZ
  0F12'   DA 0F1B'              	JC	MR_DN
  0F15'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F16'   26 00                 	MVI	H,0
  0F18'   C3 0B0E'              	JMP	KCORE
  0F1B'                         MR_DN:
  0F1B'   2F                    	CMA
  0F1C'   3C                    	INR	A		; A = target - row now
  0F1D'   6F                    	MOV	L,A
  0F1E'   26 00                 	MVI	H,0
  0F20'   C3 0A2E'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0F23'                         VC_HIGH:
  0F23'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0F26'   2B                    	DCX	H		; row = count - 1
  0F27'   7C                    	MOV	A,H
  0F28'   B7                    	ORA	A
  0F29'   3A 0000*              	LDA	SCBOT
  0F2C'   C2 0F34'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F2F'   BD                    	CMP	L		; CY iff SCBOT < row
  0F30'   DA 0F34'              	JC	VH_GO
  0F33'   7D                    	MOV	A,L
  0F34'                         VH_GO:
  0F34'   CD 0F0C'              	CALL	MVROW
  0F37'   C3 0973'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F3A'                         VC_MIDL:
  0F3A'   CD 0785'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0F3D'   CD 11CC'              	CALL	HTSCR		; HL -> the top line's rows
  0F40'   3A 0000*              	LDA	TXEND
  0F43'   3C                    	INR	A
  0F44'   B7                    	ORA	A
  0F45'   1F                    	RAR
  0F46'   3D                    	DCR	A
  0F47'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F48'   CD 1212'              	CALL	HTFQ
  0F4B'   D2 0F4F'              	JNC	VM_GO
  0F4E'   2B                    	DCX	H
  0F4F'                         VM_GO:
  0F4F'   CD 1207'              	CALL	HTGO
  0F52'   C3 0973'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0F55'                         VC_LOWL:
  0F55'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0F58'   2B                    	DCX	H		; count - 1
  0F59'   3A 0000*              	LDA	SCBOT
  0F5C'   5F                    	MOV	E,A
  0F5D'   16 00                 	MVI	D,0
  0F5F'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F60'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F63'   3E 00                 	MVI	A,0
  0F65'   D2 0F6C'              	JNC	VL_GO		; at or past the top -> row 0
  0F68'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F6B'   7D                    	MOV	A,L
  0F6C'                         VL_GO:
  0F6C'   CD 0F0C'              	CALL	MVROW
  0F6F'   C3 0973'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F72'                         VC_PGDN:
  0F72'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0F75'   22 0000*              	SHLD	RWR
  0F78'   3A 0000*              	LDA	SCEOF
  0F7B'   B7                    	ORA	A
  0F7C'   CA 0F84'              	JZ	VPD_N
  0F7F'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F82'   B7                    	ORA	A		;   top line
  0F83'   C8                    	RZ			; it already is
  0F84'                         VPD_N:
  0F84'   3A 0000*              	LDA	NEDIT
  0F87'   3C                    	INR	A
  0F88'   4F                    	MOV	C,A
  0F89'   3E 02                 	MVI	A,2
  0F8B'   CD 11D3'              	CALL	HTSET		; HL -> the top line's rows
  0F8E'   E5                    	PUSH	H
  0F8F'   C5                    	PUSH	B
  0F90'   3A 0000*              	LDA	NEDIT
  0F93'   4F                    	MOV	C,A
  0F94'   CD 1212'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F97'   3A 0000*              	LDA	NEDIT
  0F9A'   DA 0FA7'              	JC	VPD_R		; there is none: no overlap
  0F9D'   3A 0000*              	LDA	HTN
  0FA0'   90                    	SUB	B
  0FA1'   3C                    	INR	A
  0FA2'   47                    	MOV	B,A		; the lines from it up to the table's first
  0FA3'   AF                    	XRA	A
  0FA4'   CD 1041'              	CALL	OVLAP
  0FA7'                         VPD_R:
  0FA7'   CD 1090'              	CALL	PGROWS		; RWR = the rows to go
  0FAA'   C1                    	POP	B
  0FAB'   E1                    	POP	H
  0FAC'   CD 1253'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0FAF'   DA 0FCB'              	JC	VPD_TP		; the text ended: its last line
  0FB2'   79                    	MOV	A,C
  0FB3'   B7                    	ORA	A
  0FB4'   CA 0FCB'              	JZ	VPD_TP
  0FB7'   3A 0000*              	LDA	RWMV		; part of the way down a line: its start -- unless
  0FBA'   B7                    	ORA	A		;   that is the top line still, then the next
  0FBB'   C2 0FCB'              	JNZ	VPD_TP
  0FBE'   E5                    	PUSH	H
  0FBF'   CD 1201'              	CALL	HTIX
  0FC2'   21 0000*              	LXI	H,HTTP
  0FC5'   BE                    	CMP	M
  0FC6'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FC7'   C2 0FCB'              	JNZ	VPD_TP
  0FCA'   23                    	INX	H
  0FCB'                         VPD_TP:
  0FCB'   54                    	MOV	D,H
  0FCC'   5D                    	MOV	E,L
  0FCD'   C3 113A'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FD0'                         VC_PGUP:
  0FD0'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  0FD3'   22 0000*              	SHLD	RWR
  0FD6'   3A 0000*              	LDA	SCBOF
  0FD9'   B7                    	ORA	A
  0FDA'   C0                    	RNZ
  0FDB'   CD 0EDA'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FDE'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FE0'   0E 01                 	MVI	C,1
  0FE2'   D2 0FE9'              	JNC	VPU_1
  0FE5'   3A 0000*              	LDA	NEDIT
  0FE8'   4F                    	MOV	C,A
  0FE9'                         VPU_1:
  0FE9'   3A 0000*              	LDA	NEDIT
  0FEC'   CD 11D3'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FEF'   E5                    	PUSH	H
  0FF0'   D5                    	PUSH	D
  0FF1'   2B                    	DCX	H		; the line above the top one, and on down
  0FF2'   04                    	INR	B
  0FF3'   3E 01                 	MVI	A,1
  0FF5'   CD 1041'              	CALL	OVLAP
  0FF8'   CD 1090'              	CALL	PGROWS		; RWR = the rows to go
  0FFB'   D1                    	POP	D
  0FFC'   E1                    	POP	H
  0FFD'   43                    	MOV	B,E
  0FFE'   CD 1293'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  1001'   DA 101E'              	JC	VPU_3		;   above it; or the file's first line
  1004'   79                    	MOV	A,C
  1005'   B7                    	ORA	A
  1006'   CA 101E'              	JZ	VPU_3
  1009'   3A 0000*              	LDA	RWMV
  100C'   B7                    	ORA	A
  100D'   C2 101D'              	JNZ	VPU_2
  1010'   E5                    	PUSH	H
  1011'   CD 1201'              	CALL	HTIX
  1014'   3C                    	INR	A
  1015'   21 0000*              	LXI	H,HTTP
  1018'   BE                    	CMP	M
  1019'   E1                    	POP	H
  101A'   CA 101E'              	JZ	VPU_3		; the first line back: all of it
  101D'                         VPU_2:
  101D'   23                    	INX	H
  101E'                         VPU_3:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  101E'   CD 1207'              	CALL	HTGO		; the cursor on the new top line ...
  1021'   3A 0000*              	LDA	NEDIT
  1024'   4F                    	MOV	C,A
  1025'   06 00                 	MVI	B,0
  1027'   CD 11E8'              	CALL	HTRB		; ... and the lines under it measured
  102A'   E5                    	PUSH	H
  102B'   3A 0000*              	LDA	NEDIT
  102E'   4F                    	MOV	C,A
  102F'   CD 1212'              	CALL	HTFQ		; HL -> the first the screen has not room for
  1032'   2B                    	DCX	H
  1033'   D1                    	POP	D		; DE -> the top line's rows
  1034'   EB                    	XCHG
  1035'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  1038'   D2 103D'              	JNC	VPU_4		;   fills the screen)
  103B'   54                    	MOV	D,H
  103C'   5D                    	MOV	E,L
  103D'                         VPU_4:
  103D'   EB                    	XCHG
  103E'   C3 113A'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  1041'                         OVLAP:
  1041'   32 0000*              	STA	OVDIR
  1044'   3A 0000*              	LDA	NEDIT
  1047'   D6 02                 	SUI	2
  1049'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  104A'   56                    	MOV	D,M		; D = h1
  104B'   CD 1082'              	CALL	OV_NX
  104E'   DA 107E'              	JC	OV_0
  1051'   5E                    	MOV	E,M		; E = h2
  1052'   7A                    	MOV	A,D
  1053'   83                    	ADD	E
  1054'   57                    	MOV	D,A		; D = h1 + h2
  1055'   79                    	MOV	A,C
  1056'   BA                    	CMP	D
  1057'   DA 107E'              	JC	OV_0
  105A'   CD 1082'              	CALL	OV_NX
  105D'   DA 107E'              	JC	OV_0
  1060'   7B                    	MOV	A,E
  1061'   86                    	ADD	M
  1062'   5F                    	MOV	E,A		; E = h2 + h3
  1063'   79                    	MOV	A,C
  1064'   BB                    	CMP	E
  1065'   DA 107E'              	JC	OV_0
  1068'   7A                    	MOV	A,D
  1069'   86                    	ADD	M
  106A'   57                    	MOV	D,A		; D = h1 + h2 + h3
  106B'   CD 1082'              	CALL	OV_NX
  106E'   DA 107B'              	JC	OV_1
  1071'   7B                    	MOV	A,E
  1072'   86                    	ADD	M		; h2 + h3 + h4
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1073'   5F                    	MOV	E,A
  1074'   79                    	MOV	A,C
  1075'   BB                    	CMP	E
