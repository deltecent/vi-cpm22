  0595'   E1                    	POP	H
  0596'   83                    	ADD	E
  0597'   5F                    	MOV	E,A
  0598'   D2 0588'              	JNC	SG_LP
  059B'   14                    	INR	D
  059C'   C3 0588'              	JMP	SG_LP
  059F'                         SG_CUR:
  059F'   2A 0000*              	LHLD	TXTEND
  05A2'   D5                    	PUSH	D
  05A3'   EB                    	XCHG
  05A4'   2A 0000*              	LHLD	GAPEND
  05A7'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05AA'   D1                    	POP	D
  05AB'   CA 05BF'              	JZ	SG_SET
  05AE'   7E                    	MOV	A,M
  05AF'   FE 09                 	CPI	TAB
  05B1'   C2 05BF'              	JNZ	SG_SET
  05B4'   6B                    	MOV	L,E
  05B5'   CD 05C4'              	CALL	CWID
  05B8'   3D                    	DCR	A		; the TAB's last column
  05B9'   83                    	ADD	E
  05BA'   5F                    	MOV	E,A
  05BB'   D2 05BF'              	JNC	SG_SET
  05BE'   14                    	INR	D
  05BF'                         SG_SET:
  05BF'   EB                    	XCHG
  05C0'   22 2906'              	SHLD	GOALCOL
  05C3'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05C4'                         CWID:
  05C4'   FE 0D                 	CPI	CR
  05C6'   CA 05D5'              	JZ	CW_0
  05C9'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05CB'   3E 01                 	MVI	A,1
  05CD'   C0                    	RNZ
  05CE'   7D                    	MOV	A,L
  05CF'   E6 07                 	ANI	TABWID-1
  05D1'   2F                    	CMA
  05D2'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05D4'   C9                    	RET
  05D5'                         CW_0:
  05D5'   AF                    	XRA	A
  05D6'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05D7'                         BOL:
  05D7'                         BOL_LP:
  05D7'   7C                    	MOV	A,H
  05D8'   B5                    	ORA	L
  05D9'   C8                    	RZ			; at 0
  05DA'   2B                    	DCX	H		; look at off-1
  05DB'   E5                    	PUSH	H
  05DC'   CD 0000*              	CALL	CHARAT
  05DF'   E1                    	POP	H		; HL = off-1
  05E0'   FE 0A                 	CPI	LF
  05E2'   CA 05E8'              	JZ	BOL_DN
  05E5'   C3 05D7'              	JMP	BOL_LP
  05E8'                         BOL_DN:
  05E8'   23                    	INX	H		; line starts just after the LF
  05E9'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05EA'                         EOLNL:
  05EA'   E5                    	PUSH	H
  05EB'   CD 0000*              	CALL	LOGLEN
  05EE'   22 2946'              	SHLD	WKN
  05F1'   E1                    	POP	H
  05F2'                         ENL_LP:
  05F2'   EB                    	XCHG			; DE = i
  05F3'   2A 2946'              	LHLD	WKN
  05F6'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  05F9'   EB                    	XCHG			; HL = i, DE = n
  05FA'   D0                    	RNC			; i >= n: no LF on this line
  05FB'   E5                    	PUSH	H
  05FC'   CD 0000*              	CALL	CHARAT
  05FF'   E1                    	POP	H
  0600'   FE 0A                 	CPI	LF
  0602'   C8                    	RZ			; the LF: HL is its offset
  0603'   23                    	INX	H
  0604'   C3 05F2'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0607'                         NLSTART:
  0607'   CD 05EA'              	CALL	EOLNL
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060A'   E5                    	PUSH	H
  060B'   CD 0000*              	CALL	LOGLEN
  060E'   D1                    	POP	D		; DE = eol result
  060F'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0612'   C8                    	RZ			; no next line: HL = LOGLEN
  0613'   EB                    	XCHG			; HL = eol
  0614'   23                    	INX	H
  0615'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0616'                         EOLC:
  0616'   E5                    	PUSH	H
  0617'   CD 05EA'              	CALL	EOLNL
  061A'   22 2948'              	SHLD	WKTERM
  061D'   E1                    	POP	H
  061E'   CD 05D7'              	CALL	BOL
  0621'   22 294A'              	SHLD	WKBOL
  0624'   2A 2948'              	LHLD	WKTERM
  0627'   EB                    	XCHG			; DE = term
  0628'   2A 294A'              	LHLD	WKBOL
  062B'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  062E'   CA 064D'              	JZ	EOLC_MT
  0631'   EB                    	XCHG			; HL = term
  0632'   2B                    	DCX	H		; term-1
  0633'   E5                    	PUSH	H
  0634'   CD 0000*              	CALL	CHARAT
  0637'   E1                    	POP	H		; HL = term-1
  0638'   FE 0D                 	CPI	CR
  063A'   CA 0640'              	JZ	EOLC_CR		; content ends at term-1
  063D'   C3 0641'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0640'                         EOLC_CR:
  0640'   2B                    	DCX	H		; last = (term-1) - 1
  0641'                         EOLC_LS:
  0641'   EB                    	XCHG			; DE = last
  0642'   2A 294A'              	LHLD	WKBOL
  0645'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0648'   DA 064D'              	JC	EOLC_MT
  064B'   EB                    	XCHG			; HL = last
  064C'   C9                    	RET
  064D'                         EOLC_MT:
  064D'   2A 294A'              	LHLD	WKBOL
  0650'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0651'                         COL:
  0651'   E5                    	PUSH	H
  0652'   CD 05D7'              	CALL	BOL
  0655'   D1                    	POP	D		; DE = off
  0656'   EB                    	XCHG			; HL = off, DE = bol
  0657'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  065A'                         ATENDQ:
  065A'   CD 0000*              	CALL	CUROFF
  065D'   E5                    	PUSH	H
  065E'   CD 0000*              	CALL	LOGLEN
  0661'   D1                    	POP	D		; DE = cur
  0662'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0665'                         CURCHR:
  0665'   CD 0000*              	CALL	CUROFF
  0668'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  066B'                         MOVCNT:
  066B'   CD 06EB'              	CALL	SETMOV
  066E'   C3 067E'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0671'                         CNTOFF:
  0671'   CD 067E'              	CALL	GETCNT
  0674'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0677'                         GBSUB:
  0677'   EB                    	XCHG
  0678'   2A 0000*              	LHLD	GAPBEG
  067B'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  067E'                         GETCNT:
  067E'   2A 28FE'              	LHLD	CMDCNT
  0681'   7C                    	MOV	A,H
  0682'   B5                    	ORA	L
  0683'   C2 068A'              	JNZ	GC_HAVE
  0686'   21 0001               	LXI	H,1
  0689'   C9                    	RET
  068A'                         GC_HAVE:
  068A'   E5                    	PUSH	H
  068B'   21 0000               	LXI	H,0
  068E'   22 28FE'              	SHLD	CMDCNT
  0691'   E1                    	POP	H
  0692'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0693'                         CNTTST:				; WM 1175
  0693'   E5                    	PUSH	H
  0694'   2A 28FE'              	LHLD	CMDCNT
  0697'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  069A'   B4                    	ORA	H
  069B'   B5                    	ORA	L
  069C'   E1                    	POP	H
  069D'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  06A0'                         CLASSF:
  06A0'   47                    	MOV	B,A
  06A1'   FE 20                 	CPI	' '
  06A3'   CA 06E3'              	JZ	CLS0
  06A6'   FE 09                 	CPI	TAB
  06A8'   CA 06E3'              	JZ	CLS0
  06AB'   FE 0A                 	CPI	LF
  06AD'   CA 06E3'              	JZ	CLS0
  06B0'   FE 0D                 	CPI	CR
  06B2'   CA 06E3'              	JZ	CLS0
  06B5'   3A 2908'              	LDA	WBIG
  06B8'   B7                    	ORA	A
  06B9'   C2 06E5'              	JNZ	CLS1
  06BC'   78                    	MOV	A,B
  06BD'   FE 5F                 	CPI	'_'
  06BF'   CA 06E5'              	JZ	CLS1
  06C2'   FE 30                 	CPI	'0'
  06C4'   DA 06E8'              	JC	CLS2
  06C7'   FE 3A                 	CPI	'9'+1
  06C9'   DA 06E5'              	JC	CLS1
  06CC'   FE 41                 	CPI	'A'
  06CE'   DA 06E8'              	JC	CLS2
  06D1'   FE 5B                 	CPI	'Z'+1
  06D3'   DA 06E5'              	JC	CLS1
  06D6'   FE 61                 	CPI	'a'
  06D8'   DA 06E8'              	JC	CLS2
  06DB'   FE 7B                 	CPI	'z'+1
  06DD'   DA 06E5'              	JC	CLS1
  06E0'   C3 06E8'              	JMP	CLS2
  06E3'   AF                    CLS0:	XRA	A
  06E4'   C9                    	RET
  06E5'   3E 01                 CLS1:	MVI	A,1
  06E7'   C9                    	RET
  06E8'   3E 02                 CLS2:	MVI	A,2
  06EA'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  06EB'                         SETMOV:
  06EB'   3E 01                 	MVI	A,R_MOVE
  06ED'   32 2902'              	STA	RINTENT
  06F0'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06F1'                         SETLIN:
  06F1'   3E 02                 	MVI	A,R_LINE
  06F3'   32 2902'              	STA	RINTENT
  06F6'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  06F7'                         SETILN:
  06F7'   3E 01                 	MVI	A,1
  06F9'   32 2903'              	STA	ILN		; one line, unless a put overwrites it below
  06FC'   3E 05                 	MVI	A,R_ILIN
  06FE'   32 2902'              	STA	RINTENT
  0701'   AF                    	XRA	A
  0702'   32 2905'              	STA	ILABOV		; the row above the opened ones is untouched
  0705'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0706'                         SETJON:
  0706'   3E 06                 	MVI	A,R_JOIN
  0708'   32 2902'              	STA	RINTENT
  070B'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  070C'                         SETFUL:
  070C'   3E 00                 	MVI	A,R_FULL
  070E'   32 2902'              	STA	RINTENT
  0711'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0712'                         TAILTAB:
  0712'   CD 0000*              	CALL	CUROFF
  0715'   22 2942'              	SHLD	TTI
  0718'                         TT_LP:
  0718'   2A 2942'              	LHLD	TTI
  071B'   EB                    	XCHG			; DE = TTI
  071C'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  071F'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0722'   D2 0742'              	JNC	TT_NO		; reached end of text -> no tab
  0725'   2A 2942'              	LHLD	TTI
  0728'   CD 0000*              	CALL	CHARAT
  072B'   FE 0A                 	CPI	LF
  072D'   CA 0742'              	JZ	TT_NO		; end of line -> no tab
  0730'   FE 09                 	CPI	TAB
  0732'   CA 073F'              	JZ	TT_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0735'   2A 2942'              	LHLD	TTI
  0738'   23                    	INX	H
  0739'   22 2942'              	SHLD	TTI
  073C'   C3 0718'              	JMP	TT_LP
  073F'                         TT_YES:
  073F'   3E 01                 	MVI	A,1
  0741'   C9                    	RET
  0742'                         TT_NO:
  0742'   AF                    	XRA	A
  0743'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0744'                         VC_H:
  0744'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0747'   22 2940'              	SHLD	CNTV
  074A'                         VCH_LP:
  074A'   2A 2940'              	LHLD	CNTV
  074D'   7C                    	MOV	A,H
  074E'   B5                    	ORA	L
  074F'   C8                    	RZ
  0750'   2B                    	DCX	H
  0751'   22 2940'              	SHLD	CNTV
  0754'   CD 075A'              	CALL	HSTEP
  0757'   C3 074A'              	JMP	VCH_LP
  075A'                         HSTEP:
  075A'   CD 0000*              	CALL	CUROFF		; HL = cur
  075D'   7C                    	MOV	A,H
  075E'   B5                    	ORA	L
  075F'   C8                    	RZ			; at 0
  0760'   E5                    	PUSH	H
  0761'   CD 05D7'              	CALL	BOL		; HL = bol
  0764'   D1                    	POP	D		; DE = cur
  0765'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  0768'   C8                    	RZ			; at BOL, cannot go left
  0769'   EB                    	XCHG			; HL = cur
  076A'   2B                    	DCX	H
  076B'   C3 056D'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  076E'                         VC_L:
  076E'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0771'   22 2940'              	SHLD	CNTV
  0774'                         VCL_LP:
  0774'   2A 2940'              	LHLD	CNTV
  0777'   7C                    	MOV	A,H
  0778'   B5                    	ORA	L
  0779'   C8                    	RZ
  077A'   2B                    	DCX	H
  077B'   22 2940'              	SHLD	CNTV
  077E'   CD 0784'              	CALL	LSTEP
  0781'   C3 0774'              	JMP	VCL_LP
  0784'                         LSTEP:
  0784'   CD 0000*              	CALL	CUROFF		; HL = cur
  0787'   E5                    	PUSH	H
  0788'   CD 0616'              	CALL	EOLC		; HL = eolc
  078B'   D1                    	POP	D		; DE = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  078C'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  078F'   D0                    	RNC			; cur >= eolc, cannot go right
  0790'   EB                    	XCHG			; HL = cur
  0791'   23                    	INX	H
  0792'   C3 056D'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0795'                         VC_0:
  0795'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  0798'   CD 07A2'              	CALL	LNSTRT
  079B'   21 0000               	LXI	H,0
  079E'   22 2906'              	SHLD	GOALCOL
  07A1'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  07A2'                         LNSTRT:
  07A2'   CD 0EB9'              	CALL	ZSAVE
  07A5'   21 0000               	LXI	H,0
  07A8'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  07AB'   E5                    	PUSH	H
  07AC'   CD 0ECC'              	CALL	ZREST
  07AF'   E1                    	POP	H
  07B0'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  07B3'                         VC_CRT:
  07B3'   CD 066B'              	CALL	MOVCNT		; a cursor motion, and its count
  07B6'   C3 07B9'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  07B9'                         FNBLNK:
  07B9'   CD 07A2'              	CALL	LNSTRT
  07BC'   CD 0000*              	CALL	RGET0
  07BF'   11 0000               	LXI	D,0		; DE = blanks skipped
  07C2'                         FN_LP:
  07C2'   CD 0000*              	CALL	RDGET
  07C5'   DA 07E8'              	JC	FN_GO		; the end of the file
  07C8'   FE 20                 	CPI	' '
  07CA'   CA 07D2'              	JZ	FN_WH
  07CD'   FE 09                 	CPI	TAB
  07CF'   C2 07E8'              	JNZ	FN_GO		; a non-blank, or the line's end
  07D2'                         FN_WH:
  07D2'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  07D5'   DA 07E8'              	JC	FN_GO
  07D8'   FE 0D                 	CPI	CR
  07DA'   CA 07E8'              	JZ	FN_GO
  07DD'   FE 0A                 	CPI	LF
  07DF'   CA 07E8'              	JZ	FN_GO
  07E2'   2B                    	DCX	H		; not yet: read that char again
  07E3'   03                    	INX	B
  07E4'   13                    	INX	D
