  0774'   FE 20                 	CPI	' '
  0776'   CA 07B6'              	JZ	CLS0
  0779'   FE 09                 	CPI	TAB
  077B'   CA 07B6'              	JZ	CLS0
  077E'   FE 0A                 	CPI	LF
  0780'   CA 07B6'              	JZ	CLS0
  0783'   FE 0D                 	CPI	CR
  0785'   CA 07B6'              	JZ	CLS0
  0788'   3A 2AD3'              	LDA	WBIG
  078B'   B7                    	ORA	A
  078C'   C2 07B8'              	JNZ	CLS1
  078F'   78                    	MOV	A,B
  0790'   FE 5F                 	CPI	'_'
  0792'   CA 07B8'              	JZ	CLS1
  0795'   FE 30                 	CPI	'0'
  0797'   DA 07BB'              	JC	CLS2
  079A'   FE 3A                 	CPI	'9'+1
  079C'   DA 07B8'              	JC	CLS1
  079F'   FE 41                 	CPI	'A'
  07A1'   DA 07BB'              	JC	CLS2
  07A4'   FE 5B                 	CPI	'Z'+1
  07A6'   DA 07B8'              	JC	CLS1
  07A9'   FE 61                 	CPI	'a'
  07AB'   DA 07BB'              	JC	CLS2
  07AE'   FE 7B                 	CPI	'z'+1
  07B0'   DA 07B8'              	JC	CLS1
  07B3'   C3 07BB'              	JMP	CLS2
  07B6'   AF                    CLS0:	XRA	A
  07B7'   C9                    	RET
  07B8'   3E 01                 CLS1:	MVI	A,1
  07BA'   C9                    	RET
  07BB'   3E 02                 CLS2:	MVI	A,2
  07BD'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  07BE'                         SETMOV:
  07BE'   3E 01                 	MVI	A,R_MOVE
  07C0'   32 2ACD'              	STA	RINTENT
  07C3'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  07C4'                         SETLIN:
  07C4'   3E 02                 	MVI	A,R_LINE
  07C6'   32 2ACD'              	STA	RINTENT
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C9'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  07CA'                         SETILN:
  07CA'   3E 01                 	MVI	A,1
  07CC'   32 2ACE'              	STA	ILN		; one line, unless a put overwrites it below
  07CF'   3E 05                 	MVI	A,R_ILIN
  07D1'   32 2ACD'              	STA	RINTENT
  07D4'   AF                    	XRA	A
  07D5'   32 2AD0'              	STA	ILABOV		; the row above the opened ones is untouched
  07D8'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  07D9'                         SETJON:
  07D9'   3E 06                 	MVI	A,R_JOIN
  07DB'   32 2ACD'              	STA	RINTENT
  07DE'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  07DF'                         SETFUL:
  07DF'   3E 00                 	MVI	A,R_FULL
  07E1'   32 2ACD'              	STA	RINTENT
  07E4'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  07E5'                         TAILTAB:
  07E5'   CD 0000*              	CALL	CUROFF
  07E8'   22 2B0D'              	SHLD	TTI
  07EB'                         TT_LP:
  07EB'   2A 2B0D'              	LHLD	TTI
  07EE'   EB                    	XCHG			; DE = TTI
  07EF'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  07F2'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  07F5'   D2 0815'              	JNC	TT_NO		; reached end of text -> no tab
  07F8'   2A 2B0D'              	LHLD	TTI
  07FB'   CD 0000*              	CALL	CHARAT
  07FE'   FE 0A                 	CPI	LF
  0800'   CA 0815'              	JZ	TT_NO		; end of line -> no tab
  0803'   FE 09                 	CPI	TAB
  0805'   CA 0812'              	JZ	TT_YES
  0808'   2A 2B0D'              	LHLD	TTI
  080B'   23                    	INX	H
  080C'   22 2B0D'              	SHLD	TTI
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  080F'   C3 07EB'              	JMP	TT_LP
  0812'                         TT_YES:
  0812'   3E 01                 	MVI	A,1
  0814'   C9                    	RET
  0815'                         TT_NO:
  0815'   AF                    	XRA	A
  0816'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0817'                         VC_H:
  0817'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  081A'   22 2B0B'              	SHLD	CNTV
  081D'                         VCH_LP:
  081D'   2A 2B0B'              	LHLD	CNTV
  0820'   7C                    	MOV	A,H
  0821'   B5                    	ORA	L
  0822'   C8                    	RZ
  0823'   2B                    	DCX	H
  0824'   22 2B0B'              	SHLD	CNTV
  0827'   CD 082D'              	CALL	HSTEP
  082A'   C3 081D'              	JMP	VCH_LP
  082D'                         HSTEP:
  082D'   CD 0000*              	CALL	CUROFF		; HL = cur
  0830'   7C                    	MOV	A,H
  0831'   B5                    	ORA	L
  0832'   C8                    	RZ			; at 0
  0833'   E5                    	PUSH	H
  0834'   CD 0648'              	CALL	BOL		; HL = bol
  0837'   D1                    	POP	D		; DE = cur
  0838'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  083B'   C8                    	RZ			; at BOL, cannot go left
  083C'   EB                    	XCHG			; HL = cur
  083D'   2B                    	DCX	H
  083E'   C3 05DE'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0841'                         VC_L:
  0841'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0844'   22 2B0B'              	SHLD	CNTV
  0847'                         VCL_LP:
  0847'   2A 2B0B'              	LHLD	CNTV
  084A'   7C                    	MOV	A,H
  084B'   B5                    	ORA	L
  084C'   C8                    	RZ
  084D'   2B                    	DCX	H
  084E'   22 2B0B'              	SHLD	CNTV
  0851'   CD 0857'              	CALL	LSTEP
  0854'   C3 0847'              	JMP	VCL_LP
  0857'                         LSTEP:
  0857'   CD 0000*              	CALL	CUROFF		; HL = cur
  085A'   E5                    	PUSH	H
  085B'   CD 0687'              	CALL	EOLC		; HL = eolc
  085E'   D1                    	POP	D		; DE = cur
  085F'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0862'   D2 086A'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0865'   EB                    	XCHG			; HL = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0866'   23                    	INX	H
  0867'   C3 05DE'              	JMP	GOSET
  086A'                         LS_NO:				; on the line's last char.  An operator waiting on
  086A'   CD 0C36'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  086D'   C8                    	RZ			;   motion inclusive when it falls short), which
  086E'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0870'   32 2AD4'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0873'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0874'                         VC_0:
  0874'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0877'   CD 0881'              	CALL	LNSTRT
  087A'   21 0000               	LXI	H,0
  087D'   22 2AD1'              	SHLD	GOALCOL
  0880'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0881'                         LNSTRT:
  0881'   CD 0FB3'              	CALL	ZSAVE
  0884'   21 0000               	LXI	H,0
  0887'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  088A'   E5                    	PUSH	H
  088B'   CD 0FC6'              	CALL	ZREST
  088E'   E1                    	POP	H
  088F'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0892'                         VC_CRT:
  0892'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0895'   C3 0898'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0898'                         FNBLNK:
  0898'   CD 0881'              	CALL	LNSTRT
  089B'   CD 0000*              	CALL	RGET0
  089E'   11 0000               	LXI	D,0		; DE = blanks skipped
  08A1'                         FN_LP:
  08A1'   CD 0000*              	CALL	RDGET
  08A4'   DA 08C7'              	JC	FN_GO		; the end of the file
  08A7'   FE 20                 	CPI	' '
  08A9'   CA 08B1'              	JZ	FN_WH
  08AC'   FE 09                 	CPI	TAB
  08AE'   C2 08C7'              	JNZ	FN_GO		; a non-blank, or the line's end
  08B1'                         FN_WH:
  08B1'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  08B4'   DA 08C7'              	JC	FN_GO
  08B7'   FE 0D                 	CPI	CR
  08B9'   CA 08C7'              	JZ	FN_GO
  08BC'   FE 0A                 	CPI	LF
  08BE'   CA 08C7'              	JZ	FN_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C1'   2B                    	DCX	H		; not yet: read that char again
  08C2'   03                    	INX	B
  08C3'   13                    	INX	D
  08C4'   C3 08A1'              	JMP	FN_LP
  08C7'                         FN_GO:
  08C7'   D5                    	PUSH	D
  08C8'   CD 0000*              	CALL	CUROFF
  08CB'   D1                    	POP	D
  08CC'   19                    	DAD	D
  08CD'   C3 05DE'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  08D0'                         VC_EOL:
  08D0'   CD 07BE'              	CALL	SETMOV
  08D3'   21 FFFF               	LXI	H,0FFFFH
  08D6'   22 2AD1'              	SHLD	GOALCOL
  08D9'   CD 06EF'              	CALL	GETCNT
  08DC'   2B                    	DCX	H		; count-1
  08DD'   7C                    	MOV	A,H
  08DE'   B5                    	ORA	L
  08DF'   CA 08EE'              	JZ	VEOL_0
  08E2'   E5                    	PUSH	H
  08E3'   CD 0903'              	CALL	ONLAST
  08E6'   E1                    	POP	H
  08E7'   D8                    	RC			; the last line: no move (vim)
  08E8'   CD 0953'              	CALL	JCORE
  08EB'   C3 0AA2'              	JMP	JKLAND
  08EE'                         VEOL_0:
  08EE'   CD 0881'              	CALL	LNSTRT
  08F1'   C3 0AA2'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  08F4'                         VC_CR:
  08F4'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  08F7'   E5                    	PUSH	H
  08F8'   CD 0903'              	CALL	ONLAST
  08FB'   E1                    	POP	H
  08FC'   D8                    	RC
  08FD'   CD 0953'              	CALL	JCORE
  0900'   C3 0898'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0903'                         ONLAST:
  0903'   CD 0000*              	CALL	RGET0
  0906'                         OL_LP:
  0906'   CD 0000*              	CALL	RDGET
  0909'   D8                    	RC			; the file ends on this line
  090A'   FE 0A                 	CPI	LF
  090C'   C2 0906'              	JNZ	OL_LP
  090F'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0912'                         VC_J:
  0912'   CD 07BE'              	CALL	SETMOV
  0915'   CD 093D'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0918'   CD 06EF'              	CALL	GETCNT		; HL = count
  091B'   CD 0953'              	CALL	JCORE
  091E'   CD 0936'              	CALL	JKDRP
  0921'   C3 0AA2'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0924'                         VC_K:
  0924'   CD 07BE'              	CALL	SETMOV
  0927'   CD 093D'              	CALL	GLCHK
  092A'   CD 06EF'              	CALL	GETCNT
  092D'   CD 09F0'              	CALL	KCORE
  0930'   CD 0936'              	CALL	JKDRP
  0933'   C3 0AA2'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  0936'                         JKDRP:
  0936'   7A                    	MOV	A,D
  0937'   B3                    	ORA	E
  0938'   C0                    	RNZ
  0939'   32 2AF3'              	STA	PSAVE
  093C'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  093D'                         GLCHK:
  093D'   2A 2AD1'              	LHLD	GOALCOL
  0940'   7C                    	MOV	A,H
  0941'   3C                    	INR	A
  0942'   C0                    	RNZ
  0943'   7D                    	MOV	A,L
  0944'   FE FE                 	CPI	0FEH
  0946'   C0                    	RNZ
  0947'   C3 05E1'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  094A'                         GLSTAL:
  094A'   E5                    	PUSH	H
  094B'   21 FFFE               	LXI	H,0FFFEH
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  094E'   22 2AD1'              	SHLD	GOALCOL
  0951'   E1                    	POP	H
  0952'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0953'                         JCORE:
  0953'   7C                    	MOV	A,H
  0954'   B5                    	ORA	L
  0955'   C8                    	RZ
  0956'   22 2AD7'              	SHLD	JKCNT
  0959'   CD 0D65'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  095C'   47                    	MOV	B,A
  095D'   3A 0000*              	LDA	NEDIT
  0960'   3D                    	DCR	A
  0961'   90                    	SUB	B
  0962'   5F                    	MOV	E,A
  0963'   16 00                 	MVI	D,0
  0965'   3A 0000*              	LDA	NEDIT
  0968'   6F                    	MOV	L,A
  0969'   26 00                 	MVI	H,0
  096B'   19                    	DAD	D
  096C'   EB                    	XCHG			; DE = limit
  096D'   2A 2AD7'              	LHLD	JKCNT
  0970'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0973'   D2 0977'              	JNC	JC_N
  0976'   EB                    	XCHG			; HL = limit
  0977'                         JC_N:
  0977'   22 2AD9'              	SHLD	JKN		; N = min(count, limit)
  097A'   EB                    	XCHG			; DE = LFs to find
  097B'   CD 0000*              	CALL	RGET0
  097E'                         JC_SC:
  097E'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0981'   DA 09A0'              	JC	JC_EOF
  0984'   32 2AE0'              	STA	JKLST
  0987'   FE 0A                 	CPI	LF
  0989'   C2 097E'              	JNZ	JC_SC
  098C'   1B                    	DCX	D
  098D'   7A                    	MOV	A,D
  098E'   B3                    	ORA	E
  098F'   C2 097E'              	JNZ	JC_SC
  0992'   2A 2AD7'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0995'   22 2ADB'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0998'   3E 01                 	MVI	A,1
  099A'   32 2ADF'              	STA	JKPHN
  099D'   C3 09BB'              	JMP	JC_MV
  09A0'                         JC_EOF:
  09A0'   2A 2AD9'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  09A3'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  09A6'   7C                    	MOV	A,H
  09A7'   B5                    	ORA	L
  09A8'   CA 09B4'              	JZ	JC_AV
  09AB'   3A 2AE0'              	LDA	JKLST
  09AE'   FE 0A                 	CPI	LF
  09B0'   C2 09B4'              	JNZ	JC_AV
  09B3'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09B4'                         JC_AV:
  09B4'   22 2ADB'              	SHLD	JKMOV
  09B7'   AF                    	XRA	A
  09B8'   32 2ADF'              	STA	JKPHN
  09BB'                         JC_MV:
  09BB'   2A 2AD7'              	LHLD	JKCNT
  09BE'   AF                    	XRA	A
  09BF'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  09C2'   CD 0A81'              	CALL	ATEOF
  09C5'   D2 09D9'              	JNC	JC_DN
  09C8'   CD 0A87'              	CALL	LASTLN		; ran past the last line: back onto it
  09CB'   3A 2ADF'              	LDA	JKPHN
  09CE'   B7                    	ORA	A
  09CF'   CA 09D9'              	JZ	JC_DN
  09D2'   2A 2ADB'              	LHLD	JKMOV
  09D5'   2B                    	DCX	H
  09D6'   22 2ADB'              	SHLD	JKMOV
  09D9'                         JC_DN:
  09D9'   2A 2AD9'              	LHLD	JKN		; LNDLT += min(moved, N)
  09DC'   EB                    	XCHG
  09DD'   2A 2ADB'              	LHLD	JKMOV
  09E0'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  09E3'   D2 09E7'              	JNC	JC_AD
  09E6'   EB                    	XCHG
  09E7'                         JC_AD:
  09E7'   EB                    	XCHG			; DE = lines moved
  09E8'   2A 0000*              	LHLD	LNDLT
  09EB'   19                    	DAD	D
  09EC'   22 0000*              	SHLD	LNDLT
  09EF'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09F0'                         KCORE:
  09F0'   7C                    	MOV	A,H
  09F1'   B5                    	ORA	L
  09F2'   C8                    	RZ
  09F3'   22 2AD7'              	SHLD	JKCNT
  09F6'   CD 0D65'              	CALL	CURRW		; limit = row + NEDIT
  09F9'   5F                    	MOV	E,A
  09FA'   16 00                 	MVI	D,0
  09FC'   3A 0000*              	LDA	NEDIT
  09FF'   6F                    	MOV	L,A
  0A00'   26 00                 	MVI	H,0
  0A02'   19                    	DAD	D
  0A03'   EB                    	XCHG			; DE = limit
  0A04'   2A 2AD7'              	LHLD	JKCNT
  0A07'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A0A'   D2 0A0E'              	JNC	KC_N
  0A0D'   EB                    	XCHG			; HL = limit
  0A0E'                         KC_N:
  0A0E'   22 2AD9'              	SHLD	JKN		; N = min(count, limit)
  0A11'   EB                    	XCHG			; DE = LFs to find
  0A12'   21 0000               	LXI	H,0
  0A15'   22 2ADD'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0A18'                         KC_ED:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A18'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A19'   2A 2ADD'              	LHLD	JKBK
  0A1C'   CD 06E8'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A1F'   E5                    	PUSH	H
  0A20'   EB                    	XCHG
  0A21'   2A 0000*              	LHLD	TXTBEG
  0A24'   EB                    	XCHG
  0A25'   CD 0000*              	CALL	SUBHD
  0A28'   44                    	MOV	B,H
  0A29'   4D                    	MOV	C,L
  0A2A'   E1                    	POP	H
  0A2B'   D1                    	POP	D
  0A2C'                         KC_SC:
  0A2C'   78                    	MOV	A,B
  0A2D'   B1                    	ORA	C
  0A2E'   CA 0A45'              	JZ	KC_TB
  0A31'   2B                    	DCX	H
  0A32'   0B                    	DCX	B
  0A33'   7E                    	MOV	A,M
  0A34'   FE 0A                 	CPI	LF
  0A36'   C2 0A2C'              	JNZ	KC_SC
  0A39'   1B                    	DCX	D
  0A3A'   7A                    	MOV	A,D
  0A3B'   B3                    	ORA	E
  0A3C'   C2 0A2C'              	JNZ	KC_SC
  0A3F'   2A 2AD7'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A42'   C3 0A65'              	JMP	KC_MV
  0A45'                         KC_TB:
  0A45'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A46'   CD 06E8'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A49'   22 2ADD'              	SHLD	JKBK
  0A4C'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A4F'   7C                    	MOV	A,H
  0A50'   B5                    	ORA	L
  0A51'   CA 0A5E'              	JZ	KC_B0
  0A54'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0A57'   D1                    	POP	D
  0A58'   DA 0A5F'              	JC	KC_BOF
  0A5B'   C3 0A18'              	JMP	KC_ED
  0A5E'                         KC_B0:
  0A5E'   D1                    	POP	D
  0A5F'                         KC_BOF:
  0A5F'   2A 2AD9'              	LHLD	JKN		; moved = LFs found
  0A62'   CD 0000*              	CALL	SUBHD
  0A65'                         KC_MV:
  0A65'   E5                    	PUSH	H
  0A66'   2A 2AD7'              	LHLD	JKCNT
  0A69'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A6C'   D1                    	POP	D		; DE = moved
  0A6D'   2A 2AD9'              	LHLD	JKN
  0A70'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A73'   DA 0A77'              	JC	KC_AD
  0A76'   EB                    	XCHG			; DE = N
  0A77'                         KC_AD:
  0A77'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A7A'   CD 0000*              	CALL	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A7D'   22 0000*              	SHLD	LNDLT
  0A80'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A81'                         ATEOF:
  0A81'   CD 0000*              	CALL	RGET0
  0A84'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A87'                         LASTLN:
  0A87'   2A 0000*              	LHLD	GAPBEG
  0A8A'   EB                    	XCHG
  0A8B'   2A 0000*              	LHLD	TXTBEG
  0A8E'   CD 0000*              	CALL	CMP16
  0A91'   21 0000               	LXI	H,0
  0A94'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A97'   1B                    	DCX	D
  0A98'   1A                    	LDAX	D
  0A99'   FE 0A                 	CPI	LF
  0A9B'   C2 0000*              	JNZ	SETBWD
  0A9E'   23                    	INX	H
  0A9F'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0AA2'                         JKLAND:
  0AA2'   21 0000               	LXI	H,0
  0AA5'   22 2AE1'              	SHLD	JKVC		; screen column
  0AA8'   2B                    	DCX	H
  0AA9'   22 2AE3'              	SHLD	JKLS		; last content char: none yet
  0AAC'   CD 0000*              	CALL	RGET0
  0AAF'   11 0000               	LXI	D,0		; DE = chars read
  0AB2'                         JL_RD:
  0AB2'   CD 0000*              	CALL	RDGET
  0AB5'   DA 0AEF'              	JC	JL_END
  0AB8'   FE 0A                 	CPI	LF
  0ABA'   CA 0AEF'              	JZ	JL_END
  0ABD'   E5                    	PUSH	H
  0ABE'   C5                    	PUSH	B
  0ABF'   2A 2AE1'              	LHLD	JKVC
  0AC2'   CD 0635'              	CALL	CWID
  0AC5'   B7                    	ORA	A
  0AC6'   CA 0AE9'              	JZ	JL_NX		; a CR
  0AC9'   EB                    	XCHG
  0ACA'   22 2AE3'              	SHLD	JKLS		; the last content char so far
  0ACD'   EB                    	XCHG
  0ACE'   4F                    	MOV	C,A
  0ACF'   06 00                 	MVI	B,0
  0AD1'   09                    	DAD	B		; HL = the column after this char
  0AD2'   22 2AE1'              	SHLD	JKVC
  0AD5'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AD6'   EB                    	XCHG
  0AD7'   2A 2AD1'              	LHLD	GOALCOL
  0ADA'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0ADD'   D1                    	POP	D
  0ADE'   DA 0AE9'              	JC	JL_NX
  0AE1'   CA 0AE9'              	JZ	JL_NX
  0AE4'   C1                    	POP	B		; this char holds the goal column
  0AE5'   E1                    	POP	H
  0AE6'   C3 0AFA'              	JMP	JL_GO
  0AE9'                         JL_NX:
  0AE9'   C1                    	POP	B
  0AEA'   E1                    	POP	H
  0AEB'   13                    	INX	D
  0AEC'   C3 0AB2'              	JMP	JL_RD
  0AEF'                         JL_END:
  0AEF'   2A 2AE3'              	LHLD	JKLS		; past the line's end: its last content char
  0AF2'   7C                    	MOV	A,H
  0AF3'   A5                    	ANA	L
  0AF4'   3C                    	INR	A
  0AF5'   C2 0AF9'              	JNZ	JL_LS
  0AF8'   23                    	INX	H		; no content: the line's start
  0AF9'                         JL_LS:
  0AF9'   EB                    	XCHG
  0AFA'                         JL_GO:
  0AFA'   D5                    	PUSH	D		; DE = step from the line start
  0AFB'   CD 0000*              	CALL	CUROFF
  0AFE'   D1                    	POP	D
  0AFF'   19                    	DAD	D
  0B00'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0B03'   AF                    VC_W:	XRA	A
  0B04'   32 2AD3'              	STA	WBIG
  0B07'   C3 0B0F'              	JMP	WDO
  0B0A'   3E 01                 VCBGW:	MVI	A,1
  0B0C'   32 2AD3'              	STA	WBIG
  0B0F'   CD 07BE'              WDO:	CALL	SETMOV
  0B12'   AF                    	XRA	A
  0B13'   32 2AD4'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0B16'   CD 06EF'              	CALL	GETCNT
  0B19'   22 2B0B'              	SHLD	CNTV
  0B1C'   2A 2B0B'              WDO_LP: LHLD	CNTV
  0B1F'   7C                    	MOV	A,H
  0B20'   B5                    	ORA	L
  0B21'   CA 0B2E'              	JZ	WDO_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B24'   2B                    	DCX	H
  0B25'   22 2B0B'              	SHLD	CNTV
  0B28'   CD 0B8B'              	CALL	FWD1
  0B2B'   D2 0B1C'              	JNC	WDO_LP
  0B2E'                         WDO_DN:
  0B2E'   CD 0A81'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B31'   DA 0B3E'              	JC	WDO_NL
  0B34'   FE 0D                 	CPI	CR
  0B36'   CA 0B3E'              	JZ	WDO_NL
  0B39'   FE 0A                 	CPI	LF
  0B3B'   C2 05E1'              	JNZ	SETGL
  0B3E'                         WDO_NL:
  0B3E'   CD 0000*              	CALL	PEEKL
  0B41'   DA 05E1'              	JC	SETGL
  0B44'   FE 0A                 	CPI	LF
  0B46'   CA 05E1'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B49'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B4B'   32 2AD4'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B4E'   CD 0CAA'              	CALL	DECC		; back onto its last char
  0B51'   C3 05E1'              	JMP	SETGL
                                
  0B54'   AF                    VC_B:	XRA	A
  0B55'   32 2AD3'              	STA	WBIG
  0B58'   C3 0B60'              	JMP	BDO
  0B5B'   3E 01                 VCBGB:	MVI	A,1
  0B5D'   32 2AD3'              	STA	WBIG
  0B60'   CD 07BE'              BDO:	CALL	SETMOV
  0B63'   CD 06EF'              	CALL	GETCNT
  0B66'   22 2B0B'              	SHLD	CNTV
  0B69'   CD 0BFB'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B6C'   D2 0B7C'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B6F'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B70'   32 2AF3'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B73'   C3 05E1'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B76'                         BDO_LP:				;   its operator stands -- both as vim
  0B76'   CD 0BFB'              	CALL	BCK1
  0B79'   DA 05E1'              	JC	SETGL
  0B7C'   2A 2B0B'              BDO_NX: LHLD	CNTV
  0B7F'   2B                    	DCX	H
  0B80'   22 2B0B'              	SHLD	CNTV
  0B83'   7C                    	MOV	A,H
  0B84'   B5                    	ORA	L
  0B85'   C2 0B76'              	JNZ	BDO_LP
  0B88'   C3 05E1'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B8B'                         FWD1:
  0B8B'   CD 0C2E'              	CALL	CCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B8E'   32 2B17'              	STA	WKCLS		; the starting class
  0B91'   CD 0C68'              	CALL	INCC
  0B94'   B7                    	ORA	A
  0B95'   CA 0BAE'              	JZ	FW_WD
  0B98'   37                    	STC
  0B99'   F8                    	RM			; -1: already at the end
  0B9A'   CD 0BE6'              	CALL	WLAST
  0B9D'   C8                    	RZ
  0B9E'   FE 02                 	CPI	2
  0BA0'   C2 0BAE'              	JNZ	FW_WD		; 1: a next line was reached
  0BA3'   CD 0A81'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0BA6'   D4 0C4F'              	CNC	NXLN
  0BA9'   D2 0BAE'              	JNC	FW_WD
  0BAC'   37                    	STC			; yes: failed
  0BAD'   C9                    	RET
  0BAE'                         FW_WD:
  0BAE'   3A 2B17'              	LDA	WKCLS		; go past the rest of this word
  0BB1'   B7                    	ORA	A
  0BB2'   CA 0BCE'              	JZ	FW_WS
  0BB5'                         FW_WLP:
  0BB5'   CD 0C2E'              	CALL	CCLS
  0BB8'   21 2B17'              	LXI	H,WKCLS
  0BBB'   BE                    	CMP	M
  0BBC'   C2 0BCE'              	JNZ	FW_WS
  0BBF'   CD 0C68'              	CALL	INCC
  0BC2'   B7                    	ORA	A
  0BC3'   F8                    	RM			; the end of the file (NC)
  0BC4'   CA 0BB5'              	JZ	FW_WLP
  0BC7'   CD 0BE6'              	CALL	WLAST
  0BCA'   C8                    	RZ
  0BCB'   C3 0BB5'              	JMP	FW_WLP
  0BCE'                         FW_WS:
  0BCE'   CD 0C2E'              	CALL	CCLS		; then over blanks to the next word
  0BD1'   B7                    	ORA	A
  0BD2'   C0                    	RNZ
  0BD3'   CD 0C36'              	CALL	EMPTY
  0BD6'   C8                    	RZ			; an empty line is a word
  0BD7'   CD 0C68'              	CALL	INCC
  0BDA'   B7                    	ORA	A
  0BDB'   F8                    	RM
  0BDC'   CA 0BCE'              	JZ	FW_WS
  0BDF'   CD 0BE6'              	CALL	WLAST
  0BE2'   C8                    	RZ
  0BE3'   C3 0BCE'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BE6'                         WLAST:
  0BE6'   47                    	MOV	B,A
  0BE7'   2A 2B0B'              	LHLD	CNTV
  0BEA'   7C                    	MOV	A,H
  0BEB'   B5                    	ORA	L
  0BEC'   C2 0BF7'              	JNZ	WL_X		; words still owed
  0BEF'   3A 2AF3'              	LDA	PSAVE
  0BF2'   B7                    	ORA	A
  0BF3'   CA 0BF9'              	JZ	WL_NO		; a plain 'w'
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BF6'   AF                    	XRA	A
  0BF7'   78                    WL_X:	MOV	A,B
  0BF8'   C9                    	RET
  0BF9'   B0                    WL_NO:	ORA	B
  0BFA'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BFB'                         BCK1:
  0BFB'   CD 0CAA'              	CALL	DECC
  0BFE'   B7                    	ORA	A
  0BFF'   37                    	STC
  0C00'   F8                    	RM
  0C01'                         BK_WS:
  0C01'   CD 0C2E'              	CALL	CCLS		; back over blanks
  0C04'   B7                    	ORA	A
  0C05'   C2 0C15'              	JNZ	BK_WD
  0C08'   CD 0C36'              	CALL	EMPTY
  0C0B'   C8                    	RZ			; an empty line is a word
  0C0C'   CD 0CAA'              	CALL	DECC
  0C0F'   B7                    	ORA	A
  0C10'   F2 0C01'              	JP	BK_WS
  0C13'   AF                    	XRA	A		; the start of the file (NC)
  0C14'   C9                    	RET
  0C15'                         BK_WD:
  0C15'   32 2B17'              	STA	WKCLS		; back to the start of this word
  0C18'                         BK_WLP:
  0C18'   CD 0CAA'              	CALL	DECC
  0C1B'   B7                    	ORA	A
  0C1C'   FA 0C2C'              	JM	BK_OK		; the start of the file
  0C1F'   CD 0C2E'              	CALL	CCLS
  0C22'   21 2B17'              	LXI	H,WKCLS
  0C25'   BE                    	CMP	M
  0C26'   CA 0C18'              	JZ	BK_WLP
  0C29'   CD 0C68'              	CALL	INCC		; overshot: forward one
  0C2C'                         BK_OK:
  0C2C'   AF                    	XRA	A
  0C2D'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C2E'                         CCLS:
  0C2E'   CD 0A81'              	CALL	ATEOF
  0C31'   D2 0773'              	JNC	CLASSF
  0C34'   AF                    	XRA	A
  0C35'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C36'                         EMPTY:
  0C36'   CD 0A81'              	CALL	ATEOF
  0C39'   DA 0C44'              	JC	EM_ST
  0C3C'   FE 0D                 	CPI	CR
  0C3E'   CA 0C44'              	JZ	EM_ST
  0C41'   FE 0A                 	CPI	LF
  0C43'   C0                    	RNZ
  0C44'                         EM_ST:
  0C44'   CD 0000*              	CALL	PEEKL
  0C47'   DA 0C4D'              	JC	EM_Y
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C4A'   FE 0A                 	CPI	LF
  0C4C'   C9                    	RET
  0C4D'                         EM_Y:
  0C4D'   AF                    	XRA	A
  0C4E'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C4F'                         NXLN:
  0C4F'   FE 0A                 	CPI	LF
  0C51'   CA 0C60'              	JZ	NX_LF
  0C54'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C57'   D8                    	RC
  0C58'   FE 0A                 	CPI	LF
  0C5A'   CA 0C60'              	JZ	NX_LF
  0C5D'   2B                    	DCX	H		; a lone CR
  0C5E'   AF                    	XRA	A
  0C5F'   C9                    	RET
  0C60'                         NX_LF:
  0C60'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C63'   D8                    	RC
  0C64'   2B                    	DCX	H
  0C65'   3E 01                 	MVI	A,1
  0C67'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C68'                         INCC:
  0C68'   CD 0A81'              	CALL	ATEOF
  0C6B'   DA 0CA6'              	JC	IC_END
  0C6E'   FE 0D                 	CPI	CR
  0C70'   CA 0C91'              	JZ	IC_NL
  0C73'   FE 0A                 	CPI	LF
  0C75'   CA 0C91'              	JZ	IC_NL
  0C78'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C7B'                         IC_CH:
  0C7B'   CD 0A81'              	CALL	ATEOF
  0C7E'   DA 0C8D'              	JC	IC_2
  0C81'   FE 0D                 	CPI	CR
  0C83'   CA 0C8D'              	JZ	IC_2
  0C86'   FE 0A                 	CPI	LF
  0C88'   CA 0C8D'              	JZ	IC_2
  0C8B'   AF                    	XRA	A
  0C8C'   C9                    	RET
  0C8D'                         IC_2:
  0C8D'   3E 02                 	MVI	A,2
  0C8F'   B7                    	ORA	A
  0C90'   C9                    	RET
  0C91'                         IC_NL:
  0C91'   CD 0C4F'              	CALL	NXLN
  0C94'   DA 0CA6'              	JC	IC_END
  0C97'   F5                    	PUSH	PSW
  0C98'   CD 0000*              	CALL	PUTCUR
  0C9B'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C9C'   B7                    	ORA	A
  0C9D'   CA 0C7B'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0CA0'   CD 0CCC'              	CALL	LNINC
  0CA3'   3E 01                 	MVI	A,1
  0CA5'   C9                    	RET
  0CA6'                         IC_END:
  0CA6'   3E FF                 	MVI	A,0FFH
  0CA8'   B7                    	ORA	A
  0CA9'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0CAA'                         DECC:
  0CAA'   CD 0000*              	CALL	PEEKL
  0CAD'   DA 0CA6'              	JC	IC_END
  0CB0'   F5                    	PUSH	PSW
  0CB1'   CD 0000*              	CALL	PUTCUR
  0CB4'   F1                    	POP	PSW
  0CB5'   FE 0A                 	CPI	LF
  0CB7'   3E 00                 	MVI	A,0
  0CB9'   C0                    	RNZ
  0CBA'   CD 0CDA'              	CALL	LNDEC
  0CBD'   CD 0000*              	CALL	PEEKL		; onto its CR
  0CC0'   DA 0CC8'              	JC	DC_1
  0CC3'   FE 0D                 	CPI	CR
  0CC5'   CC 0000*              	CZ	PUTCUR
  0CC8'                         DC_1:
  0CC8'   3E 01                 	MVI	A,1
  0CCA'   B7                    	ORA	A
  0CCB'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CCC'                         LNINC:
  0CCC'   E5                    	PUSH	H
  0CCD'   2A 0000*              	LHLD	LNDLT
  0CD0'   7C                    	MOV	A,H
  0CD1'   FE 40                 	CPI	40H
  0CD3'   CA 0CE8'              	JZ	LN_X
  0CD6'   23                    	INX	H
  0CD7'   C3 0CE5'              	JMP	LN_ST
  0CDA'                         LNDEC:
  0CDA'   E5                    	PUSH	H
  0CDB'   2A 0000*              	LHLD	LNDLT
  0CDE'   7C                    	MOV	A,H
  0CDF'   FE C0                 	CPI	0C0H
  0CE1'   CA 0CE8'              	JZ	LN_X
  0CE4'   2B                    	DCX	H
  0CE5'                         LN_ST:
  0CE5'   22 0000*              	SHLD	LNDLT
  0CE8'                         LN_X:
  0CE8'   E1                    	POP	H
  0CE9'   C9                    	RET
                                
  0CEA'   AF                    VC_E:	XRA	A
  0CEB'   32 2AD3'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CEE'   C3 0CF6'              	JMP	EDO
  0CF1'   3E 01                 VCBGE:	MVI	A,1
  0CF3'   32 2AD3'              	STA	WBIG
  0CF6'   CD 07BE'              EDO:	CALL	SETMOV
  0CF9'   CD 06EF'              	CALL	GETCNT
  0CFC'   22 2B0B'              	SHLD	CNTV
  0CFF'   2A 2B0B'              EDO_LP: LHLD	CNTV
  0D02'   7C                    	MOV	A,H
  0D03'   B5                    	ORA	L
  0D04'   CA 0B2E'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0D07'   2B                    	DCX	H
  0D08'   22 2B0B'              	SHLD	CNTV
  0D0B'   CD 0D19'              	CALL	ESTEP
  0D0E'   21 2AF6'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0D11'   36 00                 	MVI	M,0
  0D13'   D2 0CFF'              	JNC	EDO_LP
  0D16'   C3 0B2E'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0D19'                         ESTEP:
  0D19'   CD 0C2E'              	CALL	CCLS
  0D1C'   32 2B17'              	STA	WKCLS		; the starting class
  0D1F'   CD 0C68'              	CALL	INCC
  0D22'   B7                    	ORA	A
  0D23'   FA 0D49'              	JM	ES_F
  0D26'   CD 0C2E'              	CALL	CCLS
  0D29'   B7                    	ORA	A
  0D2A'   CA 0D34'              	JZ	ES_ST
  0D2D'   21 2B17'              	LXI	H,WKCLS
  0D30'   BE                    	CMP	M
  0D31'   CA 0D4B'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D34'                         ES_ST:
  0D34'   3A 2AF6'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D37'   B7                    	ORA	A		;   that char is the word's end already, and
  0D38'   C2 0D62'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D3B'                         ES_WS:
  0D3B'   CD 0C2E'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D3E'   B7                    	ORA	A
  0D3F'   C2 0D4B'              	JNZ	ES_SK
  0D42'   CD 0C68'              	CALL	INCC
  0D45'   B7                    	ORA	A
  0D46'   F2 0D3B'              	JP	ES_WS
  0D49'                         ES_F:
  0D49'   37                    	STC
  0D4A'   C9                    	RET
  0D4B'                         ES_SK:
  0D4B'   CD 0C2E'              	CALL	CCLS		; past the rest of this word ...
  0D4E'   32 2B17'              	STA	WKCLS
  0D51'                         ES_SL:
  0D51'   CD 0C68'              	CALL	INCC
  0D54'   B7                    	ORA	A
  0D55'   FA 0D49'              	JM	ES_F
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D58'   CD 0C2E'              	CALL	CCLS
  0D5B'   21 2B17'              	LXI	H,WKCLS
  0D5E'   BE                    	CMP	M
  0D5F'   CA 0D51'              	JZ	ES_SL
  0D62'   C3 0CAA'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D65'                         CURRW:
  0D65'   2A 0000*              	LHLD	WINROW
  0D68'   EB                    	XCHG
  0D69'   2A 0000*              	LHLD	LNDLT
  0D6C'   19                    	DAD	D		; HL = row (signed)
  0D6D'   7C                    	MOV	A,H
  0D6E'   B7                    	ORA	A
  0D6F'   FA 0D82'              	JM	CRW_0		; above the screen -> top row
  0D72'   C2 0D7D'              	JNZ	CRW_BT		; far below -> bottom row
  0D75'   3A 0000*              	LDA	NEDIT
  0D78'   3D                    	DCR	A		; A = bottom row
  0D79'   BD                    	CMP	L		; CY iff bottom < row
  0D7A'   D8                    	RC
  0D7B'   7D                    	MOV	A,L
  0D7C'   C9                    	RET
  0D7D'                         CRW_BT:
  0D7D'   3A 0000*              	LDA	NEDIT
  0D80'   3D                    	DCR	A
  0D81'   C9                    	RET
  0D82'                         CRW_0:
  0D82'   AF                    	XRA	A
  0D83'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D84'                         SETRWT:
  0D84'   2A 0000*              	LHLD	LNDLT
  0D87'   EB                    	XCHG
  0D88'   6F                    	MOV	L,A
  0D89'   26 00                 	MVI	H,0
  0D8B'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D8E'   22 0000*              	SHLD	WINROW
  0D91'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D92'                         MVROW:
  0D92'   47                    	MOV	B,A
  0D93'   CD 0D65'              	CALL	CURRW
  0D96'   90                    	SUB	B		; A = row now - target
  0D97'   C8                    	RZ
  0D98'   DA 0DA1'              	JC	MR_DN
  0D9B'   6F                    	MOV	L,A
  0D9C'   26 00                 	MVI	H,0
  0D9E'   C3 09F0'              	JMP	KCORE
  0DA1'                         MR_DN:
  0DA1'   2F                    	CMA
  0DA2'   3C                    	INR	A		; A = target - row now
  0DA3'   6F                    	MOV	L,A
  0DA4'   26 00                 	MVI	H,0
  0DA6'   C3 0953'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0DA9'                         VC_HIGH:
  0DA9'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0DAC'   2B                    	DCX	H		; row = count - 1
  0DAD'   7C                    	MOV	A,H
  0DAE'   B7                    	ORA	A
  0DAF'   3A 0000*              	LDA	SCBOT
  0DB2'   C2 0DBA'              	JNZ	VH_GO		; >= 256 -> the last text row
  0DB5'   BD                    	CMP	L		; CY iff SCBOT < row
  0DB6'   DA 0DBA'              	JC	VH_GO
  0DB9'   7D                    	MOV	A,L
  0DBA'                         VH_GO:
  0DBA'   CD 0D92'              	CALL	MVROW
  0DBD'   C3 0898'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0DC0'                         VC_MIDL:
  0DC0'   CD 06DC'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0DC3'   3A 0000*              	LDA	SCBOT
  0DC6'   B7                    	ORA	A		; clear CY for the shift
  0DC7'   1F                    	RAR			; A = SCBOT / 2
  0DC8'   CD 0D92'              	CALL	MVROW
  0DCB'   C3 0898'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0DCE'                         VC_LOWL:
  0DCE'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0DD1'   2B                    	DCX	H		; count - 1
  0DD2'   3A 0000*              	LDA	SCBOT
  0DD5'   5F                    	MOV	E,A
  0DD6'   16 00                 	MVI	D,0
  0DD8'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DD9'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DDC'   3E 00                 	MVI	A,0
  0DDE'   D2 0DE5'              	JNC	VL_GO		; at or past the top -> row 0
  0DE1'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DE4'   7D                    	MOV	A,L
  0DE5'                         VL_GO:
  0DE5'   CD 0D92'              	CALL	MVROW
  0DE8'   C3 0898'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0DEB'                         VC_PGDN:
  0DEB'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0DEE'   3A 0000*              	LDA	SCEOF
  0DF1'   B7                    	ORA	A
  0DF2'   CA 0E00'              	JZ	VPD_N
  0DF5'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0DF8'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0DF9'   C8                    	RZ			; it already is
  0DFA'   CD 0D92'              	CALL	MVROW
  0DFD'   C3 0E11'              	JMP	VPD_TP
  0E00'                         VPD_N:
  0E00'   3A 0000*              	LDA	NEDIT
  0E03'   D6 02                 	SUI	2
  0E05'   CD 0E59'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0E08'   E5                    	PUSH	H
  0E09'   AF                    	XRA	A
  0E0A'   CD 0D92'              	CALL	MVROW		; the top line
  0E0D'   E1                    	POP	H
  0E0E'   CD 0953'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0E11'                         VPD_TP:
  0E11'   AF                    	XRA	A
  0E12'   CD 0D84'              	CALL	SETRWT		; to the top row
  0E15'   C3 0898'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0E18'                         VC_PGUP:
  0E18'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  0E1B'   3A 0000*              	LDA	SCBOF
  0E1E'   B7                    	ORA	A
  0E1F'   C0                    	RNZ
  0E20'   3A 0000*              	LDA	NEDIT
  0E23'   47                    	MOV	B,A
  0E24'   3A 0000*              	LDA	SCEOF
  0E27'   B7                    	ORA	A
  0E28'   CA 0E39'              	JZ	VPU_2
  0E2B'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0E2E'   FE 02                 	CPI	2
  0E30'   D2 0E39'              	JNC	VPU_2
  0E33'   2F                    	CMA
  0E34'   3C                    	INR	A
  0E35'   80                    	ADD	B
  0E36'   C3 0E3C'              	JMP	VPU_P
  0E39'                         VPU_2:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E39'   78                    	MOV	A,B
  0E3A'   D6 02                 	SUI	2
  0E3C'                         VPU_P:
  0E3C'   CD 0E59'              	CALL	MULSAT		; HL = count * page
  0E3F'   E5                    	PUSH	H
  0E40'   AF                    	XRA	A
  0E41'   CD 0D92'              	CALL	MVROW		; the top line
  0E44'   E1                    	POP	H
  0E45'   CD 09F0'              	CALL	KCORE		; the new top line
  0E48'   AF                    	XRA	A
  0E49'   CD 0D84'              	CALL	SETRWT		; on the top row
  0E4C'   3A 0000*              	LDA	NEDIT
  0E4F'   3D                    	DCR	A
  0E50'   6F                    	MOV	L,A
  0E51'   26 00                 	MVI	H,0
  0E53'   CD 0953'              	CALL	JCORE		; the bottom row's line
  0E56'   C3 0898'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0E59'                         MULSAT:
  0E59'   EB                    	XCHG
  0E5A'   21 0000               	LXI	H,0
  0E5D'   B7                    	ORA	A
  0E5E'   C8                    	RZ
  0E5F'                         MS_LP:
  0E5F'   19                    	DAD	D
  0E60'   DA 0E68'              	JC	MS_SAT
  0E63'   3D                    	DCR	A
  0E64'   C2 0E5F'              	JNZ	MS_LP
  0E67'   C9                    	RET
  0E68'                         MS_SAT:
  0E68'   21 FFFF               	LXI	H,0FFFFH
  0E6B'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E6C'                         VC_HFDN:
  0E6C'   CD 07BE'              	CALL	SETMOV
  0E6F'   CD 0D65'              	CALL	CURRW
  0E72'   32 2AD5'              	STA	HFROW
  0E75'   CD 0EE3'              	CALL	HFCNT		; HL = lines
  0E78'   3A 2AD5'              	LDA	HFROW
  0E7B'   47                    	MOV	B,A
  0E7C'   3A 0000*              	LDA	SCEOF
  0E7F'   B7                    	ORA	A
  0E80'   CA 0E88'              	JZ	VHD_GO
  0E83'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E86'   B8                    	CMP	B
  0E87'   C8                    	RZ			; the cursor is on it
  0E88'                         VHD_GO:
  0E88'   CD 0953'              	CALL	JCORE
  0E8B'   3A 0000*              	LDA	SCEOF
  0E8E'   B7                    	ORA	A
  0E8F'   C2 0898'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E92'   3A 2AD5'              	LDA	HFROW
  0E95'   CD 0D84'              	CALL	SETRWT
  0E98'   3E 01                 	MVI	A,1
  0E9A'   32 0000*              	STA	WFILL		; not past the end of the file
  0E9D'   C3 0898'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0EA0'                         VC_HFUP:
  0EA0'   CD 07BE'              	CALL	SETMOV
  0EA3'   CD 0D65'              	CALL	CURRW
  0EA6'   32 2AD5'              	STA	HFROW
  0EA9'   CD 0EE3'              	CALL	HFCNT		; HL = lines
  0EAC'   CD 0EC3'              	CALL	ONFST
  0EAF'   C8                    	RZ			; the cursor is on the first line
  0EB0'   CD 09F0'              	CALL	KCORE
  0EB3'   3A 0000*              	LDA	SCBOF
  0EB6'   B7                    	ORA	A
  0EB7'   C2 0898'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0EBA'   3A 2AD5'              	LDA	HFROW
  0EBD'   CD 0D84'              	CALL	SETRWT
  0EC0'   C3 0898'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0EC3'                         ONFST:
  0EC3'   E5                    	PUSH	H
  0EC4'   2A 0000*              	LHLD	OUTPOS
  0EC7'   7C                    	MOV	A,H
  0EC8'   B5                    	ORA	L
  0EC9'   C2 0EE1'              	JNZ	OF_RET
  0ECC'   2A 0000*              	LHLD	TXTBEG
  0ECF'   EB                    	XCHG			; DE = TXTBEG
  0ED0'   2A 0000*              	LHLD	GAPBEG
  0ED3'                         OF_LP:
  0ED3'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0ED6'   CA 0EE1'              	JZ	OF_RET
  0ED9'   2B                    	DCX	H
  0EDA'   7E                    	MOV	A,M
  0EDB'   FE 0A                 	CPI	LF
  0EDD'   C2 0ED3'              	JNZ	OF_LP
  0EE0'   B7                    	ORA	A		; NZ
  0EE1'                         OF_RET:
  0EE1'   E1                    	POP	H
  0EE2'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0EE3'                         HFCNT:
  0EE3'   2A 2AC9'              	LHLD	CMDCNT
  0EE6'   7C                    	MOV	A,H
  0EE7'   B5                    	ORA	L
  0EE8'   CA 0EFF'              	JZ	HFC_AM
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EEB'   CD 06EF'              	CALL	GETCNT		; HL = count; clears it
  0EEE'   3A 0000*              	LDA	NEDIT
  0EF1'   5F                    	MOV	E,A
  0EF2'   16 00                 	MVI	D,0
  0EF4'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0EF7'   D2 0EFB'              	JNC	HFC_ST
  0EFA'   EB                    	XCHG			; HL = NEDIT
  0EFB'                         HFC_ST:
  0EFB'   7D                    	MOV	A,L
  0EFC'   32 2AD6'              	STA	HFAMT
  0EFF'                         HFC_AM:
  0EFF'   3A 2AD6'              	LDA	HFAMT
  0F02'   B7                    	ORA	A
  0F03'   C2 0F10'              	JNZ	HFC_HL
  0F06'   3A 0000*              	LDA	NEDIT
  0F09'   B7                    	ORA	A
  0F0A'   1F                    	RAR
  0F0B'   B7                    	ORA	A
  0F0C'   C2 0F10'              	JNZ	HFC_HL
  0F0F'   3C                    	INR	A		; at least one line
  0F10'                         HFC_HL:
  0F10'   6F                    	MOV	L,A
  0F11'   26 00                 	MVI	H,0
  0F13'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0F14'                         VC_REDR:
  0F14'   C3 06EF'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0F17'                         VC_G:
  0F17'   CD 07BE'              	CALL	SETMOV
  0F1A'   CD 0FD9'              	CALL	GZONE		; the screen's top line, before the move
  0F1D'   CD 0718'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0F20'   2A 2AC9'              	LHLD	CMDCNT
  0F23'   7C                    	MOV	A,H
  0F24'   B5                    	ORA	L
  0F25'   C2 0F38'              	JNZ	VG_N
  0F28'   AF                    	XRA	A		; forward
  0F29'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2C'   CD 074F'              	CALL	BRKOFF
  0F2F'   DA 0767'              	JC	BRKBAK
  0F32'   CD 0A87'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0F35'   C3 0FF1'              	JMP	GPLACE
  0F38'                         VG_N:
  0F38'   CD 06EF'              	CALL	GETCNT		; HL = target line (1-based)
  0F3B'                         VG_LN:
  0F3B'   CD 0F47'              	CALL	GOLN
  0F3E'   CD 074F'              	CALL	BRKOFF
  0F41'   DA 0767'              	JC	BRKBAK
  0F44'   C3 0FF1'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0F47'                         GOLN:
  0F47'   E5                    	PUSH	H
  0F48'   CD 0000*              	CALL	CNTLF
  0F4B'   23                    	INX	H		; HL = the cursor's line
  0F4C'   D1                    	POP	D		; DE = the line wanted
  0F4D'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0F50'   DA 0F5B'              	JC	GLN_BK
  0F53'   EB                    	XCHG
  0F54'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0F57'   AF                    	XRA	A
  0F58'   C3 0F60'              	JMP	GLN_MV
  0F5B'                         GLN_BK:
  0F5B'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0F5E'   3E FF                 	MVI	A,0FFH
  0F60'                         GLN_MV:
  0F60'   CD 0000*              	CALL	MVLIND
  0F63'   CD 0A81'              	CALL	ATEOF
  0F66'   DC 0A87'              	CC	LASTLN		; past the last line: onto it
  0F69'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0F6A'                         VC_LG:
  0F6A'   CD 07BE'              	CALL	SETMOV
  0F6D'   3A 2AF1'              	LDA	GSAVE
  0F70'   B7                    	ORA	A
  0F71'   C2 0F7A'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F74'   3E 01                 	MVI	A,PG
  0F76'   32 2AF0'              	STA	GPEND
  0F79'   C9                    	RET
  0F7A'                         VLG_GG:
  0F7A'   CD 0FD9'              	CALL	GZONE
  0F7D'   CD 0718'              	CALL	BRKON
  0F80'   CD 06EF'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F83'   C3 0F3B'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F86'                         SUB24:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F86'   4F                    	MOV	C,A
  0F87'   7D                    	MOV	A,L
  0F88'   93                    	SUB	E
  0F89'   6F                    	MOV	L,A
  0F8A'   7C                    	MOV	A,H
  0F8B'   9A                    	SBB	D
  0F8C'   67                    	MOV	H,A
  0F8D'   79                    	MOV	A,C
  0F8E'   98                    	SBB	B
  0F8F'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F90'                         CURFP:
  0F90'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F93'                         FPOS:
  0F93'   C5                    	PUSH	B
  0F94'   D5                    	PUSH	D
  0F95'   EB                    	XCHG
  0F96'   2A 0000*              	LHLD	TXTBEG
  0F99'   EB                    	XCHG
  0F9A'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F9D'   EB                    	XCHG			; DE = that
  0F9E'   2A 0000*              	LHLD	OUTPOS
  0FA1'   7C                    	MOV	A,H
  0FA2'   B7                    	ORA	A		; CY = 0
  0FA3'   1F                    	RAR
  0FA4'   47                    	MOV	B,A
  0FA5'   7D                    	MOV	A,L
  0FA6'   1F                    	RAR
  0FA7'   67                    	MOV	H,A
  0FA8'   3E 00                 	MVI	A,0
  0FAA'   1F                    	RAR
  0FAB'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0FAC'   19                    	DAD	D
  0FAD'   78                    	MOV	A,B
  0FAE'   CE 00                 	ACI	0		; A:HL = the position
  0FB0'   D1                    	POP	D
  0FB1'   C1                    	POP	B
  0FB2'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0FB3'                         ZSAVE:
  0FB3'   2A 2AC9'              	LHLD	CMDCNT
  0FB6'   22 2B2F'              	SHLD	ZSVCNT
  0FB9'   2A 0000*              	LHLD	AUXCNT
  0FBC'   22 2B31'              	SHLD	ZSVAUX
  0FBF'   3A 0000*              	LDA	DIRFLG
  0FC2'   32 2B33'              	STA	ZSVDIR
  0FC5'   C9                    	RET
  0FC6'                         ZREST:
  0FC6'   2A 2B2F'              	LHLD	ZSVCNT
  0FC9'   22 2AC9'              	SHLD	CMDCNT
  0FCC'   2A 2B31'              	LHLD	ZSVAUX
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FCF'   22 0000*              	SHLD	AUXCNT
  0FD2'   3A 2B33'              	LDA	ZSVDIR
  0FD5'   32 0000*              	STA	DIRFLG
  0FD8'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0FD9'                         GZONE:
  0FD9'   CD 0FB3'              	CALL	ZSAVE
  0FDC'   CD 0D65'              	CALL	CURRW
  0FDF'   6F                    	MOV	L,A
  0FE0'   26 00                 	MVI	H,0
  0FE2'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0FE5'   CD 0F93'              	CALL	FPOS
  0FE8'   22 0000*              	SHLD	ZTOP
  0FEB'   32 0002*              	STA	ZTOP+2
  0FEE'   C3 0FC6'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0FF1'                         GPLACE:
  0FF1'   CD 0FB3'              	CALL	ZSAVE
  0FF4'   CD 0F90'              	CALL	CURFP
  0FF7'   EB                    	XCHG
  0FF8'   2A 0000*              	LHLD	ZTOP
  0FFB'   EB                    	XCHG
  0FFC'   4F                    	MOV	C,A		; C:HL = the target's position
  0FFD'   3A 0002*              	LDA	ZTOP+2
  1000'   47                    	MOV	B,A		; B:DE = the top's
  1001'   79                    	MOV	A,C
  1002'   CD 0F86'              	CALL	SUB24
  1005'   22 2B2C'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1008'   DA 1055'              	JC	GP_UP
  100B'   B7                    	ORA	A
  100C'   C2 1096'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  100F'   3A 0000*              	LDA	NEDIT
  1012'   5F                    	MOV	E,A
  1013'   16 00                 	MVI	D,0
  1015'   B7                    	ORA	A
  1016'   1F                    	RAR
  1017'   6F                    	MOV	L,A
  1018'   26 00                 	MVI	H,0
  101A'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  101B'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  101E'   CD 06E8'              	CALL	GBSUB		; HL = bytes from there to the target
  1021'   EB                    	XCHG
  1022'   2A 2B2C'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1025'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1028'   DA 1096'              	JC	GP_MID
  102B'   CD 06E8'              	CALL	GBSUB		; HL = the top line's start (resident)
  102E'   01 0000               	LXI	B,0		; BC = lines from the top
  1031'                         GP_CNT:
  1031'   7A                    	MOV	A,D
  1032'   B3                    	ORA	E
  1033'   CA 1042'              	JZ	GP_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1036'   7E                    	MOV	A,M
  1037'   23                    	INX	H
  1038'   1B                    	DCX	D
  1039'   FE 0A                 	CPI	LF
  103B'   C2 1031'              	JNZ	GP_CNT
  103E'   03                    	INX	B
  103F'   C3 1031'              	JMP	GP_CNT
  1042'                         GP_DN:
  1042'   3A 0000*              	LDA	NEDIT
  1045'   3D                    	DCR	A
  1046'   5F                    	MOV	E,A
  1047'   16 00                 	MVI	D,0		; DE = the bottom row
  1049'   60                    	MOV	H,B
  104A'   69                    	MOV	L,C
  104B'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  104E'   DA 10A0'              	JC	GP_SET		; A = the bottom row
  1051'   7D                    	MOV	A,L		; on the screen: its row
  1052'   C3 10C0'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1055'                         GP_UP:
  1055'   3C                    	INR	A
  1056'   C2 1096'              	JNZ	GP_MID		; 64K bytes or more above
  1059'   2A 2B2C'              	LHLD	ZDIF
  105C'   EB                    	XCHG
  105D'   21 0000               	LXI	H,0
  1060'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1063'   7C                    	MOV	A,H
  1064'   B5                    	ORA	L
  1065'   CA 1096'              	JZ	GP_MID		; exactly 64K
  1068'   EB                    	XCHG			; DE = bytes to read
  1069'   AF                    	XRA	A
  106A'   32 2B2E'              	STA	ZLF
  106D'   CD 0000*              	CALL	RGET0
  1070'                         GP_RD:
  1070'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1073'   DA 1096'              	JC	GP_MID
  1076'   FE 0A                 	CPI	LF
  1078'   C2 108C'              	JNZ	GP_RN
  107B'   3A 0000*              	LDA	NEDIT
  107E'   B7                    	ORA	A
  107F'   1F                    	RAR
  1080'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1082'   E5                    	PUSH	H
  1083'   21 2B2E'              	LXI	H,ZLF
  1086'   34                    	INR	M
  1087'   BE                    	CMP	M		; CY iff more lines than that
  1088'   E1                    	POP	H
  1089'   DA 1096'              	JC	GP_MID
  108C'                         GP_RN:
  108C'   1B                    	DCX	D
  108D'   7A                    	MOV	A,D
  108E'   B3                    	ORA	E
  108F'   C2 1070'              	JNZ	GP_RD
  1092'   AF                    	XRA	A		; the top row
  1093'   C3 10A0'              	JMP	GP_SET
  1096'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                				;   adjacent, the A it computes is the row
  1096'   3E 01                 	MVI	A,1
  1098'   32 0000*              	STA	WFILL		; not past the end of the file
  109B'   3A 0000*              	LDA	NEDIT
  109E'   B7                    	ORA	A
  109F'   1F                    	RAR			; the middle row
  10A0'                         GP_SET:
  10A0'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  10A1'   26 00                 	MVI	H,0
  10A3'   22 0000*              	SHLD	WINROW
  10A6'   21 0000               	LXI	H,0
  10A9'   22 0000*              	SHLD	LNDLT
  10AC'   CD 07DF'              	CALL	SETFUL		; the window may have paged: full repaint
  10AF'                         GP_FIN:
  10AF'   CD 0FC6'              	CALL	ZREST
  10B2'   3A 2B57'              	LDA	GPKEEP
  10B5'   B7                    	ORA	A
  10B6'   CA 0898'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  10B9'   AF                    	XRA	A
  10BA'   32 2B57'              	STA	GPKEEP
  10BD'   C3 05E1'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  10C0'                         GP_ONS:
  10C0'   6F                    	MOV	L,A
  10C1'   26 00                 	MVI	H,0		; HL = the row it lands on
  10C3'   EB                    	XCHG
  10C4'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  10C7'   EB                    	XCHG
  10C8'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  10CB'   22 0000*              	SHLD	LNDLT
  10CE'   3E 01                 	MVI	A,R_MOVE
  10D0'   32 2ACD'              	STA	RINTENT
  10D3'   C3 10AF'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  10D6'                         OPPEND:
  10D6'   AF                    	XRA	A
  10D7'   32 2AF6'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  10DA'   3A 2AF3'              	LDA	PSAVE
  10DD'   FE 63                 	CPI	'c'
  10DF'   C2 10FC'              	JNZ	OPP_ND
  10E2'   79                    	MOV	A,C
  10E3'   FE 77                 	CPI	'w'
  10E5'   CA 10ED'              	JZ	OPP_W
  10E8'   FE 57                 	CPI	'W'
  10EA'   C2 10FC'              	JNZ	OPP_ND
  10ED'                         OPP_W:
  10ED'   CD 12CF'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  10F0'   DA 10FC'              	JC	OPP_ND
  10F3'   79                    	MOV	A,C
  10F4'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  10F6'   4F                    	MOV	C,A
  10F7'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  10F9'   32 2AF6'              	STA	CWEOL		;   char for the next word's: see ESTEP
  10FC'                         OPP_ND:
  10FC'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  10FD'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  10FF'   C2 1113'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1102'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1105'   DA 11A3'              	JC	OPABRT
  1108'   79                    	MOV	A,C
  1109'   FE 67                 	CPI	'g'
  110B'   C2 11A3'              	JNZ	OPABRT
  110E'   3E 01                 	MVI	A,PG
  1110'   32 2AF1'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1113'                         OPP_NG:
  1113'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1114'   21 2AF3'              	LXI	H,PSAVE
  1117'   BE                    	CMP	M
  1118'   CA 12F0'              	JZ	OPLINE
  111B'   79                    	MOV	A,C		; (OPCLS classifies the key)
  111C'   CD 1306'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  111F'   DA 11A3'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1122'   32 2AF5'              	STA	OPCLSV
  1125'   47                    	MOV	B,A		; B = the class
  1126'   3A 2AF3'              	LDA	PSAVE
  1129'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  112B'   C2 1137'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  112E'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  112F'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1131'   C2 1159'              	JNZ	OPP_GO
  1134'   C3 1142'              	JMP	OPP_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1137'                         OPP_NC:
  1137'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1139'   C2 1159'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  113C'   78                    	MOV	A,B		;   a charwise register would need a type flag
  113D'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  113F'   CA 1159'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1142'                         OPP_NO:
  1142'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1143'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1145'   CA 1153'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1148'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  114A'   CA 1153'              	JZ	OPP_SW		;   so swallow it before dropping the command
  114D'   CD 034A'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1150'   C2 11A3'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1153'                         OPP_SW:
  1153'   CD 021C'              	CALL	MKGETK
  1156'   C3 11A3'              	JMP	OPABRT
  1159'                         OPP_GO:
  1159'   AF                    	XRA	A
  115A'   32 2AD4'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  115D'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1160'   22 2AF7'              	SHLD	OPSTA
  1163'   C5                    	PUSH	B
  1164'   21 2AFB'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1167'   CD 044D'              	CALL	FPSTO		;   only good until the motion pages the window
  116A'   3A 2AF5'              	LDA	OPCLSV
  116D'   FE 02                 	CPI	2
  116F'   CC 11A6'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1172'   C1                    	POP	B
  1173'   21 29F7'              	LXI	H,CMDTAB
  1176'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1179'   3A 2AF3'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  117C'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  117D'   CA 07BE'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1180'   CD 11D2'              	CALL	OPSFIX		; where the start is in the window NOW
  1183'   D2 11EE'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1186'   22 2AF7'              	SHLD	OPSTA
  1189'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  118C'   22 2AF9'              	SHLD	OPEND2
  118F'   3A 2AF3'              	LDA	PSAVE
  1192'   FE 79                 	CPI	'y'
  1194'   CA 185C'              	JZ	OPYANK		; a yank takes the span without losing it
  1197'   CD 1341'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  119A'   3A 2AF3'              	LDA	PSAVE
  119D'   FE 63                 	CPI	'c'
  119F'   C0                    	RNZ
  11A0'   C3 1615'              	JMP	SETINS
  11A3'                         OPABRT:				; not a motion -> the operator is dropped and
  11A3'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  11A6'                         OPENDS:
  11A6'   2A 2AF7'              	LHLD	OPSTA
  11A9'   CD 0648'              	CALL	BOL
  11AC'   11 2AFE'              	LXI	D,OPSLO
  11AF'   CD 11C4'              	CALL	OPE_ST
  11B2'   2A 2AF7'              	LHLD	OPSTA
  11B5'   CD 0678'              	CALL	NLSTART
  11B8'   11 2B01'              	LXI	D,OPSHI
  11BB'   CD 11C4'              	CALL	OPE_ST
  11BE'   2A 2AF7'              	LHLD	OPSTA
  11C1'   C3 0000*              	JMP	GOTO
  11C4'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  11C4'   D5                    	PUSH	D
  11C5'   CD 0000*              	CALL	GOTO
  11C8'   E1                    	POP	H
  11C9'   C3 044D'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  11CC'                         CURBD:
  11CC'   CD 0F90'              	CALL	CURFP
  11CF'   EB                    	XCHG
  11D0'   47                    	MOV	B,A
  11D1'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  11D2'                         OPSFIX:
  11D2'   21 2AFB'              	LXI	H,OPSFP
  11D5'   CD 0400'              	CALL	MKLOAD
  11D8'   CD 11CC'              	CALL	CURBD
  11DB'   2A 2B61'              	LHLD	MKPOS
  11DE'   3A 2B63'              	LDA	MKPOS+2
  11E1'   CD 0F86'              	CALL	SUB24
  11E4'   B4                    	ORA	H
  11E5'   B5                    	ORA	L
  11E6'   C2 040D'              	JNZ	MKWIN
  11E9'   CD 0000*              	CALL	CUROFF
  11EC'   37                    	STC
  11ED'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  11EE'                         OPPGD:
  11EE'   47                    	MOV	B,A
  11EF'   3A 2AF5'              	LDA	OPCLSV
  11F2'   FE 02                 	CPI	2
  11F4'   C2 12B0'              	JNZ	OPG_NO
  11F7'   3A 2AF3'              	LDA	PSAVE
  11FA'   FE 64                 	CPI	'd'
  11FC'   C2 12B0'              	JNZ	OPG_NO
  11FF'   04                    	INR	B
  1200'   CA 120F'              	JZ	OPG_FW
  1203'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1206'   CD 0648'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1209'   CD 0000*              	CALL	GOTO
  120C'   C3 1227'              	JMP	OPG_GO
  120F'                         OPG_FW:
  120F'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1212'   CD 0678'              	CALL	NLSTART		;   landed on, and the low one is where the
  1215'   11 2B01'              	LXI	D,OPSHI		;   start line began
  1218'   CD 11C4'              	CALL	OPE_ST
  121B'   21 2AFE'              	LXI	H,OPSLO
  121E'   CD 0400'              	CALL	MKLOAD
  1221'   CD 03CD'              	CALL	MKPAGE
  1224'   CD 0000*              	CALL	GOTO
  1227'                         OPG_GO:
  1227'   CD 11CC'              	CALL	CURBD
  122A'   2A 2B01'              	LHLD	OPSHI
  122D'   3A 2B03'              	LDA	OPSHI+2
  1230'   CD 0F86'              	CALL	SUB24		; A:HL = the bytes to take
  1233'                         OPG_SV:
  1233'   22 2B04'              	SHLD	OPTOGO
  1236'   32 2B06'              	STA	OPTOGO+2
  1239'                         OPG_NX:
  1239'   CD 06CB'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  123C'   CD 0000*              	CALL	SUBHD
  123F'   EB                    	XCHG			; DE = what the window holds past the cursor
  1240'   2A 2B04'              	LHLD	OPTOGO
  1243'   3A 2B06'              	LDA	OPTOGO+2
  1246'   B7                    	ORA	A
  1247'   C2 127A'              	JNZ	OPG_PG		; 64K or more to go
  124A'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  124D'   DA 127A'              	JC	OPG_PG
  1250'   CA 127A'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1253'                         OPG_FN:				; the rest of it is here
  1253'   E5                    	PUSH	H
  1254'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1257'   CD 0000*              	CALL	CUROFF
  125A'   22 2B07'              	SHLD	OPLO
  125D'   D1                    	POP	D
  125E'   19                    	DAD	D
  125F'   22 2B09'              	SHLD	OPHI
  1262'   CD 1474'              	CALL	OPDSPN
  1265'   CD 0A81'              	CALL	ATEOF
  1268'   D2 12C9'              	JNC	OPMID
  126B'   CD 0EC3'              	CALL	ONFST		; deleted to the end of the file: onto the new
  126E'   CA 12C9'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1271'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1274'   CD 0000*              	CALL	SETBWD
  1277'   C3 12C9'              	JMP	OPMID
  127A'                         OPG_PG:
  127A'   7A                    	MOV	A,D
  127B'   B3                    	ORA	E
  127C'   C2 1295'              	JNZ	OPG_DL
  127F'   CD 0A81'              	CALL	ATEOF		; nothing held past the cursor
  1282'   21 0000               	LXI	H,0
  1285'   DA 1253'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1288'   2B                    	DCX	H
  1289'   CD 0000*              	CALL	SETC0
  128C'   CD 0000*              	CALL	GOLINE
  128F'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1292'   C3 1239'              	JMP	OPG_NX
  1295'                         OPG_DL:
  1295'   D5                    	PUSH	D
  1296'   21 FFFF               	LXI	H,0FFFFH
  1299'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  129C'   E1                    	POP	H
  129D'   E5                    	PUSH	H
  129E'   CD 0000*              	CALL	DELFWD
  12A1'   D1                    	POP	D
  12A2'   06 00                 	MVI	B,0
  12A4'   2A 2B04'              	LHLD	OPTOGO
  12A7'   3A 2B06'              	LDA	OPTOGO+2
  12AA'   CD 0F86'              	CALL	SUB24
  12AD'   C3 1233'              	JMP	OPG_SV
  12B0'                         OPG_NO:
  12B0'   0E 07                 	MVI	C,BEL
  12B2'   CD 0000*              	CALL	BCONOU
  12B5'                         OPG_HM:				; the cursor back where the command found it
  12B5'   21 2AFB'              	LXI	H,OPSFP
  12B8'   CD 0400'              	CALL	MKLOAD
  12BB'   CD 03CD'              	CALL	MKPAGE
  12BE'   CD 0000*              	CALL	GOTO
  12C1'   AF                    	XRA	A
  12C2'   32 2AF3'              	STA	PSAVE
  12C5'   3C                    	INR	A
  12C6'   32 2B57'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  12C9'                         OPMID:
  12C9'   CD 0FB3'              	CALL	ZSAVE
  12CC'   C3 1096'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  12CF'                         ONWHIT:
  12CF'   CD 06CB'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12D2'   CA 12EE'              	JZ	OW_YES
  12D5'   CD 06D6'              	CALL	CURCHR		; A = the char under the cursor
  12D8'   FE 20                 	CPI	' '
  12DA'   CA 12EE'              	JZ	OW_YES
  12DD'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12DF'   CA 12EE'              	JZ	OW_YES
  12E2'   FE 0D                 	CPI	CR
  12E4'   CA 12EE'              	JZ	OW_YES
  12E7'   FE 0A                 	CPI	LF
  12E9'   CA 12EE'              	JZ	OW_YES
  12EC'   B7                    	ORA	A		; a char to change: CY clear
  12ED'   C9                    	RET
  12EE'                         OW_YES:
  12EE'   37                    	STC
  12EF'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  12F0'                         OPLINE:
  12F0'   3A 2AF3'              	LDA	PSAVE
  12F3'   FE 63                 	CPI	'c'
  12F5'   CA 07BE'              	JZ	SETMOV
  12F8'   FE 79                 	CPI	'y'
  12FA'   CA 183B'              	JZ	VY_YY
  12FD'   21 2AFB'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1300'   CD 044D'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1303'   C3 17B1'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1306'                         OPCLS:
  1306'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1308'   CA 1315'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  130B'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  130D'   C2 1329'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1310'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1312'   C3 1317'              	JMP	OPC_FK
  1315'                         OPC_SEM:
  1315'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1317'                         OPC_FK:
  1317'   3A 2B4D'              	LDA	FNDKND
  131A'   B7                    	ORA	A
  131B'   37                    	STC
  131C'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  131D'   A8                    	XRA	B		; ... and now the direction ',' asked for
  131E'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1320'   CA 1327'              	JZ	OPC_EXC
  1323'   3E 01                 	MVI	A,1
  1325'   B7                    	ORA	A		; CY clear: a motion, class 1
  1326'   C9                    	RET
  1327'                         OPC_EXC:
  1327'   AF                    	XRA	A		; class 0, CY clear
  1328'   C9                    	RET
  1329'                         OPC_TB:
  1329'   47                    	MOV	B,A
  132A'   21 1509'              	LXI	H,OPCTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  132D'                         OPC_LP:
  132D'   7E                    	MOV	A,M
  132E'   B7                    	ORA	A
  132F'   CA 133F'              	JZ	OPC_MS		; end of table -> not a motion
  1332'   B8                    	CMP	B
  1333'   CA 133B'              	JZ	OPC_HT
  1336'   23                    	INX	H
  1337'   23                    	INX	H
  1338'   C3 132D'              	JMP	OPC_LP
  133B'                         OPC_HT:
  133B'   23                    	INX	H
  133C'   7E                    	MOV	A,M		; class byte
  133D'   B7                    	ORA	A		; clear CY
  133E'   C9                    	RET
  133F'                         OPC_MS:
  133F'   37                    	STC
  1340'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1341'                         OPAPPL:
  1341'   3A 2AF5'              	LDA	OPCLSV
  1344'   FE 02                 	CPI	2
  1346'   CA 14DD'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1349'   2A 2AF7'              	LHLD	OPSTA
  134C'   EB                    	XCHG			; DE = start
  134D'   2A 2AF9'              	LHLD	OPEND2		; HL = end
  1350'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1353'   DA 1366'              	JC	OPA_F
  1356'   CA 1366'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1359'   22 2B07'              	SHLD	OPLO
  135C'   EB                    	XCHG
  135D'   22 2B09'              	SHLD	OPHI
  1360'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1363'   C3 141D'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1366'                         OPA_F:
  1366'   EB                    	XCHG			; HL = start, DE = end
  1367'   22 2B07'              	SHLD	OPLO
  136A'   EB                    	XCHG			; HL = end
  136B'   3A 2AF5'              	LDA	OPCLSV
  136E'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1370'   CA 141A'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1373'   FE 01                 	CPI	1
  1375'   C2 1397'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1378'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1379'   22 2B09'              	SHLD	OPHI		; park it: CEND clobbers DE
  137C'   2B                    	DCX	H		; the line it landed on
  137D'   CD 1593'              	CALL	CEND		; HL = that line's content end
  1380'   EB                    	XCHG			; DE = it
  1381'   2A 2B09'              	LHLD	OPHI		; HL = hi
  1384'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1387'   D2 13A2'              	JNC	OPA_HI		; hi is inside the line: keep it
  138A'   2A 2B07'              	LHLD	OPLO
  138D'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1390'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1393'   EB                    	XCHG			; HL = the content end: the span stops there
  1394'   C3 13A2'              	JMP	OPA_HI
  1397'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1397'   22 2B09'              	SHLD	OPHI
  139A'   3A 2AD4'              	LDA	WPULL
  139D'   B7                    	ORA	A
  139E'   CA 141D'              	JZ	OPA_C1
  13A1'   23                    	INX	H
  13A2'                         OPA_HI:
  13A2'   22 2B09'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  13A5'                         OPA_DO:
  13A5'   CD 1469'              	CALL	OPSPNL
  13A8'   7C                    	MOV	A,H
  13A9'   B5                    	ORA	L
  13AA'   C2 13B3'              	JNZ	OPA_D1
  13AD'   2A 2B07'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  13B0'   C3 0000*              	JMP	GOTO		;   to where the span starts
  13B3'                         OPA_D1:
  13B3'   3A 2AF3'              	LDA	PSAVE
  13B6'   FE 63                 	CPI	'c'
  13B8'   CA 1474'              	JZ	OPDSPN
  13BB'   CD 145C'              	CALL	SPNBRK
  13BE'   D2 13DF'              	JNC	OPA_D2
  13C1'   2A 2B09'              	LHLD	OPHI
  13C4'   CD 1593'              	CALL	CEND
  13C7'   EB                    	XCHG			; DE = the content end of the line it ends in
  13C8'   2A 2B09'              	LHLD	OPHI
  13CB'                         OPA_BL:
  13CB'   CD 0000*              	CALL	CMP16
  13CE'   CA 13E5'              	JZ	OPA_BI		; only blanks after it
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13D1'   D5                    	PUSH	D
  13D2'   E5                    	PUSH	H
  13D3'   CD 0000*              	CALL	CHARAT
  13D6'   E1                    	POP	H
  13D7'   D1                    	POP	D
  13D8'   23                    	INX	H
  13D9'   CD 1414'              	CALL	BLANKQ
  13DC'   CA 13CB'              	JZ	OPA_BL
  13DF'                         OPA_D2:
  13DF'   CD 1474'              	CALL	OPDSPN
  13E2'   C3 15A4'              	JMP	CLAMPE
  13E5'                         OPA_BI:
  13E5'   CD 13F7'              	CALL	LOIND
  13E8'   C2 13DF'              	JNZ	OPA_D2
  13EB'   2A 2B09'              	LHLD	OPHI
  13EE'   CD 0678'              	CALL	NLSTART
  13F1'   22 2B09'              	SHLD	OPHI
  13F4'   C3 1448'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  13F7'                         LOIND:
  13F7'   2A 2B07'              	LHLD	OPLO
  13FA'   CD 0648'              	CALL	BOL
  13FD'                         LI_LP:
  13FD'   E5                    	PUSH	H
  13FE'   EB                    	XCHG
  13FF'   2A 2B07'              	LHLD	OPLO
  1402'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1405'   E1                    	POP	H
  1406'   C8                    	RZ
  1407'   E5                    	PUSH	H
  1408'   CD 0000*              	CALL	CHARAT
  140B'   E1                    	POP	H
  140C'   23                    	INX	H
  140D'   CD 1414'              	CALL	BLANKQ
  1410'   CA 13FD'              	JZ	LI_LP
  1413'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1414'                         BLANKQ:
  1414'   FE 20                 	CPI	' '
  1416'   C8                    	RZ
  1417'   FE 09                 	CPI	TAB
  1419'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  141A'                         OPA_JP:
  141A'   22 2B09'              	SHLD	OPHI
  141D'                         OPA_C1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  141D'   CD 1469'              	CALL	OPSPNL
  1420'   7C                    	MOV	A,H
  1421'   B5                    	ORA	L
  1422'   CA 13A5'              	JZ	OPA_DO		; nothing spanned
  1425'   2A 2B09'              	LHLD	OPHI
  1428'   CD 0648'              	CALL	BOL
  142B'   EB                    	XCHG
  142C'   2A 2B09'              	LHLD	OPHI
  142F'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1432'   C2 13A5'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1435'   CD 13F7'              	CALL	LOIND
  1438'   CA 1448'              	JZ	C1_LW		; only blanks before lo: whole lines
  143B'                         C1_CH:
  143B'   2A 2B09'              	LHLD	OPHI		; back over the line break to the content end
  143E'   2B                    	DCX	H		;   of the line before
  143F'   CD 1593'              	CALL	CEND
  1442'   22 2B09'              	SHLD	OPHI
  1445'   C3 13A5'              	JMP	OPA_DO
  1448'                         C1_LW:
  1448'   2A 2B07'              	LHLD	OPLO
  144B'   CD 0648'              	CALL	BOL
  144E'   22 2B07'              	SHLD	OPLO
  1451'   3A 2AF3'              	LDA	PSAVE
  1454'   FE 63                 	CPI	'c'
  1456'   CA 143B'              	JZ	C1_CH
  1459'   C3 14F0'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  145C'                         SPNBRK:
  145C'   2A 2B07'              	LHLD	OPLO
  145F'   CD 065B'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1462'   EB                    	XCHG			; DE = it
  1463'   2A 2B09'              	LHLD	OPHI
  1466'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1469'                         OPSPNL:
  1469'   2A 2B09'              	LHLD	OPHI
  146C'   EB                    	XCHG
  146D'   2A 2B07'              	LHLD	OPLO
  1470'   EB                    	XCHG			; HL = hi, DE = lo
  1471'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1474'                         OPDSPN:
  1474'   CD 145C'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1477'   F5                    	PUSH	PSW
  1478'   2A 2B07'              	LHLD	OPLO
  147B'   CD 0000*              	CALL	GOTO
  147E'   CD 1469'              	CALL	OPSPNL		; HL = hi - lo
  1481'   CD 0000*              	CALL	DELFWD
  1484'   CD 018C'              	CALL	MARKMOD
  1487'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1488'   DA 07DF'              	JC	SETFUL		; a break went: every row below it moved up
  148B'   C3 07C4'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  148E'                         UNDFNB:
  148E'   CD 0000*              	CALL	CUROFF
  1491'   E5                    	PUSH	H
  1492'   CD 0898'              	CALL	FNBLNK
  1495'   CD 0000*              	CALL	CUROFF
  1498'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  1499'   CD 0000*              	CALL	CMP16
  149C'   D2 0000*              	JNC	UNDHER
  149F'   EB                    	XCHG
  14A0'   CD 0000*              	CALL	GOTO
  14A3'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  14A6'                         OPALSP:
  14A6'   2A 2AF7'              	LHLD	OPSTA
  14A9'   EB                    	XCHG
  14AA'   2A 2AF9'              	LHLD	OPEND2
  14AD'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  14B0'   DA 14C0'              	JC	OPAL_F
  14B3'   22 2B07'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  14B6'   EB                    	XCHG
  14B7'   22 2B09'              	SHLD	OPHI		; hi-src = start
  14BA'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  14BD'   C3 14CA'              	JMP	OPAL_R
  14C0'                         OPAL_F:
  14C0'   EB                    	XCHG			; HL = start
  14C1'   22 2B07'              	SHLD	OPLO		; lo-src = start
  14C4'   2A 2AF9'              	LHLD	OPEND2
  14C7'   22 2B09'              	SHLD	OPHI		; hi-src = end
  14CA'                         OPAL_R:
  14CA'   2A 2B07'              	LHLD	OPLO
  14CD'   CD 0648'              	CALL	BOL
  14D0'   22 2B07'              	SHLD	OPLO		; lo = BOL(low line)
  14D3'   2A 2B09'              	LHLD	OPHI
  14D6'   CD 0678'              	CALL	NLSTART
  14D9'   22 2B09'              	SHLD	OPHI		; hi = start of line past the high line
  14DC'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  14DD'                         OPALIN:
  14DD'   CD 14A6'              	CALL	OPALSP
  14E0'   2A 2B07'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  14E3'   CD 0678'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  14E6'   EB                    	XCHG			;   the column)
  14E7'   2A 2B09'              	LHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14EA'   CD 0000*              	CALL	CMP16
  14ED'   CC 148E'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  14F0'                         OPDLIN:
  14F0'   CD 1474'              	CALL	OPDSPN
  14F3'   CD 06CB'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  14F6'   DA 1506'              	JC	OPDL_NB
  14F9'   CD 0000*              	CALL	LOGLEN
  14FC'   7C                    	MOV	A,H
  14FD'   B5                    	ORA	L
  14FE'   C8                    	RZ			; empty buffer
  14FF'   2B                    	DCX	H
  1500'   CD 0648'              	CALL	BOL
  1503'   CD 0000*              	CALL	GOTO
  1506'                         OPDL_NB:
  1506'   C3 0898'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1509'                         OPCTAB:
  1509'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  150D'   62 00 42 00           
  1511'   68 00 6C 00           
  1515'   30 00 5E 00           
  1519'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  151B'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  151F'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1523'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1527'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  152B'   24 01                 
  152D'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1531'   47 02 48 02           
  1535'   4D 02 4C 02           
  1539'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  153B'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  153D'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  153E'                         VCB_C:
  153E'   CD 154A'              	CALL	VCB_CD
  1541'   C3 1615'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1544'                         VCB_D:
  1544'   CD 154A'              	CALL	VCB_CD
  1547'   C3 15A4'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  154A'                         VCB_CD:
  154A'   CD 06E2'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  154D'   22 2B07'              	SHLD	OPLO
  1550'   CD 0000*              	CALL	CUROFF
  1553'   CD 1593'              	CALL	CEND		; to the line's content end, the CR,LF left
  1556'   22 2B09'              	SHLD	OPHI
  1559'   C3 1474'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  155C'                         VC_X:
  155C'   CD 094A'              	CALL	GLSTAL
  155F'   CD 07C4'              	CALL	SETLIN
  1562'   CD 06EF'              	CALL	GETCNT
  1565'   22 2B0B'              	SHLD	CNTV
  1568'   CD 0000*              	CALL	CUROFF
  156B'   22 2B0F'              	SHLD	WKI		; cur
  156E'   CD 1593'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1571'   EB                    	XCHG			; DE = contentend
  1572'   2A 2B0F'              	LHLD	WKI		; HL = cur
  1575'   EB                    	XCHG			; HL = contentend, DE = cur
  1576'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1579'   7C                    	MOV	A,H
  157A'   B5                    	ORA	L
  157B'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  157C'   EB                    	XCHG			; DE = available
  157D'   2A 2B0B'              	LHLD	CNTV		; HL = count
  1580'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1583'   DA 1589'              	JC	VX_USEA
  1586'   C3 158A'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1589'                         VX_USEA:
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1589'   EB                    	XCHG			; HL = available
  158A'                         VX_DEL:
  158A'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  158D'   CD 018C'              	CALL	MARKMOD
  1590'   C3 15A4'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1593'                         CEND:
  1593'   CD 065B'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1596'   7C                    	MOV	A,H
  1597'   B5                    	ORA	L
  1598'   C8                    	RZ			; the start of the text: nothing before it
  1599'   2B                    	DCX	H
  159A'   E5                    	PUSH	H
  159B'   CD 0000*              	CALL	CHARAT
  159E'   E1                    	POP	H		; HL = term-1
  159F'   FE 0D                 	CPI	CR
  15A1'   C8                    	RZ			; a CR before the LF -> the content ends there
  15A2'   23                    	INX	H
  15A3'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  15A4'                         CLAMPE:
  15A4'   CD 0000*              	CALL	CUROFF
  15A7'   E5                    	PUSH	H
  15A8'   CD 0687'              	CALL	EOLC
  15AB'   D1                    	POP	D		; DE = cur
  15AC'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  15AF'   D8                    	RC
  15B0'   C8                    	RZ
  15B1'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  15B4'                         VC_I:
  15B4'   CD 06EF'              	CALL	GETCNT
  15B7'   C3 1612'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  15BA'                         VC_A:
  15BA'   CD 06EF'              	CALL	GETCNT
  15BD'   CD 06CB'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15C0'   CA 15D7'              	JZ	VA_INS
  15C3'   EB                    	XCHG			; HL = cur
  15C4'   E5                    	PUSH	H
  15C5'   CD 0000*              	CALL	CHARAT
  15C8'   E1                    	POP	H
  15C9'   FE 0A                 	CPI	LF
  15CB'   CA 15D7'              	JZ	VA_INS		; on the line terminator -> append in place
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15CE'   FE 0D                 	CPI	CR
  15D0'   CA 15D7'              	JZ	VA_INS
  15D3'   23                    	INX	H
  15D4'   CD 0000*              	CALL	GOTO
  15D7'                         VA_INS:
  15D7'   C3 1612'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  15DA'                         VCB_A:
  15DA'   CD 06E2'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15DD'   CD 0687'              	CALL	EOLC		; HL = last content char (the start when empty)
  15E0'   E5                    	PUSH	H
  15E1'   CD 0000*              	CALL	CHARAT
  15E4'   E1                    	POP	H
  15E5'   FE 0D                 	CPI	CR
  15E7'   CA 15F0'              	JZ	VBA_IN		; an empty line: insert at its start
  15EA'   FE 0A                 	CPI	LF
  15EC'   CA 15F0'              	JZ	VBA_IN
  15EF'   23                    	INX	H		; past the last content char
  15F0'                         VBA_IN:
  15F0'   CD 0000*              	CALL	GOTO
  15F3'   C3 1612'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  15F6'                         VCB_I:
  15F6'   CD 06EF'              	CALL	GETCNT
  15F9'   CD 0898'              	CALL	FNBLNK
  15FC'   CD 0000*              	CALL	CUROFF
  15FF'   E5                    	PUSH	H
  1600'   CD 0000*              	CALL	CHARAT
  1603'   E1                    	POP	H
  1604'   FE 20                 	CPI	' '
  1606'   CA 160E'              	JZ	VBI_SK
  1609'   FE 09                 	CPI	TAB
  160B'   C2 1612'              	JNZ	SETINM
  160E'                         VBI_SK:
  160E'   23                    	INX	H		; blanks only: past the last of them
  160F'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1612'                         SETINM:
  1612'   CD 07BE'              	CALL	SETMOV
  1615'                         SETINS:
  1615'   3E 01                 	MVI	A,EM_INS
  1617'   32 2AC8'              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  161A'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  161B'                         ATCEND:
  161B'   CD 06CB'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  161E'   C8                    	RZ
  161F'   CD 06D6'              	CALL	CURCHR		; A = the char under the cursor
  1622'   FE 0D                 	CPI	CR
  1624'   C8                    	RZ
  1625'   FE 0A                 	CPI	LF
  1627'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1628'                         OPNBRK:
  1628'   CD 1F38'              	CALL	PUTBRK
  162B'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  162E'   23                    	INX	H
  162F'   22 0000*              	SHLD	LNDLT
  1632'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1635'                         ENDBRK:
  1635'   CD 06CB'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1638'   C0                    	RNZ
  1639'   CD 1628'              	CALL	OPNBRK
  163C'   CD 0000*              	CALL	CUROFF
  163F'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1640'   2B                    	DCX	H		;   line, with its own terminator after it
  1641'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1644'                         VC_O:
  1644'   CD 06E2'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1647'   CD 1593'              	CALL	CEND
  164A'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  164D'   CD 1628'              	CALL	OPNBRK
  1650'   CD 1635'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1653'   CD 07CA'              	CALL	SETILN		;   needs a terminator of its own to exist
  1656'   C3 1615'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1659'                         VCB_O:
  1659'   CD 06E2'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  165C'   CD 0648'              	CALL	BOL
  165F'   CD 0000*              	CALL	GOTO
  1662'   CD 1628'              	CALL	OPNBRK
  1665'   CD 0000*              	CALL	CUROFF
  1668'   2B                    	DCX	H
  1669'   2B                    	DCX	H
  166A'   CD 0000*              	CALL	GOTO
  166D'   CD 07CA'              	CALL	SETILN
  1670'   C3 1615'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1673'                         VCB_J:
  1673'   CD 06E2'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1676'   CD 1593'              	CALL	CEND		; the join point: this line's content end
  1679'   22 2B07'              	SHLD	OPLO
  167C'   CD 0000*              	CALL	CUROFF
  167F'   CD 0678'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1682'   E5                    	PUSH	H
  1683'   CD 0000*              	CALL	LOGLEN
  1686'   D1                    	POP	D		; DE = that start
  1687'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  168A'   CA 07BE'              	JZ	SETMOV
  168D'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  168E'                         VJ_WS:
  168E'   E5                    	PUSH	H
  168F'   CD 0000*              	CALL	LOGLEN
  1692'   D1                    	POP	D		; DE = the scan
  1693'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1696'   CA 16AD'              	JZ	VJ_DEL
  1699'   EB                    	XCHG			; HL = the scan
  169A'   E5                    	PUSH	H
  169B'   CD 0000*              	CALL	CHARAT
  169E'   E1                    	POP	H
  169F'   FE 20                 	CPI	' '
  16A1'   CA 16A9'              	JZ	VJ_SKIP
  16A4'   FE 09                 	CPI	TAB
  16A6'   C2 16AD'              	JNZ	VJ_DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16A9'                         VJ_SKIP:
  16A9'   23                    	INX	H
  16AA'   C3 168E'              	JMP	VJ_WS
  16AD'                         VJ_DEL:
  16AD'   22 2B09'              	SHLD	OPHI
  16B0'   CD 1474'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  16B3'   CD 07D9'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  16B6'   CD 06CB'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  16B9'   CA 15A4'              	JZ	CLAMPE
  16BC'   CD 06D6'              	CALL	CURCHR		; the first char of what was appended
  16BF'   FE 0D                 	CPI	CR
  16C1'   CA 15A4'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  16C4'   FE 0A                 	CPI	LF
  16C6'   CA 15A4'              	JZ	CLAMPE
  16C9'   FE 29                 	CPI	')'
  16CB'   CA 15A4'              	JZ	CLAMPE		; vim puts no space before a ')'
  16CE'   CD 0000*              	CALL	CUROFF
  16D1'   7C                    	MOV	A,H
  16D2'   B5                    	ORA	L
  16D3'   CA 16E9'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  16D6'   2B                    	DCX	H
  16D7'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  16DA'   FE 20                 	CPI	' '
  16DC'   CA 15A4'              	JZ	CLAMPE
  16DF'   FE 09                 	CPI	TAB
  16E1'   CA 15A4'              	JZ	CLAMPE
  16E4'   FE 0A                 	CPI	LF
  16E6'   CA 15A4'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  16E9'                         VJ_SP:
  16E9'   3E 20                 	MVI	A,' '
  16EB'   CD 0000*              	CALL	PUTGAP
  16EE'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16F1'   2B                    	DCX	H
  16F2'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  16F5'                         VC_TILD:
  16F5'   CD 06EF'              	CALL	GETCNT
  16F8'   CD 07C4'              	CALL	SETLIN		; only this row changes
  16FB'   CD 094A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16FE'   CD 06CB'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1701'   CA 07BE'              	JZ	SETMOV
  1704'   CD 06D6'              	CALL	CURCHR		; A = the char under the cursor
  1707'   FE 0D                 	CPI	CR
  1709'   CA 07BE'              	JZ	SETMOV		; the line's end: nothing to toggle
  170C'   FE 0A                 	CPI	LF
  170E'   CA 07BE'              	JZ	SETMOV
  1711'   47                    	MOV	B,A
  1712'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1714'   FE 41                 	CPI	'A'
  1716'   DA 1722'              	JC	VT_PUT		; below 'A': no case
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1719'   FE 5B                 	CPI	'Z'+1
  171B'   D2 1722'              	JNC	VT_PUT		; above 'Z': no case
  171E'   78                    	MOV	A,B
  171F'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1721'   47                    	MOV	B,A
  1722'                         VT_PUT:
  1722'   78                    	MOV	A,B
  1723'   32 2B18'              	STA	VRCH		; the calls below do not preserve B
  1726'   CD 018C'              	CALL	MARKMOD
  1729'   21 0001               	LXI	H,1
  172C'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  172F'   3A 2B18'              	LDA	VRCH
  1732'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1735'   C3 15A4'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1738'                         VC_R:
  1738'   CD 06DC'              	CALL	MOVCNT		; a cursor motion, and its count
  173B'   3E 03                 	MVI	A,PR
  173D'   32 2AF0'              	STA	GPEND
  1740'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1741'                         VR_DO:
  1741'   AF                    	XRA	A
  1742'   32 2AF0'              	STA	GPEND
  1745'   79                    	MOV	A,C
  1746'   32 2B18'              	STA	VRCH		; the calls below do not preserve C
  1749'   CD 07C4'              	CALL	SETLIN		; only this row changed
  174C'   CD 094A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  174F'   CD 06CB'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1752'   CA 07BE'              	JZ	SETMOV		; the end of the text: vim does nothing
  1755'   CD 06D6'              	CALL	CURCHR		; A = the char under the cursor
  1758'   FE 0D                 	CPI	CR
  175A'   CA 07BE'              	JZ	SETMOV		; the line's end: nothing to replace
  175D'   FE 0A                 	CPI	LF
  175F'   CA 07BE'              	JZ	SETMOV
  1762'   CD 018C'              	CALL	MARKMOD
  1765'   21 0001               	LXI	H,1
  1768'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  176B'   3A 2B18'              	LDA	VRCH
  176E'   FE 0D                 	CPI	CR
  1770'   CA 177D'              	JZ	VR_CR
  1773'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1776'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1779'   2B                    	DCX	H		;   out, which moves every logical offset
  177A'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  177D'                         VR_CR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  177D'   CD 1628'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1780'   CD 1635'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1783'   CD 07CA'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1786'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1788'   32 2AD0'              	STA	ILABOV
  178B'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  178C'                         VCB_R:
  178C'   CD 06EF'              	CALL	GETCNT
  178F'   CD 07BE'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1792'   21 0000               	LXI	H,0
  1795'   22 2B19'              	SHLD	RPDEL		; nothing of ours to put back yet
  1798'   22 2B1B'              	SHLD	RPAPP
  179B'   3E 02                 	MVI	A,EM_REP
  179D'   32 2AC8'              	STA	EDMODE
  17A0'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  17A1'                         VC_D:
  17A1'   3E 64                 	MVI	A,'d'
  17A3'   32 2AF2'              	STA	PENDOP
  17A6'   C3 07BE'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  17A9'                         VC_C:
  17A9'   3E 63                 	MVI	A,'c'
  17AB'   32 2AF2'              	STA	PENDOP
  17AE'   C3 07BE'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  17B1'                         VD_DD:
  17B1'   CD 094A'              	CALL	GLSTAL
  17B4'   CD 06EF'              	CALL	GETCNT
  17B7'   22 2B0B'              	SHLD	CNTV
  17BA'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  17BC'   32 2AF4'              	STA	DDSNG
  17BF'   2B                    	DCX	H
  17C0'   7C                    	MOV	A,H
  17C1'   B5                    	ORA	L
  17C2'   C2 17D0'              	JNZ	VDD_LS
  17C5'   3E 01                 	MVI	A,1
  17C7'   32 2AF4'              	STA	DDSNG
  17CA'   CD 148E'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  17CD'   C3 17D6'              	JMP	VDD_GO
  17D0'                         VDD_LS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17D0'   CD 0903'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  17D3'   DA 07BE'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  17D6'                         VDD_GO:
  17D6'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17D9'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  17DC'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  17DF'   CD 219B'              	CALL	COPY12		;   every mark in the lines has closed up by then
  17E2'   CD 0881'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  17E5'   2A 2B0B'              	LHLD	CNTV
  17E8'   CD 0000*              	CALL	SETC0
  17EB'                         VDD_FW:
  17EB'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  17EE'   DA 193C'              	JC	QREFUS		; ... which has no room for them
  17F1'   CD 0704'              	CALL	CNTTST
  17F4'   C2 17EB'              	JNZ	VDD_FW
  17F7'   CD 018C'              	CALL	MARKMOD
  17FA'   CD 0A81'              	CALL	ATEOF
  17FD'   D2 1818'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1800'   3E 00                 	MVI	A,0
  1802'   32 2AF4'              	STA	DDSNG		; deleted to the end: full repaint
  1805'   CD 0EC3'              	CALL	ONFST
  1808'   CA 0898'              	JZ	FNBLNK		; nothing left before it
  180B'   21 0001               	LXI	H,1		; onto the new last line
  180E'   CD 0000*              	CALL	SETBWD
  1811'   2A 0000*              	LHLD	LNDLT
  1814'   2B                    	DCX	H
  1815'   22 0000*              	SHLD	LNDLT
  1818'                         VDD_UP:
  1818'   CD 0898'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  181B'   3A 2AF4'              	LDA	DDSNG
  181E'   B7                    	ORA	A
  181F'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1820'   3E 03                 	MVI	A,R_DLIN
  1822'   32 2ACD'              	STA	RINTENT
  1825'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1826'                         QEMPTY:
  1826'   2A 0000*              	LHLD	QBEG
  1829'   EB                    	XCHG
  182A'   2A 0000*              	LHLD	QEND
  182D'   7C                    	MOV	A,H
  182E'   BA                    	CMP	D
  182F'   C0                    	RNZ
  1830'   7D                    	MOV	A,L
  1831'   BB                    	CMP	E
  1832'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1833'                         VC_Y:
  1833'   3E 79                 	MVI	A,'y'
  1835'   32 2AF2'              	STA	PENDOP
  1838'   C3 07BE'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  183B'                         VY_YY:
  183B'   21 2AFB'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  183E'   CD 044D'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1841'   CD 0000*              	CALL	CUROFF
  1844'   22 2B3C'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1847'   CD 0648'              	CALL	BOL
  184A'   22 2B3E'              	SHLD	YPT		; where the lines come from, to put them back
  184D'   CD 19A2'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1850'   CD 19E5'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1853'   D2 19A9'              	JNC	YNDONE
  1856'   21 17B1'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1859'   C3 1885'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  185C'                         OPYANK:
  185C'   CD 14A6'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  185F'   2A 2AF7'              	LHLD	OPSTA
  1862'   EB                    	XCHG			; DE = start
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1863'   2A 2AF9'              	LHLD	OPEND2		; HL = end
  1866'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1869'   D2 186D'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  186C'   EB                    	XCHG			; ... otherwise the start is
  186D'                         OPY_LO:
  186D'   22 2B3C'              	SHLD	YOFF
  1870'   2A 2B07'              	LHLD	OPLO
  1873'   22 2B3E'              	SHLD	YPT		; where the lines come from, to put them back
  1876'   CD 19A2'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1879'   CD 1A5D'              	CALL	YNSPAN		; copied where they lie, if there is room
  187C'   D2 19A9'              	JNC	YNDONE
  187F'   21 1963'              	LXI	H,YSPAN
  1882'   C3 1885'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1885'                         YKGO:
  1885'   22 2B66'              	SHLD	YACT
  1888'   2A 2B3E'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  188B'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  188C'   2A 2B3C'              	LHLD	YOFF		;   survive this -- the put-back below can page
  188F'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1892'   22 2B6C'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1895'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1898'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1899'   2A 2B3E'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  189C'   EB                    	XCHG			;   window as it was, then names other text
  189D'   E1                    	POP	H
  189E'   CD 0000*              	CALL	SUBHD
  18A1'   EB                    	XCHG			; DE = how far behind the cursor they start
  18A2'   CD 0F90'              	CALL	CURFP
  18A5'   06 00                 	MVI	B,0
  18A7'   CD 0F86'              	CALL	SUB24
  18AA'   22 2B6E'              	SHLD	YPFP
  18AD'   32 2B70'              	STA	YPFP+2
  18B0'   3A 2ACC'              	LDA	MODF
  18B3'   32 2B39'              	STA	YMODF
  18B6'   3A 2AE5'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  18B9'   32 2B3A'              	STA	YDCHG		;   a yank must not become the last change
  18BC'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  18BF'   32 2B3B'              	STA	YURPL		;   back are not a change to undo either
  18C2'   3E 01                 	MVI	A,1
  18C4'   32 0000*              	STA	UNDRPL
  18C7'   32 2B65'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  18CA'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  18CD'   22 2B48'              	SHLD	YLDLT
  18D0'   CD 0000*              	CALL	LOGLEN
  18D3'   22 2B6A'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  18D6'   2A 2B66'              	LHLD	YACT
  18D9'   CD 193B'              	CALL	YCALL		; the lines out of the file, into the register
  18DC'   3A 2B34'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  18DF'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  18E1'   CA 191F'              	JZ	YK_RF		;   cursor: only the flags are still owed
  18E4'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18E7'   EB                    	XCHG
  18E8'   2A 2B6A'              	LHLD	YWAS
  18EB'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  18EE'   CA 1900'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  18F1'   21 2B6E'              	LXI	H,YPFP		; back to where they came from, by its place in
  18F4'   CD 0400'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  18F7'   CD 03CD'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  18FA'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  18FD'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1900'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1900'   2A 2B6E'              	LHLD	YPFP		;   cursor is still owed its place)
  1903'   EB                    	XCHG
  1904'   2A 2B6C'              	LHLD	YCOL
  1907'   19                    	DAD	D
  1908'   22 2B61'              	SHLD	MKPOS
  190B'   3A 2B70'              	LDA	YPFP+2
  190E'   CE 00                 	ACI	0
  1910'   32 2B63'              	STA	MKPOS+2
  1913'   CD 03CD'              	CALL	MKPAGE
  1916'   CD 0000*              	CALL	GOTO
  1919'                         YK_RST:
  1919'   2A 2B48'              	LHLD	YLDLT
  191C'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  191F'                         YK_RF:
  191F'   3A 2B39'              	LDA	YMODF
  1922'   32 2ACC'              	STA	MODF
  1925'   3A 2B3A'              	LDA	YDCHG
  1928'   32 2AE5'              	STA	DOTCHG
  192B'   3A 2B3B'              	LDA	YURPL
  192E'   32 0000*              	STA	UNDRPL
  1931'   AF                    	XRA	A
  1932'   32 2B65'              	STA	MKHOLD
  1935'   CD 094A'              	CALL	GLSTAL
  1938'   C3 07DF'              	JMP	SETFUL		; the cheap paint cannot carry this
  193B'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ; and the cursor goes back where it started, as OPG_NO puts it.
  193C'                         QREFUS:
  193C'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  193F'   CD 1826'              	CALL	QEMPTY
  1942'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1945'   CD 0000*              	CALL	QKILL
  1948'   3A 2B65'              	LDA	MKHOLD
  194B'   B7                    	ORA	A
  194C'   C2 195B'              	JNZ	QRF_Y
  194F'   21 0000*              	LXI	H,MKSAV
  1952'   11 0000*              	LXI	D,MKTAB
  1955'   CD 219B'              	CALL	COPY12
  1958'   CD 0000*              	CALL	UNDCLR
  195B'                         QRF_Y:
  195B'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  195D'   32 2B34'              	STA	MSGWHT
  1960'   C3 12B5'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1963'                         YSPAN:
  1963'   CD 094A'              	CALL	GLSTAL
  1966'   CD 1469'              	CALL	OPSPNL		; HL = the span's length
  1969'   22 2B68'              	SHLD	YTGT
  196C'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  196F'   EB                    	XCHG			; DE = it
  1970'   2A 2B68'              	LHLD	YTGT
  1973'   EB                    	XCHG			; HL = the text's, DE = the span's
  1974'   CD 0000*              	CALL	SUBHD
  1977'   22 2B68'              	SHLD	YTGT		; what the text is left at when the span is out
  197A'   2A 2B07'              	LHLD	OPLO
  197D'   CD 0000*              	CALL	GOTO
  1980'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1983'                         YS_LP:
  1983'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1986'   CD 0000*              	CALL	SETC0
  1989'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  198C'   DA 193C'              	JC	QREFUS		; ... which has no room for it
  198F'   CD 0000*              	CALL	LOGLEN
  1992'   EB                    	XCHG			; DE = what is left
  1993'   2A 2B68'              	LHLD	YTGT
  1996'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1999'   DA 199F'              	JC	YS_END		; below it -- cannot happen over whole lines,
  199C'   C2 1983'              	JNZ	YS_LP		;   but never spin here if it ever did
  199F'                         YS_END:
  199F'   C3 018C'              	JMP	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  19A2'                         YNPRE:
  19A2'   2A 0000*              	LHLD	PGTOPM
  19A5'   22 2B71'              	SHLD	YNPG
  19A8'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  19A9'                         YNDONE:
  19A9'   2A 2B3C'              	LHLD	YOFF
  19AC'   CD 0000*              	CALL	GOTO
  19AF'   2A 0000*              	LHLD	PGTOPM
  19B2'   EB                    	XCHG
  19B3'   2A 2B71'              	LHLD	YNPG
  19B6'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  19B9'   C2 07DF'              	JNZ	SETFUL		; it moved under us: repaint after all
  19BC'   C3 07BE'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  19BF'                         YNROOM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19BF'   11 0100               	LXI	D,100H
  19C2'   19                    	DAD	D
  19C3'   D8                    	RC			; within a chunk of 64K: no arena holds that
  19C4'   E5                    	PUSH	H		; the span plus its slack
  19C5'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  19C8'   EB                    	XCHG			; HL = free
  19C9'   D1                    	POP	D		; DE = the span plus its slack
  19CA'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  19CD'   DA 19D5'              	JC	YNR_OK
  19D0'   CA 19D5'              	JZ	YNR_OK
  19D3'   37                    	STC			; not enough: the delete-and-put-back path
  19D4'   C9                    	RET
  19D5'                         YNR_OK:
  19D5'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  19D6'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  19D7'                         YNGO:
  19D7'   C5                    	PUSH	B
  19D8'   CD 06EF'              	CALL	GETCNT		; spent here: this yank is happening
  19DB'   CD 094A'              	CALL	GLSTAL
  19DE'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  19E1'   C1                    	POP	B
  19E2'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  19E5'                         YNCOPY:
  19E5'   2A 2AC9'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  19E8'   7C                    	MOV	A,H		;   the count itself
  19E9'   B5                    	ORA	L
  19EA'   C2 19F0'              	JNZ	YNC_HV
  19ED'   21 0001               	LXI	H,1
  19F0'                         YNC_HV:
  19F0'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  19F1'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  19F2'   B4                    	ORA	H
  19F3'   CA 19FE'              	JZ	YNC_M
  19F6'   E5                    	PUSH	H
  19F7'   CD 0903'              	CALL	ONLAST		; vim: a count over one on the last line does
  19FA'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  19FB'   DA 1A10'              	JC	YNC_RF
  19FE'                         YNC_M:
  19FE'   E5                    	PUSH	H
  19FF'   CD 0881'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1A02'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A03'   CD 1A18'              	CALL	YNLINE		; BC = the span, measured where it stands
  1A06'   D8                    	RC			; not measurable here: let the pager answer it
  1A07'   60                    	MOV	H,B
  1A08'   69                    	MOV	L,C
  1A09'   CD 19BF'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1A0C'   D8                    	RC			; no: the delete-and-put-back path
  1A0D'   C3 19D7'              	JMP	YNGO
  1A10'                         YNC_RF:
  1A10'   CD 06EF'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1A13'   CD 094A'              	CALL	GLSTAL		;   register alone, and that is the command
  1A16'   B7                    	ORA	A		; NC: done
  1A17'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1A18'                         YNLINE:
  1A18'   22 2B73'              	SHLD	YNCNT		; the lines it still wants
  1A1B'   2A 0000*              	LHLD	GAPEND
  1A1E'                         YNL_LP:
  1A1E'   EB                    	XCHG			; DE = the scan
  1A1F'   2A 0000*              	LHLD	TXTEND
  1A22'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1A25'   EB                    	XCHG			; HL = the scan
  1A26'   D2 1A46'              	JNC	YNL_EN		; the resident text ran out
  1A29'   7E                    	MOV	A,M
  1A2A'   23                    	INX	H
  1A2B'   FE 0A                 	CPI	LF
  1A2D'   C2 1A1E'              	JNZ	YNL_LP
  1A30'   E5                    	PUSH	H
  1A31'   2A 2B73'              	LHLD	YNCNT
  1A34'   2B                    	DCX	H
  1A35'   22 2B73'              	SHLD	YNCNT
  1A38'   7C                    	MOV	A,H
  1A39'   B5                    	ORA	L
  1A3A'   E1                    	POP	H
  1A3B'   C2 1A1E'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1A3E'   EB                    	XCHG			; DE = past the last of them
  1A3F'   2A 0000*              	LHLD	GAPEND
  1A42'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1A43'   C3 1A54'              	JMP	YNL_BC
  1A46'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1A46'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1A49'   C2 1A5B'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1A4C'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1A4F'   EB                    	XCHG			;   count clamps to it as vim's does
  1A50'   2A 0000*              	LHLD	GAPEND
  1A53'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1A54'                         YNL_BC:
  1A54'   CD 0000*              	CALL	SUBHD		; HL = the span
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A57'   44                    	MOV	B,H
  1A58'   4D                    	MOV	C,L
  1A59'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1A5A'   C9                    	RET
  1A5B'                         YNL_NO:
  1A5B'   37                    	STC
  1A5C'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1A5D'                         YNSPAN:
  1A5D'   CD 1469'              	CALL	OPSPNL		; HL = the span's length
  1A60'   44                    	MOV	B,H
  1A61'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1A62'   CD 19BF'              	CALL	YNROOM
  1A65'   D8                    	RC			; no room: the delete-and-put-back path
  1A66'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1A67'   2A 2B07'              	LHLD	OPLO
  1A6A'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1A6D'   C1                    	POP	B
  1A6E'   C3 19D7'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1A71'                         VC_P:
  1A71'   CD 1826'              	CALL	QEMPTY
  1A74'   CA 1B47'              	JZ	VP_BEL
  1A77'   CD 06EF'              	CALL	GETCNT
  1A7A'   22 2B40'              	SHLD	PCNT
  1A7D'   CD 0000*              	CALL	CUROFF
  1A80'   CD 0678'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1A83'   C3 1A98'              	JMP	VP_GO
  1A86'                         VCB_P:
  1A86'   CD 1826'              	CALL	QEMPTY
  1A89'   CA 1B47'              	JZ	VP_BEL
  1A8C'   CD 06EF'              	CALL	GETCNT
  1A8F'   22 2B40'              	SHLD	PCNT
  1A92'   CD 0000*              	CALL	CUROFF
  1A95'   CD 0648'              	CALL	BOL
  1A98'                         VP_GO:
  1A98'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1A9B'   CD 0000*              	CALL	CUROFF
  1A9E'   EB                    	XCHG
  1A9F'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1AA2'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1AA5'   DA 1ABA'              	JC	VP_IN
  1AA8'   EB                    	XCHG			; HL = the put point = LOGLEN
  1AA9'   7C                    	MOV	A,H
  1AAA'   B5                    	ORA	L
  1AAB'   CA 1AB7'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AAE'   2B                    	DCX	H
  1AAF'   CD 0000*              	CALL	CHARAT
  1AB2'   FE 0A                 	CPI	LF
  1AB4'   CA 1ABA'              	JZ	VP_IN
  1AB7'                         VP_BRK:
  1AB7'   CD 1628'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1ABA'                         VP_IN:
  1ABA'   21 2B42'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1ABD'   CD 044D'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1AC0'   CD 0FD9'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1AC3'   2A 0000*              	LHLD	QBEG
  1AC6'   EB                    	XCHG
  1AC7'   2A 0000*              	LHLD	QEND
  1ACA'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1ACD'   EB                    	XCHG
  1ACE'   22 2B45'              	SHLD	PLFS
  1AD1'   2A 2B40'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1AD4'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1AD5'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1AD6'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1AD8'   C2 1ADC'              	JNZ	VP_PZ
  1ADB'   7D                    	MOV	A,L
  1ADC'                         VP_PZ:
  1ADC'   32 2B47'              	STA	PCPY
  1ADF'                         VP_LP:
  1ADF'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1AE2'   2A 0000*              	LHLD	LNDLT
  1AE5'   EB                    	XCHG
  1AE6'   2A 2B45'              	LHLD	PLFS
  1AE9'   19                    	DAD	D
  1AEA'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1AED'   2A 2B40'              	LHLD	PCNT
  1AF0'   2B                    	DCX	H
  1AF1'   22 2B40'              	SHLD	PCNT
  1AF4'   7C                    	MOV	A,H
  1AF5'   B5                    	ORA	L
  1AF6'   C2 1ADF'              	JNZ	VP_LP
  1AF9'   CD 018C'              	CALL	MARKMOD
  1AFC'   21 2B42'              	LXI	H,PPFP
  1AFF'   CD 0400'              	CALL	MKLOAD
  1B02'   CD 040D'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1B05'   D2 1B38'              	JNC	VP_PGD
  1B08'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1B0B'   CD 094A'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1B0E'   3A 2B47'              	LDA	PCPY
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B11'   B7                    	ORA	A
  1B12'   CA 0898'              	JZ	FNBLNK
  1B15'   2A 2B45'              	LHLD	PLFS
  1B18'   7C                    	MOV	A,H
  1B19'   B7                    	ORA	A
  1B1A'   C2 0898'              	JNZ	FNBLNK
  1B1D'   3A 2B47'              	LDA	PCPY
  1B20'   CD 0E59'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1B23'   7C                    	MOV	A,H
  1B24'   B7                    	ORA	A
  1B25'   C2 0898'              	JNZ	FNBLNK
  1B28'   7D                    	MOV	A,L
  1B29'   B7                    	ORA	A
  1B2A'   CA 0898'              	JZ	FNBLNK
  1B2D'   F5                    	PUSH	PSW
  1B2E'   CD 07CA'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1B31'   F1                    	POP	PSW
  1B32'   32 2ACE'              	STA	ILN		; ... which the lines put now replace
  1B35'   C3 0898'              	JMP	FNBLNK
  1B38'                         VP_PGD:				; the put paged its first line out: page back
  1B38'   CD 03CD'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1B3B'   CD 0000*              	CALL	GOTO
  1B3E'   CD 094A'              	CALL	GLSTAL
  1B41'   CD 0FF1'              	CALL	GPLACE
  1B44'   C3 07DF'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1B47'                         VP_BEL:
  1B47'   CD 06EF'              	CALL	GETCNT		; the count is spent either way
  1B4A'   0E 07                 	MVI	C,BEL
  1B4C'   CD 0000*              	CALL	BCONOU
  1B4F'   C3 07BE'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1B52'                         VIREP:
  1B52'   78                    	MOV	A,B
  1B53'   FE 01                 	CPI	KT_ACT
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B55'   CA 1C82'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1B58'   FE 02                 	CPI	KT_CHAR
  1B5A'   C0                    	RNZ			; ignore anything else
  1B5B'   79                    	MOV	A,C
  1B5C'   FE 0D                 	CPI	CR
  1B5E'   CA 1BC2'              	JZ	VP_CR
  1B61'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1B63'   CA 1BC2'              	JZ	VP_CR
  1B66'   FE 08                 	CPI	BS
  1B68'   CA 1BCE'              	JZ	VP_BS
  1B6B'   FE 7F                 	CPI	DEL
  1B6D'   CA 1BCE'              	JZ	VP_BS
  1B70'   32 2B18'              	STA	VRCH		; the calls below do not preserve C
  1B73'   CD 07C4'              	CALL	SETLIN		; this row changed
  1B76'   CD 018C'              	CALL	MARKMOD
  1B79'   CD 161B'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1B7C'   CA 1BB4'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1B7F'   3A 2B18'              	LDA	VRCH
  1B82'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1B85'   2A 2B19'              	LHLD	RPDEL
  1B88'   7C                    	MOV	A,H
  1B89'   B5                    	ORA	L
  1B8A'   CA 1BA0'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1B8D'   2A 0000*              	LHLD	GAPEND
  1B90'   EB                    	XCHG
  1B91'   2A 2B1D'              	LHLD	RPGE
  1B94'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1B97'   CA 1BA0'              	JZ	VP_OVW
  1B9A'   21 0000               	LXI	H,0
  1B9D'   22 2B19'              	SHLD	RPDEL		; the text moved: those originals are gone
  1BA0'                         VP_OVW:
  1BA0'   21 0001               	LXI	H,1
  1BA3'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1BA6'   2A 0000*              	LHLD	GAPEND
  1BA9'   22 2B1D'              	SHLD	RPGE
  1BAC'   2A 2B19'              	LHLD	RPDEL
  1BAF'   23                    	INX	H
  1BB0'   22 2B19'              	SHLD	RPDEL
  1BB3'   C9                    	RET
  1BB4'                         VP_APP:
  1BB4'   3A 2B18'              	LDA	VRCH
  1BB7'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1BBA'   2A 2B1B'              	LHLD	RPAPP
  1BBD'   23                    	INX	H
  1BBE'   22 2B1B'              	SHLD	RPAPP
  1BC1'   C9                    	RET
  1BC2'                         VP_CR:
  1BC2'   21 0000               	LXI	H,0
  1BC5'   22 2B19'              	SHLD	RPDEL		; a line break ends what BS can put back
  1BC8'   22 2B1B'              	SHLD	RPAPP
  1BCB'   C3 1C58'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1BCE'                         VP_BS:
  1BCE'   2A 2B1B'              	LHLD	RPAPP
  1BD1'   7C                    	MOV	A,H
  1BD2'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BD3'   CA 1BE0'              	JZ	VP_BSD
  1BD6'   2B                    	DCX	H
  1BD7'   22 2B1B'              	SHLD	RPAPP		; an appended char: it just goes
  1BDA'   CD 07C4'              	CALL	SETLIN
  1BDD'   C3 0000*              	JMP	DELPRV
  1BE0'                         VP_BSD:
  1BE0'   2A 2B19'              	LHLD	RPDEL
  1BE3'   7C                    	MOV	A,H
  1BE4'   B5                    	ORA	L
  1BE5'   CA 1C0C'              	JZ	VP_BSM		; nothing of ours left
  1BE8'   2A 0000*              	LHLD	GAPEND
  1BEB'   EB                    	XCHG
  1BEC'   2A 2B1D'              	LHLD	RPGE
  1BEF'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1BF2'   C2 1C0C'              	JNZ	VP_BSM
  1BF5'   2A 2B19'              	LHLD	RPDEL
  1BF8'   2B                    	DCX	H
  1BF9'   22 2B19'              	SHLD	RPDEL
  1BFC'   CD 07C4'              	CALL	SETLIN
  1BFF'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1C02'   CD 0000*              	CALL	UNDELF		; the original comes back
  1C05'   2A 0000*              	LHLD	GAPEND
  1C08'   22 2B1D'              	SHLD	RPGE
  1C0B'   C9                    	RET
  1C0C'                         VP_BSM:
  1C0C'   CD 07BE'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1C0F'   C3 082D'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1C12'                         VIINS:
  1C12'   78                    	MOV	A,B
  1C13'   FE 01                 	CPI	KT_ACT
  1C15'   CA 1C82'              	JZ	VI_ACT
  1C18'   FE 02                 	CPI	KT_CHAR
  1C1A'   C0                    	RNZ			; ignore anything else
  1C1B'   79                    	MOV	A,C
  1C1C'   FE 0D                 	CPI	CR
  1C1E'   CA 1C58'              	JZ	VI_CR
  1C21'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1C23'   CA 1C58'              	JZ	VI_CR
  1C26'   FE 08                 	CPI	BS
  1C28'   CA 1C70'              	JZ	VI_BS
  1C2B'   FE 7F                 	CPI	DEL
  1C2D'   CA 1C70'              	JZ	VI_BS
  1C30'   79                    	MOV	A,C
  1C31'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1C34'   CD 018C'              	CALL	MARKMOD
  1C37'   CD 07C4'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1C3A'   79                    	MOV	A,C
  1C3B'   FE 20                 	CPI	' '
  1C3D'   D8                    	RC			; control char -> keep R_LINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C3E'   FE 7F                 	CPI	DEL
  1C40'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1C41'   CD 07E5'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1C44'   B7                    	ORA	A
  1C45'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1C46'   3E 04                 	MVI	A,R_ICH
  1C48'   32 2ACD'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1C4B'   CD 161B'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1C4E'   3E 00                 	MVI	A,0
  1C50'   C2 1C54'              	JNZ	VI_ICH
  1C53'   3C                    	INR	A
  1C54'                         VI_ICH:
  1C54'   32 2ACF'              	STA	ICHAPP
  1C57'   C9                    	RET
  1C58'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1C58'   CD 161B'              	CALL	ATCEND
  1C5B'   3E 00                 	MVI	A,0
  1C5D'   CA 1C61'              	JZ	VI_CRS
  1C60'   3C                    	INR	A
  1C61'                         VI_CRS:
  1C61'   F5                    	PUSH	PSW
  1C62'   CD 1628'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1C65'   CD 1635'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1C68'   CD 07CA'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1C6B'   F1                    	POP	PSW
  1C6C'   32 2AD0'              	STA	ILABOV
  1C6F'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1C70'                         VI_BS:
  1C70'   CD 0000*              	CALL	PEEKL
  1C73'   D8                    	RC			; start of the file: nothing to delete
  1C74'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1C76'   CA 1C7C'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1C79'   CD 07C4'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1C7C'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1C7C'   CD 018C'              	CALL	MARKMOD
  1C7F'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1C82'                         VI_ACT:
  1C82'   79                    	MOV	A,C
  1C83'   FE 0B                 	CPI	ACT_ESC
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C85'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1C86'   3E 00                 	MVI	A,EM_CMD
  1C88'   32 2AC8'              	STA	EDMODE
  1C8B'   CD 07BE'              	CALL	SETMOV
  1C8E'   CD 082D'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1C91'   C3 094A'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1C94'                         RDLINE:
  1C94'   EB                    	XCHG			; HL = buffer
  1C95'   22 2B1F'              	SHLD	RLPTR
  1C98'   3E 00                 	MVI	A,0
  1C9A'   32 2B21'              	STA	RLLEN
  1C9D'   78                    	MOV	A,B
  1C9E'   32 2B22'              	STA	RLMAX
  1CA1'   79                    	MOV	A,C
  1CA2'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1CA5'                         RL_LP:
  1CA5'   CD 0000*              	CALL	GETKEY
  1CA8'   78                    	MOV	A,B
  1CA9'   FE 01                 	CPI	KT_ACT
  1CAB'   CA 1D01'              	JZ	RL_ACT
  1CAE'   FE 02                 	CPI	KT_CHAR
  1CB0'   C2 1CA5'              	JNZ	RL_LP		; ignore other keys
  1CB3'   79                    	MOV	A,C
  1CB4'   FE 0D                 	CPI	CR
  1CB6'   CA 1D12'              	JZ	RL_DONE
  1CB9'   FE 08                 	CPI	BS
  1CBB'   CA 1CE9'              	JZ	RL_BS
  1CBE'   FE 7F                 	CPI	DEL
  1CC0'   CA 1CE9'              	JZ	RL_BS
  1CC3'   FE 20                 	CPI	' '
  1CC5'   DA 1CA5'              	JC	RL_LP		; control char -> ignore
  1CC8'   3A 2B21'              	LDA	RLLEN
  1CCB'   47                    	MOV	B,A
  1CCC'   3A 2B22'              	LDA	RLMAX
  1CCF'   B8                    	CMP	B
  1CD0'   CA 1CA5'              	JZ	RL_LP		; full -> ignore
  1CD3'   2A 2B1F'              	LHLD	RLPTR
  1CD6'   71                    	MOV	M,C
  1CD7'   23                    	INX	H
  1CD8'   22 2B1F'              	SHLD	RLPTR
  1CDB'   3A 2B21'              	LDA	RLLEN
  1CDE'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CDF'   32 2B21'              	STA	RLLEN
  1CE2'   79                    	MOV	A,C
  1CE3'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1CE6'   C3 1CA5'              	JMP	RL_LP
  1CE9'                         RL_BS:				; WM LINEPOP
  1CE9'   3A 2B21'              	LDA	RLLEN
  1CEC'   B7                    	ORA	A
  1CED'   CA 1D07'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1CF0'   3D                    	DCR	A
  1CF1'   32 2B21'              	STA	RLLEN
  1CF4'   2A 2B1F'              	LHLD	RLPTR
  1CF7'   2B                    	DCX	H
  1CF8'   22 2B1F'              	SHLD	RLPTR
  1CFB'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1CFE'   C3 1CA5'              	JMP	RL_LP
  1D01'                         RL_ACT:
  1D01'   79                    	MOV	A,C
  1D02'   FE 0B                 	CPI	ACT_ESC
  1D04'   C2 1CA5'              	JNZ	RL_LP
  1D07'                         RL_CAN:
  1D07'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1D09'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1D0C'   CD 07C4'              	CALL	SETLIN		; redraw one row
  1D0F'   3E FF                 	MVI	A,0FFH		; cancelled
  1D11'   C9                    	RET
  1D12'                         RL_DONE:
  1D12'   AF                    	XRA	A
  1D13'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1D14'                         VC_BZ:
  1D14'   CD 07BE'              	CALL	SETMOV
  1D17'   3A 2AF1'              	LDA	GSAVE
  1D1A'   FE 02                 	CPI	PZ
  1D1C'   CA 1D27'              	JZ	VZ_ZZ
  1D1F'   B7                    	ORA	A
  1D20'   C0                    	RNZ			; 'g' was pending: vim drops both
  1D21'   3E 02                 	MVI	A,PZ
  1D23'   32 2AF0'              	STA	GPEND
  1D26'   C9                    	RET
  1D27'                         VZ_ZZ:
  1D27'   3E 04                 	MVI	A,EO_X
  1D29'   32 2B23'              	STA	EXOP
  1D2C'   3E 01                 	MVI	A,1
  1D2E'   32 2B36'              	STA	EXBANG		; no '!'
  1D31'   AF                    	XRA	A
  1D32'   32 2B24'              	STA	EXARG		; no file name
  1D35'   3A 2ACC'              	LDA	MODF		; as ':x': a changed text is written first
  1D38'   B7                    	ORA	A
  1D39'   CA 1E7A'              	JZ	EX_Q
  1D3C'   C3 1E14'              	JMP	EX_W
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1D3F'                         VC_EX:
  1D3F'   CD 06EF'              	CALL	GETCNT
  1D42'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1D45'   11 0000*              	LXI	D,EXBUF
  1D48'   06 28                 	MVI	B,EXMAX
  1D4A'   0E 3A                 	MVI	C,':'
  1D4C'   CD 1C94'              	CALL	RDLINE
  1D4F'   B7                    	ORA	A
  1D50'   C0                    	RNZ			; cancelled
  1D51'   3A 2B21'              	LDA	RLLEN
  1D54'   5F                    	MOV	E,A
  1D55'   16 00                 	MVI	D,0
  1D57'   21 0000*              	LXI	H,EXBUF
  1D5A'   19                    	DAD	D
  1D5B'   36 00                 	MVI	M,0		; the line ends with a 0
  1D5D'   21 0000*              	LXI	H,EXBUF
  1D60'   CD 2330'              	CALL	SKIPB
  1D63'   C8                    	RZ			; nothing on it
  1D64'   22 2B26'              	SHLD	EXCMD
  1D67'   CD 2524'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1D6A'   CD 2330'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1D6D'   56                    	MOV	D,M
  1D6E'   23                    	INX	H
  1D6F'   1E 00                 	MVI	E,0
  1D71'   CD 233C'              	CALL	ISLOW
  1D74'   DA 1D7F'              	JC	EX_LK
  1D77'   5F                    	MOV	E,A
  1D78'   23                    	INX	H
  1D79'   CD 233C'              	CALL	ISLOW
  1D7C'   D2 1D98'              	JNC	EX_NOT		; a third letter: none of ours
  1D7F'                         EX_LK:
  1D7F'   E5                    	PUSH	H
  1D80'   21 250B'              	LXI	H,EXTAB
  1D83'                         EX_TL:
  1D83'   7E                    	MOV	A,M
  1D84'   B7                    	ORA	A
  1D85'   CA 1D97'              	JZ	EX_NTP		; not in the table
  1D88'   23                    	INX	H
  1D89'   BA                    	CMP	D
  1D8A'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D8B'   23                    	INX	H
  1D8C'   C2 1D93'              	JNZ	EX_TN
  1D8F'   BB                    	CMP	E
  1D90'   CA 1D9E'              	JZ	EX_TF
  1D93'                         EX_TN:
  1D93'   23                    	INX	H
  1D94'   C3 1D83'              	JMP	EX_TL
  1D97'                         EX_NTP:
  1D97'   E1                    	POP	H
  1D98'                         EX_NOT:
  1D98'   21 23F4'              	LXI	H,SNOT
  1D9B'   C3 2371'              	JMP	EXERT
  1D9E'                         EX_TF:
  1D9E'   7E                    	MOV	A,M
  1D9F'   32 2B23'              	STA	EXOP
  1DA2'   E1                    	POP	H
  1DA3'   FE 06                 	CPI	EO_S
  1DA5'   CA 2593'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1DA8'   FE 01                 	CPI	EO_W
  1DAA'   CA 1DB9'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1DAD'   FE 08                 	CPI	EO_R
  1DAF'   CA 1DB9'              	JZ	EX_RG		; ... and ':Nr name' a line
  1DB2'   3A 2B7F'              	LDA	SRNGF
  1DB5'   B7                    	ORA	A
  1DB6'   C2 1D98'              	JNZ	EX_NOT		; a range on a command that does not take one
  1DB9'                         EX_RG:
                                	;--- '!', then the file name ---
  1DB9'   7E                    	MOV	A,M
  1DBA'   D6 21                 	SUI	'!'
  1DBC'   32 2B36'              	STA	EXBANG		; 0 = '!'
  1DBF'   C2 1DC3'              	JNZ	EX_NB
  1DC2'   23                    	INX	H
  1DC3'                         EX_NB:
  1DC3'   CD 2330'              	CALL	SKIPB
  1DC6'   32 2B24'              	STA	EXARG		; 0 = no file name
  1DC9'   CA 1DE2'              	JZ	EX_RUN
  1DCC'   22 2B26'              	SHLD	EXCMD
  1DCF'   3A 2B23'              	LDA	EXOP
  1DD2'   FE 02                 	CPI	EO_Q
  1DD4'   CA 236E'              	JZ	EX_TRL		; :q takes none
  1DD7'   FE 07                 	CPI	EO_V
  1DD9'   CA 236E'              	JZ	EX_TRL		; nor :ve
  1DDC'   CD 229A'              	CALL	PARSFN
  1DDF'   C2 2362'              	JNZ	EX_INV
  1DE2'                         EX_RUN:
  1DE2'   3A 2B23'              	LDA	EXOP
  1DE5'   FE 05                 	CPI	EO_E
  1DE7'   CA 1E91'              	JZ	EX_E
  1DEA'   FE 02                 	CPI	EO_Q
  1DEC'   CA 1E7A'              	JZ	EX_Q
  1DEF'   FE 07                 	CPI	EO_V
  1DF1'   CA 2368'              	JZ	EX_V
  1DF4'   FE 08                 	CPI	EO_R
  1DF6'   CA 2022'              	JZ	EX_R
  1DF9'   FE 04                 	CPI	EO_X
  1DFB'   CA 1E0D'              	JZ	EX_XM
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1DFE'   FE 01                 	CPI	EO_W
  1E00'   C2 1E14'              	JNZ	EX_W		; :wq
  1E03'   3A 2B7F'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1E06'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1E07'   C2 1F42'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1E0A'   C3 1E14'              	JMP	EX_W
  1E0D'                         EX_XM:
  1E0D'   3A 2ACC'              	LDA	MODF		; :x writes only a changed text
  1E10'   B7                    	ORA	A
  1E11'   CA 1E7A'              	JZ	EX_Q
  1E14'                         EX_W:
  1E14'   CD 2102'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1E17'   D8                    	RC			; refused (message shown)
  1E18'   32 2B25'              	STA	EXBAK
  1E1B'   3A 2B23'              	LDA	EXOP
  1E1E'   FE 01                 	CPI	EO_W
  1E20'   CA 1E37'              	JZ	EX_WK
  1E23'   3A 2B25'              	LDA	EXBAK
  1E26'   B7                    	ORA	A
  1E27'   C2 1E77'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1E2A'   3A 2B36'              	LDA	EXBANG
  1E2D'   B7                    	ORA	A
  1E2E'   CA 1E77'              	JZ	EX_WQ		; so it does with '!'
  1E31'   CD 1E37'              	CALL	EX_WK		; else it may not: keep the text
  1E34'   C3 1E7A'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1E37'                         EX_WK:
  1E37'   CD 0D65'              	CALL	CURRW		; the cursor's row and file position
  1E3A'   32 2B28'              	STA	WPROW
  1E3D'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1E40'   7D                    	MOV	A,L
  1E41'   E6 7F                 	ANI	7FH
  1E43'   32 2B29'              	STA	WPBYT
  1E46'   7D                    	MOV	A,L
  1E47'   17                    	RAL
  1E48'   7C                    	MOV	A,H
  1E49'   17                    	RAL
  1E4A'   5F                    	MOV	E,A
  1E4B'   3E 00                 	MVI	A,0
  1E4D'   17                    	RAL
  1E4E'   57                    	MOV	D,A		; DE = HL / 128
  1E4F'   2A 0000*              	LHLD	OUTPOS
  1E52'   19                    	DAD	D
  1E53'   22 2B2A'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1E56'   CD 2137'              	CALL	WRITE
  1E59'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1E5C'   2A 2B2A'              	LHLD	WPREC
  1E5F'   EB                    	XCHG
  1E60'   3A 2B29'              	LDA	WPBYT
  1E63'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1E66'   CD 0000*              	CALL	GOTO
  1E69'                         EX_WRW:
  1E69'   21 0000               	LXI	H,0
  1E6C'   22 0000*              	SHLD	LNDLT
  1E6F'   3A 2B28'              	LDA	WPROW
  1E72'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E73'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1E76'   C9                    	RET
  1E77'                         EX_WQ:
  1E77'   CD 2137'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1E7A'                         EX_Q:
  1E7A'   3A 2B36'              	LDA	EXBANG
  1E7D'   B7                    	ORA	A
  1E7E'   CA 1E88'              	JZ	EX_QT
  1E81'   3A 2ACC'              	LDA	MODF
  1E84'   B7                    	ORA	A
  1E85'   C2 2356'              	JNZ	MSGNWR		; changed, no '!': stay
  1E88'                         EX_QT:
  1E88'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1E8B'   3E 01                 	MVI	A,1
  1E8D'   32 2ACB'              	STA	QUITF
  1E90'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1E91'                         EX_E:
  1E91'   3A 2B36'              	LDA	EXBANG
  1E94'   B7                    	ORA	A
  1E95'   CA 1E9F'              	JZ	EE_GO
  1E98'   3A 2ACC'              	LDA	MODF
  1E9B'   B7                    	ORA	A
  1E9C'   C2 2356'              	JNZ	MSGNWR
  1E9F'                         EE_GO:
  1E9F'   3A 2B24'              	LDA	EXARG
  1EA2'   B7                    	ORA	A
  1EA3'   C2 1EAA'              	JNZ	EE_ARG
  1EA6'   CD 2173'              	CALL	OWNTF		; no name: the buffer's own
  1EA9'   D8                    	RC
  1EAA'                         EE_ARG:
  1EAA'   CD 2189'              	CALL	ISOWN
  1EAD'   21 0001               	LXI	H,1
  1EB0'   C2 1EB7'              	JNZ	EE_LD		; another file: its first line
  1EB3'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1EB6'   23                    	INX	H		; HL = the cursor's line
  1EB7'                         EE_LD:
  1EB7'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1EB9'   32 2B34'              	STA	MSGWHT
  1EBC'   E5                    	PUSH	H
  1EBD'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1EC0'   21 0000*              	LXI	H,TFCB
  1EC3'   11 0000*              	LXI	D,FNAME
  1EC6'   CD 219B'              	CALL	COPY12		; the buffer's name
  1EC9'   CD 2160'              	CALL	SRCTF
  1ECC'   CD 0000*              	CALL	REOPEN
  1ECF'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1ED2'   AF                    	XRA	A
  1ED3'   32 2ACC'              	STA	MODF
  1ED6'   E1                    	POP	H
  1ED7'   2B                    	DCX	H
  1ED8'   AF                    	XRA	A
  1ED9'   CD 0000*              	CALL	MVLIND		; down to the line
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EDC'   CD 0A81'              	CALL	ATEOF
  1EDF'   DC 0A87'              	CC	LASTLN		; past the last line: onto it
  1EE2'   CD 0FB3'              	CALL	ZSAVE
  1EE5'   C3 1096'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1EE8'                         TFDOS:
  1EE8'   C5                    	PUSH	B
  1EE9'   11 0080               	LXI	D,CMDTAIL
  1EEC'   0E 1A                 	MVI	C,1AH		; set the DMA
  1EEE'   CD 0005               	CALL	BDOS
  1EF1'   C1                    	POP	B
  1EF2'   11 0000*              	LXI	D,TFCB
  1EF5'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1EF8'                         EXRNG:
  1EF8'   2A 2B80'              	LHLD	SRNG1
  1EFB'   7C                    	MOV	A,H
  1EFC'   B5                    	ORA	L
  1EFD'   37                    	STC
  1EFE'   C8                    	RZ
  1EFF'   2A 2B82'              	LHLD	SRNG2
  1F02'   EB                    	XCHG
  1F03'   2A 2B80'              	LHLD	SRNG1
  1F06'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F09'   D8                    	RC
  1F0A'   EB                    	XCHG			; HL = the last line, DE = the first
  1F0B'   CD 0000*              	CALL	SUBHD
  1F0E'   23                    	INX	H
  1F0F'   22 2B8A'              	SHLD	SLINES
  1F12'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1F13'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1F14'                         GOLNX:
  1F14'   E5                    	PUSH	H
  1F15'   CD 0F47'              	CALL	GOLN
  1F18'   CD 0000*              	CALL	CNTLF
  1F1B'   23                    	INX	H		; the line the cursor came to rest on
  1F1C'   D1                    	POP	D
  1F1D'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1F20'                         EXSAVP:
  1F20'   CD 0D65'              	CALL	CURRW
  1F23'   32 2B28'              	STA	WPROW
  1F26'   21 2B61'              	LXI	H,MKPOS
  1F29'   C3 044D'              	JMP	FPSTO
  1F2C'                         EXRSTP:
  1F2C'   CD 0000*              	CALL	CLRCNT
  1F2F'   CD 03CD'              	CALL	MKPAGE		; page until that place is in the window again
  1F32'   CD 0000*              	CALL	GOTO
  1F35'   C3 1E69'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1F38'                         PUTBRK:
  1F38'   3E 0D                 	MVI	A,CR
  1F3A'   CD 0000*              	CALL	PUTGAP
  1F3D'   3E 0A                 	MVI	A,LF
  1F3F'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1F42'                         EX_WR:
  1F42'   3A 2B24'              	LDA	EXARG
  1F45'   B7                    	ORA	A
  1F46'   CA 2344'              	JZ	MSGNFN		; No file name
  1F49'   CD 2189'              	CALL	ISOWN
  1F4C'   CA 1FEC'              	JZ	EXW_OW
  1F4F'   CD 0000*              	CALL	TEXIST
  1F52'   32 2B8D'              	STA	RWERR		; nonzero: a file of that name is there
  1F55'   CA 1F5F'              	JZ	EXW_GO
  1F58'   3A 2B36'              	LDA	EXBANG
  1F5B'   B7                    	ORA	A
  1F5C'   C2 234A'              	JNZ	MSGEXI		; File exists (! to force)
  1F5F'                         EXW_GO:
  1F5F'   CD 1EF8'              	CALL	EXRNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F62'   DA 1FE6'              	JC	EXW_BD
  1F65'   CD 1F20'              	CALL	EXSAVP
  1F68'   2A 2B80'              	LHLD	SRNG1
  1F6B'   CD 1F14'              	CALL	GOLNX
  1F6E'   C2 1FE3'              	JNZ	EXW_NL		; the text has no line N
  1F71'   3A 2B8D'              	LDA	RWERR		; a delete scans the whole directory, there or
  1F74'   B7                    	ORA	A		;   not: only when TEXIST found one
  1F75'   0E 13                 	MVI	C,13H
  1F77'   C4 1EE8'              	CNZ	TFDOS		; delete what is there
  1F7A'   0E 16                 	MVI	C,16H
  1F7C'   CD 1EE8'              	CALL	TFDOS		; ... and make it
  1F7F'   3C                    	INR	A
  1F80'   CA 1FD5'              	JZ	EXW_FL		; no directory entry left
  1F83'   3E 80                 	MVI	A,80H
  1F85'   32 2B8C'              	STA	RWPTR
  1F88'   AF                    	XRA	A
  1F89'   32 2B8D'              	STA	RWERR
  1F8C'   2A 2B8A'              	LHLD	SLINES
  1F8F'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1F92'                         EXW_LP:
  1F92'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1F95'   E5                    	PUSH	H
  1F96'   EB                    	XCHG
  1F97'   2A 0000*              	LHLD	GAPEND
  1F9A'   CD 1FF2'              	CALL	RWOUT		; the text from the cursor to there
  1F9D'   E1                    	POP	H
  1F9E'   3A 2B8D'              	LDA	RWERR
  1FA1'   B7                    	ORA	A
  1FA2'   C2 1FBE'              	JNZ	EXW_EN
  1FA5'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1FA8'   CD 0704'              	CALL	CNTTST
  1FAB'   C2 1F92'              	JNZ	EXW_LP
  1FAE'                         EXW_PD:				; the last record is padded out with ^Z
  1FAE'   3A 2B8C'              	LDA	RWPTR
  1FB1'   FE 80                 	CPI	80H
  1FB3'   CA 1FBE'              	JZ	EXW_EN
  1FB6'   3E 1A                 	MVI	A,CPMEOF
  1FB8'   CD 1FFE'              	CALL	RWPUT
  1FBB'   C3 1FAE'              	JMP	EXW_PD
  1FBE'                         EXW_EN:
  1FBE'   0E 10                 	MVI	C,10H
  1FC0'   CD 1EE8'              	CALL	TFDOS		; close
  1FC3'   3A 2B8D'              	LDA	RWERR
  1FC6'   B7                    	ORA	A
  1FC7'   C2 1FD5'              	JNZ	EXW_FL
  1FCA'   CD 1F2C'              	CALL	EXRSTP
  1FCD'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1FCF'   32 2B34'              	STA	MSGWHT
  1FD2'   C3 07BE'              	JMP	SETMOV		; nothing on the screen has changed
  1FD5'                         EXW_FL:				; no room: the part written is not left behind
  1FD5'   0E 13                 	MVI	C,13H
  1FD7'   CD 1EE8'              	CALL	TFDOS
  1FDA'   CD 1F2C'              	CALL	EXRSTP
  1FDD'   21 2501'              	LXI	H,SDFUL
  1FE0'   C3 237C'              	JMP	EXERR
  1FE3'                         EXW_NL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FE3'   CD 1F2C'              	CALL	EXRSTP
  1FE6'                         EXW_BD:
  1FE6'   21 24F3'              	LXI	H,SRNGE
  1FE9'   C3 237C'              	JMP	EXERR
  1FEC'                         EXW_OW:
  1FEC'   21 23AB'              	LXI	H,SEXI
  1FEF'   C3 237C'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1FF2'                         RWOUT:
  1FF2'   CD 0000*              	CALL	CMP16
  1FF5'   C8                    	RZ
  1FF6'   7E                    	MOV	A,M
  1FF7'   23                    	INX	H
  1FF8'   CD 1FFE'              	CALL	RWPUT
  1FFB'   C3 1FF2'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1FFE'                         RWPUT:
  1FFE'   E5                    	PUSH	H
  1FFF'   F5                    	PUSH	PSW
  2000'   3A 2B8C'              	LDA	RWPTR
  2003'   6F                    	MOV	L,A
  2004'   26 00                 	MVI	H,0
  2006'   F1                    	POP	PSW
  2007'   77                    	MOV	M,A
  2008'   2C                    	INR	L		; Z: that was the record's last byte
  2009'   7D                    	MOV	A,L
  200A'   C2 201D'              	JNZ	RWP_ST
  200D'   D5                    	PUSH	D
  200E'   0E 15                 	MVI	C,15H
  2010'   CD 1EE8'              	CALL	TFDOS		; write it
  2013'   D1                    	POP	D
  2014'   B7                    	ORA	A
  2015'   CA 201B'              	JZ	RWP_OK
  2018'   32 2B8D'              	STA	RWERR
  201B'                         RWP_OK:
  201B'   3E 80                 	MVI	A,80H
  201D'                         RWP_ST:
  201D'   32 2B8C'              	STA	RWPTR
  2020'   E1                    	POP	H
  2021'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2022'                         EX_R:
  2022'   3A 2B24'              	LDA	EXARG
  2025'   B7                    	ORA	A
  2026'   CA 2344'              	JZ	MSGNFN		; No file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2029'   0E 0F                 	MVI	C,0FH
  202B'   CD 1EE8'              	CALL	TFDOS		; open
  202E'   3C                    	INR	A
  202F'   CA 20FC'              	JZ	ER_NOF
  2032'   CD 0FD9'              	CALL	GZONE		; the screen's top line, before anything moves
  2035'   CD 1F20'              	CALL	EXSAVP
  2038'   3A 2B7F'              	LDA	SRNGF
  203B'   B7                    	ORA	A
  203C'   CA 2055'              	JZ	ER_NXT		; no line given: below the cursor's
  203F'   2A 2B82'              	LHLD	SRNG2
  2042'   7C                    	MOV	A,H
  2043'   B5                    	ORA	L
  2044'   C2 204F'              	JNZ	ER_LN
  2047'   23                    	INX	H
  2048'   CD 0F47'              	CALL	GOLN		; ':0r': above line 1 ...
  204B'   AF                    	XRA	A		;   which never wants a line end put in first
  204C'   C3 2077'              	JMP	ER_BRK
  204F'                         ER_LN:
  204F'   CD 1F14'              	CALL	GOLNX
  2052'   C2 1FE3'              	JNZ	EXW_NL		; the text has no line N
  2055'                         ER_NXT:
  2055'   21 0001               	LXI	H,1
  2058'   AF                    	XRA	A
  2059'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  205C'   CD 0A81'              	CALL	ATEOF
  205F'   3E 00                 	MVI	A,0
  2061'   D2 2077'              	JNC	ER_BRK		; text follows
  2064'   2A 0000*              	LHLD	GAPBEG
  2067'   EB                    	XCHG
  2068'   2A 0000*              	LHLD	TXTBEG
  206B'   CD 0000*              	CALL	CMP16
  206E'   3E 01                 	MVI	A,1
  2070'   CA 2077'              	JZ	ER_BRK		; nothing before the cursor either
  2073'   1B                    	DCX	D
  2074'   1A                    	LDAX	D
  2075'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2077'                         ER_BRK:
  2077'   32 2B8F'              	STA	RDBRK
  207A'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  207D'   AF                    	XRA	A
  207E'   32 2B8E'              	STA	RDANY
  2081'                         ER_LP:
  2081'   0E 14                 	MVI	C,14H
  2083'   CD 1EE8'              	CALL	TFDOS		; the next record
  2086'   B7                    	ORA	A
  2087'   C2 20BA'              	JNZ	ER_END
  208A'   21 0080               	LXI	H,CMDTAIL
  208D'   0E 00                 	MVI	C,0
  208F'                         ER_SC:				; C = its bytes, up to a ^Z
  208F'   7E                    	MOV	A,M
  2090'   FE 1A                 	CPI	CPMEOF
  2092'   CA 209A'              	JZ	ER_GOT
  2095'   23                    	INX	H
  2096'   0C                    	INR	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  2097'   F2 208F'              	JP	ER_SC		; (minus: all 128)
  209A'                         ER_GOT:
  209A'   79                    	MOV	A,C
  209B'   B7                    	ORA	A
  209C'   CA 20BA'              	JZ	ER_END
  209F'   C5                    	PUSH	B
  20A0'   3A 2B8E'              	LDA	RDANY
  20A3'   B7                    	ORA	A
  20A4'   CC 20EB'              	CZ	ER_1ST
  20A7'   C1                    	POP	B
  20A8'   06 00                 	MVI	B,0
  20AA'   11 0080               	LXI	D,CMDTAIL
  20AD'   C5                    	PUSH	B
  20AE'   CD 0000*              	CALL	INSBLK
  20B1'   C1                    	POP	B
  20B2'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  20B5'   79                    	MOV	A,C
  20B6'   17                    	RAL
  20B7'   DA 2081'              	JC	ER_LP		; a full record: there may be more
  20BA'                         ER_END:
  20BA'   3A 2B8E'              	LDA	RDANY
  20BD'   B7                    	ORA	A
  20BE'   CA 20DC'              	JZ	ER_PL		; nothing in the file: nothing has changed
  20C1'   CD 0A81'              	CALL	ATEOF
  20C4'   DA 20D1'              	JC	ER_MD		; the text now ends as the file read ends
  20C7'   2A 0000*              	LHLD	GAPBEG
  20CA'   2B                    	DCX	H
  20CB'   7E                    	MOV	A,M
  20CC'   FE 0A                 	CPI	LF
  20CE'   C4 1F38'              	CNZ	PUTBRK		; text follows: what was read ends a line
  20D1'                         ER_MD:
  20D1'   3E 01                 	MVI	A,1
  20D3'   32 2ACC'              	STA	MODF
  20D6'   CD 03CD'              	CALL	MKPAGE		; back to the first line read
  20D9'   CD 0000*              	CALL	GOTO
  20DC'                         ER_PL:
  20DC'   CD 0A81'              	CALL	ATEOF
  20DF'   DC 0A87'              	CC	LASTLN		; (nothing read, at the end: the last line)
  20E2'   CD 0000*              	CALL	CLRCNT
  20E5'   CD 0FF1'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  20E8'   C3 07DF'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  20EB'                         ER_1ST:
  20EB'   3C                    	INR	A
  20EC'   32 2B8E'              	STA	RDANY
  20EF'   3A 2B8F'              	LDA	RDBRK
  20F2'   B7                    	ORA	A
  20F3'   C4 1F38'              	CNZ	PUTBRK
  20F6'   21 2B61'              	LXI	H,MKPOS
  20F9'   C3 044D'              	JMP	FPSTO
  20FC'                         ER_NOF:
  20FC'   21 24E2'              	LXI	H,SNOPN
  20FF'   C3 2371'              	JMP	EXERT
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2102'                         WRCHK:
  2102'   3A 2B24'              	LDA	EXARG
  2105'   B7                    	ORA	A
  2106'   C2 2110'              	JNZ	WC_ARG
  2109'   CD 2173'              	CALL	OWNTF
  210C'   D8                    	RC
  210D'   C3 2125'              	JMP	WC_OWN
  2110'                         WC_ARG:
  2110'   CD 2189'              	CALL	ISOWN
  2113'   CA 2125'              	JZ	WC_OWN
  2116'   3A 2B36'              	LDA	EXBANG
  2119'   B7                    	ORA	A
  211A'   CA 2123'              	JZ	WC_OTH
  211D'   CD 0000*              	CALL	TEXIST
  2120'   C2 234A'              	JNZ	MSGEXI		; File exists (! to force)
  2123'                         WC_OTH:
  2123'   AF                    	XRA	A		; (NC)
  2124'   C9                    	RET
  2125'                         WC_OWN:
  2125'   3A 2B37'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2128'   B7                    	ORA	A
  2129'   CA 2133'              	JZ	WC_OK
  212C'   3A 2B36'              	LDA	EXBANG
  212F'   B7                    	ORA	A
  2130'   C2 2350'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2133'                         WC_OK:
  2133'   3E 01                 	MVI	A,1
  2135'   B7                    	ORA	A		; (NC)
  2136'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2137'                         WRITE:
  2137'   3A 2B25'              	LDA	EXBAK
  213A'   CD 0000*              	CALL	WRTO
  213D'   3A 0001*              	LDA	FNAME+1
  2140'   FE 20                 	CPI	' '
  2142'   C2 214E'              	JNZ	WR_HAS
  2145'   21 0000*              	LXI	H,TFCB
  2148'   11 0000*              	LXI	D,FNAME
  214B'   CD 219B'              	CALL	COPY12
  214E'                         WR_HAS:
  214E'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2150'   32 2B34'              	STA	MSGWHT
  2153'   CD 2189'              	CALL	ISOWN
  2156'   C2 2160'              	JNZ	SRCTF
  2159'   AF                    	XRA	A
  215A'   32 2ACC'              	STA	MODF
  215D'   32 2B35'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2160'                         SRCTF:
  2160'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2163'   11 005C               	LXI	D,DFTFCB
  2166'   CD 219B'              	CALL	COPY12
  2169'   AF                    	XRA	A
  216A'   06 04                 	MVI	B,4
  216C'                         SRC_Z:
  216C'   12                    	STAX	D		; extent, s1, s2, record count: 0
  216D'   13                    	INX	D
  216E'   05                    	DCR	B
  216F'   C2 216C'              	JNZ	SRC_Z
  2172'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2173'                         OWNTF:
  2173'   3A 0001*              	LDA	FNAME+1
  2176'   FE 20                 	CPI	' '
  2178'   CA 2344'              	JZ	MSGNFN
  217B'   CD 21A6'              	CALL	TFCLR
  217E'   21 0000*              	LXI	H,FNAME
  2181'   11 0000*              	LXI	D,TFCB
  2184'   CD 219B'              	CALL	COPY12
  2187'   B7                    	ORA	A		; (NC)
  2188'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2189'                         ISOWN:
  2189'   21 0000*              	LXI	H,TFCB
  218C'   11 0000*              	LXI	D,FNAME
  218F'   06 0C                 	MVI	B,12
  2191'                         IO_LP:
  2191'   1A                    	LDAX	D
  2192'   BE                    	CMP	M
  2193'   C0                    	RNZ
  2194'   23                    	INX	H
  2195'   13                    	INX	D
  2196'   05                    	DCR	B
  2197'   C2 2191'              	JNZ	IO_LP
  219A'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  219B'                         COPY12:
  219B'   06 0C                 	MVI	B,12
  219D'                         CP_LP:
  219D'   7E                    	MOV	A,M
  219E'   12                    	STAX	D
  219F'   23                    	INX	H
  21A0'   13                    	INX	D
  21A1'   05                    	DCR	B
  21A2'   C2 219D'              	JNZ	CP_LP
  21A5'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  21A6'                         TFCLR:
  21A6'   11 0000*              	LXI	D,TFCB
  21A9'   06 24                 	MVI	B,36
  21AB'   AF                    	XRA	A
  21AC'                         TC_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AC'   12                    	STAX	D
  21AD'   13                    	INX	D
  21AE'   05                    	DCR	B
  21AF'   C2 21AC'              	JNZ	TC_LP
  21B2'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  21B3'                         FOPEN:
  21B3'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  21B5'   32 2B34'              	STA	MSGWHT
  21B8'   21 005C               	LXI	H,DFTFCB
  21BB'   CD 228D'              	CALL	NRMDRV
  21BE'   11 0000*              	LXI	D,FNAME
  21C1'   CD 219B'              	CALL	COPY12
  21C4'   CD 0000*              	CALL	OPENZ
  21C7'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  21CA'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  21CC'   C8                    	RZ
  21CD'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  21D0'   32 2B35'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  21D3'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  21D4'                         ARGSCN:
  21D4'   3A 0080               	LDA	CMDTAIL
  21D7'   47                    	MOV	B,A		; B = what is left of the line
  21D8'   B7                    	ORA	A
  21D9'   C8                    	RZ
  21DA'   21 0081               	LXI	H,CMDTAIL+1
  21DD'                         AS_TOK:				; at a token, or the blanks before one
  21DD'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21DE'   FE 20                 	CPI	' '
  21E0'   C2 21E9'              	JNZ	AS_OPT
  21E3'   23                    	INX	H
  21E4'   05                    	DCR	B
  21E5'   C2 21DD'              	JNZ	AS_TOK
  21E8'   C9                    	RET
  21E9'                         AS_OPT:
  21E9'   FE 2B                 	CPI	'+'
  21EB'   CA 2215'              	JZ	AS_PLS
  21EE'   FE 2D                 	CPI	'-'
  21F0'   CA 2204'              	JZ	AS_SW
  21F3'   FE 2F                 	CPI	'/'
  21F5'   CA 2204'              	JZ	AS_SW
  21F8'                         AS_SKP:				; not ours (the file name): on to the next one
  21F8'   23                    	INX	H
  21F9'   05                    	DCR	B
  21FA'   C8                    	RZ
  21FB'   7E                    	MOV	A,M
  21FC'   FE 20                 	CPI	' '
  21FE'   C2 21F8'              	JNZ	AS_SKP
  2201'   C3 21DD'              	JMP	AS_TOK
  2204'                         AS_SW:
  2204'   23                    	INX	H
  2205'   05                    	DCR	B
  2206'   C8                    	RZ
  2207'   7E                    	MOV	A,M
  2208'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  220A'   FE 52                 	CPI	'R'
  220C'   C2 21F8'              	JNZ	AS_SKP
  220F'   32 2B37'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2212'   C3 21F8'              	JMP	AS_SKP
  2215'                         AS_PLS:
  2215'   3E 01                 	MVI	A,1
  2217'   32 2B38'              	STA	PLUSF		; '+' gets the line even with no number on it
  221A'   11 0000*              	LXI	D,PLUSB
  221D'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  221F'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2220'   05                    	DCR	B
  2221'   CA 2258'              	JZ	AS_PE
  2224'   7E                    	MOV	A,M
  2225'   FE 30                 	CPI	'0'
  2227'   C2 223F'              	JNZ	AS_PD
  222A'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  222A'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  222B'   05                    	DCR	B
  222C'   CA 2260'              	JZ	AS_P1
  222F'   7E                    	MOV	A,M
  2230'   FE 30                 	CPI	'0'
  2232'   CA 222A'              	JZ	AS_PZ
  2235'   FE 31                 	CPI	'1'
  2237'   DA 2260'              	JC	AS_P1		; zeros and then no digit at all: line 1
  223A'   FE 3A                 	CPI	'9'+1
  223C'   D2 2260'              	JNC	AS_P1
  223F'                         AS_PD:				; the digits, as typed
  223F'   7E                    	MOV	A,M
  2240'   FE 30                 	CPI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2242'   DA 2258'              	JC	AS_PE
  2245'   FE 3A                 	CPI	'9'+1
  2247'   D2 2258'              	JNC	AS_PE
  224A'   79                    	MOV	A,C
  224B'   B7                    	ORA	A
  224C'   CA 2267'              	JZ	AS_POV
  224F'   0D                    	DCR	C
  2250'   7E                    	MOV	A,M
  2251'   12                    	STAX	D
  2252'   13                    	INX	D
  2253'   23                    	INX	H
  2254'   05                    	DCR	B
  2255'   C2 223F'              	JNZ	AS_PD
  2258'                         AS_PE:
  2258'   AF                    	XRA	A
  2259'   12                    	STAX	D		; the digits end with a 0
  225A'   78                    	MOV	A,B
  225B'   B7                    	ORA	A
  225C'   C8                    	RZ
  225D'   C3 21DD'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2260'                         AS_P1:
  2260'   3E 31                 	MVI	A,'1'
  2262'   12                    	STAX	D
  2263'   13                    	INX	D
  2264'   C3 2258'              	JMP	AS_PE
  2267'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2267'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  226A'   C3 2258'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  226D'                         ARGGO:
  226D'   3A 2B38'              	LDA	PLUSF
  2270'   B7                    	ORA	A
  2271'   C8                    	RZ
  2272'   21 0000*              	LXI	H,PLUSB
  2275'                         AG_LP:
  2275'   7E                    	MOV	A,M
  2276'   B7                    	ORA	A
  2277'   CA 2286'              	JZ	AG_G
  227A'   4F                    	MOV	C,A
