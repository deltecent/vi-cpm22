  06A9'   2A 0000*              	LHLD	GAPEND
  06AC'   09                    	DAD	B
  06AD'   D1                    	POP	D
  06AE'                         BOL_A:
  06AE'   78                    	MOV	A,B
  06AF'   B1                    	ORA	C
  06B0'   CA 06BF'              	JZ	BOL_B		; back at the gap: the rest is before it
  06B3'   2B                    	DCX	H
  06B4'   7E                    	MOV	A,M
  06B5'   FE 0A                 	CPI	LF
  06B7'   CA 06D3'              	JZ	BOL_X
  06BA'   1B                    	DCX	D
  06BB'   0B                    	DCX	B
  06BC'   C3 06AE'              	JMP	BOL_A
  06BF'                         BOL_B:
  06BF'   2A 0000*              	LHLD	TXTBEG
  06C2'   19                    	DAD	D
  06C3'                         BOL_C:
  06C3'   7A                    	MOV	A,D
  06C4'   B3                    	ORA	E
  06C5'   CA 06D3'              	JZ	BOL_X		; at 0
  06C8'   2B                    	DCX	H
  06C9'   7E                    	MOV	A,M
  06CA'   FE 0A                 	CPI	LF
  06CC'   CA 06D3'              	JZ	BOL_X
  06CF'   1B                    	DCX	D
  06D0'   C3 06C3'              	JMP	BOL_C
  06D3'                         BOL_X:
  06D3'   EB                    	XCHG
  06D4'   C1                    	POP	B
  06D5'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  06D6'                         EOLNL:
  06D6'   C5                    	PUSH	B
  06D7'   E5                    	PUSH	H
  06D8'   CD 0000*              	CALL	CUROFF
  06DB'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  06DC'   CD 0000*              	CALL	CMP16
  06DF'   D2 06FD'              	JNC	ENL_A
  06E2'   2A 0000*              	LHLD	GAPBEG
  06E5'   44                    	MOV	B,H
  06E6'   4D                    	MOV	C,L
  06E7'   2A 0000*              	LHLD	TXTBEG
  06EA'   19                    	DAD	D
  06EB'                         ENL_B:
  06EB'   7D                    	MOV	A,L
  06EC'   91                    	SUB	C
  06ED'   7C                    	MOV	A,H
  06EE'   98                    	SBB	B
  06EF'   D2 070B'              	JNC	ENL_G		; at the gap: on from its far side
  06F2'   7E                    	MOV	A,M
