  1E99'   CD 1EBE'              	CALL	CPYNAM
  1E9C'   FE 2E                 	CPI	'.'
  1E9E'   0E 03                 	MVI	C,3
  1EA0'   C4 1ED1'              	CNZ	PADFLD		; no type: blanks
