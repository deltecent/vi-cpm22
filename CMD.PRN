                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	DCHBS				; ... 1 = left of the cursor (BS)
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2E98'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2DDB'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1F2C'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1E61'              	JMP	VIREP
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2E10'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 1A4B'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2DDC'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2DDC'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2DDC'              	SHLD	CMDCNT
  0074'   C3 0807'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
  0077'   3A 2E10'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2E11'              	STA	GSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   AF                    	XRA	A
  007E'   32 2E10'              	STA	GPEND
  0081'   3A 2E12'              	LDA	PENDOP
  0084'   32 2E13'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2E12'              	STA	PENDOP
  008B'   3A 2E13'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 13CA'              	JNZ	OPPEND
  0092'   3A 2E11'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2D23'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 0807'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 0732'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2E10'              	STA	GPEND
  00B0'   32 2E11'              	STA	GSAVE
  00B3'   32 2E12'              	STA	PENDOP
  00B6'   32 2E13'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CD'   5E                    	MOV	E,M
  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2E07'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2E06'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2E06'              	STA	DOTSTA
  00EA'   32 2E08'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2E0A'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F7'   32 2E09'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FA'   47                    	MOV	B,A
  00FB'   2A 2E0A'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2E0A'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2E0A'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2E08'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2E07'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2DDB'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2E10'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2E12'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2DDC'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2E09'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2E06'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2E05'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2E05'              	STA	DOTCHG
  0151'   32 2E0C'              	STA	DOTLEN
  0154'   3A 2E08'              	LDA	DOTOVF
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'   B7                    	ORA	A
  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2E0A'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2E0C'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2DDF'              	STA	MODF
  0179'   32 2E05'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2DDC'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2E0E'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2DDC'              	SHLD	CMDCNT
  0189'   3A 2E0C'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2E0D'              	STA	DOTIX
  0194'   2A 2E0E'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2DDC'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05A4'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2E0D'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2E0D'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BB'   32 2E07'              	STA	DOTRPL
  01BE'                         DOTLP:
  01BE'   CD 05A4'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2E0D'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2E0D'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2E07'              	STA	DOTRPL
  01D6'   32 2E05'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 0844'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 0807'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2E74'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2E74'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F2'   77                    	MOV	M,A
  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2E07'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05A4'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2E0D'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2E0D'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  021C'   C3 022B'              	JMP	FNDNEW
  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2E69'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2E6A'              	STA	FNDCH
  0238'   3A 2E69'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2E69'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2E69'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2E13'              	STA	PSAVE
  0267'   C3 0807'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2E6B'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2E6C'              	STA	FNDSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0271'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0274'   22 2E6D'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2E6F'              	SHLD	FNDCUR
  027D'   3A 2E6B'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2E6F'              	LHLD	FNDCUR
  0288'   CD 06CA'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2E71'              	SHLD	FNDLIM
  028E'   2A 2E6F'              	LHLD	FNDCUR
  0291'   3A 2E6C'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2E71'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2E6F'              	LHLD	FNDCUR
  02B9'   CD 0624'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2E71'              	SHLD	FNDLIM
  02BF'   2A 2E6F'              	LHLD	FNDCUR
  02C2'   3A 2E6C'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2E71'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EA'   2B                    	DCX	H
  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2E6B'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2E6B'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05BA'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2E13'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2E6A'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2E6D'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2E6D'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  032B'   FE 54                 	CPI	'T'
  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2E80'              	STA	MKWHAT
  033D'   CD 071F'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2E80'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0365'   E1                    	POP	H
  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2E13'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2E80'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 12DB'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 075B'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 0798'              	CALL	BRKOFF		; (A only)
  0393'   DA 07B0'              	JC	BRKBAK
  0396'   3A 2E80'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2E73'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 12F3'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2DDC'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 0747'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;it, and an offset into the window it started in means nothing there.
  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2E7D'              	SHLD	MKPOS
  03E5'   32 2E7F'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 1295'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2E7D'              	LHLD	MKPOS
  03F4'   3A 2E7F'              	LDA	MKPOS+2
  03F7'   CD 1288'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2E13'              	STA	PSAVE
  0414'   21 27B3'              	LXI	H,SMKNS
  0417'   C3 2698'              	JMP	EXERR
  041A'                         MKNOLT:
  041A'   3A 2E80'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2E13'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 1292'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 0807'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 24BB'              	CALL	COPY12
  044B'   21 2E74'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0460'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
  0490'   32 2E7C'              	STA	MKTYP
  0493'   3A 2E81'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2E7A'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 1292'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 1288'              	CALL	SUB24
  04BE'   22 2E77'              	SHLD	MKEDIT
  04C1'   32 2E79'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2E74'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2E77'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2E7C'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2E7A'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   79                    	MOV	A,C
  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2E7A'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053B'   13                    	INX	D
  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2DDC'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 0587'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 056D'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2DDF'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 09AE'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   C3 0844'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  056D'                         UCLAMP:
  056D'   E5                    	PUSH	H
  056E'   CD 189D'              	CALL	CEND		; HL = the line's content end
  0571'   D1                    	POP	D		; DE = the offset wanted
  0572'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0575'   D2 057A'              	JNC	UCL_BK
  0578'   EB                    	XCHG
  0579'   C9                    	RET
  057A'                         UCL_BK:
  057A'   E5                    	PUSH	H		; the content end
  057B'   EB                    	XCHG			; HL = the offset wanted
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057C'   CD 0624'              	CALL	BOL
  057F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0580'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0583'   EB                    	XCHG			; HL = the content end
  0584'   C8                    	RZ
  0585'   2B                    	DCX	H		; ... its last character
  0586'   C9                    	RET
  0587'                         UNDNO:
  0587'   3A 0000*              	LDA	UNDWHY
  058A'   B7                    	ORA	A
  058B'   CA 059C'              	JZ	UNDBEL
  058E'   21 276D'              	LXI	H,SUNDW		; the change has paged away: say so
  0591'   FE 01                 	CPI	1
  0593'   CA 2698'              	JZ	EXERR
  0596'   21 278F'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0599'   C3 2698'              	JMP	EXERR
  059C'                         UNDBEL:
  059C'   0E 07                 	MVI	C,BEL
  059E'   CD 0000*              	CALL	BCONOU
  05A1'   C3 0807'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05A4'                         DOTGET:
  05A4'   3A 2E0D'              	LDA	DOTIX
  05A7'   5F                    	MOV	E,A
  05A8'   3A 2E0C'              	LDA	DOTLEN
  05AB'   BB                    	CMP	E
  05AC'   CA 05B8'              	JZ	DOTGEF
  05AF'   16 00                 	MVI	D,0
  05B1'   21 0000*              	LXI	H,DOTBUF
  05B4'   19                    	DAD	D
  05B5'   7E                    	MOV	A,M
  05B6'   B7                    	ORA	A		; CY clear: a key was returned
  05B7'   C9                    	RET
  05B8'                         DOTGEF:
  05B8'   37                    	STC
  05B9'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05BA'                         GOSET:
  05BA'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05BD'                         SETGL:
  05BD'   CD 12B5'              	CALL	ZSAVE
  05C0'   21 0000               	LXI	H,0
  05C3'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C6'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C7'   CD 12C8'              	CALL	ZREST
  05CA'   E1                    	POP	H
  05CB'   E5                    	PUSH	H
  05CC'   CD 072B'              	CALL	GBSUB		; HL = bytes to the cursor
  05CF'   44                    	MOV	B,H
  05D0'   4D                    	MOV	C,L
  05D1'   E1                    	POP	H		; HL = the line's start
  05D2'   11 0000               	LXI	D,0		; DE = screen column
  05D5'                         SG_LP:
  05D5'   78                    	MOV	A,B
  05D6'   B1                    	ORA	C
  05D7'   CA 05EC'              	JZ	SG_CUR
  05DA'   7E                    	MOV	A,M
  05DB'   23                    	INX	H
  05DC'   0B                    	DCX	B
  05DD'   E5                    	PUSH	H
  05DE'   6B                    	MOV	L,E
  05DF'   CD 0611'              	CALL	CWID
  05E2'   E1                    	POP	H
  05E3'   83                    	ADD	E
  05E4'   5F                    	MOV	E,A
  05E5'   D2 05D5'              	JNC	SG_LP
  05E8'   14                    	INR	D
  05E9'   C3 05D5'              	JMP	SG_LP
  05EC'                         SG_CUR:
  05EC'   2A 0000*              	LHLD	TXTEND
  05EF'   D5                    	PUSH	D
  05F0'   EB                    	XCHG
  05F1'   2A 0000*              	LHLD	GAPEND
  05F4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05F7'   D1                    	POP	D
  05F8'   CA 060C'              	JZ	SG_SET
  05FB'   7E                    	MOV	A,M
  05FC'   FE 09                 	CPI	TAB
  05FE'   C2 060C'              	JNZ	SG_SET
  0601'   6B                    	MOV	L,E
  0602'   CD 0611'              	CALL	CWID
  0605'   3D                    	DCR	A		; the TAB's last column
  0606'   83                    	ADD	E
  0607'   5F                    	MOV	E,A
  0608'   D2 060C'              	JNC	SG_SET
  060B'   14                    	INR	D
  060C'                         SG_SET:
  060C'   EB                    	XCHG
  060D'   22 2DE6'              	SHLD	GOALCOL
  0610'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0611'                         CWID:
  0611'   FE 0D                 	CPI	CR
  0613'   CA 0622'              	JZ	CW_0
  0616'   FE 09                 	CPI	TAB
  0618'   3E 01                 	MVI	A,1
  061A'   C0                    	RNZ
  061B'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  061C'   E6 07                 	ANI	TABWID-1
  061E'   2F                    	CMA
  061F'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0621'   C9                    	RET
  0622'                         CW_0:
  0622'   AF                    	XRA	A
  0623'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  0624'                         BOL:
  0624'   C5                    	PUSH	B
  0625'   E5                    	PUSH	H
  0626'   CD 0000*              	CALL	CUROFF
  0629'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  062A'   CD 0000*              	CALL	CMP16
  062D'   DA 0650'              	JC	BOL_B
  0630'   CA 0650'              	JZ	BOL_B
  0633'   D5                    	PUSH	D
  0634'   EB                    	XCHG
  0635'   CD 0000*              	CALL	SUBHD
  0638'   44                    	MOV	B,H
  0639'   4D                    	MOV	C,L		; BC = how far past the gap it is
  063A'   2A 0000*              	LHLD	GAPEND
  063D'   09                    	DAD	B
  063E'   D1                    	POP	D
  063F'                         BOL_A:
  063F'   78                    	MOV	A,B
  0640'   B1                    	ORA	C
  0641'   CA 0650'              	JZ	BOL_B		; back at the gap: the rest is before it
  0644'   2B                    	DCX	H
  0645'   7E                    	MOV	A,M
  0646'   FE 0A                 	CPI	LF
  0648'   CA 0664'              	JZ	BOL_X
  064B'   1B                    	DCX	D
  064C'   0B                    	DCX	B
  064D'   C3 063F'              	JMP	BOL_A
  0650'                         BOL_B:
  0650'   2A 0000*              	LHLD	TXTBEG
  0653'   19                    	DAD	D
  0654'                         BOL_C:
  0654'   7A                    	MOV	A,D
  0655'   B3                    	ORA	E
  0656'   CA 0664'              	JZ	BOL_X		; at 0
  0659'   2B                    	DCX	H
  065A'   7E                    	MOV	A,M
  065B'   FE 0A                 	CPI	LF
  065D'   CA 0664'              	JZ	BOL_X
  0660'   1B                    	DCX	D
  0661'   C3 0654'              	JMP	BOL_C
  0664'                         BOL_X:
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   EB                    	XCHG
  0665'   C1                    	POP	B
  0666'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  0667'                         EOLNL:
  0667'   C5                    	PUSH	B
  0668'   E5                    	PUSH	H
  0669'   CD 0000*              	CALL	CUROFF
  066C'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  066D'   CD 0000*              	CALL	CMP16
  0670'   D2 068E'              	JNC	ENL_A
  0673'   2A 0000*              	LHLD	GAPBEG
  0676'   44                    	MOV	B,H
  0677'   4D                    	MOV	C,L
  0678'   2A 0000*              	LHLD	TXTBEG
  067B'   19                    	DAD	D
  067C'                         ENL_B:
  067C'   7D                    	MOV	A,L
  067D'   91                    	SUB	C
  067E'   7C                    	MOV	A,H
  067F'   98                    	SBB	B
  0680'   D2 069C'              	JNC	ENL_G		; at the gap: on from its far side
  0683'   7E                    	MOV	A,M
  0684'   FE 0A                 	CPI	LF
  0686'   CA 06B8'              	JZ	ENL_X
  0689'   23                    	INX	H
  068A'   13                    	INX	D
  068B'   C3 067C'              	JMP	ENL_B
  068E'                         ENL_A:
  068E'   D5                    	PUSH	D
  068F'   EB                    	XCHG
  0690'   CD 0000*              	CALL	SUBHD
  0693'   EB                    	XCHG			; DE = how far past the gap it is
  0694'   2A 0000*              	LHLD	GAPEND
  0697'   19                    	DAD	D
  0698'   D1                    	POP	D
  0699'   C3 069F'              	JMP	ENL_S
  069C'                         ENL_G:
  069C'   2A 0000*              	LHLD	GAPEND
  069F'                         ENL_S:
  069F'   E5                    	PUSH	H
  06A0'   2A 0000*              	LHLD	TXTEND
  06A3'   44                    	MOV	B,H
  06A4'   4D                    	MOV	C,L
  06A5'   E1                    	POP	H
  06A6'                         ENL_C:
  06A6'   7D                    	MOV	A,L
  06A7'   91                    	SUB	C
  06A8'   7C                    	MOV	A,H
  06A9'   98                    	SBB	B
  06AA'   D2 06B8'              	JNC	ENL_X		; the end of the text
  06AD'   7E                    	MOV	A,M
  06AE'   FE 0A                 	CPI	LF
  06B0'   CA 06B8'              	JZ	ENL_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B3'   23                    	INX	H
  06B4'   13                    	INX	D
  06B5'   C3 06A6'              	JMP	ENL_C
  06B8'                         ENL_X:
  06B8'   EB                    	XCHG
  06B9'   C1                    	POP	B
  06BA'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  06BB'                         NLSTART:
  06BB'   CD 0667'              	CALL	EOLNL
  06BE'   E5                    	PUSH	H
  06BF'   CD 0000*              	CALL	LOGLEN
  06C2'   D1                    	POP	D		; DE = eol result
  06C3'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  06C6'   C8                    	RZ			; no next line: HL = LOGLEN
  06C7'   EB                    	XCHG			; HL = eol
  06C8'   23                    	INX	H
  06C9'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  06CA'                         EOLC:
  06CA'   E5                    	PUSH	H
  06CB'   CD 0667'              	CALL	EOLNL
  06CE'   22 2E2F'              	SHLD	WKTERM
  06D1'   E1                    	POP	H
  06D2'   CD 0624'              	CALL	BOL
  06D5'   22 2E31'              	SHLD	WKBOL
  06D8'   2A 2E2F'              	LHLD	WKTERM
  06DB'   EB                    	XCHG			; DE = term
  06DC'   2A 2E31'              	LHLD	WKBOL
  06DF'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  06E2'   CA 0701'              	JZ	EOLC_MT
  06E5'   EB                    	XCHG			; HL = term
  06E6'   2B                    	DCX	H		; term-1
  06E7'   E5                    	PUSH	H
  06E8'   CD 0000*              	CALL	CHARAT
  06EB'   E1                    	POP	H		; HL = term-1
  06EC'   FE 0D                 	CPI	CR
  06EE'   CA 06F4'              	JZ	EOLC_CR		; content ends at term-1
  06F1'   C3 06F5'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  06F4'                         EOLC_CR:
  06F4'   2B                    	DCX	H		; last = (term-1) - 1
  06F5'                         EOLC_LS:
  06F5'   EB                    	XCHG			; DE = last
  06F6'   2A 2E31'              	LHLD	WKBOL
  06F9'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  06FC'   DA 0701'              	JC	EOLC_MT
  06FF'   EB                    	XCHG			; HL = last
  0700'   C9                    	RET
  0701'                         EOLC_MT:
  0701'   2A 2E31'              	LHLD	WKBOL
  0704'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0705'                         COL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0705'   E5                    	PUSH	H
  0706'   CD 0624'              	CALL	BOL
  0709'   D1                    	POP	D		; DE = off
  070A'   EB                    	XCHG			; HL = off, DE = bol
  070B'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  070E'                         ATENDQ:
  070E'   CD 0000*              	CALL	CUROFF
  0711'   E5                    	PUSH	H
  0712'   CD 0000*              	CALL	LOGLEN
  0715'   D1                    	POP	D		; DE = cur
  0716'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0719'                         CURCHR:
  0719'   CD 0000*              	CALL	CUROFF
  071C'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  071F'                         MOVCNT:
  071F'   CD 0807'              	CALL	SETMOV
  0722'   C3 0732'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0725'                         CNTOFF:
  0725'   CD 0732'              	CALL	GETCNT
  0728'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  072B'                         GBSUB:
  072B'   EB                    	XCHG
  072C'   2A 0000*              	LHLD	GAPBEG
  072F'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0732'                         GETCNT:
  0732'   2A 2DDC'              	LHLD	CMDCNT
  0735'   7C                    	MOV	A,H
  0736'   B5                    	ORA	L
  0737'   C2 073E'              	JNZ	GC_HAVE
  073A'   21 0001               	LXI	H,1
  073D'   C9                    	RET
  073E'                         GC_HAVE:
  073E'   E5                    	PUSH	H
  073F'   21 0000               	LXI	H,0
  0742'   22 2DDC'              	SHLD	CMDCNT
  0745'   E1                    	POP	H
  0746'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0747'                         CNTTST:				; WM 1175
  0747'   3A 2E98'              	LDA	BRKARM
  074A'   B7                    	ORA	A
  074B'   C4 0775'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  074E'   E5                    	PUSH	H
  074F'   2A 2DDC'              	LHLD	CMDCNT
  0752'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  0755'   B4                    	ORA	H
  0756'   B5                    	ORA	L
  0757'   E1                    	POP	H
  0758'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  075B'                         BRKON:
  075B'   21 2E93'              	LXI	H,SOFF
  075E'   CD 0429'              	CALL	FPSTO
  0761'   2A 0000*              	LHLD	LNDLT
  0764'   22 2E96'              	SHLD	SLDLT
  0767'   AF                    	XRA	A
  0768'   32 2E99'              	STA	BRKHIT
  076B'   3A 2E13'              	LDA	PSAVE
  076E'   B7                    	ORA	A
  076F'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0770'   3C                    	INR	A
  0771'   32 2E98'              	STA	BRKARM
  0774'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  0775'                         BRKTST:
  0775'   C5                    	PUSH	B
  0776'   D5                    	PUSH	D
  0777'   E5                    	PUSH	H
  0778'   CD 0000*              	CALL	KBBRK
  077B'   CA 0794'              	JZ	BT_NO
  077E'   32 2E99'              	STA	BRKHIT		; (A = FFH)
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0781'   21 2742'              	LXI	H,SINTG
  0784'   CD 0000*              	CALL	EXMSG
  0787'   AF                    	XRA	A
  0788'   32 2E98'              	STA	BRKARM		; the way back is not stopped in its turn
  078B'   32 0000*              	STA	AUXCNT
  078E'   21 0000               	LXI	H,0
  0791'   22 2DDC'              	SHLD	CMDCNT
  0794'                         BT_NO:
  0794'   E1                    	POP	H
  0795'   D1                    	POP	D
  0796'   C1                    	POP	B
  0797'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  0798'                         BRKOFF:
  0798'   AF                    	XRA	A
  0799'   32 2E98'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  079C'                         BRKQ:
  079C'   3A 2E99'              	LDA	BRKHIT
  079F'   B7                    	ORA	A
  07A0'   C8                    	RZ
  07A1'   37                    	STC
  07A2'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07A3'                         RSTPL:
  07A3'   21 2E93'              	LXI	H,SOFF
  07A6'   CD 03D0'              	CALL	BACKTO
  07A9'   2A 2E96'              	LHLD	SLDLT
  07AC'   22 0000*              	SHLD	LNDLT
  07AF'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07B0'                         BRKBAK:
  07B0'   CD 07A3'              	CALL	RSTPL
  07B3'   CD 0000*              	CALL	KBFLSH
  07B6'   21 2736'              	LXI	H,SINTR
  07B9'   C3 2698'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  07BC'                         CLASSF:
  07BC'   47                    	MOV	B,A
  07BD'   FE 20                 	CPI	' '
  07BF'   CA 07FF'              	JZ	CLS0
  07C2'   FE 09                 	CPI	TAB
  07C4'   CA 07FF'              	JZ	CLS0
  07C7'   FE 0A                 	CPI	LF
  07C9'   CA 07FF'              	JZ	CLS0
  07CC'   FE 0D                 	CPI	CR
  07CE'   CA 07FF'              	JZ	CLS0
  07D1'   3A 2DE8'              	LDA	WBIG
  07D4'   B7                    	ORA	A
  07D5'   C2 0801'              	JNZ	CLS1
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07D8'   78                    	MOV	A,B
  07D9'   FE 5F                 	CPI	'_'
  07DB'   CA 0801'              	JZ	CLS1
  07DE'   FE 30                 	CPI	'0'
  07E0'   DA 0804'              	JC	CLS2
  07E3'   FE 3A                 	CPI	'9'+1
  07E5'   DA 0801'              	JC	CLS1
  07E8'   FE 41                 	CPI	'A'
  07EA'   DA 0804'              	JC	CLS2
  07ED'   FE 5B                 	CPI	'Z'+1
  07EF'   DA 0801'              	JC	CLS1
  07F2'   FE 61                 	CPI	'a'
  07F4'   DA 0804'              	JC	CLS2
  07F7'   FE 7B                 	CPI	'z'+1
  07F9'   DA 0801'              	JC	CLS1
  07FC'   C3 0804'              	JMP	CLS2
  07FF'   AF                    CLS0:	XRA	A
  0800'   C9                    	RET
  0801'   3E 01                 CLS1:	MVI	A,1
  0803'   C9                    	RET
  0804'   3E 02                 CLS2:	MVI	A,2
  0806'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0807'                         SETMOV:
  0807'   3E 01                 	MVI	A,R_MOVE
  0809'   32 2DE0'              	STA	RINTENT
  080C'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  080D'                         SETLIN:
  080D'   3E 02                 	MVI	A,R_LINE
  080F'   32 2DE0'              	STA	RINTENT
  0812'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  0813'                         SETCEL:
  0813'   CD 0828'              	CALL	PLAINQ
  0816'   D0                    	RNC
  0817'   3A 2E34'              	LDA	VRCH
  081A'   CD 0828'              	CALL	PLAINQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081D'   D0                    	RNC
  081E'   78                    	MOV	A,B
  081F'   32 2DE2'              	STA	ICHAPP
  0822'   3E 04                 	MVI	A,R_ICH
  0824'   32 2DE0'              	STA	RINTENT
  0827'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0828'                         PLAINQ:
  0828'   FE 20                 	CPI	' '
  082A'   3F                    	CMC
  082B'   D0                    	RNC
  082C'   FE 7F                 	CPI	DEL
  082E'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  082F'                         SETILN:
  082F'   3E 01                 	MVI	A,1
  0831'   32 2DE1'              	STA	ILN		; one line, unless a put overwrites it below
  0834'   3E 05                 	MVI	A,R_ILIN
  0836'   32 2DE0'              	STA	RINTENT
  0839'   AF                    	XRA	A
  083A'   32 2DE5'              	STA	ILABOV		; the row above the opened ones is untouched
  083D'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  083E'                         SETJON:
  083E'   3E 06                 	MVI	A,R_JOIN
  0840'   32 2DE0'              	STA	RINTENT
  0843'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0844'                         SETFUL:
  0844'   3E 00                 	MVI	A,R_FULL
  0846'   32 2DE0'              	STA	RINTENT
  0849'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  084A'                         TAILTAB:
  084A'   C5                    	PUSH	B
  084B'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  084E'   E5                    	PUSH	H
  084F'   2A 0000*              	LHLD	TXTEND
  0852'   44                    	MOV	B,H
  0853'   4D                    	MOV	C,L
  0854'   2A 0000*              	LHLD	GAPEND
  0857'   D1                    	POP	D		; DE = the offset of the byte at HL
  0858'                         TT_LP:
  0858'   7D                    	MOV	A,L
  0859'   91                    	SUB	C
  085A'   7C                    	MOV	A,H
  085B'   98                    	SBB	B
  085C'   D2 0878'              	JNC	TT_NO		; reached end of text -> no tab
  085F'   7E                    	MOV	A,M
  0860'   FE 0A                 	CPI	LF
  0862'   CA 0878'              	JZ	TT_NO		; end of line -> no tab
  0865'   FE 0D                 	CPI	CR
  0867'   CA 086F'              	JZ	TT_NX		; (the line end's own)
  086A'   FE 20                 	CPI	' '
  086C'   DA 0874'              	JC	TT_YES
  086F'                         TT_NX:
  086F'   23                    	INX	H
  0870'   13                    	INX	D
  0871'   C3 0858'              	JMP	TT_LP
  0874'                         TT_YES:
  0874'   C1                    	POP	B
  0875'   3E 01                 	MVI	A,1
  0877'   C9                    	RET
  0878'                         TT_NO:
  0878'   C1                    	POP	B
  0879'   AF                    	XRA	A
  087A'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  087B'                         VC_H:
  087B'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  087E'   22 2E2B'              	SHLD	CNTV
  0881'                         VCH_LP:
  0881'   2A 2E2B'              	LHLD	CNTV
  0884'   7C                    	MOV	A,H
  0885'   B5                    	ORA	L
  0886'   C8                    	RZ
  0887'   2B                    	DCX	H
  0888'   22 2E2B'              	SHLD	CNTV
  088B'   CD 0891'              	CALL	HSTEP
  088E'   C3 0881'              	JMP	VCH_LP
  0891'                         HSTEP:
  0891'   CD 0000*              	CALL	CUROFF		; HL = cur
  0894'   7C                    	MOV	A,H
  0895'   B5                    	ORA	L
  0896'   C8                    	RZ			; at 0
  0897'   E5                    	PUSH	H
  0898'   CD 0624'              	CALL	BOL		; HL = bol
  089B'   D1                    	POP	D		; DE = cur
  089C'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  089F'   C8                    	RZ			; at BOL, cannot go left
  08A0'   EB                    	XCHG			; HL = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A1'   2B                    	DCX	H
  08A2'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  08A5'                         VC_L:
  08A5'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08A8'   22 2E2B'              	SHLD	CNTV
  08AB'                         VCL_LP:
  08AB'   2A 2E2B'              	LHLD	CNTV
  08AE'   7C                    	MOV	A,H
  08AF'   B5                    	ORA	L
  08B0'   C8                    	RZ
  08B1'   2B                    	DCX	H
  08B2'   22 2E2B'              	SHLD	CNTV
  08B5'   CD 08BB'              	CALL	LSTEP
  08B8'   C3 08AB'              	JMP	VCL_LP
  08BB'                         LSTEP:
  08BB'   CD 0000*              	CALL	CUROFF		; HL = cur
  08BE'   E5                    	PUSH	H
  08BF'   CD 06CA'              	CALL	EOLC		; HL = eolc
  08C2'   D1                    	POP	D		; DE = cur
  08C3'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  08C6'   D2 08CE'              	JNC	LS_NO		; cur >= eolc, cannot go right
  08C9'   EB                    	XCHG			; HL = cur
  08CA'   23                    	INX	H
  08CB'   C3 05BA'              	JMP	GOSET
  08CE'                         LS_NO:				; on the line's last char.  An operator waiting on
  08CE'   CD 0C9A'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  08D1'   C8                    	RZ			;   motion inclusive when it falls short), which
  08D2'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  08D4'   32 2DE9'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  08D7'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  08D8'                         VC_0:
  08D8'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08DB'   CD 08E5'              	CALL	LNSTRT
  08DE'   21 0000               	LXI	H,0
  08E1'   22 2DE6'              	SHLD	GOALCOL
  08E4'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  08E5'                         LNSTRT:
  08E5'   CD 12B5'              	CALL	ZSAVE
  08E8'   21 0000               	LXI	H,0
  08EB'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  08EE'   E5                    	PUSH	H
  08EF'   CD 12C8'              	CALL	ZREST
  08F2'   E1                    	POP	H
  08F3'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  08F6'                         VC_CRT:
  08F6'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  08F9'   C3 08FC'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  08FC'                         FNBLNK:
  08FC'   CD 08E5'              	CALL	LNSTRT
  08FF'   CD 0000*              	CALL	RGET0
  0902'   11 0000               	LXI	D,0		; DE = blanks skipped
  0905'                         FN_LP:
  0905'   CD 0000*              	CALL	RDGET
  0908'   DA 092B'              	JC	FN_GO		; the end of the file
  090B'   FE 20                 	CPI	' '
  090D'   CA 0915'              	JZ	FN_WH
  0910'   FE 09                 	CPI	TAB
  0912'   C2 092B'              	JNZ	FN_GO		; a non-blank, or the line's end
  0915'                         FN_WH:
  0915'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0918'   DA 092B'              	JC	FN_GO
  091B'   FE 0D                 	CPI	CR
  091D'   CA 092B'              	JZ	FN_GO
  0920'   FE 0A                 	CPI	LF
  0922'   CA 092B'              	JZ	FN_GO
  0925'   2B                    	DCX	H		; not yet: read that char again
  0926'   03                    	INX	B
  0927'   13                    	INX	D
  0928'   C3 0905'              	JMP	FN_LP
  092B'                         FN_GO:
  092B'   D5                    	PUSH	D
  092C'   CD 0000*              	CALL	CUROFF
  092F'   D1                    	POP	D
  0930'   19                    	DAD	D
  0931'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0934'                         VC_EOL:
  0934'   CD 0807'              	CALL	SETMOV
  0937'   21 FFFF               	LXI	H,0FFFFH
  093A'   22 2DE6'              	SHLD	GOALCOL
  093D'   CD 0732'              	CALL	GETCNT
  0940'   2B                    	DCX	H		; count-1
  0941'   7C                    	MOV	A,H
  0942'   B5                    	ORA	L
  0943'   CA 0952'              	JZ	VEOL_0
  0946'   E5                    	PUSH	H
  0947'   CD 0967'              	CALL	ONLAST
  094A'   E1                    	POP	H
  094B'   D8                    	RC			; the last line: no move (vim)
  094C'   CD 09B7'              	CALL	JCORE
  094F'   C3 0B06'              	JMP	JKLAND
  0952'                         VEOL_0:
  0952'   CD 08E5'              	CALL	LNSTRT
  0955'   C3 0B06'              	JMP	JKLAND
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0958'                         VC_CR:
  0958'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  095B'   E5                    	PUSH	H
  095C'   CD 0967'              	CALL	ONLAST
  095F'   E1                    	POP	H
  0960'   D8                    	RC
  0961'   CD 09B7'              	CALL	JCORE
  0964'   C3 08FC'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0967'                         ONLAST:
  0967'   CD 0000*              	CALL	RGET0
  096A'                         OL_LP:
  096A'   CD 0000*              	CALL	RDGET
  096D'   D8                    	RC			; the file ends on this line
  096E'   FE 0A                 	CPI	LF
  0970'   C2 096A'              	JNZ	OL_LP
  0973'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0976'                         VC_J:
  0976'   CD 0807'              	CALL	SETMOV
  0979'   CD 09A1'              	CALL	GLCHK		; the goal column, from the cursor if stale
  097C'   CD 0732'              	CALL	GETCNT		; HL = count
  097F'   CD 09B7'              	CALL	JCORE
  0982'   CD 099A'              	CALL	JKDRP
  0985'   C3 0B06'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0988'                         VC_K:
  0988'   CD 0807'              	CALL	SETMOV
  098B'   CD 09A1'              	CALL	GLCHK
  098E'   CD 0732'              	CALL	GETCNT
  0991'   CD 0A54'              	CALL	KCORE
  0994'   CD 099A'              	CALL	JKDRP
  0997'   C3 0B06'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ; takes its line.
  099A'                         JKDRP:
  099A'   7A                    	MOV	A,D
  099B'   B3                    	ORA	E
  099C'   C0                    	RNZ
  099D'   32 2E13'              	STA	PSAVE
  09A0'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09A1'                         GLCHK:
  09A1'   2A 2DE6'              	LHLD	GOALCOL
  09A4'   7C                    	MOV	A,H
  09A5'   3C                    	INR	A
  09A6'   C0                    	RNZ
  09A7'   7D                    	MOV	A,L
  09A8'   FE FE                 	CPI	0FEH
  09AA'   C0                    	RNZ
  09AB'   C3 05BD'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  09AE'                         GLSTAL:
  09AE'   E5                    	PUSH	H
  09AF'   21 FFFE               	LXI	H,0FFFEH
  09B2'   22 2DE6'              	SHLD	GOALCOL
  09B5'   E1                    	POP	H
  09B6'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  09B7'                         JCORE:
  09B7'   7C                    	MOV	A,H
  09B8'   B5                    	ORA	L
  09B9'   C8                    	RZ
  09BA'   22 2DF7'              	SHLD	JKCNT
  09BD'   CD 0DC9'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  09C0'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  09C1'   3A 0000*              	LDA	NEDIT
  09C4'   3C                    	INR	A
  09C5'   90                    	SUB	B
  09C6'   5F                    	MOV	E,A
  09C7'   16 00                 	MVI	D,0
  09C9'   3A 0000*              	LDA	NEDIT
  09CC'   6F                    	MOV	L,A
  09CD'   26 00                 	MVI	H,0
  09CF'   19                    	DAD	D
  09D0'   EB                    	XCHG			; DE = limit
  09D1'   2A 2DF7'              	LHLD	JKCNT
  09D4'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09D7'   D2 09DB'              	JNC	JC_N
  09DA'   EB                    	XCHG			; HL = limit
  09DB'                         JC_N:
  09DB'   22 2DF9'              	SHLD	JKN		; N = min(count, limit)
  09DE'   EB                    	XCHG			; DE = LFs to find
  09DF'   CD 0000*              	CALL	RGET0
  09E2'                         JC_SC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E2'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  09E5'   DA 0A04'              	JC	JC_EOF
  09E8'   32 2E00'              	STA	JKLST
  09EB'   FE 0A                 	CPI	LF
  09ED'   C2 09E2'              	JNZ	JC_SC
  09F0'   1B                    	DCX	D
  09F1'   7A                    	MOV	A,D
  09F2'   B3                    	ORA	E
  09F3'   C2 09E2'              	JNZ	JC_SC
  09F6'   2A 2DF7'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  09F9'   22 2DFB'              	SHLD	JKMOV		;   one if the last LF found ends the file
  09FC'   3E 01                 	MVI	A,1
  09FE'   32 2DFF'              	STA	JKPHN
  0A01'   C3 0A1F'              	JMP	JC_MV
  0A04'                         JC_EOF:
  0A04'   2A 2DF9'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A07'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A0A'   7C                    	MOV	A,H
  0A0B'   B5                    	ORA	L
  0A0C'   CA 0A18'              	JZ	JC_AV
  0A0F'   3A 2E00'              	LDA	JKLST
  0A12'   FE 0A                 	CPI	LF
  0A14'   C2 0A18'              	JNZ	JC_AV
  0A17'   2B                    	DCX	H
  0A18'                         JC_AV:
  0A18'   22 2DFB'              	SHLD	JKMOV
  0A1B'   AF                    	XRA	A
  0A1C'   32 2DFF'              	STA	JKPHN
  0A1F'                         JC_MV:
  0A1F'   2A 2DF7'              	LHLD	JKCNT
  0A22'   AF                    	XRA	A
  0A23'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0A26'   CD 0AE5'              	CALL	ATEOF
  0A29'   D2 0A3D'              	JNC	JC_DN
  0A2C'   CD 0AEB'              	CALL	LASTLN		; ran past the last line: back onto it
  0A2F'   3A 2DFF'              	LDA	JKPHN
  0A32'   B7                    	ORA	A
  0A33'   CA 0A3D'              	JZ	JC_DN
  0A36'   2A 2DFB'              	LHLD	JKMOV
  0A39'   2B                    	DCX	H
  0A3A'   22 2DFB'              	SHLD	JKMOV
  0A3D'                         JC_DN:
  0A3D'   2A 2DF9'              	LHLD	JKN		; LNDLT += min(moved, N)
  0A40'   EB                    	XCHG
  0A41'   2A 2DFB'              	LHLD	JKMOV
  0A44'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0A47'   D2 0A4B'              	JNC	JC_AD
  0A4A'   EB                    	XCHG
  0A4B'                         JC_AD:
  0A4B'   EB                    	XCHG			; DE = lines moved
  0A4C'   2A 0000*              	LHLD	LNDLT
  0A4F'   19                    	DAD	D
  0A50'   22 0000*              	SHLD	LNDLT
  0A53'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


                                ; line when the file starts first); LNDLT -= the lines moved.
  0A54'                         KCORE:
  0A54'   7C                    	MOV	A,H
  0A55'   B5                    	ORA	L
  0A56'   C8                    	RZ
  0A57'   22 2DF7'              	SHLD	JKCNT
  0A5A'   CD 0DC9'              	CALL	CURRW		; limit = row + NEDIT
  0A5D'   5F                    	MOV	E,A
  0A5E'   16 00                 	MVI	D,0
  0A60'   3A 0000*              	LDA	NEDIT
  0A63'   6F                    	MOV	L,A
  0A64'   26 00                 	MVI	H,0
  0A66'   19                    	DAD	D
  0A67'   EB                    	XCHG			; DE = limit
  0A68'   2A 2DF7'              	LHLD	JKCNT
  0A6B'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A6E'   D2 0A72'              	JNC	KC_N
  0A71'   EB                    	XCHG			; HL = limit
  0A72'                         KC_N:
  0A72'   22 2DF9'              	SHLD	JKN		; N = min(count, limit)
  0A75'   EB                    	XCHG			; DE = LFs to find
  0A76'   21 0000               	LXI	H,0
  0A79'   22 2DFD'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0A7C'                         KC_ED:
  0A7C'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A7D'   2A 2DFD'              	LHLD	JKBK
  0A80'   CD 072B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A83'   E5                    	PUSH	H
  0A84'   EB                    	XCHG
  0A85'   2A 0000*              	LHLD	TXTBEG
  0A88'   EB                    	XCHG
  0A89'   CD 0000*              	CALL	SUBHD
  0A8C'   44                    	MOV	B,H
  0A8D'   4D                    	MOV	C,L
  0A8E'   E1                    	POP	H
  0A8F'   D1                    	POP	D
  0A90'                         KC_SC:
  0A90'   78                    	MOV	A,B
  0A91'   B1                    	ORA	C
  0A92'   CA 0AA9'              	JZ	KC_TB
  0A95'   2B                    	DCX	H
  0A96'   0B                    	DCX	B
  0A97'   7E                    	MOV	A,M
  0A98'   FE 0A                 	CPI	LF
  0A9A'   C2 0A90'              	JNZ	KC_SC
  0A9D'   1B                    	DCX	D
  0A9E'   7A                    	MOV	A,D
  0A9F'   B3                    	ORA	E
  0AA0'   C2 0A90'              	JNZ	KC_SC
  0AA3'   2A 2DF7'              	LHLD	JKCNT		; N lines above: the move is count lines
  0AA6'   C3 0AC9'              	JMP	KC_MV
  0AA9'                         KC_TB:
  0AA9'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0AAA'   CD 072B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0AAD'   22 2DFD'              	SHLD	JKBK
  0AB0'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AB3'   7C                    	MOV	A,H
  0AB4'   B5                    	ORA	L
  0AB5'   CA 0AC2'              	JZ	KC_B0
  0AB8'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0ABB'   D1                    	POP	D
  0ABC'   DA 0AC3'              	JC	KC_BOF
  0ABF'   C3 0A7C'              	JMP	KC_ED
  0AC2'                         KC_B0:
  0AC2'   D1                    	POP	D
  0AC3'                         KC_BOF:
  0AC3'   2A 2DF9'              	LHLD	JKN		; moved = LFs found
  0AC6'   CD 0000*              	CALL	SUBHD
  0AC9'                         KC_MV:
  0AC9'   E5                    	PUSH	H
  0ACA'   2A 2DF7'              	LHLD	JKCNT
  0ACD'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0AD0'   D1                    	POP	D		; DE = moved
  0AD1'   2A 2DF9'              	LHLD	JKN
  0AD4'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0AD7'   DA 0ADB'              	JC	KC_AD
  0ADA'   EB                    	XCHG			; DE = N
  0ADB'                         KC_AD:
  0ADB'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0ADE'   CD 0000*              	CALL	SUBHD
  0AE1'   22 0000*              	SHLD	LNDLT
  0AE4'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0AE5'                         ATEOF:
  0AE5'   CD 0000*              	CALL	RGET0
  0AE8'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0AEB'                         LASTLN:
  0AEB'   2A 0000*              	LHLD	GAPBEG
  0AEE'   EB                    	XCHG
  0AEF'   2A 0000*              	LHLD	TXTBEG
  0AF2'   CD 0000*              	CALL	CMP16
  0AF5'   21 0000               	LXI	H,0
  0AF8'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0AFB'   1B                    	DCX	D
  0AFC'   1A                    	LDAX	D
  0AFD'   FE 0A                 	CPI	LF
  0AFF'   C2 0000*              	JNZ	SETBWD
  0B02'   23                    	INX	H
  0B03'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0B06'                         JKLAND:
  0B06'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B09'   22 2E01'              	SHLD	JKVC		; screen column
  0B0C'   2B                    	DCX	H
  0B0D'   22 2E03'              	SHLD	JKLS		; last content char: none yet
  0B10'   CD 0000*              	CALL	RGET0
  0B13'   11 0000               	LXI	D,0		; DE = chars read
  0B16'                         JL_RD:
  0B16'   CD 0000*              	CALL	RDGET
  0B19'   DA 0B53'              	JC	JL_END
  0B1C'   FE 0A                 	CPI	LF
  0B1E'   CA 0B53'              	JZ	JL_END
  0B21'   E5                    	PUSH	H
  0B22'   C5                    	PUSH	B
  0B23'   2A 2E01'              	LHLD	JKVC
  0B26'   CD 0611'              	CALL	CWID
  0B29'   B7                    	ORA	A
  0B2A'   CA 0B4D'              	JZ	JL_NX		; a CR
  0B2D'   EB                    	XCHG
  0B2E'   22 2E03'              	SHLD	JKLS		; the last content char so far
  0B31'   EB                    	XCHG
  0B32'   4F                    	MOV	C,A
  0B33'   06 00                 	MVI	B,0
  0B35'   09                    	DAD	B		; HL = the column after this char
  0B36'   22 2E01'              	SHLD	JKVC
  0B39'   D5                    	PUSH	D
  0B3A'   EB                    	XCHG
  0B3B'   2A 2DE6'              	LHLD	GOALCOL
  0B3E'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0B41'   D1                    	POP	D
  0B42'   DA 0B4D'              	JC	JL_NX
  0B45'   CA 0B4D'              	JZ	JL_NX
  0B48'   C1                    	POP	B		; this char holds the goal column
  0B49'   E1                    	POP	H
  0B4A'   C3 0B5E'              	JMP	JL_GO
  0B4D'                         JL_NX:
  0B4D'   C1                    	POP	B
  0B4E'   E1                    	POP	H
  0B4F'   13                    	INX	D
  0B50'   C3 0B16'              	JMP	JL_RD
  0B53'                         JL_END:
  0B53'   2A 2E03'              	LHLD	JKLS		; past the line's end: its last content char
  0B56'   7C                    	MOV	A,H
  0B57'   A5                    	ANA	L
  0B58'   3C                    	INR	A
  0B59'   C2 0B5D'              	JNZ	JL_LS
  0B5C'   23                    	INX	H		; no content: the line's start
  0B5D'                         JL_LS:
  0B5D'   EB                    	XCHG
  0B5E'                         JL_GO:
  0B5E'   D5                    	PUSH	D		; DE = step from the line start
  0B5F'   CD 0000*              	CALL	CUROFF
  0B62'   D1                    	POP	D
  0B63'   19                    	DAD	D
  0B64'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0B67'   AF                    VC_W:	XRA	A
  0B68'   32 2DE8'              	STA	WBIG
  0B6B'   C3 0B73'              	JMP	WDO
  0B6E'   3E 01                 VCBGW:	MVI	A,1
  0B70'   32 2DE8'              	STA	WBIG
  0B73'   CD 0807'              WDO:	CALL	SETMOV
  0B76'   AF                    	XRA	A
  0B77'   32 2DE9'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0B7A'   CD 0732'              	CALL	GETCNT
  0B7D'   22 2E2B'              	SHLD	CNTV
  0B80'   2A 2E2B'              WDO_LP: LHLD	CNTV
  0B83'   7C                    	MOV	A,H
  0B84'   B5                    	ORA	L
  0B85'   CA 0B92'              	JZ	WDO_DN
  0B88'   2B                    	DCX	H
  0B89'   22 2E2B'              	SHLD	CNTV
  0B8C'   CD 0BEF'              	CALL	FWD1
  0B8F'   D2 0B80'              	JNC	WDO_LP
  0B92'                         WDO_DN:
  0B92'   CD 0AE5'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B95'   DA 0BA2'              	JC	WDO_NL
  0B98'   FE 0D                 	CPI	CR
  0B9A'   CA 0BA2'              	JZ	WDO_NL
  0B9D'   FE 0A                 	CPI	LF
  0B9F'   C2 05BD'              	JNZ	SETGL
  0BA2'                         WDO_NL:
  0BA2'   CD 0000*              	CALL	PEEKL
  0BA5'   DA 05BD'              	JC	SETGL
  0BA8'   FE 0A                 	CPI	LF
  0BAA'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0BAD'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0BAF'   32 2DE9'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0BB2'   CD 0D0E'              	CALL	DECC		; back onto its last char
  0BB5'   C3 05BD'              	JMP	SETGL
                                
  0BB8'   AF                    VC_B:	XRA	A
  0BB9'   32 2DE8'              	STA	WBIG
  0BBC'   C3 0BC4'              	JMP	BDO
  0BBF'   3E 01                 VCBGB:	MVI	A,1
  0BC1'   32 2DE8'              	STA	WBIG
  0BC4'   CD 0807'              BDO:	CALL	SETMOV
  0BC7'   CD 0732'              	CALL	GETCNT
  0BCA'   22 2E2B'              	SHLD	CNTV
  0BCD'   CD 0C5F'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0BD0'   D2 0BE0'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0BD3'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BD4'   32 2E13'              	STA	PSAVE		;   first char opened an insert).  A count that
  0BD7'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0BDA'                         BDO_LP:				;   its operator stands -- both as vim
  0BDA'   CD 0C5F'              	CALL	BCK1
  0BDD'   DA 05BD'              	JC	SETGL
  0BE0'   2A 2E2B'              BDO_NX: LHLD	CNTV
  0BE3'   2B                    	DCX	H
  0BE4'   22 2E2B'              	SHLD	CNTV
  0BE7'   7C                    	MOV	A,H
  0BE8'   B5                    	ORA	L
  0BE9'   C2 0BDA'              	JNZ	BDO_LP
  0BEC'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0BEF'                         FWD1:
  0BEF'   CD 0C92'              	CALL	CCLS
  0BF2'   32 2E33'              	STA	WKCLS		; the starting class
  0BF5'   CD 0CCC'              	CALL	INCC
  0BF8'   B7                    	ORA	A
  0BF9'   CA 0C12'              	JZ	FW_WD
  0BFC'   37                    	STC
  0BFD'   F8                    	RM			; -1: already at the end
  0BFE'   CD 0C4A'              	CALL	WLAST
  0C01'   C8                    	RZ
  0C02'   FE 02                 	CPI	2
  0C04'   C2 0C12'              	JNZ	FW_WD		; 1: a next line was reached
  0C07'   CD 0AE5'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0C0A'   D4 0CB3'              	CNC	NXLN
  0C0D'   D2 0C12'              	JNC	FW_WD
  0C10'   37                    	STC			; yes: failed
  0C11'   C9                    	RET
  0C12'                         FW_WD:
  0C12'   3A 2E33'              	LDA	WKCLS		; go past the rest of this word
  0C15'   B7                    	ORA	A
  0C16'   CA 0C32'              	JZ	FW_WS
  0C19'                         FW_WLP:
  0C19'   CD 0C92'              	CALL	CCLS
  0C1C'   21 2E33'              	LXI	H,WKCLS
  0C1F'   BE                    	CMP	M
  0C20'   C2 0C32'              	JNZ	FW_WS
  0C23'   CD 0CCC'              	CALL	INCC
  0C26'   B7                    	ORA	A
  0C27'   F8                    	RM			; the end of the file (NC)
  0C28'   CA 0C19'              	JZ	FW_WLP
  0C2B'   CD 0C4A'              	CALL	WLAST
  0C2E'   C8                    	RZ
  0C2F'   C3 0C19'              	JMP	FW_WLP
  0C32'                         FW_WS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C32'   CD 0C92'              	CALL	CCLS		; then over blanks to the next word
  0C35'   B7                    	ORA	A
  0C36'   C0                    	RNZ
  0C37'   CD 0C9A'              	CALL	EMPTY
  0C3A'   C8                    	RZ			; an empty line is a word
  0C3B'   CD 0CCC'              	CALL	INCC
  0C3E'   B7                    	ORA	A
  0C3F'   F8                    	RM
  0C40'   CA 0C32'              	JZ	FW_WS
  0C43'   CD 0C4A'              	CALL	WLAST
  0C46'   C8                    	RZ
  0C47'   C3 0C32'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0C4A'                         WLAST:
  0C4A'   47                    	MOV	B,A
  0C4B'   2A 2E2B'              	LHLD	CNTV
  0C4E'   7C                    	MOV	A,H
  0C4F'   B5                    	ORA	L
  0C50'   C2 0C5B'              	JNZ	WL_X		; words still owed
  0C53'   3A 2E13'              	LDA	PSAVE
  0C56'   B7                    	ORA	A
  0C57'   CA 0C5D'              	JZ	WL_NO		; a plain 'w'
  0C5A'   AF                    	XRA	A
  0C5B'   78                    WL_X:	MOV	A,B
  0C5C'   C9                    	RET
  0C5D'   B0                    WL_NO:	ORA	B
  0C5E'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0C5F'                         BCK1:
  0C5F'   CD 0D0E'              	CALL	DECC
  0C62'   B7                    	ORA	A
  0C63'   37                    	STC
  0C64'   F8                    	RM
  0C65'                         BK_WS:
  0C65'   CD 0C92'              	CALL	CCLS		; back over blanks
  0C68'   B7                    	ORA	A
  0C69'   C2 0C79'              	JNZ	BK_WD
  0C6C'   CD 0C9A'              	CALL	EMPTY
  0C6F'   C8                    	RZ			; an empty line is a word
  0C70'   CD 0D0E'              	CALL	DECC
  0C73'   B7                    	ORA	A
  0C74'   F2 0C65'              	JP	BK_WS
  0C77'   AF                    	XRA	A		; the start of the file (NC)
  0C78'   C9                    	RET
  0C79'                         BK_WD:
  0C79'   32 2E33'              	STA	WKCLS		; back to the start of this word
  0C7C'                         BK_WLP:
  0C7C'   CD 0D0E'              	CALL	DECC
  0C7F'   B7                    	ORA	A
  0C80'   FA 0C90'              	JM	BK_OK		; the start of the file
  0C83'   CD 0C92'              	CALL	CCLS
  0C86'   21 2E33'              	LXI	H,WKCLS
  0C89'   BE                    	CMP	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C8A'   CA 0C7C'              	JZ	BK_WLP
  0C8D'   CD 0CCC'              	CALL	INCC		; overshot: forward one
  0C90'                         BK_OK:
  0C90'   AF                    	XRA	A
  0C91'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C92'                         CCLS:
  0C92'   CD 0AE5'              	CALL	ATEOF
  0C95'   D2 07BC'              	JNC	CLASSF
  0C98'   AF                    	XRA	A
  0C99'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C9A'                         EMPTY:
  0C9A'   CD 0AE5'              	CALL	ATEOF
  0C9D'   DA 0CA8'              	JC	EM_ST
  0CA0'   FE 0D                 	CPI	CR
  0CA2'   CA 0CA8'              	JZ	EM_ST
  0CA5'   FE 0A                 	CPI	LF
  0CA7'   C0                    	RNZ
  0CA8'                         EM_ST:
  0CA8'   CD 0000*              	CALL	PEEKL
  0CAB'   DA 0CB1'              	JC	EM_Y
  0CAE'   FE 0A                 	CPI	LF
  0CB0'   C9                    	RET
  0CB1'                         EM_Y:
  0CB1'   AF                    	XRA	A
  0CB2'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0CB3'                         NXLN:
  0CB3'   FE 0A                 	CPI	LF
  0CB5'   CA 0CC4'              	JZ	NX_LF
  0CB8'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0CBB'   D8                    	RC
  0CBC'   FE 0A                 	CPI	LF
  0CBE'   CA 0CC4'              	JZ	NX_LF
  0CC1'   2B                    	DCX	H		; a lone CR
  0CC2'   AF                    	XRA	A
  0CC3'   C9                    	RET
  0CC4'                         NX_LF:
  0CC4'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0CC7'   D8                    	RC
  0CC8'   2B                    	DCX	H
  0CC9'   3E 01                 	MVI	A,1
  0CCB'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0CCC'                         INCC:
  0CCC'   CD 0AE5'              	CALL	ATEOF
  0CCF'   DA 0D0A'              	JC	IC_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CD2'   FE 0D                 	CPI	CR
  0CD4'   CA 0CF5'              	JZ	IC_NL
  0CD7'   FE 0A                 	CPI	LF
  0CD9'   CA 0CF5'              	JZ	IC_NL
  0CDC'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0CDF'                         IC_CH:
  0CDF'   CD 0AE5'              	CALL	ATEOF
  0CE2'   DA 0CF1'              	JC	IC_2
  0CE5'   FE 0D                 	CPI	CR
  0CE7'   CA 0CF1'              	JZ	IC_2
  0CEA'   FE 0A                 	CPI	LF
  0CEC'   CA 0CF1'              	JZ	IC_2
  0CEF'   AF                    	XRA	A
  0CF0'   C9                    	RET
  0CF1'                         IC_2:
  0CF1'   3E 02                 	MVI	A,2
  0CF3'   B7                    	ORA	A
  0CF4'   C9                    	RET
  0CF5'                         IC_NL:
  0CF5'   CD 0CB3'              	CALL	NXLN
  0CF8'   DA 0D0A'              	JC	IC_END
  0CFB'   F5                    	PUSH	PSW
  0CFC'   CD 0000*              	CALL	PUTCUR
  0CFF'   F1                    	POP	PSW
  0D00'   B7                    	ORA	A
  0D01'   CA 0CDF'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0D04'   CD 0D30'              	CALL	LNINC
  0D07'   3E 01                 	MVI	A,1
  0D09'   C9                    	RET
  0D0A'                         IC_END:
  0D0A'   3E FF                 	MVI	A,0FFH
  0D0C'   B7                    	ORA	A
  0D0D'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0D0E'                         DECC:
  0D0E'   CD 0000*              	CALL	PEEKL
  0D11'   DA 0D0A'              	JC	IC_END
  0D14'   F5                    	PUSH	PSW
  0D15'   CD 0000*              	CALL	PUTCUR
  0D18'   F1                    	POP	PSW
  0D19'   FE 0A                 	CPI	LF
  0D1B'   3E 00                 	MVI	A,0
  0D1D'   C0                    	RNZ
  0D1E'   CD 0D3E'              	CALL	LNDEC
  0D21'   CD 0000*              	CALL	PEEKL		; onto its CR
  0D24'   DA 0D2C'              	JC	DC_1
  0D27'   FE 0D                 	CPI	CR
  0D29'   CC 0000*              	CZ	PUTCUR
  0D2C'                         DC_1:
  0D2C'   3E 01                 	MVI	A,1
  0D2E'   B7                    	ORA	A
  0D2F'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ; (a count through a file of empty lines).  Keep all but A.
  0D30'                         LNINC:
  0D30'   E5                    	PUSH	H
  0D31'   2A 0000*              	LHLD	LNDLT
  0D34'   7C                    	MOV	A,H
  0D35'   FE 40                 	CPI	40H
  0D37'   CA 0D4C'              	JZ	LN_X
  0D3A'   23                    	INX	H
  0D3B'   C3 0D49'              	JMP	LN_ST
  0D3E'                         LNDEC:
  0D3E'   E5                    	PUSH	H
  0D3F'   2A 0000*              	LHLD	LNDLT
  0D42'   7C                    	MOV	A,H
  0D43'   FE C0                 	CPI	0C0H
  0D45'   CA 0D4C'              	JZ	LN_X
  0D48'   2B                    	DCX	H
  0D49'                         LN_ST:
  0D49'   22 0000*              	SHLD	LNDLT
  0D4C'                         LN_X:
  0D4C'   E1                    	POP	H
  0D4D'   C9                    	RET
                                
  0D4E'   AF                    VC_E:	XRA	A
  0D4F'   32 2DE8'              	STA	WBIG
  0D52'   C3 0D5A'              	JMP	EDO
  0D55'   3E 01                 VCBGE:	MVI	A,1
  0D57'   32 2DE8'              	STA	WBIG
  0D5A'   CD 0807'              EDO:	CALL	SETMOV
  0D5D'   CD 0732'              	CALL	GETCNT
  0D60'   22 2E2B'              	SHLD	CNTV
  0D63'   2A 2E2B'              EDO_LP: LHLD	CNTV
  0D66'   7C                    	MOV	A,H
  0D67'   B5                    	ORA	L
  0D68'   CA 0B92'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0D6B'   2B                    	DCX	H
  0D6C'   22 2E2B'              	SHLD	CNTV
  0D6F'   CD 0D7D'              	CALL	ESTEP
  0D72'   21 2E16'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0D75'   36 00                 	MVI	M,0
  0D77'   D2 0D63'              	JNC	EDO_LP
  0D7A'   C3 0B92'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0D7D'                         ESTEP:
  0D7D'   CD 0C92'              	CALL	CCLS
  0D80'   32 2E33'              	STA	WKCLS		; the starting class
  0D83'   CD 0CCC'              	CALL	INCC
  0D86'   B7                    	ORA	A
  0D87'   FA 0DAD'              	JM	ES_F
  0D8A'   CD 0C92'              	CALL	CCLS
  0D8D'   B7                    	ORA	A
  0D8E'   CA 0D98'              	JZ	ES_ST
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D91'   21 2E33'              	LXI	H,WKCLS
  0D94'   BE                    	CMP	M
  0D95'   CA 0DAF'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D98'                         ES_ST:
  0D98'   3A 2E16'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D9B'   B7                    	ORA	A		;   that char is the word's end already, and
  0D9C'   C2 0DC6'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D9F'                         ES_WS:
  0D9F'   CD 0C92'              	CALL	CCLS		; over blanks, line ends and empty lines
  0DA2'   B7                    	ORA	A
  0DA3'   C2 0DAF'              	JNZ	ES_SK
  0DA6'   CD 0CCC'              	CALL	INCC
  0DA9'   B7                    	ORA	A
  0DAA'   F2 0D9F'              	JP	ES_WS
  0DAD'                         ES_F:
  0DAD'   37                    	STC
  0DAE'   C9                    	RET
  0DAF'                         ES_SK:
  0DAF'   CD 0C92'              	CALL	CCLS		; past the rest of this word ...
  0DB2'   32 2E33'              	STA	WKCLS
  0DB5'                         ES_SL:
  0DB5'   CD 0CCC'              	CALL	INCC
  0DB8'   B7                    	ORA	A
  0DB9'   FA 0DAD'              	JM	ES_F
  0DBC'   CD 0C92'              	CALL	CCLS
  0DBF'   21 2E33'              	LXI	H,WKCLS
  0DC2'   BE                    	CMP	M
  0DC3'   CA 0DB5'              	JZ	ES_SL
  0DC6'   C3 0D0E'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0DC9'                         CURRW:
  0DC9'   2A 0000*              	LHLD	WINROW
  0DCC'   EB                    	XCHG
  0DCD'   2A 0000*              	LHLD	LNDLT
  0DD0'   19                    	DAD	D		; HL = row (signed)
  0DD1'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD2'   B7                    	ORA	A
  0DD3'   FA 0DE6'              	JM	CRW_0		; above the screen -> top row
  0DD6'   C2 0DE1'              	JNZ	CRW_BT		; far below -> bottom row
  0DD9'   3A 0000*              	LDA	NEDIT
  0DDC'   3D                    	DCR	A		; A = bottom row
  0DDD'   BD                    	CMP	L		; CY iff bottom < row
  0DDE'   D8                    	RC
  0DDF'   7D                    	MOV	A,L
  0DE0'   C9                    	RET
  0DE1'                         CRW_BT:
  0DE1'   3A 0000*              	LDA	NEDIT
  0DE4'   3D                    	DCR	A
  0DE5'   C9                    	RET
  0DE6'                         CRW_0:
  0DE6'   AF                    	XRA	A
  0DE7'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0DE8'                         SETRWT:
  0DE8'   2A 0000*              	LHLD	LNDLT
  0DEB'   EB                    	XCHG
  0DEC'   6F                    	MOV	L,A
  0DED'   26 00                 	MVI	H,0
  0DEF'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0DF2'   22 0000*              	SHLD	WINROW
  0DF5'   3E 01                 	MVI	A,PL_SET
  0DF7'   32 0000*              	STA	PLACE
  0DFA'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0DFB'                         MVROW:
  0DFB'   47                    	MOV	B,A
  0DFC'   CD 0DC9'              	CALL	CURRW
  0DFF'   90                    	SUB	B		; A = row now - target
  0E00'                         MR_GO:
  0E00'   C8                    	RZ
  0E01'   DA 0E0A'              	JC	MR_DN
  0E04'   6F                    	MOV	L,A
  0E05'   26 00                 	MVI	H,0
  0E07'   C3 0A54'              	JMP	KCORE
  0E0A'                         MR_DN:
  0E0A'   2F                    	CMA
  0E0B'   3C                    	INR	A		; A = target - row now
  0E0C'   6F                    	MOV	L,A
  0E0D'   26 00                 	MVI	H,0
  0E0F'   C3 09B7'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0E12'                         VC_HIGH:
  0E12'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E15'   2B                    	DCX	H		; row = count - 1
  0E16'   7C                    	MOV	A,H
  0E17'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E18'   3A 0000*              	LDA	SCBOT
  0E1B'   C2 0E23'              	JNZ	VH_GO		; >= 256 -> the last text row
  0E1E'   BD                    	CMP	L		; CY iff SCBOT < row
  0E1F'   DA 0E23'              	JC	VH_GO
  0E22'   7D                    	MOV	A,L
  0E23'                         VH_GO:
  0E23'   CD 0DFB'              	CALL	MVROW
  0E26'   C3 08FC'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0E29'                         VC_MIDL:
  0E29'   CD 071F'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0E2C'   CD 10BB'              	CALL	HTSCR		; HL -> the top line's rows
  0E2F'   3A 0000*              	LDA	TXEND
  0E32'   3C                    	INR	A
  0E33'   B7                    	ORA	A
  0E34'   1F                    	RAR
  0E35'   3D                    	DCR	A
  0E36'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0E37'   CD 1101'              	CALL	HTFQ
  0E3A'   D2 0E3E'              	JNC	VM_GO
  0E3D'   2B                    	DCX	H
  0E3E'                         VM_GO:
  0E3E'   CD 10F6'              	CALL	HTGO
  0E41'   C3 08FC'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0E44'                         VC_LOWL:
  0E44'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E47'   2B                    	DCX	H		; count - 1
  0E48'   3A 0000*              	LDA	SCBOT
  0E4B'   5F                    	MOV	E,A
  0E4C'   16 00                 	MVI	D,0
  0E4E'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0E4F'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0E52'   3E 00                 	MVI	A,0
  0E54'   D2 0E5B'              	JNC	VL_GO		; at or past the top -> row 0
  0E57'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0E5A'   7D                    	MOV	A,L
  0E5B'                         VL_GO:
  0E5B'   CD 0DFB'              	CALL	MVROW
  0E5E'   C3 08FC'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0E61'                         VC_PGDN:
  0E61'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0E64'   22 2DF3'              	SHLD	RWR
  0E67'   3A 0000*              	LDA	SCEOF
  0E6A'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E6B'   CA 0E73'              	JZ	VPD_N
  0E6E'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0E71'   B7                    	ORA	A		;   top line
  0E72'   C8                    	RZ			; it already is
  0E73'                         VPD_N:
  0E73'   3A 0000*              	LDA	NEDIT
  0E76'   3C                    	INR	A
  0E77'   4F                    	MOV	C,A
  0E78'   3E 02                 	MVI	A,2
  0E7A'   CD 10C2'              	CALL	HTSET		; HL -> the top line's rows
  0E7D'   E5                    	PUSH	H
  0E7E'   C5                    	PUSH	B
  0E7F'   3A 0000*              	LDA	NEDIT
  0E82'   4F                    	MOV	C,A
  0E83'   CD 1101'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0E86'   3A 0000*              	LDA	NEDIT
  0E89'   DA 0E96'              	JC	VPD_R		; there is none: no overlap
  0E8C'   3A 2DEE'              	LDA	HTN
  0E8F'   90                    	SUB	B
  0E90'   3C                    	INR	A
  0E91'   47                    	MOV	B,A		; the lines from it up to the table's first
  0E92'   AF                    	XRA	A
  0E93'   CD 0F30'              	CALL	OVLAP
  0E96'                         VPD_R:
  0E96'   CD 0F7F'              	CALL	PGROWS		; RWR = the rows to go
  0E99'   C1                    	POP	B
  0E9A'   E1                    	POP	H
  0E9B'   CD 1142'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0E9E'   DA 0EBA'              	JC	VPD_TP		; the text ended: its last line
  0EA1'   79                    	MOV	A,C
  0EA2'   B7                    	ORA	A
  0EA3'   CA 0EBA'              	JZ	VPD_TP
  0EA6'   3A 2DF5'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0EA9'   B7                    	ORA	A		;   that is the top line still, then the next
  0EAA'   C2 0EBA'              	JNZ	VPD_TP
  0EAD'   E5                    	PUSH	H
  0EAE'   CD 10F0'              	CALL	HTIX
  0EB1'   21 2DF0'              	LXI	H,HTTP
  0EB4'   BE                    	CMP	M
  0EB5'   E1                    	POP	H
  0EB6'   C2 0EBA'              	JNZ	VPD_TP
  0EB9'   23                    	INX	H
  0EBA'                         VPD_TP:
  0EBA'   54                    	MOV	D,H
  0EBB'   5D                    	MOV	E,L
  0EBC'   C3 1029'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0EBF'                         VC_PGUP:
  0EBF'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  0EC2'   22 2DF3'              	SHLD	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EC5'   3A 0000*              	LDA	SCBOF
  0EC8'   B7                    	ORA	A
  0EC9'   C0                    	RNZ
  0ECA'   CD 0DC9'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0ECD'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0ECF'   0E 01                 	MVI	C,1
  0ED1'   D2 0ED8'              	JNC	VPU_1
  0ED4'   3A 0000*              	LDA	NEDIT
  0ED7'   4F                    	MOV	C,A
  0ED8'                         VPU_1:
  0ED8'   3A 0000*              	LDA	NEDIT
  0EDB'   CD 10C2'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0EDE'   E5                    	PUSH	H
  0EDF'   D5                    	PUSH	D
  0EE0'   2B                    	DCX	H		; the line above the top one, and on down
  0EE1'   04                    	INR	B
  0EE2'   3E 01                 	MVI	A,1
  0EE4'   CD 0F30'              	CALL	OVLAP
  0EE7'   CD 0F7F'              	CALL	PGROWS		; RWR = the rows to go
  0EEA'   D1                    	POP	D
  0EEB'   E1                    	POP	H
  0EEC'   43                    	MOV	B,E
  0EED'   CD 1182'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0EF0'   DA 0F0D'              	JC	VPU_3		;   above it; or the file's first line
  0EF3'   79                    	MOV	A,C
  0EF4'   B7                    	ORA	A
  0EF5'   CA 0F0D'              	JZ	VPU_3
  0EF8'   3A 2DF5'              	LDA	RWMV
  0EFB'   B7                    	ORA	A
  0EFC'   C2 0F0C'              	JNZ	VPU_2
  0EFF'   E5                    	PUSH	H
  0F00'   CD 10F0'              	CALL	HTIX
  0F03'   3C                    	INR	A
  0F04'   21 2DF0'              	LXI	H,HTTP
  0F07'   BE                    	CMP	M
  0F08'   E1                    	POP	H
  0F09'   CA 0F0D'              	JZ	VPU_3		; the first line back: all of it
  0F0C'                         VPU_2:
  0F0C'   23                    	INX	H
  0F0D'                         VPU_3:
  0F0D'   CD 10F6'              	CALL	HTGO		; the cursor on the new top line ...
  0F10'   3A 0000*              	LDA	NEDIT
  0F13'   4F                    	MOV	C,A
  0F14'   06 00                 	MVI	B,0
  0F16'   CD 10D7'              	CALL	HTRB		; ... and the lines under it measured
  0F19'   E5                    	PUSH	H
  0F1A'   3A 0000*              	LDA	NEDIT
  0F1D'   4F                    	MOV	C,A
  0F1E'   CD 1101'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0F21'   2B                    	DCX	H
  0F22'   D1                    	POP	D		; DE -> the top line's rows
  0F23'   EB                    	XCHG
  0F24'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0F27'   D2 0F2C'              	JNC	VPU_4		;   fills the screen)
  0F2A'   54                    	MOV	D,H
  0F2B'   5D                    	MOV	E,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2C'                         VPU_4:
  0F2C'   EB                    	XCHG
  0F2D'   C3 1029'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0F30'                         OVLAP:
  0F30'   32 2DF6'              	STA	OVDIR
  0F33'   3A 0000*              	LDA	NEDIT
  0F36'   D6 02                 	SUI	2
  0F38'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0F39'   56                    	MOV	D,M		; D = h1
  0F3A'   CD 0F71'              	CALL	OV_NX
  0F3D'   DA 0F6D'              	JC	OV_0
  0F40'   5E                    	MOV	E,M		; E = h2
  0F41'   7A                    	MOV	A,D
  0F42'   83                    	ADD	E
  0F43'   57                    	MOV	D,A		; D = h1 + h2
  0F44'   79                    	MOV	A,C
  0F45'   BA                    	CMP	D
  0F46'   DA 0F6D'              	JC	OV_0
  0F49'   CD 0F71'              	CALL	OV_NX
  0F4C'   DA 0F6D'              	JC	OV_0
  0F4F'   7B                    	MOV	A,E
  0F50'   86                    	ADD	M
  0F51'   5F                    	MOV	E,A		; E = h2 + h3
  0F52'   79                    	MOV	A,C
  0F53'   BB                    	CMP	E
  0F54'   DA 0F6D'              	JC	OV_0
  0F57'   7A                    	MOV	A,D
  0F58'   86                    	ADD	M
  0F59'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0F5A'   CD 0F71'              	CALL	OV_NX
  0F5D'   DA 0F6A'              	JC	OV_1
  0F60'   7B                    	MOV	A,E
  0F61'   86                    	ADD	M		; h2 + h3 + h4
  0F62'   5F                    	MOV	E,A
  0F63'   79                    	MOV	A,C
  0F64'   BB                    	CMP	E
  0F65'   DA 0F6A'              	JC	OV_1
  0F68'   BA                    	CMP	D
  0F69'   D0                    	RNC			; two lines of overlap
  0F6A'                         OV_1:
  0F6A'   79                    	MOV	A,C
  0F6B'   3C                    	INR	A
  0F6C'   C9                    	RET
  0F6D'                         OV_0:
  0F6D'   79                    	MOV	A,C
  0F6E'   C6 02                 	ADI	2
  0F70'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0F71'                         OV_NX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F71'   05                    	DCR	B
  0F72'   37                    	STC
  0F73'   C8                    	RZ
  0F74'   3A 2DF6'              	LDA	OVDIR
  0F77'   B7                    	ORA	A		; (CY off)
  0F78'   CA 0F7D'              	JZ	OV_UP
  0F7B'   23                    	INX	H
  0F7C'   23                    	INX	H
  0F7D'                         OV_UP:
  0F7D'   2B                    	DCX	H
  0F7E'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0F7F'                         PGROWS:
  0F7F'   2A 2DF3'              	LHLD	RWR
  0F82'   CD 0F8D'              	CALL	MULSAT
  0F85'   22 2DF3'              	SHLD	RWR
  0F88'   AF                    	XRA	A
  0F89'   32 2DF5'              	STA	RWMV
  0F8C'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0F8D'                         MULSAT:
  0F8D'   EB                    	XCHG
  0F8E'   21 0000               	LXI	H,0
  0F91'   B7                    	ORA	A
  0F92'   C8                    	RZ
  0F93'                         MS_LP:
  0F93'   19                    	DAD	D
  0F94'   DA 0F9C'              	JC	MS_SAT
  0F97'   3D                    	DCR	A
  0F98'   C2 0F93'              	JNZ	MS_LP
  0F9B'   C9                    	RET
  0F9C'                         MS_SAT:
  0F9C'   21 FFFF               	LXI	H,0FFFFH
  0F9F'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0FA0'                         VC_HFDN:
  0FA0'   CD 0807'              	CALL	SETMOV
  0FA3'   CD 11E5'              	CALL	HFCNT		; HFN = the rows
  0FA6'   3A 0000*              	LDA	TALLF
  0FA9'   B7                    	ORA	A
  0FAA'   C2 1040'              	JNZ	VHD_TL
  0FAD'   CD 0DC9'              	CALL	CURRW
  0FB0'   47                    	MOV	B,A
  0FB1'   3A 0000*              	LDA	SCEOF
  0FB4'   B7                    	ORA	A
  0FB5'   CA 0FBD'              	JZ	VHD_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FB8'   3A 0000*              	LDA	SCBOT		; the last line's place
  0FBB'   B8                    	CMP	B
  0FBC'   C8                    	RZ			; the cursor is on it
  0FBD'                         VHD_GO:
  0FBD'   3A 0000*              	LDA	NEDIT
  0FC0'   21 2DEB'              	LXI	H,HFN
  0FC3'   86                    	ADD	M
  0FC4'   3C                    	INR	A
  0FC5'   4F                    	MOV	C,A
  0FC6'   AF                    	XRA	A
  0FC7'   CD 10C2'              	CALL	HTSET		; HL -> the top line's rows
  0FCA'   3A 2DEB'              	LDA	HFN
  0FCD'   57                    	MOV	D,A		; D = the rows the text moves
  0FCE'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0FCF'   3A 2DF1'              	LDA	HTEOF
  0FD2'   B7                    	ORA	A
  0FD3'   CA 0FF2'              	JZ	VHD_1
  0FD6'   E5                    	PUSH	H
  0FD7'   C5                    	PUSH	B
  0FD8'   0E FF                 	MVI	C,255
  0FDA'   CD 1101'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0FDD'   3A 0000*              	LDA	NEDIT
  0FE0'   81                    	ADD	C
  0FE1'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0FE2'   C1                    	POP	B
  0FE3'   E1                    	POP	H
  0FE4'   B7                    	ORA	A
  0FE5'   FA 0FF0'              	JM	VHD_0		; none
  0FE8'   BA                    	CMP	D
  0FE9'   D2 0FF2'              	JNC	VHD_1
  0FEC'   57                    	MOV	D,A
  0FED'   C3 0FF2'              	JMP	VHD_1
  0FF0'                         VHD_0:
  0FF0'   16 00                 	MVI	D,0
  0FF2'                         VHD_1:
  0FF2'   7A                    	MOV	A,D
  0FF3'   B7                    	ORA	A
  0FF4'   CA 100F'              	JZ	VHD_C		; the text stays
  0FF7'   4A                    	MOV	C,D
  0FF8'   CD 1101'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0FFB'   79                    	MOV	A,C
  0FFC'   B7                    	ORA	A
  0FFD'   CA 100F'              	JZ	VHD_C
  1000'   BA                    	CMP	D
  1001'   C2 100C'              	JNZ	VHD_R
  1004'   7E                    	MOV	A,M		; the top line still: past all of it
  1005'   91                    	SUB	C
  1006'   83                    	ADD	E
  1007'   5F                    	MOV	E,A
  1008'   23                    	INX	H
  1009'   C3 100F'              	JMP	VHD_C
  100C'                         VHD_R:
  100C'   7B                    	MOV	A,E		; part of the way down a line: its start
  100D'   91                    	SUB	C
  100E'   5F                    	MOV	E,A
  100F'                         VHD_C:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  100F'   22 2DEC'              	SHLD	HFTP
  1012'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  1015'   83                    	ADD	E
  1016'   4F                    	MOV	C,A
  1017'   3A 2DEF'              	LDA	HTCUR
  101A'   CD 10E3'              	CALL	HTPT
  101D'   CD 1101'              	CALL	HTFQ
  1020'   D2 1024'              	JNC	HFEND
  1023'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  1024'                         HFEND:
  1024'   EB                    	XCHG
  1025'   2A 2DEC'              	LHLD	HFTP
  1028'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1029'                         HTLAND:
  1029'   E5                    	PUSH	H
  102A'   D5                    	PUSH	D
  102B'   CD 10F6'              	CALL	HTGO
  102E'   D1                    	POP	D
  102F'   E1                    	POP	H
  1030'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  1033'   7C                    	MOV	A,H
  1034'   B7                    	ORA	A
  1035'   7D                    	MOV	A,L
  1036'   CA 103A'              	JZ	HL_SET
  1039'   AF                    	XRA	A
  103A'                         HL_SET:
  103A'   CD 0DE8'              	CALL	SETRWT
  103D'   C3 08FC'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1040'                         VHD_TL:
  1040'   3A 0000*              	LDA	SKIPR
  1043'   47                    	MOV	B,A
  1044'   3A 0000*              	LDA	CSUB
  1047'   90                    	SUB	B		; A = that row
  1048'   F5                    	PUSH	PSW
  1049'   21 0001               	LXI	H,1
  104C'   CD 09B7'              	CALL	JCORE		; (on the last line: nowhere to go)
  104F'   F1                    	POP	PSW
  1050'   4F                    	MOV	C,A
  1051'   C5                    	PUSH	B
  1052'   0C                    	INR	C
  1053'   06 00                 	MVI	B,0
  1055'   CD 10D7'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  1058'   22 2DEC'              	SHLD	HFTP
  105B'   D1                    	POP	D
  105C'   4B                    	MOV	C,E
  105D'   CD 1101'              	CALL	HTFQ
  1060'   D2 1024'              	JNC	HFEND
  1063'   2B                    	DCX	H
  1064'   C3 1024'              	JMP	HFEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  1067'                         VC_HFUP:
  1067'   CD 0807'              	CALL	SETMOV
  106A'   CD 11E5'              	CALL	HFCNT		; HFN = the rows
  106D'   CD 11C5'              	CALL	ONFST
  1070'   C8                    	RZ			; the cursor is on the first line
  1071'   0E 01                 	MVI	C,1
  1073'   3A 2DEB'              	LDA	HFN
  1076'   CD 10C2'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  1079'   43                    	MOV	B,E
  107A'   3A 2DEB'              	LDA	HFN
  107D'   4F                    	MOV	C,A
  107E'   5F                    	MOV	E,A		; E = the rows the cursor moves
  107F'   CD 1112'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1082'   DA 109D'              	JC	VHU_C		;   above it; or the file's first line
  1085'   79                    	MOV	A,C
  1086'   B7                    	ORA	A
  1087'   CA 109D'              	JZ	VHU_C
  108A'   3A 2DF0'              	LDA	HTTP
  108D'   3D                    	DCR	A
  108E'   B8                    	CMP	B
  108F'   CA 109A'              	JZ	VHU_F
  1092'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1093'   96                    	SUB	M
  1094'   81                    	ADD	C
  1095'   5F                    	MOV	E,A
  1096'   23                    	INX	H
  1097'   C3 109D'              	JMP	VHU_C
  109A'                         VHU_F:
  109A'   7B                    	MOV	A,E		; ... the first line back: all of it
  109B'   81                    	ADD	C
  109C'   5F                    	MOV	E,A
  109D'                         VHU_C:
  109D'   22 2DEC'              	SHLD	HFTP
  10A0'   4B                    	MOV	C,E
  10A1'   3A 2DEF'              	LDA	HTCUR
  10A4'   CD 10E3'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  10A7'   3A 0000*              	LDA	CSUB
  10AA'   57                    	MOV	D,A
  10AB'   79                    	MOV	A,C
  10AC'   92                    	SUB	D		; the rows to go, less those of its own line above it
  10AD'   DA 1024'              	JC	HFEND
  10B0'   CA 1024'              	JZ	HFEND
  10B3'   4F                    	MOV	C,A
  10B4'   43                    	MOV	B,E
  10B5'   CD 1112'              	CALL	HTBQ		; (off the top: the file's first line)
  10B8'   C3 1024'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  10BB'                         HTSCR:
  10BB'   CD 0DC9'              	CALL	CURRW
  10BE'   47                    	MOV	B,A
  10BF'   C3 10CD'              	JMP	HS_TP
  10C2'                         HTSET:
  10C2'   47                    	MOV	B,A
  10C3'   CD 0DC9'              	CALL	CURRW		; (keeps BC)
  10C6'   F5                    	PUSH	PSW
  10C7'   80                    	ADD	B
  10C8'   47                    	MOV	B,A
  10C9'   CD 10D7'              	CALL	HTRB
  10CC'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  10CD'                         HS_TP:
  10CD'   3A 2DEF'              	LDA	HTCUR
  10D0'   90                    	SUB	B
  10D1'   32 2DF0'              	STA	HTTP
  10D4'   C3 10E3'              	JMP	HTPT
  10D7'                         HTRB:
  10D7'   CD 12B5'              	CALL	ZSAVE
  10DA'   CD 0000*              	CALL	HTBLD
  10DD'   CD 12C8'              	CALL	ZREST
  10E0'   3A 2DEF'              	LDA	HTCUR
  10E3'                         HTPT:
  10E3'   5F                    	MOV	E,A
  10E4'   16 00                 	MVI	D,0
  10E6'   21 0000*              	LXI	H,HTAB
  10E9'   19                    	DAD	D
  10EA'   3A 2DEE'              	LDA	HTN
  10ED'   93                    	SUB	E
  10EE'   47                    	MOV	B,A
  10EF'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  10F0'                         HTIX:
  10F0'   11 0000*              	LXI	D,HTAB
  10F3'   7D                    	MOV	A,L
  10F4'   93                    	SUB	E
  10F5'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  10F6'                         HTGO:
  10F6'   CD 10F0'              	CALL	HTIX
  10F9'   47                    	MOV	B,A
  10FA'   3A 2DEF'              	LDA	HTCUR
  10FD'   90                    	SUB	B		; A = the lines up to it
  10FE'   C3 0E00'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1101'                         HTFQ:
  1101'   78                    	MOV	A,B
  1102'   B7                    	ORA	A
  1103'   37                    	STC
  1104'   C8                    	RZ
  1105'   79                    	MOV	A,C
  1106'   96                    	SUB	M
  1107'   DA 1110'              	JC	HF_IN
  110A'   4F                    	MOV	C,A
  110B'   23                    	INX	H
  110C'   05                    	DCR	B
  110D'   C3 1101'              	JMP	HTFQ
  1110'                         HF_IN:
  1110'   B7                    	ORA	A
  1111'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1112'                         HTBQ:
  1112'   78                    	MOV	A,B
  1113'   B7                    	ORA	A
  1114'   37                    	STC
  1115'   C8                    	RZ
  1116'   2B                    	DCX	H
  1117'   05                    	DCR	B
  1118'   7E                    	MOV	A,M
  1119'   91                    	SUB	C
  111A'   D2 1123'              	JNC	HQ_IN
  111D'   2F                    	CMA
  111E'   3C                    	INR	A
  111F'   4F                    	MOV	C,A
  1120'   C3 1112'              	JMP	HTBQ
  1123'                         HQ_IN:
  1123'   4F                    	MOV	C,A
  1124'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1125'                         RWQ:
  1125'   0E 64                 	MVI	C,100
  1127'   3A 2DF4'              	LDA	RWR+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  112A'   B7                    	ORA	A
  112B'   C0                    	RNZ
  112C'   3A 2DF3'              	LDA	RWR
  112F'   B9                    	CMP	C
  1130'   D0                    	RNC
  1131'   4F                    	MOV	C,A
  1132'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1133'                         RWSUB:
  1133'   E5                    	PUSH	H
  1134'   5F                    	MOV	E,A
  1135'   16 00                 	MVI	D,0
  1137'   2A 2DF3'              	LHLD	RWR
  113A'   CD 0000*              	CALL	SUBHD
  113D'   22 2DF3'              	SHLD	RWR
  1140'   E1                    	POP	H
  1141'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1142'                         RWFWD:
  1142'   CD 1125'              	CALL	RWQ
  1145'   51                    	MOV	D,C
  1146'   CD 1101'              	CALL	HTFQ
  1149'   F5                    	PUSH	PSW
  114A'   7A                    	MOV	A,D
  114B'   91                    	SUB	C		; the rows that took it to that line's first
  114C'   CD 1133'              	CALL	RWSUB
  114F'   F1                    	POP	PSW
  1150'   DA 1164'              	JC	RF_OFF
  1153'   3A 2DF4'              	LDA	RWR+1		; is what is left inside this line?
  1156'   B7                    	ORA	A
  1157'   C2 116E'              	JNZ	RF_GO
  115A'   3A 2DF3'              	LDA	RWR
  115D'   BE                    	CMP	M
  115E'   D2 116E'              	JNC	RF_GO
  1161'   4F                    	MOV	C,A
  1162'   B7                    	ORA	A
  1163'   C9                    	RET
  1164'                         RF_OFF:
  1164'   3A 2DF1'              	LDA	HTEOF
  1167'   B7                    	ORA	A
  1168'   CA 116E'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  116B'   2B                    	DCX	H
  116C'   37                    	STC
  116D'   C9                    	RET
  116E'                         RF_GO:
  116E'   CD 10F6'              	CALL	HTGO
  1171'   3E 01                 	MVI	A,1
  1173'   32 2DF5'              	STA	RWMV
  1176'   CD 1125'              	CALL	RWQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1179'   0C                    	INR	C
  117A'   06 00                 	MVI	B,0
  117C'   CD 10D7'              	CALL	HTRB
  117F'   C3 1142'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1182'                         RWBAK:
  1182'   CD 1125'              	CALL	RWQ
  1185'   51                    	MOV	D,C
  1186'   CD 1112'              	CALL	HTBQ
  1189'   DA 11A6'              	JC	RB_OFF
  118C'   7A                    	MOV	A,D
  118D'   81                    	ADD	C
  118E'   5F                    	MOV	E,A		; E = the rows up to that line's first
  118F'   3A 2DF4'              	LDA	RWR+1
  1192'   B7                    	ORA	A
  1193'   C2 11A2'              	JNZ	RB_ON
  1196'   3A 2DF3'              	LDA	RWR
  1199'   57                    	MOV	D,A
  119A'   7B                    	MOV	A,E
  119B'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  119C'   DA 11A2'              	JC	RB_ON
  119F'   4F                    	MOV	C,A
  11A0'   B7                    	ORA	A
  11A1'   C9                    	RET
  11A2'                         RB_ON:
  11A2'   7B                    	MOV	A,E
  11A3'   C3 11AD'              	JMP	RB_GO
  11A6'                         RB_OFF:
  11A6'   3A 2DF2'              	LDA	HTBOF
  11A9'   0F                    	RRC			; CY: that is the file's first line
  11AA'   D8                    	RC
  11AB'   7A                    	MOV	A,D
  11AC'   91                    	SUB	C
  11AD'                         RB_GO:
  11AD'   CD 1133'              	CALL	RWSUB
  11B0'   CD 10F6'              	CALL	HTGO
  11B3'   3E 01                 	MVI	A,1
  11B5'   32 2DF5'              	STA	RWMV
  11B8'   CD 1125'              	CALL	RWQ
  11BB'   41                    	MOV	B,C
  11BC'   0E 01                 	MVI	C,1
  11BE'   CD 10D7'              	CALL	HTRB
  11C1'   43                    	MOV	B,E
  11C2'   C3 1182'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  11C5'                         ONFST:
  11C5'   E5                    	PUSH	H
  11C6'   2A 0000*              	LHLD	OUTPOS
  11C9'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11CA'   B5                    	ORA	L
  11CB'   C2 11E3'              	JNZ	OF_RET
  11CE'   2A 0000*              	LHLD	TXTBEG
  11D1'   EB                    	XCHG			; DE = TXTBEG
  11D2'   2A 0000*              	LHLD	GAPBEG
  11D5'                         OF_LP:
  11D5'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  11D8'   CA 11E3'              	JZ	OF_RET
  11DB'   2B                    	DCX	H
  11DC'   7E                    	MOV	A,M
  11DD'   FE 0A                 	CPI	LF
  11DF'   C2 11D5'              	JNZ	OF_LP
  11E2'   B7                    	ORA	A		; NZ
  11E3'                         OF_RET:
  11E3'   E1                    	POP	H
  11E4'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  11E5'                         HFCNT:
  11E5'   2A 2DDC'              	LHLD	CMDCNT
  11E8'   7C                    	MOV	A,H
  11E9'   B5                    	ORA	L
  11EA'   CA 1201'              	JZ	HFC_AM
  11ED'   CD 0732'              	CALL	GETCNT		; HL = count; clears it
  11F0'   3A 0000*              	LDA	NEDIT
  11F3'   5F                    	MOV	E,A
  11F4'   16 00                 	MVI	D,0
  11F6'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  11F9'   D2 11FD'              	JNC	HFC_ST
  11FC'   EB                    	XCHG			; HL = NEDIT
  11FD'                         HFC_ST:
  11FD'   7D                    	MOV	A,L
  11FE'   32 2DEA'              	STA	HFAMT
  1201'                         HFC_AM:
  1201'   3A 2DEA'              	LDA	HFAMT
  1204'   B7                    	ORA	A
  1205'   C2 1212'              	JNZ	HFC_HL
  1208'   3A 0000*              	LDA	NEDIT
  120B'   B7                    	ORA	A
  120C'   1F                    	RAR
  120D'   B7                    	ORA	A
  120E'   C2 1212'              	JNZ	HFC_HL
  1211'   3C                    	INR	A		; at least one row
  1212'                         HFC_HL:
  1212'   32 2DEB'              	STA	HFN
  1215'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1216'                         VC_REDR:
  1216'   C3 0732'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1219'                         VC_G:
  1219'   CD 0807'              	CALL	SETMOV
  121C'   CD 12DB'              	CALL	GZONE		; the screen's top line, before the move
  121F'   CD 075B'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1222'   2A 2DDC'              	LHLD	CMDCNT
  1225'   7C                    	MOV	A,H
  1226'   B5                    	ORA	L
  1227'   C2 123A'              	JNZ	VG_N
  122A'   AF                    	XRA	A		; forward
  122B'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  122E'   CD 0798'              	CALL	BRKOFF
  1231'   DA 07B0'              	JC	BRKBAK
  1234'   CD 0AEB'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1237'   C3 12F3'              	JMP	GPLACE
  123A'                         VG_N:
  123A'   CD 0732'              	CALL	GETCNT		; HL = target line (1-based)
  123D'                         VG_LN:
  123D'   CD 1249'              	CALL	GOLN
  1240'   CD 0798'              	CALL	BRKOFF
  1243'   DA 07B0'              	JC	BRKBAK
  1246'   C3 12F3'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  1249'                         GOLN:
  1249'   E5                    	PUSH	H
  124A'   CD 0000*              	CALL	CNTLF
  124D'   23                    	INX	H		; HL = the cursor's line
  124E'   D1                    	POP	D		; DE = the line wanted
  124F'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1252'   DA 125D'              	JC	GLN_BK
  1255'   EB                    	XCHG
  1256'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  1259'   AF                    	XRA	A
  125A'   C3 1262'              	JMP	GLN_MV
  125D'                         GLN_BK:
  125D'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1260'   3E FF                 	MVI	A,0FFH
  1262'                         GLN_MV:
  1262'   CD 0000*              	CALL	MVLIND
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1265'   CD 0AE5'              	CALL	ATEOF
  1268'   DC 0AEB'              	CC	LASTLN		; past the last line: onto it
  126B'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  126C'                         VC_LG:
  126C'   CD 0807'              	CALL	SETMOV
  126F'   3A 2E11'              	LDA	GSAVE
  1272'   B7                    	ORA	A
  1273'   C2 127C'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  1276'   3E 01                 	MVI	A,PG
  1278'   32 2E10'              	STA	GPEND
  127B'   C9                    	RET
  127C'                         VLG_GG:
  127C'   CD 12DB'              	CALL	GZONE
  127F'   CD 075B'              	CALL	BRKON
  1282'   CD 0732'              	CALL	GETCNT		; HL = target line (no count: 1)
  1285'   C3 123D'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1288'                         SUB24:
  1288'   4F                    	MOV	C,A
  1289'   7D                    	MOV	A,L
  128A'   93                    	SUB	E
  128B'   6F                    	MOV	L,A
  128C'   7C                    	MOV	A,H
  128D'   9A                    	SBB	D
  128E'   67                    	MOV	H,A
  128F'   79                    	MOV	A,C
  1290'   98                    	SBB	B
  1291'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1292'                         CURFP:
  1292'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1295'                         FPOS:
  1295'   C5                    	PUSH	B
  1296'   D5                    	PUSH	D
  1297'   EB                    	XCHG
  1298'   2A 0000*              	LHLD	TXTBEG
  129B'   EB                    	XCHG
  129C'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  129F'   EB                    	XCHG			; DE = that
  12A0'   2A 0000*              	LHLD	OUTPOS
  12A3'   7C                    	MOV	A,H
  12A4'   B7                    	ORA	A		; CY = 0
  12A5'   1F                    	RAR
  12A6'   47                    	MOV	B,A
  12A7'   7D                    	MOV	A,L
  12A8'   1F                    	RAR
  12A9'   67                    	MOV	H,A
  12AA'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12AC'   1F                    	RAR
  12AD'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  12AE'   19                    	DAD	D
  12AF'   78                    	MOV	A,B
  12B0'   CE 00                 	ACI	0		; A:HL = the position
  12B2'   D1                    	POP	D
  12B3'   C1                    	POP	B
  12B4'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  12B5'                         ZSAVE:
  12B5'   2A 2DDC'              	LHLD	CMDCNT
  12B8'   22 2E4B'              	SHLD	ZSVCNT
  12BB'   2A 0000*              	LHLD	AUXCNT
  12BE'   22 2E4D'              	SHLD	ZSVAUX
  12C1'   3A 0000*              	LDA	DIRFLG
  12C4'   32 2E4F'              	STA	ZSVDIR
  12C7'   C9                    	RET
  12C8'                         ZREST:
  12C8'   2A 2E4B'              	LHLD	ZSVCNT
  12CB'   22 2DDC'              	SHLD	CMDCNT
  12CE'   2A 2E4D'              	LHLD	ZSVAUX
  12D1'   22 0000*              	SHLD	AUXCNT
  12D4'   3A 2E4F'              	LDA	ZSVDIR
  12D7'   32 0000*              	STA	DIRFLG
  12DA'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  12DB'                         GZONE:
  12DB'   CD 12B5'              	CALL	ZSAVE
  12DE'   CD 0DC9'              	CALL	CURRW
  12E1'   6F                    	MOV	L,A
  12E2'   26 00                 	MVI	H,0
  12E4'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  12E7'   CD 1295'              	CALL	FPOS
  12EA'   22 0000*              	SHLD	ZTOP
  12ED'   32 0002*              	STA	ZTOP+2
  12F0'   C3 12C8'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  12F3'                         GPLACE:
  12F3'   CD 12B5'              	CALL	ZSAVE
  12F6'   CD 1292'              	CALL	CURFP
  12F9'   EB                    	XCHG
  12FA'   2A 0000*              	LHLD	ZTOP
  12FD'   EB                    	XCHG
  12FE'   4F                    	MOV	C,A		; C:HL = the target's position
  12FF'   3A 0002*              	LDA	ZTOP+2
  1302'   47                    	MOV	B,A		; B:DE = the top's
  1303'   79                    	MOV	A,C
  1304'   CD 1288'              	CALL	SUB24
  1307'   22 2E48'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  130A'   DA 1344'              	JC	GP_UP
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  130D'   B7                    	ORA	A
  130E'   C2 138A'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1311'   3A 0000*              	LDA	NEDIT
  1314'   87                    	ADD	A
  1315'   3C                    	INR	A
  1316'   6F                    	MOV	L,A
  1317'   26 00                 	MVI	H,0
  1319'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  131C'   CD 072B'              	CALL	GBSUB		; HL = bytes from there to the target
  131F'   EB                    	XCHG
  1320'   2A 2E48'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1323'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1326'   DA 138A'              	JC	GP_MID
  1329'   CD 072B'              	CALL	GBSUB		; HL = the top line's start (resident)
  132C'   01 0000               	LXI	B,0		; BC = lines from the top
  132F'                         GP_CNT:
  132F'   7A                    	MOV	A,D
  1330'   B3                    	ORA	E
  1331'   CA 1340'              	JZ	GP_DN
  1334'   7E                    	MOV	A,M
  1335'   23                    	INX	H
  1336'   1B                    	DCX	D
  1337'   FE 0A                 	CPI	LF
  1339'   C2 132F'              	JNZ	GP_CNT
  133C'   03                    	INX	B
  133D'   C3 132F'              	JMP	GP_CNT
  1340'                         GP_DN:
  1340'   79                    	MOV	A,C		; the lines from the top one to it
  1341'   C3 13B4'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1344'                         GP_UP:
  1344'   3C                    	INR	A
  1345'   C2 138A'              	JNZ	GP_MID		; 64K bytes or more above
  1348'   2A 2E48'              	LHLD	ZDIF
  134B'   EB                    	XCHG
  134C'   21 0000               	LXI	H,0
  134F'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1352'   7C                    	MOV	A,H
  1353'   B5                    	ORA	L
  1354'   CA 138A'              	JZ	GP_MID		; exactly 64K
  1357'   EB                    	XCHG			; DE = bytes to read
  1358'   AF                    	XRA	A
  1359'   32 2E4A'              	STA	ZLF
  135C'   CD 0000*              	CALL	RGET0
  135F'                         GP_RD:
  135F'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1362'   DA 138A'              	JC	GP_MID
  1365'   FE 0A                 	CPI	LF
  1367'   C2 137B'              	JNZ	GP_RN
  136A'   3A 0000*              	LDA	NEDIT
  136D'   B7                    	ORA	A
  136E'   1F                    	RAR
  136F'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1371'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1372'   21 2E4A'              	LXI	H,ZLF
  1375'   34                    	INR	M
  1376'   BE                    	CMP	M		; CY iff more lines than that
  1377'   E1                    	POP	H
  1378'   DA 138A'              	JC	GP_MID
  137B'                         GP_RN:
  137B'   1B                    	DCX	D
  137C'   7A                    	MOV	A,D
  137D'   B3                    	ORA	E
  137E'   C2 135F'              	JNZ	GP_RD
  1381'   3E 01                 	MVI	A,PL_SET	; the top row
  1383'   32 0000*              	STA	PLACE
  1386'   AF                    	XRA	A
  1387'   C3 1394'              	JMP	GP_SET
  138A'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  138A'   3E 02                 	MVI	A,PL_MID
  138C'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  138F'   3A 0000*              	LDA	NEDIT
  1392'   B7                    	ORA	A
  1393'   1F                    	RAR			; (no more lines above it than this)
  1394'                         GP_SET:
  1394'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1395'   26 00                 	MVI	H,0
  1397'   22 0000*              	SHLD	WINROW
  139A'   21 0000               	LXI	H,0
  139D'   22 0000*              	SHLD	LNDLT
  13A0'   CD 0844'              	CALL	SETFUL		; the window may have paged: full repaint
  13A3'                         GP_FIN:
  13A3'   CD 12C8'              	CALL	ZREST
  13A6'   3A 2E73'              	LDA	GPKEEP
  13A9'   B7                    	ORA	A
  13AA'   CA 08FC'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  13AD'   AF                    	XRA	A
  13AE'   32 2E73'              	STA	GPKEEP
  13B1'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  13B4'                         GP_ONS:
  13B4'   6F                    	MOV	L,A
  13B5'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  13B7'   EB                    	XCHG
  13B8'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  13BB'   EB                    	XCHG
  13BC'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  13BF'   22 0000*              	SHLD	LNDLT
  13C2'   3E 01                 	MVI	A,R_MOVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13C4'   32 2DE0'              	STA	RINTENT
  13C7'   C3 13A3'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  13CA'                         OPPEND:
  13CA'   AF                    	XRA	A
  13CB'   32 2E16'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  13CE'   3A 2E13'              	LDA	PSAVE
  13D1'   FE 63                 	CPI	'c'
  13D3'   C2 13F0'              	JNZ	OPP_ND
  13D6'   79                    	MOV	A,C
  13D7'   FE 77                 	CPI	'w'
  13D9'   CA 13E1'              	JZ	OPP_W
  13DC'   FE 57                 	CPI	'W'
  13DE'   C2 13F0'              	JNZ	OPP_ND
  13E1'                         OPP_W:
  13E1'   CD 15C3'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  13E4'   DA 13F0'              	JC	OPP_ND
  13E7'   79                    	MOV	A,C
  13E8'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  13EA'   4F                    	MOV	C,A
  13EB'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  13ED'   32 2E16'              	STA	CWEOL		;   char for the next word's: see ESTEP
  13F0'                         OPP_ND:
  13F0'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  13F1'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  13F3'   C2 1407'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  13F6'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  13F9'   DA 1497'              	JC	OPABRT
  13FC'   79                    	MOV	A,C
  13FD'   FE 67                 	CPI	'g'
  13FF'   C2 1497'              	JNZ	OPABRT
  1402'   3E 01                 	MVI	A,PG
  1404'   32 2E11'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1407'                         OPP_NG:
  1407'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1408'   21 2E13'              	LXI	H,PSAVE
  140B'   BE                    	CMP	M
  140C'   CA 15E4'              	JZ	OPLINE
  140F'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1410'   CD 15FA'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1413'   DA 1497'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1416'   32 2E15'              	STA	OPCLSV
  1419'   47                    	MOV	B,A		; B = the class
  141A'   3A 2E13'              	LDA	PSAVE
  141D'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  141F'   C2 142B'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1422'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1423'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1425'   C2 144D'              	JNZ	OPP_GO
  1428'   C3 1436'              	JMP	OPP_NO
  142B'                         OPP_NC:
  142B'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  142D'   C2 144D'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1430'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1431'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1433'   CA 144D'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1436'                         OPP_NO:
  1436'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1437'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1439'   CA 1447'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  143C'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  143E'   CA 1447'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1441'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1444'   C2 1497'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1447'                         OPP_SW:
  1447'   CD 01F9'              	CALL	MKGETK
  144A'   C3 1497'              	JMP	OPABRT
  144D'                         OPP_GO:
  144D'   AF                    	XRA	A
  144E'   32 2DE9'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1451'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1454'   22 2E17'              	SHLD	OPSTA
  1457'   C5                    	PUSH	B
  1458'   21 2E1B'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  145B'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  145E'   3A 2E15'              	LDA	OPCLSV
  1461'   FE 02                 	CPI	2
  1463'   CC 149A'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1466'   C1                    	POP	B
  1467'   21 2D23'              	LXI	H,CMDTAB
  146A'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  146D'   3A 2E13'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1470'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1471'   CA 0807'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1474'   CD 14C6'              	CALL	OPSFIX		; where the start is in the window NOW
  1477'   D2 14E2'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  147A'   22 2E17'              	SHLD	OPSTA
  147D'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1480'   22 2E19'              	SHLD	OPEND2
  1483'   3A 2E13'              	LDA	PSAVE
  1486'   FE 79                 	CPI	'y'
  1488'   CA 1B6B'              	JZ	OPYANK		; a yank takes the span without losing it
  148B'   CD 1635'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  148E'   3A 2E13'              	LDA	PSAVE
  1491'   FE 63                 	CPI	'c'
  1493'   C0                    	RNZ
  1494'   C3 191F'              	JMP	SETINS
  1497'                         OPABRT:				; not a motion -> the operator is dropped and
  1497'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  149A'                         OPENDS:
  149A'   2A 2E17'              	LHLD	OPSTA
  149D'   CD 0624'              	CALL	BOL
  14A0'   11 2E1E'              	LXI	D,OPSLO
  14A3'   CD 14B8'              	CALL	OPE_ST
  14A6'   2A 2E17'              	LHLD	OPSTA
  14A9'   CD 06BB'              	CALL	NLSTART
  14AC'   11 2E21'              	LXI	D,OPSHI
  14AF'   CD 14B8'              	CALL	OPE_ST
  14B2'   2A 2E17'              	LHLD	OPSTA
  14B5'   C3 0000*              	JMP	GOTO
  14B8'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  14B8'   D5                    	PUSH	D
  14B9'   CD 0000*              	CALL	GOTO
  14BC'   E1                    	POP	H
  14BD'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  14C0'                         CURBD:
  14C0'   CD 1292'              	CALL	CURFP
  14C3'   EB                    	XCHG
  14C4'   47                    	MOV	B,A
  14C5'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  14C6'                         OPSFIX:
  14C6'   21 2E1B'              	LXI	H,OPSFP
  14C9'   CD 03DC'              	CALL	MKLOAD
  14CC'   CD 14C0'              	CALL	CURBD
  14CF'   2A 2E7D'              	LHLD	MKPOS
  14D2'   3A 2E7F'              	LDA	MKPOS+2
  14D5'   CD 1288'              	CALL	SUB24
  14D8'   B4                    	ORA	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14D9'   B5                    	ORA	L
  14DA'   C2 03E9'              	JNZ	MKWIN
  14DD'   CD 0000*              	CALL	CUROFF
  14E0'   37                    	STC
  14E1'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  14E2'                         OPPGD:
  14E2'   47                    	MOV	B,A
  14E3'   3A 2E15'              	LDA	OPCLSV
  14E6'   FE 02                 	CPI	2
  14E8'   C2 15A4'              	JNZ	OPG_NO
  14EB'   3A 2E13'              	LDA	PSAVE
  14EE'   FE 64                 	CPI	'd'
  14F0'   C2 15A4'              	JNZ	OPG_NO
  14F3'   04                    	INR	B
  14F4'   CA 1503'              	JZ	OPG_FW
  14F7'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  14FA'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  14FD'   CD 0000*              	CALL	GOTO
  1500'   C3 151B'              	JMP	OPG_GO
  1503'                         OPG_FW:
  1503'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1506'   CD 06BB'              	CALL	NLSTART		;   landed on, and the low one is where the
  1509'   11 2E21'              	LXI	D,OPSHI		;   start line began
  150C'   CD 14B8'              	CALL	OPE_ST
  150F'   21 2E1E'              	LXI	H,OPSLO
  1512'   CD 03DC'              	CALL	MKLOAD
  1515'   CD 03A9'              	CALL	MKPAGE
  1518'   CD 0000*              	CALL	GOTO
  151B'                         OPG_GO:
  151B'   CD 14C0'              	CALL	CURBD
  151E'   2A 2E21'              	LHLD	OPSHI
  1521'   3A 2E23'              	LDA	OPSHI+2
  1524'   CD 1288'              	CALL	SUB24		; A:HL = the bytes to take
  1527'                         OPG_SV:
  1527'   22 2E24'              	SHLD	OPTOGO
  152A'   32 2E26'              	STA	OPTOGO+2
  152D'                         OPG_NX:
  152D'   CD 070E'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1530'   CD 0000*              	CALL	SUBHD
  1533'   EB                    	XCHG			; DE = what the window holds past the cursor
  1534'   2A 2E24'              	LHLD	OPTOGO
  1537'   3A 2E26'              	LDA	OPTOGO+2
  153A'   B7                    	ORA	A
  153B'   C2 156E'              	JNZ	OPG_PG		; 64K or more to go
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  153E'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1541'   DA 156E'              	JC	OPG_PG
  1544'   CA 156E'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1547'                         OPG_FN:				; the rest of it is here
  1547'   E5                    	PUSH	H
  1548'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  154B'   CD 0000*              	CALL	CUROFF
  154E'   22 2E27'              	SHLD	OPLO
  1551'   D1                    	POP	D
  1552'   19                    	DAD	D
  1553'   22 2E29'              	SHLD	OPHI
  1556'   CD 1768'              	CALL	OPDSPN
  1559'   CD 0AE5'              	CALL	ATEOF
  155C'   D2 15BD'              	JNC	OPMID
  155F'   CD 11C5'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1562'   CA 15BD'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1565'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1568'   CD 0000*              	CALL	SETBWD
  156B'   C3 15BD'              	JMP	OPMID
  156E'                         OPG_PG:
  156E'   7A                    	MOV	A,D
  156F'   B3                    	ORA	E
  1570'   C2 1589'              	JNZ	OPG_DL
  1573'   CD 0AE5'              	CALL	ATEOF		; nothing held past the cursor
  1576'   21 0000               	LXI	H,0
  1579'   DA 1547'              	JC	OPG_FN		; ... and no more to come: the file ran out
  157C'   2B                    	DCX	H
  157D'   CD 0000*              	CALL	SETC0
  1580'   CD 0000*              	CALL	GOLINE
  1583'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1586'   C3 152D'              	JMP	OPG_NX
  1589'                         OPG_DL:
  1589'   D5                    	PUSH	D
  158A'   21 FFFF               	LXI	H,0FFFFH
  158D'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1590'   E1                    	POP	H
  1591'   E5                    	PUSH	H
  1592'   CD 0000*              	CALL	DELFWD
  1595'   D1                    	POP	D
  1596'   06 00                 	MVI	B,0
  1598'   2A 2E24'              	LHLD	OPTOGO
  159B'   3A 2E26'              	LDA	OPTOGO+2
  159E'   CD 1288'              	CALL	SUB24
  15A1'   C3 1527'              	JMP	OPG_SV
  15A4'                         OPG_NO:
  15A4'   0E 07                 	MVI	C,BEL
  15A6'   CD 0000*              	CALL	BCONOU
  15A9'                         OPG_HM:				; the cursor back where the command found it
  15A9'   21 2E1B'              	LXI	H,OPSFP
  15AC'   CD 03DC'              	CALL	MKLOAD
  15AF'   CD 03A9'              	CALL	MKPAGE
  15B2'   CD 0000*              	CALL	GOTO
  15B5'   AF                    	XRA	A
  15B6'   32 2E13'              	STA	PSAVE
  15B9'   3C                    	INR	A
  15BA'   32 2E73'              	STA	GPKEEP		; the column it had, not the first non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  15BD'                         OPMID:
  15BD'   CD 12B5'              	CALL	ZSAVE
  15C0'   C3 138A'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  15C3'                         ONWHIT:
  15C3'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15C6'   CA 15E2'              	JZ	OW_YES
  15C9'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  15CC'   FE 20                 	CPI	' '
  15CE'   CA 15E2'              	JZ	OW_YES
  15D1'   FE 09                 	CPI	TAB
  15D3'   CA 15E2'              	JZ	OW_YES
  15D6'   FE 0D                 	CPI	CR
  15D8'   CA 15E2'              	JZ	OW_YES
  15DB'   FE 0A                 	CPI	LF
  15DD'   CA 15E2'              	JZ	OW_YES
  15E0'   B7                    	ORA	A		; a char to change: CY clear
  15E1'   C9                    	RET
  15E2'                         OW_YES:
  15E2'   37                    	STC
  15E3'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  15E4'                         OPLINE:
  15E4'   3A 2E13'              	LDA	PSAVE
  15E7'   FE 63                 	CPI	'c'
  15E9'   CA 0807'              	JZ	SETMOV
  15EC'   FE 79                 	CPI	'y'
  15EE'   CA 1B4A'              	JZ	VY_YY
  15F1'   21 2E1B'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  15F4'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  15F7'   C3 1AC0'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  15FA'                         OPCLS:
  15FA'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  15FC'   CA 1609'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  15FF'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1601'   C2 161D'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1604'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1606'   C3 160B'              	JMP	OPC_FK
  1609'                         OPC_SEM:
  1609'   06 00                 	MVI	B,0		; ';' runs it as it stands
  160B'                         OPC_FK:
  160B'   3A 2E69'              	LDA	FNDKND
  160E'   B7                    	ORA	A
  160F'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1610'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1611'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1612'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1614'   CA 161B'              	JZ	OPC_EXC
  1617'   3E 01                 	MVI	A,1
  1619'   B7                    	ORA	A		; CY clear: a motion, class 1
  161A'   C9                    	RET
  161B'                         OPC_EXC:
  161B'   AF                    	XRA	A		; class 0, CY clear
  161C'   C9                    	RET
  161D'                         OPC_TB:
  161D'   47                    	MOV	B,A
  161E'   21 17FD'              	LXI	H,OPCTAB
  1621'                         OPC_LP:
  1621'   7E                    	MOV	A,M
  1622'   B7                    	ORA	A
  1623'   CA 1633'              	JZ	OPC_MS		; end of table -> not a motion
  1626'   B8                    	CMP	B
  1627'   CA 162F'              	JZ	OPC_HT
  162A'   23                    	INX	H
  162B'   23                    	INX	H
  162C'   C3 1621'              	JMP	OPC_LP
  162F'                         OPC_HT:
  162F'   23                    	INX	H
  1630'   7E                    	MOV	A,M		; class byte
  1631'   B7                    	ORA	A		; clear CY
  1632'   C9                    	RET
  1633'                         OPC_MS:
  1633'   37                    	STC
  1634'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1635'                         OPAPPL:
  1635'   3A 2E15'              	LDA	OPCLSV
  1638'   FE 02                 	CPI	2
  163A'   CA 17D1'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  163D'   2A 2E17'              	LHLD	OPSTA
  1640'   EB                    	XCHG			; DE = start
  1641'   2A 2E19'              	LHLD	OPEND2		; HL = end
  1644'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1647'   DA 165A'              	JC	OPA_F
  164A'   CA 165A'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  164D'   22 2E27'              	SHLD	OPLO
  1650'   EB                    	XCHG
  1651'   22 2E29'              	SHLD	OPHI
  1654'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1657'   C3 1711'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  165A'                         OPA_F:
  165A'   EB                    	XCHG			; HL = start, DE = end
  165B'   22 2E27'              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  165E'   EB                    	XCHG			; HL = end
  165F'   3A 2E15'              	LDA	OPCLSV
  1662'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1664'   CA 170E'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1667'   FE 01                 	CPI	1
  1669'   C2 168B'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  166C'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  166D'   22 2E29'              	SHLD	OPHI		; park it: CEND clobbers DE
  1670'   2B                    	DCX	H		; the line it landed on
  1671'   CD 189D'              	CALL	CEND		; HL = that line's content end
  1674'   EB                    	XCHG			; DE = it
  1675'   2A 2E29'              	LHLD	OPHI		; HL = hi
  1678'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  167B'   D2 1696'              	JNC	OPA_HI		; hi is inside the line: keep it
  167E'   2A 2E27'              	LHLD	OPLO
  1681'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1684'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1687'   EB                    	XCHG			; HL = the content end: the span stops there
  1688'   C3 1696'              	JMP	OPA_HI
  168B'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  168B'   22 2E29'              	SHLD	OPHI
  168E'   3A 2DE9'              	LDA	WPULL
  1691'   B7                    	ORA	A
  1692'   CA 1711'              	JZ	OPA_C1
  1695'   23                    	INX	H
  1696'                         OPA_HI:
  1696'   22 2E29'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1699'                         OPA_DO:
  1699'   CD 175D'              	CALL	OPSPNL
  169C'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  169D'   B5                    	ORA	L
  169E'   C2 16A7'              	JNZ	OPA_D1
  16A1'   2A 2E27'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  16A4'   C3 0000*              	JMP	GOTO		;   to where the span starts
  16A7'                         OPA_D1:
  16A7'   3A 2E13'              	LDA	PSAVE
  16AA'   FE 63                 	CPI	'c'
  16AC'   CA 1768'              	JZ	OPDSPN
  16AF'   CD 1750'              	CALL	SPNBRK
  16B2'   D2 16D3'              	JNC	OPA_D2
  16B5'   2A 2E29'              	LHLD	OPHI
  16B8'   CD 189D'              	CALL	CEND
  16BB'   EB                    	XCHG			; DE = the content end of the line it ends in
  16BC'   2A 2E29'              	LHLD	OPHI
  16BF'                         OPA_BL:
  16BF'   CD 0000*              	CALL	CMP16
  16C2'   CA 16D9'              	JZ	OPA_BI		; only blanks after it
  16C5'   D5                    	PUSH	D
  16C6'   E5                    	PUSH	H
  16C7'   CD 0000*              	CALL	CHARAT
  16CA'   E1                    	POP	H
  16CB'   D1                    	POP	D
  16CC'   23                    	INX	H
  16CD'   CD 1708'              	CALL	BLANKQ
  16D0'   CA 16BF'              	JZ	OPA_BL
  16D3'                         OPA_D2:
  16D3'   CD 1768'              	CALL	OPDSPN
  16D6'   C3 18AE'              	JMP	CLAMPE
  16D9'                         OPA_BI:
  16D9'   CD 16EB'              	CALL	LOIND
  16DC'   C2 16D3'              	JNZ	OPA_D2
  16DF'   2A 2E29'              	LHLD	OPHI
  16E2'   CD 06BB'              	CALL	NLSTART
  16E5'   22 2E29'              	SHLD	OPHI
  16E8'   C3 173C'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  16EB'                         LOIND:
  16EB'   2A 2E27'              	LHLD	OPLO
  16EE'   CD 0624'              	CALL	BOL
  16F1'                         LI_LP:
  16F1'   E5                    	PUSH	H
  16F2'   EB                    	XCHG
  16F3'   2A 2E27'              	LHLD	OPLO
  16F6'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  16F9'   E1                    	POP	H
  16FA'   C8                    	RZ
  16FB'   E5                    	PUSH	H
  16FC'   CD 0000*              	CALL	CHARAT
  16FF'   E1                    	POP	H
  1700'   23                    	INX	H
  1701'   CD 1708'              	CALL	BLANKQ
  1704'   CA 16F1'              	JZ	LI_LP
  1707'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1708'                         BLANKQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1708'   FE 20                 	CPI	' '
  170A'   C8                    	RZ
  170B'   FE 09                 	CPI	TAB
  170D'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  170E'                         OPA_JP:
  170E'   22 2E29'              	SHLD	OPHI
  1711'                         OPA_C1:
  1711'   CD 175D'              	CALL	OPSPNL
  1714'   7C                    	MOV	A,H
  1715'   B5                    	ORA	L
  1716'   CA 1699'              	JZ	OPA_DO		; nothing spanned
  1719'   2A 2E29'              	LHLD	OPHI
  171C'   CD 0624'              	CALL	BOL
  171F'   EB                    	XCHG
  1720'   2A 2E29'              	LHLD	OPHI
  1723'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1726'   C2 1699'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1729'   CD 16EB'              	CALL	LOIND
  172C'   CA 173C'              	JZ	C1_LW		; only blanks before lo: whole lines
  172F'                         C1_CH:
  172F'   2A 2E29'              	LHLD	OPHI		; back over the line break to the content end
  1732'   2B                    	DCX	H		;   of the line before
  1733'   CD 189D'              	CALL	CEND
  1736'   22 2E29'              	SHLD	OPHI
  1739'   C3 1699'              	JMP	OPA_DO
  173C'                         C1_LW:
  173C'   2A 2E27'              	LHLD	OPLO
  173F'   CD 0624'              	CALL	BOL
  1742'   22 2E27'              	SHLD	OPLO
  1745'   3A 2E13'              	LDA	PSAVE
  1748'   FE 63                 	CPI	'c'
  174A'   CA 172F'              	JZ	C1_CH
  174D'   C3 17E4'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1750'                         SPNBRK:
  1750'   2A 2E27'              	LHLD	OPLO
  1753'   CD 0667'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1756'   EB                    	XCHG			; DE = it
  1757'   2A 2E29'              	LHLD	OPHI
  175A'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  175D'                         OPSPNL:
  175D'   2A 2E29'              	LHLD	OPHI
  1760'   EB                    	XCHG
  1761'   2A 2E27'              	LHLD	OPLO
  1764'   EB                    	XCHG			; HL = hi, DE = lo
  1765'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1768'                         OPDSPN:
  1768'   CD 1750'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  176B'   F5                    	PUSH	PSW
  176C'   2A 2E27'              	LHLD	OPLO
  176F'   CD 0000*              	CALL	GOTO
  1772'   CD 175D'              	CALL	OPSPNL		; HL = hi - lo
  1775'   CD 0000*              	CALL	DELFWD
  1778'   CD 0174'              	CALL	MARKMOD
  177B'   F1                    	POP	PSW
  177C'   DA 0844'              	JC	SETFUL		; a break went: every row below it moved up
  177F'   C3 080D'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1782'                         UNDFNB:
  1782'   CD 0000*              	CALL	CUROFF
  1785'   E5                    	PUSH	H
  1786'   CD 08FC'              	CALL	FNBLNK
  1789'   CD 0000*              	CALL	CUROFF
  178C'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  178D'   CD 0000*              	CALL	CMP16
  1790'   D2 0000*              	JNC	UNDHER
  1793'   EB                    	XCHG
  1794'   CD 0000*              	CALL	GOTO
  1797'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  179A'                         OPALSP:
  179A'   2A 2E17'              	LHLD	OPSTA
  179D'   EB                    	XCHG
  179E'   2A 2E19'              	LHLD	OPEND2
  17A1'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  17A4'   DA 17B4'              	JC	OPAL_F
  17A7'   22 2E27'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  17AA'   EB                    	XCHG
  17AB'   22 2E29'              	SHLD	OPHI		; hi-src = start
  17AE'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  17B1'   C3 17BE'              	JMP	OPAL_R
  17B4'                         OPAL_F:
  17B4'   EB                    	XCHG			; HL = start
  17B5'   22 2E27'              	SHLD	OPLO		; lo-src = start
  17B8'   2A 2E19'              	LHLD	OPEND2
  17BB'   22 2E29'              	SHLD	OPHI		; hi-src = end
  17BE'                         OPAL_R:
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17BE'   2A 2E27'              	LHLD	OPLO
  17C1'   CD 0624'              	CALL	BOL
  17C4'   22 2E27'              	SHLD	OPLO		; lo = BOL(low line)
  17C7'   2A 2E29'              	LHLD	OPHI
  17CA'   CD 06BB'              	CALL	NLSTART
  17CD'   22 2E29'              	SHLD	OPHI		; hi = start of line past the high line
  17D0'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  17D1'                         OPALIN:
  17D1'   CD 179A'              	CALL	OPALSP
  17D4'   2A 2E27'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  17D7'   CD 06BB'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  17DA'   EB                    	XCHG			;   the column)
  17DB'   2A 2E29'              	LHLD	OPHI
  17DE'   CD 0000*              	CALL	CMP16
  17E1'   CC 1782'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  17E4'                         OPDLIN:
  17E4'   CD 1768'              	CALL	OPDSPN
  17E7'   CD 070E'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  17EA'   DA 17FA'              	JC	OPDL_NB
  17ED'   CD 0000*              	CALL	LOGLEN
  17F0'   7C                    	MOV	A,H
  17F1'   B5                    	ORA	L
  17F2'   C8                    	RZ			; empty buffer
  17F3'   2B                    	DCX	H
  17F4'   CD 0624'              	CALL	BOL
  17F7'   CD 0000*              	CALL	GOTO
  17FA'                         OPDL_NB:
  17FA'   C3 08FC'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  17FD'                         OPCTAB:
  17FD'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1801'   62 00 42 00           
  1805'   68 00 6C 00           
  1809'   30 00 5E 00           
  180D'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                				;   so OPA_EX's end-of-line clamp does not apply
  180F'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1813'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1817'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  181B'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  181F'   24 01                 
  1821'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1825'   47 02 48 02           
  1829'   4D 02 4C 02           
  182D'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  182F'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1831'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1832'                         VCB_C:
  1832'   CD 183E'              	CALL	VCB_CD
  1835'   C3 191F'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1838'                         VCB_D:
  1838'   CD 183E'              	CALL	VCB_CD
  183B'   C3 18AE'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  183E'                         VCB_CD:
  183E'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1841'   22 2E27'              	SHLD	OPLO
  1844'   CD 0000*              	CALL	CUROFF
  1847'   CD 189D'              	CALL	CEND		; to the line's content end, the CR,LF left
  184A'   22 2E29'              	SHLD	OPHI
  184D'   C3 1768'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1850'                         VC_X:
  1850'   CD 09AE'              	CALL	GLSTAL
  1853'   CD 080D'              	CALL	SETLIN
  1856'   CD 0732'              	CALL	GETCNT
  1859'   22 2E2B'              	SHLD	CNTV
  185C'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  185F'   22 2E2D'              	SHLD	WKI		; cur
  1862'   CD 189D'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1865'   EB                    	XCHG			; DE = contentend
  1866'   2A 2E2D'              	LHLD	WKI		; HL = cur
  1869'   EB                    	XCHG			; HL = contentend, DE = cur
  186A'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  186D'   7C                    	MOV	A,H
  186E'   B5                    	ORA	L
  186F'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1870'   EB                    	XCHG			; DE = available
  1871'   2A 2E2B'              	LHLD	CNTV		; HL = count
  1874'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1877'   DA 187D'              	JC	VX_USEA
  187A'   C3 187E'              	JMP	VX_DEL		; count <= available -> HL = count = del
  187D'                         VX_USEA:
  187D'   EB                    	XCHG			; HL = available
  187E'                         VX_DEL:
                                	;--- plain chars, and plain chars after them: the terminal can close
                                	;    the cells up itself (R_DCH).  A TAB there would change width. ---
  187E'   E5                    	PUSH	H
  187F'   CD 084A'              	CALL	TAILTAB
  1882'   E1                    	POP	H
  1883'   B4                    	ORA	H		; (or more of them than a byte counts)
  1884'   C2 1894'              	JNZ	VX_D1
  1887'   7D                    	MOV	A,L
  1888'   32 2DE3'              	STA	DCHN
  188B'   AF                    	XRA	A
  188C'   32 2DE4'              	STA	DCHBS
  188F'   3E 07                 	MVI	A,R_DCH
  1891'   32 2DE0'              	STA	RINTENT
  1894'                         VX_D1:
  1894'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1897'   CD 0174'              	CALL	MARKMOD
  189A'   C3 18AE'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  189D'                         CEND:
  189D'   CD 0667'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  18A0'   7C                    	MOV	A,H
  18A1'   B5                    	ORA	L
  18A2'   C8                    	RZ			; the start of the text: nothing before it
  18A3'   2B                    	DCX	H
  18A4'   E5                    	PUSH	H
  18A5'   CD 0000*              	CALL	CHARAT
  18A8'   E1                    	POP	H		; HL = term-1
  18A9'   FE 0D                 	CPI	CR
  18AB'   C8                    	RZ			; a CR before the LF -> the content ends there
  18AC'   23                    	INX	H
  18AD'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  18AE'                         CLAMPE:
  18AE'   CD 0000*              	CALL	CUROFF
  18B1'   E5                    	PUSH	H
  18B2'   CD 06CA'              	CALL	EOLC
  18B5'   D1                    	POP	D		; DE = cur
  18B6'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  18B9'   D8                    	RC
  18BA'   C8                    	RZ
  18BB'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  18BE'                         VC_I:
  18BE'   CD 0732'              	CALL	GETCNT
  18C1'   C3 191C'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  18C4'                         VC_A:
  18C4'   CD 0732'              	CALL	GETCNT
  18C7'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  18CA'   CA 18E1'              	JZ	VA_INS
  18CD'   EB                    	XCHG			; HL = cur
  18CE'   E5                    	PUSH	H
  18CF'   CD 0000*              	CALL	CHARAT
  18D2'   E1                    	POP	H
  18D3'   FE 0A                 	CPI	LF
  18D5'   CA 18E1'              	JZ	VA_INS		; on the line terminator -> append in place
  18D8'   FE 0D                 	CPI	CR
  18DA'   CA 18E1'              	JZ	VA_INS
  18DD'   23                    	INX	H
  18DE'   CD 0000*              	CALL	GOTO
  18E1'                         VA_INS:
  18E1'   C3 191C'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  18E4'                         VCB_A:
  18E4'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18E7'   CD 06CA'              	CALL	EOLC		; HL = last content char (the start when empty)
  18EA'   E5                    	PUSH	H
  18EB'   CD 0000*              	CALL	CHARAT
  18EE'   E1                    	POP	H
  18EF'   FE 0D                 	CPI	CR
  18F1'   CA 18FA'              	JZ	VBA_IN		; an empty line: insert at its start
  18F4'   FE 0A                 	CPI	LF
  18F6'   CA 18FA'              	JZ	VBA_IN
  18F9'   23                    	INX	H		; past the last content char
  18FA'                         VBA_IN:
  18FA'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18FD'   C3 191C'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1900'                         VCB_I:
  1900'   CD 0732'              	CALL	GETCNT
  1903'   CD 08FC'              	CALL	FNBLNK
  1906'   CD 0000*              	CALL	CUROFF
  1909'   E5                    	PUSH	H
  190A'   CD 0000*              	CALL	CHARAT
  190D'   E1                    	POP	H
  190E'   FE 20                 	CPI	' '
  1910'   CA 1918'              	JZ	VBI_SK
  1913'   FE 09                 	CPI	TAB
  1915'   C2 191C'              	JNZ	SETINM
  1918'                         VBI_SK:
  1918'   23                    	INX	H		; blanks only: past the last of them
  1919'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  191C'                         SETINM:
  191C'   CD 0807'              	CALL	SETMOV
  191F'                         SETINS:
  191F'   3E 01                 	MVI	A,EM_INS
  1921'   32 2DDB'              	STA	EDMODE
  1924'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1925'                         ATCEND:
  1925'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1928'   C8                    	RZ
  1929'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  192C'   FE 0D                 	CPI	CR
  192E'   C8                    	RZ
  192F'   FE 0A                 	CPI	LF
  1931'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1932'                         OPNBRK:
  1932'   CD 2258'              	CALL	PUTBRK
  1935'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1938'   23                    	INX	H
  1939'   22 0000*              	SHLD	LNDLT
  193C'   C3 0174'              	JMP	MARKMOD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  193F'                         ENDBRK:
  193F'   CD 070E'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1942'   C0                    	RNZ
  1943'   CD 1932'              	CALL	OPNBRK
  1946'   CD 0000*              	CALL	CUROFF
  1949'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  194A'   2B                    	DCX	H		;   line, with its own terminator after it
  194B'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  194E'                         VC_O:
  194E'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1951'   CD 189D'              	CALL	CEND
  1954'   CD 0000*              	CALL	GOTO
  1957'   CD 1932'              	CALL	OPNBRK
  195A'   CD 193F'              	CALL	ENDBRK		; a last line with no line end: the opened line
  195D'   CD 082F'              	CALL	SETILN		;   needs a terminator of its own to exist
  1960'   C3 191F'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1963'                         VCB_O:
  1963'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1966'   CD 0624'              	CALL	BOL
  1969'   CD 0000*              	CALL	GOTO
  196C'   CD 1932'              	CALL	OPNBRK
  196F'   CD 0000*              	CALL	CUROFF
  1972'   2B                    	DCX	H
  1973'   2B                    	DCX	H
  1974'   CD 0000*              	CALL	GOTO
  1977'   CD 082F'              	CALL	SETILN
  197A'   C3 191F'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  197D'                         VCB_J:
  197D'   CD 0725'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1980'   CD 189D'              	CALL	CEND		; the join point: this line's content end
  1983'   22 2E27'              	SHLD	OPLO
  1986'   CD 0000*              	CALL	CUROFF
  1989'   CD 06BB'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  198C'   E5                    	PUSH	H
  198D'   CD 0000*              	CALL	LOGLEN
  1990'   D1                    	POP	D		; DE = that start
  1991'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1994'   CA 0807'              	JZ	SETMOV
  1997'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1998'                         VJ_WS:
  1998'   E5                    	PUSH	H
  1999'   CD 0000*              	CALL	LOGLEN
  199C'   D1                    	POP	D		; DE = the scan
  199D'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  19A0'   CA 19B7'              	JZ	VJ_DEL
  19A3'   EB                    	XCHG			; HL = the scan
  19A4'   E5                    	PUSH	H
  19A5'   CD 0000*              	CALL	CHARAT
  19A8'   E1                    	POP	H
  19A9'   FE 20                 	CPI	' '
  19AB'   CA 19B3'              	JZ	VJ_SKIP
  19AE'   FE 09                 	CPI	TAB
  19B0'   C2 19B7'              	JNZ	VJ_DEL
  19B3'                         VJ_SKIP:
  19B3'   23                    	INX	H
  19B4'   C3 1998'              	JMP	VJ_WS
  19B7'                         VJ_DEL:
  19B7'   22 2E29'              	SHLD	OPHI
  19BA'   CD 1768'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  19BD'   CD 083E'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  19C0'   CD 070E'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  19C3'   CA 18AE'              	JZ	CLAMPE
  19C6'   CD 0719'              	CALL	CURCHR		; the first char of what was appended
  19C9'   FE 0D                 	CPI	CR
  19CB'   CA 18AE'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  19CE'   FE 0A                 	CPI	LF
  19D0'   CA 18AE'              	JZ	CLAMPE
  19D3'   FE 29                 	CPI	')'
  19D5'   CA 18AE'              	JZ	CLAMPE		; vim puts no space before a ')'
  19D8'   CD 0000*              	CALL	CUROFF
  19DB'   7C                    	MOV	A,H
  19DC'   B5                    	ORA	L
  19DD'   CA 19F3'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  19E0'   2B                    	DCX	H
  19E1'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  19E4'   FE 20                 	CPI	' '
  19E6'   CA 18AE'              	JZ	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19E9'   FE 09                 	CPI	TAB
  19EB'   CA 18AE'              	JZ	CLAMPE
  19EE'   FE 0A                 	CPI	LF
  19F0'   CA 18AE'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  19F3'                         VJ_SP:
  19F3'   3E 20                 	MVI	A,' '
  19F5'   CD 0000*              	CALL	PUTGAP
  19F8'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  19FB'   2B                    	DCX	H
  19FC'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  19FF'                         VC_TILD:
  19FF'   CD 0732'              	CALL	GETCNT
  1A02'   CD 080D'              	CALL	SETLIN		; only this row changes
  1A05'   CD 09AE'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A08'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A0B'   CA 0807'              	JZ	SETMOV
  1A0E'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  1A11'   FE 0D                 	CPI	CR
  1A13'   CA 0807'              	JZ	SETMOV		; the line's end: nothing to toggle
  1A16'   FE 0A                 	CPI	LF
  1A18'   CA 0807'              	JZ	SETMOV
  1A1B'   47                    	MOV	B,A
  1A1C'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1A1E'   FE 41                 	CPI	'A'
  1A20'   DA 1A2C'              	JC	VT_PUT		; below 'A': no case
  1A23'   FE 5B                 	CPI	'Z'+1
  1A25'   D2 1A2C'              	JNC	VT_PUT		; above 'Z': no case
  1A28'   78                    	MOV	A,B
  1A29'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1A2B'   47                    	MOV	B,A
  1A2C'                         VT_PUT:
  1A2C'   78                    	MOV	A,B
  1A2D'   32 2E34'              	STA	VRCH		; the calls below do not preserve B
  1A30'   CD 0174'              	CALL	MARKMOD
  1A33'   21 0001               	LXI	H,1
  1A36'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A39'   3A 2E34'              	LDA	VRCH
  1A3C'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1A3F'   C3 18AE'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1A42'                         VC_R:
  1A42'   CD 071F'              	CALL	MOVCNT		; a cursor motion, and its count
  1A45'   3E 03                 	MVI	A,PR
  1A47'   32 2E10'              	STA	GPEND
  1A4A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1A4B'                         VR_DO:
  1A4B'   AF                    	XRA	A
  1A4C'   32 2E10'              	STA	GPEND
  1A4F'   79                    	MOV	A,C
  1A50'   32 2E34'              	STA	VRCH		; the calls below do not preserve C
  1A53'   CD 080D'              	CALL	SETLIN		; only this row changed
  1A56'   CD 09AE'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1A59'   CD 070E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A5C'   CA 0807'              	JZ	SETMOV		; the end of the text: vim does nothing
  1A5F'   CD 0719'              	CALL	CURCHR		; A = the char under the cursor
  1A62'   FE 0D                 	CPI	CR
  1A64'   CA 0807'              	JZ	SETMOV		; the line's end: nothing to replace
  1A67'   FE 0A                 	CPI	LF
  1A69'   CA 0807'              	JZ	SETMOV
  1A6C'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1A6E'   CD 0813'              	CALL	SETCEL
  1A71'   CD 0174'              	CALL	MARKMOD
  1A74'   21 0001               	LXI	H,1
  1A77'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1A7A'   3A 2E34'              	LDA	VRCH
  1A7D'   FE 0D                 	CPI	CR
  1A7F'   CA 1A8C'              	JZ	VR_CR
  1A82'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1A85'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A88'   2B                    	DCX	H		;   out, which moves every logical offset
  1A89'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1A8C'                         VR_CR:
  1A8C'   CD 1932'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1A8F'   CD 193F'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1A92'   CD 082F'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1A95'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1A97'   32 2DE5'              	STA	ILABOV
  1A9A'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1A9B'                         VCB_R:
  1A9B'   CD 0732'              	CALL	GETCNT
  1A9E'   CD 0807'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1AA1'   21 0000               	LXI	H,0
  1AA4'   22 2E35'              	SHLD	RPDEL		; nothing of ours to put back yet
  1AA7'   22 2E37'              	SHLD	RPAPP
  1AAA'   3E 02                 	MVI	A,EM_REP
  1AAC'   32 2DDB'              	STA	EDMODE
  1AAF'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1AB0'                         VC_D:
  1AB0'   3E 64                 	MVI	A,'d'
  1AB2'   32 2E12'              	STA	PENDOP
  1AB5'   C3 0807'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1AB8'                         VC_C:
  1AB8'   3E 63                 	MVI	A,'c'
  1ABA'   32 2E12'              	STA	PENDOP
  1ABD'   C3 0807'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1AC0'                         VD_DD:
  1AC0'   CD 09AE'              	CALL	GLSTAL
  1AC3'   CD 0732'              	CALL	GETCNT
  1AC6'   22 2E2B'              	SHLD	CNTV
  1AC9'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1ACB'   32 2E14'              	STA	DDSNG
  1ACE'   2B                    	DCX	H
  1ACF'   7C                    	MOV	A,H
  1AD0'   B5                    	ORA	L
  1AD1'   C2 1ADF'              	JNZ	VDD_LS
  1AD4'   3E 01                 	MVI	A,1
  1AD6'   32 2E14'              	STA	DDSNG
  1AD9'   CD 1782'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1ADC'   C3 1AE5'              	JMP	VDD_GO
  1ADF'                         VDD_LS:
  1ADF'   CD 0967'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1AE2'   DA 0807'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1AE5'                         VDD_GO:
  1AE5'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1AE8'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1AEB'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1AEE'   CD 24BB'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1AF1'   CD 08E5'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1AF4'   2A 2E2B'              	LHLD	CNTV
  1AF7'   CD 0000*              	CALL	SETC0
  1AFA'                         VDD_FW:
  1AFA'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1AFD'   DA 1C4B'              	JC	QREFUS		; ... which has no room for them
  1B00'   CD 0747'              	CALL	CNTTST
  1B03'   C2 1AFA'              	JNZ	VDD_FW
  1B06'   CD 0174'              	CALL	MARKMOD
  1B09'   CD 0AE5'              	CALL	ATEOF
  1B0C'   D2 1B27'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1B0F'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B11'   32 2E14'              	STA	DDSNG		; deleted to the end: full repaint
  1B14'   CD 11C5'              	CALL	ONFST
  1B17'   CA 08FC'              	JZ	FNBLNK		; nothing left before it
  1B1A'   21 0001               	LXI	H,1		; onto the new last line
  1B1D'   CD 0000*              	CALL	SETBWD
  1B20'   2A 0000*              	LHLD	LNDLT
  1B23'   2B                    	DCX	H
  1B24'   22 0000*              	SHLD	LNDLT
  1B27'                         VDD_UP:
  1B27'   CD 08FC'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1B2A'   3A 2E14'              	LDA	DDSNG
  1B2D'   B7                    	ORA	A
  1B2E'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1B2F'   3E 03                 	MVI	A,R_DLIN
  1B31'   32 2DE0'              	STA	RINTENT
  1B34'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1B35'                         QEMPTY:
  1B35'   2A 0000*              	LHLD	QBEG
  1B38'   EB                    	XCHG
  1B39'   2A 0000*              	LHLD	QEND
  1B3C'   7C                    	MOV	A,H
  1B3D'   BA                    	CMP	D
  1B3E'   C0                    	RNZ
  1B3F'   7D                    	MOV	A,L
  1B40'   BB                    	CMP	E
  1B41'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1B42'                         VC_Y:
  1B42'   3E 79                 	MVI	A,'y'
  1B44'   32 2E12'              	STA	PENDOP
  1B47'   C3 0807'              	JMP	SETMOV
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1B4A'                         VY_YY:
  1B4A'   21 2E1B'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1B4D'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1B50'   CD 0000*              	CALL	CUROFF
  1B53'   22 2E58'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1B56'   CD 0624'              	CALL	BOL
  1B59'   22 2E5A'              	SHLD	YPT		; where the lines come from, to put them back
  1B5C'   CD 1CB1'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B5F'   CD 1CF4'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1B62'   D2 1CB8'              	JNC	YNDONE
  1B65'   21 1AC0'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1B68'   C3 1B94'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1B6B'                         OPYANK:
  1B6B'   CD 179A'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1B6E'   2A 2E17'              	LHLD	OPSTA
  1B71'   EB                    	XCHG			; DE = start
  1B72'   2A 2E19'              	LHLD	OPEND2		; HL = end
  1B75'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1B78'   D2 1B7C'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1B7B'   EB                    	XCHG			; ... otherwise the start is
  1B7C'                         OPY_LO:
  1B7C'   22 2E58'              	SHLD	YOFF
  1B7F'   2A 2E27'              	LHLD	OPLO
  1B82'   22 2E5A'              	SHLD	YPT		; where the lines come from, to put them back
  1B85'   CD 1CB1'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B88'   CD 1D6C'              	CALL	YNSPAN		; copied where they lie, if there is room
  1B8B'   D2 1CB8'              	JNC	YNDONE
  1B8E'   21 1C72'              	LXI	H,YSPAN
  1B91'   C3 1B94'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1B94'                         YKGO:
  1B94'   22 2E82'              	SHLD	YACT
  1B97'   2A 2E5A'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1B9A'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1B9B'   2A 2E58'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1B9E'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1BA1'   22 2E88'              	SHLD	YCOL		;   them -- but a distance within the lines does
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BA4'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1BA7'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1BA8'   2A 2E5A'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1BAB'   EB                    	XCHG			;   window as it was, then names other text
  1BAC'   E1                    	POP	H
  1BAD'   CD 0000*              	CALL	SUBHD
  1BB0'   EB                    	XCHG			; DE = how far behind the cursor they start
  1BB1'   CD 1292'              	CALL	CURFP
  1BB4'   06 00                 	MVI	B,0
  1BB6'   CD 1288'              	CALL	SUB24
  1BB9'   22 2E8A'              	SHLD	YPFP
  1BBC'   32 2E8C'              	STA	YPFP+2
  1BBF'   3A 2DDF'              	LDA	MODF
  1BC2'   32 2E55'              	STA	YMODF
  1BC5'   3A 2E05'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1BC8'   32 2E56'              	STA	YDCHG		;   a yank must not become the last change
  1BCB'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1BCE'   32 2E57'              	STA	YURPL		;   back are not a change to undo either
  1BD1'   3E 01                 	MVI	A,1
  1BD3'   32 0000*              	STA	UNDRPL
  1BD6'   32 2E81'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1BD9'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1BDC'   22 2E64'              	SHLD	YLDLT
  1BDF'   CD 0000*              	CALL	LOGLEN
  1BE2'   22 2E86'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1BE5'   2A 2E82'              	LHLD	YACT
  1BE8'   CD 1C4A'              	CALL	YCALL		; the lines out of the file, into the register
  1BEB'   3A 2E50'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1BEE'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1BF0'   CA 1C2E'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1BF3'   CD 0000*              	CALL	LOGLEN
  1BF6'   EB                    	XCHG
  1BF7'   2A 2E86'              	LHLD	YWAS
  1BFA'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1BFD'   CA 1C0F'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1C00'   21 2E8A'              	LXI	H,YPFP		; back to where they came from, by its place in
  1C03'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1C06'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1C09'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1C0C'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1C0F'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1C0F'   2A 2E8A'              	LHLD	YPFP		;   cursor is still owed its place)
  1C12'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C13'   2A 2E88'              	LHLD	YCOL
  1C16'   19                    	DAD	D
  1C17'   22 2E7D'              	SHLD	MKPOS
  1C1A'   3A 2E8C'              	LDA	YPFP+2
  1C1D'   CE 00                 	ACI	0
  1C1F'   32 2E7F'              	STA	MKPOS+2
  1C22'   CD 03A9'              	CALL	MKPAGE
  1C25'   CD 0000*              	CALL	GOTO
  1C28'                         YK_RST:
  1C28'   2A 2E64'              	LHLD	YLDLT
  1C2B'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1C2E'                         YK_RF:
  1C2E'   3A 2E55'              	LDA	YMODF
  1C31'   32 2DDF'              	STA	MODF
  1C34'   3A 2E56'              	LDA	YDCHG
  1C37'   32 2E05'              	STA	DOTCHG
  1C3A'   3A 2E57'              	LDA	YURPL
  1C3D'   32 0000*              	STA	UNDRPL
  1C40'   AF                    	XRA	A
  1C41'   32 2E81'              	STA	MKHOLD
  1C44'   CD 09AE'              	CALL	GLSTAL
  1C47'   C3 0844'              	JMP	SETFUL		; the cheap paint cannot carry this
  1C4A'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1C4B'                         QREFUS:
  1C4B'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1C4E'   CD 1B35'              	CALL	QEMPTY
  1C51'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1C54'   CD 0000*              	CALL	QKILL
  1C57'   3A 2E81'              	LDA	MKHOLD
  1C5A'   B7                    	ORA	A
  1C5B'   C2 1C6A'              	JNZ	QRF_Y
  1C5E'   21 0000*              	LXI	H,MKSAV
  1C61'   11 0000*              	LXI	D,MKTAB
  1C64'   CD 24BB'              	CALL	COPY12
  1C67'   CD 0000*              	CALL	UNDCLR
  1C6A'                         QRF_Y:
  1C6A'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1C6C'   32 2E50'              	STA	MSGWHT
  1C6F'   C3 15A9'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1C72'                         YSPAN:
  1C72'   CD 09AE'              	CALL	GLSTAL
  1C75'   CD 175D'              	CALL	OPSPNL		; HL = the span's length
  1C78'   22 2E84'              	SHLD	YTGT
  1C7B'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1C7E'   EB                    	XCHG			; DE = it
  1C7F'   2A 2E84'              	LHLD	YTGT
  1C82'   EB                    	XCHG			; HL = the text's, DE = the span's
  1C83'   CD 0000*              	CALL	SUBHD
  1C86'   22 2E84'              	SHLD	YTGT		; what the text is left at when the span is out
  1C89'   2A 2E27'              	LHLD	OPLO
  1C8C'   CD 0000*              	CALL	GOTO
  1C8F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C92'                         YS_LP:
  1C92'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1C95'   CD 0000*              	CALL	SETC0
  1C98'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1C9B'   DA 1C4B'              	JC	QREFUS		; ... which has no room for it
  1C9E'   CD 0000*              	CALL	LOGLEN
  1CA1'   EB                    	XCHG			; DE = what is left
  1CA2'   2A 2E84'              	LHLD	YTGT
  1CA5'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1CA8'   DA 1CAE'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1CAB'   C2 1C92'              	JNZ	YS_LP		;   but never spin here if it ever did
  1CAE'                         YS_END:
  1CAE'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1CB1'                         YNPRE:
  1CB1'   2A 0000*              	LHLD	PGTOPM
  1CB4'   22 2E8D'              	SHLD	YNPG
  1CB7'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1CB8'                         YNDONE:
  1CB8'   2A 2E58'              	LHLD	YOFF
  1CBB'   CD 0000*              	CALL	GOTO
  1CBE'   2A 0000*              	LHLD	PGTOPM
  1CC1'   EB                    	XCHG
  1CC2'   2A 2E8D'              	LHLD	YNPG
  1CC5'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1CC8'   C2 0844'              	JNZ	SETFUL		; it moved under us: repaint after all
  1CCB'   C3 0807'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1CCE'                         YNROOM:
  1CCE'   11 0100               	LXI	D,100H
  1CD1'   19                    	DAD	D
  1CD2'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1CD3'   E5                    	PUSH	H		; the span plus its slack
  1CD4'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1CD7'   EB                    	XCHG			; HL = free
  1CD8'   D1                    	POP	D		; DE = the span plus its slack
  1CD9'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1CDC'   DA 1CE4'              	JC	YNR_OK
  1CDF'   CA 1CE4'              	JZ	YNR_OK
  1CE2'   37                    	STC			; not enough: the delete-and-put-back path
  1CE3'   C9                    	RET
  1CE4'                         YNR_OK:
  1CE4'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1CE5'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1CE6'                         YNGO:
  1CE6'   C5                    	PUSH	B
  1CE7'   CD 0732'              	CALL	GETCNT		; spent here: this yank is happening
  1CEA'   CD 09AE'              	CALL	GLSTAL
  1CED'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CF0'   C1                    	POP	B
  1CF1'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1CF4'                         YNCOPY:
  1CF4'   2A 2DDC'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1CF7'   7C                    	MOV	A,H		;   the count itself
  1CF8'   B5                    	ORA	L
  1CF9'   C2 1CFF'              	JNZ	YNC_HV
  1CFC'   21 0001               	LXI	H,1
  1CFF'                         YNC_HV:
  1CFF'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1D00'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1D01'   B4                    	ORA	H
  1D02'   CA 1D0D'              	JZ	YNC_M
  1D05'   E5                    	PUSH	H
  1D06'   CD 0967'              	CALL	ONLAST		; vim: a count over one on the last line does
  1D09'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1D0A'   DA 1D1F'              	JC	YNC_RF
  1D0D'                         YNC_M:
  1D0D'   E5                    	PUSH	H
  1D0E'   CD 08E5'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1D11'   E1                    	POP	H
  1D12'   CD 1D27'              	CALL	YNLINE		; BC = the span, measured where it stands
  1D15'   D8                    	RC			; not measurable here: let the pager answer it
  1D16'   60                    	MOV	H,B
  1D17'   69                    	MOV	L,C
  1D18'   CD 1CCE'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1D1B'   D8                    	RC			; no: the delete-and-put-back path
  1D1C'   C3 1CE6'              	JMP	YNGO
  1D1F'                         YNC_RF:
  1D1F'   CD 0732'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1D22'   CD 09AE'              	CALL	GLSTAL		;   register alone, and that is the command
  1D25'   B7                    	ORA	A		; NC: done
  1D26'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1D27'                         YNLINE:
  1D27'   22 2E8F'              	SHLD	YNCNT		; the lines it still wants
  1D2A'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D2D'                         YNL_LP:
  1D2D'   EB                    	XCHG			; DE = the scan
  1D2E'   2A 0000*              	LHLD	TXTEND
  1D31'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1D34'   EB                    	XCHG			; HL = the scan
  1D35'   D2 1D55'              	JNC	YNL_EN		; the resident text ran out
  1D38'   7E                    	MOV	A,M
  1D39'   23                    	INX	H
  1D3A'   FE 0A                 	CPI	LF
  1D3C'   C2 1D2D'              	JNZ	YNL_LP
  1D3F'   E5                    	PUSH	H
  1D40'   2A 2E8F'              	LHLD	YNCNT
  1D43'   2B                    	DCX	H
  1D44'   22 2E8F'              	SHLD	YNCNT
  1D47'   7C                    	MOV	A,H
  1D48'   B5                    	ORA	L
  1D49'   E1                    	POP	H
  1D4A'   C2 1D2D'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1D4D'   EB                    	XCHG			; DE = past the last of them
  1D4E'   2A 0000*              	LHLD	GAPEND
  1D51'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1D52'   C3 1D63'              	JMP	YNL_BC
  1D55'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1D55'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1D58'   C2 1D6A'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1D5B'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1D5E'   EB                    	XCHG			;   count clamps to it as vim's does
  1D5F'   2A 0000*              	LHLD	GAPEND
  1D62'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1D63'                         YNL_BC:
  1D63'   CD 0000*              	CALL	SUBHD		; HL = the span
  1D66'   44                    	MOV	B,H
  1D67'   4D                    	MOV	C,L
  1D68'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1D69'   C9                    	RET
  1D6A'                         YNL_NO:
  1D6A'   37                    	STC
  1D6B'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1D6C'                         YNSPAN:
  1D6C'   CD 175D'              	CALL	OPSPNL		; HL = the span's length
  1D6F'   44                    	MOV	B,H
  1D70'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1D71'   CD 1CCE'              	CALL	YNROOM
  1D74'   D8                    	RC			; no room: the delete-and-put-back path
  1D75'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1D76'   2A 2E27'              	LHLD	OPLO
  1D79'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1D7C'   C1                    	POP	B
  1D7D'   C3 1CE6'              	JMP	YNGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1D80'                         VC_P:
  1D80'   CD 1B35'              	CALL	QEMPTY
  1D83'   CA 1E56'              	JZ	VP_BEL
  1D86'   CD 0732'              	CALL	GETCNT
  1D89'   22 2E5C'              	SHLD	PCNT
  1D8C'   CD 0000*              	CALL	CUROFF
  1D8F'   CD 06BB'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1D92'   C3 1DA7'              	JMP	VP_GO
  1D95'                         VCB_P:
  1D95'   CD 1B35'              	CALL	QEMPTY
  1D98'   CA 1E56'              	JZ	VP_BEL
  1D9B'   CD 0732'              	CALL	GETCNT
  1D9E'   22 2E5C'              	SHLD	PCNT
  1DA1'   CD 0000*              	CALL	CUROFF
  1DA4'   CD 0624'              	CALL	BOL
  1DA7'                         VP_GO:
  1DA7'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1DAA'   CD 0000*              	CALL	CUROFF
  1DAD'   EB                    	XCHG
  1DAE'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1DB1'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1DB4'   DA 1DC9'              	JC	VP_IN
  1DB7'   EB                    	XCHG			; HL = the put point = LOGLEN
  1DB8'   7C                    	MOV	A,H
  1DB9'   B5                    	ORA	L
  1DBA'   CA 1DC6'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1DBD'   2B                    	DCX	H
  1DBE'   CD 0000*              	CALL	CHARAT
  1DC1'   FE 0A                 	CPI	LF
  1DC3'   CA 1DC9'              	JZ	VP_IN
  1DC6'                         VP_BRK:
  1DC6'   CD 1932'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1DC9'                         VP_IN:
  1DC9'   21 2E5E'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1DCC'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1DCF'   CD 12DB'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1DD2'   2A 0000*              	LHLD	QBEG
  1DD5'   EB                    	XCHG
  1DD6'   2A 0000*              	LHLD	QEND
  1DD9'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1DDC'   EB                    	XCHG
  1DDD'   22 2E61'              	SHLD	PLFS
  1DE0'   2A 2E5C'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1DE3'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1DE4'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1DE5'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1DE7'   C2 1DEB'              	JNZ	VP_PZ
  1DEA'   7D                    	MOV	A,L
  1DEB'                         VP_PZ:
  1DEB'   32 2E63'              	STA	PCPY
  1DEE'                         VP_LP:
  1DEE'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1DF1'   2A 0000*              	LHLD	LNDLT
  1DF4'   EB                    	XCHG
  1DF5'   2A 2E61'              	LHLD	PLFS
  1DF8'   19                    	DAD	D
  1DF9'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1DFC'   2A 2E5C'              	LHLD	PCNT
  1DFF'   2B                    	DCX	H
  1E00'   22 2E5C'              	SHLD	PCNT
  1E03'   7C                    	MOV	A,H
  1E04'   B5                    	ORA	L
  1E05'   C2 1DEE'              	JNZ	VP_LP
  1E08'   CD 0174'              	CALL	MARKMOD
  1E0B'   21 2E5E'              	LXI	H,PPFP
  1E0E'   CD 03DC'              	CALL	MKLOAD
  1E11'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1E14'   D2 1E47'              	JNC	VP_PGD
  1E17'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1E1A'   CD 09AE'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1E1D'   3A 2E63'              	LDA	PCPY
  1E20'   B7                    	ORA	A
  1E21'   CA 08FC'              	JZ	FNBLNK
  1E24'   2A 2E61'              	LHLD	PLFS
  1E27'   7C                    	MOV	A,H
  1E28'   B7                    	ORA	A
  1E29'   C2 08FC'              	JNZ	FNBLNK
  1E2C'   3A 2E63'              	LDA	PCPY
  1E2F'   CD 0F8D'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1E32'   7C                    	MOV	A,H
  1E33'   B7                    	ORA	A
  1E34'   C2 08FC'              	JNZ	FNBLNK
  1E37'   7D                    	MOV	A,L
  1E38'   B7                    	ORA	A
  1E39'   CA 08FC'              	JZ	FNBLNK
  1E3C'   F5                    	PUSH	PSW
  1E3D'   CD 082F'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1E40'   F1                    	POP	PSW
  1E41'   32 2DE1'              	STA	ILN		; ... which the lines put now replace
  1E44'   C3 08FC'              	JMP	FNBLNK
  1E47'                         VP_PGD:				; the put paged its first line out: page back
  1E47'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1E4A'   CD 0000*              	CALL	GOTO
  1E4D'   CD 09AE'              	CALL	GLSTAL
  1E50'   CD 12F3'              	CALL	GPLACE
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E53'   C3 0844'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1E56'                         VP_BEL:
  1E56'   CD 0732'              	CALL	GETCNT		; the count is spent either way
  1E59'   0E 07                 	MVI	C,BEL
  1E5B'   CD 0000*              	CALL	BCONOU
  1E5E'   C3 0807'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1E61'                         VIREP:
  1E61'   79                    	MOV	A,C
  1E62'   FE 1B                 	CPI	ESC
  1E64'   CA 1FB3'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1E67'   FE 0D                 	CPI	CR
  1E69'   CA 1EDC'              	JZ	VP_CR
  1E6C'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1E6E'   CA 1EDC'              	JZ	VP_CR
  1E71'   FE 08                 	CPI	BS
  1E73'   CA 1EE8'              	JZ	VP_BS
  1E76'   FE 7F                 	CPI	DEL
  1E78'   CA 1EE8'              	JZ	VP_BS
  1E7B'   32 2E34'              	STA	VRCH		; the calls below do not preserve C
  1E7E'   CD 080D'              	CALL	SETLIN		; this row changed
  1E81'   CD 0174'              	CALL	MARKMOD
  1E84'   CD 1925'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1E87'   CA 1EC7'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1E8A'   CD 0719'              	CALL	CURCHR
  1E8D'   06 01                 	MVI	B,1
  1E8F'   CD 0813'              	CALL	SETCEL
  1E92'   3A 2E34'              	LDA	VRCH
  1E95'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1E98'   2A 2E35'              	LHLD	RPDEL
  1E9B'   7C                    	MOV	A,H
  1E9C'   B5                    	ORA	L
  1E9D'   CA 1EB3'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1EA0'   2A 0000*              	LHLD	GAPEND
  1EA3'   EB                    	XCHG
  1EA4'   2A 2E39'              	LHLD	RPGE
  1EA7'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1EAA'   CA 1EB3'              	JZ	VP_OVW
  1EAD'   21 0000               	LXI	H,0
  1EB0'   22 2E35'              	SHLD	RPDEL		; the text moved: those originals are gone
  1EB3'                         VP_OVW:
  1EB3'   21 0001               	LXI	H,1
  1EB6'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1EB9'   2A 0000*              	LHLD	GAPEND
  1EBC'   22 2E39'              	SHLD	RPGE
  1EBF'   2A 2E35'              	LHLD	RPDEL
  1EC2'   23                    	INX	H
  1EC3'   22 2E35'              	SHLD	RPDEL
  1EC6'   C9                    	RET
  1EC7'                         VP_APP:
  1EC7'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1EC9'   06 01                 	MVI	B,1
  1ECB'   CD 0813'              	CALL	SETCEL
  1ECE'   3A 2E34'              	LDA	VRCH
  1ED1'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1ED4'   2A 2E37'              	LHLD	RPAPP
  1ED7'   23                    	INX	H
  1ED8'   22 2E37'              	SHLD	RPAPP
  1EDB'   C9                    	RET
  1EDC'                         VP_CR:
  1EDC'   21 0000               	LXI	H,0
  1EDF'   22 2E35'              	SHLD	RPDEL		; a line break ends what BS can put back
  1EE2'   22 2E37'              	SHLD	RPAPP
  1EE5'   C3 1F6E'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1EE8'                         VP_BS:
  1EE8'   2A 2E37'              	LHLD	RPAPP
  1EEB'   7C                    	MOV	A,H
  1EEC'   B5                    	ORA	L
  1EED'   CA 1EFA'              	JZ	VP_BSD
  1EF0'   2B                    	DCX	H
  1EF1'   22 2E37'              	SHLD	RPAPP		; an appended char: it just goes
  1EF4'   CD 080D'              	CALL	SETLIN
  1EF7'   C3 0000*              	JMP	DELPRV
  1EFA'                         VP_BSD:
  1EFA'   2A 2E35'              	LHLD	RPDEL
  1EFD'   7C                    	MOV	A,H
  1EFE'   B5                    	ORA	L
  1EFF'   CA 1F26'              	JZ	VP_BSM		; nothing of ours left
  1F02'   2A 0000*              	LHLD	GAPEND
  1F05'   EB                    	XCHG
  1F06'   2A 2E39'              	LHLD	RPGE
  1F09'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1F0C'   C2 1F26'              	JNZ	VP_BSM
  1F0F'   2A 2E35'              	LHLD	RPDEL
  1F12'   2B                    	DCX	H
  1F13'   22 2E35'              	SHLD	RPDEL
  1F16'   CD 080D'              	CALL	SETLIN
  1F19'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1F1C'   CD 0000*              	CALL	UNDELF		; the original comes back
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F1F'   2A 0000*              	LHLD	GAPEND
  1F22'   22 2E39'              	SHLD	RPGE
  1F25'   C9                    	RET
  1F26'                         VP_BSM:
  1F26'   CD 0807'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1F29'   C3 0891'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1F2C'                         VIINS:
  1F2C'   79                    	MOV	A,C
  1F2D'   FE 1B                 	CPI	ESC
  1F2F'   CA 1FB3'              	JZ	VI_ESC
  1F32'   FE 0D                 	CPI	CR
  1F34'   CA 1F6E'              	JZ	VI_CR
  1F37'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1F39'   CA 1F6E'              	JZ	VI_CR
  1F3C'   FE 08                 	CPI	BS
  1F3E'   CA 1F86'              	JZ	VI_BS
  1F41'   FE 7F                 	CPI	DEL
  1F43'   CA 1F86'              	JZ	VI_BS
  1F46'   79                    	MOV	A,C
  1F47'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1F4A'   CD 0174'              	CALL	MARKMOD
  1F4D'   CD 080D'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1F50'   79                    	MOV	A,C
  1F51'   FE 20                 	CPI	' '
  1F53'   D8                    	RC			; control char -> keep R_LINE
  1F54'   FE 7F                 	CPI	DEL
  1F56'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1F57'   CD 084A'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1F5A'   B7                    	ORA	A
  1F5B'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1F5C'   3E 04                 	MVI	A,R_ICH
  1F5E'   32 2DE0'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1F61'   CD 1925'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1F64'   3E 00                 	MVI	A,0
  1F66'   C2 1F6A'              	JNZ	VI_ICH
  1F69'   3C                    	INR	A
  1F6A'                         VI_ICH:
  1F6A'   32 2DE2'              	STA	ICHAPP
  1F6D'   C9                    	RET
  1F6E'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F6E'   CD 1925'              	CALL	ATCEND
  1F71'   3E 00                 	MVI	A,0
  1F73'   CA 1F77'              	JZ	VI_CRS
  1F76'   3C                    	INR	A
  1F77'                         VI_CRS:
  1F77'   F5                    	PUSH	PSW
  1F78'   CD 1932'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1F7B'   CD 193F'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1F7E'   CD 082F'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1F81'   F1                    	POP	PSW
  1F82'   32 2DE5'              	STA	ILABOV
  1F85'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1F86'                         VI_BS:
  1F86'   CD 0000*              	CALL	PEEKL
  1F89'   D8                    	RC			; start of the file: nothing to delete
  1F8A'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1F8C'   CA 1FAD'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1F8F'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  1F90'   CD 080D'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  1F93'   78                    	MOV	A,B
  1F94'   CD 0828'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  1F97'   D2 1FAD'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  1F9A'   CD 084A'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  1F9D'   B7                    	ORA	A		;   cursor)
  1F9E'   C2 1FAD'              	JNZ	VI_BSJ
  1FA1'   3C                    	INR	A
  1FA2'   32 2DE3'              	STA	DCHN
  1FA5'   32 2DE4'              	STA	DCHBS
  1FA8'   3E 07                 	MVI	A,R_DCH
  1FAA'   32 2DE0'              	STA	RINTENT
  1FAD'                         VI_BSJ:
  1FAD'   CD 0174'              	CALL	MARKMOD
  1FB0'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1FB3'                         VI_ESC:
  1FB3'   3E 00                 	MVI	A,EM_CMD
  1FB5'   32 2DDB'              	STA	EDMODE
  1FB8'   CD 0807'              	CALL	SETMOV
  1FBB'   CD 0891'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1FBE'   C3 09AE'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1FC1'                         RDLINE:
  1FC1'   EB                    	XCHG			; HL = buffer
  1FC2'   22 2E3B'              	SHLD	RLPTR
  1FC5'   3E 00                 	MVI	A,0
  1FC7'   32 2E3D'              	STA	RLLEN
  1FCA'   78                    	MOV	A,B
  1FCB'   32 2E3E'              	STA	RLMAX
  1FCE'   79                    	MOV	A,C
  1FCF'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1FD2'                         RL_LP:
  1FD2'   CD 0000*              	CALL	GETKEY
  1FD5'   FE 1B                 	CPI	ESC
  1FD7'   CA 2027'              	JZ	RL_CAN
  1FDA'   FE 0D                 	CPI	CR
  1FDC'   CA 2032'              	JZ	RL_DONE
  1FDF'   FE 08                 	CPI	BS
  1FE1'   CA 200F'              	JZ	RL_BS
  1FE4'   FE 7F                 	CPI	DEL
  1FE6'   CA 200F'              	JZ	RL_BS
  1FE9'   FE 20                 	CPI	' '
  1FEB'   DA 1FD2'              	JC	RL_LP		; control char -> ignore
  1FEE'   3A 2E3D'              	LDA	RLLEN
  1FF1'   47                    	MOV	B,A
  1FF2'   3A 2E3E'              	LDA	RLMAX
  1FF5'   B8                    	CMP	B
  1FF6'   CA 1FD2'              	JZ	RL_LP		; full -> ignore
  1FF9'   2A 2E3B'              	LHLD	RLPTR
  1FFC'   71                    	MOV	M,C
  1FFD'   23                    	INX	H
  1FFE'   22 2E3B'              	SHLD	RLPTR
  2001'   3A 2E3D'              	LDA	RLLEN
  2004'   3C                    	INR	A
  2005'   32 2E3D'              	STA	RLLEN
  2008'   79                    	MOV	A,C
  2009'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  200C'   C3 1FD2'              	JMP	RL_LP
  200F'                         RL_BS:				; WM LINEPOP
  200F'   3A 2E3D'              	LDA	RLLEN
  2012'   B7                    	ORA	A
  2013'   CA 2027'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  2016'   3D                    	DCR	A
  2017'   32 2E3D'              	STA	RLLEN
  201A'   2A 2E3B'              	LHLD	RLPTR
  201D'   2B                    	DCX	H
  201E'   22 2E3B'              	SHLD	RLPTR
  2021'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  2024'   C3 1FD2'              	JMP	RL_LP
  2027'                         RL_CAN:
  2027'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2029'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  202C'   CD 080D'              	CALL	SETLIN		; redraw one row
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  202F'   3E FF                 	MVI	A,0FFH		; cancelled
  2031'   C9                    	RET
  2032'                         RL_DONE:
  2032'   AF                    	XRA	A
  2033'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2034'                         VC_BZ:
  2034'   CD 0807'              	CALL	SETMOV
  2037'   3A 2E11'              	LDA	GSAVE
  203A'   FE 02                 	CPI	PZ
  203C'   CA 2047'              	JZ	VZ_ZZ
  203F'   B7                    	ORA	A
  2040'   C0                    	RNZ			; 'g' was pending: vim drops both
  2041'   3E 02                 	MVI	A,PZ
  2043'   32 2E10'              	STA	GPEND
  2046'   C9                    	RET
  2047'                         VZ_ZZ:
  2047'   3E 04                 	MVI	A,EO_X
  2049'   32 2E3F'              	STA	EXOP
  204C'   3E 01                 	MVI	A,1
  204E'   32 2E52'              	STA	EXBANG		; no '!'
  2051'   AF                    	XRA	A
  2052'   32 2E40'              	STA	EXARG		; no file name
  2055'   3A 2DDF'              	LDA	MODF		; as ':x': a changed text is written first
  2058'   B7                    	ORA	A
  2059'   CA 219A'              	JZ	EX_Q
  205C'   C3 2134'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  205F'                         VC_EX:
  205F'   CD 0732'              	CALL	GETCNT
  2062'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  2065'   11 0000*              	LXI	D,EXBUF
  2068'   06 28                 	MVI	B,EXMAX
  206A'   0E 3A                 	MVI	C,':'
  206C'   CD 1FC1'              	CALL	RDLINE
  206F'   B7                    	ORA	A
  2070'   C0                    	RNZ			; cancelled
  2071'   3A 2E3D'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2074'   5F                    	MOV	E,A
  2075'   16 00                 	MVI	D,0
  2077'   21 0000*              	LXI	H,EXBUF
  207A'   19                    	DAD	D
  207B'   36 00                 	MVI	M,0		; the line ends with a 0
  207D'   21 0000*              	LXI	H,EXBUF
  2080'   CD 264C'              	CALL	SKIPB
  2083'   C8                    	RZ			; nothing on it
  2084'   22 2E42'              	SHLD	EXCMD
  2087'   CD 2850'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  208A'   CD 264C'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  208D'   56                    	MOV	D,M
  208E'   23                    	INX	H
  208F'   1E 00                 	MVI	E,0
  2091'   CD 2658'              	CALL	ISLOW
  2094'   DA 209F'              	JC	EX_LK
  2097'   5F                    	MOV	E,A
  2098'   23                    	INX	H
  2099'   CD 2658'              	CALL	ISLOW
  209C'   D2 20B8'              	JNC	EX_NOT		; a third letter: none of ours
  209F'                         EX_LK:
  209F'   E5                    	PUSH	H
  20A0'   21 2837'              	LXI	H,EXTAB
  20A3'                         EX_TL:
  20A3'   7E                    	MOV	A,M
  20A4'   B7                    	ORA	A
  20A5'   CA 20B7'              	JZ	EX_NTP		; not in the table
  20A8'   23                    	INX	H
  20A9'   BA                    	CMP	D
  20AA'   7E                    	MOV	A,M
  20AB'   23                    	INX	H
  20AC'   C2 20B3'              	JNZ	EX_TN
  20AF'   BB                    	CMP	E
  20B0'   CA 20BE'              	JZ	EX_TF
  20B3'                         EX_TN:
  20B3'   23                    	INX	H
  20B4'   C3 20A3'              	JMP	EX_TL
  20B7'                         EX_NTP:
  20B7'   E1                    	POP	H
  20B8'                         EX_NOT:
  20B8'   21 2710'              	LXI	H,SNOT
  20BB'   C3 268D'              	JMP	EXERT
  20BE'                         EX_TF:
  20BE'   7E                    	MOV	A,M
  20BF'   32 2E3F'              	STA	EXOP
  20C2'   E1                    	POP	H
  20C3'   FE 06                 	CPI	EO_S
  20C5'   CA 28BF'              	JZ	EX_S		; ':s' reads the rest of the line itself
  20C8'   FE 01                 	CPI	EO_W
  20CA'   CA 20D9'              	JZ	EX_RG		; ':N,Mw name' takes a range
  20CD'   FE 08                 	CPI	EO_R
  20CF'   CA 20D9'              	JZ	EX_RG		; ... and ':Nr name' a line
  20D2'   3A 2E9B'              	LDA	SRNGF
  20D5'   B7                    	ORA	A
  20D6'   C2 20B8'              	JNZ	EX_NOT		; a range on a command that does not take one
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20D9'                         EX_RG:
                                	;--- '!', then the file name ---
  20D9'   7E                    	MOV	A,M
  20DA'   D6 21                 	SUI	'!'
  20DC'   32 2E52'              	STA	EXBANG		; 0 = '!'
  20DF'   C2 20E3'              	JNZ	EX_NB
  20E2'   23                    	INX	H
  20E3'                         EX_NB:
  20E3'   CD 264C'              	CALL	SKIPB
  20E6'   32 2E40'              	STA	EXARG		; 0 = no file name
  20E9'   CA 2102'              	JZ	EX_RUN
  20EC'   22 2E42'              	SHLD	EXCMD
  20EF'   3A 2E3F'              	LDA	EXOP
  20F2'   FE 02                 	CPI	EO_Q
  20F4'   CA 268A'              	JZ	EX_TRL		; :q takes none
  20F7'   FE 07                 	CPI	EO_V
  20F9'   CA 268A'              	JZ	EX_TRL		; nor :ve
  20FC'   CD 25B6'              	CALL	PARSFN
  20FF'   C2 267E'              	JNZ	EX_INV
  2102'                         EX_RUN:
  2102'   3A 2E3F'              	LDA	EXOP
  2105'   FE 05                 	CPI	EO_E
  2107'   CA 21B1'              	JZ	EX_E
  210A'   FE 02                 	CPI	EO_Q
  210C'   CA 219A'              	JZ	EX_Q
  210F'   FE 07                 	CPI	EO_V
  2111'   CA 2684'              	JZ	EX_V
  2114'   FE 08                 	CPI	EO_R
  2116'   CA 2342'              	JZ	EX_R
  2119'   FE 04                 	CPI	EO_X
  211B'   CA 212D'              	JZ	EX_XM
  211E'   FE 01                 	CPI	EO_W
  2120'   C2 2134'              	JNZ	EX_W		; :wq
  2123'   3A 2E9B'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2126'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2127'   C2 2262'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  212A'   C3 2134'              	JMP	EX_W
  212D'                         EX_XM:
  212D'   3A 2DDF'              	LDA	MODF		; :x writes only a changed text
  2130'   B7                    	ORA	A
  2131'   CA 219A'              	JZ	EX_Q
  2134'                         EX_W:
  2134'   CD 2422'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2137'   D8                    	RC			; refused (message shown)
  2138'   32 2E41'              	STA	EXBAK
  213B'   3A 2E3F'              	LDA	EXOP
  213E'   FE 01                 	CPI	EO_W
  2140'   CA 2157'              	JZ	EX_WK
  2143'   3A 2E41'              	LDA	EXBAK
  2146'   B7                    	ORA	A
  2147'   C2 2197'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  214A'   3A 2E52'              	LDA	EXBANG
  214D'   B7                    	ORA	A
  214E'   CA 2197'              	JZ	EX_WQ		; so it does with '!'
  2151'   CD 2157'              	CALL	EX_WK		; else it may not: keep the text
  2154'   C3 219A'              	JMP	EX_Q
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                ;EX_WK -- write, then keep editing where the cursor was.
  2157'                         EX_WK:
  2157'   CD 0DC9'              	CALL	CURRW		; the cursor's row and file position
  215A'   32 2E44'              	STA	WPROW
  215D'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2160'   7D                    	MOV	A,L
  2161'   E6 7F                 	ANI	7FH
  2163'   32 2E45'              	STA	WPBYT
  2166'   7D                    	MOV	A,L
  2167'   17                    	RAL
  2168'   7C                    	MOV	A,H
  2169'   17                    	RAL
  216A'   5F                    	MOV	E,A
  216B'   3E 00                 	MVI	A,0
  216D'   17                    	RAL
  216E'   57                    	MOV	D,A		; DE = HL / 128
  216F'   2A 0000*              	LHLD	OUTPOS
  2172'   19                    	DAD	D
  2173'   22 2E46'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2176'   CD 2457'              	CALL	WRITE
  2179'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  217C'   2A 2E46'              	LHLD	WPREC
  217F'   EB                    	XCHG
  2180'   3A 2E45'              	LDA	WPBYT
  2183'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2186'   CD 0000*              	CALL	GOTO
  2189'                         EX_WRW:
  2189'   21 0000               	LXI	H,0
  218C'   22 0000*              	SHLD	LNDLT
  218F'   3A 2E44'              	LDA	WPROW
  2192'   6F                    	MOV	L,A
  2193'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2196'   C9                    	RET
  2197'                         EX_WQ:
  2197'   CD 2457'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  219A'                         EX_Q:
  219A'   3A 2E52'              	LDA	EXBANG
  219D'   B7                    	ORA	A
  219E'   CA 21A8'              	JZ	EX_QT
  21A1'   3A 2DDF'              	LDA	MODF
  21A4'   B7                    	ORA	A
  21A5'   C2 2672'              	JNZ	MSGNWR		; changed, no '!': stay
  21A8'                         EX_QT:
  21A8'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  21AB'   3E 01                 	MVI	A,1
  21AD'   32 2DDE'              	STA	QUITF
  21B0'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  21B1'                         EX_E:
  21B1'   3A 2E52'              	LDA	EXBANG
  21B4'   B7                    	ORA	A
  21B5'   CA 21BF'              	JZ	EE_GO
  21B8'   3A 2DDF'              	LDA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21BB'   B7                    	ORA	A
  21BC'   C2 2672'              	JNZ	MSGNWR
  21BF'                         EE_GO:
  21BF'   3A 2E40'              	LDA	EXARG
  21C2'   B7                    	ORA	A
  21C3'   C2 21CA'              	JNZ	EE_ARG
  21C6'   CD 2493'              	CALL	OWNTF		; no name: the buffer's own
  21C9'   D8                    	RC
  21CA'                         EE_ARG:
  21CA'   CD 24A9'              	CALL	ISOWN
  21CD'   21 0001               	LXI	H,1
  21D0'   C2 21D7'              	JNZ	EE_LD		; another file: its first line
  21D3'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  21D6'   23                    	INX	H		; HL = the cursor's line
  21D7'                         EE_LD:
  21D7'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  21D9'   32 2E50'              	STA	MSGWHT
  21DC'   E5                    	PUSH	H
  21DD'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  21E0'   21 0000*              	LXI	H,TFCB
  21E3'   11 0000*              	LXI	D,FNAME
  21E6'   CD 24BB'              	CALL	COPY12		; the buffer's name
  21E9'   CD 2480'              	CALL	SRCTF
  21EC'   CD 0000*              	CALL	REOPEN
  21EF'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  21F2'   AF                    	XRA	A
  21F3'   32 2DDF'              	STA	MODF
  21F6'   E1                    	POP	H
  21F7'   2B                    	DCX	H
  21F8'   AF                    	XRA	A
  21F9'   CD 0000*              	CALL	MVLIND		; down to the line
  21FC'   CD 0AE5'              	CALL	ATEOF
  21FF'   DC 0AEB'              	CC	LASTLN		; past the last line: onto it
  2202'   CD 12B5'              	CALL	ZSAVE
  2205'   C3 138A'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2208'                         TFDOS:
  2208'   C5                    	PUSH	B
  2209'   11 0080               	LXI	D,CMDTAIL
  220C'   0E 1A                 	MVI	C,1AH		; set the DMA
  220E'   CD 0005               	CALL	BDOS
  2211'   C1                    	POP	B
  2212'   11 0000*              	LXI	D,TFCB
  2215'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2218'                         EXRNG:
  2218'   2A 2E9C'              	LHLD	SRNG1
  221B'   7C                    	MOV	A,H
  221C'   B5                    	ORA	L
  221D'   37                    	STC
  221E'   C8                    	RZ
  221F'   2A 2E9E'              	LHLD	SRNG2
  2222'   EB                    	XCHG
  2223'   2A 2E9C'              	LHLD	SRNG1
  2226'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2229'   D8                    	RC
  222A'   EB                    	XCHG			; HL = the last line, DE = the first
  222B'   CD 0000*              	CALL	SUBHD
  222E'   23                    	INX	H
  222F'   22 2EA6'              	SHLD	SLINES
  2232'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2233'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2234'                         GOLNX:
  2234'   E5                    	PUSH	H
  2235'   CD 1249'              	CALL	GOLN
  2238'   CD 0000*              	CALL	CNTLF
  223B'   23                    	INX	H		; the line the cursor came to rest on
  223C'   D1                    	POP	D
  223D'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2240'                         EXSAVP:
  2240'   CD 0DC9'              	CALL	CURRW
  2243'   32 2E44'              	STA	WPROW
  2246'   21 2E7D'              	LXI	H,MKPOS
  2249'   C3 0429'              	JMP	FPSTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  224C'                         EXRSTP:
  224C'   CD 0000*              	CALL	CLRCNT
  224F'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2252'   CD 0000*              	CALL	GOTO
  2255'   C3 2189'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2258'                         PUTBRK:
  2258'   3E 0D                 	MVI	A,CR
  225A'   CD 0000*              	CALL	PUTGAP
  225D'   3E 0A                 	MVI	A,LF
  225F'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2262'                         EX_WR:
  2262'   3A 2E40'              	LDA	EXARG
  2265'   B7                    	ORA	A
  2266'   CA 2660'              	JZ	MSGNFN		; No file name
  2269'   CD 24A9'              	CALL	ISOWN
  226C'   CA 230C'              	JZ	EXW_OW
  226F'   CD 0000*              	CALL	TEXIST
  2272'   32 2EA9'              	STA	RWERR		; nonzero: a file of that name is there
  2275'   CA 227F'              	JZ	EXW_GO
  2278'   3A 2E52'              	LDA	EXBANG
  227B'   B7                    	ORA	A
  227C'   C2 2666'              	JNZ	MSGEXI		; File exists (! to force)
  227F'                         EXW_GO:
  227F'   CD 2218'              	CALL	EXRNG
  2282'   DA 2306'              	JC	EXW_BD
  2285'   CD 2240'              	CALL	EXSAVP
  2288'   2A 2E9C'              	LHLD	SRNG1
  228B'   CD 2234'              	CALL	GOLNX
  228E'   C2 2303'              	JNZ	EXW_NL		; the text has no line N
  2291'   3A 2EA9'              	LDA	RWERR		; a delete scans the whole directory, there or
  2294'   B7                    	ORA	A		;   not: only when TEXIST found one
  2295'   0E 13                 	MVI	C,13H
  2297'   C4 2208'              	CNZ	TFDOS		; delete what is there
  229A'   0E 16                 	MVI	C,16H
  229C'   CD 2208'              	CALL	TFDOS		; ... and make it
  229F'   3C                    	INR	A
  22A0'   CA 22F5'              	JZ	EXW_FL		; no directory entry left
  22A3'   3E 80                 	MVI	A,80H
  22A5'   32 2EA8'              	STA	RWPTR
  22A8'   AF                    	XRA	A
  22A9'   32 2EA9'              	STA	RWERR
  22AC'   2A 2EA6'              	LHLD	SLINES
  22AF'   CD 0000*              	CALL	SETC0		; that many lines, forward
  22B2'                         EXW_LP:
  22B2'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  22B5'   E5                    	PUSH	H
  22B6'   EB                    	XCHG
  22B7'   2A 0000*              	LHLD	GAPEND
  22BA'   CD 2312'              	CALL	RWOUT		; the text from the cursor to there
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22BD'   E1                    	POP	H
  22BE'   3A 2EA9'              	LDA	RWERR
  22C1'   B7                    	ORA	A
  22C2'   C2 22DE'              	JNZ	EXW_EN
  22C5'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  22C8'   CD 0747'              	CALL	CNTTST
  22CB'   C2 22B2'              	JNZ	EXW_LP
  22CE'                         EXW_PD:				; the last record is padded out with ^Z
  22CE'   3A 2EA8'              	LDA	RWPTR
  22D1'   FE 80                 	CPI	80H
  22D3'   CA 22DE'              	JZ	EXW_EN
  22D6'   3E 1A                 	MVI	A,CPMEOF
  22D8'   CD 231E'              	CALL	RWPUT
  22DB'   C3 22CE'              	JMP	EXW_PD
  22DE'                         EXW_EN:
  22DE'   0E 10                 	MVI	C,10H
  22E0'   CD 2208'              	CALL	TFDOS		; close
  22E3'   3A 2EA9'              	LDA	RWERR
  22E6'   B7                    	ORA	A
  22E7'   C2 22F5'              	JNZ	EXW_FL
  22EA'   CD 224C'              	CALL	EXRSTP
  22ED'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  22EF'   32 2E50'              	STA	MSGWHT
  22F2'   C3 0807'              	JMP	SETMOV		; nothing on the screen has changed
  22F5'                         EXW_FL:				; no room: the part written is not left behind
  22F5'   0E 13                 	MVI	C,13H
  22F7'   CD 2208'              	CALL	TFDOS
  22FA'   CD 224C'              	CALL	EXRSTP
  22FD'   21 282D'              	LXI	H,SDFUL
  2300'   C3 2698'              	JMP	EXERR
  2303'                         EXW_NL:
  2303'   CD 224C'              	CALL	EXRSTP
  2306'                         EXW_BD:
  2306'   21 281F'              	LXI	H,SRNGE
  2309'   C3 2698'              	JMP	EXERR
  230C'                         EXW_OW:
  230C'   21 26C7'              	LXI	H,SEXI
  230F'   C3 2698'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2312'                         RWOUT:
  2312'   CD 0000*              	CALL	CMP16
  2315'   C8                    	RZ
  2316'   7E                    	MOV	A,M
  2317'   23                    	INX	H
  2318'   CD 231E'              	CALL	RWPUT
  231B'   C3 2312'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  231E'                         RWPUT:
  231E'   E5                    	PUSH	H
  231F'   F5                    	PUSH	PSW
  2320'   3A 2EA8'              	LDA	RWPTR
  2323'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2324'   26 00                 	MVI	H,0
  2326'   F1                    	POP	PSW
  2327'   77                    	MOV	M,A
  2328'   2C                    	INR	L		; Z: that was the record's last byte
  2329'   7D                    	MOV	A,L
  232A'   C2 233D'              	JNZ	RWP_ST
  232D'   D5                    	PUSH	D
  232E'   0E 15                 	MVI	C,15H
  2330'   CD 2208'              	CALL	TFDOS		; write it
  2333'   D1                    	POP	D
  2334'   B7                    	ORA	A
  2335'   CA 233B'              	JZ	RWP_OK
  2338'   32 2EA9'              	STA	RWERR
  233B'                         RWP_OK:
  233B'   3E 80                 	MVI	A,80H
  233D'                         RWP_ST:
  233D'   32 2EA8'              	STA	RWPTR
  2340'   E1                    	POP	H
  2341'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2342'                         EX_R:
  2342'   3A 2E40'              	LDA	EXARG
  2345'   B7                    	ORA	A
  2346'   CA 2660'              	JZ	MSGNFN		; No file name
  2349'   0E 0F                 	MVI	C,0FH
  234B'   CD 2208'              	CALL	TFDOS		; open
  234E'   3C                    	INR	A
  234F'   CA 241C'              	JZ	ER_NOF
  2352'   CD 12DB'              	CALL	GZONE		; the screen's top line, before anything moves
  2355'   CD 2240'              	CALL	EXSAVP
  2358'   3A 2E9B'              	LDA	SRNGF
  235B'   B7                    	ORA	A
  235C'   CA 2375'              	JZ	ER_NXT		; no line given: below the cursor's
  235F'   2A 2E9E'              	LHLD	SRNG2
  2362'   7C                    	MOV	A,H
  2363'   B5                    	ORA	L
  2364'   C2 236F'              	JNZ	ER_LN
  2367'   23                    	INX	H
  2368'   CD 1249'              	CALL	GOLN		; ':0r': above line 1 ...
  236B'   AF                    	XRA	A		;   which never wants a line end put in first
  236C'   C3 2397'              	JMP	ER_BRK
  236F'                         ER_LN:
  236F'   CD 2234'              	CALL	GOLNX
  2372'   C2 2303'              	JNZ	EXW_NL		; the text has no line N
  2375'                         ER_NXT:
  2375'   21 0001               	LXI	H,1
  2378'   AF                    	XRA	A
  2379'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                	;    empty buffer still has its one empty line, and the text goes below it
  237C'   CD 0AE5'              	CALL	ATEOF
  237F'   3E 00                 	MVI	A,0
  2381'   D2 2397'              	JNC	ER_BRK		; text follows
  2384'   2A 0000*              	LHLD	GAPBEG
  2387'   EB                    	XCHG
  2388'   2A 0000*              	LHLD	TXTBEG
  238B'   CD 0000*              	CALL	CMP16
  238E'   3E 01                 	MVI	A,1
  2390'   CA 2397'              	JZ	ER_BRK		; nothing before the cursor either
  2393'   1B                    	DCX	D
  2394'   1A                    	LDAX	D
  2395'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2397'                         ER_BRK:
  2397'   32 2EAB'              	STA	RDBRK
  239A'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  239D'   AF                    	XRA	A
  239E'   32 2EAA'              	STA	RDANY
  23A1'                         ER_LP:
  23A1'   0E 14                 	MVI	C,14H
  23A3'   CD 2208'              	CALL	TFDOS		; the next record
  23A6'   B7                    	ORA	A
  23A7'   C2 23DA'              	JNZ	ER_END
  23AA'   21 0080               	LXI	H,CMDTAIL
  23AD'   0E 00                 	MVI	C,0
  23AF'                         ER_SC:				; C = its bytes, up to a ^Z
  23AF'   7E                    	MOV	A,M
  23B0'   FE 1A                 	CPI	CPMEOF
  23B2'   CA 23BA'              	JZ	ER_GOT
  23B5'   23                    	INX	H
  23B6'   0C                    	INR	C
  23B7'   F2 23AF'              	JP	ER_SC		; (minus: all 128)
  23BA'                         ER_GOT:
  23BA'   79                    	MOV	A,C
  23BB'   B7                    	ORA	A
  23BC'   CA 23DA'              	JZ	ER_END
  23BF'   C5                    	PUSH	B
  23C0'   3A 2EAA'              	LDA	RDANY
  23C3'   B7                    	ORA	A
  23C4'   CC 240B'              	CZ	ER_1ST
  23C7'   C1                    	POP	B
  23C8'   06 00                 	MVI	B,0
  23CA'   11 0080               	LXI	D,CMDTAIL
  23CD'   C5                    	PUSH	B
  23CE'   CD 0000*              	CALL	INSBLK
  23D1'   C1                    	POP	B
  23D2'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  23D5'   79                    	MOV	A,C
  23D6'   17                    	RAL
  23D7'   DA 23A1'              	JC	ER_LP		; a full record: there may be more
  23DA'                         ER_END:
  23DA'   3A 2EAA'              	LDA	RDANY
  23DD'   B7                    	ORA	A
  23DE'   CA 23FC'              	JZ	ER_PL		; nothing in the file: nothing has changed
  23E1'   CD 0AE5'              	CALL	ATEOF
  23E4'   DA 23F1'              	JC	ER_MD		; the text now ends as the file read ends
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23E7'   2A 0000*              	LHLD	GAPBEG
  23EA'   2B                    	DCX	H
  23EB'   7E                    	MOV	A,M
  23EC'   FE 0A                 	CPI	LF
  23EE'   C4 2258'              	CNZ	PUTBRK		; text follows: what was read ends a line
  23F1'                         ER_MD:
  23F1'   3E 01                 	MVI	A,1
  23F3'   32 2DDF'              	STA	MODF
  23F6'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  23F9'   CD 0000*              	CALL	GOTO
  23FC'                         ER_PL:
  23FC'   CD 0AE5'              	CALL	ATEOF
  23FF'   DC 0AEB'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2402'   CD 0000*              	CALL	CLRCNT
  2405'   CD 12F3'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2408'   C3 0844'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  240B'                         ER_1ST:
  240B'   3C                    	INR	A
  240C'   32 2EAA'              	STA	RDANY
  240F'   3A 2EAB'              	LDA	RDBRK
  2412'   B7                    	ORA	A
  2413'   C4 2258'              	CNZ	PUTBRK
  2416'   21 2E7D'              	LXI	H,MKPOS
  2419'   C3 0429'              	JMP	FPSTO
  241C'                         ER_NOF:
  241C'   21 280E'              	LXI	H,SNOPN
  241F'   C3 268D'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2422'                         WRCHK:
  2422'   3A 2E40'              	LDA	EXARG
  2425'   B7                    	ORA	A
  2426'   C2 2430'              	JNZ	WC_ARG
  2429'   CD 2493'              	CALL	OWNTF
  242C'   D8                    	RC
  242D'   C3 2445'              	JMP	WC_OWN
  2430'                         WC_ARG:
  2430'   CD 24A9'              	CALL	ISOWN
  2433'   CA 2445'              	JZ	WC_OWN
  2436'   3A 2E52'              	LDA	EXBANG
  2439'   B7                    	ORA	A
  243A'   CA 2443'              	JZ	WC_OTH
  243D'   CD 0000*              	CALL	TEXIST
  2440'   C2 2666'              	JNZ	MSGEXI		; File exists (! to force)
  2443'                         WC_OTH:
  2443'   AF                    	XRA	A		; (NC)
  2444'   C9                    	RET
  2445'                         WC_OWN:
  2445'   3A 2E53'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2448'   B7                    	ORA	A
  2449'   CA 2453'              	JZ	WC_OK
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  244C'   3A 2E52'              	LDA	EXBANG
  244F'   B7                    	ORA	A
  2450'   C2 266C'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2453'                         WC_OK:
  2453'   3E 01                 	MVI	A,1
  2455'   B7                    	ORA	A		; (NC)
  2456'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2457'                         WRITE:
  2457'   3A 2E41'              	LDA	EXBAK
  245A'   CD 0000*              	CALL	WRTO
  245D'   3A 0001*              	LDA	FNAME+1
  2460'   FE 20                 	CPI	' '
  2462'   C2 246E'              	JNZ	WR_HAS
  2465'   21 0000*              	LXI	H,TFCB
  2468'   11 0000*              	LXI	D,FNAME
  246B'   CD 24BB'              	CALL	COPY12
  246E'                         WR_HAS:
  246E'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2470'   32 2E50'              	STA	MSGWHT
  2473'   CD 24A9'              	CALL	ISOWN
  2476'   C2 2480'              	JNZ	SRCTF
  2479'   AF                    	XRA	A
  247A'   32 2DDF'              	STA	MODF
  247D'   32 2E51'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2480'                         SRCTF:
  2480'   21 0000*              	LXI	H,TFCB
  2483'   11 005C               	LXI	D,DFTFCB
  2486'   CD 24BB'              	CALL	COPY12
  2489'   AF                    	XRA	A
  248A'   06 04                 	MVI	B,4
  248C'                         SRC_Z:
  248C'   12                    	STAX	D		; extent, s1, s2, record count: 0
  248D'   13                    	INX	D
  248E'   05                    	DCR	B
  248F'   C2 248C'              	JNZ	SRC_Z
  2492'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2493'                         OWNTF:
  2493'   3A 0001*              	LDA	FNAME+1
  2496'   FE 20                 	CPI	' '
  2498'   CA 2660'              	JZ	MSGNFN
  249B'   CD 24C6'              	CALL	TFCLR
  249E'   21 0000*              	LXI	H,FNAME
  24A1'   11 0000*              	LXI	D,TFCB
  24A4'   CD 24BB'              	CALL	COPY12
  24A7'   B7                    	ORA	A		; (NC)
  24A8'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  24A9'                         ISOWN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24A9'   21 0000*              	LXI	H,TFCB
  24AC'   11 0000*              	LXI	D,FNAME
  24AF'   06 0C                 	MVI	B,12
  24B1'                         IO_LP:
  24B1'   1A                    	LDAX	D
  24B2'   BE                    	CMP	M
  24B3'   C0                    	RNZ
  24B4'   23                    	INX	H
  24B5'   13                    	INX	D
  24B6'   05                    	DCR	B
  24B7'   C2 24B1'              	JNZ	IO_LP
  24BA'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  24BB'                         COPY12:
  24BB'   06 0C                 	MVI	B,12
  24BD'                         CP_LP:
  24BD'   7E                    	MOV	A,M
  24BE'   12                    	STAX	D
  24BF'   23                    	INX	H
  24C0'   13                    	INX	D
  24C1'   05                    	DCR	B
  24C2'   C2 24BD'              	JNZ	CP_LP
  24C5'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  24C6'                         TFCLR:
  24C6'   11 0000*              	LXI	D,TFCB
  24C9'   06 24                 	MVI	B,36
  24CB'   AF                    	XRA	A
  24CC'                         TC_LP:
  24CC'   12                    	STAX	D
  24CD'   13                    	INX	D
  24CE'   05                    	DCR	B
  24CF'   C2 24CC'              	JNZ	TC_LP
  24D2'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  24D3'                         FOPEN:
  24D3'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  24D5'   32 2E50'              	STA	MSGWHT
  24D8'   21 005C               	LXI	H,DFTFCB
  24DB'   CD 25A9'              	CALL	NRMDRV
  24DE'   11 0000*              	LXI	D,FNAME
  24E1'   CD 24BB'              	CALL	COPY12
  24E4'   CD 0000*              	CALL	OPENZ
  24E7'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  24EA'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  24EC'   C8                    	RZ
  24ED'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  24F0'   32 2E51'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  24F3'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  24F4'                         ARGSCN:
  24F4'   3A 0080               	LDA	CMDTAIL
  24F7'   47                    	MOV	B,A		; B = what is left of the line
  24F8'   B7                    	ORA	A
  24F9'   C8                    	RZ
  24FA'   21 0081               	LXI	H,CMDTAIL+1
  24FD'                         AS_TOK:				; at a token, or the blanks before one
  24FD'   7E                    	MOV	A,M
  24FE'   FE 20                 	CPI	' '
  2500'   C2 2509'              	JNZ	AS_OPT
  2503'   23                    	INX	H
  2504'   05                    	DCR	B
  2505'   C2 24FD'              	JNZ	AS_TOK
  2508'   C9                    	RET
  2509'                         AS_OPT:
  2509'   FE 2B                 	CPI	'+'
  250B'   CA 2535'              	JZ	AS_PLS
  250E'   FE 2D                 	CPI	'-'
  2510'   CA 2524'              	JZ	AS_SW
  2513'   FE 2F                 	CPI	'/'
  2515'   CA 2524'              	JZ	AS_SW
  2518'                         AS_SKP:				; not ours (the file name): on to the next one
  2518'   23                    	INX	H
  2519'   05                    	DCR	B
  251A'   C8                    	RZ
  251B'   7E                    	MOV	A,M
  251C'   FE 20                 	CPI	' '
  251E'   C2 2518'              	JNZ	AS_SKP
  2521'   C3 24FD'              	JMP	AS_TOK
  2524'                         AS_SW:
  2524'   23                    	INX	H
  2525'   05                    	DCR	B
  2526'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2527'   7E                    	MOV	A,M
  2528'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  252A'   FE 52                 	CPI	'R'
  252C'   C2 2518'              	JNZ	AS_SKP
  252F'   32 2E53'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2532'   C3 2518'              	JMP	AS_SKP
  2535'                         AS_PLS:
  2535'   3E 01                 	MVI	A,1
  2537'   32 2E54'              	STA	PLUSF		; '+' gets the line even with no number on it
  253A'   11 0000*              	LXI	D,PLUSB
  253D'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  253F'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2540'   05                    	DCR	B
  2541'   CA 2578'              	JZ	AS_PE
  2544'   7E                    	MOV	A,M
  2545'   FE 30                 	CPI	'0'
  2547'   C2 255F'              	JNZ	AS_PD
  254A'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  254A'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  254B'   05                    	DCR	B
  254C'   CA 2580'              	JZ	AS_P1
  254F'   7E                    	MOV	A,M
  2550'   FE 30                 	CPI	'0'
  2552'   CA 254A'              	JZ	AS_PZ
  2555'   FE 31                 	CPI	'1'
  2557'   DA 2580'              	JC	AS_P1		; zeros and then no digit at all: line 1
  255A'   FE 3A                 	CPI	'9'+1
  255C'   D2 2580'              	JNC	AS_P1
  255F'                         AS_PD:				; the digits, as typed
  255F'   7E                    	MOV	A,M
  2560'   FE 30                 	CPI	'0'
  2562'   DA 2578'              	JC	AS_PE
  2565'   FE 3A                 	CPI	'9'+1
  2567'   D2 2578'              	JNC	AS_PE
  256A'   79                    	MOV	A,C
  256B'   B7                    	ORA	A
  256C'   CA 2587'              	JZ	AS_POV
  256F'   0D                    	DCR	C
  2570'   7E                    	MOV	A,M
  2571'   12                    	STAX	D
  2572'   13                    	INX	D
  2573'   23                    	INX	H
  2574'   05                    	DCR	B
  2575'   C2 255F'              	JNZ	AS_PD
  2578'                         AS_PE:
  2578'   AF                    	XRA	A
  2579'   12                    	STAX	D		; the digits end with a 0
  257A'   78                    	MOV	A,B
  257B'   B7                    	ORA	A
  257C'   C8                    	RZ
  257D'   C3 24FD'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2580'                         AS_P1:
  2580'   3E 31                 	MVI	A,'1'
  2582'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2583'   13                    	INX	D
  2584'   C3 2578'              	JMP	AS_PE
  2587'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2587'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  258A'   C3 2578'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  258D'                         ARGGO:
  258D'   3A 2E54'              	LDA	PLUSF
  2590'   B7                    	ORA	A
  2591'   C8                    	RZ
  2592'   21 0000*              	LXI	H,PLUSB
  2595'                         AG_LP:
  2595'   7E                    	MOV	A,M
  2596'   B7                    	ORA	A
  2597'   CA 25A4'              	JZ	AG_G
  259A'   4F                    	MOV	C,A
  259B'   E5                    	PUSH	H
  259C'   CD 0023'              	CALL	VICMD
  259F'   E1                    	POP	H
  25A0'   23                    	INX	H
  25A1'   C3 2595'              	JMP	AG_LP
  25A4'                         AG_G:
  25A4'   0E 47                 	MVI	C,'G'
  25A6'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  25A9'                         NRMDRV:
  25A9'   7E                    	MOV	A,M
  25AA'   B7                    	ORA	A
  25AB'   C0                    	RNZ
  25AC'   E5                    	PUSH	H
  25AD'   0E 19                 	MVI	C,BF_CURDSK
  25AF'   CD 0005               	CALL	BDOS
  25B2'   E1                    	POP	H
  25B3'   3C                    	INR	A
  25B4'   77                    	MOV	M,A
  25B5'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  25B6'                         PARSFN:
  25B6'   CD 24C6'              	CALL	TFCLR
  25B9'   11 0000*              	LXI	D,TFCB
  25BC'   23                    	INX	H
  25BD'   7E                    	MOV	A,M
  25BE'   2B                    	DCX	H
  25BF'   FE 3A                 	CPI	':'
  25C1'   C2 25D3'              	JNZ	PF_NM
  25C4'   CD 2619'              	CALL	GETFNC
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25C7'   CA 25D3'              	JZ	PF_NM
  25CA'   D6 40                 	SUI	40H
  25CC'   12                    	STAX	D
  25CD'   FE 11                 	CPI	17
  25CF'   D2 25F7'              	JNC	PF_BAD
  25D2'   23                    	INX	H
  25D3'                         PF_NM:
  25D3'   13                    	INX	D
  25D4'   0E 08                 	MVI	C,8
  25D6'   CD 25FB'              	CALL	CPYNAM
  25D9'   FE 2E                 	CPI	'.'
  25DB'   0E 03                 	MVI	C,3
  25DD'   C4 260E'              	CNZ	PADFLD		; no type: blanks
  25E0'   CC 25FA'              	CZ	CPYNM0		; '.': the type
  25E3'   3A 0001*              	LDA	TFCB+1
  25E6'   FE 20                 	CPI	' '
  25E8'   CA 25F7'              	JZ	PF_BAD		; no name
  25EB'   CD 264C'              	CALL	SKIPB
  25EE'   C0                    	RNZ			; more after it
  25EF'   21 0000*              	LXI	H,TFCB
  25F2'   CD 25A9'              	CALL	NRMDRV
  25F5'   AF                    	XRA	A
  25F6'   C9                    	RET
  25F7'                         PF_BAD:
  25F7'   F6 01                 	ORI	1
  25F9'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  25FA'                         CPYNM0:
  25FA'   23                    	INX	H
  25FB'                         CPYNAM:
  25FB'   CD 2619'              	CALL	GETFNC
  25FE'   CA 260E'              	JZ	PADFLD
  2601'   12                    	STAX	D
  2602'   13                    	INX	D
  2603'   0D                    	DCR	C
  2604'   C2 25FB'              	JNZ	CPYNAM
  2607'                         CN_SKP:
  2607'   CD 2619'              	CALL	GETFNC
  260A'   C2 2607'              	JNZ	CN_SKP
  260D'   C9                    	RET
  260E'                         PADFLD:
  260E'   F5                    	PUSH	PSW
  260F'                         PD_LP:
  260F'   3E 20                 	MVI	A,' '
  2611'   12                    	STAX	D
  2612'   13                    	INX	D
  2613'   0D                    	DCR	C
  2614'   C2 260F'              	JNZ	PD_LP
  2617'   F1                    	POP	PSW
  2618'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2619'                         GETFNC:
  2619'   7E                    	MOV	A,M
  261A'   FE 3D                 	CPI	'='
  261C'   C8                    	RZ
  261D'   FE 5F                 	CPI	'_'
  261F'   C8                    	RZ
  2620'   FE 3B                 	CPI	';'
  2622'   C8                    	RZ
  2623'   FE 3C                 	CPI	'<'
  2625'   C8                    	RZ
  2626'   FE 3E                 	CPI	'>'
  2628'   C8                    	RZ
  2629'   FE 2E                 	CPI	'.'
  262B'   C8                    	RZ
  262C'   FE 3A                 	CPI	':'
  262E'   C8                    	RZ
  262F'   FE 2A                 	CPI	'*'
  2631'   C8                    	RZ
  2632'   FE 3F                 	CPI	'?'
  2634'   C8                    	RZ
  2635'   FE 20                 	CPI	' '
  2637'   DA 264A'              	JC	GF_CTL
  263A'   C8                    	RZ
  263B'   23                    	INX	H
  263C'   FE 61                 	CPI	'a'
  263E'   DA 2648'              	JC	GF_DN
