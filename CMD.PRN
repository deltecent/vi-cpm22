  0A9A'   C2 0A8B'              	JNZ	JQ_LP
  0A9D'   EB                    	XCHG			; DE = the line's start
  0A9E'   2A 0000*              	LHLD	TXTEND
  0AA1'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0AA4'   D2 0A36'              	JNC	JC_SL
  0AA7'   EB                    	XCHG
  0AA8'   CD 0000*              	CALL	PUTCUR
  0AAB'   21 0000               	LXI	H,0
  0AAE'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AB1'   2A 2F1F'              	LHLD	JKCNT
  0AB4'   22 2F23'              	SHLD	JKMOV
  0AB7'   C3 0AD8'              	JMP	JC_DN
