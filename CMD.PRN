  06EB'   7D                    	MOV	A,L
  06EC'   91                    	SUB	C
  06ED'   7C                    	MOV	A,H
  06EE'   98                    	SBB	B
  06EF'   D2 070B'              	JNC	ENL_G		; at the gap: on from its far side
  06F2'   7E                    	MOV	A,M
