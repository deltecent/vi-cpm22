  22F8'   06                    	DB	06H			; ^F -- page forward
  22F9'   0B1F'                 	DW	VC_PGDN
  22FB'   02                    	DB	02H			; ^B -- page back
  22FC'   0B4C'                 	DW	VC_PGUP
  22FE'   04                    	DB	04H			; ^D -- half page down
  22FF'   0BA0'                 	DW	VC_HFDN
  2301'   15                    	DB	15H			; ^U -- half page up
  2302'   0BD4'                 	DW	VC_HFUP
  2304'   0C                    	DB	0CH			; ^L -- redraw
  2305'   0C48'                 	DW	VC_REDR
  2307'   2E                    	DB	'.'			; '.' -- repeat the last change
  2308'   01A2'                 	DW	VC_DOT
  230A'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  230B'   0311'                 	DW	VC_UNDO
  230D'   6D                    	DB	'm'		; m{a-c} -- set a mark
  230E'   0248'                 	DW	VC_MK
  2310'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2311'   024D'                 	DW	VC_BQ
