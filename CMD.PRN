  10ED'   79                    	MOV	A,C
  10EE'   B7                    	ORA	A
  10EF'   CA 1101'              	JZ	VHD_C
  10F2'   BA                    	CMP	D
  10F3'   C2 10FE'              	JNZ	VHD_R
