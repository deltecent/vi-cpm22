  2984'   178F'                 	DW	VC_Y
  2986'   59                    	DB	'Y'
  2987'   1797'                 	DW	VY_YY
  2989'   70                    	DB	'p'
  298A'   19CD'                 	DW	VC_P
  298C'   50                    	DB	'P'
  298D'   19E2'                 	DW	VCB_P
  298F'   69                    	DB	'i'
  2990'   1513'                 	DW	VC_I
  2992'   61                    	DB	'a'
  2993'   1519'                 	DW	VC_A
  2995'   41                    	DB	'A'
  2996'   1539'                 	DW	VCB_A
