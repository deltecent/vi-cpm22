  2A51'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2A52'                         EXADDR:
  2A52'   AF                    	XRA	A
  2A53'   32 0000*              	STA	SRNGF
  2A56'   7E                    	MOV	A,M
  2A57'   FE 25                 	CPI	'%'
  2A59'   CA 2A82'              	JZ	EXA_AL
  2A5C'   EB                    	XCHG			; DE walks the line, HL takes the number
  2A5D'   CD 2A97'              	CALL	EXNUM
  2A60'   DA 2A80'              	JC	EXA_NO
  2A63'   22 0000*              	SHLD	SRNG1
  2A66'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2A69'   1A                    	LDAX	D
  2A6A'   FE 2C                 	CPI	','
  2A6C'   C2 2A79'              	JNZ	EXA_YS
  2A6F'   13                    	INX	D
  2A70'   CD 2A97'              	CALL	EXNUM
  2A73'   DA 2A80'              	JC	EXA_NO		; ',' with no number: not a range at all
  2A76'   22 0000*              	SHLD	SRNG2
  2A79'                         EXA_YS:
  2A79'   EB                    	XCHG
  2A7A'   3E 01                 	MVI	A,1
  2A7C'   32 0000*              	STA	SRNGF
  2A7F'   C9                    	RET
  2A80'                         EXA_NO:
  2A80'   EB                    	XCHG
  2A81'   C9                    	RET
  2A82'                         EXA_AL:
  2A82'   23                    	INX	H
  2A83'   E5                    	PUSH	H
  2A84'   21 0001               	LXI	H,1
  2A87'   22 0000*              	SHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2A8A'   21 FFFF               	LXI	H,0FFFFH
  2A8D'   22 0000*              	SHLD	SRNG2
  2A90'   E1                    	POP	H
  2A91'   3E 01                 	MVI	A,1
  2A93'   32 0000*              	STA	SRNGF
  2A96'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2A97'                         EXNUM:
  2A97'   1A                    	LDAX	D
  2A98'   D6 30                 	SUI	'0'
  2A9A'   D8                    	RC
  2A9B'   FE 0A                 	CPI	10
  2A9D'   3F                    	CMC
  2A9E'   D8                    	RC
  2A9F'   21 0000               	LXI	H,0
  2AA2'                         EXN_LP:
  2AA2'   1A                    	LDAX	D
  2AA3'   D6 30                 	SUI	'0'
  2AA5'   DA 2ABF'              	JC	EXN_DN
  2AA8'   FE 0A                 	CPI	10
  2AAA'   D2 2ABF'              	JNC	EXN_DN
  2AAD'   13                    	INX	D
  2AAE'   C5                    	PUSH	B
  2AAF'   4F                    	MOV	C,A
  2AB0'   06 00                 	MVI	B,0		; BC = the digit
  2AB2'   D5                    	PUSH	D
  2AB3'   54                    	MOV	D,H
  2AB4'   5D                    	MOV	E,L
  2AB5'   29                    	DAD	H		; *2
  2AB6'   29                    	DAD	H		; *4
  2AB7'   19                    	DAD	D		; *5
  2AB8'   29                    	DAD	H		; *10
  2AB9'   D1                    	POP	D
  2ABA'   09                    	DAD	B
  2ABB'   C1                    	POP	B
  2ABC'   C3 2AA2'              	JMP	EXN_LP
  2ABF'                         EXN_DN:
  2ABF'   B7                    	ORA	A		; CY clear: there was a number
  2AC0'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2AC1'                         EX_S:
  2AC1'   7E                    	MOV	A,M
  2AC2'   B7                    	ORA	A
  2AC3'   CA 2B05'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2AC6'   32 0000*              	STA	SDELIM
  2AC9'   23                    	INX	H
  2ACA'   11 0000*              	LXI	D,SRCHST
  2ACD'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2AD0'   4F                    	MOV	C,A
  2AD1'   CD 2B0B'              	CALL	SCOPY
  2AD4'   78                    	MOV	A,B
  2AD5'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2AD6'   CA 2B05'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2AD9'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2ADC'   3E 01                 	MVI	A,1
  2ADE'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2AE1'   11 0000*              	LXI	D,SREPL
  2AE4'   0E 24                 	MVI	C,SREPMX
  2AE6'   CD 2B0B'              	CALL	SCOPY
  2AE9'   78                    	MOV	A,B
  2AEA'   32 0000*              	STA	SREPLN
  2AED'   AF                    	XRA	A
  2AEE'   32 0000*              	STA	SGFLAG
  2AF1'   7E                    	MOV	A,M
  2AF2'   FE 67                 	CPI	'g'
  2AF4'   C2 2AFD'              	JNZ	EX_SG
  2AF7'   23                    	INX	H
  2AF8'   3E 01                 	MVI	A,1
  2AFA'   32 0000*              	STA	SGFLAG
  2AFD'                         EX_SG:
  2AFD'   7E                    	MOV	A,M
  2AFE'   B7                    	ORA	A
  2AFF'   C2 2869'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2B02'   C3 2B2B'              	JMP	SUBGO
  2B05'                         SUBNOP:
  2B05'   21 2934'              	LXI	H,SNOPAT
  2B08'   C3 2877'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2B0B'                         SCOPY:
  2B0B'   06 00                 	MVI	B,0
  2B0D'                         SCP_LP:
  2B0D'   78                    	MOV	A,B
  2B0E'   B9                    	CMP	C
  2B0F'   D2 2B28'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2B12'   7E                    	MOV	A,M
  2B13'   B7                    	ORA	A
  2B14'   CA 2B28'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2B17'   E5                    	PUSH	H
  2B18'   21 0000*              	LXI	H,SDELIM
  2B1B'   BE                    	CMP	M
  2B1C'   E1                    	POP	H
  2B1D'   CA 2B27'              	JZ	SCP_SK
  2B20'   12                    	STAX	D
  2B21'   13                    	INX	D
  2B22'   23                    	INX	H
  2B23'   04                    	INR	B
  2B24'   C3 2B0D'              	JMP	SCP_LP
  2B27'                         SCP_SK:
  2B27'   23                    	INX	H
  2B28'                         SCP_DN:
  2B28'   AF                    	XRA	A
  2B29'   12                    	STAX	D
  2B2A'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2B2B'                         SUBGO:
  2B2B'   CD 1401'              	CALL	GZONE
  2B2E'   2A 0000*              	LHLD	LNDLT
  2B31'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2B34'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2B37'   CD 0444'              	CALL	FPSTO		;   search's SN_BAD does
  2B3A'   AF                    	XRA	A
  2B3B'   32 0000*              	STA	SANY
  2B3E'   21 0000               	LXI	H,0
  2B41'   22 0000*              	SHLD	SBACK
  2B44'   3A 0000*              	LDA	SRNGF
  2B47'   B7                    	ORA	A
  2B48'   CA 2B5A'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2B4B'   CD 23F7'              	CALL	EXRNG		; SLINES = the lines in the range
  2B4E'   DA 2BD6'              	JC	SUBBAD
  2B51'   2A 0000*              	LHLD	SRNG1
  2B54'   CD 135A'              	CALL	GOLN
  2B57'   C3 2B60'              	JMP	SUBLP
  2B5A'                         SUB_1L:
  2B5A'   21 0001               	LXI	H,1
  2B5D'   22 0000*              	SHLD	SLINES
  2B60'                         SUBLP:
  2B60'   CD 2BDC'              	CALL	SUBLIN		; A = 1 when this line changed
  2B63'   B7                    	ORA	A
  2B64'   CA 2B72'              	JZ	SUB_NX
  2B67'   3E 01                 	MVI	A,1
  2B69'   32 0000*              	STA	SANY
  2B6C'   21 0000               	LXI	H,0
  2B6F'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2B72'                         SUB_NX:
  2B72'   2A 0000*              	LHLD	SLINES
  2B75'   2B                    	DCX	H
  2B76'   22 0000*              	SHLD	SLINES
  2B79'   7C                    	MOV	A,H
  2B7A'   B5                    	ORA	L
  2B7B'   CA 2B99'              	JZ	SUBDON		; the range is spent
  2B7E'   21 0001               	LXI	H,1
  2B81'   AF                    	XRA	A
  2B82'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2B85'   3A 0000*              	LDA	SANY
  2B88'   B7                    	ORA	A
  2B89'   CA 2B93'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2B8C'   2A 0000*              	LHLD	SBACK
  2B8F'   23                    	INX	H
  2B90'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2B93'                         SUB_AE:
  2B93'   CD 0BF6'              	CALL	ATEOF
  2B96'   D2 2B60'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2B99'                         SUBDON:
  2B99'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2B9C'   3A 0000*              	LDA	SANY
  2B9F'   B7                    	ORA	A
  2BA0'   CA 2BBE'              	JZ	SUBNFD
  2BA3'   3E 01                 	MVI	A,1
  2BA5'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2BA8'   2A 0000*              	LHLD	SBACK
  2BAB'   7C                    	MOV	A,H
  2BAC'   B5                    	ORA	L
  2BAD'   CA 2BB8'              	JZ	SUB_PL
  2BB0'   3E FF                 	MVI	A,0FFH
  2BB2'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2BB5'   CD 0000*              	CALL	CLRCNT
  2BB8'                         SUB_PL:
  2BB8'   CD 1419'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2BBB'   C3 08AA'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2BBE'                         SUBNFD:
  2BBE'   21 0000*              	LXI	H,SOFFS
  2BC1'   CD 03EF'              	CALL	BACKTO
  2BC4'   2A 0000*              	LHLD	SLDLTS
  2BC7'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2BCA'   21 2904'              	LXI	H,SNOTFD
  2BCD'   CD 2877'              	CALL	EXERR
  2BD0'   21 0000*              	LXI	H,SRCHST
  2BD3'   C3 2872'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2BD6'                         SUBBAD:
  2BD6'   21 28F2'              	LXI	H,SNOT
  2BD9'   C3 286C'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2BDC'                         SUBLIN:
  2BDC'   AF                    	XRA	A
  2BDD'   32 0000*              	STA	SLCHG
  2BE0'   CD 2C5B'              	CALL	SUBBOL
  2BE3'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2BE6'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2BE6'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2BE9'   DA 2BF1'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2BEC'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2BEE'   C2 2BE6'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2BF1'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2BF1'   CD 0000*              	CALL	CUROFF
  2BF4'   E5                    	PUSH	H
  2BF5'   CD 1A29'              	CALL	CEND
  2BF8'   D1                    	POP	D
  2BF9'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2BFC'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2BFD'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2C00'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2C01'   B7                    	ORA	A		;   span is a line, not a pair.)
  2C02'   FA 2C54'              	JM	SUBL_D		; what is left is shorter than the pattern
  2C05'   44                    	MOV	B,H
  2C06'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2C07'   11 0000*              	LXI	D,SRCHST
  2C0A'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2C0D'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2C10'   DA 2C54'              	JC	SUBL_D
  2C13'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2C16'   EB                    	XCHG
  2C17'   2A 0000*              	LHLD	GAPEND
  2C1A'   EB                    	XCHG
  2C1B'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2C1E'   EB                    	XCHG
  2C1F'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2C20'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2C23'   D1                    	POP	D
  2C24'   19                    	DAD	D		; ... and so the match's logical offset
  2C25'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2C28'   3A 0000*              	LDA	SANY
  2C2B'   B7                    	ORA	A
  2C2C'   C2 2C39'              	JNZ	SUBL_C
  2C2F'   3A 0000*              	LDA	SLCHG
  2C32'   B7                    	ORA	A
  2C33'   C2 2C39'              	JNZ	SUBL_C
  2C36'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2C39'                         SUBL_C:
  2C39'   3A 0000*              	LDA	SRCHBF
  2C3C'   6F                    	MOV	L,A
  2C3D'   26 00                 	MVI	H,0
  2C3F'   CD 0000*              	CALL	DELFWD		; the match goes
  2C42'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2C45'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2C48'                         SUBL_I:
  2C48'   3E 01                 	MVI	A,1
  2C4A'   32 0000*              	STA	SLCHG
  2C4D'   3A 0000*              	LDA	SGFLAG
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C50'   B7                    	ORA	A
  2C51'   C2 2BF1'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2C54'                         SUBL_D:
  2C54'   CD 2C5B'              	CALL	SUBBOL
  2C57'   3A 0000*              	LDA	SLCHG
  2C5A'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2C5B'                         SUBBOL:
  2C5B'   CD 0000*              	CALL	CUROFF
  2C5E'   CD 0693'              	CALL	BOL
  2C61'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2C64'                         VC_SRCH:
  2C64'   CD 086D'              	CALL	SETMOV
  2C67'   C5                    	PUSH	B
  2C68'   CD 0798'              	CALL	GETCNT
  2C6B'   22 0000*              	SHLD	SCNT
  2C6E'   C1                    	POP	B
  2C6F'   79                    	MOV	A,C
  2C70'   FE 2F                 	CPI	'/'
  2C72'   3E 00                 	MVI	A,0
  2C74'   CA 2C79'              	JZ	VS_DIR
  2C77'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2C79'                         VS_DIR:
  2C79'   32 0000*              	STA	SDIR
  2C7C'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2C7F'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2C82'   47                    	MOV	B,A
  2C83'   CD 2198'              	CALL	RDLINE
  2C86'   B7                    	ORA	A
  2C87'   C0                    	RNZ			; cancelled: nothing happens at all
  2C88'   3A 0000*              	LDA	PSAVE		; under an operator ('d/pat') the terminal's
  2C8B'   B7                    	ORA	A		;   cursor goes back on the text: R_DCH deletes
  2C8C'   C4 0000*              	CNZ	SCURS		;   wherever that cursor is
  2C8F'   3A 0000*              	LDA	RLLEN
  2C92'   B7                    	ORA	A
  2C93'   CA 2CA8'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2C96'   5F                    	MOV	E,A
  2C97'   16 00                 	MVI	D,0
  2C99'   21 0000*              	LXI	H,SRCHST
  2C9C'   19                    	DAD	D
  2C9D'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2C9F'   7B                    	MOV	A,E
  2CA0'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2CA3'   3E 01                 	MVI	A,1
  2CA5'   32 0000*              	STA	SHAVE
  2CA8'                         VS_OLD:
  2CA8'   3A 0000*              	LDA	SHAVE
  2CAB'   B7                    	ORA	A
  2CAC'   CA 2CB8'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2CAF'   3A 0000*              	LDA	SDIR
  2CB2'   32 0000*              	STA	SDIRE
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CB5'   C3 2CE1'              	JMP	SRCHN
  2CB8'                         VS_NOP:
  2CB8'   21 2934'              	LXI	H,SNOPAT
  2CBB'   C3 2877'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2CBE'                         VC_N:
  2CBE'   CD 086D'              	CALL	SETMOV
  2CC1'   3A 0000*              	LDA	SDIR
  2CC4'   C3 2CCE'              	JMP	VN_GO
  2CC7'                         VCB_N:
  2CC7'   CD 086D'              	CALL	SETMOV
  2CCA'   3A 0000*              	LDA	SDIR
  2CCD'   2F                    	CMA			; the other way: 0 <-> FFH
  2CCE'                         VN_GO:
  2CCE'   32 0000*              	STA	SDIRE
  2CD1'   CD 0798'              	CALL	GETCNT
  2CD4'   22 0000*              	SHLD	SCNT
  2CD7'   3A 0000*              	LDA	SHAVE
  2CDA'   B7                    	ORA	A
  2CDB'   CA 2CB8'              	JZ	VS_NOP
  2CDE'   C3 2CE1'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2CE1'                         SRCHN:
  2CE1'   CD 1401'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2CE4'   CD 07C1'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it -- under an
  2CE7'   3E 01                 	MVI	A,1		;   operator too: unlike 'dG', 'd/' changes nothing
  2CE9'   32 0000*              	STA	BRKARM		;   until the search is over, and a stop drops it
  2CEC'                         SN_LP:
  2CEC'   CD 2D21'              	CALL	SRCHGO
  2CEF'   DA 2D0C'              	JC	SN_BAD
  2CF2'   2A 0000*              	LHLD	SCNT
  2CF5'   2B                    	DCX	H
  2CF6'   22 0000*              	SHLD	SCNT
  2CF9'   7C                    	MOV	A,H
  2CFA'   B5                    	ORA	L
  2CFB'   C2 2CEC'              	JNZ	SN_LP
  2CFE'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2D01'   CD 07FE'              	CALL	BRKOFF
  2D04'   3E 01                 	MVI	A,1
  2D06'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2D09'   C3 1419'              	JMP	GPLACE		; (which sets LNDLT itself)
  2D0C'                         SN_BAD:
  2D0C'   CD 07FE'              	CALL	BRKOFF
  2D0F'   DA 0816'              	JC	BRKBAK		; stopped, which is not the same as not found
  2D12'   CD 0809'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2D15'   21 2904'              	LXI	H,SNOTFD
  2D18'   CD 2877'              	CALL	EXERR
  2D1B'   21 0000*              	LXI	H,SRCHST
  2D1E'   C3 2872'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, paging as WM's find pages, then the rest of the
                                ; file READ where it lies (SCAN) and the window moved once, to the match --
                                ; not paged round the whole file a second time (issue #35).  CY = the pattern
                                ; is nowhere in the file, or an ESC stopped it (BRKQ says which); the cursor
                                ; is then at an end of the file, and SRCHN puts it back.
  2D21'                         SRCHGO:
  2D21'   21 0000*              	LXI	H,SGPOS
  2D24'   CD 0444'              	CALL	FPSTO		; where this one starts: the wrapped pass ends
  2D27'   CD 2F77'              	CALL	SRCHW		;   there
  2D2A'   D0                    	RNC
  2D2B'   CD 0802'              	CALL	BRKQ
  2D2E'   D8                    	RC			; stopped: no second pass
  2D2F'   CD 2D3C'              	CALL	SCAN
  2D32'   D8                    	RC
  2D33'   21 0000*              	LXI	H,SCHIT
  2D36'   CD 03EF'              	CALL	BACKTO		; to the match: one move, as a mark jump
  2D39'   C3 0802'              	JMP	BRKQ		; CY: stopped on the way there
                                
                                ;SCAN -- the wrapped pass, without moving the window: the records above it,
                                ; the window, then the records below it, through SECBUF in file order (SCNEXT).
                                ; The last bytes of each piece, a pattern less one, are kept just below
                                ; SECBUF, so a match that straddles two pieces is seen whole there.  '/'
                                ; wants the FIRST match in the file and stops reading once a match could only
                                ; start past SGPOS -- the first pass found nothing there.  '?' wants the LAST,
                                ; so it reads to the end, but skips the records that end before SCLIM: the
                                ; first pass found nothing that ends before SGPOS.  NC: SCHIT = the match's
                                ; file position.  CY: there is none, or an ESC stopped it.
  2D3C'                         SCAN:
  2D3C'   AF                    	XRA	A
  2D3D'   32 0000*              	STA	SCFND
  2D40'   32 0000*              	STA	SCCRY
  2D43'   32 0000*              	STA	SCPH		; the records above the window first
  2D46'   32 0002*              	STA	SCPOS+2
  2D49'   21 0000               	LXI	H,0
  2D4C'   22 0000*              	SHLD	SCIX
  2D4F'   22 0000*              	SHLD	SCPOS
  2D52'   3A 0000*              	LDA	SRCHBF
  2D55'   5F                    	MOV	E,A
  2D56'   16 00                 	MVI	D,0		; DE = the pattern's length
  2D58'   2A 0000*              	LHLD	SGPOS
  2D5B'   3A 0000*              	LDA	SDIRE
  2D5E'   B7                    	ORA	A
  2D5F'   3A 0002*              	LDA	SGPOS+2
  2D62'   FA 2D6B'              	JM	SC_BK
  2D65'   19                    	DAD	D		; '/': SGPOS + the length
  2D66'   CE 00                 	ACI	0
  2D68'   C3 2D75'              	JMP	SC_LIM
  2D6B'                         SC_BK:
  2D6B'   42                    	MOV	B,D
  2D6C'   CD 13AE'              	CALL	SUB24		; '?': SGPOS - the length (0 if that is less)
  2D6F'   D2 2D75'              	JNC	SC_LIM
  2D72'   AF                    	XRA	A
  2D73'   67                    	MOV	H,A
  2D74'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2D75'                         SC_LIM:
  2D75'   22 0000*              	SHLD	SCLIM
  2D78'   32 0002*              	STA	SCLIM+2
  2D7B'                         SC_LP:
  2D7B'   3A 0000*              	LDA	BRKARM
  2D7E'   B7                    	ORA	A
  2D7F'   C4 07DB'              	CNZ	BRKTST		; an ESC, as CNTTST looks for one
  2D82'   CD 0802'              	CALL	BRKQ
  2D85'   D8                    	RC
  2D86'   3A 0000*              	LDA	SDIRE
  2D89'   B7                    	ORA	A
  2D8A'   FA 2DA6'              	JM	SC_RD		; '?' reads to the end
  2D8D'   3A 0000*              	LDA	SCFND
  2D90'   B7                    	ORA	A
  2D91'   C0                    	RNZ			; '/': the first is all it wants (NC)
  2D92'   2A 0000*              	LHLD	SCLIM
  2D95'   EB                    	XCHG
  2D96'   3A 0002*              	LDA	SCLIM+2
  2D99'   47                    	MOV	B,A
  2D9A'   2A 0000*              	LHLD	SCPOS
  2D9D'   3A 0002*              	LDA	SCPOS+2
  2DA0'   CD 13AE'              	CALL	SUB24		; NC: no match can start at SGPOS or before
  2DA3'   D2 2DB3'              	JNC	SC_END		;   from here on
  2DA6'                         SC_RD:
  2DA6'   CD 2E56'              	CALL	SCNEXT		; SECBUF = the next piece, A = its length
  2DA9'   DA 2DB3'              	JC	SC_END		; the file has run out
  2DAC'   B7                    	ORA	A
  2DAD'   C4 2DB9'              	CNZ	SCMAT
  2DB0'   C3 2D7B'              	JMP	SC_LP
  2DB3'                         SC_END:
  2DB3'   3A 0000*              	LDA	SCFND
  2DB6'   D6 01                 	SUI	1		; CY iff there is none
  2DB8'   C9                    	RET
                                
                                ;SCMAT -- look for the pattern in the A bytes in SECBUF and the carry below
                                ; it, then keep the last of them as the carry and move SCPOS past them.
  2DB9'                         SCMAT:
  2DB9'   4F                    	MOV	C,A
  2DBA'   06 00                 	MVI	B,0
  2DBC'   C5                    	PUSH	B		; the length of the piece
  2DBD'   3A 0000*              	LDA	SRCHBF
  2DC0'   67                    	MOV	H,A
  2DC1'   3A 0000*              	LDA	SCCRY
  2DC4'   81                    	ADD	C		; the carry and the piece
  2DC5'   94                    	SUB	H
  2DC6'   DA 2E1D'              	JC	SCM_NO		; shorter than the pattern
  2DC9'   3C                    	INR	A
  2DCA'   4F                    	MOV	C,A		; BC = the places a match may start at
  2DCB'   11 0000*              	LXI	D,SRCHST
  2DCE'   3A 0000*              	LDA	SDIRE
  2DD1'   B7                    	ORA	A
  2DD2'   FA 2DEF'              	JM	SCM_BK
  2DD5'   3A 0000*              	LDA	SCCRY		; '/': the first, from the carry's first byte
  2DD8'   2F                    	CMA
  2DD9'   6F                    	MOV	L,A
  2DDA'   26 FF                 	MVI	H,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DDC'   23                    	INX	H		; HL = - the carry
  2DDD'   D5                    	PUSH	D
  2DDE'   11 0000*              	LXI	D,SECBUF
  2DE1'   19                    	DAD	D
  2DE2'   D1                    	POP	D
  2DE3'   CD 0000*              	CALL	MATCHF
  2DE6'   DA 2E1D'              	JC	SCM_NO
  2DE9'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match
  2DEC'   C3 2E00'              	JMP	SCM_HI
  2DEF'                         SCM_BK:
  2DEF'   E1                    	POP	H		; '?': the last, back from the piece's end
  2DF0'   E5                    	PUSH	H
  2DF1'   D5                    	PUSH	D
  2DF2'   11 0000*              	LXI	D,SECBUF
  2DF5'   19                    	DAD	D
  2DF6'   D1                    	POP	D
  2DF7'   CD 0000*              	CALL	SUBLEN		; the last place one can start
  2DFA'   CD 0000*              	CALL	MATCHB
  2DFD'   DA 2E1D'              	JC	SCM_NO
  2E00'                         SCM_HI:
  2E00'   EB                    	XCHG			; DE = the match, in SECBUF or below it
  2E01'   2A 0000*              	LHLD	SCPOS
  2E04'   19                    	DAD	D
  2E05'   3A 0002*              	LDA	SCPOS+2
  2E08'   CE 00                 	ACI	0
  2E0A'   11 0000*              	LXI	D,SECBUF
  2E0D'   06 00                 	MVI	B,0
  2E0F'   CD 13AE'              	CALL	SUB24		; its file position
  2E12'   22 0000*              	SHLD	SCHIT
  2E15'   32 0002*              	STA	SCHIT+2
  2E18'   3E 01                 	MVI	A,1
  2E1A'   32 0000*              	STA	SCFND
  2E1D'                         SCM_NO:
  2E1D'   C1                    	POP	B		; BC = the piece's length
  2E1E'   C5                    	PUSH	B
  2E1F'   3A 0000*              	LDA	SCCRY
  2E22'   81                    	ADD	C
  2E23'   5F                    	MOV	E,A		; the carry and the piece
  2E24'   3A 0000*              	LDA	SRCHBF
  2E27'   3D                    	DCR	A		; ... of which a pattern less one is kept
  2E28'   BB                    	CMP	E
  2E29'   DA 2E2D'              	JC	SCM_T
  2E2C'   7B                    	MOV	A,E
  2E2D'                         SCM_T:
  2E2D'   32 0000*              	STA	SCCRY
  2E30'   5F                    	MOV	E,A
  2E31'   16 00                 	MVI	D,0		; DE = the new carry
  2E33'   21 0000*              	LXI	H,SECBUF
  2E36'   09                    	DAD	B
  2E37'   CD 0000*              	CALL	SUBHD		; the bytes it keeps
  2E3A'   E5                    	PUSH	H
  2E3B'   21 0000*              	LXI	H,SECBUF
  2E3E'   CD 0000*              	CALL	SUBHD		; where they go
  2E41'   42                    	MOV	B,D
  2E42'   4B                    	MOV	C,E
  2E43'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E44'   E1                    	POP	H
  2E45'   CD 0000*              	CALL	MEMCPY		; (down, so a forward copy is safe)
  2E48'   D1                    	POP	D		; the piece's length
                                ;SCADV -- SCPOS += DE.
  2E49'                         SCADV:
  2E49'   2A 0000*              	LHLD	SCPOS
  2E4C'   19                    	DAD	D
  2E4D'   22 0000*              	SHLD	SCPOS
  2E50'   D0                    	RNC
  2E51'   21 0002*              	LXI	H,SCPOS+2
  2E54'   34                    	INR	M
  2E55'   C9                    	RET
                                
                                ;SCNEXT -- the next piece of the file into SECBUF: A = its length, which is 0
                                ; for a record skipped.  CY: the file has run out.  SCPH is what it is in:
                                ; 0 the records above the window, 1 the window before the gap, 2 after it,
                                ; 3 VIBACKUP.$$$ (top down), 4 the source below, 5 nothing left.
  2E56'                         SCNEXT:
  2E56'   3A 0000*              	LDA	SCPH
  2E59'   B7                    	ORA	A
  2E5A'   CA 2E6C'              	JZ	SN_AB
  2E5D'   FE 03                 	CPI	3
  2E5F'   DA 2E9A'              	JC	SN_GP
  2E62'   CA 2F10'              	JZ	SN_BAK
  2E65'   FE 04                 	CPI	4
  2E67'   CA 2F2A'              	JZ	SN_SRC
  2E6A'   37                    	STC
  2E6B'   C9                    	RET
  2E6C'                         SN_AB:
  2E6C'   2A 0000*              	LHLD	OUTPOS
  2E6F'   EB                    	XCHG
  2E70'   2A 0000*              	LHLD	SCIX
  2E73'   CD 0000*              	CALL	CMP16
  2E76'   CA 2E84'              	JZ	SN_W0		; all of them read: the window
  2E79'   23                    	INX	H
  2E7A'   22 0000*              	SHLD	SCIX
  2E7D'   2B                    	DCX	H
  2E7E'   AF                    	XRA	A		; above the window
  2E7F'   CD 2F41'              	CALL	SN_REC
  2E82'   B7                    	ORA	A
  2E83'   C9                    	RET
  2E84'                         SN_W0:
  2E84'   2A 0000*              	LHLD	TXTBEG
  2E87'   EB                    	XCHG
  2E88'   2A 0000*              	LHLD	GAPBEG
  2E8B'   3E 01                 	MVI	A,1
  2E8D'                         SN_PH:				; phase A, from DE up to HL
  2E8D'   32 0000*              	STA	SCPH
  2E90'   22 0000*              	SHLD	SCEND
  2E93'   EB                    	XCHG
  2E94'   22 0000*              	SHLD	SCIX
  2E97'   C3 2E56'              	JMP	SCNEXT
  2E9A'                         SN_GP:				; the window: up to 128 bytes of it, copied
  2E9A'   2A 0000*              	LHLD	SCIX
  2E9D'   EB                    	XCHG
  2E9E'   2A 0000*              	LHLD	SCEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2EA1'   CD 0000*              	CALL	SUBHD		; HL = what is left of this part
  2EA4'   7C                    	MOV	A,H
  2EA5'   B5                    	ORA	L
  2EA6'   CA 2ECB'              	JZ	SN_GPX
  2EA9'   7C                    	MOV	A,H
  2EAA'   B7                    	ORA	A
  2EAB'   C2 2EB4'              	JNZ	SN_128
  2EAE'   7D                    	MOV	A,L
  2EAF'   FE 81                 	CPI	81H
  2EB1'   DA 2EB7'              	JC	SN_GPN
  2EB4'                         SN_128:
  2EB4'   21 0080               	LXI	H,80H
  2EB7'                         SN_GPN:
  2EB7'   E5                    	PUSH	H
  2EB8'   44                    	MOV	B,H
  2EB9'   4D                    	MOV	C,L
  2EBA'   EB                    	XCHG
  2EBB'   E5                    	PUSH	H
  2EBC'   11 0000*              	LXI	D,SECBUF
  2EBF'   CD 0000*              	CALL	MEMCPY
  2EC2'   E1                    	POP	H
  2EC3'   C1                    	POP	B
  2EC4'   09                    	DAD	B
  2EC5'   22 0000*              	SHLD	SCIX
  2EC8'   79                    	MOV	A,C
  2EC9'   B7                    	ORA	A
  2ECA'   C9                    	RET
  2ECB'                         SN_GPX:
  2ECB'   3A 0000*              	LDA	SCPH
  2ECE'   FE 02                 	CPI	2
  2ED0'   CA 2EDF'              	JZ	SN_BLW
  2ED3'   2A 0000*              	LHLD	GAPEND
  2ED6'   EB                    	XCHG
  2ED7'   2A 0000*              	LHLD	TXTEND
  2EDA'   3E 02                 	MVI	A,2
  2EDC'   C3 2E8D'              	JMP	SN_PH
  2EDF'                         SN_BLW:				; below the window: VIBACKUP.$$$ if it holds
  2EDF'   3A 0000*              	LDA	BAKRDY		;   anything, as RDIN reads it first
  2EE2'   B7                    	ORA	A
  2EE3'   CA 2EF9'              	JZ	SN_S0
  2EE6'   2A 0000*              	LHLD	BAKPOS
  2EE9'   7C                    	MOV	A,H
  2EEA'   B5                    	ORA	L
  2EEB'   CA 2EF9'              	JZ	SN_S0
  2EEE'   22 0000*              	SHLD	SCIX
  2EF1'   3E 03                 	MVI	A,3
  2EF3'   32 0000*              	STA	SCPH
  2EF6'   C3 2E56'              	JMP	SCNEXT
  2EF9'                         SN_S0:				; then the source, from where it is read to
  2EF9'   3A 005B               	LDA	5BH
  2EFC'   B7                    	ORA	A
  2EFD'   3E 05                 	MVI	A,5
  2EFF'   CA 2F0A'              	JZ	SN_END
  2F02'   2A 007E               	LHLD	7EH
  2F05'   22 0000*              	SHLD	SCIX
  2F08'   3E 04                 	MVI	A,4
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2F0A'                         SN_END:
  2F0A'   32 0000*              	STA	SCPH
  2F0D'   C3 2E56'              	JMP	SCNEXT
  2F10'                         SN_BAK:
  2F10'   2A 0000*              	LHLD	SCIX
  2F13'   7C                    	MOV	A,H
  2F14'   B5                    	ORA	L
  2F15'   CA 2EF9'              	JZ	SN_S0		; record 0 read
  2F18'   2B                    	DCX	H
  2F19'   22 0000*              	SHLD	SCIX
  2F1C'   3E 01                 	MVI	A,1
  2F1E'   CD 2F41'              	CALL	SN_REC
  2F21'   D0                    	RNC
  2F22'   21 0000               	LXI	H,0		; a ^Z: the stack ends there (RDIN's IOEOF)
  2F25'   22 0000*              	SHLD	SCIX
  2F28'   B7                    	ORA	A
  2F29'   C9                    	RET
  2F2A'                         SN_SRC:
  2F2A'   2A 0000*              	LHLD	SCIX
  2F2D'   23                    	INX	H
  2F2E'   22 0000*              	SHLD	SCIX
  2F31'   2B                    	DCX	H
  2F32'   3E 02                 	MVI	A,2
  2F34'   CD 2F41'              	CALL	SN_REC
  2F37'   D0                    	RNC
  2F38'   F5                    	PUSH	PSW		; a ^Z or no record: the end of the file
  2F39'   3E 05                 	MVI	A,5
  2F3B'   32 0000*              	STA	SCPH
  2F3E'   F1                    	POP	PSW
  2F3F'   B7                    	ORA	A
  2F40'   C9                    	RET
                                
                                ;SN_REC -- SCNREC (record HL, kind A), unless it is a '?' record that ends
                                ; before SCLIM, which is skipped: SCPOS moves past it and the carry goes (a
                                ; record is 128 bytes until the last, and that one is never skipped).
  2F41'                         SN_REC:
  2F41'   F5                    	PUSH	PSW
  2F42'   E5                    	PUSH	H
  2F43'   3A 0000*              	LDA	SDIRE
  2F46'   B7                    	ORA	A
  2F47'   F2 2F72'              	JP	SN_RD		; '/' never skips
  2F4A'   2A 0000*              	LHLD	SCPOS
  2F4D'   11 0080               	LXI	D,80H
  2F50'   19                    	DAD	D
  2F51'   EB                    	XCHG
  2F52'   3A 0002*              	LDA	SCPOS+2
  2F55'   CE 00                 	ACI	0
  2F57'   47                    	MOV	B,A		; B:DE = past this record
  2F58'   2A 0000*              	LHLD	SCLIM
  2F5B'   3A 0002*              	LDA	SCLIM+2
  2F5E'   CD 13AE'              	CALL	SUB24		; NC: it ends at SCLIM or before
  2F61'   DA 2F72'              	JC	SN_RD
  2F64'   E1                    	POP	H
  2F65'   F1                    	POP	PSW
  2F66'   AF                    	XRA	A
  2F67'   32 0000*              	STA	SCCRY
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2F6A'   11 0080               	LXI	D,80H
  2F6D'   CD 2E49'              	CALL	SCADV
  2F70'   AF                    	XRA	A		; nothing to look at, NC
  2F71'   C9                    	RET
  2F72'                         SN_RD:
  2F72'   E1                    	POP	H
  2F73'   F1                    	POP	PSW
  2F74'   C3 0000*              	JMP	SCNREC
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller reads the rest of the file or restores the cursor outright.
  2F77'                         SRCHW:
  2F77'   3A 0000*              	LDA	SDIRE
  2F7A'   32 0000*              	STA	DIRFLG
  2F7D'   21 FFFF               	LXI	H,0FFFFH
  2F80'   22 0000*              	SHLD	CMDCNT
  2F83'   AF                    	XRA	A
  2F84'   32 0000*              	STA	AUXCNT
  2F87'                         SW_LP:
  2F87'   CD 0802'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2F8A'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2F8B'   CD 2F97'              	CALL	SRCH1
  2F8E'   D0                    	RNC
  2F8F'   CD 0000*              	CALL	SCRLST
  2F92'   D2 2F87'              	JNC	SW_LP
  2F95'   37                    	STC
  2F96'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2F97'                         SRCH1:
  2F97'   11 0000*              	LXI	D,SRCHST
  2F9A'   3A 0000*              	LDA	DIRFLG
  2F9D'   B7                    	ORA	A
  2F9E'   FA 2FBB'              	JM	SR1_BK
  2FA1'   21 0000*              	LXI	H,GAPEND
  2FA4'   CD 0000*              	CALL	FWDCNT
  2FA7'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2FAA'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2FAB'   78                    	MOV	A,B
  2FAC'   B1                    	ORA	C
  2FAD'   37                    	STC
  2FAE'   C8                    	RZ			; no room for a match even before the skip
  2FAF'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2FB0'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2FB1'   CD 0000*              	CALL	MATCHF
  2FB4'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


  2FB5'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2FB8'   C3 0000*              	JMP	PUTCUR
  2FBB'                         SR1_BK:
  2FBB'   21 0000*              	LXI	H,TXTBEG
  2FBE'   CD 0000*              	CALL	FWDCNT
  2FC1'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2FC4'   D8                    	RC
  2FC5'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2FC8'   CD 0000*              	CALL	MATCHB
  2FCB'   D8                    	RC
  2FCC'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2FCF'                         MSGNAM:
  2FCF'   E5                    	PUSH	H
  2FD0'   3E 22                 	MVI	A,'"'
  2FD2'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2FD5'   E1                    	POP	H
  2FD6'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2FD7'   23                    	INX	H
  2FD8'   7E                    	MOV	A,M
  2FD9'   FE 20                 	CPI	' '
  2FDB'   C2 2FE8'              	JNZ	MN_HAS
  2FDE'   21 29C2'              	LXI	H,SNONM
  2FE1'   CD 0000*              	CALL	OUTSTR
  2FE4'   E1                    	POP	H
  2FE5'   C3 3032'              	JMP	MN_END
  2FE8'                         MN_HAS:
  2FE8'   0E 19                 	MVI	C,BF_CURDSK
  2FEA'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2FED'   E1                    	POP	H
  2FEE'   E5                    	PUSH	H
  2FEF'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2FF0'   BE                    	CMP	M
  2FF1'   CA 2FFF'              	JZ	MN_NAM
  2FF4'   7E                    	MOV	A,M
