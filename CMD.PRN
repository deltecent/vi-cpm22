                                ;============================================================
                                ; DATA
                                ;============================================================
  21D4'   00                    EDMODE: DB	EM_CMD
  21D5'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  21D7'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  21D8'   00                    MODF:	DB	0		; 1 = unsaved changes
  21D9'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  21DA'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  21DB'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                				;   nothing follows it to shift: no ICH needed
  21DC'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  21DD'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  21DF'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  21E0'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  21E1'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  21E2'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  21E3'   0000                  JKCNT:	DW	0		; j/k: count
  21E5'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  21E7'   0000                  JKMOV:	DW	0		; j: lines moved
  21E9'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  21EB'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  21EC'   00                    JKLST:	DB	0		; j: last byte of the scan
  21ED'   0000                  JKVC:	DW	0		; j/k landing: screen column
  21EF'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  21F1'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  21F2'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  21F3'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  21F4'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  21F5'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  21F6'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  21F8'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  21F9'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  21FA'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  21FC'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  21FD'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  21FE'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  21FF'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2200'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2201'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2202'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  2203'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2205'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2207'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2209'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  220B'   0000                  CNTV:	DW	0		; motion repeat counter
  220D'   0000                  TTI:	DW	0		; TAILTAB scan index
  220F'   0000                  WKI:	DW	0		; scan index
  2211'   0000                  WKN:	DW	0		; cached LOGLEN
  2213'   0000                  WKLO:	DW	0		; dd: range low offset
  2215'   0000                  WKTERM: DW	0		; line terminator offset
  2217'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2219'   00                    WKCLS:	DB	0		; word motion: class of the current run
  221A'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  221B'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  221D'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  221F'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
  2221'   0000                  TOFFV:	DW	0		; QSNAP: cursor logical offset
  2223'   0000                  TLINEV: DW	0		; QSNAP: cursor line (0-based)
  2225'   0000                  TCOLV:	DW	0		; QSNAP: cursor column (0-based)
                                
  2227'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2229'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  222A'   00                    RLMAX:	DB	0		; RDLINE: capacity
  222B'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  222C'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  222D'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  222E'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2230'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2231'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2232'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2234'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2236'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2237'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2239'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  223B'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  223C'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  223D'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  223E'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  223F'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2240'   00                    PLUSF:	DB	0		; command line: '+' was given
  2241'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2242'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2243'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2244'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2246'   0000                  YPT:	DW	0		; yy: where the lines came from
  2248'   0000                  PCNT:	DW	0		; p/P: copies still to put
  224A'   0000                  PPT:	DW	0		; p/P: the first line put
  224C'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  224E'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  224F'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2251'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2252'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2253'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2254'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2255'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2258'   0000                  MKEDIT: DW	0		; MKDROP: where the edit that may drop them is
  225A'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  225B'   00                    MKHOLD: DB	0		; set across a yank's delete + put back: MKDROP
                                				;   must leave the marks alone through it
  225C'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  225E'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2260'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2262'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2264'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  2266'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2268'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2269'   00                    SRNGF:	DB	0		; ex: a line range was given
  226A'   0000                  SRNG1:	DW	0		; ex: its first line
  226C'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  226E'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  226F'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2270'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2271'   00                    SLCHG:	DB	0		; ':s' this line changed
  2272'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2274'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  2276'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2278'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  227A'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  227B'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
