  08D6'   EB                    	XCHG			; DE = lines moved
  08D7'   2A 0000*              	LHLD	LNDLT
  08DA'   19                    	DAD	D
  08DB'   22 0000*              	SHLD	LNDLT
  08DE'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  08DF'                         KCORE:
  08DF'   7C                    	MOV	A,H
  08E0'   B5                    	ORA	L
  08E1'   C8                    	RZ
  08E2'   22 24BD'              	SHLD	JKCNT
  08E5'   CD 0C58'              	CALL	CURRW		; limit = row + NEDIT
  08E8'   5F                    	MOV	E,A
  08E9'   16 00                 	MVI	D,0
  08EB'   3A 0000*              	LDA	NEDIT
  08EE'   6F                    	MOV	L,A
  08EF'   26 00                 	MVI	H,0
  08F1'   19                    	DAD	D
  08F2'   EB                    	XCHG			; DE = limit
  08F3'   2A 24BD'              	LHLD	JKCNT
  08F6'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  08F9'   D2 08FD'              	JNC	KC_N
