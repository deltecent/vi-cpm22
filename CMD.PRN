  2DD9'   198A'                 	DW	VC_O
  2DDB'   4F                    	DB	'O'
  2DDC'   199F'                 	DW	VCB_O
  2DDE'   4A                    	DB	'J'
  2DDF'   19B9'                 	DW	VCB_J
