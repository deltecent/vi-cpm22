  230D'   6C 69 64 20           
  2311'   66 69 6C 65           
  2315'   20 6E 61 6D           
  2319'   65 00                 
  231B'   54 72 61 69           STRL:	DB	'Trailing chars: ',0
  231F'   6C 69 6E 67           
  2323'   20 63 68 61           
  2327'   72 73 3A 20           
  232B'   00                    
  232C'   49 6E 76 61           SNOT:	DB	'Invalid command: ',0
  2330'   6C 69 64 20           
