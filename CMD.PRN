  0B7C'   CD 0000*              	CALL	PUTCUR
  0B7F'   F1                    	POP	PSW
  0B80'   FE 0A                 	CPI	LF
  0B82'   3E 00                 	MVI	A,0
  0B84'   C0                    	RNZ
  0B85'   CD 0BA5'              	CALL	LNDEC
  0B88'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B8B'   DA 0B93'              	JC	DC_1
  0B8E'   FE 0D                 	CPI	CR
  0B90'   CC 0000*              	CZ	PUTCUR
  0B93'                         DC_1:
  0B93'   3E 01                 	MVI	A,1
  0B95'   B7                    	ORA	A
  0B96'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
