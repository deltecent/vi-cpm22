  2836'   5D 00                 
  2838'   20 6C 69 6E           SLINE:	DB	' line ',0
  283C'   65 20 00              
  283F'   20 63 6F 6C           SCOLM:	DB	' col ',0
  2843'   20 00                 
  2845'   20 2D 2D 42           SNOLIN: DB	' --Buffer empty--',0
  2849'   75 66 66 65           
  284D'   72 20 65 6D           
  2851'   70 74 79 2D           
  2855'   2D 00                 
  2857'   20 77 72 69           SWRIT:	DB	' written',0
  285B'   74 74 65 6E           
  285F'   00                    
  2860'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  2864'   74 20 6F 70           
  2868'   65 6E 20 66           
  286C'   69 6C 65 20           
  2870'   00                    
  2871'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  2875'   6C 69 64 20           
  2879'   72 61 6E 67           
  287D'   65 00                 
  287F'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  2883'   20 66 75 6C           
  2887'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2889'                         EXTAB:
  2889'   77 00 01              	DB	'w',0,EO_W
  288C'   71 00 02              	DB	'q',0,EO_Q
  288F'   77 71 03              	DB	'w','q',EO_WQ
  2892'   78 00 04              	DB	'x',0,EO_X
  2895'   65 00 05              	DB	'e',0,EO_E
  2898'   73 00 06              	DB	's',0,EO_S
  289B'   76 65 07              	DB	'v','e',EO_V
  289E'   72 00 08              	DB	'r',0,EO_R
