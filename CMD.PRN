  0A3D'   C3 09FA'              	JMP	KC_ED
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A40'                         KC_B0:
  0A40'   D1                    	POP	D
  0A41'                         KC_BOF:
  0A41'   2A 2A95'              	LHLD	JKN		; moved = LFs found
  0A44'   CD 0000*              	CALL	SUBHD
  0A47'                         KC_MV:
  0A47'   E5                    	PUSH	H
  0A48'   2A 2A93'              	LHLD	JKCNT
  0A4B'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A4E'   D1                    	POP	D		; DE = moved
  0A4F'   2A 2A95'              	LHLD	JKN
  0A52'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A55'   DA 0A59'              	JC	KC_AD
  0A58'   EB                    	XCHG			; DE = N
  0A59'                         KC_AD:
  0A59'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A5C'   CD 0000*              	CALL	SUBHD
  0A5F'   22 0000*              	SHLD	LNDLT
  0A62'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A63'                         ATEOF:
  0A63'   CD 0000*              	CALL	RGET0
  0A66'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A69'                         LASTLN:
  0A69'   2A 0000*              	LHLD	GAPBEG
  0A6C'   EB                    	XCHG
  0A6D'   2A 0000*              	LHLD	TXTBEG
  0A70'   CD 0000*              	CALL	CMP16
  0A73'   21 0000               	LXI	H,0
  0A76'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A79'   1B                    	DCX	D
  0A7A'   1A                    	LDAX	D
  0A7B'   FE 0A                 	CPI	LF
  0A7D'   C2 0000*              	JNZ	SETBWD
  0A80'   23                    	INX	H
  0A81'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A84'                         JKLAND:
  0A84'   21 0000               	LXI	H,0
  0A87'   22 2A9D'              	SHLD	JKVC		; screen column
  0A8A'   2B                    	DCX	H
  0A8B'   22 2A9F'              	SHLD	JKLS		; last content char: none yet
  0A8E'   CD 0000*              	CALL	RGET0
  0A91'   11 0000               	LXI	D,0		; DE = chars read
  0A94'                         JL_RD:
  0A94'   CD 0000*              	CALL	RDGET
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A97'   DA 0AD1'              	JC	JL_END
  0A9A'   FE 0A                 	CPI	LF
  0A9C'   CA 0AD1'              	JZ	JL_END
  0A9F'   E5                    	PUSH	H
  0AA0'   C5                    	PUSH	B
  0AA1'   2A 2A9D'              	LHLD	JKVC
  0AA4'   CD 0611'              	CALL	CWID
  0AA7'   B7                    	ORA	A
  0AA8'   CA 0ACB'              	JZ	JL_NX		; a CR
  0AAB'   EB                    	XCHG
  0AAC'   22 2A9F'              	SHLD	JKLS		; the last content char so far
  0AAF'   EB                    	XCHG
  0AB0'   4F                    	MOV	C,A
  0AB1'   06 00                 	MVI	B,0
  0AB3'   09                    	DAD	B		; HL = the column after this char
  0AB4'   22 2A9D'              	SHLD	JKVC
  0AB7'   D5                    	PUSH	D
  0AB8'   EB                    	XCHG
  0AB9'   2A 2A8D'              	LHLD	GOALCOL
  0ABC'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0ABF'   D1                    	POP	D
  0AC0'   DA 0ACB'              	JC	JL_NX
  0AC3'   CA 0ACB'              	JZ	JL_NX
  0AC6'   C1                    	POP	B		; this char holds the goal column
  0AC7'   E1                    	POP	H
  0AC8'   C3 0ADC'              	JMP	JL_GO
  0ACB'                         JL_NX:
  0ACB'   C1                    	POP	B
  0ACC'   E1                    	POP	H
  0ACD'   13                    	INX	D
  0ACE'   C3 0A94'              	JMP	JL_RD
  0AD1'                         JL_END:
  0AD1'   2A 2A9F'              	LHLD	JKLS		; past the line's end: its last content char
  0AD4'   7C                    	MOV	A,H
  0AD5'   A5                    	ANA	L
  0AD6'   3C                    	INR	A
  0AD7'   C2 0ADB'              	JNZ	JL_LS
  0ADA'   23                    	INX	H		; no content: the line's start
  0ADB'                         JL_LS:
  0ADB'   EB                    	XCHG
  0ADC'                         JL_GO:
  0ADC'   D5                    	PUSH	D		; DE = step from the line start
  0ADD'   CD 0000*              	CALL	CUROFF
  0AE0'   D1                    	POP	D
  0AE1'   19                    	DAD	D
  0AE2'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0AE5'   AF                    VC_W:	XRA	A
  0AE6'   32 2A8F'              	STA	WBIG
  0AE9'   C3 0AF1'              	JMP	WDO
  0AEC'   3E 01                 VCBGW:	MVI	A,1
  0AEE'   32 2A8F'              	STA	WBIG
  0AF1'   CD 07A0'              WDO:	CALL	SETMOV
  0AF4'   AF                    	XRA	A
  0AF5'   32 2A90'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AF8'   CD 06CB'              	CALL	GETCNT
  0AFB'   22 2AC7'              	SHLD	CNTV
  0AFE'   2A 2AC7'              WDO_LP: LHLD	CNTV
  0B01'   7C                    	MOV	A,H
  0B02'   B5                    	ORA	L
  0B03'   CA 0B10'              	JZ	WDO_DN
  0B06'   2B                    	DCX	H
  0B07'   22 2AC7'              	SHLD	CNTV
  0B0A'   CD 0B6D'              	CALL	FWD1
  0B0D'   D2 0AFE'              	JNC	WDO_LP
  0B10'                         WDO_DN:
  0B10'   CD 0A63'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B13'   DA 0B20'              	JC	WDO_NL
  0B16'   FE 0D                 	CPI	CR
  0B18'   CA 0B20'              	JZ	WDO_NL
  0B1B'   FE 0A                 	CPI	LF
  0B1D'   C2 05BD'              	JNZ	SETGL
  0B20'                         WDO_NL:
  0B20'   CD 0000*              	CALL	PEEKL
  0B23'   DA 05BD'              	JC	SETGL
  0B26'   FE 0A                 	CPI	LF
  0B28'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B2B'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B2D'   32 2A90'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B30'   CD 0C8C'              	CALL	DECC		; back onto its last char
  0B33'   C3 05BD'              	JMP	SETGL
                                
  0B36'   AF                    VC_B:	XRA	A
  0B37'   32 2A8F'              	STA	WBIG
  0B3A'   C3 0B42'              	JMP	BDO
  0B3D'   3E 01                 VCBGB:	MVI	A,1
  0B3F'   32 2A8F'              	STA	WBIG
  0B42'   CD 07A0'              BDO:	CALL	SETMOV
  0B45'   CD 06CB'              	CALL	GETCNT
  0B48'   22 2AC7'              	SHLD	CNTV
  0B4B'   CD 0BDD'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B4E'   D2 0B5E'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B51'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B52'   32 2AAF'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B55'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B58'                         BDO_LP:				;   its operator stands -- both as vim
  0B58'   CD 0BDD'              	CALL	BCK1
  0B5B'   DA 05BD'              	JC	SETGL
  0B5E'   2A 2AC7'              BDO_NX: LHLD	CNTV
  0B61'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B62'   22 2AC7'              	SHLD	CNTV
  0B65'   7C                    	MOV	A,H
  0B66'   B5                    	ORA	L
  0B67'   C2 0B58'              	JNZ	BDO_LP
  0B6A'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B6D'                         FWD1:
  0B6D'   CD 0C10'              	CALL	CCLS
  0B70'   32 2AD3'              	STA	WKCLS		; the starting class
  0B73'   CD 0C4A'              	CALL	INCC
  0B76'   B7                    	ORA	A
  0B77'   CA 0B90'              	JZ	FW_WD
  0B7A'   37                    	STC
  0B7B'   F8                    	RM			; -1: already at the end
  0B7C'   CD 0BC8'              	CALL	WLAST
  0B7F'   C8                    	RZ
  0B80'   FE 02                 	CPI	2
  0B82'   C2 0B90'              	JNZ	FW_WD		; 1: a next line was reached
  0B85'   CD 0A63'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B88'   D4 0C31'              	CNC	NXLN
  0B8B'   D2 0B90'              	JNC	FW_WD
  0B8E'   37                    	STC			; yes: failed
  0B8F'   C9                    	RET
  0B90'                         FW_WD:
  0B90'   3A 2AD3'              	LDA	WKCLS		; go past the rest of this word
  0B93'   B7                    	ORA	A
  0B94'   CA 0BB0'              	JZ	FW_WS
  0B97'                         FW_WLP:
  0B97'   CD 0C10'              	CALL	CCLS
  0B9A'   21 2AD3'              	LXI	H,WKCLS
  0B9D'   BE                    	CMP	M
  0B9E'   C2 0BB0'              	JNZ	FW_WS
  0BA1'   CD 0C4A'              	CALL	INCC
  0BA4'   B7                    	ORA	A
  0BA5'   F8                    	RM			; the end of the file (NC)
  0BA6'   CA 0B97'              	JZ	FW_WLP
  0BA9'   CD 0BC8'              	CALL	WLAST
  0BAC'   C8                    	RZ
  0BAD'   C3 0B97'              	JMP	FW_WLP
  0BB0'                         FW_WS:
  0BB0'   CD 0C10'              	CALL	CCLS		; then over blanks to the next word
  0BB3'   B7                    	ORA	A
  0BB4'   C0                    	RNZ
  0BB5'   CD 0C18'              	CALL	EMPTY
  0BB8'   C8                    	RZ			; an empty line is a word
  0BB9'   CD 0C4A'              	CALL	INCC
  0BBC'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BBD'   F8                    	RM
  0BBE'   CA 0BB0'              	JZ	FW_WS
  0BC1'   CD 0BC8'              	CALL	WLAST
  0BC4'   C8                    	RZ
  0BC5'   C3 0BB0'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BC8'                         WLAST:
  0BC8'   47                    	MOV	B,A
  0BC9'   2A 2AC7'              	LHLD	CNTV
  0BCC'   7C                    	MOV	A,H
  0BCD'   B5                    	ORA	L
  0BCE'   C2 0BD9'              	JNZ	WL_X		; words still owed
  0BD1'   3A 2AAF'              	LDA	PSAVE
  0BD4'   B7                    	ORA	A
  0BD5'   CA 0BDB'              	JZ	WL_NO		; a plain 'w'
  0BD8'   AF                    	XRA	A
  0BD9'   78                    WL_X:	MOV	A,B
  0BDA'   C9                    	RET
  0BDB'   B0                    WL_NO:	ORA	B
  0BDC'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BDD'                         BCK1:
  0BDD'   CD 0C8C'              	CALL	DECC
  0BE0'   B7                    	ORA	A
  0BE1'   37                    	STC
  0BE2'   F8                    	RM
  0BE3'                         BK_WS:
  0BE3'   CD 0C10'              	CALL	CCLS		; back over blanks
  0BE6'   B7                    	ORA	A
  0BE7'   C2 0BF7'              	JNZ	BK_WD
  0BEA'   CD 0C18'              	CALL	EMPTY
  0BED'   C8                    	RZ			; an empty line is a word
  0BEE'   CD 0C8C'              	CALL	DECC
  0BF1'   B7                    	ORA	A
  0BF2'   F2 0BE3'              	JP	BK_WS
  0BF5'   AF                    	XRA	A		; the start of the file (NC)
  0BF6'   C9                    	RET
  0BF7'                         BK_WD:
  0BF7'   32 2AD3'              	STA	WKCLS		; back to the start of this word
  0BFA'                         BK_WLP:
  0BFA'   CD 0C8C'              	CALL	DECC
  0BFD'   B7                    	ORA	A
  0BFE'   FA 0C0E'              	JM	BK_OK		; the start of the file
  0C01'   CD 0C10'              	CALL	CCLS
  0C04'   21 2AD3'              	LXI	H,WKCLS
  0C07'   BE                    	CMP	M
  0C08'   CA 0BFA'              	JZ	BK_WLP
  0C0B'   CD 0C4A'              	CALL	INCC		; overshot: forward one
  0C0E'                         BK_OK:
  0C0E'   AF                    	XRA	A
  0C0F'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C10'                         CCLS:
  0C10'   CD 0A63'              	CALL	ATEOF
  0C13'   D2 0755'              	JNC	CLASSF
  0C16'   AF                    	XRA	A
  0C17'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C18'                         EMPTY:
  0C18'   CD 0A63'              	CALL	ATEOF
  0C1B'   DA 0C26'              	JC	EM_ST
  0C1E'   FE 0D                 	CPI	CR
  0C20'   CA 0C26'              	JZ	EM_ST
  0C23'   FE 0A                 	CPI	LF
  0C25'   C0                    	RNZ
  0C26'                         EM_ST:
  0C26'   CD 0000*              	CALL	PEEKL
  0C29'   DA 0C2F'              	JC	EM_Y
  0C2C'   FE 0A                 	CPI	LF
  0C2E'   C9                    	RET
  0C2F'                         EM_Y:
  0C2F'   AF                    	XRA	A
  0C30'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C31'                         NXLN:
  0C31'   FE 0A                 	CPI	LF
  0C33'   CA 0C42'              	JZ	NX_LF
  0C36'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C39'   D8                    	RC
  0C3A'   FE 0A                 	CPI	LF
  0C3C'   CA 0C42'              	JZ	NX_LF
  0C3F'   2B                    	DCX	H		; a lone CR
  0C40'   AF                    	XRA	A
  0C41'   C9                    	RET
  0C42'                         NX_LF:
  0C42'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C45'   D8                    	RC
  0C46'   2B                    	DCX	H
  0C47'   3E 01                 	MVI	A,1
  0C49'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C4A'                         INCC:
  0C4A'   CD 0A63'              	CALL	ATEOF
  0C4D'   DA 0C88'              	JC	IC_END
  0C50'   FE 0D                 	CPI	CR
  0C52'   CA 0C73'              	JZ	IC_NL
  0C55'   FE 0A                 	CPI	LF
  0C57'   CA 0C73'              	JZ	IC_NL
  0C5A'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C5D'                         IC_CH:
  0C5D'   CD 0A63'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C60'   DA 0C6F'              	JC	IC_2
  0C63'   FE 0D                 	CPI	CR
  0C65'   CA 0C6F'              	JZ	IC_2
  0C68'   FE 0A                 	CPI	LF
  0C6A'   CA 0C6F'              	JZ	IC_2
  0C6D'   AF                    	XRA	A
  0C6E'   C9                    	RET
  0C6F'                         IC_2:
  0C6F'   3E 02                 	MVI	A,2
  0C71'   B7                    	ORA	A
  0C72'   C9                    	RET
  0C73'                         IC_NL:
  0C73'   CD 0C31'              	CALL	NXLN
  0C76'   DA 0C88'              	JC	IC_END
  0C79'   F5                    	PUSH	PSW
  0C7A'   CD 0000*              	CALL	PUTCUR
  0C7D'   F1                    	POP	PSW
  0C7E'   B7                    	ORA	A
  0C7F'   CA 0C5D'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C82'   CD 0CAE'              	CALL	LNINC
  0C85'   3E 01                 	MVI	A,1
  0C87'   C9                    	RET
  0C88'                         IC_END:
  0C88'   3E FF                 	MVI	A,0FFH
  0C8A'   B7                    	ORA	A
  0C8B'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C8C'                         DECC:
  0C8C'   CD 0000*              	CALL	PEEKL
  0C8F'   DA 0C88'              	JC	IC_END
  0C92'   F5                    	PUSH	PSW
  0C93'   CD 0000*              	CALL	PUTCUR
  0C96'   F1                    	POP	PSW
  0C97'   FE 0A                 	CPI	LF
  0C99'   3E 00                 	MVI	A,0
  0C9B'   C0                    	RNZ
  0C9C'   CD 0CBC'              	CALL	LNDEC
  0C9F'   CD 0000*              	CALL	PEEKL		; onto its CR
  0CA2'   DA 0CAA'              	JC	DC_1
  0CA5'   FE 0D                 	CPI	CR
  0CA7'   CC 0000*              	CZ	PUTCUR
  0CAA'                         DC_1:
  0CAA'   3E 01                 	MVI	A,1
  0CAC'   B7                    	ORA	A
  0CAD'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CAE'                         LNINC:
  0CAE'   E5                    	PUSH	H
  0CAF'   2A 0000*              	LHLD	LNDLT
  0CB2'   7C                    	MOV	A,H
  0CB3'   FE 40                 	CPI	40H
  0CB5'   CA 0CCA'              	JZ	LN_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CB8'   23                    	INX	H
  0CB9'   C3 0CC7'              	JMP	LN_ST
  0CBC'                         LNDEC:
  0CBC'   E5                    	PUSH	H
  0CBD'   2A 0000*              	LHLD	LNDLT
  0CC0'   7C                    	MOV	A,H
  0CC1'   FE C0                 	CPI	0C0H
  0CC3'   CA 0CCA'              	JZ	LN_X
  0CC6'   2B                    	DCX	H
  0CC7'                         LN_ST:
  0CC7'   22 0000*              	SHLD	LNDLT
  0CCA'                         LN_X:
  0CCA'   E1                    	POP	H
  0CCB'   C9                    	RET
                                
  0CCC'   AF                    VC_E:	XRA	A
  0CCD'   32 2A8F'              	STA	WBIG
  0CD0'   C3 0CD8'              	JMP	EDO
  0CD3'   3E 01                 VCBGE:	MVI	A,1
  0CD5'   32 2A8F'              	STA	WBIG
  0CD8'   CD 07A0'              EDO:	CALL	SETMOV
  0CDB'   CD 06CB'              	CALL	GETCNT
  0CDE'   22 2AC7'              	SHLD	CNTV
  0CE1'   2A 2AC7'              EDO_LP: LHLD	CNTV
  0CE4'   7C                    	MOV	A,H
  0CE5'   B5                    	ORA	L
  0CE6'   CA 0B10'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CE9'   2B                    	DCX	H
  0CEA'   22 2AC7'              	SHLD	CNTV
  0CED'   CD 0CFB'              	CALL	ESTEP
  0CF0'   21 2AB2'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CF3'   36 00                 	MVI	M,0
  0CF5'   D2 0CE1'              	JNC	EDO_LP
  0CF8'   C3 0B10'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0CFB'                         ESTEP:
  0CFB'   CD 0C10'              	CALL	CCLS
  0CFE'   32 2AD3'              	STA	WKCLS		; the starting class
  0D01'   CD 0C4A'              	CALL	INCC
  0D04'   B7                    	ORA	A
  0D05'   FA 0D2B'              	JM	ES_F
  0D08'   CD 0C10'              	CALL	CCLS
  0D0B'   B7                    	ORA	A
  0D0C'   CA 0D16'              	JZ	ES_ST
  0D0F'   21 2AD3'              	LXI	H,WKCLS
  0D12'   BE                    	CMP	M
  0D13'   CA 0D2D'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D16'                         ES_ST:
  0D16'   3A 2AB2'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D19'   B7                    	ORA	A		;   that char is the word's end already, and
  0D1A'   C2 0D44'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D1D'                         ES_WS:
  0D1D'   CD 0C10'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D20'   B7                    	ORA	A
  0D21'   C2 0D2D'              	JNZ	ES_SK
  0D24'   CD 0C4A'              	CALL	INCC
  0D27'   B7                    	ORA	A
  0D28'   F2 0D1D'              	JP	ES_WS
  0D2B'                         ES_F:
  0D2B'   37                    	STC
  0D2C'   C9                    	RET
  0D2D'                         ES_SK:
  0D2D'   CD 0C10'              	CALL	CCLS		; past the rest of this word ...
  0D30'   32 2AD3'              	STA	WKCLS
  0D33'                         ES_SL:
  0D33'   CD 0C4A'              	CALL	INCC
  0D36'   B7                    	ORA	A
  0D37'   FA 0D2B'              	JM	ES_F
  0D3A'   CD 0C10'              	CALL	CCLS
  0D3D'   21 2AD3'              	LXI	H,WKCLS
  0D40'   BE                    	CMP	M
  0D41'   CA 0D33'              	JZ	ES_SL
  0D44'   C3 0C8C'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D47'                         CURRW:
  0D47'   2A 0000*              	LHLD	WINROW
  0D4A'   EB                    	XCHG
  0D4B'   2A 0000*              	LHLD	LNDLT
  0D4E'   19                    	DAD	D		; HL = row (signed)
  0D4F'   7C                    	MOV	A,H
  0D50'   B7                    	ORA	A
  0D51'   FA 0D64'              	JM	CRW_0		; above the screen -> top row
  0D54'   C2 0D5F'              	JNZ	CRW_BT		; far below -> bottom row
  0D57'   3A 0000*              	LDA	NEDIT
  0D5A'   3D                    	DCR	A		; A = bottom row
  0D5B'   BD                    	CMP	L		; CY iff bottom < row
  0D5C'   D8                    	RC
  0D5D'   7D                    	MOV	A,L
  0D5E'   C9                    	RET
  0D5F'                         CRW_BT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D5F'   3A 0000*              	LDA	NEDIT
  0D62'   3D                    	DCR	A
  0D63'   C9                    	RET
  0D64'                         CRW_0:
  0D64'   AF                    	XRA	A
  0D65'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D66'                         SETRWT:
  0D66'   2A 0000*              	LHLD	LNDLT
  0D69'   EB                    	XCHG
  0D6A'   6F                    	MOV	L,A
  0D6B'   26 00                 	MVI	H,0
  0D6D'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D70'   22 0000*              	SHLD	WINROW
  0D73'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D74'                         MVROW:
  0D74'   47                    	MOV	B,A
  0D75'   CD 0D47'              	CALL	CURRW
  0D78'   90                    	SUB	B		; A = row now - target
  0D79'   C8                    	RZ
  0D7A'   DA 0D83'              	JC	MR_DN
  0D7D'   6F                    	MOV	L,A
  0D7E'   26 00                 	MVI	H,0
  0D80'   C3 09D2'              	JMP	KCORE
  0D83'                         MR_DN:
  0D83'   2F                    	CMA
  0D84'   3C                    	INR	A		; A = target - row now
  0D85'   6F                    	MOV	L,A
  0D86'   26 00                 	MVI	H,0
  0D88'   C3 0935'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D8B'                         VC_HIGH:
  0D8B'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0D8E'   2B                    	DCX	H		; row = count - 1
  0D8F'   7C                    	MOV	A,H
  0D90'   B7                    	ORA	A
  0D91'   3A 0000*              	LDA	SCBOT
  0D94'   C2 0D9C'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D97'   BD                    	CMP	L		; CY iff SCBOT < row
  0D98'   DA 0D9C'              	JC	VH_GO
  0D9B'   7D                    	MOV	A,L
  0D9C'                         VH_GO:
  0D9C'   CD 0D74'              	CALL	MVROW
  0D9F'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0DA2'                         VC_MIDL:
  0DA2'   CD 06B8'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0DA5'   3A 0000*              	LDA	SCBOT
  0DA8'   B7                    	ORA	A		; clear CY for the shift
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DA9'   1F                    	RAR			; A = SCBOT / 2
  0DAA'   CD 0D74'              	CALL	MVROW
  0DAD'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0DB0'                         VC_LOWL:
  0DB0'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DB3'   2B                    	DCX	H		; count - 1
  0DB4'   3A 0000*              	LDA	SCBOT
  0DB7'   5F                    	MOV	E,A
  0DB8'   16 00                 	MVI	D,0
  0DBA'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DBB'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DBE'   3E 00                 	MVI	A,0
  0DC0'   D2 0DC7'              	JNC	VL_GO		; at or past the top -> row 0
  0DC3'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0DC6'   7D                    	MOV	A,L
  0DC7'                         VL_GO:
  0DC7'   CD 0D74'              	CALL	MVROW
  0DCA'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0DCD'                         VC_PGDN:
  0DCD'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DD0'   3A 0000*              	LDA	SCEOF
  0DD3'   B7                    	ORA	A
  0DD4'   CA 0DE2'              	JZ	VPD_N
  0DD7'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0DDA'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0DDB'   C8                    	RZ			; it already is
  0DDC'   CD 0D74'              	CALL	MVROW
  0DDF'   C3 0DF3'              	JMP	VPD_TP
  0DE2'                         VPD_N:
  0DE2'   3A 0000*              	LDA	NEDIT
  0DE5'   D6 02                 	SUI	2
  0DE7'   CD 0E3B'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DEA'   E5                    	PUSH	H
  0DEB'   AF                    	XRA	A
  0DEC'   CD 0D74'              	CALL	MVROW		; the top line
  0DEF'   E1                    	POP	H
  0DF0'   CD 0935'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DF3'                         VPD_TP:
  0DF3'   AF                    	XRA	A
  0DF4'   CD 0D66'              	CALL	SETRWT		; to the top row
  0DF7'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DFA'                         VC_PGUP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DFA'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DFD'   3A 0000*              	LDA	SCBOF
  0E00'   B7                    	ORA	A
  0E01'   C0                    	RNZ
  0E02'   3A 0000*              	LDA	NEDIT
  0E05'   47                    	MOV	B,A
  0E06'   3A 0000*              	LDA	SCEOF
  0E09'   B7                    	ORA	A
  0E0A'   CA 0E1B'              	JZ	VPU_2
  0E0D'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0E10'   FE 02                 	CPI	2
  0E12'   D2 0E1B'              	JNC	VPU_2
  0E15'   2F                    	CMA
  0E16'   3C                    	INR	A
  0E17'   80                    	ADD	B
  0E18'   C3 0E1E'              	JMP	VPU_P
  0E1B'                         VPU_2:
  0E1B'   78                    	MOV	A,B
  0E1C'   D6 02                 	SUI	2
  0E1E'                         VPU_P:
  0E1E'   CD 0E3B'              	CALL	MULSAT		; HL = count * page
  0E21'   E5                    	PUSH	H
  0E22'   AF                    	XRA	A
  0E23'   CD 0D74'              	CALL	MVROW		; the top line
  0E26'   E1                    	POP	H
  0E27'   CD 09D2'              	CALL	KCORE		; the new top line
  0E2A'   AF                    	XRA	A
  0E2B'   CD 0D66'              	CALL	SETRWT		; on the top row
  0E2E'   3A 0000*              	LDA	NEDIT
  0E31'   3D                    	DCR	A
  0E32'   6F                    	MOV	L,A
  0E33'   26 00                 	MVI	H,0
  0E35'   CD 0935'              	CALL	JCORE		; the bottom row's line
  0E38'   C3 087A'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0E3B'                         MULSAT:
  0E3B'   EB                    	XCHG
  0E3C'   21 0000               	LXI	H,0
  0E3F'   B7                    	ORA	A
  0E40'   C8                    	RZ
  0E41'                         MS_LP:
  0E41'   19                    	DAD	D
  0E42'   DA 0E4A'              	JC	MS_SAT
  0E45'   3D                    	DCR	A
  0E46'   C2 0E41'              	JNZ	MS_LP
  0E49'   C9                    	RET
  0E4A'                         MS_SAT:
  0E4A'   21 FFFF               	LXI	H,0FFFFH
  0E4D'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E4E'                         VC_HFDN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E4E'   CD 07A0'              	CALL	SETMOV
  0E51'   CD 0D47'              	CALL	CURRW
  0E54'   32 2A91'              	STA	HFROW
  0E57'   CD 0EC5'              	CALL	HFCNT		; HL = lines
  0E5A'   3A 2A91'              	LDA	HFROW
  0E5D'   47                    	MOV	B,A
  0E5E'   3A 0000*              	LDA	SCEOF
  0E61'   B7                    	ORA	A
  0E62'   CA 0E6A'              	JZ	VHD_GO
  0E65'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E68'   B8                    	CMP	B
  0E69'   C8                    	RZ			; the cursor is on it
  0E6A'                         VHD_GO:
  0E6A'   CD 0935'              	CALL	JCORE
  0E6D'   3A 0000*              	LDA	SCEOF
  0E70'   B7                    	ORA	A
  0E71'   C2 087A'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E74'   3A 2A91'              	LDA	HFROW
  0E77'   CD 0D66'              	CALL	SETRWT
  0E7A'   3E 01                 	MVI	A,1
  0E7C'   32 0000*              	STA	WFILL		; not past the end of the file
  0E7F'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E82'                         VC_HFUP:
  0E82'   CD 07A0'              	CALL	SETMOV
  0E85'   CD 0D47'              	CALL	CURRW
  0E88'   32 2A91'              	STA	HFROW
  0E8B'   CD 0EC5'              	CALL	HFCNT		; HL = lines
  0E8E'   CD 0EA5'              	CALL	ONFST
  0E91'   C8                    	RZ			; the cursor is on the first line
  0E92'   CD 09D2'              	CALL	KCORE
  0E95'   3A 0000*              	LDA	SCBOF
  0E98'   B7                    	ORA	A
  0E99'   C2 087A'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E9C'   3A 2A91'              	LDA	HFROW
  0E9F'   CD 0D66'              	CALL	SETRWT
  0EA2'   C3 087A'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0EA5'                         ONFST:
  0EA5'   E5                    	PUSH	H
  0EA6'   2A 0000*              	LHLD	OUTPOS
  0EA9'   7C                    	MOV	A,H
  0EAA'   B5                    	ORA	L
  0EAB'   C2 0EC3'              	JNZ	OF_RET
  0EAE'   2A 0000*              	LHLD	TXTBEG
  0EB1'   EB                    	XCHG			; DE = TXTBEG
  0EB2'   2A 0000*              	LHLD	GAPBEG
  0EB5'                         OF_LP:
  0EB5'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EB8'   CA 0EC3'              	JZ	OF_RET
  0EBB'   2B                    	DCX	H
  0EBC'   7E                    	MOV	A,M
  0EBD'   FE 0A                 	CPI	LF
  0EBF'   C2 0EB5'              	JNZ	OF_LP
  0EC2'   B7                    	ORA	A		; NZ
  0EC3'                         OF_RET:
  0EC3'   E1                    	POP	H
  0EC4'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0EC5'                         HFCNT:
  0EC5'   2A 2A85'              	LHLD	CMDCNT
  0EC8'   7C                    	MOV	A,H
  0EC9'   B5                    	ORA	L
  0ECA'   CA 0EE1'              	JZ	HFC_AM
  0ECD'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  0ED0'   3A 0000*              	LDA	NEDIT
  0ED3'   5F                    	MOV	E,A
  0ED4'   16 00                 	MVI	D,0
  0ED6'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0ED9'   D2 0EDD'              	JNC	HFC_ST
  0EDC'   EB                    	XCHG			; HL = NEDIT
  0EDD'                         HFC_ST:
  0EDD'   7D                    	MOV	A,L
  0EDE'   32 2A92'              	STA	HFAMT
  0EE1'                         HFC_AM:
  0EE1'   3A 2A92'              	LDA	HFAMT
  0EE4'   B7                    	ORA	A
  0EE5'   C2 0EF2'              	JNZ	HFC_HL
  0EE8'   3A 0000*              	LDA	NEDIT
  0EEB'   B7                    	ORA	A
  0EEC'   1F                    	RAR
  0EED'   B7                    	ORA	A
  0EEE'   C2 0EF2'              	JNZ	HFC_HL
  0EF1'   3C                    	INR	A		; at least one line
  0EF2'                         HFC_HL:
  0EF2'   6F                    	MOV	L,A
  0EF3'   26 00                 	MVI	H,0
  0EF5'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EF6'                         VC_REDR:
  0EF6'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EF9'                         VC_G:
  0EF9'   CD 07A0'              	CALL	SETMOV
  0EFC'   CD 0FBB'              	CALL	GZONE		; the screen's top line, before the move
  0EFF'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  0F02'   2A 2A85'              	LHLD	CMDCNT
  0F05'   7C                    	MOV	A,H
  0F06'   B5                    	ORA	L
  0F07'   C2 0F1A'              	JNZ	VG_N
  0F0A'   AF                    	XRA	A		; forward
  0F0B'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0F0E'   CD 0731'              	CALL	BRKOFF
  0F11'   DA 0749'              	JC	BRKBAK
  0F14'   CD 0A69'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0F17'   C3 0FD3'              	JMP	GPLACE
  0F1A'                         VG_N:
  0F1A'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  0F1D'                         VG_LN:
  0F1D'   CD 0F29'              	CALL	GOLN
  0F20'   CD 0731'              	CALL	BRKOFF
  0F23'   DA 0749'              	JC	BRKBAK
  0F26'   C3 0FD3'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0F29'                         GOLN:
  0F29'   E5                    	PUSH	H
  0F2A'   CD 0000*              	CALL	CNTLF
  0F2D'   23                    	INX	H		; HL = the cursor's line
  0F2E'   D1                    	POP	D		; DE = the line wanted
  0F2F'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0F32'   DA 0F3D'              	JC	GLN_BK
  0F35'   EB                    	XCHG
  0F36'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0F39'   AF                    	XRA	A
  0F3A'   C3 0F42'              	JMP	GLN_MV
  0F3D'                         GLN_BK:
  0F3D'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0F40'   3E FF                 	MVI	A,0FFH
  0F42'                         GLN_MV:
  0F42'   CD 0000*              	CALL	MVLIND
  0F45'   CD 0A63'              	CALL	ATEOF
  0F48'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  0F4B'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F4C'                         VC_LG:
  0F4C'   CD 07A0'              	CALL	SETMOV
  0F4F'   3A 2AAD'              	LDA	GSAVE
  0F52'   B7                    	ORA	A
  0F53'   C2 0F5C'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F56'   3E 01                 	MVI	A,PG
  0F58'   32 2AAC'              	STA	GPEND
  0F5B'   C9                    	RET
  0F5C'                         VLG_GG:
  0F5C'   CD 0FBB'              	CALL	GZONE
  0F5F'   CD 06F4'              	CALL	BRKON
  0F62'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F65'   C3 0F1D'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F68'                         SUB24:
  0F68'   4F                    	MOV	C,A
  0F69'   7D                    	MOV	A,L
  0F6A'   93                    	SUB	E
  0F6B'   6F                    	MOV	L,A
  0F6C'   7C                    	MOV	A,H
  0F6D'   9A                    	SBB	D
  0F6E'   67                    	MOV	H,A
  0F6F'   79                    	MOV	A,C
  0F70'   98                    	SBB	B
  0F71'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F72'                         CURFP:
  0F72'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F75'                         FPOS:
  0F75'   C5                    	PUSH	B
  0F76'   D5                    	PUSH	D
  0F77'   EB                    	XCHG
  0F78'   2A 0000*              	LHLD	TXTBEG
  0F7B'   EB                    	XCHG
  0F7C'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F7F'   EB                    	XCHG			; DE = that
  0F80'   2A 0000*              	LHLD	OUTPOS
  0F83'   7C                    	MOV	A,H
  0F84'   B7                    	ORA	A		; CY = 0
  0F85'   1F                    	RAR
  0F86'   47                    	MOV	B,A
  0F87'   7D                    	MOV	A,L
  0F88'   1F                    	RAR
  0F89'   67                    	MOV	H,A
  0F8A'   3E 00                 	MVI	A,0
  0F8C'   1F                    	RAR
  0F8D'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F8E'   19                    	DAD	D
  0F8F'   78                    	MOV	A,B
  0F90'   CE 00                 	ACI	0		; A:HL = the position
  0F92'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F93'   C1                    	POP	B
  0F94'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F95'                         ZSAVE:
  0F95'   2A 2A85'              	LHLD	CMDCNT
  0F98'   22 2AEB'              	SHLD	ZSVCNT
  0F9B'   2A 0000*              	LHLD	AUXCNT
  0F9E'   22 2AED'              	SHLD	ZSVAUX
  0FA1'   3A 0000*              	LDA	DIRFLG
  0FA4'   32 2AEF'              	STA	ZSVDIR
  0FA7'   C9                    	RET
  0FA8'                         ZREST:
  0FA8'   2A 2AEB'              	LHLD	ZSVCNT
  0FAB'   22 2A85'              	SHLD	CMDCNT
  0FAE'   2A 2AED'              	LHLD	ZSVAUX
  0FB1'   22 0000*              	SHLD	AUXCNT
  0FB4'   3A 2AEF'              	LDA	ZSVDIR
  0FB7'   32 0000*              	STA	DIRFLG
  0FBA'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0FBB'                         GZONE:
  0FBB'   CD 0F95'              	CALL	ZSAVE
  0FBE'   CD 0D47'              	CALL	CURRW
  0FC1'   6F                    	MOV	L,A
  0FC2'   26 00                 	MVI	H,0
  0FC4'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0FC7'   CD 0F75'              	CALL	FPOS
  0FCA'   22 0000*              	SHLD	ZTOP
  0FCD'   32 0002*              	STA	ZTOP+2
  0FD0'   C3 0FA8'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0FD3'                         GPLACE:
  0FD3'   CD 0F95'              	CALL	ZSAVE
  0FD6'   CD 0F72'              	CALL	CURFP
  0FD9'   EB                    	XCHG
  0FDA'   2A 0000*              	LHLD	ZTOP
  0FDD'   EB                    	XCHG
  0FDE'   4F                    	MOV	C,A		; C:HL = the target's position
  0FDF'   3A 0002*              	LDA	ZTOP+2
  0FE2'   47                    	MOV	B,A		; B:DE = the top's
  0FE3'   79                    	MOV	A,C
  0FE4'   CD 0F68'              	CALL	SUB24
  0FE7'   22 2AE8'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0FEA'   DA 1037'              	JC	GP_UP
  0FED'   B7                    	ORA	A
  0FEE'   C2 1078'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FF1'   3A 0000*              	LDA	NEDIT
  0FF4'   5F                    	MOV	E,A
  0FF5'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FF7'   B7                    	ORA	A
  0FF8'   1F                    	RAR
  0FF9'   6F                    	MOV	L,A
  0FFA'   26 00                 	MVI	H,0
  0FFC'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FFD'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1000'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  1003'   EB                    	XCHG
  1004'   2A 2AE8'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1007'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  100A'   DA 1078'              	JC	GP_MID
  100D'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  1010'   01 0000               	LXI	B,0		; BC = lines from the top
  1013'                         GP_CNT:
  1013'   7A                    	MOV	A,D
  1014'   B3                    	ORA	E
  1015'   CA 1024'              	JZ	GP_DN
  1018'   7E                    	MOV	A,M
  1019'   23                    	INX	H
  101A'   1B                    	DCX	D
  101B'   FE 0A                 	CPI	LF
  101D'   C2 1013'              	JNZ	GP_CNT
  1020'   03                    	INX	B
  1021'   C3 1013'              	JMP	GP_CNT
  1024'                         GP_DN:
  1024'   3A 0000*              	LDA	NEDIT
  1027'   3D                    	DCR	A
  1028'   5F                    	MOV	E,A
  1029'   16 00                 	MVI	D,0		; DE = the bottom row
  102B'   60                    	MOV	H,B
  102C'   69                    	MOV	L,C
  102D'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  1030'   DA 1082'              	JC	GP_SET		; A = the bottom row
  1033'   7D                    	MOV	A,L		; on the screen: its row
  1034'   C3 10A2'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1037'                         GP_UP:
  1037'   3C                    	INR	A
  1038'   C2 1078'              	JNZ	GP_MID		; 64K bytes or more above
  103B'   2A 2AE8'              	LHLD	ZDIF
  103E'   EB                    	XCHG
  103F'   21 0000               	LXI	H,0
  1042'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1045'   7C                    	MOV	A,H
  1046'   B5                    	ORA	L
  1047'   CA 1078'              	JZ	GP_MID		; exactly 64K
  104A'   EB                    	XCHG			; DE = bytes to read
  104B'   AF                    	XRA	A
  104C'   32 2AEA'              	STA	ZLF
  104F'   CD 0000*              	CALL	RGET0
  1052'                         GP_RD:
  1052'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1055'   DA 1078'              	JC	GP_MID
  1058'   FE 0A                 	CPI	LF
  105A'   C2 106E'              	JNZ	GP_RN
  105D'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1060'   B7                    	ORA	A
  1061'   1F                    	RAR
  1062'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1064'   E5                    	PUSH	H
  1065'   21 2AEA'              	LXI	H,ZLF
  1068'   34                    	INR	M
  1069'   BE                    	CMP	M		; CY iff more lines than that
  106A'   E1                    	POP	H
  106B'   DA 1078'              	JC	GP_MID
  106E'                         GP_RN:
  106E'   1B                    	DCX	D
  106F'   7A                    	MOV	A,D
  1070'   B3                    	ORA	E
  1071'   C2 1052'              	JNZ	GP_RD
  1074'   AF                    	XRA	A		; the top row
  1075'   C3 1082'              	JMP	GP_SET
  1078'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1078'   3E 02                 	MVI	A,2
  107A'   32 0000*              	STA	WFILL		; SCRN.MAC WF_MID: mid-screen, as the rows fall
  107D'   3A 0000*              	LDA	NEDIT
  1080'   B7                    	ORA	A
  1081'   1F                    	RAR			; (no more lines above it than this)
  1082'                         GP_SET:
  1082'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1083'   26 00                 	MVI	H,0
  1085'   22 0000*              	SHLD	WINROW
  1088'   21 0000               	LXI	H,0
  108B'   22 0000*              	SHLD	LNDLT
  108E'   CD 07C1'              	CALL	SETFUL		; the window may have paged: full repaint
  1091'                         GP_FIN:
  1091'   CD 0FA8'              	CALL	ZREST
  1094'   3A 2B13'              	LDA	GPKEEP
  1097'   B7                    	ORA	A
  1098'   CA 087A'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  109B'   AF                    	XRA	A
  109C'   32 2B13'              	STA	GPKEEP
  109F'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  10A2'                         GP_ONS:
  10A2'   6F                    	MOV	L,A
  10A3'   26 00                 	MVI	H,0		; HL = the row it lands on
  10A5'   EB                    	XCHG
  10A6'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  10A9'   EB                    	XCHG
  10AA'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  10AD'   22 0000*              	SHLD	LNDLT
  10B0'   3E 01                 	MVI	A,R_MOVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10B2'   32 2A89'              	STA	RINTENT
  10B5'   C3 1091'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  10B8'                         OPPEND:
  10B8'   AF                    	XRA	A
  10B9'   32 2AB2'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  10BC'   3A 2AAF'              	LDA	PSAVE
  10BF'   FE 63                 	CPI	'c'
  10C1'   C2 10DE'              	JNZ	OPP_ND
  10C4'   79                    	MOV	A,C
  10C5'   FE 77                 	CPI	'w'
  10C7'   CA 10CF'              	JZ	OPP_W
  10CA'   FE 57                 	CPI	'W'
  10CC'   C2 10DE'              	JNZ	OPP_ND
  10CF'                         OPP_W:
  10CF'   CD 12B1'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  10D2'   DA 10DE'              	JC	OPP_ND
  10D5'   79                    	MOV	A,C
  10D6'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  10D8'   4F                    	MOV	C,A
  10D9'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  10DB'   32 2AB2'              	STA	CWEOL		;   char for the next word's: see ESTEP
  10DE'                         OPP_ND:
  10DE'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  10DF'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  10E1'   C2 10F5'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  10E4'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  10E7'   DA 1185'              	JC	OPABRT
  10EA'   79                    	MOV	A,C
  10EB'   FE 67                 	CPI	'g'
  10ED'   C2 1185'              	JNZ	OPABRT
  10F0'   3E 01                 	MVI	A,PG
  10F2'   32 2AAD'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10F5'                         OPP_NG:
  10F5'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10F6'   21 2AAF'              	LXI	H,PSAVE
  10F9'   BE                    	CMP	M
  10FA'   CA 12D2'              	JZ	OPLINE
  10FD'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10FE'   CD 12E8'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1101'   DA 1185'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1104'   32 2AB1'              	STA	OPCLSV
  1107'   47                    	MOV	B,A		; B = the class
  1108'   3A 2AAF'              	LDA	PSAVE
  110B'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  110D'   C2 1119'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1110'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1111'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1113'   C2 113B'              	JNZ	OPP_GO
  1116'   C3 1124'              	JMP	OPP_NO
  1119'                         OPP_NC:
  1119'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  111B'   C2 113B'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  111E'   78                    	MOV	A,B		;   a charwise register would need a type flag
  111F'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1121'   CA 113B'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1124'                         OPP_NO:
  1124'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1125'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1127'   CA 1135'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  112A'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  112C'   CA 1135'              	JZ	OPP_SW		;   so swallow it before dropping the command
  112F'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1132'   C2 1185'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1135'                         OPP_SW:
  1135'   CD 01F9'              	CALL	MKGETK
  1138'   C3 1185'              	JMP	OPABRT
  113B'                         OPP_GO:
  113B'   AF                    	XRA	A
  113C'   32 2A90'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  113F'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1142'   22 2AB3'              	SHLD	OPSTA
  1145'   C5                    	PUSH	B
  1146'   21 2AB7'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1149'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  114C'   3A 2AB1'              	LDA	OPCLSV
  114F'   FE 02                 	CPI	2
  1151'   CC 1188'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1154'   C1                    	POP	B
  1155'   21 29CC'              	LXI	H,CMDTAB
  1158'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  115B'   3A 2AAF'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  115E'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  115F'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1162'   CD 11B4'              	CALL	OPSFIX		; where the start is in the window NOW
  1165'   D2 11D0'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1168'   22 2AB3'              	SHLD	OPSTA
  116B'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  116E'   22 2AB5'              	SHLD	OPEND2
  1171'   3A 2AAF'              	LDA	PSAVE
  1174'   FE 79                 	CPI	'y'
  1176'   CA 183E'              	JZ	OPYANK		; a yank takes the span without losing it
  1179'   CD 1323'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  117C'   3A 2AAF'              	LDA	PSAVE
  117F'   FE 63                 	CPI	'c'
  1181'   C0                    	RNZ
  1182'   C3 15F7'              	JMP	SETINS
  1185'                         OPABRT:				; not a motion -> the operator is dropped and
  1185'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1188'                         OPENDS:
  1188'   2A 2AB3'              	LHLD	OPSTA
  118B'   CD 0624'              	CALL	BOL
  118E'   11 2ABA'              	LXI	D,OPSLO
  1191'   CD 11A6'              	CALL	OPE_ST
  1194'   2A 2AB3'              	LHLD	OPSTA
  1197'   CD 0654'              	CALL	NLSTART
  119A'   11 2ABD'              	LXI	D,OPSHI
  119D'   CD 11A6'              	CALL	OPE_ST
  11A0'   2A 2AB3'              	LHLD	OPSTA
  11A3'   C3 0000*              	JMP	GOTO
  11A6'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  11A6'   D5                    	PUSH	D
  11A7'   CD 0000*              	CALL	GOTO
  11AA'   E1                    	POP	H
  11AB'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  11AE'                         CURBD:
  11AE'   CD 0F72'              	CALL	CURFP
  11B1'   EB                    	XCHG
  11B2'   47                    	MOV	B,A
  11B3'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  11B4'                         OPSFIX:
  11B4'   21 2AB7'              	LXI	H,OPSFP
  11B7'   CD 03DC'              	CALL	MKLOAD
  11BA'   CD 11AE'              	CALL	CURBD
  11BD'   2A 2B1D'              	LHLD	MKPOS
  11C0'   3A 2B1F'              	LDA	MKPOS+2
  11C3'   CD 0F68'              	CALL	SUB24
  11C6'   B4                    	ORA	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11C7'   B5                    	ORA	L
  11C8'   C2 03E9'              	JNZ	MKWIN
  11CB'   CD 0000*              	CALL	CUROFF
  11CE'   37                    	STC
  11CF'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  11D0'                         OPPGD:
  11D0'   47                    	MOV	B,A
  11D1'   3A 2AB1'              	LDA	OPCLSV
  11D4'   FE 02                 	CPI	2
  11D6'   C2 1292'              	JNZ	OPG_NO
  11D9'   3A 2AAF'              	LDA	PSAVE
  11DC'   FE 64                 	CPI	'd'
  11DE'   C2 1292'              	JNZ	OPG_NO
  11E1'   04                    	INR	B
  11E2'   CA 11F1'              	JZ	OPG_FW
  11E5'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11E8'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11EB'   CD 0000*              	CALL	GOTO
  11EE'   C3 1209'              	JMP	OPG_GO
  11F1'                         OPG_FW:
  11F1'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11F4'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  11F7'   11 2ABD'              	LXI	D,OPSHI		;   start line began
  11FA'   CD 11A6'              	CALL	OPE_ST
  11FD'   21 2ABA'              	LXI	H,OPSLO
  1200'   CD 03DC'              	CALL	MKLOAD
  1203'   CD 03A9'              	CALL	MKPAGE
  1206'   CD 0000*              	CALL	GOTO
  1209'                         OPG_GO:
  1209'   CD 11AE'              	CALL	CURBD
  120C'   2A 2ABD'              	LHLD	OPSHI
  120F'   3A 2ABF'              	LDA	OPSHI+2
  1212'   CD 0F68'              	CALL	SUB24		; A:HL = the bytes to take
  1215'                         OPG_SV:
  1215'   22 2AC0'              	SHLD	OPTOGO
  1218'   32 2AC2'              	STA	OPTOGO+2
  121B'                         OPG_NX:
  121B'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  121E'   CD 0000*              	CALL	SUBHD
  1221'   EB                    	XCHG			; DE = what the window holds past the cursor
  1222'   2A 2AC0'              	LHLD	OPTOGO
  1225'   3A 2AC2'              	LDA	OPTOGO+2
  1228'   B7                    	ORA	A
  1229'   C2 125C'              	JNZ	OPG_PG		; 64K or more to go
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  122C'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  122F'   DA 125C'              	JC	OPG_PG
  1232'   CA 125C'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1235'                         OPG_FN:				; the rest of it is here
  1235'   E5                    	PUSH	H
  1236'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1239'   CD 0000*              	CALL	CUROFF
  123C'   22 2AC3'              	SHLD	OPLO
  123F'   D1                    	POP	D
  1240'   19                    	DAD	D
  1241'   22 2AC5'              	SHLD	OPHI
  1244'   CD 1456'              	CALL	OPDSPN
  1247'   CD 0A63'              	CALL	ATEOF
  124A'   D2 12AB'              	JNC	OPMID
  124D'   CD 0EA5'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1250'   CA 12AB'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1253'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1256'   CD 0000*              	CALL	SETBWD
  1259'   C3 12AB'              	JMP	OPMID
  125C'                         OPG_PG:
  125C'   7A                    	MOV	A,D
  125D'   B3                    	ORA	E
  125E'   C2 1277'              	JNZ	OPG_DL
  1261'   CD 0A63'              	CALL	ATEOF		; nothing held past the cursor
  1264'   21 0000               	LXI	H,0
  1267'   DA 1235'              	JC	OPG_FN		; ... and no more to come: the file ran out
  126A'   2B                    	DCX	H
  126B'   CD 0000*              	CALL	SETC0
  126E'   CD 0000*              	CALL	GOLINE
  1271'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1274'   C3 121B'              	JMP	OPG_NX
  1277'                         OPG_DL:
  1277'   D5                    	PUSH	D
  1278'   21 FFFF               	LXI	H,0FFFFH
  127B'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  127E'   E1                    	POP	H
  127F'   E5                    	PUSH	H
  1280'   CD 0000*              	CALL	DELFWD
  1283'   D1                    	POP	D
  1284'   06 00                 	MVI	B,0
  1286'   2A 2AC0'              	LHLD	OPTOGO
  1289'   3A 2AC2'              	LDA	OPTOGO+2
  128C'   CD 0F68'              	CALL	SUB24
  128F'   C3 1215'              	JMP	OPG_SV
  1292'                         OPG_NO:
  1292'   0E 07                 	MVI	C,BEL
  1294'   CD 0000*              	CALL	BCONOU
  1297'                         OPG_HM:				; the cursor back where the command found it
  1297'   21 2AB7'              	LXI	H,OPSFP
  129A'   CD 03DC'              	CALL	MKLOAD
  129D'   CD 03A9'              	CALL	MKPAGE
  12A0'   CD 0000*              	CALL	GOTO
  12A3'   AF                    	XRA	A
  12A4'   32 2AAF'              	STA	PSAVE
  12A7'   3C                    	INR	A
  12A8'   32 2B13'              	STA	GPKEEP		; the column it had, not the first non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  12AB'                         OPMID:
  12AB'   CD 0F95'              	CALL	ZSAVE
  12AE'   C3 1078'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  12B1'                         ONWHIT:
  12B1'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12B4'   CA 12D0'              	JZ	OW_YES
  12B7'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  12BA'   FE 20                 	CPI	' '
  12BC'   CA 12D0'              	JZ	OW_YES
  12BF'   FE 09                 	CPI	TAB
  12C1'   CA 12D0'              	JZ	OW_YES
  12C4'   FE 0D                 	CPI	CR
  12C6'   CA 12D0'              	JZ	OW_YES
  12C9'   FE 0A                 	CPI	LF
  12CB'   CA 12D0'              	JZ	OW_YES
  12CE'   B7                    	ORA	A		; a char to change: CY clear
  12CF'   C9                    	RET
  12D0'                         OW_YES:
  12D0'   37                    	STC
  12D1'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  12D2'                         OPLINE:
  12D2'   3A 2AAF'              	LDA	PSAVE
  12D5'   FE 63                 	CPI	'c'
  12D7'   CA 07A0'              	JZ	SETMOV
  12DA'   FE 79                 	CPI	'y'
  12DC'   CA 181D'              	JZ	VY_YY
  12DF'   21 2AB7'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  12E2'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  12E5'   C3 1793'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12E8'                         OPCLS:
  12E8'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12EA'   CA 12F7'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12ED'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12EF'   C2 130B'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12F2'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12F4'   C3 12F9'              	JMP	OPC_FK
  12F7'                         OPC_SEM:
  12F7'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12F9'                         OPC_FK:
  12F9'   3A 2B09'              	LDA	FNDKND
  12FC'   B7                    	ORA	A
  12FD'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12FE'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12FF'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1300'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1302'   CA 1309'              	JZ	OPC_EXC
  1305'   3E 01                 	MVI	A,1
  1307'   B7                    	ORA	A		; CY clear: a motion, class 1
  1308'   C9                    	RET
  1309'                         OPC_EXC:
  1309'   AF                    	XRA	A		; class 0, CY clear
  130A'   C9                    	RET
  130B'                         OPC_TB:
  130B'   47                    	MOV	B,A
  130C'   21 14EB'              	LXI	H,OPCTAB
  130F'                         OPC_LP:
  130F'   7E                    	MOV	A,M
  1310'   B7                    	ORA	A
  1311'   CA 1321'              	JZ	OPC_MS		; end of table -> not a motion
  1314'   B8                    	CMP	B
  1315'   CA 131D'              	JZ	OPC_HT
  1318'   23                    	INX	H
  1319'   23                    	INX	H
  131A'   C3 130F'              	JMP	OPC_LP
  131D'                         OPC_HT:
  131D'   23                    	INX	H
  131E'   7E                    	MOV	A,M		; class byte
  131F'   B7                    	ORA	A		; clear CY
  1320'   C9                    	RET
  1321'                         OPC_MS:
  1321'   37                    	STC
  1322'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1323'                         OPAPPL:
  1323'   3A 2AB1'              	LDA	OPCLSV
  1326'   FE 02                 	CPI	2
  1328'   CA 14BF'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  132B'   2A 2AB3'              	LHLD	OPSTA
  132E'   EB                    	XCHG			; DE = start
  132F'   2A 2AB5'              	LHLD	OPEND2		; HL = end
  1332'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1335'   DA 1348'              	JC	OPA_F
  1338'   CA 1348'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  133B'   22 2AC3'              	SHLD	OPLO
  133E'   EB                    	XCHG
  133F'   22 2AC5'              	SHLD	OPHI
  1342'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1345'   C3 13FF'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1348'                         OPA_F:
  1348'   EB                    	XCHG			; HL = start, DE = end
  1349'   22 2AC3'              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  134C'   EB                    	XCHG			; HL = end
  134D'   3A 2AB1'              	LDA	OPCLSV
  1350'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1352'   CA 13FC'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1355'   FE 01                 	CPI	1
  1357'   C2 1379'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  135A'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  135B'   22 2AC5'              	SHLD	OPHI		; park it: CEND clobbers DE
  135E'   2B                    	DCX	H		; the line it landed on
  135F'   CD 1575'              	CALL	CEND		; HL = that line's content end
  1362'   EB                    	XCHG			; DE = it
  1363'   2A 2AC5'              	LHLD	OPHI		; HL = hi
  1366'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1369'   D2 1384'              	JNC	OPA_HI		; hi is inside the line: keep it
  136C'   2A 2AC3'              	LHLD	OPLO
  136F'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1372'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1375'   EB                    	XCHG			; HL = the content end: the span stops there
  1376'   C3 1384'              	JMP	OPA_HI
  1379'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1379'   22 2AC5'              	SHLD	OPHI
  137C'   3A 2A90'              	LDA	WPULL
  137F'   B7                    	ORA	A
  1380'   CA 13FF'              	JZ	OPA_C1
  1383'   23                    	INX	H
  1384'                         OPA_HI:
  1384'   22 2AC5'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1387'                         OPA_DO:
  1387'   CD 144B'              	CALL	OPSPNL
  138A'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  138B'   B5                    	ORA	L
  138C'   C2 1395'              	JNZ	OPA_D1
  138F'   2A 2AC3'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1392'   C3 0000*              	JMP	GOTO		;   to where the span starts
  1395'                         OPA_D1:
  1395'   3A 2AAF'              	LDA	PSAVE
  1398'   FE 63                 	CPI	'c'
  139A'   CA 1456'              	JZ	OPDSPN
  139D'   CD 143E'              	CALL	SPNBRK
  13A0'   D2 13C1'              	JNC	OPA_D2
  13A3'   2A 2AC5'              	LHLD	OPHI
  13A6'   CD 1575'              	CALL	CEND
  13A9'   EB                    	XCHG			; DE = the content end of the line it ends in
  13AA'   2A 2AC5'              	LHLD	OPHI
  13AD'                         OPA_BL:
  13AD'   CD 0000*              	CALL	CMP16
  13B0'   CA 13C7'              	JZ	OPA_BI		; only blanks after it
  13B3'   D5                    	PUSH	D
  13B4'   E5                    	PUSH	H
  13B5'   CD 0000*              	CALL	CHARAT
  13B8'   E1                    	POP	H
  13B9'   D1                    	POP	D
  13BA'   23                    	INX	H
  13BB'   CD 13F6'              	CALL	BLANKQ
  13BE'   CA 13AD'              	JZ	OPA_BL
  13C1'                         OPA_D2:
  13C1'   CD 1456'              	CALL	OPDSPN
  13C4'   C3 1586'              	JMP	CLAMPE
  13C7'                         OPA_BI:
  13C7'   CD 13D9'              	CALL	LOIND
  13CA'   C2 13C1'              	JNZ	OPA_D2
  13CD'   2A 2AC5'              	LHLD	OPHI
  13D0'   CD 0654'              	CALL	NLSTART
  13D3'   22 2AC5'              	SHLD	OPHI
  13D6'   C3 142A'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  13D9'                         LOIND:
  13D9'   2A 2AC3'              	LHLD	OPLO
  13DC'   CD 0624'              	CALL	BOL
  13DF'                         LI_LP:
  13DF'   E5                    	PUSH	H
  13E0'   EB                    	XCHG
  13E1'   2A 2AC3'              	LHLD	OPLO
  13E4'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  13E7'   E1                    	POP	H
  13E8'   C8                    	RZ
  13E9'   E5                    	PUSH	H
  13EA'   CD 0000*              	CALL	CHARAT
  13ED'   E1                    	POP	H
  13EE'   23                    	INX	H
  13EF'   CD 13F6'              	CALL	BLANKQ
  13F2'   CA 13DF'              	JZ	LI_LP
  13F5'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  13F6'                         BLANKQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13F6'   FE 20                 	CPI	' '
  13F8'   C8                    	RZ
  13F9'   FE 09                 	CPI	TAB
  13FB'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  13FC'                         OPA_JP:
  13FC'   22 2AC5'              	SHLD	OPHI
  13FF'                         OPA_C1:
  13FF'   CD 144B'              	CALL	OPSPNL
  1402'   7C                    	MOV	A,H
  1403'   B5                    	ORA	L
  1404'   CA 1387'              	JZ	OPA_DO		; nothing spanned
  1407'   2A 2AC5'              	LHLD	OPHI
  140A'   CD 0624'              	CALL	BOL
  140D'   EB                    	XCHG
  140E'   2A 2AC5'              	LHLD	OPHI
  1411'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1414'   C2 1387'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1417'   CD 13D9'              	CALL	LOIND
  141A'   CA 142A'              	JZ	C1_LW		; only blanks before lo: whole lines
  141D'                         C1_CH:
  141D'   2A 2AC5'              	LHLD	OPHI		; back over the line break to the content end
  1420'   2B                    	DCX	H		;   of the line before
  1421'   CD 1575'              	CALL	CEND
  1424'   22 2AC5'              	SHLD	OPHI
  1427'   C3 1387'              	JMP	OPA_DO
  142A'                         C1_LW:
  142A'   2A 2AC3'              	LHLD	OPLO
  142D'   CD 0624'              	CALL	BOL
  1430'   22 2AC3'              	SHLD	OPLO
  1433'   3A 2AAF'              	LDA	PSAVE
  1436'   FE 63                 	CPI	'c'
  1438'   CA 141D'              	JZ	C1_CH
  143B'   C3 14D2'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  143E'                         SPNBRK:
  143E'   2A 2AC3'              	LHLD	OPLO
  1441'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1444'   EB                    	XCHG			; DE = it
  1445'   2A 2AC5'              	LHLD	OPHI
  1448'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  144B'                         OPSPNL:
  144B'   2A 2AC5'              	LHLD	OPHI
  144E'   EB                    	XCHG
  144F'   2A 2AC3'              	LHLD	OPLO
  1452'   EB                    	XCHG			; HL = hi, DE = lo
  1453'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1456'                         OPDSPN:
  1456'   CD 143E'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1459'   F5                    	PUSH	PSW
  145A'   2A 2AC3'              	LHLD	OPLO
  145D'   CD 0000*              	CALL	GOTO
  1460'   CD 144B'              	CALL	OPSPNL		; HL = hi - lo
  1463'   CD 0000*              	CALL	DELFWD
  1466'   CD 0174'              	CALL	MARKMOD
  1469'   F1                    	POP	PSW
  146A'   DA 07C1'              	JC	SETFUL		; a break went: every row below it moved up
  146D'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1470'                         UNDFNB:
  1470'   CD 0000*              	CALL	CUROFF
  1473'   E5                    	PUSH	H
  1474'   CD 087A'              	CALL	FNBLNK
  1477'   CD 0000*              	CALL	CUROFF
  147A'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  147B'   CD 0000*              	CALL	CMP16
  147E'   D2 0000*              	JNC	UNDHER
  1481'   EB                    	XCHG
  1482'   CD 0000*              	CALL	GOTO
  1485'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1488'                         OPALSP:
  1488'   2A 2AB3'              	LHLD	OPSTA
  148B'   EB                    	XCHG
  148C'   2A 2AB5'              	LHLD	OPEND2
  148F'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1492'   DA 14A2'              	JC	OPAL_F
  1495'   22 2AC3'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1498'   EB                    	XCHG
  1499'   22 2AC5'              	SHLD	OPHI		; hi-src = start
  149C'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  149F'   C3 14AC'              	JMP	OPAL_R
  14A2'                         OPAL_F:
  14A2'   EB                    	XCHG			; HL = start
  14A3'   22 2AC3'              	SHLD	OPLO		; lo-src = start
  14A6'   2A 2AB5'              	LHLD	OPEND2
  14A9'   22 2AC5'              	SHLD	OPHI		; hi-src = end
  14AC'                         OPAL_R:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14AC'   2A 2AC3'              	LHLD	OPLO
  14AF'   CD 0624'              	CALL	BOL
  14B2'   22 2AC3'              	SHLD	OPLO		; lo = BOL(low line)
  14B5'   2A 2AC5'              	LHLD	OPHI
  14B8'   CD 0654'              	CALL	NLSTART
  14BB'   22 2AC5'              	SHLD	OPHI		; hi = start of line past the high line
  14BE'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  14BF'                         OPALIN:
  14BF'   CD 1488'              	CALL	OPALSP
  14C2'   2A 2AC3'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  14C5'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  14C8'   EB                    	XCHG			;   the column)
  14C9'   2A 2AC5'              	LHLD	OPHI
  14CC'   CD 0000*              	CALL	CMP16
  14CF'   CC 1470'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  14D2'                         OPDLIN:
  14D2'   CD 1456'              	CALL	OPDSPN
  14D5'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  14D8'   DA 14E8'              	JC	OPDL_NB
  14DB'   CD 0000*              	CALL	LOGLEN
  14DE'   7C                    	MOV	A,H
  14DF'   B5                    	ORA	L
  14E0'   C8                    	RZ			; empty buffer
  14E1'   2B                    	DCX	H
  14E2'   CD 0624'              	CALL	BOL
  14E5'   CD 0000*              	CALL	GOTO
  14E8'                         OPDL_NB:
  14E8'   C3 087A'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  14EB'                         OPCTAB:
  14EB'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  14EF'   62 00 42 00           
  14F3'   68 00 6C 00           
  14F7'   30 00 5E 00           
  14FB'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                				;   so OPA_EX's end-of-line clamp does not apply
  14FD'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1501'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1505'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1509'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  150D'   24 01                 
  150F'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1513'   47 02 48 02           
  1517'   4D 02 4C 02           
  151B'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  151D'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  151F'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1520'                         VCB_C:
  1520'   CD 152C'              	CALL	VCB_CD
  1523'   C3 15F7'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1526'                         VCB_D:
  1526'   CD 152C'              	CALL	VCB_CD
  1529'   C3 1586'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  152C'                         VCB_CD:
  152C'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  152F'   22 2AC3'              	SHLD	OPLO
  1532'   CD 0000*              	CALL	CUROFF
  1535'   CD 1575'              	CALL	CEND		; to the line's content end, the CR,LF left
  1538'   22 2AC5'              	SHLD	OPHI
  153B'   C3 1456'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  153E'                         VC_X:
  153E'   CD 092C'              	CALL	GLSTAL
  1541'   CD 07A6'              	CALL	SETLIN
  1544'   CD 06CB'              	CALL	GETCNT
  1547'   22 2AC7'              	SHLD	CNTV
  154A'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  154D'   22 2ACB'              	SHLD	WKI		; cur
  1550'   CD 1575'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1553'   EB                    	XCHG			; DE = contentend
  1554'   2A 2ACB'              	LHLD	WKI		; HL = cur
  1557'   EB                    	XCHG			; HL = contentend, DE = cur
  1558'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  155B'   7C                    	MOV	A,H
  155C'   B5                    	ORA	L
  155D'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  155E'   EB                    	XCHG			; DE = available
  155F'   2A 2AC7'              	LHLD	CNTV		; HL = count
  1562'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1565'   DA 156B'              	JC	VX_USEA
  1568'   C3 156C'              	JMP	VX_DEL		; count <= available -> HL = count = del
  156B'                         VX_USEA:
  156B'   EB                    	XCHG			; HL = available
  156C'                         VX_DEL:
  156C'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  156F'   CD 0174'              	CALL	MARKMOD
  1572'   C3 1586'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1575'                         CEND:
  1575'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1578'   7C                    	MOV	A,H
  1579'   B5                    	ORA	L
  157A'   C8                    	RZ			; the start of the text: nothing before it
  157B'   2B                    	DCX	H
  157C'   E5                    	PUSH	H
  157D'   CD 0000*              	CALL	CHARAT
  1580'   E1                    	POP	H		; HL = term-1
  1581'   FE 0D                 	CPI	CR
  1583'   C8                    	RZ			; a CR before the LF -> the content ends there
  1584'   23                    	INX	H
  1585'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1586'                         CLAMPE:
  1586'   CD 0000*              	CALL	CUROFF
  1589'   E5                    	PUSH	H
  158A'   CD 0663'              	CALL	EOLC
  158D'   D1                    	POP	D		; DE = cur
  158E'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1591'   D8                    	RC
  1592'   C8                    	RZ
  1593'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1596'                         VC_I:
  1596'   CD 06CB'              	CALL	GETCNT
  1599'   C3 15F4'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  159C'                         VC_A:
  159C'   CD 06CB'              	CALL	GETCNT
  159F'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15A2'   CA 15B9'              	JZ	VA_INS
  15A5'   EB                    	XCHG			; HL = cur
  15A6'   E5                    	PUSH	H
  15A7'   CD 0000*              	CALL	CHARAT
  15AA'   E1                    	POP	H
  15AB'   FE 0A                 	CPI	LF
  15AD'   CA 15B9'              	JZ	VA_INS		; on the line terminator -> append in place
  15B0'   FE 0D                 	CPI	CR
  15B2'   CA 15B9'              	JZ	VA_INS
  15B5'   23                    	INX	H
  15B6'   CD 0000*              	CALL	GOTO
  15B9'                         VA_INS:
  15B9'   C3 15F4'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  15BC'                         VCB_A:
  15BC'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15BF'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  15C2'   E5                    	PUSH	H
  15C3'   CD 0000*              	CALL	CHARAT
  15C6'   E1                    	POP	H
  15C7'   FE 0D                 	CPI	CR
  15C9'   CA 15D2'              	JZ	VBA_IN		; an empty line: insert at its start
  15CC'   FE 0A                 	CPI	LF
  15CE'   CA 15D2'              	JZ	VBA_IN
  15D1'   23                    	INX	H		; past the last content char
  15D2'                         VBA_IN:
  15D2'   CD 0000*              	CALL	GOTO
  15D5'   C3 15F4'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  15D8'                         VCB_I:
  15D8'   CD 06CB'              	CALL	GETCNT
  15DB'   CD 087A'              	CALL	FNBLNK
  15DE'   CD 0000*              	CALL	CUROFF
  15E1'   E5                    	PUSH	H
  15E2'   CD 0000*              	CALL	CHARAT
  15E5'   E1                    	POP	H
  15E6'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15E8'   CA 15F0'              	JZ	VBI_SK
  15EB'   FE 09                 	CPI	TAB
  15ED'   C2 15F4'              	JNZ	SETINM
  15F0'                         VBI_SK:
  15F0'   23                    	INX	H		; blanks only: past the last of them
  15F1'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  15F4'                         SETINM:
  15F4'   CD 07A0'              	CALL	SETMOV
  15F7'                         SETINS:
  15F7'   3E 01                 	MVI	A,EM_INS
  15F9'   32 2A84'              	STA	EDMODE
  15FC'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  15FD'                         ATCEND:
  15FD'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1600'   C8                    	RZ
  1601'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1604'   FE 0D                 	CPI	CR
  1606'   C8                    	RZ
  1607'   FE 0A                 	CPI	LF
  1609'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  160A'                         OPNBRK:
  160A'   CD 1F01'              	CALL	PUTBRK
  160D'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1610'   23                    	INX	H
  1611'   22 0000*              	SHLD	LNDLT
  1614'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1617'                         ENDBRK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1617'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  161A'   C0                    	RNZ
  161B'   CD 160A'              	CALL	OPNBRK
  161E'   CD 0000*              	CALL	CUROFF
  1621'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1622'   2B                    	DCX	H		;   line, with its own terminator after it
  1623'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1626'                         VC_O:
  1626'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1629'   CD 1575'              	CALL	CEND
  162C'   CD 0000*              	CALL	GOTO
  162F'   CD 160A'              	CALL	OPNBRK
  1632'   CD 1617'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1635'   CD 07AC'              	CALL	SETILN		;   needs a terminator of its own to exist
  1638'   C3 15F7'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  163B'                         VCB_O:
  163B'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  163E'   CD 0624'              	CALL	BOL
  1641'   CD 0000*              	CALL	GOTO
  1644'   CD 160A'              	CALL	OPNBRK
  1647'   CD 0000*              	CALL	CUROFF
  164A'   2B                    	DCX	H
  164B'   2B                    	DCX	H
  164C'   CD 0000*              	CALL	GOTO
  164F'   CD 07AC'              	CALL	SETILN
  1652'   C3 15F7'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1655'                         VCB_J:
  1655'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1658'   CD 1575'              	CALL	CEND		; the join point: this line's content end
  165B'   22 2AC3'              	SHLD	OPLO
  165E'   CD 0000*              	CALL	CUROFF
  1661'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1664'   E5                    	PUSH	H
  1665'   CD 0000*              	CALL	LOGLEN
  1668'   D1                    	POP	D		; DE = that start
  1669'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  166C'   CA 07A0'              	JZ	SETMOV
  166F'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1670'                         VJ_WS:
  1670'   E5                    	PUSH	H
  1671'   CD 0000*              	CALL	LOGLEN
  1674'   D1                    	POP	D		; DE = the scan
  1675'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1678'   CA 168F'              	JZ	VJ_DEL
  167B'   EB                    	XCHG			; HL = the scan
  167C'   E5                    	PUSH	H
  167D'   CD 0000*              	CALL	CHARAT
  1680'   E1                    	POP	H
  1681'   FE 20                 	CPI	' '
  1683'   CA 168B'              	JZ	VJ_SKIP
  1686'   FE 09                 	CPI	TAB
  1688'   C2 168F'              	JNZ	VJ_DEL
  168B'                         VJ_SKIP:
  168B'   23                    	INX	H
  168C'   C3 1670'              	JMP	VJ_WS
  168F'                         VJ_DEL:
  168F'   22 2AC5'              	SHLD	OPHI
  1692'   CD 1456'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1695'   CD 07BB'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1698'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  169B'   CA 1586'              	JZ	CLAMPE
  169E'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  16A1'   FE 0D                 	CPI	CR
  16A3'   CA 1586'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  16A6'   FE 0A                 	CPI	LF
  16A8'   CA 1586'              	JZ	CLAMPE
  16AB'   FE 29                 	CPI	')'
  16AD'   CA 1586'              	JZ	CLAMPE		; vim puts no space before a ')'
  16B0'   CD 0000*              	CALL	CUROFF
  16B3'   7C                    	MOV	A,H
  16B4'   B5                    	ORA	L
  16B5'   CA 16CB'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  16B8'   2B                    	DCX	H
  16B9'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  16BC'   FE 20                 	CPI	' '
  16BE'   CA 1586'              	JZ	CLAMPE
  16C1'   FE 09                 	CPI	TAB
  16C3'   CA 1586'              	JZ	CLAMPE
  16C6'   FE 0A                 	CPI	LF
  16C8'   CA 1586'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  16CB'                         VJ_SP:
  16CB'   3E 20                 	MVI	A,' '
  16CD'   CD 0000*              	CALL	PUTGAP
  16D0'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16D3'   2B                    	DCX	H
  16D4'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  16D7'                         VC_TILD:
  16D7'   CD 06CB'              	CALL	GETCNT
  16DA'   CD 07A6'              	CALL	SETLIN		; only this row changes
  16DD'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16E0'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16E3'   CA 07A0'              	JZ	SETMOV
  16E6'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  16E9'   FE 0D                 	CPI	CR
  16EB'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  16EE'   FE 0A                 	CPI	LF
  16F0'   CA 07A0'              	JZ	SETMOV
  16F3'   47                    	MOV	B,A
  16F4'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  16F6'   FE 41                 	CPI	'A'
  16F8'   DA 1704'              	JC	VT_PUT		; below 'A': no case
  16FB'   FE 5B                 	CPI	'Z'+1
  16FD'   D2 1704'              	JNC	VT_PUT		; above 'Z': no case
  1700'   78                    	MOV	A,B
  1701'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1703'   47                    	MOV	B,A
  1704'                         VT_PUT:
  1704'   78                    	MOV	A,B
  1705'   32 2AD4'              	STA	VRCH		; the calls below do not preserve B
  1708'   CD 0174'              	CALL	MARKMOD
  170B'   21 0001               	LXI	H,1
  170E'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1711'   3A 2AD4'              	LDA	VRCH
  1714'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1717'   C3 1586'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  171A'                         VC_R:
  171A'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  171D'   3E 03                 	MVI	A,PR
  171F'   32 2AAC'              	STA	GPEND
  1722'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1723'                         VR_DO:
  1723'   AF                    	XRA	A
  1724'   32 2AAC'              	STA	GPEND
  1727'   79                    	MOV	A,C
  1728'   32 2AD4'              	STA	VRCH		; the calls below do not preserve C
  172B'   CD 07A6'              	CALL	SETLIN		; only this row changed
  172E'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1731'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1734'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1737'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  173A'   FE 0D                 	CPI	CR
  173C'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  173F'   FE 0A                 	CPI	LF
  1741'   CA 07A0'              	JZ	SETMOV
  1744'   CD 0174'              	CALL	MARKMOD
  1747'   21 0001               	LXI	H,1
  174A'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  174D'   3A 2AD4'              	LDA	VRCH
  1750'   FE 0D                 	CPI	CR
  1752'   CA 175F'              	JZ	VR_CR
  1755'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1758'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  175B'   2B                    	DCX	H		;   out, which moves every logical offset
  175C'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  175F'                         VR_CR:
  175F'   CD 160A'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1762'   CD 1617'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1765'   CD 07AC'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1768'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  176A'   32 2A8C'              	STA	ILABOV
  176D'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  176E'                         VCB_R:
  176E'   CD 06CB'              	CALL	GETCNT
  1771'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1774'   21 0000               	LXI	H,0
  1777'   22 2AD5'              	SHLD	RPDEL		; nothing of ours to put back yet
  177A'   22 2AD7'              	SHLD	RPAPP
  177D'   3E 02                 	MVI	A,EM_REP
  177F'   32 2A84'              	STA	EDMODE
  1782'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1783'                         VC_D:
  1783'   3E 64                 	MVI	A,'d'
  1785'   32 2AAE'              	STA	PENDOP
  1788'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  178B'                         VC_C:
  178B'   3E 63                 	MVI	A,'c'
  178D'   32 2AAE'              	STA	PENDOP
  1790'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ; goes to the first non-blank.
  1793'                         VD_DD:
  1793'   CD 092C'              	CALL	GLSTAL
  1796'   CD 06CB'              	CALL	GETCNT
  1799'   22 2AC7'              	SHLD	CNTV
  179C'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  179E'   32 2AB0'              	STA	DDSNG
  17A1'   2B                    	DCX	H
  17A2'   7C                    	MOV	A,H
  17A3'   B5                    	ORA	L
  17A4'   C2 17B2'              	JNZ	VDD_LS
  17A7'   3E 01                 	MVI	A,1
  17A9'   32 2AB0'              	STA	DDSNG
  17AC'   CD 1470'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  17AF'   C3 17B8'              	JMP	VDD_GO
  17B2'                         VDD_LS:
  17B2'   CD 08E5'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  17B5'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  17B8'                         VDD_GO:
  17B8'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17BB'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  17BE'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  17C1'   CD 2164'              	CALL	COPY12		;   every mark in the lines has closed up by then
  17C4'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  17C7'   2A 2AC7'              	LHLD	CNTV
  17CA'   CD 0000*              	CALL	SETC0
  17CD'                         VDD_FW:
  17CD'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  17D0'   DA 191E'              	JC	QREFUS		; ... which has no room for them
  17D3'   CD 06E0'              	CALL	CNTTST
  17D6'   C2 17CD'              	JNZ	VDD_FW
  17D9'   CD 0174'              	CALL	MARKMOD
  17DC'   CD 0A63'              	CALL	ATEOF
  17DF'   D2 17FA'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  17E2'   3E 00                 	MVI	A,0
  17E4'   32 2AB0'              	STA	DDSNG		; deleted to the end: full repaint
  17E7'   CD 0EA5'              	CALL	ONFST
  17EA'   CA 087A'              	JZ	FNBLNK		; nothing left before it
  17ED'   21 0001               	LXI	H,1		; onto the new last line
  17F0'   CD 0000*              	CALL	SETBWD
  17F3'   2A 0000*              	LHLD	LNDLT
  17F6'   2B                    	DCX	H
  17F7'   22 0000*              	SHLD	LNDLT
  17FA'                         VDD_UP:
  17FA'   CD 087A'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  17FD'   3A 2AB0'              	LDA	DDSNG
  1800'   B7                    	ORA	A
  1801'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1802'   3E 03                 	MVI	A,R_DLIN
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1804'   32 2A89'              	STA	RINTENT
  1807'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1808'                         QEMPTY:
  1808'   2A 0000*              	LHLD	QBEG
  180B'   EB                    	XCHG
  180C'   2A 0000*              	LHLD	QEND
  180F'   7C                    	MOV	A,H
  1810'   BA                    	CMP	D
  1811'   C0                    	RNZ
  1812'   7D                    	MOV	A,L
  1813'   BB                    	CMP	E
  1814'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1815'                         VC_Y:
  1815'   3E 79                 	MVI	A,'y'
  1817'   32 2AAE'              	STA	PENDOP
  181A'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  181D'                         VY_YY:
  181D'   21 2AB7'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1820'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1823'   CD 0000*              	CALL	CUROFF
  1826'   22 2AF8'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1829'   CD 0624'              	CALL	BOL
  182C'   22 2AFA'              	SHLD	YPT		; where the lines come from, to put them back
  182F'   CD 1984'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1832'   CD 19C7'              	CALL	YNCOPY		; copied where they lie, if that can be done
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1835'   D2 198B'              	JNC	YNDONE
  1838'   21 1793'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  183B'   C3 1867'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  183E'                         OPYANK:
  183E'   CD 1488'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1841'   2A 2AB3'              	LHLD	OPSTA
  1844'   EB                    	XCHG			; DE = start
  1845'   2A 2AB5'              	LHLD	OPEND2		; HL = end
  1848'   CD 0000*              	CALL	CMP16		; CY iff start < end
  184B'   D2 184F'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  184E'   EB                    	XCHG			; ... otherwise the start is
  184F'                         OPY_LO:
  184F'   22 2AF8'              	SHLD	YOFF
  1852'   2A 2AC3'              	LHLD	OPLO
  1855'   22 2AFA'              	SHLD	YPT		; where the lines come from, to put them back
  1858'   CD 1984'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  185B'   CD 1A3F'              	CALL	YNSPAN		; copied where they lie, if there is room
  185E'   D2 198B'              	JNC	YNDONE
  1861'   21 1945'              	LXI	H,YSPAN
  1864'   C3 1867'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1867'                         YKGO:
  1867'   22 2B22'              	SHLD	YACT
  186A'   2A 2AFA'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  186D'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  186E'   2A 2AF8'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1871'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1874'   22 2B28'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1877'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  187A'   E5                    	PUSH	H		;   pages the window on when the count's lines
  187B'   2A 2AFA'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  187E'   EB                    	XCHG			;   window as it was, then names other text
  187F'   E1                    	POP	H
  1880'   CD 0000*              	CALL	SUBHD
  1883'   EB                    	XCHG			; DE = how far behind the cursor they start
  1884'   CD 0F72'              	CALL	CURFP
  1887'   06 00                 	MVI	B,0
  1889'   CD 0F68'              	CALL	SUB24
  188C'   22 2B2A'              	SHLD	YPFP
  188F'   32 2B2C'              	STA	YPFP+2
  1892'   3A 2A88'              	LDA	MODF
  1895'   32 2AF5'              	STA	YMODF
  1898'   3A 2AA1'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  189B'   32 2AF6'              	STA	YDCHG		;   a yank must not become the last change
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  189E'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  18A1'   32 2AF7'              	STA	YURPL		;   back are not a change to undo either
  18A4'   3E 01                 	MVI	A,1
  18A6'   32 0000*              	STA	UNDRPL
  18A9'   32 2B21'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  18AC'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  18AF'   22 2B04'              	SHLD	YLDLT
  18B2'   CD 0000*              	CALL	LOGLEN
  18B5'   22 2B26'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  18B8'   2A 2B22'              	LHLD	YACT
  18BB'   CD 191D'              	CALL	YCALL		; the lines out of the file, into the register
  18BE'   3A 2AF0'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  18C1'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  18C3'   CA 1901'              	JZ	YK_RF		;   cursor: only the flags are still owed
  18C6'   CD 0000*              	CALL	LOGLEN
  18C9'   EB                    	XCHG
  18CA'   2A 2B26'              	LHLD	YWAS
  18CD'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  18D0'   CA 18E2'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  18D3'   21 2B2A'              	LXI	H,YPFP		; back to where they came from, by its place in
  18D6'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  18D9'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  18DC'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  18DF'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  18E2'                         YK_FIN:				; (nothing came out: nothing went back, and the
  18E2'   2A 2B2A'              	LHLD	YPFP		;   cursor is still owed its place)
  18E5'   EB                    	XCHG
  18E6'   2A 2B28'              	LHLD	YCOL
  18E9'   19                    	DAD	D
  18EA'   22 2B1D'              	SHLD	MKPOS
  18ED'   3A 2B2C'              	LDA	YPFP+2
  18F0'   CE 00                 	ACI	0
  18F2'   32 2B1F'              	STA	MKPOS+2
  18F5'   CD 03A9'              	CALL	MKPAGE
  18F8'   CD 0000*              	CALL	GOTO
  18FB'                         YK_RST:
  18FB'   2A 2B04'              	LHLD	YLDLT
  18FE'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1901'                         YK_RF:
  1901'   3A 2AF5'              	LDA	YMODF
  1904'   32 2A88'              	STA	MODF
  1907'   3A 2AF6'              	LDA	YDCHG
  190A'   32 2AA1'              	STA	DOTCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  190D'   3A 2AF7'              	LDA	YURPL
  1910'   32 0000*              	STA	UNDRPL
  1913'   AF                    	XRA	A
  1914'   32 2B21'              	STA	MKHOLD
  1917'   CD 092C'              	CALL	GLSTAL
  191A'   C3 07C1'              	JMP	SETFUL		; the cheap paint cannot carry this
  191D'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  191E'                         QREFUS:
  191E'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1921'   CD 1808'              	CALL	QEMPTY
  1924'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1927'   CD 0000*              	CALL	QKILL
  192A'   3A 2B21'              	LDA	MKHOLD
  192D'   B7                    	ORA	A
  192E'   C2 193D'              	JNZ	QRF_Y
  1931'   21 0000*              	LXI	H,MKSAV
  1934'   11 0000*              	LXI	D,MKTAB
  1937'   CD 2164'              	CALL	COPY12
  193A'   CD 0000*              	CALL	UNDCLR
  193D'                         QRF_Y:
  193D'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  193F'   32 2AF0'              	STA	MSGWHT
  1942'   C3 1297'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1945'                         YSPAN:
  1945'   CD 092C'              	CALL	GLSTAL
  1948'   CD 144B'              	CALL	OPSPNL		; HL = the span's length
  194B'   22 2B24'              	SHLD	YTGT
  194E'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1951'   EB                    	XCHG			; DE = it
  1952'   2A 2B24'              	LHLD	YTGT
  1955'   EB                    	XCHG			; HL = the text's, DE = the span's
  1956'   CD 0000*              	CALL	SUBHD
  1959'   22 2B24'              	SHLD	YTGT		; what the text is left at when the span is out
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  195C'   2A 2AC3'              	LHLD	OPLO
  195F'   CD 0000*              	CALL	GOTO
  1962'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1965'                         YS_LP:
  1965'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1968'   CD 0000*              	CALL	SETC0
  196B'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  196E'   DA 191E'              	JC	QREFUS		; ... which has no room for it
  1971'   CD 0000*              	CALL	LOGLEN
  1974'   EB                    	XCHG			; DE = what is left
  1975'   2A 2B24'              	LHLD	YTGT
  1978'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  197B'   DA 1981'              	JC	YS_END		; below it -- cannot happen over whole lines,
  197E'   C2 1965'              	JNZ	YS_LP		;   but never spin here if it ever did
  1981'                         YS_END:
  1981'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1984'                         YNPRE:
  1984'   2A 0000*              	LHLD	PGTOPM
  1987'   22 2B2D'              	SHLD	YNPG
  198A'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  198B'                         YNDONE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  198B'   2A 2AF8'              	LHLD	YOFF
  198E'   CD 0000*              	CALL	GOTO
  1991'   2A 0000*              	LHLD	PGTOPM
  1994'   EB                    	XCHG
  1995'   2A 2B2D'              	LHLD	YNPG
  1998'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  199B'   C2 07C1'              	JNZ	SETFUL		; it moved under us: repaint after all
  199E'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  19A1'                         YNROOM:
  19A1'   11 0100               	LXI	D,100H
  19A4'   19                    	DAD	D
  19A5'   D8                    	RC			; within a chunk of 64K: no arena holds that
  19A6'   E5                    	PUSH	H		; the span plus its slack
  19A7'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  19AA'   EB                    	XCHG			; HL = free
  19AB'   D1                    	POP	D		; DE = the span plus its slack
  19AC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  19AF'   DA 19B7'              	JC	YNR_OK
  19B2'   CA 19B7'              	JZ	YNR_OK
  19B5'   37                    	STC			; not enough: the delete-and-put-back path
  19B6'   C9                    	RET
  19B7'                         YNR_OK:
  19B7'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  19B8'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  19B9'                         YNGO:
  19B9'   C5                    	PUSH	B
  19BA'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  19BD'   CD 092C'              	CALL	GLSTAL
  19C0'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  19C3'   C1                    	POP	B
  19C4'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  19C7'                         YNCOPY:
  19C7'   2A 2A85'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  19CA'   7C                    	MOV	A,H		;   the count itself
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19CB'   B5                    	ORA	L
  19CC'   C2 19D2'              	JNZ	YNC_HV
  19CF'   21 0001               	LXI	H,1
  19D2'                         YNC_HV:
  19D2'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  19D3'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  19D4'   B4                    	ORA	H
  19D5'   CA 19E0'              	JZ	YNC_M
  19D8'   E5                    	PUSH	H
  19D9'   CD 08E5'              	CALL	ONLAST		; vim: a count over one on the last line does
  19DC'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  19DD'   DA 19F2'              	JC	YNC_RF
  19E0'                         YNC_M:
  19E0'   E5                    	PUSH	H
  19E1'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  19E4'   E1                    	POP	H
  19E5'   CD 19FA'              	CALL	YNLINE		; BC = the span, measured where it stands
  19E8'   D8                    	RC			; not measurable here: let the pager answer it
  19E9'   60                    	MOV	H,B
  19EA'   69                    	MOV	L,C
  19EB'   CD 19A1'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  19EE'   D8                    	RC			; no: the delete-and-put-back path
  19EF'   C3 19B9'              	JMP	YNGO
  19F2'                         YNC_RF:
  19F2'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  19F5'   CD 092C'              	CALL	GLSTAL		;   register alone, and that is the command
  19F8'   B7                    	ORA	A		; NC: done
  19F9'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  19FA'                         YNLINE:
  19FA'   22 2B2F'              	SHLD	YNCNT		; the lines it still wants
  19FD'   2A 0000*              	LHLD	GAPEND
  1A00'                         YNL_LP:
  1A00'   EB                    	XCHG			; DE = the scan
  1A01'   2A 0000*              	LHLD	TXTEND
  1A04'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1A07'   EB                    	XCHG			; HL = the scan
  1A08'   D2 1A28'              	JNC	YNL_EN		; the resident text ran out
  1A0B'   7E                    	MOV	A,M
  1A0C'   23                    	INX	H
  1A0D'   FE 0A                 	CPI	LF
  1A0F'   C2 1A00'              	JNZ	YNL_LP
  1A12'   E5                    	PUSH	H
  1A13'   2A 2B2F'              	LHLD	YNCNT
  1A16'   2B                    	DCX	H
  1A17'   22 2B2F'              	SHLD	YNCNT
  1A1A'   7C                    	MOV	A,H
  1A1B'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A1C'   E1                    	POP	H
  1A1D'   C2 1A00'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1A20'   EB                    	XCHG			; DE = past the last of them
  1A21'   2A 0000*              	LHLD	GAPEND
  1A24'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1A25'   C3 1A36'              	JMP	YNL_BC
  1A28'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1A28'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1A2B'   C2 1A3D'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1A2E'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1A31'   EB                    	XCHG			;   count clamps to it as vim's does
  1A32'   2A 0000*              	LHLD	GAPEND
  1A35'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1A36'                         YNL_BC:
  1A36'   CD 0000*              	CALL	SUBHD		; HL = the span
  1A39'   44                    	MOV	B,H
  1A3A'   4D                    	MOV	C,L
  1A3B'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1A3C'   C9                    	RET
  1A3D'                         YNL_NO:
  1A3D'   37                    	STC
  1A3E'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1A3F'                         YNSPAN:
  1A3F'   CD 144B'              	CALL	OPSPNL		; HL = the span's length
  1A42'   44                    	MOV	B,H
  1A43'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1A44'   CD 19A1'              	CALL	YNROOM
  1A47'   D8                    	RC			; no room: the delete-and-put-back path
  1A48'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1A49'   2A 2AC3'              	LHLD	OPLO
  1A4C'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1A4F'   C1                    	POP	B
  1A50'   C3 19B9'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1A53'                         VC_P:
  1A53'   CD 1808'              	CALL	QEMPTY
  1A56'   CA 1B29'              	JZ	VP_BEL
  1A59'   CD 06CB'              	CALL	GETCNT
  1A5C'   22 2AFC'              	SHLD	PCNT
  1A5F'   CD 0000*              	CALL	CUROFF
  1A62'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1A65'   C3 1A7A'              	JMP	VP_GO
  1A68'                         VCB_P:
  1A68'   CD 1808'              	CALL	QEMPTY
  1A6B'   CA 1B29'              	JZ	VP_BEL
  1A6E'   CD 06CB'              	CALL	GETCNT
  1A71'   22 2AFC'              	SHLD	PCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A74'   CD 0000*              	CALL	CUROFF
  1A77'   CD 0624'              	CALL	BOL
  1A7A'                         VP_GO:
  1A7A'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1A7D'   CD 0000*              	CALL	CUROFF
  1A80'   EB                    	XCHG
  1A81'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1A84'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A87'   DA 1A9C'              	JC	VP_IN
  1A8A'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A8B'   7C                    	MOV	A,H
  1A8C'   B5                    	ORA	L
  1A8D'   CA 1A99'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A90'   2B                    	DCX	H
  1A91'   CD 0000*              	CALL	CHARAT
  1A94'   FE 0A                 	CPI	LF
  1A96'   CA 1A9C'              	JZ	VP_IN
  1A99'                         VP_BRK:
  1A99'   CD 160A'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A9C'                         VP_IN:
  1A9C'   21 2AFE'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1A9F'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1AA2'   CD 0FBB'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1AA5'   2A 0000*              	LHLD	QBEG
  1AA8'   EB                    	XCHG
  1AA9'   2A 0000*              	LHLD	QEND
  1AAC'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1AAF'   EB                    	XCHG
  1AB0'   22 2B01'              	SHLD	PLFS
  1AB3'   2A 2AFC'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1AB6'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1AB7'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1AB8'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1ABA'   C2 1ABE'              	JNZ	VP_PZ
  1ABD'   7D                    	MOV	A,L
  1ABE'                         VP_PZ:
  1ABE'   32 2B03'              	STA	PCPY
  1AC1'                         VP_LP:
  1AC1'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1AC4'   2A 0000*              	LHLD	LNDLT
  1AC7'   EB                    	XCHG
  1AC8'   2A 2B01'              	LHLD	PLFS
  1ACB'   19                    	DAD	D
  1ACC'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1ACF'   2A 2AFC'              	LHLD	PCNT
  1AD2'   2B                    	DCX	H
  1AD3'   22 2AFC'              	SHLD	PCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AD6'   7C                    	MOV	A,H
  1AD7'   B5                    	ORA	L
  1AD8'   C2 1AC1'              	JNZ	VP_LP
  1ADB'   CD 0174'              	CALL	MARKMOD
  1ADE'   21 2AFE'              	LXI	H,PPFP
  1AE1'   CD 03DC'              	CALL	MKLOAD
  1AE4'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1AE7'   D2 1B1A'              	JNC	VP_PGD
  1AEA'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1AED'   CD 092C'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1AF0'   3A 2B03'              	LDA	PCPY
  1AF3'   B7                    	ORA	A
  1AF4'   CA 087A'              	JZ	FNBLNK
  1AF7'   2A 2B01'              	LHLD	PLFS
  1AFA'   7C                    	MOV	A,H
  1AFB'   B7                    	ORA	A
  1AFC'   C2 087A'              	JNZ	FNBLNK
  1AFF'   3A 2B03'              	LDA	PCPY
  1B02'   CD 0E3B'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1B05'   7C                    	MOV	A,H
  1B06'   B7                    	ORA	A
  1B07'   C2 087A'              	JNZ	FNBLNK
  1B0A'   7D                    	MOV	A,L
  1B0B'   B7                    	ORA	A
  1B0C'   CA 087A'              	JZ	FNBLNK
  1B0F'   F5                    	PUSH	PSW
  1B10'   CD 07AC'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1B13'   F1                    	POP	PSW
  1B14'   32 2A8A'              	STA	ILN		; ... which the lines put now replace
  1B17'   C3 087A'              	JMP	FNBLNK
  1B1A'                         VP_PGD:				; the put paged its first line out: page back
  1B1A'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1B1D'   CD 0000*              	CALL	GOTO
  1B20'   CD 092C'              	CALL	GLSTAL
  1B23'   CD 0FD3'              	CALL	GPLACE
  1B26'   C3 07C1'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1B29'                         VP_BEL:
  1B29'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1B2C'   0E 07                 	MVI	C,BEL
  1B2E'   CD 0000*              	CALL	BCONOU
  1B31'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1B34'                         VIREP:
  1B34'   79                    	MOV	A,C
  1B35'   FE 1B                 	CPI	ESC
  1B37'   CA 1C5C'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1B3A'   FE 0D                 	CPI	CR
  1B3C'   CA 1BA0'              	JZ	VP_CR
  1B3F'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1B41'   CA 1BA0'              	JZ	VP_CR
  1B44'   FE 08                 	CPI	BS
  1B46'   CA 1BAC'              	JZ	VP_BS
  1B49'   FE 7F                 	CPI	DEL
  1B4B'   CA 1BAC'              	JZ	VP_BS
  1B4E'   32 2AD4'              	STA	VRCH		; the calls below do not preserve C
  1B51'   CD 07A6'              	CALL	SETLIN		; this row changed
  1B54'   CD 0174'              	CALL	MARKMOD
  1B57'   CD 15FD'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1B5A'   CA 1B92'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1B5D'   3A 2AD4'              	LDA	VRCH
  1B60'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1B63'   2A 2AD5'              	LHLD	RPDEL
  1B66'   7C                    	MOV	A,H
  1B67'   B5                    	ORA	L
  1B68'   CA 1B7E'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1B6B'   2A 0000*              	LHLD	GAPEND
  1B6E'   EB                    	XCHG
  1B6F'   2A 2AD9'              	LHLD	RPGE
  1B72'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1B75'   CA 1B7E'              	JZ	VP_OVW
  1B78'   21 0000               	LXI	H,0
  1B7B'   22 2AD5'              	SHLD	RPDEL		; the text moved: those originals are gone
  1B7E'                         VP_OVW:
  1B7E'   21 0001               	LXI	H,1
  1B81'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1B84'   2A 0000*              	LHLD	GAPEND
  1B87'   22 2AD9'              	SHLD	RPGE
  1B8A'   2A 2AD5'              	LHLD	RPDEL
  1B8D'   23                    	INX	H
  1B8E'   22 2AD5'              	SHLD	RPDEL
  1B91'   C9                    	RET
  1B92'                         VP_APP:
  1B92'   3A 2AD4'              	LDA	VRCH
  1B95'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B98'   2A 2AD7'              	LHLD	RPAPP
  1B9B'   23                    	INX	H
  1B9C'   22 2AD7'              	SHLD	RPAPP
  1B9F'   C9                    	RET
  1BA0'                         VP_CR:
  1BA0'   21 0000               	LXI	H,0
  1BA3'   22 2AD5'              	SHLD	RPDEL		; a line break ends what BS can put back
  1BA6'   22 2AD7'              	SHLD	RPAPP
  1BA9'   C3 1C32'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1BAC'                         VP_BS:
  1BAC'   2A 2AD7'              	LHLD	RPAPP
  1BAF'   7C                    	MOV	A,H
  1BB0'   B5                    	ORA	L
  1BB1'   CA 1BBE'              	JZ	VP_BSD
  1BB4'   2B                    	DCX	H
  1BB5'   22 2AD7'              	SHLD	RPAPP		; an appended char: it just goes
  1BB8'   CD 07A6'              	CALL	SETLIN
  1BBB'   C3 0000*              	JMP	DELPRV
  1BBE'                         VP_BSD:
  1BBE'   2A 2AD5'              	LHLD	RPDEL
  1BC1'   7C                    	MOV	A,H
  1BC2'   B5                    	ORA	L
  1BC3'   CA 1BEA'              	JZ	VP_BSM		; nothing of ours left
  1BC6'   2A 0000*              	LHLD	GAPEND
  1BC9'   EB                    	XCHG
  1BCA'   2A 2AD9'              	LHLD	RPGE
  1BCD'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1BD0'   C2 1BEA'              	JNZ	VP_BSM
  1BD3'   2A 2AD5'              	LHLD	RPDEL
  1BD6'   2B                    	DCX	H
  1BD7'   22 2AD5'              	SHLD	RPDEL
  1BDA'   CD 07A6'              	CALL	SETLIN
  1BDD'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1BE0'   CD 0000*              	CALL	UNDELF		; the original comes back
  1BE3'   2A 0000*              	LHLD	GAPEND
  1BE6'   22 2AD9'              	SHLD	RPGE
  1BE9'   C9                    	RET
  1BEA'                         VP_BSM:
  1BEA'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1BED'   C3 080F'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1BF0'                         VIINS:
  1BF0'   79                    	MOV	A,C
  1BF1'   FE 1B                 	CPI	ESC
  1BF3'   CA 1C5C'              	JZ	VI_ESC
  1BF6'   FE 0D                 	CPI	CR
  1BF8'   CA 1C32'              	JZ	VI_CR
  1BFB'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1BFD'   CA 1C32'              	JZ	VI_CR
  1C00'   FE 08                 	CPI	BS
  1C02'   CA 1C4A'              	JZ	VI_BS
  1C05'   FE 7F                 	CPI	DEL
  1C07'   CA 1C4A'              	JZ	VI_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C0A'   79                    	MOV	A,C
  1C0B'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1C0E'   CD 0174'              	CALL	MARKMOD
  1C11'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1C14'   79                    	MOV	A,C
  1C15'   FE 20                 	CPI	' '
  1C17'   D8                    	RC			; control char -> keep R_LINE
  1C18'   FE 7F                 	CPI	DEL
  1C1A'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1C1B'   CD 07C7'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1C1E'   B7                    	ORA	A
  1C1F'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1C20'   3E 04                 	MVI	A,R_ICH
  1C22'   32 2A89'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1C25'   CD 15FD'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1C28'   3E 00                 	MVI	A,0
  1C2A'   C2 1C2E'              	JNZ	VI_ICH
  1C2D'   3C                    	INR	A
  1C2E'                         VI_ICH:
  1C2E'   32 2A8B'              	STA	ICHAPP
  1C31'   C9                    	RET
  1C32'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1C32'   CD 15FD'              	CALL	ATCEND
  1C35'   3E 00                 	MVI	A,0
  1C37'   CA 1C3B'              	JZ	VI_CRS
  1C3A'   3C                    	INR	A
  1C3B'                         VI_CRS:
  1C3B'   F5                    	PUSH	PSW
  1C3C'   CD 160A'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1C3F'   CD 1617'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1C42'   CD 07AC'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1C45'   F1                    	POP	PSW
  1C46'   32 2A8C'              	STA	ILABOV
  1C49'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1C4A'                         VI_BS:
  1C4A'   CD 0000*              	CALL	PEEKL
  1C4D'   D8                    	RC			; start of the file: nothing to delete
  1C4E'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1C50'   CA 1C56'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1C53'   CD 07A6'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1C56'                         VI_BSJ:				;   char is inside the row -- redraw just that row
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C56'   CD 0174'              	CALL	MARKMOD
  1C59'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1C5C'                         VI_ESC:
  1C5C'   3E 00                 	MVI	A,EM_CMD
  1C5E'   32 2A84'              	STA	EDMODE
  1C61'   CD 07A0'              	CALL	SETMOV
  1C64'   CD 080F'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1C67'   C3 092C'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1C6A'                         RDLINE:
  1C6A'   EB                    	XCHG			; HL = buffer
  1C6B'   22 2ADB'              	SHLD	RLPTR
  1C6E'   3E 00                 	MVI	A,0
  1C70'   32 2ADD'              	STA	RLLEN
  1C73'   78                    	MOV	A,B
  1C74'   32 2ADE'              	STA	RLMAX
  1C77'   79                    	MOV	A,C
  1C78'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1C7B'                         RL_LP:
  1C7B'   CD 0000*              	CALL	GETKEY
  1C7E'   FE 1B                 	CPI	ESC
  1C80'   CA 1CD0'              	JZ	RL_CAN
  1C83'   FE 0D                 	CPI	CR
  1C85'   CA 1CDB'              	JZ	RL_DONE
  1C88'   FE 08                 	CPI	BS
  1C8A'   CA 1CB8'              	JZ	RL_BS
  1C8D'   FE 7F                 	CPI	DEL
  1C8F'   CA 1CB8'              	JZ	RL_BS
  1C92'   FE 20                 	CPI	' '
  1C94'   DA 1C7B'              	JC	RL_LP		; control char -> ignore
  1C97'   3A 2ADD'              	LDA	RLLEN
  1C9A'   47                    	MOV	B,A
  1C9B'   3A 2ADE'              	LDA	RLMAX
  1C9E'   B8                    	CMP	B
  1C9F'   CA 1C7B'              	JZ	RL_LP		; full -> ignore
  1CA2'   2A 2ADB'              	LHLD	RLPTR
  1CA5'   71                    	MOV	M,C
  1CA6'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1CA7'   22 2ADB'              	SHLD	RLPTR
  1CAA'   3A 2ADD'              	LDA	RLLEN
  1CAD'   3C                    	INR	A
  1CAE'   32 2ADD'              	STA	RLLEN
  1CB1'   79                    	MOV	A,C
  1CB2'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1CB5'   C3 1C7B'              	JMP	RL_LP
  1CB8'                         RL_BS:				; WM LINEPOP
  1CB8'   3A 2ADD'              	LDA	RLLEN
  1CBB'   B7                    	ORA	A
  1CBC'   CA 1CD0'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1CBF'   3D                    	DCR	A
  1CC0'   32 2ADD'              	STA	RLLEN
  1CC3'   2A 2ADB'              	LHLD	RLPTR
  1CC6'   2B                    	DCX	H
  1CC7'   22 2ADB'              	SHLD	RLPTR
  1CCA'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1CCD'   C3 1C7B'              	JMP	RL_LP
  1CD0'                         RL_CAN:
  1CD0'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1CD2'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1CD5'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1CD8'   3E FF                 	MVI	A,0FFH		; cancelled
  1CDA'   C9                    	RET
  1CDB'                         RL_DONE:
  1CDB'   AF                    	XRA	A
  1CDC'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1CDD'                         VC_BZ:
  1CDD'   CD 07A0'              	CALL	SETMOV
  1CE0'   3A 2AAD'              	LDA	GSAVE
  1CE3'   FE 02                 	CPI	PZ
  1CE5'   CA 1CF0'              	JZ	VZ_ZZ
  1CE8'   B7                    	ORA	A
  1CE9'   C0                    	RNZ			; 'g' was pending: vim drops both
  1CEA'   3E 02                 	MVI	A,PZ
  1CEC'   32 2AAC'              	STA	GPEND
  1CEF'   C9                    	RET
  1CF0'                         VZ_ZZ:
  1CF0'   3E 04                 	MVI	A,EO_X
  1CF2'   32 2ADF'              	STA	EXOP
  1CF5'   3E 01                 	MVI	A,1
  1CF7'   32 2AF2'              	STA	EXBANG		; no '!'
  1CFA'   AF                    	XRA	A
  1CFB'   32 2AE0'              	STA	EXARG		; no file name
  1CFE'   3A 2A88'              	LDA	MODF		; as ':x': a changed text is written first
  1D01'   B7                    	ORA	A
  1D02'   CA 1E43'              	JZ	EX_Q
  1D05'   C3 1DDD'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1D08'                         VC_EX:
  1D08'   CD 06CB'              	CALL	GETCNT
  1D0B'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1D0E'   11 0000*              	LXI	D,EXBUF
  1D11'   06 28                 	MVI	B,EXMAX
  1D13'   0E 3A                 	MVI	C,':'
  1D15'   CD 1C6A'              	CALL	RDLINE
  1D18'   B7                    	ORA	A
  1D19'   C0                    	RNZ			; cancelled
  1D1A'   3A 2ADD'              	LDA	RLLEN
  1D1D'   5F                    	MOV	E,A
  1D1E'   16 00                 	MVI	D,0
  1D20'   21 0000*              	LXI	H,EXBUF
  1D23'   19                    	DAD	D
  1D24'   36 00                 	MVI	M,0		; the line ends with a 0
  1D26'   21 0000*              	LXI	H,EXBUF
  1D29'   CD 22F5'              	CALL	SKIPB
  1D2C'   C8                    	RZ			; nothing on it
  1D2D'   22 2AE2'              	SHLD	EXCMD
  1D30'   CD 24F9'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1D33'   CD 22F5'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1D36'   56                    	MOV	D,M
  1D37'   23                    	INX	H
  1D38'   1E 00                 	MVI	E,0
  1D3A'   CD 2301'              	CALL	ISLOW
  1D3D'   DA 1D48'              	JC	EX_LK
  1D40'   5F                    	MOV	E,A
  1D41'   23                    	INX	H
  1D42'   CD 2301'              	CALL	ISLOW
  1D45'   D2 1D61'              	JNC	EX_NOT		; a third letter: none of ours
  1D48'                         EX_LK:
  1D48'   E5                    	PUSH	H
  1D49'   21 24E0'              	LXI	H,EXTAB
  1D4C'                         EX_TL:
  1D4C'   7E                    	MOV	A,M
  1D4D'   B7                    	ORA	A
  1D4E'   CA 1D60'              	JZ	EX_NTP		; not in the table
  1D51'   23                    	INX	H
  1D52'   BA                    	CMP	D
  1D53'   7E                    	MOV	A,M
  1D54'   23                    	INX	H
  1D55'   C2 1D5C'              	JNZ	EX_TN
  1D58'   BB                    	CMP	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D59'   CA 1D67'              	JZ	EX_TF
  1D5C'                         EX_TN:
  1D5C'   23                    	INX	H
  1D5D'   C3 1D4C'              	JMP	EX_TL
  1D60'                         EX_NTP:
  1D60'   E1                    	POP	H
  1D61'                         EX_NOT:
  1D61'   21 23B9'              	LXI	H,SNOT
  1D64'   C3 2336'              	JMP	EXERT
  1D67'                         EX_TF:
  1D67'   7E                    	MOV	A,M
  1D68'   32 2ADF'              	STA	EXOP
  1D6B'   E1                    	POP	H
  1D6C'   FE 06                 	CPI	EO_S
  1D6E'   CA 2568'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1D71'   FE 01                 	CPI	EO_W
  1D73'   CA 1D82'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1D76'   FE 08                 	CPI	EO_R
  1D78'   CA 1D82'              	JZ	EX_RG		; ... and ':Nr name' a line
  1D7B'   3A 2B3B'              	LDA	SRNGF
  1D7E'   B7                    	ORA	A
  1D7F'   C2 1D61'              	JNZ	EX_NOT		; a range on a command that does not take one
  1D82'                         EX_RG:
                                	;--- '!', then the file name ---
  1D82'   7E                    	MOV	A,M
  1D83'   D6 21                 	SUI	'!'
  1D85'   32 2AF2'              	STA	EXBANG		; 0 = '!'
  1D88'   C2 1D8C'              	JNZ	EX_NB
  1D8B'   23                    	INX	H
  1D8C'                         EX_NB:
  1D8C'   CD 22F5'              	CALL	SKIPB
  1D8F'   32 2AE0'              	STA	EXARG		; 0 = no file name
  1D92'   CA 1DAB'              	JZ	EX_RUN
  1D95'   22 2AE2'              	SHLD	EXCMD
  1D98'   3A 2ADF'              	LDA	EXOP
  1D9B'   FE 02                 	CPI	EO_Q
  1D9D'   CA 2333'              	JZ	EX_TRL		; :q takes none
  1DA0'   FE 07                 	CPI	EO_V
  1DA2'   CA 2333'              	JZ	EX_TRL		; nor :ve
  1DA5'   CD 225F'              	CALL	PARSFN
  1DA8'   C2 2327'              	JNZ	EX_INV
  1DAB'                         EX_RUN:
  1DAB'   3A 2ADF'              	LDA	EXOP
  1DAE'   FE 05                 	CPI	EO_E
  1DB0'   CA 1E5A'              	JZ	EX_E
  1DB3'   FE 02                 	CPI	EO_Q
  1DB5'   CA 1E43'              	JZ	EX_Q
  1DB8'   FE 07                 	CPI	EO_V
  1DBA'   CA 232D'              	JZ	EX_V
  1DBD'   FE 08                 	CPI	EO_R
  1DBF'   CA 1FEB'              	JZ	EX_R
  1DC2'   FE 04                 	CPI	EO_X
  1DC4'   CA 1DD6'              	JZ	EX_XM
  1DC7'   FE 01                 	CPI	EO_W
  1DC9'   C2 1DDD'              	JNZ	EX_W		; :wq
  1DCC'   3A 2B3B'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DCF'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1DD0'   C2 1F0B'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1DD3'   C3 1DDD'              	JMP	EX_W
  1DD6'                         EX_XM:
  1DD6'   3A 2A88'              	LDA	MODF		; :x writes only a changed text
  1DD9'   B7                    	ORA	A
  1DDA'   CA 1E43'              	JZ	EX_Q
  1DDD'                         EX_W:
  1DDD'   CD 20CB'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1DE0'   D8                    	RC			; refused (message shown)
  1DE1'   32 2AE1'              	STA	EXBAK
  1DE4'   3A 2ADF'              	LDA	EXOP
  1DE7'   FE 01                 	CPI	EO_W
  1DE9'   CA 1E00'              	JZ	EX_WK
  1DEC'   3A 2AE1'              	LDA	EXBAK
  1DEF'   B7                    	ORA	A
  1DF0'   C2 1E40'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1DF3'   3A 2AF2'              	LDA	EXBANG
  1DF6'   B7                    	ORA	A
  1DF7'   CA 1E40'              	JZ	EX_WQ		; so it does with '!'
  1DFA'   CD 1E00'              	CALL	EX_WK		; else it may not: keep the text
  1DFD'   C3 1E43'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1E00'                         EX_WK:
  1E00'   CD 0D47'              	CALL	CURRW		; the cursor's row and file position
  1E03'   32 2AE4'              	STA	WPROW
  1E06'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1E09'   7D                    	MOV	A,L
  1E0A'   E6 7F                 	ANI	7FH
  1E0C'   32 2AE5'              	STA	WPBYT
  1E0F'   7D                    	MOV	A,L
  1E10'   17                    	RAL
  1E11'   7C                    	MOV	A,H
  1E12'   17                    	RAL
  1E13'   5F                    	MOV	E,A
  1E14'   3E 00                 	MVI	A,0
  1E16'   17                    	RAL
  1E17'   57                    	MOV	D,A		; DE = HL / 128
  1E18'   2A 0000*              	LHLD	OUTPOS
  1E1B'   19                    	DAD	D
  1E1C'   22 2AE6'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1E1F'   CD 2100'              	CALL	WRITE
  1E22'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1E25'   2A 2AE6'              	LHLD	WPREC
  1E28'   EB                    	XCHG
  1E29'   3A 2AE5'              	LDA	WPBYT
  1E2C'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1E2F'   CD 0000*              	CALL	GOTO
  1E32'                         EX_WRW:
  1E32'   21 0000               	LXI	H,0
  1E35'   22 0000*              	SHLD	LNDLT
  1E38'   3A 2AE4'              	LDA	WPROW
  1E3B'   6F                    	MOV	L,A
  1E3C'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1E3F'   C9                    	RET
  1E40'                         EX_WQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E40'   CD 2100'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1E43'                         EX_Q:
  1E43'   3A 2AF2'              	LDA	EXBANG
  1E46'   B7                    	ORA	A
  1E47'   CA 1E51'              	JZ	EX_QT
  1E4A'   3A 2A88'              	LDA	MODF
  1E4D'   B7                    	ORA	A
  1E4E'   C2 231B'              	JNZ	MSGNWR		; changed, no '!': stay
  1E51'                         EX_QT:
  1E51'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1E54'   3E 01                 	MVI	A,1
  1E56'   32 2A87'              	STA	QUITF
  1E59'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1E5A'                         EX_E:
  1E5A'   3A 2AF2'              	LDA	EXBANG
  1E5D'   B7                    	ORA	A
  1E5E'   CA 1E68'              	JZ	EE_GO
  1E61'   3A 2A88'              	LDA	MODF
  1E64'   B7                    	ORA	A
  1E65'   C2 231B'              	JNZ	MSGNWR
  1E68'                         EE_GO:
  1E68'   3A 2AE0'              	LDA	EXARG
  1E6B'   B7                    	ORA	A
  1E6C'   C2 1E73'              	JNZ	EE_ARG
  1E6F'   CD 213C'              	CALL	OWNTF		; no name: the buffer's own
  1E72'   D8                    	RC
  1E73'                         EE_ARG:
  1E73'   CD 2152'              	CALL	ISOWN
  1E76'   21 0001               	LXI	H,1
  1E79'   C2 1E80'              	JNZ	EE_LD		; another file: its first line
  1E7C'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1E7F'   23                    	INX	H		; HL = the cursor's line
  1E80'                         EE_LD:
  1E80'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1E82'   32 2AF0'              	STA	MSGWHT
  1E85'   E5                    	PUSH	H
  1E86'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E89'   21 0000*              	LXI	H,TFCB
  1E8C'   11 0000*              	LXI	D,FNAME
  1E8F'   CD 2164'              	CALL	COPY12		; the buffer's name
  1E92'   CD 2129'              	CALL	SRCTF
  1E95'   CD 0000*              	CALL	REOPEN
  1E98'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  1E9B'   AF                    	XRA	A
  1E9C'   32 2A88'              	STA	MODF
  1E9F'   E1                    	POP	H
  1EA0'   2B                    	DCX	H
  1EA1'   AF                    	XRA	A
  1EA2'   CD 0000*              	CALL	MVLIND		; down to the line
  1EA5'   CD 0A63'              	CALL	ATEOF
  1EA8'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  1EAB'   CD 0F95'              	CALL	ZSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1EAE'   C3 1078'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1EB1'                         TFDOS:
  1EB1'   C5                    	PUSH	B
  1EB2'   11 0080               	LXI	D,CMDTAIL
  1EB5'   0E 1A                 	MVI	C,1AH		; set the DMA
  1EB7'   CD 0005               	CALL	BDOS
  1EBA'   C1                    	POP	B
  1EBB'   11 0000*              	LXI	D,TFCB
  1EBE'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1EC1'                         EXRNG:
  1EC1'   2A 2B3C'              	LHLD	SRNG1
  1EC4'   7C                    	MOV	A,H
  1EC5'   B5                    	ORA	L
  1EC6'   37                    	STC
  1EC7'   C8                    	RZ
  1EC8'   2A 2B3E'              	LHLD	SRNG2
  1ECB'   EB                    	XCHG
  1ECC'   2A 2B3C'              	LHLD	SRNG1
  1ECF'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1ED2'   D8                    	RC
  1ED3'   EB                    	XCHG			; HL = the last line, DE = the first
  1ED4'   CD 0000*              	CALL	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1ED7'   23                    	INX	H
  1ED8'   22 2B46'              	SHLD	SLINES
  1EDB'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1EDC'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1EDD'                         GOLNX:
  1EDD'   E5                    	PUSH	H
  1EDE'   CD 0F29'              	CALL	GOLN
  1EE1'   CD 0000*              	CALL	CNTLF
  1EE4'   23                    	INX	H		; the line the cursor came to rest on
  1EE5'   D1                    	POP	D
  1EE6'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1EE9'                         EXSAVP:
  1EE9'   CD 0D47'              	CALL	CURRW
  1EEC'   32 2AE4'              	STA	WPROW
  1EEF'   21 2B1D'              	LXI	H,MKPOS
  1EF2'   C3 0429'              	JMP	FPSTO
  1EF5'                         EXRSTP:
  1EF5'   CD 0000*              	CALL	CLRCNT
  1EF8'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  1EFB'   CD 0000*              	CALL	GOTO
  1EFE'   C3 1E32'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1F01'                         PUTBRK:
  1F01'   3E 0D                 	MVI	A,CR
  1F03'   CD 0000*              	CALL	PUTGAP
  1F06'   3E 0A                 	MVI	A,LF
  1F08'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1F0B'                         EX_WR:
  1F0B'   3A 2AE0'              	LDA	EXARG
  1F0E'   B7                    	ORA	A
  1F0F'   CA 2309'              	JZ	MSGNFN		; No file name
  1F12'   CD 2152'              	CALL	ISOWN
  1F15'   CA 1FB5'              	JZ	EXW_OW
  1F18'   CD 0000*              	CALL	TEXIST
  1F1B'   32 2B49'              	STA	RWERR		; nonzero: a file of that name is there
  1F1E'   CA 1F28'              	JZ	EXW_GO
  1F21'   3A 2AF2'              	LDA	EXBANG
  1F24'   B7                    	ORA	A
  1F25'   C2 230F'              	JNZ	MSGEXI		; File exists (! to force)
  1F28'                         EXW_GO:
  1F28'   CD 1EC1'              	CALL	EXRNG
  1F2B'   DA 1FAF'              	JC	EXW_BD
  1F2E'   CD 1EE9'              	CALL	EXSAVP
  1F31'   2A 2B3C'              	LHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F34'   CD 1EDD'              	CALL	GOLNX
  1F37'   C2 1FAC'              	JNZ	EXW_NL		; the text has no line N
  1F3A'   3A 2B49'              	LDA	RWERR		; a delete scans the whole directory, there or
  1F3D'   B7                    	ORA	A		;   not: only when TEXIST found one
  1F3E'   0E 13                 	MVI	C,13H
  1F40'   C4 1EB1'              	CNZ	TFDOS		; delete what is there
  1F43'   0E 16                 	MVI	C,16H
  1F45'   CD 1EB1'              	CALL	TFDOS		; ... and make it
  1F48'   3C                    	INR	A
  1F49'   CA 1F9E'              	JZ	EXW_FL		; no directory entry left
  1F4C'   3E 80                 	MVI	A,80H
  1F4E'   32 2B48'              	STA	RWPTR
  1F51'   AF                    	XRA	A
  1F52'   32 2B49'              	STA	RWERR
  1F55'   2A 2B46'              	LHLD	SLINES
  1F58'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1F5B'                         EXW_LP:
  1F5B'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1F5E'   E5                    	PUSH	H
  1F5F'   EB                    	XCHG
  1F60'   2A 0000*              	LHLD	GAPEND
  1F63'   CD 1FBB'              	CALL	RWOUT		; the text from the cursor to there
  1F66'   E1                    	POP	H
  1F67'   3A 2B49'              	LDA	RWERR
  1F6A'   B7                    	ORA	A
  1F6B'   C2 1F87'              	JNZ	EXW_EN
  1F6E'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1F71'   CD 06E0'              	CALL	CNTTST
  1F74'   C2 1F5B'              	JNZ	EXW_LP
  1F77'                         EXW_PD:				; the last record is padded out with ^Z
  1F77'   3A 2B48'              	LDA	RWPTR
  1F7A'   FE 80                 	CPI	80H
  1F7C'   CA 1F87'              	JZ	EXW_EN
  1F7F'   3E 1A                 	MVI	A,CPMEOF
  1F81'   CD 1FC7'              	CALL	RWPUT
  1F84'   C3 1F77'              	JMP	EXW_PD
  1F87'                         EXW_EN:
  1F87'   0E 10                 	MVI	C,10H
  1F89'   CD 1EB1'              	CALL	TFDOS		; close
  1F8C'   3A 2B49'              	LDA	RWERR
  1F8F'   B7                    	ORA	A
  1F90'   C2 1F9E'              	JNZ	EXW_FL
  1F93'   CD 1EF5'              	CALL	EXRSTP
  1F96'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F98'   32 2AF0'              	STA	MSGWHT
  1F9B'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  1F9E'                         EXW_FL:				; no room: the part written is not left behind
  1F9E'   0E 13                 	MVI	C,13H
  1FA0'   CD 1EB1'              	CALL	TFDOS
  1FA3'   CD 1EF5'              	CALL	EXRSTP
  1FA6'   21 24D6'              	LXI	H,SDFUL
  1FA9'   C3 2341'              	JMP	EXERR
  1FAC'                         EXW_NL:
  1FAC'   CD 1EF5'              	CALL	EXRSTP
  1FAF'                         EXW_BD:
  1FAF'   21 24C8'              	LXI	H,SRNGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FB2'   C3 2341'              	JMP	EXERR
  1FB5'                         EXW_OW:
  1FB5'   21 2370'              	LXI	H,SEXI
  1FB8'   C3 2341'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1FBB'                         RWOUT:
  1FBB'   CD 0000*              	CALL	CMP16
  1FBE'   C8                    	RZ
  1FBF'   7E                    	MOV	A,M
  1FC0'   23                    	INX	H
  1FC1'   CD 1FC7'              	CALL	RWPUT
  1FC4'   C3 1FBB'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1FC7'                         RWPUT:
  1FC7'   E5                    	PUSH	H
  1FC8'   F5                    	PUSH	PSW
  1FC9'   3A 2B48'              	LDA	RWPTR
  1FCC'   6F                    	MOV	L,A
  1FCD'   26 00                 	MVI	H,0
  1FCF'   F1                    	POP	PSW
  1FD0'   77                    	MOV	M,A
  1FD1'   2C                    	INR	L		; Z: that was the record's last byte
  1FD2'   7D                    	MOV	A,L
  1FD3'   C2 1FE6'              	JNZ	RWP_ST
  1FD6'   D5                    	PUSH	D
  1FD7'   0E 15                 	MVI	C,15H
  1FD9'   CD 1EB1'              	CALL	TFDOS		; write it
  1FDC'   D1                    	POP	D
  1FDD'   B7                    	ORA	A
  1FDE'   CA 1FE4'              	JZ	RWP_OK
  1FE1'   32 2B49'              	STA	RWERR
  1FE4'                         RWP_OK:
  1FE4'   3E 80                 	MVI	A,80H
  1FE6'                         RWP_ST:
  1FE6'   32 2B48'              	STA	RWPTR
  1FE9'   E1                    	POP	H
  1FEA'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1FEB'                         EX_R:
  1FEB'   3A 2AE0'              	LDA	EXARG
  1FEE'   B7                    	ORA	A
  1FEF'   CA 2309'              	JZ	MSGNFN		; No file name
  1FF2'   0E 0F                 	MVI	C,0FH
  1FF4'   CD 1EB1'              	CALL	TFDOS		; open
  1FF7'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FF8'   CA 20C5'              	JZ	ER_NOF
  1FFB'   CD 0FBB'              	CALL	GZONE		; the screen's top line, before anything moves
  1FFE'   CD 1EE9'              	CALL	EXSAVP
  2001'   3A 2B3B'              	LDA	SRNGF
  2004'   B7                    	ORA	A
  2005'   CA 201E'              	JZ	ER_NXT		; no line given: below the cursor's
  2008'   2A 2B3E'              	LHLD	SRNG2
  200B'   7C                    	MOV	A,H
  200C'   B5                    	ORA	L
  200D'   C2 2018'              	JNZ	ER_LN
  2010'   23                    	INX	H
  2011'   CD 0F29'              	CALL	GOLN		; ':0r': above line 1 ...
  2014'   AF                    	XRA	A		;   which never wants a line end put in first
  2015'   C3 2040'              	JMP	ER_BRK
  2018'                         ER_LN:
  2018'   CD 1EDD'              	CALL	GOLNX
  201B'   C2 1FAC'              	JNZ	EXW_NL		; the text has no line N
  201E'                         ER_NXT:
  201E'   21 0001               	LXI	H,1
  2021'   AF                    	XRA	A
  2022'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2025'   CD 0A63'              	CALL	ATEOF
  2028'   3E 00                 	MVI	A,0
  202A'   D2 2040'              	JNC	ER_BRK		; text follows
  202D'   2A 0000*              	LHLD	GAPBEG
  2030'   EB                    	XCHG
  2031'   2A 0000*              	LHLD	TXTBEG
  2034'   CD 0000*              	CALL	CMP16
  2037'   3E 01                 	MVI	A,1
  2039'   CA 2040'              	JZ	ER_BRK		; nothing before the cursor either
  203C'   1B                    	DCX	D
  203D'   1A                    	LDAX	D
  203E'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2040'                         ER_BRK:
  2040'   32 2B4B'              	STA	RDBRK
  2043'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2046'   AF                    	XRA	A
  2047'   32 2B4A'              	STA	RDANY
  204A'                         ER_LP:
  204A'   0E 14                 	MVI	C,14H
  204C'   CD 1EB1'              	CALL	TFDOS		; the next record
  204F'   B7                    	ORA	A
  2050'   C2 2083'              	JNZ	ER_END
  2053'   21 0080               	LXI	H,CMDTAIL
  2056'   0E 00                 	MVI	C,0
  2058'                         ER_SC:				; C = its bytes, up to a ^Z
  2058'   7E                    	MOV	A,M
  2059'   FE 1A                 	CPI	CPMEOF
  205B'   CA 2063'              	JZ	ER_GOT
  205E'   23                    	INX	H
  205F'   0C                    	INR	C
  2060'   F2 2058'              	JP	ER_SC		; (minus: all 128)
  2063'                         ER_GOT:
  2063'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2064'   B7                    	ORA	A
  2065'   CA 2083'              	JZ	ER_END
  2068'   C5                    	PUSH	B
  2069'   3A 2B4A'              	LDA	RDANY
  206C'   B7                    	ORA	A
  206D'   CC 20B4'              	CZ	ER_1ST
  2070'   C1                    	POP	B
  2071'   06 00                 	MVI	B,0
  2073'   11 0080               	LXI	D,CMDTAIL
  2076'   C5                    	PUSH	B
  2077'   CD 0000*              	CALL	INSBLK
  207A'   C1                    	POP	B
  207B'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  207E'   79                    	MOV	A,C
  207F'   17                    	RAL
  2080'   DA 204A'              	JC	ER_LP		; a full record: there may be more
  2083'                         ER_END:
  2083'   3A 2B4A'              	LDA	RDANY
  2086'   B7                    	ORA	A
  2087'   CA 20A5'              	JZ	ER_PL		; nothing in the file: nothing has changed
  208A'   CD 0A63'              	CALL	ATEOF
  208D'   DA 209A'              	JC	ER_MD		; the text now ends as the file read ends
  2090'   2A 0000*              	LHLD	GAPBEG
  2093'   2B                    	DCX	H
  2094'   7E                    	MOV	A,M
  2095'   FE 0A                 	CPI	LF
  2097'   C4 1F01'              	CNZ	PUTBRK		; text follows: what was read ends a line
  209A'                         ER_MD:
  209A'   3E 01                 	MVI	A,1
  209C'   32 2A88'              	STA	MODF
  209F'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  20A2'   CD 0000*              	CALL	GOTO
  20A5'                         ER_PL:
  20A5'   CD 0A63'              	CALL	ATEOF
  20A8'   DC 0A69'              	CC	LASTLN		; (nothing read, at the end: the last line)
  20AB'   CD 0000*              	CALL	CLRCNT
  20AE'   CD 0FD3'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  20B1'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  20B4'                         ER_1ST:
  20B4'   3C                    	INR	A
  20B5'   32 2B4A'              	STA	RDANY
  20B8'   3A 2B4B'              	LDA	RDBRK
  20BB'   B7                    	ORA	A
  20BC'   C4 1F01'              	CNZ	PUTBRK
  20BF'   21 2B1D'              	LXI	H,MKPOS
  20C2'   C3 0429'              	JMP	FPSTO
  20C5'                         ER_NOF:
  20C5'   21 24B7'              	LXI	H,SNOPN
  20C8'   C3 2336'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20CB'                         WRCHK:
  20CB'   3A 2AE0'              	LDA	EXARG
  20CE'   B7                    	ORA	A
  20CF'   C2 20D9'              	JNZ	WC_ARG
  20D2'   CD 213C'              	CALL	OWNTF
  20D5'   D8                    	RC
  20D6'   C3 20EE'              	JMP	WC_OWN
  20D9'                         WC_ARG:
  20D9'   CD 2152'              	CALL	ISOWN
  20DC'   CA 20EE'              	JZ	WC_OWN
  20DF'   3A 2AF2'              	LDA	EXBANG
  20E2'   B7                    	ORA	A
  20E3'   CA 20EC'              	JZ	WC_OTH
  20E6'   CD 0000*              	CALL	TEXIST
  20E9'   C2 230F'              	JNZ	MSGEXI		; File exists (! to force)
  20EC'                         WC_OTH:
  20EC'   AF                    	XRA	A		; (NC)
  20ED'   C9                    	RET
  20EE'                         WC_OWN:
  20EE'   3A 2AF3'              	LDA	ROFLAG		; '-R': this is the file it may not write
  20F1'   B7                    	ORA	A
  20F2'   CA 20FC'              	JZ	WC_OK
  20F5'   3A 2AF2'              	LDA	EXBANG
  20F8'   B7                    	ORA	A
  20F9'   C2 2315'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  20FC'                         WC_OK:
  20FC'   3E 01                 	MVI	A,1
  20FE'   B7                    	ORA	A		; (NC)
  20FF'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2100'                         WRITE:
  2100'   3A 2AE1'              	LDA	EXBAK
  2103'   CD 0000*              	CALL	WRTO
  2106'   3A 0001*              	LDA	FNAME+1
  2109'   FE 20                 	CPI	' '
  210B'   C2 2117'              	JNZ	WR_HAS
  210E'   21 0000*              	LXI	H,TFCB
  2111'   11 0000*              	LXI	D,FNAME
  2114'   CD 2164'              	CALL	COPY12
  2117'                         WR_HAS:
  2117'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2119'   32 2AF0'              	STA	MSGWHT
  211C'   CD 2152'              	CALL	ISOWN
  211F'   C2 2129'              	JNZ	SRCTF
  2122'   AF                    	XRA	A
  2123'   32 2A88'              	STA	MODF
  2126'   32 2AF1'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2129'                         SRCTF:
  2129'   21 0000*              	LXI	H,TFCB
  212C'   11 005C               	LXI	D,DFTFCB
  212F'   CD 2164'              	CALL	COPY12
  2132'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2133'   06 04                 	MVI	B,4
  2135'                         SRC_Z:
  2135'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2136'   13                    	INX	D
  2137'   05                    	DCR	B
  2138'   C2 2135'              	JNZ	SRC_Z
  213B'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  213C'                         OWNTF:
  213C'   3A 0001*              	LDA	FNAME+1
  213F'   FE 20                 	CPI	' '
  2141'   CA 2309'              	JZ	MSGNFN
  2144'   CD 216F'              	CALL	TFCLR
  2147'   21 0000*              	LXI	H,FNAME
  214A'   11 0000*              	LXI	D,TFCB
  214D'   CD 2164'              	CALL	COPY12
  2150'   B7                    	ORA	A		; (NC)
  2151'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2152'                         ISOWN:
  2152'   21 0000*              	LXI	H,TFCB
  2155'   11 0000*              	LXI	D,FNAME
  2158'   06 0C                 	MVI	B,12
  215A'                         IO_LP:
  215A'   1A                    	LDAX	D
  215B'   BE                    	CMP	M
  215C'   C0                    	RNZ
  215D'   23                    	INX	H
  215E'   13                    	INX	D
  215F'   05                    	DCR	B
  2160'   C2 215A'              	JNZ	IO_LP
  2163'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  2164'                         COPY12:
  2164'   06 0C                 	MVI	B,12
  2166'                         CP_LP:
  2166'   7E                    	MOV	A,M
  2167'   12                    	STAX	D
  2168'   23                    	INX	H
  2169'   13                    	INX	D
  216A'   05                    	DCR	B
  216B'   C2 2166'              	JNZ	CP_LP
  216E'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  216F'                         TFCLR:
  216F'   11 0000*              	LXI	D,TFCB
  2172'   06 24                 	MVI	B,36
  2174'   AF                    	XRA	A
  2175'                         TC_LP:
  2175'   12                    	STAX	D
  2176'   13                    	INX	D
  2177'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2178'   C2 2175'              	JNZ	TC_LP
  217B'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  217C'                         FOPEN:
  217C'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  217E'   32 2AF0'              	STA	MSGWHT
  2181'   21 005C               	LXI	H,DFTFCB
  2184'   CD 2252'              	CALL	NRMDRV
  2187'   11 0000*              	LXI	D,FNAME
  218A'   CD 2164'              	CALL	COPY12
  218D'   CD 0000*              	CALL	OPENZ
  2190'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2193'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2195'   C8                    	RZ
  2196'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2199'   32 2AF1'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  219C'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  219D'                         ARGSCN:
  219D'   3A 0080               	LDA	CMDTAIL
  21A0'   47                    	MOV	B,A		; B = what is left of the line
  21A1'   B7                    	ORA	A
  21A2'   C8                    	RZ
  21A3'   21 0081               	LXI	H,CMDTAIL+1
  21A6'                         AS_TOK:				; at a token, or the blanks before one
  21A6'   7E                    	MOV	A,M
  21A7'   FE 20                 	CPI	' '
  21A9'   C2 21B2'              	JNZ	AS_OPT
  21AC'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AD'   05                    	DCR	B
  21AE'   C2 21A6'              	JNZ	AS_TOK
  21B1'   C9                    	RET
  21B2'                         AS_OPT:
  21B2'   FE 2B                 	CPI	'+'
  21B4'   CA 21DE'              	JZ	AS_PLS
  21B7'   FE 2D                 	CPI	'-'
  21B9'   CA 21CD'              	JZ	AS_SW
  21BC'   FE 2F                 	CPI	'/'
  21BE'   CA 21CD'              	JZ	AS_SW
  21C1'                         AS_SKP:				; not ours (the file name): on to the next one
  21C1'   23                    	INX	H
  21C2'   05                    	DCR	B
  21C3'   C8                    	RZ
  21C4'   7E                    	MOV	A,M
  21C5'   FE 20                 	CPI	' '
  21C7'   C2 21C1'              	JNZ	AS_SKP
  21CA'   C3 21A6'              	JMP	AS_TOK
  21CD'                         AS_SW:
  21CD'   23                    	INX	H
  21CE'   05                    	DCR	B
  21CF'   C8                    	RZ
  21D0'   7E                    	MOV	A,M
  21D1'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  21D3'   FE 52                 	CPI	'R'
  21D5'   C2 21C1'              	JNZ	AS_SKP
  21D8'   32 2AF3'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  21DB'   C3 21C1'              	JMP	AS_SKP
  21DE'                         AS_PLS:
  21DE'   3E 01                 	MVI	A,1
  21E0'   32 2AF4'              	STA	PLUSF		; '+' gets the line even with no number on it
  21E3'   11 0000*              	LXI	D,PLUSB
  21E6'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  21E8'   23                    	INX	H		;   line space, so it is taken as '+' alone
  21E9'   05                    	DCR	B
  21EA'   CA 2221'              	JZ	AS_PE
  21ED'   7E                    	MOV	A,M
  21EE'   FE 30                 	CPI	'0'
  21F0'   C2 2208'              	JNZ	AS_PD
  21F3'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  21F3'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  21F4'   05                    	DCR	B
  21F5'   CA 2229'              	JZ	AS_P1
  21F8'   7E                    	MOV	A,M
  21F9'   FE 30                 	CPI	'0'
  21FB'   CA 21F3'              	JZ	AS_PZ
  21FE'   FE 31                 	CPI	'1'
  2200'   DA 2229'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2203'   FE 3A                 	CPI	'9'+1
  2205'   D2 2229'              	JNC	AS_P1
  2208'                         AS_PD:				; the digits, as typed
  2208'   7E                    	MOV	A,M
  2209'   FE 30                 	CPI	'0'
  220B'   DA 2221'              	JC	AS_PE
  220E'   FE 3A                 	CPI	'9'+1
  2210'   D2 2221'              	JNC	AS_PE
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2213'   79                    	MOV	A,C
  2214'   B7                    	ORA	A
  2215'   CA 2230'              	JZ	AS_POV
  2218'   0D                    	DCR	C
  2219'   7E                    	MOV	A,M
  221A'   12                    	STAX	D
  221B'   13                    	INX	D
  221C'   23                    	INX	H
  221D'   05                    	DCR	B
  221E'   C2 2208'              	JNZ	AS_PD
  2221'                         AS_PE:
  2221'   AF                    	XRA	A
  2222'   12                    	STAX	D		; the digits end with a 0
  2223'   78                    	MOV	A,B
  2224'   B7                    	ORA	A
  2225'   C8                    	RZ
  2226'   C3 21A6'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2229'                         AS_P1:
  2229'   3E 31                 	MVI	A,'1'
  222B'   12                    	STAX	D
  222C'   13                    	INX	D
  222D'   C3 2221'              	JMP	AS_PE
  2230'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2230'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2233'   C3 2221'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2236'                         ARGGO:
  2236'   3A 2AF4'              	LDA	PLUSF
  2239'   B7                    	ORA	A
  223A'   C8                    	RZ
  223B'   21 0000*              	LXI	H,PLUSB
  223E'                         AG_LP:
  223E'   7E                    	MOV	A,M
  223F'   B7                    	ORA	A
  2240'   CA 224D'              	JZ	AG_G
  2243'   4F                    	MOV	C,A
  2244'   E5                    	PUSH	H
  2245'   CD 0023'              	CALL	VICMD
  2248'   E1                    	POP	H
  2249'   23                    	INX	H
  224A'   C3 223E'              	JMP	AG_LP
  224D'                         AG_G:
  224D'   0E 47                 	MVI	C,'G'
  224F'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  2252'                         NRMDRV:
  2252'   7E                    	MOV	A,M
  2253'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2254'   C0                    	RNZ
  2255'   E5                    	PUSH	H
  2256'   0E 19                 	MVI	C,BF_CURDSK
  2258'   CD 0005               	CALL	BDOS
  225B'   E1                    	POP	H
  225C'   3C                    	INR	A
  225D'   77                    	MOV	M,A
  225E'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  225F'                         PARSFN:
  225F'   CD 216F'              	CALL	TFCLR
  2262'   11 0000*              	LXI	D,TFCB
  2265'   23                    	INX	H
  2266'   7E                    	MOV	A,M
  2267'   2B                    	DCX	H
  2268'   FE 3A                 	CPI	':'
  226A'   C2 227C'              	JNZ	PF_NM
  226D'   CD 22C2'              	CALL	GETFNC
  2270'   CA 227C'              	JZ	PF_NM
  2273'   D6 40                 	SUI	40H
  2275'   12                    	STAX	D
  2276'   FE 11                 	CPI	17
  2278'   D2 22A0'              	JNC	PF_BAD
  227B'   23                    	INX	H
  227C'                         PF_NM:
  227C'   13                    	INX	D
  227D'   0E 08                 	MVI	C,8
  227F'   CD 22A4'              	CALL	CPYNAM
  2282'   FE 2E                 	CPI	'.'
  2284'   0E 03                 	MVI	C,3
  2286'   C4 22B7'              	CNZ	PADFLD		; no type: blanks
  2289'   CC 22A3'              	CZ	CPYNM0		; '.': the type
  228C'   3A 0001*              	LDA	TFCB+1
  228F'   FE 20                 	CPI	' '
  2291'   CA 22A0'              	JZ	PF_BAD		; no name
  2294'   CD 22F5'              	CALL	SKIPB
  2297'   C0                    	RNZ			; more after it
  2298'   21 0000*              	LXI	H,TFCB
  229B'   CD 2252'              	CALL	NRMDRV
  229E'   AF                    	XRA	A
  229F'   C9                    	RET
  22A0'                         PF_BAD:
  22A0'   F6 01                 	ORI	1
  22A2'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  22A3'                         CPYNM0:
  22A3'   23                    	INX	H
