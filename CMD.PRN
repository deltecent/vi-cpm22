  0F29'   CD 1136'              	CALL	HFCNT		; HFN = the rows
  0F2C'   CD 0D47'              	CALL	CURRW
  0F2F'   47                    	MOV	B,A
  0F30'   3A 0000*              	LDA	SCEOF
  0F33'   B7                    	ORA	A
  0F34'   CA 0F3C'              	JZ	VHD_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F37'   3A 0000*              	LDA	SCBOT		; the last line's place
  0F3A'   B8                    	CMP	B
  0F3B'   C8                    	RZ			; the cursor is on it
  0F3C'                         VHD_GO:
  0F3C'   3A 0000*              	LDA	NEDIT
  0F3F'   21 2CF0'              	LXI	H,HFN
  0F42'   86                    	ADD	M
  0F43'   3C                    	INR	A
  0F44'   4F                    	MOV	C,A
  0F45'   AF                    	XRA	A
  0F46'   CD 1013'              	CALL	HTSET		; HL -> the top line's rows
  0F49'   3A 2CF0'              	LDA	HFN
  0F4C'   57                    	MOV	D,A		; D = the rows the text moves
  0F4D'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0F4E'   3A 2CF6'              	LDA	HTEOF
  0F51'   B7                    	ORA	A
  0F52'   CA 0F71'              	JZ	VHD_1
  0F55'   E5                    	PUSH	H
  0F56'   C5                    	PUSH	B
  0F57'   0E FF                 	MVI	C,255
  0F59'   CD 1052'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0F5C'   3A 0000*              	LDA	NEDIT
  0F5F'   81                    	ADD	C
  0F60'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0F61'   C1                    	POP	B
  0F62'   E1                    	POP	H
  0F63'   B7                    	ORA	A
  0F64'   FA 0F6F'              	JM	VHD_0		; none
  0F67'   BA                    	CMP	D
  0F68'   D2 0F71'              	JNC	VHD_1
  0F6B'   57                    	MOV	D,A
  0F6C'   C3 0F71'              	JMP	VHD_1
  0F6F'                         VHD_0:
  0F6F'   16 00                 	MVI	D,0
  0F71'                         VHD_1:
  0F71'   7A                    	MOV	A,D
  0F72'   B7                    	ORA	A
  0F73'   CA 0F8E'              	JZ	VHD_C		; the text stays
  0F76'   4A                    	MOV	C,D
  0F77'   CD 1052'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0F7A'   79                    	MOV	A,C
  0F7B'   B7                    	ORA	A
  0F7C'   CA 0F8E'              	JZ	VHD_C
  0F7F'   BA                    	CMP	D
  0F80'   C2 0F8B'              	JNZ	VHD_R
  0F83'   7E                    	MOV	A,M		; the top line still: past all of it
  0F84'   91                    	SUB	C
  0F85'   83                    	ADD	E
  0F86'   5F                    	MOV	E,A
  0F87'   23                    	INX	H
  0F88'   C3 0F8E'              	JMP	VHD_C
  0F8B'                         VHD_R:
  0F8B'   7B                    	MOV	A,E		; part of the way down a line: its start
  0F8C'   91                    	SUB	C
  0F8D'   5F                    	MOV	E,A
  0F8E'                         VHD_C:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F8E'   22 2CF1'              	SHLD	HFTP
  0F91'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  0F94'   83                    	ADD	E
  0F95'   4F                    	MOV	C,A
  0F96'   3A 2CF4'              	LDA	HTCUR
  0F99'   CD 1034'              	CALL	HTPT
  0F9C'   CD 1052'              	CALL	HTFQ
  0F9F'   D2 0FA3'              	JNC	HFEND
  0FA2'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  0FA3'                         HFEND:
  0FA3'   EB                    	XCHG
  0FA4'   2A 2CF1'              	LHLD	HFTP
  0FA7'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  0FA8'                         HTLAND:
  0FA8'   E5                    	PUSH	H
  0FA9'   D5                    	PUSH	D
  0FAA'   CD 1047'              	CALL	HTGO
  0FAD'   D1                    	POP	D
  0FAE'   E1                    	POP	H
  0FAF'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  0FB2'   7C                    	MOV	A,H
  0FB3'   B7                    	ORA	A
  0FB4'   7D                    	MOV	A,L
  0FB5'   CA 0FB9'              	JZ	HL_SET
  0FB8'   AF                    	XRA	A
  0FB9'                         HL_SET:
  0FB9'   CD 0D66'              	CALL	SETRWT
  0FBC'   C3 087A'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  0FBF'                         VC_HFUP:
  0FBF'   CD 07A0'              	CALL	SETMOV
  0FC2'   CD 1136'              	CALL	HFCNT		; HFN = the rows
  0FC5'   CD 1116'              	CALL	ONFST
  0FC8'   C8                    	RZ			; the cursor is on the first line
  0FC9'   0E 01                 	MVI	C,1
  0FCB'   3A 2CF0'              	LDA	HFN
  0FCE'   CD 1013'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FD1'   43                    	MOV	B,E
  0FD2'   3A 2CF0'              	LDA	HFN
  0FD5'   4F                    	MOV	C,A
  0FD6'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0FD7'   CD 1063'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  0FDA'   DA 0FF5'              	JC	VHU_C		;   above it; or the file's first line
  0FDD'   79                    	MOV	A,C
  0FDE'   B7                    	ORA	A
  0FDF'   CA 0FF5'              	JZ	VHU_C
  0FE2'   3A 2CF5'              	LDA	HTTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FE5'   3D                    	DCR	A
  0FE6'   B8                    	CMP	B
  0FE7'   CA 0FF2'              	JZ	VHU_F
  0FEA'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  0FEB'   96                    	SUB	M
  0FEC'   81                    	ADD	C
  0FED'   5F                    	MOV	E,A
  0FEE'   23                    	INX	H
  0FEF'   C3 0FF5'              	JMP	VHU_C
  0FF2'                         VHU_F:
  0FF2'   7B                    	MOV	A,E		; ... the first line back: all of it
  0FF3'   81                    	ADD	C
  0FF4'   5F                    	MOV	E,A
  0FF5'                         VHU_C:
  0FF5'   22 2CF1'              	SHLD	HFTP
  0FF8'   4B                    	MOV	C,E
  0FF9'   3A 2CF4'              	LDA	HTCUR
  0FFC'   CD 1034'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  0FFF'   3A 0000*              	LDA	CSUB
  1002'   57                    	MOV	D,A
  1003'   79                    	MOV	A,C
  1004'   92                    	SUB	D		; the rows to go, less those of its own line above it
  1005'   DA 0FA3'              	JC	HFEND
  1008'   CA 0FA3'              	JZ	HFEND
  100B'   4F                    	MOV	C,A
  100C'   43                    	MOV	B,E
  100D'   CD 1063'              	CALL	HTBQ		; (off the top: the file's first line)
  1010'   C3 0FA3'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
  1013'                         HTSET:
  1013'   47                    	MOV	B,A
  1014'   CD 0D47'              	CALL	CURRW		; (keeps BC)
  1017'   F5                    	PUSH	PSW
  1018'   80                    	ADD	B
  1019'   47                    	MOV	B,A
  101A'   CD 1028'              	CALL	HTRB
  101D'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  101E'   3A 2CF4'              	LDA	HTCUR
  1021'   90                    	SUB	B
  1022'   32 2CF5'              	STA	HTTP
  1025'   C3 1034'              	JMP	HTPT
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1028'                         HTRB:
  1028'   CD 1206'              	CALL	ZSAVE
  102B'   CD 0000*              	CALL	HTBLD
  102E'   CD 1219'              	CALL	ZREST
  1031'   3A 2CF4'              	LDA	HTCUR
  1034'                         HTPT:
  1034'   5F                    	MOV	E,A
  1035'   16 00                 	MVI	D,0
  1037'   21 0000*              	LXI	H,HTAB
  103A'   19                    	DAD	D
  103B'   3A 2CF3'              	LDA	HTN
  103E'   93                    	SUB	E
  103F'   47                    	MOV	B,A
  1040'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1041'                         HTIX:
  1041'   11 0000*              	LXI	D,HTAB
  1044'   7D                    	MOV	A,L
  1045'   93                    	SUB	E
  1046'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1047'                         HTGO:
  1047'   CD 1041'              	CALL	HTIX
  104A'   47                    	MOV	B,A
  104B'   3A 2CF4'              	LDA	HTCUR
  104E'   90                    	SUB	B		; A = the lines up to it
  104F'   C3 0D7E'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1052'                         HTFQ:
  1052'   78                    	MOV	A,B
  1053'   B7                    	ORA	A
  1054'   37                    	STC
  1055'   C8                    	RZ
  1056'   79                    	MOV	A,C
  1057'   96                    	SUB	M
  1058'   DA 1061'              	JC	HF_IN
  105B'   4F                    	MOV	C,A
  105C'   23                    	INX	H
  105D'   05                    	DCR	B
  105E'   C3 1052'              	JMP	HTFQ
  1061'                         HF_IN:
  1061'   B7                    	ORA	A
  1062'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1063'                         HTBQ:
  1063'   78                    	MOV	A,B
  1064'   B7                    	ORA	A
  1065'   37                    	STC
  1066'   C8                    	RZ
  1067'   2B                    	DCX	H
  1068'   05                    	DCR	B
  1069'   7E                    	MOV	A,M
  106A'   91                    	SUB	C
  106B'   D2 1074'              	JNC	HQ_IN
  106E'   2F                    	CMA
  106F'   3C                    	INR	A
  1070'   4F                    	MOV	C,A
  1071'   C3 1063'              	JMP	HTBQ
  1074'                         HQ_IN:
  1074'   4F                    	MOV	C,A
  1075'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1076'                         RWQ:
  1076'   0E 64                 	MVI	C,100
  1078'   3A 2CF9'              	LDA	RWR+1
  107B'   B7                    	ORA	A
  107C'   C0                    	RNZ
  107D'   3A 2CF8'              	LDA	RWR
  1080'   B9                    	CMP	C
  1081'   D0                    	RNC
  1082'   4F                    	MOV	C,A
  1083'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1084'                         RWSUB:
  1084'   E5                    	PUSH	H
  1085'   5F                    	MOV	E,A
  1086'   16 00                 	MVI	D,0
  1088'   2A 2CF8'              	LHLD	RWR
  108B'   CD 0000*              	CALL	SUBHD
  108E'   22 2CF8'              	SHLD	RWR
  1091'   E1                    	POP	H
  1092'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1093'                         RWFWD:
  1093'   CD 1076'              	CALL	RWQ
  1096'   51                    	MOV	D,C
  1097'   CD 1052'              	CALL	HTFQ
  109A'   F5                    	PUSH	PSW
  109B'   7A                    	MOV	A,D
  109C'   91                    	SUB	C		; the rows that took it to that line's first
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  109D'   CD 1084'              	CALL	RWSUB
  10A0'   F1                    	POP	PSW
  10A1'   DA 10B5'              	JC	RF_OFF
  10A4'   3A 2CF9'              	LDA	RWR+1		; is what is left inside this line?
  10A7'   B7                    	ORA	A
  10A8'   C2 10BF'              	JNZ	RF_GO
  10AB'   3A 2CF8'              	LDA	RWR
  10AE'   BE                    	CMP	M
  10AF'   D2 10BF'              	JNC	RF_GO
  10B2'   4F                    	MOV	C,A
  10B3'   B7                    	ORA	A
  10B4'   C9                    	RET
  10B5'                         RF_OFF:
  10B5'   3A 2CF6'              	LDA	HTEOF
  10B8'   B7                    	ORA	A
  10B9'   CA 10BF'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  10BC'   2B                    	DCX	H
  10BD'   37                    	STC
  10BE'   C9                    	RET
  10BF'                         RF_GO:
  10BF'   CD 1047'              	CALL	HTGO
  10C2'   3E 01                 	MVI	A,1
  10C4'   32 2CFA'              	STA	RWMV
  10C7'   CD 1076'              	CALL	RWQ
  10CA'   0C                    	INR	C
  10CB'   06 00                 	MVI	B,0
  10CD'   CD 1028'              	CALL	HTRB
  10D0'   C3 1093'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  10D3'                         RWBAK:
  10D3'   CD 1076'              	CALL	RWQ
  10D6'   51                    	MOV	D,C
  10D7'   CD 1063'              	CALL	HTBQ
  10DA'   DA 10F7'              	JC	RB_OFF
  10DD'   7A                    	MOV	A,D
  10DE'   81                    	ADD	C
  10DF'   5F                    	MOV	E,A		; E = the rows up to that line's first
  10E0'   3A 2CF9'              	LDA	RWR+1
  10E3'   B7                    	ORA	A
  10E4'   C2 10F3'              	JNZ	RB_ON
  10E7'   3A 2CF8'              	LDA	RWR
  10EA'   57                    	MOV	D,A
  10EB'   7B                    	MOV	A,E
  10EC'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  10ED'   DA 10F3'              	JC	RB_ON
  10F0'   4F                    	MOV	C,A
  10F1'   B7                    	ORA	A
  10F2'   C9                    	RET
  10F3'                         RB_ON:
  10F3'   7B                    	MOV	A,E
  10F4'   C3 10FE'              	JMP	RB_GO
  10F7'                         RB_OFF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  10F7'   3A 2CF7'              	LDA	HTBOF
  10FA'   0F                    	RRC			; CY: that is the file's first line
  10FB'   D8                    	RC
  10FC'   7A                    	MOV	A,D
  10FD'   91                    	SUB	C
  10FE'                         RB_GO:
  10FE'   CD 1084'              	CALL	RWSUB
  1101'   CD 1047'              	CALL	HTGO
  1104'   3E 01                 	MVI	A,1
  1106'   32 2CFA'              	STA	RWMV
  1109'   CD 1076'              	CALL	RWQ
  110C'   41                    	MOV	B,C
  110D'   0E 01                 	MVI	C,1
  110F'   CD 1028'              	CALL	HTRB
  1112'   43                    	MOV	B,E
  1113'   C3 10D3'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  1116'                         ONFST:
  1116'   E5                    	PUSH	H
  1117'   2A 0000*              	LHLD	OUTPOS
  111A'   7C                    	MOV	A,H
  111B'   B5                    	ORA	L
  111C'   C2 1134'              	JNZ	OF_RET
  111F'   2A 0000*              	LHLD	TXTBEG
  1122'   EB                    	XCHG			; DE = TXTBEG
  1123'   2A 0000*              	LHLD	GAPBEG
  1126'                         OF_LP:
  1126'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1129'   CA 1134'              	JZ	OF_RET
  112C'   2B                    	DCX	H
  112D'   7E                    	MOV	A,M
  112E'   FE 0A                 	CPI	LF
  1130'   C2 1126'              	JNZ	OF_LP
  1133'   B7                    	ORA	A		; NZ
  1134'                         OF_RET:
  1134'   E1                    	POP	H
  1135'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1136'                         HFCNT:
  1136'   2A 2CE3'              	LHLD	CMDCNT
  1139'   7C                    	MOV	A,H
  113A'   B5                    	ORA	L
  113B'   CA 1152'              	JZ	HFC_AM
  113E'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  1141'   3A 0000*              	LDA	NEDIT
  1144'   5F                    	MOV	E,A
  1145'   16 00                 	MVI	D,0
  1147'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  114A'   D2 114E'              	JNC	HFC_ST
  114D'   EB                    	XCHG			; HL = NEDIT
  114E'                         HFC_ST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  114E'   7D                    	MOV	A,L
  114F'   32 2CEF'              	STA	HFAMT
  1152'                         HFC_AM:
  1152'   3A 2CEF'              	LDA	HFAMT
  1155'   B7                    	ORA	A
  1156'   C2 1163'              	JNZ	HFC_HL
  1159'   3A 0000*              	LDA	NEDIT
  115C'   B7                    	ORA	A
  115D'   1F                    	RAR
  115E'   B7                    	ORA	A
  115F'   C2 1163'              	JNZ	HFC_HL
  1162'   3C                    	INR	A		; at least one row
  1163'                         HFC_HL:
  1163'   32 2CF0'              	STA	HFN
  1166'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1167'                         VC_REDR:
  1167'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  116A'                         VC_G:
  116A'   CD 07A0'              	CALL	SETMOV
  116D'   CD 122C'              	CALL	GZONE		; the screen's top line, before the move
  1170'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1173'   2A 2CE3'              	LHLD	CMDCNT
  1176'   7C                    	MOV	A,H
  1177'   B5                    	ORA	L
  1178'   C2 118B'              	JNZ	VG_N
  117B'   AF                    	XRA	A		; forward
  117C'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  117F'   CD 0731'              	CALL	BRKOFF
  1182'   DA 0749'              	JC	BRKBAK
  1185'   CD 0A69'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1188'   C3 1244'              	JMP	GPLACE
  118B'                         VG_N:
  118B'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  118E'                         VG_LN:
  118E'   CD 119A'              	CALL	GOLN
  1191'   CD 0731'              	CALL	BRKOFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1194'   DA 0749'              	JC	BRKBAK
  1197'   C3 1244'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  119A'                         GOLN:
  119A'   E5                    	PUSH	H
  119B'   CD 0000*              	CALL	CNTLF
  119E'   23                    	INX	H		; HL = the cursor's line
  119F'   D1                    	POP	D		; DE = the line wanted
  11A0'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  11A3'   DA 11AE'              	JC	GLN_BK
  11A6'   EB                    	XCHG
  11A7'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  11AA'   AF                    	XRA	A
  11AB'   C3 11B3'              	JMP	GLN_MV
  11AE'                         GLN_BK:
  11AE'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  11B1'   3E FF                 	MVI	A,0FFH
  11B3'                         GLN_MV:
  11B3'   CD 0000*              	CALL	MVLIND
  11B6'   CD 0A63'              	CALL	ATEOF
  11B9'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  11BC'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  11BD'                         VC_LG:
  11BD'   CD 07A0'              	CALL	SETMOV
  11C0'   3A 2D16'              	LDA	GSAVE
  11C3'   B7                    	ORA	A
  11C4'   C2 11CD'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  11C7'   3E 01                 	MVI	A,PG
  11C9'   32 2D15'              	STA	GPEND
  11CC'   C9                    	RET
  11CD'                         VLG_GG:
  11CD'   CD 122C'              	CALL	GZONE
  11D0'   CD 06F4'              	CALL	BRKON
  11D3'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  11D6'   C3 118E'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  11D9'                         SUB24:
  11D9'   4F                    	MOV	C,A
  11DA'   7D                    	MOV	A,L
  11DB'   93                    	SUB	E
  11DC'   6F                    	MOV	L,A
  11DD'   7C                    	MOV	A,H
  11DE'   9A                    	SBB	D
  11DF'   67                    	MOV	H,A
  11E0'   79                    	MOV	A,C
  11E1'   98                    	SBB	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11E2'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  11E3'                         CURFP:
  11E3'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  11E6'                         FPOS:
  11E6'   C5                    	PUSH	B
  11E7'   D5                    	PUSH	D
  11E8'   EB                    	XCHG
  11E9'   2A 0000*              	LHLD	TXTBEG
  11EC'   EB                    	XCHG
  11ED'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  11F0'   EB                    	XCHG			; DE = that
  11F1'   2A 0000*              	LHLD	OUTPOS
  11F4'   7C                    	MOV	A,H
  11F5'   B7                    	ORA	A		; CY = 0
  11F6'   1F                    	RAR
  11F7'   47                    	MOV	B,A
  11F8'   7D                    	MOV	A,L
  11F9'   1F                    	RAR
  11FA'   67                    	MOV	H,A
  11FB'   3E 00                 	MVI	A,0
  11FD'   1F                    	RAR
  11FE'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  11FF'   19                    	DAD	D
  1200'   78                    	MOV	A,B
  1201'   CE 00                 	ACI	0		; A:HL = the position
  1203'   D1                    	POP	D
  1204'   C1                    	POP	B
  1205'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1206'                         ZSAVE:
  1206'   2A 2CE3'              	LHLD	CMDCNT
  1209'   22 2D54'              	SHLD	ZSVCNT
  120C'   2A 0000*              	LHLD	AUXCNT
  120F'   22 2D56'              	SHLD	ZSVAUX
  1212'   3A 0000*              	LDA	DIRFLG
  1215'   32 2D58'              	STA	ZSVDIR
  1218'   C9                    	RET
  1219'                         ZREST:
  1219'   2A 2D54'              	LHLD	ZSVCNT
  121C'   22 2CE3'              	SHLD	CMDCNT
  121F'   2A 2D56'              	LHLD	ZSVAUX
  1222'   22 0000*              	SHLD	AUXCNT
  1225'   3A 2D58'              	LDA	ZSVDIR
  1228'   32 0000*              	STA	DIRFLG
  122B'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  122C'                         GZONE:
  122C'   CD 1206'              	CALL	ZSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122F'   CD 0D47'              	CALL	CURRW
  1232'   6F                    	MOV	L,A
  1233'   26 00                 	MVI	H,0
  1235'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1238'   CD 11E6'              	CALL	FPOS
  123B'   22 0000*              	SHLD	ZTOP
  123E'   32 0002*              	STA	ZTOP+2
  1241'   C3 1219'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1244'                         GPLACE:
  1244'   CD 1206'              	CALL	ZSAVE
  1247'   CD 11E3'              	CALL	CURFP
  124A'   EB                    	XCHG
  124B'   2A 0000*              	LHLD	ZTOP
  124E'   EB                    	XCHG
  124F'   4F                    	MOV	C,A		; C:HL = the target's position
  1250'   3A 0002*              	LDA	ZTOP+2
  1253'   47                    	MOV	B,A		; B:DE = the top's
  1254'   79                    	MOV	A,C
  1255'   CD 11D9'              	CALL	SUB24
  1258'   22 2D51'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  125B'   DA 1295'              	JC	GP_UP
  125E'   B7                    	ORA	A
  125F'   C2 12D6'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1262'   3A 0000*              	LDA	NEDIT
  1265'   87                    	ADD	A
  1266'   3C                    	INR	A
  1267'   6F                    	MOV	L,A
  1268'   26 00                 	MVI	H,0
  126A'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  126D'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  1270'   EB                    	XCHG
  1271'   2A 2D51'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1274'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1277'   DA 12D6'              	JC	GP_MID
  127A'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  127D'   01 0000               	LXI	B,0		; BC = lines from the top
  1280'                         GP_CNT:
  1280'   7A                    	MOV	A,D
  1281'   B3                    	ORA	E
  1282'   CA 1291'              	JZ	GP_DN
  1285'   7E                    	MOV	A,M
  1286'   23                    	INX	H
  1287'   1B                    	DCX	D
  1288'   FE 0A                 	CPI	LF
  128A'   C2 1280'              	JNZ	GP_CNT
  128D'   03                    	INX	B
  128E'   C3 1280'              	JMP	GP_CNT
  1291'                         GP_DN:
  1291'   79                    	MOV	A,C		; the lines from the top one to it
  1292'   C3 1300'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1295'                         GP_UP:
  1295'   3C                    	INR	A
  1296'   C2 12D6'              	JNZ	GP_MID		; 64K bytes or more above
  1299'   2A 2D51'              	LHLD	ZDIF
  129C'   EB                    	XCHG
  129D'   21 0000               	LXI	H,0
  12A0'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  12A3'   7C                    	MOV	A,H
  12A4'   B5                    	ORA	L
  12A5'   CA 12D6'              	JZ	GP_MID		; exactly 64K
  12A8'   EB                    	XCHG			; DE = bytes to read
  12A9'   AF                    	XRA	A
  12AA'   32 2D53'              	STA	ZLF
  12AD'   CD 0000*              	CALL	RGET0
  12B0'                         GP_RD:
  12B0'   CD 0000*              	CALL	RDGET		; (keeps DE)
  12B3'   DA 12D6'              	JC	GP_MID
  12B6'   FE 0A                 	CPI	LF
  12B8'   C2 12CC'              	JNZ	GP_RN
  12BB'   3A 0000*              	LDA	NEDIT
  12BE'   B7                    	ORA	A
  12BF'   1F                    	RAR
  12C0'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  12C2'   E5                    	PUSH	H
  12C3'   21 2D53'              	LXI	H,ZLF
  12C6'   34                    	INR	M
  12C7'   BE                    	CMP	M		; CY iff more lines than that
  12C8'   E1                    	POP	H
  12C9'   DA 12D6'              	JC	GP_MID
  12CC'                         GP_RN:
  12CC'   1B                    	DCX	D
  12CD'   7A                    	MOV	A,D
  12CE'   B3                    	ORA	E
  12CF'   C2 12B0'              	JNZ	GP_RD
  12D2'   AF                    	XRA	A		; the top row
  12D3'   C3 12E0'              	JMP	GP_SET
  12D6'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  12D6'   3E 02                 	MVI	A,2
  12D8'   32 0000*              	STA	WFILL		; SCRN.MAC WF_MID: mid-screen, as the rows fall
  12DB'   3A 0000*              	LDA	NEDIT
  12DE'   B7                    	ORA	A
  12DF'   1F                    	RAR			; (no more lines above it than this)
  12E0'                         GP_SET:
  12E0'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  12E1'   26 00                 	MVI	H,0
  12E3'   22 0000*              	SHLD	WINROW
  12E6'   21 0000               	LXI	H,0
  12E9'   22 0000*              	SHLD	LNDLT
  12EC'   CD 07C1'              	CALL	SETFUL		; the window may have paged: full repaint
  12EF'                         GP_FIN:
  12EF'   CD 1219'              	CALL	ZREST
  12F2'   3A 2D7C'              	LDA	GPKEEP
  12F5'   B7                    	ORA	A
  12F6'   CA 087A'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  12F9'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12FA'   32 2D7C'              	STA	GPKEEP
  12FD'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  1300'                         GP_ONS:
  1300'   6F                    	MOV	L,A
  1301'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  1303'   EB                    	XCHG
  1304'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1307'   EB                    	XCHG
  1308'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  130B'   22 0000*              	SHLD	LNDLT
  130E'   3E 01                 	MVI	A,R_MOVE
  1310'   32 2CE7'              	STA	RINTENT
  1313'   C3 12EF'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1316'                         OPPEND:
  1316'   AF                    	XRA	A
  1317'   32 2D1B'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  131A'   3A 2D18'              	LDA	PSAVE
  131D'   FE 63                 	CPI	'c'
  131F'   C2 133C'              	JNZ	OPP_ND
  1322'   79                    	MOV	A,C
  1323'   FE 77                 	CPI	'w'
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1325'   CA 132D'              	JZ	OPP_W
  1328'   FE 57                 	CPI	'W'
  132A'   C2 133C'              	JNZ	OPP_ND
  132D'                         OPP_W:
  132D'   CD 150F'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1330'   DA 133C'              	JC	OPP_ND
  1333'   79                    	MOV	A,C
  1334'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1336'   4F                    	MOV	C,A
  1337'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1339'   32 2D1B'              	STA	CWEOL		;   char for the next word's: see ESTEP
  133C'                         OPP_ND:
  133C'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  133D'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  133F'   C2 1353'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1342'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1345'   DA 13E3'              	JC	OPABRT
  1348'   79                    	MOV	A,C
  1349'   FE 67                 	CPI	'g'
  134B'   C2 13E3'              	JNZ	OPABRT
  134E'   3E 01                 	MVI	A,PG
  1350'   32 2D16'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1353'                         OPP_NG:
  1353'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1354'   21 2D18'              	LXI	H,PSAVE
  1357'   BE                    	CMP	M
  1358'   CA 1530'              	JZ	OPLINE
  135B'   79                    	MOV	A,C		; (OPCLS classifies the key)
  135C'   CD 1546'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  135F'   DA 13E3'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1362'   32 2D1A'              	STA	OPCLSV
  1365'   47                    	MOV	B,A		; B = the class
  1366'   3A 2D18'              	LDA	PSAVE
  1369'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  136B'   C2 1377'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  136E'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  136F'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1371'   C2 1399'              	JNZ	OPP_GO
  1374'   C3 1382'              	JMP	OPP_NO
  1377'                         OPP_NC:
  1377'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1379'   C2 1399'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  137C'   78                    	MOV	A,B		;   a charwise register would need a type flag
  137D'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  137F'   CA 1399'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1382'                         OPP_NO:
  1382'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1383'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1385'   CA 1393'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1388'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  138A'   CA 1393'              	JZ	OPP_SW		;   so swallow it before dropping the command
  138D'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1390'   C2 13E3'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1393'                         OPP_SW:
  1393'   CD 01F9'              	CALL	MKGETK
  1396'   C3 13E3'              	JMP	OPABRT
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1399'                         OPP_GO:
  1399'   AF                    	XRA	A
  139A'   32 2CEE'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  139D'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  13A0'   22 2D1C'              	SHLD	OPSTA
  13A3'   C5                    	PUSH	B
  13A4'   21 2D20'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  13A7'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  13AA'   3A 2D1A'              	LDA	OPCLSV
  13AD'   FE 02                 	CPI	2
  13AF'   CC 13E6'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  13B2'   C1                    	POP	B
  13B3'   21 2C2A'              	LXI	H,CMDTAB
  13B6'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  13B9'   3A 2D18'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  13BC'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  13BD'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  13C0'   CD 1412'              	CALL	OPSFIX		; where the start is in the window NOW
  13C3'   D2 142E'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  13C6'   22 2D1C'              	SHLD	OPSTA
  13C9'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  13CC'   22 2D1E'              	SHLD	OPEND2
  13CF'   3A 2D18'              	LDA	PSAVE
  13D2'   FE 79                 	CPI	'y'
  13D4'   CA 1A9C'              	JZ	OPYANK		; a yank takes the span without losing it
  13D7'   CD 1581'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  13DA'   3A 2D18'              	LDA	PSAVE
  13DD'   FE 63                 	CPI	'c'
  13DF'   C0                    	RNZ
  13E0'   C3 1855'              	JMP	SETINS
  13E3'                         OPABRT:				; not a motion -> the operator is dropped and
  13E3'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  13E6'                         OPENDS:
  13E6'   2A 2D1C'              	LHLD	OPSTA
  13E9'   CD 0624'              	CALL	BOL
  13EC'   11 2D23'              	LXI	D,OPSLO
  13EF'   CD 1404'              	CALL	OPE_ST
  13F2'   2A 2D1C'              	LHLD	OPSTA
  13F5'   CD 0654'              	CALL	NLSTART
  13F8'   11 2D26'              	LXI	D,OPSHI
  13FB'   CD 1404'              	CALL	OPE_ST
  13FE'   2A 2D1C'              	LHLD	OPSTA
  1401'   C3 0000*              	JMP	GOTO
  1404'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1404'   D5                    	PUSH	D
  1405'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1408'   E1                    	POP	H
  1409'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  140C'                         CURBD:
  140C'   CD 11E3'              	CALL	CURFP
  140F'   EB                    	XCHG
  1410'   47                    	MOV	B,A
  1411'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1412'                         OPSFIX:
  1412'   21 2D20'              	LXI	H,OPSFP
  1415'   CD 03DC'              	CALL	MKLOAD
  1418'   CD 140C'              	CALL	CURBD
  141B'   2A 2D86'              	LHLD	MKPOS
  141E'   3A 2D88'              	LDA	MKPOS+2
  1421'   CD 11D9'              	CALL	SUB24
  1424'   B4                    	ORA	H
  1425'   B5                    	ORA	L
  1426'   C2 03E9'              	JNZ	MKWIN
  1429'   CD 0000*              	CALL	CUROFF
  142C'   37                    	STC
  142D'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  142E'                         OPPGD:
  142E'   47                    	MOV	B,A
  142F'   3A 2D1A'              	LDA	OPCLSV
  1432'   FE 02                 	CPI	2
  1434'   C2 14F0'              	JNZ	OPG_NO
  1437'   3A 2D18'              	LDA	PSAVE
  143A'   FE 64                 	CPI	'd'
  143C'   C2 14F0'              	JNZ	OPG_NO
  143F'   04                    	INR	B
  1440'   CA 144F'              	JZ	OPG_FW
  1443'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1446'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1449'   CD 0000*              	CALL	GOTO
  144C'   C3 1467'              	JMP	OPG_GO
  144F'                         OPG_FW:
  144F'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1452'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1455'   11 2D26'              	LXI	D,OPSHI		;   start line began
  1458'   CD 1404'              	CALL	OPE_ST
  145B'   21 2D23'              	LXI	H,OPSLO
  145E'   CD 03DC'              	CALL	MKLOAD
  1461'   CD 03A9'              	CALL	MKPAGE
  1464'   CD 0000*              	CALL	GOTO
  1467'                         OPG_GO:
  1467'   CD 140C'              	CALL	CURBD
  146A'   2A 2D26'              	LHLD	OPSHI
  146D'   3A 2D28'              	LDA	OPSHI+2
  1470'   CD 11D9'              	CALL	SUB24		; A:HL = the bytes to take
  1473'                         OPG_SV:
  1473'   22 2D29'              	SHLD	OPTOGO
  1476'   32 2D2B'              	STA	OPTOGO+2
  1479'                         OPG_NX:
  1479'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  147C'   CD 0000*              	CALL	SUBHD
  147F'   EB                    	XCHG			; DE = what the window holds past the cursor
  1480'   2A 2D29'              	LHLD	OPTOGO
  1483'   3A 2D2B'              	LDA	OPTOGO+2
  1486'   B7                    	ORA	A
  1487'   C2 14BA'              	JNZ	OPG_PG		; 64K or more to go
  148A'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  148D'   DA 14BA'              	JC	OPG_PG
  1490'   CA 14BA'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1493'                         OPG_FN:				; the rest of it is here
  1493'   E5                    	PUSH	H
  1494'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1497'   CD 0000*              	CALL	CUROFF
  149A'   22 2D2C'              	SHLD	OPLO
  149D'   D1                    	POP	D
  149E'   19                    	DAD	D
  149F'   22 2D2E'              	SHLD	OPHI
  14A2'   CD 16B4'              	CALL	OPDSPN
  14A5'   CD 0A63'              	CALL	ATEOF
  14A8'   D2 1509'              	JNC	OPMID
  14AB'   CD 1116'              	CALL	ONFST		; deleted to the end of the file: onto the new
  14AE'   CA 1509'              	JZ	OPMID		;   last line, if there is one -- and the pager
  14B1'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  14B4'   CD 0000*              	CALL	SETBWD
  14B7'   C3 1509'              	JMP	OPMID
  14BA'                         OPG_PG:
  14BA'   7A                    	MOV	A,D
  14BB'   B3                    	ORA	E
  14BC'   C2 14D5'              	JNZ	OPG_DL
  14BF'   CD 0A63'              	CALL	ATEOF		; nothing held past the cursor
  14C2'   21 0000               	LXI	H,0
  14C5'   DA 1493'              	JC	OPG_FN		; ... and no more to come: the file ran out
  14C8'   2B                    	DCX	H
  14C9'   CD 0000*              	CALL	SETC0
  14CC'   CD 0000*              	CALL	GOLINE
  14CF'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  14D2'   C3 1479'              	JMP	OPG_NX
  14D5'                         OPG_DL:
  14D5'   D5                    	PUSH	D
  14D6'   21 FFFF               	LXI	H,0FFFFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  14D9'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  14DC'   E1                    	POP	H
  14DD'   E5                    	PUSH	H
  14DE'   CD 0000*              	CALL	DELFWD
  14E1'   D1                    	POP	D
  14E2'   06 00                 	MVI	B,0
  14E4'   2A 2D29'              	LHLD	OPTOGO
  14E7'   3A 2D2B'              	LDA	OPTOGO+2
  14EA'   CD 11D9'              	CALL	SUB24
  14ED'   C3 1473'              	JMP	OPG_SV
  14F0'                         OPG_NO:
  14F0'   0E 07                 	MVI	C,BEL
  14F2'   CD 0000*              	CALL	BCONOU
  14F5'                         OPG_HM:				; the cursor back where the command found it
  14F5'   21 2D20'              	LXI	H,OPSFP
  14F8'   CD 03DC'              	CALL	MKLOAD
  14FB'   CD 03A9'              	CALL	MKPAGE
  14FE'   CD 0000*              	CALL	GOTO
  1501'   AF                    	XRA	A
  1502'   32 2D18'              	STA	PSAVE
  1505'   3C                    	INR	A
  1506'   32 2D7C'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1509'                         OPMID:
  1509'   CD 1206'              	CALL	ZSAVE
  150C'   C3 12D6'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  150F'                         ONWHIT:
  150F'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1512'   CA 152E'              	JZ	OW_YES
  1515'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1518'   FE 20                 	CPI	' '
  151A'   CA 152E'              	JZ	OW_YES
  151D'   FE 09                 	CPI	TAB
  151F'   CA 152E'              	JZ	OW_YES
  1522'   FE 0D                 	CPI	CR
  1524'   CA 152E'              	JZ	OW_YES
  1527'   FE 0A                 	CPI	LF
  1529'   CA 152E'              	JZ	OW_YES
  152C'   B7                    	ORA	A		; a char to change: CY clear
  152D'   C9                    	RET
  152E'                         OW_YES:
  152E'   37                    	STC
  152F'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1530'                         OPLINE:
  1530'   3A 2D18'              	LDA	PSAVE
  1533'   FE 63                 	CPI	'c'
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1535'   CA 07A0'              	JZ	SETMOV
  1538'   FE 79                 	CPI	'y'
  153A'   CA 1A7B'              	JZ	VY_YY
  153D'   21 2D20'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1540'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1543'   C3 19F1'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1546'                         OPCLS:
  1546'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1548'   CA 1555'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  154B'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  154D'   C2 1569'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1550'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1552'   C3 1557'              	JMP	OPC_FK
  1555'                         OPC_SEM:
  1555'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1557'                         OPC_FK:
  1557'   3A 2D72'              	LDA	FNDKND
  155A'   B7                    	ORA	A
  155B'   37                    	STC
  155C'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  155D'   A8                    	XRA	B		; ... and now the direction ',' asked for
  155E'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1560'   CA 1567'              	JZ	OPC_EXC
  1563'   3E 01                 	MVI	A,1
  1565'   B7                    	ORA	A		; CY clear: a motion, class 1
  1566'   C9                    	RET
  1567'                         OPC_EXC:
  1567'   AF                    	XRA	A		; class 0, CY clear
  1568'   C9                    	RET
  1569'                         OPC_TB:
  1569'   47                    	MOV	B,A
  156A'   21 1749'              	LXI	H,OPCTAB
  156D'                         OPC_LP:
  156D'   7E                    	MOV	A,M
  156E'   B7                    	ORA	A
  156F'   CA 157F'              	JZ	OPC_MS		; end of table -> not a motion
  1572'   B8                    	CMP	B
  1573'   CA 157B'              	JZ	OPC_HT
  1576'   23                    	INX	H
  1577'   23                    	INX	H
  1578'   C3 156D'              	JMP	OPC_LP
  157B'                         OPC_HT:
  157B'   23                    	INX	H
  157C'   7E                    	MOV	A,M		; class byte
  157D'   B7                    	ORA	A		; clear CY
  157E'   C9                    	RET
  157F'                         OPC_MS:
  157F'   37                    	STC
  1580'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1581'                         OPAPPL:
  1581'   3A 2D1A'              	LDA	OPCLSV
  1584'   FE 02                 	CPI	2
  1586'   CA 171D'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1589'   2A 2D1C'              	LHLD	OPSTA
  158C'   EB                    	XCHG			; DE = start
  158D'   2A 2D1E'              	LHLD	OPEND2		; HL = end
  1590'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1593'   DA 15A6'              	JC	OPA_F
  1596'   CA 15A6'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1599'   22 2D2C'              	SHLD	OPLO
  159C'   EB                    	XCHG
  159D'   22 2D2E'              	SHLD	OPHI
  15A0'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  15A3'   C3 165D'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  15A6'                         OPA_F:
  15A6'   EB                    	XCHG			; HL = start, DE = end
  15A7'   22 2D2C'              	SHLD	OPLO
  15AA'   EB                    	XCHG			; HL = end
  15AB'   3A 2D1A'              	LDA	OPCLSV
  15AE'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  15B0'   CA 165A'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  15B3'   FE 01                 	CPI	1
  15B5'   C2 15D7'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  15B8'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  15B9'   22 2D2E'              	SHLD	OPHI		; park it: CEND clobbers DE
  15BC'   2B                    	DCX	H		; the line it landed on
  15BD'   CD 17D3'              	CALL	CEND		; HL = that line's content end
  15C0'   EB                    	XCHG			; DE = it
  15C1'   2A 2D2E'              	LHLD	OPHI		; HL = hi
  15C4'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  15C7'   D2 15E2'              	JNC	OPA_HI		; hi is inside the line: keep it
  15CA'   2A 2D2C'              	LHLD	OPLO
  15CD'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  15D0'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  15D3'   EB                    	XCHG			; HL = the content end: the span stops there
  15D4'   C3 15E2'              	JMP	OPA_HI
  15D7'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  15D7'   22 2D2E'              	SHLD	OPHI
  15DA'   3A 2CEE'              	LDA	WPULL
  15DD'   B7                    	ORA	A
  15DE'   CA 165D'              	JZ	OPA_C1
  15E1'   23                    	INX	H
  15E2'                         OPA_HI:
  15E2'   22 2D2E'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  15E5'                         OPA_DO:
  15E5'   CD 16A9'              	CALL	OPSPNL
  15E8'   7C                    	MOV	A,H
  15E9'   B5                    	ORA	L
  15EA'   C2 15F3'              	JNZ	OPA_D1
  15ED'   2A 2D2C'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  15F0'   C3 0000*              	JMP	GOTO		;   to where the span starts
  15F3'                         OPA_D1:
  15F3'   3A 2D18'              	LDA	PSAVE
  15F6'   FE 63                 	CPI	'c'
  15F8'   CA 16B4'              	JZ	OPDSPN
  15FB'   CD 169C'              	CALL	SPNBRK
  15FE'   D2 161F'              	JNC	OPA_D2
  1601'   2A 2D2E'              	LHLD	OPHI
  1604'   CD 17D3'              	CALL	CEND
  1607'   EB                    	XCHG			; DE = the content end of the line it ends in
  1608'   2A 2D2E'              	LHLD	OPHI
  160B'                         OPA_BL:
  160B'   CD 0000*              	CALL	CMP16
  160E'   CA 1625'              	JZ	OPA_BI		; only blanks after it
  1611'   D5                    	PUSH	D
  1612'   E5                    	PUSH	H
  1613'   CD 0000*              	CALL	CHARAT
  1616'   E1                    	POP	H
  1617'   D1                    	POP	D
  1618'   23                    	INX	H
  1619'   CD 1654'              	CALL	BLANKQ
  161C'   CA 160B'              	JZ	OPA_BL
  161F'                         OPA_D2:
  161F'   CD 16B4'              	CALL	OPDSPN
  1622'   C3 17E4'              	JMP	CLAMPE
  1625'                         OPA_BI:
  1625'   CD 1637'              	CALL	LOIND
  1628'   C2 161F'              	JNZ	OPA_D2
  162B'   2A 2D2E'              	LHLD	OPHI
  162E'   CD 0654'              	CALL	NLSTART
  1631'   22 2D2E'              	SHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1634'   C3 1688'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1637'                         LOIND:
  1637'   2A 2D2C'              	LHLD	OPLO
  163A'   CD 0624'              	CALL	BOL
  163D'                         LI_LP:
  163D'   E5                    	PUSH	H
  163E'   EB                    	XCHG
  163F'   2A 2D2C'              	LHLD	OPLO
  1642'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1645'   E1                    	POP	H
  1646'   C8                    	RZ
  1647'   E5                    	PUSH	H
  1648'   CD 0000*              	CALL	CHARAT
  164B'   E1                    	POP	H
  164C'   23                    	INX	H
  164D'   CD 1654'              	CALL	BLANKQ
  1650'   CA 163D'              	JZ	LI_LP
  1653'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1654'                         BLANKQ:
  1654'   FE 20                 	CPI	' '
  1656'   C8                    	RZ
  1657'   FE 09                 	CPI	TAB
  1659'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  165A'                         OPA_JP:
  165A'   22 2D2E'              	SHLD	OPHI
  165D'                         OPA_C1:
  165D'   CD 16A9'              	CALL	OPSPNL
  1660'   7C                    	MOV	A,H
  1661'   B5                    	ORA	L
  1662'   CA 15E5'              	JZ	OPA_DO		; nothing spanned
  1665'   2A 2D2E'              	LHLD	OPHI
  1668'   CD 0624'              	CALL	BOL
  166B'   EB                    	XCHG
  166C'   2A 2D2E'              	LHLD	OPHI
  166F'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1672'   C2 15E5'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1675'   CD 1637'              	CALL	LOIND
  1678'   CA 1688'              	JZ	C1_LW		; only blanks before lo: whole lines
  167B'                         C1_CH:
  167B'   2A 2D2E'              	LHLD	OPHI		; back over the line break to the content end
  167E'   2B                    	DCX	H		;   of the line before
  167F'   CD 17D3'              	CALL	CEND
  1682'   22 2D2E'              	SHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1685'   C3 15E5'              	JMP	OPA_DO
  1688'                         C1_LW:
  1688'   2A 2D2C'              	LHLD	OPLO
  168B'   CD 0624'              	CALL	BOL
  168E'   22 2D2C'              	SHLD	OPLO
  1691'   3A 2D18'              	LDA	PSAVE
  1694'   FE 63                 	CPI	'c'
  1696'   CA 167B'              	JZ	C1_CH
  1699'   C3 1730'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  169C'                         SPNBRK:
  169C'   2A 2D2C'              	LHLD	OPLO
  169F'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  16A2'   EB                    	XCHG			; DE = it
  16A3'   2A 2D2E'              	LHLD	OPHI
  16A6'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  16A9'                         OPSPNL:
  16A9'   2A 2D2E'              	LHLD	OPHI
  16AC'   EB                    	XCHG
  16AD'   2A 2D2C'              	LHLD	OPLO
  16B0'   EB                    	XCHG			; HL = hi, DE = lo
  16B1'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  16B4'                         OPDSPN:
  16B4'   CD 169C'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  16B7'   F5                    	PUSH	PSW
  16B8'   2A 2D2C'              	LHLD	OPLO
  16BB'   CD 0000*              	CALL	GOTO
  16BE'   CD 16A9'              	CALL	OPSPNL		; HL = hi - lo
  16C1'   CD 0000*              	CALL	DELFWD
  16C4'   CD 0174'              	CALL	MARKMOD
  16C7'   F1                    	POP	PSW
  16C8'   DA 07C1'              	JC	SETFUL		; a break went: every row below it moved up
  16CB'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  16CE'                         UNDFNB:
  16CE'   CD 0000*              	CALL	CUROFF
  16D1'   E5                    	PUSH	H
  16D2'   CD 087A'              	CALL	FNBLNK
  16D5'   CD 0000*              	CALL	CUROFF
  16D8'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  16D9'   CD 0000*              	CALL	CMP16
  16DC'   D2 0000*              	JNC	UNDHER
  16DF'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16E0'   CD 0000*              	CALL	GOTO
  16E3'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  16E6'                         OPALSP:
  16E6'   2A 2D1C'              	LHLD	OPSTA
  16E9'   EB                    	XCHG
  16EA'   2A 2D1E'              	LHLD	OPEND2
  16ED'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  16F0'   DA 1700'              	JC	OPAL_F
  16F3'   22 2D2C'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  16F6'   EB                    	XCHG
  16F7'   22 2D2E'              	SHLD	OPHI		; hi-src = start
  16FA'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  16FD'   C3 170A'              	JMP	OPAL_R
  1700'                         OPAL_F:
  1700'   EB                    	XCHG			; HL = start
  1701'   22 2D2C'              	SHLD	OPLO		; lo-src = start
  1704'   2A 2D1E'              	LHLD	OPEND2
  1707'   22 2D2E'              	SHLD	OPHI		; hi-src = end
  170A'                         OPAL_R:
  170A'   2A 2D2C'              	LHLD	OPLO
  170D'   CD 0624'              	CALL	BOL
  1710'   22 2D2C'              	SHLD	OPLO		; lo = BOL(low line)
  1713'   2A 2D2E'              	LHLD	OPHI
  1716'   CD 0654'              	CALL	NLSTART
  1719'   22 2D2E'              	SHLD	OPHI		; hi = start of line past the high line
  171C'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  171D'                         OPALIN:
  171D'   CD 16E6'              	CALL	OPALSP
  1720'   2A 2D2C'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1723'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1726'   EB                    	XCHG			;   the column)
  1727'   2A 2D2E'              	LHLD	OPHI
  172A'   CD 0000*              	CALL	CMP16
  172D'   CC 16CE'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1730'                         OPDLIN:
  1730'   CD 16B4'              	CALL	OPDSPN
  1733'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1736'   DA 1746'              	JC	OPDL_NB
  1739'   CD 0000*              	CALL	LOGLEN
  173C'   7C                    	MOV	A,H
  173D'   B5                    	ORA	L
  173E'   C8                    	RZ			; empty buffer
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  173F'   2B                    	DCX	H
  1740'   CD 0624'              	CALL	BOL
  1743'   CD 0000*              	CALL	GOTO
  1746'                         OPDL_NB:
  1746'   C3 087A'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1749'                         OPCTAB:
  1749'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  174D'   62 00 42 00           
  1751'   68 00 6C 00           
  1755'   30 00 5E 00           
  1759'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  175B'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  175F'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1763'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1767'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  176B'   24 01                 
  176D'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1771'   47 02 48 02           
  1775'   4D 02 4C 02           
  1779'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  177B'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  177D'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  177E'                         VCB_C:
  177E'   CD 178A'              	CALL	VCB_CD
  1781'   C3 1855'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1784'                         VCB_D:
  1784'   CD 178A'              	CALL	VCB_CD
  1787'   C3 17E4'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  178A'                         VCB_CD:
  178A'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  178D'   22 2D2C'              	SHLD	OPLO
  1790'   CD 0000*              	CALL	CUROFF
  1793'   CD 17D3'              	CALL	CEND		; to the line's content end, the CR,LF left
  1796'   22 2D2E'              	SHLD	OPHI
  1799'   C3 16B4'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  179C'                         VC_X:
  179C'   CD 092C'              	CALL	GLSTAL
  179F'   CD 07A6'              	CALL	SETLIN
  17A2'   CD 06CB'              	CALL	GETCNT
  17A5'   22 2D30'              	SHLD	CNTV
  17A8'   CD 0000*              	CALL	CUROFF
  17AB'   22 2D34'              	SHLD	WKI		; cur
  17AE'   CD 17D3'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  17B1'   EB                    	XCHG			; DE = contentend
  17B2'   2A 2D34'              	LHLD	WKI		; HL = cur
  17B5'   EB                    	XCHG			; HL = contentend, DE = cur
  17B6'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  17B9'   7C                    	MOV	A,H
  17BA'   B5                    	ORA	L
  17BB'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  17BC'   EB                    	XCHG			; DE = available
  17BD'   2A 2D30'              	LHLD	CNTV		; HL = count
  17C0'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  17C3'   DA 17C9'              	JC	VX_USEA
  17C6'   C3 17CA'              	JMP	VX_DEL		; count <= available -> HL = count = del
  17C9'                         VX_USEA:
  17C9'   EB                    	XCHG			; HL = available
  17CA'                         VX_DEL:
  17CA'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  17CD'   CD 0174'              	CALL	MARKMOD
  17D0'   C3 17E4'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  17D3'                         CEND:
  17D3'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  17D6'   7C                    	MOV	A,H
  17D7'   B5                    	ORA	L
  17D8'   C8                    	RZ			; the start of the text: nothing before it
  17D9'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17DA'   E5                    	PUSH	H
  17DB'   CD 0000*              	CALL	CHARAT
  17DE'   E1                    	POP	H		; HL = term-1
  17DF'   FE 0D                 	CPI	CR
  17E1'   C8                    	RZ			; a CR before the LF -> the content ends there
  17E2'   23                    	INX	H
  17E3'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  17E4'                         CLAMPE:
  17E4'   CD 0000*              	CALL	CUROFF
  17E7'   E5                    	PUSH	H
  17E8'   CD 0663'              	CALL	EOLC
  17EB'   D1                    	POP	D		; DE = cur
  17EC'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  17EF'   D8                    	RC
  17F0'   C8                    	RZ
  17F1'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  17F4'                         VC_I:
  17F4'   CD 06CB'              	CALL	GETCNT
  17F7'   C3 1852'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  17FA'                         VC_A:
  17FA'   CD 06CB'              	CALL	GETCNT
  17FD'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1800'   CA 1817'              	JZ	VA_INS
  1803'   EB                    	XCHG			; HL = cur
  1804'   E5                    	PUSH	H
  1805'   CD 0000*              	CALL	CHARAT
  1808'   E1                    	POP	H
  1809'   FE 0A                 	CPI	LF
  180B'   CA 1817'              	JZ	VA_INS		; on the line terminator -> append in place
  180E'   FE 0D                 	CPI	CR
  1810'   CA 1817'              	JZ	VA_INS
  1813'   23                    	INX	H
  1814'   CD 0000*              	CALL	GOTO
  1817'                         VA_INS:
  1817'   C3 1852'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  181A'                         VCB_A:
  181A'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  181D'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  1820'   E5                    	PUSH	H
  1821'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1824'   E1                    	POP	H
  1825'   FE 0D                 	CPI	CR
  1827'   CA 1830'              	JZ	VBA_IN		; an empty line: insert at its start
  182A'   FE 0A                 	CPI	LF
  182C'   CA 1830'              	JZ	VBA_IN
  182F'   23                    	INX	H		; past the last content char
  1830'                         VBA_IN:
  1830'   CD 0000*              	CALL	GOTO
  1833'   C3 1852'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1836'                         VCB_I:
  1836'   CD 06CB'              	CALL	GETCNT
  1839'   CD 087A'              	CALL	FNBLNK
  183C'   CD 0000*              	CALL	CUROFF
  183F'   E5                    	PUSH	H
  1840'   CD 0000*              	CALL	CHARAT
  1843'   E1                    	POP	H
  1844'   FE 20                 	CPI	' '
  1846'   CA 184E'              	JZ	VBI_SK
  1849'   FE 09                 	CPI	TAB
  184B'   C2 1852'              	JNZ	SETINM
  184E'                         VBI_SK:
  184E'   23                    	INX	H		; blanks only: past the last of them
  184F'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1852'                         SETINM:
  1852'   CD 07A0'              	CALL	SETMOV
  1855'                         SETINS:
  1855'   3E 01                 	MVI	A,EM_INS
  1857'   32 2CE2'              	STA	EDMODE
  185A'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  185B'                         ATCEND:
  185B'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  185E'   C8                    	RZ
  185F'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1862'   FE 0D                 	CPI	CR
  1864'   C8                    	RZ
  1865'   FE 0A                 	CPI	LF
  1867'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1868'                         OPNBRK:
  1868'   CD 215F'              	CALL	PUTBRK
  186B'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  186E'   23                    	INX	H
  186F'   22 0000*              	SHLD	LNDLT
  1872'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1875'                         ENDBRK:
  1875'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1878'   C0                    	RNZ
  1879'   CD 1868'              	CALL	OPNBRK
  187C'   CD 0000*              	CALL	CUROFF
  187F'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1880'   2B                    	DCX	H		;   line, with its own terminator after it
  1881'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1884'                         VC_O:
  1884'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1887'   CD 17D3'              	CALL	CEND
  188A'   CD 0000*              	CALL	GOTO
  188D'   CD 1868'              	CALL	OPNBRK
  1890'   CD 1875'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1893'   CD 07AC'              	CALL	SETILN		;   needs a terminator of its own to exist
  1896'   C3 1855'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1899'                         VCB_O:
  1899'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  189C'   CD 0624'              	CALL	BOL
  189F'   CD 0000*              	CALL	GOTO
  18A2'   CD 1868'              	CALL	OPNBRK
  18A5'   CD 0000*              	CALL	CUROFF
  18A8'   2B                    	DCX	H
  18A9'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18AA'   CD 0000*              	CALL	GOTO
  18AD'   CD 07AC'              	CALL	SETILN
  18B0'   C3 1855'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  18B3'                         VCB_J:
  18B3'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18B6'   CD 17D3'              	CALL	CEND		; the join point: this line's content end
  18B9'   22 2D2C'              	SHLD	OPLO
  18BC'   CD 0000*              	CALL	CUROFF
  18BF'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  18C2'   E5                    	PUSH	H
  18C3'   CD 0000*              	CALL	LOGLEN
  18C6'   D1                    	POP	D		; DE = that start
  18C7'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  18CA'   CA 07A0'              	JZ	SETMOV
  18CD'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  18CE'                         VJ_WS:
  18CE'   E5                    	PUSH	H
  18CF'   CD 0000*              	CALL	LOGLEN
  18D2'   D1                    	POP	D		; DE = the scan
  18D3'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  18D6'   CA 18ED'              	JZ	VJ_DEL
  18D9'   EB                    	XCHG			; HL = the scan
  18DA'   E5                    	PUSH	H
  18DB'   CD 0000*              	CALL	CHARAT
  18DE'   E1                    	POP	H
  18DF'   FE 20                 	CPI	' '
  18E1'   CA 18E9'              	JZ	VJ_SKIP
  18E4'   FE 09                 	CPI	TAB
  18E6'   C2 18ED'              	JNZ	VJ_DEL
  18E9'                         VJ_SKIP:
  18E9'   23                    	INX	H
  18EA'   C3 18CE'              	JMP	VJ_WS
  18ED'                         VJ_DEL:
  18ED'   22 2D2E'              	SHLD	OPHI
  18F0'   CD 16B4'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  18F3'   CD 07BB'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  18F6'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  18F9'   CA 17E4'              	JZ	CLAMPE
  18FC'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  18FF'   FE 0D                 	CPI	CR
  1901'   CA 17E4'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1904'   FE 0A                 	CPI	LF
  1906'   CA 17E4'              	JZ	CLAMPE
  1909'   FE 29                 	CPI	')'
  190B'   CA 17E4'              	JZ	CLAMPE		; vim puts no space before a ')'
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  190E'   CD 0000*              	CALL	CUROFF
  1911'   7C                    	MOV	A,H
  1912'   B5                    	ORA	L
  1913'   CA 1929'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1916'   2B                    	DCX	H
  1917'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  191A'   FE 20                 	CPI	' '
  191C'   CA 17E4'              	JZ	CLAMPE
  191F'   FE 09                 	CPI	TAB
  1921'   CA 17E4'              	JZ	CLAMPE
  1924'   FE 0A                 	CPI	LF
  1926'   CA 17E4'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1929'                         VJ_SP:
  1929'   3E 20                 	MVI	A,' '
  192B'   CD 0000*              	CALL	PUTGAP
  192E'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1931'   2B                    	DCX	H
  1932'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1935'                         VC_TILD:
  1935'   CD 06CB'              	CALL	GETCNT
  1938'   CD 07A6'              	CALL	SETLIN		; only this row changes
  193B'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  193E'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1941'   CA 07A0'              	JZ	SETMOV
  1944'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1947'   FE 0D                 	CPI	CR
  1949'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  194C'   FE 0A                 	CPI	LF
  194E'   CA 07A0'              	JZ	SETMOV
  1951'   47                    	MOV	B,A
  1952'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1954'   FE 41                 	CPI	'A'
  1956'   DA 1962'              	JC	VT_PUT		; below 'A': no case
  1959'   FE 5B                 	CPI	'Z'+1
  195B'   D2 1962'              	JNC	VT_PUT		; above 'Z': no case
  195E'   78                    	MOV	A,B
  195F'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1961'   47                    	MOV	B,A
  1962'                         VT_PUT:
  1962'   78                    	MOV	A,B
  1963'   32 2D3D'              	STA	VRCH		; the calls below do not preserve B
  1966'   CD 0174'              	CALL	MARKMOD
  1969'   21 0001               	LXI	H,1
  196C'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  196F'   3A 2D3D'              	LDA	VRCH
  1972'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1975'   C3 17E4'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1978'                         VC_R:
  1978'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  197B'   3E 03                 	MVI	A,PR
  197D'   32 2D15'              	STA	GPEND
  1980'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1981'                         VR_DO:
  1981'   AF                    	XRA	A
  1982'   32 2D15'              	STA	GPEND
  1985'   79                    	MOV	A,C
  1986'   32 2D3D'              	STA	VRCH		; the calls below do not preserve C
  1989'   CD 07A6'              	CALL	SETLIN		; only this row changed
  198C'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  198F'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1992'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
  1995'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1998'   FE 0D                 	CPI	CR
  199A'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  199D'   FE 0A                 	CPI	LF
  199F'   CA 07A0'              	JZ	SETMOV
  19A2'   CD 0174'              	CALL	MARKMOD
  19A5'   21 0001               	LXI	H,1
  19A8'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19AB'   3A 2D3D'              	LDA	VRCH
  19AE'   FE 0D                 	CPI	CR
  19B0'   CA 19BD'              	JZ	VR_CR
  19B3'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  19B6'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  19B9'   2B                    	DCX	H		;   out, which moves every logical offset
  19BA'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  19BD'                         VR_CR:
  19BD'   CD 1868'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  19C0'   CD 1875'              	CALL	ENDBRK		;   replaced char may have been the text's last
  19C3'   CD 07AC'              	CALL	SETILN		;   row above it lost the char that was replaced,
  19C6'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  19C8'   32 2CEA'              	STA	ILABOV
  19CB'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  19CC'                         VCB_R:
  19CC'   CD 06CB'              	CALL	GETCNT
  19CF'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  19D2'   21 0000               	LXI	H,0
  19D5'   22 2D3E'              	SHLD	RPDEL		; nothing of ours to put back yet
  19D8'   22 2D40'              	SHLD	RPAPP
  19DB'   3E 02                 	MVI	A,EM_REP
  19DD'   32 2CE2'              	STA	EDMODE
  19E0'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  19E1'                         VC_D:
  19E1'   3E 64                 	MVI	A,'d'
  19E3'   32 2D17'              	STA	PENDOP
  19E6'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  19E9'                         VC_C:
  19E9'   3E 63                 	MVI	A,'c'
  19EB'   32 2D17'              	STA	PENDOP
  19EE'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  19F1'                         VD_DD:
  19F1'   CD 092C'              	CALL	GLSTAL
  19F4'   CD 06CB'              	CALL	GETCNT
  19F7'   22 2D30'              	SHLD	CNTV
  19FA'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  19FC'   32 2D19'              	STA	DDSNG
  19FF'   2B                    	DCX	H
  1A00'   7C                    	MOV	A,H
  1A01'   B5                    	ORA	L
  1A02'   C2 1A10'              	JNZ	VDD_LS
  1A05'   3E 01                 	MVI	A,1
  1A07'   32 2D19'              	STA	DDSNG
  1A0A'   CD 16CE'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1A0D'   C3 1A16'              	JMP	VDD_GO
  1A10'                         VDD_LS:
  1A10'   CD 08E5'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1A13'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1A16'                         VDD_GO:
  1A16'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1A19'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1A1C'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1A1F'   CD 23C2'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1A22'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1A25'   2A 2D30'              	LHLD	CNTV
  1A28'   CD 0000*              	CALL	SETC0
  1A2B'                         VDD_FW:
  1A2B'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1A2E'   DA 1B7C'              	JC	QREFUS		; ... which has no room for them
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A31'   CD 06E0'              	CALL	CNTTST
  1A34'   C2 1A2B'              	JNZ	VDD_FW
  1A37'   CD 0174'              	CALL	MARKMOD
  1A3A'   CD 0A63'              	CALL	ATEOF
  1A3D'   D2 1A58'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1A40'   3E 00                 	MVI	A,0
  1A42'   32 2D19'              	STA	DDSNG		; deleted to the end: full repaint
  1A45'   CD 1116'              	CALL	ONFST
  1A48'   CA 087A'              	JZ	FNBLNK		; nothing left before it
  1A4B'   21 0001               	LXI	H,1		; onto the new last line
  1A4E'   CD 0000*              	CALL	SETBWD
  1A51'   2A 0000*              	LHLD	LNDLT
  1A54'   2B                    	DCX	H
  1A55'   22 0000*              	SHLD	LNDLT
  1A58'                         VDD_UP:
  1A58'   CD 087A'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1A5B'   3A 2D19'              	LDA	DDSNG
  1A5E'   B7                    	ORA	A
  1A5F'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1A60'   3E 03                 	MVI	A,R_DLIN
  1A62'   32 2CE7'              	STA	RINTENT
  1A65'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1A66'                         QEMPTY:
  1A66'   2A 0000*              	LHLD	QBEG
  1A69'   EB                    	XCHG
  1A6A'   2A 0000*              	LHLD	QEND
  1A6D'   7C                    	MOV	A,H
  1A6E'   BA                    	CMP	D
  1A6F'   C0                    	RNZ
  1A70'   7D                    	MOV	A,L
  1A71'   BB                    	CMP	E
  1A72'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ; linewise ones and turns the rest away.
  1A73'                         VC_Y:
  1A73'   3E 79                 	MVI	A,'y'
  1A75'   32 2D17'              	STA	PENDOP
  1A78'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1A7B'                         VY_YY:
  1A7B'   21 2D20'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1A7E'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1A81'   CD 0000*              	CALL	CUROFF
  1A84'   22 2D61'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1A87'   CD 0624'              	CALL	BOL
  1A8A'   22 2D63'              	SHLD	YPT		; where the lines come from, to put them back
  1A8D'   CD 1BE2'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1A90'   CD 1C25'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1A93'   D2 1BE9'              	JNC	YNDONE
  1A96'   21 19F1'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1A99'   C3 1AC5'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1A9C'                         OPYANK:
  1A9C'   CD 16E6'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1A9F'   2A 2D1C'              	LHLD	OPSTA
  1AA2'   EB                    	XCHG			; DE = start
  1AA3'   2A 2D1E'              	LHLD	OPEND2		; HL = end
  1AA6'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1AA9'   D2 1AAD'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1AAC'   EB                    	XCHG			; ... otherwise the start is
  1AAD'                         OPY_LO:
  1AAD'   22 2D61'              	SHLD	YOFF
  1AB0'   2A 2D2C'              	LHLD	OPLO
  1AB3'   22 2D63'              	SHLD	YPT		; where the lines come from, to put them back
  1AB6'   CD 1BE2'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AB9'   CD 1C9D'              	CALL	YNSPAN		; copied where they lie, if there is room
  1ABC'   D2 1BE9'              	JNC	YNDONE
  1ABF'   21 1BA3'              	LXI	H,YSPAN
  1AC2'   C3 1AC5'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1AC5'                         YKGO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1AC5'   22 2D8B'              	SHLD	YACT
  1AC8'   2A 2D63'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1ACB'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1ACC'   2A 2D61'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1ACF'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1AD2'   22 2D91'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1AD5'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1AD8'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1AD9'   2A 2D63'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1ADC'   EB                    	XCHG			;   window as it was, then names other text
  1ADD'   E1                    	POP	H
  1ADE'   CD 0000*              	CALL	SUBHD
  1AE1'   EB                    	XCHG			; DE = how far behind the cursor they start
  1AE2'   CD 11E3'              	CALL	CURFP
  1AE5'   06 00                 	MVI	B,0
  1AE7'   CD 11D9'              	CALL	SUB24
  1AEA'   22 2D93'              	SHLD	YPFP
  1AED'   32 2D95'              	STA	YPFP+2
  1AF0'   3A 2CE6'              	LDA	MODF
  1AF3'   32 2D5E'              	STA	YMODF
  1AF6'   3A 2D0A'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1AF9'   32 2D5F'              	STA	YDCHG		;   a yank must not become the last change
  1AFC'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1AFF'   32 2D60'              	STA	YURPL		;   back are not a change to undo either
  1B02'   3E 01                 	MVI	A,1
  1B04'   32 0000*              	STA	UNDRPL
  1B07'   32 2D8A'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1B0A'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1B0D'   22 2D6D'              	SHLD	YLDLT
  1B10'   CD 0000*              	CALL	LOGLEN
  1B13'   22 2D8F'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1B16'   2A 2D8B'              	LHLD	YACT
  1B19'   CD 1B7B'              	CALL	YCALL		; the lines out of the file, into the register
  1B1C'   3A 2D59'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1B1F'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1B21'   CA 1B5F'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1B24'   CD 0000*              	CALL	LOGLEN
  1B27'   EB                    	XCHG
  1B28'   2A 2D8F'              	LHLD	YWAS
  1B2B'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1B2E'   CA 1B40'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1B31'   21 2D93'              	LXI	H,YPFP		; back to where they came from, by its place in
  1B34'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1B37'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1B3A'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1B3D'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1B40'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1B40'   2A 2D93'              	LHLD	YPFP		;   cursor is still owed its place)
  1B43'   EB                    	XCHG
  1B44'   2A 2D91'              	LHLD	YCOL
  1B47'   19                    	DAD	D
  1B48'   22 2D86'              	SHLD	MKPOS
  1B4B'   3A 2D95'              	LDA	YPFP+2
  1B4E'   CE 00                 	ACI	0
  1B50'   32 2D88'              	STA	MKPOS+2
  1B53'   CD 03A9'              	CALL	MKPAGE
  1B56'   CD 0000*              	CALL	GOTO
  1B59'                         YK_RST:
  1B59'   2A 2D6D'              	LHLD	YLDLT
  1B5C'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1B5F'                         YK_RF:
  1B5F'   3A 2D5E'              	LDA	YMODF
  1B62'   32 2CE6'              	STA	MODF
  1B65'   3A 2D5F'              	LDA	YDCHG
  1B68'   32 2D0A'              	STA	DOTCHG
  1B6B'   3A 2D60'              	LDA	YURPL
  1B6E'   32 0000*              	STA	UNDRPL
  1B71'   AF                    	XRA	A
  1B72'   32 2D8A'              	STA	MKHOLD
  1B75'   CD 092C'              	CALL	GLSTAL
  1B78'   C3 07C1'              	JMP	SETFUL		; the cheap paint cannot carry this
  1B7B'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1B7C'                         QREFUS:
  1B7C'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1B7F'   CD 1A66'              	CALL	QEMPTY
  1B82'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1B85'   CD 0000*              	CALL	QKILL
  1B88'   3A 2D8A'              	LDA	MKHOLD
  1B8B'   B7                    	ORA	A
  1B8C'   C2 1B9B'              	JNZ	QRF_Y
  1B8F'   21 0000*              	LXI	H,MKSAV
  1B92'   11 0000*              	LXI	D,MKTAB
  1B95'   CD 23C2'              	CALL	COPY12
  1B98'   CD 0000*              	CALL	UNDCLR
  1B9B'                         QRF_Y:
  1B9B'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1B9D'   32 2D59'              	STA	MSGWHT
  1BA0'   C3 14F5'              	JMP	OPG_HM
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1BA3'                         YSPAN:
  1BA3'   CD 092C'              	CALL	GLSTAL
  1BA6'   CD 16A9'              	CALL	OPSPNL		; HL = the span's length
  1BA9'   22 2D8D'              	SHLD	YTGT
  1BAC'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1BAF'   EB                    	XCHG			; DE = it
  1BB0'   2A 2D8D'              	LHLD	YTGT
  1BB3'   EB                    	XCHG			; HL = the text's, DE = the span's
  1BB4'   CD 0000*              	CALL	SUBHD
  1BB7'   22 2D8D'              	SHLD	YTGT		; what the text is left at when the span is out
  1BBA'   2A 2D2C'              	LHLD	OPLO
  1BBD'   CD 0000*              	CALL	GOTO
  1BC0'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1BC3'                         YS_LP:
  1BC3'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1BC6'   CD 0000*              	CALL	SETC0
  1BC9'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1BCC'   DA 1B7C'              	JC	QREFUS		; ... which has no room for it
  1BCF'   CD 0000*              	CALL	LOGLEN
  1BD2'   EB                    	XCHG			; DE = what is left
  1BD3'   2A 2D8D'              	LHLD	YTGT
  1BD6'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1BD9'   DA 1BDF'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1BDC'   C2 1BC3'              	JNZ	YS_LP		;   but never spin here if it ever did
  1BDF'                         YS_END:
  1BDF'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1BE2'                         YNPRE:
  1BE2'   2A 0000*              	LHLD	PGTOPM
  1BE5'   22 2D96'              	SHLD	YNPG
  1BE8'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1BE9'                         YNDONE:
  1BE9'   2A 2D61'              	LHLD	YOFF
  1BEC'   CD 0000*              	CALL	GOTO
  1BEF'   2A 0000*              	LHLD	PGTOPM
  1BF2'   EB                    	XCHG
  1BF3'   2A 2D96'              	LHLD	YNPG
  1BF6'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1BF9'   C2 07C1'              	JNZ	SETFUL		; it moved under us: repaint after all
  1BFC'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1BFF'                         YNROOM:
  1BFF'   11 0100               	LXI	D,100H
  1C02'   19                    	DAD	D
  1C03'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1C04'   E5                    	PUSH	H		; the span plus its slack
  1C05'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1C08'   EB                    	XCHG			; HL = free
  1C09'   D1                    	POP	D		; DE = the span plus its slack
  1C0A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1C0D'   DA 1C15'              	JC	YNR_OK
  1C10'   CA 1C15'              	JZ	YNR_OK
  1C13'   37                    	STC			; not enough: the delete-and-put-back path
  1C14'   C9                    	RET
  1C15'                         YNR_OK:
  1C15'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1C16'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ; not touched.
  1C17'                         YNGO:
  1C17'   C5                    	PUSH	B
  1C18'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  1C1B'   CD 092C'              	CALL	GLSTAL
  1C1E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C21'   C1                    	POP	B
  1C22'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1C25'                         YNCOPY:
  1C25'   2A 2CE3'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1C28'   7C                    	MOV	A,H		;   the count itself
  1C29'   B5                    	ORA	L
  1C2A'   C2 1C30'              	JNZ	YNC_HV
  1C2D'   21 0001               	LXI	H,1
  1C30'                         YNC_HV:
  1C30'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1C31'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1C32'   B4                    	ORA	H
  1C33'   CA 1C3E'              	JZ	YNC_M
  1C36'   E5                    	PUSH	H
  1C37'   CD 08E5'              	CALL	ONLAST		; vim: a count over one on the last line does
  1C3A'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1C3B'   DA 1C50'              	JC	YNC_RF
  1C3E'                         YNC_M:
  1C3E'   E5                    	PUSH	H
  1C3F'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1C42'   E1                    	POP	H
  1C43'   CD 1C58'              	CALL	YNLINE		; BC = the span, measured where it stands
  1C46'   D8                    	RC			; not measurable here: let the pager answer it
  1C47'   60                    	MOV	H,B
  1C48'   69                    	MOV	L,C
  1C49'   CD 1BFF'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1C4C'   D8                    	RC			; no: the delete-and-put-back path
  1C4D'   C3 1C17'              	JMP	YNGO
  1C50'                         YNC_RF:
  1C50'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1C53'   CD 092C'              	CALL	GLSTAL		;   register alone, and that is the command
  1C56'   B7                    	ORA	A		; NC: done
  1C57'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1C58'                         YNLINE:
  1C58'   22 2D98'              	SHLD	YNCNT		; the lines it still wants
  1C5B'   2A 0000*              	LHLD	GAPEND
  1C5E'                         YNL_LP:
  1C5E'   EB                    	XCHG			; DE = the scan
  1C5F'   2A 0000*              	LHLD	TXTEND
  1C62'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1C65'   EB                    	XCHG			; HL = the scan
  1C66'   D2 1C86'              	JNC	YNL_EN		; the resident text ran out
  1C69'   7E                    	MOV	A,M
  1C6A'   23                    	INX	H
  1C6B'   FE 0A                 	CPI	LF
  1C6D'   C2 1C5E'              	JNZ	YNL_LP
  1C70'   E5                    	PUSH	H
  1C71'   2A 2D98'              	LHLD	YNCNT
  1C74'   2B                    	DCX	H
  1C75'   22 2D98'              	SHLD	YNCNT
  1C78'   7C                    	MOV	A,H
  1C79'   B5                    	ORA	L
  1C7A'   E1                    	POP	H
  1C7B'   C2 1C5E'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1C7E'   EB                    	XCHG			; DE = past the last of them
  1C7F'   2A 0000*              	LHLD	GAPEND
  1C82'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1C83'   C3 1C94'              	JMP	YNL_BC
  1C86'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1C86'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1C89'   C2 1C9B'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1C8C'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1C8F'   EB                    	XCHG			;   count clamps to it as vim's does
  1C90'   2A 0000*              	LHLD	GAPEND
  1C93'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1C94'                         YNL_BC:
  1C94'   CD 0000*              	CALL	SUBHD		; HL = the span
  1C97'   44                    	MOV	B,H
  1C98'   4D                    	MOV	C,L
  1C99'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1C9A'   C9                    	RET
  1C9B'                         YNL_NO:
  1C9B'   37                    	STC
  1C9C'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1C9D'                         YNSPAN:
  1C9D'   CD 16A9'              	CALL	OPSPNL		; HL = the span's length
  1CA0'   44                    	MOV	B,H
  1CA1'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1CA2'   CD 1BFF'              	CALL	YNROOM
  1CA5'   D8                    	RC			; no room: the delete-and-put-back path
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CA6'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1CA7'   2A 2D2C'              	LHLD	OPLO
  1CAA'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1CAD'   C1                    	POP	B
  1CAE'   C3 1C17'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1CB1'                         VC_P:
  1CB1'   CD 1A66'              	CALL	QEMPTY
  1CB4'   CA 1D87'              	JZ	VP_BEL
  1CB7'   CD 06CB'              	CALL	GETCNT
  1CBA'   22 2D65'              	SHLD	PCNT
  1CBD'   CD 0000*              	CALL	CUROFF
  1CC0'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1CC3'   C3 1CD8'              	JMP	VP_GO
  1CC6'                         VCB_P:
  1CC6'   CD 1A66'              	CALL	QEMPTY
  1CC9'   CA 1D87'              	JZ	VP_BEL
  1CCC'   CD 06CB'              	CALL	GETCNT
  1CCF'   22 2D65'              	SHLD	PCNT
  1CD2'   CD 0000*              	CALL	CUROFF
  1CD5'   CD 0624'              	CALL	BOL
  1CD8'                         VP_GO:
  1CD8'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1CDB'   CD 0000*              	CALL	CUROFF
  1CDE'   EB                    	XCHG
  1CDF'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1CE2'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1CE5'   DA 1CFA'              	JC	VP_IN
  1CE8'   EB                    	XCHG			; HL = the put point = LOGLEN
  1CE9'   7C                    	MOV	A,H
  1CEA'   B5                    	ORA	L
  1CEB'   CA 1CF7'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1CEE'   2B                    	DCX	H
  1CEF'   CD 0000*              	CALL	CHARAT
  1CF2'   FE 0A                 	CPI	LF
  1CF4'   CA 1CFA'              	JZ	VP_IN
  1CF7'                         VP_BRK:
  1CF7'   CD 1868'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1CFA'                         VP_IN:
  1CFA'   21 2D67'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1CFD'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1D00'   CD 122C'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1D03'   2A 0000*              	LHLD	QBEG
  1D06'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D07'   2A 0000*              	LHLD	QEND
  1D0A'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1D0D'   EB                    	XCHG
  1D0E'   22 2D6A'              	SHLD	PLFS
  1D11'   2A 2D65'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1D14'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1D15'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1D16'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1D18'   C2 1D1C'              	JNZ	VP_PZ
  1D1B'   7D                    	MOV	A,L
  1D1C'                         VP_PZ:
  1D1C'   32 2D6C'              	STA	PCPY
  1D1F'                         VP_LP:
  1D1F'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1D22'   2A 0000*              	LHLD	LNDLT
  1D25'   EB                    	XCHG
  1D26'   2A 2D6A'              	LHLD	PLFS
  1D29'   19                    	DAD	D
  1D2A'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1D2D'   2A 2D65'              	LHLD	PCNT
  1D30'   2B                    	DCX	H
  1D31'   22 2D65'              	SHLD	PCNT
  1D34'   7C                    	MOV	A,H
  1D35'   B5                    	ORA	L
  1D36'   C2 1D1F'              	JNZ	VP_LP
  1D39'   CD 0174'              	CALL	MARKMOD
  1D3C'   21 2D67'              	LXI	H,PPFP
  1D3F'   CD 03DC'              	CALL	MKLOAD
  1D42'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1D45'   D2 1D78'              	JNC	VP_PGD
  1D48'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1D4B'   CD 092C'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1D4E'   3A 2D6C'              	LDA	PCPY
  1D51'   B7                    	ORA	A
  1D52'   CA 087A'              	JZ	FNBLNK
  1D55'   2A 2D6A'              	LHLD	PLFS
  1D58'   7C                    	MOV	A,H
  1D59'   B7                    	ORA	A
  1D5A'   C2 087A'              	JNZ	FNBLNK
  1D5D'   3A 2D6C'              	LDA	PCPY
  1D60'   CD 0F13'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1D63'   7C                    	MOV	A,H
  1D64'   B7                    	ORA	A
  1D65'   C2 087A'              	JNZ	FNBLNK
  1D68'   7D                    	MOV	A,L
  1D69'   B7                    	ORA	A
  1D6A'   CA 087A'              	JZ	FNBLNK
  1D6D'   F5                    	PUSH	PSW
  1D6E'   CD 07AC'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1D71'   F1                    	POP	PSW
  1D72'   32 2CE8'              	STA	ILN		; ... which the lines put now replace
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D75'   C3 087A'              	JMP	FNBLNK
  1D78'                         VP_PGD:				; the put paged its first line out: page back
  1D78'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1D7B'   CD 0000*              	CALL	GOTO
  1D7E'   CD 092C'              	CALL	GLSTAL
  1D81'   CD 1244'              	CALL	GPLACE
  1D84'   C3 07C1'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1D87'                         VP_BEL:
  1D87'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1D8A'   0E 07                 	MVI	C,BEL
  1D8C'   CD 0000*              	CALL	BCONOU
  1D8F'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1D92'                         VIREP:
  1D92'   79                    	MOV	A,C
  1D93'   FE 1B                 	CPI	ESC
  1D95'   CA 1EBA'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1D98'   FE 0D                 	CPI	CR
  1D9A'   CA 1DFE'              	JZ	VP_CR
  1D9D'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1D9F'   CA 1DFE'              	JZ	VP_CR
  1DA2'   FE 08                 	CPI	BS
  1DA4'   CA 1E0A'              	JZ	VP_BS
  1DA7'   FE 7F                 	CPI	DEL
  1DA9'   CA 1E0A'              	JZ	VP_BS
  1DAC'   32 2D3D'              	STA	VRCH		; the calls below do not preserve C
  1DAF'   CD 07A6'              	CALL	SETLIN		; this row changed
  1DB2'   CD 0174'              	CALL	MARKMOD
  1DB5'   CD 185B'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1DB8'   CA 1DF0'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1DBB'   3A 2D3D'              	LDA	VRCH
  1DBE'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1DC1'   2A 2D3E'              	LHLD	RPDEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DC4'   7C                    	MOV	A,H
  1DC5'   B5                    	ORA	L
  1DC6'   CA 1DDC'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1DC9'   2A 0000*              	LHLD	GAPEND
  1DCC'   EB                    	XCHG
  1DCD'   2A 2D42'              	LHLD	RPGE
  1DD0'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1DD3'   CA 1DDC'              	JZ	VP_OVW
  1DD6'   21 0000               	LXI	H,0
  1DD9'   22 2D3E'              	SHLD	RPDEL		; the text moved: those originals are gone
  1DDC'                         VP_OVW:
  1DDC'   21 0001               	LXI	H,1
  1DDF'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1DE2'   2A 0000*              	LHLD	GAPEND
  1DE5'   22 2D42'              	SHLD	RPGE
  1DE8'   2A 2D3E'              	LHLD	RPDEL
  1DEB'   23                    	INX	H
  1DEC'   22 2D3E'              	SHLD	RPDEL
  1DEF'   C9                    	RET
  1DF0'                         VP_APP:
  1DF0'   3A 2D3D'              	LDA	VRCH
  1DF3'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1DF6'   2A 2D40'              	LHLD	RPAPP
  1DF9'   23                    	INX	H
  1DFA'   22 2D40'              	SHLD	RPAPP
  1DFD'   C9                    	RET
  1DFE'                         VP_CR:
  1DFE'   21 0000               	LXI	H,0
  1E01'   22 2D3E'              	SHLD	RPDEL		; a line break ends what BS can put back
  1E04'   22 2D40'              	SHLD	RPAPP
  1E07'   C3 1E90'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1E0A'                         VP_BS:
  1E0A'   2A 2D40'              	LHLD	RPAPP
  1E0D'   7C                    	MOV	A,H
  1E0E'   B5                    	ORA	L
  1E0F'   CA 1E1C'              	JZ	VP_BSD
  1E12'   2B                    	DCX	H
  1E13'   22 2D40'              	SHLD	RPAPP		; an appended char: it just goes
  1E16'   CD 07A6'              	CALL	SETLIN
  1E19'   C3 0000*              	JMP	DELPRV
  1E1C'                         VP_BSD:
  1E1C'   2A 2D3E'              	LHLD	RPDEL
  1E1F'   7C                    	MOV	A,H
  1E20'   B5                    	ORA	L
  1E21'   CA 1E48'              	JZ	VP_BSM		; nothing of ours left
  1E24'   2A 0000*              	LHLD	GAPEND
  1E27'   EB                    	XCHG
  1E28'   2A 2D42'              	LHLD	RPGE
  1E2B'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1E2E'   C2 1E48'              	JNZ	VP_BSM
  1E31'   2A 2D3E'              	LHLD	RPDEL
  1E34'   2B                    	DCX	H
  1E35'   22 2D3E'              	SHLD	RPDEL
  1E38'   CD 07A6'              	CALL	SETLIN
  1E3B'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1E3E'   CD 0000*              	CALL	UNDELF		; the original comes back
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E41'   2A 0000*              	LHLD	GAPEND
  1E44'   22 2D42'              	SHLD	RPGE
  1E47'   C9                    	RET
  1E48'                         VP_BSM:
  1E48'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1E4B'   C3 080F'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1E4E'                         VIINS:
  1E4E'   79                    	MOV	A,C
  1E4F'   FE 1B                 	CPI	ESC
  1E51'   CA 1EBA'              	JZ	VI_ESC
  1E54'   FE 0D                 	CPI	CR
  1E56'   CA 1E90'              	JZ	VI_CR
  1E59'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1E5B'   CA 1E90'              	JZ	VI_CR
  1E5E'   FE 08                 	CPI	BS
  1E60'   CA 1EA8'              	JZ	VI_BS
  1E63'   FE 7F                 	CPI	DEL
  1E65'   CA 1EA8'              	JZ	VI_BS
  1E68'   79                    	MOV	A,C
  1E69'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1E6C'   CD 0174'              	CALL	MARKMOD
  1E6F'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1E72'   79                    	MOV	A,C
  1E73'   FE 20                 	CPI	' '
  1E75'   D8                    	RC			; control char -> keep R_LINE
  1E76'   FE 7F                 	CPI	DEL
  1E78'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1E79'   CD 07C7'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1E7C'   B7                    	ORA	A
  1E7D'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1E7E'   3E 04                 	MVI	A,R_ICH
  1E80'   32 2CE7'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1E83'   CD 185B'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1E86'   3E 00                 	MVI	A,0
  1E88'   C2 1E8C'              	JNZ	VI_ICH
  1E8B'   3C                    	INR	A
  1E8C'                         VI_ICH:
  1E8C'   32 2CE9'              	STA	ICHAPP
  1E8F'   C9                    	RET
  1E90'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E90'   CD 185B'              	CALL	ATCEND
  1E93'   3E 00                 	MVI	A,0
  1E95'   CA 1E99'              	JZ	VI_CRS
  1E98'   3C                    	INR	A
  1E99'                         VI_CRS:
  1E99'   F5                    	PUSH	PSW
  1E9A'   CD 1868'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1E9D'   CD 1875'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1EA0'   CD 07AC'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1EA3'   F1                    	POP	PSW
  1EA4'   32 2CEA'              	STA	ILABOV
  1EA7'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1EA8'                         VI_BS:
  1EA8'   CD 0000*              	CALL	PEEKL
  1EAB'   D8                    	RC			; start of the file: nothing to delete
  1EAC'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1EAE'   CA 1EB4'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1EB1'   CD 07A6'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1EB4'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1EB4'   CD 0174'              	CALL	MARKMOD
  1EB7'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1EBA'                         VI_ESC:
  1EBA'   3E 00                 	MVI	A,EM_CMD
  1EBC'   32 2CE2'              	STA	EDMODE
  1EBF'   CD 07A0'              	CALL	SETMOV
  1EC2'   CD 080F'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1EC5'   C3 092C'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1EC8'                         RDLINE:
  1EC8'   EB                    	XCHG			; HL = buffer
  1EC9'   22 2D44'              	SHLD	RLPTR
  1ECC'   3E 00                 	MVI	A,0
  1ECE'   32 2D46'              	STA	RLLEN
  1ED1'   78                    	MOV	A,B
  1ED2'   32 2D47'              	STA	RLMAX
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1ED5'   79                    	MOV	A,C
  1ED6'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1ED9'                         RL_LP:
  1ED9'   CD 0000*              	CALL	GETKEY
  1EDC'   FE 1B                 	CPI	ESC
  1EDE'   CA 1F2E'              	JZ	RL_CAN
  1EE1'   FE 0D                 	CPI	CR
  1EE3'   CA 1F39'              	JZ	RL_DONE
  1EE6'   FE 08                 	CPI	BS
  1EE8'   CA 1F16'              	JZ	RL_BS
  1EEB'   FE 7F                 	CPI	DEL
  1EED'   CA 1F16'              	JZ	RL_BS
  1EF0'   FE 20                 	CPI	' '
  1EF2'   DA 1ED9'              	JC	RL_LP		; control char -> ignore
  1EF5'   3A 2D46'              	LDA	RLLEN
  1EF8'   47                    	MOV	B,A
  1EF9'   3A 2D47'              	LDA	RLMAX
  1EFC'   B8                    	CMP	B
  1EFD'   CA 1ED9'              	JZ	RL_LP		; full -> ignore
  1F00'   2A 2D44'              	LHLD	RLPTR
  1F03'   71                    	MOV	M,C
  1F04'   23                    	INX	H
  1F05'   22 2D44'              	SHLD	RLPTR
  1F08'   3A 2D46'              	LDA	RLLEN
  1F0B'   3C                    	INR	A
  1F0C'   32 2D46'              	STA	RLLEN
  1F0F'   79                    	MOV	A,C
  1F10'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1F13'   C3 1ED9'              	JMP	RL_LP
  1F16'                         RL_BS:				; WM LINEPOP
  1F16'   3A 2D46'              	LDA	RLLEN
  1F19'   B7                    	ORA	A
  1F1A'   CA 1F2E'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1F1D'   3D                    	DCR	A
  1F1E'   32 2D46'              	STA	RLLEN
  1F21'   2A 2D44'              	LHLD	RLPTR
  1F24'   2B                    	DCX	H
  1F25'   22 2D44'              	SHLD	RLPTR
  1F28'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1F2B'   C3 1ED9'              	JMP	RL_LP
  1F2E'                         RL_CAN:
  1F2E'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1F30'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1F33'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1F36'   3E FF                 	MVI	A,0FFH		; cancelled
  1F38'   C9                    	RET
  1F39'                         RL_DONE:
  1F39'   AF                    	XRA	A
  1F3A'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1F3B'                         VC_BZ:
  1F3B'   CD 07A0'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F3E'   3A 2D16'              	LDA	GSAVE
  1F41'   FE 02                 	CPI	PZ
  1F43'   CA 1F4E'              	JZ	VZ_ZZ
  1F46'   B7                    	ORA	A
  1F47'   C0                    	RNZ			; 'g' was pending: vim drops both
  1F48'   3E 02                 	MVI	A,PZ
  1F4A'   32 2D15'              	STA	GPEND
  1F4D'   C9                    	RET
  1F4E'                         VZ_ZZ:
  1F4E'   3E 04                 	MVI	A,EO_X
  1F50'   32 2D48'              	STA	EXOP
  1F53'   3E 01                 	MVI	A,1
  1F55'   32 2D5B'              	STA	EXBANG		; no '!'
  1F58'   AF                    	XRA	A
  1F59'   32 2D49'              	STA	EXARG		; no file name
  1F5C'   3A 2CE6'              	LDA	MODF		; as ':x': a changed text is written first
  1F5F'   B7                    	ORA	A
  1F60'   CA 20A1'              	JZ	EX_Q
  1F63'   C3 203B'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1F66'                         VC_EX:
  1F66'   CD 06CB'              	CALL	GETCNT
  1F69'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1F6C'   11 0000*              	LXI	D,EXBUF
  1F6F'   06 28                 	MVI	B,EXMAX
  1F71'   0E 3A                 	MVI	C,':'
  1F73'   CD 1EC8'              	CALL	RDLINE
  1F76'   B7                    	ORA	A
  1F77'   C0                    	RNZ			; cancelled
  1F78'   3A 2D46'              	LDA	RLLEN
  1F7B'   5F                    	MOV	E,A
  1F7C'   16 00                 	MVI	D,0
  1F7E'   21 0000*              	LXI	H,EXBUF
  1F81'   19                    	DAD	D
  1F82'   36 00                 	MVI	M,0		; the line ends with a 0
  1F84'   21 0000*              	LXI	H,EXBUF
  1F87'   CD 2553'              	CALL	SKIPB
  1F8A'   C8                    	RZ			; nothing on it
  1F8B'   22 2D4B'              	SHLD	EXCMD
  1F8E'   CD 2757'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1F91'   CD 2553'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F94'   56                    	MOV	D,M
  1F95'   23                    	INX	H
  1F96'   1E 00                 	MVI	E,0
  1F98'   CD 255F'              	CALL	ISLOW
  1F9B'   DA 1FA6'              	JC	EX_LK
  1F9E'   5F                    	MOV	E,A
  1F9F'   23                    	INX	H
  1FA0'   CD 255F'              	CALL	ISLOW
  1FA3'   D2 1FBF'              	JNC	EX_NOT		; a third letter: none of ours
  1FA6'                         EX_LK:
  1FA6'   E5                    	PUSH	H
  1FA7'   21 273E'              	LXI	H,EXTAB
  1FAA'                         EX_TL:
  1FAA'   7E                    	MOV	A,M
  1FAB'   B7                    	ORA	A
  1FAC'   CA 1FBE'              	JZ	EX_NTP		; not in the table
  1FAF'   23                    	INX	H
  1FB0'   BA                    	CMP	D
  1FB1'   7E                    	MOV	A,M
  1FB2'   23                    	INX	H
  1FB3'   C2 1FBA'              	JNZ	EX_TN
  1FB6'   BB                    	CMP	E
  1FB7'   CA 1FC5'              	JZ	EX_TF
  1FBA'                         EX_TN:
  1FBA'   23                    	INX	H
  1FBB'   C3 1FAA'              	JMP	EX_TL
  1FBE'                         EX_NTP:
  1FBE'   E1                    	POP	H
  1FBF'                         EX_NOT:
  1FBF'   21 2617'              	LXI	H,SNOT
  1FC2'   C3 2594'              	JMP	EXERT
  1FC5'                         EX_TF:
  1FC5'   7E                    	MOV	A,M
  1FC6'   32 2D48'              	STA	EXOP
  1FC9'   E1                    	POP	H
  1FCA'   FE 06                 	CPI	EO_S
  1FCC'   CA 27C6'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1FCF'   FE 01                 	CPI	EO_W
  1FD1'   CA 1FE0'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1FD4'   FE 08                 	CPI	EO_R
  1FD6'   CA 1FE0'              	JZ	EX_RG		; ... and ':Nr name' a line
  1FD9'   3A 2DA4'              	LDA	SRNGF
  1FDC'   B7                    	ORA	A
  1FDD'   C2 1FBF'              	JNZ	EX_NOT		; a range on a command that does not take one
  1FE0'                         EX_RG:
                                	;--- '!', then the file name ---
  1FE0'   7E                    	MOV	A,M
  1FE1'   D6 21                 	SUI	'!'
  1FE3'   32 2D5B'              	STA	EXBANG		; 0 = '!'
  1FE6'   C2 1FEA'              	JNZ	EX_NB
  1FE9'   23                    	INX	H
  1FEA'                         EX_NB:
  1FEA'   CD 2553'              	CALL	SKIPB
  1FED'   32 2D49'              	STA	EXARG		; 0 = no file name
  1FF0'   CA 2009'              	JZ	EX_RUN
  1FF3'   22 2D4B'              	SHLD	EXCMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FF6'   3A 2D48'              	LDA	EXOP
  1FF9'   FE 02                 	CPI	EO_Q
  1FFB'   CA 2591'              	JZ	EX_TRL		; :q takes none
  1FFE'   FE 07                 	CPI	EO_V
  2000'   CA 2591'              	JZ	EX_TRL		; nor :ve
  2003'   CD 24BD'              	CALL	PARSFN
  2006'   C2 2585'              	JNZ	EX_INV
  2009'                         EX_RUN:
  2009'   3A 2D48'              	LDA	EXOP
  200C'   FE 05                 	CPI	EO_E
  200E'   CA 20B8'              	JZ	EX_E
  2011'   FE 02                 	CPI	EO_Q
  2013'   CA 20A1'              	JZ	EX_Q
  2016'   FE 07                 	CPI	EO_V
  2018'   CA 258B'              	JZ	EX_V
  201B'   FE 08                 	CPI	EO_R
  201D'   CA 2249'              	JZ	EX_R
  2020'   FE 04                 	CPI	EO_X
  2022'   CA 2034'              	JZ	EX_XM
  2025'   FE 01                 	CPI	EO_W
  2027'   C2 203B'              	JNZ	EX_W		; :wq
  202A'   3A 2DA4'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  202D'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  202E'   C2 2169'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2031'   C3 203B'              	JMP	EX_W
  2034'                         EX_XM:
  2034'   3A 2CE6'              	LDA	MODF		; :x writes only a changed text
  2037'   B7                    	ORA	A
  2038'   CA 20A1'              	JZ	EX_Q
  203B'                         EX_W:
  203B'   CD 2329'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  203E'   D8                    	RC			; refused (message shown)
  203F'   32 2D4A'              	STA	EXBAK
  2042'   3A 2D48'              	LDA	EXOP
  2045'   FE 01                 	CPI	EO_W
  2047'   CA 205E'              	JZ	EX_WK
  204A'   3A 2D4A'              	LDA	EXBAK
  204D'   B7                    	ORA	A
  204E'   C2 209E'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2051'   3A 2D5B'              	LDA	EXBANG
  2054'   B7                    	ORA	A
  2055'   CA 209E'              	JZ	EX_WQ		; so it does with '!'
  2058'   CD 205E'              	CALL	EX_WK		; else it may not: keep the text
  205B'   C3 20A1'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  205E'                         EX_WK:
  205E'   CD 0D47'              	CALL	CURRW		; the cursor's row and file position
  2061'   32 2D4D'              	STA	WPROW
  2064'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2067'   7D                    	MOV	A,L
  2068'   E6 7F                 	ANI	7FH
  206A'   32 2D4E'              	STA	WPBYT
  206D'   7D                    	MOV	A,L
  206E'   17                    	RAL
  206F'   7C                    	MOV	A,H
  2070'   17                    	RAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2071'   5F                    	MOV	E,A
  2072'   3E 00                 	MVI	A,0
  2074'   17                    	RAL
  2075'   57                    	MOV	D,A		; DE = HL / 128
  2076'   2A 0000*              	LHLD	OUTPOS
  2079'   19                    	DAD	D
  207A'   22 2D4F'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  207D'   CD 235E'              	CALL	WRITE
  2080'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  2083'   2A 2D4F'              	LHLD	WPREC
  2086'   EB                    	XCHG
  2087'   3A 2D4E'              	LDA	WPBYT
  208A'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  208D'   CD 0000*              	CALL	GOTO
  2090'                         EX_WRW:
  2090'   21 0000               	LXI	H,0
  2093'   22 0000*              	SHLD	LNDLT
  2096'   3A 2D4D'              	LDA	WPROW
  2099'   6F                    	MOV	L,A
  209A'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  209D'   C9                    	RET
  209E'                         EX_WQ:
  209E'   CD 235E'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  20A1'                         EX_Q:
  20A1'   3A 2D5B'              	LDA	EXBANG
  20A4'   B7                    	ORA	A
  20A5'   CA 20AF'              	JZ	EX_QT
  20A8'   3A 2CE6'              	LDA	MODF
  20AB'   B7                    	ORA	A
  20AC'   C2 2579'              	JNZ	MSGNWR		; changed, no '!': stay
  20AF'                         EX_QT:
  20AF'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  20B2'   3E 01                 	MVI	A,1
  20B4'   32 2CE5'              	STA	QUITF
  20B7'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  20B8'                         EX_E:
  20B8'   3A 2D5B'              	LDA	EXBANG
  20BB'   B7                    	ORA	A
  20BC'   CA 20C6'              	JZ	EE_GO
  20BF'   3A 2CE6'              	LDA	MODF
  20C2'   B7                    	ORA	A
  20C3'   C2 2579'              	JNZ	MSGNWR
  20C6'                         EE_GO:
  20C6'   3A 2D49'              	LDA	EXARG
  20C9'   B7                    	ORA	A
  20CA'   C2 20D1'              	JNZ	EE_ARG
  20CD'   CD 239A'              	CALL	OWNTF		; no name: the buffer's own
  20D0'   D8                    	RC
  20D1'                         EE_ARG:
  20D1'   CD 23B0'              	CALL	ISOWN
  20D4'   21 0001               	LXI	H,1
  20D7'   C2 20DE'              	JNZ	EE_LD		; another file: its first line
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  20DA'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  20DD'   23                    	INX	H		; HL = the cursor's line
  20DE'                         EE_LD:
  20DE'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  20E0'   32 2D59'              	STA	MSGWHT
  20E3'   E5                    	PUSH	H
  20E4'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  20E7'   21 0000*              	LXI	H,TFCB
  20EA'   11 0000*              	LXI	D,FNAME
  20ED'   CD 23C2'              	CALL	COPY12		; the buffer's name
  20F0'   CD 2387'              	CALL	SRCTF
  20F3'   CD 0000*              	CALL	REOPEN
  20F6'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  20F9'   AF                    	XRA	A
  20FA'   32 2CE6'              	STA	MODF
  20FD'   E1                    	POP	H
  20FE'   2B                    	DCX	H
  20FF'   AF                    	XRA	A
  2100'   CD 0000*              	CALL	MVLIND		; down to the line
  2103'   CD 0A63'              	CALL	ATEOF
  2106'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  2109'   CD 1206'              	CALL	ZSAVE
  210C'   C3 12D6'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  210F'                         TFDOS:
  210F'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2110'   11 0080               	LXI	D,CMDTAIL
  2113'   0E 1A                 	MVI	C,1AH		; set the DMA
  2115'   CD 0005               	CALL	BDOS
  2118'   C1                    	POP	B
  2119'   11 0000*              	LXI	D,TFCB
  211C'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  211F'                         EXRNG:
  211F'   2A 2DA5'              	LHLD	SRNG1
  2122'   7C                    	MOV	A,H
  2123'   B5                    	ORA	L
  2124'   37                    	STC
  2125'   C8                    	RZ
  2126'   2A 2DA7'              	LHLD	SRNG2
  2129'   EB                    	XCHG
  212A'   2A 2DA5'              	LHLD	SRNG1
  212D'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2130'   D8                    	RC
  2131'   EB                    	XCHG			; HL = the last line, DE = the first
  2132'   CD 0000*              	CALL	SUBHD
  2135'   23                    	INX	H
  2136'   22 2DAF'              	SHLD	SLINES
  2139'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  213A'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  213B'                         GOLNX:
  213B'   E5                    	PUSH	H
  213C'   CD 119A'              	CALL	GOLN
  213F'   CD 0000*              	CALL	CNTLF
  2142'   23                    	INX	H		; the line the cursor came to rest on
  2143'   D1                    	POP	D
  2144'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2147'                         EXSAVP:
  2147'   CD 0D47'              	CALL	CURRW
  214A'   32 2D4D'              	STA	WPROW
  214D'   21 2D86'              	LXI	H,MKPOS
  2150'   C3 0429'              	JMP	FPSTO
  2153'                         EXRSTP:
  2153'   CD 0000*              	CALL	CLRCNT
  2156'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2159'   CD 0000*              	CALL	GOTO
  215C'   C3 2090'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  215F'                         PUTBRK:
  215F'   3E 0D                 	MVI	A,CR
  2161'   CD 0000*              	CALL	PUTGAP
  2164'   3E 0A                 	MVI	A,LF
  2166'   C3 0000*              	JMP	PUTGAP
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2169'                         EX_WR:
  2169'   3A 2D49'              	LDA	EXARG
  216C'   B7                    	ORA	A
  216D'   CA 2567'              	JZ	MSGNFN		; No file name
  2170'   CD 23B0'              	CALL	ISOWN
  2173'   CA 2213'              	JZ	EXW_OW
  2176'   CD 0000*              	CALL	TEXIST
  2179'   32 2DB2'              	STA	RWERR		; nonzero: a file of that name is there
  217C'   CA 2186'              	JZ	EXW_GO
  217F'   3A 2D5B'              	LDA	EXBANG
  2182'   B7                    	ORA	A
  2183'   C2 256D'              	JNZ	MSGEXI		; File exists (! to force)
  2186'                         EXW_GO:
  2186'   CD 211F'              	CALL	EXRNG
  2189'   DA 220D'              	JC	EXW_BD
  218C'   CD 2147'              	CALL	EXSAVP
  218F'   2A 2DA5'              	LHLD	SRNG1
  2192'   CD 213B'              	CALL	GOLNX
  2195'   C2 220A'              	JNZ	EXW_NL		; the text has no line N
  2198'   3A 2DB2'              	LDA	RWERR		; a delete scans the whole directory, there or
  219B'   B7                    	ORA	A		;   not: only when TEXIST found one
  219C'   0E 13                 	MVI	C,13H
  219E'   C4 210F'              	CNZ	TFDOS		; delete what is there
  21A1'   0E 16                 	MVI	C,16H
  21A3'   CD 210F'              	CALL	TFDOS		; ... and make it
  21A6'   3C                    	INR	A
  21A7'   CA 21FC'              	JZ	EXW_FL		; no directory entry left
  21AA'   3E 80                 	MVI	A,80H
  21AC'   32 2DB1'              	STA	RWPTR
  21AF'   AF                    	XRA	A
  21B0'   32 2DB2'              	STA	RWERR
  21B3'   2A 2DAF'              	LHLD	SLINES
  21B6'   CD 0000*              	CALL	SETC0		; that many lines, forward
  21B9'                         EXW_LP:
  21B9'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  21BC'   E5                    	PUSH	H
  21BD'   EB                    	XCHG
  21BE'   2A 0000*              	LHLD	GAPEND
  21C1'   CD 2219'              	CALL	RWOUT		; the text from the cursor to there
  21C4'   E1                    	POP	H
  21C5'   3A 2DB2'              	LDA	RWERR
  21C8'   B7                    	ORA	A
  21C9'   C2 21E5'              	JNZ	EXW_EN
  21CC'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  21CF'   CD 06E0'              	CALL	CNTTST
  21D2'   C2 21B9'              	JNZ	EXW_LP
  21D5'                         EXW_PD:				; the last record is padded out with ^Z
  21D5'   3A 2DB1'              	LDA	RWPTR
  21D8'   FE 80                 	CPI	80H
  21DA'   CA 21E5'              	JZ	EXW_EN
  21DD'   3E 1A                 	MVI	A,CPMEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21DF'   CD 2225'              	CALL	RWPUT
  21E2'   C3 21D5'              	JMP	EXW_PD
  21E5'                         EXW_EN:
  21E5'   0E 10                 	MVI	C,10H
  21E7'   CD 210F'              	CALL	TFDOS		; close
  21EA'   3A 2DB2'              	LDA	RWERR
  21ED'   B7                    	ORA	A
  21EE'   C2 21FC'              	JNZ	EXW_FL
  21F1'   CD 2153'              	CALL	EXRSTP
  21F4'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  21F6'   32 2D59'              	STA	MSGWHT
  21F9'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  21FC'                         EXW_FL:				; no room: the part written is not left behind
  21FC'   0E 13                 	MVI	C,13H
  21FE'   CD 210F'              	CALL	TFDOS
  2201'   CD 2153'              	CALL	EXRSTP
  2204'   21 2734'              	LXI	H,SDFUL
  2207'   C3 259F'              	JMP	EXERR
  220A'                         EXW_NL:
  220A'   CD 2153'              	CALL	EXRSTP
  220D'                         EXW_BD:
  220D'   21 2726'              	LXI	H,SRNGE
  2210'   C3 259F'              	JMP	EXERR
  2213'                         EXW_OW:
  2213'   21 25CE'              	LXI	H,SEXI
  2216'   C3 259F'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2219'                         RWOUT:
  2219'   CD 0000*              	CALL	CMP16
  221C'   C8                    	RZ
  221D'   7E                    	MOV	A,M
  221E'   23                    	INX	H
  221F'   CD 2225'              	CALL	RWPUT
  2222'   C3 2219'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2225'                         RWPUT:
  2225'   E5                    	PUSH	H
  2226'   F5                    	PUSH	PSW
  2227'   3A 2DB1'              	LDA	RWPTR
  222A'   6F                    	MOV	L,A
  222B'   26 00                 	MVI	H,0
  222D'   F1                    	POP	PSW
  222E'   77                    	MOV	M,A
  222F'   2C                    	INR	L		; Z: that was the record's last byte
  2230'   7D                    	MOV	A,L
  2231'   C2 2244'              	JNZ	RWP_ST
  2234'   D5                    	PUSH	D
  2235'   0E 15                 	MVI	C,15H
  2237'   CD 210F'              	CALL	TFDOS		; write it
  223A'   D1                    	POP	D
  223B'   B7                    	ORA	A
  223C'   CA 2242'              	JZ	RWP_OK
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  223F'   32 2DB2'              	STA	RWERR
  2242'                         RWP_OK:
  2242'   3E 80                 	MVI	A,80H
  2244'                         RWP_ST:
  2244'   32 2DB1'              	STA	RWPTR
  2247'   E1                    	POP	H
  2248'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2249'                         EX_R:
  2249'   3A 2D49'              	LDA	EXARG
  224C'   B7                    	ORA	A
  224D'   CA 2567'              	JZ	MSGNFN		; No file name
  2250'   0E 0F                 	MVI	C,0FH
  2252'   CD 210F'              	CALL	TFDOS		; open
  2255'   3C                    	INR	A
  2256'   CA 2323'              	JZ	ER_NOF
  2259'   CD 122C'              	CALL	GZONE		; the screen's top line, before anything moves
  225C'   CD 2147'              	CALL	EXSAVP
  225F'   3A 2DA4'              	LDA	SRNGF
  2262'   B7                    	ORA	A
  2263'   CA 227C'              	JZ	ER_NXT		; no line given: below the cursor's
  2266'   2A 2DA7'              	LHLD	SRNG2
  2269'   7C                    	MOV	A,H
  226A'   B5                    	ORA	L
  226B'   C2 2276'              	JNZ	ER_LN
  226E'   23                    	INX	H
  226F'   CD 119A'              	CALL	GOLN		; ':0r': above line 1 ...
  2272'   AF                    	XRA	A		;   which never wants a line end put in first
  2273'   C3 229E'              	JMP	ER_BRK
  2276'                         ER_LN:
  2276'   CD 213B'              	CALL	GOLNX
  2279'   C2 220A'              	JNZ	EXW_NL		; the text has no line N
  227C'                         ER_NXT:
  227C'   21 0001               	LXI	H,1
  227F'   AF                    	XRA	A
  2280'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2283'   CD 0A63'              	CALL	ATEOF
  2286'   3E 00                 	MVI	A,0
  2288'   D2 229E'              	JNC	ER_BRK		; text follows
  228B'   2A 0000*              	LHLD	GAPBEG
  228E'   EB                    	XCHG
  228F'   2A 0000*              	LHLD	TXTBEG
  2292'   CD 0000*              	CALL	CMP16
  2295'   3E 01                 	MVI	A,1
  2297'   CA 229E'              	JZ	ER_BRK		; nothing before the cursor either
  229A'   1B                    	DCX	D
  229B'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  229C'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  229E'                         ER_BRK:
  229E'   32 2DB4'              	STA	RDBRK
  22A1'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  22A4'   AF                    	XRA	A
  22A5'   32 2DB3'              	STA	RDANY
  22A8'                         ER_LP:
  22A8'   0E 14                 	MVI	C,14H
  22AA'   CD 210F'              	CALL	TFDOS		; the next record
  22AD'   B7                    	ORA	A
  22AE'   C2 22E1'              	JNZ	ER_END
  22B1'   21 0080               	LXI	H,CMDTAIL
  22B4'   0E 00                 	MVI	C,0
  22B6'                         ER_SC:				; C = its bytes, up to a ^Z
  22B6'   7E                    	MOV	A,M
  22B7'   FE 1A                 	CPI	CPMEOF
  22B9'   CA 22C1'              	JZ	ER_GOT
  22BC'   23                    	INX	H
  22BD'   0C                    	INR	C
  22BE'   F2 22B6'              	JP	ER_SC		; (minus: all 128)
  22C1'                         ER_GOT:
  22C1'   79                    	MOV	A,C
  22C2'   B7                    	ORA	A
  22C3'   CA 22E1'              	JZ	ER_END
  22C6'   C5                    	PUSH	B
  22C7'   3A 2DB3'              	LDA	RDANY
  22CA'   B7                    	ORA	A
  22CB'   CC 2312'              	CZ	ER_1ST
  22CE'   C1                    	POP	B
  22CF'   06 00                 	MVI	B,0
  22D1'   11 0080               	LXI	D,CMDTAIL
  22D4'   C5                    	PUSH	B
  22D5'   CD 0000*              	CALL	INSBLK
  22D8'   C1                    	POP	B
  22D9'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  22DC'   79                    	MOV	A,C
  22DD'   17                    	RAL
  22DE'   DA 22A8'              	JC	ER_LP		; a full record: there may be more
  22E1'                         ER_END:
  22E1'   3A 2DB3'              	LDA	RDANY
  22E4'   B7                    	ORA	A
  22E5'   CA 2303'              	JZ	ER_PL		; nothing in the file: nothing has changed
  22E8'   CD 0A63'              	CALL	ATEOF
  22EB'   DA 22F8'              	JC	ER_MD		; the text now ends as the file read ends
  22EE'   2A 0000*              	LHLD	GAPBEG
  22F1'   2B                    	DCX	H
  22F2'   7E                    	MOV	A,M
  22F3'   FE 0A                 	CPI	LF
  22F5'   C4 215F'              	CNZ	PUTBRK		; text follows: what was read ends a line
  22F8'                         ER_MD:
  22F8'   3E 01                 	MVI	A,1
  22FA'   32 2CE6'              	STA	MODF
  22FD'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2300'   CD 0000*              	CALL	GOTO
  2303'                         ER_PL:
  2303'   CD 0A63'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2306'   DC 0A69'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2309'   CD 0000*              	CALL	CLRCNT
  230C'   CD 1244'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  230F'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2312'                         ER_1ST:
  2312'   3C                    	INR	A
  2313'   32 2DB3'              	STA	RDANY
  2316'   3A 2DB4'              	LDA	RDBRK
  2319'   B7                    	ORA	A
  231A'   C4 215F'              	CNZ	PUTBRK
  231D'   21 2D86'              	LXI	H,MKPOS
  2320'   C3 0429'              	JMP	FPSTO
  2323'                         ER_NOF:
  2323'   21 2715'              	LXI	H,SNOPN
  2326'   C3 2594'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2329'                         WRCHK:
  2329'   3A 2D49'              	LDA	EXARG
  232C'   B7                    	ORA	A
  232D'   C2 2337'              	JNZ	WC_ARG
  2330'   CD 239A'              	CALL	OWNTF
  2333'   D8                    	RC
  2334'   C3 234C'              	JMP	WC_OWN
  2337'                         WC_ARG:
  2337'   CD 23B0'              	CALL	ISOWN
  233A'   CA 234C'              	JZ	WC_OWN
  233D'   3A 2D5B'              	LDA	EXBANG
  2340'   B7                    	ORA	A
  2341'   CA 234A'              	JZ	WC_OTH
  2344'   CD 0000*              	CALL	TEXIST
  2347'   C2 256D'              	JNZ	MSGEXI		; File exists (! to force)
  234A'                         WC_OTH:
  234A'   AF                    	XRA	A		; (NC)
  234B'   C9                    	RET
  234C'                         WC_OWN:
  234C'   3A 2D5C'              	LDA	ROFLAG		; '-R': this is the file it may not write
  234F'   B7                    	ORA	A
  2350'   CA 235A'              	JZ	WC_OK
  2353'   3A 2D5B'              	LDA	EXBANG
  2356'   B7                    	ORA	A
  2357'   C2 2573'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  235A'                         WC_OK:
  235A'   3E 01                 	MVI	A,1
  235C'   B7                    	ORA	A		; (NC)
  235D'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  235E'                         WRITE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  235E'   3A 2D4A'              	LDA	EXBAK
  2361'   CD 0000*              	CALL	WRTO
  2364'   3A 0001*              	LDA	FNAME+1
  2367'   FE 20                 	CPI	' '
  2369'   C2 2375'              	JNZ	WR_HAS
  236C'   21 0000*              	LXI	H,TFCB
  236F'   11 0000*              	LXI	D,FNAME
  2372'   CD 23C2'              	CALL	COPY12
  2375'                         WR_HAS:
  2375'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2377'   32 2D59'              	STA	MSGWHT
  237A'   CD 23B0'              	CALL	ISOWN
  237D'   C2 2387'              	JNZ	SRCTF
  2380'   AF                    	XRA	A
  2381'   32 2CE6'              	STA	MODF
  2384'   32 2D5A'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2387'                         SRCTF:
  2387'   21 0000*              	LXI	H,TFCB
  238A'   11 005C               	LXI	D,DFTFCB
  238D'   CD 23C2'              	CALL	COPY12
  2390'   AF                    	XRA	A
  2391'   06 04                 	MVI	B,4
  2393'                         SRC_Z:
  2393'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2394'   13                    	INX	D
  2395'   05                    	DCR	B
  2396'   C2 2393'              	JNZ	SRC_Z
  2399'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  239A'                         OWNTF:
  239A'   3A 0001*              	LDA	FNAME+1
  239D'   FE 20                 	CPI	' '
  239F'   CA 2567'              	JZ	MSGNFN
  23A2'   CD 23CD'              	CALL	TFCLR
  23A5'   21 0000*              	LXI	H,FNAME
  23A8'   11 0000*              	LXI	D,TFCB
  23AB'   CD 23C2'              	CALL	COPY12
  23AE'   B7                    	ORA	A		; (NC)
  23AF'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  23B0'                         ISOWN:
  23B0'   21 0000*              	LXI	H,TFCB
  23B3'   11 0000*              	LXI	D,FNAME
  23B6'   06 0C                 	MVI	B,12
  23B8'                         IO_LP:
  23B8'   1A                    	LDAX	D
  23B9'   BE                    	CMP	M
  23BA'   C0                    	RNZ
  23BB'   23                    	INX	H
  23BC'   13                    	INX	D
  23BD'   05                    	DCR	B
  23BE'   C2 23B8'              	JNZ	IO_LP
  23C1'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  23C2'                         COPY12:
  23C2'   06 0C                 	MVI	B,12
  23C4'                         CP_LP:
  23C4'   7E                    	MOV	A,M
  23C5'   12                    	STAX	D
  23C6'   23                    	INX	H
  23C7'   13                    	INX	D
  23C8'   05                    	DCR	B
  23C9'   C2 23C4'              	JNZ	CP_LP
  23CC'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  23CD'                         TFCLR:
  23CD'   11 0000*              	LXI	D,TFCB
  23D0'   06 24                 	MVI	B,36
  23D2'   AF                    	XRA	A
  23D3'                         TC_LP:
  23D3'   12                    	STAX	D
  23D4'   13                    	INX	D
  23D5'   05                    	DCR	B
  23D6'   C2 23D3'              	JNZ	TC_LP
  23D9'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  23DA'                         FOPEN:
  23DA'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  23DC'   32 2D59'              	STA	MSGWHT
  23DF'   21 005C               	LXI	H,DFTFCB
  23E2'   CD 24B0'              	CALL	NRMDRV
  23E5'   11 0000*              	LXI	D,FNAME
  23E8'   CD 23C2'              	CALL	COPY12
  23EB'   CD 0000*              	CALL	OPENZ
  23EE'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  23F1'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  23F3'   C8                    	RZ
  23F4'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  23F7'   32 2D5A'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  23FA'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  23FB'                         ARGSCN:
  23FB'   3A 0080               	LDA	CMDTAIL
  23FE'   47                    	MOV	B,A		; B = what is left of the line
  23FF'   B7                    	ORA	A
  2400'   C8                    	RZ
  2401'   21 0081               	LXI	H,CMDTAIL+1
  2404'                         AS_TOK:				; at a token, or the blanks before one
  2404'   7E                    	MOV	A,M
  2405'   FE 20                 	CPI	' '
  2407'   C2 2410'              	JNZ	AS_OPT
  240A'   23                    	INX	H
  240B'   05                    	DCR	B
  240C'   C2 2404'              	JNZ	AS_TOK
  240F'   C9                    	RET
  2410'                         AS_OPT:
  2410'   FE 2B                 	CPI	'+'
  2412'   CA 243C'              	JZ	AS_PLS
  2415'   FE 2D                 	CPI	'-'
  2417'   CA 242B'              	JZ	AS_SW
  241A'   FE 2F                 	CPI	'/'
  241C'   CA 242B'              	JZ	AS_SW
  241F'                         AS_SKP:				; not ours (the file name): on to the next one
  241F'   23                    	INX	H
  2420'   05                    	DCR	B
  2421'   C8                    	RZ
  2422'   7E                    	MOV	A,M
  2423'   FE 20                 	CPI	' '
  2425'   C2 241F'              	JNZ	AS_SKP
  2428'   C3 2404'              	JMP	AS_TOK
  242B'                         AS_SW:
  242B'   23                    	INX	H
  242C'   05                    	DCR	B
  242D'   C8                    	RZ
  242E'   7E                    	MOV	A,M
  242F'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2431'   FE 52                 	CPI	'R'
  2433'   C2 241F'              	JNZ	AS_SKP
  2436'   32 2D5C'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2439'   C3 241F'              	JMP	AS_SKP
  243C'                         AS_PLS:
  243C'   3E 01                 	MVI	A,1
  243E'   32 2D5D'              	STA	PLUSF		; '+' gets the line even with no number on it
  2441'   11 0000*              	LXI	D,PLUSB
  2444'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2446'   23                    	INX	H		;   line space, so it is taken as '+' alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2447'   05                    	DCR	B
  2448'   CA 247F'              	JZ	AS_PE
  244B'   7E                    	MOV	A,M
  244C'   FE 30                 	CPI	'0'
  244E'   C2 2466'              	JNZ	AS_PD
  2451'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2451'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2452'   05                    	DCR	B
  2453'   CA 2487'              	JZ	AS_P1
  2456'   7E                    	MOV	A,M
  2457'   FE 30                 	CPI	'0'
  2459'   CA 2451'              	JZ	AS_PZ
  245C'   FE 31                 	CPI	'1'
  245E'   DA 2487'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2461'   FE 3A                 	CPI	'9'+1
  2463'   D2 2487'              	JNC	AS_P1
  2466'                         AS_PD:				; the digits, as typed
  2466'   7E                    	MOV	A,M
  2467'   FE 30                 	CPI	'0'
  2469'   DA 247F'              	JC	AS_PE
  246C'   FE 3A                 	CPI	'9'+1
  246E'   D2 247F'              	JNC	AS_PE
  2471'   79                    	MOV	A,C
  2472'   B7                    	ORA	A
  2473'   CA 248E'              	JZ	AS_POV
  2476'   0D                    	DCR	C
  2477'   7E                    	MOV	A,M
  2478'   12                    	STAX	D
  2479'   13                    	INX	D
  247A'   23                    	INX	H
  247B'   05                    	DCR	B
  247C'   C2 2466'              	JNZ	AS_PD
  247F'                         AS_PE:
  247F'   AF                    	XRA	A
  2480'   12                    	STAX	D		; the digits end with a 0
  2481'   78                    	MOV	A,B
  2482'   B7                    	ORA	A
  2483'   C8                    	RZ
  2484'   C3 2404'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2487'                         AS_P1:
  2487'   3E 31                 	MVI	A,'1'
  2489'   12                    	STAX	D
  248A'   13                    	INX	D
  248B'   C3 247F'              	JMP	AS_PE
  248E'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  248E'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2491'   C3 247F'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2494'                         ARGGO:
  2494'   3A 2D5D'              	LDA	PLUSF
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2497'   B7                    	ORA	A
  2498'   C8                    	RZ
  2499'   21 0000*              	LXI	H,PLUSB
  249C'                         AG_LP:
  249C'   7E                    	MOV	A,M
  249D'   B7                    	ORA	A
  249E'   CA 24AB'              	JZ	AG_G
  24A1'   4F                    	MOV	C,A
  24A2'   E5                    	PUSH	H
  24A3'   CD 0023'              	CALL	VICMD
  24A6'   E1                    	POP	H
  24A7'   23                    	INX	H
  24A8'   C3 249C'              	JMP	AG_LP
  24AB'                         AG_G:
  24AB'   0E 47                 	MVI	C,'G'
  24AD'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  24B0'                         NRMDRV:
  24B0'   7E                    	MOV	A,M
  24B1'   B7                    	ORA	A
  24B2'   C0                    	RNZ
  24B3'   E5                    	PUSH	H
  24B4'   0E 19                 	MVI	C,BF_CURDSK
  24B6'   CD 0005               	CALL	BDOS
  24B9'   E1                    	POP	H
  24BA'   3C                    	INR	A
  24BB'   77                    	MOV	M,A
  24BC'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  24BD'                         PARSFN:
  24BD'   CD 23CD'              	CALL	TFCLR
  24C0'   11 0000*              	LXI	D,TFCB
  24C3'   23                    	INX	H
  24C4'   7E                    	MOV	A,M
  24C5'   2B                    	DCX	H
  24C6'   FE 3A                 	CPI	':'
  24C8'   C2 24DA'              	JNZ	PF_NM
  24CB'   CD 2520'              	CALL	GETFNC
  24CE'   CA 24DA'              	JZ	PF_NM
