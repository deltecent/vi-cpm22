  0870'   47                    	MOV	B,A
  0871'   3A 0000*              	LDA	NEDIT
  0874'   3D                    	DCR	A
  0875'   90                    	SUB	B
  0876'   5F                    	MOV	E,A
  0877'   16 00                 	MVI	D,0
  0879'   3A 0000*              	LDA	NEDIT
