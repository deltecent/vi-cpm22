                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
  0005                   C      MW_MEM	EQU	5		; out of memory: the key abandoned (MEMABT)
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
  0024                   C      SREPMX	EQU	EXMAX-4		; ':s' replacement -- bounded by the ex line
                         C      				;   itself, so SCOPY can never truncate a line
                         C      				;   anyone is able to type: the shortest
                         C      				;   substitute is 's' '/' + one pattern char +
                         C      				;   '/' before the replacement starts, and
                         C      				;   RDLINE stores at most EXMAX.  Tied to
                         C      				;   EXMAX rather than written out, so the two
                         C      				;   cannot drift apart.
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	BOL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	MEMABT				; out of room: the key goes (VI.MAC hooks it)
                                	EXTRN	ERRMSG				; BUF.MAC -- ... unless it cannot
                                	EXTRN	MLDRAW				; VI.MAC  -- the main loop's repaint
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	UNDML, UNDL0			; ... and whether one line changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDLK, UNDLC, UNDLL0		; ... or whole lines came or went
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                	EXTRN	SCNREC, SECBUF			; PAGE.MAC -- a record outside it, read
                                	EXTRN	BAKRDY, BAKPOS			; ... and the backup stack below it
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 0000*              	STA	BRKARM		;   one before it (BRKON)
  0004'   32 0000*              	STA	ABTFLG		; ... and MEMABT's repaint is behind it
  0007'   CD 00DA'              	CALL	DOTPRE
  000A'   CD 0010'              	CALL	CDMODE
  000D'   C3 011F'              	JMP	DOTPOST
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0010'                         CDMODE:
  0010'   3A 0000*              	LDA	EDMODE
  0013'   FE 01                 	CPI	EM_INS
  0015'   CA 0020'              	JZ	CD_INS
  0018'   FE 02                 	CPI	EM_REP
  001A'   CA 0023'              	JZ	CD_REP
  001D'   C3 0026'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0020'                         CD_INS:
  0020'   C3 20A5'              	JMP	VIINS
  0023'                         CD_REP:
  0023'   C3 1FDA'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0026'                         VICMD:
  0026'   79                    	MOV	A,C
  0027'   FE 1B                 	CPI	ESC
  0029'   CA 00AF'              	JZ	VIC_ESC
  002C'   3A 0000*              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 1B7D'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 0000*              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 0000*              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 0000*              	SHLD	CMDCNT
  0077'   C3 0855'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 0000*              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 0000*              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 0000*              	STA	GPEND
  0084'   3A 0000*              	LDA	PENDOP
  0087'   32 0000*              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 0000*              	STA	PENDOP
  008E'   3A 0000*              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 14C3'              	JNZ	OPPEND
  0095'   3A 0000*              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 3104'              	LXI	H,CMDTAB
  00A6'   C3 00BF'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 0855'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 0780'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ESC:
  00AF'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00B0'   32 0000*              	STA	GPEND
  00B3'   32 0000*              	STA	GSAVE
  00B6'   32 0000*              	STA	PENDOP
  00B9'   32 0000*              	STA	PSAVE
  00BC'   C3 00A9'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BF'                         VSCANQ:
  00BF'   CD 00CB'              	CALL	VSCLK
  00C2'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C5'   E9                    	PCHL
  00C6'                         VSCAN:
  00C6'   CD 00CB'              	CALL	VSCLK
  00C9'   C8                    	RZ			; miss
  00CA'   E9                    	PCHL
  00CB'                         VSCLK:
  00CB'   7E                    VSCAN1: MOV	A,M
  00CC'   B7                    	ORA	A
  00CD'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CE'   23                    	INX	H
  00CF'   B9                    	CMP	C
  00D0'   5E                    	MOV	E,M
  00D1'   23                    	INX	H
  00D2'   56                    	MOV	D,M
  00D3'   23                    	INX	H
  00D4'   C2 00CB'              	JNZ	VSCAN1
  00D7'   EB                    	XCHG			; HL = the handler
  00D8'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D9'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DA'                         DOTPRE:
  00DA'   3A 0000*              	LDA	DOTRPL
  00DD'   B7                    	ORA	A
  00DE'   C0                    	RNZ			; the replay's own keys are not recorded
  00DF'   C5                    	PUSH	B
  00E0'   D5                    	PUSH	D
  00E1'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E2'   3A 31C0'              	LDA	DOTSTA
  00E5'   B7                    	ORA	A
  00E6'   CA 00F9'              	JZ	DOTP1
  00E9'   AF                    	XRA	A		; a new command: the recording starts over
  00EA'   32 31C0'              	STA	DOTSTA
  00ED'   32 0000*              	STA	DOTOVF
  00F0'   21 0000*              	LXI	H,DOTSCR
  00F3'   22 31C1'              	SHLD	DOTSP
  00F6'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F9'                         DOTP1:
  00F9'   79                    	MOV	A,C
  00FA'   32 0000*              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FD'   47                    	MOV	B,A
  00FE'   2A 31C1'              	LHLD	DOTSP
  0101'   EB                    	XCHG
  0102'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0105'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0108'   D2 0117'              	JNC	DOTPOV
  010B'   2A 31C1'              	LHLD	DOTSP
  010E'   70                    	MOV	M,B
  010F'   23                    	INX	H
  0110'   22 31C1'              	SHLD	DOTSP
  0113'                         DOTPX:
  0113'   E1                    	POP	H
  0114'   D1                    	POP	D
  0115'   C1                    	POP	B
  0116'   C9                    	RET
  0117'                         DOTPOV:
  0117'   3E 01                 	MVI	A,1
  0119'   32 0000*              	STA	DOTOVF		; too long to record: give this recording up
  011C'   C3 0113'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011F'                         DOTPOST:
  011F'   3A 0000*              	LDA	DOTRPL
  0122'   B7                    	ORA	A
  0123'   C0                    	RNZ
  0124'   3A 0000*              	LDA	EDMODE
  0127'   B7                    	ORA	A
  0128'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0129'   3A 0000*              	LDA	GPEND
  012C'   B7                    	ORA	A
  012D'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012E'   3A 0000*              	LDA	PENDOP
  0131'   B7                    	ORA	A
  0132'   C0                    	RNZ			; an operator still waiting for its motion
  0133'   2A 0000*              	LHLD	CMDCNT
  0136'   7C                    	MOV	A,H
  0137'   B5                    	ORA	L
  0138'   CA 0146'              	JZ	DOTQ1
  013B'   3A 0000*              	LDA	DOTLK		; a digit with the count still up: the command
  013E'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0140'   DA 0146'              	JC	DOTQ1
  0143'   FE 3A                 	CPI	'9'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0145'   D8                    	RC
  0146'                         DOTQ1:
  0146'   3E 01                 	MVI	A,1
  0148'   32 31C0'              	STA	DOTSTA		; the next key starts a new recording
  014B'   3A 0000*              	LDA	DOTCHG
  014E'   B7                    	ORA	A
  014F'   C8                    	RZ			; changed nothing: not a repeatable command
  0150'   AF                    	XRA	A
  0151'   32 0000*              	STA	DOTCHG
  0154'   32 0000*              	STA	DOTLEN
  0157'   3A 0000*              	LDA	DOTOVF
  015A'   B7                    	ORA	A
  015B'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  015C'   2A 31C1'              	LHLD	DOTSP
  015F'   11 0000*              	LXI	D,DOTSCR
  0162'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0165'   7D                    	MOV	A,L
  0166'   32 0000*              	STA	DOTLEN
  0169'   B7                    	ORA	A
  016A'   C8                    	RZ
  016B'   4F                    	MOV	C,A
  016C'   06 00                 	MVI	B,0
  016E'   21 0000*              	LXI	H,DOTSCR
  0171'   11 0000*              	LXI	D,DOTBUF
  0174'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0177'                         MARKMOD:
  0177'   3E 01                 	MVI	A,1
  0179'   32 0000*              	STA	MODF
  017C'   32 0000*              	STA	DOTCHG
  017F'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0180'                         VC_DOT:
  0180'   2A 0000*              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0183'   22 0000*              	SHLD	DOTNCT
  0186'   21 0000               	LXI	H,0
  0189'   22 0000*              	SHLD	CMDCNT
  018C'   3A 0000*              	LDA	DOTLEN
  018F'   B7                    	ORA	A
  0190'   CA 01DF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0193'   AF                    	XRA	A
  0194'   32 0000*              	STA	DOTIX
  0197'   2A 0000*              	LHLD	DOTNCT
  019A'   7C                    	MOV	A,H
  019B'   B5                    	ORA	L
  019C'   CA 01BC'              	JZ	DOTGO
  019F'   22 0000*              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01A2'                         DOTSKP:
  01A2'   CD 05FB'              	CALL	DOTGET		; ... so step past the digits it recorded
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A5'   DA 01BC'              	JC	DOTGO
  01A8'   FE 30                 	CPI	'0'
  01AA'   DA 01BC'              	JC	DOTGO
  01AD'   FE 3A                 	CPI	'9'+1
  01AF'   D2 01BC'              	JNC	DOTGO
  01B2'   3A 0000*              	LDA	DOTIX
  01B5'   3C                    	INR	A
  01B6'   32 0000*              	STA	DOTIX
  01B9'   C3 01A2'              	JMP	DOTSKP
  01BC'                         DOTGO:
  01BC'   3E 01                 	MVI	A,1
  01BE'   32 0000*              	STA	DOTRPL
  01C1'                         DOTLP:
  01C1'   CD 05FB'              	CALL	DOTGET
  01C4'   DA 01D5'              	JC	DOTDN
  01C7'   4F                    	MOV	C,A
  01C8'   3A 0000*              	LDA	DOTIX
  01CB'   3C                    	INR	A
  01CC'   32 0000*              	STA	DOTIX
  01CF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01D2'   C3 01C1'              	JMP	DOTLP
  01D5'                         DOTDN:
  01D5'   AF                    	XRA	A
  01D6'   32 0000*              	STA	DOTRPL
  01D9'   32 0000*              	STA	DOTCHG		; the '.' is not itself the new last change
  01DC'   C3 0892'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DF'                         DOTBEL:
  01DF'   0E 07                 	MVI	C,BEL
  01E1'   CD 0000*              	CALL	BCONOU
  01E4'   C3 0855'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E7'                         MKVAD:
  01E7'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01E9'   59                    	MOV	E,C
  01EA'   21 0000*              	LXI	H,MKVAL
  01ED'   19                    	DAD	D
  01EE'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EF'                         MKCLR:
  01EF'   21 0000*              	LXI	H,MKVAL
  01F2'   06 03                 	MVI	B,MKMAX
  01F4'   AF                    	XRA	A
  01F5'                         MKC_LP:
  01F5'   77                    	MOV	M,A
  01F6'   23                    	INX	H
  01F7'   05                    	DCR	B
  01F8'   C2 01F5'              	JNZ	MKC_LP
  01FB'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01FC'                         MKGETK:
  01FC'   3A 0000*              	LDA	DOTRPL
  01FF'   B7                    	ORA	A
  0200'   CA 0211'              	JZ	MKG_KB
  0203'   CD 05FB'              	CALL	DOTGET		; the recording's next key
  0206'   D8                    	RC
  0207'   4F                    	MOV	C,A
  0208'   3A 0000*              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  020B'   3C                    	INR	A
  020C'   32 0000*              	STA	DOTIX
  020F'   B7                    	ORA	A		; CY clear
  0210'   C9                    	RET
  0211'                         MKG_KB:
  0211'   CD 0000*              	CALL	GETKEY
  0214'   FE 1B                 	CPI	ESC
  0216'   37                    	STC
  0217'   C8                    	RZ			; ESC cancels the command
  0218'   CD 00DA'              	CALL	DOTPRE		; C kept
  021B'   B7                    	ORA	A		; CY clear
  021C'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021D'                         VC_FF:				; 'f' -- forward, onto the character
  021D'   3E 66                 	MVI	A,'f'
  021F'   C3 022E'              	JMP	FNDNEW
  0222'                         VC_FB:				; 'F' -- backward, onto it
  0222'   3E 46                 	MVI	A,'F'
  0224'   C3 022E'              	JMP	FNDNEW
  0227'                         VC_TF:				; 't' -- forward, up to it
  0227'   3E 74                 	MVI	A,'t'
  0229'   C3 022E'              	JMP	FNDNEW
  022C'                         VC_TB:				; 'T' -- backward, up to it
  022C'   3E 54                 	MVI	A,'T'
  022E'                         FNDNEW:
  022E'   32 0000*              	STA	FNDKND		; the find ';' and ',' will repeat
  0231'   CD 01FC'              	CALL	MKGETK		; the character it looks for
  0234'   DA 0266'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0237'   79                    	MOV	A,C
  0238'   32 0000*              	STA	FNDCH
  023B'   3A 0000*              	LDA	FNDKND
  023E'   06 01                 	MVI	B,1		; a find starts at the next character along
  0240'   C3 026D'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0243'                         VC_SEMI:
  0243'   3A 0000*              	LDA	FNDKND
  0246'   B7                    	ORA	A
  0247'   CA 0266'              	JZ	FNDNIL		; nothing has been looked for yet
  024A'   C3 0256'              	JMP	FNDREP
  024D'                         VC_COMMA:
  024D'   3A 0000*              	LDA	FNDKND
  0250'   B7                    	ORA	A
  0251'   CA 0266'              	JZ	FNDNIL
  0254'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0256'                         FNDREP:
  0256'   06 01                 	MVI	B,1
  0258'   F5                    	PUSH	PSW
  0259'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  025B'   FE 54                 	CPI	'T'
  025D'   C2 0262'              	JNZ	FNDR_GO
  0260'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0262'                         FNDR_GO:
  0262'   F1                    	POP	PSW
  0263'   C3 026D'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0266'                         FNDNIL:
  0266'   AF                    	XRA	A
  0267'   32 0000*              	STA	PSAVE
  026A'   C3 0855'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026D'                         FNDGO:
  026D'   32 0000*              	STA	FNDRUN
  0270'   78                    	MOV	A,B
  0271'   32 0000*              	STA	FNDSTP
  0274'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0277'   22 0000*              	SHLD	FNDN		; the occurrence wanted
  027A'   CD 0000*              	CALL	CUROFF
  027D'   22 0000*              	SHLD	FNDCUR
  0280'   3A 0000*              	LDA	FNDRUN
  0283'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0285'   CA 02B9'              	JZ	FNDBWD
  0288'   2A 0000*              	LHLD	FNDCUR
  028B'   CD 0721'              	CALL	EOLC		; HL = the line's last content character
  028E'   22 0000*              	SHLD	FNDLIM
  0291'   2A 0000*              	LHLD	FNDCUR
  0294'   3A 0000*              	LDA	FNDSTP
  0297'   5F                    	MOV	E,A
  0298'   16 00                 	MVI	D,0
  029A'   19                    	DAD	D		; HL = where the scan starts
  029B'                         FNDF_LP:
  029B'   EB                    	XCHG			; DE = the scan
  029C'   2A 0000*              	LHLD	FNDLIM
  029F'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02A2'   EB                    	XCHG			; HL = the scan
  02A3'   CA 02A9'              	JZ	FNDF_AT		; the last character is still a candidate
  02A6'   D2 030B'              	JNC	FNDMIS		; past it: not on this line
  02A9'                         FNDF_AT:
  02A9'   CD 0312'              	CALL	FNDSEE		; Z iff this is the character
  02AC'   C2 02B5'              	JNZ	FNDF_NX
  02AF'   CD 031D'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02B2'   CA 02F1'              	JZ	FNDHIT
  02B5'                         FNDF_NX:
  02B5'   23                    	INX	H
  02B6'   C3 029B'              	JMP	FNDF_LP
  02B9'                         FNDBWD:
  02B9'   2A 0000*              	LHLD	FNDCUR
  02BC'   CD 067B'              	CALL	BOL		; HL = the line's first character
  02BF'   22 0000*              	SHLD	FNDLIM
  02C2'   2A 0000*              	LHLD	FNDCUR
  02C5'   3A 0000*              	LDA	FNDSTP
  02C8'   2F                    	CMA
  02C9'   5F                    	MOV	E,A
  02CA'   16 FF                 	MVI	D,0FFH
  02CC'   13                    	INX	D		; DE = -step
  02CD'   19                    	DAD	D		; HL = where the scan starts
  02CE'   D2 030B'              	JNC	FNDMIS		; ... off the front of the text altogether
  02D1'                         FNDB_LP:
  02D1'   EB                    	XCHG			; DE = the scan
  02D2'   2A 0000*              	LHLD	FNDLIM
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D5'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D8'   EB                    	XCHG			; HL = the scan
  02D9'   DA 030B'              	JC	FNDMIS		; before this line: not on it
  02DC'   CD 0312'              	CALL	FNDSEE
  02DF'   C2 02E8'              	JNZ	FNDB_NX
  02E2'   CD 031D'              	CALL	FNDCNT
  02E5'   CA 02F1'              	JZ	FNDHIT
  02E8'                         FNDB_NX:
  02E8'   7C                    	MOV	A,H
  02E9'   B5                    	ORA	L
  02EA'   CA 030B'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02ED'   2B                    	DCX	H
  02EE'   C3 02D1'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02F1'                         FNDHIT:
  02F1'   3A 0000*              	LDA	FNDRUN
  02F4'   E6 5F                 	ANI	5FH
  02F6'   FE 54                 	CPI	'T'
  02F8'   C2 0308'              	JNZ	FNDLND
  02FB'   3A 0000*              	LDA	FNDRUN
  02FE'   E6 20                 	ANI	20H
  0300'   CA 0307'              	JZ	FNDH_BW
  0303'   2B                    	DCX	H		; forward 't': the character before it
  0304'   C3 0308'              	JMP	FNDLND
  0307'                         FNDH_BW:
  0307'   23                    	INX	H		; backward 'T': the character after it
  0308'                         FNDLND:
  0308'   C3 0611'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  030B'                         FNDMIS:
  030B'   AF                    	XRA	A
  030C'   32 0000*              	STA	PSAVE
  030F'   C3 01DF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0312'                         FNDSEE:
  0312'   E5                    	PUSH	H
  0313'   CD 0000*              	CALL	CHARAT
  0316'   E1                    	POP	H
  0317'   47                    	MOV	B,A
  0318'   3A 0000*              	LDA	FNDCH
  031B'   B8                    	CMP	B
  031C'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031D'                         FNDCNT:
  031D'   E5                    	PUSH	H
  031E'   2A 0000*              	LHLD	FNDN
  0321'   2B                    	DCX	H
  0322'   22 0000*              	SHLD	FNDN
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0325'   7C                    	MOV	A,H
  0326'   B5                    	ORA	L
  0327'   E1                    	POP	H
  0328'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0329'                         ISFIND:
  0329'   E6 5F                 	ANI	5FH		; fold the case away
  032B'   FE 46                 	CPI	'F'
  032D'   C8                    	RZ
  032E'   FE 54                 	CPI	'T'
  0330'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0331'                         VC_MK:
  0331'   3E 04                 	MVI	A,PM
  0333'   C3 033D'              	JMP	MKGO
  0336'                         VC_BQ:
  0336'   3E 05                 	MVI	A,PJ
  0338'   C3 033D'              	JMP	MKGO
  033B'                         VC_AQ:
  033B'   3E 06                 	MVI	A,PJL
  033D'                         MKGO:
  033D'   32 0000*              	STA	MKWHAT
  0340'   CD 076D'              	CALL	MOVCNT		; a count means nothing on any of the three
  0343'   CD 01FC'              	CALL	MKGETK		; the key that names the mark
  0346'   DA 0425'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0349'                         MKOP:
  0349'   79                    	MOV	A,C
  034A'   D6 61                 	SUI	'a'
  034C'   FE 03                 	CPI	MKMAX
  034E'   D2 041D'              	JNC	MKNOLT		; not a mark letter
  0351'   4F                    	MOV	C,A		; C = the mark's index
  0352'   87                    	ADD	A
  0353'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0354'   5F                    	MOV	E,A
  0355'   16 00                 	MVI	D,0
  0357'   21 0000*              	LXI	H,MKTAB
  035A'   19                    	DAD	D		; HL -> this mark's slot
  035B'   3A 0000*              	LDA	MKWHAT
  035E'   FE 04                 	CPI	PM
  0360'   CA 0438'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0363'                         MKJMP:
  0363'   E5                    	PUSH	H
  0364'   CD 01E7'              	CALL	MKVAD
  0367'   7E                    	MOV	A,M
  0368'   E1                    	POP	H
  0369'   B7                    	ORA	A
  036A'   CA 0413'              	JZ	MKNSET		; never set
  036D'   CD 03DF'              	CALL	MKLOAD		; the file position it holds
  0370'   CD 03EC'              	CALL	MKWIN
  0373'   DA 038A'              	JC	MKJ_GO		; in the window: any command may go there
  0376'   3A 0000*              	LDA	PSAVE
  0379'   B7                    	ORA	A
  037A'   CA 038A'              	JZ	MKJ_GO
  037D'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037F'   C2 0425'              	JNZ	MKBAD
  0382'   3A 0000*              	LDA	MKWHAT
  0385'   FE 06                 	CPI	PJL
  0387'   C2 0425'              	JNZ	MKBAD
  038A'                         MKJ_GO:
  038A'   CD 13D4'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038D'   CD 07A9'              	CALL	BRKON		; ... and an ESC may stop it from here on
  0390'   CD 03AC'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0393'   CD 07E6'              	CALL	BRKOFF		; (A only)
  0396'   DA 07FE'              	JC	BRKBAK
  0399'   3A 0000*              	LDA	MKWHAT
  039C'   FE 06                 	CPI	PJL
  039E'   CA 03A6'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03A1'   3E 01                 	MVI	A,1		;   non-blank
  03A3'   32 0000*              	STA	GPKEEP		; '`': land on the column it was set at
  03A6'                         MKJ_LN:
  03A6'   CD 0000*              	CALL	GOTO
  03A9'   C3 13EC'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03AC'                         MKPAGE:
  03AC'   CD 03EC'              	CALL	MKWIN
  03AF'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03B2'   32 0000*              	STA	DIRFLG
  03B5'   21 FFFF               	LXI	H,0FFFFH
  03B8'   22 0000*              	SHLD	CMDCNT
  03BB'   CD 0000*              	CALL	GOLINE
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03BE'   CD 0000*              	CALL	SCRLST
  03C1'   CD 0795'              	CALL	CNTTST
  03C4'   C2 03AC'              	JNZ	MKPAGE
  03C7'   CD 03EC'              	CALL	MKWIN		; the file ran out: that was its last step
  03CA'   DA 0000*              	JC	CLRCNT
  03CD'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03D0'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03D3'                         BACKTO:
  03D3'   CD 03DF'              	CALL	MKLOAD
  03D6'   CD 0000*              	CALL	CLRCNT
  03D9'   CD 03AC'              	CALL	MKPAGE
  03DC'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DF'                         MKLOAD:
  03DF'   5E                    	MOV	E,M
  03E0'   23                    	INX	H
  03E1'   56                    	MOV	D,M
  03E2'   23                    	INX	H
  03E3'   7E                    	MOV	A,M
  03E4'   EB                    	XCHG
  03E5'   22 0000*              	SHLD	MKPOS
  03E8'   32 0002*              	STA	MKPOS+2
  03EB'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03EC'                         MKWIN:
  03EC'   2A 0000*              	LHLD	TXTBEG
  03EF'   CD 138E'              	CALL	FPOS
  03F2'   EB                    	XCHG
  03F3'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F4'   2A 0000*              	LHLD	MKPOS
  03F7'   3A 0002*              	LDA	MKPOS+2
  03FA'   CD 1381'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FD'   DA 040F'              	JC	MKW_BK		; above it
  0400'   C2 040D'              	JNZ	MKW_FW		; 64K or more below it
  0403'   E5                    	PUSH	H
  0404'   CD 0000*              	CALL	LOGLEN
  0407'   D1                    	POP	D
  0408'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  040B'   EB                    	XCHG
  040C'   D8                    	RC			; inside
  040D'                         MKW_FW:
  040D'   AF                    	XRA	A
  040E'   C9                    	RET
  040F'                         MKW_BK:
  040F'   3E FF                 	MVI	A,0FFH
  0411'   B7                    	ORA	A
  0412'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0413'                         MKNSET:
  0413'   AF                    	XRA	A
  0414'   32 0000*              	STA	PSAVE
  0417'   21 2955'              	LXI	H,SMKNS
  041A'   C3 281A'              	JMP	EXERR
  041D'                         MKNOLT:
  041D'   3A 0000*              	LDA	MKWHAT
  0420'   FE 04                 	CPI	PM
  0422'   C2 0413'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0425'                         MKBAD:
  0425'   AF                    	XRA	A
  0426'   32 0000*              	STA	PSAVE
  0429'   C3 01DF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  042C'                         FPSTO:
  042C'   E5                    	PUSH	H
  042D'   CD 138B'              	CALL	CURFP		; A:HL = the cursor's file position
  0430'   EB                    	XCHG
  0431'   E1                    	POP	H
  0432'   73                    	MOV	M,E
  0433'   23                    	INX	H
  0434'   72                    	MOV	M,D
  0435'   23                    	INX	H
  0436'   77                    	MOV	M,A
  0437'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0438'                         MKSET:
  0438'   CD 042C'              	CALL	FPSTO
  043B'   CD 01E7'              	CALL	MKVAD
  043E'   36 01                 	MVI	M,1		; ... and the mark is live
  0440'   C3 0855'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0443'                         MKSNAP:
  0443'   C5                    	PUSH	B
  0444'   E5                    	PUSH	H
  0445'   21 0000*              	LXI	H,MKTAB
  0448'   11 0000*              	LXI	D,MKUND
  044B'   CD 263D'              	CALL	COPY12
  044E'   21 0000*              	LXI	H,MKVAL
  0451'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0454'   06 03                 	MVI	B,MKMAX
  0456'                         MSN_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0456'   7E                    	MOV	A,M
  0457'   12                    	STAX	D
  0458'   23                    	INX	H
  0459'   13                    	INX	D
  045A'   13                    	INX	D
  045B'   13                    	INX	D
  045C'   13                    	INX	D
  045D'   05                    	DCR	B
  045E'   C2 0456'              	JNZ	MSN_LP
  0461'   E1                    	POP	H
  0462'   C1                    	POP	B
  0463'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0464'                         MKREST:
  0464'   0E 02                 	MVI	C,MKMAX-1
  0466'                         MRS_LP:
  0466'   79                    	MOV	A,C
  0467'   87                    	ADD	A
  0468'   87                    	ADD	A
  0469'   5F                    	MOV	E,A
  046A'   16 00                 	MVI	D,0
  046C'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046F'   19                    	DAD	D
  0470'   7E                    	MOV	A,M
  0471'   B7                    	ORA	A
  0472'   CA 048E'              	JZ	MRS_NX		; it was not set then
  0475'   2B                    	DCX	H
  0476'   2B                    	DCX	H
  0477'   2B                    	DCX	H
  0478'   E5                    	PUSH	H
  0479'   21 0000*              	LXI	H,MKTAB
  047C'   19                    	DAD	D
  047D'   EB                    	XCHG			; DE -> the mark
  047E'   E1                    	POP	H		; HL -> its copy
  047F'   06 03                 	MVI	B,MKSIZ-1
  0481'                         MRS_CP:
  0481'   7E                    	MOV	A,M
  0482'   12                    	STAX	D
  0483'   23                    	INX	H
  0484'   13                    	INX	D
  0485'   05                    	DCR	B
  0486'   C2 0481'              	JNZ	MRS_CP
  0489'   CD 01E7'              	CALL	MKVAD
  048C'   36 01                 	MVI	M,1
  048E'                         MRS_NX:
  048E'   0D                    	DCR	C
  048F'   F2 0466'              	JP	MRS_LP
  0492'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0493'                         MKSHFT:
  0493'   32 0000*              	STA	MKTYP
  0496'   3A 0000*              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0499'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  049A'   C0                    	RNZ			;   every mark points into is still there
  049B'   3A 0000*              	LDA	UNDRPL
  049E'   B7                    	ORA	A
  049F'   C2 04A9'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  04A2'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A5'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A6'   C4 0443'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A9'                         MKS_GO:
  04A9'   C5                    	PUSH	B
  04AA'   50                    	MOV	D,B
  04AB'   59                    	MOV	E,C
  04AC'   EB                    	XCHG
  04AD'   22 0000*              	SHLD	MKN		; the edit's length
  04B0'   D5                    	PUSH	D		; ... and its offset
  04B1'   CD 0000*              	CALL	CUROFF
  04B4'   D1                    	POP	D
  04B5'   CD 0000*              	CALL	SUBHD
  04B8'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B9'   CD 138B'              	CALL	CURFP		; A:HL = the cursor's file position
  04BC'   06 00                 	MVI	B,0
  04BE'   CD 1381'              	CALL	SUB24
  04C1'   22 0000*              	SHLD	MKEDIT
  04C4'   32 0002*              	STA	MKEDIT+2	; where in the file the edit is
  04C7'   21 0000*              	LXI	H,MKVAL
  04CA'   11 0000*              	LXI	D,MKTAB
  04CD'   06 03                 	MVI	B,MKMAX
  04CF'                         MKS_LP:
  04CF'   7E                    	MOV	A,M
  04D0'   B7                    	ORA	A
  04D1'   CA 053D'              	JZ	MKS_N0		; that mark is not set
  04D4'   E5                    	PUSH	H
  04D5'   C5                    	PUSH	B
  04D6'   21 0000*              	LXI	H,MKEDIT
  04D9'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04DA'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04DB'   4F                    	MOV	C,A
  04DC'   13                    	INX	D
  04DD'   23                    	INX	H
  04DE'   1A                    	LDAX	D
  04DF'   9E                    	SBB	M
  04E0'   47                    	MOV	B,A
  04E1'   13                    	INX	D
  04E2'   23                    	INX	H
  04E3'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04E4'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E5'   DA 0538'              	JC	MKS_PP		; before it: nothing moves
  04E8'   6F                    	MOV	L,A
  04E9'   3A 0000*              	LDA	MKTYP
  04EC'   3D                    	DCR	A
  04ED'   CA 0512'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04F0'   7D                    	MOV	A,L
  04F1'   2A 0000*              	LHLD	MKN
  04F4'   B7                    	ORA	A
  04F5'   C2 0501'              	JNZ	MKS_DL		; 64K or more past it
  04F8'   79                    	MOV	A,C
  04F9'   95                    	SUB	L
  04FA'   78                    	MOV	A,B
  04FB'   9C                    	SBB	H
  04FC'   D2 0501'              	JNC	MKS_DL		; past the end of what goes
  04FF'   60                    	MOV	H,B
  0500'   69                    	MOV	L,C		; inside it: close up to the edit
  0501'                         MKS_DL:
  0501'   1B                    	DCX	D
  0502'   1B                    	DCX	D
  0503'   1A                    	LDAX	D
  0504'   95                    	SUB	L
  0505'   12                    	STAX	D
  0506'   13                    	INX	D
  0507'   1A                    	LDAX	D
  0508'   9C                    	SBB	H
  0509'   12                    	STAX	D
  050A'   13                    	INX	D
  050B'   1A                    	LDAX	D
  050C'   DE 00                 	SBI	0
  050E'   12                    	STAX	D
  050F'   C3 0538'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  0512'                         MKS_IN:
  0512'   7D                    	MOV	A,L
  0513'   B0                    	ORA	B
  0514'   B1                    	ORA	C
  0515'   C2 0527'              	JNZ	MKS_AD		; the mark is past it
  0518'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  051B'   2B                    	DCX	H
  051C'   7E                    	MOV	A,M		; the last byte that went in
  051D'   FE 0A                 	CPI	LF
  051F'   CA 0527'              	JZ	MKS_AD
  0522'   FE 0D                 	CPI	CR
  0524'   C2 0538'              	JNZ	MKS_PP
  0527'                         MKS_AD:
  0527'   2A 0000*              	LHLD	MKN
  052A'   1B                    	DCX	D
  052B'   1B                    	DCX	D
  052C'   1A                    	LDAX	D
  052D'   85                    	ADD	L
  052E'   12                    	STAX	D
  052F'   13                    	INX	D
  0530'   1A                    	LDAX	D
  0531'   8C                    	ADC	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0532'   12                    	STAX	D
  0533'   13                    	INX	D
  0534'   1A                    	LDAX	D
  0535'   CE 00                 	ACI	0
  0537'   12                    	STAX	D
  0538'                         MKS_PP:
  0538'   C1                    	POP	B
  0539'   E1                    	POP	H
  053A'   C3 053F'              	JMP	MKS_NX
  053D'                         MKS_N0:
  053D'   13                    	INX	D
  053E'   13                    	INX	D
  053F'                         MKS_NX:
  053F'   13                    	INX	D
  0540'   13                    	INX	D
  0541'   23                    	INX	H
  0542'   05                    	DCR	B
  0543'   C2 04CF'              	JNZ	MKS_LP
  0546'   C1                    	POP	B
  0547'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0548'                         VC_UNDO:
  0548'   21 0000               	LXI	H,0
  054B'   22 0000*              	SHLD	CMDCNT
  054E'   CD 0000*              	CALL	UNDO
  0551'   DA 05DE'              	JC	UNDNO
  0554'   3A 0000*              	LDA	UNDST
  0557'   FE 02                 	CPI	2
  0559'   CC 0464'              	CZ	MKREST		; undone (not redone): the marks go back too
  055C'   2A 0000*              	LHLD	UNDCUR
  055F'   CD 05C4'              	CALL	UCLAMP		; vi never sits on a line terminator
  0562'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0565'   3E 01                 	MVI	A,1
  0567'   32 0000*              	STA	MODF		; undone past a ':w' still differs from the file
  056A'   CD 0A0D'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056D'   3A 0000*              	LDA	UNDML		; every step on one line, no line end among
  0570'   B7                    	ORA	A		;   them, and the cursor back on that line:
  0571'   C2 0589'              	JNZ	VU_LNS		;   the line is the repaint -- all of it, the
  0574'   2A 0000*              	LHLD	UNDL0		;   cursor need not be where the change began.
  0577'   EB                    	XCHG			;   Anything else, and whole spans moved:
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0578'   2A 0000*              	LHLD	LNDLT		;   repaint rather than guess
  057B'   CD 0000*              	CALL	CMP16
  057E'   C2 0892'              	JNZ	SETFUL
  0581'   3E 01                 	MVI	A,1
  0583'   32 0000*              	STA	LNALL
  0586'   C3 085B'              	JMP	SETLIN
                                
                                ;VU_LNS -- more than a line changed.  Whole lines put back, the cursor on the
                                ; first of them, are rows opened there as a put opens them (R_ILIN; SCDRAW
                                ; wants them at the line the cursor was on or right under it).  One whole
                                ; line taken from under the cursor is 'dd' (R_DLIN), whether the next comes
                                ; up into its place or the cursor goes to the line over it.  Anything else
                                ; is the screen.
  0589'                         VU_LNS:
  0589'   CD 0892'              	CALL	SETFUL
  058C'   3A 0000*              	LDA	UNDLC
  058F'   B7                    	ORA	A
  0590'   C8                    	RZ
  0591'   47                    	MOV	B,A
  0592'   2A 0000*              	LHLD	UNDLL0
  0595'   EB                    	XCHG
  0596'   2A 0000*              	LHLD	LNDLT		; DE = where the lines start, HL = the cursor
  0599'   3A 0000*              	LDA	UNDLK
  059C'   FE 01                 	CPI	1
  059E'   CA 05B8'              	JZ	VU_IN
  05A1'   FE 02                 	CPI	2
  05A3'   C0                    	RNZ
  05A4'   05                    	DCR	B
  05A5'   C0                    	RNZ
  05A6'   7A                    	MOV	A,D
  05A7'   B3                    	ORA	E
  05A8'   C0                    	RNZ			; (not the line the cursor was on)
  05A9'   7C                    	MOV	A,H
  05AA'   B5                    	ORA	L
  05AB'   CA 05B2'              	JZ	VU_DL
  05AE'   23                    	INX	H		; ... or the cursor went onto the line over it:
  05AF'   7C                    	MOV	A,H		;   a line put under the cursor's, or opened
  05B0'   B5                    	ORA	L		;   there, and taken back
  05B1'   C0                    	RNZ
  05B2'                         VU_DL:
  05B2'   3E 03                 	MVI	A,R_DLIN
  05B4'   32 0000*              	STA	RINTENT
  05B7'   C9                    	RET
  05B8'                         VU_IN:
  05B8'   CD 0000*              	CALL	CMP16
  05BB'   C0                    	RNZ
  05BC'   CD 087D'              	CALL	SETILN
  05BF'   78                    	MOV	A,B
  05C0'   32 31BC'              	STA	ILN
  05C3'   C9                    	RET
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  05C4'                         UCLAMP:
  05C4'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C5'   CD 19CF'              	CALL	CEND		; HL = the line's content end
  05C8'   D1                    	POP	D		; DE = the offset wanted
  05C9'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  05CC'   D2 05D1'              	JNC	UCL_BK
  05CF'   EB                    	XCHG
  05D0'   C9                    	RET
  05D1'                         UCL_BK:
  05D1'   E5                    	PUSH	H		; the content end
  05D2'   EB                    	XCHG			; HL = the offset wanted
  05D3'   CD 067B'              	CALL	BOL
  05D6'   D1                    	POP	D		; DE = the content end, HL = the line's start
  05D7'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  05DA'   EB                    	XCHG			; HL = the content end
  05DB'   C8                    	RZ
  05DC'   2B                    	DCX	H		; ... its last character
  05DD'   C9                    	RET
  05DE'                         UNDNO:
  05DE'   3A 0000*              	LDA	UNDWHY
  05E1'   B7                    	ORA	A
  05E2'   CA 05F3'              	JZ	UNDBEL
  05E5'   21 28EF'              	LXI	H,SUNDW		; the change has paged away: say so
  05E8'   FE 01                 	CPI	1
  05EA'   CA 281A'              	JZ	EXERR
  05ED'   21 2911'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  05F0'   C3 281A'              	JMP	EXERR
  05F3'                         UNDBEL:
  05F3'   0E 07                 	MVI	C,BEL
  05F5'   CD 0000*              	CALL	BCONOU
  05F8'   C3 0855'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05FB'                         DOTGET:
  05FB'   3A 0000*              	LDA	DOTIX
  05FE'   5F                    	MOV	E,A
  05FF'   3A 0000*              	LDA	DOTLEN
  0602'   BB                    	CMP	E
  0603'   CA 060F'              	JZ	DOTGEF
  0606'   16 00                 	MVI	D,0
  0608'   21 0000*              	LXI	H,DOTBUF
  060B'   19                    	DAD	D
  060C'   7E                    	MOV	A,M
  060D'   B7                    	ORA	A		; CY clear: a key was returned
  060E'   C9                    	RET
  060F'                         DOTGEF:
  060F'   37                    	STC
  0610'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0611'                         GOSET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0611'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0614'                         SETGL:
  0614'   CD 13AE'              	CALL	ZSAVE
  0617'   21 0000               	LXI	H,0
  061A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  061D'   E5                    	PUSH	H
  061E'   CD 13C1'              	CALL	ZREST
  0621'   E1                    	POP	H
  0622'   E5                    	PUSH	H
  0623'   CD 0779'              	CALL	GBSUB		; HL = bytes to the cursor
  0626'   44                    	MOV	B,H
  0627'   4D                    	MOV	C,L
  0628'   E1                    	POP	H		; HL = the line's start
  0629'   11 0000               	LXI	D,0		; DE = screen column
  062C'                         SG_LP:
  062C'   78                    	MOV	A,B
  062D'   B1                    	ORA	C
  062E'   CA 0643'              	JZ	SG_CUR
  0631'   7E                    	MOV	A,M
  0632'   23                    	INX	H
  0633'   0B                    	DCX	B
  0634'   E5                    	PUSH	H
  0635'   6B                    	MOV	L,E
  0636'   CD 0668'              	CALL	CWID
  0639'   E1                    	POP	H
  063A'   83                    	ADD	E
  063B'   5F                    	MOV	E,A
  063C'   D2 062C'              	JNC	SG_LP
  063F'   14                    	INR	D
  0640'   C3 062C'              	JMP	SG_LP
  0643'                         SG_CUR:
  0643'   2A 0000*              	LHLD	TXTEND
  0646'   D5                    	PUSH	D
  0647'   EB                    	XCHG
  0648'   2A 0000*              	LHLD	GAPEND
  064B'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  064E'   D1                    	POP	D
  064F'   CA 0663'              	JZ	SG_SET
  0652'   7E                    	MOV	A,M
  0653'   FE 09                 	CPI	TAB
  0655'   C2 0663'              	JNZ	SG_SET
  0658'   6B                    	MOV	L,E
  0659'   CD 0668'              	CALL	CWID
  065C'   3D                    	DCR	A		; the TAB's last column
  065D'   83                    	ADD	E
  065E'   5F                    	MOV	E,A
  065F'   D2 0663'              	JNC	SG_SET
  0662'   14                    	INR	D
  0663'                         SG_SET:
  0663'   EB                    	XCHG
  0664'   22 31BE'              	SHLD	GOALCOL
  0667'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0668'                         CWID:
  0668'   FE 0D                 	CPI	CR
  066A'   CA 0679'              	JZ	CW_0
  066D'   FE 09                 	CPI	TAB
  066F'   3E 01                 	MVI	A,1
  0671'   C0                    	RNZ
  0672'   7D                    	MOV	A,L
  0673'   E6 07                 	ANI	TABWID-1
  0675'   2F                    	CMA
  0676'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0678'   C9                    	RET
  0679'                         CW_0:
  0679'   AF                    	XRA	A
  067A'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  067B'                         BOL:
  067B'   C5                    	PUSH	B
  067C'   E5                    	PUSH	H
  067D'   CD 0000*              	CALL	CUROFF
  0680'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  0681'   CD 0000*              	CALL	CMP16
  0684'   DA 06A7'              	JC	BOL_B
  0687'   CA 06A7'              	JZ	BOL_B
  068A'   D5                    	PUSH	D
  068B'   EB                    	XCHG
  068C'   CD 0000*              	CALL	SUBHD
  068F'   44                    	MOV	B,H
  0690'   4D                    	MOV	C,L		; BC = how far past the gap it is
  0691'   2A 0000*              	LHLD	GAPEND
  0694'   09                    	DAD	B
  0695'   D1                    	POP	D
  0696'                         BOL_A:
  0696'   78                    	MOV	A,B
  0697'   B1                    	ORA	C
  0698'   CA 06A7'              	JZ	BOL_B		; back at the gap: the rest is before it
  069B'   2B                    	DCX	H
  069C'   7E                    	MOV	A,M
  069D'   FE 0A                 	CPI	LF
  069F'   CA 06BB'              	JZ	BOL_X
  06A2'   1B                    	DCX	D
  06A3'   0B                    	DCX	B
  06A4'   C3 0696'              	JMP	BOL_A
  06A7'                         BOL_B:
  06A7'   2A 0000*              	LHLD	TXTBEG
  06AA'   19                    	DAD	D
  06AB'                         BOL_C:
  06AB'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06AC'   B3                    	ORA	E
  06AD'   CA 06BB'              	JZ	BOL_X		; at 0
  06B0'   2B                    	DCX	H
  06B1'   7E                    	MOV	A,M
  06B2'   FE 0A                 	CPI	LF
  06B4'   CA 06BB'              	JZ	BOL_X
  06B7'   1B                    	DCX	D
  06B8'   C3 06AB'              	JMP	BOL_C
  06BB'                         BOL_X:
  06BB'   EB                    	XCHG
  06BC'   C1                    	POP	B
  06BD'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
                                ; Read the same way; keeps BC.
  06BE'                         EOLNL:
  06BE'   C5                    	PUSH	B
  06BF'   E5                    	PUSH	H
  06C0'   CD 0000*              	CALL	CUROFF
  06C3'   D1                    	POP	D		; DE = off, HL = the bytes before the gap
  06C4'   CD 0000*              	CALL	CMP16
  06C7'   D2 06E5'              	JNC	ENL_A
  06CA'   2A 0000*              	LHLD	GAPBEG
  06CD'   44                    	MOV	B,H
  06CE'   4D                    	MOV	C,L
  06CF'   2A 0000*              	LHLD	TXTBEG
  06D2'   19                    	DAD	D
  06D3'                         ENL_B:
  06D3'   7D                    	MOV	A,L
  06D4'   91                    	SUB	C
  06D5'   7C                    	MOV	A,H
  06D6'   98                    	SBB	B
  06D7'   D2 06F3'              	JNC	ENL_G		; at the gap: on from its far side
  06DA'   7E                    	MOV	A,M
  06DB'   FE 0A                 	CPI	LF
  06DD'   CA 070F'              	JZ	ENL_X
  06E0'   23                    	INX	H
  06E1'   13                    	INX	D
  06E2'   C3 06D3'              	JMP	ENL_B
  06E5'                         ENL_A:
  06E5'   D5                    	PUSH	D
  06E6'   EB                    	XCHG
  06E7'   CD 0000*              	CALL	SUBHD
  06EA'   EB                    	XCHG			; DE = how far past the gap it is
  06EB'   2A 0000*              	LHLD	GAPEND
  06EE'   19                    	DAD	D
  06EF'   D1                    	POP	D
  06F0'   C3 06F6'              	JMP	ENL_S
  06F3'                         ENL_G:
  06F3'   2A 0000*              	LHLD	GAPEND
  06F6'                         ENL_S:
  06F6'   E5                    	PUSH	H
  06F7'   2A 0000*              	LHLD	TXTEND
  06FA'   44                    	MOV	B,H
  06FB'   4D                    	MOV	C,L
  06FC'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06FD'                         ENL_C:
  06FD'   7D                    	MOV	A,L
  06FE'   91                    	SUB	C
  06FF'   7C                    	MOV	A,H
  0700'   98                    	SBB	B
  0701'   D2 070F'              	JNC	ENL_X		; the end of the text
  0704'   7E                    	MOV	A,M
  0705'   FE 0A                 	CPI	LF
  0707'   CA 070F'              	JZ	ENL_X
  070A'   23                    	INX	H
  070B'   13                    	INX	D
  070C'   C3 06FD'              	JMP	ENL_C
  070F'                         ENL_X:
  070F'   EB                    	XCHG
  0710'   C1                    	POP	B
  0711'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0712'                         NLSTART:
  0712'   CD 06BE'              	CALL	EOLNL
  0715'   E5                    	PUSH	H
  0716'   CD 0000*              	CALL	LOGLEN
  0719'   D1                    	POP	D		; DE = eol result
  071A'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  071D'   C8                    	RZ			; no next line: HL = LOGLEN
  071E'   EB                    	XCHG			; HL = eol
  071F'   23                    	INX	H
  0720'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0721'                         EOLC:
  0721'   E5                    	PUSH	H
  0722'   CD 06BE'              	CALL	EOLNL
  0725'   22 0000*              	SHLD	WKTERM
  0728'   E1                    	POP	H
  0729'   CD 067B'              	CALL	BOL
  072C'   22 0000*              	SHLD	WKBOL
  072F'   2A 0000*              	LHLD	WKTERM
  0732'   EB                    	XCHG			; DE = term
  0733'   2A 0000*              	LHLD	WKBOL
  0736'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0739'   CA 0758'              	JZ	EOLC_MT
  073C'   EB                    	XCHG			; HL = term
  073D'   2B                    	DCX	H		; term-1
  073E'   E5                    	PUSH	H
  073F'   CD 0000*              	CALL	CHARAT
  0742'   E1                    	POP	H		; HL = term-1
  0743'   FE 0D                 	CPI	CR
  0745'   CA 074B'              	JZ	EOLC_CR		; content ends at term-1
  0748'   C3 074C'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  074B'                         EOLC_CR:
  074B'   2B                    	DCX	H		; last = (term-1) - 1
  074C'                         EOLC_LS:
  074C'   EB                    	XCHG			; DE = last
  074D'   2A 0000*              	LHLD	WKBOL
  0750'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0753'   DA 0758'              	JC	EOLC_MT
  0756'   EB                    	XCHG			; HL = last
  0757'   C9                    	RET
  0758'                         EOLC_MT:
  0758'   2A 0000*              	LHLD	WKBOL
  075B'   C9                    	RET
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  075C'                         ATENDQ:
  075C'   CD 0000*              	CALL	CUROFF
  075F'   E5                    	PUSH	H
  0760'   CD 0000*              	CALL	LOGLEN
  0763'   D1                    	POP	D		; DE = cur
  0764'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0767'                         CURCHR:
  0767'   CD 0000*              	CALL	CUROFF
  076A'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  076D'                         MOVCNT:
  076D'   CD 0855'              	CALL	SETMOV
  0770'   C3 0780'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0773'                         CNTOFF:
  0773'   CD 0780'              	CALL	GETCNT
  0776'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0779'                         GBSUB:
  0779'   EB                    	XCHG
  077A'   2A 0000*              	LHLD	GAPBEG
  077D'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0780'                         GETCNT:
  0780'   2A 0000*              	LHLD	CMDCNT
  0783'   7C                    	MOV	A,H
  0784'   B5                    	ORA	L
  0785'   C2 078C'              	JNZ	GC_HAVE
  0788'   21 0001               	LXI	H,1
  078B'   C9                    	RET
  078C'                         GC_HAVE:
  078C'   E5                    	PUSH	H
  078D'   21 0000               	LXI	H,0
  0790'   22 0000*              	SHLD	CMDCNT
  0793'   E1                    	POP	H
  0794'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0795'                         CNTTST:				; WM 1175
  0795'   3A 0000*              	LDA	BRKARM
  0798'   B7                    	ORA	A
  0799'   C4 07C3'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  079C'   E5                    	PUSH	H
  079D'   2A 0000*              	LHLD	CMDCNT
  07A0'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  07A3'   B4                    	ORA	H
  07A4'   B5                    	ORA	L
  07A5'   E1                    	POP	H
  07A6'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07A9'                         BRKON:
  07A9'   21 0000*              	LXI	H,SOFF
  07AC'   CD 042C'              	CALL	FPSTO
  07AF'   2A 0000*              	LHLD	LNDLT
  07B2'   22 0000*              	SHLD	SLDLT
  07B5'   AF                    	XRA	A
  07B6'   32 0000*              	STA	BRKHIT
  07B9'   3A 0000*              	LDA	PSAVE
  07BC'   B7                    	ORA	A
  07BD'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07BE'   3C                    	INR	A
  07BF'   32 0000*              	STA	BRKARM
  07C2'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07C3'                         BRKTST:
  07C3'   C5                    	PUSH	B
  07C4'   D5                    	PUSH	D
  07C5'   E5                    	PUSH	H
  07C6'   CD 0000*              	CALL	KBBRK
  07C9'   CA 07E2'              	JZ	BT_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07CC'   32 0000*              	STA	BRKHIT		; (A = FFH)
  07CF'   21 28C4'              	LXI	H,SINTG
  07D2'   CD 0000*              	CALL	EXMSG
  07D5'   AF                    	XRA	A
  07D6'   32 0000*              	STA	BRKARM		; the way back is not stopped in its turn
  07D9'   32 0000*              	STA	AUXCNT
  07DC'   21 0000               	LXI	H,0
  07DF'   22 0000*              	SHLD	CMDCNT
  07E2'                         BT_NO:
  07E2'   E1                    	POP	H
  07E3'   D1                    	POP	D
  07E4'   C1                    	POP	B
  07E5'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07E6'                         BRKOFF:
  07E6'   AF                    	XRA	A
  07E7'   32 0000*              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  07EA'                         BRKQ:
  07EA'   3A 0000*              	LDA	BRKHIT
  07ED'   B7                    	ORA	A
  07EE'   C8                    	RZ
  07EF'   37                    	STC
  07F0'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07F1'                         RSTPL:
  07F1'   21 0000*              	LXI	H,SOFF
  07F4'   CD 03D3'              	CALL	BACKTO
  07F7'   2A 0000*              	LHLD	SLDLT
  07FA'   22 0000*              	SHLD	LNDLT
  07FD'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07FE'                         BRKBAK:
  07FE'   CD 07F1'              	CALL	RSTPL
  0801'   CD 0000*              	CALL	KBFLSH
  0804'   21 28B8'              	LXI	H,SINTR
  0807'   C3 281A'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  080A'                         CLASSF:
  080A'   47                    	MOV	B,A
  080B'   FE 20                 	CPI	' '
  080D'   CA 084D'              	JZ	CLS0
  0810'   FE 09                 	CPI	TAB
  0812'   CA 084D'              	JZ	CLS0
  0815'   FE 0A                 	CPI	LF
  0817'   CA 084D'              	JZ	CLS0
  081A'   FE 0D                 	CPI	CR
  081C'   CA 084D'              	JZ	CLS0
  081F'   3A 0000*              	LDA	WBIG
  0822'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0823'   C2 084F'              	JNZ	CLS1
  0826'   78                    	MOV	A,B
  0827'   FE 5F                 	CPI	'_'
  0829'   CA 084F'              	JZ	CLS1
  082C'   FE 30                 	CPI	'0'
  082E'   DA 0852'              	JC	CLS2
  0831'   FE 3A                 	CPI	'9'+1
  0833'   DA 084F'              	JC	CLS1
  0836'   FE 41                 	CPI	'A'
  0838'   DA 0852'              	JC	CLS2
  083B'   FE 5B                 	CPI	'Z'+1
  083D'   DA 084F'              	JC	CLS1
  0840'   FE 61                 	CPI	'a'
  0842'   DA 0852'              	JC	CLS2
  0845'   FE 7B                 	CPI	'z'+1
  0847'   DA 084F'              	JC	CLS1
  084A'   C3 0852'              	JMP	CLS2
  084D'   AF                    CLS0:	XRA	A
  084E'   C9                    	RET
  084F'   3E 01                 CLS1:	MVI	A,1
  0851'   C9                    	RET
  0852'   3E 02                 CLS2:	MVI	A,2
  0854'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0855'                         SETMOV:
  0855'   3E 01                 	MVI	A,R_MOVE
  0857'   32 0000*              	STA	RINTENT
  085A'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  085B'                         SETLIN:
  085B'   3E 02                 	MVI	A,R_LINE
  085D'   32 0000*              	STA	RINTENT
  0860'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  0861'                         SETCEL:
  0861'   CD 0876'              	CALL	PLAINQ
  0864'   D0                    	RNC
  0865'   3A 0000*              	LDA	VRCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0868'   CD 0876'              	CALL	PLAINQ
  086B'   D0                    	RNC
  086C'   78                    	MOV	A,B
  086D'   32 0000*              	STA	ICHAPP
  0870'   3E 04                 	MVI	A,R_ICH
  0872'   32 0000*              	STA	RINTENT
  0875'   C9                    	RET
                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0876'                         PLAINQ:
  0876'   FE 20                 	CPI	' '
  0878'   3F                    	CMC
  0879'   D0                    	RNC
  087A'   FE 7F                 	CPI	DEL
  087C'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  087D'                         SETILN:
  087D'   3E 01                 	MVI	A,1
  087F'   32 31BC'              	STA	ILN		; one line, unless a put overwrites it below
  0882'   3E 05                 	MVI	A,R_ILIN
  0884'   32 0000*              	STA	RINTENT
  0887'   AF                    	XRA	A
  0888'   32 0000*              	STA	ILABOV		; the row above the opened ones is untouched
  088B'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  088C'                         SETJON:
  088C'   3E 06                 	MVI	A,R_JOIN
  088E'   32 0000*              	STA	RINTENT
  0891'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0892'                         SETFUL:
  0892'   3E 00                 	MVI	A,R_FULL
  0894'   32 0000*              	STA	RINTENT
  0897'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0898'                         TAILTAB:
  0898'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  0899'   CD 0000*              	CALL	CUROFF
  089C'   E5                    	PUSH	H
  089D'   2A 0000*              	LHLD	TXTEND
  08A0'   44                    	MOV	B,H
  08A1'   4D                    	MOV	C,L
  08A2'   2A 0000*              	LHLD	GAPEND
  08A5'   D1                    	POP	D		; DE = the offset of the byte at HL
  08A6'                         TT_LP:
  08A6'   7D                    	MOV	A,L
  08A7'   91                    	SUB	C
  08A8'   7C                    	MOV	A,H
  08A9'   98                    	SBB	B
  08AA'   D2 08CA'              	JNC	TT_NO		; reached end of text -> no tab
  08AD'   7E                    	MOV	A,M
  08AE'   FE 0A                 	CPI	LF
  08B0'   CA 08CA'              	JZ	TT_NO		; end of line -> no tab
  08B3'   FE 0D                 	CPI	CR
  08B5'   CA 08BD'              	JZ	TT_NX		; (the line end's own)
  08B8'   FE 20                 	CPI	' '
  08BA'   DA 08C2'              	JC	TT_YES
  08BD'                         TT_NX:
  08BD'   23                    	INX	H
  08BE'   13                    	INX	D
  08BF'   C3 08A6'              	JMP	TT_LP
  08C2'                         TT_YES:
  08C2'   EB                    	XCHG
  08C3'   22 0000*              	SHLD	TTI
  08C6'   C1                    	POP	B
  08C7'   3E 01                 	MVI	A,1
  08C9'   C9                    	RET
  08CA'                         TT_NO:
  08CA'   C1                    	POP	B
  08CB'   AF                    	XRA	A
  08CC'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  08CD'                         VC_H:
  08CD'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  08D0'   22 0000*              	SHLD	CNTV
  08D3'                         VCH_LP:
  08D3'   2A 0000*              	LHLD	CNTV
  08D6'   7C                    	MOV	A,H
  08D7'   B5                    	ORA	L
  08D8'   C8                    	RZ
  08D9'   2B                    	DCX	H
  08DA'   22 0000*              	SHLD	CNTV
  08DD'   CD 08E3'              	CALL	HSTEP
  08E0'   C3 08D3'              	JMP	VCH_LP
  08E3'                         HSTEP:
  08E3'   CD 0000*              	CALL	CUROFF		; HL = cur
  08E6'   7C                    	MOV	A,H
  08E7'   B5                    	ORA	L
  08E8'   C8                    	RZ			; at 0
  08E9'   E5                    	PUSH	H
  08EA'   CD 067B'              	CALL	BOL		; HL = bol
  08ED'   D1                    	POP	D		; DE = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08EE'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  08F1'   C8                    	RZ			; at BOL, cannot go left
  08F2'   EB                    	XCHG			; HL = cur
  08F3'   2B                    	DCX	H
  08F4'   C3 0611'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  08F7'                         VC_L:
  08F7'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  08FA'   22 0000*              	SHLD	CNTV
  08FD'                         VCL_LP:
  08FD'   2A 0000*              	LHLD	CNTV
  0900'   7C                    	MOV	A,H
  0901'   B5                    	ORA	L
  0902'   C8                    	RZ
  0903'   2B                    	DCX	H
  0904'   22 0000*              	SHLD	CNTV
  0907'   CD 090D'              	CALL	LSTEP
  090A'   C3 08FD'              	JMP	VCL_LP
  090D'                         LSTEP:
  090D'   CD 0000*              	CALL	CUROFF		; HL = cur
  0910'   E5                    	PUSH	H
  0911'   CD 0721'              	CALL	EOLC		; HL = eolc
  0914'   D1                    	POP	D		; DE = cur
  0915'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0918'   D2 0920'              	JNC	LS_NO		; cur >= eolc, cannot go right
  091B'   EB                    	XCHG			; HL = cur
  091C'   23                    	INX	H
  091D'   C3 0611'              	JMP	GOSET
  0920'                         LS_NO:				; on the line's last char.  An operator waiting on
  0920'   CD 0D93'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0923'   C8                    	RZ			;   motion inclusive when it falls short), which
  0924'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0926'   32 0000*              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0929'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  092A'                         VC_0:
  092A'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  092D'   CD 0937'              	CALL	LNSTRT
  0930'   21 0000               	LXI	H,0
  0933'   22 31BE'              	SHLD	GOALCOL
  0936'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0937'                         LNSTRT:
  0937'   CD 13AE'              	CALL	ZSAVE
  093A'   21 0000               	LXI	H,0
  093D'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0940'   E5                    	PUSH	H
  0941'   CD 13C1'              	CALL	ZREST
  0944'   E1                    	POP	H
  0945'   C3 0000*              	JMP	PUTCUR
                                
                                ;LNEND -- the cursor's line whole in the window: read on from the cursor to
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ; its LF with WM's RGET, which pages in what the window does not hold yet.
                                ; The window ends on a record, not a line, so its last line is cut short, and
                                ; a measure that stops at the window's end (NLSTART at LOGLEN) takes a piece
                                ; of a line for the whole of it (issue #38).  The cursor stays where it is;
                                ; text behind it may page out, so an offset taken before this is stale.
  0948'                         LNEND:
  0948'   CD 0000*              	CALL	RGET0
  094B'                         LNE_LP:
  094B'   CD 0000*              	CALL	RDGET
  094E'   D8                    	RC			; the end of the file
  094F'   FE 0A                 	CPI	LF
  0951'   C2 094B'              	JNZ	LNE_LP
  0954'   C9                    	RET
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0955'                         VC_CRT:
  0955'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  0958'   C3 095B'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  095B'                         FNBLNK:
  095B'   CD 0937'              	CALL	LNSTRT
  095E'   CD 0000*              	CALL	RGET0
  0961'   11 0000               	LXI	D,0		; DE = blanks skipped
  0964'                         FN_LP:
  0964'   CD 0000*              	CALL	RDGET
  0967'   DA 098A'              	JC	FN_GO		; the end of the file
  096A'   FE 20                 	CPI	' '
  096C'   CA 0974'              	JZ	FN_WH
  096F'   FE 09                 	CPI	TAB
  0971'   C2 098A'              	JNZ	FN_GO		; a non-blank, or the line's end
  0974'                         FN_WH:
  0974'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0977'   DA 098A'              	JC	FN_GO
  097A'   FE 0D                 	CPI	CR
  097C'   CA 098A'              	JZ	FN_GO
  097F'   FE 0A                 	CPI	LF
  0981'   CA 098A'              	JZ	FN_GO
  0984'   2B                    	DCX	H		; not yet: read that char again
  0985'   03                    	INX	B
  0986'   13                    	INX	D
  0987'   C3 0964'              	JMP	FN_LP
  098A'                         FN_GO:
  098A'   D5                    	PUSH	D
  098B'   CD 0000*              	CALL	CUROFF
  098E'   D1                    	POP	D
  098F'   19                    	DAD	D
  0990'   C3 0611'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0993'                         VC_EOL:
  0993'   CD 0855'              	CALL	SETMOV
  0996'   21 FFFF               	LXI	H,0FFFFH
  0999'   22 31BE'              	SHLD	GOALCOL
  099C'   CD 0780'              	CALL	GETCNT
  099F'   2B                    	DCX	H		; count-1
  09A0'   7C                    	MOV	A,H
  09A1'   B5                    	ORA	L
  09A2'   CA 09B1'              	JZ	VEOL_0
  09A5'   E5                    	PUSH	H
  09A6'   CD 09C6'              	CALL	ONLAST
  09A9'   E1                    	POP	H
  09AA'   D8                    	RC			; the last line: no move (vim)
  09AB'   CD 0A16'              	CALL	JCORE
  09AE'   C3 0BFF'              	JMP	JKLAND
  09B1'                         VEOL_0:
  09B1'   CD 0937'              	CALL	LNSTRT
  09B4'   C3 0BFF'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09B7'                         VC_CR:
  09B7'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  09BA'   E5                    	PUSH	H
  09BB'   CD 09C6'              	CALL	ONLAST
  09BE'   E1                    	POP	H
  09BF'   D8                    	RC
  09C0'   CD 0A16'              	CALL	JCORE
  09C3'   C3 095B'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09C6'                         ONLAST:
  09C6'   CD 0000*              	CALL	RGET0
  09C9'                         OL_LP:
  09C9'   CD 0000*              	CALL	RDGET
  09CC'   D8                    	RC			; the file ends on this line
  09CD'   FE 0A                 	CPI	LF
  09CF'   C2 09C9'              	JNZ	OL_LP
  09D2'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09D5'                         VC_J:
  09D5'   CD 0855'              	CALL	SETMOV
  09D8'   CD 0A00'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09DB'   CD 0780'              	CALL	GETCNT		; HL = count
  09DE'   CD 0A16'              	CALL	JCORE
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09E1'   CD 09F9'              	CALL	JKDRP
  09E4'   C3 0BFF'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  09E7'                         VC_K:
  09E7'   CD 0855'              	CALL	SETMOV
  09EA'   CD 0A00'              	CALL	GLCHK
  09ED'   CD 0780'              	CALL	GETCNT
  09F0'   CD 0AF6'              	CALL	KCORE
  09F3'   CD 09F9'              	CALL	JKDRP
  09F6'   C3 0BFF'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  09F9'                         JKDRP:
  09F9'   7A                    	MOV	A,D
  09FA'   B3                    	ORA	E
  09FB'   C0                    	RNZ
  09FC'   32 0000*              	STA	PSAVE
  09FF'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0A00'                         GLCHK:
  0A00'   2A 31BE'              	LHLD	GOALCOL
  0A03'   7C                    	MOV	A,H
  0A04'   3C                    	INR	A
  0A05'   C0                    	RNZ
  0A06'   7D                    	MOV	A,L
  0A07'   FE FE                 	CPI	0FEH
  0A09'   C0                    	RNZ
  0A0A'   C3 0614'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0A0D'                         GLSTAL:
  0A0D'   E5                    	PUSH	H
  0A0E'   21 FFFE               	LXI	H,0FFFEH
  0A11'   22 31BE'              	SHLD	GOALCOL
  0A14'   E1                    	POP	H
  0A15'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A16'                         JCORE:
  0A16'   7C                    	MOV	A,H
  0A17'   B5                    	ORA	L
  0A18'   C8                    	RZ
  0A19'   22 0000*              	SHLD	JKCNT
  0A1C'   CD 0EC2'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A1F'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A20'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A23'   3C                    	INR	A
  0A24'   90                    	SUB	B
  0A25'   5F                    	MOV	E,A
  0A26'   16 00                 	MVI	D,0
  0A28'   3A 0000*              	LDA	NEDIT
  0A2B'   6F                    	MOV	L,A
  0A2C'   26 00                 	MVI	H,0
  0A2E'   19                    	DAD	D
  0A2F'   EB                    	XCHG			; DE = limit
  0A30'   2A 0000*              	LHLD	JKCNT
  0A33'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A36'   D2 0A84'              	JNC	JC_QK
  0A39'   EB                    	XCHG			; HL = limit
  0A3A'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0A3D'                         JC_SL:
  0A3D'   2A 0000*              	LHLD	JKN
  0A40'   EB                    	XCHG			; DE = LFs to find
  0A41'   CD 0000*              	CALL	RGET0
  0A44'                         JC_SC:
  0A44'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A47'   DA 0A66'              	JC	JC_EOF
  0A4A'   32 0000*              	STA	JKLST
  0A4D'   FE 0A                 	CPI	LF
  0A4F'   C2 0A44'              	JNZ	JC_SC
  0A52'   1B                    	DCX	D
  0A53'   7A                    	MOV	A,D
  0A54'   B3                    	ORA	E
  0A55'   C2 0A44'              	JNZ	JC_SC
  0A58'   2A 0000*              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A5B'   22 0000*              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A5E'   3E 01                 	MVI	A,1
  0A60'   32 0000*              	STA	JKPHN
  0A63'   C3 0AC1'              	JMP	JC_MV
  0A66'                         JC_EOF:
  0A66'   2A 0000*              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A69'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A6C'   7C                    	MOV	A,H
  0A6D'   B5                    	ORA	L
  0A6E'   CA 0A7A'              	JZ	JC_AV
  0A71'   3A 0000*              	LDA	JKLST
  0A74'   FE 0A                 	CPI	LF
  0A76'   C2 0A7A'              	JNZ	JC_AV
  0A79'   2B                    	DCX	H
  0A7A'                         JC_AV:
  0A7A'   22 0000*              	SHLD	JKMOV
  0A7D'   AF                    	XRA	A
  0A7E'   32 0000*              	STA	JKPHN
  0A81'   C3 0AC1'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0A84'                         JC_QK:
  0A84'   22 0000*              	SHLD	JKN		; N = the count
  0A87'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0A8A'   3A 0000*              	LDA	JKN
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0A8D'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0A8E'   16 0A                 	MVI	D,LF
  0A90'   04                    	INR	B
  0A91'   0C                    	INR	C
  0A92'                         JQ_LP:
  0A92'   0D                    	DCR	C
  0A93'   C2 0A9A'              	JNZ	JQ_CH
  0A96'   05                    	DCR	B
  0A97'   CA 0A3D'              	JZ	JC_SL
  0A9A'                         JQ_CH:
  0A9A'   7E                    	MOV	A,M
  0A9B'   23                    	INX	H
  0A9C'   BA                    	CMP	D
  0A9D'   C2 0A92'              	JNZ	JQ_LP
  0AA0'   1D                    	DCR	E
  0AA1'   C2 0A92'              	JNZ	JQ_LP
  0AA4'   EB                    	XCHG			; DE = the line's start
  0AA5'   2A 0000*              	LHLD	TXTEND
  0AA8'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0AAB'   D2 0A3D'              	JNC	JC_SL
  0AAE'   EB                    	XCHG
  0AAF'   CD 0000*              	CALL	PUTCUR
  0AB2'   21 0000               	LXI	H,0
  0AB5'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AB8'   2A 0000*              	LHLD	JKCNT
  0ABB'   22 0000*              	SHLD	JKMOV
  0ABE'   C3 0ADF'              	JMP	JC_DN
  0AC1'                         JC_MV:
  0AC1'   2A 0000*              	LHLD	JKCNT
  0AC4'   AF                    	XRA	A
  0AC5'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0AC8'   CD 0BDE'              	CALL	ATEOF
  0ACB'   D2 0ADF'              	JNC	JC_DN
  0ACE'   CD 0BE4'              	CALL	LASTLN		; ran past the last line: back onto it
  0AD1'   3A 0000*              	LDA	JKPHN
  0AD4'   B7                    	ORA	A
  0AD5'   CA 0ADF'              	JZ	JC_DN
  0AD8'   2A 0000*              	LHLD	JKMOV
  0ADB'   2B                    	DCX	H
  0ADC'   22 0000*              	SHLD	JKMOV
  0ADF'                         JC_DN:
  0ADF'   2A 0000*              	LHLD	JKN		; LNDLT += min(moved, N)
  0AE2'   EB                    	XCHG
  0AE3'   2A 0000*              	LHLD	JKMOV
  0AE6'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0AE9'   D2 0AED'              	JNC	JC_AD
  0AEC'   EB                    	XCHG
  0AED'                         JC_AD:
  0AED'   EB                    	XCHG			; DE = lines moved
  0AEE'   2A 0000*              	LHLD	LNDLT
  0AF1'   19                    	DAD	D
  0AF2'   22 0000*              	SHLD	LNDLT
  0AF5'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0AF6'                         KCORE:
  0AF6'   7C                    	MOV	A,H
  0AF7'   B5                    	ORA	L
  0AF8'   C8                    	RZ
  0AF9'   22 0000*              	SHLD	JKCNT
  0AFC'   CD 0EC2'              	CALL	CURRW		; limit = row + NEDIT
  0AFF'   5F                    	MOV	E,A
  0B00'   16 00                 	MVI	D,0
  0B02'   3A 0000*              	LDA	NEDIT
  0B05'   6F                    	MOV	L,A
  0B06'   26 00                 	MVI	H,0
  0B08'   19                    	DAD	D
  0B09'   EB                    	XCHG			; DE = limit
  0B0A'   2A 0000*              	LHLD	JKCNT
  0B0D'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0B10'   D2 0B8A'              	JNC	KC_QK
  0B13'   EB                    	XCHG			; HL = limit
  0B14'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0B17'                         KC_SL:
  0B17'   2A 0000*              	LHLD	JKN
  0B1A'   EB                    	XCHG			; DE = LFs to find
  0B1B'   21 0000               	LXI	H,0
  0B1E'   22 0000*              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0B21'                         KC_ED:
  0B21'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0B22'   2A 0000*              	LHLD	JKBK
  0B25'   CD 0779'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B28'   E5                    	PUSH	H
  0B29'   EB                    	XCHG
  0B2A'   2A 0000*              	LHLD	TXTBEG
  0B2D'   EB                    	XCHG
  0B2E'   CD 0000*              	CALL	SUBHD
  0B31'   44                    	MOV	B,H
  0B32'   4D                    	MOV	C,L
  0B33'   E1                    	POP	H
  0B34'   D1                    	POP	D
  0B35'                         KC_SC:
  0B35'   78                    	MOV	A,B
  0B36'   B1                    	ORA	C
  0B37'   CA 0B4E'              	JZ	KC_TB
  0B3A'   2B                    	DCX	H
  0B3B'   0B                    	DCX	B
  0B3C'   7E                    	MOV	A,M
  0B3D'   FE 0A                 	CPI	LF
  0B3F'   C2 0B35'              	JNZ	KC_SC
  0B42'   1B                    	DCX	D
  0B43'   7A                    	MOV	A,D
  0B44'   B3                    	ORA	E
  0B45'   C2 0B35'              	JNZ	KC_SC
  0B48'   2A 0000*              	LHLD	JKCNT		; N lines above: the move is count lines
  0B4B'   C3 0B6E'              	JMP	KC_MV
  0B4E'                         KC_TB:
  0B4E'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B4F'   CD 0779'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B52'   22 0000*              	SHLD	JKBK
  0B55'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B58'   7C                    	MOV	A,H
  0B59'   B5                    	ORA	L
  0B5A'   CA 0B67'              	JZ	KC_B0
  0B5D'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B60'   D1                    	POP	D
  0B61'   DA 0B68'              	JC	KC_BOF
  0B64'   C3 0B21'              	JMP	KC_ED
  0B67'                         KC_B0:
  0B67'   D1                    	POP	D
  0B68'                         KC_BOF:
  0B68'   2A 0000*              	LHLD	JKN		; moved = LFs found
  0B6B'   CD 0000*              	CALL	SUBHD
  0B6E'                         KC_MV:
  0B6E'   E5                    	PUSH	H
  0B6F'   2A 0000*              	LHLD	JKCNT
  0B72'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B75'   D1                    	POP	D		; DE = moved
  0B76'   2A 0000*              	LHLD	JKN
  0B79'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B7C'   DA 0B80'              	JC	KC_AD
  0B7F'   EB                    	XCHG			; DE = N
  0B80'                         KC_AD:
  0B80'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B83'   CD 0000*              	CALL	SUBHD
  0B86'   22 0000*              	SHLD	LNDLT
  0B89'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0B8A'                         KC_QK:
  0B8A'   22 0000*              	SHLD	JKN		; N = the count
  0B8D'   2A 0000*              	LHLD	TXTBEG
  0B90'   EB                    	XCHG
  0B91'   2A 0000*              	LHLD	GAPBEG
  0B94'   E5                    	PUSH	H
  0B95'   CD 0000*              	CALL	SUBHD
  0B98'   44                    	MOV	B,H
  0B99'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0B9A'   E1                    	POP	H
  0B9B'   3A 0000*              	LDA	JKN
  0B9E'   3C                    	INR	A
  0B9F'   5F                    	MOV	E,A		; E = LFs to find
  0BA0'   16 0A                 	MVI	D,LF
  0BA2'   04                    	INR	B
  0BA3'   0C                    	INR	C
  0BA4'                         KQ_LP:
  0BA4'   0D                    	DCR	C
  0BA5'   C2 0BAC'              	JNZ	KQ_CH
  0BA8'   05                    	DCR	B
  0BA9'   CA 0BCC'              	JZ	KQ_TB
  0BAC'                         KQ_CH:
  0BAC'   2B                    	DCX	H
  0BAD'   7E                    	MOV	A,M
  0BAE'   BA                    	CMP	D
  0BAF'   C2 0BA4'              	JNZ	KQ_LP
  0BB2'   1D                    	DCR	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BB3'   C2 0BA4'              	JNZ	KQ_LP
  0BB6'   23                    	INX	H
  0BB7'                         KQ_GO:
  0BB7'   CD 0000*              	CALL	PUTCUR
  0BBA'   21 0000               	LXI	H,0
  0BBD'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BC0'   3E FF                 	MVI	A,0FFH
  0BC2'   32 0000*              	STA	DIRFLG
  0BC5'   2A 0000*              	LHLD	JKCNT
  0BC8'   EB                    	XCHG			; DE = the lines moved
  0BC9'   C3 0B80'              	JMP	KC_AD
  0BCC'                         KQ_TB:
  0BCC'   1D                    	DCR	E
  0BCD'   C2 0B17'              	JNZ	KC_SL
  0BD0'   2A 0000*              	LHLD	OUTPOS
  0BD3'   7C                    	MOV	A,H
  0BD4'   B5                    	ORA	L
  0BD5'   C2 0B17'              	JNZ	KC_SL
  0BD8'   2A 0000*              	LHLD	TXTBEG
  0BDB'   C3 0BB7'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BDE'                         ATEOF:
  0BDE'   CD 0000*              	CALL	RGET0
  0BE1'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0BE4'                         LASTLN:
  0BE4'   2A 0000*              	LHLD	GAPBEG
  0BE7'   EB                    	XCHG
  0BE8'   2A 0000*              	LHLD	TXTBEG
  0BEB'   CD 0000*              	CALL	CMP16
  0BEE'   21 0000               	LXI	H,0
  0BF1'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0BF4'   1B                    	DCX	D
  0BF5'   1A                    	LDAX	D
  0BF6'   FE 0A                 	CPI	LF
  0BF8'   C2 0000*              	JNZ	SETBWD
  0BFB'   23                    	INX	H
  0BFC'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0BFF'                         JKLAND:
  0BFF'   21 0000               	LXI	H,0
  0C02'   22 0000*              	SHLD	JKVC		; screen column
  0C05'   2B                    	DCX	H
  0C06'   22 0000*              	SHLD	JKLS		; last content char: none yet
  0C09'   CD 0000*              	CALL	RGET0
  0C0C'   11 0000               	LXI	D,0		; DE = chars read
  0C0F'                         JL_RD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C0F'   CD 0000*              	CALL	RDGET
  0C12'   DA 0C4C'              	JC	JL_END
  0C15'   FE 0A                 	CPI	LF
  0C17'   CA 0C4C'              	JZ	JL_END
  0C1A'   E5                    	PUSH	H
  0C1B'   C5                    	PUSH	B
  0C1C'   2A 0000*              	LHLD	JKVC
  0C1F'   CD 0668'              	CALL	CWID
  0C22'   B7                    	ORA	A
  0C23'   CA 0C46'              	JZ	JL_NX		; a CR
  0C26'   EB                    	XCHG
  0C27'   22 0000*              	SHLD	JKLS		; the last content char so far
  0C2A'   EB                    	XCHG
  0C2B'   4F                    	MOV	C,A
  0C2C'   06 00                 	MVI	B,0
  0C2E'   09                    	DAD	B		; HL = the column after this char
  0C2F'   22 0000*              	SHLD	JKVC
  0C32'   D5                    	PUSH	D
  0C33'   EB                    	XCHG
  0C34'   2A 31BE'              	LHLD	GOALCOL
  0C37'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C3A'   D1                    	POP	D
  0C3B'   DA 0C46'              	JC	JL_NX
  0C3E'   CA 0C46'              	JZ	JL_NX
  0C41'   C1                    	POP	B		; this char holds the goal column
  0C42'   E1                    	POP	H
  0C43'   C3 0C57'              	JMP	JL_GO
  0C46'                         JL_NX:
  0C46'   C1                    	POP	B
  0C47'   E1                    	POP	H
  0C48'   13                    	INX	D
  0C49'   C3 0C0F'              	JMP	JL_RD
  0C4C'                         JL_END:
  0C4C'   2A 0000*              	LHLD	JKLS		; past the line's end: its last content char
  0C4F'   7C                    	MOV	A,H
  0C50'   A5                    	ANA	L
  0C51'   3C                    	INR	A
  0C52'   C2 0C56'              	JNZ	JL_LS
  0C55'   23                    	INX	H		; no content: the line's start
  0C56'                         JL_LS:
  0C56'   EB                    	XCHG
  0C57'                         JL_GO:
  0C57'   D5                    	PUSH	D		; DE = step from the line start
  0C58'   CD 0000*              	CALL	CUROFF
  0C5B'   D1                    	POP	D
  0C5C'   19                    	DAD	D
  0C5D'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C60'   AF                    VC_W:	XRA	A
  0C61'   32 0000*              	STA	WBIG
  0C64'   C3 0C6C'              	JMP	WDO
  0C67'   3E 01                 VCBGW:	MVI	A,1
  0C69'   32 0000*              	STA	WBIG
  0C6C'   CD 0855'              WDO:	CALL	SETMOV
  0C6F'   AF                    	XRA	A
  0C70'   32 0000*              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C73'   CD 0780'              	CALL	GETCNT
  0C76'   22 0000*              	SHLD	CNTV
  0C79'   2A 0000*              WDO_LP: LHLD	CNTV
  0C7C'   7C                    	MOV	A,H
  0C7D'   B5                    	ORA	L
  0C7E'   CA 0C8B'              	JZ	WDO_DN
  0C81'   2B                    	DCX	H
  0C82'   22 0000*              	SHLD	CNTV
  0C85'   CD 0CE8'              	CALL	FWD1
  0C88'   D2 0C79'              	JNC	WDO_LP
  0C8B'                         WDO_DN:
  0C8B'   CD 0BDE'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0C8E'   DA 0C9B'              	JC	WDO_NL
  0C91'   FE 0D                 	CPI	CR
  0C93'   CA 0C9B'              	JZ	WDO_NL
  0C96'   FE 0A                 	CPI	LF
  0C98'   C2 0614'              	JNZ	SETGL
  0C9B'                         WDO_NL:
  0C9B'   CD 0000*              	CALL	PEEKL
  0C9E'   DA 0614'              	JC	SETGL
  0CA1'   FE 0A                 	CPI	LF
  0CA3'   CA 0614'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0CA6'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0CA8'   32 0000*              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0CAB'   CD 0E07'              	CALL	DECC		; back onto its last char
  0CAE'   C3 0614'              	JMP	SETGL
                                
  0CB1'   AF                    VC_B:	XRA	A
  0CB2'   32 0000*              	STA	WBIG
  0CB5'   C3 0CBD'              	JMP	BDO
  0CB8'   3E 01                 VCBGB:	MVI	A,1
  0CBA'   32 0000*              	STA	WBIG
  0CBD'   CD 0855'              BDO:	CALL	SETMOV
  0CC0'   CD 0780'              	CALL	GETCNT
  0CC3'   22 0000*              	SHLD	CNTV
  0CC6'   CD 0D58'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CC9'   D2 0CD9'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CCC'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CCD'   32 0000*              	STA	PSAVE		;   first char opened an insert).  A count that
  0CD0'   C3 0614'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CD3'                         BDO_LP:				;   its operator stands -- both as vim
  0CD3'   CD 0D58'              	CALL	BCK1
  0CD6'   DA 0614'              	JC	SETGL
  0CD9'   2A 0000*              BDO_NX: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CDC'   2B                    	DCX	H
  0CDD'   22 0000*              	SHLD	CNTV
  0CE0'   7C                    	MOV	A,H
  0CE1'   B5                    	ORA	L
  0CE2'   C2 0CD3'              	JNZ	BDO_LP
  0CE5'   C3 0614'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0CE8'                         FWD1:
  0CE8'   CD 0D8B'              	CALL	CCLS
  0CEB'   32 0000*              	STA	WKCLS		; the starting class
  0CEE'   CD 0DC5'              	CALL	INCC
  0CF1'   B7                    	ORA	A
  0CF2'   CA 0D0B'              	JZ	FW_WD
  0CF5'   37                    	STC
  0CF6'   F8                    	RM			; -1: already at the end
  0CF7'   CD 0D43'              	CALL	WLAST
  0CFA'   C8                    	RZ
  0CFB'   FE 02                 	CPI	2
  0CFD'   C2 0D0B'              	JNZ	FW_WD		; 1: a next line was reached
  0D00'   CD 0BDE'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0D03'   D4 0DAC'              	CNC	NXLN
  0D06'   D2 0D0B'              	JNC	FW_WD
  0D09'   37                    	STC			; yes: failed
  0D0A'   C9                    	RET
  0D0B'                         FW_WD:
  0D0B'   3A 0000*              	LDA	WKCLS		; go past the rest of this word
  0D0E'   B7                    	ORA	A
  0D0F'   CA 0D2B'              	JZ	FW_WS
  0D12'                         FW_WLP:
  0D12'   CD 0D8B'              	CALL	CCLS
  0D15'   21 0000*              	LXI	H,WKCLS
  0D18'   BE                    	CMP	M
  0D19'   C2 0D2B'              	JNZ	FW_WS
  0D1C'   CD 0DC5'              	CALL	INCC
  0D1F'   B7                    	ORA	A
  0D20'   F8                    	RM			; the end of the file (NC)
  0D21'   CA 0D12'              	JZ	FW_WLP
  0D24'   CD 0D43'              	CALL	WLAST
  0D27'   C8                    	RZ
  0D28'   C3 0D12'              	JMP	FW_WLP
  0D2B'                         FW_WS:
  0D2B'   CD 0D8B'              	CALL	CCLS		; then over blanks to the next word
  0D2E'   B7                    	ORA	A
  0D2F'   C0                    	RNZ
  0D30'   CD 0D93'              	CALL	EMPTY
  0D33'   C8                    	RZ			; an empty line is a word
  0D34'   CD 0DC5'              	CALL	INCC
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D37'   B7                    	ORA	A
  0D38'   F8                    	RM
  0D39'   CA 0D2B'              	JZ	FW_WS
  0D3C'   CD 0D43'              	CALL	WLAST
  0D3F'   C8                    	RZ
  0D40'   C3 0D2B'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D43'                         WLAST:
  0D43'   47                    	MOV	B,A
  0D44'   2A 0000*              	LHLD	CNTV
  0D47'   7C                    	MOV	A,H
  0D48'   B5                    	ORA	L
  0D49'   C2 0D54'              	JNZ	WL_X		; words still owed
  0D4C'   3A 0000*              	LDA	PSAVE
  0D4F'   B7                    	ORA	A
  0D50'   CA 0D56'              	JZ	WL_NO		; a plain 'w'
  0D53'   AF                    	XRA	A
  0D54'   78                    WL_X:	MOV	A,B
  0D55'   C9                    	RET
  0D56'   B0                    WL_NO:	ORA	B
  0D57'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D58'                         BCK1:
  0D58'   CD 0E07'              	CALL	DECC
  0D5B'   B7                    	ORA	A
  0D5C'   37                    	STC
  0D5D'   F8                    	RM
  0D5E'                         BK_WS:
  0D5E'   CD 0D8B'              	CALL	CCLS		; back over blanks
  0D61'   B7                    	ORA	A
  0D62'   C2 0D72'              	JNZ	BK_WD
  0D65'   CD 0D93'              	CALL	EMPTY
  0D68'   C8                    	RZ			; an empty line is a word
  0D69'   CD 0E07'              	CALL	DECC
  0D6C'   B7                    	ORA	A
  0D6D'   F2 0D5E'              	JP	BK_WS
  0D70'   AF                    	XRA	A		; the start of the file (NC)
  0D71'   C9                    	RET
  0D72'                         BK_WD:
  0D72'   32 0000*              	STA	WKCLS		; back to the start of this word
  0D75'                         BK_WLP:
  0D75'   CD 0E07'              	CALL	DECC
  0D78'   B7                    	ORA	A
  0D79'   FA 0D89'              	JM	BK_OK		; the start of the file
  0D7C'   CD 0D8B'              	CALL	CCLS
  0D7F'   21 0000*              	LXI	H,WKCLS
  0D82'   BE                    	CMP	M
  0D83'   CA 0D75'              	JZ	BK_WLP
  0D86'   CD 0DC5'              	CALL	INCC		; overshot: forward one
  0D89'                         BK_OK:
  0D89'   AF                    	XRA	A
  0D8A'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0D8B'                         CCLS:
  0D8B'   CD 0BDE'              	CALL	ATEOF
  0D8E'   D2 080A'              	JNC	CLASSF
  0D91'   AF                    	XRA	A
  0D92'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0D93'                         EMPTY:
  0D93'   CD 0BDE'              	CALL	ATEOF
  0D96'   DA 0DA1'              	JC	EM_ST
  0D99'   FE 0D                 	CPI	CR
  0D9B'   CA 0DA1'              	JZ	EM_ST
  0D9E'   FE 0A                 	CPI	LF
  0DA0'   C0                    	RNZ
  0DA1'                         EM_ST:
  0DA1'   CD 0000*              	CALL	PEEKL
  0DA4'   DA 0DAA'              	JC	EM_Y
  0DA7'   FE 0A                 	CPI	LF
  0DA9'   C9                    	RET
  0DAA'                         EM_Y:
  0DAA'   AF                    	XRA	A
  0DAB'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0DAC'                         NXLN:
  0DAC'   FE 0A                 	CPI	LF
  0DAE'   CA 0DBD'              	JZ	NX_LF
  0DB1'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DB4'   D8                    	RC
  0DB5'   FE 0A                 	CPI	LF
  0DB7'   CA 0DBD'              	JZ	NX_LF
  0DBA'   2B                    	DCX	H		; a lone CR
  0DBB'   AF                    	XRA	A
  0DBC'   C9                    	RET
  0DBD'                         NX_LF:
  0DBD'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DC0'   D8                    	RC
  0DC1'   2B                    	DCX	H
  0DC2'   3E 01                 	MVI	A,1
  0DC4'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DC5'                         INCC:
  0DC5'   CD 0BDE'              	CALL	ATEOF
  0DC8'   DA 0E03'              	JC	IC_END
  0DCB'   FE 0D                 	CPI	CR
  0DCD'   CA 0DEE'              	JZ	IC_NL
  0DD0'   FE 0A                 	CPI	LF
  0DD2'   CA 0DEE'              	JZ	IC_NL
  0DD5'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DD8'                         IC_CH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DD8'   CD 0BDE'              	CALL	ATEOF
  0DDB'   DA 0DEA'              	JC	IC_2
  0DDE'   FE 0D                 	CPI	CR
  0DE0'   CA 0DEA'              	JZ	IC_2
  0DE3'   FE 0A                 	CPI	LF
  0DE5'   CA 0DEA'              	JZ	IC_2
  0DE8'   AF                    	XRA	A
  0DE9'   C9                    	RET
  0DEA'                         IC_2:
  0DEA'   3E 02                 	MVI	A,2
  0DEC'   B7                    	ORA	A
  0DED'   C9                    	RET
  0DEE'                         IC_NL:
  0DEE'   CD 0DAC'              	CALL	NXLN
  0DF1'   DA 0E03'              	JC	IC_END
  0DF4'   F5                    	PUSH	PSW
  0DF5'   CD 0000*              	CALL	PUTCUR
  0DF8'   F1                    	POP	PSW
  0DF9'   B7                    	ORA	A
  0DFA'   CA 0DD8'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0DFD'   CD 0E29'              	CALL	LNINC
  0E00'   3E 01                 	MVI	A,1
  0E02'   C9                    	RET
  0E03'                         IC_END:
  0E03'   3E FF                 	MVI	A,0FFH
  0E05'   B7                    	ORA	A
  0E06'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0E07'                         DECC:
  0E07'   CD 0000*              	CALL	PEEKL
  0E0A'   DA 0E03'              	JC	IC_END
  0E0D'   F5                    	PUSH	PSW
  0E0E'   CD 0000*              	CALL	PUTCUR
  0E11'   F1                    	POP	PSW
  0E12'   FE 0A                 	CPI	LF
  0E14'   3E 00                 	MVI	A,0
  0E16'   C0                    	RNZ
  0E17'   CD 0E37'              	CALL	LNDEC
  0E1A'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E1D'   DA 0E25'              	JC	DC_1
  0E20'   FE 0D                 	CPI	CR
  0E22'   CC 0000*              	CZ	PUTCUR
  0E25'                         DC_1:
  0E25'   3E 01                 	MVI	A,1
  0E27'   B7                    	ORA	A
  0E28'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E29'                         LNINC:
  0E29'   E5                    	PUSH	H
  0E2A'   2A 0000*              	LHLD	LNDLT
  0E2D'   7C                    	MOV	A,H
  0E2E'   FE 40                 	CPI	40H
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E30'   CA 0E45'              	JZ	LN_X
  0E33'   23                    	INX	H
  0E34'   C3 0E42'              	JMP	LN_ST
  0E37'                         LNDEC:
  0E37'   E5                    	PUSH	H
  0E38'   2A 0000*              	LHLD	LNDLT
  0E3B'   7C                    	MOV	A,H
  0E3C'   FE C0                 	CPI	0C0H
  0E3E'   CA 0E45'              	JZ	LN_X
  0E41'   2B                    	DCX	H
  0E42'                         LN_ST:
  0E42'   22 0000*              	SHLD	LNDLT
  0E45'                         LN_X:
  0E45'   E1                    	POP	H
  0E46'   C9                    	RET
                                
  0E47'   AF                    VC_E:	XRA	A
  0E48'   32 0000*              	STA	WBIG
  0E4B'   C3 0E53'              	JMP	EDO
  0E4E'   3E 01                 VCBGE:	MVI	A,1
  0E50'   32 0000*              	STA	WBIG
  0E53'   CD 0855'              EDO:	CALL	SETMOV
  0E56'   CD 0780'              	CALL	GETCNT
  0E59'   22 0000*              	SHLD	CNTV
  0E5C'   2A 0000*              EDO_LP: LHLD	CNTV
  0E5F'   7C                    	MOV	A,H
  0E60'   B5                    	ORA	L
  0E61'   CA 0C8B'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E64'   2B                    	DCX	H
  0E65'   22 0000*              	SHLD	CNTV
  0E68'   CD 0E76'              	CALL	ESTEP
  0E6B'   21 0000*              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E6E'   36 00                 	MVI	M,0
  0E70'   D2 0E5C'              	JNC	EDO_LP
  0E73'   C3 0C8B'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E76'                         ESTEP:
  0E76'   CD 0D8B'              	CALL	CCLS
  0E79'   32 0000*              	STA	WKCLS		; the starting class
  0E7C'   CD 0DC5'              	CALL	INCC
  0E7F'   B7                    	ORA	A
  0E80'   FA 0EA6'              	JM	ES_F
  0E83'   CD 0D8B'              	CALL	CCLS
  0E86'   B7                    	ORA	A
  0E87'   CA 0E91'              	JZ	ES_ST
  0E8A'   21 0000*              	LXI	H,WKCLS
  0E8D'   BE                    	CMP	M
  0E8E'   CA 0EA8'              	JZ	ES_SK		; still in the word it started in: on to its end
  0E91'                         ES_ST:
  0E91'   3A 0000*              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0E94'   B7                    	ORA	A		;   that char is the word's end already, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E95'   C2 0EBF'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0E98'                         ES_WS:
  0E98'   CD 0D8B'              	CALL	CCLS		; over blanks, line ends and empty lines
  0E9B'   B7                    	ORA	A
  0E9C'   C2 0EA8'              	JNZ	ES_SK
  0E9F'   CD 0DC5'              	CALL	INCC
  0EA2'   B7                    	ORA	A
  0EA3'   F2 0E98'              	JP	ES_WS
  0EA6'                         ES_F:
  0EA6'   37                    	STC
  0EA7'   C9                    	RET
  0EA8'                         ES_SK:
  0EA8'   CD 0D8B'              	CALL	CCLS		; past the rest of this word ...
  0EAB'   32 0000*              	STA	WKCLS
  0EAE'                         ES_SL:
  0EAE'   CD 0DC5'              	CALL	INCC
  0EB1'   B7                    	ORA	A
  0EB2'   FA 0EA6'              	JM	ES_F
  0EB5'   CD 0D8B'              	CALL	CCLS
  0EB8'   21 0000*              	LXI	H,WKCLS
  0EBB'   BE                    	CMP	M
  0EBC'   CA 0EAE'              	JZ	ES_SL
  0EBF'   C3 0E07'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EC2'                         CURRW:
  0EC2'   2A 0000*              	LHLD	WINROW
  0EC5'   EB                    	XCHG
  0EC6'   2A 0000*              	LHLD	LNDLT
  0EC9'   19                    	DAD	D		; HL = row (signed)
  0ECA'   7C                    	MOV	A,H
  0ECB'   B7                    	ORA	A
  0ECC'   FA 0EDF'              	JM	CRW_0		; above the screen -> top row
  0ECF'   C2 0EDA'              	JNZ	CRW_BT		; far below -> bottom row
  0ED2'   3A 0000*              	LDA	NEDIT
  0ED5'   3D                    	DCR	A		; A = bottom row
  0ED6'   BD                    	CMP	L		; CY iff bottom < row
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0ED7'   D8                    	RC
  0ED8'   7D                    	MOV	A,L
  0ED9'   C9                    	RET
  0EDA'                         CRW_BT:
  0EDA'   3A 0000*              	LDA	NEDIT
  0EDD'   3D                    	DCR	A
  0EDE'   C9                    	RET
  0EDF'                         CRW_0:
  0EDF'   AF                    	XRA	A
  0EE0'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0EE1'                         SETRWT:
  0EE1'   2A 0000*              	LHLD	LNDLT
  0EE4'   EB                    	XCHG
  0EE5'   6F                    	MOV	L,A
  0EE6'   26 00                 	MVI	H,0
  0EE8'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0EEB'   22 0000*              	SHLD	WINROW
  0EEE'   3E 01                 	MVI	A,PL_SET
  0EF0'   32 0000*              	STA	PLACE
  0EF3'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0EF4'                         MVROW:
  0EF4'   47                    	MOV	B,A
  0EF5'   CD 0EC2'              	CALL	CURRW
  0EF8'   90                    	SUB	B		; A = row now - target
  0EF9'                         MR_GO:
  0EF9'   C8                    	RZ
  0EFA'   DA 0F03'              	JC	MR_DN
  0EFD'   6F                    	MOV	L,A
  0EFE'   26 00                 	MVI	H,0
  0F00'   C3 0AF6'              	JMP	KCORE
  0F03'                         MR_DN:
  0F03'   2F                    	CMA
  0F04'   3C                    	INR	A		; A = target - row now
  0F05'   6F                    	MOV	L,A
  0F06'   26 00                 	MVI	H,0
  0F08'   C3 0A16'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0F0B'                         VC_HIGH:
  0F0B'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  0F0E'   2B                    	DCX	H		; row = count - 1
  0F0F'   7C                    	MOV	A,H
  0F10'   B7                    	ORA	A
  0F11'   3A 0000*              	LDA	SCBOT
  0F14'   C2 0F1C'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F17'   BD                    	CMP	L		; CY iff SCBOT < row
  0F18'   DA 0F1C'              	JC	VH_GO
  0F1B'   7D                    	MOV	A,L
  0F1C'                         VH_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F1C'   CD 0EF4'              	CALL	MVROW
  0F1F'   C3 095B'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F22'                         VC_MIDL:
  0F22'   CD 076D'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0F25'   CD 11B4'              	CALL	HTSCR		; HL -> the top line's rows
  0F28'   3A 0000*              	LDA	TXEND
  0F2B'   3C                    	INR	A
  0F2C'   B7                    	ORA	A
  0F2D'   1F                    	RAR
  0F2E'   3D                    	DCR	A
  0F2F'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F30'   CD 11FA'              	CALL	HTFQ
  0F33'   D2 0F37'              	JNC	VM_GO
  0F36'   2B                    	DCX	H
  0F37'                         VM_GO:
  0F37'   CD 11EF'              	CALL	HTGO
  0F3A'   C3 095B'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0F3D'                         VC_LOWL:
  0F3D'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  0F40'   2B                    	DCX	H		; count - 1
  0F41'   3A 0000*              	LDA	SCBOT
  0F44'   5F                    	MOV	E,A
  0F45'   16 00                 	MVI	D,0
  0F47'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F48'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F4B'   3E 00                 	MVI	A,0
  0F4D'   D2 0F54'              	JNC	VL_GO		; at or past the top -> row 0
  0F50'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0F53'   7D                    	MOV	A,L
  0F54'                         VL_GO:
  0F54'   CD 0EF4'              	CALL	MVROW
  0F57'   C3 095B'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F5A'                         VC_PGDN:
  0F5A'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  0F5D'   22 0000*              	SHLD	RWR
  0F60'   3A 0000*              	LDA	SCEOF
  0F63'   B7                    	ORA	A
  0F64'   CA 0F6C'              	JZ	VPD_N
  0F67'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F6A'   B7                    	ORA	A		;   top line
  0F6B'   C8                    	RZ			; it already is
  0F6C'                         VPD_N:
  0F6C'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F6F'   3C                    	INR	A
  0F70'   4F                    	MOV	C,A
  0F71'   3E 02                 	MVI	A,2
  0F73'   CD 11BB'              	CALL	HTSET		; HL -> the top line's rows
  0F76'   E5                    	PUSH	H
  0F77'   C5                    	PUSH	B
  0F78'   3A 0000*              	LDA	NEDIT
  0F7B'   4F                    	MOV	C,A
  0F7C'   CD 11FA'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F7F'   3A 0000*              	LDA	NEDIT
  0F82'   DA 0F8F'              	JC	VPD_R		; there is none: no overlap
  0F85'   3A 0000*              	LDA	HTN
  0F88'   90                    	SUB	B
  0F89'   3C                    	INR	A
  0F8A'   47                    	MOV	B,A		; the lines from it up to the table's first
  0F8B'   AF                    	XRA	A
  0F8C'   CD 1029'              	CALL	OVLAP
  0F8F'                         VPD_R:
  0F8F'   CD 1078'              	CALL	PGROWS		; RWR = the rows to go
  0F92'   C1                    	POP	B
  0F93'   E1                    	POP	H
  0F94'   CD 123B'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0F97'   DA 0FB3'              	JC	VPD_TP		; the text ended: its last line
  0F9A'   79                    	MOV	A,C
  0F9B'   B7                    	ORA	A
  0F9C'   CA 0FB3'              	JZ	VPD_TP
  0F9F'   3A 0000*              	LDA	RWMV		; part of the way down a line: its start -- unless
  0FA2'   B7                    	ORA	A		;   that is the top line still, then the next
  0FA3'   C2 0FB3'              	JNZ	VPD_TP
  0FA6'   E5                    	PUSH	H
  0FA7'   CD 11E9'              	CALL	HTIX
  0FAA'   21 0000*              	LXI	H,HTTP
  0FAD'   BE                    	CMP	M
  0FAE'   E1                    	POP	H
  0FAF'   C2 0FB3'              	JNZ	VPD_TP
  0FB2'   23                    	INX	H
  0FB3'                         VPD_TP:
  0FB3'   54                    	MOV	D,H
  0FB4'   5D                    	MOV	E,L
  0FB5'   C3 1122'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FB8'                         VC_PGUP:
  0FB8'   CD 076D'              	CALL	MOVCNT		; a cursor motion, and its count
  0FBB'   22 0000*              	SHLD	RWR
  0FBE'   3A 0000*              	LDA	SCBOF
  0FC1'   B7                    	ORA	A
  0FC2'   C0                    	RNZ
  0FC3'   CD 0EC2'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FC6'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FC8'   0E 01                 	MVI	C,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FCA'   D2 0FD1'              	JNC	VPU_1
  0FCD'   3A 0000*              	LDA	NEDIT
  0FD0'   4F                    	MOV	C,A
  0FD1'                         VPU_1:
  0FD1'   3A 0000*              	LDA	NEDIT
  0FD4'   CD 11BB'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FD7'   E5                    	PUSH	H
  0FD8'   D5                    	PUSH	D
  0FD9'   2B                    	DCX	H		; the line above the top one, and on down
  0FDA'   04                    	INR	B
  0FDB'   3E 01                 	MVI	A,1
  0FDD'   CD 1029'              	CALL	OVLAP
  0FE0'   CD 1078'              	CALL	PGROWS		; RWR = the rows to go
  0FE3'   D1                    	POP	D
  0FE4'   E1                    	POP	H
  0FE5'   43                    	MOV	B,E
  0FE6'   CD 127B'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0FE9'   DA 1006'              	JC	VPU_3		;   above it; or the file's first line
  0FEC'   79                    	MOV	A,C
  0FED'   B7                    	ORA	A
  0FEE'   CA 1006'              	JZ	VPU_3
  0FF1'   3A 0000*              	LDA	RWMV
  0FF4'   B7                    	ORA	A
  0FF5'   C2 1005'              	JNZ	VPU_2
  0FF8'   E5                    	PUSH	H
  0FF9'   CD 11E9'              	CALL	HTIX
  0FFC'   3C                    	INR	A
  0FFD'   21 0000*              	LXI	H,HTTP
  1000'   BE                    	CMP	M
  1001'   E1                    	POP	H
  1002'   CA 1006'              	JZ	VPU_3		; the first line back: all of it
  1005'                         VPU_2:
  1005'   23                    	INX	H
  1006'                         VPU_3:
  1006'   CD 11EF'              	CALL	HTGO		; the cursor on the new top line ...
  1009'   3A 0000*              	LDA	NEDIT
  100C'   4F                    	MOV	C,A
  100D'   06 00                 	MVI	B,0
  100F'   CD 11D0'              	CALL	HTRB		; ... and the lines under it measured
  1012'   E5                    	PUSH	H
  1013'   3A 0000*              	LDA	NEDIT
  1016'   4F                    	MOV	C,A
  1017'   CD 11FA'              	CALL	HTFQ		; HL -> the first the screen has not room for
  101A'   2B                    	DCX	H
  101B'   D1                    	POP	D		; DE -> the top line's rows
  101C'   EB                    	XCHG
  101D'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  1020'   D2 1025'              	JNC	VPU_4		;   fills the screen)
  1023'   54                    	MOV	D,H
  1024'   5D                    	MOV	E,L
  1025'                         VPU_4:
  1025'   EB                    	XCHG
  1026'   C3 1122'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  1029'                         OVLAP:
  1029'   32 0000*              	STA	OVDIR
  102C'   3A 0000*              	LDA	NEDIT
  102F'   D6 02                 	SUI	2
  1031'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  1032'   56                    	MOV	D,M		; D = h1
  1033'   CD 106A'              	CALL	OV_NX
  1036'   DA 1066'              	JC	OV_0
  1039'   5E                    	MOV	E,M		; E = h2
  103A'   7A                    	MOV	A,D
  103B'   83                    	ADD	E
  103C'   57                    	MOV	D,A		; D = h1 + h2
  103D'   79                    	MOV	A,C
  103E'   BA                    	CMP	D
  103F'   DA 1066'              	JC	OV_0
  1042'   CD 106A'              	CALL	OV_NX
  1045'   DA 1066'              	JC	OV_0
  1048'   7B                    	MOV	A,E
  1049'   86                    	ADD	M
  104A'   5F                    	MOV	E,A		; E = h2 + h3
  104B'   79                    	MOV	A,C
  104C'   BB                    	CMP	E
  104D'   DA 1066'              	JC	OV_0
  1050'   7A                    	MOV	A,D
  1051'   86                    	ADD	M
  1052'   57                    	MOV	D,A		; D = h1 + h2 + h3
  1053'   CD 106A'              	CALL	OV_NX
  1056'   DA 1063'              	JC	OV_1
  1059'   7B                    	MOV	A,E
  105A'   86                    	ADD	M		; h2 + h3 + h4
  105B'   5F                    	MOV	E,A
  105C'   79                    	MOV	A,C
  105D'   BB                    	CMP	E
  105E'   DA 1063'              	JC	OV_1
  1061'   BA                    	CMP	D
  1062'   D0                    	RNC			; two lines of overlap
  1063'                         OV_1:
  1063'   79                    	MOV	A,C
  1064'   3C                    	INR	A
  1065'   C9                    	RET
  1066'                         OV_0:
  1066'   79                    	MOV	A,C
  1067'   C6 02                 	ADI	2
  1069'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  106A'                         OV_NX:
  106A'   05                    	DCR	B
  106B'   37                    	STC
  106C'   C8                    	RZ
  106D'   3A 0000*              	LDA	OVDIR
  1070'   B7                    	ORA	A		; (CY off)
  1071'   CA 1076'              	JZ	OV_UP
