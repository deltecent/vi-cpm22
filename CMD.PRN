                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  28BB'                         EXTAB:
  28BB'   77 00 01              	DB	'w',0,EO_W
  28BE'   71 00 02              	DB	'q',0,EO_Q
  28C1'   77 71 03              	DB	'w','q',EO_WQ
  28C4'   78 00 04              	DB	'x',0,EO_X
  28C7'   65 00 05              	DB	'e',0,EO_E
  28CA'   73 00 06              	DB	's',0,EO_S
  28CD'   76 65 07              	DB	'v','e',EO_V
  28D0'   72 00 08              	DB	'r',0,EO_R
  28D3'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  28D4'                         EXADDR:
  28D4'   AF                    	XRA	A
  28D5'   32 2F22'              	STA	SRNGF
  28D8'   7E                    	MOV	A,M
  28D9'   FE 25                 	CPI	'%'
  28DB'   CA 2904'              	JZ	EXA_AL
  28DE'   EB                    	XCHG			; DE walks the line, HL takes the number
  28DF'   CD 2919'              	CALL	EXNUM
  28E2'   DA 2902'              	JC	EXA_NO
  28E5'   22 2F23'              	SHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  28E8'   22 2F25'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  28EB'   1A                    	LDAX	D
  28EC'   FE 2C                 	CPI	','
  28EE'   C2 28FB'              	JNZ	EXA_YS
  28F1'   13                    	INX	D
  28F2'   CD 2919'              	CALL	EXNUM
  28F5'   DA 2902'              	JC	EXA_NO		; ',' with no number: not a range at all
  28F8'   22 2F25'              	SHLD	SRNG2
  28FB'                         EXA_YS:
  28FB'   EB                    	XCHG
  28FC'   3E 01                 	MVI	A,1
  28FE'   32 2F22'              	STA	SRNGF
  2901'   C9                    	RET
  2902'                         EXA_NO:
  2902'   EB                    	XCHG
  2903'   C9                    	RET
  2904'                         EXA_AL:
  2904'   23                    	INX	H
  2905'   E5                    	PUSH	H
  2906'   21 0001               	LXI	H,1
  2909'   22 2F23'              	SHLD	SRNG1
  290C'   21 FFFF               	LXI	H,0FFFFH
  290F'   22 2F25'              	SHLD	SRNG2
  2912'   E1                    	POP	H
  2913'   3E 01                 	MVI	A,1
  2915'   32 2F22'              	STA	SRNGF
  2918'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2919'                         EXNUM:
  2919'   1A                    	LDAX	D
  291A'   D6 30                 	SUI	'0'
  291C'   D8                    	RC
  291D'   FE 0A                 	CPI	10
  291F'   3F                    	CMC
  2920'   D8                    	RC
  2921'   21 0000               	LXI	H,0
  2924'                         EXN_LP:
  2924'   1A                    	LDAX	D
  2925'   D6 30                 	SUI	'0'
  2927'   DA 2941'              	JC	EXN_DN
  292A'   FE 0A                 	CPI	10
  292C'   D2 2941'              	JNC	EXN_DN
  292F'   13                    	INX	D
  2930'   C5                    	PUSH	B
  2931'   4F                    	MOV	C,A
  2932'   06 00                 	MVI	B,0		; BC = the digit
  2934'   D5                    	PUSH	D
  2935'   54                    	MOV	D,H
  2936'   5D                    	MOV	E,L
  2937'   29                    	DAD	H		; *2
  2938'   29                    	DAD	H		; *4
  2939'   19                    	DAD	D		; *5
  293A'   29                    	DAD	H		; *10
  293B'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


  293C'   09                    	DAD	B
  293D'   C1                    	POP	B
  293E'   C3 2924'              	JMP	EXN_LP
  2941'                         EXN_DN:
  2941'   B7                    	ORA	A		; CY clear: there was a number
  2942'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2943'                         EX_S:
  2943'   7E                    	MOV	A,M
  2944'   B7                    	ORA	A
  2945'   CA 2987'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2948'   32 2F27'              	STA	SDELIM
  294B'   23                    	INX	H
  294C'   11 0000*              	LXI	D,SRCHST
  294F'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2952'   4F                    	MOV	C,A
  2953'   CD 298D'              	CALL	SCOPY
  2956'   78                    	MOV	A,B
  2957'   B7                    	ORA	A
  2958'   CA 2987'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  295B'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  295E'   3E 01                 	MVI	A,1
  2960'   32 2EEF'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2963'   11 2F39'              	LXI	D,SREPL
  2966'   0E 24                 	MVI	C,SREPMX
  2968'   CD 298D'              	CALL	SCOPY
  296B'   78                    	MOV	A,B
  296C'   32 2F38'              	STA	SREPLN
  296F'   AF                    	XRA	A
  2970'   32 2F28'              	STA	SGFLAG
  2973'   7E                    	MOV	A,M
  2974'   FE 67                 	CPI	'g'
  2976'   C2 297F'              	JNZ	EX_SG
  2979'   23                    	INX	H
  297A'   3E 01                 	MVI	A,1
  297C'   32 2F28'              	STA	SGFLAG
  297F'                         EX_SG:
  297F'   7E                    	MOV	A,M
  2980'   B7                    	ORA	A
  2981'   C2 270E'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2984'   C3 29AD'              	JMP	SUBGO
  2987'                         SUBNOP:
  2987'   21 27D6'              	LXI	H,SNOPAT
  298A'   C3 271C'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  298D'                         SCOPY:
  298D'   06 00                 	MVI	B,0
  298F'                         SCP_LP:
  298F'   78                    	MOV	A,B
  2990'   B9                    	CMP	C
  2991'   D2 29AA'              	JNC	SCP_DN		; full: what is left stays on the line, and so
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


                                				;   comes back as trailing characters
  2994'   7E                    	MOV	A,M
  2995'   B7                    	ORA	A
  2996'   CA 29AA'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2999'   E5                    	PUSH	H
  299A'   21 2F27'              	LXI	H,SDELIM
  299D'   BE                    	CMP	M
  299E'   E1                    	POP	H
  299F'   CA 29A9'              	JZ	SCP_SK
  29A2'   12                    	STAX	D
  29A3'   13                    	INX	D
  29A4'   23                    	INX	H
  29A5'   04                    	INR	B
  29A6'   C3 298F'              	JMP	SCP_LP
  29A9'                         SCP_SK:
  29A9'   23                    	INX	H
  29AA'                         SCP_DN:
  29AA'   AF                    	XRA	A
  29AB'   12                    	STAX	D
  29AC'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  29AD'                         SUBGO:
  29AD'   CD 132A'              	CALL	GZONE
  29B0'   2A 0000*              	LHLD	LNDLT
  29B3'   22 2F36'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  29B6'   21 2F33'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  29B9'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  29BC'   AF                    	XRA	A
  29BD'   32 2F29'              	STA	SANY
  29C0'   21 0000               	LXI	H,0
  29C3'   22 2F2B'              	SHLD	SBACK
  29C6'   3A 2F22'              	LDA	SRNGF
  29C9'   B7                    	ORA	A
  29CA'   CA 29DC'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  29CD'   CD 229C'              	CALL	EXRNG		; SLINES = the lines in the range
  29D0'   DA 2A58'              	JC	SUBBAD
  29D3'   2A 2F23'              	LHLD	SRNG1
  29D6'   CD 1298'              	CALL	GOLN
  29D9'   C3 29E2'              	JMP	SUBLP
  29DC'                         SUB_1L:
  29DC'   21 0001               	LXI	H,1
  29DF'   22 2F2D'              	SHLD	SLINES
  29E2'                         SUBLP:
  29E2'   CD 2A5E'              	CALL	SUBLIN		; A = 1 when this line changed
  29E5'   B7                    	ORA	A
  29E6'   CA 29F4'              	JZ	SUB_NX
  29E9'   3E 01                 	MVI	A,1
  29EB'   32 2F29'              	STA	SANY
  29EE'   21 0000               	LXI	H,0
  29F1'   22 2F2B'              	SHLD	SBACK		; the cursor is ON the last line changed
  29F4'                         SUB_NX:
  29F4'   2A 2F2D'              	LHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  29F7'   2B                    	DCX	H
  29F8'   22 2F2D'              	SHLD	SLINES
  29FB'   7C                    	MOV	A,H
  29FC'   B5                    	ORA	L
  29FD'   CA 2A1B'              	JZ	SUBDON		; the range is spent
  2A00'   21 0001               	LXI	H,1
  2A03'   AF                    	XRA	A
  2A04'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2A07'   3A 2F29'              	LDA	SANY
  2A0A'   B7                    	ORA	A
  2A0B'   CA 2A15'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2A0E'   2A 2F2B'              	LHLD	SBACK
  2A11'   23                    	INX	H
  2A12'   22 2F2B'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2A15'                         SUB_AE:
  2A15'   CD 0B34'              	CALL	ATEOF
  2A18'   D2 29E2'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2A1B'                         SUBDON:
  2A1B'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2A1E'   3A 2F29'              	LDA	SANY
  2A21'   B7                    	ORA	A
  2A22'   CA 2A40'              	JZ	SUBNFD
  2A25'   3E 01                 	MVI	A,1
  2A27'   32 2E63'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2A2A'   2A 2F2B'              	LHLD	SBACK
  2A2D'   7C                    	MOV	A,H
  2A2E'   B5                    	ORA	L
  2A2F'   CA 2A3A'              	JZ	SUB_PL
  2A32'   3E FF                 	MVI	A,0FFH
  2A34'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2A37'   CD 0000*              	CALL	CLRCNT
  2A3A'                         SUB_PL:
  2A3A'   CD 1342'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2A3D'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2A40'                         SUBNFD:
  2A40'   21 2F33'              	LXI	H,SOFFS
  2A43'   CD 03D0'              	CALL	BACKTO
  2A46'   2A 2F36'              	LHLD	SLDLTS
  2A49'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2A4C'   21 27A6'              	LXI	H,SNOTFD
  2A4F'   CD 271C'              	CALL	EXERR
  2A52'   21 0000*              	LXI	H,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A55'   C3 2717'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2A58'                         SUBBAD:
  2A58'   21 2794'              	LXI	H,SNOT
  2A5B'   C3 2711'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2A5E'                         SUBLIN:
  2A5E'   AF                    	XRA	A
  2A5F'   32 2F2A'              	STA	SLCHG
  2A62'   CD 2ADD'              	CALL	SUBBOL
  2A65'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2A68'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2A68'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2A6B'   DA 2A73'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2A6E'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2A70'   C2 2A68'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2A73'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2A73'   CD 0000*              	CALL	CUROFF
  2A76'   E5                    	PUSH	H
  2A77'   CD 191D'              	CALL	CEND
  2A7A'   D1                    	POP	D
  2A7B'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2A7E'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2A7F'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2A82'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2A83'   B7                    	ORA	A		;   span is a line, not a pair.)
  2A84'   FA 2AD6'              	JM	SUBL_D		; what is left is shorter than the pattern
  2A87'   44                    	MOV	B,H
  2A88'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2A89'   11 0000*              	LXI	D,SRCHST
  2A8C'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2A8F'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2A92'   DA 2AD6'              	JC	SUBL_D
  2A95'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2A98'   EB                    	XCHG
  2A99'   2A 0000*              	LHLD	GAPEND
  2A9C'   EB                    	XCHG
  2A9D'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2AA0'   EB                    	XCHG
  2AA1'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2AA2'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2AA5'   D1                    	POP	D
  2AA6'   19                    	DAD	D		; ... and so the match's logical offset
  2AA7'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2AAA'   3A 2F29'              	LDA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2AAD'   B7                    	ORA	A
  2AAE'   C2 2ABB'              	JNZ	SUBL_C
  2AB1'   3A 2F2A'              	LDA	SLCHG
  2AB4'   B7                    	ORA	A
  2AB5'   C2 2ABB'              	JNZ	SUBL_C
  2AB8'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2ABB'                         SUBL_C:
  2ABB'   3A 0000*              	LDA	SRCHBF
  2ABE'   6F                    	MOV	L,A
  2ABF'   26 00                 	MVI	H,0
  2AC1'   CD 0000*              	CALL	DELFWD		; the match goes
  2AC4'   11 2F38'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2AC7'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2ACA'                         SUBL_I:
  2ACA'   3E 01                 	MVI	A,1
  2ACC'   32 2F2A'              	STA	SLCHG
  2ACF'   3A 2F28'              	LDA	SGFLAG
  2AD2'   B7                    	ORA	A
  2AD3'   C2 2A73'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2AD6'                         SUBL_D:
  2AD6'   CD 2ADD'              	CALL	SUBBOL
  2AD9'   3A 2F2A'              	LDA	SLCHG
  2ADC'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2ADD'                         SUBBOL:
  2ADD'   CD 0000*              	CALL	CUROFF
  2AE0'   CD 066F'              	CALL	BOL
  2AE3'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2AE6'                         VC_SRCH:
  2AE6'   CD 0852'              	CALL	SETMOV
  2AE9'   C5                    	PUSH	B
  2AEA'   CD 077D'              	CALL	GETCNT
  2AED'   22 2F18'              	SHLD	SCNT
  2AF0'   C1                    	POP	B
  2AF1'   79                    	MOV	A,C
  2AF2'   FE 2F                 	CPI	'/'
  2AF4'   3E 00                 	MVI	A,0
  2AF6'   CA 2AFB'              	JZ	VS_DIR
  2AF9'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2AFB'                         VS_DIR:
  2AFB'   32 2EED'              	STA	SDIR
  2AFE'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2B01'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2B04'   47                    	MOV	B,A
  2B05'   CD 2045'              	CALL	RDLINE
  2B08'   B7                    	ORA	A
  2B09'   C0                    	RNZ			; cancelled: nothing happens at all
  2B0A'   3A 2EC4'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2B0D'   B7                    	ORA	A
  2B0E'   CA 2B23'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2B11'   5F                    	MOV	E,A
  2B12'   16 00                 	MVI	D,0
  2B14'   21 0000*              	LXI	H,SRCHST
  2B17'   19                    	DAD	D
  2B18'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2B1A'   7B                    	MOV	A,E
  2B1B'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2B1E'   3E 01                 	MVI	A,1
  2B20'   32 2EEF'              	STA	SHAVE
  2B23'                         VS_OLD:
  2B23'   3A 2EEF'              	LDA	SHAVE
  2B26'   B7                    	ORA	A
  2B27'   CA 2B33'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2B2A'   3A 2EED'              	LDA	SDIR
  2B2D'   32 2EEE'              	STA	SDIRE
  2B30'   C3 2B5C'              	JMP	SRCHN
  2B33'                         VS_NOP:
  2B33'   21 27D6'              	LXI	H,SNOPAT
  2B36'   C3 271C'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2B39'                         VC_N:
  2B39'   CD 0852'              	CALL	SETMOV
  2B3C'   3A 2EED'              	LDA	SDIR
  2B3F'   C3 2B49'              	JMP	VN_GO
  2B42'                         VCB_N:
  2B42'   CD 0852'              	CALL	SETMOV
  2B45'   3A 2EED'              	LDA	SDIR
  2B48'   2F                    	CMA			; the other way: 0 <-> FFH
  2B49'                         VN_GO:
  2B49'   32 2EEE'              	STA	SDIRE
  2B4C'   CD 077D'              	CALL	GETCNT
  2B4F'   22 2F18'              	SHLD	SCNT
  2B52'   3A 2EEF'              	LDA	SHAVE
  2B55'   B7                    	ORA	A
  2B56'   CA 2B33'              	JZ	VS_NOP
  2B59'   C3 2B5C'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2B5C'                         SRCHN:
  2B5C'   CD 132A'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2B5F'   CD 07A6'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2B62'                         SN_LP:
  2B62'   CD 2B97'              	CALL	SRCHGO
  2B65'   DA 2B82'              	JC	SN_BAD
  2B68'   2A 2F18'              	LHLD	SCNT
  2B6B'   2B                    	DCX	H
  2B6C'   22 2F18'              	SHLD	SCNT
  2B6F'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B70'   B5                    	ORA	L
  2B71'   C2 2B62'              	JNZ	SN_LP
  2B74'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2B77'   CD 07E3'              	CALL	BRKOFF
  2B7A'   3E 01                 	MVI	A,1
  2B7C'   32 2EFA'              	STA	GPKEEP		; land on the match, not the first non-blank
  2B7F'   C3 1342'              	JMP	GPLACE		; (which sets LNDLT itself)
  2B82'                         SN_BAD:
  2B82'   CD 07E3'              	CALL	BRKOFF
  2B85'   DA 07FB'              	JC	BRKBAK		; stopped, which is not the same as not found
  2B88'   CD 07EE'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2B8B'   21 27A6'              	LXI	H,SNOTFD
  2B8E'   CD 271C'              	CALL	EXERR
  2B91'   21 0000*              	LXI	H,SRCHST
  2B94'   C3 2717'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2B97'                         SRCHGO:
  2B97'   3E 01                 	MVI	A,1
  2B99'   32 2F21'              	STA	SSKIP		; this pass starts one past the cursor
  2B9C'   CD 2BB2'              	CALL	SRCHW
  2B9F'   D0                    	RNC
  2BA0'   CD 07E7'              	CALL	BRKQ
  2BA3'   D8                    	RC			; stopped: no second pass
  2BA4'   3A 2EEE'              	LDA	SDIRE
  2BA7'   2F                    	CMA
  2BA8'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2BAB'   AF                    	XRA	A
  2BAC'   32 2F21'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2BAF'   C3 2BB2'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2BB2'                         SRCHW:
  2BB2'   3A 2EEE'              	LDA	SDIRE
  2BB5'   32 0000*              	STA	DIRFLG
  2BB8'   21 FFFF               	LXI	H,0FFFFH
  2BBB'   22 2E60'              	SHLD	CMDCNT
  2BBE'   AF                    	XRA	A
  2BBF'   32 0000*              	STA	AUXCNT
  2BC2'                         SW_LP:
  2BC2'   CD 07E7'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2BC5'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2BC6'   CD 2BD2'              	CALL	SRCH1
  2BC9'   D0                    	RNC
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BCA'   CD 0000*              	CALL	SCRLST
  2BCD'   D2 2BC2'              	JNC	SW_LP
  2BD0'   37                    	STC
  2BD1'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2BD2'                         SRCH1:
  2BD2'   11 0000*              	LXI	D,SRCHST
  2BD5'   3A 0000*              	LDA	DIRFLG
  2BD8'   B7                    	ORA	A
  2BD9'   FA 2BFD'              	JM	SR1_BK
  2BDC'   21 0000*              	LXI	H,GAPEND
  2BDF'   CD 0000*              	CALL	FWDCNT
  2BE2'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2BE5'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2BE6'   3A 2F21'              	LDA	SSKIP
  2BE9'   B7                    	ORA	A
  2BEA'   CA 2BF3'              	JZ	SR1_FW
  2BED'   78                    	MOV	A,B
  2BEE'   B1                    	ORA	C
  2BEF'   37                    	STC
  2BF0'   C8                    	RZ			; no room for a match even before the skip
  2BF1'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2BF2'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2BF3'                         SR1_FW:
  2BF3'   CD 0000*              	CALL	MATCHF
  2BF6'   D8                    	RC
  2BF7'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2BFA'   C3 0000*              	JMP	PUTCUR
  2BFD'                         SR1_BK:
  2BFD'   21 0000*              	LXI	H,TXTBEG
  2C00'   CD 0000*              	CALL	FWDCNT
  2C03'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2C06'   D8                    	RC
  2C07'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2C0A'   CD 0000*              	CALL	MATCHB
  2C0D'   D8                    	RC
  2C0E'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2C11'                         MSGNAM:
  2C11'   E5                    	PUSH	H
  2C12'   3E 22                 	MVI	A,'"'
  2C14'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2C17'   E1                    	POP	H
  2C18'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2C19'   23                    	INX	H
  2C1A'   7E                    	MOV	A,M
  2C1B'   FE 20                 	CPI	' '
  2C1D'   C2 2C2A'              	JNZ	MN_HAS
  2C20'   21 2844'              	LXI	H,SNONM
  2C23'   CD 0000*              	CALL	OUTSTR
  2C26'   E1                    	POP	H
  2C27'   C3 2C74'              	JMP	MN_END
  2C2A'                         MN_HAS:
  2C2A'   0E 19                 	MVI	C,BF_CURDSK
  2C2C'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2C2F'   E1                    	POP	H
  2C30'   E5                    	PUSH	H
  2C31'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2C32'   BE                    	CMP	M
  2C33'   CA 2C41'              	JZ	MN_NAM
  2C36'   7E                    	MOV	A,M
  2C37'   C6 40                 	ADI	'A'-1
  2C39'   CD 0000*              	CALL	OUTCH
  2C3C'   3E 3A                 	MVI	A,':'
  2C3E'   CD 0000*              	CALL	OUTCH
  2C41'                         MN_NAM:
  2C41'   E1                    	POP	H
  2C42'   E5                    	PUSH	H
  2C43'   23                    	INX	H
  2C44'   0E 08                 	MVI	C,8
  2C46'                         MN_NM:
  2C46'   7E                    	MOV	A,M
  2C47'   FE 20                 	CPI	' '
  2C49'   CA 2C54'              	JZ	MN_EXT
  2C4C'   CD 0000*              	CALL	OUTCH
  2C4F'   23                    	INX	H
  2C50'   0D                    	DCR	C
  2C51'   C2 2C46'              	JNZ	MN_NM
  2C54'                         MN_EXT:
  2C54'   E1                    	POP	H
  2C55'   11 0009               	LXI	D,9
  2C58'   19                    	DAD	D		; the type field
  2C59'   7E                    	MOV	A,M
  2C5A'   FE 20                 	CPI	' '
  2C5C'   CA 2C74'              	JZ	MN_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C5F'   3E 2E                 	MVI	A,'.'
  2C61'   CD 0000*              	CALL	OUTCH
  2C64'   0E 03                 	MVI	C,3
  2C66'                         MN_XL:
  2C66'   7E                    	MOV	A,M
  2C67'   FE 20                 	CPI	' '
  2C69'   CA 2C74'              	JZ	MN_END
  2C6C'   CD 0000*              	CALL	OUTCH
  2C6F'   23                    	INX	H
  2C70'   0D                    	DCR	C
  2C71'   C2 2C66'              	JNZ	MN_XL
  2C74'                         MN_END:
  2C74'   3E 22                 	MVI	A,'"'
  2C76'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2C79'                         MSGFLG:
  2C79'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2C7B'   B7                    	ORA	A
  2C7C'   CA 2C8C'              	JZ	MF_RO
  2C7F'   3A 2E63'              	LDA	MODF
  2C82'   B7                    	ORA	A
  2C83'   CA 2C8C'              	JZ	MF_RO
  2C86'   21 284E'              	LXI	H,SMODM
  2C89'   CD 2CA1'              	CALL	MF_PUT
  2C8C'                         MF_RO:
  2C8C'   3A 2EDA'              	LDA	ROFLAG
  2C8F'   B7                    	ORA	A
  2C90'   CA 2C99'              	JZ	MF_NEW
  2C93'   21 2859'              	LXI	H,SROM
  2C96'   CD 2CA1'              	CALL	MF_PUT
  2C99'                         MF_NEW:
  2C99'   3A 2ED8'              	LDA	MSGNEW
  2C9C'   B7                    	ORA	A
  2C9D'   C8                    	RZ
  2C9E'   21 2864'              	LXI	H,SNEWM
  2CA1'                         MF_PUT:
  2CA1'   78                    	MOV	A,B
  2CA2'   B7                    	ORA	A
  2CA3'   C2 2CAF'              	JNZ	MF_STR
  2CA6'   06 01                 	MVI	B,1
  2CA8'   E5                    	PUSH	H
  2CA9'   3E 20                 	MVI	A,' '
  2CAB'   CD 0000*              	CALL	OUTCH
  2CAE'   E1                    	POP	H
  2CAF'                         MF_STR:
  2CAF'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2CB2'                         EMITW:
  2CB2'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CB3'   D5                    	PUSH	D
  2CB4'   06 00                 	MVI	B,0
  2CB6'   11 2710               	LXI	D,10000
  2CB9'   CD 2CD7'              	CALL	EWDIG
  2CBC'   11 03E8               	LXI	D,1000
  2CBF'   CD 2CD7'              	CALL	EWDIG
  2CC2'   11 0064               	LXI	D,100
  2CC5'   CD 2CD7'              	CALL	EWDIG
  2CC8'   11 000A               	LXI	D,10
  2CCB'   CD 2CD7'              	CALL	EWDIG
  2CCE'   7D                    	MOV	A,L		; the units digit is always printed
  2CCF'   C6 30                 	ADI	'0'
  2CD1'   CD 0000*              	CALL	OUTCH
  2CD4'   D1                    	POP	D
  2CD5'   C1                    	POP	B
  2CD6'   C9                    	RET
  2CD7'                         EWDIG:
  2CD7'   0E 00                 	MVI	C,0
  2CD9'                         EW_LP:
  2CD9'   7D                    	MOV	A,L
  2CDA'   93                    	SUB	E
  2CDB'   6F                    	MOV	L,A
  2CDC'   7C                    	MOV	A,H
  2CDD'   9A                    	SBB	D
  2CDE'   67                    	MOV	H,A
  2CDF'   DA 2CE6'              	JC	EW_DN
  2CE2'   0C                    	INR	C
  2CE3'   C3 2CD9'              	JMP	EW_LP
  2CE6'                         EW_DN:
  2CE6'   19                    	DAD	D		; one subtraction too many: give it back
  2CE7'   79                    	MOV	A,C
  2CE8'   B7                    	ORA	A
  2CE9'   C2 2CEF'              	JNZ	EW_PR
  2CEC'   78                    	MOV	A,B
  2CED'   B7                    	ORA	A
  2CEE'   C8                    	RZ			; a leading zero: write nothing
  2CEF'                         EW_PR:
  2CEF'   79                    	MOV	A,C
  2CF0'   C6 30                 	ADI	'0'
  2CF2'   CD 0000*              	CALL	OUTCH
  2CF5'   06 01                 	MVI	B,1
  2CF7'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2CF8'                         ISEMPT:
  2CF8'   2A 0000*              	LHLD	OUTPOS
  2CFB'   7C                    	MOV	A,H
  2CFC'   B5                    	ORA	L
  2CFD'   C0                    	RNZ
  2CFE'   CD 0000*              	CALL	LOGLEN
  2D01'   7C                    	MOV	A,H
  2D02'   B5                    	ORA	L
  2D03'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2D04'                         MSGCTG:
  2D04'   21 0000*              	LXI	H,FNAME
  2D07'   CD 2C11'              	CALL	MSGNAM
  2D0A'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2D0C'   CD 2C79'              	CALL	MSGFLG
  2D0F'   CD 2CF8'              	CALL	ISEMPT
  2D12'   C2 2D1B'              	JNZ	MG_POS
  2D15'   21 2877'              	LXI	H,SNOLIN
  2D18'   C3 0000*              	JMP	OUTSTR
  2D1B'                         MG_POS:
  2D1B'   21 286A'              	LXI	H,SLINE
  2D1E'   CD 0000*              	CALL	OUTSTR
  2D21'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2D24'   23                    	INX	H		;   ... so the line it is on
  2D25'   CD 2CB2'              	CALL	EMITW
  2D28'   21 2871'              	LXI	H,SCOLM
  2D2B'   CD 0000*              	CALL	OUTSTR
  2D2E'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2D31'   23                    	INX	H
  2D32'   E5                    	PUSH	H
  2D33'   CD 2CB2'              	CALL	EMITW
  2D36'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2D39'   23                    	INX	H
  2D3A'   D1                    	POP	D
  2D3B'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2D3E'   C8                    	RZ
  2D3F'   E5                    	PUSH	H
  2D40'   3E 2D                 	MVI	A,'-'
  2D42'   CD 0000*              	CALL	OUTCH
  2D45'   E1                    	POP	H
  2D46'   C3 2CB2'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2D49'                         FILMSG:
  2D49'   3A 0001*              	LDA	FNAME+1
  2D4C'   FE 20                 	CPI	' '
  2D4E'   C8                    	RZ
  2D4F'   21 0000*              	LXI	H,FNAME
  2D52'   CD 2C11'              	CALL	MSGNAM
  2D55'   AF                    	XRA	A		; nothing has been changed yet
  2D56'   C3 2C79'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2D59'                         WRMSG:
  2D59'   21 0000*              	LXI	H,TFCB
  2D5C'   CD 2C11'              	CALL	MSGNAM
  2D5F'   21 2889'              	LXI	H,SWRIT
  2D62'   C3 0000*              	JMP	OUTSTR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2D65'                         MSGPST:
  2D65'   3A 2ED7'              	LDA	MSGWHT
  2D68'   B7                    	ORA	A
  2D69'   C8                    	RZ
  2D6A'   47                    	MOV	B,A
  2D6B'   AF                    	XRA	A
  2D6C'   32 2ED7'              	STA	MSGWHT
  2D6F'   78                    	MOV	A,B
  2D70'   FE 01                 	CPI	MW_FIL
  2D72'   CA 2D8E'              	JZ	MP_FIL
  2D75'   FE 02                 	CPI	MW_WRT
  2D77'   CA 2D94'              	JZ	MP_WRT
  2D7A'   FE 04                 	CPI	MW_BIG
  2D7C'   CA 2D85'              	JZ	MP_BIG
  2D7F'   CD 2D04'              	CALL	MSGCTG
  2D82'   C3 0000*              	JMP	SCURS
  2D85'                         MP_BIG:
  2D85'   21 2825'              	LXI	H,SQBIG
  2D88'   CD 0000*              	CALL	EXMSG
  2D8B'   C3 0000*              	JMP	SCURS
  2D8E'                         MP_FIL:
  2D8E'   CD 2D49'              	CALL	FILMSG
  2D91'   C3 0000*              	JMP	SCURS
  2D94'                         MP_WRT:
  2D94'   CD 2D59'              	CALL	WRMSG
  2D97'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2D9A'                         VC_CTLG:
  2D9A'   3E 03                 	MVI	A,MW_CTG
  2D9C'   32 2ED7'              	STA	MSGWHT
  2D9F'   3E 01                 	MVI	A,R_MOVE
  2DA1'   32 2E64'              	STA	RINTENT
  2DA4'   C3 077D'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2DA7'                         CMDTAB:
  2DA7'   07                    	DB	07H			; ^G -- where am I?
  2DA8'   2D9A'                 	DW	VC_CTLG
  2DAA'   68                    	DB	'h'
  2DAB'   08CA'                 	DW	VC_H
  2DAD'   6C                    	DB	'l'
  2DAE'   08F4'                 	DW	VC_L
  2DB0'   6A                    	DB	'j'
  2DB1'   09C5'                 	DW	VC_J
  2DB3'   6B                    	DB	'k'
  2DB4'   09D7'                 	DW	VC_K
  2DB6'   30                    	DB	'0'
  2DB7'   0927'                 	DW	VC_0
  2DB9'   5E                    	DB	'^'
  2DBA'   0945'                 	DW	VC_CRT
  2DBC'   24                    	DB	'$'
  2DBD'   0983'                 	DW	VC_EOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DBF'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2DC0'   09A7'                 	DW	VC_CR
  2DC2'   77                    	DB	'w'
  2DC3'   0BB6'                 	DW	VC_W
  2DC5'   62                    	DB	'b'
  2DC6'   0C07'                 	DW	VC_B
  2DC8'   65                    	DB	'e'
  2DC9'   0D9D'                 	DW	VC_E
  2DCB'   57                    	DB	'W'
  2DCC'   0BBD'                 	DW	VCBGW
  2DCE'   42                    	DB	'B'
  2DCF'   0C0E'                 	DW	VCBGB
  2DD1'   45                    	DB	'E'
  2DD2'   0DA4'                 	DW	VCBGE
  2DD4'   47                    	DB	'G'
  2DD5'   1268'                 	DW	VC_G
  2DD7'   67                    	DB	'g'
  2DD8'   12BB'                 	DW	VC_LG
  2DDA'   78                    	DB	'x'
  2DDB'   18B2'                 	DW	VC_X
  2DDD'   5A                    	DB	'Z'
  2DDE'   20B8'                 	DW	VC_BZ
  2DE0'   66                    	DB	'f'
  2DE1'   021A'                 	DW	VC_FF
  2DE3'   46                    	DB	'F'
  2DE4'   021F'                 	DW	VC_FB
  2DE6'   74                    	DB	't'
  2DE7'   0224'                 	DW	VC_TF
  2DE9'   54                    	DB	'T'
  2DEA'   0229'                 	DW	VC_TB
  2DEC'   3B                    	DB	';'
  2DED'   0240'                 	DW	VC_SEMI
  2DEF'   2C                    	DB	','
  2DF0'   024A'                 	DW	VC_COMMA
  2DF2'   79                    	DB	'y'
  2DF3'   1BC2'                 	DW	VC_Y
  2DF5'   59                    	DB	'Y'
  2DF6'   1BCA'                 	DW	VY_YY
  2DF8'   70                    	DB	'p'
  2DF9'   1E00'                 	DW	VC_P
  2DFB'   50                    	DB	'P'
  2DFC'   1E15'                 	DW	VCB_P
  2DFE'   69                    	DB	'i'
  2DFF'   193E'                 	DW	VC_I
  2E01'   61                    	DB	'a'
  2E02'   1944'                 	DW	VC_A
  2E04'   41                    	DB	'A'
  2E05'   1964'                 	DW	VCB_A
  2E07'   49                    	DB	'I'
  2E08'   1980'                 	DW	VCB_I
  2E0A'   72                    	DB	'r'
  2E0B'   1AC2'                 	DW	VC_R
  2E0D'   52                    	DB	'R'
  2E0E'   1B1B'                 	DW	VCB_R
  2E10'   64                    	DB	'd'
  2E11'   1B30'                 	DW	VC_D
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E13'   44                    	DB	'D'
  2E14'   1897'                 	DW	VCB_D
  2E16'   43                    	DB	'C'
  2E17'   1891'                 	DW	VCB_C
  2E19'   63                    	DB	'c'
  2E1A'   1B38'                 	DW	VC_C
  2E1C'   6F                    	DB	'o'
  2E1D'   19CE'                 	DW	VC_O
  2E1F'   4F                    	DB	'O'
  2E20'   19E3'                 	DW	VCB_O
  2E22'   4A                    	DB	'J'
  2E23'   19FD'                 	DW	VCB_J
  2E25'   7E                    	DB	'~'
  2E26'   1A7F'                 	DW	VC_TILD
  2E28'   3A                    	DB	':'
  2E29'   20E3'                 	DW	VC_EX
  2E2B'   2F                    	DB	'/'
  2E2C'   2AE6'                 	DW	VC_SRCH
  2E2E'   3F                    	DB	'?'
  2E2F'   2AE6'                 	DW	VC_SRCH
  2E31'   6E                    	DB	'n'
  2E32'   2B39'                 	DW	VC_N
  2E34'   4E                    	DB	'N'
  2E35'   2B42'                 	DW	VCB_N
  2E37'   48                    	DB	'H'
  2E38'   0E61'                 	DW	VC_HIGH
  2E3A'   4D                    	DB	'M'
  2E3B'   0E78'                 	DW	VC_MIDL
  2E3D'   4C                    	DB	'L'
  2E3E'   0E93'                 	DW	VC_LOWL
  2E40'   06                    	DB	06H			; ^F -- page forward
  2E41'   0EB0'                 	DW	VC_PGDN
  2E43'   02                    	DB	02H			; ^B -- page back
  2E44'   0F0E'                 	DW	VC_PGUP
  2E46'   04                    	DB	04H			; ^D -- half page down
  2E47'   0FEF'                 	DW	VC_HFDN
  2E49'   15                    	DB	15H			; ^U -- half page up
  2E4A'   10B6'                 	DW	VC_HFUP
  2E4C'   0C                    	DB	0CH			; ^L -- redraw
  2E4D'   1265'                 	DW	VC_REDR
  2E4F'   2E                    	DB	'.'			; '.' -- repeat the last change
  2E50'   017D'                 	DW	VC_DOT
  2E52'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2E53'   0545'                 	DW	VC_UNDO
  2E55'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2E56'   032E'                 	DW	VC_MK
  2E58'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2E59'   0333'                 	DW	VC_BQ
  2E5B'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2E5C'   0338'                 	DW	VC_AQ
  2E5E'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2E5F'   00                    EDMODE: DB	EM_CMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E60'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2E62'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2E63'   00                    MODF:	DB	0		; 1 = unsaved changes
  2E64'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2E65'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2E66'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2E67'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  2E68'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2E69'   00                    LNALL:	DB	0		; 1 = this R_LINE is drawn from the line's first
                                				;   row, not the cursor's (SCRN.MAC clears it)
  2E6A'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2E6B'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2E6D'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2E6E'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2E6F'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2E70'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2E71'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2E73'   00                    HTN:	DB	0		; row table: its entries
  2E74'   00                    HTCUR:	DB	0		; ... the cursor line's
  2E75'   00                    HTTP:	DB	0		; ... the top line's
  2E76'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2E77'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2E78'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2E7A'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2E7B'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2E7C'   0000                  JKCNT:	DW	0		; j/k: count
  2E7E'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2E80'   0000                  JKMOV:	DW	0		; j: lines moved
  2E82'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2E84'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2E85'   00                    JKLST:	DB	0		; j: last byte of the scan
  2E86'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2E88'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2E8A'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2E8B'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2E8C'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2E8D'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2E8E'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2E8F'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2E91'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2E92'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2E93'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2E95'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2E96'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2E97'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2E98'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2E99'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2E9A'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2E9B'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2E9C'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2E9E'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2EA0'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2EA3'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2EA6'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2EA9'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2EAC'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2EAE'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2EB0'   0000                  CNTV:	DW	0		; motion repeat counter
  2EB2'   0000                  TTI:	DW	0		; TAILTAB scan index
  2EB4'   0000                  WKI:	DW	0		; scan index
  2EB6'   0000                  WKTERM: DW	0		; line terminator offset
  2EB8'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2EBA'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2EBB'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2EBC'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2EBE'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2EC0'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2EC2'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2EC4'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2EC5'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2EC6'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2EC7'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2EC8'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2EC9'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2ECB'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2ECC'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2ECD'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2ECF'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2ED1'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2ED2'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2ED4'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2ED6'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2ED7'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2ED8'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2ED9'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2EDA'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2EDB'   00                    PLUSF:	DB	0		; command line: '+' was given
  2EDC'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2EDD'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2EDE'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2EDF'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2EE1'   0000                  YPT:	DW	0		; yy: where the lines came from
  2EE3'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2EE5'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2EE8'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2EEA'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2EEB'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2EED'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2EEE'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2EEF'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2EF0'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2EF1'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2EF2'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2EF3'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2EF4'   0000                  FNDN:	DW	0		; occurrences still to count off
  2EF6'   0000                  FNDCUR: DW	0		; the cursor it started from
  2EF8'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2EFA'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2EFB'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2EFE'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2F01'   0000                  MKN:	DW	0		; ... how long it is
  2F03'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2F04'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2F07'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2F08'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2F09'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2F0B'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2F0D'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2F0F'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2F11'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2F14'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2F16'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2F18'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2F1A'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2F1D'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2F1F'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2F20'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2F21'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2F22'   00                    SRNGF:	DB	0		; ex: a line range was given
  2F23'   0000                  SRNG1:	DW	0		; ex: its first line
  2F25'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2F27'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2F28'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2F29'   00                    SANY:	DB	0		; ':s' something in the range has changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


  2F2A'   00                    SLCHG:	DB	0		; ':s' this line changed
  2F2B'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2F2D'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2F2F'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2F30'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2F31'   00                    RDANY:	DB	0		; ':r' something has been read in
  2F32'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2F33'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2F36'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2F38'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2F39'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
