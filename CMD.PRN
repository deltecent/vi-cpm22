  0C2A'   2A 26D1'              	LHLD	WKN
  0C2D'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C30'   D2 0C4D'              	JNC	ES_LND
  0C33'   2A 26CF'              	LHLD	WKI
  0C36'   23                    	INX	H
  0C37'   E5                    	PUSH	H		; i+1
  0C38'   CD 0000*              	CALL	CHARAT
  0C3B'   CD 0690'              	CALL	CLASSF
  0C3E'   E1                    	POP	H		; HL = i+1
  0C3F'   47                    	MOV	B,A
  0C40'   3A 26D7'              	LDA	WKCLS
