  232F'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  2330'   00                    EDMODE: DB	EM_CMD
  2331'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2333'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2334'   00                    MODF:	DB	0		; 1 = unsaved changes
  2335'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2336'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2337'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2338'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2339'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  233B'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  233C'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  233D'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  233E'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  233F'   0000                  JKCNT:	DW	0		; j/k: count
  2341'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2343'   0000                  JKMOV:	DW	0		; j: lines moved
  2345'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2347'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2348'   00                    JKLST:	DB	0		; j: last byte of the scan
  2349'   0000                  JKVC:	DW	0		; j/k landing: screen column
  234B'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  234D'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  234E'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  234F'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2350'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2351'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2352'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2354'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2355'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2356'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2358'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2359'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  235A'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  235B'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  235C'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  235D'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  235E'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  235F'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2361'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2363'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2365'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2367'   0000                  CNTV:	DW	0		; motion repeat counter
  2369'   0000                  TTI:	DW	0		; TAILTAB scan index
  236B'   0000                  WKI:	DW	0		; scan index
  236D'   0000                  WKN:	DW	0		; cached LOGLEN
  236F'   0000                  WKLO:	DW	0		; dd: range low offset
  2371'   0000                  WKTERM: DW	0		; line terminator offset
  2373'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2375'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2376'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2377'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2379'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  237B'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
  237D'   0000                  TOFFV:	DW	0		; QSNAP: cursor logical offset
  237F'   0000                  TLINEV: DW	0		; QSNAP: cursor line (0-based)
  2381'   0000                  TCOLV:	DW	0		; QSNAP: cursor column (0-based)
                                
  2383'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2385'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2386'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2387'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2388'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2389'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  238A'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  238C'   00                    WPROW:	DB	0		; :w -- the cursor's row
  238D'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  238E'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2390'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2392'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2393'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2395'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2397'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2398'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2399'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  239A'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  239B'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  239C'   00                    PLUSF:	DB	0		; command line: '+' was given
  239D'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  239E'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  239F'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  23A0'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  23A2'   0000                  YPT:	DW	0		; yy: where the lines came from
  23A4'   0000                  PCNT:	DW	0		; p/P: copies still to put
  23A6'   0000                  PPT:	DW	0		; p/P: the first line put
  23A8'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  23AA'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  23AB'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  23AD'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  23AE'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  23AF'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  23B0'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  23B1'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  23B4'   0000                  MKEDIT: DW	0		; MKDROP: where the edit that may drop them is
  23B6'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  23B7'   00                    MKHOLD: DB	0		; set across a yank's delete + put back: MKDROP
                                				;   must leave the marks alone through it
  23B8'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  23BA'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  23BC'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  23BE'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  23C0'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  23C2'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  23C4'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  23C6'   0000                  YNLF:	DW	0		; ... where the line below the cursor's starts
  23C8'   00                    YNSAW:	DB	0		; ... 1 once a line break has been seen
  23C9'   00                    YNNOP:	DB	0		; ... 1 = refused: there is nothing to yank
  23CA'   0000                  SCNT:	DW	0		; searches still to do (the count)
  23CC'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  23CE'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  23D0'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  23D1'   00                    SRNGF:	DB	0		; ex: a line range was given
  23D2'   0000                  SRNG1:	DW	0		; ex: its first line
  23D4'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  23D6'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  23D7'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  23D8'   00                    SANY:	DB	0		; ':s' something in the range has changed
  23D9'   00                    SLCHG:	DB	0		; ':s' this line changed
  23DA'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  23DC'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  23DE'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  23E0'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  23E2'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  23E3'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
