  08A0'   1B                    	DCX	D
  08A1'   7A                    	MOV	A,D
  08A2'   B3                    	ORA	E
  08A3'   C2 0892'              	JNZ	JC_SC
  08A6'   2A 290C'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  08A9'   22 2910'              	SHLD	JKMOV		;   one if the last LF found ends the file
  08AC'   3E 01                 	MVI	A,1
  08AE'   32 2914'              	STA	JKPHN
  08B1'   C3 08CF'              	JMP	JC_MV
