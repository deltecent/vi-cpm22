  0BB3'   CA 0BB9'              	JZ	EM_ST
  0BB6'   FE 0A                 	CPI	LF
  0BB8'   C0                    	RNZ
  0BB9'                         EM_ST:
  0BB9'   CD 0000*              	CALL	PEEKL
  0BBC'   DA 0BC2'              	JC	EM_Y
  0BBF'   FE 0A                 	CPI	LF
  0BC1'   C9                    	RET
  0BC2'                         EM_Y:
  0BC2'   AF                    	XRA	A
  0BC3'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BC4'                         NXLN:
  0BC4'   FE 0A                 	CPI	LF
  0BC6'   CA 0BD5'              	JZ	NX_LF
  0BC9'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BCC'   D8                    	RC
  0BCD'   FE 0A                 	CPI	LF
  0BCF'   CA 0BD5'              	JZ	NX_LF
  0BD2'   2B                    	DCX	H		; a lone CR
  0BD3'   AF                    	XRA	A
  0BD4'   C9                    	RET
  0BD5'                         NX_LF:
  0BD5'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0BD8'   D8                    	RC
  0BD9'   2B                    	DCX	H
  0BDA'   3E 01                 	MVI	A,1
  0BDC'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0BDD'                         INCC:
  0BDD'   CD 0A1D'              	CALL	ATEOF
  0BE0'   DA 0C1B'              	JC	IC_END
  0BE3'   FE 0D                 	CPI	CR
  0BE5'   CA 0C06'              	JZ	IC_NL
  0BE8'   FE 0A                 	CPI	LF
  0BEA'   CA 0C06'              	JZ	IC_NL
  0BED'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0BF0'                         IC_CH:
  0BF0'   CD 0A1D'              	CALL	ATEOF
  0BF3'   DA 0C02'              	JC	IC_2
  0BF6'   FE 0D                 	CPI	CR
  0BF8'   CA 0C02'              	JZ	IC_2
  0BFB'   FE 0A                 	CPI	LF
  0BFD'   CA 0C02'              	JZ	IC_2
  0C00'   AF                    	XRA	A
  0C01'   C9                    	RET
  0C02'                         IC_2:
  0C02'   3E 02                 	MVI	A,2
  0C04'   B7                    	ORA	A
  0C05'   C9                    	RET
