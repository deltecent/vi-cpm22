  0913'   D1                    	POP	D
  0914'   DA 091F'              	JC	JL_NX
  0917'   CA 091F'              	JZ	JL_NX
  091A'   C1                    	POP	B		; this char holds the goal column
  091B'   E1                    	POP	H
  091C'   C3 0930'              	JMP	JL_GO
  091F'                         JL_NX:
  091F'   C1                    	POP	B
  0920'   E1                    	POP	H
  0921'   13                    	INX	D
  0922'   C3 08E8'              	JMP	JL_RD
  0925'                         JL_END:
  0925'   2A 23FC'              	LHLD	JKLS		; past the line's end: its last content char
  0928'   7C                    	MOV	A,H
  0929'   A5                    	ANA	L
  092A'   3C                    	INR	A
