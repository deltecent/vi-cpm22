  0979'   DA 0984'              	JC	JL_NX
  097C'   CA 0984'              	JZ	JL_NX
  097F'   C1                    	POP	B		; this char holds the goal column
  0980'   E1                    	POP	H
  0981'   C3 0995'              	JMP	JL_GO
