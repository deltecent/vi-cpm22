  1F13'   32 268A'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1F16'   E1                    	POP	H
  1F17'   CD 0000*              	CALL	EXMSG
  1F1A'   3E 01                 	MVI	A,R_MOVE
  1F1C'   32 2623'              	STA	RINTENT
  1F1F'   37                    	STC
  1F20'   C9                    	RET
