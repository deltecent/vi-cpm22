                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   CD 00D9'              	CALL	DOTPRE
  0003'   CD 0009'              	CALL	CDMODE
  0006'   C3 0130'              	JMP	DOTPOST
  0009'                         CDMODE:
  0009'   3A 26AE'              	LDA	EDMODE
  000C'   FE 01                 	CPI	EM_INS
  000E'   CA 0019'              	JZ	CD_INS
  0011'   FE 02                 	CPI	EM_REP
  0013'   CA 001C'              	JZ	CD_REP
  0016'   C3 001F'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0019'                         CD_INS:
  0019'   C3 1A4F'              	JMP	VIINS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  001C'                         CD_REP:
  001C'   C3 198F'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  001F'                         VICMD:
  001F'   78                    	MOV	A,B
  0020'   FE 00                 	CPI	KT_NONE
  0022'   C8                    	RZ			; discarded key
  0023'   FE 01                 	CPI	KT_ACT
  0025'   CA 00AB'              	JZ	VIC_ACT
  0028'   3A 26D6'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002B'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002D'   CA 159C'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0030'   79                    	MOV	A,C
  0031'   FE 31                 	CPI	'1'
  0033'   DA 003E'              	JC	VIC_NOTD	; < '1'
  0036'   FE 3A                 	CPI	'9'+1
  0038'   D2 003E'              	JNC	VIC_NOTD	; > '9'
  003B'   C3 004E'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003E'                         VIC_NOTD:
  003E'   79                    	MOV	A,C
  003F'   FE 30                 	CPI	'0'
  0041'   C2 0076'              	JNZ	VICDSP
  0044'   2A 26AF'              	LHLD	CMDCNT
  0047'   7C                    	MOV	A,H
  0048'   B5                    	ORA	L
  0049'   CA 0076'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004C'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004E'                         VICDIG:
  004E'   2A 26AF'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0051'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0052'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0053'   29                    	DAD	H		; *2
  0054'   DA 006D'              	JC	VIC_SAT
  0057'   29                    	DAD	H		; *4
  0058'   DA 006D'              	JC	VIC_SAT
  005B'   19                    	DAD	D		; *5
  005C'   DA 006D'              	JC	VIC_SAT
  005F'   29                    	DAD	H		; *10
  0060'   DA 006D'              	JC	VIC_SAT
  0063'   79                    	MOV	A,C
  0064'   D6 30                 	SUI	'0'
  0066'   5F                    	MOV	E,A
  0067'   16 00                 	MVI	D,0
  0069'   19                    	DAD	D
  006A'   D2 0070'              	JNC	VIC_CNT
  006D'                         VIC_SAT:
  006D'   21 FFFF               	LXI	H,0FFFFH
  0070'                         VIC_CNT:
  0070'   22 26AF'              	SHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0073'   C3 06DF'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0076'                         VICDSP:
  0076'   3A 26D6'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0079'   32 26D7'              	STA	GSAVE
  007C'   AF                    	XRA	A
  007D'   32 26D6'              	STA	GPEND
  0080'   3A 26D8'              	LDA	PENDOP
  0083'   32 26D9'              	STA	PSAVE
  0086'   AF                    	XRA	A
  0087'   32 26D8'              	STA	PENDOP
  008A'   3A 26D9'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008D'   B7                    	ORA	A
  008E'   C2 0FD0'              	JNZ	OPPEND
  0091'   3A 26D7'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0094'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0096'   C2 009F'              	JNZ	VIC_TB
  0099'   79                    	MOV	A,C
  009A'   FE 5A                 	CPI	'Z'
  009C'   C2 00A5'              	JNZ	VIC_SW
  009F'                         VIC_TB:
  009F'   21 25DD'              	LXI	H,CMDTAB
  00A2'   C3 00BE'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A5'                         VIC_SW:
  00A5'   CD 06DF'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A8'   C3 0672'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AB'                         VIC_ACT:
  00AB'   AF                    	XRA	A		; action key clears all pending state
  00AC'   32 26D6'              	STA	GPEND
  00AF'   32 26D7'              	STA	GSAVE
  00B2'   32 26D8'              	STA	PENDOP
  00B5'   32 26D9'              	STA	PSAVE
  00B8'   21 2695'              	LXI	H,ACTTAB
  00BB'   C3 00BE'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BE'                         VSCANQ:
  00BE'   CD 00CA'              	CALL	VSCLK
  00C1'   CA 00A5'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C4'   E9                    	PCHL
  00C5'                         VSCAN:
  00C5'   CD 00CA'              	CALL	VSCLK
  00C8'   C8                    	RZ			; miss
  00C9'   E9                    	PCHL
  00CA'                         VSCLK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CA'   7E                    VSCAN1: MOV	A,M
  00CB'   B7                    	ORA	A
  00CC'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CD'   23                    	INX	H
  00CE'   B9                    	CMP	C
  00CF'   5E                    	MOV	E,M
  00D0'   23                    	INX	H
  00D1'   56                    	MOV	D,M
  00D2'   23                    	INX	H
  00D3'   C2 00CA'              	JNZ	VSCAN1
  00D6'   EB                    	XCHG			; HL = the handler
  00D7'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D8'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D9'                         DOTPRE:
  00D9'   3A 26CD'              	LDA	DOTRPL
  00DC'   B7                    	ORA	A
  00DD'   C0                    	RNZ			; the replay's own keys are not recorded
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   3A 26CC'              	LDA	DOTSTA
  00E4'   B7                    	ORA	A
  00E5'   CA 00F8'              	JZ	DOTP1
  00E8'   AF                    	XRA	A		; a new command: the recording starts over
  00E9'   32 26CC'              	STA	DOTSTA
  00EC'   32 26CE'              	STA	DOTOVF
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00EF'   21 0000*              	LXI	H,DOTSCR
  00F2'   22 26D0'              	SHLD	DOTSP
  00F5'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F8'                         DOTP1:
  00F8'   78                    	MOV	A,B
  00F9'   FE 00                 	CPI	KT_NONE
  00FB'   CA 0124'              	JZ	DOTPX		; a discarded key is not a keystroke
  00FE'   FE 01                 	CPI	KT_ACT
  0100'   79                    	MOV	A,C
  0101'   CA 0109'              	JZ	DOTP2
  0104'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0106'   C3 010B'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0109'                         DOTP2:
  0109'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010B'                         DOTP3:
  010B'   32 26CF'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  010E'   47                    	MOV	B,A
  010F'   2A 26D0'              	LHLD	DOTSP
  0112'   EB                    	XCHG
  0113'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0116'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0119'   D2 0128'              	JNC	DOTPOV
  011C'   2A 26D0'              	LHLD	DOTSP
  011F'   70                    	MOV	M,B
  0120'   23                    	INX	H
  0121'   22 26D0'              	SHLD	DOTSP
  0124'                         DOTPX:
  0124'   E1                    	POP	H
  0125'   D1                    	POP	D
  0126'   C1                    	POP	B
  0127'   C9                    	RET
  0128'                         DOTPOV:
  0128'   3E 01                 	MVI	A,1
  012A'   32 26CE'              	STA	DOTOVF		; too long to record: give this recording up
  012D'   C3 0124'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0130'                         DOTPOST:
  0130'   3A 26CD'              	LDA	DOTRPL
  0133'   B7                    	ORA	A
  0134'   C0                    	RNZ
  0135'   3A 26AE'              	LDA	EDMODE
  0138'   B7                    	ORA	A
  0139'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013A'   3A 26D6'              	LDA	GPEND
  013D'   B7                    	ORA	A
  013E'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  013F'   3A 26D8'              	LDA	PENDOP
  0142'   B7                    	ORA	A
  0143'   C0                    	RNZ			; an operator still waiting for its motion
  0144'   2A 26AF'              	LHLD	CMDCNT
  0147'   7C                    	MOV	A,H
  0148'   B5                    	ORA	L
  0149'   CA 0157'              	JZ	DOTQ1
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  014C'   3A 26CF'              	LDA	DOTLK		; a digit with the count still up: the command
  014F'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0151'   DA 0157'              	JC	DOTQ1
  0154'   FE 3A                 	CPI	'9'+1
  0156'   D8                    	RC
  0157'                         DOTQ1:
  0157'   3E 01                 	MVI	A,1
  0159'   32 26CC'              	STA	DOTSTA		; the next key starts a new recording
  015C'   3A 26CB'              	LDA	DOTCHG
  015F'   B7                    	ORA	A
  0160'   C8                    	RZ			; changed nothing: not a repeatable command
  0161'   AF                    	XRA	A
  0162'   32 26CB'              	STA	DOTCHG
  0165'   32 26D2'              	STA	DOTLEN
  0168'   3A 26CE'              	LDA	DOTOVF
  016B'   B7                    	ORA	A
  016C'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  016D'   2A 26D0'              	LHLD	DOTSP
  0170'   11 0000*              	LXI	D,DOTSCR
  0173'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0176'   7D                    	MOV	A,L
  0177'   32 26D2'              	STA	DOTLEN
  017A'   B7                    	ORA	A
  017B'   C8                    	RZ
  017C'   4F                    	MOV	C,A
  017D'   06 00                 	MVI	B,0
  017F'   21 0000*              	LXI	H,DOTSCR
  0182'   11 0000*              	LXI	D,DOTBUF
  0185'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0188'                         MARKMOD:
  0188'   3E 01                 	MVI	A,1
  018A'   32 26B2'              	STA	MODF
  018D'   32 26CB'              	STA	DOTCHG
  0190'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0191'                         VC_DOT:
  0191'   2A 26AF'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0194'   22 26D4'              	SHLD	DOTNCT
  0197'   21 0000               	LXI	H,0
  019A'   22 26AF'              	SHLD	CMDCNT
  019D'   3A 26D2'              	LDA	DOTLEN
  01A0'   B7                    	ORA	A
  01A1'   CA 01FB'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01A4'   AF                    	XRA	A
  01A5'   32 26D3'              	STA	DOTIX
  01A8'   2A 26D4'              	LHLD	DOTNCT
  01AB'   7C                    	MOV	A,H
  01AC'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01AD'   CA 01CD'              	JZ	DOTGO
  01B0'   22 26AF'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B3'                         DOTSKP:
  01B3'   CD 054B'              	CALL	DOTGET		; ... so step past the digits it recorded
  01B6'   DA 01CD'              	JC	DOTGO
  01B9'   FE 30                 	CPI	'0'
  01BB'   DA 01CD'              	JC	DOTGO
  01BE'   FE 3A                 	CPI	'9'+1
  01C0'   D2 01CD'              	JNC	DOTGO
  01C3'   3A 26D3'              	LDA	DOTIX
  01C6'   3C                    	INR	A
  01C7'   32 26D3'              	STA	DOTIX
  01CA'   C3 01B3'              	JMP	DOTSKP
  01CD'                         DOTGO:
  01CD'   3E 01                 	MVI	A,1
  01CF'   32 26CD'              	STA	DOTRPL
  01D2'                         DOTLP:
  01D2'   CD 054B'              	CALL	DOTGET
  01D5'   DA 01F1'              	JC	DOTDN
  01D8'   4F                    	MOV	C,A
  01D9'   06 02                 	MVI	B,KT_CHAR
  01DB'   B7                    	ORA	A
  01DC'   F2 01E4'              	JP	DOTLP2
  01DF'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E1'   4F                    	MOV	C,A
  01E2'   06 01                 	MVI	B,KT_ACT
  01E4'                         DOTLP2:
  01E4'   3A 26D3'              	LDA	DOTIX
  01E7'   3C                    	INR	A
  01E8'   32 26D3'              	STA	DOTIX
  01EB'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01EE'   C3 01D2'              	JMP	DOTLP
  01F1'                         DOTDN:
  01F1'   AF                    	XRA	A
  01F2'   32 26CD'              	STA	DOTRPL
  01F5'   32 26CB'              	STA	DOTCHG		; the '.' is not itself the new last change
  01F8'   C3 0700'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FB'                         DOTBEL:
  01FB'   0E 07                 	MVI	C,BEL
  01FD'   CD 0000*              	CALL	BCONOU
  0200'   C3 06DF'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0203'                         MKVAD:
  0203'   16 00                 	MVI	D,0
  0205'   59                    	MOV	E,C
  0206'   21 273D'              	LXI	H,MKVAL
  0209'   19                    	DAD	D
  020A'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020B'                         MKCLR:
  020B'   21 273D'              	LXI	H,MKVAL
  020E'   06 03                 	MVI	B,MKMAX
  0210'   AF                    	XRA	A
  0211'                         MKC_LP:
  0211'   77                    	MOV	M,A
  0212'   23                    	INX	H
  0213'   05                    	DCR	B
  0214'   C2 0211'              	JNZ	MKC_LP
  0217'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  0218'                         MKGETK:
  0218'   3A 26CD'              	LDA	DOTRPL
  021B'   B7                    	ORA	A
  021C'   CA 022D'              	JZ	MKG_KB
  021F'   CD 054B'              	CALL	DOTGET		; the recording's next key
  0222'   D8                    	RC
  0223'   4F                    	MOV	C,A
  0224'   3A 26D3'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0227'   3C                    	INR	A
  0228'   32 26D3'              	STA	DOTIX
  022B'   B7                    	ORA	A		; CY clear
  022C'   C9                    	RET
  022D'                         MKG_KB:
  022D'   CD 0000*              	CALL	GETKEY
  0230'   78                    	MOV	A,B
  0231'   FE 02                 	CPI	KT_CHAR
  0233'   37                    	STC
  0234'   C0                    	RNZ			; an action key (ESC) cancels the command
  0235'   B7                    	ORA	A		; CY clear
  0236'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  0237'                         VC_FF:				; 'f' -- forward, onto the character
  0237'   3E 66                 	MVI	A,'f'
  0239'   C3 0248'              	JMP	FNDNEW
  023C'                         VC_FB:				; 'F' -- backward, onto it
  023C'   3E 46                 	MVI	A,'F'
  023E'   C3 0248'              	JMP	FNDNEW
  0241'                         VC_TF:				; 't' -- forward, up to it
  0241'   3E 74                 	MVI	A,'t'
  0243'   C3 0248'              	JMP	FNDNEW
  0246'                         VC_TB:				; 'T' -- backward, up to it
  0246'   3E 54                 	MVI	A,'T'
  0248'                         FNDNEW:
  0248'   32 2732'              	STA	FNDKND		; the find ';' and ',' will repeat
  024B'   CD 0218'              	CALL	MKGETK		; the character it looks for
  024E'   DA 0285'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0251'   79                    	MOV	A,C
  0252'   32 2733'              	STA	FNDCH
  0255'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  0257'   CD 00D9'              	CALL	DOTPRE
  025A'   3A 2732'              	LDA	FNDKND
  025D'   06 01                 	MVI	B,1		; a find starts at the next character along
  025F'   C3 028C'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0262'                         VC_SEMI:
  0262'   3A 2732'              	LDA	FNDKND
  0265'   B7                    	ORA	A
  0266'   CA 0285'              	JZ	FNDNIL		; nothing has been looked for yet
  0269'   C3 0275'              	JMP	FNDREP
  026C'                         VC_COMMA:
  026C'   3A 2732'              	LDA	FNDKND
  026F'   B7                    	ORA	A
  0270'   CA 0285'              	JZ	FNDNIL
  0273'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0275'                         FNDREP:
  0275'   06 01                 	MVI	B,1
  0277'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0278'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027A'   FE 54                 	CPI	'T'
  027C'   C2 0281'              	JNZ	FNDR_GO
  027F'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0281'                         FNDR_GO:
  0281'   F1                    	POP	PSW
  0282'   C3 028C'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0285'                         FNDNIL:
  0285'   AF                    	XRA	A
  0286'   32 26D9'              	STA	PSAVE
  0289'   C3 06DF'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  028C'                         FNDGO:
  028C'   32 2734'              	STA	FNDRUN
  028F'   78                    	MOV	A,B
  0290'   32 2735'              	STA	FNDSTP
  0293'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0296'   22 2736'              	SHLD	FNDN		; the occurrence wanted
  0299'   CD 0000*              	CALL	CUROFF
  029C'   22 2738'              	SHLD	FNDCUR
  029F'   3A 2734'              	LDA	FNDRUN
  02A2'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A4'   CA 02D8'              	JZ	FNDBWD
  02A7'   2A 2738'              	LHLD	FNDCUR
  02AA'   CD 060A'              	CALL	EOLC		; HL = the line's last content character
  02AD'   22 273A'              	SHLD	FNDLIM
  02B0'   2A 2738'              	LHLD	FNDCUR
  02B3'   3A 2735'              	LDA	FNDSTP
  02B6'   5F                    	MOV	E,A
  02B7'   16 00                 	MVI	D,0
  02B9'   19                    	DAD	D		; HL = where the scan starts
  02BA'                         FNDF_LP:
  02BA'   EB                    	XCHG			; DE = the scan
  02BB'   2A 273A'              	LHLD	FNDLIM
  02BE'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C1'   EB                    	XCHG			; HL = the scan
  02C2'   CA 02C8'              	JZ	FNDF_AT		; the last character is still a candidate
  02C5'   D2 032A'              	JNC	FNDMIS		; past it: not on this line
  02C8'                         FNDF_AT:
  02C8'   CD 0331'              	CALL	FNDSEE		; Z iff this is the character
  02CB'   C2 02D4'              	JNZ	FNDF_NX
  02CE'   CD 033C'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D1'   CA 0310'              	JZ	FNDHIT
  02D4'                         FNDF_NX:
  02D4'   23                    	INX	H
  02D5'   C3 02BA'              	JMP	FNDF_LP
  02D8'                         FNDBWD:
  02D8'   2A 2738'              	LHLD	FNDCUR
  02DB'   CD 05CB'              	CALL	BOL		; HL = the line's first character
  02DE'   22 273A'              	SHLD	FNDLIM
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02E1'   2A 2738'              	LHLD	FNDCUR
  02E4'   3A 2735'              	LDA	FNDSTP
  02E7'   2F                    	CMA
  02E8'   5F                    	MOV	E,A
  02E9'   16 FF                 	MVI	D,0FFH
  02EB'   13                    	INX	D		; DE = -step
  02EC'   19                    	DAD	D		; HL = where the scan starts
  02ED'   D2 032A'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F0'                         FNDB_LP:
  02F0'   EB                    	XCHG			; DE = the scan
  02F1'   2A 273A'              	LHLD	FNDLIM
  02F4'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02F7'   EB                    	XCHG			; HL = the scan
  02F8'   DA 032A'              	JC	FNDMIS		; before this line: not on it
  02FB'   CD 0331'              	CALL	FNDSEE
  02FE'   C2 0307'              	JNZ	FNDB_NX
  0301'   CD 033C'              	CALL	FNDCNT
  0304'   CA 0310'              	JZ	FNDHIT
  0307'                         FNDB_NX:
  0307'   7C                    	MOV	A,H
  0308'   B5                    	ORA	L
  0309'   CA 032A'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  030C'   2B                    	DCX	H
  030D'   C3 02F0'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0310'                         FNDHIT:
  0310'   3A 2734'              	LDA	FNDRUN
  0313'   E6 5F                 	ANI	5FH
  0315'   FE 54                 	CPI	'T'
  0317'   C2 0327'              	JNZ	FNDLND
  031A'   3A 2734'              	LDA	FNDRUN
  031D'   E6 20                 	ANI	20H
  031F'   CA 0326'              	JZ	FNDH_BW
  0322'   2B                    	DCX	H		; forward 't': the character before it
  0323'   C3 0327'              	JMP	FNDLND
  0326'                         FNDH_BW:
  0326'   23                    	INX	H		; backward 'T': the character after it
  0327'                         FNDLND:
  0327'   C3 0561'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032A'                         FNDMIS:
  032A'   AF                    	XRA	A
  032B'   32 26D9'              	STA	PSAVE
  032E'   C3 01FB'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0331'                         FNDSEE:
  0331'   E5                    	PUSH	H
  0332'   CD 0000*              	CALL	CHARAT
  0335'   E1                    	POP	H
  0336'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0337'   3A 2733'              	LDA	FNDCH
  033A'   B8                    	CMP	B
  033B'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  033C'                         FNDCNT:
  033C'   E5                    	PUSH	H
  033D'   2A 2736'              	LHLD	FNDN
  0340'   2B                    	DCX	H
  0341'   22 2736'              	SHLD	FNDN
  0344'   7C                    	MOV	A,H
  0345'   B5                    	ORA	L
  0346'   E1                    	POP	H
  0347'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0348'                         ISFIND:
  0348'   E6 5F                 	ANI	5FH		; fold the case away
  034A'   FE 46                 	CPI	'F'
  034C'   C8                    	RZ
  034D'   FE 54                 	CPI	'T'
  034F'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0350'                         VC_MK:
  0350'   3E 04                 	MVI	A,PM
  0352'   C3 035C'              	JMP	MKGO
  0355'                         VC_BQ:
  0355'   3E 05                 	MVI	A,PJ
  0357'   C3 035C'              	JMP	MKGO
  035A'                         VC_AQ:
  035A'   3E 06                 	MVI	A,PJL
  035C'                         MKGO:
  035C'   32 2749'              	STA	MKWHAT
  035F'   CD 065F'              	CALL	MOVCNT		; a count means nothing on any of the three
  0362'   CD 0218'              	CALL	MKGETK		; the key that names the mark
  0365'   DA 042F'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0368'                         MKOP:
  0368'   79                    	MOV	A,C
  0369'   D6 61                 	SUI	'a'
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  036B'   FE 03                 	CPI	MKMAX
  036D'   D2 0427'              	JNC	MKNOLT		; not a mark letter
  0370'   4F                    	MOV	C,A		; C = the mark's index
  0371'   87                    	ADD	A
  0372'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0373'   5F                    	MOV	E,A
  0374'   16 00                 	MVI	D,0
  0376'   21 0000*              	LXI	H,MKTAB
  0379'   19                    	DAD	D		; HL -> this mark's slot
  037A'   3A 2749'              	LDA	MKWHAT
  037D'   FE 04                 	CPI	PM
  037F'   CA 0442'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0382'                         MKJMP:
  0382'   E5                    	PUSH	H
  0383'   CD 0203'              	CALL	MKVAD
  0386'   7E                    	MOV	A,M
  0387'   E1                    	POP	H
  0388'   B7                    	ORA	A
  0389'   CA 041D'              	JZ	MKNSET		; never set
  038C'   CD 03E9'              	CALL	MKLOAD		; the file position it holds
  038F'   CD 03F6'              	CALL	MKWIN
  0392'   DA 03A9'              	JC	MKJ_GO		; in the window: any command may go there
  0395'   3A 26D9'              	LDA	PSAVE
  0398'   B7                    	ORA	A
  0399'   CA 03A9'              	JZ	MKJ_GO
  039C'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  039E'   C2 042F'              	JNZ	MKBAD
  03A1'   3A 2749'              	LDA	MKWHAT
  03A4'   FE 06                 	CPI	PJL
  03A6'   C2 042F'              	JNZ	MKBAD
  03A9'                         MKJ_GO:
  03A9'   CD 0ED3'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03AC'   CD 03C2'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03AF'   3A 2749'              	LDA	MKWHAT
  03B2'   FE 06                 	CPI	PJL
  03B4'   CA 03BC'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03B7'   3E 01                 	MVI	A,1		;   non-blank
  03B9'   32 273C'              	STA	GPKEEP		; '`': land on the column it was set at
  03BC'                         MKJ_LN:
  03BC'   CD 0000*              	CALL	GOTO
  03BF'   C3 0EEB'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03C2'                         MKPAGE:
  03C2'   CD 03F6'              	CALL	MKWIN
  03C5'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03C8'   32 0000*              	STA	DIRFLG
  03CB'   21 FFFF               	LXI	H,0FFFFH
  03CE'   22 26AF'              	SHLD	CMDCNT
  03D1'   CD 0000*              	CALL	GOLINE
  03D4'   CD 0000*              	CALL	SCRLST
  03D7'   CD 0687'              	CALL	CNTTST
  03DA'   C2 03C2'              	JNZ	MKPAGE
  03DD'   CD 03F6'              	CALL	MKWIN		; the file ran out: that was its last step
  03E0'   DA 0000*              	JC	CLRCNT
  03E3'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03E6'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03E9'                         MKLOAD:
  03E9'   5E                    	MOV	E,M
  03EA'   23                    	INX	H
  03EB'   56                    	MOV	D,M
  03EC'   23                    	INX	H
  03ED'   7E                    	MOV	A,M
  03EE'   EB                    	XCHG
  03EF'   22 2746'              	SHLD	MKPOS
  03F2'   32 2748'              	STA	MKPOS+2
  03F5'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03F6'                         MKWIN:
  03F6'   2A 0000*              	LHLD	TXTBEG
  03F9'   CD 0E8D'              	CALL	FPOS
  03FC'   EB                    	XCHG
  03FD'   47                    	MOV	B,A		; B:DE = the window's first byte
  03FE'   2A 2746'              	LHLD	MKPOS
  0401'   3A 2748'              	LDA	MKPOS+2
  0404'   CD 0E80'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0407'   DA 0419'              	JC	MKW_BK		; above it
  040A'   C2 0417'              	JNZ	MKW_FW		; 64K or more below it
  040D'   E5                    	PUSH	H
  040E'   CD 0000*              	CALL	LOGLEN
  0411'   D1                    	POP	D
  0412'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0415'   EB                    	XCHG
  0416'   D8                    	RC			; inside
  0417'                         MKW_FW:
  0417'   AF                    	XRA	A
  0418'   C9                    	RET
  0419'                         MKW_BK:
  0419'   3E FF                 	MVI	A,0FFH
  041B'   B7                    	ORA	A
  041C'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  041D'                         MKNSET:
  041D'   AF                    	XRA	A
  041E'   32 26D9'              	STA	PSAVE
  0421'   21 2080'              	LXI	H,SMKNS
  0424'   C3 1F81'              	JMP	EXERR
  0427'                         MKNOLT:
  0427'   3A 2749'              	LDA	MKWHAT
  042A'   FE 04                 	CPI	PM
  042C'   C2 041D'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  042F'                         MKBAD:
  042F'   AF                    	XRA	A
  0430'   32 26D9'              	STA	PSAVE
  0433'   C3 01FB'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0436'                         FPSTO:
  0436'   E5                    	PUSH	H
  0437'   CD 0E8A'              	CALL	CURFP		; A:HL = the cursor's file position
  043A'   EB                    	XCHG
  043B'   E1                    	POP	H
  043C'   73                    	MOV	M,E
  043D'   23                    	INX	H
  043E'   72                    	MOV	M,D
  043F'   23                    	INX	H
  0440'   77                    	MOV	M,A
  0441'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0442'                         MKSET:
  0442'   CD 0436'              	CALL	FPSTO
  0445'   CD 0203'              	CALL	MKVAD
  0448'   36 01                 	MVI	M,1		; ... and the mark is live
  044A'   C3 06DF'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  044D'                         MKSHFT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  044D'   32 2745'              	STA	MKTYP
  0450'   3A 274A'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0453'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  0454'   C0                    	RNZ			;   every mark points into is still there
  0455'   C5                    	PUSH	B
  0456'   50                    	MOV	D,B
  0457'   59                    	MOV	E,C
  0458'   EB                    	XCHG
  0459'   22 2743'              	SHLD	MKN		; the edit's length
  045C'   D5                    	PUSH	D		; ... and its offset
  045D'   CD 0000*              	CALL	CUROFF
  0460'   D1                    	POP	D
  0461'   CD 0000*              	CALL	SUBHD
  0464'   EB                    	XCHG			; DE = how far behind the cursor it is
  0465'   CD 0E8A'              	CALL	CURFP		; A:HL = the cursor's file position
  0468'   06 00                 	MVI	B,0
  046A'   CD 0E80'              	CALL	SUB24
  046D'   22 2740'              	SHLD	MKEDIT
  0470'   32 2742'              	STA	MKEDIT+2	; where in the file the edit is
  0473'   21 273D'              	LXI	H,MKVAL
  0476'   11 0000*              	LXI	D,MKTAB
  0479'   06 03                 	MVI	B,MKMAX
  047B'                         MKS_LP:
  047B'   7E                    	MOV	A,M
  047C'   B7                    	ORA	A
  047D'   CA 04E9'              	JZ	MKS_N0		; that mark is not set
  0480'   E5                    	PUSH	H
  0481'   C5                    	PUSH	B
  0482'   21 2740'              	LXI	H,MKEDIT
  0485'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  0486'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  0487'   4F                    	MOV	C,A
  0488'   13                    	INX	D
  0489'   23                    	INX	H
  048A'   1A                    	LDAX	D
  048B'   9E                    	SBB	M
  048C'   47                    	MOV	B,A
  048D'   13                    	INX	D
  048E'   23                    	INX	H
  048F'   1A                    	LDAX	D
  0490'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  0491'   DA 04E4'              	JC	MKS_PP		; before it: nothing moves
  0494'   6F                    	MOV	L,A
  0495'   3A 2745'              	LDA	MKTYP
  0498'   3D                    	DCR	A
  0499'   CA 04BE'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  049C'   7D                    	MOV	A,L
  049D'   2A 2743'              	LHLD	MKN
  04A0'   B7                    	ORA	A
  04A1'   C2 04AD'              	JNZ	MKS_DL		; 64K or more past it
  04A4'   79                    	MOV	A,C
  04A5'   95                    	SUB	L
  04A6'   78                    	MOV	A,B
  04A7'   9C                    	SBB	H
  04A8'   D2 04AD'              	JNC	MKS_DL		; past the end of what goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04AB'   60                    	MOV	H,B
  04AC'   69                    	MOV	L,C		; inside it: close up to the edit
  04AD'                         MKS_DL:
  04AD'   1B                    	DCX	D
  04AE'   1B                    	DCX	D
  04AF'   1A                    	LDAX	D
  04B0'   95                    	SUB	L
  04B1'   12                    	STAX	D
  04B2'   13                    	INX	D
  04B3'   1A                    	LDAX	D
  04B4'   9C                    	SBB	H
  04B5'   12                    	STAX	D
  04B6'   13                    	INX	D
  04B7'   1A                    	LDAX	D
  04B8'   DE 00                 	SBI	0
  04BA'   12                    	STAX	D
  04BB'   C3 04E4'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04BE'                         MKS_IN:
  04BE'   7D                    	MOV	A,L
  04BF'   B0                    	ORA	B
  04C0'   B1                    	ORA	C
  04C1'   C2 04D3'              	JNZ	MKS_AD		; the mark is past it
  04C4'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04C7'   2B                    	DCX	H
  04C8'   7E                    	MOV	A,M		; the last byte that went in
  04C9'   FE 0A                 	CPI	LF
  04CB'   CA 04D3'              	JZ	MKS_AD
  04CE'   FE 0D                 	CPI	CR
  04D0'   C2 04E4'              	JNZ	MKS_PP
  04D3'                         MKS_AD:
  04D3'   2A 2743'              	LHLD	MKN
  04D6'   1B                    	DCX	D
  04D7'   1B                    	DCX	D
  04D8'   1A                    	LDAX	D
  04D9'   85                    	ADD	L
  04DA'   12                    	STAX	D
  04DB'   13                    	INX	D
  04DC'   1A                    	LDAX	D
  04DD'   8C                    	ADC	H
  04DE'   12                    	STAX	D
  04DF'   13                    	INX	D
  04E0'   1A                    	LDAX	D
  04E1'   CE 00                 	ACI	0
  04E3'   12                    	STAX	D
  04E4'                         MKS_PP:
  04E4'   C1                    	POP	B
  04E5'   E1                    	POP	H
  04E6'   C3 04EB'              	JMP	MKS_NX
  04E9'                         MKS_N0:
  04E9'   13                    	INX	D
  04EA'   13                    	INX	D
  04EB'                         MKS_NX:
  04EB'   13                    	INX	D
  04EC'   13                    	INX	D
  04ED'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04EE'   05                    	DCR	B
  04EF'   C2 047B'              	JNZ	MKS_LP
  04F2'   C1                    	POP	B
  04F3'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  04F4'                         VC_UNDO:
  04F4'   21 0000               	LXI	H,0
  04F7'   22 26AF'              	SHLD	CMDCNT
  04FA'   CD 0000*              	CALL	UNDO
  04FD'   DA 052E'              	JC	UNDNO
  0500'   2A 0000*              	LHLD	UNDCUR
  0503'   CD 0514'              	CALL	UCLAMP		; vi never sits on a line terminator
  0506'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0509'   3E 01                 	MVI	A,1
  050B'   32 26B2'              	STA	MODF		; undone past a ':w' still differs from the file
  050E'   CD 0852'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0511'   C3 0700'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0514'                         UCLAMP:
  0514'   E5                    	PUSH	H
  0515'   CD 13E7'              	CALL	CEND		; HL = the line's content end
  0518'   D1                    	POP	D		; DE = the offset wanted
  0519'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  051C'   D2 0521'              	JNC	UCL_BK
  051F'   EB                    	XCHG
  0520'   C9                    	RET
  0521'                         UCL_BK:
  0521'   E5                    	PUSH	H		; the content end
  0522'   EB                    	XCHG			; HL = the offset wanted
  0523'   CD 05CB'              	CALL	BOL
  0526'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0527'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  052A'   EB                    	XCHG			; HL = the content end
  052B'   C8                    	RZ
  052C'   2B                    	DCX	H		; ... its last character
  052D'   C9                    	RET
  052E'                         UNDNO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052E'   3A 0000*              	LDA	UNDWHY
  0531'   B7                    	ORA	A
  0532'   CA 0543'              	JZ	UNDBEL
  0535'   21 203A'              	LXI	H,SUNDW		; the change has paged away: say so
  0538'   FE 01                 	CPI	1
  053A'   CA 1F81'              	JZ	EXERR
  053D'   21 205C'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0540'   C3 1F81'              	JMP	EXERR
  0543'                         UNDBEL:
  0543'   0E 07                 	MVI	C,BEL
  0545'   CD 0000*              	CALL	BCONOU
  0548'   C3 06DF'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  054B'                         DOTGET:
  054B'   3A 26D3'              	LDA	DOTIX
  054E'   5F                    	MOV	E,A
  054F'   3A 26D2'              	LDA	DOTLEN
  0552'   BB                    	CMP	E
  0553'   CA 055F'              	JZ	DOTGEF
  0556'   16 00                 	MVI	D,0
  0558'   21 0000*              	LXI	H,DOTBUF
  055B'   19                    	DAD	D
  055C'   7E                    	MOV	A,M
  055D'   B7                    	ORA	A		; CY clear: a key was returned
  055E'   C9                    	RET
  055F'                         DOTGEF:
  055F'   37                    	STC
  0560'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0561'                         GOSET:
  0561'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0564'                         SETGL:
  0564'   CD 0EAD'              	CALL	ZSAVE
  0567'   21 0000               	LXI	H,0
  056A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  056D'   E5                    	PUSH	H
  056E'   CD 0EC0'              	CALL	ZREST
  0571'   E1                    	POP	H
  0572'   E5                    	PUSH	H
  0573'   CD 066B'              	CALL	GBSUB		; HL = bytes to the cursor
  0576'   44                    	MOV	B,H
  0577'   4D                    	MOV	C,L
  0578'   E1                    	POP	H		; HL = the line's start
  0579'   11 0000               	LXI	D,0		; DE = screen column
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057C'                         SG_LP:
  057C'   78                    	MOV	A,B
  057D'   B1                    	ORA	C
  057E'   CA 0593'              	JZ	SG_CUR
  0581'   7E                    	MOV	A,M
  0582'   23                    	INX	H
  0583'   0B                    	DCX	B
  0584'   E5                    	PUSH	H
  0585'   6B                    	MOV	L,E
  0586'   CD 05B8'              	CALL	CWID
  0589'   E1                    	POP	H
  058A'   83                    	ADD	E
  058B'   5F                    	MOV	E,A
  058C'   D2 057C'              	JNC	SG_LP
  058F'   14                    	INR	D
  0590'   C3 057C'              	JMP	SG_LP
  0593'                         SG_CUR:
  0593'   2A 0000*              	LHLD	TXTEND
  0596'   D5                    	PUSH	D
  0597'   EB                    	XCHG
  0598'   2A 0000*              	LHLD	GAPEND
  059B'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  059E'   D1                    	POP	D
  059F'   CA 05B3'              	JZ	SG_SET
  05A2'   7E                    	MOV	A,M
  05A3'   FE 09                 	CPI	TAB
  05A5'   C2 05B3'              	JNZ	SG_SET
  05A8'   6B                    	MOV	L,E
  05A9'   CD 05B8'              	CALL	CWID
  05AC'   3D                    	DCR	A		; the TAB's last column
  05AD'   83                    	ADD	E
  05AE'   5F                    	MOV	E,A
  05AF'   D2 05B3'              	JNC	SG_SET
  05B2'   14                    	INR	D
  05B3'                         SG_SET:
  05B3'   EB                    	XCHG
  05B4'   22 26B7'              	SHLD	GOALCOL
  05B7'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05B8'                         CWID:
  05B8'   FE 0D                 	CPI	CR
  05BA'   CA 05C9'              	JZ	CW_0
  05BD'   FE 09                 	CPI	TAB
  05BF'   3E 01                 	MVI	A,1
  05C1'   C0                    	RNZ
  05C2'   7D                    	MOV	A,L
  05C3'   E6 07                 	ANI	TABWID-1
  05C5'   2F                    	CMA
  05C6'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05C8'   C9                    	RET
  05C9'                         CW_0:
  05C9'   AF                    	XRA	A
  05CA'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05CB'                         BOL:
  05CB'                         BOL_LP:
  05CB'   7C                    	MOV	A,H
  05CC'   B5                    	ORA	L
  05CD'   C8                    	RZ			; at 0
  05CE'   2B                    	DCX	H		; look at off-1
  05CF'   E5                    	PUSH	H
  05D0'   CD 0000*              	CALL	CHARAT
  05D3'   E1                    	POP	H		; HL = off-1
  05D4'   FE 0A                 	CPI	LF
  05D6'   CA 05DC'              	JZ	BOL_DN
  05D9'   C3 05CB'              	JMP	BOL_LP
  05DC'                         BOL_DN:
  05DC'   23                    	INX	H		; line starts just after the LF
  05DD'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05DE'                         EOLNL:
  05DE'   E5                    	PUSH	H
  05DF'   CD 0000*              	CALL	LOGLEN
  05E2'   22 26F7'              	SHLD	WKN
  05E5'   E1                    	POP	H
  05E6'                         ENL_LP:
  05E6'   EB                    	XCHG			; DE = i
  05E7'   2A 26F7'              	LHLD	WKN
  05EA'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  05ED'   EB                    	XCHG			; HL = i, DE = n
  05EE'   D0                    	RNC			; i >= n: no LF on this line
  05EF'   E5                    	PUSH	H
  05F0'   CD 0000*              	CALL	CHARAT
  05F3'   E1                    	POP	H
  05F4'   FE 0A                 	CPI	LF
  05F6'   C8                    	RZ			; the LF: HL is its offset
  05F7'   23                    	INX	H
  05F8'   C3 05E6'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  05FB'                         NLSTART:
  05FB'   CD 05DE'              	CALL	EOLNL
  05FE'   E5                    	PUSH	H
  05FF'   CD 0000*              	CALL	LOGLEN
  0602'   D1                    	POP	D		; DE = eol result
  0603'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  0606'   C8                    	RZ			; no next line: HL = LOGLEN
  0607'   EB                    	XCHG			; HL = eol
  0608'   23                    	INX	H
  0609'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  060A'                         EOLC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060A'   E5                    	PUSH	H
  060B'   CD 05DE'              	CALL	EOLNL
  060E'   22 26F9'              	SHLD	WKTERM
  0611'   E1                    	POP	H
  0612'   CD 05CB'              	CALL	BOL
  0615'   22 26FB'              	SHLD	WKBOL
  0618'   2A 26F9'              	LHLD	WKTERM
  061B'   EB                    	XCHG			; DE = term
  061C'   2A 26FB'              	LHLD	WKBOL
  061F'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0622'   CA 0641'              	JZ	EOLC_MT
  0625'   EB                    	XCHG			; HL = term
  0626'   2B                    	DCX	H		; term-1
  0627'   E5                    	PUSH	H
  0628'   CD 0000*              	CALL	CHARAT
  062B'   E1                    	POP	H		; HL = term-1
  062C'   FE 0D                 	CPI	CR
  062E'   CA 0634'              	JZ	EOLC_CR		; content ends at term-1
  0631'   C3 0635'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0634'                         EOLC_CR:
  0634'   2B                    	DCX	H		; last = (term-1) - 1
  0635'                         EOLC_LS:
  0635'   EB                    	XCHG			; DE = last
  0636'   2A 26FB'              	LHLD	WKBOL
  0639'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  063C'   DA 0641'              	JC	EOLC_MT
  063F'   EB                    	XCHG			; HL = last
  0640'   C9                    	RET
  0641'                         EOLC_MT:
  0641'   2A 26FB'              	LHLD	WKBOL
  0644'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0645'                         COL:
  0645'   E5                    	PUSH	H
  0646'   CD 05CB'              	CALL	BOL
  0649'   D1                    	POP	D		; DE = off
  064A'   EB                    	XCHG			; HL = off, DE = bol
  064B'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  064E'                         ATENDQ:
  064E'   CD 0000*              	CALL	CUROFF
  0651'   E5                    	PUSH	H
  0652'   CD 0000*              	CALL	LOGLEN
  0655'   D1                    	POP	D		; DE = cur
  0656'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0659'                         CURCHR:
  0659'   CD 0000*              	CALL	CUROFF
  065C'   C3 0000*              	JMP	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  065F'                         MOVCNT:
  065F'   CD 06DF'              	CALL	SETMOV
  0662'   C3 0672'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0665'                         CNTOFF:
  0665'   CD 0672'              	CALL	GETCNT
  0668'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  066B'                         GBSUB:
  066B'   EB                    	XCHG
  066C'   2A 0000*              	LHLD	GAPBEG
  066F'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0672'                         GETCNT:
  0672'   2A 26AF'              	LHLD	CMDCNT
  0675'   7C                    	MOV	A,H
  0676'   B5                    	ORA	L
  0677'   C2 067E'              	JNZ	GC_HAVE
  067A'   21 0001               	LXI	H,1
  067D'   C9                    	RET
  067E'                         GC_HAVE:
  067E'   E5                    	PUSH	H
  067F'   21 0000               	LXI	H,0
  0682'   22 26AF'              	SHLD	CMDCNT
  0685'   E1                    	POP	H
  0686'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0687'                         CNTTST:				; WM 1175
  0687'   E5                    	PUSH	H
  0688'   2A 26AF'              	LHLD	CMDCNT
  068B'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  068E'   B4                    	ORA	H
  068F'   B5                    	ORA	L
  0690'   E1                    	POP	H
  0691'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0694'                         CLASSF:
  0694'   47                    	MOV	B,A
  0695'   FE 20                 	CPI	' '
  0697'   CA 06D7'              	JZ	CLS0
  069A'   FE 09                 	CPI	TAB
  069C'   CA 06D7'              	JZ	CLS0
  069F'   FE 0A                 	CPI	LF
  06A1'   CA 06D7'              	JZ	CLS0
  06A4'   FE 0D                 	CPI	CR
  06A6'   CA 06D7'              	JZ	CLS0
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A9'   3A 26B9'              	LDA	WBIG
  06AC'   B7                    	ORA	A
  06AD'   C2 06D9'              	JNZ	CLS1
  06B0'   78                    	MOV	A,B
  06B1'   FE 5F                 	CPI	'_'
  06B3'   CA 06D9'              	JZ	CLS1
  06B6'   FE 30                 	CPI	'0'
  06B8'   DA 06DC'              	JC	CLS2
  06BB'   FE 3A                 	CPI	'9'+1
  06BD'   DA 06D9'              	JC	CLS1
  06C0'   FE 41                 	CPI	'A'
  06C2'   DA 06DC'              	JC	CLS2
  06C5'   FE 5B                 	CPI	'Z'+1
  06C7'   DA 06D9'              	JC	CLS1
  06CA'   FE 61                 	CPI	'a'
  06CC'   DA 06DC'              	JC	CLS2
  06CF'   FE 7B                 	CPI	'z'+1
  06D1'   DA 06D9'              	JC	CLS1
  06D4'   C3 06DC'              	JMP	CLS2
  06D7'   AF                    CLS0:	XRA	A
  06D8'   C9                    	RET
  06D9'   3E 01                 CLS1:	MVI	A,1
  06DB'   C9                    	RET
  06DC'   3E 02                 CLS2:	MVI	A,2
  06DE'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  06DF'                         SETMOV:
  06DF'   3E 01                 	MVI	A,R_MOVE
  06E1'   32 26B3'              	STA	RINTENT
  06E4'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  06E5'                         SETLIN:
  06E5'   3E 02                 	MVI	A,R_LINE
  06E7'   32 26B3'              	STA	RINTENT
  06EA'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  06EB'                         SETILN:
  06EB'   3E 01                 	MVI	A,1
  06ED'   32 26B4'              	STA	ILN		; one line, unless a put overwrites it below
  06F0'   3E 05                 	MVI	A,R_ILIN
  06F2'   32 26B3'              	STA	RINTENT
  06F5'   AF                    	XRA	A
  06F6'   32 26B6'              	STA	ILABOV		; the row above the opened ones is untouched
  06F9'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  06FA'                         SETJON:
  06FA'   3E 06                 	MVI	A,R_JOIN
  06FC'   32 26B3'              	STA	RINTENT
  06FF'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0700'                         SETFUL:
  0700'   3E 00                 	MVI	A,R_FULL
  0702'   32 26B3'              	STA	RINTENT
  0705'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0706'                         TAILTAB:
  0706'   CD 0000*              	CALL	CUROFF
  0709'   22 26F3'              	SHLD	TTI
  070C'                         TT_LP:
  070C'   2A 26F3'              	LHLD	TTI
  070F'   EB                    	XCHG			; DE = TTI
  0710'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  0713'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0716'   D2 0736'              	JNC	TT_NO		; reached end of text -> no tab
  0719'   2A 26F3'              	LHLD	TTI
  071C'   CD 0000*              	CALL	CHARAT
  071F'   FE 0A                 	CPI	LF
  0721'   CA 0736'              	JZ	TT_NO		; end of line -> no tab
  0724'   FE 09                 	CPI	TAB
  0726'   CA 0733'              	JZ	TT_YES
  0729'   2A 26F3'              	LHLD	TTI
  072C'   23                    	INX	H
  072D'   22 26F3'              	SHLD	TTI
  0730'   C3 070C'              	JMP	TT_LP
  0733'                         TT_YES:
  0733'   3E 01                 	MVI	A,1
  0735'   C9                    	RET
  0736'                         TT_NO:
  0736'   AF                    	XRA	A
  0737'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;VC_H -- left, count times, stopping at BOL.
  0738'                         VC_H:
  0738'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  073B'   22 26F1'              	SHLD	CNTV
  073E'                         VCH_LP:
  073E'   2A 26F1'              	LHLD	CNTV
  0741'   7C                    	MOV	A,H
  0742'   B5                    	ORA	L
  0743'   C8                    	RZ
  0744'   2B                    	DCX	H
  0745'   22 26F1'              	SHLD	CNTV
  0748'   CD 074E'              	CALL	HSTEP
  074B'   C3 073E'              	JMP	VCH_LP
  074E'                         HSTEP:
  074E'   CD 0000*              	CALL	CUROFF		; HL = cur
  0751'   7C                    	MOV	A,H
  0752'   B5                    	ORA	L
  0753'   C8                    	RZ			; at 0
  0754'   E5                    	PUSH	H
  0755'   CD 05CB'              	CALL	BOL		; HL = bol
  0758'   D1                    	POP	D		; DE = cur
  0759'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  075C'   C8                    	RZ			; at BOL, cannot go left
  075D'   EB                    	XCHG			; HL = cur
  075E'   2B                    	DCX	H
  075F'   C3 0561'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0762'                         VC_L:
  0762'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0765'   22 26F1'              	SHLD	CNTV
  0768'                         VCL_LP:
  0768'   2A 26F1'              	LHLD	CNTV
  076B'   7C                    	MOV	A,H
  076C'   B5                    	ORA	L
  076D'   C8                    	RZ
  076E'   2B                    	DCX	H
  076F'   22 26F1'              	SHLD	CNTV
  0772'   CD 0778'              	CALL	LSTEP
  0775'   C3 0768'              	JMP	VCL_LP
  0778'                         LSTEP:
  0778'   CD 0000*              	CALL	CUROFF		; HL = cur
  077B'   E5                    	PUSH	H
  077C'   CD 060A'              	CALL	EOLC		; HL = eolc
  077F'   D1                    	POP	D		; DE = cur
  0780'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0783'   D0                    	RNC			; cur >= eolc, cannot go right
  0784'   EB                    	XCHG			; HL = cur
  0785'   23                    	INX	H
  0786'   C3 0561'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0789'                         VC_0:
  0789'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  078C'   CD 0796'              	CALL	LNSTRT
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  078F'   21 0000               	LXI	H,0
  0792'   22 26B7'              	SHLD	GOALCOL
  0795'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0796'                         LNSTRT:
  0796'   CD 0EAD'              	CALL	ZSAVE
  0799'   21 0000               	LXI	H,0
  079C'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  079F'   E5                    	PUSH	H
  07A0'   CD 0EC0'              	CALL	ZREST
  07A3'   E1                    	POP	H
  07A4'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  07A7'                         VC_CRT:
  07A7'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  07AA'   C3 07AD'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  07AD'                         FNBLNK:
  07AD'   CD 0796'              	CALL	LNSTRT
  07B0'   CD 0000*              	CALL	RGET0
  07B3'   11 0000               	LXI	D,0		; DE = blanks skipped
  07B6'                         FN_LP:
  07B6'   CD 0000*              	CALL	RDGET
  07B9'   DA 07DC'              	JC	FN_GO		; the end of the file
  07BC'   FE 20                 	CPI	' '
  07BE'   CA 07C6'              	JZ	FN_WH
  07C1'   FE 09                 	CPI	TAB
  07C3'   C2 07DC'              	JNZ	FN_GO		; a non-blank, or the line's end
  07C6'                         FN_WH:
  07C6'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  07C9'   DA 07DC'              	JC	FN_GO
  07CC'   FE 0D                 	CPI	CR
  07CE'   CA 07DC'              	JZ	FN_GO
  07D1'   FE 0A                 	CPI	LF
  07D3'   CA 07DC'              	JZ	FN_GO
  07D6'   2B                    	DCX	H		; not yet: read that char again
  07D7'   03                    	INX	B
  07D8'   13                    	INX	D
  07D9'   C3 07B6'              	JMP	FN_LP
  07DC'                         FN_GO:
  07DC'   D5                    	PUSH	D
  07DD'   CD 0000*              	CALL	CUROFF
  07E0'   D1                    	POP	D
  07E1'   19                    	DAD	D
  07E2'   C3 0561'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07E5'                         VC_EOL:
  07E5'   CD 06DF'              	CALL	SETMOV
  07E8'   21 FFFF               	LXI	H,0FFFFH
  07EB'   22 26B7'              	SHLD	GOALCOL
  07EE'   CD 0672'              	CALL	GETCNT
  07F1'   2B                    	DCX	H		; count-1
  07F2'   7C                    	MOV	A,H
  07F3'   B5                    	ORA	L
  07F4'   CA 0803'              	JZ	VEOL_0
  07F7'   E5                    	PUSH	H
  07F8'   CD 0818'              	CALL	ONLAST
  07FB'   E1                    	POP	H
  07FC'   D8                    	RC			; the last line: no move (vim)
  07FD'   CD 085B'              	CALL	JCORE
  0800'   C3 09AA'              	JMP	JKLAND
  0803'                         VEOL_0:
  0803'   CD 0796'              	CALL	LNSTRT
  0806'   C3 09AA'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0809'                         VC_CR:
  0809'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  080C'   E5                    	PUSH	H
  080D'   CD 0818'              	CALL	ONLAST
  0810'   E1                    	POP	H
  0811'   D8                    	RC
  0812'   CD 085B'              	CALL	JCORE
  0815'   C3 07AD'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0818'                         ONLAST:
  0818'   CD 0000*              	CALL	RGET0
  081B'                         OL_LP:
  081B'   CD 0000*              	CALL	RDGET
  081E'   D8                    	RC			; the file ends on this line
  081F'   FE 0A                 	CPI	LF
  0821'   C2 081B'              	JNZ	OL_LP
  0824'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  0827'                         VC_J:
  0827'   CD 06DF'              	CALL	SETMOV
  082A'   CD 0845'              	CALL	GLCHK		; the goal column, from the cursor if stale
  082D'   CD 0672'              	CALL	GETCNT		; HL = count
  0830'   CD 085B'              	CALL	JCORE
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0833'   C3 09AA'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0836'                         VC_K:
  0836'   CD 06DF'              	CALL	SETMOV
  0839'   CD 0845'              	CALL	GLCHK
  083C'   CD 0672'              	CALL	GETCNT
  083F'   CD 08F8'              	CALL	KCORE
  0842'   C3 09AA'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0845'                         GLCHK:
  0845'   2A 26B7'              	LHLD	GOALCOL
  0848'   7C                    	MOV	A,H
  0849'   3C                    	INR	A
  084A'   C0                    	RNZ
  084B'   7D                    	MOV	A,L
  084C'   FE FE                 	CPI	0FEH
  084E'   C0                    	RNZ
  084F'   C3 0564'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0852'                         GLSTAL:
  0852'   E5                    	PUSH	H
  0853'   21 FFFE               	LXI	H,0FFFEH
  0856'   22 26B7'              	SHLD	GOALCOL
  0859'   E1                    	POP	H
  085A'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  085B'                         JCORE:
  085B'   7C                    	MOV	A,H
  085C'   B5                    	ORA	L
  085D'   C8                    	RZ
  085E'   22 26BD'              	SHLD	JKCNT
  0861'   CD 0C71'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  0864'   47                    	MOV	B,A
  0865'   3A 0000*              	LDA	NEDIT
  0868'   3D                    	DCR	A
  0869'   90                    	SUB	B
  086A'   5F                    	MOV	E,A
  086B'   16 00                 	MVI	D,0
  086D'   3A 0000*              	LDA	NEDIT
  0870'   6F                    	MOV	L,A
  0871'   26 00                 	MVI	H,0
  0873'   19                    	DAD	D
  0874'   EB                    	XCHG			; DE = limit
  0875'   2A 26BD'              	LHLD	JKCNT
  0878'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  087B'   D2 087F'              	JNC	JC_N
  087E'   EB                    	XCHG			; HL = limit
  087F'                         JC_N:
  087F'   22 26BF'              	SHLD	JKN		; N = min(count, limit)
  0882'   EB                    	XCHG			; DE = LFs to find
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0883'   CD 0000*              	CALL	RGET0
  0886'                         JC_SC:
  0886'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0889'   DA 08A8'              	JC	JC_EOF
  088C'   32 26C6'              	STA	JKLST
  088F'   FE 0A                 	CPI	LF
  0891'   C2 0886'              	JNZ	JC_SC
  0894'   1B                    	DCX	D
  0895'   7A                    	MOV	A,D
  0896'   B3                    	ORA	E
  0897'   C2 0886'              	JNZ	JC_SC
  089A'   2A 26BD'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  089D'   22 26C1'              	SHLD	JKMOV		;   one if the last LF found ends the file
  08A0'   3E 01                 	MVI	A,1
  08A2'   32 26C5'              	STA	JKPHN
  08A5'   C3 08C3'              	JMP	JC_MV
  08A8'                         JC_EOF:
  08A8'   2A 26BF'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  08AB'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  08AE'   7C                    	MOV	A,H
  08AF'   B5                    	ORA	L
  08B0'   CA 08BC'              	JZ	JC_AV
  08B3'   3A 26C6'              	LDA	JKLST
  08B6'   FE 0A                 	CPI	LF
  08B8'   C2 08BC'              	JNZ	JC_AV
  08BB'   2B                    	DCX	H
  08BC'                         JC_AV:
  08BC'   22 26C1'              	SHLD	JKMOV
  08BF'   AF                    	XRA	A
  08C0'   32 26C5'              	STA	JKPHN
  08C3'                         JC_MV:
  08C3'   2A 26BD'              	LHLD	JKCNT
  08C6'   AF                    	XRA	A
  08C7'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  08CA'   CD 0989'              	CALL	ATEOF
  08CD'   D2 08E1'              	JNC	JC_DN
  08D0'   CD 098F'              	CALL	LASTLN		; ran past the last line: back onto it
  08D3'   3A 26C5'              	LDA	JKPHN
  08D6'   B7                    	ORA	A
  08D7'   CA 08E1'              	JZ	JC_DN
  08DA'   2A 26C1'              	LHLD	JKMOV
  08DD'   2B                    	DCX	H
  08DE'   22 26C1'              	SHLD	JKMOV
  08E1'                         JC_DN:
  08E1'   2A 26BF'              	LHLD	JKN		; LNDLT += min(moved, N)
  08E4'   EB                    	XCHG
  08E5'   2A 26C1'              	LHLD	JKMOV
  08E8'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  08EB'   D2 08EF'              	JNC	JC_AD
  08EE'   EB                    	XCHG
  08EF'                         JC_AD:
  08EF'   EB                    	XCHG			; DE = lines moved
  08F0'   2A 0000*              	LHLD	LNDLT
  08F3'   19                    	DAD	D
  08F4'   22 0000*              	SHLD	LNDLT
  08F7'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  08F8'                         KCORE:
  08F8'   7C                    	MOV	A,H
  08F9'   B5                    	ORA	L
  08FA'   C8                    	RZ
  08FB'   22 26BD'              	SHLD	JKCNT
  08FE'   CD 0C71'              	CALL	CURRW		; limit = row + NEDIT
  0901'   5F                    	MOV	E,A
  0902'   16 00                 	MVI	D,0
  0904'   3A 0000*              	LDA	NEDIT
  0907'   6F                    	MOV	L,A
  0908'   26 00                 	MVI	H,0
  090A'   19                    	DAD	D
  090B'   EB                    	XCHG			; DE = limit
  090C'   2A 26BD'              	LHLD	JKCNT
  090F'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0912'   D2 0916'              	JNC	KC_N
  0915'   EB                    	XCHG			; HL = limit
  0916'                         KC_N:
  0916'   22 26BF'              	SHLD	JKN		; N = min(count, limit)
  0919'   EB                    	XCHG			; DE = LFs to find
  091A'   21 0000               	LXI	H,0
  091D'   22 26C3'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0920'                         KC_ED:
  0920'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0921'   2A 26C3'              	LHLD	JKBK
  0924'   CD 066B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0927'   E5                    	PUSH	H
  0928'   EB                    	XCHG
  0929'   2A 0000*              	LHLD	TXTBEG
  092C'   EB                    	XCHG
  092D'   CD 0000*              	CALL	SUBHD
  0930'   44                    	MOV	B,H
  0931'   4D                    	MOV	C,L
  0932'   E1                    	POP	H
  0933'   D1                    	POP	D
  0934'                         KC_SC:
  0934'   78                    	MOV	A,B
  0935'   B1                    	ORA	C
  0936'   CA 094D'              	JZ	KC_TB
  0939'   2B                    	DCX	H
  093A'   0B                    	DCX	B
  093B'   7E                    	MOV	A,M
  093C'   FE 0A                 	CPI	LF
  093E'   C2 0934'              	JNZ	KC_SC
  0941'   1B                    	DCX	D
  0942'   7A                    	MOV	A,D
  0943'   B3                    	ORA	E
  0944'   C2 0934'              	JNZ	KC_SC
  0947'   2A 26BD'              	LHLD	JKCNT		; N lines above: the move is count lines
  094A'   C3 096D'              	JMP	KC_MV
  094D'                         KC_TB:
  094D'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  094E'   CD 066B'              	CALL	GBSUB		; HL = GAPBEG - that pointer
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0951'   22 26C3'              	SHLD	JKBK
  0954'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0957'   7C                    	MOV	A,H
  0958'   B5                    	ORA	L
  0959'   CA 0966'              	JZ	KC_B0
  095C'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  095F'   D1                    	POP	D
  0960'   DA 0967'              	JC	KC_BOF
  0963'   C3 0920'              	JMP	KC_ED
  0966'                         KC_B0:
  0966'   D1                    	POP	D
  0967'                         KC_BOF:
  0967'   2A 26BF'              	LHLD	JKN		; moved = LFs found
  096A'   CD 0000*              	CALL	SUBHD
  096D'                         KC_MV:
  096D'   E5                    	PUSH	H
  096E'   2A 26BD'              	LHLD	JKCNT
  0971'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0974'   D1                    	POP	D		; DE = moved
  0975'   2A 26BF'              	LHLD	JKN
  0978'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  097B'   DA 097F'              	JC	KC_AD
  097E'   EB                    	XCHG			; DE = N
  097F'                         KC_AD:
  097F'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0982'   CD 0000*              	CALL	SUBHD
  0985'   22 0000*              	SHLD	LNDLT
  0988'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0989'                         ATEOF:
  0989'   CD 0000*              	CALL	RGET0
  098C'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  098F'                         LASTLN:
  098F'   2A 0000*              	LHLD	GAPBEG
  0992'   EB                    	XCHG
  0993'   2A 0000*              	LHLD	TXTBEG
  0996'   CD 0000*              	CALL	CMP16
  0999'   21 0000               	LXI	H,0
  099C'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  099F'   1B                    	DCX	D
  09A0'   1A                    	LDAX	D
  09A1'   FE 0A                 	CPI	LF
  09A3'   C2 0000*              	JNZ	SETBWD
  09A6'   23                    	INX	H
  09A7'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09AA'                         JKLAND:
  09AA'   21 0000               	LXI	H,0
  09AD'   22 26C7'              	SHLD	JKVC		; screen column
  09B0'   2B                    	DCX	H
  09B1'   22 26C9'              	SHLD	JKLS		; last content char: none yet
  09B4'   CD 0000*              	CALL	RGET0
  09B7'   11 0000               	LXI	D,0		; DE = chars read
  09BA'                         JL_RD:
  09BA'   CD 0000*              	CALL	RDGET
  09BD'   DA 09F7'              	JC	JL_END
  09C0'   FE 0A                 	CPI	LF
  09C2'   CA 09F7'              	JZ	JL_END
  09C5'   E5                    	PUSH	H
  09C6'   C5                    	PUSH	B
  09C7'   2A 26C7'              	LHLD	JKVC
  09CA'   CD 05B8'              	CALL	CWID
  09CD'   B7                    	ORA	A
  09CE'   CA 09F1'              	JZ	JL_NX		; a CR
  09D1'   EB                    	XCHG
  09D2'   22 26C9'              	SHLD	JKLS		; the last content char so far
  09D5'   EB                    	XCHG
  09D6'   4F                    	MOV	C,A
  09D7'   06 00                 	MVI	B,0
  09D9'   09                    	DAD	B		; HL = the column after this char
  09DA'   22 26C7'              	SHLD	JKVC
  09DD'   D5                    	PUSH	D
  09DE'   EB                    	XCHG
  09DF'   2A 26B7'              	LHLD	GOALCOL
  09E2'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  09E5'   D1                    	POP	D
  09E6'   DA 09F1'              	JC	JL_NX
  09E9'   CA 09F1'              	JZ	JL_NX
  09EC'   C1                    	POP	B		; this char holds the goal column
  09ED'   E1                    	POP	H
  09EE'   C3 0A02'              	JMP	JL_GO
  09F1'                         JL_NX:
  09F1'   C1                    	POP	B
  09F2'   E1                    	POP	H
  09F3'   13                    	INX	D
  09F4'   C3 09BA'              	JMP	JL_RD
  09F7'                         JL_END:
  09F7'   2A 26C9'              	LHLD	JKLS		; past the line's end: its last content char
  09FA'   7C                    	MOV	A,H
  09FB'   A5                    	ANA	L
  09FC'   3C                    	INR	A
  09FD'   C2 0A01'              	JNZ	JL_LS
  0A00'   23                    	INX	H		; no content: the line's start
  0A01'                         JL_LS:
  0A01'   EB                    	XCHG
  0A02'                         JL_GO:
  0A02'   D5                    	PUSH	D		; DE = step from the line start
  0A03'   CD 0000*              	CALL	CUROFF
  0A06'   D1                    	POP	D
  0A07'   19                    	DAD	D
  0A08'   C3 0000*              	JMP	GOTO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A0B'   AF                    VC_W:	XRA	A
  0A0C'   32 26B9'              	STA	WBIG
  0A0F'   C3 0A17'              	JMP	WDO
  0A12'   3E 01                 VCBGW:	MVI	A,1
  0A14'   32 26B9'              	STA	WBIG
  0A17'   CD 06DF'              WDO:	CALL	SETMOV
  0A1A'   AF                    	XRA	A
  0A1B'   32 26BA'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0A1E'   CD 0672'              	CALL	GETCNT
  0A21'   22 26F1'              	SHLD	CNTV
  0A24'   2A 26F1'              WDO_LP: LHLD	CNTV
  0A27'   7C                    	MOV	A,H
  0A28'   B5                    	ORA	L
  0A29'   CA 0A36'              	JZ	WDO_DN
  0A2C'   2B                    	DCX	H
  0A2D'   22 26F1'              	SHLD	CNTV
  0A30'   CD 0A86'              	CALL	FWD1
  0A33'   D2 0A24'              	JNC	WDO_LP
  0A36'                         WDO_DN:
  0A36'   CD 0989'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0A39'   DA 0A46'              	JC	WDO_NL
  0A3C'   FE 0D                 	CPI	CR
  0A3E'   CA 0A46'              	JZ	WDO_NL
  0A41'   FE 0A                 	CPI	LF
  0A43'   C2 0564'              	JNZ	SETGL
  0A46'                         WDO_NL:
  0A46'   CD 0000*              	CALL	PEEKL
  0A49'   DA 0564'              	JC	SETGL
  0A4C'   FE 0A                 	CPI	LF
  0A4E'   CA 0564'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0A51'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0A53'   32 26BA'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0A56'   CD 0B81'              	CALL	DECC		; back onto its last char
  0A59'   C3 0564'              	JMP	SETGL
                                
  0A5C'   AF                    VC_B:	XRA	A
  0A5D'   32 26B9'              	STA	WBIG
  0A60'   C3 0A68'              	JMP	BDO
  0A63'   3E 01                 VCBGB:	MVI	A,1
  0A65'   32 26B9'              	STA	WBIG
  0A68'   CD 06DF'              BDO:	CALL	SETMOV
  0A6B'   CD 0672'              	CALL	GETCNT
  0A6E'   22 26F1'              	SHLD	CNTV
  0A71'   2A 26F1'              BDO_LP: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A74'   7C                    	MOV	A,H
  0A75'   B5                    	ORA	L
  0A76'   CA 0564'              	JZ	SETGL
  0A79'   2B                    	DCX	H
  0A7A'   22 26F1'              	SHLD	CNTV
  0A7D'   CD 0AD2'              	CALL	BCK1
  0A80'   D2 0A71'              	JNC	BDO_LP
  0A83'   C3 0564'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0A86'                         FWD1:
  0A86'   CD 0B05'              	CALL	CCLS
  0A89'   32 26FD'              	STA	WKCLS		; the starting class
  0A8C'   CD 0B3F'              	CALL	INCC
  0A8F'   B7                    	ORA	A
  0A90'   CA 0AA8'              	JZ	FW_WD
  0A93'   37                    	STC
  0A94'   F8                    	RM			; -1: already at the end
  0A95'   FE 02                 	CPI	2
  0A97'   C2 0AA8'              	JNZ	FW_WD		; 1: a next line was reached
  0A9A'   CD 0989'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0A9D'   D4 0B26'              	CNC	NXLN
  0AA0'   D2 0AA8'              	JNC	FW_WD
  0AA3'   CD 0B81'              	CALL	DECC		; yes: back onto its last char, failed
  0AA6'   37                    	STC
  0AA7'   C9                    	RET
  0AA8'                         FW_WD:
  0AA8'   3A 26FD'              	LDA	WKCLS		; go past the rest of this word
  0AAB'   B7                    	ORA	A
  0AAC'   CA 0AC1'              	JZ	FW_WS
  0AAF'                         FW_WLP:
  0AAF'   CD 0B05'              	CALL	CCLS
  0AB2'   21 26FD'              	LXI	H,WKCLS
  0AB5'   BE                    	CMP	M
  0AB6'   C2 0AC1'              	JNZ	FW_WS
  0AB9'   CD 0B3F'              	CALL	INCC
  0ABC'   B7                    	ORA	A
  0ABD'   F8                    	RM			; the end of the file (NC)
  0ABE'   C3 0AAF'              	JMP	FW_WLP
  0AC1'                         FW_WS:
  0AC1'   CD 0B05'              	CALL	CCLS		; then over blanks to the next word
  0AC4'   B7                    	ORA	A
  0AC5'   C0                    	RNZ
  0AC6'   CD 0B0D'              	CALL	EMPTY
  0AC9'   C8                    	RZ			; an empty line is a word
  0ACA'   CD 0B3F'              	CALL	INCC
  0ACD'   B7                    	ORA	A
  0ACE'   F8                    	RM
  0ACF'   C3 0AC1'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0AD2'                         BCK1:
  0AD2'   CD 0B81'              	CALL	DECC
  0AD5'   B7                    	ORA	A
  0AD6'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AD7'   F8                    	RM
  0AD8'                         BK_WS:
  0AD8'   CD 0B05'              	CALL	CCLS		; back over blanks
  0ADB'   B7                    	ORA	A
  0ADC'   C2 0AEC'              	JNZ	BK_WD
  0ADF'   CD 0B0D'              	CALL	EMPTY
  0AE2'   C8                    	RZ			; an empty line is a word
  0AE3'   CD 0B81'              	CALL	DECC
  0AE6'   B7                    	ORA	A
  0AE7'   F2 0AD8'              	JP	BK_WS
  0AEA'   AF                    	XRA	A		; the start of the file (NC)
  0AEB'   C9                    	RET
  0AEC'                         BK_WD:
  0AEC'   32 26FD'              	STA	WKCLS		; back to the start of this word
  0AEF'                         BK_WLP:
  0AEF'   CD 0B81'              	CALL	DECC
  0AF2'   B7                    	ORA	A
  0AF3'   FA 0B03'              	JM	BK_OK		; the start of the file
  0AF6'   CD 0B05'              	CALL	CCLS
  0AF9'   21 26FD'              	LXI	H,WKCLS
  0AFC'   BE                    	CMP	M
  0AFD'   CA 0AEF'              	JZ	BK_WLP
  0B00'   CD 0B3F'              	CALL	INCC		; overshot: forward one
  0B03'                         BK_OK:
  0B03'   AF                    	XRA	A
  0B04'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B05'                         CCLS:
  0B05'   CD 0989'              	CALL	ATEOF
  0B08'   D2 0694'              	JNC	CLASSF
  0B0B'   AF                    	XRA	A
  0B0C'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B0D'                         EMPTY:
  0B0D'   CD 0989'              	CALL	ATEOF
  0B10'   DA 0B1B'              	JC	EM_ST
  0B13'   FE 0D                 	CPI	CR
  0B15'   CA 0B1B'              	JZ	EM_ST
  0B18'   FE 0A                 	CPI	LF
  0B1A'   C0                    	RNZ
  0B1B'                         EM_ST:
  0B1B'   CD 0000*              	CALL	PEEKL
  0B1E'   DA 0B24'              	JC	EM_Y
  0B21'   FE 0A                 	CPI	LF
  0B23'   C9                    	RET
  0B24'                         EM_Y:
  0B24'   AF                    	XRA	A
  0B25'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0B26'                         NXLN:
  0B26'   FE 0A                 	CPI	LF
