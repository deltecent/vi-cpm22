  06E4'   22 21E7'              	SHLD	JKMOV
  06E7'   AF                    	XRA	A
  06E8'   32 21EB'              	STA	JKPHN
  06EB'                         JC_MV:
  06EB'   2A 21E3'              	LHLD	JKCNT
  06EE'   AF                    	XRA	A
  06EF'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  06F2'   CD 07B1'              	CALL	ATEOF
  06F5'   D2 0709'              	JNC	JC_DN
  06F8'   CD 07B7'              	CALL	LASTLN		; ran past the last line: back onto it
  06FB'   3A 21EB'              	LDA	JKPHN
  06FE'   B7                    	ORA	A
  06FF'   CA 0709'              	JZ	JC_DN
  0702'   2A 21E7'              	LHLD	JKMOV
  0705'   2B                    	DCX	H
  0706'   22 21E7'              	SHLD	JKMOV
  0709'                         JC_DN:
  0709'   2A 21E5'              	LHLD	JKN		; LNDLT += min(moved, N)
  070C'   EB                    	XCHG
  070D'   2A 21E7'              	LHLD	JKMOV
  0710'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0713'   D2 0717'              	JNC	JC_AD
  0716'   EB                    	XCHG
