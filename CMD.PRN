  1190'   CD 1223'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1193'   DA 11AE'              	JC	VHU_C		;   above it; or the file's first line
  1196'   79                    	MOV	A,C
  1197'   B7                    	ORA	A
  1198'   CA 11AE'              	JZ	VHU_C
  119B'   3A 0000*              	LDA	HTTP
  119E'   3D                    	DCR	A
  119F'   B8                    	CMP	B
  11A0'   CA 11AB'              	JZ	VHU_F
