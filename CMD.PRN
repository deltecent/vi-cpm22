  070C'   EB                    	XCHG
  070D'   C1                    	POP	B
  070E'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  070F'                         NLSTART:
  070F'   CD 06BB'              	CALL	EOLNL
  0712'   E5                    	PUSH	H
  0713'   CD 0000*              	CALL	LOGLEN
  0716'   D1                    	POP	D		; DE = eol result
  0717'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  071A'   C8                    	RZ			; no next line: HL = LOGLEN
  071B'   EB                    	XCHG			; HL = eol
  071C'   23                    	INX	H
  071D'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  071E'                         EOLC:
  071E'   E5                    	PUSH	H
  071F'   CD 06BB'              	CALL	EOLNL
  0722'   22 0000*              	SHLD	WKTERM
  0725'   E1                    	POP	H
  0726'   CD 0678'              	CALL	BOL
  0729'   22 0000*              	SHLD	WKBOL
  072C'   2A 0000*              	LHLD	WKTERM
  072F'   EB                    	XCHG			; DE = term
  0730'   2A 0000*              	LHLD	WKBOL
  0733'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0736'   CA 0755'              	JZ	EOLC_MT
  0739'   EB                    	XCHG			; HL = term
  073A'   2B                    	DCX	H		; term-1
  073B'   E5                    	PUSH	H
  073C'   CD 0000*              	CALL	CHARAT
  073F'   E1                    	POP	H		; HL = term-1
  0740'   FE 0D                 	CPI	CR
  0742'   CA 0748'              	JZ	EOLC_CR		; content ends at term-1
  0745'   C3 0749'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0748'                         EOLC_CR:
  0748'   2B                    	DCX	H		; last = (term-1) - 1
  0749'                         EOLC_LS:
  0749'   EB                    	XCHG			; DE = last
  074A'   2A 0000*              	LHLD	WKBOL
  074D'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0750'   DA 0755'              	JC	EOLC_MT
  0753'   EB                    	XCHG			; HL = last
  0754'   C9                    	RET
  0755'                         EOLC_MT:
  0755'   2A 0000*              	LHLD	WKBOL
  0758'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0759'                         ATENDQ:
  0759'   CD 0000*              	CALL	CUROFF
  075C'   E5                    	PUSH	H
  075D'   CD 0000*              	CALL	LOGLEN
  0760'   D1                    	POP	D		; DE = cur
  0761'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0764'                         CURCHR:
  0764'   CD 0000*              	CALL	CUROFF
  0767'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  076A'                         MOVCNT:
  076A'   CD 0852'              	CALL	SETMOV
  076D'   C3 077D'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0770'                         CNTOFF:
  0770'   CD 077D'              	CALL	GETCNT
  0773'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0776'                         GBSUB:
  0776'   EB                    	XCHG
  0777'   2A 0000*              	LHLD	GAPBEG
  077A'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  077D'                         GETCNT:
  077D'   2A 0000*              	LHLD	CMDCNT
  0780'   7C                    	MOV	A,H
  0781'   B5                    	ORA	L
  0782'   C2 0789'              	JNZ	GC_HAVE
  0785'   21 0001               	LXI	H,1
  0788'   C9                    	RET
  0789'                         GC_HAVE:
  0789'   E5                    	PUSH	H
  078A'   21 0000               	LXI	H,0
  078D'   22 0000*              	SHLD	CMDCNT
  0790'   E1                    	POP	H
  0791'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0792'                         CNTTST:				; WM 1175
  0792'   3A 0000*              	LDA	BRKARM
  0795'   B7                    	ORA	A
  0796'   C4 07C0'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  0799'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  079A'   2A 0000*              	LHLD	CMDCNT
  079D'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  07A0'   B4                    	ORA	H
  07A1'   B5                    	ORA	L
  07A2'   E1                    	POP	H
  07A3'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07A6'                         BRKON:
  07A6'   21 0000*              	LXI	H,SOFF
  07A9'   CD 0429'              	CALL	FPSTO
  07AC'   2A 0000*              	LHLD	LNDLT
  07AF'   22 0000*              	SHLD	SLDLT
  07B2'   AF                    	XRA	A
  07B3'   32 0000*              	STA	BRKHIT
  07B6'   3A 0000*              	LDA	PSAVE
  07B9'   B7                    	ORA	A
  07BA'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07BB'   3C                    	INR	A
  07BC'   32 0000*              	STA	BRKARM
  07BF'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07C0'                         BRKTST:
  07C0'   C5                    	PUSH	B
  07C1'   D5                    	PUSH	D
  07C2'   E5                    	PUSH	H
  07C3'   CD 0000*              	CALL	KBBRK
  07C6'   CA 07DF'              	JZ	BT_NO
  07C9'   32 0000*              	STA	BRKHIT		; (A = FFH)
  07CC'   21 2870'              	LXI	H,SINTG
  07CF'   CD 0000*              	CALL	EXMSG
  07D2'   AF                    	XRA	A
  07D3'   32 0000*              	STA	BRKARM		; the way back is not stopped in its turn
  07D6'   32 0000*              	STA	AUXCNT
  07D9'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07DC'   22 0000*              	SHLD	CMDCNT
  07DF'                         BT_NO:
  07DF'   E1                    	POP	H
  07E0'   D1                    	POP	D
  07E1'   C1                    	POP	B
  07E2'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07E3'                         BRKOFF:
  07E3'   AF                    	XRA	A
  07E4'   32 0000*              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  07E7'                         BRKQ:
  07E7'   3A 0000*              	LDA	BRKHIT
  07EA'   B7                    	ORA	A
  07EB'   C8                    	RZ
  07EC'   37                    	STC
  07ED'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07EE'                         RSTPL:
  07EE'   21 0000*              	LXI	H,SOFF
  07F1'   CD 03D0'              	CALL	BACKTO
  07F4'   2A 0000*              	LHLD	SLDLT
  07F7'   22 0000*              	SHLD	LNDLT
  07FA'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07FB'                         BRKBAK:
  07FB'   CD 07EE'              	CALL	RSTPL
  07FE'   CD 0000*              	CALL	KBFLSH
  0801'   21 2864'              	LXI	H,SINTR
  0804'   C3 27C6'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0807'                         CLASSF:
  0807'   47                    	MOV	B,A
  0808'   FE 20                 	CPI	' '
  080A'   CA 084A'              	JZ	CLS0
  080D'   FE 09                 	CPI	TAB
  080F'   CA 084A'              	JZ	CLS0
  0812'   FE 0A                 	CPI	LF
  0814'   CA 084A'              	JZ	CLS0
  0817'   FE 0D                 	CPI	CR
  0819'   CA 084A'              	JZ	CLS0
  081C'   3A 0000*              	LDA	WBIG
  081F'   B7                    	ORA	A
  0820'   C2 084C'              	JNZ	CLS1
  0823'   78                    	MOV	A,B
  0824'   FE 5F                 	CPI	'_'
  0826'   CA 084C'              	JZ	CLS1
  0829'   FE 30                 	CPI	'0'
  082B'   DA 084F'              	JC	CLS2
  082E'   FE 3A                 	CPI	'9'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0830'   DA 084C'              	JC	CLS1
  0833'   FE 41                 	CPI	'A'
  0835'   DA 084F'              	JC	CLS2
  0838'   FE 5B                 	CPI	'Z'+1
  083A'   DA 084C'              	JC	CLS1
  083D'   FE 61                 	CPI	'a'
  083F'   DA 084F'              	JC	CLS2
  0842'   FE 7B                 	CPI	'z'+1
  0844'   DA 084C'              	JC	CLS1
  0847'   C3 084F'              	JMP	CLS2
  084A'   AF                    CLS0:	XRA	A
  084B'   C9                    	RET
  084C'   3E 01                 CLS1:	MVI	A,1
  084E'   C9                    	RET
  084F'   3E 02                 CLS2:	MVI	A,2
  0851'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0852'                         SETMOV:
  0852'   3E 01                 	MVI	A,R_MOVE
  0854'   32 0000*              	STA	RINTENT
  0857'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0858'                         SETLIN:
  0858'   3E 02                 	MVI	A,R_LINE
  085A'   32 0000*              	STA	RINTENT
  085D'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  085E'                         SETCEL:
  085E'   CD 0873'              	CALL	PLAINQ
  0861'   D0                    	RNC
  0862'   3A 0000*              	LDA	VRCH
  0865'   CD 0873'              	CALL	PLAINQ
  0868'   D0                    	RNC
  0869'   78                    	MOV	A,B
  086A'   32 0000*              	STA	ICHAPP
  086D'   3E 04                 	MVI	A,R_ICH
  086F'   32 0000*              	STA	RINTENT
  0872'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0873'                         PLAINQ:
  0873'   FE 20                 	CPI	' '
  0875'   3F                    	CMC
  0876'   D0                    	RNC
  0877'   FE 7F                 	CPI	DEL
  0879'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  087A'                         SETILN:
  087A'   3E 01                 	MVI	A,1
  087C'   32 2F09'              	STA	ILN		; one line, unless a put overwrites it below
  087F'   3E 05                 	MVI	A,R_ILIN
  0881'   32 0000*              	STA	RINTENT
  0884'   AF                    	XRA	A
  0885'   32 0000*              	STA	ILABOV		; the row above the opened ones is untouched
  0888'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0889'                         SETJON:
  0889'   3E 06                 	MVI	A,R_JOIN
  088B'   32 0000*              	STA	RINTENT
  088E'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  088F'                         SETFUL:
  088F'   3E 00                 	MVI	A,R_FULL
  0891'   32 0000*              	STA	RINTENT
  0894'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0895'                         TAILTAB:
  0895'   C5                    	PUSH	B
  0896'   CD 0000*              	CALL	CUROFF
  0899'   E5                    	PUSH	H
  089A'   2A 0000*              	LHLD	TXTEND
  089D'   44                    	MOV	B,H
  089E'   4D                    	MOV	C,L
  089F'   2A 0000*              	LHLD	GAPEND
  08A2'   D1                    	POP	D		; DE = the offset of the byte at HL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A3'                         TT_LP:
  08A3'   7D                    	MOV	A,L
  08A4'   91                    	SUB	C
  08A5'   7C                    	MOV	A,H
  08A6'   98                    	SBB	B
  08A7'   D2 08C7'              	JNC	TT_NO		; reached end of text -> no tab
  08AA'   7E                    	MOV	A,M
  08AB'   FE 0A                 	CPI	LF
  08AD'   CA 08C7'              	JZ	TT_NO		; end of line -> no tab
  08B0'   FE 0D                 	CPI	CR
  08B2'   CA 08BA'              	JZ	TT_NX		; (the line end's own)
  08B5'   FE 20                 	CPI	' '
  08B7'   DA 08BF'              	JC	TT_YES
  08BA'                         TT_NX:
  08BA'   23                    	INX	H
  08BB'   13                    	INX	D
  08BC'   C3 08A3'              	JMP	TT_LP
  08BF'                         TT_YES:
  08BF'   EB                    	XCHG
  08C0'   22 0000*              	SHLD	TTI
  08C3'   C1                    	POP	B
  08C4'   3E 01                 	MVI	A,1
  08C6'   C9                    	RET
  08C7'                         TT_NO:
  08C7'   C1                    	POP	B
  08C8'   AF                    	XRA	A
  08C9'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  08CA'                         VC_H:
  08CA'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  08CD'   22 0000*              	SHLD	CNTV
  08D0'                         VCH_LP:
  08D0'   2A 0000*              	LHLD	CNTV
  08D3'   7C                    	MOV	A,H
  08D4'   B5                    	ORA	L
  08D5'   C8                    	RZ
  08D6'   2B                    	DCX	H
  08D7'   22 0000*              	SHLD	CNTV
  08DA'   CD 08E0'              	CALL	HSTEP
  08DD'   C3 08D0'              	JMP	VCH_LP
  08E0'                         HSTEP:
  08E0'   CD 0000*              	CALL	CUROFF		; HL = cur
  08E3'   7C                    	MOV	A,H
  08E4'   B5                    	ORA	L
  08E5'   C8                    	RZ			; at 0
  08E6'   E5                    	PUSH	H
  08E7'   CD 0678'              	CALL	BOL		; HL = bol
  08EA'   D1                    	POP	D		; DE = cur
  08EB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  08EE'   C8                    	RZ			; at BOL, cannot go left
  08EF'   EB                    	XCHG			; HL = cur
  08F0'   2B                    	DCX	H
  08F1'   C3 060E'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08F4'                         VC_L:
  08F4'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  08F7'   22 0000*              	SHLD	CNTV
  08FA'                         VCL_LP:
  08FA'   2A 0000*              	LHLD	CNTV
  08FD'   7C                    	MOV	A,H
  08FE'   B5                    	ORA	L
  08FF'   C8                    	RZ
  0900'   2B                    	DCX	H
  0901'   22 0000*              	SHLD	CNTV
  0904'   CD 090A'              	CALL	LSTEP
  0907'   C3 08FA'              	JMP	VCL_LP
  090A'                         LSTEP:
  090A'   CD 0000*              	CALL	CUROFF		; HL = cur
  090D'   E5                    	PUSH	H
  090E'   CD 071E'              	CALL	EOLC		; HL = eolc
  0911'   D1                    	POP	D		; DE = cur
  0912'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0915'   D2 091D'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0918'   EB                    	XCHG			; HL = cur
  0919'   23                    	INX	H
  091A'   C3 060E'              	JMP	GOSET
  091D'                         LS_NO:				; on the line's last char.  An operator waiting on
  091D'   CD 0D90'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0920'   C8                    	RZ			;   motion inclusive when it falls short), which
  0921'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0923'   32 0000*              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0926'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0927'                         VC_0:
  0927'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  092A'   CD 0934'              	CALL	LNSTRT
  092D'   21 0000               	LXI	H,0
  0930'   22 2F0B'              	SHLD	GOALCOL
  0933'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0934'                         LNSTRT:
  0934'   CD 13AB'              	CALL	ZSAVE
  0937'   21 0000               	LXI	H,0
  093A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  093D'   E5                    	PUSH	H
  093E'   CD 13BE'              	CALL	ZREST
  0941'   E1                    	POP	H
  0942'   C3 0000*              	JMP	PUTCUR
                                
                                ;LNEND -- the cursor's line whole in the window: read on from the cursor to
                                ; its LF with WM's RGET, which pages in what the window does not hold yet.
                                ; The window ends on a record, not a line, so its last line is cut short, and
                                ; a measure that stops at the window's end (NLSTART at LOGLEN) takes a piece
                                ; of a line for the whole of it (issue #38).  The cursor stays where it is;
                                ; text behind it may page out, so an offset taken before this is stale.
  0945'                         LNEND:
  0945'   CD 0000*              	CALL	RGET0
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0948'                         LNE_LP:
  0948'   CD 0000*              	CALL	RDGET
  094B'   D8                    	RC			; the end of the file
  094C'   FE 0A                 	CPI	LF
  094E'   C2 0948'              	JNZ	LNE_LP
  0951'   C9                    	RET
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0952'                         VC_CRT:
  0952'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0955'   C3 0958'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0958'                         FNBLNK:
  0958'   CD 0934'              	CALL	LNSTRT
  095B'   CD 0000*              	CALL	RGET0
  095E'   11 0000               	LXI	D,0		; DE = blanks skipped
  0961'                         FN_LP:
  0961'   CD 0000*              	CALL	RDGET
  0964'   DA 0987'              	JC	FN_GO		; the end of the file
  0967'   FE 20                 	CPI	' '
  0969'   CA 0971'              	JZ	FN_WH
  096C'   FE 09                 	CPI	TAB
  096E'   C2 0987'              	JNZ	FN_GO		; a non-blank, or the line's end
  0971'                         FN_WH:
  0971'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0974'   DA 0987'              	JC	FN_GO
  0977'   FE 0D                 	CPI	CR
  0979'   CA 0987'              	JZ	FN_GO
  097C'   FE 0A                 	CPI	LF
  097E'   CA 0987'              	JZ	FN_GO
  0981'   2B                    	DCX	H		; not yet: read that char again
  0982'   03                    	INX	B
  0983'   13                    	INX	D
  0984'   C3 0961'              	JMP	FN_LP
  0987'                         FN_GO:
  0987'   D5                    	PUSH	D
  0988'   CD 0000*              	CALL	CUROFF
  098B'   D1                    	POP	D
  098C'   19                    	DAD	D
  098D'   C3 060E'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0990'                         VC_EOL:
  0990'   CD 0852'              	CALL	SETMOV
  0993'   21 FFFF               	LXI	H,0FFFFH
  0996'   22 2F0B'              	SHLD	GOALCOL
  0999'   CD 077D'              	CALL	GETCNT
  099C'   2B                    	DCX	H		; count-1
  099D'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  099E'   B5                    	ORA	L
  099F'   CA 09AE'              	JZ	VEOL_0
  09A2'   E5                    	PUSH	H
  09A3'   CD 09C3'              	CALL	ONLAST
  09A6'   E1                    	POP	H
  09A7'   D8                    	RC			; the last line: no move (vim)
  09A8'   CD 0A13'              	CALL	JCORE
  09AB'   C3 0BFC'              	JMP	JKLAND
  09AE'                         VEOL_0:
  09AE'   CD 0934'              	CALL	LNSTRT
  09B1'   C3 0BFC'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09B4'                         VC_CR:
  09B4'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  09B7'   E5                    	PUSH	H
  09B8'   CD 09C3'              	CALL	ONLAST
  09BB'   E1                    	POP	H
  09BC'   D8                    	RC
  09BD'   CD 0A13'              	CALL	JCORE
  09C0'   C3 0958'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09C3'                         ONLAST:
  09C3'   CD 0000*              	CALL	RGET0
  09C6'                         OL_LP:
  09C6'   CD 0000*              	CALL	RDGET
  09C9'   D8                    	RC			; the file ends on this line
  09CA'   FE 0A                 	CPI	LF
  09CC'   C2 09C6'              	JNZ	OL_LP
  09CF'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09D2'                         VC_J:
  09D2'   CD 0852'              	CALL	SETMOV
  09D5'   CD 09FD'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09D8'   CD 077D'              	CALL	GETCNT		; HL = count
  09DB'   CD 0A13'              	CALL	JCORE
  09DE'   CD 09F6'              	CALL	JKDRP
  09E1'   C3 0BFC'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  09E4'                         VC_K:
  09E4'   CD 0852'              	CALL	SETMOV
  09E7'   CD 09FD'              	CALL	GLCHK
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09EA'   CD 077D'              	CALL	GETCNT
  09ED'   CD 0AF3'              	CALL	KCORE
  09F0'   CD 09F6'              	CALL	JKDRP
  09F3'   C3 0BFC'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  09F6'                         JKDRP:
  09F6'   7A                    	MOV	A,D
  09F7'   B3                    	ORA	E
  09F8'   C0                    	RNZ
  09F9'   32 0000*              	STA	PSAVE
  09FC'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09FD'                         GLCHK:
  09FD'   2A 2F0B'              	LHLD	GOALCOL
  0A00'   7C                    	MOV	A,H
  0A01'   3C                    	INR	A
  0A02'   C0                    	RNZ
  0A03'   7D                    	MOV	A,L
  0A04'   FE FE                 	CPI	0FEH
  0A06'   C0                    	RNZ
  0A07'   C3 0611'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0A0A'                         GLSTAL:
  0A0A'   E5                    	PUSH	H
  0A0B'   21 FFFE               	LXI	H,0FFFEH
  0A0E'   22 2F0B'              	SHLD	GOALCOL
  0A11'   E1                    	POP	H
  0A12'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A13'                         JCORE:
  0A13'   7C                    	MOV	A,H
  0A14'   B5                    	ORA	L
  0A15'   C8                    	RZ
  0A16'   22 0000*              	SHLD	JKCNT
  0A19'   CD 0EBF'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A1C'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A1D'   3A 0000*              	LDA	NEDIT
  0A20'   3C                    	INR	A
  0A21'   90                    	SUB	B
  0A22'   5F                    	MOV	E,A
  0A23'   16 00                 	MVI	D,0
  0A25'   3A 0000*              	LDA	NEDIT
  0A28'   6F                    	MOV	L,A
  0A29'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A2B'   19                    	DAD	D
  0A2C'   EB                    	XCHG			; DE = limit
  0A2D'   2A 0000*              	LHLD	JKCNT
  0A30'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A33'   D2 0A81'              	JNC	JC_QK
  0A36'   EB                    	XCHG			; HL = limit
  0A37'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0A3A'                         JC_SL:
  0A3A'   2A 0000*              	LHLD	JKN
  0A3D'   EB                    	XCHG			; DE = LFs to find
  0A3E'   CD 0000*              	CALL	RGET0
  0A41'                         JC_SC:
  0A41'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A44'   DA 0A63'              	JC	JC_EOF
  0A47'   32 0000*              	STA	JKLST
  0A4A'   FE 0A                 	CPI	LF
  0A4C'   C2 0A41'              	JNZ	JC_SC
  0A4F'   1B                    	DCX	D
  0A50'   7A                    	MOV	A,D
  0A51'   B3                    	ORA	E
  0A52'   C2 0A41'              	JNZ	JC_SC
  0A55'   2A 0000*              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A58'   22 0000*              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A5B'   3E 01                 	MVI	A,1
  0A5D'   32 0000*              	STA	JKPHN
  0A60'   C3 0ABE'              	JMP	JC_MV
  0A63'                         JC_EOF:
  0A63'   2A 0000*              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A66'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A69'   7C                    	MOV	A,H
  0A6A'   B5                    	ORA	L
  0A6B'   CA 0A77'              	JZ	JC_AV
  0A6E'   3A 0000*              	LDA	JKLST
  0A71'   FE 0A                 	CPI	LF
  0A73'   C2 0A77'              	JNZ	JC_AV
  0A76'   2B                    	DCX	H
  0A77'                         JC_AV:
  0A77'   22 0000*              	SHLD	JKMOV
  0A7A'   AF                    	XRA	A
  0A7B'   32 0000*              	STA	JKPHN
  0A7E'   C3 0ABE'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0A81'                         JC_QK:
  0A81'   22 0000*              	SHLD	JKN		; N = the count
  0A84'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0A87'   3A 0000*              	LDA	JKN
  0A8A'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0A8B'   16 0A                 	MVI	D,LF
  0A8D'   04                    	INR	B
  0A8E'   0C                    	INR	C
  0A8F'                         JQ_LP:
  0A8F'   0D                    	DCR	C
  0A90'   C2 0A97'              	JNZ	JQ_CH
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0A93'   05                    	DCR	B
  0A94'   CA 0A3A'              	JZ	JC_SL
  0A97'                         JQ_CH:
  0A97'   7E                    	MOV	A,M
  0A98'   23                    	INX	H
  0A99'   BA                    	CMP	D
  0A9A'   C2 0A8F'              	JNZ	JQ_LP
  0A9D'   1D                    	DCR	E
  0A9E'   C2 0A8F'              	JNZ	JQ_LP
  0AA1'   EB                    	XCHG			; DE = the line's start
  0AA2'   2A 0000*              	LHLD	TXTEND
  0AA5'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0AA8'   D2 0A3A'              	JNC	JC_SL
  0AAB'   EB                    	XCHG
  0AAC'   CD 0000*              	CALL	PUTCUR
  0AAF'   21 0000               	LXI	H,0
  0AB2'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AB5'   2A 0000*              	LHLD	JKCNT
  0AB8'   22 0000*              	SHLD	JKMOV
  0ABB'   C3 0ADC'              	JMP	JC_DN
  0ABE'                         JC_MV:
  0ABE'   2A 0000*              	LHLD	JKCNT
  0AC1'   AF                    	XRA	A
  0AC2'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0AC5'   CD 0BDB'              	CALL	ATEOF
  0AC8'   D2 0ADC'              	JNC	JC_DN
  0ACB'   CD 0BE1'              	CALL	LASTLN		; ran past the last line: back onto it
  0ACE'   3A 0000*              	LDA	JKPHN
  0AD1'   B7                    	ORA	A
  0AD2'   CA 0ADC'              	JZ	JC_DN
  0AD5'   2A 0000*              	LHLD	JKMOV
  0AD8'   2B                    	DCX	H
  0AD9'   22 0000*              	SHLD	JKMOV
  0ADC'                         JC_DN:
  0ADC'   2A 0000*              	LHLD	JKN		; LNDLT += min(moved, N)
  0ADF'   EB                    	XCHG
  0AE0'   2A 0000*              	LHLD	JKMOV
  0AE3'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0AE6'   D2 0AEA'              	JNC	JC_AD
  0AE9'   EB                    	XCHG
  0AEA'                         JC_AD:
  0AEA'   EB                    	XCHG			; DE = lines moved
  0AEB'   2A 0000*              	LHLD	LNDLT
  0AEE'   19                    	DAD	D
  0AEF'   22 0000*              	SHLD	LNDLT
  0AF2'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0AF3'                         KCORE:
  0AF3'   7C                    	MOV	A,H
  0AF4'   B5                    	ORA	L
  0AF5'   C8                    	RZ
  0AF6'   22 0000*              	SHLD	JKCNT
  0AF9'   CD 0EBF'              	CALL	CURRW		; limit = row + NEDIT
  0AFC'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0AFD'   16 00                 	MVI	D,0
  0AFF'   3A 0000*              	LDA	NEDIT
  0B02'   6F                    	MOV	L,A
  0B03'   26 00                 	MVI	H,0
  0B05'   19                    	DAD	D
  0B06'   EB                    	XCHG			; DE = limit
  0B07'   2A 0000*              	LHLD	JKCNT
  0B0A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0B0D'   D2 0B87'              	JNC	KC_QK
  0B10'   EB                    	XCHG			; HL = limit
  0B11'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0B14'                         KC_SL:
  0B14'   2A 0000*              	LHLD	JKN
  0B17'   EB                    	XCHG			; DE = LFs to find
  0B18'   21 0000               	LXI	H,0
  0B1B'   22 0000*              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0B1E'                         KC_ED:
  0B1E'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0B1F'   2A 0000*              	LHLD	JKBK
  0B22'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B25'   E5                    	PUSH	H
  0B26'   EB                    	XCHG
  0B27'   2A 0000*              	LHLD	TXTBEG
  0B2A'   EB                    	XCHG
  0B2B'   CD 0000*              	CALL	SUBHD
  0B2E'   44                    	MOV	B,H
  0B2F'   4D                    	MOV	C,L
  0B30'   E1                    	POP	H
  0B31'   D1                    	POP	D
  0B32'                         KC_SC:
  0B32'   78                    	MOV	A,B
  0B33'   B1                    	ORA	C
  0B34'   CA 0B4B'              	JZ	KC_TB
  0B37'   2B                    	DCX	H
  0B38'   0B                    	DCX	B
  0B39'   7E                    	MOV	A,M
  0B3A'   FE 0A                 	CPI	LF
  0B3C'   C2 0B32'              	JNZ	KC_SC
  0B3F'   1B                    	DCX	D
  0B40'   7A                    	MOV	A,D
  0B41'   B3                    	ORA	E
  0B42'   C2 0B32'              	JNZ	KC_SC
  0B45'   2A 0000*              	LHLD	JKCNT		; N lines above: the move is count lines
  0B48'   C3 0B6B'              	JMP	KC_MV
  0B4B'                         KC_TB:
  0B4B'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B4C'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B4F'   22 0000*              	SHLD	JKBK
  0B52'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B55'   7C                    	MOV	A,H
  0B56'   B5                    	ORA	L
  0B57'   CA 0B64'              	JZ	KC_B0
  0B5A'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B5D'   D1                    	POP	D
  0B5E'   DA 0B65'              	JC	KC_BOF
  0B61'   C3 0B1E'              	JMP	KC_ED
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B64'                         KC_B0:
  0B64'   D1                    	POP	D
  0B65'                         KC_BOF:
  0B65'   2A 0000*              	LHLD	JKN		; moved = LFs found
  0B68'   CD 0000*              	CALL	SUBHD
  0B6B'                         KC_MV:
  0B6B'   E5                    	PUSH	H
  0B6C'   2A 0000*              	LHLD	JKCNT
  0B6F'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B72'   D1                    	POP	D		; DE = moved
  0B73'   2A 0000*              	LHLD	JKN
  0B76'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B79'   DA 0B7D'              	JC	KC_AD
  0B7C'   EB                    	XCHG			; DE = N
  0B7D'                         KC_AD:
  0B7D'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B80'   CD 0000*              	CALL	SUBHD
  0B83'   22 0000*              	SHLD	LNDLT
  0B86'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0B87'                         KC_QK:
  0B87'   22 0000*              	SHLD	JKN		; N = the count
  0B8A'   2A 0000*              	LHLD	TXTBEG
  0B8D'   EB                    	XCHG
  0B8E'   2A 0000*              	LHLD	GAPBEG
  0B91'   E5                    	PUSH	H
  0B92'   CD 0000*              	CALL	SUBHD
  0B95'   44                    	MOV	B,H
  0B96'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0B97'   E1                    	POP	H
  0B98'   3A 0000*              	LDA	JKN
  0B9B'   3C                    	INR	A
  0B9C'   5F                    	MOV	E,A		; E = LFs to find
  0B9D'   16 0A                 	MVI	D,LF
  0B9F'   04                    	INR	B
  0BA0'   0C                    	INR	C
  0BA1'                         KQ_LP:
  0BA1'   0D                    	DCR	C
  0BA2'   C2 0BA9'              	JNZ	KQ_CH
  0BA5'   05                    	DCR	B
  0BA6'   CA 0BC9'              	JZ	KQ_TB
  0BA9'                         KQ_CH:
  0BA9'   2B                    	DCX	H
  0BAA'   7E                    	MOV	A,M
  0BAB'   BA                    	CMP	D
  0BAC'   C2 0BA1'              	JNZ	KQ_LP
  0BAF'   1D                    	DCR	E
  0BB0'   C2 0BA1'              	JNZ	KQ_LP
  0BB3'   23                    	INX	H
  0BB4'                         KQ_GO:
  0BB4'   CD 0000*              	CALL	PUTCUR
  0BB7'   21 0000               	LXI	H,0
  0BBA'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BBD'   3E FF                 	MVI	A,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BBF'   32 0000*              	STA	DIRFLG
  0BC2'   2A 0000*              	LHLD	JKCNT
  0BC5'   EB                    	XCHG			; DE = the lines moved
  0BC6'   C3 0B7D'              	JMP	KC_AD
  0BC9'                         KQ_TB:
  0BC9'   1D                    	DCR	E
  0BCA'   C2 0B14'              	JNZ	KC_SL
  0BCD'   2A 0000*              	LHLD	OUTPOS
  0BD0'   7C                    	MOV	A,H
  0BD1'   B5                    	ORA	L
  0BD2'   C2 0B14'              	JNZ	KC_SL
  0BD5'   2A 0000*              	LHLD	TXTBEG
  0BD8'   C3 0BB4'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BDB'                         ATEOF:
  0BDB'   CD 0000*              	CALL	RGET0
  0BDE'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0BE1'                         LASTLN:
  0BE1'   2A 0000*              	LHLD	GAPBEG
  0BE4'   EB                    	XCHG
  0BE5'   2A 0000*              	LHLD	TXTBEG
  0BE8'   CD 0000*              	CALL	CMP16
  0BEB'   21 0000               	LXI	H,0
  0BEE'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0BF1'   1B                    	DCX	D
  0BF2'   1A                    	LDAX	D
  0BF3'   FE 0A                 	CPI	LF
  0BF5'   C2 0000*              	JNZ	SETBWD
  0BF8'   23                    	INX	H
  0BF9'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0BFC'                         JKLAND:
  0BFC'   21 0000               	LXI	H,0
  0BFF'   22 0000*              	SHLD	JKVC		; screen column
  0C02'   2B                    	DCX	H
  0C03'   22 0000*              	SHLD	JKLS		; last content char: none yet
  0C06'   CD 0000*              	CALL	RGET0
  0C09'   11 0000               	LXI	D,0		; DE = chars read
  0C0C'                         JL_RD:
  0C0C'   CD 0000*              	CALL	RDGET
  0C0F'   DA 0C49'              	JC	JL_END
  0C12'   FE 0A                 	CPI	LF
  0C14'   CA 0C49'              	JZ	JL_END
  0C17'   E5                    	PUSH	H
  0C18'   C5                    	PUSH	B
  0C19'   2A 0000*              	LHLD	JKVC
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C1C'   CD 0665'              	CALL	CWID
  0C1F'   B7                    	ORA	A
  0C20'   CA 0C43'              	JZ	JL_NX		; a CR
  0C23'   EB                    	XCHG
  0C24'   22 0000*              	SHLD	JKLS		; the last content char so far
  0C27'   EB                    	XCHG
  0C28'   4F                    	MOV	C,A
  0C29'   06 00                 	MVI	B,0
  0C2B'   09                    	DAD	B		; HL = the column after this char
  0C2C'   22 0000*              	SHLD	JKVC
  0C2F'   D5                    	PUSH	D
  0C30'   EB                    	XCHG
  0C31'   2A 2F0B'              	LHLD	GOALCOL
  0C34'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C37'   D1                    	POP	D
  0C38'   DA 0C43'              	JC	JL_NX
  0C3B'   CA 0C43'              	JZ	JL_NX
  0C3E'   C1                    	POP	B		; this char holds the goal column
  0C3F'   E1                    	POP	H
  0C40'   C3 0C54'              	JMP	JL_GO
  0C43'                         JL_NX:
  0C43'   C1                    	POP	B
  0C44'   E1                    	POP	H
  0C45'   13                    	INX	D
  0C46'   C3 0C0C'              	JMP	JL_RD
  0C49'                         JL_END:
  0C49'   2A 0000*              	LHLD	JKLS		; past the line's end: its last content char
  0C4C'   7C                    	MOV	A,H
  0C4D'   A5                    	ANA	L
  0C4E'   3C                    	INR	A
  0C4F'   C2 0C53'              	JNZ	JL_LS
  0C52'   23                    	INX	H		; no content: the line's start
  0C53'                         JL_LS:
  0C53'   EB                    	XCHG
  0C54'                         JL_GO:
  0C54'   D5                    	PUSH	D		; DE = step from the line start
  0C55'   CD 0000*              	CALL	CUROFF
  0C58'   D1                    	POP	D
  0C59'   19                    	DAD	D
  0C5A'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C5D'   AF                    VC_W:	XRA	A
  0C5E'   32 0000*              	STA	WBIG
  0C61'   C3 0C69'              	JMP	WDO
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C64'   3E 01                 VCBGW:	MVI	A,1
  0C66'   32 0000*              	STA	WBIG
  0C69'   CD 0852'              WDO:	CALL	SETMOV
  0C6C'   AF                    	XRA	A
  0C6D'   32 0000*              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C70'   CD 077D'              	CALL	GETCNT
  0C73'   22 0000*              	SHLD	CNTV
  0C76'   2A 0000*              WDO_LP: LHLD	CNTV
  0C79'   7C                    	MOV	A,H
  0C7A'   B5                    	ORA	L
  0C7B'   CA 0C88'              	JZ	WDO_DN
  0C7E'   2B                    	DCX	H
  0C7F'   22 0000*              	SHLD	CNTV
  0C82'   CD 0CE5'              	CALL	FWD1
  0C85'   D2 0C76'              	JNC	WDO_LP
  0C88'                         WDO_DN:
  0C88'   CD 0BDB'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0C8B'   DA 0C98'              	JC	WDO_NL
  0C8E'   FE 0D                 	CPI	CR
  0C90'   CA 0C98'              	JZ	WDO_NL
  0C93'   FE 0A                 	CPI	LF
  0C95'   C2 0611'              	JNZ	SETGL
  0C98'                         WDO_NL:
  0C98'   CD 0000*              	CALL	PEEKL
  0C9B'   DA 0611'              	JC	SETGL
  0C9E'   FE 0A                 	CPI	LF
  0CA0'   CA 0611'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0CA3'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0CA5'   32 0000*              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0CA8'   CD 0E04'              	CALL	DECC		; back onto its last char
  0CAB'   C3 0611'              	JMP	SETGL
                                
  0CAE'   AF                    VC_B:	XRA	A
  0CAF'   32 0000*              	STA	WBIG
  0CB2'   C3 0CBA'              	JMP	BDO
  0CB5'   3E 01                 VCBGB:	MVI	A,1
  0CB7'   32 0000*              	STA	WBIG
  0CBA'   CD 0852'              BDO:	CALL	SETMOV
  0CBD'   CD 077D'              	CALL	GETCNT
  0CC0'   22 0000*              	SHLD	CNTV
  0CC3'   CD 0D55'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CC6'   D2 0CD6'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CC9'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CCA'   32 0000*              	STA	PSAVE		;   first char opened an insert).  A count that
  0CCD'   C3 0611'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CD0'                         BDO_LP:				;   its operator stands -- both as vim
  0CD0'   CD 0D55'              	CALL	BCK1
  0CD3'   DA 0611'              	JC	SETGL
  0CD6'   2A 0000*              BDO_NX: LHLD	CNTV
  0CD9'   2B                    	DCX	H
  0CDA'   22 0000*              	SHLD	CNTV
  0CDD'   7C                    	MOV	A,H
  0CDE'   B5                    	ORA	L
  0CDF'   C2 0CD0'              	JNZ	BDO_LP
  0CE2'   C3 0611'              	JMP	SETGL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0CE5'                         FWD1:
  0CE5'   CD 0D88'              	CALL	CCLS
  0CE8'   32 0000*              	STA	WKCLS		; the starting class
  0CEB'   CD 0DC2'              	CALL	INCC
  0CEE'   B7                    	ORA	A
  0CEF'   CA 0D08'              	JZ	FW_WD
  0CF2'   37                    	STC
  0CF3'   F8                    	RM			; -1: already at the end
  0CF4'   CD 0D40'              	CALL	WLAST
  0CF7'   C8                    	RZ
  0CF8'   FE 02                 	CPI	2
  0CFA'   C2 0D08'              	JNZ	FW_WD		; 1: a next line was reached
  0CFD'   CD 0BDB'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0D00'   D4 0DA9'              	CNC	NXLN
  0D03'   D2 0D08'              	JNC	FW_WD
  0D06'   37                    	STC			; yes: failed
  0D07'   C9                    	RET
  0D08'                         FW_WD:
  0D08'   3A 0000*              	LDA	WKCLS		; go past the rest of this word
  0D0B'   B7                    	ORA	A
  0D0C'   CA 0D28'              	JZ	FW_WS
  0D0F'                         FW_WLP:
  0D0F'   CD 0D88'              	CALL	CCLS
  0D12'   21 0000*              	LXI	H,WKCLS
  0D15'   BE                    	CMP	M
  0D16'   C2 0D28'              	JNZ	FW_WS
  0D19'   CD 0DC2'              	CALL	INCC
  0D1C'   B7                    	ORA	A
  0D1D'   F8                    	RM			; the end of the file (NC)
  0D1E'   CA 0D0F'              	JZ	FW_WLP
  0D21'   CD 0D40'              	CALL	WLAST
  0D24'   C8                    	RZ
  0D25'   C3 0D0F'              	JMP	FW_WLP
  0D28'                         FW_WS:
  0D28'   CD 0D88'              	CALL	CCLS		; then over blanks to the next word
  0D2B'   B7                    	ORA	A
  0D2C'   C0                    	RNZ
  0D2D'   CD 0D90'              	CALL	EMPTY
  0D30'   C8                    	RZ			; an empty line is a word
  0D31'   CD 0DC2'              	CALL	INCC
  0D34'   B7                    	ORA	A
  0D35'   F8                    	RM
  0D36'   CA 0D28'              	JZ	FW_WS
  0D39'   CD 0D40'              	CALL	WLAST
  0D3C'   C8                    	RZ
  0D3D'   C3 0D28'              	JMP	FW_WS
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D40'                         WLAST:
  0D40'   47                    	MOV	B,A
  0D41'   2A 0000*              	LHLD	CNTV
  0D44'   7C                    	MOV	A,H
  0D45'   B5                    	ORA	L
  0D46'   C2 0D51'              	JNZ	WL_X		; words still owed
  0D49'   3A 0000*              	LDA	PSAVE
  0D4C'   B7                    	ORA	A
  0D4D'   CA 0D53'              	JZ	WL_NO		; a plain 'w'
  0D50'   AF                    	XRA	A
  0D51'   78                    WL_X:	MOV	A,B
  0D52'   C9                    	RET
  0D53'   B0                    WL_NO:	ORA	B
  0D54'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D55'                         BCK1:
  0D55'   CD 0E04'              	CALL	DECC
  0D58'   B7                    	ORA	A
  0D59'   37                    	STC
  0D5A'   F8                    	RM
  0D5B'                         BK_WS:
  0D5B'   CD 0D88'              	CALL	CCLS		; back over blanks
  0D5E'   B7                    	ORA	A
  0D5F'   C2 0D6F'              	JNZ	BK_WD
  0D62'   CD 0D90'              	CALL	EMPTY
  0D65'   C8                    	RZ			; an empty line is a word
  0D66'   CD 0E04'              	CALL	DECC
  0D69'   B7                    	ORA	A
  0D6A'   F2 0D5B'              	JP	BK_WS
  0D6D'   AF                    	XRA	A		; the start of the file (NC)
  0D6E'   C9                    	RET
  0D6F'                         BK_WD:
  0D6F'   32 0000*              	STA	WKCLS		; back to the start of this word
  0D72'                         BK_WLP:
  0D72'   CD 0E04'              	CALL	DECC
  0D75'   B7                    	ORA	A
  0D76'   FA 0D86'              	JM	BK_OK		; the start of the file
  0D79'   CD 0D88'              	CALL	CCLS
  0D7C'   21 0000*              	LXI	H,WKCLS
  0D7F'   BE                    	CMP	M
  0D80'   CA 0D72'              	JZ	BK_WLP
  0D83'   CD 0DC2'              	CALL	INCC		; overshot: forward one
  0D86'                         BK_OK:
  0D86'   AF                    	XRA	A
  0D87'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0D88'                         CCLS:
  0D88'   CD 0BDB'              	CALL	ATEOF
  0D8B'   D2 0807'              	JNC	CLASSF
  0D8E'   AF                    	XRA	A
  0D8F'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0D90'                         EMPTY:
  0D90'   CD 0BDB'              	CALL	ATEOF
  0D93'   DA 0D9E'              	JC	EM_ST
  0D96'   FE 0D                 	CPI	CR
  0D98'   CA 0D9E'              	JZ	EM_ST
  0D9B'   FE 0A                 	CPI	LF
  0D9D'   C0                    	RNZ
  0D9E'                         EM_ST:
  0D9E'   CD 0000*              	CALL	PEEKL
  0DA1'   DA 0DA7'              	JC	EM_Y
  0DA4'   FE 0A                 	CPI	LF
  0DA6'   C9                    	RET
  0DA7'                         EM_Y:
  0DA7'   AF                    	XRA	A
  0DA8'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0DA9'                         NXLN:
  0DA9'   FE 0A                 	CPI	LF
  0DAB'   CA 0DBA'              	JZ	NX_LF
  0DAE'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DB1'   D8                    	RC
  0DB2'   FE 0A                 	CPI	LF
  0DB4'   CA 0DBA'              	JZ	NX_LF
  0DB7'   2B                    	DCX	H		; a lone CR
  0DB8'   AF                    	XRA	A
  0DB9'   C9                    	RET
  0DBA'                         NX_LF:
  0DBA'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DBD'   D8                    	RC
  0DBE'   2B                    	DCX	H
  0DBF'   3E 01                 	MVI	A,1
  0DC1'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DC2'                         INCC:
  0DC2'   CD 0BDB'              	CALL	ATEOF
  0DC5'   DA 0E00'              	JC	IC_END
  0DC8'   FE 0D                 	CPI	CR
  0DCA'   CA 0DEB'              	JZ	IC_NL
  0DCD'   FE 0A                 	CPI	LF
  0DCF'   CA 0DEB'              	JZ	IC_NL
  0DD2'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DD5'                         IC_CH:
  0DD5'   CD 0BDB'              	CALL	ATEOF
  0DD8'   DA 0DE7'              	JC	IC_2
  0DDB'   FE 0D                 	CPI	CR
  0DDD'   CA 0DE7'              	JZ	IC_2
  0DE0'   FE 0A                 	CPI	LF
  0DE2'   CA 0DE7'              	JZ	IC_2
  0DE5'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DE6'   C9                    	RET
  0DE7'                         IC_2:
  0DE7'   3E 02                 	MVI	A,2
  0DE9'   B7                    	ORA	A
  0DEA'   C9                    	RET
  0DEB'                         IC_NL:
  0DEB'   CD 0DA9'              	CALL	NXLN
  0DEE'   DA 0E00'              	JC	IC_END
  0DF1'   F5                    	PUSH	PSW
  0DF2'   CD 0000*              	CALL	PUTCUR
  0DF5'   F1                    	POP	PSW
  0DF6'   B7                    	ORA	A
  0DF7'   CA 0DD5'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0DFA'   CD 0E26'              	CALL	LNINC
  0DFD'   3E 01                 	MVI	A,1
  0DFF'   C9                    	RET
  0E00'                         IC_END:
  0E00'   3E FF                 	MVI	A,0FFH
  0E02'   B7                    	ORA	A
  0E03'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0E04'                         DECC:
  0E04'   CD 0000*              	CALL	PEEKL
  0E07'   DA 0E00'              	JC	IC_END
  0E0A'   F5                    	PUSH	PSW
  0E0B'   CD 0000*              	CALL	PUTCUR
  0E0E'   F1                    	POP	PSW
  0E0F'   FE 0A                 	CPI	LF
  0E11'   3E 00                 	MVI	A,0
  0E13'   C0                    	RNZ
  0E14'   CD 0E34'              	CALL	LNDEC
  0E17'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E1A'   DA 0E22'              	JC	DC_1
  0E1D'   FE 0D                 	CPI	CR
  0E1F'   CC 0000*              	CZ	PUTCUR
  0E22'                         DC_1:
  0E22'   3E 01                 	MVI	A,1
  0E24'   B7                    	ORA	A
  0E25'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E26'                         LNINC:
  0E26'   E5                    	PUSH	H
  0E27'   2A 0000*              	LHLD	LNDLT
  0E2A'   7C                    	MOV	A,H
  0E2B'   FE 40                 	CPI	40H
  0E2D'   CA 0E42'              	JZ	LN_X
  0E30'   23                    	INX	H
  0E31'   C3 0E3F'              	JMP	LN_ST
  0E34'                         LNDEC:
  0E34'   E5                    	PUSH	H
  0E35'   2A 0000*              	LHLD	LNDLT
  0E38'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E39'   FE C0                 	CPI	0C0H
  0E3B'   CA 0E42'              	JZ	LN_X
  0E3E'   2B                    	DCX	H
  0E3F'                         LN_ST:
  0E3F'   22 0000*              	SHLD	LNDLT
  0E42'                         LN_X:
  0E42'   E1                    	POP	H
  0E43'   C9                    	RET
                                
  0E44'   AF                    VC_E:	XRA	A
  0E45'   32 0000*              	STA	WBIG
  0E48'   C3 0E50'              	JMP	EDO
  0E4B'   3E 01                 VCBGE:	MVI	A,1
  0E4D'   32 0000*              	STA	WBIG
  0E50'   CD 0852'              EDO:	CALL	SETMOV
  0E53'   CD 077D'              	CALL	GETCNT
  0E56'   22 0000*              	SHLD	CNTV
  0E59'   2A 0000*              EDO_LP: LHLD	CNTV
  0E5C'   7C                    	MOV	A,H
  0E5D'   B5                    	ORA	L
  0E5E'   CA 0C88'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E61'   2B                    	DCX	H
  0E62'   22 0000*              	SHLD	CNTV
  0E65'   CD 0E73'              	CALL	ESTEP
  0E68'   21 0000*              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E6B'   36 00                 	MVI	M,0
  0E6D'   D2 0E59'              	JNC	EDO_LP
  0E70'   C3 0C88'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E73'                         ESTEP:
  0E73'   CD 0D88'              	CALL	CCLS
  0E76'   32 0000*              	STA	WKCLS		; the starting class
  0E79'   CD 0DC2'              	CALL	INCC
  0E7C'   B7                    	ORA	A
  0E7D'   FA 0EA3'              	JM	ES_F
  0E80'   CD 0D88'              	CALL	CCLS
  0E83'   B7                    	ORA	A
  0E84'   CA 0E8E'              	JZ	ES_ST
  0E87'   21 0000*              	LXI	H,WKCLS
  0E8A'   BE                    	CMP	M
  0E8B'   CA 0EA5'              	JZ	ES_SK		; still in the word it started in: on to its end
  0E8E'                         ES_ST:
  0E8E'   3A 0000*              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0E91'   B7                    	ORA	A		;   that char is the word's end already, and
  0E92'   C2 0EBC'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0E95'                         ES_WS:
  0E95'   CD 0D88'              	CALL	CCLS		; over blanks, line ends and empty lines
  0E98'   B7                    	ORA	A
  0E99'   C2 0EA5'              	JNZ	ES_SK
  0E9C'   CD 0DC2'              	CALL	INCC
  0E9F'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EA0'   F2 0E95'              	JP	ES_WS
  0EA3'                         ES_F:
  0EA3'   37                    	STC
  0EA4'   C9                    	RET
  0EA5'                         ES_SK:
  0EA5'   CD 0D88'              	CALL	CCLS		; past the rest of this word ...
  0EA8'   32 0000*              	STA	WKCLS
  0EAB'                         ES_SL:
  0EAB'   CD 0DC2'              	CALL	INCC
  0EAE'   B7                    	ORA	A
  0EAF'   FA 0EA3'              	JM	ES_F
  0EB2'   CD 0D88'              	CALL	CCLS
  0EB5'   21 0000*              	LXI	H,WKCLS
  0EB8'   BE                    	CMP	M
  0EB9'   CA 0EAB'              	JZ	ES_SL
  0EBC'   C3 0E04'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EBF'                         CURRW:
  0EBF'   2A 0000*              	LHLD	WINROW
  0EC2'   EB                    	XCHG
  0EC3'   2A 0000*              	LHLD	LNDLT
  0EC6'   19                    	DAD	D		; HL = row (signed)
  0EC7'   7C                    	MOV	A,H
  0EC8'   B7                    	ORA	A
  0EC9'   FA 0EDC'              	JM	CRW_0		; above the screen -> top row
  0ECC'   C2 0ED7'              	JNZ	CRW_BT		; far below -> bottom row
  0ECF'   3A 0000*              	LDA	NEDIT
  0ED2'   3D                    	DCR	A		; A = bottom row
  0ED3'   BD                    	CMP	L		; CY iff bottom < row
  0ED4'   D8                    	RC
  0ED5'   7D                    	MOV	A,L
  0ED6'   C9                    	RET
  0ED7'                         CRW_BT:
  0ED7'   3A 0000*              	LDA	NEDIT
  0EDA'   3D                    	DCR	A
  0EDB'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EDC'                         CRW_0:
  0EDC'   AF                    	XRA	A
  0EDD'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0EDE'                         SETRWT:
  0EDE'   2A 0000*              	LHLD	LNDLT
  0EE1'   EB                    	XCHG
  0EE2'   6F                    	MOV	L,A
  0EE3'   26 00                 	MVI	H,0
  0EE5'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0EE8'   22 0000*              	SHLD	WINROW
  0EEB'   3E 01                 	MVI	A,PL_SET
  0EED'   32 0000*              	STA	PLACE
  0EF0'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0EF1'                         MVROW:
  0EF1'   47                    	MOV	B,A
  0EF2'   CD 0EBF'              	CALL	CURRW
  0EF5'   90                    	SUB	B		; A = row now - target
  0EF6'                         MR_GO:
  0EF6'   C8                    	RZ
  0EF7'   DA 0F00'              	JC	MR_DN
  0EFA'   6F                    	MOV	L,A
  0EFB'   26 00                 	MVI	H,0
  0EFD'   C3 0AF3'              	JMP	KCORE
  0F00'                         MR_DN:
  0F00'   2F                    	CMA
  0F01'   3C                    	INR	A		; A = target - row now
  0F02'   6F                    	MOV	L,A
  0F03'   26 00                 	MVI	H,0
  0F05'   C3 0A13'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0F08'                         VC_HIGH:
  0F08'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F0B'   2B                    	DCX	H		; row = count - 1
  0F0C'   7C                    	MOV	A,H
  0F0D'   B7                    	ORA	A
  0F0E'   3A 0000*              	LDA	SCBOT
  0F11'   C2 0F19'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F14'   BD                    	CMP	L		; CY iff SCBOT < row
  0F15'   DA 0F19'              	JC	VH_GO
  0F18'   7D                    	MOV	A,L
  0F19'                         VH_GO:
  0F19'   CD 0EF1'              	CALL	MVROW
  0F1C'   C3 0958'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F1F'                         VC_MIDL:
  0F1F'   CD 076A'              	CALL	MOVCNT		; a cursor motion; the count is discarded
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F22'   CD 11B1'              	CALL	HTSCR		; HL -> the top line's rows
  0F25'   3A 0000*              	LDA	TXEND
  0F28'   3C                    	INR	A
  0F29'   B7                    	ORA	A
  0F2A'   1F                    	RAR
  0F2B'   3D                    	DCR	A
  0F2C'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F2D'   CD 11F7'              	CALL	HTFQ
  0F30'   D2 0F34'              	JNC	VM_GO
  0F33'   2B                    	DCX	H
  0F34'                         VM_GO:
  0F34'   CD 11EC'              	CALL	HTGO
  0F37'   C3 0958'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0F3A'                         VC_LOWL:
  0F3A'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F3D'   2B                    	DCX	H		; count - 1
  0F3E'   3A 0000*              	LDA	SCBOT
  0F41'   5F                    	MOV	E,A
  0F42'   16 00                 	MVI	D,0
  0F44'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F45'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F48'   3E 00                 	MVI	A,0
  0F4A'   D2 0F51'              	JNC	VL_GO		; at or past the top -> row 0
  0F4D'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0F50'   7D                    	MOV	A,L
  0F51'                         VL_GO:
  0F51'   CD 0EF1'              	CALL	MVROW
  0F54'   C3 0958'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F57'                         VC_PGDN:
  0F57'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F5A'   22 0000*              	SHLD	RWR
  0F5D'   3A 0000*              	LDA	SCEOF
  0F60'   B7                    	ORA	A
  0F61'   CA 0F69'              	JZ	VPD_N
  0F64'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F67'   B7                    	ORA	A		;   top line
  0F68'   C8                    	RZ			; it already is
  0F69'                         VPD_N:
  0F69'   3A 0000*              	LDA	NEDIT
  0F6C'   3C                    	INR	A
  0F6D'   4F                    	MOV	C,A
  0F6E'   3E 02                 	MVI	A,2
  0F70'   CD 11B8'              	CALL	HTSET		; HL -> the top line's rows
  0F73'   E5                    	PUSH	H
  0F74'   C5                    	PUSH	B
  0F75'   3A 0000*              	LDA	NEDIT
