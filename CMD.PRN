                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  107F'                         MULSAT:
  107F'   EB                    	XCHG
  1080'   21 0000               	LXI	H,0
  1083'   B7                    	ORA	A
  1084'   C8                    	RZ
