  0B4D'   CD 0B0B'              	CALL	NXLN
  0B50'   DA 0B62'              	JC	IC_END
  0B53'   F5                    	PUSH	PSW
  0B54'   CD 0000*              	CALL	PUTCUR
  0B57'   F1                    	POP	PSW
  0B58'   B7                    	ORA	A
  0B59'   CA 0B37'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B5C'   CD 0B88'              	CALL	LNINC
  0B5F'   3E 01                 	MVI	A,1
  0B61'   C9                    	RET
  0B62'                         IC_END:
  0B62'   3E FF                 	MVI	A,0FFH
  0B64'   B7                    	ORA	A
  0B65'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B66'                         DECC:
  0B66'   CD 0000*              	CALL	PEEKL
  0B69'   DA 0B62'              	JC	IC_END
  0B6C'   F5                    	PUSH	PSW
  0B6D'   CD 0000*              	CALL	PUTCUR
  0B70'   F1                    	POP	PSW
  0B71'   FE 0A                 	CPI	LF
  0B73'   3E 00                 	MVI	A,0
