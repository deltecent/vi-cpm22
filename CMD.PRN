  0B89'   2A 0000*              	LHLD	LNDLT
  0B8C'   7C                    	MOV	A,H
  0B8D'   FE 40                 	CPI	40H
  0B8F'   CA 0BA4'              	JZ	LN_X
  0B92'   23                    	INX	H
  0B93'   C3 0BA1'              	JMP	LN_ST
  0B96'                         LNDEC:
