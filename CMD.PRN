                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  0003                   C      CTRLC	EQU	03H		; ^C -- abandons a search or a long move
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- a ^C waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to a ^C by the
  0001'   32 2AC9'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00DD'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 0134'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2A16'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1B60'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1AA0'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   78                    	MOV	A,B
  0024'   FE 00                 	CPI	KT_NONE
  0026'   C8                    	RZ			; discarded key
  0027'   FE 01                 	CPI	KT_ACT
  0029'   CA 00AF'              	JZ	VIC_ACT
  002C'   3A 2A3E'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 16AD'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 2A17'              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 2A17'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 2A17'              	SHLD	CMDCNT
  0077'   C3 0758'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 2A3E'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 2A3F'              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 2A3E'              	STA	GPEND
  0084'   3A 2A40'              	LDA	PENDOP
  0087'   32 2A41'              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 2A40'              	STA	PENDOP
  008E'   3A 2A41'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 1070'              	JNZ	OPPEND
  0095'   3A 2A3F'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 2945'              	LXI	H,CMDTAB
  00A6'   C3 00C2'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 0758'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 0689'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ACT:
  00AF'   AF                    	XRA	A		; action key clears all pending state
  00B0'   32 2A3E'              	STA	GPEND
  00B3'   32 2A3F'              	STA	GSAVE
  00B6'   32 2A40'              	STA	PENDOP
  00B9'   32 2A41'              	STA	PSAVE
  00BC'   21 29FD'              	LXI	H,ACTTAB
  00BF'   C3 00C2'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00C2'                         VSCANQ:
  00C2'   CD 00CE'              	CALL	VSCLK
  00C5'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C8'   E9                    	PCHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'                         VSCAN:
  00C9'   CD 00CE'              	CALL	VSCLK
  00CC'   C8                    	RZ			; miss
  00CD'   E9                    	PCHL
  00CE'                         VSCLK:
  00CE'   7E                    VSCAN1: MOV	A,M
  00CF'   B7                    	ORA	A
  00D0'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00D1'   23                    	INX	H
  00D2'   B9                    	CMP	C
  00D3'   5E                    	MOV	E,M
  00D4'   23                    	INX	H
  00D5'   56                    	MOV	D,M
  00D6'   23                    	INX	H
  00D7'   C2 00CE'              	JNZ	VSCAN1
  00DA'   EB                    	XCHG			; HL = the handler
  00DB'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00DC'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DD'                         DOTPRE:
  00DD'   3A 2A35'              	LDA	DOTRPL
  00E0'   B7                    	ORA	A
  00E1'   C0                    	RNZ			; the replay's own keys are not recorded
  00E2'   C5                    	PUSH	B
  00E3'   D5                    	PUSH	D
  00E4'   E5                    	PUSH	H
  00E5'   3A 2A34'              	LDA	DOTSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E8'   B7                    	ORA	A
  00E9'   CA 00FC'              	JZ	DOTP1
  00EC'   AF                    	XRA	A		; a new command: the recording starts over
  00ED'   32 2A34'              	STA	DOTSTA
  00F0'   32 2A36'              	STA	DOTOVF
  00F3'   21 0000*              	LXI	H,DOTSCR
  00F6'   22 2A38'              	SHLD	DOTSP
  00F9'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00FC'                         DOTP1:
  00FC'   78                    	MOV	A,B
  00FD'   FE 00                 	CPI	KT_NONE
  00FF'   CA 0128'              	JZ	DOTPX		; a discarded key is not a keystroke
  0102'   FE 01                 	CPI	KT_ACT
  0104'   79                    	MOV	A,C
  0105'   CA 010D'              	JZ	DOTP2
  0108'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  010A'   C3 010F'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  010D'                         DOTP2:
  010D'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010F'                         DOTP3:
  010F'   32 2A37'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  0112'   47                    	MOV	B,A
  0113'   2A 2A38'              	LHLD	DOTSP
  0116'   EB                    	XCHG
  0117'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  011A'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  011D'   D2 012C'              	JNC	DOTPOV
  0120'   2A 2A38'              	LHLD	DOTSP
  0123'   70                    	MOV	M,B
  0124'   23                    	INX	H
  0125'   22 2A38'              	SHLD	DOTSP
  0128'                         DOTPX:
  0128'   E1                    	POP	H
  0129'   D1                    	POP	D
  012A'   C1                    	POP	B
  012B'   C9                    	RET
  012C'                         DOTPOV:
  012C'   3E 01                 	MVI	A,1
  012E'   32 2A36'              	STA	DOTOVF		; too long to record: give this recording up
  0131'   C3 0128'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0134'                         DOTPOST:
  0134'   3A 2A35'              	LDA	DOTRPL
  0137'   B7                    	ORA	A
  0138'   C0                    	RNZ
  0139'   3A 2A16'              	LDA	EDMODE
  013C'   B7                    	ORA	A
  013D'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013E'   3A 2A3E'              	LDA	GPEND
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  0143'   3A 2A40'              	LDA	PENDOP
  0146'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0147'   C0                    	RNZ			; an operator still waiting for its motion
  0148'   2A 2A17'              	LHLD	CMDCNT
  014B'   7C                    	MOV	A,H
  014C'   B5                    	ORA	L
  014D'   CA 015B'              	JZ	DOTQ1
  0150'   3A 2A37'              	LDA	DOTLK		; a digit with the count still up: the command
  0153'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0155'   DA 015B'              	JC	DOTQ1
  0158'   FE 3A                 	CPI	'9'+1
  015A'   D8                    	RC
  015B'                         DOTQ1:
  015B'   3E 01                 	MVI	A,1
  015D'   32 2A34'              	STA	DOTSTA		; the next key starts a new recording
  0160'   3A 2A33'              	LDA	DOTCHG
  0163'   B7                    	ORA	A
  0164'   C8                    	RZ			; changed nothing: not a repeatable command
  0165'   AF                    	XRA	A
  0166'   32 2A33'              	STA	DOTCHG
  0169'   32 2A3A'              	STA	DOTLEN
  016C'   3A 2A36'              	LDA	DOTOVF
  016F'   B7                    	ORA	A
  0170'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0171'   2A 2A38'              	LHLD	DOTSP
  0174'   11 0000*              	LXI	D,DOTSCR
  0177'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  017A'   7D                    	MOV	A,L
  017B'   32 2A3A'              	STA	DOTLEN
  017E'   B7                    	ORA	A
  017F'   C8                    	RZ
  0180'   4F                    	MOV	C,A
  0181'   06 00                 	MVI	B,0
  0183'   21 0000*              	LXI	H,DOTSCR
  0186'   11 0000*              	LXI	D,DOTBUF
  0189'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  018C'                         MARKMOD:
  018C'   3E 01                 	MVI	A,1
  018E'   32 2A1A'              	STA	MODF
  0191'   32 2A33'              	STA	DOTCHG
  0194'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0195'                         VC_DOT:
  0195'   2A 2A17'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0198'   22 2A3C'              	SHLD	DOTNCT
  019B'   21 0000               	LXI	H,0
  019E'   22 2A17'              	SHLD	CMDCNT
  01A1'   3A 2A3A'              	LDA	DOTLEN
  01A4'   B7                    	ORA	A
  01A5'   CA 01FF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A8'   AF                    	XRA	A
  01A9'   32 2A3B'              	STA	DOTIX
  01AC'   2A 2A3C'              	LHLD	DOTNCT
  01AF'   7C                    	MOV	A,H
  01B0'   B5                    	ORA	L
  01B1'   CA 01D1'              	JZ	DOTGO
  01B4'   22 2A17'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B7'                         DOTSKP:
  01B7'   CD 0562'              	CALL	DOTGET		; ... so step past the digits it recorded
  01BA'   DA 01D1'              	JC	DOTGO
  01BD'   FE 30                 	CPI	'0'
  01BF'   DA 01D1'              	JC	DOTGO
  01C2'   FE 3A                 	CPI	'9'+1
  01C4'   D2 01D1'              	JNC	DOTGO
  01C7'   3A 2A3B'              	LDA	DOTIX
  01CA'   3C                    	INR	A
  01CB'   32 2A3B'              	STA	DOTIX
  01CE'   C3 01B7'              	JMP	DOTSKP
  01D1'                         DOTGO:
  01D1'   3E 01                 	MVI	A,1
  01D3'   32 2A35'              	STA	DOTRPL
  01D6'                         DOTLP:
  01D6'   CD 0562'              	CALL	DOTGET
  01D9'   DA 01F5'              	JC	DOTDN
  01DC'   4F                    	MOV	C,A
  01DD'   06 02                 	MVI	B,KT_CHAR
  01DF'   B7                    	ORA	A
  01E0'   F2 01E8'              	JP	DOTLP2
  01E3'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E5'   4F                    	MOV	C,A
  01E6'   06 01                 	MVI	B,KT_ACT
  01E8'                         DOTLP2:
  01E8'   3A 2A3B'              	LDA	DOTIX
  01EB'   3C                    	INR	A
  01EC'   32 2A3B'              	STA	DOTIX
  01EF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F2'   C3 01D6'              	JMP	DOTLP
  01F5'                         DOTDN:
  01F5'   AF                    	XRA	A
  01F6'   32 2A35'              	STA	DOTRPL
  01F9'   32 2A33'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FC'   C3 0779'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FF'                         DOTBEL:
  01FF'   0E 07                 	MVI	C,BEL
  0201'   CD 0000*              	CALL	BCONOU
  0204'   C3 0758'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0207'                         MKVAD:
  0207'   16 00                 	MVI	D,0
  0209'   59                    	MOV	E,C
  020A'   21 2AA5'              	LXI	H,MKVAL
  020D'   19                    	DAD	D
  020E'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020F'                         MKCLR:
  020F'   21 2AA5'              	LXI	H,MKVAL
  0212'   06 03                 	MVI	B,MKMAX
  0214'   AF                    	XRA	A
  0215'                         MKC_LP:
  0215'   77                    	MOV	M,A
  0216'   23                    	INX	H
  0217'   05                    	DCR	B
  0218'   C2 0215'              	JNZ	MKC_LP
  021B'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  021C'                         MKGETK:
  021C'   3A 2A35'              	LDA	DOTRPL
  021F'   B7                    	ORA	A
  0220'   CA 0231'              	JZ	MKG_KB
  0223'   CD 0562'              	CALL	DOTGET		; the recording's next key
  0226'   D8                    	RC
  0227'   4F                    	MOV	C,A
  0228'   3A 2A3B'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022B'   3C                    	INR	A
  022C'   32 2A3B'              	STA	DOTIX
  022F'   B7                    	ORA	A		; CY clear
  0230'   C9                    	RET
  0231'                         MKG_KB:
  0231'   CD 0000*              	CALL	GETKEY
  0234'   78                    	MOV	A,B
  0235'   FE 02                 	CPI	KT_CHAR
  0237'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0238'   C0                    	RNZ			; an action key (ESC) cancels the command
  0239'   CD 00DD'              	CALL	DOTPRE		; B, C kept
  023C'   B7                    	ORA	A		; CY clear
  023D'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023E'                         VC_FF:				; 'f' -- forward, onto the character
  023E'   3E 66                 	MVI	A,'f'
  0240'   C3 024F'              	JMP	FNDNEW
  0243'                         VC_FB:				; 'F' -- backward, onto it
  0243'   3E 46                 	MVI	A,'F'
  0245'   C3 024F'              	JMP	FNDNEW
  0248'                         VC_TF:				; 't' -- forward, up to it
  0248'   3E 74                 	MVI	A,'t'
  024A'   C3 024F'              	JMP	FNDNEW
  024D'                         VC_TB:				; 'T' -- backward, up to it
  024D'   3E 54                 	MVI	A,'T'
  024F'                         FNDNEW:
  024F'   32 2A9A'              	STA	FNDKND		; the find ';' and ',' will repeat
  0252'   CD 021C'              	CALL	MKGETK		; the character it looks for
  0255'   DA 0287'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0258'   79                    	MOV	A,C
  0259'   32 2A9B'              	STA	FNDCH
  025C'   3A 2A9A'              	LDA	FNDKND
  025F'   06 01                 	MVI	B,1		; a find starts at the next character along
  0261'   C3 028E'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0264'                         VC_SEMI:
  0264'   3A 2A9A'              	LDA	FNDKND
  0267'   B7                    	ORA	A
  0268'   CA 0287'              	JZ	FNDNIL		; nothing has been looked for yet
  026B'   C3 0277'              	JMP	FNDREP
  026E'                         VC_COMMA:
  026E'   3A 2A9A'              	LDA	FNDKND
  0271'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0272'   CA 0287'              	JZ	FNDNIL
  0275'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0277'                         FNDREP:
  0277'   06 01                 	MVI	B,1
  0279'   F5                    	PUSH	PSW
  027A'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027C'   FE 54                 	CPI	'T'
  027E'   C2 0283'              	JNZ	FNDR_GO
  0281'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0283'                         FNDR_GO:
  0283'   F1                    	POP	PSW
  0284'   C3 028E'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0287'                         FNDNIL:
  0287'   AF                    	XRA	A
  0288'   32 2A41'              	STA	PSAVE
  028B'   C3 0758'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  028E'                         FNDGO:
  028E'   32 2A9C'              	STA	FNDRUN
  0291'   78                    	MOV	A,B
  0292'   32 2A9D'              	STA	FNDSTP
  0295'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0298'   22 2A9E'              	SHLD	FNDN		; the occurrence wanted
  029B'   CD 0000*              	CALL	CUROFF
  029E'   22 2AA0'              	SHLD	FNDCUR
  02A1'   3A 2A9C'              	LDA	FNDRUN
  02A4'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A6'   CA 02DA'              	JZ	FNDBWD
  02A9'   2A 2AA0'              	LHLD	FNDCUR
  02AC'   CD 0621'              	CALL	EOLC		; HL = the line's last content character
  02AF'   22 2AA2'              	SHLD	FNDLIM
  02B2'   2A 2AA0'              	LHLD	FNDCUR
  02B5'   3A 2A9D'              	LDA	FNDSTP
  02B8'   5F                    	MOV	E,A
  02B9'   16 00                 	MVI	D,0
  02BB'   19                    	DAD	D		; HL = where the scan starts
  02BC'                         FNDF_LP:
  02BC'   EB                    	XCHG			; DE = the scan
  02BD'   2A 2AA2'              	LHLD	FNDLIM
  02C0'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C3'   EB                    	XCHG			; HL = the scan
  02C4'   CA 02CA'              	JZ	FNDF_AT		; the last character is still a candidate
  02C7'   D2 032C'              	JNC	FNDMIS		; past it: not on this line
  02CA'                         FNDF_AT:
  02CA'   CD 0333'              	CALL	FNDSEE		; Z iff this is the character
  02CD'   C2 02D6'              	JNZ	FNDF_NX
  02D0'   CD 033E'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D3'   CA 0312'              	JZ	FNDHIT
  02D6'                         FNDF_NX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D6'   23                    	INX	H
  02D7'   C3 02BC'              	JMP	FNDF_LP
  02DA'                         FNDBWD:
  02DA'   2A 2AA0'              	LHLD	FNDCUR
  02DD'   CD 05E2'              	CALL	BOL		; HL = the line's first character
  02E0'   22 2AA2'              	SHLD	FNDLIM
  02E3'   2A 2AA0'              	LHLD	FNDCUR
  02E6'   3A 2A9D'              	LDA	FNDSTP
  02E9'   2F                    	CMA
  02EA'   5F                    	MOV	E,A
  02EB'   16 FF                 	MVI	D,0FFH
  02ED'   13                    	INX	D		; DE = -step
  02EE'   19                    	DAD	D		; HL = where the scan starts
  02EF'   D2 032C'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F2'                         FNDB_LP:
  02F2'   EB                    	XCHG			; DE = the scan
  02F3'   2A 2AA2'              	LHLD	FNDLIM
  02F6'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02F9'   EB                    	XCHG			; HL = the scan
  02FA'   DA 032C'              	JC	FNDMIS		; before this line: not on it
  02FD'   CD 0333'              	CALL	FNDSEE
  0300'   C2 0309'              	JNZ	FNDB_NX
  0303'   CD 033E'              	CALL	FNDCNT
  0306'   CA 0312'              	JZ	FNDHIT
  0309'                         FNDB_NX:
  0309'   7C                    	MOV	A,H
  030A'   B5                    	ORA	L
  030B'   CA 032C'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  030E'   2B                    	DCX	H
  030F'   C3 02F2'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0312'                         FNDHIT:
  0312'   3A 2A9C'              	LDA	FNDRUN
  0315'   E6 5F                 	ANI	5FH
  0317'   FE 54                 	CPI	'T'
  0319'   C2 0329'              	JNZ	FNDLND
  031C'   3A 2A9C'              	LDA	FNDRUN
  031F'   E6 20                 	ANI	20H
  0321'   CA 0328'              	JZ	FNDH_BW
  0324'   2B                    	DCX	H		; forward 't': the character before it
  0325'   C3 0329'              	JMP	FNDLND
  0328'                         FNDH_BW:
  0328'   23                    	INX	H		; backward 'T': the character after it
  0329'                         FNDLND:
  0329'   C3 0578'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032C'                         FNDMIS:
  032C'   AF                    	XRA	A
  032D'   32 2A41'              	STA	PSAVE
  0330'   C3 01FF'              	JMP	DOTBEL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0333'                         FNDSEE:
  0333'   E5                    	PUSH	H
  0334'   CD 0000*              	CALL	CHARAT
  0337'   E1                    	POP	H
  0338'   47                    	MOV	B,A
  0339'   3A 2A9B'              	LDA	FNDCH
  033C'   B8                    	CMP	B
  033D'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  033E'                         FNDCNT:
  033E'   E5                    	PUSH	H
  033F'   2A 2A9E'              	LHLD	FNDN
  0342'   2B                    	DCX	H
  0343'   22 2A9E'              	SHLD	FNDN
  0346'   7C                    	MOV	A,H
  0347'   B5                    	ORA	L
  0348'   E1                    	POP	H
  0349'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034A'                         ISFIND:
  034A'   E6 5F                 	ANI	5FH		; fold the case away
  034C'   FE 46                 	CPI	'F'
  034E'   C8                    	RZ
  034F'   FE 54                 	CPI	'T'
  0351'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0352'                         VC_MK:
  0352'   3E 04                 	MVI	A,PM
  0354'   C3 035E'              	JMP	MKGO
  0357'                         VC_BQ:
  0357'   3E 05                 	MVI	A,PJ
  0359'   C3 035E'              	JMP	MKGO
  035C'                         VC_AQ:
  035C'   3E 06                 	MVI	A,PJL
  035E'                         MKGO:
  035E'   32 2AB1'              	STA	MKWHAT
  0361'   CD 0676'              	CALL	MOVCNT		; a count means nothing on any of the three
  0364'   CD 021C'              	CALL	MKGETK		; the key that names the mark
  0367'   DA 0446'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;to a mark that is not set.
  036A'                         MKOP:
  036A'   79                    	MOV	A,C
  036B'   D6 61                 	SUI	'a'
  036D'   FE 03                 	CPI	MKMAX
  036F'   D2 043E'              	JNC	MKNOLT		; not a mark letter
  0372'   4F                    	MOV	C,A		; C = the mark's index
  0373'   87                    	ADD	A
  0374'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0375'   5F                    	MOV	E,A
  0376'   16 00                 	MVI	D,0
  0378'   21 0000*              	LXI	H,MKTAB
  037B'   19                    	DAD	D		; HL -> this mark's slot
  037C'   3A 2AB1'              	LDA	MKWHAT
  037F'   FE 04                 	CPI	PM
  0381'   CA 0459'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0384'                         MKJMP:
  0384'   E5                    	PUSH	H
  0385'   CD 0207'              	CALL	MKVAD
  0388'   7E                    	MOV	A,M
  0389'   E1                    	POP	H
  038A'   B7                    	ORA	A
  038B'   CA 0434'              	JZ	MKNSET		; never set
  038E'   CD 0400'              	CALL	MKLOAD		; the file position it holds
  0391'   CD 040D'              	CALL	MKWIN
  0394'   DA 03AB'              	JC	MKJ_GO		; in the window: any command may go there
  0397'   3A 2A41'              	LDA	PSAVE
  039A'   B7                    	ORA	A
  039B'   CA 03AB'              	JZ	MKJ_GO
  039E'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  03A0'   C2 0446'              	JNZ	MKBAD
  03A3'   3A 2AB1'              	LDA	MKWHAT
  03A6'   FE 06                 	CPI	PJL
  03A8'   C2 0446'              	JNZ	MKBAD
  03AB'                         MKJ_GO:
  03AB'   CD 0F73'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03AE'   CD 06B2'              	CALL	BRKON		; ... and a ^C may stop it from here on
  03B1'   CD 03CD'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03B4'   CD 06E9'              	CALL	BRKOFF		; (A only)
  03B7'   DA 0701'              	JC	BRKBAK
  03BA'   3A 2AB1'              	LDA	MKWHAT
  03BD'   FE 06                 	CPI	PJL
  03BF'   CA 03C7'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03C2'   3E 01                 	MVI	A,1		;   non-blank
  03C4'   32 2AA4'              	STA	GPKEEP		; '`': land on the column it was set at
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C7'                         MKJ_LN:
  03C7'   CD 0000*              	CALL	GOTO
  03CA'   C3 0F8B'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03CD'                         MKPAGE:
  03CD'   CD 040D'              	CALL	MKWIN
  03D0'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03D3'   32 0000*              	STA	DIRFLG
  03D6'   21 FFFF               	LXI	H,0FFFFH
  03D9'   22 2A17'              	SHLD	CMDCNT
  03DC'   CD 0000*              	CALL	GOLINE
  03DF'   CD 0000*              	CALL	SCRLST
  03E2'   CD 069E'              	CALL	CNTTST
  03E5'   C2 03CD'              	JNZ	MKPAGE
  03E8'   CD 040D'              	CALL	MKWIN		; the file ran out: that was its last step
  03EB'   DA 0000*              	JC	CLRCNT
  03EE'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03F1'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03F4'                         BACKTO:
  03F4'   CD 0400'              	CALL	MKLOAD
  03F7'   CD 0000*              	CALL	CLRCNT
  03FA'   CD 03CD'              	CALL	MKPAGE
  03FD'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  0400'                         MKLOAD:
  0400'   5E                    	MOV	E,M
  0401'   23                    	INX	H
  0402'   56                    	MOV	D,M
  0403'   23                    	INX	H
  0404'   7E                    	MOV	A,M
  0405'   EB                    	XCHG
  0406'   22 2AAE'              	SHLD	MKPOS
  0409'   32 2AB0'              	STA	MKPOS+2
  040C'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  040D'                         MKWIN:
  040D'   2A 0000*              	LHLD	TXTBEG
  0410'   CD 0F2D'              	CALL	FPOS
  0413'   EB                    	XCHG
  0414'   47                    	MOV	B,A		; B:DE = the window's first byte
  0415'   2A 2AAE'              	LHLD	MKPOS
  0418'   3A 2AB0'              	LDA	MKPOS+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041B'   CD 0F20'              	CALL	SUB24		; A:HL = the mark, from the window's top
  041E'   DA 0430'              	JC	MKW_BK		; above it
  0421'   C2 042E'              	JNZ	MKW_FW		; 64K or more below it
  0424'   E5                    	PUSH	H
  0425'   CD 0000*              	CALL	LOGLEN
  0428'   D1                    	POP	D
  0429'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  042C'   EB                    	XCHG
  042D'   D8                    	RC			; inside
  042E'                         MKW_FW:
  042E'   AF                    	XRA	A
  042F'   C9                    	RET
  0430'                         MKW_BK:
  0430'   3E FF                 	MVI	A,0FFH
  0432'   B7                    	ORA	A
  0433'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0434'                         MKNSET:
  0434'   AF                    	XRA	A
  0435'   32 2A41'              	STA	PSAVE
  0438'   21 23D5'              	LXI	H,SMKNS
  043B'   C3 22CA'              	JMP	EXERR
  043E'                         MKNOLT:
  043E'   3A 2AB1'              	LDA	MKWHAT
  0441'   FE 04                 	CPI	PM
  0443'   C2 0434'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0446'                         MKBAD:
  0446'   AF                    	XRA	A
  0447'   32 2A41'              	STA	PSAVE
  044A'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  044D'                         FPSTO:
  044D'   E5                    	PUSH	H
  044E'   CD 0F2A'              	CALL	CURFP		; A:HL = the cursor's file position
  0451'   EB                    	XCHG
  0452'   E1                    	POP	H
  0453'   73                    	MOV	M,E
  0454'   23                    	INX	H
  0455'   72                    	MOV	M,D
  0456'   23                    	INX	H
  0457'   77                    	MOV	M,A
  0458'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0459'                         MKSET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0459'   CD 044D'              	CALL	FPSTO
  045C'   CD 0207'              	CALL	MKVAD
  045F'   36 01                 	MVI	M,1		; ... and the mark is live
  0461'   C3 0758'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0464'                         MKSHFT:
  0464'   32 2AAD'              	STA	MKTYP
  0467'   3A 2AB2'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  046A'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  046B'   C0                    	RNZ			;   every mark points into is still there
  046C'   C5                    	PUSH	B
  046D'   50                    	MOV	D,B
  046E'   59                    	MOV	E,C
  046F'   EB                    	XCHG
  0470'   22 2AAB'              	SHLD	MKN		; the edit's length
  0473'   D5                    	PUSH	D		; ... and its offset
  0474'   CD 0000*              	CALL	CUROFF
  0477'   D1                    	POP	D
  0478'   CD 0000*              	CALL	SUBHD
  047B'   EB                    	XCHG			; DE = how far behind the cursor it is
  047C'   CD 0F2A'              	CALL	CURFP		; A:HL = the cursor's file position
  047F'   06 00                 	MVI	B,0
  0481'   CD 0F20'              	CALL	SUB24
  0484'   22 2AA8'              	SHLD	MKEDIT
  0487'   32 2AAA'              	STA	MKEDIT+2	; where in the file the edit is
  048A'   21 2AA5'              	LXI	H,MKVAL
  048D'   11 0000*              	LXI	D,MKTAB
  0490'   06 03                 	MVI	B,MKMAX
  0492'                         MKS_LP:
  0492'   7E                    	MOV	A,M
  0493'   B7                    	ORA	A
  0494'   CA 0500'              	JZ	MKS_N0		; that mark is not set
  0497'   E5                    	PUSH	H
  0498'   C5                    	PUSH	B
  0499'   21 2AA8'              	LXI	H,MKEDIT
  049C'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  049D'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  049E'   4F                    	MOV	C,A
  049F'   13                    	INX	D
  04A0'   23                    	INX	H
  04A1'   1A                    	LDAX	D
  04A2'   9E                    	SBB	M
  04A3'   47                    	MOV	B,A
  04A4'   13                    	INX	D
  04A5'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A6'   1A                    	LDAX	D
  04A7'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04A8'   DA 04FB'              	JC	MKS_PP		; before it: nothing moves
  04AB'   6F                    	MOV	L,A
  04AC'   3A 2AAD'              	LDA	MKTYP
  04AF'   3D                    	DCR	A
  04B0'   CA 04D5'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04B3'   7D                    	MOV	A,L
  04B4'   2A 2AAB'              	LHLD	MKN
  04B7'   B7                    	ORA	A
  04B8'   C2 04C4'              	JNZ	MKS_DL		; 64K or more past it
  04BB'   79                    	MOV	A,C
  04BC'   95                    	SUB	L
  04BD'   78                    	MOV	A,B
  04BE'   9C                    	SBB	H
  04BF'   D2 04C4'              	JNC	MKS_DL		; past the end of what goes
  04C2'   60                    	MOV	H,B
  04C3'   69                    	MOV	L,C		; inside it: close up to the edit
  04C4'                         MKS_DL:
  04C4'   1B                    	DCX	D
  04C5'   1B                    	DCX	D
  04C6'   1A                    	LDAX	D
  04C7'   95                    	SUB	L
  04C8'   12                    	STAX	D
  04C9'   13                    	INX	D
  04CA'   1A                    	LDAX	D
  04CB'   9C                    	SBB	H
  04CC'   12                    	STAX	D
  04CD'   13                    	INX	D
  04CE'   1A                    	LDAX	D
  04CF'   DE 00                 	SBI	0
  04D1'   12                    	STAX	D
  04D2'   C3 04FB'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04D5'                         MKS_IN:
  04D5'   7D                    	MOV	A,L
  04D6'   B0                    	ORA	B
  04D7'   B1                    	ORA	C
  04D8'   C2 04EA'              	JNZ	MKS_AD		; the mark is past it
  04DB'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04DE'   2B                    	DCX	H
  04DF'   7E                    	MOV	A,M		; the last byte that went in
  04E0'   FE 0A                 	CPI	LF
  04E2'   CA 04EA'              	JZ	MKS_AD
  04E5'   FE 0D                 	CPI	CR
  04E7'   C2 04FB'              	JNZ	MKS_PP
  04EA'                         MKS_AD:
  04EA'   2A 2AAB'              	LHLD	MKN
  04ED'   1B                    	DCX	D
  04EE'   1B                    	DCX	D
  04EF'   1A                    	LDAX	D
  04F0'   85                    	ADD	L
  04F1'   12                    	STAX	D
  04F2'   13                    	INX	D
  04F3'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F4'   8C                    	ADC	H
  04F5'   12                    	STAX	D
  04F6'   13                    	INX	D
  04F7'   1A                    	LDAX	D
  04F8'   CE 00                 	ACI	0
  04FA'   12                    	STAX	D
  04FB'                         MKS_PP:
  04FB'   C1                    	POP	B
  04FC'   E1                    	POP	H
  04FD'   C3 0502'              	JMP	MKS_NX
  0500'                         MKS_N0:
  0500'   13                    	INX	D
  0501'   13                    	INX	D
  0502'                         MKS_NX:
  0502'   13                    	INX	D
  0503'   13                    	INX	D
  0504'   23                    	INX	H
  0505'   05                    	DCR	B
  0506'   C2 0492'              	JNZ	MKS_LP
  0509'   C1                    	POP	B
  050A'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  050B'                         VC_UNDO:
  050B'   21 0000               	LXI	H,0
  050E'   22 2A17'              	SHLD	CMDCNT
  0511'   CD 0000*              	CALL	UNDO
  0514'   DA 0545'              	JC	UNDNO
  0517'   2A 0000*              	LHLD	UNDCUR
  051A'   CD 052B'              	CALL	UCLAMP		; vi never sits on a line terminator
  051D'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0520'   3E 01                 	MVI	A,1
  0522'   32 2A1A'              	STA	MODF		; undone past a ':w' still differs from the file
  0525'   CD 08E4'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0528'   C3 0779'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  052B'                         UCLAMP:
  052B'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052C'   CD 14FF'              	CALL	CEND		; HL = the line's content end
  052F'   D1                    	POP	D		; DE = the offset wanted
  0530'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0533'   D2 0538'              	JNC	UCL_BK
  0536'   EB                    	XCHG
  0537'   C9                    	RET
  0538'                         UCL_BK:
  0538'   E5                    	PUSH	H		; the content end
  0539'   EB                    	XCHG			; HL = the offset wanted
  053A'   CD 05E2'              	CALL	BOL
  053D'   D1                    	POP	D		; DE = the content end, HL = the line's start
  053E'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0541'   EB                    	XCHG			; HL = the content end
  0542'   C8                    	RZ
  0543'   2B                    	DCX	H		; ... its last character
  0544'   C9                    	RET
  0545'                         UNDNO:
  0545'   3A 0000*              	LDA	UNDWHY
  0548'   B7                    	ORA	A
  0549'   CA 055A'              	JZ	UNDBEL
  054C'   21 238F'              	LXI	H,SUNDW		; the change has paged away: say so
  054F'   FE 01                 	CPI	1
  0551'   CA 22CA'              	JZ	EXERR
  0554'   21 23B1'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0557'   C3 22CA'              	JMP	EXERR
  055A'                         UNDBEL:
  055A'   0E 07                 	MVI	C,BEL
  055C'   CD 0000*              	CALL	BCONOU
  055F'   C3 0758'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0562'                         DOTGET:
  0562'   3A 2A3B'              	LDA	DOTIX
  0565'   5F                    	MOV	E,A
  0566'   3A 2A3A'              	LDA	DOTLEN
  0569'   BB                    	CMP	E
  056A'   CA 0576'              	JZ	DOTGEF
  056D'   16 00                 	MVI	D,0
  056F'   21 0000*              	LXI	H,DOTBUF
  0572'   19                    	DAD	D
  0573'   7E                    	MOV	A,M
  0574'   B7                    	ORA	A		; CY clear: a key was returned
  0575'   C9                    	RET
  0576'                         DOTGEF:
  0576'   37                    	STC
  0577'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0578'                         GOSET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0578'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  057B'                         SETGL:
  057B'   CD 0F4D'              	CALL	ZSAVE
  057E'   21 0000               	LXI	H,0
  0581'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0584'   E5                    	PUSH	H
  0585'   CD 0F60'              	CALL	ZREST
  0588'   E1                    	POP	H
  0589'   E5                    	PUSH	H
  058A'   CD 0682'              	CALL	GBSUB		; HL = bytes to the cursor
  058D'   44                    	MOV	B,H
  058E'   4D                    	MOV	C,L
  058F'   E1                    	POP	H		; HL = the line's start
  0590'   11 0000               	LXI	D,0		; DE = screen column
  0593'                         SG_LP:
  0593'   78                    	MOV	A,B
  0594'   B1                    	ORA	C
  0595'   CA 05AA'              	JZ	SG_CUR
  0598'   7E                    	MOV	A,M
  0599'   23                    	INX	H
  059A'   0B                    	DCX	B
  059B'   E5                    	PUSH	H
  059C'   6B                    	MOV	L,E
  059D'   CD 05CF'              	CALL	CWID
  05A0'   E1                    	POP	H
  05A1'   83                    	ADD	E
  05A2'   5F                    	MOV	E,A
  05A3'   D2 0593'              	JNC	SG_LP
  05A6'   14                    	INR	D
  05A7'   C3 0593'              	JMP	SG_LP
  05AA'                         SG_CUR:
  05AA'   2A 0000*              	LHLD	TXTEND
  05AD'   D5                    	PUSH	D
  05AE'   EB                    	XCHG
  05AF'   2A 0000*              	LHLD	GAPEND
  05B2'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05B5'   D1                    	POP	D
  05B6'   CA 05CA'              	JZ	SG_SET
  05B9'   7E                    	MOV	A,M
  05BA'   FE 09                 	CPI	TAB
  05BC'   C2 05CA'              	JNZ	SG_SET
  05BF'   6B                    	MOV	L,E
  05C0'   CD 05CF'              	CALL	CWID
  05C3'   3D                    	DCR	A		; the TAB's last column
  05C4'   83                    	ADD	E
  05C5'   5F                    	MOV	E,A
  05C6'   D2 05CA'              	JNC	SG_SET
  05C9'   14                    	INR	D
  05CA'                         SG_SET:
  05CA'   EB                    	XCHG
  05CB'   22 2A1F'              	SHLD	GOALCOL
  05CE'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05CF'                         CWID:
  05CF'   FE 0D                 	CPI	CR
  05D1'   CA 05E0'              	JZ	CW_0
  05D4'   FE 09                 	CPI	TAB
  05D6'   3E 01                 	MVI	A,1
  05D8'   C0                    	RNZ
  05D9'   7D                    	MOV	A,L
  05DA'   E6 07                 	ANI	TABWID-1
  05DC'   2F                    	CMA
  05DD'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05DF'   C9                    	RET
  05E0'                         CW_0:
  05E0'   AF                    	XRA	A
  05E1'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05E2'                         BOL:
  05E2'                         BOL_LP:
  05E2'   7C                    	MOV	A,H
  05E3'   B5                    	ORA	L
  05E4'   C8                    	RZ			; at 0
  05E5'   2B                    	DCX	H		; look at off-1
  05E6'   E5                    	PUSH	H
  05E7'   CD 0000*              	CALL	CHARAT
  05EA'   E1                    	POP	H		; HL = off-1
  05EB'   FE 0A                 	CPI	LF
  05ED'   CA 05F3'              	JZ	BOL_DN
  05F0'   C3 05E2'              	JMP	BOL_LP
  05F3'                         BOL_DN:
  05F3'   23                    	INX	H		; line starts just after the LF
  05F4'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05F5'                         EOLNL:
  05F5'   E5                    	PUSH	H
  05F6'   CD 0000*              	CALL	LOGLEN
  05F9'   22 2A5F'              	SHLD	WKN
  05FC'   E1                    	POP	H
  05FD'                         ENL_LP:
  05FD'   EB                    	XCHG			; DE = i
  05FE'   2A 2A5F'              	LHLD	WKN
  0601'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0604'   EB                    	XCHG			; HL = i, DE = n
  0605'   D0                    	RNC			; i >= n: no LF on this line
  0606'   E5                    	PUSH	H
  0607'   CD 0000*              	CALL	CHARAT
  060A'   E1                    	POP	H
  060B'   FE 0A                 	CPI	LF
  060D'   C8                    	RZ			; the LF: HL is its offset
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060E'   23                    	INX	H
  060F'   C3 05FD'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0612'                         NLSTART:
  0612'   CD 05F5'              	CALL	EOLNL
  0615'   E5                    	PUSH	H
  0616'   CD 0000*              	CALL	LOGLEN
  0619'   D1                    	POP	D		; DE = eol result
  061A'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  061D'   C8                    	RZ			; no next line: HL = LOGLEN
  061E'   EB                    	XCHG			; HL = eol
  061F'   23                    	INX	H
  0620'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0621'                         EOLC:
  0621'   E5                    	PUSH	H
  0622'   CD 05F5'              	CALL	EOLNL
  0625'   22 2A61'              	SHLD	WKTERM
  0628'   E1                    	POP	H
  0629'   CD 05E2'              	CALL	BOL
  062C'   22 2A63'              	SHLD	WKBOL
  062F'   2A 2A61'              	LHLD	WKTERM
  0632'   EB                    	XCHG			; DE = term
  0633'   2A 2A63'              	LHLD	WKBOL
  0636'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0639'   CA 0658'              	JZ	EOLC_MT
  063C'   EB                    	XCHG			; HL = term
  063D'   2B                    	DCX	H		; term-1
  063E'   E5                    	PUSH	H
  063F'   CD 0000*              	CALL	CHARAT
  0642'   E1                    	POP	H		; HL = term-1
  0643'   FE 0D                 	CPI	CR
  0645'   CA 064B'              	JZ	EOLC_CR		; content ends at term-1
  0648'   C3 064C'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  064B'                         EOLC_CR:
  064B'   2B                    	DCX	H		; last = (term-1) - 1
  064C'                         EOLC_LS:
  064C'   EB                    	XCHG			; DE = last
  064D'   2A 2A63'              	LHLD	WKBOL
  0650'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0653'   DA 0658'              	JC	EOLC_MT
  0656'   EB                    	XCHG			; HL = last
  0657'   C9                    	RET
  0658'                         EOLC_MT:
  0658'   2A 2A63'              	LHLD	WKBOL
  065B'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  065C'                         COL:
  065C'   E5                    	PUSH	H
  065D'   CD 05E2'              	CALL	BOL
  0660'   D1                    	POP	D		; DE = off
  0661'   EB                    	XCHG			; HL = off, DE = bol
  0662'   C3 0000*              	JMP	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0665'                         ATENDQ:
  0665'   CD 0000*              	CALL	CUROFF
  0668'   E5                    	PUSH	H
  0669'   CD 0000*              	CALL	LOGLEN
  066C'   D1                    	POP	D		; DE = cur
  066D'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0670'                         CURCHR:
  0670'   CD 0000*              	CALL	CUROFF
  0673'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0676'                         MOVCNT:
  0676'   CD 0758'              	CALL	SETMOV
  0679'   C3 0689'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  067C'                         CNTOFF:
  067C'   CD 0689'              	CALL	GETCNT
  067F'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0682'                         GBSUB:
  0682'   EB                    	XCHG
  0683'   2A 0000*              	LHLD	GAPBEG
  0686'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  0689'                         GETCNT:
  0689'   2A 2A17'              	LHLD	CMDCNT
  068C'   7C                    	MOV	A,H
  068D'   B5                    	ORA	L
  068E'   C2 0695'              	JNZ	GC_HAVE
  0691'   21 0001               	LXI	H,1
  0694'   C9                    	RET
  0695'                         GC_HAVE:
  0695'   E5                    	PUSH	H
  0696'   21 0000               	LXI	H,0
  0699'   22 2A17'              	SHLD	CMDCNT
  069C'   E1                    	POP	H
  069D'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  069E'                         CNTTST:				; WM 1175
  069E'   3A 2AC9'              	LDA	BRKARM
  06A1'   B7                    	ORA	A
  06A2'   C4 06CC'              	CNZ	BRKTST		; a ^C spends the count: every loop stops here
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A5'   E5                    	PUSH	H
  06A6'   2A 2A17'              	LHLD	CMDCNT
  06A9'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06AC'   B4                    	ORA	H
  06AD'   B5                    	ORA	L
  06AE'   E1                    	POP	H
  06AF'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ^C -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where a ^C is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ^C.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ^C test unless an operator is waiting for this motion.
  06B2'                         BRKON:
  06B2'   21 2AC4'              	LXI	H,SOFF
  06B5'   CD 044D'              	CALL	FPSTO
  06B8'   2A 0000*              	LHLD	LNDLT
  06BB'   22 2AC7'              	SHLD	SLDLT
  06BE'   AF                    	XRA	A
  06BF'   32 2ACA'              	STA	BRKHIT
  06C2'   3A 2A41'              	LDA	PSAVE
  06C5'   B7                    	ORA	A
  06C6'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  06C7'   3C                    	INR	A
  06C8'   32 2AC9'              	STA	BRKARM
  06CB'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.
  06CC'                         BRKTST:
  06CC'   C5                    	PUSH	B
  06CD'   D5                    	PUSH	D
  06CE'   E5                    	PUSH	H
  06CF'   CD 0000*              	CALL	KBBRK
  06D2'   CA 06E5'              	JZ	BT_NO
  06D5'   32 2ACA'              	STA	BRKHIT		; (A = FFH)
  06D8'   AF                    	XRA	A
  06D9'   32 2AC9'              	STA	BRKARM		; the way back is not stopped in its turn
  06DC'   32 0000*              	STA	AUXCNT
  06DF'   21 0000               	LXI	H,0
  06E2'   22 2A17'              	SHLD	CMDCNT
  06E5'                         BT_NO:
  06E5'   E1                    	POP	H
  06E6'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06E7'   C1                    	POP	B
  06E8'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  06E9'                         BRKOFF:
  06E9'   AF                    	XRA	A
  06EA'   32 2AC9'              	STA	BRKARM
                                ;BRKQ -- CY iff a ^C stopped it.
  06ED'                         BRKQ:
  06ED'   3A 2ACA'              	LDA	BRKHIT
  06F0'   B7                    	ORA	A
  06F1'   C8                    	RZ
  06F2'   37                    	STC
  06F3'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  06F4'                         RSTPL:
  06F4'   21 2AC4'              	LXI	H,SOFF
  06F7'   CD 03F4'              	CALL	BACKTO
  06FA'   2A 2AC7'              	LHLD	SLDLT
  06FD'   22 0000*              	SHLD	LNDLT
  0700'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0701'                         BRKBAK:
  0701'   CD 06F4'              	CALL	RSTPL
  0704'   CD 0000*              	CALL	KBFLSH
  0707'   21 2368'              	LXI	H,SINTR
  070A'   C3 22CA'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  070D'                         CLASSF:
  070D'   47                    	MOV	B,A
  070E'   FE 20                 	CPI	' '
  0710'   CA 0750'              	JZ	CLS0
  0713'   FE 09                 	CPI	TAB
  0715'   CA 0750'              	JZ	CLS0
  0718'   FE 0A                 	CPI	LF
  071A'   CA 0750'              	JZ	CLS0
  071D'   FE 0D                 	CPI	CR
  071F'   CA 0750'              	JZ	CLS0
  0722'   3A 2A21'              	LDA	WBIG
  0725'   B7                    	ORA	A
  0726'   C2 0752'              	JNZ	CLS1
  0729'   78                    	MOV	A,B
  072A'   FE 5F                 	CPI	'_'
  072C'   CA 0752'              	JZ	CLS1
  072F'   FE 30                 	CPI	'0'
  0731'   DA 0755'              	JC	CLS2
  0734'   FE 3A                 	CPI	'9'+1
  0736'   DA 0752'              	JC	CLS1
  0739'   FE 41                 	CPI	'A'
  073B'   DA 0755'              	JC	CLS2
  073E'   FE 5B                 	CPI	'Z'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0740'   DA 0752'              	JC	CLS1
  0743'   FE 61                 	CPI	'a'
  0745'   DA 0755'              	JC	CLS2
  0748'   FE 7B                 	CPI	'z'+1
  074A'   DA 0752'              	JC	CLS1
  074D'   C3 0755'              	JMP	CLS2
  0750'   AF                    CLS0:	XRA	A
  0751'   C9                    	RET
  0752'   3E 01                 CLS1:	MVI	A,1
  0754'   C9                    	RET
  0755'   3E 02                 CLS2:	MVI	A,2
  0757'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0758'                         SETMOV:
  0758'   3E 01                 	MVI	A,R_MOVE
  075A'   32 2A1B'              	STA	RINTENT
  075D'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  075E'                         SETLIN:
  075E'   3E 02                 	MVI	A,R_LINE
  0760'   32 2A1B'              	STA	RINTENT
  0763'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0764'                         SETILN:
  0764'   3E 01                 	MVI	A,1
  0766'   32 2A1C'              	STA	ILN		; one line, unless a put overwrites it below
  0769'   3E 05                 	MVI	A,R_ILIN
  076B'   32 2A1B'              	STA	RINTENT
  076E'   AF                    	XRA	A
  076F'   32 2A1E'              	STA	ILABOV		; the row above the opened ones is untouched
  0772'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ; onto the cursor's, so that row and the row under it are what changed.
  0773'                         SETJON:
  0773'   3E 06                 	MVI	A,R_JOIN
  0775'   32 2A1B'              	STA	RINTENT
  0778'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0779'                         SETFUL:
  0779'   3E 00                 	MVI	A,R_FULL
  077B'   32 2A1B'              	STA	RINTENT
  077E'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  077F'                         TAILTAB:
  077F'   CD 0000*              	CALL	CUROFF
  0782'   22 2A5B'              	SHLD	TTI
  0785'                         TT_LP:
  0785'   2A 2A5B'              	LHLD	TTI
  0788'   EB                    	XCHG			; DE = TTI
  0789'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  078C'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  078F'   D2 07AF'              	JNC	TT_NO		; reached end of text -> no tab
  0792'   2A 2A5B'              	LHLD	TTI
  0795'   CD 0000*              	CALL	CHARAT
  0798'   FE 0A                 	CPI	LF
  079A'   CA 07AF'              	JZ	TT_NO		; end of line -> no tab
  079D'   FE 09                 	CPI	TAB
  079F'   CA 07AC'              	JZ	TT_YES
  07A2'   2A 2A5B'              	LHLD	TTI
  07A5'   23                    	INX	H
  07A6'   22 2A5B'              	SHLD	TTI
  07A9'   C3 0785'              	JMP	TT_LP
  07AC'                         TT_YES:
  07AC'   3E 01                 	MVI	A,1
  07AE'   C9                    	RET
  07AF'                         TT_NO:
  07AF'   AF                    	XRA	A
  07B0'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07B1'                         VC_H:
  07B1'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  07B4'   22 2A59'              	SHLD	CNTV
  07B7'                         VCH_LP:
  07B7'   2A 2A59'              	LHLD	CNTV
  07BA'   7C                    	MOV	A,H
  07BB'   B5                    	ORA	L
  07BC'   C8                    	RZ
  07BD'   2B                    	DCX	H
  07BE'   22 2A59'              	SHLD	CNTV
  07C1'   CD 07C7'              	CALL	HSTEP
  07C4'   C3 07B7'              	JMP	VCH_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C7'                         HSTEP:
  07C7'   CD 0000*              	CALL	CUROFF		; HL = cur
  07CA'   7C                    	MOV	A,H
  07CB'   B5                    	ORA	L
  07CC'   C8                    	RZ			; at 0
  07CD'   E5                    	PUSH	H
  07CE'   CD 05E2'              	CALL	BOL		; HL = bol
  07D1'   D1                    	POP	D		; DE = cur
  07D2'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  07D5'   C8                    	RZ			; at BOL, cannot go left
  07D6'   EB                    	XCHG			; HL = cur
  07D7'   2B                    	DCX	H
  07D8'   C3 0578'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  07DB'                         VC_L:
  07DB'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  07DE'   22 2A59'              	SHLD	CNTV
  07E1'                         VCL_LP:
  07E1'   2A 2A59'              	LHLD	CNTV
  07E4'   7C                    	MOV	A,H
  07E5'   B5                    	ORA	L
  07E6'   C8                    	RZ
  07E7'   2B                    	DCX	H
  07E8'   22 2A59'              	SHLD	CNTV
  07EB'   CD 07F1'              	CALL	LSTEP
  07EE'   C3 07E1'              	JMP	VCL_LP
  07F1'                         LSTEP:
  07F1'   CD 0000*              	CALL	CUROFF		; HL = cur
  07F4'   E5                    	PUSH	H
  07F5'   CD 0621'              	CALL	EOLC		; HL = eolc
  07F8'   D1                    	POP	D		; DE = cur
  07F9'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  07FC'   D2 0804'              	JNC	LS_NO		; cur >= eolc, cannot go right
  07FF'   EB                    	XCHG			; HL = cur
  0800'   23                    	INX	H
  0801'   C3 0578'              	JMP	GOSET
  0804'                         LS_NO:				; on the line's last char.  An operator waiting on
  0804'   CD 0BD0'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0807'   C8                    	RZ			;   motion inclusive when it falls short), which
  0808'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  080A'   32 2A22'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  080D'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  080E'                         VC_0:
  080E'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0811'   CD 081B'              	CALL	LNSTRT
  0814'   21 0000               	LXI	H,0
  0817'   22 2A1F'              	SHLD	GOALCOL
  081A'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  081B'                         LNSTRT:
  081B'   CD 0F4D'              	CALL	ZSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081E'   21 0000               	LXI	H,0
  0821'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0824'   E5                    	PUSH	H
  0825'   CD 0F60'              	CALL	ZREST
  0828'   E1                    	POP	H
  0829'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  082C'                         VC_CRT:
  082C'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  082F'   C3 0832'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0832'                         FNBLNK:
  0832'   CD 081B'              	CALL	LNSTRT
  0835'   CD 0000*              	CALL	RGET0
  0838'   11 0000               	LXI	D,0		; DE = blanks skipped
  083B'                         FN_LP:
  083B'   CD 0000*              	CALL	RDGET
  083E'   DA 0861'              	JC	FN_GO		; the end of the file
  0841'   FE 20                 	CPI	' '
  0843'   CA 084B'              	JZ	FN_WH
  0846'   FE 09                 	CPI	TAB
  0848'   C2 0861'              	JNZ	FN_GO		; a non-blank, or the line's end
  084B'                         FN_WH:
  084B'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  084E'   DA 0861'              	JC	FN_GO
  0851'   FE 0D                 	CPI	CR
  0853'   CA 0861'              	JZ	FN_GO
  0856'   FE 0A                 	CPI	LF
  0858'   CA 0861'              	JZ	FN_GO
  085B'   2B                    	DCX	H		; not yet: read that char again
  085C'   03                    	INX	B
  085D'   13                    	INX	D
  085E'   C3 083B'              	JMP	FN_LP
  0861'                         FN_GO:
  0861'   D5                    	PUSH	D
  0862'   CD 0000*              	CALL	CUROFF
  0865'   D1                    	POP	D
  0866'   19                    	DAD	D
  0867'   C3 0578'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  086A'                         VC_EOL:
  086A'   CD 0758'              	CALL	SETMOV
  086D'   21 FFFF               	LXI	H,0FFFFH
  0870'   22 2A1F'              	SHLD	GOALCOL
  0873'   CD 0689'              	CALL	GETCNT
  0876'   2B                    	DCX	H		; count-1
  0877'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0878'   B5                    	ORA	L
  0879'   CA 0888'              	JZ	VEOL_0
  087C'   E5                    	PUSH	H
  087D'   CD 089D'              	CALL	ONLAST
  0880'   E1                    	POP	H
  0881'   D8                    	RC			; the last line: no move (vim)
  0882'   CD 08ED'              	CALL	JCORE
  0885'   C3 0A3C'              	JMP	JKLAND
  0888'                         VEOL_0:
  0888'   CD 081B'              	CALL	LNSTRT
  088B'   C3 0A3C'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  088E'                         VC_CR:
  088E'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0891'   E5                    	PUSH	H
  0892'   CD 089D'              	CALL	ONLAST
  0895'   E1                    	POP	H
  0896'   D8                    	RC
  0897'   CD 08ED'              	CALL	JCORE
  089A'   C3 0832'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  089D'                         ONLAST:
  089D'   CD 0000*              	CALL	RGET0
  08A0'                         OL_LP:
  08A0'   CD 0000*              	CALL	RDGET
  08A3'   D8                    	RC			; the file ends on this line
  08A4'   FE 0A                 	CPI	LF
  08A6'   C2 08A0'              	JNZ	OL_LP
  08A9'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08AC'                         VC_J:
  08AC'   CD 0758'              	CALL	SETMOV
  08AF'   CD 08D7'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08B2'   CD 0689'              	CALL	GETCNT		; HL = count
  08B5'   CD 08ED'              	CALL	JCORE
  08B8'   CD 08D0'              	CALL	JKDRP
  08BB'   C3 0A3C'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  08BE'                         VC_K:
  08BE'   CD 0758'              	CALL	SETMOV
  08C1'   CD 08D7'              	CALL	GLCHK
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C4'   CD 0689'              	CALL	GETCNT
  08C7'   CD 098A'              	CALL	KCORE
  08CA'   CD 08D0'              	CALL	JKDRP
  08CD'   C3 0A3C'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  08D0'                         JKDRP:
  08D0'   7A                    	MOV	A,D
  08D1'   B3                    	ORA	E
  08D2'   C0                    	RNZ
  08D3'   32 2A41'              	STA	PSAVE
  08D6'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  08D7'                         GLCHK:
  08D7'   2A 2A1F'              	LHLD	GOALCOL
  08DA'   7C                    	MOV	A,H
  08DB'   3C                    	INR	A
  08DC'   C0                    	RNZ
  08DD'   7D                    	MOV	A,L
  08DE'   FE FE                 	CPI	0FEH
  08E0'   C0                    	RNZ
  08E1'   C3 057B'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  08E4'                         GLSTAL:
  08E4'   E5                    	PUSH	H
  08E5'   21 FFFE               	LXI	H,0FFFEH
  08E8'   22 2A1F'              	SHLD	GOALCOL
  08EB'   E1                    	POP	H
  08EC'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  08ED'                         JCORE:
  08ED'   7C                    	MOV	A,H
  08EE'   B5                    	ORA	L
  08EF'   C8                    	RZ
  08F0'   22 2A25'              	SHLD	JKCNT
  08F3'   CD 0CFF'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  08F6'   47                    	MOV	B,A
  08F7'   3A 0000*              	LDA	NEDIT
  08FA'   3D                    	DCR	A
  08FB'   90                    	SUB	B
  08FC'   5F                    	MOV	E,A
  08FD'   16 00                 	MVI	D,0
  08FF'   3A 0000*              	LDA	NEDIT
  0902'   6F                    	MOV	L,A
  0903'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0905'   19                    	DAD	D
  0906'   EB                    	XCHG			; DE = limit
  0907'   2A 2A25'              	LHLD	JKCNT
  090A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  090D'   D2 0911'              	JNC	JC_N
  0910'   EB                    	XCHG			; HL = limit
  0911'                         JC_N:
  0911'   22 2A27'              	SHLD	JKN		; N = min(count, limit)
  0914'   EB                    	XCHG			; DE = LFs to find
  0915'   CD 0000*              	CALL	RGET0
  0918'                         JC_SC:
  0918'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  091B'   DA 093A'              	JC	JC_EOF
  091E'   32 2A2E'              	STA	JKLST
  0921'   FE 0A                 	CPI	LF
  0923'   C2 0918'              	JNZ	JC_SC
  0926'   1B                    	DCX	D
  0927'   7A                    	MOV	A,D
  0928'   B3                    	ORA	E
  0929'   C2 0918'              	JNZ	JC_SC
  092C'   2A 2A25'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  092F'   22 2A29'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0932'   3E 01                 	MVI	A,1
  0934'   32 2A2D'              	STA	JKPHN
  0937'   C3 0955'              	JMP	JC_MV
  093A'                         JC_EOF:
  093A'   2A 2A27'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  093D'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0940'   7C                    	MOV	A,H
  0941'   B5                    	ORA	L
  0942'   CA 094E'              	JZ	JC_AV
  0945'   3A 2A2E'              	LDA	JKLST
  0948'   FE 0A                 	CPI	LF
  094A'   C2 094E'              	JNZ	JC_AV
  094D'   2B                    	DCX	H
  094E'                         JC_AV:
  094E'   22 2A29'              	SHLD	JKMOV
  0951'   AF                    	XRA	A
  0952'   32 2A2D'              	STA	JKPHN
  0955'                         JC_MV:
  0955'   2A 2A25'              	LHLD	JKCNT
  0958'   AF                    	XRA	A
  0959'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  095C'   CD 0A1B'              	CALL	ATEOF
  095F'   D2 0973'              	JNC	JC_DN
  0962'   CD 0A21'              	CALL	LASTLN		; ran past the last line: back onto it
  0965'   3A 2A2D'              	LDA	JKPHN
  0968'   B7                    	ORA	A
  0969'   CA 0973'              	JZ	JC_DN
  096C'   2A 2A29'              	LHLD	JKMOV
  096F'   2B                    	DCX	H
  0970'   22 2A29'              	SHLD	JKMOV
  0973'                         JC_DN:
  0973'   2A 2A27'              	LHLD	JKN		; LNDLT += min(moved, N)
  0976'   EB                    	XCHG
  0977'   2A 2A29'              	LHLD	JKMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  097A'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  097D'   D2 0981'              	JNC	JC_AD
  0980'   EB                    	XCHG
  0981'                         JC_AD:
  0981'   EB                    	XCHG			; DE = lines moved
  0982'   2A 0000*              	LHLD	LNDLT
  0985'   19                    	DAD	D
  0986'   22 0000*              	SHLD	LNDLT
  0989'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  098A'                         KCORE:
  098A'   7C                    	MOV	A,H
  098B'   B5                    	ORA	L
  098C'   C8                    	RZ
  098D'   22 2A25'              	SHLD	JKCNT
  0990'   CD 0CFF'              	CALL	CURRW		; limit = row + NEDIT
  0993'   5F                    	MOV	E,A
  0994'   16 00                 	MVI	D,0
  0996'   3A 0000*              	LDA	NEDIT
  0999'   6F                    	MOV	L,A
  099A'   26 00                 	MVI	H,0
  099C'   19                    	DAD	D
  099D'   EB                    	XCHG			; DE = limit
  099E'   2A 2A25'              	LHLD	JKCNT
  09A1'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09A4'   D2 09A8'              	JNC	KC_N
  09A7'   EB                    	XCHG			; HL = limit
  09A8'                         KC_N:
  09A8'   22 2A27'              	SHLD	JKN		; N = min(count, limit)
  09AB'   EB                    	XCHG			; DE = LFs to find
  09AC'   21 0000               	LXI	H,0
  09AF'   22 2A2B'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09B2'                         KC_ED:
  09B2'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  09B3'   2A 2A2B'              	LHLD	JKBK
  09B6'   CD 0682'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09B9'   E5                    	PUSH	H
  09BA'   EB                    	XCHG
  09BB'   2A 0000*              	LHLD	TXTBEG
  09BE'   EB                    	XCHG
  09BF'   CD 0000*              	CALL	SUBHD
  09C2'   44                    	MOV	B,H
  09C3'   4D                    	MOV	C,L
  09C4'   E1                    	POP	H
  09C5'   D1                    	POP	D
  09C6'                         KC_SC:
  09C6'   78                    	MOV	A,B
  09C7'   B1                    	ORA	C
  09C8'   CA 09DF'              	JZ	KC_TB
  09CB'   2B                    	DCX	H
  09CC'   0B                    	DCX	B
  09CD'   7E                    	MOV	A,M
  09CE'   FE 0A                 	CPI	LF
  09D0'   C2 09C6'              	JNZ	KC_SC
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09D3'   1B                    	DCX	D
  09D4'   7A                    	MOV	A,D
  09D5'   B3                    	ORA	E
  09D6'   C2 09C6'              	JNZ	KC_SC
  09D9'   2A 2A25'              	LHLD	JKCNT		; N lines above: the move is count lines
  09DC'   C3 09FF'              	JMP	KC_MV
  09DF'                         KC_TB:
  09DF'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  09E0'   CD 0682'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09E3'   22 2A2B'              	SHLD	JKBK
  09E6'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  09E9'   7C                    	MOV	A,H
  09EA'   B5                    	ORA	L
  09EB'   CA 09F8'              	JZ	KC_B0
  09EE'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  09F1'   D1                    	POP	D
  09F2'   DA 09F9'              	JC	KC_BOF
  09F5'   C3 09B2'              	JMP	KC_ED
  09F8'                         KC_B0:
  09F8'   D1                    	POP	D
  09F9'                         KC_BOF:
  09F9'   2A 2A27'              	LHLD	JKN		; moved = LFs found
  09FC'   CD 0000*              	CALL	SUBHD
  09FF'                         KC_MV:
  09FF'   E5                    	PUSH	H
  0A00'   2A 2A25'              	LHLD	JKCNT
  0A03'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A06'   D1                    	POP	D		; DE = moved
  0A07'   2A 2A27'              	LHLD	JKN
  0A0A'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A0D'   DA 0A11'              	JC	KC_AD
  0A10'   EB                    	XCHG			; DE = N
  0A11'                         KC_AD:
  0A11'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A14'   CD 0000*              	CALL	SUBHD
  0A17'   22 0000*              	SHLD	LNDLT
  0A1A'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A1B'                         ATEOF:
  0A1B'   CD 0000*              	CALL	RGET0
  0A1E'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A21'                         LASTLN:
  0A21'   2A 0000*              	LHLD	GAPBEG
  0A24'   EB                    	XCHG
  0A25'   2A 0000*              	LHLD	TXTBEG
  0A28'   CD 0000*              	CALL	CMP16
  0A2B'   21 0000               	LXI	H,0
  0A2E'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A31'   1B                    	DCX	D
  0A32'   1A                    	LDAX	D
  0A33'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A35'   C2 0000*              	JNZ	SETBWD
  0A38'   23                    	INX	H
  0A39'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A3C'                         JKLAND:
  0A3C'   21 0000               	LXI	H,0
  0A3F'   22 2A2F'              	SHLD	JKVC		; screen column
  0A42'   2B                    	DCX	H
  0A43'   22 2A31'              	SHLD	JKLS		; last content char: none yet
  0A46'   CD 0000*              	CALL	RGET0
  0A49'   11 0000               	LXI	D,0		; DE = chars read
  0A4C'                         JL_RD:
  0A4C'   CD 0000*              	CALL	RDGET
  0A4F'   DA 0A89'              	JC	JL_END
  0A52'   FE 0A                 	CPI	LF
  0A54'   CA 0A89'              	JZ	JL_END
  0A57'   E5                    	PUSH	H
  0A58'   C5                    	PUSH	B
  0A59'   2A 2A2F'              	LHLD	JKVC
  0A5C'   CD 05CF'              	CALL	CWID
  0A5F'   B7                    	ORA	A
  0A60'   CA 0A83'              	JZ	JL_NX		; a CR
  0A63'   EB                    	XCHG
  0A64'   22 2A31'              	SHLD	JKLS		; the last content char so far
  0A67'   EB                    	XCHG
  0A68'   4F                    	MOV	C,A
  0A69'   06 00                 	MVI	B,0
  0A6B'   09                    	DAD	B		; HL = the column after this char
  0A6C'   22 2A2F'              	SHLD	JKVC
  0A6F'   D5                    	PUSH	D
  0A70'   EB                    	XCHG
  0A71'   2A 2A1F'              	LHLD	GOALCOL
  0A74'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0A77'   D1                    	POP	D
  0A78'   DA 0A83'              	JC	JL_NX
  0A7B'   CA 0A83'              	JZ	JL_NX
  0A7E'   C1                    	POP	B		; this char holds the goal column
  0A7F'   E1                    	POP	H
  0A80'   C3 0A94'              	JMP	JL_GO
  0A83'                         JL_NX:
  0A83'   C1                    	POP	B
  0A84'   E1                    	POP	H
  0A85'   13                    	INX	D
  0A86'   C3 0A4C'              	JMP	JL_RD
  0A89'                         JL_END:
  0A89'   2A 2A31'              	LHLD	JKLS		; past the line's end: its last content char
  0A8C'   7C                    	MOV	A,H
  0A8D'   A5                    	ANA	L
  0A8E'   3C                    	INR	A
  0A8F'   C2 0A93'              	JNZ	JL_LS
  0A92'   23                    	INX	H		; no content: the line's start
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A93'                         JL_LS:
  0A93'   EB                    	XCHG
  0A94'                         JL_GO:
  0A94'   D5                    	PUSH	D		; DE = step from the line start
  0A95'   CD 0000*              	CALL	CUROFF
  0A98'   D1                    	POP	D
  0A99'   19                    	DAD	D
  0A9A'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A9D'   AF                    VC_W:	XRA	A
  0A9E'   32 2A21'              	STA	WBIG
  0AA1'   C3 0AA9'              	JMP	WDO
  0AA4'   3E 01                 VCBGW:	MVI	A,1
  0AA6'   32 2A21'              	STA	WBIG
  0AA9'   CD 0758'              WDO:	CALL	SETMOV
  0AAC'   AF                    	XRA	A
  0AAD'   32 2A22'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AB0'   CD 0689'              	CALL	GETCNT
  0AB3'   22 2A59'              	SHLD	CNTV
  0AB6'   2A 2A59'              WDO_LP: LHLD	CNTV
  0AB9'   7C                    	MOV	A,H
  0ABA'   B5                    	ORA	L
  0ABB'   CA 0AC8'              	JZ	WDO_DN
  0ABE'   2B                    	DCX	H
  0ABF'   22 2A59'              	SHLD	CNTV
  0AC2'   CD 0B25'              	CALL	FWD1
  0AC5'   D2 0AB6'              	JNC	WDO_LP
  0AC8'                         WDO_DN:
  0AC8'   CD 0A1B'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0ACB'   DA 0AD8'              	JC	WDO_NL
  0ACE'   FE 0D                 	CPI	CR
  0AD0'   CA 0AD8'              	JZ	WDO_NL
  0AD3'   FE 0A                 	CPI	LF
  0AD5'   C2 057B'              	JNZ	SETGL
  0AD8'                         WDO_NL:
  0AD8'   CD 0000*              	CALL	PEEKL
  0ADB'   DA 057B'              	JC	SETGL
  0ADE'   FE 0A                 	CPI	LF
  0AE0'   CA 057B'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0AE3'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0AE5'   32 2A22'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0AE8'   CD 0C44'              	CALL	DECC		; back onto its last char
  0AEB'   C3 057B'              	JMP	SETGL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AEE'   AF                    VC_B:	XRA	A
  0AEF'   32 2A21'              	STA	WBIG
  0AF2'   C3 0AFA'              	JMP	BDO
  0AF5'   3E 01                 VCBGB:	MVI	A,1
  0AF7'   32 2A21'              	STA	WBIG
  0AFA'   CD 0758'              BDO:	CALL	SETMOV
  0AFD'   CD 0689'              	CALL	GETCNT
  0B00'   22 2A59'              	SHLD	CNTV
  0B03'   CD 0B95'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B06'   D2 0B16'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B09'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B0A'   32 2A41'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B0D'   C3 057B'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B10'                         BDO_LP:				;   its operator stands -- both as vim
  0B10'   CD 0B95'              	CALL	BCK1
  0B13'   DA 057B'              	JC	SETGL
  0B16'   2A 2A59'              BDO_NX: LHLD	CNTV
  0B19'   2B                    	DCX	H
  0B1A'   22 2A59'              	SHLD	CNTV
  0B1D'   7C                    	MOV	A,H
  0B1E'   B5                    	ORA	L
  0B1F'   C2 0B10'              	JNZ	BDO_LP
  0B22'   C3 057B'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B25'                         FWD1:
  0B25'   CD 0BC8'              	CALL	CCLS
  0B28'   32 2A65'              	STA	WKCLS		; the starting class
  0B2B'   CD 0C02'              	CALL	INCC
  0B2E'   B7                    	ORA	A
  0B2F'   CA 0B48'              	JZ	FW_WD
  0B32'   37                    	STC
  0B33'   F8                    	RM			; -1: already at the end
  0B34'   CD 0B80'              	CALL	WLAST
  0B37'   C8                    	RZ
  0B38'   FE 02                 	CPI	2
  0B3A'   C2 0B48'              	JNZ	FW_WD		; 1: a next line was reached
  0B3D'   CD 0A1B'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B40'   D4 0BE9'              	CNC	NXLN
  0B43'   D2 0B48'              	JNC	FW_WD
  0B46'   37                    	STC			; yes: failed
  0B47'   C9                    	RET
  0B48'                         FW_WD:
  0B48'   3A 2A65'              	LDA	WKCLS		; go past the rest of this word
  0B4B'   B7                    	ORA	A
  0B4C'   CA 0B68'              	JZ	FW_WS
  0B4F'                         FW_WLP:
  0B4F'   CD 0BC8'              	CALL	CCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B52'   21 2A65'              	LXI	H,WKCLS
  0B55'   BE                    	CMP	M
  0B56'   C2 0B68'              	JNZ	FW_WS
  0B59'   CD 0C02'              	CALL	INCC
  0B5C'   B7                    	ORA	A
  0B5D'   F8                    	RM			; the end of the file (NC)
  0B5E'   CA 0B4F'              	JZ	FW_WLP
  0B61'   CD 0B80'              	CALL	WLAST
  0B64'   C8                    	RZ
  0B65'   C3 0B4F'              	JMP	FW_WLP
  0B68'                         FW_WS:
  0B68'   CD 0BC8'              	CALL	CCLS		; then over blanks to the next word
  0B6B'   B7                    	ORA	A
  0B6C'   C0                    	RNZ
  0B6D'   CD 0BD0'              	CALL	EMPTY
  0B70'   C8                    	RZ			; an empty line is a word
  0B71'   CD 0C02'              	CALL	INCC
  0B74'   B7                    	ORA	A
  0B75'   F8                    	RM
  0B76'   CA 0B68'              	JZ	FW_WS
  0B79'   CD 0B80'              	CALL	WLAST
  0B7C'   C8                    	RZ
  0B7D'   C3 0B68'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0B80'                         WLAST:
  0B80'   47                    	MOV	B,A
  0B81'   2A 2A59'              	LHLD	CNTV
  0B84'   7C                    	MOV	A,H
  0B85'   B5                    	ORA	L
  0B86'   C2 0B91'              	JNZ	WL_X		; words still owed
  0B89'   3A 2A41'              	LDA	PSAVE
  0B8C'   B7                    	ORA	A
  0B8D'   CA 0B93'              	JZ	WL_NO		; a plain 'w'
  0B90'   AF                    	XRA	A
  0B91'   78                    WL_X:	MOV	A,B
  0B92'   C9                    	RET
  0B93'   B0                    WL_NO:	ORA	B
  0B94'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0B95'                         BCK1:
  0B95'   CD 0C44'              	CALL	DECC
  0B98'   B7                    	ORA	A
  0B99'   37                    	STC
  0B9A'   F8                    	RM
  0B9B'                         BK_WS:
  0B9B'   CD 0BC8'              	CALL	CCLS		; back over blanks
  0B9E'   B7                    	ORA	A
  0B9F'   C2 0BAF'              	JNZ	BK_WD
  0BA2'   CD 0BD0'              	CALL	EMPTY
  0BA5'   C8                    	RZ			; an empty line is a word
  0BA6'   CD 0C44'              	CALL	DECC
  0BA9'   B7                    	ORA	A
  0BAA'   F2 0B9B'              	JP	BK_WS
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BAD'   AF                    	XRA	A		; the start of the file (NC)
  0BAE'   C9                    	RET
  0BAF'                         BK_WD:
  0BAF'   32 2A65'              	STA	WKCLS		; back to the start of this word
  0BB2'                         BK_WLP:
  0BB2'   CD 0C44'              	CALL	DECC
  0BB5'   B7                    	ORA	A
  0BB6'   FA 0BC6'              	JM	BK_OK		; the start of the file
  0BB9'   CD 0BC8'              	CALL	CCLS
  0BBC'   21 2A65'              	LXI	H,WKCLS
  0BBF'   BE                    	CMP	M
  0BC0'   CA 0BB2'              	JZ	BK_WLP
  0BC3'   CD 0C02'              	CALL	INCC		; overshot: forward one
  0BC6'                         BK_OK:
  0BC6'   AF                    	XRA	A
  0BC7'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0BC8'                         CCLS:
  0BC8'   CD 0A1B'              	CALL	ATEOF
  0BCB'   D2 070D'              	JNC	CLASSF
  0BCE'   AF                    	XRA	A
  0BCF'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0BD0'                         EMPTY:
  0BD0'   CD 0A1B'              	CALL	ATEOF
  0BD3'   DA 0BDE'              	JC	EM_ST
  0BD6'   FE 0D                 	CPI	CR
  0BD8'   CA 0BDE'              	JZ	EM_ST
  0BDB'   FE 0A                 	CPI	LF
  0BDD'   C0                    	RNZ
  0BDE'                         EM_ST:
  0BDE'   CD 0000*              	CALL	PEEKL
  0BE1'   DA 0BE7'              	JC	EM_Y
  0BE4'   FE 0A                 	CPI	LF
  0BE6'   C9                    	RET
  0BE7'                         EM_Y:
  0BE7'   AF                    	XRA	A
  0BE8'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0BE9'                         NXLN:
  0BE9'   FE 0A                 	CPI	LF
  0BEB'   CA 0BFA'              	JZ	NX_LF
  0BEE'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0BF1'   D8                    	RC
  0BF2'   FE 0A                 	CPI	LF
  0BF4'   CA 0BFA'              	JZ	NX_LF
  0BF7'   2B                    	DCX	H		; a lone CR
  0BF8'   AF                    	XRA	A
  0BF9'   C9                    	RET
  0BFA'                         NX_LF:
  0BFA'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BFD'   D8                    	RC
  0BFE'   2B                    	DCX	H
  0BFF'   3E 01                 	MVI	A,1
  0C01'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C02'                         INCC:
  0C02'   CD 0A1B'              	CALL	ATEOF
  0C05'   DA 0C40'              	JC	IC_END
  0C08'   FE 0D                 	CPI	CR
  0C0A'   CA 0C2B'              	JZ	IC_NL
  0C0D'   FE 0A                 	CPI	LF
  0C0F'   CA 0C2B'              	JZ	IC_NL
  0C12'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C15'                         IC_CH:
  0C15'   CD 0A1B'              	CALL	ATEOF
  0C18'   DA 0C27'              	JC	IC_2
  0C1B'   FE 0D                 	CPI	CR
  0C1D'   CA 0C27'              	JZ	IC_2
  0C20'   FE 0A                 	CPI	LF
  0C22'   CA 0C27'              	JZ	IC_2
  0C25'   AF                    	XRA	A
  0C26'   C9                    	RET
  0C27'                         IC_2:
  0C27'   3E 02                 	MVI	A,2
  0C29'   B7                    	ORA	A
  0C2A'   C9                    	RET
  0C2B'                         IC_NL:
  0C2B'   CD 0BE9'              	CALL	NXLN
  0C2E'   DA 0C40'              	JC	IC_END
  0C31'   F5                    	PUSH	PSW
  0C32'   CD 0000*              	CALL	PUTCUR
  0C35'   F1                    	POP	PSW
  0C36'   B7                    	ORA	A
  0C37'   CA 0C15'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C3A'   CD 0C66'              	CALL	LNINC
  0C3D'   3E 01                 	MVI	A,1
  0C3F'   C9                    	RET
  0C40'                         IC_END:
  0C40'   3E FF                 	MVI	A,0FFH
  0C42'   B7                    	ORA	A
  0C43'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C44'                         DECC:
  0C44'   CD 0000*              	CALL	PEEKL
  0C47'   DA 0C40'              	JC	IC_END
  0C4A'   F5                    	PUSH	PSW
  0C4B'   CD 0000*              	CALL	PUTCUR
  0C4E'   F1                    	POP	PSW
  0C4F'   FE 0A                 	CPI	LF
  0C51'   3E 00                 	MVI	A,0
  0C53'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C54'   CD 0C74'              	CALL	LNDEC
  0C57'   CD 0000*              	CALL	PEEKL		; onto its CR
  0C5A'   DA 0C62'              	JC	DC_1
  0C5D'   FE 0D                 	CPI	CR
  0C5F'   CC 0000*              	CZ	PUTCUR
  0C62'                         DC_1:
  0C62'   3E 01                 	MVI	A,1
  0C64'   B7                    	ORA	A
  0C65'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0C66'                         LNINC:
  0C66'   E5                    	PUSH	H
  0C67'   2A 0000*              	LHLD	LNDLT
  0C6A'   7C                    	MOV	A,H
  0C6B'   FE 40                 	CPI	40H
  0C6D'   CA 0C82'              	JZ	LN_X
  0C70'   23                    	INX	H
  0C71'   C3 0C7F'              	JMP	LN_ST
  0C74'                         LNDEC:
  0C74'   E5                    	PUSH	H
  0C75'   2A 0000*              	LHLD	LNDLT
  0C78'   7C                    	MOV	A,H
  0C79'   FE C0                 	CPI	0C0H
  0C7B'   CA 0C82'              	JZ	LN_X
  0C7E'   2B                    	DCX	H
  0C7F'                         LN_ST:
  0C7F'   22 0000*              	SHLD	LNDLT
  0C82'                         LN_X:
  0C82'   E1                    	POP	H
  0C83'   C9                    	RET
                                
  0C84'   AF                    VC_E:	XRA	A
  0C85'   32 2A21'              	STA	WBIG
  0C88'   C3 0C90'              	JMP	EDO
  0C8B'   3E 01                 VCBGE:	MVI	A,1
  0C8D'   32 2A21'              	STA	WBIG
  0C90'   CD 0758'              EDO:	CALL	SETMOV
  0C93'   CD 0689'              	CALL	GETCNT
  0C96'   22 2A59'              	SHLD	CNTV
  0C99'   2A 2A59'              EDO_LP: LHLD	CNTV
  0C9C'   7C                    	MOV	A,H
  0C9D'   B5                    	ORA	L
  0C9E'   CA 0AC8'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CA1'   2B                    	DCX	H
  0CA2'   22 2A59'              	SHLD	CNTV
  0CA5'   CD 0CB3'              	CALL	ESTEP
  0CA8'   21 2A44'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CAB'   36 00                 	MVI	M,0
  0CAD'   D2 0C99'              	JNC	EDO_LP
  0CB0'   C3 0AC8'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0CB3'                         ESTEP:
  0CB3'   CD 0BC8'              	CALL	CCLS
  0CB6'   32 2A65'              	STA	WKCLS		; the starting class
  0CB9'   CD 0C02'              	CALL	INCC
  0CBC'   B7                    	ORA	A
  0CBD'   FA 0CE3'              	JM	ES_F
  0CC0'   CD 0BC8'              	CALL	CCLS
  0CC3'   B7                    	ORA	A
  0CC4'   CA 0CCE'              	JZ	ES_ST
  0CC7'   21 2A65'              	LXI	H,WKCLS
  0CCA'   BE                    	CMP	M
  0CCB'   CA 0CE5'              	JZ	ES_SK		; still in the word it started in: on to its end
  0CCE'                         ES_ST:
  0CCE'   3A 2A44'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0CD1'   B7                    	ORA	A		;   that char is the word's end already, and
  0CD2'   C2 0CFC'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0CD5'                         ES_WS:
  0CD5'   CD 0BC8'              	CALL	CCLS		; over blanks, line ends and empty lines
  0CD8'   B7                    	ORA	A
  0CD9'   C2 0CE5'              	JNZ	ES_SK
  0CDC'   CD 0C02'              	CALL	INCC
  0CDF'   B7                    	ORA	A
  0CE0'   F2 0CD5'              	JP	ES_WS
  0CE3'                         ES_F:
  0CE3'   37                    	STC
  0CE4'   C9                    	RET
  0CE5'                         ES_SK:
  0CE5'   CD 0BC8'              	CALL	CCLS		; past the rest of this word ...
  0CE8'   32 2A65'              	STA	WKCLS
  0CEB'                         ES_SL:
  0CEB'   CD 0C02'              	CALL	INCC
  0CEE'   B7                    	ORA	A
  0CEF'   FA 0CE3'              	JM	ES_F
  0CF2'   CD 0BC8'              	CALL	CCLS
  0CF5'   21 2A65'              	LXI	H,WKCLS
  0CF8'   BE                    	CMP	M
  0CF9'   CA 0CEB'              	JZ	ES_SL
  0CFC'   C3 0C44'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0CFF'                         CURRW:
  0CFF'   2A 0000*              	LHLD	WINROW
  0D02'   EB                    	XCHG
  0D03'   2A 0000*              	LHLD	LNDLT
  0D06'   19                    	DAD	D		; HL = row (signed)
  0D07'   7C                    	MOV	A,H
  0D08'   B7                    	ORA	A
  0D09'   FA 0D1C'              	JM	CRW_0		; above the screen -> top row
  0D0C'   C2 0D17'              	JNZ	CRW_BT		; far below -> bottom row
  0D0F'   3A 0000*              	LDA	NEDIT
  0D12'   3D                    	DCR	A		; A = bottom row
  0D13'   BD                    	CMP	L		; CY iff bottom < row
  0D14'   D8                    	RC
  0D15'   7D                    	MOV	A,L
  0D16'   C9                    	RET
  0D17'                         CRW_BT:
  0D17'   3A 0000*              	LDA	NEDIT
  0D1A'   3D                    	DCR	A
  0D1B'   C9                    	RET
  0D1C'                         CRW_0:
  0D1C'   AF                    	XRA	A
  0D1D'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D1E'                         SETRWT:
  0D1E'   2A 0000*              	LHLD	LNDLT
  0D21'   EB                    	XCHG
  0D22'   6F                    	MOV	L,A
  0D23'   26 00                 	MVI	H,0
  0D25'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D28'   22 0000*              	SHLD	WINROW
  0D2B'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D2C'                         MVROW:
  0D2C'   47                    	MOV	B,A
  0D2D'   CD 0CFF'              	CALL	CURRW
  0D30'   90                    	SUB	B		; A = row now - target
  0D31'   C8                    	RZ
  0D32'   DA 0D3B'              	JC	MR_DN
  0D35'   6F                    	MOV	L,A
  0D36'   26 00                 	MVI	H,0
  0D38'   C3 098A'              	JMP	KCORE
  0D3B'                         MR_DN:
  0D3B'   2F                    	CMA
  0D3C'   3C                    	INR	A		; A = target - row now
  0D3D'   6F                    	MOV	L,A
  0D3E'   26 00                 	MVI	H,0
  0D40'   C3 08ED'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D43'                         VC_HIGH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D43'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0D46'   2B                    	DCX	H		; row = count - 1
  0D47'   7C                    	MOV	A,H
  0D48'   B7                    	ORA	A
  0D49'   3A 0000*              	LDA	SCBOT
  0D4C'   C2 0D54'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D4F'   BD                    	CMP	L		; CY iff SCBOT < row
  0D50'   DA 0D54'              	JC	VH_GO
  0D53'   7D                    	MOV	A,L
  0D54'                         VH_GO:
  0D54'   CD 0D2C'              	CALL	MVROW
  0D57'   C3 0832'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D5A'                         VC_MIDL:
  0D5A'   CD 0676'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D5D'   3A 0000*              	LDA	SCBOT
  0D60'   B7                    	ORA	A		; clear CY for the shift
  0D61'   1F                    	RAR			; A = SCBOT / 2
  0D62'   CD 0D2C'              	CALL	MVROW
  0D65'   C3 0832'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D68'                         VC_LOWL:
  0D68'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0D6B'   2B                    	DCX	H		; count - 1
  0D6C'   3A 0000*              	LDA	SCBOT
  0D6F'   5F                    	MOV	E,A
  0D70'   16 00                 	MVI	D,0
  0D72'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D73'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D76'   3E 00                 	MVI	A,0
  0D78'   D2 0D7F'              	JNC	VL_GO		; at or past the top -> row 0
  0D7B'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D7E'   7D                    	MOV	A,L
  0D7F'                         VL_GO:
  0D7F'   CD 0D2C'              	CALL	MVROW
  0D82'   C3 0832'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D85'                         VC_PGDN:
  0D85'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0D88'   3A 0000*              	LDA	SCEOF
  0D8B'   B7                    	ORA	A
  0D8C'   CA 0D9A'              	JZ	VPD_N
  0D8F'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D92'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D93'   C8                    	RZ			; it already is
  0D94'   CD 0D2C'              	CALL	MVROW
  0D97'   C3 0DAB'              	JMP	VPD_TP
  0D9A'                         VPD_N:
  0D9A'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D9D'   D6 02                 	SUI	2
  0D9F'   CD 0DF3'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DA2'   E5                    	PUSH	H
  0DA3'   AF                    	XRA	A
  0DA4'   CD 0D2C'              	CALL	MVROW		; the top line
  0DA7'   E1                    	POP	H
  0DA8'   CD 08ED'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DAB'                         VPD_TP:
  0DAB'   AF                    	XRA	A
  0DAC'   CD 0D1E'              	CALL	SETRWT		; to the top row
  0DAF'   C3 0832'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DB2'                         VC_PGUP:
  0DB2'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  0DB5'   3A 0000*              	LDA	SCBOF
  0DB8'   B7                    	ORA	A
  0DB9'   C0                    	RNZ
  0DBA'   3A 0000*              	LDA	NEDIT
  0DBD'   47                    	MOV	B,A
  0DBE'   3A 0000*              	LDA	SCEOF
  0DC1'   B7                    	ORA	A
  0DC2'   CA 0DD3'              	JZ	VPU_2
  0DC5'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DC8'   FE 02                 	CPI	2
  0DCA'   D2 0DD3'              	JNC	VPU_2
  0DCD'   2F                    	CMA
  0DCE'   3C                    	INR	A
  0DCF'   80                    	ADD	B
  0DD0'   C3 0DD6'              	JMP	VPU_P
  0DD3'                         VPU_2:
  0DD3'   78                    	MOV	A,B
  0DD4'   D6 02                 	SUI	2
  0DD6'                         VPU_P:
  0DD6'   CD 0DF3'              	CALL	MULSAT		; HL = count * page
  0DD9'   E5                    	PUSH	H
  0DDA'   AF                    	XRA	A
  0DDB'   CD 0D2C'              	CALL	MVROW		; the top line
  0DDE'   E1                    	POP	H
  0DDF'   CD 098A'              	CALL	KCORE		; the new top line
  0DE2'   AF                    	XRA	A
  0DE3'   CD 0D1E'              	CALL	SETRWT		; on the top row
  0DE6'   3A 0000*              	LDA	NEDIT
  0DE9'   3D                    	DCR	A
  0DEA'   6F                    	MOV	L,A
  0DEB'   26 00                 	MVI	H,0
  0DED'   CD 08ED'              	CALL	JCORE		; the bottom row's line
  0DF0'   C3 0832'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DF3'                         MULSAT:
  0DF3'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DF4'   21 0000               	LXI	H,0
  0DF7'   B7                    	ORA	A
  0DF8'   C8                    	RZ
  0DF9'                         MS_LP:
  0DF9'   19                    	DAD	D
  0DFA'   DA 0E02'              	JC	MS_SAT
  0DFD'   3D                    	DCR	A
  0DFE'   C2 0DF9'              	JNZ	MS_LP
  0E01'   C9                    	RET
  0E02'                         MS_SAT:
  0E02'   21 FFFF               	LXI	H,0FFFFH
  0E05'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E06'                         VC_HFDN:
  0E06'   CD 0758'              	CALL	SETMOV
  0E09'   CD 0CFF'              	CALL	CURRW
  0E0C'   32 2A23'              	STA	HFROW
  0E0F'   CD 0E7D'              	CALL	HFCNT		; HL = lines
  0E12'   3A 2A23'              	LDA	HFROW
  0E15'   47                    	MOV	B,A
  0E16'   3A 0000*              	LDA	SCEOF
  0E19'   B7                    	ORA	A
  0E1A'   CA 0E22'              	JZ	VHD_GO
  0E1D'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E20'   B8                    	CMP	B
  0E21'   C8                    	RZ			; the cursor is on it
  0E22'                         VHD_GO:
  0E22'   CD 08ED'              	CALL	JCORE
  0E25'   3A 0000*              	LDA	SCEOF
  0E28'   B7                    	ORA	A
  0E29'   C2 0832'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E2C'   3A 2A23'              	LDA	HFROW
  0E2F'   CD 0D1E'              	CALL	SETRWT
  0E32'   3E 01                 	MVI	A,1
  0E34'   32 0000*              	STA	WFILL		; not past the end of the file
  0E37'   C3 0832'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E3A'                         VC_HFUP:
  0E3A'   CD 0758'              	CALL	SETMOV
  0E3D'   CD 0CFF'              	CALL	CURRW
  0E40'   32 2A23'              	STA	HFROW
  0E43'   CD 0E7D'              	CALL	HFCNT		; HL = lines
  0E46'   CD 0E5D'              	CALL	ONFST
  0E49'   C8                    	RZ			; the cursor is on the first line
  0E4A'   CD 098A'              	CALL	KCORE
  0E4D'   3A 0000*              	LDA	SCBOF
  0E50'   B7                    	ORA	A
  0E51'   C2 0832'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E54'   3A 2A23'              	LDA	HFROW
  0E57'   CD 0D1E'              	CALL	SETRWT
  0E5A'   C3 0832'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E5D'                         ONFST:
  0E5D'   E5                    	PUSH	H
  0E5E'   2A 0000*              	LHLD	OUTPOS
  0E61'   7C                    	MOV	A,H
  0E62'   B5                    	ORA	L
  0E63'   C2 0E7B'              	JNZ	OF_RET
  0E66'   2A 0000*              	LHLD	TXTBEG
  0E69'   EB                    	XCHG			; DE = TXTBEG
  0E6A'   2A 0000*              	LHLD	GAPBEG
  0E6D'                         OF_LP:
  0E6D'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E70'   CA 0E7B'              	JZ	OF_RET
  0E73'   2B                    	DCX	H
  0E74'   7E                    	MOV	A,M
  0E75'   FE 0A                 	CPI	LF
  0E77'   C2 0E6D'              	JNZ	OF_LP
  0E7A'   B7                    	ORA	A		; NZ
  0E7B'                         OF_RET:
  0E7B'   E1                    	POP	H
  0E7C'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E7D'                         HFCNT:
  0E7D'   2A 2A17'              	LHLD	CMDCNT
  0E80'   7C                    	MOV	A,H
  0E81'   B5                    	ORA	L
  0E82'   CA 0E99'              	JZ	HFC_AM
  0E85'   CD 0689'              	CALL	GETCNT		; HL = count; clears it
  0E88'   3A 0000*              	LDA	NEDIT
  0E8B'   5F                    	MOV	E,A
  0E8C'   16 00                 	MVI	D,0
  0E8E'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E91'   D2 0E95'              	JNC	HFC_ST
  0E94'   EB                    	XCHG			; HL = NEDIT
  0E95'                         HFC_ST:
  0E95'   7D                    	MOV	A,L
  0E96'   32 2A24'              	STA	HFAMT
  0E99'                         HFC_AM:
  0E99'   3A 2A24'              	LDA	HFAMT
  0E9C'   B7                    	ORA	A
  0E9D'   C2 0EAA'              	JNZ	HFC_HL
  0EA0'   3A 0000*              	LDA	NEDIT
  0EA3'   B7                    	ORA	A
  0EA4'   1F                    	RAR
  0EA5'   B7                    	ORA	A
  0EA6'   C2 0EAA'              	JNZ	HFC_HL
  0EA9'   3C                    	INR	A		; at least one line
  0EAA'                         HFC_HL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EAA'   6F                    	MOV	L,A
  0EAB'   26 00                 	MVI	H,0
  0EAD'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EAE'                         VC_REDR:
  0EAE'   C3 0689'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EB1'                         VC_G:
  0EB1'   CD 0758'              	CALL	SETMOV
  0EB4'   CD 0F73'              	CALL	GZONE		; the screen's top line, before the move
  0EB7'   CD 06B2'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EBA'   2A 2A17'              	LHLD	CMDCNT
  0EBD'   7C                    	MOV	A,H
  0EBE'   B5                    	ORA	L
  0EBF'   C2 0ED2'              	JNZ	VG_N
  0EC2'   AF                    	XRA	A		; forward
  0EC3'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EC6'   CD 06E9'              	CALL	BRKOFF
  0EC9'   DA 0701'              	JC	BRKBAK
  0ECC'   CD 0A21'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0ECF'   C3 0F8B'              	JMP	GPLACE
  0ED2'                         VG_N:
  0ED2'   CD 0689'              	CALL	GETCNT		; HL = target line (1-based)
  0ED5'                         VG_LN:
  0ED5'   CD 0EE1'              	CALL	GOLN
  0ED8'   CD 06E9'              	CALL	BRKOFF
  0EDB'   DA 0701'              	JC	BRKBAK
  0EDE'   C3 0F8B'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EE1'                         GOLN:
  0EE1'   E5                    	PUSH	H
  0EE2'   CD 0000*              	CALL	CNTLF
  0EE5'   23                    	INX	H		; HL = the cursor's line
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EE6'   D1                    	POP	D		; DE = the line wanted
  0EE7'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EEA'   DA 0EF5'              	JC	GLN_BK
  0EED'   EB                    	XCHG
  0EEE'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EF1'   AF                    	XRA	A
  0EF2'   C3 0EFA'              	JMP	GLN_MV
  0EF5'                         GLN_BK:
  0EF5'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EF8'   3E FF                 	MVI	A,0FFH
  0EFA'                         GLN_MV:
  0EFA'   CD 0000*              	CALL	MVLIND
  0EFD'   CD 0A1B'              	CALL	ATEOF
  0F00'   DC 0A21'              	CC	LASTLN		; past the last line: onto it
  0F03'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0F04'                         VC_LG:
  0F04'   CD 0758'              	CALL	SETMOV
  0F07'   3A 2A3F'              	LDA	GSAVE
  0F0A'   B7                    	ORA	A
  0F0B'   C2 0F14'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F0E'   3E 01                 	MVI	A,PG
  0F10'   32 2A3E'              	STA	GPEND
  0F13'   C9                    	RET
  0F14'                         VLG_GG:
  0F14'   CD 0F73'              	CALL	GZONE
  0F17'   CD 06B2'              	CALL	BRKON
  0F1A'   CD 0689'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F1D'   C3 0ED5'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F20'                         SUB24:
  0F20'   4F                    	MOV	C,A
  0F21'   7D                    	MOV	A,L
  0F22'   93                    	SUB	E
  0F23'   6F                    	MOV	L,A
  0F24'   7C                    	MOV	A,H
  0F25'   9A                    	SBB	D
  0F26'   67                    	MOV	H,A
  0F27'   79                    	MOV	A,C
  0F28'   98                    	SBB	B
  0F29'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F2A'                         CURFP:
  0F2A'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F2D'                         FPOS:
  0F2D'   C5                    	PUSH	B
  0F2E'   D5                    	PUSH	D
  0F2F'   EB                    	XCHG
  0F30'   2A 0000*              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F33'   EB                    	XCHG
  0F34'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F37'   EB                    	XCHG			; DE = that
  0F38'   2A 0000*              	LHLD	OUTPOS
  0F3B'   7C                    	MOV	A,H
  0F3C'   B7                    	ORA	A		; CY = 0
  0F3D'   1F                    	RAR
  0F3E'   47                    	MOV	B,A
  0F3F'   7D                    	MOV	A,L
  0F40'   1F                    	RAR
  0F41'   67                    	MOV	H,A
  0F42'   3E 00                 	MVI	A,0
  0F44'   1F                    	RAR
  0F45'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F46'   19                    	DAD	D
  0F47'   78                    	MOV	A,B
  0F48'   CE 00                 	ACI	0		; A:HL = the position
  0F4A'   D1                    	POP	D
  0F4B'   C1                    	POP	B
  0F4C'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F4D'                         ZSAVE:
  0F4D'   2A 2A17'              	LHLD	CMDCNT
  0F50'   22 2A7D'              	SHLD	ZSVCNT
  0F53'   2A 0000*              	LHLD	AUXCNT
  0F56'   22 2A7F'              	SHLD	ZSVAUX
  0F59'   3A 0000*              	LDA	DIRFLG
  0F5C'   32 2A81'              	STA	ZSVDIR
  0F5F'   C9                    	RET
  0F60'                         ZREST:
  0F60'   2A 2A7D'              	LHLD	ZSVCNT
  0F63'   22 2A17'              	SHLD	CMDCNT
  0F66'   2A 2A7F'              	LHLD	ZSVAUX
  0F69'   22 0000*              	SHLD	AUXCNT
  0F6C'   3A 2A81'              	LDA	ZSVDIR
  0F6F'   32 0000*              	STA	DIRFLG
  0F72'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F73'                         GZONE:
  0F73'   CD 0F4D'              	CALL	ZSAVE
  0F76'   CD 0CFF'              	CALL	CURRW
  0F79'   6F                    	MOV	L,A
  0F7A'   26 00                 	MVI	H,0
  0F7C'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F7F'   CD 0F2D'              	CALL	FPOS
  0F82'   22 0000*              	SHLD	ZTOP
  0F85'   32 0002*              	STA	ZTOP+2
  0F88'   C3 0F60'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F8B'                         GPLACE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F8B'   CD 0F4D'              	CALL	ZSAVE
  0F8E'   CD 0F2A'              	CALL	CURFP
  0F91'   EB                    	XCHG
  0F92'   2A 0000*              	LHLD	ZTOP
  0F95'   EB                    	XCHG
  0F96'   4F                    	MOV	C,A		; C:HL = the target's position
  0F97'   3A 0002*              	LDA	ZTOP+2
  0F9A'   47                    	MOV	B,A		; B:DE = the top's
  0F9B'   79                    	MOV	A,C
  0F9C'   CD 0F20'              	CALL	SUB24
  0F9F'   22 2A7A'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0FA2'   DA 0FEF'              	JC	GP_UP
  0FA5'   B7                    	ORA	A
  0FA6'   C2 1030'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FA9'   3A 0000*              	LDA	NEDIT
  0FAC'   5F                    	MOV	E,A
  0FAD'   16 00                 	MVI	D,0
  0FAF'   B7                    	ORA	A
  0FB0'   1F                    	RAR
  0FB1'   6F                    	MOV	L,A
  0FB2'   26 00                 	MVI	H,0
  0FB4'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FB5'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FB8'   CD 0682'              	CALL	GBSUB		; HL = bytes from there to the target
  0FBB'   EB                    	XCHG
  0FBC'   2A 2A7A'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FBF'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FC2'   DA 1030'              	JC	GP_MID
  0FC5'   CD 0682'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FC8'   01 0000               	LXI	B,0		; BC = lines from the top
  0FCB'                         GP_CNT:
  0FCB'   7A                    	MOV	A,D
  0FCC'   B3                    	ORA	E
  0FCD'   CA 0FDC'              	JZ	GP_DN
  0FD0'   7E                    	MOV	A,M
  0FD1'   23                    	INX	H
  0FD2'   1B                    	DCX	D
  0FD3'   FE 0A                 	CPI	LF
  0FD5'   C2 0FCB'              	JNZ	GP_CNT
  0FD8'   03                    	INX	B
  0FD9'   C3 0FCB'              	JMP	GP_CNT
  0FDC'                         GP_DN:
  0FDC'   3A 0000*              	LDA	NEDIT
  0FDF'   3D                    	DCR	A
  0FE0'   5F                    	MOV	E,A
  0FE1'   16 00                 	MVI	D,0		; DE = the bottom row
  0FE3'   60                    	MOV	H,B
  0FE4'   69                    	MOV	L,C
  0FE5'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FE8'   DA 103A'              	JC	GP_SET		; A = the bottom row
  0FEB'   7D                    	MOV	A,L		; on the screen: its row
  0FEC'   C3 105A'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FEF'                         GP_UP:
  0FEF'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FF0'   C2 1030'              	JNZ	GP_MID		; 64K bytes or more above
  0FF3'   2A 2A7A'              	LHLD	ZDIF
  0FF6'   EB                    	XCHG
  0FF7'   21 0000               	LXI	H,0
  0FFA'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FFD'   7C                    	MOV	A,H
  0FFE'   B5                    	ORA	L
  0FFF'   CA 1030'              	JZ	GP_MID		; exactly 64K
  1002'   EB                    	XCHG			; DE = bytes to read
  1003'   AF                    	XRA	A
  1004'   32 2A7C'              	STA	ZLF
  1007'   CD 0000*              	CALL	RGET0
  100A'                         GP_RD:
  100A'   CD 0000*              	CALL	RDGET		; (keeps DE)
  100D'   DA 1030'              	JC	GP_MID
  1010'   FE 0A                 	CPI	LF
  1012'   C2 1026'              	JNZ	GP_RN
  1015'   3A 0000*              	LDA	NEDIT
  1018'   B7                    	ORA	A
  1019'   1F                    	RAR
  101A'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  101C'   E5                    	PUSH	H
  101D'   21 2A7C'              	LXI	H,ZLF
  1020'   34                    	INR	M
  1021'   BE                    	CMP	M		; CY iff more lines than that
  1022'   E1                    	POP	H
  1023'   DA 1030'              	JC	GP_MID
  1026'                         GP_RN:
  1026'   1B                    	DCX	D
  1027'   7A                    	MOV	A,D
  1028'   B3                    	ORA	E
  1029'   C2 100A'              	JNZ	GP_RD
  102C'   AF                    	XRA	A		; the top row
  102D'   C3 103A'              	JMP	GP_SET
  1030'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1030'   3E 01                 	MVI	A,1
  1032'   32 0000*              	STA	WFILL		; not past the end of the file
  1035'   3A 0000*              	LDA	NEDIT
  1038'   B7                    	ORA	A
  1039'   1F                    	RAR			; the middle row
  103A'                         GP_SET:
  103A'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  103B'   26 00                 	MVI	H,0
  103D'   22 0000*              	SHLD	WINROW
  1040'   21 0000               	LXI	H,0
  1043'   22 0000*              	SHLD	LNDLT
  1046'   CD 0779'              	CALL	SETFUL		; the window may have paged: full repaint
  1049'                         GP_FIN:
  1049'   CD 0F60'              	CALL	ZREST
  104C'   3A 2AA4'              	LDA	GPKEEP
  104F'   B7                    	ORA	A
  1050'   CA 0832'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1053'   AF                    	XRA	A
  1054'   32 2AA4'              	STA	GPKEEP
  1057'   C3 057B'              	JMP	SETGL		; ... except a search, which keeps the column
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  105A'                         GP_ONS:
  105A'   6F                    	MOV	L,A
  105B'   26 00                 	MVI	H,0		; HL = the row it lands on
  105D'   EB                    	XCHG
  105E'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1061'   EB                    	XCHG
  1062'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1065'   22 0000*              	SHLD	LNDLT
  1068'   3E 01                 	MVI	A,R_MOVE
  106A'   32 2A1B'              	STA	RINTENT
  106D'   C3 1049'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  1070'                         OPPEND:
  1070'   AF                    	XRA	A
  1071'   32 2A44'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1074'   3A 2A41'              	LDA	PSAVE
  1077'   FE 63                 	CPI	'c'
  1079'   C2 1096'              	JNZ	OPP_ND
  107C'   79                    	MOV	A,C
  107D'   FE 77                 	CPI	'w'
  107F'   CA 1087'              	JZ	OPP_W
  1082'   FE 57                 	CPI	'W'
  1084'   C2 1096'              	JNZ	OPP_ND
  1087'                         OPP_W:
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1087'   CD 1269'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  108A'   DA 1096'              	JC	OPP_ND
  108D'   79                    	MOV	A,C
  108E'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1090'   4F                    	MOV	C,A
  1091'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1093'   32 2A44'              	STA	CWEOL		;   char for the next word's: see ESTEP
  1096'                         OPP_ND:
  1096'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1097'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1099'   C2 10AD'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  109C'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  109F'   DA 113D'              	JC	OPABRT
  10A2'   79                    	MOV	A,C
  10A3'   FE 67                 	CPI	'g'
  10A5'   C2 113D'              	JNZ	OPABRT
  10A8'   3E 01                 	MVI	A,PG
  10AA'   32 2A3F'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10AD'                         OPP_NG:
  10AD'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10AE'   21 2A41'              	LXI	H,PSAVE
  10B1'   BE                    	CMP	M
  10B2'   CA 128A'              	JZ	OPLINE
  10B5'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10B6'   CD 12A0'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10B9'   DA 113D'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10BC'   32 2A43'              	STA	OPCLSV
  10BF'   47                    	MOV	B,A		; B = the class
  10C0'   3A 2A41'              	LDA	PSAVE
  10C3'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10C5'   C2 10D1'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10C8'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10C9'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10CB'   C2 10F3'              	JNZ	OPP_GO
  10CE'   C3 10DC'              	JMP	OPP_NO
  10D1'                         OPP_NC:
  10D1'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10D3'   C2 10F3'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10D6'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10D7'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10D9'   CA 10F3'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10DC'                         OPP_NO:
  10DC'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10DD'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10DF'   CA 10ED'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10E2'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10E4'   CA 10ED'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10E7'   CD 034A'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10EA'   C2 113D'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10ED'                         OPP_SW:
  10ED'   CD 021C'              	CALL	MKGETK
  10F0'   C3 113D'              	JMP	OPABRT
  10F3'                         OPP_GO:
  10F3'   AF                    	XRA	A
  10F4'   32 2A22'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10F7'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10FA'   22 2A45'              	SHLD	OPSTA
  10FD'   C5                    	PUSH	B
  10FE'   21 2A49'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1101'   CD 044D'              	CALL	FPSTO		;   only good until the motion pages the window
  1104'   3A 2A43'              	LDA	OPCLSV
  1107'   FE 02                 	CPI	2
  1109'   CC 1140'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  110C'   C1                    	POP	B
  110D'   21 2945'              	LXI	H,CMDTAB
  1110'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1113'   3A 2A41'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1116'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1117'   CA 0758'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  111A'   CD 116C'              	CALL	OPSFIX		; where the start is in the window NOW
  111D'   D2 1188'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1120'   22 2A45'              	SHLD	OPSTA
  1123'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1126'   22 2A47'              	SHLD	OPEND2
  1129'   3A 2A41'              	LDA	PSAVE
  112C'   FE 79                 	CPI	'y'
  112E'   CA 17C5'              	JZ	OPYANK		; a yank takes the span without losing it
  1131'   CD 12DB'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1134'   3A 2A41'              	LDA	PSAVE
  1137'   FE 63                 	CPI	'c'
  1139'   C0                    	RNZ
  113A'   C3 1581'              	JMP	SETINS
  113D'                         OPABRT:				; not a motion -> the operator is dropped and
  113D'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1140'                         OPENDS:
  1140'   2A 2A45'              	LHLD	OPSTA
  1143'   CD 05E2'              	CALL	BOL
  1146'   11 2A4C'              	LXI	D,OPSLO
  1149'   CD 115E'              	CALL	OPE_ST
  114C'   2A 2A45'              	LHLD	OPSTA
  114F'   CD 0612'              	CALL	NLSTART
  1152'   11 2A4F'              	LXI	D,OPSHI
  1155'   CD 115E'              	CALL	OPE_ST
  1158'   2A 2A45'              	LHLD	OPSTA
  115B'   C3 0000*              	JMP	GOTO
  115E'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  115E'   D5                    	PUSH	D
  115F'   CD 0000*              	CALL	GOTO
  1162'   E1                    	POP	H
  1163'   C3 044D'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1166'                         CURBD:
  1166'   CD 0F2A'              	CALL	CURFP
  1169'   EB                    	XCHG
  116A'   47                    	MOV	B,A
  116B'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  116C'                         OPSFIX:
  116C'   21 2A49'              	LXI	H,OPSFP
  116F'   CD 0400'              	CALL	MKLOAD
  1172'   CD 1166'              	CALL	CURBD
  1175'   2A 2AAE'              	LHLD	MKPOS
  1178'   3A 2AB0'              	LDA	MKPOS+2
  117B'   CD 0F20'              	CALL	SUB24
  117E'   B4                    	ORA	H
  117F'   B5                    	ORA	L
  1180'   C2 040D'              	JNZ	MKWIN
  1183'   CD 0000*              	CALL	CUROFF
  1186'   37                    	STC
  1187'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1188'                         OPPGD:
  1188'   47                    	MOV	B,A
  1189'   3A 2A43'              	LDA	OPCLSV
  118C'   FE 02                 	CPI	2
  118E'   C2 124A'              	JNZ	OPG_NO
  1191'   3A 2A41'              	LDA	PSAVE
  1194'   FE 64                 	CPI	'd'
  1196'   C2 124A'              	JNZ	OPG_NO
  1199'   04                    	INR	B
  119A'   CA 11A9'              	JZ	OPG_FW
  119D'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11A0'   CD 05E2'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11A3'   CD 0000*              	CALL	GOTO
  11A6'   C3 11C1'              	JMP	OPG_GO
  11A9'                         OPG_FW:
  11A9'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11AC'   CD 0612'              	CALL	NLSTART		;   landed on, and the low one is where the
  11AF'   11 2A4F'              	LXI	D,OPSHI		;   start line began
  11B2'   CD 115E'              	CALL	OPE_ST
  11B5'   21 2A4C'              	LXI	H,OPSLO
  11B8'   CD 0400'              	CALL	MKLOAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11BB'   CD 03CD'              	CALL	MKPAGE
  11BE'   CD 0000*              	CALL	GOTO
  11C1'                         OPG_GO:
  11C1'   CD 1166'              	CALL	CURBD
  11C4'   2A 2A4F'              	LHLD	OPSHI
  11C7'   3A 2A51'              	LDA	OPSHI+2
  11CA'   CD 0F20'              	CALL	SUB24		; A:HL = the bytes to take
  11CD'                         OPG_SV:
  11CD'   22 2A52'              	SHLD	OPTOGO
  11D0'   32 2A54'              	STA	OPTOGO+2
  11D3'                         OPG_NX:
  11D3'   CD 0665'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11D6'   CD 0000*              	CALL	SUBHD
  11D9'   EB                    	XCHG			; DE = what the window holds past the cursor
  11DA'   2A 2A52'              	LHLD	OPTOGO
  11DD'   3A 2A54'              	LDA	OPTOGO+2
  11E0'   B7                    	ORA	A
  11E1'   C2 1214'              	JNZ	OPG_PG		; 64K or more to go
  11E4'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11E7'   DA 1214'              	JC	OPG_PG
  11EA'   CA 1214'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11ED'                         OPG_FN:				; the rest of it is here
  11ED'   E5                    	PUSH	H
  11EE'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11F1'   CD 0000*              	CALL	CUROFF
  11F4'   22 2A55'              	SHLD	OPLO
  11F7'   D1                    	POP	D
  11F8'   19                    	DAD	D
  11F9'   22 2A57'              	SHLD	OPHI
  11FC'   CD 140B'              	CALL	OPDSPN
  11FF'   CD 0A1B'              	CALL	ATEOF
  1202'   D2 1263'              	JNC	OPMID
  1205'   CD 0E5D'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1208'   CA 1263'              	JZ	OPMID		;   last line, if there is one -- and the pager
  120B'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  120E'   CD 0000*              	CALL	SETBWD
  1211'   C3 1263'              	JMP	OPMID
  1214'                         OPG_PG:
  1214'   7A                    	MOV	A,D
  1215'   B3                    	ORA	E
  1216'   C2 122F'              	JNZ	OPG_DL
  1219'   CD 0A1B'              	CALL	ATEOF		; nothing held past the cursor
  121C'   21 0000               	LXI	H,0
  121F'   DA 11ED'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1222'   2B                    	DCX	H
  1223'   CD 0000*              	CALL	SETC0
  1226'   CD 0000*              	CALL	GOLINE
  1229'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  122C'   C3 11D3'              	JMP	OPG_NX
  122F'                         OPG_DL:
  122F'   D5                    	PUSH	D
  1230'   21 FFFF               	LXI	H,0FFFFH
  1233'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1236'   E1                    	POP	H
  1237'   E5                    	PUSH	H
  1238'   CD 0000*              	CALL	DELFWD
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  123B'   D1                    	POP	D
  123C'   06 00                 	MVI	B,0
  123E'   2A 2A52'              	LHLD	OPTOGO
  1241'   3A 2A54'              	LDA	OPTOGO+2
  1244'   CD 0F20'              	CALL	SUB24
  1247'   C3 11CD'              	JMP	OPG_SV
  124A'                         OPG_NO:
  124A'   0E 07                 	MVI	C,BEL
  124C'   CD 0000*              	CALL	BCONOU
  124F'                         OPG_HM:				; the cursor back where the command found it
  124F'   21 2A49'              	LXI	H,OPSFP
  1252'   CD 0400'              	CALL	MKLOAD
  1255'   CD 03CD'              	CALL	MKPAGE
  1258'   CD 0000*              	CALL	GOTO
  125B'   AF                    	XRA	A
  125C'   32 2A41'              	STA	PSAVE
  125F'   3C                    	INR	A
  1260'   32 2AA4'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1263'                         OPMID:
  1263'   CD 0F4D'              	CALL	ZSAVE
  1266'   C3 1030'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1269'                         ONWHIT:
  1269'   CD 0665'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  126C'   CA 1288'              	JZ	OW_YES
  126F'   CD 0670'              	CALL	CURCHR		; A = the char under the cursor
  1272'   FE 20                 	CPI	' '
  1274'   CA 1288'              	JZ	OW_YES
  1277'   FE 09                 	CPI	TAB
  1279'   CA 1288'              	JZ	OW_YES
  127C'   FE 0D                 	CPI	CR
  127E'   CA 1288'              	JZ	OW_YES
  1281'   FE 0A                 	CPI	LF
  1283'   CA 1288'              	JZ	OW_YES
  1286'   B7                    	ORA	A		; a char to change: CY clear
  1287'   C9                    	RET
  1288'                         OW_YES:
  1288'   37                    	STC
  1289'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  128A'                         OPLINE:
  128A'   3A 2A41'              	LDA	PSAVE
  128D'   FE 63                 	CPI	'c'
  128F'   CA 0758'              	JZ	SETMOV
  1292'   FE 79                 	CPI	'y'
  1294'   CA 17A4'              	JZ	VY_YY
  1297'   21 2A49'              	LXI	H,OPSFP		; where the cursor is, for a count the register
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  129A'   CD 044D'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  129D'   C3 171D'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12A0'                         OPCLS:
  12A0'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12A2'   CA 12AF'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12A5'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12A7'   C2 12C3'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12AA'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12AC'   C3 12B1'              	JMP	OPC_FK
  12AF'                         OPC_SEM:
  12AF'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12B1'                         OPC_FK:
  12B1'   3A 2A9A'              	LDA	FNDKND
  12B4'   B7                    	ORA	A
  12B5'   37                    	STC
  12B6'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12B7'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12B8'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12BA'   CA 12C1'              	JZ	OPC_EXC
  12BD'   3E 01                 	MVI	A,1
  12BF'   B7                    	ORA	A		; CY clear: a motion, class 1
  12C0'   C9                    	RET
  12C1'                         OPC_EXC:
  12C1'   AF                    	XRA	A		; class 0, CY clear
  12C2'   C9                    	RET
  12C3'                         OPC_TB:
  12C3'   47                    	MOV	B,A
  12C4'   21 1475'              	LXI	H,OPCTAB
  12C7'                         OPC_LP:
  12C7'   7E                    	MOV	A,M
  12C8'   B7                    	ORA	A
  12C9'   CA 12D9'              	JZ	OPC_MS		; end of table -> not a motion
  12CC'   B8                    	CMP	B
  12CD'   CA 12D5'              	JZ	OPC_HT
  12D0'   23                    	INX	H
  12D1'   23                    	INX	H
  12D2'   C3 12C7'              	JMP	OPC_LP
  12D5'                         OPC_HT:
  12D5'   23                    	INX	H
  12D6'   7E                    	MOV	A,M		; class byte
  12D7'   B7                    	ORA	A		; clear CY
  12D8'   C9                    	RET
  12D9'                         OPC_MS:
  12D9'   37                    	STC
  12DA'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12DB'                         OPAPPL:
  12DB'   3A 2A43'              	LDA	OPCLSV
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12DE'   FE 02                 	CPI	2
  12E0'   CA 1459'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12E3'   2A 2A45'              	LHLD	OPSTA
  12E6'   EB                    	XCHG			; DE = start
  12E7'   2A 2A47'              	LHLD	OPEND2		; HL = end
  12EA'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12ED'   DA 12FD'              	JC	OPA_F
  12F0'   CA 12FD'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12F3'   22 2A55'              	SHLD	OPLO
  12F6'   EB                    	XCHG
  12F7'   22 2A57'              	SHLD	OPHI
  12FA'   C3 13B4'              	JMP	OPA_C1
  12FD'                         OPA_F:
  12FD'   EB                    	XCHG			; HL = start, DE = end
  12FE'   22 2A55'              	SHLD	OPLO
  1301'   EB                    	XCHG			; HL = end
  1302'   3A 2A43'              	LDA	OPCLSV
  1305'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1307'   CA 13B1'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  130A'   FE 01                 	CPI	1
  130C'   C2 132E'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  130F'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1310'   22 2A57'              	SHLD	OPHI		; park it: CEND clobbers DE
  1313'   2B                    	DCX	H		; the line it landed on
  1314'   CD 14FF'              	CALL	CEND		; HL = that line's content end
  1317'   EB                    	XCHG			; DE = it
  1318'   2A 2A57'              	LHLD	OPHI		; HL = hi
  131B'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  131E'   D2 1339'              	JNC	OPA_HI		; hi is inside the line: keep it
  1321'   2A 2A55'              	LHLD	OPLO
  1324'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1327'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  132A'   EB                    	XCHG			; HL = the content end: the span stops there
  132B'   C3 1339'              	JMP	OPA_HI
  132E'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  132E'   22 2A57'              	SHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1331'   3A 2A22'              	LDA	WPULL
  1334'   B7                    	ORA	A
  1335'   CA 13B4'              	JZ	OPA_C1
  1338'   23                    	INX	H
  1339'                         OPA_HI:
  1339'   22 2A57'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  133C'                         OPA_DO:
  133C'   CD 1400'              	CALL	OPSPNL
  133F'   7C                    	MOV	A,H
  1340'   B5                    	ORA	L
  1341'   C2 134A'              	JNZ	OPA_D1
  1344'   2A 2A55'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1347'   C3 0000*              	JMP	GOTO		;   to where the span starts
  134A'                         OPA_D1:
  134A'   3A 2A41'              	LDA	PSAVE
  134D'   FE 63                 	CPI	'c'
  134F'   CA 140B'              	JZ	OPDSPN
  1352'   CD 13F3'              	CALL	SPNBRK
  1355'   D2 1376'              	JNC	OPA_D2
  1358'   2A 2A57'              	LHLD	OPHI
  135B'   CD 14FF'              	CALL	CEND
  135E'   EB                    	XCHG			; DE = the content end of the line it ends in
  135F'   2A 2A57'              	LHLD	OPHI
  1362'                         OPA_BL:
  1362'   CD 0000*              	CALL	CMP16
  1365'   CA 137C'              	JZ	OPA_BI		; only blanks after it
  1368'   D5                    	PUSH	D
  1369'   E5                    	PUSH	H
  136A'   CD 0000*              	CALL	CHARAT
  136D'   E1                    	POP	H
  136E'   D1                    	POP	D
  136F'   23                    	INX	H
  1370'   CD 13AB'              	CALL	BLANKQ
  1373'   CA 1362'              	JZ	OPA_BL
  1376'                         OPA_D2:
  1376'   CD 140B'              	CALL	OPDSPN
  1379'   C3 1510'              	JMP	CLAMPE
  137C'                         OPA_BI:
  137C'   CD 138E'              	CALL	LOIND
  137F'   C2 1376'              	JNZ	OPA_D2
  1382'   2A 2A57'              	LHLD	OPHI
  1385'   CD 0612'              	CALL	NLSTART
  1388'   22 2A57'              	SHLD	OPHI
  138B'   C3 13DF'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  138E'                         LOIND:
  138E'   2A 2A55'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1391'   CD 05E2'              	CALL	BOL
  1394'                         LI_LP:
  1394'   E5                    	PUSH	H
  1395'   EB                    	XCHG
  1396'   2A 2A55'              	LHLD	OPLO
  1399'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  139C'   E1                    	POP	H
  139D'   C8                    	RZ
  139E'   E5                    	PUSH	H
  139F'   CD 0000*              	CALL	CHARAT
  13A2'   E1                    	POP	H
  13A3'   23                    	INX	H
  13A4'   CD 13AB'              	CALL	BLANKQ
  13A7'   CA 1394'              	JZ	LI_LP
  13AA'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  13AB'                         BLANKQ:
  13AB'   FE 20                 	CPI	' '
  13AD'   C8                    	RZ
  13AE'   FE 09                 	CPI	TAB
  13B0'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  13B1'                         OPA_JP:
  13B1'   22 2A57'              	SHLD	OPHI
  13B4'                         OPA_C1:
  13B4'   CD 1400'              	CALL	OPSPNL
  13B7'   7C                    	MOV	A,H
  13B8'   B5                    	ORA	L
  13B9'   CA 133C'              	JZ	OPA_DO		; nothing spanned
  13BC'   2A 2A57'              	LHLD	OPHI
  13BF'   CD 05E2'              	CALL	BOL
  13C2'   EB                    	XCHG
  13C3'   2A 2A57'              	LHLD	OPHI
  13C6'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  13C9'   C2 133C'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  13CC'   CD 138E'              	CALL	LOIND
  13CF'   CA 13DF'              	JZ	C1_LW		; only blanks before lo: whole lines
  13D2'                         C1_CH:
  13D2'   2A 2A57'              	LHLD	OPHI		; back over the line break to the content end
  13D5'   2B                    	DCX	H		;   of the line before
  13D6'   CD 14FF'              	CALL	CEND
  13D9'   22 2A57'              	SHLD	OPHI
  13DC'   C3 133C'              	JMP	OPA_DO
  13DF'                         C1_LW:
  13DF'   2A 2A55'              	LHLD	OPLO
  13E2'   CD 05E2'              	CALL	BOL
  13E5'   22 2A55'              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13E8'   3A 2A41'              	LDA	PSAVE
  13EB'   FE 63                 	CPI	'c'
  13ED'   CA 13D2'              	JZ	C1_CH
  13F0'   C3 145C'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  13F3'                         SPNBRK:
  13F3'   2A 2A55'              	LHLD	OPLO
  13F6'   CD 05F5'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  13F9'   EB                    	XCHG			; DE = it
  13FA'   2A 2A57'              	LHLD	OPHI
  13FD'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1400'                         OPSPNL:
  1400'   2A 2A57'              	LHLD	OPHI
  1403'   EB                    	XCHG
  1404'   2A 2A55'              	LHLD	OPLO
  1407'   EB                    	XCHG			; HL = hi, DE = lo
  1408'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  140B'                         OPDSPN:
  140B'   CD 13F3'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  140E'   F5                    	PUSH	PSW
  140F'   2A 2A55'              	LHLD	OPLO
  1412'   CD 0000*              	CALL	GOTO
  1415'   CD 1400'              	CALL	OPSPNL		; HL = hi - lo
  1418'   CD 0000*              	CALL	DELFWD
  141B'   CD 018C'              	CALL	MARKMOD
  141E'   F1                    	POP	PSW
  141F'   DA 0779'              	JC	SETFUL		; a break went: every row below it moved up
  1422'   C3 075E'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1425'                         OPALSP:
  1425'   2A 2A45'              	LHLD	OPSTA
  1428'   EB                    	XCHG
  1429'   2A 2A47'              	LHLD	OPEND2
  142C'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  142F'   DA 143C'              	JC	OPAL_F
  1432'   22 2A55'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1435'   EB                    	XCHG
  1436'   22 2A57'              	SHLD	OPHI		; hi-src = start
  1439'   C3 1446'              	JMP	OPAL_R
  143C'                         OPAL_F:
  143C'   EB                    	XCHG			; HL = start
  143D'   22 2A55'              	SHLD	OPLO		; lo-src = start
  1440'   2A 2A47'              	LHLD	OPEND2
  1443'   22 2A57'              	SHLD	OPHI		; hi-src = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1446'                         OPAL_R:
  1446'   2A 2A55'              	LHLD	OPLO
  1449'   CD 05E2'              	CALL	BOL
  144C'   22 2A55'              	SHLD	OPLO		; lo = BOL(low line)
  144F'   2A 2A57'              	LHLD	OPHI
  1452'   CD 0612'              	CALL	NLSTART
  1455'   22 2A57'              	SHLD	OPHI		; hi = start of line past the high line
  1458'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1459'                         OPALIN:
  1459'   CD 1425'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  145C'                         OPDLIN:
  145C'   CD 140B'              	CALL	OPDSPN
  145F'   CD 0665'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1462'   DA 1472'              	JC	OPDL_NB
  1465'   CD 0000*              	CALL	LOGLEN
  1468'   7C                    	MOV	A,H
  1469'   B5                    	ORA	L
  146A'   C8                    	RZ			; empty buffer
  146B'   2B                    	DCX	H
  146C'   CD 05E2'              	CALL	BOL
  146F'   CD 0000*              	CALL	GOTO
  1472'                         OPDL_NB:
  1472'   C3 0832'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1475'                         OPCTAB:
  1475'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1479'   62 00 42 00           
  147D'   68 00 6C 00           
  1481'   30 00 5E 00           
  1485'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1487'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  148B'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  148F'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1493'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1497'   24 01                 
  1499'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  149D'   47 02 48 02           
  14A1'   4D 02 4C 02           
  14A5'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  14A7'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  14A9'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  14AA'                         VCB_C:
  14AA'   CD 14B6'              	CALL	VCB_CD
  14AD'   C3 1581'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  14B0'                         VCB_D:
  14B0'   CD 14B6'              	CALL	VCB_CD
  14B3'   C3 1510'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  14B6'                         VCB_CD:
  14B6'   CD 067C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14B9'   22 2A55'              	SHLD	OPLO
  14BC'   CD 0000*              	CALL	CUROFF
  14BF'   CD 14FF'              	CALL	CEND		; to the line's content end, the CR,LF left
  14C2'   22 2A57'              	SHLD	OPHI
  14C5'   C3 140B'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  14C8'                         VC_X:
  14C8'   CD 08E4'              	CALL	GLSTAL
  14CB'   CD 075E'              	CALL	SETLIN
  14CE'   CD 0689'              	CALL	GETCNT
  14D1'   22 2A59'              	SHLD	CNTV
  14D4'   CD 0000*              	CALL	CUROFF
  14D7'   22 2A5D'              	SHLD	WKI		; cur
  14DA'   CD 14FF'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  14DD'   EB                    	XCHG			; DE = contentend
  14DE'   2A 2A5D'              	LHLD	WKI		; HL = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14E1'   EB                    	XCHG			; HL = contentend, DE = cur
  14E2'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14E5'   7C                    	MOV	A,H
  14E6'   B5                    	ORA	L
  14E7'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14E8'   EB                    	XCHG			; DE = available
  14E9'   2A 2A59'              	LHLD	CNTV		; HL = count
  14EC'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14EF'   DA 14F5'              	JC	VX_USEA
  14F2'   C3 14F6'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14F5'                         VX_USEA:
  14F5'   EB                    	XCHG			; HL = available
  14F6'                         VX_DEL:
  14F6'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14F9'   CD 018C'              	CALL	MARKMOD
  14FC'   C3 1510'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  14FF'                         CEND:
  14FF'   CD 05F5'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1502'   7C                    	MOV	A,H
  1503'   B5                    	ORA	L
  1504'   C8                    	RZ			; the start of the text: nothing before it
  1505'   2B                    	DCX	H
  1506'   E5                    	PUSH	H
  1507'   CD 0000*              	CALL	CHARAT
  150A'   E1                    	POP	H		; HL = term-1
  150B'   FE 0D                 	CPI	CR
  150D'   C8                    	RZ			; a CR before the LF -> the content ends there
  150E'   23                    	INX	H
  150F'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1510'                         CLAMPE:
  1510'   CD 0000*              	CALL	CUROFF
  1513'   E5                    	PUSH	H
  1514'   CD 0621'              	CALL	EOLC
  1517'   D1                    	POP	D		; DE = cur
  1518'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  151B'   D8                    	RC
  151C'   C8                    	RZ
  151D'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1520'                         VC_I:
  1520'   CD 0689'              	CALL	GETCNT
  1523'   C3 157E'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1526'                         VC_A:
  1526'   CD 0689'              	CALL	GETCNT
  1529'   CD 0665'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  152C'   CA 1543'              	JZ	VA_INS
  152F'   EB                    	XCHG			; HL = cur
  1530'   E5                    	PUSH	H
  1531'   CD 0000*              	CALL	CHARAT
  1534'   E1                    	POP	H
  1535'   FE 0A                 	CPI	LF
  1537'   CA 1543'              	JZ	VA_INS		; on the line terminator -> append in place
  153A'   FE 0D                 	CPI	CR
  153C'   CA 1543'              	JZ	VA_INS
  153F'   23                    	INX	H
  1540'   CD 0000*              	CALL	GOTO
  1543'                         VA_INS:
  1543'   C3 157E'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1546'                         VCB_A:
  1546'   CD 067C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1549'   CD 0621'              	CALL	EOLC		; HL = last content char (the start when empty)
  154C'   E5                    	PUSH	H
  154D'   CD 0000*              	CALL	CHARAT
  1550'   E1                    	POP	H
  1551'   FE 0D                 	CPI	CR
  1553'   CA 155C'              	JZ	VBA_IN		; an empty line: insert at its start
  1556'   FE 0A                 	CPI	LF
  1558'   CA 155C'              	JZ	VBA_IN
  155B'   23                    	INX	H		; past the last content char
  155C'                         VBA_IN:
  155C'   CD 0000*              	CALL	GOTO
  155F'   C3 157E'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1562'                         VCB_I:
  1562'   CD 0689'              	CALL	GETCNT
  1565'   CD 0832'              	CALL	FNBLNK
  1568'   CD 0000*              	CALL	CUROFF
  156B'   E5                    	PUSH	H
  156C'   CD 0000*              	CALL	CHARAT
  156F'   E1                    	POP	H
  1570'   FE 20                 	CPI	' '
  1572'   CA 157A'              	JZ	VBI_SK
  1575'   FE 09                 	CPI	TAB
  1577'   C2 157E'              	JNZ	SETINM
  157A'                         VBI_SK:
  157A'   23                    	INX	H		; blanks only: past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  157B'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  157E'                         SETINM:
  157E'   CD 0758'              	CALL	SETMOV
  1581'                         SETINS:
  1581'   3E 01                 	MVI	A,EM_INS
  1583'   32 2A16'              	STA	EDMODE
  1586'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1587'                         ATCEND:
  1587'   CD 0665'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  158A'   C8                    	RZ
  158B'   CD 0670'              	CALL	CURCHR		; A = the char under the cursor
  158E'   FE 0D                 	CPI	CR
  1590'   C8                    	RZ
  1591'   FE 0A                 	CPI	LF
  1593'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1594'                         OPNBRK:
  1594'   CD 1E86'              	CALL	PUTBRK
  1597'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  159A'   23                    	INX	H
  159B'   22 0000*              	SHLD	LNDLT
  159E'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  15A1'                         ENDBRK:
  15A1'   CD 0665'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  15A4'   C0                    	RNZ
  15A5'   CD 1594'              	CALL	OPNBRK
  15A8'   CD 0000*              	CALL	CUROFF
  15AB'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15AC'   2B                    	DCX	H		;   line, with its own terminator after it
  15AD'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  15B0'                         VC_O:
  15B0'   CD 067C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15B3'   CD 14FF'              	CALL	CEND
  15B6'   CD 0000*              	CALL	GOTO
  15B9'   CD 1594'              	CALL	OPNBRK
  15BC'   CD 15A1'              	CALL	ENDBRK		; a last line with no line end: the opened line
  15BF'   CD 0764'              	CALL	SETILN		;   needs a terminator of its own to exist
  15C2'   C3 1581'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  15C5'                         VCB_O:
  15C5'   CD 067C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15C8'   CD 05E2'              	CALL	BOL
  15CB'   CD 0000*              	CALL	GOTO
  15CE'   CD 1594'              	CALL	OPNBRK
  15D1'   CD 0000*              	CALL	CUROFF
  15D4'   2B                    	DCX	H
  15D5'   2B                    	DCX	H
  15D6'   CD 0000*              	CALL	GOTO
  15D9'   CD 0764'              	CALL	SETILN
  15DC'   C3 1581'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  15DF'                         VCB_J:
  15DF'   CD 067C'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15E2'   CD 14FF'              	CALL	CEND		; the join point: this line's content end
  15E5'   22 2A55'              	SHLD	OPLO
  15E8'   CD 0000*              	CALL	CUROFF
  15EB'   CD 0612'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15EE'   E5                    	PUSH	H
  15EF'   CD 0000*              	CALL	LOGLEN
  15F2'   D1                    	POP	D		; DE = that start
  15F3'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15F6'   CA 0758'              	JZ	SETMOV
  15F9'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15FA'                         VJ_WS:
  15FA'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15FB'   CD 0000*              	CALL	LOGLEN
  15FE'   D1                    	POP	D		; DE = the scan
  15FF'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1602'   CA 1619'              	JZ	VJ_DEL
  1605'   EB                    	XCHG			; HL = the scan
  1606'   E5                    	PUSH	H
  1607'   CD 0000*              	CALL	CHARAT
  160A'   E1                    	POP	H
  160B'   FE 20                 	CPI	' '
  160D'   CA 1615'              	JZ	VJ_SKIP
  1610'   FE 09                 	CPI	TAB
  1612'   C2 1619'              	JNZ	VJ_DEL
  1615'                         VJ_SKIP:
  1615'   23                    	INX	H
  1616'   C3 15FA'              	JMP	VJ_WS
  1619'                         VJ_DEL:
  1619'   22 2A57'              	SHLD	OPHI
  161C'   CD 140B'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  161F'   CD 0773'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1622'   CD 0665'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1625'   CA 1510'              	JZ	CLAMPE
  1628'   CD 0670'              	CALL	CURCHR		; the first char of what was appended
  162B'   FE 0D                 	CPI	CR
  162D'   CA 1510'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1630'   FE 0A                 	CPI	LF
  1632'   CA 1510'              	JZ	CLAMPE
  1635'   FE 29                 	CPI	')'
  1637'   CA 1510'              	JZ	CLAMPE		; vim puts no space before a ')'
  163A'   CD 0000*              	CALL	CUROFF
  163D'   7C                    	MOV	A,H
  163E'   B5                    	ORA	L
  163F'   CA 1655'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1642'   2B                    	DCX	H
  1643'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1646'   FE 20                 	CPI	' '
  1648'   CA 1510'              	JZ	CLAMPE
  164B'   FE 09                 	CPI	TAB
  164D'   CA 1510'              	JZ	CLAMPE
  1650'   FE 0A                 	CPI	LF
  1652'   CA 1510'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1655'                         VJ_SP:
  1655'   3E 20                 	MVI	A,' '
  1657'   CD 0000*              	CALL	PUTGAP
  165A'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  165D'   2B                    	DCX	H
  165E'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1661'                         VC_TILD:
  1661'   CD 0689'              	CALL	GETCNT
  1664'   CD 075E'              	CALL	SETLIN		; only this row changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1667'   CD 08E4'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  166A'   CD 0665'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  166D'   CA 0758'              	JZ	SETMOV
  1670'   CD 0670'              	CALL	CURCHR		; A = the char under the cursor
  1673'   FE 0D                 	CPI	CR
  1675'   CA 0758'              	JZ	SETMOV		; the line's end: nothing to toggle
  1678'   FE 0A                 	CPI	LF
  167A'   CA 0758'              	JZ	SETMOV
  167D'   47                    	MOV	B,A
  167E'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1680'   FE 41                 	CPI	'A'
  1682'   DA 168E'              	JC	VT_PUT		; below 'A': no case
  1685'   FE 5B                 	CPI	'Z'+1
  1687'   D2 168E'              	JNC	VT_PUT		; above 'Z': no case
  168A'   78                    	MOV	A,B
  168B'   EE 20                 	XRI	20H		; a letter: flip the case bit
  168D'   47                    	MOV	B,A
  168E'                         VT_PUT:
  168E'   78                    	MOV	A,B
  168F'   32 2A66'              	STA	VRCH		; the calls below do not preserve B
  1692'   CD 018C'              	CALL	MARKMOD
  1695'   21 0001               	LXI	H,1
  1698'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  169B'   3A 2A66'              	LDA	VRCH
  169E'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  16A1'   C3 1510'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  16A4'                         VC_R:
  16A4'   CD 0676'              	CALL	MOVCNT		; a cursor motion, and its count
  16A7'   3E 03                 	MVI	A,PR
  16A9'   32 2A3E'              	STA	GPEND
  16AC'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  16AD'                         VR_DO:
  16AD'   AF                    	XRA	A
  16AE'   32 2A3E'              	STA	GPEND
  16B1'   79                    	MOV	A,C
  16B2'   32 2A66'              	STA	VRCH		; the calls below do not preserve C
  16B5'   CD 075E'              	CALL	SETLIN		; only this row changed
  16B8'   CD 08E4'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16BB'   CD 0665'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16BE'   CA 0758'              	JZ	SETMOV		; the end of the text: vim does nothing
  16C1'   CD 0670'              	CALL	CURCHR		; A = the char under the cursor
  16C4'   FE 0D                 	CPI	CR
  16C6'   CA 0758'              	JZ	SETMOV		; the line's end: nothing to replace
  16C9'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16CB'   CA 0758'              	JZ	SETMOV
  16CE'   CD 018C'              	CALL	MARKMOD
  16D1'   21 0001               	LXI	H,1
  16D4'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  16D7'   3A 2A66'              	LDA	VRCH
  16DA'   FE 0D                 	CPI	CR
  16DC'   CA 16E9'              	JZ	VR_CR
  16DF'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16E2'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16E5'   2B                    	DCX	H		;   out, which moves every logical offset
  16E6'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16E9'                         VR_CR:
  16E9'   CD 1594'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16EC'   CD 15A1'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16EF'   CD 0764'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16F2'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16F4'   32 2A1E'              	STA	ILABOV
  16F7'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16F8'                         VCB_R:
  16F8'   CD 0689'              	CALL	GETCNT
  16FB'   CD 0758'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  16FE'   21 0000               	LXI	H,0
  1701'   22 2A67'              	SHLD	RPDEL		; nothing of ours to put back yet
  1704'   22 2A69'              	SHLD	RPAPP
  1707'   3E 02                 	MVI	A,EM_REP
  1709'   32 2A16'              	STA	EDMODE
  170C'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  170D'                         VC_D:
  170D'   3E 64                 	MVI	A,'d'
  170F'   32 2A40'              	STA	PENDOP
  1712'   C3 0758'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1715'                         VC_C:
  1715'   3E 63                 	MVI	A,'c'
  1717'   32 2A40'              	STA	PENDOP
  171A'   C3 0758'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  171D'                         VD_DD:
  171D'   CD 08E4'              	CALL	GLSTAL
  1720'   CD 0689'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1723'   22 2A59'              	SHLD	CNTV
  1726'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1728'   32 2A42'              	STA	DDSNG
  172B'   2B                    	DCX	H
  172C'   7C                    	MOV	A,H
  172D'   B5                    	ORA	L
  172E'   C2 1739'              	JNZ	VDD_LS
  1731'   3E 01                 	MVI	A,1
  1733'   32 2A42'              	STA	DDSNG
  1736'   C3 173F'              	JMP	VDD_GO
  1739'                         VDD_LS:
  1739'   CD 089D'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  173C'   DA 0758'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  173F'                         VDD_GO:
  173F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1742'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1745'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1748'   CD 20E9'              	CALL	COPY12		;   every mark in the lines has closed up by then
  174B'   CD 081B'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  174E'   2A 2A59'              	LHLD	CNTV
  1751'   CD 0000*              	CALL	SETC0
  1754'                         VDD_FW:
  1754'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1757'   DA 18A5'              	JC	QREFUS		; ... which has no room for them
  175A'   CD 069E'              	CALL	CNTTST
  175D'   C2 1754'              	JNZ	VDD_FW
  1760'   CD 018C'              	CALL	MARKMOD
  1763'   CD 0A1B'              	CALL	ATEOF
  1766'   D2 1781'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1769'   3E 00                 	MVI	A,0
  176B'   32 2A42'              	STA	DDSNG		; deleted to the end: full repaint
  176E'   CD 0E5D'              	CALL	ONFST
  1771'   CA 0832'              	JZ	FNBLNK		; nothing left before it
  1774'   21 0001               	LXI	H,1		; onto the new last line
  1777'   CD 0000*              	CALL	SETBWD
  177A'   2A 0000*              	LHLD	LNDLT
  177D'   2B                    	DCX	H
  177E'   22 0000*              	SHLD	LNDLT
  1781'                         VDD_UP:
  1781'   CD 0832'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1784'   3A 2A42'              	LDA	DDSNG
  1787'   B7                    	ORA	A
  1788'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1789'   3E 03                 	MVI	A,R_DLIN
  178B'   32 2A1B'              	STA	RINTENT
  178E'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  178F'                         QEMPTY:
  178F'   2A 0000*              	LHLD	QBEG
  1792'   EB                    	XCHG
  1793'   2A 0000*              	LHLD	QEND
  1796'   7C                    	MOV	A,H
  1797'   BA                    	CMP	D
  1798'   C0                    	RNZ
  1799'   7D                    	MOV	A,L
  179A'   BB                    	CMP	E
  179B'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  179C'                         VC_Y:
  179C'   3E 79                 	MVI	A,'y'
  179E'   32 2A40'              	STA	PENDOP
  17A1'   C3 0758'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  17A4'                         VY_YY:
  17A4'   21 2A49'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  17A7'   CD 044D'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  17AA'   CD 0000*              	CALL	CUROFF
  17AD'   22 2A8A'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  17B0'   CD 05E2'              	CALL	BOL
  17B3'   22 2A8C'              	SHLD	YPT		; where the lines come from, to put them back
  17B6'   CD 190B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17B9'   CD 194E'              	CALL	YNCOPY		; copied where they lie, if that can be done
  17BC'   D2 1912'              	JNC	YNDONE
  17BF'   21 171D'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  17C2'   C3 17EE'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  17C5'                         OPYANK:
  17C5'   CD 1425'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  17C8'   2A 2A45'              	LHLD	OPSTA
  17CB'   EB                    	XCHG			; DE = start
  17CC'   2A 2A47'              	LHLD	OPEND2		; HL = end
  17CF'   CD 0000*              	CALL	CMP16		; CY iff start < end
  17D2'   D2 17D6'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  17D5'   EB                    	XCHG			; ... otherwise the start is
  17D6'                         OPY_LO:
  17D6'   22 2A8A'              	SHLD	YOFF
  17D9'   2A 2A55'              	LHLD	OPLO
  17DC'   22 2A8C'              	SHLD	YPT		; where the lines come from, to put them back
  17DF'   CD 190B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17E2'   CD 19C6'              	CALL	YNSPAN		; copied where they lie, if there is room
  17E5'   D2 1912'              	JNC	YNDONE
  17E8'   21 18CC'              	LXI	H,YSPAN
  17EB'   C3 17EE'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  17EE'                         YKGO:
  17EE'   22 2AB3'              	SHLD	YACT
  17F1'   2A 2A8C'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17F4'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17F5'   2A 2A8A'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17F8'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17FB'   22 2AB9'              	SHLD	YCOL		;   them -- but a distance within the lines does
  17FE'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1801'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1802'   2A 2A8C'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1805'   EB                    	XCHG			;   window as it was, then names other text
  1806'   E1                    	POP	H
  1807'   CD 0000*              	CALL	SUBHD
  180A'   EB                    	XCHG			; DE = how far behind the cursor they start
  180B'   CD 0F2A'              	CALL	CURFP
  180E'   06 00                 	MVI	B,0
  1810'   CD 0F20'              	CALL	SUB24
  1813'   22 2ABB'              	SHLD	YPFP
  1816'   32 2ABD'              	STA	YPFP+2
  1819'   3A 2A1A'              	LDA	MODF
  181C'   32 2A87'              	STA	YMODF
  181F'   3A 2A33'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1822'   32 2A88'              	STA	YDCHG		;   a yank must not become the last change
  1825'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1828'   32 2A89'              	STA	YURPL		;   back are not a change to undo either
  182B'   3E 01                 	MVI	A,1
  182D'   32 0000*              	STA	UNDRPL
  1830'   32 2AB2'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1833'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1836'   22 2A95'              	SHLD	YLDLT
  1839'   CD 0000*              	CALL	LOGLEN
  183C'   22 2AB7'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  183F'   2A 2AB3'              	LHLD	YACT
  1842'   CD 18A4'              	CALL	YCALL		; the lines out of the file, into the register
  1845'   3A 2A82'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1848'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  184A'   CA 1888'              	JZ	YK_RF		;   cursor: only the flags are still owed
  184D'   CD 0000*              	CALL	LOGLEN
  1850'   EB                    	XCHG
  1851'   2A 2AB7'              	LHLD	YWAS
  1854'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1857'   CA 1869'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  185A'   21 2ABB'              	LXI	H,YPFP		; back to where they came from, by its place in
  185D'   CD 0400'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1860'   CD 03CD'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1863'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1866'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1869'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1869'   2A 2ABB'              	LHLD	YPFP		;   cursor is still owed its place)
  186C'   EB                    	XCHG
  186D'   2A 2AB9'              	LHLD	YCOL
  1870'   19                    	DAD	D
  1871'   22 2AAE'              	SHLD	MKPOS
  1874'   3A 2ABD'              	LDA	YPFP+2
  1877'   CE 00                 	ACI	0
  1879'   32 2AB0'              	STA	MKPOS+2
  187C'   CD 03CD'              	CALL	MKPAGE
  187F'   CD 0000*              	CALL	GOTO
  1882'                         YK_RST:
  1882'   2A 2A95'              	LHLD	YLDLT
  1885'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1888'                         YK_RF:
  1888'   3A 2A87'              	LDA	YMODF
  188B'   32 2A1A'              	STA	MODF
  188E'   3A 2A88'              	LDA	YDCHG
  1891'   32 2A33'              	STA	DOTCHG
  1894'   3A 2A89'              	LDA	YURPL
  1897'   32 0000*              	STA	UNDRPL
  189A'   AF                    	XRA	A
  189B'   32 2AB2'              	STA	MKHOLD
  189E'   CD 08E4'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  18A1'   C3 0779'              	JMP	SETFUL		; the cheap paint cannot carry this
  18A4'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  18A5'                         QREFUS:
  18A5'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  18A8'   CD 178F'              	CALL	QEMPTY
  18AB'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  18AE'   CD 0000*              	CALL	QKILL
  18B1'   3A 2AB2'              	LDA	MKHOLD
  18B4'   B7                    	ORA	A
  18B5'   C2 18C4'              	JNZ	QRF_Y
  18B8'   21 0000*              	LXI	H,MKSAV
  18BB'   11 0000*              	LXI	D,MKTAB
  18BE'   CD 20E9'              	CALL	COPY12
  18C1'   CD 0000*              	CALL	UNDCLR
  18C4'                         QRF_Y:
  18C4'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  18C6'   32 2A82'              	STA	MSGWHT
  18C9'   C3 124F'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  18CC'                         YSPAN:
  18CC'   CD 08E4'              	CALL	GLSTAL
  18CF'   CD 1400'              	CALL	OPSPNL		; HL = the span's length
  18D2'   22 2AB5'              	SHLD	YTGT
  18D5'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  18D8'   EB                    	XCHG			; DE = it
  18D9'   2A 2AB5'              	LHLD	YTGT
  18DC'   EB                    	XCHG			; HL = the text's, DE = the span's
  18DD'   CD 0000*              	CALL	SUBHD
  18E0'   22 2AB5'              	SHLD	YTGT		; what the text is left at when the span is out
  18E3'   2A 2A55'              	LHLD	OPLO
  18E6'   CD 0000*              	CALL	GOTO
  18E9'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18EC'                         YS_LP:
  18EC'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18EF'   CD 0000*              	CALL	SETC0
  18F2'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18F5'   DA 18A5'              	JC	QREFUS		; ... which has no room for it
  18F8'   CD 0000*              	CALL	LOGLEN
  18FB'   EB                    	XCHG			; DE = what is left
  18FC'   2A 2AB5'              	LHLD	YTGT
  18FF'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1902'   DA 1908'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1905'   C2 18EC'              	JNZ	YS_LP		;   but never spin here if it ever did
  1908'                         YS_END:
  1908'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  190B'                         YNPRE:
  190B'   2A 0000*              	LHLD	PGTOPM
  190E'   22 2ABE'              	SHLD	YNPG
  1911'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1912'                         YNDONE:
  1912'   2A 2A8A'              	LHLD	YOFF
  1915'   CD 0000*              	CALL	GOTO
  1918'   2A 0000*              	LHLD	PGTOPM
  191B'   EB                    	XCHG
  191C'   2A 2ABE'              	LHLD	YNPG
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  191F'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1922'   C2 0779'              	JNZ	SETFUL		; it moved under us: repaint after all
  1925'   C3 0758'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1928'                         YNROOM:
  1928'   11 0100               	LXI	D,100H
  192B'   19                    	DAD	D
  192C'   D8                    	RC			; within a chunk of 64K: no arena holds that
  192D'   E5                    	PUSH	H		; the span plus its slack
  192E'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1931'   EB                    	XCHG			; HL = free
  1932'   D1                    	POP	D		; DE = the span plus its slack
  1933'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1936'   DA 193E'              	JC	YNR_OK
  1939'   CA 193E'              	JZ	YNR_OK
  193C'   37                    	STC			; not enough: the delete-and-put-back path
  193D'   C9                    	RET
  193E'                         YNR_OK:
  193E'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  193F'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1940'                         YNGO:
  1940'   C5                    	PUSH	B
  1941'   CD 0689'              	CALL	GETCNT		; spent here: this yank is happening
  1944'   CD 08E4'              	CALL	GLSTAL
  1947'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  194A'   C1                    	POP	B
  194B'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  194E'                         YNCOPY:
  194E'   2A 2A17'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1951'   7C                    	MOV	A,H		;   the count itself
  1952'   B5                    	ORA	L
  1953'   C2 1959'              	JNZ	YNC_HV
  1956'   21 0001               	LXI	H,1
  1959'                         YNC_HV:
  1959'   7D                    	MOV	A,L		; a count of one always has its own line to take;
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  195A'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  195B'   B4                    	ORA	H
  195C'   CA 1967'              	JZ	YNC_M
  195F'   E5                    	PUSH	H
  1960'   CD 089D'              	CALL	ONLAST		; vim: a count over one on the last line does
  1963'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1964'   DA 1979'              	JC	YNC_RF
  1967'                         YNC_M:
  1967'   E5                    	PUSH	H
  1968'   CD 081B'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  196B'   E1                    	POP	H
  196C'   CD 1981'              	CALL	YNLINE		; BC = the span, measured where it stands
  196F'   D8                    	RC			; not measurable here: let the pager answer it
  1970'   60                    	MOV	H,B
  1971'   69                    	MOV	L,C
  1972'   CD 1928'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1975'   D8                    	RC			; no: the delete-and-put-back path
  1976'   C3 1940'              	JMP	YNGO
  1979'                         YNC_RF:
  1979'   CD 0689'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  197C'   CD 08E4'              	CALL	GLSTAL		;   register alone, and that is the command
  197F'   B7                    	ORA	A		; NC: done
  1980'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1981'                         YNLINE:
  1981'   22 2AC0'              	SHLD	YNCNT		; the lines it still wants
  1984'   2A 0000*              	LHLD	GAPEND
  1987'                         YNL_LP:
  1987'   EB                    	XCHG			; DE = the scan
  1988'   2A 0000*              	LHLD	TXTEND
  198B'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  198E'   EB                    	XCHG			; HL = the scan
  198F'   D2 19AF'              	JNC	YNL_EN		; the resident text ran out
  1992'   7E                    	MOV	A,M
  1993'   23                    	INX	H
  1994'   FE 0A                 	CPI	LF
  1996'   C2 1987'              	JNZ	YNL_LP
  1999'   E5                    	PUSH	H
  199A'   2A 2AC0'              	LHLD	YNCNT
  199D'   2B                    	DCX	H
  199E'   22 2AC0'              	SHLD	YNCNT
  19A1'   7C                    	MOV	A,H
  19A2'   B5                    	ORA	L
  19A3'   E1                    	POP	H
  19A4'   C2 1987'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  19A7'   EB                    	XCHG			; DE = past the last of them
  19A8'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19AB'   EB                    	XCHG			; HL = past them, DE = GAPEND
  19AC'   C3 19BD'              	JMP	YNL_BC
  19AF'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  19AF'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  19B2'   C2 19C4'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  19B5'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  19B8'   EB                    	XCHG			;   count clamps to it as vim's does
  19B9'   2A 0000*              	LHLD	GAPEND
  19BC'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  19BD'                         YNL_BC:
  19BD'   CD 0000*              	CALL	SUBHD		; HL = the span
  19C0'   44                    	MOV	B,H
  19C1'   4D                    	MOV	C,L
  19C2'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  19C3'   C9                    	RET
  19C4'                         YNL_NO:
  19C4'   37                    	STC
  19C5'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  19C6'                         YNSPAN:
  19C6'   CD 1400'              	CALL	OPSPNL		; HL = the span's length
  19C9'   44                    	MOV	B,H
  19CA'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  19CB'   CD 1928'              	CALL	YNROOM
  19CE'   D8                    	RC			; no room: the delete-and-put-back path
  19CF'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  19D0'   2A 2A55'              	LHLD	OPLO
  19D3'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  19D6'   C1                    	POP	B
  19D7'   C3 1940'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  19DA'                         VC_P:
  19DA'   CD 178F'              	CALL	QEMPTY
  19DD'   CA 1A95'              	JZ	VP_BEL
  19E0'   CD 0689'              	CALL	GETCNT
  19E3'   22 2A8E'              	SHLD	PCNT
  19E6'   CD 0000*              	CALL	CUROFF
  19E9'   CD 0612'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19EC'   C3 1A01'              	JMP	VP_GO
  19EF'                         VCB_P:
  19EF'   CD 178F'              	CALL	QEMPTY
  19F2'   CA 1A95'              	JZ	VP_BEL
  19F5'   CD 0689'              	CALL	GETCNT
  19F8'   22 2A8E'              	SHLD	PCNT
  19FB'   CD 0000*              	CALL	CUROFF
  19FE'   CD 05E2'              	CALL	BOL
  1A01'                         VP_GO:
  1A01'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                	;    still makes a new line, so the missing break goes in first ---
  1A04'   CD 0000*              	CALL	CUROFF
  1A07'   EB                    	XCHG
  1A08'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1A0B'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A0E'   DA 1A23'              	JC	VP_IN
  1A11'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A12'   7C                    	MOV	A,H
  1A13'   B5                    	ORA	L
  1A14'   CA 1A20'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A17'   2B                    	DCX	H
  1A18'   CD 0000*              	CALL	CHARAT
  1A1B'   FE 0A                 	CPI	LF
  1A1D'   CA 1A23'              	JZ	VP_IN
  1A20'                         VP_BRK:
  1A20'   CD 1594'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A23'                         VP_IN:
  1A23'   CD 0000*              	CALL	CUROFF
  1A26'   22 2A90'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A29'   2A 0000*              	LHLD	QBEG
  1A2C'   EB                    	XCHG
  1A2D'   2A 0000*              	LHLD	QEND
  1A30'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1A33'   EB                    	XCHG
  1A34'   22 2A92'              	SHLD	PLFS
  1A37'   2A 2A8E'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1A3A'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1A3B'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1A3C'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1A3E'   C2 1A42'              	JNZ	VP_PZ
  1A41'   7D                    	MOV	A,L
  1A42'                         VP_PZ:
  1A42'   32 2A94'              	STA	PCPY
  1A45'                         VP_LP:
  1A45'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A48'   2A 0000*              	LHLD	LNDLT
  1A4B'   EB                    	XCHG
  1A4C'   2A 2A92'              	LHLD	PLFS
  1A4F'   19                    	DAD	D
  1A50'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1A53'   2A 2A8E'              	LHLD	PCNT
  1A56'   2B                    	DCX	H
  1A57'   22 2A8E'              	SHLD	PCNT
  1A5A'   7C                    	MOV	A,H
  1A5B'   B5                    	ORA	L
  1A5C'   C2 1A45'              	JNZ	VP_LP
  1A5F'   CD 018C'              	CALL	MARKMOD
  1A62'   2A 2A90'              	LHLD	PPT
  1A65'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A68'   CD 08E4'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A6B'   3A 2A94'              	LDA	PCPY
  1A6E'   B7                    	ORA	A
  1A6F'   CA 0832'              	JZ	FNBLNK
  1A72'   2A 2A92'              	LHLD	PLFS
  1A75'   7C                    	MOV	A,H
  1A76'   B7                    	ORA	A
  1A77'   C2 0832'              	JNZ	FNBLNK
  1A7A'   3A 2A94'              	LDA	PCPY
  1A7D'   CD 0DF3'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A80'   7C                    	MOV	A,H
  1A81'   B7                    	ORA	A
  1A82'   C2 0832'              	JNZ	FNBLNK
  1A85'   7D                    	MOV	A,L
  1A86'   B7                    	ORA	A
  1A87'   CA 0832'              	JZ	FNBLNK
  1A8A'   F5                    	PUSH	PSW
  1A8B'   CD 0764'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A8E'   F1                    	POP	PSW
  1A8F'   32 2A1C'              	STA	ILN		; ... which the lines put now replace
  1A92'   C3 0832'              	JMP	FNBLNK
  1A95'                         VP_BEL:
  1A95'   CD 0689'              	CALL	GETCNT		; the count is spent either way
  1A98'   0E 07                 	MVI	C,BEL
  1A9A'   CD 0000*              	CALL	BCONOU
  1A9D'   C3 0758'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1AA0'                         VIREP:
  1AA0'   78                    	MOV	A,B
  1AA1'   FE 01                 	CPI	KT_ACT
  1AA3'   CA 1BD0'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AA6'   FE 02                 	CPI	KT_CHAR
  1AA8'   C0                    	RNZ			; ignore anything else
  1AA9'   79                    	MOV	A,C
  1AAA'   FE 0D                 	CPI	CR
  1AAC'   CA 1B10'              	JZ	VP_CR
  1AAF'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1AB1'   CA 1B10'              	JZ	VP_CR
  1AB4'   FE 08                 	CPI	BS
  1AB6'   CA 1B1C'              	JZ	VP_BS
  1AB9'   FE 7F                 	CPI	DEL
  1ABB'   CA 1B1C'              	JZ	VP_BS
  1ABE'   32 2A66'              	STA	VRCH		; the calls below do not preserve C
  1AC1'   CD 075E'              	CALL	SETLIN		; this row changed
  1AC4'   CD 018C'              	CALL	MARKMOD
  1AC7'   CD 1587'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1ACA'   CA 1B02'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1ACD'   3A 2A66'              	LDA	VRCH
  1AD0'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1AD3'   2A 2A67'              	LHLD	RPDEL
  1AD6'   7C                    	MOV	A,H
  1AD7'   B5                    	ORA	L
  1AD8'   CA 1AEE'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1ADB'   2A 0000*              	LHLD	GAPEND
  1ADE'   EB                    	XCHG
  1ADF'   2A 2A6B'              	LHLD	RPGE
  1AE2'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1AE5'   CA 1AEE'              	JZ	VP_OVW
  1AE8'   21 0000               	LXI	H,0
  1AEB'   22 2A67'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AEE'                         VP_OVW:
  1AEE'   21 0001               	LXI	H,1
  1AF1'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1AF4'   2A 0000*              	LHLD	GAPEND
  1AF7'   22 2A6B'              	SHLD	RPGE
  1AFA'   2A 2A67'              	LHLD	RPDEL
  1AFD'   23                    	INX	H
  1AFE'   22 2A67'              	SHLD	RPDEL
  1B01'   C9                    	RET
  1B02'                         VP_APP:
  1B02'   3A 2A66'              	LDA	VRCH
  1B05'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1B08'   2A 2A69'              	LHLD	RPAPP
  1B0B'   23                    	INX	H
  1B0C'   22 2A69'              	SHLD	RPAPP
  1B0F'   C9                    	RET
  1B10'                         VP_CR:
  1B10'   21 0000               	LXI	H,0
  1B13'   22 2A67'              	SHLD	RPDEL		; a line break ends what BS can put back
  1B16'   22 2A69'              	SHLD	RPAPP
  1B19'   C3 1BA6'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1B1C'                         VP_BS:
  1B1C'   2A 2A69'              	LHLD	RPAPP
  1B1F'   7C                    	MOV	A,H
  1B20'   B5                    	ORA	L
  1B21'   CA 1B2E'              	JZ	VP_BSD
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B24'   2B                    	DCX	H
  1B25'   22 2A69'              	SHLD	RPAPP		; an appended char: it just goes
  1B28'   CD 075E'              	CALL	SETLIN
  1B2B'   C3 0000*              	JMP	DELPRV
  1B2E'                         VP_BSD:
  1B2E'   2A 2A67'              	LHLD	RPDEL
  1B31'   7C                    	MOV	A,H
  1B32'   B5                    	ORA	L
  1B33'   CA 1B5A'              	JZ	VP_BSM		; nothing of ours left
  1B36'   2A 0000*              	LHLD	GAPEND
  1B39'   EB                    	XCHG
  1B3A'   2A 2A6B'              	LHLD	RPGE
  1B3D'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1B40'   C2 1B5A'              	JNZ	VP_BSM
  1B43'   2A 2A67'              	LHLD	RPDEL
  1B46'   2B                    	DCX	H
  1B47'   22 2A67'              	SHLD	RPDEL
  1B4A'   CD 075E'              	CALL	SETLIN
  1B4D'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B50'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B53'   2A 0000*              	LHLD	GAPEND
  1B56'   22 2A6B'              	SHLD	RPGE
  1B59'   C9                    	RET
  1B5A'                         VP_BSM:
  1B5A'   CD 0758'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B5D'   C3 07C7'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B60'                         VIINS:
  1B60'   78                    	MOV	A,B
  1B61'   FE 01                 	CPI	KT_ACT
  1B63'   CA 1BD0'              	JZ	VI_ACT
  1B66'   FE 02                 	CPI	KT_CHAR
  1B68'   C0                    	RNZ			; ignore anything else
  1B69'   79                    	MOV	A,C
  1B6A'   FE 0D                 	CPI	CR
  1B6C'   CA 1BA6'              	JZ	VI_CR
  1B6F'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B71'   CA 1BA6'              	JZ	VI_CR
  1B74'   FE 08                 	CPI	BS
  1B76'   CA 1BBE'              	JZ	VI_BS
  1B79'   FE 7F                 	CPI	DEL
  1B7B'   CA 1BBE'              	JZ	VI_BS
  1B7E'   79                    	MOV	A,C
  1B7F'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B82'   CD 018C'              	CALL	MARKMOD
  1B85'   CD 075E'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B88'   79                    	MOV	A,C
  1B89'   FE 20                 	CPI	' '
  1B8B'   D8                    	RC			; control char -> keep R_LINE
  1B8C'   FE 7F                 	CPI	DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B8E'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B8F'   CD 077F'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B92'   B7                    	ORA	A
  1B93'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B94'   3E 04                 	MVI	A,R_ICH
  1B96'   32 2A1B'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B99'   CD 1587'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B9C'   3E 00                 	MVI	A,0
  1B9E'   C2 1BA2'              	JNZ	VI_ICH
  1BA1'   3C                    	INR	A
  1BA2'                         VI_ICH:
  1BA2'   32 2A1D'              	STA	ICHAPP
  1BA5'   C9                    	RET
  1BA6'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1BA6'   CD 1587'              	CALL	ATCEND
  1BA9'   3E 00                 	MVI	A,0
  1BAB'   CA 1BAF'              	JZ	VI_CRS
  1BAE'   3C                    	INR	A
  1BAF'                         VI_CRS:
  1BAF'   F5                    	PUSH	PSW
  1BB0'   CD 1594'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1BB3'   CD 15A1'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1BB6'   CD 0764'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1BB9'   F1                    	POP	PSW
  1BBA'   32 2A1E'              	STA	ILABOV
  1BBD'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1BBE'                         VI_BS:
  1BBE'   CD 0000*              	CALL	PEEKL
  1BC1'   D8                    	RC			; start of the file: nothing to delete
  1BC2'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1BC4'   CA 1BCA'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1BC7'   CD 075E'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1BCA'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1BCA'   CD 018C'              	CALL	MARKMOD
  1BCD'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1BD0'                         VI_ACT:
  1BD0'   79                    	MOV	A,C
  1BD1'   FE 0B                 	CPI	ACT_ESC
  1BD3'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BD4'   3E 00                 	MVI	A,EM_CMD
  1BD6'   32 2A16'              	STA	EDMODE
  1BD9'   CD 0758'              	CALL	SETMOV
  1BDC'   CD 07C7'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1BDF'   C3 08E4'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BE2'                         RDLINE:
  1BE2'   EB                    	XCHG			; HL = buffer
  1BE3'   22 2A6D'              	SHLD	RLPTR
  1BE6'   3E 00                 	MVI	A,0
  1BE8'   32 2A6F'              	STA	RLLEN
  1BEB'   78                    	MOV	A,B
  1BEC'   32 2A70'              	STA	RLMAX
  1BEF'   79                    	MOV	A,C
  1BF0'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1BF3'                         RL_LP:
  1BF3'   CD 0000*              	CALL	GETKEY
  1BF6'   78                    	MOV	A,B
  1BF7'   FE 01                 	CPI	KT_ACT
  1BF9'   CA 1C4F'              	JZ	RL_ACT
  1BFC'   FE 02                 	CPI	KT_CHAR
  1BFE'   C2 1BF3'              	JNZ	RL_LP		; ignore other keys
  1C01'   79                    	MOV	A,C
  1C02'   FE 0D                 	CPI	CR
  1C04'   CA 1C60'              	JZ	RL_DONE
  1C07'   FE 08                 	CPI	BS
  1C09'   CA 1C37'              	JZ	RL_BS
  1C0C'   FE 7F                 	CPI	DEL
  1C0E'   CA 1C37'              	JZ	RL_BS
  1C11'   FE 20                 	CPI	' '
  1C13'   DA 1BF3'              	JC	RL_LP		; control char -> ignore
  1C16'   3A 2A6F'              	LDA	RLLEN
  1C19'   47                    	MOV	B,A
  1C1A'   3A 2A70'              	LDA	RLMAX
  1C1D'   B8                    	CMP	B
  1C1E'   CA 1BF3'              	JZ	RL_LP		; full -> ignore
  1C21'   2A 2A6D'              	LHLD	RLPTR
  1C24'   71                    	MOV	M,C
  1C25'   23                    	INX	H
  1C26'   22 2A6D'              	SHLD	RLPTR
  1C29'   3A 2A6F'              	LDA	RLLEN
  1C2C'   3C                    	INR	A
  1C2D'   32 2A6F'              	STA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C30'   79                    	MOV	A,C
  1C31'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1C34'   C3 1BF3'              	JMP	RL_LP
  1C37'                         RL_BS:				; WM LINEPOP
  1C37'   3A 2A6F'              	LDA	RLLEN
  1C3A'   B7                    	ORA	A
  1C3B'   CA 1C55'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1C3E'   3D                    	DCR	A
  1C3F'   32 2A6F'              	STA	RLLEN
  1C42'   2A 2A6D'              	LHLD	RLPTR
  1C45'   2B                    	DCX	H
  1C46'   22 2A6D'              	SHLD	RLPTR
  1C49'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C4C'   C3 1BF3'              	JMP	RL_LP
  1C4F'                         RL_ACT:
  1C4F'   79                    	MOV	A,C
  1C50'   FE 0B                 	CPI	ACT_ESC
  1C52'   C2 1BF3'              	JNZ	RL_LP
  1C55'                         RL_CAN:
  1C55'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C57'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C5A'   CD 075E'              	CALL	SETLIN		; redraw one row
  1C5D'   3E FF                 	MVI	A,0FFH		; cancelled
  1C5F'   C9                    	RET
  1C60'                         RL_DONE:
  1C60'   AF                    	XRA	A
  1C61'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C62'                         VC_BZ:
  1C62'   CD 0758'              	CALL	SETMOV
  1C65'   3A 2A3F'              	LDA	GSAVE
  1C68'   FE 02                 	CPI	PZ
  1C6A'   CA 1C75'              	JZ	VZ_ZZ
  1C6D'   B7                    	ORA	A
  1C6E'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C6F'   3E 02                 	MVI	A,PZ
  1C71'   32 2A3E'              	STA	GPEND
  1C74'   C9                    	RET
  1C75'                         VZ_ZZ:
  1C75'   3E 04                 	MVI	A,EO_X
  1C77'   32 2A71'              	STA	EXOP
  1C7A'   3E 01                 	MVI	A,1
  1C7C'   32 2A84'              	STA	EXBANG		; no '!'
  1C7F'   AF                    	XRA	A
  1C80'   32 2A72'              	STA	EXARG		; no file name
  1C83'   3A 2A1A'              	LDA	MODF		; as ':x': a changed text is written first
  1C86'   B7                    	ORA	A
  1C87'   CA 1DC8'              	JZ	EX_Q
  1C8A'   C3 1D62'              	JMP	EX_W
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C8D'                         VC_EX:
  1C8D'   CD 0689'              	CALL	GETCNT
  1C90'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C93'   11 0000*              	LXI	D,EXBUF
  1C96'   06 28                 	MVI	B,EXMAX
  1C98'   0E 3A                 	MVI	C,':'
  1C9A'   CD 1BE2'              	CALL	RDLINE
  1C9D'   B7                    	ORA	A
  1C9E'   C0                    	RNZ			; cancelled
  1C9F'   3A 2A6F'              	LDA	RLLEN
  1CA2'   5F                    	MOV	E,A
  1CA3'   16 00                 	MVI	D,0
  1CA5'   21 0000*              	LXI	H,EXBUF
  1CA8'   19                    	DAD	D
  1CA9'   36 00                 	MVI	M,0		; the line ends with a 0
  1CAB'   21 0000*              	LXI	H,EXBUF
  1CAE'   CD 227E'              	CALL	SKIPB
  1CB1'   C8                    	RZ			; nothing on it
  1CB2'   22 2A74'              	SHLD	EXCMD
  1CB5'   CD 2472'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1CB8'   CD 227E'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1CBB'   56                    	MOV	D,M
  1CBC'   23                    	INX	H
  1CBD'   1E 00                 	MVI	E,0
  1CBF'   CD 228A'              	CALL	ISLOW
  1CC2'   DA 1CCD'              	JC	EX_LK
  1CC5'   5F                    	MOV	E,A
  1CC6'   23                    	INX	H
  1CC7'   CD 228A'              	CALL	ISLOW
  1CCA'   D2 1CE6'              	JNC	EX_NOT		; a third letter: none of ours
  1CCD'                         EX_LK:
  1CCD'   E5                    	PUSH	H
  1CCE'   21 2459'              	LXI	H,EXTAB
  1CD1'                         EX_TL:
  1CD1'   7E                    	MOV	A,M
  1CD2'   B7                    	ORA	A
  1CD3'   CA 1CE5'              	JZ	EX_NTP		; not in the table
  1CD6'   23                    	INX	H
  1CD7'   BA                    	CMP	D
  1CD8'   7E                    	MOV	A,M
  1CD9'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CDA'   C2 1CE1'              	JNZ	EX_TN
  1CDD'   BB                    	CMP	E
  1CDE'   CA 1CEC'              	JZ	EX_TF
  1CE1'                         EX_TN:
  1CE1'   23                    	INX	H
  1CE2'   C3 1CD1'              	JMP	EX_TL
  1CE5'                         EX_NTP:
  1CE5'   E1                    	POP	H
  1CE6'                         EX_NOT:
  1CE6'   21 2342'              	LXI	H,SNOT
  1CE9'   C3 22BF'              	JMP	EXERT
  1CEC'                         EX_TF:
  1CEC'   7E                    	MOV	A,M
  1CED'   32 2A71'              	STA	EXOP
  1CF0'   E1                    	POP	H
  1CF1'   FE 06                 	CPI	EO_S
  1CF3'   CA 24E1'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CF6'   FE 01                 	CPI	EO_W
  1CF8'   CA 1D07'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CFB'   FE 08                 	CPI	EO_R
  1CFD'   CA 1D07'              	JZ	EX_RG		; ... and ':Nr name' a line
  1D00'   3A 2ACC'              	LDA	SRNGF
  1D03'   B7                    	ORA	A
  1D04'   C2 1CE6'              	JNZ	EX_NOT		; a range on a command that does not take one
  1D07'                         EX_RG:
                                	;--- '!', then the file name ---
  1D07'   7E                    	MOV	A,M
  1D08'   D6 21                 	SUI	'!'
  1D0A'   32 2A84'              	STA	EXBANG		; 0 = '!'
  1D0D'   C2 1D11'              	JNZ	EX_NB
  1D10'   23                    	INX	H
  1D11'                         EX_NB:
  1D11'   CD 227E'              	CALL	SKIPB
  1D14'   32 2A72'              	STA	EXARG		; 0 = no file name
  1D17'   CA 1D30'              	JZ	EX_RUN
  1D1A'   22 2A74'              	SHLD	EXCMD
  1D1D'   3A 2A71'              	LDA	EXOP
  1D20'   FE 02                 	CPI	EO_Q
  1D22'   CA 22BC'              	JZ	EX_TRL		; :q takes none
  1D25'   FE 07                 	CPI	EO_V
  1D27'   CA 22BC'              	JZ	EX_TRL		; nor :ve
  1D2A'   CD 21E8'              	CALL	PARSFN
  1D2D'   C2 22B0'              	JNZ	EX_INV
  1D30'                         EX_RUN:
  1D30'   3A 2A71'              	LDA	EXOP
  1D33'   FE 05                 	CPI	EO_E
  1D35'   CA 1DDF'              	JZ	EX_E
  1D38'   FE 02                 	CPI	EO_Q
  1D3A'   CA 1DC8'              	JZ	EX_Q
  1D3D'   FE 07                 	CPI	EO_V
  1D3F'   CA 22B6'              	JZ	EX_V
  1D42'   FE 08                 	CPI	EO_R
  1D44'   CA 1F70'              	JZ	EX_R
  1D47'   FE 04                 	CPI	EO_X
  1D49'   CA 1D5B'              	JZ	EX_XM
  1D4C'   FE 01                 	CPI	EO_W
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D4E'   C2 1D62'              	JNZ	EX_W		; :wq
  1D51'   3A 2ACC'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D54'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D55'   C2 1E90'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D58'   C3 1D62'              	JMP	EX_W
  1D5B'                         EX_XM:
  1D5B'   3A 2A1A'              	LDA	MODF		; :x writes only a changed text
  1D5E'   B7                    	ORA	A
  1D5F'   CA 1DC8'              	JZ	EX_Q
  1D62'                         EX_W:
  1D62'   CD 2050'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D65'   D8                    	RC			; refused (message shown)
  1D66'   32 2A73'              	STA	EXBAK
  1D69'   3A 2A71'              	LDA	EXOP
  1D6C'   FE 01                 	CPI	EO_W
  1D6E'   CA 1D85'              	JZ	EX_WK
  1D71'   3A 2A73'              	LDA	EXBAK
  1D74'   B7                    	ORA	A
  1D75'   C2 1DC5'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D78'   3A 2A84'              	LDA	EXBANG
  1D7B'   B7                    	ORA	A
  1D7C'   CA 1DC5'              	JZ	EX_WQ		; so it does with '!'
  1D7F'   CD 1D85'              	CALL	EX_WK		; else it may not: keep the text
  1D82'   C3 1DC8'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D85'                         EX_WK:
  1D85'   CD 0CFF'              	CALL	CURRW		; the cursor's row and file position
  1D88'   32 2A76'              	STA	WPROW
  1D8B'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D8E'   7D                    	MOV	A,L
  1D8F'   E6 7F                 	ANI	7FH
  1D91'   32 2A77'              	STA	WPBYT
  1D94'   7D                    	MOV	A,L
  1D95'   17                    	RAL
  1D96'   7C                    	MOV	A,H
  1D97'   17                    	RAL
  1D98'   5F                    	MOV	E,A
  1D99'   3E 00                 	MVI	A,0
  1D9B'   17                    	RAL
  1D9C'   57                    	MOV	D,A		; DE = HL / 128
  1D9D'   2A 0000*              	LHLD	OUTPOS
  1DA0'   19                    	DAD	D
  1DA1'   22 2A78'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1DA4'   CD 2085'              	CALL	WRITE
  1DA7'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1DAA'   2A 2A78'              	LHLD	WPREC
  1DAD'   EB                    	XCHG
  1DAE'   3A 2A77'              	LDA	WPBYT
  1DB1'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1DB4'   CD 0000*              	CALL	GOTO
  1DB7'                         EX_WRW:
  1DB7'   21 0000               	LXI	H,0
  1DBA'   22 0000*              	SHLD	LNDLT
  1DBD'   3A 2A76'              	LDA	WPROW
  1DC0'   6F                    	MOV	L,A
  1DC1'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DC4'   C9                    	RET
  1DC5'                         EX_WQ:
  1DC5'   CD 2085'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1DC8'                         EX_Q:
  1DC8'   3A 2A84'              	LDA	EXBANG
  1DCB'   B7                    	ORA	A
  1DCC'   CA 1DD6'              	JZ	EX_QT
  1DCF'   3A 2A1A'              	LDA	MODF
  1DD2'   B7                    	ORA	A
  1DD3'   C2 22A4'              	JNZ	MSGNWR		; changed, no '!': stay
  1DD6'                         EX_QT:
  1DD6'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1DD9'   3E 01                 	MVI	A,1
  1DDB'   32 2A19'              	STA	QUITF
  1DDE'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1DDF'                         EX_E:
  1DDF'   3A 2A84'              	LDA	EXBANG
  1DE2'   B7                    	ORA	A
  1DE3'   CA 1DED'              	JZ	EE_GO
  1DE6'   3A 2A1A'              	LDA	MODF
  1DE9'   B7                    	ORA	A
  1DEA'   C2 22A4'              	JNZ	MSGNWR
  1DED'                         EE_GO:
  1DED'   3A 2A72'              	LDA	EXARG
  1DF0'   B7                    	ORA	A
  1DF1'   C2 1DF8'              	JNZ	EE_ARG
  1DF4'   CD 20C1'              	CALL	OWNTF		; no name: the buffer's own
  1DF7'   D8                    	RC
  1DF8'                         EE_ARG:
  1DF8'   CD 20D7'              	CALL	ISOWN
  1DFB'   21 0001               	LXI	H,1
  1DFE'   C2 1E05'              	JNZ	EE_LD		; another file: its first line
  1E01'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1E04'   23                    	INX	H		; HL = the cursor's line
  1E05'                         EE_LD:
  1E05'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1E07'   32 2A82'              	STA	MSGWHT
  1E0A'   E5                    	PUSH	H
  1E0B'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E0E'   21 0000*              	LXI	H,TFCB
  1E11'   11 0000*              	LXI	D,FNAME
  1E14'   CD 20E9'              	CALL	COPY12		; the buffer's name
  1E17'   CD 20AE'              	CALL	SRCTF
  1E1A'   CD 0000*              	CALL	REOPEN
  1E1D'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1E20'   AF                    	XRA	A
  1E21'   32 2A1A'              	STA	MODF
  1E24'   E1                    	POP	H
  1E25'   2B                    	DCX	H
  1E26'   AF                    	XRA	A
  1E27'   CD 0000*              	CALL	MVLIND		; down to the line
  1E2A'   CD 0A1B'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E2D'   DC 0A21'              	CC	LASTLN		; past the last line: onto it
  1E30'   CD 0F4D'              	CALL	ZSAVE
  1E33'   C3 1030'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1E36'                         TFDOS:
  1E36'   C5                    	PUSH	B
  1E37'   11 0080               	LXI	D,CMDTAIL
  1E3A'   0E 1A                 	MVI	C,1AH		; set the DMA
  1E3C'   CD 0005               	CALL	BDOS
  1E3F'   C1                    	POP	B
  1E40'   11 0000*              	LXI	D,TFCB
  1E43'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E46'                         EXRNG:
  1E46'   2A 2ACD'              	LHLD	SRNG1
  1E49'   7C                    	MOV	A,H
  1E4A'   B5                    	ORA	L
  1E4B'   37                    	STC
  1E4C'   C8                    	RZ
  1E4D'   2A 2ACF'              	LHLD	SRNG2
  1E50'   EB                    	XCHG
  1E51'   2A 2ACD'              	LHLD	SRNG1
  1E54'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E57'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E58'   EB                    	XCHG			; HL = the last line, DE = the first
  1E59'   CD 0000*              	CALL	SUBHD
  1E5C'   23                    	INX	H
  1E5D'   22 2AD7'              	SHLD	SLINES
  1E60'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E61'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E62'                         GOLNX:
  1E62'   E5                    	PUSH	H
  1E63'   CD 0EE1'              	CALL	GOLN
  1E66'   CD 0000*              	CALL	CNTLF
  1E69'   23                    	INX	H		; the line the cursor came to rest on
  1E6A'   D1                    	POP	D
  1E6B'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E6E'                         EXSAVP:
  1E6E'   CD 0CFF'              	CALL	CURRW
  1E71'   32 2A76'              	STA	WPROW
  1E74'   21 2AAE'              	LXI	H,MKPOS
  1E77'   C3 044D'              	JMP	FPSTO
  1E7A'                         EXRSTP:
  1E7A'   CD 0000*              	CALL	CLRCNT
  1E7D'   CD 03CD'              	CALL	MKPAGE		; page until that place is in the window again
  1E80'   CD 0000*              	CALL	GOTO
  1E83'   C3 1DB7'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E86'                         PUTBRK:
  1E86'   3E 0D                 	MVI	A,CR
  1E88'   CD 0000*              	CALL	PUTGAP
  1E8B'   3E 0A                 	MVI	A,LF
  1E8D'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E90'                         EX_WR:
  1E90'   3A 2A72'              	LDA	EXARG
  1E93'   B7                    	ORA	A
  1E94'   CA 2292'              	JZ	MSGNFN		; No file name
  1E97'   CD 20D7'              	CALL	ISOWN
  1E9A'   CA 1F3A'              	JZ	EXW_OW
  1E9D'   CD 0000*              	CALL	TEXIST
  1EA0'   32 2ADA'              	STA	RWERR		; nonzero: a file of that name is there
  1EA3'   CA 1EAD'              	JZ	EXW_GO
  1EA6'   3A 2A84'              	LDA	EXBANG
  1EA9'   B7                    	ORA	A
  1EAA'   C2 2298'              	JNZ	MSGEXI		; File exists (! to force)
  1EAD'                         EXW_GO:
  1EAD'   CD 1E46'              	CALL	EXRNG
  1EB0'   DA 1F34'              	JC	EXW_BD
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EB3'   CD 1E6E'              	CALL	EXSAVP
  1EB6'   2A 2ACD'              	LHLD	SRNG1
  1EB9'   CD 1E62'              	CALL	GOLNX
  1EBC'   C2 1F31'              	JNZ	EXW_NL		; the text has no line N
  1EBF'   3A 2ADA'              	LDA	RWERR		; a delete scans the whole directory, there or
  1EC2'   B7                    	ORA	A		;   not: only when TEXIST found one
  1EC3'   0E 13                 	MVI	C,13H
  1EC5'   C4 1E36'              	CNZ	TFDOS		; delete what is there
  1EC8'   0E 16                 	MVI	C,16H
  1ECA'   CD 1E36'              	CALL	TFDOS		; ... and make it
  1ECD'   3C                    	INR	A
  1ECE'   CA 1F23'              	JZ	EXW_FL		; no directory entry left
  1ED1'   3E 80                 	MVI	A,80H
  1ED3'   32 2AD9'              	STA	RWPTR
  1ED6'   AF                    	XRA	A
  1ED7'   32 2ADA'              	STA	RWERR
  1EDA'   2A 2AD7'              	LHLD	SLINES
  1EDD'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1EE0'                         EXW_LP:
  1EE0'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1EE3'   E5                    	PUSH	H
  1EE4'   EB                    	XCHG
  1EE5'   2A 0000*              	LHLD	GAPEND
  1EE8'   CD 1F40'              	CALL	RWOUT		; the text from the cursor to there
  1EEB'   E1                    	POP	H
  1EEC'   3A 2ADA'              	LDA	RWERR
  1EEF'   B7                    	ORA	A
  1EF0'   C2 1F0C'              	JNZ	EXW_EN
  1EF3'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EF6'   CD 069E'              	CALL	CNTTST
  1EF9'   C2 1EE0'              	JNZ	EXW_LP
  1EFC'                         EXW_PD:				; the last record is padded out with ^Z
  1EFC'   3A 2AD9'              	LDA	RWPTR
  1EFF'   FE 80                 	CPI	80H
  1F01'   CA 1F0C'              	JZ	EXW_EN
  1F04'   3E 1A                 	MVI	A,CPMEOF
  1F06'   CD 1F4C'              	CALL	RWPUT
  1F09'   C3 1EFC'              	JMP	EXW_PD
  1F0C'                         EXW_EN:
  1F0C'   0E 10                 	MVI	C,10H
  1F0E'   CD 1E36'              	CALL	TFDOS		; close
  1F11'   3A 2ADA'              	LDA	RWERR
  1F14'   B7                    	ORA	A
  1F15'   C2 1F23'              	JNZ	EXW_FL
  1F18'   CD 1E7A'              	CALL	EXRSTP
  1F1B'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F1D'   32 2A82'              	STA	MSGWHT
  1F20'   C3 0758'              	JMP	SETMOV		; nothing on the screen has changed
  1F23'                         EXW_FL:				; no room: the part written is not left behind
  1F23'   0E 13                 	MVI	C,13H
  1F25'   CD 1E36'              	CALL	TFDOS
  1F28'   CD 1E7A'              	CALL	EXRSTP
  1F2B'   21 244F'              	LXI	H,SDFUL
  1F2E'   C3 22CA'              	JMP	EXERR
  1F31'                         EXW_NL:
  1F31'   CD 1E7A'              	CALL	EXRSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F34'                         EXW_BD:
  1F34'   21 2441'              	LXI	H,SRNGE
  1F37'   C3 22CA'              	JMP	EXERR
  1F3A'                         EXW_OW:
  1F3A'   21 22F9'              	LXI	H,SEXI
  1F3D'   C3 22CA'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1F40'                         RWOUT:
  1F40'   CD 0000*              	CALL	CMP16
  1F43'   C8                    	RZ
  1F44'   7E                    	MOV	A,M
  1F45'   23                    	INX	H
  1F46'   CD 1F4C'              	CALL	RWPUT
  1F49'   C3 1F40'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F4C'                         RWPUT:
  1F4C'   E5                    	PUSH	H
  1F4D'   F5                    	PUSH	PSW
  1F4E'   3A 2AD9'              	LDA	RWPTR
  1F51'   6F                    	MOV	L,A
  1F52'   26 00                 	MVI	H,0
  1F54'   F1                    	POP	PSW
  1F55'   77                    	MOV	M,A
  1F56'   2C                    	INR	L		; Z: that was the record's last byte
  1F57'   7D                    	MOV	A,L
  1F58'   C2 1F6B'              	JNZ	RWP_ST
  1F5B'   D5                    	PUSH	D
  1F5C'   0E 15                 	MVI	C,15H
  1F5E'   CD 1E36'              	CALL	TFDOS		; write it
  1F61'   D1                    	POP	D
  1F62'   B7                    	ORA	A
  1F63'   CA 1F69'              	JZ	RWP_OK
  1F66'   32 2ADA'              	STA	RWERR
  1F69'                         RWP_OK:
  1F69'   3E 80                 	MVI	A,80H
  1F6B'                         RWP_ST:
  1F6B'   32 2AD9'              	STA	RWPTR
  1F6E'   E1                    	POP	H
  1F6F'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F70'                         EX_R:
  1F70'   3A 2A72'              	LDA	EXARG
  1F73'   B7                    	ORA	A
  1F74'   CA 2292'              	JZ	MSGNFN		; No file name
  1F77'   0E 0F                 	MVI	C,0FH
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F79'   CD 1E36'              	CALL	TFDOS		; open
  1F7C'   3C                    	INR	A
  1F7D'   CA 204A'              	JZ	ER_NOF
  1F80'   CD 0F73'              	CALL	GZONE		; the screen's top line, before anything moves
  1F83'   CD 1E6E'              	CALL	EXSAVP
  1F86'   3A 2ACC'              	LDA	SRNGF
  1F89'   B7                    	ORA	A
  1F8A'   CA 1FA3'              	JZ	ER_NXT		; no line given: below the cursor's
  1F8D'   2A 2ACF'              	LHLD	SRNG2
  1F90'   7C                    	MOV	A,H
  1F91'   B5                    	ORA	L
  1F92'   C2 1F9D'              	JNZ	ER_LN
  1F95'   23                    	INX	H
  1F96'   CD 0EE1'              	CALL	GOLN		; ':0r': above line 1 ...
  1F99'   AF                    	XRA	A		;   which never wants a line end put in first
  1F9A'   C3 1FC5'              	JMP	ER_BRK
  1F9D'                         ER_LN:
  1F9D'   CD 1E62'              	CALL	GOLNX
  1FA0'   C2 1F31'              	JNZ	EXW_NL		; the text has no line N
  1FA3'                         ER_NXT:
  1FA3'   21 0001               	LXI	H,1
  1FA6'   AF                    	XRA	A
  1FA7'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1FAA'   CD 0A1B'              	CALL	ATEOF
  1FAD'   3E 00                 	MVI	A,0
  1FAF'   D2 1FC5'              	JNC	ER_BRK		; text follows
  1FB2'   2A 0000*              	LHLD	GAPBEG
  1FB5'   EB                    	XCHG
  1FB6'   2A 0000*              	LHLD	TXTBEG
  1FB9'   CD 0000*              	CALL	CMP16
  1FBC'   3E 01                 	MVI	A,1
  1FBE'   CA 1FC5'              	JZ	ER_BRK		; nothing before the cursor either
  1FC1'   1B                    	DCX	D
  1FC2'   1A                    	LDAX	D
  1FC3'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1FC5'                         ER_BRK:
  1FC5'   32 2ADC'              	STA	RDBRK
  1FC8'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1FCB'   AF                    	XRA	A
  1FCC'   32 2ADB'              	STA	RDANY
  1FCF'                         ER_LP:
  1FCF'   0E 14                 	MVI	C,14H
  1FD1'   CD 1E36'              	CALL	TFDOS		; the next record
  1FD4'   B7                    	ORA	A
  1FD5'   C2 2008'              	JNZ	ER_END
  1FD8'   21 0080               	LXI	H,CMDTAIL
  1FDB'   0E 00                 	MVI	C,0
  1FDD'                         ER_SC:				; C = its bytes, up to a ^Z
  1FDD'   7E                    	MOV	A,M
  1FDE'   FE 1A                 	CPI	CPMEOF
  1FE0'   CA 1FE8'              	JZ	ER_GOT
  1FE3'   23                    	INX	H
  1FE4'   0C                    	INR	C
  1FE5'   F2 1FDD'              	JP	ER_SC		; (minus: all 128)
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FE8'                         ER_GOT:
  1FE8'   79                    	MOV	A,C
  1FE9'   B7                    	ORA	A
  1FEA'   CA 2008'              	JZ	ER_END
  1FED'   C5                    	PUSH	B
  1FEE'   3A 2ADB'              	LDA	RDANY
  1FF1'   B7                    	ORA	A
  1FF2'   CC 2039'              	CZ	ER_1ST
  1FF5'   C1                    	POP	B
  1FF6'   06 00                 	MVI	B,0
  1FF8'   11 0080               	LXI	D,CMDTAIL
  1FFB'   C5                    	PUSH	B
  1FFC'   CD 0000*              	CALL	INSBLK
  1FFF'   C1                    	POP	B
  2000'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2003'   79                    	MOV	A,C
  2004'   17                    	RAL
  2005'   DA 1FCF'              	JC	ER_LP		; a full record: there may be more
  2008'                         ER_END:
  2008'   3A 2ADB'              	LDA	RDANY
  200B'   B7                    	ORA	A
  200C'   CA 202A'              	JZ	ER_PL		; nothing in the file: nothing has changed
  200F'   CD 0A1B'              	CALL	ATEOF
  2012'   DA 201F'              	JC	ER_MD		; the text now ends as the file read ends
  2015'   2A 0000*              	LHLD	GAPBEG
  2018'   2B                    	DCX	H
  2019'   7E                    	MOV	A,M
  201A'   FE 0A                 	CPI	LF
  201C'   C4 1E86'              	CNZ	PUTBRK		; text follows: what was read ends a line
  201F'                         ER_MD:
  201F'   3E 01                 	MVI	A,1
  2021'   32 2A1A'              	STA	MODF
  2024'   CD 03CD'              	CALL	MKPAGE		; back to the first line read
  2027'   CD 0000*              	CALL	GOTO
  202A'                         ER_PL:
  202A'   CD 0A1B'              	CALL	ATEOF
  202D'   DC 0A21'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2030'   CD 0000*              	CALL	CLRCNT
  2033'   CD 0F8B'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2036'   C3 0779'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2039'                         ER_1ST:
  2039'   3C                    	INR	A
  203A'   32 2ADB'              	STA	RDANY
  203D'   3A 2ADC'              	LDA	RDBRK
  2040'   B7                    	ORA	A
  2041'   C4 1E86'              	CNZ	PUTBRK
  2044'   21 2AAE'              	LXI	H,MKPOS
  2047'   C3 044D'              	JMP	FPSTO
  204A'                         ER_NOF:
  204A'   21 2430'              	LXI	H,SNOPN
  204D'   C3 22BF'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2050'                         WRCHK:
  2050'   3A 2A72'              	LDA	EXARG
  2053'   B7                    	ORA	A
  2054'   C2 205E'              	JNZ	WC_ARG
  2057'   CD 20C1'              	CALL	OWNTF
  205A'   D8                    	RC
  205B'   C3 2073'              	JMP	WC_OWN
  205E'                         WC_ARG:
  205E'   CD 20D7'              	CALL	ISOWN
  2061'   CA 2073'              	JZ	WC_OWN
  2064'   3A 2A84'              	LDA	EXBANG
  2067'   B7                    	ORA	A
  2068'   CA 2071'              	JZ	WC_OTH
  206B'   CD 0000*              	CALL	TEXIST
  206E'   C2 2298'              	JNZ	MSGEXI		; File exists (! to force)
  2071'                         WC_OTH:
  2071'   AF                    	XRA	A		; (NC)
  2072'   C9                    	RET
  2073'                         WC_OWN:
  2073'   3A 2A85'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2076'   B7                    	ORA	A
  2077'   CA 2081'              	JZ	WC_OK
  207A'   3A 2A84'              	LDA	EXBANG
  207D'   B7                    	ORA	A
  207E'   C2 229E'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2081'                         WC_OK:
  2081'   3E 01                 	MVI	A,1
  2083'   B7                    	ORA	A		; (NC)
  2084'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2085'                         WRITE:
  2085'   3A 2A73'              	LDA	EXBAK
  2088'   CD 0000*              	CALL	WRTO
  208B'   3A 0001*              	LDA	FNAME+1
  208E'   FE 20                 	CPI	' '
  2090'   C2 209C'              	JNZ	WR_HAS
  2093'   21 0000*              	LXI	H,TFCB
  2096'   11 0000*              	LXI	D,FNAME
  2099'   CD 20E9'              	CALL	COPY12
  209C'                         WR_HAS:
  209C'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  209E'   32 2A82'              	STA	MSGWHT
  20A1'   CD 20D7'              	CALL	ISOWN
  20A4'   C2 20AE'              	JNZ	SRCTF
  20A7'   AF                    	XRA	A
  20A8'   32 2A1A'              	STA	MODF
  20AB'   32 2A83'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  20AE'                         SRCTF:
  20AE'   21 0000*              	LXI	H,TFCB
  20B1'   11 005C               	LXI	D,DFTFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20B4'   CD 20E9'              	CALL	COPY12
  20B7'   AF                    	XRA	A
  20B8'   06 04                 	MVI	B,4
  20BA'                         SRC_Z:
  20BA'   12                    	STAX	D		; extent, s1, s2, record count: 0
  20BB'   13                    	INX	D
  20BC'   05                    	DCR	B
  20BD'   C2 20BA'              	JNZ	SRC_Z
  20C0'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  20C1'                         OWNTF:
  20C1'   3A 0001*              	LDA	FNAME+1
  20C4'   FE 20                 	CPI	' '
  20C6'   CA 2292'              	JZ	MSGNFN
  20C9'   CD 20F4'              	CALL	TFCLR
  20CC'   21 0000*              	LXI	H,FNAME
  20CF'   11 0000*              	LXI	D,TFCB
  20D2'   CD 20E9'              	CALL	COPY12
  20D5'   B7                    	ORA	A		; (NC)
  20D6'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  20D7'                         ISOWN:
  20D7'   21 0000*              	LXI	H,TFCB
  20DA'   11 0000*              	LXI	D,FNAME
  20DD'   06 0C                 	MVI	B,12
  20DF'                         IO_LP:
  20DF'   1A                    	LDAX	D
  20E0'   BE                    	CMP	M
  20E1'   C0                    	RNZ
  20E2'   23                    	INX	H
  20E3'   13                    	INX	D
  20E4'   05                    	DCR	B
  20E5'   C2 20DF'              	JNZ	IO_LP
  20E8'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20E9'                         COPY12:
  20E9'   06 0C                 	MVI	B,12
  20EB'                         CP_LP:
  20EB'   7E                    	MOV	A,M
  20EC'   12                    	STAX	D
  20ED'   23                    	INX	H
  20EE'   13                    	INX	D
  20EF'   05                    	DCR	B
  20F0'   C2 20EB'              	JNZ	CP_LP
  20F3'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20F4'                         TFCLR:
  20F4'   11 0000*              	LXI	D,TFCB
  20F7'   06 24                 	MVI	B,36
  20F9'   AF                    	XRA	A
  20FA'                         TC_LP:
  20FA'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  20FB'   13                    	INX	D
  20FC'   05                    	DCR	B
  20FD'   C2 20FA'              	JNZ	TC_LP
  2100'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2101'                         FOPEN:
  2101'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2103'   32 2A82'              	STA	MSGWHT
  2106'   21 005C               	LXI	H,DFTFCB
  2109'   CD 21DB'              	CALL	NRMDRV
  210C'   11 0000*              	LXI	D,FNAME
  210F'   CD 20E9'              	CALL	COPY12
  2112'   CD 0000*              	CALL	OPENZ
  2115'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2118'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  211A'   C8                    	RZ
  211B'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  211E'   32 2A83'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2121'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2122'                         ARGSCN:
  2122'   3A 0080               	LDA	CMDTAIL
  2125'   47                    	MOV	B,A		; B = what is left of the line
  2126'   B7                    	ORA	A
  2127'   C8                    	RZ
  2128'   21 0081               	LXI	H,CMDTAIL+1
  212B'                         AS_TOK:				; at a token, or the blanks before one
  212B'   7E                    	MOV	A,M
  212C'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  212E'   C2 2137'              	JNZ	AS_OPT
  2131'   23                    	INX	H
  2132'   05                    	DCR	B
  2133'   C2 212B'              	JNZ	AS_TOK
  2136'   C9                    	RET
  2137'                         AS_OPT:
  2137'   FE 2B                 	CPI	'+'
  2139'   CA 2163'              	JZ	AS_PLS
  213C'   FE 2D                 	CPI	'-'
  213E'   CA 2152'              	JZ	AS_SW
  2141'   FE 2F                 	CPI	'/'
  2143'   CA 2152'              	JZ	AS_SW
  2146'                         AS_SKP:				; not ours (the file name): on to the next one
  2146'   23                    	INX	H
  2147'   05                    	DCR	B
  2148'   C8                    	RZ
  2149'   7E                    	MOV	A,M
  214A'   FE 20                 	CPI	' '
  214C'   C2 2146'              	JNZ	AS_SKP
  214F'   C3 212B'              	JMP	AS_TOK
  2152'                         AS_SW:
  2152'   23                    	INX	H
  2153'   05                    	DCR	B
  2154'   C8                    	RZ
  2155'   7E                    	MOV	A,M
  2156'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2158'   FE 52                 	CPI	'R'
  215A'   C2 2146'              	JNZ	AS_SKP
  215D'   32 2A85'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2160'   C3 2146'              	JMP	AS_SKP
  2163'                         AS_PLS:
  2163'   3E 01                 	MVI	A,1
  2165'   32 2A86'              	STA	PLUSF		; '+' gets the line even with no number on it
  2168'   11 0000*              	LXI	D,PLUSB
  216B'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  216D'   23                    	INX	H		;   line space, so it is taken as '+' alone
  216E'   05                    	DCR	B
  216F'   CA 21A6'              	JZ	AS_PE
  2172'   7E                    	MOV	A,M
  2173'   FE 30                 	CPI	'0'
  2175'   C2 218D'              	JNZ	AS_PD
  2178'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2178'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2179'   05                    	DCR	B
  217A'   CA 21AE'              	JZ	AS_P1
  217D'   7E                    	MOV	A,M
  217E'   FE 30                 	CPI	'0'
  2180'   CA 2178'              	JZ	AS_PZ
  2183'   FE 31                 	CPI	'1'
  2185'   DA 21AE'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2188'   FE 3A                 	CPI	'9'+1
  218A'   D2 21AE'              	JNC	AS_P1
  218D'                         AS_PD:				; the digits, as typed
  218D'   7E                    	MOV	A,M
  218E'   FE 30                 	CPI	'0'
  2190'   DA 21A6'              	JC	AS_PE
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2193'   FE 3A                 	CPI	'9'+1
  2195'   D2 21A6'              	JNC	AS_PE
  2198'   79                    	MOV	A,C
  2199'   B7                    	ORA	A
  219A'   CA 21B5'              	JZ	AS_POV
  219D'   0D                    	DCR	C
  219E'   7E                    	MOV	A,M
  219F'   12                    	STAX	D
  21A0'   13                    	INX	D
  21A1'   23                    	INX	H
  21A2'   05                    	DCR	B
  21A3'   C2 218D'              	JNZ	AS_PD
  21A6'                         AS_PE:
  21A6'   AF                    	XRA	A
  21A7'   12                    	STAX	D		; the digits end with a 0
  21A8'   78                    	MOV	A,B
  21A9'   B7                    	ORA	A
  21AA'   C8                    	RZ
  21AB'   C3 212B'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  21AE'                         AS_P1:
  21AE'   3E 31                 	MVI	A,'1'
  21B0'   12                    	STAX	D
  21B1'   13                    	INX	D
  21B2'   C3 21A6'              	JMP	AS_PE
  21B5'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  21B5'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  21B8'   C3 21A6'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  21BB'                         ARGGO:
  21BB'   3A 2A86'              	LDA	PLUSF
  21BE'   B7                    	ORA	A
  21BF'   C8                    	RZ
  21C0'   21 0000*              	LXI	H,PLUSB
  21C3'                         AG_LP:
  21C3'   7E                    	MOV	A,M
  21C4'   B7                    	ORA	A
  21C5'   CA 21D4'              	JZ	AG_G
  21C8'   4F                    	MOV	C,A
  21C9'   06 02                 	MVI	B,KT_CHAR
  21CB'   E5                    	PUSH	H
  21CC'   CD 0023'              	CALL	VICMD
  21CF'   E1                    	POP	H
  21D0'   23                    	INX	H
  21D1'   C3 21C3'              	JMP	AG_LP
  21D4'                         AG_G:
  21D4'   0E 47                 	MVI	C,'G'
  21D6'   06 02                 	MVI	B,KT_CHAR
  21D8'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                ; names compare byte for byte.  Keeps HL.
  21DB'                         NRMDRV:
  21DB'   7E                    	MOV	A,M
  21DC'   B7                    	ORA	A
  21DD'   C0                    	RNZ
  21DE'   E5                    	PUSH	H
  21DF'   0E 19                 	MVI	C,BF_CURDSK
  21E1'   CD 0005               	CALL	BDOS
  21E4'   E1                    	POP	H
  21E5'   3C                    	INR	A
  21E6'   77                    	MOV	M,A
  21E7'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21E8'                         PARSFN:
  21E8'   CD 20F4'              	CALL	TFCLR
  21EB'   11 0000*              	LXI	D,TFCB
  21EE'   23                    	INX	H
  21EF'   7E                    	MOV	A,M
  21F0'   2B                    	DCX	H
  21F1'   FE 3A                 	CPI	':'
  21F3'   C2 2205'              	JNZ	PF_NM
  21F6'   CD 224B'              	CALL	GETFNC
  21F9'   CA 2205'              	JZ	PF_NM
  21FC'   D6 40                 	SUI	40H
  21FE'   12                    	STAX	D
  21FF'   FE 11                 	CPI	17
  2201'   D2 2229'              	JNC	PF_BAD
  2204'   23                    	INX	H
  2205'                         PF_NM:
  2205'   13                    	INX	D
  2206'   0E 08                 	MVI	C,8
  2208'   CD 222D'              	CALL	CPYNAM
  220B'   FE 2E                 	CPI	'.'
  220D'   0E 03                 	MVI	C,3
  220F'   C4 2240'              	CNZ	PADFLD		; no type: blanks
  2212'   CC 222C'              	CZ	CPYNM0		; '.': the type
  2215'   3A 0001*              	LDA	TFCB+1
  2218'   FE 20                 	CPI	' '
  221A'   CA 2229'              	JZ	PF_BAD		; no name
  221D'   CD 227E'              	CALL	SKIPB
  2220'   C0                    	RNZ			; more after it
  2221'   21 0000*              	LXI	H,TFCB
  2224'   CD 21DB'              	CALL	NRMDRV
  2227'   AF                    	XRA	A
  2228'   C9                    	RET
  2229'                         PF_BAD:
  2229'   F6 01                 	ORI	1
  222B'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  222C'                         CPYNM0:
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  222C'   23                    	INX	H
  222D'                         CPYNAM:
  222D'   CD 224B'              	CALL	GETFNC
  2230'   CA 2240'              	JZ	PADFLD
  2233'   12                    	STAX	D
  2234'   13                    	INX	D
  2235'   0D                    	DCR	C
  2236'   C2 222D'              	JNZ	CPYNAM
  2239'                         CN_SKP:
  2239'   CD 224B'              	CALL	GETFNC
  223C'   C2 2239'              	JNZ	CN_SKP
  223F'   C9                    	RET
  2240'                         PADFLD:
  2240'   F5                    	PUSH	PSW
  2241'                         PD_LP:
  2241'   3E 20                 	MVI	A,' '
  2243'   12                    	STAX	D
  2244'   13                    	INX	D
  2245'   0D                    	DCR	C
  2246'   C2 2241'              	JNZ	PD_LP
  2249'   F1                    	POP	PSW
  224A'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  224B'                         GETFNC:
  224B'   7E                    	MOV	A,M
  224C'   FE 3D                 	CPI	'='
  224E'   C8                    	RZ
  224F'   FE 5F                 	CPI	'_'
  2251'   C8                    	RZ
  2252'   FE 3B                 	CPI	';'
  2254'   C8                    	RZ
  2255'   FE 3C                 	CPI	'<'
  2257'   C8                    	RZ
  2258'   FE 3E                 	CPI	'>'
  225A'   C8                    	RZ
  225B'   FE 2E                 	CPI	'.'
  225D'   C8                    	RZ
  225E'   FE 3A                 	CPI	':'
  2260'   C8                    	RZ
  2261'   FE 2A                 	CPI	'*'
  2263'   C8                    	RZ
  2264'   FE 3F                 	CPI	'?'
  2266'   C8                    	RZ
  2267'   FE 20                 	CPI	' '
  2269'   DA 227C'              	JC	GF_CTL
  226C'   C8                    	RZ
  226D'   23                    	INX	H
  226E'   FE 61                 	CPI	'a'
  2270'   DA 227A'              	JC	GF_DN
  2273'   FE 7B                 	CPI	'z'+1
  2275'   D2 227A'              	JNC	GF_DN
  2278'   E6 DF                 	ANI	0DFH
  227A'                         GF_DN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  227A'   B7                    	ORA	A
  227B'   C9                    	RET
  227C'                         GF_CTL:
  227C'   BF                    	CMP	A
  227D'   C9                    	RET
                                
