  18F4'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  18F7'   2A 238E'              	LHLD	WPREC
  18FA'   EB                    	XCHG
  18FB'   3A 238D'              	LDA	WPBYT
  18FE'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1901'   CD 0000*              	CALL	GOTO
  1904'   21 0000               	LXI	H,0
  1907'   22 0000*              	SHLD	LNDLT
  190A'   3A 238C'              	LDA	WPROW
  190D'   6F                    	MOV	L,A
  190E'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1911'   C9                    	RET
  1912'                         EX_WQ:
  1912'   CD 19B8'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1915'                         EX_Q:
  1915'   3A 239A'              	LDA	EXBANG
  1918'   B7                    	ORA	A
  1919'   CA 1923'              	JZ	EX_QT
  191C'   3A 2334'              	LDA	MODF
  191F'   B7                    	ORA	A
  1920'   C2 1BD7'              	JNZ	MSGNWR		; changed, no '!': stay
  1923'                         EX_QT:
  1923'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1926'   3E 01                 	MVI	A,1
  1928'   32 2333'              	STA	QUITF
  192B'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  192C'                         EX_E:
  192C'   3A 239A'              	LDA	EXBANG
  192F'   B7                    	ORA	A
  1930'   CA 193A'              	JZ	EE_GO
  1933'   3A 2334'              	LDA	MODF
  1936'   B7                    	ORA	A
  1937'   C2 1BD7'              	JNZ	MSGNWR
  193A'                         EE_GO:
  193A'   3A 2388'              	LDA	EXARG
  193D'   B7                    	ORA	A
  193E'   C2 1945'              	JNZ	EE_ARG
  1941'   CD 19F4'              	CALL	OWNTF		; no name: the buffer's own
  1944'   D8                    	RC
  1945'                         EE_ARG:
  1945'   CD 1A0A'              	CALL	ISOWN
  1948'   21 0001               	LXI	H,1
  194B'   C2 1952'              	JNZ	EE_LD		; another file: its first line
  194E'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1951'   23                    	INX	H		; HL = the cursor's line
  1952'                         EE_LD:
  1952'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1954'   32 2398'              	STA	MSGWHT
  1957'   E5                    	PUSH	H
  1958'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  195B'   21 0000*              	LXI	H,TFCB
  195E'   11 0000*              	LXI	D,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1961'   CD 1A1C'              	CALL	COPY12		; the buffer's name
  1964'   CD 19E1'              	CALL	SRCTF
  1967'   CD 0000*              	CALL	REOPEN
  196A'   CD 021C'              	CALL	MKCLR		; the marks named the buffer that just went
  196D'   AF                    	XRA	A
  196E'   32 2334'              	STA	MODF
  1971'   E1                    	POP	H
  1972'   2B                    	DCX	H
  1973'   AF                    	XRA	A
  1974'   CD 0000*              	CALL	MVLIND		; down to the line
  1977'   CD 07B1'              	CALL	ATEOF
  197A'   DC 07B7'              	CC	LASTLN		; past the last line: onto it
  197D'   CD 0CB8'              	CALL	ZSAVE
  1980'   C3 0DA1'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1983'                         WRCHK:
  1983'   3A 2388'              	LDA	EXARG
  1986'   B7                    	ORA	A
  1987'   C2 1991'              	JNZ	WC_ARG
  198A'   CD 19F4'              	CALL	OWNTF
  198D'   D8                    	RC
  198E'   C3 19A6'              	JMP	WC_OWN
  1991'                         WC_ARG:
  1991'   CD 1A0A'              	CALL	ISOWN
  1994'   CA 19A6'              	JZ	WC_OWN
  1997'   3A 239A'              	LDA	EXBANG
  199A'   B7                    	ORA	A
  199B'   CA 19A4'              	JZ	WC_OTH
  199E'   CD 0000*              	CALL	TEXIST
  19A1'   C2 1BCB'              	JNZ	MSGEXI		; File exists (! to force)
  19A4'                         WC_OTH:
  19A4'   AF                    	XRA	A		; (NC)
  19A5'   C9                    	RET
  19A6'                         WC_OWN:
  19A6'   3A 239B'              	LDA	ROFLAG		; '-R': this is the file it may not write
  19A9'   B7                    	ORA	A
  19AA'   CA 19B4'              	JZ	WC_OK
  19AD'   3A 239A'              	LDA	EXBANG
  19B0'   B7                    	ORA	A
  19B1'   C2 1BD1'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  19B4'                         WC_OK:
  19B4'   3E 01                 	MVI	A,1
  19B6'   B7                    	ORA	A		; (NC)
  19B7'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  19B8'                         WRITE:
  19B8'   3A 2389'              	LDA	EXBAK
  19BB'   CD 0000*              	CALL	WRTO
  19BE'   3A 0001*              	LDA	FNAME+1
  19C1'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  19C3'   C2 19CF'              	JNZ	WR_HAS
  19C6'   21 0000*              	LXI	H,TFCB
  19C9'   11 0000*              	LXI	D,FNAME
  19CC'   CD 1A1C'              	CALL	COPY12
  19CF'                         WR_HAS:
  19CF'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  19D1'   32 2398'              	STA	MSGWHT
  19D4'   CD 1A0A'              	CALL	ISOWN
  19D7'   C2 19E1'              	JNZ	SRCTF
  19DA'   AF                    	XRA	A
  19DB'   32 2334'              	STA	MODF
  19DE'   32 2399'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  19E1'                         SRCTF:
  19E1'   21 0000*              	LXI	H,TFCB
  19E4'   11 005C               	LXI	D,DFTFCB
  19E7'   CD 1A1C'              	CALL	COPY12
  19EA'   AF                    	XRA	A
  19EB'   06 04                 	MVI	B,4
  19ED'                         SRC_Z:
  19ED'   12                    	STAX	D		; extent, s1, s2, record count: 0
  19EE'   13                    	INX	D
  19EF'   05                    	DCR	B
  19F0'   C2 19ED'              	JNZ	SRC_Z
  19F3'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  19F4'                         OWNTF:
  19F4'   3A 0001*              	LDA	FNAME+1
  19F7'   FE 20                 	CPI	' '
  19F9'   CA 1BC5'              	JZ	MSGNFN
  19FC'   CD 1A27'              	CALL	TFCLR
  19FF'   21 0000*              	LXI	H,FNAME
  1A02'   11 0000*              	LXI	D,TFCB
  1A05'   CD 1A1C'              	CALL	COPY12
  1A08'   B7                    	ORA	A		; (NC)
  1A09'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1A0A'                         ISOWN:
  1A0A'   21 0000*              	LXI	H,TFCB
  1A0D'   11 0000*              	LXI	D,FNAME
  1A10'   06 0C                 	MVI	B,12
  1A12'                         IO_LP:
  1A12'   1A                    	LDAX	D
  1A13'   BE                    	CMP	M
  1A14'   C0                    	RNZ
  1A15'   23                    	INX	H
  1A16'   13                    	INX	D
  1A17'   05                    	DCR	B
  1A18'   C2 1A12'              	JNZ	IO_LP
  1A1B'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1A1C'                         COPY12:
  1A1C'   06 0C                 	MVI	B,12
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1A1E'                         CP_LP:
  1A1E'   7E                    	MOV	A,M
  1A1F'   12                    	STAX	D
  1A20'   23                    	INX	H
  1A21'   13                    	INX	D
  1A22'   05                    	DCR	B
  1A23'   C2 1A1E'              	JNZ	CP_LP
  1A26'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1A27'                         TFCLR:
  1A27'   11 0000*              	LXI	D,TFCB
  1A2A'   06 24                 	MVI	B,36
  1A2C'   AF                    	XRA	A
  1A2D'                         TC_LP:
  1A2D'   12                    	STAX	D
  1A2E'   13                    	INX	D
  1A2F'   05                    	DCR	B
  1A30'   C2 1A2D'              	JNZ	TC_LP
  1A33'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1A34'                         FOPEN:
  1A34'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1A36'   32 2398'              	STA	MSGWHT
  1A39'   21 005C               	LXI	H,DFTFCB
  1A3C'   CD 1B0E'              	CALL	NRMDRV
  1A3F'   11 0000*              	LXI	D,FNAME
  1A42'   CD 1A1C'              	CALL	COPY12
  1A45'   CD 0000*              	CALL	OPENZ
  1A48'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1A4B'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1A4D'   C8                    	RZ
  1A4E'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1A51'   32 2399'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1A54'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1A55'                         ARGSCN:
  1A55'   3A 0080               	LDA	CMDTAIL
  1A58'   47                    	MOV	B,A		; B = what is left of the line
  1A59'   B7                    	ORA	A
  1A5A'   C8                    	RZ
  1A5B'   21 0081               	LXI	H,CMDTAIL+1
  1A5E'                         AS_TOK:				; at a token, or the blanks before one
  1A5E'   7E                    	MOV	A,M
  1A5F'   FE 20                 	CPI	' '
  1A61'   C2 1A6A'              	JNZ	AS_OPT
  1A64'   23                    	INX	H
  1A65'   05                    	DCR	B
  1A66'   C2 1A5E'              	JNZ	AS_TOK
  1A69'   C9                    	RET
  1A6A'                         AS_OPT:
  1A6A'   FE 2B                 	CPI	'+'
  1A6C'   CA 1A96'              	JZ	AS_PLS
  1A6F'   FE 2D                 	CPI	'-'
  1A71'   CA 1A85'              	JZ	AS_SW
  1A74'   FE 2F                 	CPI	'/'
  1A76'   CA 1A85'              	JZ	AS_SW
  1A79'                         AS_SKP:				; not ours (the file name): on to the next one
  1A79'   23                    	INX	H
  1A7A'   05                    	DCR	B
  1A7B'   C8                    	RZ
  1A7C'   7E                    	MOV	A,M
  1A7D'   FE 20                 	CPI	' '
  1A7F'   C2 1A79'              	JNZ	AS_SKP
  1A82'   C3 1A5E'              	JMP	AS_TOK
  1A85'                         AS_SW:
  1A85'   23                    	INX	H
  1A86'   05                    	DCR	B
  1A87'   C8                    	RZ
  1A88'   7E                    	MOV	A,M
  1A89'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1A8B'   FE 52                 	CPI	'R'
  1A8D'   C2 1A79'              	JNZ	AS_SKP
  1A90'   32 239B'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1A93'   C3 1A79'              	JMP	AS_SKP
  1A96'                         AS_PLS:
  1A96'   3E 01                 	MVI	A,1
  1A98'   32 239C'              	STA	PLUSF		; '+' gets the line even with no number on it
  1A9B'   11 0000*              	LXI	D,PLUSB
  1A9E'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1AA0'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1AA1'   05                    	DCR	B
  1AA2'   CA 1AD9'              	JZ	AS_PE
  1AA5'   7E                    	MOV	A,M
  1AA6'   FE 30                 	CPI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1AA8'   C2 1AC0'              	JNZ	AS_PD
  1AAB'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1AAB'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1AAC'   05                    	DCR	B
  1AAD'   CA 1AE1'              	JZ	AS_P1
  1AB0'   7E                    	MOV	A,M
  1AB1'   FE 30                 	CPI	'0'
  1AB3'   CA 1AAB'              	JZ	AS_PZ
  1AB6'   FE 31                 	CPI	'1'
  1AB8'   DA 1AE1'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1ABB'   FE 3A                 	CPI	'9'+1
  1ABD'   D2 1AE1'              	JNC	AS_P1
  1AC0'                         AS_PD:				; the digits, as typed
  1AC0'   7E                    	MOV	A,M
  1AC1'   FE 30                 	CPI	'0'
  1AC3'   DA 1AD9'              	JC	AS_PE
  1AC6'   FE 3A                 	CPI	'9'+1
  1AC8'   D2 1AD9'              	JNC	AS_PE
  1ACB'   79                    	MOV	A,C
  1ACC'   B7                    	ORA	A
  1ACD'   CA 1AE8'              	JZ	AS_POV
  1AD0'   0D                    	DCR	C
  1AD1'   7E                    	MOV	A,M
  1AD2'   12                    	STAX	D
  1AD3'   13                    	INX	D
  1AD4'   23                    	INX	H
  1AD5'   05                    	DCR	B
  1AD6'   C2 1AC0'              	JNZ	AS_PD
  1AD9'                         AS_PE:
  1AD9'   AF                    	XRA	A
  1ADA'   12                    	STAX	D		; the digits end with a 0
  1ADB'   78                    	MOV	A,B
  1ADC'   B7                    	ORA	A
  1ADD'   C8                    	RZ
  1ADE'   C3 1A5E'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1AE1'                         AS_P1:
  1AE1'   3E 31                 	MVI	A,'1'
  1AE3'   12                    	STAX	D
  1AE4'   13                    	INX	D
  1AE5'   C3 1AD9'              	JMP	AS_PE
  1AE8'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1AE8'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1AEB'   C3 1AD9'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1AEE'                         ARGGO:
  1AEE'   3A 239C'              	LDA	PLUSF
  1AF1'   B7                    	ORA	A
  1AF2'   C8                    	RZ
  1AF3'   21 0000*              	LXI	H,PLUSB
  1AF6'                         AG_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AF6'   7E                    	MOV	A,M
  1AF7'   B7                    	ORA	A
  1AF8'   CA 1B07'              	JZ	AG_G
  1AFB'   4F                    	MOV	C,A
  1AFC'   06 02                 	MVI	B,KT_CHAR
  1AFE'   E5                    	PUSH	H
  1AFF'   CD 002D'              	CALL	VICMD
  1B02'   E1                    	POP	H
  1B03'   23                    	INX	H
  1B04'   C3 1AF6'              	JMP	AG_LP
  1B07'                         AG_G:
  1B07'   0E 47                 	MVI	C,'G'
  1B09'   06 02                 	MVI	B,KT_CHAR
  1B0B'   C3 002D'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1B0E'                         NRMDRV:
  1B0E'   7E                    	MOV	A,M
  1B0F'   B7                    	ORA	A
  1B10'   C0                    	RNZ
  1B11'   E5                    	PUSH	H
  1B12'   0E 19                 	MVI	C,BF_CURDSK
  1B14'   CD 0005               	CALL	BDOS
  1B17'   E1                    	POP	H
  1B18'   3C                    	INR	A
  1B19'   77                    	MOV	M,A
  1B1A'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1B1B'                         PARSFN:
  1B1B'   CD 1A27'              	CALL	TFCLR
  1B1E'   11 0000*              	LXI	D,TFCB
  1B21'   23                    	INX	H
  1B22'   7E                    	MOV	A,M
  1B23'   2B                    	DCX	H
  1B24'   FE 3A                 	CPI	':'
  1B26'   C2 1B38'              	JNZ	PF_NM
  1B29'   CD 1B7E'              	CALL	GETFNC
  1B2C'   CA 1B38'              	JZ	PF_NM
  1B2F'   D6 40                 	SUI	40H
  1B31'   12                    	STAX	D
  1B32'   FE 11                 	CPI	17
  1B34'   D2 1B5C'              	JNC	PF_BAD
  1B37'   23                    	INX	H
  1B38'                         PF_NM:
  1B38'   13                    	INX	D
  1B39'   0E 08                 	MVI	C,8
  1B3B'   CD 1B60'              	CALL	CPYNAM
  1B3E'   FE 2E                 	CPI	'.'
  1B40'   0E 03                 	MVI	C,3
  1B42'   C4 1B73'              	CNZ	PADFLD		; no type: blanks
  1B45'   CC 1B5F'              	CZ	CPYNM0		; '.': the type
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B48'   3A 0001*              	LDA	TFCB+1
  1B4B'   FE 20                 	CPI	' '
  1B4D'   CA 1B5C'              	JZ	PF_BAD		; no name
  1B50'   CD 1BB1'              	CALL	SKIPB
  1B53'   C0                    	RNZ			; more after it
  1B54'   21 0000*              	LXI	H,TFCB
  1B57'   CD 1B0E'              	CALL	NRMDRV
  1B5A'   AF                    	XRA	A
  1B5B'   C9                    	RET
  1B5C'                         PF_BAD:
  1B5C'   F6 01                 	ORI	1
  1B5E'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1B5F'                         CPYNM0:
  1B5F'   23                    	INX	H
  1B60'                         CPYNAM:
  1B60'   CD 1B7E'              	CALL	GETFNC
  1B63'   CA 1B73'              	JZ	PADFLD
  1B66'   12                    	STAX	D
  1B67'   13                    	INX	D
  1B68'   0D                    	DCR	C
  1B69'   C2 1B60'              	JNZ	CPYNAM
  1B6C'                         CN_SKP:
  1B6C'   CD 1B7E'              	CALL	GETFNC
  1B6F'   C2 1B6C'              	JNZ	CN_SKP
  1B72'   C9                    	RET
  1B73'                         PADFLD:
  1B73'   F5                    	PUSH	PSW
  1B74'                         PD_LP:
  1B74'   3E 20                 	MVI	A,' '
  1B76'   12                    	STAX	D
  1B77'   13                    	INX	D
  1B78'   0D                    	DCR	C
  1B79'   C2 1B74'              	JNZ	PD_LP
  1B7C'   F1                    	POP	PSW
  1B7D'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1B7E'                         GETFNC:
  1B7E'   7E                    	MOV	A,M
  1B7F'   FE 3D                 	CPI	'='
  1B81'   C8                    	RZ
  1B82'   FE 5F                 	CPI	'_'
  1B84'   C8                    	RZ
  1B85'   FE 3B                 	CPI	';'
  1B87'   C8                    	RZ
  1B88'   FE 3C                 	CPI	'<'
  1B8A'   C8                    	RZ
  1B8B'   FE 3E                 	CPI	'>'
  1B8D'   C8                    	RZ
  1B8E'   FE 2E                 	CPI	'.'
  1B90'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B91'   FE 3A                 	CPI	':'
  1B93'   C8                    	RZ
  1B94'   FE 2A                 	CPI	'*'
  1B96'   C8                    	RZ
  1B97'   FE 3F                 	CPI	'?'
  1B99'   C8                    	RZ
  1B9A'   FE 20                 	CPI	' '
  1B9C'   DA 1BAF'              	JC	GF_CTL
  1B9F'   C8                    	RZ
  1BA0'   23                    	INX	H
  1BA1'   FE 61                 	CPI	'a'
  1BA3'   DA 1BAD'              	JC	GF_DN
  1BA6'   FE 7B                 	CPI	'z'+1
  1BA8'   D2 1BAD'              	JNC	GF_DN
  1BAB'   E6 DF                 	ANI	0DFH
  1BAD'                         GF_DN:
  1BAD'   B7                    	ORA	A
  1BAE'   C9                    	RET
  1BAF'                         GF_CTL:
  1BAF'   BF                    	CMP	A
  1BB0'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1BB1'                         SKIPB:
  1BB1'   7E                    	MOV	A,M
  1BB2'   FE 20                 	CPI	' '
  1BB4'   C2 1BBB'              	JNZ	SB_DN
  1BB7'   23                    	INX	H
  1BB8'   C3 1BB1'              	JMP	SKIPB
  1BBB'                         SB_DN:
  1BBB'   B7                    	ORA	A
  1BBC'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1BBD'                         ISLOW:
  1BBD'   7E                    	MOV	A,M
  1BBE'   FE 61                 	CPI	'a'
  1BC0'   D8                    	RC
  1BC1'   FE 7B                 	CPI	'z'+1
  1BC3'   3F                    	CMC
  1BC4'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1BC5'                         MSGNFN:
  1BC5'   21 1C12'              	LXI	H,SNFN
  1BC8'   C3 1BFD'              	JMP	EXERR
  1BCB'                         MSGEXI:
  1BCB'   21 1C2C'              	LXI	H,SEXI
  1BCE'   C3 1BDA'              	JMP	EXBNG
  1BD1'                         MSGRO:
  1BD1'   21 1C38'              	LXI	H,SRO
  1BD4'   C3 1BDA'              	JMP	EXBNG
  1BD7'                         MSGNWR:
  1BD7'   21 1C1F'              	LXI	H,SNWR
  1BDA'                         EXBNG:
  1BDA'   CD 1BFD'              	CALL	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BDD'   21 1C44'              	LXI	H,SBNG
  1BE0'   C3 1BF8'              	JMP	EXOUT
  1BE3'                         EX_INV:
  1BE3'   21 1C52'              	LXI	H,SINV
  1BE6'   C3 1BFD'              	JMP	EXERR
  1BE9'                         EX_V:				; :ve -- the version, on the bottom row
  1BE9'   21 1C0D'              	LXI	H,SVER
  1BEC'   C3 1BFD'              	JMP	EXERR
  1BEF'                         EX_TRL:
  1BEF'   21 1C64'              	LXI	H,STRL
  1BF2'                         EXERT:				; the message, then the text at EXCMD
  1BF2'   CD 1BFD'              	CALL	EXERR
  1BF5'   2A 238A'              	LHLD	EXCMD
  1BF8'                         EXOUT:
  1BF8'   CD 0000*              	CALL	OUTSTR
  1BFB'   37                    	STC
  1BFC'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1BFD'                         EXERR:
  1BFD'   E5                    	PUSH	H
  1BFE'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1BFF'   32 2398'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1C02'   E1                    	POP	H
  1C03'   CD 0000*              	CALL	EXMSG
  1C06'   3E 01                 	MVI	A,R_MOVE
  1C08'   32 2335'              	STA	RINTENT
  1C0B'   37                    	STC
  1C0C'   C9                    	RET
                                
  1C0D'   56 31 2E 30           SVER:	DB	'V1.0',0
  1C11'   00                    
  1C12'   4E 6F 20 66           SNFN:	DB	'No file name',0
  1C16'   69 6C 65 20           
  1C1A'   6E 61 6D 65           
  1C1E'   00                    
  1C1F'   46 69 6C 65           SNWR:	DB	'File changed',0
  1C23'   20 63 68 61           
  1C27'   6E 67 65 64           
  1C2B'   00                    
  1C2C'   46 69 6C 65           SEXI:	DB	'File exists',0
  1C30'   20 65 78 69           
  1C34'   73 74 73 00           
  1C38'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  1C3C'   20 69 73 20           
  1C40'   73 65 74 00           
  1C44'   20 28 21 20           SBNG:	DB	' (! to force)',0
  1C48'   74 6F 20 66           
  1C4C'   6F 72 63 65           
  1C50'   29 00                 
  1C52'   49 6E 76 61           SINV:	DB	'Invalid file name',0
  1C56'   6C 69 64 20           
  1C5A'   66 69 6C 65           
  1C5E'   20 6E 61 6D           
  1C62'   65 00                 
  1C64'   54 72 61 69           STRL:	DB	'Trailing chars: ',0
