                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                                ; DE mid-number and skipping there costs more than the position is worth.
  20E1'                         EXADDR:
  20E1'   AF                    	XRA	A
  20E2'   32 2751'              	STA	SRNGF
  20E5'   7E                    	MOV	A,M
  20E6'   FE 25                 	CPI	'%'
  20E8'   CA 2111'              	JZ	EXA_AL
  20EB'   EB                    	XCHG			; DE walks the line, HL takes the number
  20EC'   CD 2126'              	CALL	EXNUM
  20EF'   DA 210F'              	JC	EXA_NO
  20F2'   22 2752'              	SHLD	SRNG1
  20F5'   22 2754'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  20F8'   1A                    	LDAX	D
  20F9'   FE 2C                 	CPI	','
  20FB'   C2 2108'              	JNZ	EXA_YS
  20FE'   13                    	INX	D
  20FF'   CD 2126'              	CALL	EXNUM
  2102'   DA 210F'              	JC	EXA_NO		; ',' with no number: not a range at all
  2105'   22 2754'              	SHLD	SRNG2
  2108'                         EXA_YS:
  2108'   EB                    	XCHG
  2109'   3E 01                 	MVI	A,1
  210B'   32 2751'              	STA	SRNGF
  210E'   C9                    	RET
  210F'                         EXA_NO:
  210F'   EB                    	XCHG
  2110'   C9                    	RET
  2111'                         EXA_AL:
  2111'   23                    	INX	H
  2112'   E5                    	PUSH	H
  2113'   21 0001               	LXI	H,1
  2116'   22 2752'              	SHLD	SRNG1
  2119'   21 FFFF               	LXI	H,0FFFFH
  211C'   22 2754'              	SHLD	SRNG2
  211F'   E1                    	POP	H
  2120'   3E 01                 	MVI	A,1
  2122'   32 2751'              	STA	SRNGF
  2125'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2126'                         EXNUM:
  2126'   1A                    	LDAX	D
  2127'   D6 30                 	SUI	'0'
  2129'   D8                    	RC
  212A'   FE 0A                 	CPI	10
  212C'   3F                    	CMC
  212D'   D8                    	RC
  212E'   21 0000               	LXI	H,0
  2131'                         EXN_LP:
  2131'   1A                    	LDAX	D
  2132'   D6 30                 	SUI	'0'
  2134'   DA 214E'              	JC	EXN_DN
  2137'   FE 0A                 	CPI	10
  2139'   D2 214E'              	JNC	EXN_DN
  213C'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  213D'   C5                    	PUSH	B
  213E'   4F                    	MOV	C,A
  213F'   06 00                 	MVI	B,0		; BC = the digit
  2141'   D5                    	PUSH	D
  2142'   54                    	MOV	D,H
  2143'   5D                    	MOV	E,L
  2144'   29                    	DAD	H		; *2
  2145'   29                    	DAD	H		; *4
  2146'   19                    	DAD	D		; *5
  2147'   29                    	DAD	H		; *10
  2148'   D1                    	POP	D
  2149'   09                    	DAD	B
  214A'   C1                    	POP	B
  214B'   C3 2131'              	JMP	EXN_LP
  214E'                         EXN_DN:
  214E'   B7                    	ORA	A		; CY clear: there was a number
  214F'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2150'                         EX_S:
  2150'   7E                    	MOV	A,M
  2151'   B7                    	ORA	A
  2152'   CA 2194'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2155'   32 2756'              	STA	SDELIM
  2158'   23                    	INX	H
  2159'   11 0000*              	LXI	D,SRCHST
  215C'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  215F'   4F                    	MOV	C,A
  2160'   CD 219A'              	CALL	SCOPY
  2163'   78                    	MOV	A,B
  2164'   B7                    	ORA	A
  2165'   CA 2194'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2168'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  216B'   3E 01                 	MVI	A,1
  216D'   32 2721'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2170'   11 2763'              	LXI	D,SREPL
  2173'   0E 24                 	MVI	C,SREPMX
  2175'   CD 219A'              	CALL	SCOPY
  2178'   78                    	MOV	A,B
  2179'   32 2762'              	STA	SREPLN
  217C'   AF                    	XRA	A
  217D'   32 2757'              	STA	SGFLAG
  2180'   7E                    	MOV	A,M
  2181'   FE 67                 	CPI	'g'
  2183'   C2 218C'              	JNZ	EX_SG
  2186'   23                    	INX	H
  2187'   3E 01                 	MVI	A,1
  2189'   32 2757'              	STA	SGFLAG
  218C'                         EX_SG:
  218C'   7E                    	MOV	A,M
  218D'   B7                    	ORA	A
  218E'   C2 1F63'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2191'   C3 21BA'              	JMP	SUBGO
  2194'                         SUBNOP:
  2194'   21 200F'              	LXI	H,SNOPAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2197'   C3 1F71'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  219A'                         SCOPY:
  219A'   06 00                 	MVI	B,0
  219C'                         SCP_LP:
  219C'   78                    	MOV	A,B
  219D'   B9                    	CMP	C
  219E'   D2 21B7'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  21A1'   7E                    	MOV	A,M
  21A2'   B7                    	ORA	A
  21A3'   CA 21B7'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  21A6'   E5                    	PUSH	H
  21A7'   21 2756'              	LXI	H,SDELIM
  21AA'   BE                    	CMP	M
  21AB'   E1                    	POP	H
  21AC'   CA 21B6'              	JZ	SCP_SK
  21AF'   12                    	STAX	D
  21B0'   13                    	INX	D
  21B1'   23                    	INX	H
  21B2'   04                    	INR	B
  21B3'   C3 219C'              	JMP	SCP_LP
  21B6'                         SCP_SK:
  21B6'   23                    	INX	H
  21B7'                         SCP_DN:
  21B7'   AF                    	XRA	A
  21B8'   12                    	STAX	D
  21B9'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  21BA'                         SUBGO:
  21BA'   CD 0EC3'              	CALL	GZONE
  21BD'   2A 0000*              	LHLD	LNDLT
  21C0'   22 2760'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  21C3'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  21C6'   22 275E'              	SHLD	SOFFS		;   search's SN_BAD does
  21C9'   AF                    	XRA	A
  21CA'   32 2758'              	STA	SANY
  21CD'   21 0000               	LXI	H,0
  21D0'   22 275A'              	SHLD	SBACK
  21D3'   3A 2751'              	LDA	SRNGF
  21D6'   B7                    	ORA	A
  21D7'   CA 2200'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  21DA'   2A 2752'              	LHLD	SRNG1
  21DD'   7C                    	MOV	A,H
  21DE'   B5                    	ORA	L
  21DF'   CA 227C'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  21E2'   2A 2754'              	LHLD	SRNG2
  21E5'   EB                    	XCHG
  21E6'   2A 2752'              	LHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21E9'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  21EC'   DA 227C'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  21EF'   EB                    	XCHG			; HL = the last line, DE = the first
  21F0'   CD 0000*              	CALL	SUBHD
  21F3'   23                    	INX	H		; HL = the lines in the range
  21F4'   22 275C'              	SHLD	SLINES
  21F7'   2A 2752'              	LHLD	SRNG1
  21FA'   CD 0E44'              	CALL	GOLN
  21FD'   C3 2206'              	JMP	SUBLP
  2200'                         SUB_1L:
  2200'   21 0001               	LXI	H,1
  2203'   22 275C'              	SHLD	SLINES
  2206'                         SUBLP:
  2206'   CD 2282'              	CALL	SUBLIN		; A = 1 when this line changed
  2209'   B7                    	ORA	A
  220A'   CA 2218'              	JZ	SUB_NX
  220D'   3E 01                 	MVI	A,1
  220F'   32 2758'              	STA	SANY
  2212'   21 0000               	LXI	H,0
  2215'   22 275A'              	SHLD	SBACK		; the cursor is ON the last line changed
  2218'                         SUB_NX:
  2218'   2A 275C'              	LHLD	SLINES
  221B'   2B                    	DCX	H
  221C'   22 275C'              	SHLD	SLINES
  221F'   7C                    	MOV	A,H
  2220'   B5                    	ORA	L
  2221'   CA 223F'              	JZ	SUBDON		; the range is spent
  2224'   21 0001               	LXI	H,1
  2227'   AF                    	XRA	A
  2228'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  222B'   3A 2758'              	LDA	SANY
  222E'   B7                    	ORA	A
  222F'   CA 2239'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2232'   2A 275A'              	LHLD	SBACK
  2235'   23                    	INX	H
  2236'   22 275A'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2239'                         SUB_AE:
  2239'   CD 0989'              	CALL	ATEOF
  223C'   D2 2206'              	JNC	SUBLP		; ... unless that ran off the end of the file
  223F'                         SUBDON:
  223F'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2242'   3A 2758'              	LDA	SANY
  2245'   B7                    	ORA	A
  2246'   CA 2264'              	JZ	SUBNFD
  2249'   3E 01                 	MVI	A,1
  224B'   32 26A2'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  224E'   2A 275A'              	LHLD	SBACK
  2251'   7C                    	MOV	A,H
  2252'   B5                    	ORA	L
  2253'   CA 225E'              	JZ	SUB_PL
  2256'   3E FF                 	MVI	A,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2258'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  225B'   CD 0000*              	CALL	CLRCNT
  225E'                         SUB_PL:
  225E'   CD 0EDB'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2261'   C3 0700'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2264'                         SUBNFD:
  2264'   2A 275E'              	LHLD	SOFFS
  2267'   CD 0000*              	CALL	GOTO
  226A'   2A 2760'              	LHLD	SLDLTS
  226D'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2270'   21 1FFB'              	LXI	H,SNOTFD
  2273'   CD 1F71'              	CALL	EXERR
  2276'   21 0000*              	LXI	H,SRCHST
  2279'   C3 1F6C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  227C'                         SUBBAD:
  227C'   21 1FE9'              	LXI	H,SNOT
  227F'   C3 1F66'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2282'                         SUBLIN:
  2282'   AF                    	XRA	A
  2283'   32 2759'              	STA	SLCHG
  2286'   CD 2301'              	CALL	SUBBOL
  2289'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  228C'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  228C'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  228F'   DA 2297'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2292'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2294'   C2 228C'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2297'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2297'   CD 0000*              	CALL	CUROFF
  229A'   E5                    	PUSH	H
  229B'   CD 13D7'              	CALL	CEND
  229E'   D1                    	POP	D
  229F'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  22A2'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  22A3'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  22A6'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  22A7'   B7                    	ORA	A		;   span is a line, not a pair.)
  22A8'   FA 22FA'              	JM	SUBL_D		; what is left is shorter than the pattern
  22AB'   44                    	MOV	B,H
  22AC'   4D                    	MOV	C,L		; BC = the start positions a match can take
  22AD'   11 0000*              	LXI	D,SRCHST
  22B0'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  22B3'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  22B6'   DA 22FA'              	JC	SUBL_D
  22B9'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  22BC'   EB                    	XCHG
  22BD'   2A 0000*              	LHLD	GAPEND
  22C0'   EB                    	XCHG
  22C1'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  22C4'   EB                    	XCHG
  22C5'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  22C6'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  22C9'   D1                    	POP	D
  22CA'   19                    	DAD	D		; ... and so the match's logical offset
  22CB'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  22CE'   3A 2758'              	LDA	SANY
  22D1'   B7                    	ORA	A
  22D2'   C2 22DF'              	JNZ	SUBL_C
  22D5'   3A 2759'              	LDA	SLCHG
  22D8'   B7                    	ORA	A
  22D9'   C2 22DF'              	JNZ	SUBL_C
  22DC'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  22DF'                         SUBL_C:
  22DF'   3A 0000*              	LDA	SRCHBF
  22E2'   6F                    	MOV	L,A
  22E3'   26 00                 	MVI	H,0
  22E5'   CD 0000*              	CALL	DELFWD		; the match goes
  22E8'   11 2762'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  22EB'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  22EE'                         SUBL_I:
  22EE'   3E 01                 	MVI	A,1
  22F0'   32 2759'              	STA	SLCHG
  22F3'   3A 2757'              	LDA	SGFLAG
  22F6'   B7                    	ORA	A
  22F7'   C2 2297'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  22FA'                         SUBL_D:
  22FA'   CD 2301'              	CALL	SUBBOL
  22FD'   3A 2759'              	LDA	SLCHG
  2300'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2301'                         SUBBOL:
  2301'   CD 0000*              	CALL	CUROFF
  2304'   CD 05CB'              	CALL	BOL
  2307'   C3 0000*              	JMP	GOTO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  230A'                         VC_SRCH:
  230A'   CD 06DF'              	CALL	SETMOV
  230D'   C5                    	PUSH	B
  230E'   CD 0672'              	CALL	GETCNT
  2311'   22 274A'              	SHLD	SCNT
  2314'   C1                    	POP	B
  2315'   79                    	MOV	A,C
  2316'   FE 2F                 	CPI	'/'
  2318'   3E 00                 	MVI	A,0
  231A'   CA 231F'              	JZ	VS_DIR
  231D'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  231F'                         VS_DIR:
  231F'   32 271F'              	STA	SDIR
  2322'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2325'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2328'   47                    	MOV	B,A
  2329'   CD 1AC1'              	CALL	RDLINE
  232C'   B7                    	ORA	A
  232D'   C0                    	RNZ			; cancelled: nothing happens at all
  232E'   3A 26F7'              	LDA	RLLEN
  2331'   B7                    	ORA	A
  2332'   CA 2347'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2335'   5F                    	MOV	E,A
  2336'   16 00                 	MVI	D,0
  2338'   21 0000*              	LXI	H,SRCHST
  233B'   19                    	DAD	D
  233C'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  233E'   7B                    	MOV	A,E
  233F'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2342'   3E 01                 	MVI	A,1
  2344'   32 2721'              	STA	SHAVE
  2347'                         VS_OLD:
  2347'   3A 2721'              	LDA	SHAVE
  234A'   B7                    	ORA	A
  234B'   CA 2357'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  234E'   3A 271F'              	LDA	SDIR
  2351'   32 2720'              	STA	SDIRE
  2354'   C3 2380'              	JMP	SRCHN
  2357'                         VS_NOP:
  2357'   21 200F'              	LXI	H,SNOPAT
  235A'   C3 1F71'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  235D'                         VC_N:
  235D'   CD 06DF'              	CALL	SETMOV
  2360'   3A 271F'              	LDA	SDIR
  2363'   C3 236D'              	JMP	VN_GO
  2366'                         VCB_N:
  2366'   CD 06DF'              	CALL	SETMOV
  2369'   3A 271F'              	LDA	SDIR
  236C'   2F                    	CMA			; the other way: 0 <-> FFH
  236D'                         VN_GO:
  236D'   32 2720'              	STA	SDIRE
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2370'   CD 0672'              	CALL	GETCNT
  2373'   22 274A'              	SHLD	SCNT
  2376'   3A 2721'              	LDA	SHAVE
  2379'   B7                    	ORA	A
  237A'   CA 2357'              	JZ	VS_NOP
  237D'   C3 2380'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2380'                         SRCHN:
  2380'   CD 0EC3'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2383'   2A 0000*              	LHLD	LNDLT
  2386'   22 274E'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  2389'   CD 0000*              	CALL	CUROFF
  238C'   22 274C'              	SHLD	SOFF
  238F'                         SN_LP:
  238F'   CD 23C7'              	CALL	SRCHGO
  2392'   DA 23AC'              	JC	SN_BAD
  2395'   2A 274A'              	LHLD	SCNT
  2398'   2B                    	DCX	H
  2399'   22 274A'              	SHLD	SCNT
  239C'   7C                    	MOV	A,H
  239D'   B5                    	ORA	L
  239E'   C2 238F'              	JNZ	SN_LP
  23A1'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  23A4'   3E 01                 	MVI	A,1
  23A6'   32 272C'              	STA	GPKEEP		; land on the match, not the first non-blank
  23A9'   C3 0EDB'              	JMP	GPLACE		; (which sets LNDLT itself)
  23AC'                         SN_BAD:
  23AC'   CD 0000*              	CALL	CLRCNT
  23AF'   2A 274C'              	LHLD	SOFF
  23B2'   CD 0000*              	CALL	GOTO
  23B5'   2A 274E'              	LHLD	SLDLT
  23B8'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  23BB'   21 1FFB'              	LXI	H,SNOTFD
  23BE'   CD 1F71'              	CALL	EXERR
  23C1'   21 0000*              	LXI	H,SRCHST
  23C4'   C3 1F6C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  23C7'                         SRCHGO:
  23C7'   3E 01                 	MVI	A,1
  23C9'   32 2750'              	STA	SSKIP		; this pass starts one past the cursor
  23CC'   CD 23DE'              	CALL	SRCHW
  23CF'   D0                    	RNC
  23D0'   3A 2720'              	LDA	SDIRE
  23D3'   2F                    	CMA
  23D4'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  23D7'   AF                    	XRA	A
  23D8'   32 2750'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  23DB'   C3 23DE'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  23DE'                         SRCHW:
  23DE'   3A 2720'              	LDA	SDIRE
  23E1'   32 0000*              	STA	DIRFLG
  23E4'   21 FFFF               	LXI	H,0FFFFH
  23E7'   22 269F'              	SHLD	CMDCNT
  23EA'   AF                    	XRA	A
  23EB'   32 0000*              	STA	AUXCNT
  23EE'                         SW_LP:
  23EE'   CD 23FA'              	CALL	SRCH1
  23F1'   D0                    	RNC
  23F2'   CD 0000*              	CALL	SCRLST
  23F5'   D2 23EE'              	JNC	SW_LP
  23F8'   37                    	STC
  23F9'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  23FA'                         SRCH1:
  23FA'   11 0000*              	LXI	D,SRCHST
  23FD'   3A 0000*              	LDA	DIRFLG
  2400'   B7                    	ORA	A
  2401'   FA 2425'              	JM	SR1_BK
  2404'   21 0000*              	LXI	H,GAPEND
  2407'   CD 0000*              	CALL	FWDCNT
  240A'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  240D'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  240E'   3A 2750'              	LDA	SSKIP
  2411'   B7                    	ORA	A
  2412'   CA 241B'              	JZ	SR1_FW
  2415'   78                    	MOV	A,B
  2416'   B1                    	ORA	C
  2417'   37                    	STC
  2418'   C8                    	RZ			; no room for a match even before the skip
  2419'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  241A'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  241B'                         SR1_FW:
  241B'   CD 0000*              	CALL	MATCHF
  241E'   D8                    	RC
  241F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2422'   C3 0000*              	JMP	PUTCUR
  2425'                         SR1_BK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2425'   21 0000*              	LXI	H,TXTBEG
  2428'   CD 0000*              	CALL	FWDCNT
  242B'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  242E'   D8                    	RC
  242F'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2432'   CD 0000*              	CALL	MATCHB
  2435'   D8                    	RC
  2436'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2439'                         MSGNAM:
  2439'   E5                    	PUSH	H
  243A'   3E 22                 	MVI	A,'"'
  243C'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  243F'   E1                    	POP	H
  2440'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2441'   23                    	INX	H
  2442'   7E                    	MOV	A,M
  2443'   FE 20                 	CPI	' '
  2445'   C2 2452'              	JNZ	MN_HAS
  2448'   21 207D'              	LXI	H,SNONM
  244B'   CD 0000*              	CALL	OUTSTR
  244E'   E1                    	POP	H
  244F'   C3 249C'              	JMP	MN_END
  2452'                         MN_HAS:
  2452'   0E 19                 	MVI	C,BF_CURDSK
  2454'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2457'   E1                    	POP	H
  2458'   E5                    	PUSH	H
  2459'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  245A'   BE                    	CMP	M
  245B'   CA 2469'              	JZ	MN_NAM
  245E'   7E                    	MOV	A,M
  245F'   C6 40                 	ADI	'A'-1
  2461'   CD 0000*              	CALL	OUTCH
  2464'   3E 3A                 	MVI	A,':'
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2466'   CD 0000*              	CALL	OUTCH
  2469'                         MN_NAM:
  2469'   E1                    	POP	H
  246A'   E5                    	PUSH	H
  246B'   23                    	INX	H
  246C'   0E 08                 	MVI	C,8
  246E'                         MN_NM:
  246E'   7E                    	MOV	A,M
  246F'   FE 20                 	CPI	' '
  2471'   CA 247C'              	JZ	MN_EXT
  2474'   CD 0000*              	CALL	OUTCH
  2477'   23                    	INX	H
  2478'   0D                    	DCR	C
  2479'   C2 246E'              	JNZ	MN_NM
  247C'                         MN_EXT:
  247C'   E1                    	POP	H
  247D'   11 0009               	LXI	D,9
  2480'   19                    	DAD	D		; the type field
  2481'   7E                    	MOV	A,M
  2482'   FE 20                 	CPI	' '
  2484'   CA 249C'              	JZ	MN_END
  2487'   3E 2E                 	MVI	A,'.'
  2489'   CD 0000*              	CALL	OUTCH
  248C'   0E 03                 	MVI	C,3
  248E'                         MN_XL:
  248E'   7E                    	MOV	A,M
  248F'   FE 20                 	CPI	' '
  2491'   CA 249C'              	JZ	MN_END
  2494'   CD 0000*              	CALL	OUTCH
  2497'   23                    	INX	H
  2498'   0D                    	DCR	C
  2499'   C2 248E'              	JNZ	MN_XL
  249C'                         MN_END:
  249C'   3E 22                 	MVI	A,'"'
  249E'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  24A1'                         MSGFLG:
  24A1'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  24A3'   B7                    	ORA	A
  24A4'   CA 24B4'              	JZ	MF_RO
  24A7'   3A 26A2'              	LDA	MODF
  24AA'   B7                    	ORA	A
  24AB'   CA 24B4'              	JZ	MF_RO
  24AE'   21 2087'              	LXI	H,SMODM
  24B1'   CD 24C9'              	CALL	MF_PUT
  24B4'                         MF_RO:
  24B4'   3A 270D'              	LDA	ROFLAG
  24B7'   B7                    	ORA	A
  24B8'   CA 24C1'              	JZ	MF_NEW
  24BB'   21 2092'              	LXI	H,SROM
  24BE'   CD 24C9'              	CALL	MF_PUT
  24C1'                         MF_NEW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  24C1'   3A 270B'              	LDA	MSGNEW
  24C4'   B7                    	ORA	A
  24C5'   C8                    	RZ
  24C6'   21 209D'              	LXI	H,SNEWM
  24C9'                         MF_PUT:
  24C9'   78                    	MOV	A,B
  24CA'   B7                    	ORA	A
  24CB'   C2 24D7'              	JNZ	MF_STR
  24CE'   06 01                 	MVI	B,1
  24D0'   E5                    	PUSH	H
  24D1'   3E 20                 	MVI	A,' '
  24D3'   CD 0000*              	CALL	OUTCH
  24D6'   E1                    	POP	H
  24D7'                         MF_STR:
  24D7'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  24DA'                         EMITW:
  24DA'   C5                    	PUSH	B
  24DB'   D5                    	PUSH	D
  24DC'   06 00                 	MVI	B,0
  24DE'   11 2710               	LXI	D,10000
  24E1'   CD 24FF'              	CALL	EWDIG
  24E4'   11 03E8               	LXI	D,1000
  24E7'   CD 24FF'              	CALL	EWDIG
  24EA'   11 0064               	LXI	D,100
  24ED'   CD 24FF'              	CALL	EWDIG
  24F0'   11 000A               	LXI	D,10
  24F3'   CD 24FF'              	CALL	EWDIG
  24F6'   7D                    	MOV	A,L		; the units digit is always printed
  24F7'   C6 30                 	ADI	'0'
  24F9'   CD 0000*              	CALL	OUTCH
  24FC'   D1                    	POP	D
  24FD'   C1                    	POP	B
  24FE'   C9                    	RET
  24FF'                         EWDIG:
  24FF'   0E 00                 	MVI	C,0
  2501'                         EW_LP:
  2501'   7D                    	MOV	A,L
  2502'   93                    	SUB	E
  2503'   6F                    	MOV	L,A
  2504'   7C                    	MOV	A,H
  2505'   9A                    	SBB	D
  2506'   67                    	MOV	H,A
  2507'   DA 250E'              	JC	EW_DN
  250A'   0C                    	INR	C
  250B'   C3 2501'              	JMP	EW_LP
  250E'                         EW_DN:
  250E'   19                    	DAD	D		; one subtraction too many: give it back
  250F'   79                    	MOV	A,C
  2510'   B7                    	ORA	A
  2511'   C2 2517'              	JNZ	EW_PR
  2514'   78                    	MOV	A,B
  2515'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2516'   C8                    	RZ			; a leading zero: write nothing
  2517'                         EW_PR:
  2517'   79                    	MOV	A,C
  2518'   C6 30                 	ADI	'0'
  251A'   CD 0000*              	CALL	OUTCH
  251D'   06 01                 	MVI	B,1
  251F'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2520'                         ISEMPT:
  2520'   2A 0000*              	LHLD	OUTPOS
  2523'   7C                    	MOV	A,H
  2524'   B5                    	ORA	L
  2525'   C0                    	RNZ
  2526'   CD 0000*              	CALL	LOGLEN
  2529'   7C                    	MOV	A,H
  252A'   B5                    	ORA	L
  252B'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  252C'                         MSGCTG:
  252C'   21 0000*              	LXI	H,FNAME
  252F'   CD 2439'              	CALL	MSGNAM
  2532'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2534'   CD 24A1'              	CALL	MSGFLG
  2537'   CD 2520'              	CALL	ISEMPT
  253A'   C2 2543'              	JNZ	MG_POS
  253D'   21 20B0'              	LXI	H,SNOLIN
  2540'   C3 0000*              	JMP	OUTSTR
  2543'                         MG_POS:
  2543'   21 20A3'              	LXI	H,SLINE
  2546'   CD 0000*              	CALL	OUTSTR
  2549'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  254C'   23                    	INX	H		;   ... so the line it is on
  254D'   CD 24DA'              	CALL	EMITW
  2550'   21 20AA'              	LXI	H,SCOLM
  2553'   CD 0000*              	CALL	OUTSTR
  2556'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2559'   23                    	INX	H
  255A'   E5                    	PUSH	H
  255B'   CD 24DA'              	CALL	EMITW
  255E'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2561'   23                    	INX	H
  2562'   D1                    	POP	D
  2563'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2566'   C8                    	RZ
  2567'   E5                    	PUSH	H
  2568'   3E 2D                 	MVI	A,'-'
  256A'   CD 0000*              	CALL	OUTCH
  256D'   E1                    	POP	H
  256E'   C3 24DA'              	JMP	EMITW
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2571'                         FILMSG:
  2571'   3A 0001*              	LDA	FNAME+1
  2574'   FE 20                 	CPI	' '
  2576'   C8                    	RZ
  2577'   21 0000*              	LXI	H,FNAME
  257A'   CD 2439'              	CALL	MSGNAM
  257D'   AF                    	XRA	A		; nothing has been changed yet
  257E'   C3 24A1'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2581'                         WRMSG:
  2581'   21 0000*              	LXI	H,TFCB
  2584'   CD 2439'              	CALL	MSGNAM
  2587'   21 20C2'              	LXI	H,SWRIT
  258A'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  258D'                         MSGPST:
  258D'   3A 270A'              	LDA	MSGWHT
  2590'   B7                    	ORA	A
  2591'   C8                    	RZ
  2592'   47                    	MOV	B,A
  2593'   AF                    	XRA	A
  2594'   32 270A'              	STA	MSGWHT
  2597'   78                    	MOV	A,B
  2598'   FE 01                 	CPI	MW_FIL
  259A'   CA 25B6'              	JZ	MP_FIL
  259D'   FE 02                 	CPI	MW_WRT
  259F'   CA 25BC'              	JZ	MP_WRT
  25A2'   FE 04                 	CPI	MW_BIG
  25A4'   CA 25AD'              	JZ	MP_BIG
  25A7'   CD 252C'              	CALL	MSGCTG
  25AA'   C3 0000*              	JMP	SCURS
  25AD'                         MP_BIG:
  25AD'   21 205E'              	LXI	H,SQBIG
  25B0'   CD 0000*              	CALL	EXMSG
  25B3'   C3 0000*              	JMP	SCURS
  25B6'                         MP_FIL:
  25B6'   CD 2571'              	CALL	FILMSG
  25B9'   C3 0000*              	JMP	SCURS
  25BC'                         MP_WRT:
  25BC'   CD 2581'              	CALL	WRMSG
  25BF'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  25C2'                         VC_CTLG:
  25C2'   3E 03                 	MVI	A,MW_CTG
  25C4'   32 270A'              	STA	MSGWHT
  25C7'   3E 01                 	MVI	A,R_MOVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  25C9'   32 26A3'              	STA	RINTENT
  25CC'   C9                    	RET
                                
  25CD'                         CMDTAB:
  25CD'   07                    	DB	07H			; ^G -- where am I?
  25CE'   25C2'                 	DW	VC_CTLG
  25D0'   68                    	DB	'h'
  25D1'   0738'                 	DW	VC_H
  25D3'   6C                    	DB	'l'
  25D4'   0762'                 	DW	VC_L
  25D6'   6A                    	DB	'j'
  25D7'   0827'                 	DW	VC_J
  25D9'   6B                    	DB	'k'
  25DA'   0836'                 	DW	VC_K
  25DC'   30                    	DB	'0'
  25DD'   0789'                 	DW	VC_0
  25DF'   5E                    	DB	'^'
  25E0'   07A7'                 	DW	VC_CRT
  25E2'   24                    	DB	'$'
  25E3'   07E5'                 	DW	VC_EOL
  25E5'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  25E6'   0809'                 	DW	VC_CR
  25E8'   77                    	DB	'w'
  25E9'   0A0B'                 	DW	VC_W
  25EB'   62                    	DB	'b'
  25EC'   0A5C'                 	DW	VC_B
  25EE'   65                    	DB	'e'
  25EF'   0BC1'                 	DW	VC_E
  25F1'   57                    	DB	'W'
  25F2'   0A12'                 	DW	VCBGW
  25F4'   42                    	DB	'B'
  25F5'   0A63'                 	DW	VCBGB
  25F7'   45                    	DB	'E'
  25F8'   0BC8'                 	DW	VCBGE
  25FA'   47                    	DB	'G'
  25FB'   0E23'                 	DW	VC_G
  25FD'   67                    	DB	'g'
  25FE'   0E57'                 	DW	VC_LG
  2600'   78                    	DB	'x'
  2601'   13A0'                 	DW	VC_X
  2603'   5A                    	DB	'Z'
  2604'   1B41'                 	DW	VC_BZ
  2606'   66                    	DB	'f'
  2607'   0237'                 	DW	VC_FF
  2609'   46                    	DB	'F'
  260A'   023C'                 	DW	VC_FB
  260C'   74                    	DB	't'
  260D'   0241'                 	DW	VC_TF
  260F'   54                    	DB	'T'
