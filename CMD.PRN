  061A'   5F                    	MOV	E,A
  061B'   3A 0000*              	LDA	DOTLEN
  061E'   BB                    	CMP	E
  061F'   CA 062B'              	JZ	DOTGEF
  0622'   16 00                 	MVI	D,0
  0624'   21 0000*              	LXI	H,DOTBUF
