  0BDA'                         ESTEP:
  0BDA'   CD 0000*              	CALL	CUROFF
  0BDD'   22 24EF'              	SHLD	WKI
  0BE0'   CD 0000*              	CALL	LOGLEN
  0BE3'   22 24F1'              	SHLD	WKN
  0BE6'   2A 24EF'              	LHLD	WKI
  0BE9'   23                    	INX	H
  0BEA'   22 24EF'              	SHLD	WKI
  0BED'                         ES_WS:
  0BED'   2A 24EF'              	LHLD	WKI
  0BF0'   EB                    	XCHG
  0BF1'   2A 24F1'              	LHLD	WKN
  0BF4'   CD 0000*              	CALL	CMP16
  0BF7'   D2 0C45'              	JNC	ES_LND
  0BFA'   2A 24EF'              	LHLD	WKI
  0BFD'   CD 0000*              	CALL	CHARAT
  0C00'   CD 0688'              	CALL	CLASSF
  0C03'   B7                    	ORA	A
  0C04'   C2 0C11'              	JNZ	ES_WD
  0C07'   2A 24EF'              	LHLD	WKI
  0C0A'   23                    	INX	H
  0C0B'   22 24EF'              	SHLD	WKI
  0C0E'   C3 0BED'              	JMP	ES_WS
  0C11'                         ES_WD:
  0C11'   2A 24EF'              	LHLD	WKI
  0C14'   CD 0000*              	CALL	CHARAT
  0C17'   CD 0688'              	CALL	CLASSF
  0C1A'   32 24F7'              	STA	WKCLS
  0C1D'                         ES_RUN:
  0C1D'   2A 24EF'              	LHLD	WKI
  0C20'   23                    	INX	H
  0C21'   EB                    	XCHG			; DE = i+1
  0C22'   2A 24F1'              	LHLD	WKN
  0C25'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C28'   D2 0C45'              	JNC	ES_LND
  0C2B'   2A 24EF'              	LHLD	WKI
  0C2E'   23                    	INX	H
  0C2F'   E5                    	PUSH	H		; i+1
  0C30'   CD 0000*              	CALL	CHARAT
  0C33'   CD 0688'              	CALL	CLASSF
  0C36'   E1                    	POP	H		; HL = i+1
  0C37'   47                    	MOV	B,A
  0C38'   3A 24F7'              	LDA	WKCLS
  0C3B'   B8                    	CMP	B
  0C3C'   C2 0C45'              	JNZ	ES_LND
  0C3F'   22 24EF'              	SHLD	WKI
  0C42'   C3 0C1D'              	JMP	ES_RUN
  0C45'                         ES_LND:
  0C45'   2A 24F1'              	LHLD	WKN
  0C48'   EB                    	XCHG
  0C49'   2A 24EF'              	LHLD	WKI
  0C4C'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C4F'   DA 0C5B'              	JC	ES_CL
  0C52'   CA 0C5B'              	JZ	ES_CL
  0C55'   2A 24EF'              	LHLD	WKI
  0C58'   C3 0555'              	JMP	GOSET
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C5B'                         ES_CL:
  0C5B'   2A 24F1'              	LHLD	WKN
  0C5E'   7C                    	MOV	A,H
  0C5F'   B5                    	ORA	L
  0C60'   C8                    	RZ
  0C61'   2B                    	DCX	H
  0C62'   C3 0555'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C65'                         CURRW:
  0C65'   2A 0000*              	LHLD	WINROW
  0C68'   EB                    	XCHG
  0C69'   2A 0000*              	LHLD	LNDLT
  0C6C'   19                    	DAD	D		; HL = row (signed)
  0C6D'   7C                    	MOV	A,H
  0C6E'   B7                    	ORA	A
  0C6F'   FA 0C82'              	JM	CRW_0		; above the screen -> top row
  0C72'   C2 0C7D'              	JNZ	CRW_BT		; far below -> bottom row
  0C75'   3A 0000*              	LDA	NEDIT
  0C78'   3D                    	DCR	A		; A = bottom row
  0C79'   BD                    	CMP	L		; CY iff bottom < row
  0C7A'   D8                    	RC
  0C7B'   7D                    	MOV	A,L
  0C7C'   C9                    	RET
  0C7D'                         CRW_BT:
  0C7D'   3A 0000*              	LDA	NEDIT
  0C80'   3D                    	DCR	A
  0C81'   C9                    	RET
  0C82'                         CRW_0:
  0C82'   AF                    	XRA	A
  0C83'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C84'                         SETRWT:
  0C84'   2A 0000*              	LHLD	LNDLT
  0C87'   EB                    	XCHG
  0C88'   6F                    	MOV	L,A
  0C89'   26 00                 	MVI	H,0
  0C8B'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C8E'   22 0000*              	SHLD	WINROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C91'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C92'                         MVROW:
  0C92'   47                    	MOV	B,A
  0C93'   CD 0C65'              	CALL	CURRW
  0C96'   90                    	SUB	B		; A = row now - target
  0C97'   C8                    	RZ
  0C98'   DA 0CA1'              	JC	MR_DN
  0C9B'   6F                    	MOV	L,A
  0C9C'   26 00                 	MVI	H,0
  0C9E'   C3 08EC'              	JMP	KCORE
  0CA1'                         MR_DN:
  0CA1'   2F                    	CMA
  0CA2'   3C                    	INR	A		; A = target - row now
  0CA3'   6F                    	MOV	L,A
  0CA4'   26 00                 	MVI	H,0
  0CA6'   C3 084F'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CA9'                         VC_HIGH:
  0CA9'   CD 0653'              	CALL	MOVCNT		; a cursor motion, and its count
  0CAC'   2B                    	DCX	H		; row = count - 1
  0CAD'   7C                    	MOV	A,H
  0CAE'   B7                    	ORA	A
  0CAF'   3A 0000*              	LDA	SCBOT
  0CB2'   C2 0CBA'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CB5'   BD                    	CMP	L		; CY iff SCBOT < row
  0CB6'   DA 0CBA'              	JC	VH_GO
  0CB9'   7D                    	MOV	A,L
  0CBA'                         VH_GO:
  0CBA'   CD 0C92'              	CALL	MVROW
  0CBD'   C3 07A1'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CC0'                         VC_MIDL:
  0CC0'   CD 0653'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CC3'   3A 0000*              	LDA	SCBOT
  0CC6'   B7                    	ORA	A		; clear CY for the shift
  0CC7'   1F                    	RAR			; A = SCBOT / 2
  0CC8'   CD 0C92'              	CALL	MVROW
  0CCB'   C3 07A1'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CCE'                         VC_LOWL:
  0CCE'   CD 0653'              	CALL	MOVCNT		; a cursor motion, and its count
  0CD1'   2B                    	DCX	H		; count - 1
  0CD2'   3A 0000*              	LDA	SCBOT
  0CD5'   5F                    	MOV	E,A
  0CD6'   16 00                 	MVI	D,0
  0CD8'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CD9'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CDC'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CDE'   D2 0CE5'              	JNC	VL_GO		; at or past the top -> row 0
  0CE1'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CE4'   7D                    	MOV	A,L
  0CE5'                         VL_GO:
  0CE5'   CD 0C92'              	CALL	MVROW
  0CE8'   C3 07A1'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CEB'                         VC_PGDN:
  0CEB'   CD 0653'              	CALL	MOVCNT		; a cursor motion, and its count
  0CEE'   3A 0000*              	LDA	SCEOF
  0CF1'   B7                    	ORA	A
  0CF2'   CA 0D00'              	JZ	VPD_N
  0CF5'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0CF8'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0CF9'   C8                    	RZ			; it already is
  0CFA'   CD 0C92'              	CALL	MVROW
  0CFD'   C3 0D11'              	JMP	VPD_TP
  0D00'                         VPD_N:
  0D00'   3A 0000*              	LDA	NEDIT
  0D03'   D6 02                 	SUI	2
  0D05'   CD 0D59'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D08'   E5                    	PUSH	H
  0D09'   AF                    	XRA	A
  0D0A'   CD 0C92'              	CALL	MVROW		; the top line
  0D0D'   E1                    	POP	H
  0D0E'   CD 084F'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D11'                         VPD_TP:
  0D11'   AF                    	XRA	A
  0D12'   CD 0C84'              	CALL	SETRWT		; to the top row
  0D15'   C3 07A1'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D18'                         VC_PGUP:
  0D18'   CD 0653'              	CALL	MOVCNT		; a cursor motion, and its count
  0D1B'   3A 0000*              	LDA	SCBOF
  0D1E'   B7                    	ORA	A
  0D1F'   C0                    	RNZ
  0D20'   3A 0000*              	LDA	NEDIT
  0D23'   47                    	MOV	B,A
  0D24'   3A 0000*              	LDA	SCEOF
  0D27'   B7                    	ORA	A
  0D28'   CA 0D39'              	JZ	VPU_2
  0D2B'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D2E'   FE 02                 	CPI	2
  0D30'   D2 0D39'              	JNC	VPU_2
  0D33'   2F                    	CMA
  0D34'   3C                    	INR	A
  0D35'   80                    	ADD	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D36'   C3 0D3C'              	JMP	VPU_P
  0D39'                         VPU_2:
  0D39'   78                    	MOV	A,B
  0D3A'   D6 02                 	SUI	2
  0D3C'                         VPU_P:
  0D3C'   CD 0D59'              	CALL	MULSAT		; HL = count * page
  0D3F'   E5                    	PUSH	H
  0D40'   AF                    	XRA	A
  0D41'   CD 0C92'              	CALL	MVROW		; the top line
  0D44'   E1                    	POP	H
  0D45'   CD 08EC'              	CALL	KCORE		; the new top line
  0D48'   AF                    	XRA	A
  0D49'   CD 0C84'              	CALL	SETRWT		; on the top row
  0D4C'   3A 0000*              	LDA	NEDIT
  0D4F'   3D                    	DCR	A
  0D50'   6F                    	MOV	L,A
  0D51'   26 00                 	MVI	H,0
  0D53'   CD 084F'              	CALL	JCORE		; the bottom row's line
  0D56'   C3 07A1'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D59'                         MULSAT:
  0D59'   EB                    	XCHG
  0D5A'   21 0000               	LXI	H,0
  0D5D'   B7                    	ORA	A
  0D5E'   C8                    	RZ
  0D5F'                         MS_LP:
  0D5F'   19                    	DAD	D
  0D60'   DA 0D68'              	JC	MS_SAT
  0D63'   3D                    	DCR	A
  0D64'   C2 0D5F'              	JNZ	MS_LP
  0D67'   C9                    	RET
  0D68'                         MS_SAT:
  0D68'   21 FFFF               	LXI	H,0FFFFH
  0D6B'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D6C'                         VC_HFDN:
  0D6C'   CD 06D3'              	CALL	SETMOV
  0D6F'   CD 0C65'              	CALL	CURRW
  0D72'   32 24C1'              	STA	HFROW
  0D75'   CD 0DE3'              	CALL	HFCNT		; HL = lines
  0D78'   3A 24C1'              	LDA	HFROW
  0D7B'   47                    	MOV	B,A
  0D7C'   3A 0000*              	LDA	SCEOF
  0D7F'   B7                    	ORA	A
  0D80'   CA 0D88'              	JZ	VHD_GO
  0D83'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D86'   B8                    	CMP	B
  0D87'   C8                    	RZ			; the cursor is on it
  0D88'                         VHD_GO:
  0D88'   CD 084F'              	CALL	JCORE
  0D8B'   3A 0000*              	LDA	SCEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D8E'   B7                    	ORA	A
  0D8F'   C2 07A1'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D92'   3A 24C1'              	LDA	HFROW
  0D95'   CD 0C84'              	CALL	SETRWT
  0D98'   3E 01                 	MVI	A,1
  0D9A'   32 0000*              	STA	WFILL		; not past the end of the file
  0D9D'   C3 07A1'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DA0'                         VC_HFUP:
  0DA0'   CD 06D3'              	CALL	SETMOV
  0DA3'   CD 0C65'              	CALL	CURRW
  0DA6'   32 24C1'              	STA	HFROW
  0DA9'   CD 0DE3'              	CALL	HFCNT		; HL = lines
  0DAC'   CD 0DC3'              	CALL	ONFST
  0DAF'   C8                    	RZ			; the cursor is on the first line
  0DB0'   CD 08EC'              	CALL	KCORE
  0DB3'   3A 0000*              	LDA	SCBOF
  0DB6'   B7                    	ORA	A
  0DB7'   C2 07A1'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DBA'   3A 24C1'              	LDA	HFROW
  0DBD'   CD 0C84'              	CALL	SETRWT
  0DC0'   C3 07A1'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DC3'                         ONFST:
  0DC3'   E5                    	PUSH	H
  0DC4'   2A 0000*              	LHLD	OUTPOS
  0DC7'   7C                    	MOV	A,H
  0DC8'   B5                    	ORA	L
  0DC9'   C2 0DE1'              	JNZ	OF_RET
  0DCC'   2A 0000*              	LHLD	TXTBEG
  0DCF'   EB                    	XCHG			; DE = TXTBEG
  0DD0'   2A 0000*              	LHLD	GAPBEG
  0DD3'                         OF_LP:
  0DD3'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DD6'   CA 0DE1'              	JZ	OF_RET
  0DD9'   2B                    	DCX	H
  0DDA'   7E                    	MOV	A,M
  0DDB'   FE 0A                 	CPI	LF
  0DDD'   C2 0DD3'              	JNZ	OF_LP
  0DE0'   B7                    	ORA	A		; NZ
  0DE1'                         OF_RET:
  0DE1'   E1                    	POP	H
  0DE2'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DE3'                         HFCNT:
  0DE3'   2A 24B5'              	LHLD	CMDCNT
  0DE6'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DE7'   B5                    	ORA	L
  0DE8'   CA 0DFF'              	JZ	HFC_AM
  0DEB'   CD 0666'              	CALL	GETCNT		; HL = count; clears it
  0DEE'   3A 0000*              	LDA	NEDIT
  0DF1'   5F                    	MOV	E,A
  0DF2'   16 00                 	MVI	D,0
  0DF4'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0DF7'   D2 0DFB'              	JNC	HFC_ST
  0DFA'   EB                    	XCHG			; HL = NEDIT
  0DFB'                         HFC_ST:
  0DFB'   7D                    	MOV	A,L
  0DFC'   32 24C2'              	STA	HFAMT
  0DFF'                         HFC_AM:
  0DFF'   3A 24C2'              	LDA	HFAMT
  0E02'   B7                    	ORA	A
  0E03'   C2 0E10'              	JNZ	HFC_HL
  0E06'   3A 0000*              	LDA	NEDIT
  0E09'   B7                    	ORA	A
  0E0A'   1F                    	RAR
  0E0B'   B7                    	ORA	A
  0E0C'   C2 0E10'              	JNZ	HFC_HL
  0E0F'   3C                    	INR	A		; at least one line
  0E10'                         HFC_HL:
  0E10'   6F                    	MOV	L,A
  0E11'   26 00                 	MVI	H,0
  0E13'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E14'                         VC_REDR:
  0E14'   C3 0666'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E17'                         VC_G:
  0E17'   CD 06D3'              	CALL	SETMOV
  0E1A'   CD 0EAA'              	CALL	GZONE		; the screen's top line, before the move
  0E1D'   2A 24B5'              	LHLD	CMDCNT
  0E20'   7C                    	MOV	A,H
  0E21'   B5                    	ORA	L
  0E22'   C2 0E2F'              	JNZ	VG_N
  0E25'   AF                    	XRA	A		; forward
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E26'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E29'   CD 0983'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E2C'   C3 0EC2'              	JMP	GPLACE
  0E2F'                         VG_N:
  0E2F'   CD 0666'              	CALL	GETCNT		; HL = target line (1-based)
  0E32'                         VG_LN:
  0E32'   CD 0E38'              	CALL	GOLN
  0E35'   C3 0EC2'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E38'                         GOLN:
  0E38'   2B                    	DCX	H		; lines to move from line 1
  0E39'   E5                    	PUSH	H
  0E3A'   3E FF                 	MVI	A,0FFH
  0E3C'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E3F'   E1                    	POP	H
  0E40'   AF                    	XRA	A
  0E41'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E44'   CD 097D'              	CALL	ATEOF
  0E47'   DC 0983'              	CC	LASTLN		; past the last line: onto it
  0E4A'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E4B'                         VC_LG:
  0E4B'   CD 06D3'              	CALL	SETMOV
  0E4E'   3A 24DD'              	LDA	GSAVE
  0E51'   B7                    	ORA	A
  0E52'   C2 0E5B'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E55'   3E 01                 	MVI	A,PG
  0E57'   32 24DC'              	STA	GPEND
  0E5A'   C9                    	RET
  0E5B'                         VLG_GG:
  0E5B'   CD 0EAA'              	CALL	GZONE
  0E5E'   CD 0666'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E61'   C3 0E32'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E64'                         FPOS:
  0E64'   C5                    	PUSH	B
  0E65'   D5                    	PUSH	D
  0E66'   EB                    	XCHG
  0E67'   2A 0000*              	LHLD	TXTBEG
  0E6A'   EB                    	XCHG
  0E6B'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E6E'   EB                    	XCHG			; DE = that
  0E6F'   2A 0000*              	LHLD	OUTPOS
  0E72'   7C                    	MOV	A,H
  0E73'   B7                    	ORA	A		; CY = 0
  0E74'   1F                    	RAR
  0E75'   47                    	MOV	B,A
  0E76'   7D                    	MOV	A,L
  0E77'   1F                    	RAR
  0E78'   67                    	MOV	H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E79'   3E 00                 	MVI	A,0
  0E7B'   1F                    	RAR
  0E7C'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E7D'   19                    	DAD	D
  0E7E'   78                    	MOV	A,B
  0E7F'   CE 00                 	ACI	0		; A:HL = the position
  0E81'   D1                    	POP	D
  0E82'   C1                    	POP	B
  0E83'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E84'                         ZSAVE:
  0E84'   2A 24B5'              	LHLD	CMDCNT
  0E87'   22 250F'              	SHLD	ZSVCNT
  0E8A'   2A 0000*              	LHLD	AUXCNT
  0E8D'   22 2511'              	SHLD	ZSVAUX
  0E90'   3A 0000*              	LDA	DIRFLG
  0E93'   32 2513'              	STA	ZSVDIR
  0E96'   C9                    	RET
  0E97'                         ZREST:
  0E97'   2A 250F'              	LHLD	ZSVCNT
  0E9A'   22 24B5'              	SHLD	CMDCNT
  0E9D'   2A 2511'              	LHLD	ZSVAUX
  0EA0'   22 0000*              	SHLD	AUXCNT
  0EA3'   3A 2513'              	LDA	ZSVDIR
  0EA6'   32 0000*              	STA	DIRFLG
  0EA9'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EAA'                         GZONE:
  0EAA'   CD 0E84'              	CALL	ZSAVE
  0EAD'   CD 0C65'              	CALL	CURRW
  0EB0'   6F                    	MOV	L,A
  0EB1'   26 00                 	MVI	H,0
  0EB3'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0EB6'   CD 0E64'              	CALL	FPOS
  0EB9'   22 0000*              	SHLD	ZTOP
  0EBC'   32 0002*              	STA	ZTOP+2
  0EBF'   C3 0E97'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EC2'                         GPLACE:
  0EC2'   CD 0E84'              	CALL	ZSAVE
  0EC5'   2A 0000*              	LHLD	GAPBEG
  0EC8'   CD 0E64'              	CALL	FPOS
  0ECB'   EB                    	XCHG
  0ECC'   4F                    	MOV	C,A		; C:DE = the target's position
  0ECD'   2A 0000*              	LHLD	ZTOP
  0ED0'   7B                    	MOV	A,E
  0ED1'   95                    	SUB	L
  0ED2'   6F                    	MOV	L,A
  0ED3'   7A                    	MOV	A,D
  0ED4'   9C                    	SBB	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0ED5'   67                    	MOV	H,A
  0ED6'   22 250C'              	SHLD	ZDIF
  0ED9'   3A 0002*              	LDA	ZTOP+2
  0EDC'   47                    	MOV	B,A
  0EDD'   79                    	MOV	A,C
  0EDE'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0EDF'   DA 0F2C'              	JC	GP_UP
  0EE2'   B7                    	ORA	A
  0EE3'   C2 0F6D'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EE6'   3A 0000*              	LDA	NEDIT
  0EE9'   5F                    	MOV	E,A
  0EEA'   16 00                 	MVI	D,0
  0EEC'   B7                    	ORA	A
  0EED'   1F                    	RAR
  0EEE'   6F                    	MOV	L,A
  0EEF'   26 00                 	MVI	H,0
  0EF1'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0EF2'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0EF5'   CD 065F'              	CALL	GBSUB		; HL = bytes from there to the target
  0EF8'   EB                    	XCHG
  0EF9'   2A 250C'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0EFC'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0EFF'   DA 0F6D'              	JC	GP_MID
  0F02'   CD 065F'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F05'   01 0000               	LXI	B,0		; BC = lines from the top
  0F08'                         GP_CNT:
  0F08'   7A                    	MOV	A,D
  0F09'   B3                    	ORA	E
  0F0A'   CA 0F19'              	JZ	GP_DN
  0F0D'   7E                    	MOV	A,M
  0F0E'   23                    	INX	H
  0F0F'   1B                    	DCX	D
  0F10'   FE 0A                 	CPI	LF
  0F12'   C2 0F08'              	JNZ	GP_CNT
  0F15'   03                    	INX	B
  0F16'   C3 0F08'              	JMP	GP_CNT
  0F19'                         GP_DN:
  0F19'   3A 0000*              	LDA	NEDIT
  0F1C'   3D                    	DCR	A
  0F1D'   5F                    	MOV	E,A
  0F1E'   16 00                 	MVI	D,0		; DE = the bottom row
  0F20'   60                    	MOV	H,B
  0F21'   69                    	MOV	L,C
  0F22'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F25'   DA 0F77'              	JC	GP_SET		; A = the bottom row
  0F28'   7D                    	MOV	A,L		; on the screen: its row
  0F29'   C3 0F97'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F2C'                         GP_UP:
  0F2C'   3C                    	INR	A
  0F2D'   C2 0F6D'              	JNZ	GP_MID		; 64K bytes or more above
  0F30'   2A 250C'              	LHLD	ZDIF
  0F33'   EB                    	XCHG
  0F34'   21 0000               	LXI	H,0
  0F37'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F3A'   7C                    	MOV	A,H
  0F3B'   B5                    	ORA	L
  0F3C'   CA 0F6D'              	JZ	GP_MID		; exactly 64K
  0F3F'   EB                    	XCHG			; DE = bytes to read
  0F40'   AF                    	XRA	A
  0F41'   32 250E'              	STA	ZLF
  0F44'   CD 0000*              	CALL	RGET0
  0F47'                         GP_RD:
  0F47'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F4A'   DA 0F6D'              	JC	GP_MID
  0F4D'   FE 0A                 	CPI	LF
  0F4F'   C2 0F63'              	JNZ	GP_RN
  0F52'   3A 0000*              	LDA	NEDIT
  0F55'   B7                    	ORA	A
  0F56'   1F                    	RAR
  0F57'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F59'   E5                    	PUSH	H
  0F5A'   21 250E'              	LXI	H,ZLF
  0F5D'   34                    	INR	M
  0F5E'   BE                    	CMP	M		; CY iff more lines than that
  0F5F'   E1                    	POP	H
  0F60'   DA 0F6D'              	JC	GP_MID
  0F63'                         GP_RN:
  0F63'   1B                    	DCX	D
  0F64'   7A                    	MOV	A,D
  0F65'   B3                    	ORA	E
  0F66'   C2 0F47'              	JNZ	GP_RD
  0F69'   AF                    	XRA	A		; the top row
  0F6A'   C3 0F77'              	JMP	GP_SET
  0F6D'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F6D'   3E 01                 	MVI	A,1
  0F6F'   32 0000*              	STA	WFILL		; not past the end of the file
  0F72'   3A 0000*              	LDA	NEDIT
  0F75'   B7                    	ORA	A
  0F76'   1F                    	RAR			; the middle row
  0F77'                         GP_SET:
  0F77'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F78'   26 00                 	MVI	H,0
  0F7A'   22 0000*              	SHLD	WINROW
  0F7D'   21 0000               	LXI	H,0
  0F80'   22 0000*              	SHLD	LNDLT
  0F83'   CD 06F4'              	CALL	SETFUL		; the window may have paged: full repaint
  0F86'                         GP_FIN:
  0F86'   CD 0E97'              	CALL	ZREST
  0F89'   3A 2536'              	LDA	GPKEEP
  0F8C'   B7                    	ORA	A
  0F8D'   CA 07A1'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F90'   AF                    	XRA	A
  0F91'   32 2536'              	STA	GPKEEP
  0F94'   C3 0558'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0F97'                         GP_ONS:
  0F97'   6F                    	MOV	L,A
  0F98'   26 00                 	MVI	H,0		; HL = the row it lands on
  0F9A'   EB                    	XCHG
  0F9B'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0F9E'   EB                    	XCHG
  0F9F'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FA2'   22 0000*              	SHLD	LNDLT
  0FA5'   3E 01                 	MVI	A,R_MOVE
  0FA7'   32 24B9'              	STA	RINTENT
  0FAA'   C3 0F86'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FAD'                         OPPEND:
  0FAD'   AF                    	XRA	A
  0FAE'   32 24E2'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FB1'   3A 24DF'              	LDA	PSAVE
  0FB4'   FE 63                 	CPI	'c'
  0FB6'   C2 0FD3'              	JNZ	OPP_ND
  0FB9'   79                    	MOV	A,C
  0FBA'   FE 77                 	CPI	'w'
  0FBC'   CA 0FC4'              	JZ	OPP_W
  0FBF'   FE 57                 	CPI	'W'
  0FC1'   C2 0FD3'              	JNZ	OPP_ND
  0FC4'                         OPP_W:
  0FC4'   CD 104D'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FC7'   DA 0FD3'              	JC	OPP_ND
  0FCA'   79                    	MOV	A,C
  0FCB'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FCD'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FCE'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FD0'   32 24E2'              	STA	CWEOL		;   see the clamp in OPA_F
  0FD3'                         OPP_ND:
  0FD3'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0FD4'   21 24DF'              	LXI	H,PSAVE
  0FD7'   BE                    	CMP	M
  0FD8'   CA 106E'              	JZ	OPLINE
  0FDB'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0FDC'   CD 107E'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0FDF'   DA 104A'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0FE2'   32 24E1'              	STA	OPCLSV
  0FE5'   47                    	MOV	B,A		; B = the class
  0FE6'   3A 24DF'              	LDA	PSAVE
  0FE9'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0FEB'   C2 0FF7'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0FEE'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0FEF'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0FF1'   C2 1019'              	JNZ	OPP_GO
  0FF4'   C3 1002'              	JMP	OPP_NO
  0FF7'                         OPP_NC:
  0FF7'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0FF9'   C2 1019'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0FFC'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0FFD'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0FFF'   CA 1019'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1002'                         OPP_NO:
  1002'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1003'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1005'   CA 1013'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1008'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  100A'   CA 1013'              	JZ	OPP_SW		;   so swallow it before dropping the command
  100D'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1010'   C2 104A'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1013'                         OPP_SW:
  1013'   CD 0218'              	CALL	MKGETK
  1016'   C3 104A'              	JMP	OPABRT
  1019'                         OPP_GO:
  1019'   AF                    	XRA	A
  101A'   32 24C0'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  101D'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1020'   22 24E3'              	SHLD	OPSTA
  1023'   21 23E3'              	LXI	H,CMDTAB
  1026'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1029'   3A 24DF'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  102C'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  102D'   CA 06D3'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1030'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1033'   22 24E5'              	SHLD	OPEND2
  1036'   3A 24DF'              	LDA	PSAVE
  1039'   FE 79                 	CPI	'y'
  103B'   CA 151E'              	JZ	OPYANK		; a yank takes the span without losing it
  103E'   CD 10B9'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1041'   3A 24DF'              	LDA	PSAVE
  1044'   FE 63                 	CPI	'c'
  1046'   C0                    	RNZ
  1047'   C3 12E5'              	JMP	SETINS
  104A'                         OPABRT:
  104A'   C3 06D3'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  104D'                         ONWHIT:
  104D'   CD 0642'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1050'   CA 106C'              	JZ	OW_YES
  1053'   CD 064D'              	CALL	CURCHR		; A = the char under the cursor
  1056'   FE 20                 	CPI	' '
  1058'   CA 106C'              	JZ	OW_YES
  105B'   FE 09                 	CPI	TAB
  105D'   CA 106C'              	JZ	OW_YES
  1060'   FE 0D                 	CPI	CR
  1062'   CA 106C'              	JZ	OW_YES
  1065'   FE 0A                 	CPI	LF
  1067'   CA 106C'              	JZ	OW_YES
  106A'   B7                    	ORA	A		; a char to change: CY clear
  106B'   C9                    	RET
  106C'                         OW_YES:
  106C'   37                    	STC
  106D'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  106E'                         OPLINE:
  106E'   3A 24DF'              	LDA	PSAVE
  1071'   FE 63                 	CPI	'c'
  1073'   CA 06D3'              	JZ	SETMOV
  1076'   FE 79                 	CPI	'y'
  1078'   CA 1503'              	JZ	VY_YY
  107B'   C3 1488'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  107E'                         OPCLS:
  107E'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1080'   CA 108D'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1083'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1085'   C2 10A1'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1088'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  108A'   C3 108F'              	JMP	OPC_FK
  108D'                         OPC_SEM:
  108D'   06 00                 	MVI	B,0		; ';' runs it as it stands
  108F'                         OPC_FK:
  108F'   3A 252C'              	LDA	FNDKND
  1092'   B7                    	ORA	A
  1093'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1094'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1095'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1096'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1098'   CA 109F'              	JZ	OPC_EXC
  109B'   3E 01                 	MVI	A,1
  109D'   B7                    	ORA	A		; CY clear: a motion, class 1
  109E'   C9                    	RET
  109F'                         OPC_EXC:
  109F'   AF                    	XRA	A		; class 0, CY clear
  10A0'   C9                    	RET
  10A1'                         OPC_TB:
  10A1'   47                    	MOV	B,A
  10A2'   21 11DB'              	LXI	H,OPCTAB
  10A5'                         OPC_LP:
  10A5'   7E                    	MOV	A,M
  10A6'   B7                    	ORA	A
  10A7'   CA 10B7'              	JZ	OPC_MS		; end of table -> not a motion
  10AA'   B8                    	CMP	B
  10AB'   CA 10B3'              	JZ	OPC_HT
  10AE'   23                    	INX	H
  10AF'   23                    	INX	H
  10B0'   C3 10A5'              	JMP	OPC_LP
  10B3'                         OPC_HT:
  10B3'   23                    	INX	H
  10B4'   7E                    	MOV	A,M		; class byte
  10B5'   B7                    	ORA	A		; clear CY
  10B6'   C9                    	RET
  10B7'                         OPC_MS:
  10B7'   37                    	STC
  10B8'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  10B9'                         OPAPPL:
  10B9'   3A 24E1'              	LDA	OPCLSV
  10BC'   FE 02                 	CPI	2
  10BE'   CA 11BF'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  10C1'   2A 24E3'              	LHLD	OPSTA
  10C4'   EB                    	XCHG			; DE = start
  10C5'   2A 24E5'              	LHLD	OPEND2		; HL = end
  10C8'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  10CB'   DA 10DB'              	JC	OPA_F
  10CE'   CA 10DB'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  10D1'   22 24E7'              	SHLD	OPLO
  10D4'   EB                    	XCHG
  10D5'   22 24E9'              	SHLD	OPHI
  10D8'   C3 1133'              	JMP	OPA_DO
  10DB'                         OPA_F:
  10DB'   EB                    	XCHG			; HL = start, DE = end
  10DC'   22 24E7'              	SHLD	OPLO
  10DF'   EB                    	XCHG			; HL = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10E0'   3A 24E1'              	LDA	OPCLSV
  10E3'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  10E5'   CA 1130'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  10E8'   FE 01                 	CPI	1
  10EA'   C2 110C'              	JNZ	OPA_EX
  10ED'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  10EE'   3A 24E2'              	LDA	CWEOL
  10F1'   B7                    	ORA	A
  10F2'   CA 1130'              	JZ	OPA_HI
  10F5'   22 24E9'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  10F8'   2A 24E7'              	LHLD	OPLO
  10FB'   CD 1263'              	CALL	CEND		; HL = the start line's content end
  10FE'   EB                    	XCHG			; DE = that content end
  10FF'   2A 24E9'              	LHLD	OPHI		; HL = hi
  1102'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1105'   D2 1130'              	JNC	OPA_HI		; hi is inside the line: keep it
  1108'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1109'   C3 1130'              	JMP	OPA_HI
  110C'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  110C'   22 24E9'              	SHLD	OPHI		; the motion's own end, for now
  110F'   2A 24E7'              	LHLD	OPLO
  1112'   CD 1263'              	CALL	CEND		; HL = the start line's content end
  1115'   EB                    	XCHG			; DE = that content end
  1116'   3A 24C0'              	LDA	WPULL		; the motion landed on a line's end and was
  1119'   B7                    	ORA	A		;   pulled back onto its last char (the command
  111A'   C2 1126'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  111D'   2A 24E9'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1120'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  1123'   D2 1133'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1126'                         OPA_CE:				;   deletes the word, not all but its last char
  1126'   2A 24E7'              	LHLD	OPLO
  1129'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  112C'   CA 1171'              	JZ	OPA_LN
  112F'   EB                    	XCHG			; HL = the content end
  1130'                         OPA_HI:
  1130'   22 24E9'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  1133'                         OPA_DO:
  1133'   CD 1157'              	CALL	OPDSPN
  1136'   3A 24DF'              	LDA	PSAVE
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1139'   FE 63                 	CPI	'c'
  113B'   C8                    	RZ
  113C'   C3 1274'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  113F'                         SPNBRK:
  113F'   2A 24E7'              	LHLD	OPLO
  1142'   CD 05D2'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1145'   EB                    	XCHG			; DE = it
  1146'   2A 24E9'              	LHLD	OPHI
  1149'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  114C'                         OPSPNL:
  114C'   2A 24E9'              	LHLD	OPHI
  114F'   EB                    	XCHG
  1150'   2A 24E7'              	LHLD	OPLO
  1153'   EB                    	XCHG			; HL = hi, DE = lo
  1154'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1157'                         OPDSPN:
  1157'   CD 113F'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  115A'   F5                    	PUSH	PSW
  115B'   2A 24E7'              	LHLD	OPLO
  115E'   CD 0000*              	CALL	GOTO
  1161'   CD 114C'              	CALL	OPSPNL		; HL = hi - lo
  1164'   CD 0000*              	CALL	DELFWD
  1167'   CD 0188'              	CALL	MARKMOD
  116A'   F1                    	POP	PSW
  116B'   DA 06F4'              	JC	SETFUL		; a break went: every row below it moved up
  116E'   C3 06D9'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  1171'                         OPA_LN:
  1171'   3A 24DF'              	LDA	PSAVE
  1174'   FE 63                 	CPI	'c'
  1176'   C2 117F'              	JNZ	OPA_LD
  1179'   2A 24E7'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  117C'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  117F'                         OPA_LD:
  117F'   2A 24E7'              	LHLD	OPLO
  1182'   22 24E3'              	SHLD	OPSTA
  1185'   22 24E5'              	SHLD	OPEND2
  1188'   C3 11BF'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  118B'                         OPALSP:
  118B'   2A 24E3'              	LHLD	OPSTA
  118E'   EB                    	XCHG
  118F'   2A 24E5'              	LHLD	OPEND2
  1192'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1195'   DA 11A2'              	JC	OPAL_F
  1198'   22 24E7'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  119B'   EB                    	XCHG
  119C'   22 24E9'              	SHLD	OPHI		; hi-src = start
  119F'   C3 11AC'              	JMP	OPAL_R
  11A2'                         OPAL_F:
  11A2'   EB                    	XCHG			; HL = start
  11A3'   22 24E7'              	SHLD	OPLO		; lo-src = start
  11A6'   2A 24E5'              	LHLD	OPEND2
  11A9'   22 24E9'              	SHLD	OPHI		; hi-src = end
  11AC'                         OPAL_R:
  11AC'   2A 24E7'              	LHLD	OPLO
  11AF'   CD 05BF'              	CALL	BOL
  11B2'   22 24E7'              	SHLD	OPLO		; lo = BOL(low line)
  11B5'   2A 24E9'              	LHLD	OPHI
  11B8'   CD 05EF'              	CALL	NLSTART
  11BB'   22 24E9'              	SHLD	OPHI		; hi = start of line past the high line
  11BE'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  11BF'                         OPALIN:
  11BF'   CD 118B'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  11C2'                         OPDLIN:
  11C2'   CD 1157'              	CALL	OPDSPN
  11C5'   CD 0642'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  11C8'   DA 11D8'              	JC	OPDL_NB
  11CB'   CD 0000*              	CALL	LOGLEN
  11CE'   7C                    	MOV	A,H
  11CF'   B5                    	ORA	L
  11D0'   C8                    	RZ			; empty buffer
  11D1'   2B                    	DCX	H
  11D2'   CD 05BF'              	CALL	BOL
  11D5'   CD 0000*              	CALL	GOTO
  11D8'                         OPDL_NB:
  11D8'   C3 07A1'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  11DB'                         OPCTAB:
  11DB'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  11DF'   62 00 42 00           
  11E3'   68 00 6C 00           
  11E7'   30 00 5E 00           
  11EB'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  11ED'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  11F1'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  11F5'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  11F9'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  11FD'   24 01                 
  11FF'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1203'   47 02 48 02           
  1207'   4D 02 4C 02           
  120B'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  120D'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  120E'                         VCB_C:
  120E'   CD 121A'              	CALL	VCB_CD
  1211'   C3 12E5'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1214'                         VCB_D:
  1214'   CD 121A'              	CALL	VCB_CD
  1217'   C3 1274'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  121A'                         VCB_CD:
  121A'   CD 0659'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  121D'   22 24E7'              	SHLD	OPLO
  1220'   CD 0000*              	CALL	CUROFF
  1223'   CD 1263'              	CALL	CEND		; to the line's content end, the CR,LF left
  1226'   22 24E9'              	SHLD	OPHI
  1229'   C3 1157'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  122C'                         VC_X:
  122C'   CD 0846'              	CALL	GLSTAL
  122F'   CD 06D9'              	CALL	SETLIN
  1232'   CD 0666'              	CALL	GETCNT
  1235'   22 24EB'              	SHLD	CNTV
  1238'   CD 0000*              	CALL	CUROFF
  123B'   22 24EF'              	SHLD	WKI		; cur
  123E'   CD 1263'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1241'   EB                    	XCHG			; DE = contentend
  1242'   2A 24EF'              	LHLD	WKI		; HL = cur
  1245'   EB                    	XCHG			; HL = contentend, DE = cur
  1246'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1249'   7C                    	MOV	A,H
  124A'   B5                    	ORA	L
  124B'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  124C'   EB                    	XCHG			; DE = available
  124D'   2A 24EB'              	LHLD	CNTV		; HL = count
  1250'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1253'   DA 1259'              	JC	VX_USEA
  1256'   C3 125A'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1259'                         VX_USEA:
  1259'   EB                    	XCHG			; HL = available
  125A'                         VX_DEL:
  125A'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  125D'   CD 0188'              	CALL	MARKMOD
  1260'   C3 1274'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1263'                         CEND:
  1263'   CD 05D2'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1266'   7C                    	MOV	A,H
  1267'   B5                    	ORA	L
  1268'   C8                    	RZ			; the start of the text: nothing before it
  1269'   2B                    	DCX	H
  126A'   E5                    	PUSH	H
  126B'   CD 0000*              	CALL	CHARAT
  126E'   E1                    	POP	H		; HL = term-1
  126F'   FE 0D                 	CPI	CR
  1271'   C8                    	RZ			; a CR before the LF -> the content ends there
  1272'   23                    	INX	H
  1273'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1274'                         CLAMPE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1274'   CD 0000*              	CALL	CUROFF
  1277'   E5                    	PUSH	H
  1278'   CD 05FE'              	CALL	EOLC
  127B'   D1                    	POP	D		; DE = cur
  127C'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  127F'   D8                    	RC
  1280'   C8                    	RZ
  1281'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1284'                         VC_I:
  1284'   CD 0666'              	CALL	GETCNT
  1287'   C3 12E2'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  128A'                         VC_A:
  128A'   CD 0666'              	CALL	GETCNT
  128D'   CD 0642'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1290'   CA 12A7'              	JZ	VA_INS
  1293'   EB                    	XCHG			; HL = cur
  1294'   E5                    	PUSH	H
  1295'   CD 0000*              	CALL	CHARAT
  1298'   E1                    	POP	H
  1299'   FE 0A                 	CPI	LF
  129B'   CA 12A7'              	JZ	VA_INS		; on the line terminator -> append in place
  129E'   FE 0D                 	CPI	CR
  12A0'   CA 12A7'              	JZ	VA_INS
  12A3'   23                    	INX	H
  12A4'   CD 0000*              	CALL	GOTO
  12A7'                         VA_INS:
  12A7'   C3 12E2'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  12AA'                         VCB_A:
  12AA'   CD 0659'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12AD'   CD 05FE'              	CALL	EOLC		; HL = last content char (the start when empty)
  12B0'   E5                    	PUSH	H
  12B1'   CD 0000*              	CALL	CHARAT
  12B4'   E1                    	POP	H
  12B5'   FE 0D                 	CPI	CR
  12B7'   CA 12C0'              	JZ	VBA_IN		; an empty line: insert at its start
  12BA'   FE 0A                 	CPI	LF
  12BC'   CA 12C0'              	JZ	VBA_IN
  12BF'   23                    	INX	H		; past the last content char
  12C0'                         VBA_IN:
  12C0'   CD 0000*              	CALL	GOTO
  12C3'   C3 12E2'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  12C6'                         VCB_I:
  12C6'   CD 0666'              	CALL	GETCNT
  12C9'   CD 07A1'              	CALL	FNBLNK
  12CC'   CD 0000*              	CALL	CUROFF
  12CF'   E5                    	PUSH	H
  12D0'   CD 0000*              	CALL	CHARAT
  12D3'   E1                    	POP	H
  12D4'   FE 20                 	CPI	' '
  12D6'   CA 12DE'              	JZ	VBI_SK
  12D9'   FE 09                 	CPI	TAB
  12DB'   C2 12E2'              	JNZ	SETINM
  12DE'                         VBI_SK:
  12DE'   23                    	INX	H		; blanks only: past the last of them
  12DF'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  12E2'                         SETINM:
  12E2'   CD 06D3'              	CALL	SETMOV
  12E5'                         SETINS:
  12E5'   3E 01                 	MVI	A,EM_INS
  12E7'   32 24B4'              	STA	EDMODE
  12EA'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  12EB'                         ATCEND:
  12EB'   CD 0642'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12EE'   C8                    	RZ
  12EF'   CD 064D'              	CALL	CURCHR		; A = the char under the cursor
  12F2'   FE 0D                 	CPI	CR
  12F4'   C8                    	RZ
  12F5'   FE 0A                 	CPI	LF
  12F7'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  12F8'                         OPNBRK:
  12F8'   3E 0D                 	MVI	A,CR
  12FA'   CD 0000*              	CALL	PUTGAP
  12FD'   3E 0A                 	MVI	A,LF
  12FF'   CD 0000*              	CALL	PUTGAP
  1302'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1305'   23                    	INX	H
  1306'   22 0000*              	SHLD	LNDLT
  1309'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  130C'                         ENDBRK:
  130C'   CD 0642'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  130F'   C0                    	RNZ
  1310'   CD 12F8'              	CALL	OPNBRK
  1313'   CD 0000*              	CALL	CUROFF
  1316'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1317'   2B                    	DCX	H		;   line, with its own terminator after it
  1318'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  131B'                         VC_O:
  131B'   CD 0659'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  131E'   CD 1263'              	CALL	CEND
  1321'   CD 0000*              	CALL	GOTO
  1324'   CD 12F8'              	CALL	OPNBRK
  1327'   CD 130C'              	CALL	ENDBRK		; a last line with no line end: the opened line
  132A'   CD 06DF'              	CALL	SETILN		;   needs a terminator of its own to exist
  132D'   C3 12E5'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1330'                         VCB_O:
  1330'   CD 0659'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1333'   CD 05BF'              	CALL	BOL
  1336'   CD 0000*              	CALL	GOTO
  1339'   CD 12F8'              	CALL	OPNBRK
  133C'   CD 0000*              	CALL	CUROFF
  133F'   2B                    	DCX	H
  1340'   2B                    	DCX	H
  1341'   CD 0000*              	CALL	GOTO
  1344'   CD 06DF'              	CALL	SETILN
  1347'   C3 12E5'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  134A'                         VCB_J:
  134A'   CD 0659'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  134D'   CD 1263'              	CALL	CEND		; the join point: this line's content end
  1350'   22 24E7'              	SHLD	OPLO
  1353'   CD 0000*              	CALL	CUROFF
  1356'   CD 05EF'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1359'   E5                    	PUSH	H
  135A'   CD 0000*              	CALL	LOGLEN
  135D'   D1                    	POP	D		; DE = that start
  135E'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1361'   CA 06D3'              	JZ	SETMOV
  1364'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1365'                         VJ_WS:
  1365'   E5                    	PUSH	H
  1366'   CD 0000*              	CALL	LOGLEN
  1369'   D1                    	POP	D		; DE = the scan
  136A'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  136D'   CA 1384'              	JZ	VJ_DEL
  1370'   EB                    	XCHG			; HL = the scan
  1371'   E5                    	PUSH	H
  1372'   CD 0000*              	CALL	CHARAT
  1375'   E1                    	POP	H
  1376'   FE 20                 	CPI	' '
  1378'   CA 1380'              	JZ	VJ_SKIP
  137B'   FE 09                 	CPI	TAB
  137D'   C2 1384'              	JNZ	VJ_DEL
  1380'                         VJ_SKIP:
  1380'   23                    	INX	H
  1381'   C3 1365'              	JMP	VJ_WS
  1384'                         VJ_DEL:
  1384'   22 24E9'              	SHLD	OPHI
  1387'   CD 1157'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  138A'   CD 06EE'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  138D'   CD 0642'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1390'   CA 1274'              	JZ	CLAMPE
  1393'   CD 064D'              	CALL	CURCHR		; the first char of what was appended
  1396'   FE 0D                 	CPI	CR
  1398'   CA 1274'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  139B'   FE 0A                 	CPI	LF
  139D'   CA 1274'              	JZ	CLAMPE
  13A0'   FE 29                 	CPI	')'
  13A2'   CA 1274'              	JZ	CLAMPE		; vim puts no space before a ')'
  13A5'   CD 0000*              	CALL	CUROFF
  13A8'   7C                    	MOV	A,H
  13A9'   B5                    	ORA	L
  13AA'   CA 13C0'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  13AD'   2B                    	DCX	H
  13AE'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  13B1'   FE 20                 	CPI	' '
  13B3'   CA 1274'              	JZ	CLAMPE
  13B6'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13B8'   CA 1274'              	JZ	CLAMPE
  13BB'   FE 0A                 	CPI	LF
  13BD'   CA 1274'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  13C0'                         VJ_SP:
  13C0'   3E 20                 	MVI	A,' '
  13C2'   CD 0000*              	CALL	PUTGAP
  13C5'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  13C8'   2B                    	DCX	H
  13C9'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  13CC'                         VC_TILD:
  13CC'   CD 0666'              	CALL	GETCNT
  13CF'   CD 06D9'              	CALL	SETLIN		; only this row changes
  13D2'   CD 0846'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  13D5'   CD 0642'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  13D8'   CA 06D3'              	JZ	SETMOV
  13DB'   CD 064D'              	CALL	CURCHR		; A = the char under the cursor
  13DE'   FE 0D                 	CPI	CR
  13E0'   CA 06D3'              	JZ	SETMOV		; the line's end: nothing to toggle
  13E3'   FE 0A                 	CPI	LF
  13E5'   CA 06D3'              	JZ	SETMOV
  13E8'   47                    	MOV	B,A
  13E9'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  13EB'   FE 41                 	CPI	'A'
  13ED'   DA 13F9'              	JC	VT_PUT		; below 'A': no case
  13F0'   FE 5B                 	CPI	'Z'+1
  13F2'   D2 13F9'              	JNC	VT_PUT		; above 'Z': no case
  13F5'   78                    	MOV	A,B
  13F6'   EE 20                 	XRI	20H		; a letter: flip the case bit
  13F8'   47                    	MOV	B,A
  13F9'                         VT_PUT:
  13F9'   78                    	MOV	A,B
  13FA'   32 24F8'              	STA	VRCH		; the calls below do not preserve B
  13FD'   CD 0188'              	CALL	MARKMOD
  1400'   21 0001               	LXI	H,1
  1403'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1406'   3A 24F8'              	LDA	VRCH
  1409'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  140C'   C3 1274'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  140F'                         VC_R:
  140F'   CD 0653'              	CALL	MOVCNT		; a cursor motion, and its count
  1412'   3E 03                 	MVI	A,PR
  1414'   32 24DC'              	STA	GPEND
  1417'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1418'                         VR_DO:
  1418'   AF                    	XRA	A
  1419'   32 24DC'              	STA	GPEND
  141C'   79                    	MOV	A,C
  141D'   32 24F8'              	STA	VRCH		; the calls below do not preserve C
  1420'   CD 06D9'              	CALL	SETLIN		; only this row changed
  1423'   CD 0846'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1426'   CD 0642'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1429'   CA 06D3'              	JZ	SETMOV		; the end of the text: vim does nothing
  142C'   CD 064D'              	CALL	CURCHR		; A = the char under the cursor
  142F'   FE 0D                 	CPI	CR
  1431'   CA 06D3'              	JZ	SETMOV		; the line's end: nothing to replace
  1434'   FE 0A                 	CPI	LF
  1436'   CA 06D3'              	JZ	SETMOV
  1439'   CD 0188'              	CALL	MARKMOD
  143C'   21 0001               	LXI	H,1
  143F'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1442'   3A 24F8'              	LDA	VRCH
  1445'   FE 0D                 	CPI	CR
  1447'   CA 1454'              	JZ	VR_CR
  144A'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  144D'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1450'   2B                    	DCX	H		;   out, which moves every logical offset
  1451'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1454'                         VR_CR:
  1454'   CD 12F8'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1457'   CD 130C'              	CALL	ENDBRK		;   replaced char may have been the text's last
  145A'   CD 06DF'              	CALL	SETILN		;   row above it lost the char that was replaced,
  145D'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  145F'   32 24BC'              	STA	ILABOV
  1462'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1463'                         VCB_R:
  1463'   CD 0666'              	CALL	GETCNT
  1466'   CD 06D3'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1469'   21 0000               	LXI	H,0
  146C'   22 24F9'              	SHLD	RPDEL		; nothing of ours to put back yet
  146F'   22 24FB'              	SHLD	RPAPP
  1472'   3E 02                 	MVI	A,EM_REP
  1474'   32 24B4'              	STA	EDMODE
  1477'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1478'                         VC_D:
  1478'   3E 64                 	MVI	A,'d'
  147A'   32 24DE'              	STA	PENDOP
  147D'   C3 06D3'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1480'                         VC_C:
  1480'   3E 63                 	MVI	A,'c'
  1482'   32 24DE'              	STA	PENDOP
  1485'   C3 06D3'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1488'                         VD_DD:
  1488'   CD 0846'              	CALL	GLSTAL
  148B'   CD 0666'              	CALL	GETCNT
  148E'   22 24EB'              	SHLD	CNTV
  1491'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1493'   32 24E0'              	STA	DDSNG
  1496'   2B                    	DCX	H
  1497'   7C                    	MOV	A,H
  1498'   B5                    	ORA	L
  1499'   C2 14A4'              	JNZ	VDD_LS
  149C'   3E 01                 	MVI	A,1
  149E'   32 24E0'              	STA	DDSNG
  14A1'   C3 14AA'              	JMP	VDD_GO
  14A4'                         VDD_LS:
  14A4'   CD 080C'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  14A7'   DA 06D3'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  14AA'                         VDD_GO:
  14AA'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  14AD'   CD 078A'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  14B0'   2A 24EB'              	LHLD	CNTV
  14B3'   CD 0000*              	CALL	SETC0
  14B6'                         VDD_FW:
  14B6'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  14B9'   CD 067B'              	CALL	CNTTST
  14BC'   C2 14B6'              	JNZ	VDD_FW
  14BF'   CD 0188'              	CALL	MARKMOD
  14C2'   CD 097D'              	CALL	ATEOF
  14C5'   D2 14E0'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  14C8'   3E 00                 	MVI	A,0
  14CA'   32 24E0'              	STA	DDSNG		; deleted to the end: full repaint
  14CD'   CD 0DC3'              	CALL	ONFST
  14D0'   CA 07A1'              	JZ	FNBLNK		; nothing left before it
  14D3'   21 0001               	LXI	H,1		; onto the new last line
  14D6'   CD 0000*              	CALL	SETBWD
  14D9'   2A 0000*              	LHLD	LNDLT
  14DC'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14DD'   22 0000*              	SHLD	LNDLT
  14E0'                         VDD_UP:
  14E0'   CD 07A1'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  14E3'   3A 24E0'              	LDA	DDSNG
  14E6'   B7                    	ORA	A
  14E7'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  14E8'   3E 03                 	MVI	A,R_DLIN
  14EA'   32 24B9'              	STA	RINTENT
  14ED'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  14EE'                         QEMPTY:
  14EE'   2A 0000*              	LHLD	QBEG
  14F1'   EB                    	XCHG
  14F2'   2A 0000*              	LHLD	QEND
  14F5'   7C                    	MOV	A,H
  14F6'   BA                    	CMP	D
  14F7'   C0                    	RNZ
  14F8'   7D                    	MOV	A,L
  14F9'   BB                    	CMP	E
  14FA'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  14FB'                         VC_Y:
  14FB'   3E 79                 	MVI	A,'y'
  14FD'   32 24DE'              	STA	PENDOP
  1500'   C3 06D3'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1503'                         VY_YY:
  1503'   CD 0000*              	CALL	CUROFF
  1506'   22 251C'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1509'   CD 05BF'              	CALL	BOL
  150C'   22 251E'              	SHLD	YPT		; where the lines come from, to put them back
  150F'   CD 1620'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1512'   CD 1663'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1515'   D2 1627'              	JNC	YNDONE
  1518'   21 1488'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  151B'   C3 1547'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  151E'                         OPYANK:
  151E'   CD 118B'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1521'   2A 24E3'              	LHLD	OPSTA
  1524'   EB                    	XCHG			; DE = start
  1525'   2A 24E5'              	LHLD	OPEND2		; HL = end
  1528'   CD 0000*              	CALL	CMP16		; CY iff start < end
  152B'   D2 152F'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  152E'   EB                    	XCHG			; ... otherwise the start is
  152F'                         OPY_LO:
  152F'   22 251C'              	SHLD	YOFF
  1532'   2A 24E7'              	LHLD	OPLO
  1535'   22 251E'              	SHLD	YPT		; where the lines come from, to put them back
  1538'   CD 1620'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  153B'   CD 16DB'              	CALL	YNSPAN		; copied where they lie, if there is room
  153E'   D2 1627'              	JNC	YNDONE
  1541'   21 15E4'              	LXI	H,YSPAN
  1544'   C3 1547'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1547'                         YKGO:
  1547'   22 2545'              	SHLD	YACT
  154A'   2A 251E'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  154D'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  154E'   2A 251C'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1551'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1554'   22 254B'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1557'   3A 24B8'              	LDA	MODF
  155A'   32 2519'              	STA	YMODF
  155D'   3A 24D1'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1560'   32 251A'              	STA	YDCHG		;   a yank must not become the last change
  1563'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1566'   32 251B'              	STA	YURPL		;   back are not a change to undo either
  1569'   3E 01                 	MVI	A,1
  156B'   32 0000*              	STA	UNDRPL
  156E'   32 2544'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1571'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1574'   22 2527'              	SHLD	YLDLT
  1577'   CD 0000*              	CALL	LOGLEN
  157A'   22 2549'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  157D'   2A 2545'              	LHLD	YACT
  1580'   CD 15E3'              	CALL	YCALL		; the lines out of the file, into the register
  1583'   CD 0000*              	CALL	LOGLEN
  1586'   EB                    	XCHG
  1587'   2A 2549'              	LHLD	YWAS
  158A'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  158D'   CA 15BB'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1590'   2A 251E'              	LHLD	YPT
  1593'   CD 0000*              	CALL	GOTO
  1596'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1599'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  159C'   22 254D'              	SHLD	YBLK
  159F'   2A 0000*              	LHLD	QBEG
  15A2'   EB                    	XCHG
  15A3'   2A 0000*              	LHLD	QEND
  15A6'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  15A9'   EB                    	XCHG
  15AA'   2A 254D'              	LHLD	YBLK
  15AD'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  15B0'   EB                    	XCHG
  15B1'   2A 254B'              	LHLD	YCOL
  15B4'   19                    	DAD	D		; ... and the cursor is YCOL into them
  15B5'   CD 0000*              	CALL	GOTO
  15B8'   C3 15C1'              	JMP	YK_RST
  15BB'                         YK_FIN:				; nothing came out, so nothing was put back and
  15BB'   2A 251C'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  15BE'   CD 0000*              	CALL	GOTO		;   where it was
  15C1'                         YK_RST:
  15C1'   2A 2527'              	LHLD	YLDLT
  15C4'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  15C7'   3A 2519'              	LDA	YMODF
  15CA'   32 24B8'              	STA	MODF
  15CD'   3A 251A'              	LDA	YDCHG
  15D0'   32 24D1'              	STA	DOTCHG
  15D3'   3A 251B'              	LDA	YURPL
  15D6'   32 0000*              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15D9'   AF                    	XRA	A
  15DA'   32 2544'              	STA	MKHOLD
  15DD'   CD 0846'              	CALL	GLSTAL
  15E0'   C3 06F4'              	JMP	SETFUL		; the cheap paint cannot carry this
  15E3'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  15E4'                         YSPAN:
  15E4'   CD 0846'              	CALL	GLSTAL
  15E7'   CD 114C'              	CALL	OPSPNL		; HL = the span's length
  15EA'   22 2547'              	SHLD	YTGT
  15ED'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  15F0'   EB                    	XCHG			; DE = it
  15F1'   2A 2547'              	LHLD	YTGT
  15F4'   EB                    	XCHG			; HL = the text's, DE = the span's
  15F5'   CD 0000*              	CALL	SUBHD
  15F8'   22 2547'              	SHLD	YTGT		; what the text is left at when the span is out
  15FB'   2A 24E7'              	LHLD	OPLO
  15FE'   CD 0000*              	CALL	GOTO
  1601'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1604'                         YS_LP:
  1604'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1607'   CD 0000*              	CALL	SETC0
  160A'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  160D'   CD 0000*              	CALL	LOGLEN
  1610'   EB                    	XCHG			; DE = what is left
  1611'   2A 2547'              	LHLD	YTGT
  1614'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1617'   DA 161D'              	JC	YS_END		; below it -- cannot happen over whole lines,
  161A'   C2 1604'              	JNZ	YS_LP		;   but never spin here if it ever did
  161D'                         YS_END:
  161D'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1620'                         YNPRE:
  1620'   2A 0000*              	LHLD	PGTOPM
  1623'   22 254F'              	SHLD	YNPG
  1626'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1627'                         YNDONE:
  1627'   2A 251C'              	LHLD	YOFF
  162A'   CD 0000*              	CALL	GOTO
  162D'   2A 0000*              	LHLD	PGTOPM
  1630'   EB                    	XCHG
  1631'   2A 254F'              	LHLD	YNPG
  1634'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1637'   C2 06F4'              	JNZ	SETFUL		; it moved under us: repaint after all
  163A'   C3 06D3'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  163D'                         YNROOM:
  163D'   11 0100               	LXI	D,100H
  1640'   19                    	DAD	D
  1641'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1642'   E5                    	PUSH	H		; the span plus its slack
  1643'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1646'   EB                    	XCHG			; HL = free
  1647'   D1                    	POP	D		; DE = the span plus its slack
  1648'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  164B'   DA 1653'              	JC	YNR_OK
  164E'   CA 1653'              	JZ	YNR_OK
  1651'   37                    	STC			; not enough: the delete-and-put-back path
  1652'   C9                    	RET
  1653'                         YNR_OK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1653'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1654'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1655'                         YNGO:
  1655'   C5                    	PUSH	B
  1656'   CD 0666'              	CALL	GETCNT		; spent here: this yank is happening
  1659'   CD 0846'              	CALL	GLSTAL
  165C'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  165F'   C1                    	POP	B
  1660'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1663'                         YNCOPY:
  1663'   2A 24B5'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1666'   7C                    	MOV	A,H		;   the count itself
  1667'   B5                    	ORA	L
  1668'   C2 166E'              	JNZ	YNC_HV
  166B'   21 0001               	LXI	H,1
  166E'                         YNC_HV:
  166E'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  166F'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1670'   B4                    	ORA	H
  1671'   CA 167C'              	JZ	YNC_M
  1674'   E5                    	PUSH	H
  1675'   CD 080C'              	CALL	ONLAST		; vim: a count over one on the last line does
  1678'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1679'   DA 168E'              	JC	YNC_RF
  167C'                         YNC_M:
  167C'   E5                    	PUSH	H
  167D'   CD 078A'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1680'   E1                    	POP	H
  1681'   CD 1696'              	CALL	YNLINE		; BC = the span, measured where it stands
  1684'   D8                    	RC			; not measurable here: let the pager answer it
  1685'   60                    	MOV	H,B
  1686'   69                    	MOV	L,C
  1687'   CD 163D'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  168A'   D8                    	RC			; no: the delete-and-put-back path
  168B'   C3 1655'              	JMP	YNGO
  168E'                         YNC_RF:
  168E'   CD 0666'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1691'   CD 0846'              	CALL	GLSTAL		;   register alone, and that is the command
  1694'   B7                    	ORA	A		; NC: done
  1695'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1696'                         YNLINE:
  1696'   22 2551'              	SHLD	YNCNT		; the lines it still wants
  1699'   2A 0000*              	LHLD	GAPEND
  169C'                         YNL_LP:
  169C'   EB                    	XCHG			; DE = the scan
  169D'   2A 0000*              	LHLD	TXTEND
  16A0'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  16A3'   EB                    	XCHG			; HL = the scan
  16A4'   D2 16C4'              	JNC	YNL_EN		; the resident text ran out
  16A7'   7E                    	MOV	A,M
  16A8'   23                    	INX	H
  16A9'   FE 0A                 	CPI	LF
  16AB'   C2 169C'              	JNZ	YNL_LP
  16AE'   E5                    	PUSH	H
  16AF'   2A 2551'              	LHLD	YNCNT
  16B2'   2B                    	DCX	H
  16B3'   22 2551'              	SHLD	YNCNT
  16B6'   7C                    	MOV	A,H
  16B7'   B5                    	ORA	L
  16B8'   E1                    	POP	H
  16B9'   C2 169C'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  16BC'   EB                    	XCHG			; DE = past the last of them
  16BD'   2A 0000*              	LHLD	GAPEND
  16C0'   EB                    	XCHG			; HL = past them, DE = GAPEND
  16C1'   C3 16D2'              	JMP	YNL_BC
  16C4'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  16C4'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  16C7'   C2 16D9'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  16CA'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  16CD'   EB                    	XCHG			;   count clamps to it as vim's does
  16CE'   2A 0000*              	LHLD	GAPEND
  16D1'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  16D2'                         YNL_BC:
  16D2'   CD 0000*              	CALL	SUBHD		; HL = the span
  16D5'   44                    	MOV	B,H
  16D6'   4D                    	MOV	C,L
  16D7'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  16D8'   C9                    	RET
  16D9'                         YNL_NO:
  16D9'   37                    	STC
  16DA'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  16DB'                         YNSPAN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16DB'   CD 114C'              	CALL	OPSPNL		; HL = the span's length
  16DE'   44                    	MOV	B,H
  16DF'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  16E0'   CD 163D'              	CALL	YNROOM
  16E3'   D8                    	RC			; no room: the delete-and-put-back path
  16E4'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  16E5'   2A 24E7'              	LHLD	OPLO
  16E8'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  16EB'   C1                    	POP	B
  16EC'   C3 1655'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  16EF'                         VC_P:
  16EF'   CD 14EE'              	CALL	QEMPTY
  16F2'   CA 17AA'              	JZ	VP_BEL
  16F5'   CD 0666'              	CALL	GETCNT
  16F8'   22 2520'              	SHLD	PCNT
  16FB'   CD 0000*              	CALL	CUROFF
  16FE'   CD 05EF'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1701'   C3 1716'              	JMP	VP_GO
  1704'                         VCB_P:
  1704'   CD 14EE'              	CALL	QEMPTY
  1707'   CA 17AA'              	JZ	VP_BEL
  170A'   CD 0666'              	CALL	GETCNT
  170D'   22 2520'              	SHLD	PCNT
  1710'   CD 0000*              	CALL	CUROFF
  1713'   CD 05BF'              	CALL	BOL
  1716'                         VP_GO:
  1716'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1719'   CD 0000*              	CALL	CUROFF
  171C'   EB                    	XCHG
  171D'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1720'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1723'   DA 1738'              	JC	VP_IN
  1726'   EB                    	XCHG			; HL = the put point = LOGLEN
  1727'   7C                    	MOV	A,H
  1728'   B5                    	ORA	L
  1729'   CA 1735'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  172C'   2B                    	DCX	H
  172D'   CD 0000*              	CALL	CHARAT
  1730'   FE 0A                 	CPI	LF
  1732'   CA 1738'              	JZ	VP_IN
  1735'                         VP_BRK:
  1735'   CD 12F8'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1738'                         VP_IN:
  1738'   CD 0000*              	CALL	CUROFF
  173B'   22 2522'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                	;    the register's own line count is added for each copy put. ---
  173E'   2A 0000*              	LHLD	QBEG
  1741'   EB                    	XCHG
  1742'   2A 0000*              	LHLD	QEND
  1745'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1748'   EB                    	XCHG
  1749'   22 2524'              	SHLD	PLFS
  174C'   2A 2520'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  174F'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1750'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1751'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1753'   C2 1757'              	JNZ	VP_PZ
  1756'   7D                    	MOV	A,L
  1757'                         VP_PZ:
  1757'   32 2526'              	STA	PCPY
  175A'                         VP_LP:
  175A'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  175D'   2A 0000*              	LHLD	LNDLT
  1760'   EB                    	XCHG
  1761'   2A 2524'              	LHLD	PLFS
  1764'   19                    	DAD	D
  1765'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1768'   2A 2520'              	LHLD	PCNT
  176B'   2B                    	DCX	H
  176C'   22 2520'              	SHLD	PCNT
  176F'   7C                    	MOV	A,H
  1770'   B5                    	ORA	L
  1771'   C2 175A'              	JNZ	VP_LP
  1774'   CD 0188'              	CALL	MARKMOD
  1777'   2A 2522'              	LHLD	PPT
  177A'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  177D'   CD 0846'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1780'   3A 2526'              	LDA	PCPY
  1783'   B7                    	ORA	A
  1784'   CA 07A1'              	JZ	FNBLNK
  1787'   2A 2524'              	LHLD	PLFS
  178A'   7C                    	MOV	A,H
  178B'   B7                    	ORA	A
  178C'   C2 07A1'              	JNZ	FNBLNK
  178F'   3A 2526'              	LDA	PCPY
  1792'   CD 0D59'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1795'   7C                    	MOV	A,H
  1796'   B7                    	ORA	A
  1797'   C2 07A1'              	JNZ	FNBLNK
  179A'   7D                    	MOV	A,L
  179B'   B7                    	ORA	A
  179C'   CA 07A1'              	JZ	FNBLNK
  179F'   F5                    	PUSH	PSW
  17A0'   CD 06DF'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  17A3'   F1                    	POP	PSW
  17A4'   32 24BA'              	STA	ILN		; ... which the lines put now replace
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17A7'   C3 07A1'              	JMP	FNBLNK
  17AA'                         VP_BEL:
  17AA'   CD 0666'              	CALL	GETCNT		; the count is spent either way
  17AD'   0E 07                 	MVI	C,BEL
  17AF'   CD 0000*              	CALL	BCONOU
  17B2'   C3 06D3'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  17B5'                         VIREP:
  17B5'   78                    	MOV	A,B
  17B6'   FE 01                 	CPI	KT_ACT
  17B8'   CA 18E5'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  17BB'   FE 02                 	CPI	KT_CHAR
  17BD'   C0                    	RNZ			; ignore anything else
  17BE'   79                    	MOV	A,C
  17BF'   FE 0D                 	CPI	CR
  17C1'   CA 1825'              	JZ	VP_CR
  17C4'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  17C6'   CA 1825'              	JZ	VP_CR
  17C9'   FE 08                 	CPI	BS
  17CB'   CA 1831'              	JZ	VP_BS
  17CE'   FE 7F                 	CPI	DEL
  17D0'   CA 1831'              	JZ	VP_BS
  17D3'   32 24F8'              	STA	VRCH		; the calls below do not preserve C
  17D6'   CD 06D9'              	CALL	SETLIN		; this row changed
  17D9'   CD 0188'              	CALL	MARKMOD
  17DC'   CD 12EB'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  17DF'   CA 1817'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  17E2'   3A 24F8'              	LDA	VRCH
  17E5'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  17E8'   2A 24F9'              	LHLD	RPDEL
  17EB'   7C                    	MOV	A,H
  17EC'   B5                    	ORA	L
  17ED'   CA 1803'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  17F0'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17F3'   EB                    	XCHG
  17F4'   2A 24FD'              	LHLD	RPGE
  17F7'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  17FA'   CA 1803'              	JZ	VP_OVW
  17FD'   21 0000               	LXI	H,0
  1800'   22 24F9'              	SHLD	RPDEL		; the text moved: those originals are gone
  1803'                         VP_OVW:
  1803'   21 0001               	LXI	H,1
  1806'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1809'   2A 0000*              	LHLD	GAPEND
  180C'   22 24FD'              	SHLD	RPGE
  180F'   2A 24F9'              	LHLD	RPDEL
  1812'   23                    	INX	H
  1813'   22 24F9'              	SHLD	RPDEL
  1816'   C9                    	RET
  1817'                         VP_APP:
  1817'   3A 24F8'              	LDA	VRCH
  181A'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  181D'   2A 24FB'              	LHLD	RPAPP
  1820'   23                    	INX	H
  1821'   22 24FB'              	SHLD	RPAPP
  1824'   C9                    	RET
  1825'                         VP_CR:
  1825'   21 0000               	LXI	H,0
  1828'   22 24F9'              	SHLD	RPDEL		; a line break ends what BS can put back
  182B'   22 24FB'              	SHLD	RPAPP
  182E'   C3 18BB'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1831'                         VP_BS:
  1831'   2A 24FB'              	LHLD	RPAPP
  1834'   7C                    	MOV	A,H
  1835'   B5                    	ORA	L
  1836'   CA 1843'              	JZ	VP_BSD
  1839'   2B                    	DCX	H
  183A'   22 24FB'              	SHLD	RPAPP		; an appended char: it just goes
  183D'   CD 06D9'              	CALL	SETLIN
  1840'   C3 0000*              	JMP	DELPRV
  1843'                         VP_BSD:
  1843'   2A 24F9'              	LHLD	RPDEL
  1846'   7C                    	MOV	A,H
  1847'   B5                    	ORA	L
  1848'   CA 186F'              	JZ	VP_BSM		; nothing of ours left
  184B'   2A 0000*              	LHLD	GAPEND
  184E'   EB                    	XCHG
  184F'   2A 24FD'              	LHLD	RPGE
  1852'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1855'   C2 186F'              	JNZ	VP_BSM
  1858'   2A 24F9'              	LHLD	RPDEL
  185B'   2B                    	DCX	H
  185C'   22 24F9'              	SHLD	RPDEL
  185F'   CD 06D9'              	CALL	SETLIN
  1862'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1865'   CD 0000*              	CALL	UNDELF		; the original comes back
  1868'   2A 0000*              	LHLD	GAPEND
  186B'   22 24FD'              	SHLD	RPGE
  186E'   C9                    	RET
  186F'                         VP_BSM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  186F'   CD 06D3'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1872'   C3 0742'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1875'                         VIINS:
  1875'   78                    	MOV	A,B
  1876'   FE 01                 	CPI	KT_ACT
  1878'   CA 18E5'              	JZ	VI_ACT
  187B'   FE 02                 	CPI	KT_CHAR
  187D'   C0                    	RNZ			; ignore anything else
  187E'   79                    	MOV	A,C
  187F'   FE 0D                 	CPI	CR
  1881'   CA 18BB'              	JZ	VI_CR
  1884'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1886'   CA 18BB'              	JZ	VI_CR
  1889'   FE 08                 	CPI	BS
  188B'   CA 18D3'              	JZ	VI_BS
  188E'   FE 7F                 	CPI	DEL
  1890'   CA 18D3'              	JZ	VI_BS
  1893'   79                    	MOV	A,C
  1894'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1897'   CD 0188'              	CALL	MARKMOD
  189A'   CD 06D9'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  189D'   79                    	MOV	A,C
  189E'   FE 20                 	CPI	' '
  18A0'   D8                    	RC			; control char -> keep R_LINE
  18A1'   FE 7F                 	CPI	DEL
  18A3'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  18A4'   CD 06FA'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  18A7'   B7                    	ORA	A
  18A8'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  18A9'   3E 04                 	MVI	A,R_ICH
  18AB'   32 24B9'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  18AE'   CD 12EB'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  18B1'   3E 00                 	MVI	A,0
  18B3'   C2 18B7'              	JNZ	VI_ICH
  18B6'   3C                    	INR	A
  18B7'                         VI_ICH:
  18B7'   32 24BB'              	STA	ICHAPP
  18BA'   C9                    	RET
  18BB'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  18BB'   CD 12EB'              	CALL	ATCEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18BE'   3E 00                 	MVI	A,0
  18C0'   CA 18C4'              	JZ	VI_CRS
  18C3'   3C                    	INR	A
  18C4'                         VI_CRS:
  18C4'   F5                    	PUSH	PSW
  18C5'   CD 12F8'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  18C8'   CD 130C'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  18CB'   CD 06DF'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  18CE'   F1                    	POP	PSW
  18CF'   32 24BC'              	STA	ILABOV
  18D2'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  18D3'                         VI_BS:
  18D3'   CD 0000*              	CALL	PEEKL
  18D6'   D8                    	RC			; start of the file: nothing to delete
  18D7'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  18D9'   CA 18DF'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  18DC'   CD 06D9'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  18DF'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  18DF'   CD 0188'              	CALL	MARKMOD
  18E2'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  18E5'                         VI_ACT:
  18E5'   79                    	MOV	A,C
  18E6'   FE 0B                 	CPI	ACT_ESC
  18E8'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  18E9'   3E 00                 	MVI	A,EM_CMD
  18EB'   32 24B4'              	STA	EDMODE
  18EE'   CD 06D3'              	CALL	SETMOV
  18F1'   CD 0742'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  18F4'   C3 0846'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  18F7'                         RDLINE:
  18F7'   EB                    	XCHG			; HL = buffer
  18F8'   22 24FF'              	SHLD	RLPTR
  18FB'   3E 00                 	MVI	A,0
  18FD'   32 2501'              	STA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1900'   78                    	MOV	A,B
  1901'   32 2502'              	STA	RLMAX
  1904'   79                    	MOV	A,C
  1905'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1908'                         RL_LP:
  1908'   CD 0000*              	CALL	GETKEY
  190B'   78                    	MOV	A,B
  190C'   FE 01                 	CPI	KT_ACT
  190E'   CA 1964'              	JZ	RL_ACT
  1911'   FE 02                 	CPI	KT_CHAR
  1913'   C2 1908'              	JNZ	RL_LP		; ignore other keys
  1916'   79                    	MOV	A,C
  1917'   FE 0D                 	CPI	CR
  1919'   CA 1975'              	JZ	RL_DONE
  191C'   FE 08                 	CPI	BS
  191E'   CA 194C'              	JZ	RL_BS
  1921'   FE 7F                 	CPI	DEL
  1923'   CA 194C'              	JZ	RL_BS
  1926'   FE 20                 	CPI	' '
  1928'   DA 1908'              	JC	RL_LP		; control char -> ignore
  192B'   3A 2501'              	LDA	RLLEN
  192E'   47                    	MOV	B,A
  192F'   3A 2502'              	LDA	RLMAX
  1932'   B8                    	CMP	B
  1933'   CA 1908'              	JZ	RL_LP		; full -> ignore
  1936'   2A 24FF'              	LHLD	RLPTR
  1939'   71                    	MOV	M,C
  193A'   23                    	INX	H
  193B'   22 24FF'              	SHLD	RLPTR
  193E'   3A 2501'              	LDA	RLLEN
  1941'   3C                    	INR	A
  1942'   32 2501'              	STA	RLLEN
  1945'   79                    	MOV	A,C
  1946'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1949'   C3 1908'              	JMP	RL_LP
  194C'                         RL_BS:				; WM LINEPOP
  194C'   3A 2501'              	LDA	RLLEN
  194F'   B7                    	ORA	A
  1950'   CA 196A'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1953'   3D                    	DCR	A
  1954'   32 2501'              	STA	RLLEN
  1957'   2A 24FF'              	LHLD	RLPTR
  195A'   2B                    	DCX	H
  195B'   22 24FF'              	SHLD	RLPTR
  195E'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1961'   C3 1908'              	JMP	RL_LP
  1964'                         RL_ACT:
  1964'   79                    	MOV	A,C
  1965'   FE 0B                 	CPI	ACT_ESC
  1967'   C2 1908'              	JNZ	RL_LP
  196A'                         RL_CAN:
  196A'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  196C'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  196F'   CD 06D9'              	CALL	SETLIN		; redraw one row
  1972'   3E FF                 	MVI	A,0FFH		; cancelled
  1974'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1975'                         RL_DONE:
  1975'   AF                    	XRA	A
  1976'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1977'                         VC_BZ:
  1977'   CD 06D3'              	CALL	SETMOV
  197A'   3A 24DD'              	LDA	GSAVE
  197D'   FE 02                 	CPI	PZ
  197F'   CA 198A'              	JZ	VZ_ZZ
  1982'   B7                    	ORA	A
  1983'   C0                    	RNZ			; 'g' was pending: vim drops both
  1984'   3E 02                 	MVI	A,PZ
  1986'   32 24DC'              	STA	GPEND
  1989'   C9                    	RET
  198A'                         VZ_ZZ:
  198A'   3E 04                 	MVI	A,EO_X
  198C'   32 2503'              	STA	EXOP
  198F'   3E 01                 	MVI	A,1
  1991'   32 2516'              	STA	EXBANG		; no '!'
  1994'   AF                    	XRA	A
  1995'   32 2504'              	STA	EXARG		; no file name
  1998'   3A 24B8'              	LDA	MODF		; as ':x': a changed text is written first
  199B'   B7                    	ORA	A
  199C'   CA 1ABF'              	JZ	EX_Q
  199F'   C3 1A59'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  19A2'                         VC_EX:
  19A2'   CD 0666'              	CALL	GETCNT
  19A5'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  19A8'   11 0000*              	LXI	D,EXBUF
  19AB'   06 28                 	MVI	B,EXMAX
  19AD'   0E 3A                 	MVI	C,':'
  19AF'   CD 18F7'              	CALL	RDLINE
  19B2'   B7                    	ORA	A
  19B3'   C0                    	RNZ			; cancelled
  19B4'   3A 2501'              	LDA	RLLEN
  19B7'   5F                    	MOV	E,A
  19B8'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19BA'   21 0000*              	LXI	H,EXBUF
  19BD'   19                    	DAD	D
  19BE'   36 00                 	MVI	M,0		; the line ends with a 0
  19C0'   21 0000*              	LXI	H,EXBUF
  19C3'   CD 1D5B'              	CALL	SKIPB
  19C6'   C8                    	RZ			; nothing on it
  19C7'   22 2506'              	SHLD	EXCMD
  19CA'   CD 1F05'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  19CD'   CD 1D5B'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  19D0'   56                    	MOV	D,M
  19D1'   23                    	INX	H
  19D2'   1E 00                 	MVI	E,0
  19D4'   CD 1D67'              	CALL	ISLOW
  19D7'   DA 19E2'              	JC	EX_LK
  19DA'   5F                    	MOV	E,A
  19DB'   23                    	INX	H
  19DC'   CD 1D67'              	CALL	ISLOW
  19DF'   D2 19FB'              	JNC	EX_NOT		; a third letter: none of ours
  19E2'                         EX_LK:
  19E2'   E5                    	PUSH	H
  19E3'   21 1EEF'              	LXI	H,EXTAB
  19E6'                         EX_TL:
  19E6'   7E                    	MOV	A,M
  19E7'   B7                    	ORA	A
  19E8'   CA 19FA'              	JZ	EX_NTP		; not in the table
  19EB'   23                    	INX	H
  19EC'   BA                    	CMP	D
  19ED'   7E                    	MOV	A,M
  19EE'   23                    	INX	H
  19EF'   C2 19F6'              	JNZ	EX_TN
  19F2'   BB                    	CMP	E
  19F3'   CA 1A01'              	JZ	EX_TF
  19F6'                         EX_TN:
  19F6'   23                    	INX	H
  19F7'   C3 19E6'              	JMP	EX_TL
  19FA'                         EX_NTP:
  19FA'   E1                    	POP	H
  19FB'                         EX_NOT:
  19FB'   21 1E1F'              	LXI	H,SNOT
  19FE'   C3 1D9C'              	JMP	EXERT
  1A01'                         EX_TF:
  1A01'   7E                    	MOV	A,M
  1A02'   32 2503'              	STA	EXOP
  1A05'   E1                    	POP	H
  1A06'   FE 06                 	CPI	EO_S
  1A08'   CA 1F74'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1A0B'   3A 255A'              	LDA	SRNGF
  1A0E'   B7                    	ORA	A
  1A0F'   C2 19FB'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1A12'   7E                    	MOV	A,M
  1A13'   D6 21                 	SUI	'!'
  1A15'   32 2516'              	STA	EXBANG		; 0 = '!'
  1A18'   C2 1A1C'              	JNZ	EX_NB
  1A1B'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A1C'                         EX_NB:
  1A1C'   CD 1D5B'              	CALL	SKIPB
  1A1F'   32 2504'              	STA	EXARG		; 0 = no file name
  1A22'   CA 1A3B'              	JZ	EX_RUN
  1A25'   22 2506'              	SHLD	EXCMD
  1A28'   3A 2503'              	LDA	EXOP
  1A2B'   FE 02                 	CPI	EO_Q
  1A2D'   CA 1D99'              	JZ	EX_TRL		; :q takes none
  1A30'   FE 07                 	CPI	EO_V
  1A32'   CA 1D99'              	JZ	EX_TRL		; nor :ve
  1A35'   CD 1CC5'              	CALL	PARSFN
  1A38'   C2 1D8D'              	JNZ	EX_INV
  1A3B'                         EX_RUN:
  1A3B'   3A 2503'              	LDA	EXOP
  1A3E'   FE 05                 	CPI	EO_E
  1A40'   CA 1AD6'              	JZ	EX_E
  1A43'   FE 02                 	CPI	EO_Q
  1A45'   CA 1ABF'              	JZ	EX_Q
  1A48'   FE 07                 	CPI	EO_V
  1A4A'   CA 1D93'              	JZ	EX_V
  1A4D'   FE 04                 	CPI	EO_X
  1A4F'   C2 1A59'              	JNZ	EX_W
  1A52'   3A 24B8'              	LDA	MODF		; :x writes only a changed text
  1A55'   B7                    	ORA	A
  1A56'   CA 1ABF'              	JZ	EX_Q
  1A59'                         EX_W:
  1A59'   CD 1B2D'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1A5C'   D8                    	RC			; refused (message shown)
  1A5D'   32 2505'              	STA	EXBAK
  1A60'   3A 2503'              	LDA	EXOP
  1A63'   FE 01                 	CPI	EO_W
  1A65'   CA 1A7C'              	JZ	EX_WK
  1A68'   3A 2505'              	LDA	EXBAK
  1A6B'   B7                    	ORA	A
  1A6C'   C2 1ABC'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1A6F'   3A 2516'              	LDA	EXBANG
  1A72'   B7                    	ORA	A
  1A73'   CA 1ABC'              	JZ	EX_WQ		; so it does with '!'
  1A76'   CD 1A7C'              	CALL	EX_WK		; else it may not: keep the text
  1A79'   C3 1ABF'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1A7C'                         EX_WK:
  1A7C'   CD 0C65'              	CALL	CURRW		; the cursor's row and file position
  1A7F'   32 2508'              	STA	WPROW
  1A82'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1A85'   7D                    	MOV	A,L
  1A86'   E6 7F                 	ANI	7FH
  1A88'   32 2509'              	STA	WPBYT
  1A8B'   7D                    	MOV	A,L
  1A8C'   17                    	RAL
  1A8D'   7C                    	MOV	A,H
  1A8E'   17                    	RAL
  1A8F'   5F                    	MOV	E,A
  1A90'   3E 00                 	MVI	A,0
  1A92'   17                    	RAL
  1A93'   57                    	MOV	D,A		; DE = HL / 128
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A94'   2A 0000*              	LHLD	OUTPOS
  1A97'   19                    	DAD	D
  1A98'   22 250A'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1A9B'   CD 1B62'              	CALL	WRITE
  1A9E'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1AA1'   2A 250A'              	LHLD	WPREC
  1AA4'   EB                    	XCHG
  1AA5'   3A 2509'              	LDA	WPBYT
  1AA8'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1AAB'   CD 0000*              	CALL	GOTO
  1AAE'   21 0000               	LXI	H,0
  1AB1'   22 0000*              	SHLD	LNDLT
  1AB4'   3A 2508'              	LDA	WPROW
  1AB7'   6F                    	MOV	L,A
  1AB8'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1ABB'   C9                    	RET
  1ABC'                         EX_WQ:
  1ABC'   CD 1B62'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1ABF'                         EX_Q:
  1ABF'   3A 2516'              	LDA	EXBANG
  1AC2'   B7                    	ORA	A
  1AC3'   CA 1ACD'              	JZ	EX_QT
  1AC6'   3A 24B8'              	LDA	MODF
  1AC9'   B7                    	ORA	A
  1ACA'   C2 1D81'              	JNZ	MSGNWR		; changed, no '!': stay
  1ACD'                         EX_QT:
  1ACD'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1AD0'   3E 01                 	MVI	A,1
  1AD2'   32 24B7'              	STA	QUITF
  1AD5'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1AD6'                         EX_E:
  1AD6'   3A 2516'              	LDA	EXBANG
  1AD9'   B7                    	ORA	A
  1ADA'   CA 1AE4'              	JZ	EE_GO
  1ADD'   3A 24B8'              	LDA	MODF
  1AE0'   B7                    	ORA	A
  1AE1'   C2 1D81'              	JNZ	MSGNWR
  1AE4'                         EE_GO:
  1AE4'   3A 2504'              	LDA	EXARG
  1AE7'   B7                    	ORA	A
  1AE8'   C2 1AEF'              	JNZ	EE_ARG
  1AEB'   CD 1B9E'              	CALL	OWNTF		; no name: the buffer's own
  1AEE'   D8                    	RC
  1AEF'                         EE_ARG:
  1AEF'   CD 1BB4'              	CALL	ISOWN
  1AF2'   21 0001               	LXI	H,1
  1AF5'   C2 1AFC'              	JNZ	EE_LD		; another file: its first line
  1AF8'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1AFB'   23                    	INX	H		; HL = the cursor's line
  1AFC'                         EE_LD:
  1AFC'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1AFE'   32 2514'              	STA	MSGWHT
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B01'   E5                    	PUSH	H
  1B02'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1B05'   21 0000*              	LXI	H,TFCB
  1B08'   11 0000*              	LXI	D,FNAME
  1B0B'   CD 1BC6'              	CALL	COPY12		; the buffer's name
  1B0E'   CD 1B8B'              	CALL	SRCTF
  1B11'   CD 0000*              	CALL	REOPEN
  1B14'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1B17'   AF                    	XRA	A
  1B18'   32 24B8'              	STA	MODF
  1B1B'   E1                    	POP	H
  1B1C'   2B                    	DCX	H
  1B1D'   AF                    	XRA	A
  1B1E'   CD 0000*              	CALL	MVLIND		; down to the line
  1B21'   CD 097D'              	CALL	ATEOF
  1B24'   DC 0983'              	CC	LASTLN		; past the last line: onto it
  1B27'   CD 0E84'              	CALL	ZSAVE
  1B2A'   C3 0F6D'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1B2D'                         WRCHK:
  1B2D'   3A 2504'              	LDA	EXARG
  1B30'   B7                    	ORA	A
  1B31'   C2 1B3B'              	JNZ	WC_ARG
  1B34'   CD 1B9E'              	CALL	OWNTF
  1B37'   D8                    	RC
  1B38'   C3 1B50'              	JMP	WC_OWN
  1B3B'                         WC_ARG:
  1B3B'   CD 1BB4'              	CALL	ISOWN
  1B3E'   CA 1B50'              	JZ	WC_OWN
  1B41'   3A 2516'              	LDA	EXBANG
  1B44'   B7                    	ORA	A
  1B45'   CA 1B4E'              	JZ	WC_OTH
  1B48'   CD 0000*              	CALL	TEXIST
  1B4B'   C2 1D75'              	JNZ	MSGEXI		; File exists (! to force)
  1B4E'                         WC_OTH:
  1B4E'   AF                    	XRA	A		; (NC)
  1B4F'   C9                    	RET
  1B50'                         WC_OWN:
  1B50'   3A 2517'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1B53'   B7                    	ORA	A
  1B54'   CA 1B5E'              	JZ	WC_OK
  1B57'   3A 2516'              	LDA	EXBANG
  1B5A'   B7                    	ORA	A
  1B5B'   C2 1D7B'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1B5E'                         WC_OK:
  1B5E'   3E 01                 	MVI	A,1
  1B60'   B7                    	ORA	A		; (NC)
  1B61'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1B62'                         WRITE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B62'   3A 2505'              	LDA	EXBAK
  1B65'   CD 0000*              	CALL	WRTO
  1B68'   3A 0001*              	LDA	FNAME+1
  1B6B'   FE 20                 	CPI	' '
  1B6D'   C2 1B79'              	JNZ	WR_HAS
  1B70'   21 0000*              	LXI	H,TFCB
  1B73'   11 0000*              	LXI	D,FNAME
  1B76'   CD 1BC6'              	CALL	COPY12
  1B79'                         WR_HAS:
  1B79'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1B7B'   32 2514'              	STA	MSGWHT
  1B7E'   CD 1BB4'              	CALL	ISOWN
  1B81'   C2 1B8B'              	JNZ	SRCTF
  1B84'   AF                    	XRA	A
  1B85'   32 24B8'              	STA	MODF
  1B88'   32 2515'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1B8B'                         SRCTF:
  1B8B'   21 0000*              	LXI	H,TFCB
  1B8E'   11 005C               	LXI	D,DFTFCB
  1B91'   CD 1BC6'              	CALL	COPY12
  1B94'   AF                    	XRA	A
  1B95'   06 04                 	MVI	B,4
  1B97'                         SRC_Z:
  1B97'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1B98'   13                    	INX	D
  1B99'   05                    	DCR	B
  1B9A'   C2 1B97'              	JNZ	SRC_Z
  1B9D'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1B9E'                         OWNTF:
  1B9E'   3A 0001*              	LDA	FNAME+1
  1BA1'   FE 20                 	CPI	' '
  1BA3'   CA 1D6F'              	JZ	MSGNFN
  1BA6'   CD 1BD1'              	CALL	TFCLR
  1BA9'   21 0000*              	LXI	H,FNAME
  1BAC'   11 0000*              	LXI	D,TFCB
  1BAF'   CD 1BC6'              	CALL	COPY12
  1BB2'   B7                    	ORA	A		; (NC)
  1BB3'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1BB4'                         ISOWN:
  1BB4'   21 0000*              	LXI	H,TFCB
  1BB7'   11 0000*              	LXI	D,FNAME
  1BBA'   06 0C                 	MVI	B,12
  1BBC'                         IO_LP:
  1BBC'   1A                    	LDAX	D
  1BBD'   BE                    	CMP	M
  1BBE'   C0                    	RNZ
  1BBF'   23                    	INX	H
  1BC0'   13                    	INX	D
  1BC1'   05                    	DCR	B
  1BC2'   C2 1BBC'              	JNZ	IO_LP
  1BC5'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1BC6'                         COPY12:
  1BC6'   06 0C                 	MVI	B,12
  1BC8'                         CP_LP:
  1BC8'   7E                    	MOV	A,M
  1BC9'   12                    	STAX	D
  1BCA'   23                    	INX	H
  1BCB'   13                    	INX	D
  1BCC'   05                    	DCR	B
  1BCD'   C2 1BC8'              	JNZ	CP_LP
  1BD0'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1BD1'                         TFCLR:
  1BD1'   11 0000*              	LXI	D,TFCB
  1BD4'   06 24                 	MVI	B,36
  1BD6'   AF                    	XRA	A
  1BD7'                         TC_LP:
  1BD7'   12                    	STAX	D
  1BD8'   13                    	INX	D
  1BD9'   05                    	DCR	B
  1BDA'   C2 1BD7'              	JNZ	TC_LP
  1BDD'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1BDE'                         FOPEN:
  1BDE'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1BE0'   32 2514'              	STA	MSGWHT
  1BE3'   21 005C               	LXI	H,DFTFCB
  1BE6'   CD 1CB8'              	CALL	NRMDRV
  1BE9'   11 0000*              	LXI	D,FNAME
  1BEC'   CD 1BC6'              	CALL	COPY12
  1BEF'   CD 0000*              	CALL	OPENZ
  1BF2'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1BF5'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1BF7'   C8                    	RZ
  1BF8'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1BFB'   32 2515'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1BFE'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1BFF'                         ARGSCN:
  1BFF'   3A 0080               	LDA	CMDTAIL
  1C02'   47                    	MOV	B,A		; B = what is left of the line
  1C03'   B7                    	ORA	A
  1C04'   C8                    	RZ
  1C05'   21 0081               	LXI	H,CMDTAIL+1
  1C08'                         AS_TOK:				; at a token, or the blanks before one
  1C08'   7E                    	MOV	A,M
  1C09'   FE 20                 	CPI	' '
  1C0B'   C2 1C14'              	JNZ	AS_OPT
  1C0E'   23                    	INX	H
  1C0F'   05                    	DCR	B
  1C10'   C2 1C08'              	JNZ	AS_TOK
  1C13'   C9                    	RET
  1C14'                         AS_OPT:
  1C14'   FE 2B                 	CPI	'+'
  1C16'   CA 1C40'              	JZ	AS_PLS
  1C19'   FE 2D                 	CPI	'-'
  1C1B'   CA 1C2F'              	JZ	AS_SW
  1C1E'   FE 2F                 	CPI	'/'
  1C20'   CA 1C2F'              	JZ	AS_SW
  1C23'                         AS_SKP:				; not ours (the file name): on to the next one
  1C23'   23                    	INX	H
  1C24'   05                    	DCR	B
  1C25'   C8                    	RZ
  1C26'   7E                    	MOV	A,M
  1C27'   FE 20                 	CPI	' '
  1C29'   C2 1C23'              	JNZ	AS_SKP
  1C2C'   C3 1C08'              	JMP	AS_TOK
  1C2F'                         AS_SW:
  1C2F'   23                    	INX	H
  1C30'   05                    	DCR	B
  1C31'   C8                    	RZ
  1C32'   7E                    	MOV	A,M
  1C33'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1C35'   FE 52                 	CPI	'R'
  1C37'   C2 1C23'              	JNZ	AS_SKP
  1C3A'   32 2517'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1C3D'   C3 1C23'              	JMP	AS_SKP
  1C40'                         AS_PLS:
  1C40'   3E 01                 	MVI	A,1
  1C42'   32 2518'              	STA	PLUSF		; '+' gets the line even with no number on it
  1C45'   11 0000*              	LXI	D,PLUSB
  1C48'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1C4A'   23                    	INX	H		;   line space, so it is taken as '+' alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C4B'   05                    	DCR	B
  1C4C'   CA 1C83'              	JZ	AS_PE
  1C4F'   7E                    	MOV	A,M
  1C50'   FE 30                 	CPI	'0'
  1C52'   C2 1C6A'              	JNZ	AS_PD
  1C55'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1C55'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1C56'   05                    	DCR	B
  1C57'   CA 1C8B'              	JZ	AS_P1
  1C5A'   7E                    	MOV	A,M
  1C5B'   FE 30                 	CPI	'0'
  1C5D'   CA 1C55'              	JZ	AS_PZ
  1C60'   FE 31                 	CPI	'1'
  1C62'   DA 1C8B'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1C65'   FE 3A                 	CPI	'9'+1
  1C67'   D2 1C8B'              	JNC	AS_P1
  1C6A'                         AS_PD:				; the digits, as typed
  1C6A'   7E                    	MOV	A,M
  1C6B'   FE 30                 	CPI	'0'
  1C6D'   DA 1C83'              	JC	AS_PE
  1C70'   FE 3A                 	CPI	'9'+1
  1C72'   D2 1C83'              	JNC	AS_PE
  1C75'   79                    	MOV	A,C
  1C76'   B7                    	ORA	A
  1C77'   CA 1C92'              	JZ	AS_POV
  1C7A'   0D                    	DCR	C
  1C7B'   7E                    	MOV	A,M
  1C7C'   12                    	STAX	D
  1C7D'   13                    	INX	D
  1C7E'   23                    	INX	H
  1C7F'   05                    	DCR	B
  1C80'   C2 1C6A'              	JNZ	AS_PD
  1C83'                         AS_PE:
  1C83'   AF                    	XRA	A
  1C84'   12                    	STAX	D		; the digits end with a 0
  1C85'   78                    	MOV	A,B
  1C86'   B7                    	ORA	A
  1C87'   C8                    	RZ
  1C88'   C3 1C08'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1C8B'                         AS_P1:
  1C8B'   3E 31                 	MVI	A,'1'
  1C8D'   12                    	STAX	D
  1C8E'   13                    	INX	D
  1C8F'   C3 1C83'              	JMP	AS_PE
  1C92'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1C92'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1C95'   C3 1C83'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1C98'                         ARGGO:
  1C98'   3A 2518'              	LDA	PLUSF
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C9B'   B7                    	ORA	A
  1C9C'   C8                    	RZ
  1C9D'   21 0000*              	LXI	H,PLUSB
  1CA0'                         AG_LP:
  1CA0'   7E                    	MOV	A,M
  1CA1'   B7                    	ORA	A
  1CA2'   CA 1CB1'              	JZ	AG_G
  1CA5'   4F                    	MOV	C,A
  1CA6'   06 02                 	MVI	B,KT_CHAR
  1CA8'   E5                    	PUSH	H
  1CA9'   CD 001F'              	CALL	VICMD
  1CAC'   E1                    	POP	H
  1CAD'   23                    	INX	H
  1CAE'   C3 1CA0'              	JMP	AG_LP
  1CB1'                         AG_G:
  1CB1'   0E 47                 	MVI	C,'G'
  1CB3'   06 02                 	MVI	B,KT_CHAR
  1CB5'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1CB8'                         NRMDRV:
  1CB8'   7E                    	MOV	A,M
  1CB9'   B7                    	ORA	A
  1CBA'   C0                    	RNZ
  1CBB'   E5                    	PUSH	H
  1CBC'   0E 19                 	MVI	C,BF_CURDSK
  1CBE'   CD 0005               	CALL	BDOS
  1CC1'   E1                    	POP	H
  1CC2'   3C                    	INR	A
  1CC3'   77                    	MOV	M,A
  1CC4'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1CC5'                         PARSFN:
  1CC5'   CD 1BD1'              	CALL	TFCLR
  1CC8'   11 0000*              	LXI	D,TFCB
  1CCB'   23                    	INX	H
  1CCC'   7E                    	MOV	A,M
  1CCD'   2B                    	DCX	H
  1CCE'   FE 3A                 	CPI	':'
  1CD0'   C2 1CE2'              	JNZ	PF_NM
  1CD3'   CD 1D28'              	CALL	GETFNC
  1CD6'   CA 1CE2'              	JZ	PF_NM
  1CD9'   D6 40                 	SUI	40H
  1CDB'   12                    	STAX	D
  1CDC'   FE 11                 	CPI	17
  1CDE'   D2 1D06'              	JNC	PF_BAD
  1CE1'   23                    	INX	H
  1CE2'                         PF_NM:
  1CE2'   13                    	INX	D
  1CE3'   0E 08                 	MVI	C,8
  1CE5'   CD 1D0A'              	CALL	CPYNAM
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CE8'   FE 2E                 	CPI	'.'
  1CEA'   0E 03                 	MVI	C,3
  1CEC'   C4 1D1D'              	CNZ	PADFLD		; no type: blanks
  1CEF'   CC 1D09'              	CZ	CPYNM0		; '.': the type
  1CF2'   3A 0001*              	LDA	TFCB+1
  1CF5'   FE 20                 	CPI	' '
  1CF7'   CA 1D06'              	JZ	PF_BAD		; no name
  1CFA'   CD 1D5B'              	CALL	SKIPB
  1CFD'   C0                    	RNZ			; more after it
  1CFE'   21 0000*              	LXI	H,TFCB
  1D01'   CD 1CB8'              	CALL	NRMDRV
  1D04'   AF                    	XRA	A
  1D05'   C9                    	RET
  1D06'                         PF_BAD:
  1D06'   F6 01                 	ORI	1
  1D08'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1D09'                         CPYNM0:
  1D09'   23                    	INX	H
  1D0A'                         CPYNAM:
  1D0A'   CD 1D28'              	CALL	GETFNC
  1D0D'   CA 1D1D'              	JZ	PADFLD
  1D10'   12                    	STAX	D
  1D11'   13                    	INX	D
  1D12'   0D                    	DCR	C
  1D13'   C2 1D0A'              	JNZ	CPYNAM
  1D16'                         CN_SKP:
  1D16'   CD 1D28'              	CALL	GETFNC
  1D19'   C2 1D16'              	JNZ	CN_SKP
  1D1C'   C9                    	RET
  1D1D'                         PADFLD:
  1D1D'   F5                    	PUSH	PSW
  1D1E'                         PD_LP:
  1D1E'   3E 20                 	MVI	A,' '
  1D20'   12                    	STAX	D
  1D21'   13                    	INX	D
  1D22'   0D                    	DCR	C
  1D23'   C2 1D1E'              	JNZ	PD_LP
  1D26'   F1                    	POP	PSW
  1D27'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1D28'                         GETFNC:
  1D28'   7E                    	MOV	A,M
  1D29'   FE 3D                 	CPI	'='
  1D2B'   C8                    	RZ
  1D2C'   FE 5F                 	CPI	'_'
  1D2E'   C8                    	RZ
  1D2F'   FE 3B                 	CPI	';'
  1D31'   C8                    	RZ
  1D32'   FE 3C                 	CPI	'<'
  1D34'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D35'   FE 3E                 	CPI	'>'
  1D37'   C8                    	RZ
  1D38'   FE 2E                 	CPI	'.'
  1D3A'   C8                    	RZ
  1D3B'   FE 3A                 	CPI	':'
  1D3D'   C8                    	RZ
  1D3E'   FE 2A                 	CPI	'*'
  1D40'   C8                    	RZ
  1D41'   FE 3F                 	CPI	'?'
  1D43'   C8                    	RZ
  1D44'   FE 20                 	CPI	' '
  1D46'   DA 1D59'              	JC	GF_CTL
  1D49'   C8                    	RZ
  1D4A'   23                    	INX	H
  1D4B'   FE 61                 	CPI	'a'
  1D4D'   DA 1D57'              	JC	GF_DN
  1D50'   FE 7B                 	CPI	'z'+1
  1D52'   D2 1D57'              	JNC	GF_DN
  1D55'   E6 DF                 	ANI	0DFH
  1D57'                         GF_DN:
  1D57'   B7                    	ORA	A
  1D58'   C9                    	RET
  1D59'                         GF_CTL:
  1D59'   BF                    	CMP	A
  1D5A'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1D5B'                         SKIPB:
  1D5B'   7E                    	MOV	A,M
  1D5C'   FE 20                 	CPI	' '
  1D5E'   C2 1D65'              	JNZ	SB_DN
  1D61'   23                    	INX	H
  1D62'   C3 1D5B'              	JMP	SKIPB
  1D65'                         SB_DN:
  1D65'   B7                    	ORA	A
  1D66'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1D67'                         ISLOW:
  1D67'   7E                    	MOV	A,M
  1D68'   FE 61                 	CPI	'a'
  1D6A'   D8                    	RC
  1D6B'   FE 7B                 	CPI	'z'+1
  1D6D'   3F                    	CMC
  1D6E'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1D6F'                         MSGNFN:
  1D6F'   21 1DBC'              	LXI	H,SNFN
  1D72'   C3 1DA7'              	JMP	EXERR
  1D75'                         MSGEXI:
  1D75'   21 1DD6'              	LXI	H,SEXI
  1D78'   C3 1D84'              	JMP	EXBNG
  1D7B'                         MSGRO:
  1D7B'   21 1DE2'              	LXI	H,SRO
  1D7E'   C3 1D84'              	JMP	EXBNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D81'                         MSGNWR:
  1D81'   21 1DC9'              	LXI	H,SNWR
  1D84'                         EXBNG:
  1D84'   CD 1DA7'              	CALL	EXERR
  1D87'   21 1DEE'              	LXI	H,SBNG
  1D8A'   C3 1DA2'              	JMP	EXOUT
  1D8D'                         EX_INV:
  1D8D'   21 1DFC'              	LXI	H,SINV
  1D90'   C3 1DA7'              	JMP	EXERR
  1D93'                         EX_V:				; :ve -- the version, on the bottom row
  1D93'   21 1DB7'              	LXI	H,SVER
  1D96'   C3 1DA7'              	JMP	EXERR
  1D99'                         EX_TRL:
  1D99'   21 1E0E'              	LXI	H,STRL
  1D9C'                         EXERT:				; the message, then the text at EXCMD
  1D9C'   CD 1DA7'              	CALL	EXERR
  1D9F'   2A 2506'              	LHLD	EXCMD
  1DA2'                         EXOUT:
  1DA2'   CD 0000*              	CALL	OUTSTR
  1DA5'   37                    	STC
  1DA6'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1DA7'                         EXERR:
  1DA7'   E5                    	PUSH	H
  1DA8'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1DA9'   32 2514'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1DAC'   E1                    	POP	H
  1DAD'   CD 0000*              	CALL	EXMSG
  1DB0'   3E 01                 	MVI	A,R_MOVE
  1DB2'   32 24B9'              	STA	RINTENT
  1DB5'   37                    	STC
  1DB6'   C9                    	RET
                                
