  1063'   05                    	DCR	B
  1064'   37                    	STC
  1065'   C8                    	RZ
  1066'   3A 2F1E'              	LDA	OVDIR
  1069'   B7                    	ORA	A		; (CY off)
  106A'   CA 106F'              	JZ	OV_UP
  106D'   23                    	INX	H
  106E'   23                    	INX	H
  106F'                         OV_UP:
  106F'   2B                    	DCX	H
  1070'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  1071'                         PGROWS:
  1071'   2A 2F1B'              	LHLD	RWR
  1074'   CD 107F'              	CALL	MULSAT
  1077'   22 2F1B'              	SHLD	RWR
  107A'   AF                    	XRA	A
  107B'   32 2F1D'              	STA	RWMV
  107E'   C9                    	RET
