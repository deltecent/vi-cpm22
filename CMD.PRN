  06FF'   CD 0000*              	CALL	SUBHD
  0702'   EB                    	XCHG			; DE = how far past the gap it is
  0703'   2A 0000*              	LHLD	GAPEND
  0706'   19                    	DAD	D
  0707'   D1                    	POP	D
  0708'   C3 070E'              	JMP	ENL_S
  070B'                         ENL_G:
  070B'   2A 0000*              	LHLD	GAPEND
  070E'                         ENL_S:
  070E'   E5                    	PUSH	H
  070F'   2A 0000*              	LHLD	TXTEND
  0712'   44                    	MOV	B,H
