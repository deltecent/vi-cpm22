  0C54'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C57'   DA 0C63'              	JC	ES_CL
  0C5A'   CA 0C63'              	JZ	ES_CL
  0C5D'   2A 26CF'              	LHLD	WKI
  0C60'   C3 055D'              	JMP	GOSET
  0C63'                         ES_CL:
  0C63'   2A 26D1'              	LHLD	WKN
  0C66'   7C                    	MOV	A,H
  0C67'   B5                    	ORA	L
  0C68'   C8                    	RZ
  0C69'   2B                    	DCX	H
  0C6A'   C3 055D'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C6D'                         CURRW:
  0C6D'   2A 0000*              	LHLD	WINROW
  0C70'   EB                    	XCHG
  0C71'   2A 0000*              	LHLD	LNDLT
  0C74'   19                    	DAD	D		; HL = row (signed)
  0C75'   7C                    	MOV	A,H
  0C76'   B7                    	ORA	A
  0C77'   FA 0C8A'              	JM	CRW_0		; above the screen -> top row
  0C7A'   C2 0C85'              	JNZ	CRW_BT		; far below -> bottom row
  0C7D'   3A 0000*              	LDA	NEDIT
  0C80'   3D                    	DCR	A		; A = bottom row
  0C81'   BD                    	CMP	L		; CY iff bottom < row
  0C82'   D8                    	RC
  0C83'   7D                    	MOV	A,L
  0C84'   C9                    	RET
  0C85'                         CRW_BT:
  0C85'   3A 0000*              	LDA	NEDIT
  0C88'   3D                    	DCR	A
  0C89'   C9                    	RET
  0C8A'                         CRW_0:
  0C8A'   AF                    	XRA	A
  0C8B'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C8C'                         SETRWT:
  0C8C'   2A 0000*              	LHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C8F'   EB                    	XCHG
  0C90'   6F                    	MOV	L,A
  0C91'   26 00                 	MVI	H,0
  0C93'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C96'   22 0000*              	SHLD	WINROW
  0C99'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C9A'                         MVROW:
  0C9A'   47                    	MOV	B,A
  0C9B'   CD 0C6D'              	CALL	CURRW
  0C9E'   90                    	SUB	B		; A = row now - target
  0C9F'   C8                    	RZ
  0CA0'   DA 0CA9'              	JC	MR_DN
  0CA3'   6F                    	MOV	L,A
  0CA4'   26 00                 	MVI	H,0
  0CA6'   C3 08F4'              	JMP	KCORE
  0CA9'                         MR_DN:
  0CA9'   2F                    	CMA
  0CAA'   3C                    	INR	A		; A = target - row now
  0CAB'   6F                    	MOV	L,A
  0CAC'   26 00                 	MVI	H,0
  0CAE'   C3 0857'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CB1'                         VC_HIGH:
  0CB1'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CB4'   2B                    	DCX	H		; row = count - 1
  0CB5'   7C                    	MOV	A,H
  0CB6'   B7                    	ORA	A
  0CB7'   3A 0000*              	LDA	SCBOT
  0CBA'   C2 0CC2'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CBD'   BD                    	CMP	L		; CY iff SCBOT < row
  0CBE'   DA 0CC2'              	JC	VH_GO
  0CC1'   7D                    	MOV	A,L
  0CC2'                         VH_GO:
  0CC2'   CD 0C9A'              	CALL	MVROW
  0CC5'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CC8'                         VC_MIDL:
  0CC8'   CD 065B'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CCB'   3A 0000*              	LDA	SCBOT
  0CCE'   B7                    	ORA	A		; clear CY for the shift
  0CCF'   1F                    	RAR			; A = SCBOT / 2
  0CD0'   CD 0C9A'              	CALL	MVROW
  0CD3'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CD6'                         VC_LOWL:
  0CD6'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CD9'   2B                    	DCX	H		; count - 1
  0CDA'   3A 0000*              	LDA	SCBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CDD'   5F                    	MOV	E,A
  0CDE'   16 00                 	MVI	D,0
  0CE0'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CE1'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CE4'   3E 00                 	MVI	A,0
  0CE6'   D2 0CED'              	JNC	VL_GO		; at or past the top -> row 0
  0CE9'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CEC'   7D                    	MOV	A,L
  0CED'                         VL_GO:
  0CED'   CD 0C9A'              	CALL	MVROW
  0CF0'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CF3'                         VC_PGDN:
  0CF3'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0CF6'   3A 0000*              	LDA	SCEOF
  0CF9'   B7                    	ORA	A
  0CFA'   CA 0D08'              	JZ	VPD_N
  0CFD'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D00'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D01'   C8                    	RZ			; it already is
  0D02'   CD 0C9A'              	CALL	MVROW
  0D05'   C3 0D19'              	JMP	VPD_TP
  0D08'                         VPD_N:
  0D08'   3A 0000*              	LDA	NEDIT
  0D0B'   D6 02                 	SUI	2
  0D0D'   CD 0D61'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D10'   E5                    	PUSH	H
  0D11'   AF                    	XRA	A
  0D12'   CD 0C9A'              	CALL	MVROW		; the top line
  0D15'   E1                    	POP	H
  0D16'   CD 0857'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D19'                         VPD_TP:
  0D19'   AF                    	XRA	A
  0D1A'   CD 0C8C'              	CALL	SETRWT		; to the top row
  0D1D'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D20'                         VC_PGUP:
  0D20'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  0D23'   3A 0000*              	LDA	SCBOF
  0D26'   B7                    	ORA	A
  0D27'   C0                    	RNZ
  0D28'   3A 0000*              	LDA	NEDIT
  0D2B'   47                    	MOV	B,A
  0D2C'   3A 0000*              	LDA	SCEOF
  0D2F'   B7                    	ORA	A
  0D30'   CA 0D41'              	JZ	VPU_2
  0D33'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D36'   FE 02                 	CPI	2
  0D38'   D2 0D41'              	JNC	VPU_2
  0D3B'   2F                    	CMA
  0D3C'   3C                    	INR	A
  0D3D'   80                    	ADD	B
  0D3E'   C3 0D44'              	JMP	VPU_P
  0D41'                         VPU_2:
  0D41'   78                    	MOV	A,B
  0D42'   D6 02                 	SUI	2
  0D44'                         VPU_P:
  0D44'   CD 0D61'              	CALL	MULSAT		; HL = count * page
  0D47'   E5                    	PUSH	H
  0D48'   AF                    	XRA	A
  0D49'   CD 0C9A'              	CALL	MVROW		; the top line
  0D4C'   E1                    	POP	H
  0D4D'   CD 08F4'              	CALL	KCORE		; the new top line
  0D50'   AF                    	XRA	A
  0D51'   CD 0C8C'              	CALL	SETRWT		; on the top row
  0D54'   3A 0000*              	LDA	NEDIT
  0D57'   3D                    	DCR	A
  0D58'   6F                    	MOV	L,A
  0D59'   26 00                 	MVI	H,0
  0D5B'   CD 0857'              	CALL	JCORE		; the bottom row's line
  0D5E'   C3 07A9'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D61'                         MULSAT:
  0D61'   EB                    	XCHG
  0D62'   21 0000               	LXI	H,0
  0D65'   B7                    	ORA	A
  0D66'   C8                    	RZ
  0D67'                         MS_LP:
  0D67'   19                    	DAD	D
  0D68'   DA 0D70'              	JC	MS_SAT
  0D6B'   3D                    	DCR	A
  0D6C'   C2 0D67'              	JNZ	MS_LP
  0D6F'   C9                    	RET
  0D70'                         MS_SAT:
  0D70'   21 FFFF               	LXI	H,0FFFFH
  0D73'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D74'                         VC_HFDN:
  0D74'   CD 06DB'              	CALL	SETMOV
  0D77'   CD 0C6D'              	CALL	CURRW
  0D7A'   32 2695'              	STA	HFROW
  0D7D'   CD 0DEB'              	CALL	HFCNT		; HL = lines
  0D80'   3A 2695'              	LDA	HFROW
  0D83'   47                    	MOV	B,A
  0D84'   3A 0000*              	LDA	SCEOF
  0D87'   B7                    	ORA	A
  0D88'   CA 0D90'              	JZ	VHD_GO
  0D8B'   3A 0000*              	LDA	SCBOT		; the last line's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D8E'   B8                    	CMP	B
  0D8F'   C8                    	RZ			; the cursor is on it
  0D90'                         VHD_GO:
  0D90'   CD 0857'              	CALL	JCORE
  0D93'   3A 0000*              	LDA	SCEOF
  0D96'   B7                    	ORA	A
  0D97'   C2 07A9'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D9A'   3A 2695'              	LDA	HFROW
  0D9D'   CD 0C8C'              	CALL	SETRWT
  0DA0'   3E 01                 	MVI	A,1
  0DA2'   32 0000*              	STA	WFILL		; not past the end of the file
  0DA5'   C3 07A9'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DA8'                         VC_HFUP:
  0DA8'   CD 06DB'              	CALL	SETMOV
  0DAB'   CD 0C6D'              	CALL	CURRW
  0DAE'   32 2695'              	STA	HFROW
  0DB1'   CD 0DEB'              	CALL	HFCNT		; HL = lines
  0DB4'   CD 0DCB'              	CALL	ONFST
  0DB7'   C8                    	RZ			; the cursor is on the first line
  0DB8'   CD 08F4'              	CALL	KCORE
  0DBB'   3A 0000*              	LDA	SCBOF
  0DBE'   B7                    	ORA	A
  0DBF'   C2 07A9'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DC2'   3A 2695'              	LDA	HFROW
  0DC5'   CD 0C8C'              	CALL	SETRWT
  0DC8'   C3 07A9'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DCB'                         ONFST:
  0DCB'   E5                    	PUSH	H
  0DCC'   2A 0000*              	LHLD	OUTPOS
  0DCF'   7C                    	MOV	A,H
  0DD0'   B5                    	ORA	L
  0DD1'   C2 0DE9'              	JNZ	OF_RET
  0DD4'   2A 0000*              	LHLD	TXTBEG
  0DD7'   EB                    	XCHG			; DE = TXTBEG
  0DD8'   2A 0000*              	LHLD	GAPBEG
  0DDB'                         OF_LP:
  0DDB'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DDE'   CA 0DE9'              	JZ	OF_RET
  0DE1'   2B                    	DCX	H
  0DE2'   7E                    	MOV	A,M
  0DE3'   FE 0A                 	CPI	LF
  0DE5'   C2 0DDB'              	JNZ	OF_LP
  0DE8'   B7                    	ORA	A		; NZ
  0DE9'                         OF_RET:
  0DE9'   E1                    	POP	H
  0DEA'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DEB'                         HFCNT:
  0DEB'   2A 2689'              	LHLD	CMDCNT
  0DEE'   7C                    	MOV	A,H
  0DEF'   B5                    	ORA	L
  0DF0'   CA 0E07'              	JZ	HFC_AM
  0DF3'   CD 066E'              	CALL	GETCNT		; HL = count; clears it
  0DF6'   3A 0000*              	LDA	NEDIT
  0DF9'   5F                    	MOV	E,A
  0DFA'   16 00                 	MVI	D,0
  0DFC'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0DFF'   D2 0E03'              	JNC	HFC_ST
  0E02'   EB                    	XCHG			; HL = NEDIT
  0E03'                         HFC_ST:
  0E03'   7D                    	MOV	A,L
  0E04'   32 2696'              	STA	HFAMT
  0E07'                         HFC_AM:
  0E07'   3A 2696'              	LDA	HFAMT
  0E0A'   B7                    	ORA	A
  0E0B'   C2 0E18'              	JNZ	HFC_HL
  0E0E'   3A 0000*              	LDA	NEDIT
  0E11'   B7                    	ORA	A
  0E12'   1F                    	RAR
  0E13'   B7                    	ORA	A
  0E14'   C2 0E18'              	JNZ	HFC_HL
  0E17'   3C                    	INR	A		; at least one line
  0E18'                         HFC_HL:
  0E18'   6F                    	MOV	L,A
  0E19'   26 00                 	MVI	H,0
  0E1B'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E1C'                         VC_REDR:
  0E1C'   C3 066E'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E1F'                         VC_G:
  0E1F'   CD 06DB'              	CALL	SETMOV
  0E22'   CD 0EBF'              	CALL	GZONE		; the screen's top line, before the move
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E25'   2A 2689'              	LHLD	CMDCNT
  0E28'   7C                    	MOV	A,H
  0E29'   B5                    	ORA	L
  0E2A'   C2 0E37'              	JNZ	VG_N
  0E2D'   AF                    	XRA	A		; forward
  0E2E'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E31'   CD 098B'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E34'   C3 0ED7'              	JMP	GPLACE
  0E37'                         VG_N:
  0E37'   CD 066E'              	CALL	GETCNT		; HL = target line (1-based)
  0E3A'                         VG_LN:
  0E3A'   CD 0E40'              	CALL	GOLN
  0E3D'   C3 0ED7'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E40'                         GOLN:
  0E40'   2B                    	DCX	H		; lines to move from line 1
  0E41'   E5                    	PUSH	H
  0E42'   3E FF                 	MVI	A,0FFH
  0E44'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E47'   E1                    	POP	H
  0E48'   AF                    	XRA	A
  0E49'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E4C'   CD 0985'              	CALL	ATEOF
  0E4F'   DC 098B'              	CC	LASTLN		; past the last line: onto it
  0E52'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E53'                         VC_LG:
  0E53'   CD 06DB'              	CALL	SETMOV
  0E56'   3A 26B1'              	LDA	GSAVE
  0E59'   B7                    	ORA	A
  0E5A'   C2 0E63'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E5D'   3E 01                 	MVI	A,PG
  0E5F'   32 26B0'              	STA	GPEND
  0E62'   C9                    	RET
  0E63'                         VLG_GG:
  0E63'   CD 0EBF'              	CALL	GZONE
  0E66'   CD 066E'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E69'   C3 0E3A'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E6C'                         SUB24:
  0E6C'   4F                    	MOV	C,A
  0E6D'   7D                    	MOV	A,L
  0E6E'   93                    	SUB	E
  0E6F'   6F                    	MOV	L,A
  0E70'   7C                    	MOV	A,H
  0E71'   9A                    	SBB	D
  0E72'   67                    	MOV	H,A
  0E73'   79                    	MOV	A,C
  0E74'   98                    	SBB	B
  0E75'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E76'                         CURFP:
  0E76'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E79'                         FPOS:
  0E79'   C5                    	PUSH	B
  0E7A'   D5                    	PUSH	D
  0E7B'   EB                    	XCHG
  0E7C'   2A 0000*              	LHLD	TXTBEG
  0E7F'   EB                    	XCHG
  0E80'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E83'   EB                    	XCHG			; DE = that
  0E84'   2A 0000*              	LHLD	OUTPOS
  0E87'   7C                    	MOV	A,H
  0E88'   B7                    	ORA	A		; CY = 0
  0E89'   1F                    	RAR
  0E8A'   47                    	MOV	B,A
  0E8B'   7D                    	MOV	A,L
  0E8C'   1F                    	RAR
  0E8D'   67                    	MOV	H,A
  0E8E'   3E 00                 	MVI	A,0
  0E90'   1F                    	RAR
  0E91'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E92'   19                    	DAD	D
  0E93'   78                    	MOV	A,B
  0E94'   CE 00                 	ACI	0		; A:HL = the position
  0E96'   D1                    	POP	D
  0E97'   C1                    	POP	B
  0E98'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E99'                         ZSAVE:
  0E99'   2A 2689'              	LHLD	CMDCNT
  0E9C'   22 26EF'              	SHLD	ZSVCNT
  0E9F'   2A 0000*              	LHLD	AUXCNT
  0EA2'   22 26F1'              	SHLD	ZSVAUX
  0EA5'   3A 0000*              	LDA	DIRFLG
  0EA8'   32 26F3'              	STA	ZSVDIR
  0EAB'   C9                    	RET
  0EAC'                         ZREST:
  0EAC'   2A 26EF'              	LHLD	ZSVCNT
  0EAF'   22 2689'              	SHLD	CMDCNT
  0EB2'   2A 26F1'              	LHLD	ZSVAUX
  0EB5'   22 0000*              	SHLD	AUXCNT
  0EB8'   3A 26F3'              	LDA	ZSVDIR
  0EBB'   32 0000*              	STA	DIRFLG
  0EBE'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EBF'                         GZONE:
  0EBF'   CD 0E99'              	CALL	ZSAVE
  0EC2'   CD 0C6D'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EC5'   6F                    	MOV	L,A
  0EC6'   26 00                 	MVI	H,0
  0EC8'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0ECB'   CD 0E79'              	CALL	FPOS
  0ECE'   22 0000*              	SHLD	ZTOP
  0ED1'   32 0002*              	STA	ZTOP+2
  0ED4'   C3 0EAC'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0ED7'                         GPLACE:
  0ED7'   CD 0E99'              	CALL	ZSAVE
  0EDA'   CD 0E76'              	CALL	CURFP
  0EDD'   EB                    	XCHG
  0EDE'   2A 0000*              	LHLD	ZTOP
  0EE1'   EB                    	XCHG
  0EE2'   4F                    	MOV	C,A		; C:HL = the target's position
  0EE3'   3A 0002*              	LDA	ZTOP+2
  0EE6'   47                    	MOV	B,A		; B:DE = the top's
  0EE7'   79                    	MOV	A,C
  0EE8'   CD 0E6C'              	CALL	SUB24
  0EEB'   22 26EC'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0EEE'   DA 0F3B'              	JC	GP_UP
  0EF1'   B7                    	ORA	A
  0EF2'   C2 0F7C'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EF5'   3A 0000*              	LDA	NEDIT
  0EF8'   5F                    	MOV	E,A
  0EF9'   16 00                 	MVI	D,0
  0EFB'   B7                    	ORA	A
  0EFC'   1F                    	RAR
  0EFD'   6F                    	MOV	L,A
  0EFE'   26 00                 	MVI	H,0
  0F00'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0F01'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F04'   CD 0667'              	CALL	GBSUB		; HL = bytes from there to the target
  0F07'   EB                    	XCHG
  0F08'   2A 26EC'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F0B'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F0E'   DA 0F7C'              	JC	GP_MID
  0F11'   CD 0667'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F14'   01 0000               	LXI	B,0		; BC = lines from the top
  0F17'                         GP_CNT:
  0F17'   7A                    	MOV	A,D
  0F18'   B3                    	ORA	E
  0F19'   CA 0F28'              	JZ	GP_DN
  0F1C'   7E                    	MOV	A,M
  0F1D'   23                    	INX	H
  0F1E'   1B                    	DCX	D
  0F1F'   FE 0A                 	CPI	LF
  0F21'   C2 0F17'              	JNZ	GP_CNT
  0F24'   03                    	INX	B
  0F25'   C3 0F17'              	JMP	GP_CNT
  0F28'                         GP_DN:
  0F28'   3A 0000*              	LDA	NEDIT
  0F2B'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F2C'   5F                    	MOV	E,A
  0F2D'   16 00                 	MVI	D,0		; DE = the bottom row
  0F2F'   60                    	MOV	H,B
  0F30'   69                    	MOV	L,C
  0F31'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F34'   DA 0F86'              	JC	GP_SET		; A = the bottom row
  0F37'   7D                    	MOV	A,L		; on the screen: its row
  0F38'   C3 0FA6'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F3B'                         GP_UP:
  0F3B'   3C                    	INR	A
  0F3C'   C2 0F7C'              	JNZ	GP_MID		; 64K bytes or more above
  0F3F'   2A 26EC'              	LHLD	ZDIF
  0F42'   EB                    	XCHG
  0F43'   21 0000               	LXI	H,0
  0F46'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F49'   7C                    	MOV	A,H
  0F4A'   B5                    	ORA	L
  0F4B'   CA 0F7C'              	JZ	GP_MID		; exactly 64K
  0F4E'   EB                    	XCHG			; DE = bytes to read
  0F4F'   AF                    	XRA	A
  0F50'   32 26EE'              	STA	ZLF
  0F53'   CD 0000*              	CALL	RGET0
  0F56'                         GP_RD:
  0F56'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F59'   DA 0F7C'              	JC	GP_MID
  0F5C'   FE 0A                 	CPI	LF
  0F5E'   C2 0F72'              	JNZ	GP_RN
  0F61'   3A 0000*              	LDA	NEDIT
  0F64'   B7                    	ORA	A
  0F65'   1F                    	RAR
  0F66'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F68'   E5                    	PUSH	H
  0F69'   21 26EE'              	LXI	H,ZLF
  0F6C'   34                    	INR	M
  0F6D'   BE                    	CMP	M		; CY iff more lines than that
  0F6E'   E1                    	POP	H
  0F6F'   DA 0F7C'              	JC	GP_MID
  0F72'                         GP_RN:
  0F72'   1B                    	DCX	D
  0F73'   7A                    	MOV	A,D
  0F74'   B3                    	ORA	E
  0F75'   C2 0F56'              	JNZ	GP_RD
  0F78'   AF                    	XRA	A		; the top row
  0F79'   C3 0F86'              	JMP	GP_SET
  0F7C'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F7C'   3E 01                 	MVI	A,1
  0F7E'   32 0000*              	STA	WFILL		; not past the end of the file
  0F81'   3A 0000*              	LDA	NEDIT
  0F84'   B7                    	ORA	A
  0F85'   1F                    	RAR			; the middle row
  0F86'                         GP_SET:
  0F86'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F87'   26 00                 	MVI	H,0
  0F89'   22 0000*              	SHLD	WINROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F8C'   21 0000               	LXI	H,0
  0F8F'   22 0000*              	SHLD	LNDLT
  0F92'   CD 06FC'              	CALL	SETFUL		; the window may have paged: full repaint
  0F95'                         GP_FIN:
  0F95'   CD 0EAC'              	CALL	ZREST
  0F98'   3A 2716'              	LDA	GPKEEP
  0F9B'   B7                    	ORA	A
  0F9C'   CA 07A9'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F9F'   AF                    	XRA	A
  0FA0'   32 2716'              	STA	GPKEEP
  0FA3'   C3 0560'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0FA6'                         GP_ONS:
  0FA6'   6F                    	MOV	L,A
  0FA7'   26 00                 	MVI	H,0		; HL = the row it lands on
  0FA9'   EB                    	XCHG
  0FAA'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0FAD'   EB                    	XCHG
  0FAE'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FB1'   22 0000*              	SHLD	LNDLT
  0FB4'   3E 01                 	MVI	A,R_MOVE
  0FB6'   32 268D'              	STA	RINTENT
  0FB9'   C3 0F95'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FBC'                         OPPEND:
  0FBC'   AF                    	XRA	A
  0FBD'   32 26B6'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FC0'   3A 26B3'              	LDA	PSAVE
  0FC3'   FE 63                 	CPI	'c'
  0FC5'   C2 0FE2'              	JNZ	OPP_ND
  0FC8'   79                    	MOV	A,C
  0FC9'   FE 77                 	CPI	'w'
  0FCB'   CA 0FD3'              	JZ	OPP_W
  0FCE'   FE 57                 	CPI	'W'
  0FD0'   C2 0FE2'              	JNZ	OPP_ND
  0FD3'                         OPP_W:
  0FD3'   CD 11B5'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FD6'   DA 0FE2'              	JC	OPP_ND
  0FD9'   79                    	MOV	A,C
  0FDA'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FDC'   4F                    	MOV	C,A
  0FDD'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FDF'   32 26B6'              	STA	CWEOL		;   see the clamp in OPA_F
  0FE2'                         OPP_ND:
  0FE2'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  0FE3'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  0FE5'   C2 0FF9'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  0FE8'   CD 0218'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  0FEB'   DA 1089'              	JC	OPABRT
  0FEE'   79                    	MOV	A,C
  0FEF'   FE 67                 	CPI	'g'
  0FF1'   C2 1089'              	JNZ	OPABRT
  0FF4'   3E 01                 	MVI	A,PG
  0FF6'   32 26B1'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  0FF9'                         OPP_NG:
  0FF9'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0FFA'   21 26B3'              	LXI	H,PSAVE
  0FFD'   BE                    	CMP	M
  0FFE'   CA 11D6'              	JZ	OPLINE
  1001'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1002'   CD 11EC'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1005'   DA 1089'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1008'   32 26B5'              	STA	OPCLSV
  100B'   47                    	MOV	B,A		; B = the class
  100C'   3A 26B3'              	LDA	PSAVE
  100F'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1011'   C2 101D'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1014'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1015'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1017'   C2 103F'              	JNZ	OPP_GO
  101A'   C3 1028'              	JMP	OPP_NO
  101D'                         OPP_NC:
  101D'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  101F'   C2 103F'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1022'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1023'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1025'   CA 103F'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1028'                         OPP_NO:
  1028'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1029'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  102B'   CA 1039'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  102E'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1030'   CA 1039'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1033'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1036'   C2 1089'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1039'                         OPP_SW:
  1039'   CD 0218'              	CALL	MKGETK
  103C'   C3 1089'              	JMP	OPABRT
  103F'                         OPP_GO:
  103F'   AF                    	XRA	A
  1040'   32 2694'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1043'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1046'   22 26B7'              	SHLD	OPSTA
  1049'   C5                    	PUSH	B
  104A'   21 26BB'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  104D'   CD 0432'              	CALL	FPSTO		;   only good until the motion pages the window
  1050'   3A 26B5'              	LDA	OPCLSV
  1053'   FE 02                 	CPI	2
  1055'   CC 108C'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1058'   C1                    	POP	B
  1059'   21 25B7'              	LXI	H,CMDTAB
  105C'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  105F'   3A 26B3'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1062'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1063'   CA 06DB'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1066'   CD 10B8'              	CALL	OPSFIX		; where the start is in the window NOW
  1069'   D2 10D4'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  106C'   22 26B7'              	SHLD	OPSTA
  106F'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1072'   22 26B9'              	SHLD	OPEND2
  1075'   3A 26B3'              	LDA	PSAVE
  1078'   FE 79                 	CPI	'y'
  107A'   CA 16A0'              	JZ	OPYANK		; a yank takes the span without losing it
  107D'   CD 1227'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1080'   3A 26B3'              	LDA	PSAVE
  1083'   FE 63                 	CPI	'c'
  1085'   C0                    	RNZ
  1086'   C3 1455'              	JMP	SETINS
  1089'                         OPABRT:
  1089'   C3 06DB'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  108C'                         OPENDS:
  108C'   2A 26B7'              	LHLD	OPSTA
  108F'   CD 05C7'              	CALL	BOL
  1092'   11 26BE'              	LXI	D,OPSLO
  1095'   CD 10AA'              	CALL	OPE_ST
  1098'   2A 26B7'              	LHLD	OPSTA
  109B'   CD 05F7'              	CALL	NLSTART
  109E'   11 26C1'              	LXI	D,OPSHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A1'   CD 10AA'              	CALL	OPE_ST
  10A4'   2A 26B7'              	LHLD	OPSTA
  10A7'   C3 0000*              	JMP	GOTO
  10AA'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  10AA'   D5                    	PUSH	D
  10AB'   CD 0000*              	CALL	GOTO
  10AE'   E1                    	POP	H
  10AF'   C3 0432'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  10B2'                         CURBD:
  10B2'   CD 0E76'              	CALL	CURFP
  10B5'   EB                    	XCHG
  10B6'   47                    	MOV	B,A
  10B7'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  10B8'                         OPSFIX:
  10B8'   21 26BB'              	LXI	H,OPSFP
  10BB'   CD 03E5'              	CALL	MKLOAD
  10BE'   CD 10B2'              	CALL	CURBD
  10C1'   2A 2720'              	LHLD	MKPOS
  10C4'   3A 2722'              	LDA	MKPOS+2
  10C7'   CD 0E6C'              	CALL	SUB24
  10CA'   B4                    	ORA	H
  10CB'   B5                    	ORA	L
  10CC'   C2 03F2'              	JNZ	MKWIN
  10CF'   CD 0000*              	CALL	CUROFF
  10D2'   37                    	STC
  10D3'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  10D4'                         OPPGD:
  10D4'   47                    	MOV	B,A
  10D5'   3A 26B5'              	LDA	OPCLSV
  10D8'   FE 02                 	CPI	2
  10DA'   C2 1196'              	JNZ	OPG_NO
  10DD'   3A 26B3'              	LDA	PSAVE
  10E0'   FE 64                 	CPI	'd'
  10E2'   C2 1196'              	JNZ	OPG_NO
  10E5'   04                    	INR	B
  10E6'   CA 10F5'              	JZ	OPG_FW
  10E9'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10EC'   CD 05C7'              	CALL	BOL		;   and the high end is OPSHI as it stands
  10EF'   CD 0000*              	CALL	GOTO
  10F2'   C3 110D'              	JMP	OPG_GO
  10F5'                         OPG_FW:
  10F5'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  10F8'   CD 05F7'              	CALL	NLSTART		;   landed on, and the low one is where the
  10FB'   11 26C1'              	LXI	D,OPSHI		;   start line began
  10FE'   CD 10AA'              	CALL	OPE_ST
  1101'   21 26BE'              	LXI	H,OPSLO
  1104'   CD 03E5'              	CALL	MKLOAD
  1107'   CD 03C2'              	CALL	MKPAGE
  110A'   CD 0000*              	CALL	GOTO
  110D'                         OPG_GO:
  110D'   CD 10B2'              	CALL	CURBD
  1110'   2A 26C1'              	LHLD	OPSHI
  1113'   3A 26C3'              	LDA	OPSHI+2
  1116'   CD 0E6C'              	CALL	SUB24		; A:HL = the bytes to take
  1119'                         OPG_SV:
  1119'   22 26C4'              	SHLD	OPTOGO
  111C'   32 26C6'              	STA	OPTOGO+2
  111F'                         OPG_NX:
  111F'   CD 064A'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1122'   CD 0000*              	CALL	SUBHD
  1125'   EB                    	XCHG			; DE = what the window holds past the cursor
  1126'   2A 26C4'              	LHLD	OPTOGO
  1129'   3A 26C6'              	LDA	OPTOGO+2
  112C'   B7                    	ORA	A
  112D'   C2 1160'              	JNZ	OPG_PG		; 64K or more to go
  1130'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1133'   DA 1160'              	JC	OPG_PG
  1136'   CA 1160'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1139'                         OPG_FN:				; the rest of it is here
  1139'   E5                    	PUSH	H
  113A'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  113D'   CD 0000*              	CALL	CUROFF
  1140'   22 26C7'              	SHLD	OPLO
  1143'   D1                    	POP	D
  1144'   19                    	DAD	D
  1145'   22 26C9'              	SHLD	OPHI
  1148'   CD 12C5'              	CALL	OPDSPN
  114B'   CD 0985'              	CALL	ATEOF
  114E'   D2 11AF'              	JNC	OPMID
  1151'   CD 0DCB'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1154'   CA 11AF'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1157'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  115A'   CD 0000*              	CALL	SETBWD
  115D'   C3 11AF'              	JMP	OPMID
  1160'                         OPG_PG:
  1160'   7A                    	MOV	A,D
  1161'   B3                    	ORA	E
  1162'   C2 117B'              	JNZ	OPG_DL
  1165'   CD 0985'              	CALL	ATEOF		; nothing held past the cursor
  1168'   21 0000               	LXI	H,0
  116B'   DA 1139'              	JC	OPG_FN		; ... and no more to come: the file ran out
  116E'   2B                    	DCX	H
  116F'   CD 0000*              	CALL	SETC0
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1172'   CD 0000*              	CALL	GOLINE
  1175'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1178'   C3 111F'              	JMP	OPG_NX
  117B'                         OPG_DL:
  117B'   D5                    	PUSH	D
  117C'   21 FFFF               	LXI	H,0FFFFH
  117F'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1182'   E1                    	POP	H
  1183'   E5                    	PUSH	H
  1184'   CD 0000*              	CALL	DELFWD
  1187'   D1                    	POP	D
  1188'   06 00                 	MVI	B,0
  118A'   2A 26C4'              	LHLD	OPTOGO
  118D'   3A 26C6'              	LDA	OPTOGO+2
  1190'   CD 0E6C'              	CALL	SUB24
  1193'   C3 1119'              	JMP	OPG_SV
  1196'                         OPG_NO:
  1196'   0E 07                 	MVI	C,BEL
  1198'   CD 0000*              	CALL	BCONOU
  119B'                         OPG_HM:				; the cursor back where the command found it
  119B'   21 26BB'              	LXI	H,OPSFP
  119E'   CD 03E5'              	CALL	MKLOAD
  11A1'   CD 03C2'              	CALL	MKPAGE
  11A4'   CD 0000*              	CALL	GOTO
  11A7'   AF                    	XRA	A
  11A8'   32 26B3'              	STA	PSAVE
  11AB'   3C                    	INR	A
  11AC'   32 2716'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  11AF'                         OPMID:
  11AF'   CD 0E99'              	CALL	ZSAVE
  11B2'   C3 0F7C'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  11B5'                         ONWHIT:
  11B5'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11B8'   CA 11D4'              	JZ	OW_YES
  11BB'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  11BE'   FE 20                 	CPI	' '
  11C0'   CA 11D4'              	JZ	OW_YES
  11C3'   FE 09                 	CPI	TAB
  11C5'   CA 11D4'              	JZ	OW_YES
  11C8'   FE 0D                 	CPI	CR
  11CA'   CA 11D4'              	JZ	OW_YES
  11CD'   FE 0A                 	CPI	LF
  11CF'   CA 11D4'              	JZ	OW_YES
  11D2'   B7                    	ORA	A		; a char to change: CY clear
  11D3'   C9                    	RET
  11D4'                         OW_YES:
  11D4'   37                    	STC
  11D5'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  11D6'                         OPLINE:
  11D6'   3A 26B3'              	LDA	PSAVE
  11D9'   FE 63                 	CPI	'c'
  11DB'   CA 06DB'              	JZ	SETMOV
  11DE'   FE 79                 	CPI	'y'
  11E0'   CA 167F'              	JZ	VY_YY
  11E3'   21 26BB'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  11E6'   CD 0432'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  11E9'   C3 15F8'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  11EC'                         OPCLS:
  11EC'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  11EE'   CA 11FB'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  11F1'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  11F3'   C2 120F'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  11F6'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  11F8'   C3 11FD'              	JMP	OPC_FK
  11FB'                         OPC_SEM:
  11FB'   06 00                 	MVI	B,0		; ';' runs it as it stands
  11FD'                         OPC_FK:
  11FD'   3A 270C'              	LDA	FNDKND
  1200'   B7                    	ORA	A
  1201'   37                    	STC
  1202'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1203'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1204'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1206'   CA 120D'              	JZ	OPC_EXC
  1209'   3E 01                 	MVI	A,1
  120B'   B7                    	ORA	A		; CY clear: a motion, class 1
  120C'   C9                    	RET
  120D'                         OPC_EXC:
  120D'   AF                    	XRA	A		; class 0, CY clear
  120E'   C9                    	RET
  120F'                         OPC_TB:
  120F'   47                    	MOV	B,A
  1210'   21 1349'              	LXI	H,OPCTAB
  1213'                         OPC_LP:
  1213'   7E                    	MOV	A,M
  1214'   B7                    	ORA	A
  1215'   CA 1225'              	JZ	OPC_MS		; end of table -> not a motion
  1218'   B8                    	CMP	B
  1219'   CA 1221'              	JZ	OPC_HT
  121C'   23                    	INX	H
  121D'   23                    	INX	H
  121E'   C3 1213'              	JMP	OPC_LP
  1221'                         OPC_HT:
  1221'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1222'   7E                    	MOV	A,M		; class byte
  1223'   B7                    	ORA	A		; clear CY
  1224'   C9                    	RET
  1225'                         OPC_MS:
  1225'   37                    	STC
  1226'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1227'                         OPAPPL:
  1227'   3A 26B5'              	LDA	OPCLSV
  122A'   FE 02                 	CPI	2
  122C'   CA 132D'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  122F'   2A 26B7'              	LHLD	OPSTA
  1232'   EB                    	XCHG			; DE = start
  1233'   2A 26B9'              	LHLD	OPEND2		; HL = end
  1236'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1239'   DA 1249'              	JC	OPA_F
  123C'   CA 1249'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  123F'   22 26C7'              	SHLD	OPLO
  1242'   EB                    	XCHG
  1243'   22 26C9'              	SHLD	OPHI
  1246'   C3 12A1'              	JMP	OPA_DO
  1249'                         OPA_F:
  1249'   EB                    	XCHG			; HL = start, DE = end
  124A'   22 26C7'              	SHLD	OPLO
  124D'   EB                    	XCHG			; HL = end
  124E'   3A 26B5'              	LDA	OPCLSV
  1251'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1253'   CA 129E'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1256'   FE 01                 	CPI	1
  1258'   C2 127A'              	JNZ	OPA_EX
  125B'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  125C'   3A 26B6'              	LDA	CWEOL
  125F'   B7                    	ORA	A
  1260'   CA 129E'              	JZ	OPA_HI
  1263'   22 26C9'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1266'   2A 26C7'              	LHLD	OPLO
  1269'   CD 13D3'              	CALL	CEND		; HL = the start line's content end
  126C'   EB                    	XCHG			; DE = that content end
  126D'   2A 26C9'              	LHLD	OPHI		; HL = hi
  1270'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1273'   D2 129E'              	JNC	OPA_HI		; hi is inside the line: keep it
  1276'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1277'   C3 129E'              	JMP	OPA_HI
  127A'                         OPA_EX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  127A'   22 26C9'              	SHLD	OPHI		; the motion's own end, for now
  127D'   2A 26C7'              	LHLD	OPLO
  1280'   CD 13D3'              	CALL	CEND		; HL = the start line's content end
  1283'   EB                    	XCHG			; DE = that content end
  1284'   3A 2694'              	LDA	WPULL		; the motion landed on a line's end and was
  1287'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1288'   C2 1294'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  128B'   2A 26C9'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  128E'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  1291'   D2 12A1'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1294'                         OPA_CE:				;   deletes the word, not all but its last char
  1294'   2A 26C7'              	LHLD	OPLO
  1297'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  129A'   CA 12DF'              	JZ	OPA_LN
  129D'   EB                    	XCHG			; HL = the content end
  129E'                         OPA_HI:
  129E'   22 26C9'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  12A1'                         OPA_DO:
  12A1'   CD 12C5'              	CALL	OPDSPN
  12A4'   3A 26B3'              	LDA	PSAVE
  12A7'   FE 63                 	CPI	'c'
  12A9'   C8                    	RZ
  12AA'   C3 13E4'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  12AD'                         SPNBRK:
  12AD'   2A 26C7'              	LHLD	OPLO
  12B0'   CD 05DA'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  12B3'   EB                    	XCHG			; DE = it
  12B4'   2A 26C9'              	LHLD	OPHI
  12B7'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  12BA'                         OPSPNL:
  12BA'   2A 26C9'              	LHLD	OPHI
  12BD'   EB                    	XCHG
  12BE'   2A 26C7'              	LHLD	OPLO
  12C1'   EB                    	XCHG			; HL = hi, DE = lo
  12C2'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  12C5'                         OPDSPN:
  12C5'   CD 12AD'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  12C8'   F5                    	PUSH	PSW
  12C9'   2A 26C7'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12CC'   CD 0000*              	CALL	GOTO
  12CF'   CD 12BA'              	CALL	OPSPNL		; HL = hi - lo
  12D2'   CD 0000*              	CALL	DELFWD
  12D5'   CD 0188'              	CALL	MARKMOD
  12D8'   F1                    	POP	PSW
  12D9'   DA 06FC'              	JC	SETFUL		; a break went: every row below it moved up
  12DC'   C3 06E1'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  12DF'                         OPA_LN:
  12DF'   3A 26B3'              	LDA	PSAVE
  12E2'   FE 63                 	CPI	'c'
  12E4'   C2 12ED'              	JNZ	OPA_LD
  12E7'   2A 26C7'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  12EA'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  12ED'                         OPA_LD:
  12ED'   2A 26C7'              	LHLD	OPLO
  12F0'   22 26B7'              	SHLD	OPSTA
  12F3'   22 26B9'              	SHLD	OPEND2
  12F6'   C3 132D'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  12F9'                         OPALSP:
  12F9'   2A 26B7'              	LHLD	OPSTA
  12FC'   EB                    	XCHG
  12FD'   2A 26B9'              	LHLD	OPEND2
  1300'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1303'   DA 1310'              	JC	OPAL_F
  1306'   22 26C7'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1309'   EB                    	XCHG
  130A'   22 26C9'              	SHLD	OPHI		; hi-src = start
  130D'   C3 131A'              	JMP	OPAL_R
  1310'                         OPAL_F:
  1310'   EB                    	XCHG			; HL = start
  1311'   22 26C7'              	SHLD	OPLO		; lo-src = start
  1314'   2A 26B9'              	LHLD	OPEND2
  1317'   22 26C9'              	SHLD	OPHI		; hi-src = end
  131A'                         OPAL_R:
  131A'   2A 26C7'              	LHLD	OPLO
  131D'   CD 05C7'              	CALL	BOL
  1320'   22 26C7'              	SHLD	OPLO		; lo = BOL(low line)
  1323'   2A 26C9'              	LHLD	OPHI
  1326'   CD 05F7'              	CALL	NLSTART
  1329'   22 26C9'              	SHLD	OPHI		; hi = start of line past the high line
  132C'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  132D'                         OPALIN:
  132D'   CD 12F9'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1330'                         OPDLIN:
  1330'   CD 12C5'              	CALL	OPDSPN
  1333'   CD 064A'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1336'   DA 1346'              	JC	OPDL_NB
  1339'   CD 0000*              	CALL	LOGLEN
  133C'   7C                    	MOV	A,H
  133D'   B5                    	ORA	L
  133E'   C8                    	RZ			; empty buffer
  133F'   2B                    	DCX	H
  1340'   CD 05C7'              	CALL	BOL
  1343'   CD 0000*              	CALL	GOTO
  1346'                         OPDL_NB:
  1346'   C3 07A9'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1349'                         OPCTAB:
  1349'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  134D'   62 00 42 00           
  1351'   68 00 6C 00           
  1355'   30 00 5E 00           
  1359'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  135B'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  135F'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1363'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1367'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  136B'   24 01                 
  136D'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1371'   47 02 48 02           
  1375'   4D 02 4C 02           
  1379'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  137B'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  137D'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  137E'                         VCB_C:
  137E'   CD 138A'              	CALL	VCB_CD
  1381'   C3 1455'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1384'                         VCB_D:
  1384'   CD 138A'              	CALL	VCB_CD
  1387'   C3 13E4'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  138A'                         VCB_CD:
  138A'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  138D'   22 26C7'              	SHLD	OPLO
  1390'   CD 0000*              	CALL	CUROFF
  1393'   CD 13D3'              	CALL	CEND		; to the line's content end, the CR,LF left
  1396'   22 26C9'              	SHLD	OPHI
  1399'   C3 12C5'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  139C'                         VC_X:
  139C'   CD 084E'              	CALL	GLSTAL
  139F'   CD 06E1'              	CALL	SETLIN
  13A2'   CD 066E'              	CALL	GETCNT
  13A5'   22 26CB'              	SHLD	CNTV
  13A8'   CD 0000*              	CALL	CUROFF
  13AB'   22 26CF'              	SHLD	WKI		; cur
  13AE'   CD 13D3'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  13B1'   EB                    	XCHG			; DE = contentend
  13B2'   2A 26CF'              	LHLD	WKI		; HL = cur
  13B5'   EB                    	XCHG			; HL = contentend, DE = cur
  13B6'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  13B9'   7C                    	MOV	A,H
  13BA'   B5                    	ORA	L
  13BB'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  13BC'   EB                    	XCHG			; DE = available
  13BD'   2A 26CB'              	LHLD	CNTV		; HL = count
  13C0'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  13C3'   DA 13C9'              	JC	VX_USEA
  13C6'   C3 13CA'              	JMP	VX_DEL		; count <= available -> HL = count = del
  13C9'                         VX_USEA:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13C9'   EB                    	XCHG			; HL = available
  13CA'                         VX_DEL:
  13CA'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  13CD'   CD 0188'              	CALL	MARKMOD
  13D0'   C3 13E4'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  13D3'                         CEND:
  13D3'   CD 05DA'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  13D6'   7C                    	MOV	A,H
  13D7'   B5                    	ORA	L
  13D8'   C8                    	RZ			; the start of the text: nothing before it
  13D9'   2B                    	DCX	H
  13DA'   E5                    	PUSH	H
  13DB'   CD 0000*              	CALL	CHARAT
  13DE'   E1                    	POP	H		; HL = term-1
  13DF'   FE 0D                 	CPI	CR
  13E1'   C8                    	RZ			; a CR before the LF -> the content ends there
  13E2'   23                    	INX	H
  13E3'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  13E4'                         CLAMPE:
  13E4'   CD 0000*              	CALL	CUROFF
  13E7'   E5                    	PUSH	H
  13E8'   CD 0606'              	CALL	EOLC
  13EB'   D1                    	POP	D		; DE = cur
  13EC'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  13EF'   D8                    	RC
  13F0'   C8                    	RZ
  13F1'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  13F4'                         VC_I:
  13F4'   CD 066E'              	CALL	GETCNT
  13F7'   C3 1452'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  13FA'                         VC_A:
  13FA'   CD 066E'              	CALL	GETCNT
  13FD'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1400'   CA 1417'              	JZ	VA_INS
  1403'   EB                    	XCHG			; HL = cur
  1404'   E5                    	PUSH	H
  1405'   CD 0000*              	CALL	CHARAT
  1408'   E1                    	POP	H
  1409'   FE 0A                 	CPI	LF
  140B'   CA 1417'              	JZ	VA_INS		; on the line terminator -> append in place
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  140E'   FE 0D                 	CPI	CR
  1410'   CA 1417'              	JZ	VA_INS
  1413'   23                    	INX	H
  1414'   CD 0000*              	CALL	GOTO
  1417'                         VA_INS:
  1417'   C3 1452'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  141A'                         VCB_A:
  141A'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  141D'   CD 0606'              	CALL	EOLC		; HL = last content char (the start when empty)
  1420'   E5                    	PUSH	H
  1421'   CD 0000*              	CALL	CHARAT
  1424'   E1                    	POP	H
  1425'   FE 0D                 	CPI	CR
  1427'   CA 1430'              	JZ	VBA_IN		; an empty line: insert at its start
  142A'   FE 0A                 	CPI	LF
  142C'   CA 1430'              	JZ	VBA_IN
  142F'   23                    	INX	H		; past the last content char
  1430'                         VBA_IN:
  1430'   CD 0000*              	CALL	GOTO
  1433'   C3 1452'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1436'                         VCB_I:
  1436'   CD 066E'              	CALL	GETCNT
  1439'   CD 07A9'              	CALL	FNBLNK
  143C'   CD 0000*              	CALL	CUROFF
  143F'   E5                    	PUSH	H
  1440'   CD 0000*              	CALL	CHARAT
  1443'   E1                    	POP	H
  1444'   FE 20                 	CPI	' '
  1446'   CA 144E'              	JZ	VBI_SK
  1449'   FE 09                 	CPI	TAB
  144B'   C2 1452'              	JNZ	SETINM
  144E'                         VBI_SK:
  144E'   23                    	INX	H		; blanks only: past the last of them
  144F'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1452'                         SETINM:
  1452'   CD 06DB'              	CALL	SETMOV
  1455'                         SETINS:
  1455'   3E 01                 	MVI	A,EM_INS
  1457'   32 2688'              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145A'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  145B'                         ATCEND:
  145B'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  145E'   C8                    	RZ
  145F'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  1462'   FE 0D                 	CPI	CR
  1464'   C8                    	RZ
  1465'   FE 0A                 	CPI	LF
  1467'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1468'                         OPNBRK:
  1468'   3E 0D                 	MVI	A,CR
  146A'   CD 0000*              	CALL	PUTGAP
  146D'   3E 0A                 	MVI	A,LF
  146F'   CD 0000*              	CALL	PUTGAP
  1472'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1475'   23                    	INX	H
  1476'   22 0000*              	SHLD	LNDLT
  1479'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  147C'                         ENDBRK:
  147C'   CD 064A'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  147F'   C0                    	RNZ
  1480'   CD 1468'              	CALL	OPNBRK
  1483'   CD 0000*              	CALL	CUROFF
  1486'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1487'   2B                    	DCX	H		;   line, with its own terminator after it
  1488'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  148B'                         VC_O:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  148B'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  148E'   CD 13D3'              	CALL	CEND
  1491'   CD 0000*              	CALL	GOTO
  1494'   CD 1468'              	CALL	OPNBRK
  1497'   CD 147C'              	CALL	ENDBRK		; a last line with no line end: the opened line
  149A'   CD 06E7'              	CALL	SETILN		;   needs a terminator of its own to exist
  149D'   C3 1455'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  14A0'                         VCB_O:
  14A0'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14A3'   CD 05C7'              	CALL	BOL
  14A6'   CD 0000*              	CALL	GOTO
  14A9'   CD 1468'              	CALL	OPNBRK
  14AC'   CD 0000*              	CALL	CUROFF
  14AF'   2B                    	DCX	H
  14B0'   2B                    	DCX	H
  14B1'   CD 0000*              	CALL	GOTO
  14B4'   CD 06E7'              	CALL	SETILN
  14B7'   C3 1455'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  14BA'                         VCB_J:
  14BA'   CD 0661'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14BD'   CD 13D3'              	CALL	CEND		; the join point: this line's content end
  14C0'   22 26C7'              	SHLD	OPLO
  14C3'   CD 0000*              	CALL	CUROFF
  14C6'   CD 05F7'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  14C9'   E5                    	PUSH	H
  14CA'   CD 0000*              	CALL	LOGLEN
  14CD'   D1                    	POP	D		; DE = that start
  14CE'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  14D1'   CA 06DB'              	JZ	SETMOV
  14D4'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  14D5'                         VJ_WS:
  14D5'   E5                    	PUSH	H
  14D6'   CD 0000*              	CALL	LOGLEN
  14D9'   D1                    	POP	D		; DE = the scan
  14DA'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  14DD'   CA 14F4'              	JZ	VJ_DEL
  14E0'   EB                    	XCHG			; HL = the scan
  14E1'   E5                    	PUSH	H
  14E2'   CD 0000*              	CALL	CHARAT
  14E5'   E1                    	POP	H
  14E6'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14E8'   CA 14F0'              	JZ	VJ_SKIP
  14EB'   FE 09                 	CPI	TAB
  14ED'   C2 14F4'              	JNZ	VJ_DEL
  14F0'                         VJ_SKIP:
  14F0'   23                    	INX	H
  14F1'   C3 14D5'              	JMP	VJ_WS
  14F4'                         VJ_DEL:
  14F4'   22 26C9'              	SHLD	OPHI
  14F7'   CD 12C5'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  14FA'   CD 06F6'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  14FD'   CD 064A'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1500'   CA 13E4'              	JZ	CLAMPE
  1503'   CD 0655'              	CALL	CURCHR		; the first char of what was appended
  1506'   FE 0D                 	CPI	CR
  1508'   CA 13E4'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  150B'   FE 0A                 	CPI	LF
  150D'   CA 13E4'              	JZ	CLAMPE
  1510'   FE 29                 	CPI	')'
  1512'   CA 13E4'              	JZ	CLAMPE		; vim puts no space before a ')'
  1515'   CD 0000*              	CALL	CUROFF
  1518'   7C                    	MOV	A,H
  1519'   B5                    	ORA	L
  151A'   CA 1530'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  151D'   2B                    	DCX	H
  151E'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1521'   FE 20                 	CPI	' '
  1523'   CA 13E4'              	JZ	CLAMPE
  1526'   FE 09                 	CPI	TAB
  1528'   CA 13E4'              	JZ	CLAMPE
  152B'   FE 0A                 	CPI	LF
  152D'   CA 13E4'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1530'                         VJ_SP:
  1530'   3E 20                 	MVI	A,' '
  1532'   CD 0000*              	CALL	PUTGAP
  1535'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1538'   2B                    	DCX	H
  1539'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  153C'                         VC_TILD:
  153C'   CD 066E'              	CALL	GETCNT
  153F'   CD 06E1'              	CALL	SETLIN		; only this row changes
  1542'   CD 084E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1545'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1548'   CA 06DB'              	JZ	SETMOV
  154B'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  154E'   FE 0D                 	CPI	CR
  1550'   CA 06DB'              	JZ	SETMOV		; the line's end: nothing to toggle
  1553'   FE 0A                 	CPI	LF
  1555'   CA 06DB'              	JZ	SETMOV
  1558'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1559'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  155B'   FE 41                 	CPI	'A'
  155D'   DA 1569'              	JC	VT_PUT		; below 'A': no case
  1560'   FE 5B                 	CPI	'Z'+1
  1562'   D2 1569'              	JNC	VT_PUT		; above 'Z': no case
  1565'   78                    	MOV	A,B
  1566'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1568'   47                    	MOV	B,A
  1569'                         VT_PUT:
  1569'   78                    	MOV	A,B
  156A'   32 26D8'              	STA	VRCH		; the calls below do not preserve B
  156D'   CD 0188'              	CALL	MARKMOD
  1570'   21 0001               	LXI	H,1
  1573'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1576'   3A 26D8'              	LDA	VRCH
  1579'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  157C'   C3 13E4'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  157F'                         VC_R:
  157F'   CD 065B'              	CALL	MOVCNT		; a cursor motion, and its count
  1582'   3E 03                 	MVI	A,PR
  1584'   32 26B0'              	STA	GPEND
  1587'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1588'                         VR_DO:
  1588'   AF                    	XRA	A
  1589'   32 26B0'              	STA	GPEND
  158C'   79                    	MOV	A,C
  158D'   32 26D8'              	STA	VRCH		; the calls below do not preserve C
  1590'   CD 06E1'              	CALL	SETLIN		; only this row changed
  1593'   CD 084E'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1596'   CD 064A'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1599'   CA 06DB'              	JZ	SETMOV		; the end of the text: vim does nothing
  159C'   CD 0655'              	CALL	CURCHR		; A = the char under the cursor
  159F'   FE 0D                 	CPI	CR
  15A1'   CA 06DB'              	JZ	SETMOV		; the line's end: nothing to replace
  15A4'   FE 0A                 	CPI	LF
  15A6'   CA 06DB'              	JZ	SETMOV
  15A9'   CD 0188'              	CALL	MARKMOD
  15AC'   21 0001               	LXI	H,1
  15AF'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  15B2'   3A 26D8'              	LDA	VRCH
  15B5'   FE 0D                 	CPI	CR
  15B7'   CA 15C4'              	JZ	VR_CR
  15BA'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  15BD'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15C0'   2B                    	DCX	H		;   out, which moves every logical offset
  15C1'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  15C4'                         VR_CR:
  15C4'   CD 1468'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  15C7'   CD 147C'              	CALL	ENDBRK		;   replaced char may have been the text's last
  15CA'   CD 06E7'              	CALL	SETILN		;   row above it lost the char that was replaced,
  15CD'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  15CF'   32 2690'              	STA	ILABOV
  15D2'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  15D3'                         VCB_R:
  15D3'   CD 066E'              	CALL	GETCNT
  15D6'   CD 06DB'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  15D9'   21 0000               	LXI	H,0
  15DC'   22 26D9'              	SHLD	RPDEL		; nothing of ours to put back yet
  15DF'   22 26DB'              	SHLD	RPAPP
  15E2'   3E 02                 	MVI	A,EM_REP
  15E4'   32 2688'              	STA	EDMODE
  15E7'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  15E8'                         VC_D:
  15E8'   3E 64                 	MVI	A,'d'
  15EA'   32 26B2'              	STA	PENDOP
  15ED'   C3 06DB'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  15F0'                         VC_C:
  15F0'   3E 63                 	MVI	A,'c'
  15F2'   32 26B2'              	STA	PENDOP
  15F5'   C3 06DB'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  15F8'                         VD_DD:
  15F8'   CD 084E'              	CALL	GLSTAL
  15FB'   CD 066E'              	CALL	GETCNT
  15FE'   22 26CB'              	SHLD	CNTV
  1601'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1603'   32 26B4'              	STA	DDSNG
  1606'   2B                    	DCX	H
  1607'   7C                    	MOV	A,H
  1608'   B5                    	ORA	L
  1609'   C2 1614'              	JNZ	VDD_LS
  160C'   3E 01                 	MVI	A,1
  160E'   32 26B4'              	STA	DDSNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1611'   C3 161A'              	JMP	VDD_GO
  1614'                         VDD_LS:
  1614'   CD 0814'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1617'   DA 06DB'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  161A'                         VDD_GO:
  161A'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  161D'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1620'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1623'   CD 1D7A'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1626'   CD 0792'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1629'   2A 26CB'              	LHLD	CNTV
  162C'   CD 0000*              	CALL	SETC0
  162F'                         VDD_FW:
  162F'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1632'   DA 176E'              	JC	QREFUS		; ... which has no room for them
  1635'   CD 0683'              	CALL	CNTTST
  1638'   C2 162F'              	JNZ	VDD_FW
  163B'   CD 0188'              	CALL	MARKMOD
  163E'   CD 0985'              	CALL	ATEOF
  1641'   D2 165C'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1644'   3E 00                 	MVI	A,0
  1646'   32 26B4'              	STA	DDSNG		; deleted to the end: full repaint
  1649'   CD 0DCB'              	CALL	ONFST
  164C'   CA 07A9'              	JZ	FNBLNK		; nothing left before it
  164F'   21 0001               	LXI	H,1		; onto the new last line
  1652'   CD 0000*              	CALL	SETBWD
  1655'   2A 0000*              	LHLD	LNDLT
  1658'   2B                    	DCX	H
  1659'   22 0000*              	SHLD	LNDLT
  165C'                         VDD_UP:
  165C'   CD 07A9'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  165F'   3A 26B4'              	LDA	DDSNG
  1662'   B7                    	ORA	A
  1663'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1664'   3E 03                 	MVI	A,R_DLIN
  1666'   32 268D'              	STA	RINTENT
  1669'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  166A'                         QEMPTY:
  166A'   2A 0000*              	LHLD	QBEG
  166D'   EB                    	XCHG
  166E'   2A 0000*              	LHLD	QEND
  1671'   7C                    	MOV	A,H
  1672'   BA                    	CMP	D
  1673'   C0                    	RNZ
  1674'   7D                    	MOV	A,L
  1675'   BB                    	CMP	E
  1676'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1677'                         VC_Y:
  1677'   3E 79                 	MVI	A,'y'
  1679'   32 26B2'              	STA	PENDOP
  167C'   C3 06DB'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  167F'                         VY_YY:
  167F'   21 26BB'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1682'   CD 0432'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1685'   CD 0000*              	CALL	CUROFF
  1688'   22 26FC'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  168B'   CD 05C7'              	CALL	BOL
  168E'   22 26FE'              	SHLD	YPT		; where the lines come from, to put them back
  1691'   CD 17D4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1694'   CD 1817'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1697'   D2 17DB'              	JNC	YNDONE
  169A'   21 15F8'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  169D'   C3 16C9'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  16A0'                         OPYANK:
  16A0'   CD 12F9'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16A3'   2A 26B7'              	LHLD	OPSTA
  16A6'   EB                    	XCHG			; DE = start
  16A7'   2A 26B9'              	LHLD	OPEND2		; HL = end
  16AA'   CD 0000*              	CALL	CMP16		; CY iff start < end
  16AD'   D2 16B1'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  16B0'   EB                    	XCHG			; ... otherwise the start is
  16B1'                         OPY_LO:
  16B1'   22 26FC'              	SHLD	YOFF
  16B4'   2A 26C7'              	LHLD	OPLO
  16B7'   22 26FE'              	SHLD	YPT		; where the lines come from, to put them back
  16BA'   CD 17D4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16BD'   CD 188F'              	CALL	YNSPAN		; copied where they lie, if there is room
  16C0'   D2 17DB'              	JNC	YNDONE
  16C3'   21 1795'              	LXI	H,YSPAN
  16C6'   C3 16C9'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  16C9'                         YKGO:
  16C9'   22 2725'              	SHLD	YACT
  16CC'   2A 26FE'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  16CF'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  16D0'   2A 26FC'              	LHLD	YOFF		;   survive this -- the put-back below can page
  16D3'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  16D6'   22 272B'              	SHLD	YCOL		;   them -- but a distance within the lines does
  16D9'   3A 268C'              	LDA	MODF
  16DC'   32 26F9'              	STA	YMODF
  16DF'   3A 26A5'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  16E2'   32 26FA'              	STA	YDCHG		;   a yank must not become the last change
  16E5'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  16E8'   32 26FB'              	STA	YURPL		;   back are not a change to undo either
  16EB'   3E 01                 	MVI	A,1
  16ED'   32 0000*              	STA	UNDRPL
  16F0'   32 2724'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  16F3'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  16F6'   22 2707'              	SHLD	YLDLT
  16F9'   CD 0000*              	CALL	LOGLEN
  16FC'   22 2729'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  16FF'   2A 2725'              	LHLD	YACT
  1702'   CD 176D'              	CALL	YCALL		; the lines out of the file, into the register
  1705'   3A 26F4'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1708'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  170A'   CA 1751'              	JZ	YK_RF		;   cursor: only the flags are still owed
  170D'   CD 0000*              	CALL	LOGLEN
  1710'   EB                    	XCHG
  1711'   2A 2729'              	LHLD	YWAS
  1714'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1717'   CA 1745'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  171A'   2A 26FE'              	LHLD	YPT
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  171D'   CD 0000*              	CALL	GOTO
  1720'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1723'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  1726'   22 272D'              	SHLD	YBLK
  1729'   2A 0000*              	LHLD	QBEG
  172C'   EB                    	XCHG
  172D'   2A 0000*              	LHLD	QEND
  1730'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  1733'   EB                    	XCHG
  1734'   2A 272D'              	LHLD	YBLK
  1737'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  173A'   EB                    	XCHG
  173B'   2A 272B'              	LHLD	YCOL
  173E'   19                    	DAD	D		; ... and the cursor is YCOL into them
  173F'   CD 0000*              	CALL	GOTO
  1742'   C3 174B'              	JMP	YK_RST
  1745'                         YK_FIN:				; nothing came out, so nothing was put back and
  1745'   2A 26FC'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  1748'   CD 0000*              	CALL	GOTO		;   where it was
  174B'                         YK_RST:
  174B'   2A 2707'              	LHLD	YLDLT
  174E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1751'                         YK_RF:
  1751'   3A 26F9'              	LDA	YMODF
  1754'   32 268C'              	STA	MODF
  1757'   3A 26FA'              	LDA	YDCHG
  175A'   32 26A5'              	STA	DOTCHG
  175D'   3A 26FB'              	LDA	YURPL
  1760'   32 0000*              	STA	UNDRPL
  1763'   AF                    	XRA	A
  1764'   32 2724'              	STA	MKHOLD
  1767'   CD 084E'              	CALL	GLSTAL
  176A'   C3 06FC'              	JMP	SETFUL		; the cheap paint cannot carry this
  176D'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  176E'                         QREFUS:
  176E'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1771'   CD 166A'              	CALL	QEMPTY
  1774'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1777'   CD 0000*              	CALL	QKILL
  177A'   3A 2724'              	LDA	MKHOLD
  177D'   B7                    	ORA	A
  177E'   C2 178D'              	JNZ	QRF_Y
  1781'   21 0000*              	LXI	H,MKSAV
  1784'   11 0000*              	LXI	D,MKTAB
  1787'   CD 1D7A'              	CALL	COPY12
  178A'   CD 0000*              	CALL	UNDCLR
  178D'                         QRF_Y:
  178D'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  178F'   32 26F4'              	STA	MSGWHT
  1792'   C3 119B'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1795'                         YSPAN:
  1795'   CD 084E'              	CALL	GLSTAL
  1798'   CD 12BA'              	CALL	OPSPNL		; HL = the span's length
  179B'   22 2727'              	SHLD	YTGT
  179E'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  17A1'   EB                    	XCHG			; DE = it
  17A2'   2A 2727'              	LHLD	YTGT
  17A5'   EB                    	XCHG			; HL = the text's, DE = the span's
  17A6'   CD 0000*              	CALL	SUBHD
  17A9'   22 2727'              	SHLD	YTGT		; what the text is left at when the span is out
  17AC'   2A 26C7'              	LHLD	OPLO
  17AF'   CD 0000*              	CALL	GOTO
  17B2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17B5'                         YS_LP:
  17B5'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  17B8'   CD 0000*              	CALL	SETC0
  17BB'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  17BE'   DA 176E'              	JC	QREFUS		; ... which has no room for it
  17C1'   CD 0000*              	CALL	LOGLEN
  17C4'   EB                    	XCHG			; DE = what is left
  17C5'   2A 2727'              	LHLD	YTGT
  17C8'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  17CB'   DA 17D1'              	JC	YS_END		; below it -- cannot happen over whole lines,
  17CE'   C2 17B5'              	JNZ	YS_LP		;   but never spin here if it ever did
  17D1'                         YS_END:
  17D1'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  17D4'                         YNPRE:
  17D4'   2A 0000*              	LHLD	PGTOPM
  17D7'   22 272F'              	SHLD	YNPG
  17DA'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  17DB'                         YNDONE:
  17DB'   2A 26FC'              	LHLD	YOFF
  17DE'   CD 0000*              	CALL	GOTO
  17E1'   2A 0000*              	LHLD	PGTOPM
  17E4'   EB                    	XCHG
  17E5'   2A 272F'              	LHLD	YNPG
  17E8'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  17EB'   C2 06FC'              	JNZ	SETFUL		; it moved under us: repaint after all
  17EE'   C3 06DB'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  17F1'                         YNROOM:
  17F1'   11 0100               	LXI	D,100H
  17F4'   19                    	DAD	D
  17F5'   D8                    	RC			; within a chunk of 64K: no arena holds that
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17F6'   E5                    	PUSH	H		; the span plus its slack
  17F7'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  17FA'   EB                    	XCHG			; HL = free
  17FB'   D1                    	POP	D		; DE = the span plus its slack
  17FC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  17FF'   DA 1807'              	JC	YNR_OK
  1802'   CA 1807'              	JZ	YNR_OK
  1805'   37                    	STC			; not enough: the delete-and-put-back path
  1806'   C9                    	RET
  1807'                         YNR_OK:
  1807'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1808'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1809'                         YNGO:
  1809'   C5                    	PUSH	B
  180A'   CD 066E'              	CALL	GETCNT		; spent here: this yank is happening
  180D'   CD 084E'              	CALL	GLSTAL
  1810'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1813'   C1                    	POP	B
  1814'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1817'                         YNCOPY:
  1817'   2A 2689'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  181A'   7C                    	MOV	A,H		;   the count itself
  181B'   B5                    	ORA	L
  181C'   C2 1822'              	JNZ	YNC_HV
  181F'   21 0001               	LXI	H,1
  1822'                         YNC_HV:
  1822'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1823'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1824'   B4                    	ORA	H
  1825'   CA 1830'              	JZ	YNC_M
  1828'   E5                    	PUSH	H
  1829'   CD 0814'              	CALL	ONLAST		; vim: a count over one on the last line does
  182C'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  182D'   DA 1842'              	JC	YNC_RF
  1830'                         YNC_M:
  1830'   E5                    	PUSH	H
  1831'   CD 0792'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1834'   E1                    	POP	H
  1835'   CD 184A'              	CALL	YNLINE		; BC = the span, measured where it stands
  1838'   D8                    	RC			; not measurable here: let the pager answer it
  1839'   60                    	MOV	H,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  183A'   69                    	MOV	L,C
  183B'   CD 17F1'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  183E'   D8                    	RC			; no: the delete-and-put-back path
  183F'   C3 1809'              	JMP	YNGO
  1842'                         YNC_RF:
  1842'   CD 066E'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1845'   CD 084E'              	CALL	GLSTAL		;   register alone, and that is the command
  1848'   B7                    	ORA	A		; NC: done
  1849'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  184A'                         YNLINE:
  184A'   22 2731'              	SHLD	YNCNT		; the lines it still wants
  184D'   2A 0000*              	LHLD	GAPEND
  1850'                         YNL_LP:
  1850'   EB                    	XCHG			; DE = the scan
  1851'   2A 0000*              	LHLD	TXTEND
  1854'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1857'   EB                    	XCHG			; HL = the scan
  1858'   D2 1878'              	JNC	YNL_EN		; the resident text ran out
  185B'   7E                    	MOV	A,M
  185C'   23                    	INX	H
  185D'   FE 0A                 	CPI	LF
  185F'   C2 1850'              	JNZ	YNL_LP
  1862'   E5                    	PUSH	H
  1863'   2A 2731'              	LHLD	YNCNT
  1866'   2B                    	DCX	H
  1867'   22 2731'              	SHLD	YNCNT
  186A'   7C                    	MOV	A,H
  186B'   B5                    	ORA	L
  186C'   E1                    	POP	H
  186D'   C2 1850'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1870'   EB                    	XCHG			; DE = past the last of them
  1871'   2A 0000*              	LHLD	GAPEND
  1874'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1875'   C3 1886'              	JMP	YNL_BC
  1878'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1878'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  187B'   C2 188D'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  187E'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1881'   EB                    	XCHG			;   count clamps to it as vim's does
  1882'   2A 0000*              	LHLD	GAPEND
  1885'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1886'                         YNL_BC:
  1886'   CD 0000*              	CALL	SUBHD		; HL = the span
  1889'   44                    	MOV	B,H
  188A'   4D                    	MOV	C,L
  188B'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  188C'   C9                    	RET
  188D'                         YNL_NO:
  188D'   37                    	STC
  188E'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  188F'                         YNSPAN:
  188F'   CD 12BA'              	CALL	OPSPNL		; HL = the span's length
  1892'   44                    	MOV	B,H
  1893'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1894'   CD 17F1'              	CALL	YNROOM
  1897'   D8                    	RC			; no room: the delete-and-put-back path
  1898'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1899'   2A 26C7'              	LHLD	OPLO
  189C'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  189F'   C1                    	POP	B
  18A0'   C3 1809'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  18A3'                         VC_P:
  18A3'   CD 166A'              	CALL	QEMPTY
  18A6'   CA 195E'              	JZ	VP_BEL
  18A9'   CD 066E'              	CALL	GETCNT
  18AC'   22 2700'              	SHLD	PCNT
  18AF'   CD 0000*              	CALL	CUROFF
  18B2'   CD 05F7'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  18B5'   C3 18CA'              	JMP	VP_GO
  18B8'                         VCB_P:
  18B8'   CD 166A'              	CALL	QEMPTY
  18BB'   CA 195E'              	JZ	VP_BEL
  18BE'   CD 066E'              	CALL	GETCNT
  18C1'   22 2700'              	SHLD	PCNT
  18C4'   CD 0000*              	CALL	CUROFF
  18C7'   CD 05C7'              	CALL	BOL
  18CA'                         VP_GO:
  18CA'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  18CD'   CD 0000*              	CALL	CUROFF
  18D0'   EB                    	XCHG
  18D1'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  18D4'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  18D7'   DA 18EC'              	JC	VP_IN
  18DA'   EB                    	XCHG			; HL = the put point = LOGLEN
  18DB'   7C                    	MOV	A,H
  18DC'   B5                    	ORA	L
  18DD'   CA 18E9'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  18E0'   2B                    	DCX	H
  18E1'   CD 0000*              	CALL	CHARAT
  18E4'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18E6'   CA 18EC'              	JZ	VP_IN
  18E9'                         VP_BRK:
  18E9'   CD 1468'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  18EC'                         VP_IN:
  18EC'   CD 0000*              	CALL	CUROFF
  18EF'   22 2702'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  18F2'   2A 0000*              	LHLD	QBEG
  18F5'   EB                    	XCHG
  18F6'   2A 0000*              	LHLD	QEND
  18F9'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  18FC'   EB                    	XCHG
  18FD'   22 2704'              	SHLD	PLFS
  1900'   2A 2700'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1903'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1904'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1905'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1907'   C2 190B'              	JNZ	VP_PZ
  190A'   7D                    	MOV	A,L
  190B'                         VP_PZ:
  190B'   32 2706'              	STA	PCPY
  190E'                         VP_LP:
  190E'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1911'   2A 0000*              	LHLD	LNDLT
  1914'   EB                    	XCHG
  1915'   2A 2704'              	LHLD	PLFS
  1918'   19                    	DAD	D
  1919'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  191C'   2A 2700'              	LHLD	PCNT
  191F'   2B                    	DCX	H
  1920'   22 2700'              	SHLD	PCNT
  1923'   7C                    	MOV	A,H
  1924'   B5                    	ORA	L
  1925'   C2 190E'              	JNZ	VP_LP
  1928'   CD 0188'              	CALL	MARKMOD
  192B'   2A 2702'              	LHLD	PPT
  192E'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1931'   CD 084E'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1934'   3A 2706'              	LDA	PCPY
  1937'   B7                    	ORA	A
  1938'   CA 07A9'              	JZ	FNBLNK
  193B'   2A 2704'              	LHLD	PLFS
  193E'   7C                    	MOV	A,H
  193F'   B7                    	ORA	A
  1940'   C2 07A9'              	JNZ	FNBLNK
  1943'   3A 2706'              	LDA	PCPY
  1946'   CD 0D61'              	CALL	MULSAT		; HL = the lines this put put, saturated
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1949'   7C                    	MOV	A,H
  194A'   B7                    	ORA	A
  194B'   C2 07A9'              	JNZ	FNBLNK
  194E'   7D                    	MOV	A,L
  194F'   B7                    	ORA	A
  1950'   CA 07A9'              	JZ	FNBLNK
  1953'   F5                    	PUSH	PSW
  1954'   CD 06E7'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1957'   F1                    	POP	PSW
  1958'   32 268E'              	STA	ILN		; ... which the lines put now replace
  195B'   C3 07A9'              	JMP	FNBLNK
  195E'                         VP_BEL:
  195E'   CD 066E'              	CALL	GETCNT		; the count is spent either way
  1961'   0E 07                 	MVI	C,BEL
  1963'   CD 0000*              	CALL	BCONOU
  1966'   C3 06DB'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1969'                         VIREP:
  1969'   78                    	MOV	A,B
  196A'   FE 01                 	CPI	KT_ACT
  196C'   CA 1A99'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  196F'   FE 02                 	CPI	KT_CHAR
  1971'   C0                    	RNZ			; ignore anything else
  1972'   79                    	MOV	A,C
  1973'   FE 0D                 	CPI	CR
  1975'   CA 19D9'              	JZ	VP_CR
  1978'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  197A'   CA 19D9'              	JZ	VP_CR
  197D'   FE 08                 	CPI	BS
  197F'   CA 19E5'              	JZ	VP_BS
  1982'   FE 7F                 	CPI	DEL
  1984'   CA 19E5'              	JZ	VP_BS
  1987'   32 26D8'              	STA	VRCH		; the calls below do not preserve C
  198A'   CD 06E1'              	CALL	SETLIN		; this row changed
  198D'   CD 0188'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1990'   CD 145B'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1993'   CA 19CB'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1996'   3A 26D8'              	LDA	VRCH
  1999'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  199C'   2A 26D9'              	LHLD	RPDEL
  199F'   7C                    	MOV	A,H
  19A0'   B5                    	ORA	L
  19A1'   CA 19B7'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  19A4'   2A 0000*              	LHLD	GAPEND
  19A7'   EB                    	XCHG
  19A8'   2A 26DD'              	LHLD	RPGE
  19AB'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  19AE'   CA 19B7'              	JZ	VP_OVW
  19B1'   21 0000               	LXI	H,0
  19B4'   22 26D9'              	SHLD	RPDEL		; the text moved: those originals are gone
  19B7'                         VP_OVW:
  19B7'   21 0001               	LXI	H,1
  19BA'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  19BD'   2A 0000*              	LHLD	GAPEND
  19C0'   22 26DD'              	SHLD	RPGE
  19C3'   2A 26D9'              	LHLD	RPDEL
  19C6'   23                    	INX	H
  19C7'   22 26D9'              	SHLD	RPDEL
  19CA'   C9                    	RET
  19CB'                         VP_APP:
  19CB'   3A 26D8'              	LDA	VRCH
  19CE'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  19D1'   2A 26DB'              	LHLD	RPAPP
  19D4'   23                    	INX	H
  19D5'   22 26DB'              	SHLD	RPAPP
  19D8'   C9                    	RET
  19D9'                         VP_CR:
  19D9'   21 0000               	LXI	H,0
  19DC'   22 26D9'              	SHLD	RPDEL		; a line break ends what BS can put back
  19DF'   22 26DB'              	SHLD	RPAPP
  19E2'   C3 1A6F'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  19E5'                         VP_BS:
  19E5'   2A 26DB'              	LHLD	RPAPP
  19E8'   7C                    	MOV	A,H
  19E9'   B5                    	ORA	L
  19EA'   CA 19F7'              	JZ	VP_BSD
  19ED'   2B                    	DCX	H
  19EE'   22 26DB'              	SHLD	RPAPP		; an appended char: it just goes
  19F1'   CD 06E1'              	CALL	SETLIN
  19F4'   C3 0000*              	JMP	DELPRV
  19F7'                         VP_BSD:
  19F7'   2A 26D9'              	LHLD	RPDEL
  19FA'   7C                    	MOV	A,H
  19FB'   B5                    	ORA	L
  19FC'   CA 1A23'              	JZ	VP_BSM		; nothing of ours left
  19FF'   2A 0000*              	LHLD	GAPEND
  1A02'   EB                    	XCHG
  1A03'   2A 26DD'              	LHLD	RPGE
  1A06'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1A09'   C2 1A23'              	JNZ	VP_BSM
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A0C'   2A 26D9'              	LHLD	RPDEL
  1A0F'   2B                    	DCX	H
  1A10'   22 26D9'              	SHLD	RPDEL
  1A13'   CD 06E1'              	CALL	SETLIN
  1A16'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1A19'   CD 0000*              	CALL	UNDELF		; the original comes back
  1A1C'   2A 0000*              	LHLD	GAPEND
  1A1F'   22 26DD'              	SHLD	RPGE
  1A22'   C9                    	RET
  1A23'                         VP_BSM:
  1A23'   CD 06DB'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1A26'   C3 074A'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1A29'                         VIINS:
  1A29'   78                    	MOV	A,B
  1A2A'   FE 01                 	CPI	KT_ACT
  1A2C'   CA 1A99'              	JZ	VI_ACT
  1A2F'   FE 02                 	CPI	KT_CHAR
  1A31'   C0                    	RNZ			; ignore anything else
  1A32'   79                    	MOV	A,C
  1A33'   FE 0D                 	CPI	CR
  1A35'   CA 1A6F'              	JZ	VI_CR
  1A38'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1A3A'   CA 1A6F'              	JZ	VI_CR
  1A3D'   FE 08                 	CPI	BS
  1A3F'   CA 1A87'              	JZ	VI_BS
  1A42'   FE 7F                 	CPI	DEL
  1A44'   CA 1A87'              	JZ	VI_BS
  1A47'   79                    	MOV	A,C
  1A48'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1A4B'   CD 0188'              	CALL	MARKMOD
  1A4E'   CD 06E1'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1A51'   79                    	MOV	A,C
  1A52'   FE 20                 	CPI	' '
  1A54'   D8                    	RC			; control char -> keep R_LINE
  1A55'   FE 7F                 	CPI	DEL
  1A57'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1A58'   CD 0702'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1A5B'   B7                    	ORA	A
  1A5C'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1A5D'   3E 04                 	MVI	A,R_ICH
  1A5F'   32 268D'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1A62'   CD 145B'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1A65'   3E 00                 	MVI	A,0
  1A67'   C2 1A6B'              	JNZ	VI_ICH
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A6A'   3C                    	INR	A
  1A6B'                         VI_ICH:
  1A6B'   32 268F'              	STA	ICHAPP
  1A6E'   C9                    	RET
  1A6F'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1A6F'   CD 145B'              	CALL	ATCEND
  1A72'   3E 00                 	MVI	A,0
  1A74'   CA 1A78'              	JZ	VI_CRS
  1A77'   3C                    	INR	A
  1A78'                         VI_CRS:
  1A78'   F5                    	PUSH	PSW
  1A79'   CD 1468'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1A7C'   CD 147C'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1A7F'   CD 06E7'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1A82'   F1                    	POP	PSW
  1A83'   32 2690'              	STA	ILABOV
  1A86'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1A87'                         VI_BS:
  1A87'   CD 0000*              	CALL	PEEKL
  1A8A'   D8                    	RC			; start of the file: nothing to delete
  1A8B'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1A8D'   CA 1A93'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1A90'   CD 06E1'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1A93'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1A93'   CD 0188'              	CALL	MARKMOD
  1A96'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1A99'                         VI_ACT:
  1A99'   79                    	MOV	A,C
  1A9A'   FE 0B                 	CPI	ACT_ESC
  1A9C'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1A9D'   3E 00                 	MVI	A,EM_CMD
  1A9F'   32 2688'              	STA	EDMODE
  1AA2'   CD 06DB'              	CALL	SETMOV
  1AA5'   CD 074A'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1AA8'   C3 084E'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1AAB'                         RDLINE:
  1AAB'   EB                    	XCHG			; HL = buffer
  1AAC'   22 26DF'              	SHLD	RLPTR
  1AAF'   3E 00                 	MVI	A,0
  1AB1'   32 26E1'              	STA	RLLEN
  1AB4'   78                    	MOV	A,B
  1AB5'   32 26E2'              	STA	RLMAX
  1AB8'   79                    	MOV	A,C
  1AB9'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1ABC'                         RL_LP:
  1ABC'   CD 0000*              	CALL	GETKEY
  1ABF'   78                    	MOV	A,B
  1AC0'   FE 01                 	CPI	KT_ACT
  1AC2'   CA 1B18'              	JZ	RL_ACT
  1AC5'   FE 02                 	CPI	KT_CHAR
  1AC7'   C2 1ABC'              	JNZ	RL_LP		; ignore other keys
  1ACA'   79                    	MOV	A,C
  1ACB'   FE 0D                 	CPI	CR
  1ACD'   CA 1B29'              	JZ	RL_DONE
  1AD0'   FE 08                 	CPI	BS
  1AD2'   CA 1B00'              	JZ	RL_BS
  1AD5'   FE 7F                 	CPI	DEL
  1AD7'   CA 1B00'              	JZ	RL_BS
  1ADA'   FE 20                 	CPI	' '
  1ADC'   DA 1ABC'              	JC	RL_LP		; control char -> ignore
  1ADF'   3A 26E1'              	LDA	RLLEN
  1AE2'   47                    	MOV	B,A
  1AE3'   3A 26E2'              	LDA	RLMAX
  1AE6'   B8                    	CMP	B
  1AE7'   CA 1ABC'              	JZ	RL_LP		; full -> ignore
  1AEA'   2A 26DF'              	LHLD	RLPTR
  1AED'   71                    	MOV	M,C
  1AEE'   23                    	INX	H
  1AEF'   22 26DF'              	SHLD	RLPTR
  1AF2'   3A 26E1'              	LDA	RLLEN
  1AF5'   3C                    	INR	A
  1AF6'   32 26E1'              	STA	RLLEN
  1AF9'   79                    	MOV	A,C
  1AFA'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1AFD'   C3 1ABC'              	JMP	RL_LP
  1B00'                         RL_BS:				; WM LINEPOP
  1B00'   3A 26E1'              	LDA	RLLEN
  1B03'   B7                    	ORA	A
  1B04'   CA 1B1E'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1B07'   3D                    	DCR	A
  1B08'   32 26E1'              	STA	RLLEN
  1B0B'   2A 26DF'              	LHLD	RLPTR
  1B0E'   2B                    	DCX	H
  1B0F'   22 26DF'              	SHLD	RLPTR
  1B12'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1B15'   C3 1ABC'              	JMP	RL_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B18'                         RL_ACT:
  1B18'   79                    	MOV	A,C
  1B19'   FE 0B                 	CPI	ACT_ESC
  1B1B'   C2 1ABC'              	JNZ	RL_LP
  1B1E'                         RL_CAN:
  1B1E'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1B20'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1B23'   CD 06E1'              	CALL	SETLIN		; redraw one row
  1B26'   3E FF                 	MVI	A,0FFH		; cancelled
  1B28'   C9                    	RET
  1B29'                         RL_DONE:
  1B29'   AF                    	XRA	A
  1B2A'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1B2B'                         VC_BZ:
  1B2B'   CD 06DB'              	CALL	SETMOV
  1B2E'   3A 26B1'              	LDA	GSAVE
  1B31'   FE 02                 	CPI	PZ
  1B33'   CA 1B3E'              	JZ	VZ_ZZ
  1B36'   B7                    	ORA	A
  1B37'   C0                    	RNZ			; 'g' was pending: vim drops both
  1B38'   3E 02                 	MVI	A,PZ
  1B3A'   32 26B0'              	STA	GPEND
  1B3D'   C9                    	RET
  1B3E'                         VZ_ZZ:
  1B3E'   3E 04                 	MVI	A,EO_X
  1B40'   32 26E3'              	STA	EXOP
  1B43'   3E 01                 	MVI	A,1
  1B45'   32 26F6'              	STA	EXBANG		; no '!'
  1B48'   AF                    	XRA	A
  1B49'   32 26E4'              	STA	EXARG		; no file name
  1B4C'   3A 268C'              	LDA	MODF		; as ':x': a changed text is written first
  1B4F'   B7                    	ORA	A
  1B50'   CA 1C73'              	JZ	EX_Q
  1B53'   C3 1C0D'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1B56'                         VC_EX:
  1B56'   CD 066E'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B59'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1B5C'   11 0000*              	LXI	D,EXBUF
  1B5F'   06 28                 	MVI	B,EXMAX
  1B61'   0E 3A                 	MVI	C,':'
  1B63'   CD 1AAB'              	CALL	RDLINE
  1B66'   B7                    	ORA	A
  1B67'   C0                    	RNZ			; cancelled
  1B68'   3A 26E1'              	LDA	RLLEN
  1B6B'   5F                    	MOV	E,A
  1B6C'   16 00                 	MVI	D,0
  1B6E'   21 0000*              	LXI	H,EXBUF
  1B71'   19                    	DAD	D
  1B72'   36 00                 	MVI	M,0		; the line ends with a 0
  1B74'   21 0000*              	LXI	H,EXBUF
  1B77'   CD 1F0F'              	CALL	SKIPB
  1B7A'   C8                    	RZ			; nothing on it
  1B7B'   22 26E6'              	SHLD	EXCMD
  1B7E'   CD 20CB'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1B81'   CD 1F0F'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1B84'   56                    	MOV	D,M
  1B85'   23                    	INX	H
  1B86'   1E 00                 	MVI	E,0
  1B88'   CD 1F1B'              	CALL	ISLOW
  1B8B'   DA 1B96'              	JC	EX_LK
  1B8E'   5F                    	MOV	E,A
  1B8F'   23                    	INX	H
  1B90'   CD 1F1B'              	CALL	ISLOW
  1B93'   D2 1BAF'              	JNC	EX_NOT		; a third letter: none of ours
  1B96'                         EX_LK:
  1B96'   E5                    	PUSH	H
  1B97'   21 20B5'              	LXI	H,EXTAB
  1B9A'                         EX_TL:
  1B9A'   7E                    	MOV	A,M
  1B9B'   B7                    	ORA	A
  1B9C'   CA 1BAE'              	JZ	EX_NTP		; not in the table
  1B9F'   23                    	INX	H
  1BA0'   BA                    	CMP	D
  1BA1'   7E                    	MOV	A,M
  1BA2'   23                    	INX	H
  1BA3'   C2 1BAA'              	JNZ	EX_TN
  1BA6'   BB                    	CMP	E
  1BA7'   CA 1BB5'              	JZ	EX_TF
  1BAA'                         EX_TN:
  1BAA'   23                    	INX	H
  1BAB'   C3 1B9A'              	JMP	EX_TL
  1BAE'                         EX_NTP:
  1BAE'   E1                    	POP	H
  1BAF'                         EX_NOT:
  1BAF'   21 1FD3'              	LXI	H,SNOT
  1BB2'   C3 1F50'              	JMP	EXERT
  1BB5'                         EX_TF:
  1BB5'   7E                    	MOV	A,M
  1BB6'   32 26E3'              	STA	EXOP
  1BB9'   E1                    	POP	H
  1BBA'   FE 06                 	CPI	EO_S
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BBC'   CA 213A'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1BBF'   3A 273A'              	LDA	SRNGF
  1BC2'   B7                    	ORA	A
  1BC3'   C2 1BAF'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1BC6'   7E                    	MOV	A,M
  1BC7'   D6 21                 	SUI	'!'
  1BC9'   32 26F6'              	STA	EXBANG		; 0 = '!'
  1BCC'   C2 1BD0'              	JNZ	EX_NB
  1BCF'   23                    	INX	H
  1BD0'                         EX_NB:
  1BD0'   CD 1F0F'              	CALL	SKIPB
  1BD3'   32 26E4'              	STA	EXARG		; 0 = no file name
  1BD6'   CA 1BEF'              	JZ	EX_RUN
  1BD9'   22 26E6'              	SHLD	EXCMD
  1BDC'   3A 26E3'              	LDA	EXOP
  1BDF'   FE 02                 	CPI	EO_Q
  1BE1'   CA 1F4D'              	JZ	EX_TRL		; :q takes none
  1BE4'   FE 07                 	CPI	EO_V
  1BE6'   CA 1F4D'              	JZ	EX_TRL		; nor :ve
  1BE9'   CD 1E79'              	CALL	PARSFN
  1BEC'   C2 1F41'              	JNZ	EX_INV
  1BEF'                         EX_RUN:
  1BEF'   3A 26E3'              	LDA	EXOP
  1BF2'   FE 05                 	CPI	EO_E
  1BF4'   CA 1C8A'              	JZ	EX_E
  1BF7'   FE 02                 	CPI	EO_Q
  1BF9'   CA 1C73'              	JZ	EX_Q
  1BFC'   FE 07                 	CPI	EO_V
  1BFE'   CA 1F47'              	JZ	EX_V
  1C01'   FE 04                 	CPI	EO_X
  1C03'   C2 1C0D'              	JNZ	EX_W
  1C06'   3A 268C'              	LDA	MODF		; :x writes only a changed text
  1C09'   B7                    	ORA	A
  1C0A'   CA 1C73'              	JZ	EX_Q
  1C0D'                         EX_W:
  1C0D'   CD 1CE1'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1C10'   D8                    	RC			; refused (message shown)
  1C11'   32 26E5'              	STA	EXBAK
  1C14'   3A 26E3'              	LDA	EXOP
  1C17'   FE 01                 	CPI	EO_W
  1C19'   CA 1C30'              	JZ	EX_WK
  1C1C'   3A 26E5'              	LDA	EXBAK
  1C1F'   B7                    	ORA	A
  1C20'   C2 1C70'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1C23'   3A 26F6'              	LDA	EXBANG
  1C26'   B7                    	ORA	A
  1C27'   CA 1C70'              	JZ	EX_WQ		; so it does with '!'
  1C2A'   CD 1C30'              	CALL	EX_WK		; else it may not: keep the text
  1C2D'   C3 1C73'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1C30'                         EX_WK:
  1C30'   CD 0C6D'              	CALL	CURRW		; the cursor's row and file position
  1C33'   32 26E8'              	STA	WPROW
  1C36'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1C39'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C3A'   E6 7F                 	ANI	7FH
  1C3C'   32 26E9'              	STA	WPBYT
  1C3F'   7D                    	MOV	A,L
  1C40'   17                    	RAL
  1C41'   7C                    	MOV	A,H
  1C42'   17                    	RAL
  1C43'   5F                    	MOV	E,A
  1C44'   3E 00                 	MVI	A,0
  1C46'   17                    	RAL
  1C47'   57                    	MOV	D,A		; DE = HL / 128
  1C48'   2A 0000*              	LHLD	OUTPOS
  1C4B'   19                    	DAD	D
  1C4C'   22 26EA'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1C4F'   CD 1D16'              	CALL	WRITE
  1C52'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1C55'   2A 26EA'              	LHLD	WPREC
  1C58'   EB                    	XCHG
  1C59'   3A 26E9'              	LDA	WPBYT
  1C5C'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1C5F'   CD 0000*              	CALL	GOTO
  1C62'   21 0000               	LXI	H,0
  1C65'   22 0000*              	SHLD	LNDLT
  1C68'   3A 26E8'              	LDA	WPROW
  1C6B'   6F                    	MOV	L,A
  1C6C'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1C6F'   C9                    	RET
  1C70'                         EX_WQ:
  1C70'   CD 1D16'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1C73'                         EX_Q:
  1C73'   3A 26F6'              	LDA	EXBANG
  1C76'   B7                    	ORA	A
  1C77'   CA 1C81'              	JZ	EX_QT
  1C7A'   3A 268C'              	LDA	MODF
  1C7D'   B7                    	ORA	A
  1C7E'   C2 1F35'              	JNZ	MSGNWR		; changed, no '!': stay
  1C81'                         EX_QT:
  1C81'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1C84'   3E 01                 	MVI	A,1
  1C86'   32 268B'              	STA	QUITF
  1C89'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1C8A'                         EX_E:
  1C8A'   3A 26F6'              	LDA	EXBANG
  1C8D'   B7                    	ORA	A
  1C8E'   CA 1C98'              	JZ	EE_GO
  1C91'   3A 268C'              	LDA	MODF
  1C94'   B7                    	ORA	A
  1C95'   C2 1F35'              	JNZ	MSGNWR
  1C98'                         EE_GO:
  1C98'   3A 26E4'              	LDA	EXARG
  1C9B'   B7                    	ORA	A
  1C9C'   C2 1CA3'              	JNZ	EE_ARG
  1C9F'   CD 1D52'              	CALL	OWNTF		; no name: the buffer's own
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1CA2'   D8                    	RC
  1CA3'                         EE_ARG:
  1CA3'   CD 1D68'              	CALL	ISOWN
  1CA6'   21 0001               	LXI	H,1
  1CA9'   C2 1CB0'              	JNZ	EE_LD		; another file: its first line
  1CAC'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1CAF'   23                    	INX	H		; HL = the cursor's line
  1CB0'                         EE_LD:
  1CB0'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1CB2'   32 26F4'              	STA	MSGWHT
  1CB5'   E5                    	PUSH	H
  1CB6'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1CB9'   21 0000*              	LXI	H,TFCB
  1CBC'   11 0000*              	LXI	D,FNAME
  1CBF'   CD 1D7A'              	CALL	COPY12		; the buffer's name
  1CC2'   CD 1D3F'              	CALL	SRCTF
  1CC5'   CD 0000*              	CALL	REOPEN
  1CC8'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1CCB'   AF                    	XRA	A
  1CCC'   32 268C'              	STA	MODF
  1CCF'   E1                    	POP	H
  1CD0'   2B                    	DCX	H
  1CD1'   AF                    	XRA	A
  1CD2'   CD 0000*              	CALL	MVLIND		; down to the line
  1CD5'   CD 0985'              	CALL	ATEOF
  1CD8'   DC 098B'              	CC	LASTLN		; past the last line: onto it
  1CDB'   CD 0E99'              	CALL	ZSAVE
  1CDE'   C3 0F7C'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1CE1'                         WRCHK:
  1CE1'   3A 26E4'              	LDA	EXARG
  1CE4'   B7                    	ORA	A
  1CE5'   C2 1CEF'              	JNZ	WC_ARG
  1CE8'   CD 1D52'              	CALL	OWNTF
  1CEB'   D8                    	RC
  1CEC'   C3 1D04'              	JMP	WC_OWN
  1CEF'                         WC_ARG:
  1CEF'   CD 1D68'              	CALL	ISOWN
  1CF2'   CA 1D04'              	JZ	WC_OWN
  1CF5'   3A 26F6'              	LDA	EXBANG
  1CF8'   B7                    	ORA	A
  1CF9'   CA 1D02'              	JZ	WC_OTH
  1CFC'   CD 0000*              	CALL	TEXIST
  1CFF'   C2 1F29'              	JNZ	MSGEXI		; File exists (! to force)
  1D02'                         WC_OTH:
  1D02'   AF                    	XRA	A		; (NC)
  1D03'   C9                    	RET
  1D04'                         WC_OWN:
  1D04'   3A 26F7'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1D07'   B7                    	ORA	A
  1D08'   CA 1D12'              	JZ	WC_OK
  1D0B'   3A 26F6'              	LDA	EXBANG
  1D0E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D0F'   C2 1F2F'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1D12'                         WC_OK:
  1D12'   3E 01                 	MVI	A,1
  1D14'   B7                    	ORA	A		; (NC)
  1D15'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1D16'                         WRITE:
  1D16'   3A 26E5'              	LDA	EXBAK
  1D19'   CD 0000*              	CALL	WRTO
  1D1C'   3A 0001*              	LDA	FNAME+1
  1D1F'   FE 20                 	CPI	' '
  1D21'   C2 1D2D'              	JNZ	WR_HAS
  1D24'   21 0000*              	LXI	H,TFCB
  1D27'   11 0000*              	LXI	D,FNAME
  1D2A'   CD 1D7A'              	CALL	COPY12
  1D2D'                         WR_HAS:
  1D2D'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1D2F'   32 26F4'              	STA	MSGWHT
  1D32'   CD 1D68'              	CALL	ISOWN
  1D35'   C2 1D3F'              	JNZ	SRCTF
  1D38'   AF                    	XRA	A
  1D39'   32 268C'              	STA	MODF
  1D3C'   32 26F5'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1D3F'                         SRCTF:
  1D3F'   21 0000*              	LXI	H,TFCB
  1D42'   11 005C               	LXI	D,DFTFCB
  1D45'   CD 1D7A'              	CALL	COPY12
  1D48'   AF                    	XRA	A
  1D49'   06 04                 	MVI	B,4
  1D4B'                         SRC_Z:
  1D4B'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1D4C'   13                    	INX	D
  1D4D'   05                    	DCR	B
  1D4E'   C2 1D4B'              	JNZ	SRC_Z
  1D51'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1D52'                         OWNTF:
  1D52'   3A 0001*              	LDA	FNAME+1
  1D55'   FE 20                 	CPI	' '
  1D57'   CA 1F23'              	JZ	MSGNFN
  1D5A'   CD 1D85'              	CALL	TFCLR
  1D5D'   21 0000*              	LXI	H,FNAME
  1D60'   11 0000*              	LXI	D,TFCB
  1D63'   CD 1D7A'              	CALL	COPY12
  1D66'   B7                    	ORA	A		; (NC)
  1D67'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1D68'                         ISOWN:
  1D68'   21 0000*              	LXI	H,TFCB
  1D6B'   11 0000*              	LXI	D,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D6E'   06 0C                 	MVI	B,12
  1D70'                         IO_LP:
  1D70'   1A                    	LDAX	D
  1D71'   BE                    	CMP	M
  1D72'   C0                    	RNZ
  1D73'   23                    	INX	H
  1D74'   13                    	INX	D
  1D75'   05                    	DCR	B
  1D76'   C2 1D70'              	JNZ	IO_LP
  1D79'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1D7A'                         COPY12:
  1D7A'   06 0C                 	MVI	B,12
  1D7C'                         CP_LP:
  1D7C'   7E                    	MOV	A,M
  1D7D'   12                    	STAX	D
  1D7E'   23                    	INX	H
  1D7F'   13                    	INX	D
  1D80'   05                    	DCR	B
  1D81'   C2 1D7C'              	JNZ	CP_LP
  1D84'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1D85'                         TFCLR:
  1D85'   11 0000*              	LXI	D,TFCB
  1D88'   06 24                 	MVI	B,36
  1D8A'   AF                    	XRA	A
  1D8B'                         TC_LP:
  1D8B'   12                    	STAX	D
  1D8C'   13                    	INX	D
  1D8D'   05                    	DCR	B
  1D8E'   C2 1D8B'              	JNZ	TC_LP
  1D91'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1D92'                         FOPEN:
  1D92'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1D94'   32 26F4'              	STA	MSGWHT
  1D97'   21 005C               	LXI	H,DFTFCB
  1D9A'   CD 1E6C'              	CALL	NRMDRV
  1D9D'   11 0000*              	LXI	D,FNAME
  1DA0'   CD 1D7A'              	CALL	COPY12
  1DA3'   CD 0000*              	CALL	OPENZ
  1DA6'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1DA9'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1DAB'   C8                    	RZ
  1DAC'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1DAF'   32 26F5'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1DB2'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1DB3'                         ARGSCN:
  1DB3'   3A 0080               	LDA	CMDTAIL
  1DB6'   47                    	MOV	B,A		; B = what is left of the line
  1DB7'   B7                    	ORA	A
  1DB8'   C8                    	RZ
  1DB9'   21 0081               	LXI	H,CMDTAIL+1
  1DBC'                         AS_TOK:				; at a token, or the blanks before one
  1DBC'   7E                    	MOV	A,M
  1DBD'   FE 20                 	CPI	' '
  1DBF'   C2 1DC8'              	JNZ	AS_OPT
  1DC2'   23                    	INX	H
  1DC3'   05                    	DCR	B
  1DC4'   C2 1DBC'              	JNZ	AS_TOK
  1DC7'   C9                    	RET
  1DC8'                         AS_OPT:
  1DC8'   FE 2B                 	CPI	'+'
  1DCA'   CA 1DF4'              	JZ	AS_PLS
  1DCD'   FE 2D                 	CPI	'-'
  1DCF'   CA 1DE3'              	JZ	AS_SW
  1DD2'   FE 2F                 	CPI	'/'
  1DD4'   CA 1DE3'              	JZ	AS_SW
  1DD7'                         AS_SKP:				; not ours (the file name): on to the next one
  1DD7'   23                    	INX	H
  1DD8'   05                    	DCR	B
  1DD9'   C8                    	RZ
  1DDA'   7E                    	MOV	A,M
  1DDB'   FE 20                 	CPI	' '
  1DDD'   C2 1DD7'              	JNZ	AS_SKP
  1DE0'   C3 1DBC'              	JMP	AS_TOK
  1DE3'                         AS_SW:
  1DE3'   23                    	INX	H
  1DE4'   05                    	DCR	B
  1DE5'   C8                    	RZ
  1DE6'   7E                    	MOV	A,M
  1DE7'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DE9'   FE 52                 	CPI	'R'
  1DEB'   C2 1DD7'              	JNZ	AS_SKP
  1DEE'   32 26F7'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1DF1'   C3 1DD7'              	JMP	AS_SKP
  1DF4'                         AS_PLS:
  1DF4'   3E 01                 	MVI	A,1
  1DF6'   32 26F8'              	STA	PLUSF		; '+' gets the line even with no number on it
  1DF9'   11 0000*              	LXI	D,PLUSB
  1DFC'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1DFE'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1DFF'   05                    	DCR	B
  1E00'   CA 1E37'              	JZ	AS_PE
  1E03'   7E                    	MOV	A,M
  1E04'   FE 30                 	CPI	'0'
  1E06'   C2 1E1E'              	JNZ	AS_PD
  1E09'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1E09'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1E0A'   05                    	DCR	B
  1E0B'   CA 1E3F'              	JZ	AS_P1
  1E0E'   7E                    	MOV	A,M
  1E0F'   FE 30                 	CPI	'0'
  1E11'   CA 1E09'              	JZ	AS_PZ
  1E14'   FE 31                 	CPI	'1'
  1E16'   DA 1E3F'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1E19'   FE 3A                 	CPI	'9'+1
  1E1B'   D2 1E3F'              	JNC	AS_P1
  1E1E'                         AS_PD:				; the digits, as typed
  1E1E'   7E                    	MOV	A,M
  1E1F'   FE 30                 	CPI	'0'
  1E21'   DA 1E37'              	JC	AS_PE
  1E24'   FE 3A                 	CPI	'9'+1
  1E26'   D2 1E37'              	JNC	AS_PE
  1E29'   79                    	MOV	A,C
  1E2A'   B7                    	ORA	A
  1E2B'   CA 1E46'              	JZ	AS_POV
  1E2E'   0D                    	DCR	C
  1E2F'   7E                    	MOV	A,M
  1E30'   12                    	STAX	D
  1E31'   13                    	INX	D
  1E32'   23                    	INX	H
  1E33'   05                    	DCR	B
  1E34'   C2 1E1E'              	JNZ	AS_PD
  1E37'                         AS_PE:
  1E37'   AF                    	XRA	A
  1E38'   12                    	STAX	D		; the digits end with a 0
  1E39'   78                    	MOV	A,B
  1E3A'   B7                    	ORA	A
  1E3B'   C8                    	RZ
  1E3C'   C3 1DBC'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1E3F'                         AS_P1:
  1E3F'   3E 31                 	MVI	A,'1'
  1E41'   12                    	STAX	D
  1E42'   13                    	INX	D
  1E43'   C3 1E37'              	JMP	AS_PE
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E46'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1E46'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1E49'   C3 1E37'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1E4C'                         ARGGO:
  1E4C'   3A 26F8'              	LDA	PLUSF
  1E4F'   B7                    	ORA	A
  1E50'   C8                    	RZ
  1E51'   21 0000*              	LXI	H,PLUSB
  1E54'                         AG_LP:
  1E54'   7E                    	MOV	A,M
  1E55'   B7                    	ORA	A
  1E56'   CA 1E65'              	JZ	AG_G
  1E59'   4F                    	MOV	C,A
  1E5A'   06 02                 	MVI	B,KT_CHAR
  1E5C'   E5                    	PUSH	H
  1E5D'   CD 001F'              	CALL	VICMD
  1E60'   E1                    	POP	H
  1E61'   23                    	INX	H
  1E62'   C3 1E54'              	JMP	AG_LP
  1E65'                         AG_G:
  1E65'   0E 47                 	MVI	C,'G'
  1E67'   06 02                 	MVI	B,KT_CHAR
  1E69'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1E6C'                         NRMDRV:
  1E6C'   7E                    	MOV	A,M
  1E6D'   B7                    	ORA	A
  1E6E'   C0                    	RNZ
  1E6F'   E5                    	PUSH	H
  1E70'   0E 19                 	MVI	C,BF_CURDSK
  1E72'   CD 0005               	CALL	BDOS
  1E75'   E1                    	POP	H
  1E76'   3C                    	INR	A
  1E77'   77                    	MOV	M,A
  1E78'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1E79'                         PARSFN:
  1E79'   CD 1D85'              	CALL	TFCLR
  1E7C'   11 0000*              	LXI	D,TFCB
  1E7F'   23                    	INX	H
  1E80'   7E                    	MOV	A,M
  1E81'   2B                    	DCX	H
  1E82'   FE 3A                 	CPI	':'
  1E84'   C2 1E96'              	JNZ	PF_NM
  1E87'   CD 1EDC'              	CALL	GETFNC
