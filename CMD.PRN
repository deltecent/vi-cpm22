  1EE4'   74 74 65 6E           
  1EE8'   00                    
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1EE9'                         EXTAB:
  1EE9'   77 00 01              	DB	'w',0,EO_W
  1EEC'   71 00 02              	DB	'q',0,EO_Q
  1EEF'   77 71 03              	DB	'w','q',EO_WQ
  1EF2'   78 00 04              	DB	'x',0,EO_X
  1EF5'   65 00 05              	DB	'e',0,EO_E
  1EF8'   73 00 06              	DB	's',0,EO_S
  1EFB'   76 65 07              	DB	'v','e',EO_V
  1EFE'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1EFF'                         EXADDR:
  1EFF'   AF                    	XRA	A
  1F00'   32 2554'              	STA	SRNGF
  1F03'   7E                    	MOV	A,M
  1F04'   FE 25                 	CPI	'%'
  1F06'   CA 1F2F'              	JZ	EXA_AL
  1F09'   EB                    	XCHG			; DE walks the line, HL takes the number
  1F0A'   CD 1F44'              	CALL	EXNUM
  1F0D'   DA 1F2D'              	JC	EXA_NO
  1F10'   22 2555'              	SHLD	SRNG1
  1F13'   22 2557'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1F16'   1A                    	LDAX	D
  1F17'   FE 2C                 	CPI	','
  1F19'   C2 1F26'              	JNZ	EXA_YS
  1F1C'   13                    	INX	D
  1F1D'   CD 1F44'              	CALL	EXNUM
  1F20'   DA 1F2D'              	JC	EXA_NO		; ',' with no number: not a range at all
  1F23'   22 2557'              	SHLD	SRNG2
  1F26'                         EXA_YS:
  1F26'   EB                    	XCHG
  1F27'   3E 01                 	MVI	A,1
  1F29'   32 2554'              	STA	SRNGF
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F2C'   C9                    	RET
  1F2D'                         EXA_NO:
  1F2D'   EB                    	XCHG
  1F2E'   C9                    	RET
  1F2F'                         EXA_AL:
  1F2F'   23                    	INX	H
  1F30'   E5                    	PUSH	H
  1F31'   21 0001               	LXI	H,1
  1F34'   22 2555'              	SHLD	SRNG1
  1F37'   21 FFFF               	LXI	H,0FFFFH
  1F3A'   22 2557'              	SHLD	SRNG2
  1F3D'   E1                    	POP	H
  1F3E'   3E 01                 	MVI	A,1
  1F40'   32 2554'              	STA	SRNGF
  1F43'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1F44'                         EXNUM:
  1F44'   1A                    	LDAX	D
  1F45'   D6 30                 	SUI	'0'
  1F47'   D8                    	RC
  1F48'   FE 0A                 	CPI	10
  1F4A'   3F                    	CMC
  1F4B'   D8                    	RC
  1F4C'   21 0000               	LXI	H,0
  1F4F'                         EXN_LP:
  1F4F'   1A                    	LDAX	D
  1F50'   D6 30                 	SUI	'0'
  1F52'   DA 1F6C'              	JC	EXN_DN
  1F55'   FE 0A                 	CPI	10
  1F57'   D2 1F6C'              	JNC	EXN_DN
  1F5A'   13                    	INX	D
  1F5B'   C5                    	PUSH	B
  1F5C'   4F                    	MOV	C,A
  1F5D'   06 00                 	MVI	B,0		; BC = the digit
  1F5F'   D5                    	PUSH	D
  1F60'   54                    	MOV	D,H
  1F61'   5D                    	MOV	E,L
  1F62'   29                    	DAD	H		; *2
  1F63'   29                    	DAD	H		; *4
  1F64'   19                    	DAD	D		; *5
  1F65'   29                    	DAD	H		; *10
  1F66'   D1                    	POP	D
  1F67'   09                    	DAD	B
  1F68'   C1                    	POP	B
  1F69'   C3 1F4F'              	JMP	EXN_LP
  1F6C'                         EXN_DN:
  1F6C'   B7                    	ORA	A		; CY clear: there was a number
  1F6D'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1F6E'                         EX_S:
  1F6E'   7E                    	MOV	A,M
  1F6F'   B7                    	ORA	A
  1F70'   CA 1FB2'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                				;   built (COMMANDS.md)
  1F73'   32 2559'              	STA	SDELIM
  1F76'   23                    	INX	H
  1F77'   11 0000*              	LXI	D,SRCHST
  1F7A'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1F7D'   4F                    	MOV	C,A
  1F7E'   CD 1FB8'              	CALL	SCOPY
  1F81'   78                    	MOV	A,B
  1F82'   B7                    	ORA	A
  1F83'   CA 1FB2'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1F86'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1F89'   3E 01                 	MVI	A,1
  1F8B'   32 2525'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1F8E'   11 2566'              	LXI	D,SREPL
  1F91'   0E 24                 	MVI	C,SREPMX
  1F93'   CD 1FB8'              	CALL	SCOPY
  1F96'   78                    	MOV	A,B
  1F97'   32 2565'              	STA	SREPLN
  1F9A'   AF                    	XRA	A
  1F9B'   32 255A'              	STA	SGFLAG
  1F9E'   7E                    	MOV	A,M
  1F9F'   FE 67                 	CPI	'g'
  1FA1'   C2 1FAA'              	JNZ	EX_SG
  1FA4'   23                    	INX	H
  1FA5'   3E 01                 	MVI	A,1
  1FA7'   32 255A'              	STA	SGFLAG
  1FAA'                         EX_SG:
  1FAA'   7E                    	MOV	A,M
  1FAB'   B7                    	ORA	A
  1FAC'   C2 1D93'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1FAF'   C3 1FD8'              	JMP	SUBGO
  1FB2'                         SUBNOP:
  1FB2'   21 1E3F'              	LXI	H,SNOPAT
  1FB5'   C3 1DA1'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1FB8'                         SCOPY:
  1FB8'   06 00                 	MVI	B,0
  1FBA'                         SCP_LP:
  1FBA'   78                    	MOV	A,B
  1FBB'   B9                    	CMP	C
  1FBC'   D2 1FD5'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1FBF'   7E                    	MOV	A,M
  1FC0'   B7                    	ORA	A
  1FC1'   CA 1FD5'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1FC4'   E5                    	PUSH	H
  1FC5'   21 2559'              	LXI	H,SDELIM
  1FC8'   BE                    	CMP	M
  1FC9'   E1                    	POP	H
  1FCA'   CA 1FD4'              	JZ	SCP_SK
  1FCD'   12                    	STAX	D
  1FCE'   13                    	INX	D
  1FCF'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FD0'   04                    	INR	B
  1FD1'   C3 1FBA'              	JMP	SCP_LP
  1FD4'                         SCP_SK:
  1FD4'   23                    	INX	H
  1FD5'                         SCP_DN:
  1FD5'   AF                    	XRA	A
  1FD6'   12                    	STAX	D
  1FD7'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1FD8'                         SUBGO:
  1FD8'   CD 0EAA'              	CALL	GZONE
  1FDB'   2A 0000*              	LHLD	LNDLT
  1FDE'   22 2563'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1FE1'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1FE4'   22 2561'              	SHLD	SOFFS		;   search's SN_BAD does
  1FE7'   AF                    	XRA	A
  1FE8'   32 255B'              	STA	SANY
  1FEB'   21 0000               	LXI	H,0
  1FEE'   22 255D'              	SHLD	SBACK
  1FF1'   3A 2554'              	LDA	SRNGF
  1FF4'   B7                    	ORA	A
  1FF5'   CA 201E'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1FF8'   2A 2555'              	LHLD	SRNG1
  1FFB'   7C                    	MOV	A,H
  1FFC'   B5                    	ORA	L
  1FFD'   CA 209A'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  2000'   2A 2557'              	LHLD	SRNG2
  2003'   EB                    	XCHG
  2004'   2A 2555'              	LHLD	SRNG1
  2007'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  200A'   DA 209A'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  200D'   EB                    	XCHG			; HL = the last line, DE = the first
  200E'   CD 0000*              	CALL	SUBHD
  2011'   23                    	INX	H		; HL = the lines in the range
  2012'   22 255F'              	SHLD	SLINES
  2015'   2A 2555'              	LHLD	SRNG1
  2018'   CD 0E2B'              	CALL	GOLN
  201B'   C3 2024'              	JMP	SUBLP
  201E'                         SUB_1L:
  201E'   21 0001               	LXI	H,1
  2021'   22 255F'              	SHLD	SLINES
  2024'                         SUBLP:
  2024'   CD 20A0'              	CALL	SUBLIN		; A = 1 when this line changed
  2027'   B7                    	ORA	A
  2028'   CA 2036'              	JZ	SUB_NX
  202B'   3E 01                 	MVI	A,1
  202D'   32 255B'              	STA	SANY
  2030'   21 0000               	LXI	H,0
  2033'   22 255D'              	SHLD	SBACK		; the cursor is ON the last line changed
  2036'                         SUB_NX:
  2036'   2A 255F'              	LHLD	SLINES
  2039'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  203A'   22 255F'              	SHLD	SLINES
  203D'   7C                    	MOV	A,H
  203E'   B5                    	ORA	L
  203F'   CA 205D'              	JZ	SUBDON		; the range is spent
  2042'   21 0001               	LXI	H,1
  2045'   AF                    	XRA	A
  2046'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2049'   3A 255B'              	LDA	SANY
  204C'   B7                    	ORA	A
  204D'   CA 2057'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2050'   2A 255D'              	LHLD	SBACK
  2053'   23                    	INX	H
  2054'   22 255D'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2057'                         SUB_AE:
  2057'   CD 0970'              	CALL	ATEOF
  205A'   D2 2024'              	JNC	SUBLP		; ... unless that ran off the end of the file
  205D'                         SUBDON:
  205D'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2060'   3A 255B'              	LDA	SANY
  2063'   B7                    	ORA	A
  2064'   CA 2082'              	JZ	SUBNFD
  2067'   3E 01                 	MVI	A,1
  2069'   32 24B2'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  206C'   2A 255D'              	LHLD	SBACK
  206F'   7C                    	MOV	A,H
  2070'   B5                    	ORA	L
  2071'   CA 207C'              	JZ	SUB_PL
  2074'   3E FF                 	MVI	A,0FFH
  2076'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2079'   CD 0000*              	CALL	CLRCNT
  207C'                         SUB_PL:
  207C'   CD 0EC2'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  207F'   C3 06E7'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2082'                         SUBNFD:
  2082'   2A 2561'              	LHLD	SOFFS
  2085'   CD 0000*              	CALL	GOTO
  2088'   2A 2563'              	LHLD	SLDLTS
  208B'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  208E'   21 1E2B'              	LXI	H,SNOTFD
  2091'   CD 1DA1'              	CALL	EXERR
  2094'   21 0000*              	LXI	H,SRCHST
  2097'   C3 1D9C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  209A'                         SUBBAD:
  209A'   21 1E19'              	LXI	H,SNOT
  209D'   C3 1D96'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  20A0'                         SUBLIN:
  20A0'   AF                    	XRA	A
  20A1'   32 255C'              	STA	SLCHG
  20A4'   CD 211F'              	CALL	SUBBOL
  20A7'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  20AA'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  20AA'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  20AD'   DA 20B5'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  20B0'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  20B2'   C2 20AA'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  20B5'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  20B5'   CD 0000*              	CALL	CUROFF
  20B8'   E5                    	PUSH	H
  20B9'   CD 125D'              	CALL	CEND
  20BC'   D1                    	POP	D
  20BD'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  20C0'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  20C1'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  20C4'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  20C5'   B7                    	ORA	A		;   span is a line, not a pair.)
  20C6'   FA 2118'              	JM	SUBL_D		; what is left is shorter than the pattern
  20C9'   44                    	MOV	B,H
  20CA'   4D                    	MOV	C,L		; BC = the start positions a match can take
  20CB'   11 0000*              	LXI	D,SRCHST
  20CE'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  20D1'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  20D4'   DA 2118'              	JC	SUBL_D
  20D7'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  20DA'   EB                    	XCHG
  20DB'   2A 0000*              	LHLD	GAPEND
  20DE'   EB                    	XCHG
  20DF'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  20E2'   EB                    	XCHG
  20E3'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  20E4'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  20E7'   D1                    	POP	D
  20E8'   19                    	DAD	D		; ... and so the match's logical offset
  20E9'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  20EC'   3A 255B'              	LDA	SANY
  20EF'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  20F0'   C2 20FD'              	JNZ	SUBL_C
  20F3'   3A 255C'              	LDA	SLCHG
  20F6'   B7                    	ORA	A
  20F7'   C2 20FD'              	JNZ	SUBL_C
  20FA'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  20FD'                         SUBL_C:
  20FD'   3A 0000*              	LDA	SRCHBF
  2100'   6F                    	MOV	L,A
  2101'   26 00                 	MVI	H,0
  2103'   CD 0000*              	CALL	DELFWD		; the match goes
  2106'   11 2565'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2109'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  210C'                         SUBL_I:
  210C'   3E 01                 	MVI	A,1
  210E'   32 255C'              	STA	SLCHG
  2111'   3A 255A'              	LDA	SGFLAG
  2114'   B7                    	ORA	A
  2115'   C2 20B5'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2118'                         SUBL_D:
  2118'   CD 211F'              	CALL	SUBBOL
  211B'   3A 255C'              	LDA	SLCHG
  211E'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  211F'                         SUBBOL:
  211F'   CD 0000*              	CALL	CUROFF
  2122'   CD 05B2'              	CALL	BOL
  2125'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2128'                         VC_SRCH:
  2128'   CD 06C6'              	CALL	SETMOV
  212B'   C5                    	PUSH	B
  212C'   CD 0659'              	CALL	GETCNT
  212F'   22 254D'              	SHLD	SCNT
  2132'   C1                    	POP	B
  2133'   79                    	MOV	A,C
  2134'   FE 2F                 	CPI	'/'
  2136'   3E 00                 	MVI	A,0
  2138'   CA 213D'              	JZ	VS_DIR
  213B'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  213D'                         VS_DIR:
  213D'   32 2523'              	STA	SDIR
  2140'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2143'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2146'   47                    	MOV	B,A
  2147'   CD 18F1'              	CALL	RDLINE
  214A'   B7                    	ORA	A
  214B'   C0                    	RNZ			; cancelled: nothing happens at all
  214C'   3A 24FB'              	LDA	RLLEN
  214F'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2150'   CA 2165'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2153'   5F                    	MOV	E,A
  2154'   16 00                 	MVI	D,0
  2156'   21 0000*              	LXI	H,SRCHST
  2159'   19                    	DAD	D
  215A'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  215C'   7B                    	MOV	A,E
  215D'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2160'   3E 01                 	MVI	A,1
  2162'   32 2525'              	STA	SHAVE
  2165'                         VS_OLD:
  2165'   3A 2525'              	LDA	SHAVE
  2168'   B7                    	ORA	A
  2169'   CA 2175'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  216C'   3A 2523'              	LDA	SDIR
  216F'   32 2524'              	STA	SDIRE
  2172'   C3 219E'              	JMP	SRCHN
  2175'                         VS_NOP:
  2175'   21 1E3F'              	LXI	H,SNOPAT
  2178'   C3 1DA1'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  217B'                         VC_N:
  217B'   CD 06C6'              	CALL	SETMOV
  217E'   3A 2523'              	LDA	SDIR
  2181'   C3 218B'              	JMP	VN_GO
  2184'                         VCB_N:
  2184'   CD 06C6'              	CALL	SETMOV
  2187'   3A 2523'              	LDA	SDIR
  218A'   2F                    	CMA			; the other way: 0 <-> FFH
  218B'                         VN_GO:
  218B'   32 2524'              	STA	SDIRE
  218E'   CD 0659'              	CALL	GETCNT
  2191'   22 254D'              	SHLD	SCNT
  2194'   3A 2525'              	LDA	SHAVE
  2197'   B7                    	ORA	A
  2198'   CA 2175'              	JZ	VS_NOP
  219B'   C3 219E'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  219E'                         SRCHN:
  219E'   CD 0EAA'              	CALL	GZONE		; the screen's top line, before the cursor moves
  21A1'   2A 0000*              	LHLD	LNDLT
  21A4'   22 2551'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  21A7'   CD 0000*              	CALL	CUROFF
  21AA'   22 254F'              	SHLD	SOFF
  21AD'                         SN_LP:
  21AD'   CD 21E5'              	CALL	SRCHGO
  21B0'   DA 21CA'              	JC	SN_BAD
  21B3'   2A 254D'              	LHLD	SCNT
  21B6'   2B                    	DCX	H
  21B7'   22 254D'              	SHLD	SCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21BA'   7C                    	MOV	A,H
  21BB'   B5                    	ORA	L
  21BC'   C2 21AD'              	JNZ	SN_LP
  21BF'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  21C2'   3E 01                 	MVI	A,1
  21C4'   32 2530'              	STA	GPKEEP		; land on the match, not the first non-blank
  21C7'   C3 0EC2'              	JMP	GPLACE		; (which sets LNDLT itself)
  21CA'                         SN_BAD:
  21CA'   CD 0000*              	CALL	CLRCNT
  21CD'   2A 254F'              	LHLD	SOFF
  21D0'   CD 0000*              	CALL	GOTO
  21D3'   2A 2551'              	LHLD	SLDLT
  21D6'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  21D9'   21 1E2B'              	LXI	H,SNOTFD
  21DC'   CD 1DA1'              	CALL	EXERR
  21DF'   21 0000*              	LXI	H,SRCHST
  21E2'   C3 1D9C'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  21E5'                         SRCHGO:
  21E5'   3E 01                 	MVI	A,1
  21E7'   32 2553'              	STA	SSKIP		; this pass starts one past the cursor
  21EA'   CD 21FC'              	CALL	SRCHW
  21ED'   D0                    	RNC
  21EE'   3A 2524'              	LDA	SDIRE
  21F1'   2F                    	CMA
  21F2'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  21F5'   AF                    	XRA	A
  21F6'   32 2553'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  21F9'   C3 21FC'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  21FC'                         SRCHW:
  21FC'   3A 2524'              	LDA	SDIRE
  21FF'   32 0000*              	STA	DIRFLG
  2202'   21 FFFF               	LXI	H,0FFFFH
  2205'   22 24AF'              	SHLD	CMDCNT
  2208'   AF                    	XRA	A
  2209'   32 0000*              	STA	AUXCNT
  220C'                         SW_LP:
  220C'   CD 2218'              	CALL	SRCH1
  220F'   D0                    	RNC
  2210'   CD 0000*              	CALL	SCRLST
  2213'   D2 220C'              	JNC	SW_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2216'   37                    	STC
  2217'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2218'                         SRCH1:
  2218'   11 0000*              	LXI	D,SRCHST
  221B'   3A 0000*              	LDA	DIRFLG
  221E'   B7                    	ORA	A
  221F'   FA 2243'              	JM	SR1_BK
  2222'   21 0000*              	LXI	H,GAPEND
  2225'   CD 0000*              	CALL	FWDCNT
  2228'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  222B'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  222C'   3A 2553'              	LDA	SSKIP
  222F'   B7                    	ORA	A
  2230'   CA 2239'              	JZ	SR1_FW
  2233'   78                    	MOV	A,B
  2234'   B1                    	ORA	C
  2235'   37                    	STC
  2236'   C8                    	RZ			; no room for a match even before the skip
  2237'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2238'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2239'                         SR1_FW:
  2239'   CD 0000*              	CALL	MATCHF
  223C'   D8                    	RC
  223D'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2240'   C3 0000*              	JMP	PUTCUR
  2243'                         SR1_BK:
  2243'   21 0000*              	LXI	H,TXTBEG
  2246'   CD 0000*              	CALL	FWDCNT
  2249'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  224C'   D8                    	RC
  224D'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2250'   CD 0000*              	CALL	MATCHB
  2253'   D8                    	RC
  2254'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2257'                         MSGNAM:
  2257'   E5                    	PUSH	H
  2258'   3E 22                 	MVI	A,'"'
  225A'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  225D'   E1                    	POP	H
  225E'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  225F'   23                    	INX	H
  2260'   7E                    	MOV	A,M
  2261'   FE 20                 	CPI	' '
  2263'   C2 2270'              	JNZ	MN_HAS
  2266'   21 1E9B'              	LXI	H,SNONM
  2269'   CD 0000*              	CALL	OUTSTR
  226C'   E1                    	POP	H
  226D'   C3 22BA'              	JMP	MN_END
  2270'                         MN_HAS:
  2270'   0E 19                 	MVI	C,BF_CURDSK
  2272'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2275'   E1                    	POP	H
  2276'   E5                    	PUSH	H
  2277'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2278'   BE                    	CMP	M
  2279'   CA 2287'              	JZ	MN_NAM
  227C'   7E                    	MOV	A,M
  227D'   C6 40                 	ADI	'A'-1
  227F'   CD 0000*              	CALL	OUTCH
  2282'   3E 3A                 	MVI	A,':'
  2284'   CD 0000*              	CALL	OUTCH
  2287'                         MN_NAM:
  2287'   E1                    	POP	H
  2288'   E5                    	PUSH	H
  2289'   23                    	INX	H
  228A'   0E 08                 	MVI	C,8
  228C'                         MN_NM:
  228C'   7E                    	MOV	A,M
  228D'   FE 20                 	CPI	' '
  228F'   CA 229A'              	JZ	MN_EXT
  2292'   CD 0000*              	CALL	OUTCH
  2295'   23                    	INX	H
  2296'   0D                    	DCR	C
  2297'   C2 228C'              	JNZ	MN_NM
  229A'                         MN_EXT:
  229A'   E1                    	POP	H
  229B'   11 0009               	LXI	D,9
  229E'   19                    	DAD	D		; the type field
  229F'   7E                    	MOV	A,M
  22A0'   FE 20                 	CPI	' '
  22A2'   CA 22BA'              	JZ	MN_END
  22A5'   3E 2E                 	MVI	A,'.'
  22A7'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22AA'   0E 03                 	MVI	C,3
  22AC'                         MN_XL:
  22AC'   7E                    	MOV	A,M
  22AD'   FE 20                 	CPI	' '
  22AF'   CA 22BA'              	JZ	MN_END
  22B2'   CD 0000*              	CALL	OUTCH
  22B5'   23                    	INX	H
  22B6'   0D                    	DCR	C
  22B7'   C2 22AC'              	JNZ	MN_XL
  22BA'                         MN_END:
  22BA'   3E 22                 	MVI	A,'"'
  22BC'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  22BF'                         MSGFLG:
  22BF'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  22C1'   B7                    	ORA	A
  22C2'   CA 22D2'              	JZ	MF_RO
  22C5'   3A 24B2'              	LDA	MODF
  22C8'   B7                    	ORA	A
  22C9'   CA 22D2'              	JZ	MF_RO
  22CC'   21 1EA5'              	LXI	H,SMODM
  22CF'   CD 22E7'              	CALL	MF_PUT
  22D2'                         MF_RO:
  22D2'   3A 2511'              	LDA	ROFLAG
  22D5'   B7                    	ORA	A
  22D6'   CA 22DF'              	JZ	MF_NEW
  22D9'   21 1EB0'              	LXI	H,SROM
  22DC'   CD 22E7'              	CALL	MF_PUT
  22DF'                         MF_NEW:
  22DF'   3A 250F'              	LDA	MSGNEW
  22E2'   B7                    	ORA	A
  22E3'   C8                    	RZ
  22E4'   21 1EBB'              	LXI	H,SNEWM
  22E7'                         MF_PUT:
  22E7'   78                    	MOV	A,B
  22E8'   B7                    	ORA	A
  22E9'   C2 22F5'              	JNZ	MF_STR
  22EC'   06 01                 	MVI	B,1
  22EE'   E5                    	PUSH	H
  22EF'   3E 20                 	MVI	A,' '
  22F1'   CD 0000*              	CALL	OUTCH
  22F4'   E1                    	POP	H
  22F5'                         MF_STR:
  22F5'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  22F8'                         EMITW:
  22F8'   C5                    	PUSH	B
  22F9'   D5                    	PUSH	D
  22FA'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  22FC'   11 2710               	LXI	D,10000
  22FF'   CD 231D'              	CALL	EWDIG
  2302'   11 03E8               	LXI	D,1000
  2305'   CD 231D'              	CALL	EWDIG
  2308'   11 0064               	LXI	D,100
  230B'   CD 231D'              	CALL	EWDIG
  230E'   11 000A               	LXI	D,10
  2311'   CD 231D'              	CALL	EWDIG
  2314'   7D                    	MOV	A,L		; the units digit is always printed
  2315'   C6 30                 	ADI	'0'
  2317'   CD 0000*              	CALL	OUTCH
  231A'   D1                    	POP	D
  231B'   C1                    	POP	B
  231C'   C9                    	RET
  231D'                         EWDIG:
  231D'   0E 00                 	MVI	C,0
  231F'                         EW_LP:
  231F'   7D                    	MOV	A,L
  2320'   93                    	SUB	E
  2321'   6F                    	MOV	L,A
  2322'   7C                    	MOV	A,H
  2323'   9A                    	SBB	D
  2324'   67                    	MOV	H,A
  2325'   DA 232C'              	JC	EW_DN
  2328'   0C                    	INR	C
  2329'   C3 231F'              	JMP	EW_LP
  232C'                         EW_DN:
  232C'   19                    	DAD	D		; one subtraction too many: give it back
  232D'   79                    	MOV	A,C
  232E'   B7                    	ORA	A
  232F'   C2 2335'              	JNZ	EW_PR
  2332'   78                    	MOV	A,B
  2333'   B7                    	ORA	A
  2334'   C8                    	RZ			; a leading zero: write nothing
  2335'                         EW_PR:
  2335'   79                    	MOV	A,C
  2336'   C6 30                 	ADI	'0'
  2338'   CD 0000*              	CALL	OUTCH
  233B'   06 01                 	MVI	B,1
  233D'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  233E'                         ISEMPT:
  233E'   2A 0000*              	LHLD	OUTPOS
  2341'   7C                    	MOV	A,H
  2342'   B5                    	ORA	L
  2343'   C0                    	RNZ
  2344'   CD 0000*              	CALL	LOGLEN
  2347'   7C                    	MOV	A,H
  2348'   B5                    	ORA	L
  2349'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  234A'                         MSGCTG:
  234A'   21 0000*              	LXI	H,FNAME
  234D'   CD 2257'              	CALL	MSGNAM
  2350'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2352'   CD 22BF'              	CALL	MSGFLG
  2355'   CD 233E'              	CALL	ISEMPT
  2358'   C2 2361'              	JNZ	MG_POS
  235B'   21 1ECE'              	LXI	H,SNOLIN
  235E'   C3 0000*              	JMP	OUTSTR
  2361'                         MG_POS:
  2361'   21 1EC1'              	LXI	H,SLINE
  2364'   CD 0000*              	CALL	OUTSTR
  2367'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  236A'   23                    	INX	H		;   ... so the line it is on
  236B'   CD 22F8'              	CALL	EMITW
  236E'   21 1EC8'              	LXI	H,SCOLM
  2371'   CD 0000*              	CALL	OUTSTR
  2374'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2377'   23                    	INX	H
  2378'   E5                    	PUSH	H
  2379'   CD 22F8'              	CALL	EMITW
  237C'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  237F'   23                    	INX	H
  2380'   D1                    	POP	D
  2381'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2384'   C8                    	RZ
  2385'   E5                    	PUSH	H
  2386'   3E 2D                 	MVI	A,'-'
  2388'   CD 0000*              	CALL	OUTCH
  238B'   E1                    	POP	H
  238C'   C3 22F8'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  238F'                         FILMSG:
  238F'   3A 0001*              	LDA	FNAME+1
  2392'   FE 20                 	CPI	' '
  2394'   C8                    	RZ
  2395'   21 0000*              	LXI	H,FNAME
  2398'   CD 2257'              	CALL	MSGNAM
  239B'   AF                    	XRA	A		; nothing has been changed yet
  239C'   C3 22BF'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  239F'                         WRMSG:
  239F'   21 0000*              	LXI	H,TFCB
  23A2'   CD 2257'              	CALL	MSGNAM
  23A5'   21 1EE0'              	LXI	H,SWRIT
  23A8'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  23AB'                         MSGPST:
  23AB'   3A 250E'              	LDA	MSGWHT
  23AE'   B7                    	ORA	A
  23AF'   C8                    	RZ
  23B0'   47                    	MOV	B,A
  23B1'   AF                    	XRA	A
  23B2'   32 250E'              	STA	MSGWHT
  23B5'   78                    	MOV	A,B
  23B6'   FE 01                 	CPI	MW_FIL
  23B8'   CA 23C6'              	JZ	MP_FIL
  23BB'   FE 02                 	CPI	MW_WRT
  23BD'   CA 23CC'              	JZ	MP_WRT
  23C0'   CD 234A'              	CALL	MSGCTG
  23C3'   C3 0000*              	JMP	SCURS
  23C6'                         MP_FIL:
  23C6'   CD 238F'              	CALL	FILMSG
  23C9'   C3 0000*              	JMP	SCURS
  23CC'                         MP_WRT:
  23CC'   CD 239F'              	CALL	WRMSG
  23CF'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  23D2'                         VC_CTLG:
  23D2'   3E 03                 	MVI	A,MW_CTG
  23D4'   32 250E'              	STA	MSGWHT
  23D7'   3E 01                 	MVI	A,R_MOVE
  23D9'   32 24B3'              	STA	RINTENT
  23DC'   C9                    	RET
                                
  23DD'                         CMDTAB:
  23DD'   07                    	DB	07H			; ^G -- where am I?
  23DE'   23D2'                 	DW	VC_CTLG
  23E0'   68                    	DB	'h'
  23E1'   071F'                 	DW	VC_H
  23E3'   6C                    	DB	'l'
  23E4'   0749'                 	DW	VC_L
  23E6'   6A                    	DB	'j'
  23E7'   080E'                 	DW	VC_J
  23E9'   6B                    	DB	'k'
  23EA'   081D'                 	DW	VC_K
  23EC'   30                    	DB	'0'
  23ED'   0770'                 	DW	VC_0
  23EF'   5E                    	DB	'^'
  23F0'   078E'                 	DW	VC_CRT
  23F2'   24                    	DB	'$'
  23F3'   07CC'                 	DW	VC_EOL
  23F5'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  23F6'   07F0'                 	DW	VC_CR
  23F8'   77                    	DB	'w'
  23F9'   09F2'                 	DW	VC_W
  23FB'   62                    	DB	'b'
  23FC'   0A43'                 	DW	VC_B
  23FE'   65                    	DB	'e'
  23FF'   0BA8'                 	DW	VC_E
  2401'   57                    	DB	'W'
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2402'   09F9'                 	DW	VCBGW
  2404'   42                    	DB	'B'
  2405'   0A4A'                 	DW	VCBGB
  2407'   45                    	DB	'E'
  2408'   0BAF'                 	DW	VCBGE
  240A'   47                    	DB	'G'
  240B'   0E0A'                 	DW	VC_G
  240D'   67                    	DB	'g'
  240E'   0E3E'                 	DW	VC_LG
  2410'   78                    	DB	'x'
  2411'   1226'                 	DW	VC_X
  2413'   5A                    	DB	'Z'
  2414'   1971'                 	DW	VC_BZ
  2416'   66                    	DB	'f'
  2417'   0237'                 	DW	VC_FF
  2419'   46                    	DB	'F'
  241A'   023C'                 	DW	VC_FB
  241C'   74                    	DB	't'
  241D'   0241'                 	DW	VC_TF
  241F'   54                    	DB	'T'
  2420'   0246'                 	DW	VC_TB
  2422'   3B                    	DB	';'
  2423'   0262'                 	DW	VC_SEMI
  2425'   2C                    	DB	','
  2426'   026C'                 	DW	VC_COMMA
  2428'   79                    	DB	'y'
  2429'   14F5'                 	DW	VC_Y
  242B'   59                    	DB	'Y'
  242C'   14FD'                 	DW	VY_YY
  242E'   70                    	DB	'p'
  242F'   16E9'                 	DW	VC_P
  2431'   50                    	DB	'P'
  2432'   16FE'                 	DW	VCB_P
  2434'   69                    	DB	'i'
  2435'   127E'                 	DW	VC_I
  2437'   61                    	DB	'a'
  2438'   1284'                 	DW	VC_A
  243A'   41                    	DB	'A'
  243B'   12A4'                 	DW	VCB_A
  243D'   49                    	DB	'I'
  243E'   12C0'                 	DW	VCB_I
  2440'   72                    	DB	'r'
  2441'   1409'                 	DW	VC_R
  2443'   52                    	DB	'R'
  2444'   145D'                 	DW	VCB_R
  2446'   64                    	DB	'd'
  2447'   1472'                 	DW	VC_D
  2449'   44                    	DB	'D'
  244A'   120E'                 	DW	VCB_D
  244C'   43                    	DB	'C'
  244D'   1208'                 	DW	VCB_C
  244F'   63                    	DB	'c'
  2450'   147A'                 	DW	VC_C
  2452'   6F                    	DB	'o'
  2453'   1315'                 	DW	VC_O
  2455'   4F                    	DB	'O'
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  2456'   132A'                 	DW	VCB_O
  2458'   4A                    	DB	'J'
  2459'   1344'                 	DW	VCB_J
  245B'   7E                    	DB	'~'
  245C'   13C6'                 	DW	VC_TILD
  245E'   3A                    	DB	':'
  245F'   199C'                 	DW	VC_EX
  2461'   2F                    	DB	'/'
  2462'   2128'                 	DW	VC_SRCH
  2464'   3F                    	DB	'?'
  2465'   2128'                 	DW	VC_SRCH
  2467'   6E                    	DB	'n'
  2468'   217B'                 	DW	VC_N
  246A'   4E                    	DB	'N'
  246B'   2184'                 	DW	VCB_N
  246D'   48                    	DB	'H'
  246E'   0C9C'                 	DW	VC_HIGH
  2470'   4D                    	DB	'M'
  2471'   0CB3'                 	DW	VC_MIDL
  2473'   4C                    	DB	'L'
  2474'   0CC1'                 	DW	VC_LOWL
  2476'   06                    	DB	06H			; ^F -- page forward
  2477'   0CDE'                 	DW	VC_PGDN
  2479'   02                    	DB	02H			; ^B -- page back
  247A'   0D0B'                 	DW	VC_PGUP
  247C'   04                    	DB	04H			; ^D -- half page down
  247D'   0D5F'                 	DW	VC_HFDN
  247F'   15                    	DB	15H			; ^U -- half page up
  2480'   0D93'                 	DW	VC_HFUP
  2482'   0C                    	DB	0CH			; ^L -- redraw
  2483'   0E07'                 	DW	VC_REDR
  2485'   2E                    	DB	'.'			; '.' -- repeat the last change
  2486'   0191'                 	DW	VC_DOT
  2488'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  2489'   04DB'                 	DW	VC_UNDO
  248B'   6D                    	DB	'm'		; m{a-c} -- set a mark
  248C'   0350'                 	DW	VC_MK
  248E'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  248F'   0355'                 	DW	VC_BQ
  2491'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2492'   035A'                 	DW	VC_AQ
  2494'   00                    	DB	0
                                
  2495'                         ACTTAB:
  2495'   04                    	DB	ACT_CURLT
  2496'   071F'                 	DW	VC_H
  2498'   03                    	DB	ACT_CURRT
  2499'   0749'                 	DW	VC_L
  249B'   02                    	DB	ACT_CURDN
  249C'   080E'                 	DW	VC_J
  249E'   01                    	DB	ACT_CURUP
  249F'   081D'                 	DW	VC_K
  24A1'   05                    	DB	ACT_LINST
  24A2'   0770'                 	DW	VC_0
  24A4'   06                    	DB	ACT_LINEN
  24A5'   07CC'                 	DW	VC_EOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  24A7'   07                    	DB	ACT_PGUP
  24A8'   0D0B'                 	DW	VC_PGUP
  24AA'   08                    	DB	ACT_PGDN
  24AB'   0CDE'                 	DW	VC_PGDN
  24AD'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  24AE'   00                    EDMODE: DB	EM_CMD
  24AF'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  24B1'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  24B2'   00                    MODF:	DB	0		; 1 = unsaved changes
  24B3'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  24B4'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  24B5'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  24B6'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  24B7'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  24B9'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  24BA'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  24BB'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  24BC'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  24BD'   0000                  JKCNT:	DW	0		; j/k: count
  24BF'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  24C1'   0000                  JKMOV:	DW	0		; j: lines moved
  24C3'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  24C5'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  24C6'   00                    JKLST:	DB	0		; j: last byte of the scan
  24C7'   0000                  JKVC:	DW	0		; j/k landing: screen column
  24C9'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  24CB'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  24CC'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  24CD'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  24CE'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  24CF'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  24D0'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  24D2'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  24D3'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  24D4'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  24D6'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  24D7'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  24D8'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  24D9'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  24DA'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  24DB'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24DC'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  24DD'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  24DF'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  24E1'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  24E3'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  24E5'   0000                  CNTV:	DW	0		; motion repeat counter
  24E7'   0000                  TTI:	DW	0		; TAILTAB scan index
  24E9'   0000                  WKI:	DW	0		; scan index
  24EB'   0000                  WKN:	DW	0		; cached LOGLEN
  24ED'   0000                  WKTERM: DW	0		; line terminator offset
  24EF'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  24F1'   00                    WKCLS:	DB	0		; word motion: class of the current run
  24F2'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  24F3'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  24F5'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  24F7'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  24F9'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  24FB'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  24FC'   00                    RLMAX:	DB	0		; RDLINE: capacity
  24FD'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  24FE'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  24FF'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2500'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2502'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2503'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2504'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2506'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2508'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2509'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  250B'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  250D'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  250E'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  250F'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2510'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2511'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2512'   00                    PLUSF:	DB	0		; command line: '+' was given
  2513'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2514'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2515'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2516'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2518'   0000                  YPT:	DW	0		; yy: where the lines came from
  251A'   0000                  PCNT:	DW	0		; p/P: copies still to put
  251C'   0000                  PPT:	DW	0		; p/P: the first line put
  251E'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2520'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2521'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2523'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2524'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2525'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2526'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2527'   00                    FNDCH:	DB	0		; ... and the character it looked for
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  2528'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2529'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  252A'   0000                  FNDN:	DW	0		; occurrences still to count off
  252C'   0000                  FNDCUR: DW	0		; the cursor it started from
  252E'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2530'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2531'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2534'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2537'   0000                  MKN:	DW	0		; ... how long it is
  2539'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  253A'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  253D'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  253E'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  253F'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2541'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2543'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2545'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2547'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2549'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  254B'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  254D'   0000                  SCNT:	DW	0		; searches still to do (the count)
  254F'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  2551'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  2553'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2554'   00                    SRNGF:	DB	0		; ex: a line range was given
  2555'   0000                  SRNG1:	DW	0		; ex: its first line
  2557'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2559'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  255A'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  255B'   00                    SANY:	DB	0		; ':s' something in the range has changed
  255C'   00                    SLCHG:	DB	0		; ':s' this line changed
  255D'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  255F'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  2561'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2563'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2565'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2566'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
