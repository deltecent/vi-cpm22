  0723'   22 21E3'              	SHLD	JKCNT
  0726'   CD 0A99'              	CALL	CURRW		; limit = row + NEDIT
  0729'   5F                    	MOV	E,A
  072A'   16 00                 	MVI	D,0
  072C'   3A 0000*              	LDA	NEDIT
  072F'   6F                    	MOV	L,A
  0730'   26 00                 	MVI	H,0
  0732'   19                    	DAD	D
  0733'   EB                    	XCHG			; DE = limit
  0734'   2A 21E3'              	LHLD	JKCNT
  0737'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  073A'   D2 073E'              	JNC	KC_N
  073D'   EB                    	XCHG			; HL = limit
  073E'                         KC_N:
  073E'   22 21E5'              	SHLD	JKN		; N = min(count, limit)
  0741'   EB                    	XCHG			; DE = LFs to find
  0742'   21 0000               	LXI	H,0
  0745'   22 21E9'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0748'                         KC_ED:
  0748'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0749'   2A 21E9'              	LHLD	JKBK
  074C'   CD 0493'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  074F'   E5                    	PUSH	H
  0750'   EB                    	XCHG
  0751'   2A 0000*              	LHLD	TXTBEG
  0754'   EB                    	XCHG
  0755'   CD 0000*              	CALL	SUBHD
  0758'   44                    	MOV	B,H
  0759'   4D                    	MOV	C,L
  075A'   E1                    	POP	H
  075B'   D1                    	POP	D
  075C'                         KC_SC:
  075C'   78                    	MOV	A,B
  075D'   B1                    	ORA	C
  075E'   CA 0775'              	JZ	KC_TB
  0761'   2B                    	DCX	H
  0762'   0B                    	DCX	B
  0763'   7E                    	MOV	A,M
  0764'   FE 0A                 	CPI	LF
  0766'   C2 075C'              	JNZ	KC_SC
  0769'   1B                    	DCX	D
  076A'   7A                    	MOV	A,D
  076B'   B3                    	ORA	E
  076C'   C2 075C'              	JNZ	KC_SC
  076F'   2A 21E3'              	LHLD	JKCNT		; N lines above: the move is count lines
  0772'   C3 0795'              	JMP	KC_MV
  0775'                         KC_TB:
  0775'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0776'   CD 0493'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0779'   22 21E9'              	SHLD	JKBK
  077C'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  077F'   7C                    	MOV	A,H
  0780'   B5                    	ORA	L
  0781'   CA 078E'              	JZ	KC_B0
  0784'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0787'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0788'   DA 078F'              	JC	KC_BOF
  078B'   C3 0748'              	JMP	KC_ED
  078E'                         KC_B0:
  078E'   D1                    	POP	D
  078F'                         KC_BOF:
  078F'   2A 21E5'              	LHLD	JKN		; moved = LFs found
  0792'   CD 0000*              	CALL	SUBHD
  0795'                         KC_MV:
  0795'   E5                    	PUSH	H
  0796'   2A 21E3'              	LHLD	JKCNT
  0799'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  079C'   D1                    	POP	D		; DE = moved
  079D'   2A 21E5'              	LHLD	JKN
  07A0'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  07A3'   DA 07A7'              	JC	KC_AD
  07A6'   EB                    	XCHG			; DE = N
  07A7'                         KC_AD:
  07A7'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  07AA'   CD 0000*              	CALL	SUBHD
  07AD'   22 0000*              	SHLD	LNDLT
  07B0'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  07B1'                         ATEOF:
  07B1'   CD 0000*              	CALL	RGET0
  07B4'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  07B7'                         LASTLN:
  07B7'   2A 0000*              	LHLD	GAPBEG
  07BA'   EB                    	XCHG
  07BB'   2A 0000*              	LHLD	TXTBEG
  07BE'   CD 0000*              	CALL	CMP16
  07C1'   21 0000               	LXI	H,0
  07C4'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  07C7'   1B                    	DCX	D
  07C8'   1A                    	LDAX	D
  07C9'   FE 0A                 	CPI	LF
  07CB'   C2 0000*              	JNZ	SETBWD
  07CE'   23                    	INX	H
  07CF'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  07D2'                         JKLAND:
  07D2'   21 0000               	LXI	H,0
  07D5'   22 21ED'              	SHLD	JKVC		; screen column
  07D8'   2B                    	DCX	H
  07D9'   22 21EF'              	SHLD	JKLS		; last content char: none yet
  07DC'   CD 0000*              	CALL	RGET0
  07DF'   11 0000               	LXI	D,0		; DE = chars read
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  07E2'                         JL_RD:
  07E2'   CD 0000*              	CALL	RDGET
  07E5'   DA 081F'              	JC	JL_END
  07E8'   FE 0A                 	CPI	LF
  07EA'   CA 081F'              	JZ	JL_END
  07ED'   E5                    	PUSH	H
  07EE'   C5                    	PUSH	B
  07EF'   2A 21ED'              	LHLD	JKVC
  07F2'   CD 03D8'              	CALL	CWID
  07F5'   B7                    	ORA	A
  07F6'   CA 0819'              	JZ	JL_NX		; a CR
  07F9'   EB                    	XCHG
  07FA'   22 21EF'              	SHLD	JKLS		; the last content char so far
  07FD'   EB                    	XCHG
  07FE'   4F                    	MOV	C,A
  07FF'   06 00                 	MVI	B,0
  0801'   09                    	DAD	B		; HL = the column after this char
  0802'   22 21ED'              	SHLD	JKVC
  0805'   D5                    	PUSH	D
  0806'   EB                    	XCHG
  0807'   2A 21DD'              	LHLD	GOALCOL
  080A'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  080D'   D1                    	POP	D
  080E'   DA 0819'              	JC	JL_NX
  0811'   CA 0819'              	JZ	JL_NX
  0814'   C1                    	POP	B		; this char holds the goal column
  0815'   E1                    	POP	H
  0816'   C3 082A'              	JMP	JL_GO
  0819'                         JL_NX:
  0819'   C1                    	POP	B
  081A'   E1                    	POP	H
  081B'   13                    	INX	D
  081C'   C3 07E2'              	JMP	JL_RD
  081F'                         JL_END:
  081F'   2A 21EF'              	LHLD	JKLS		; past the line's end: its last content char
  0822'   7C                    	MOV	A,H
  0823'   A5                    	ANA	L
  0824'   3C                    	INR	A
  0825'   C2 0829'              	JNZ	JL_LS
  0828'   23                    	INX	H		; no content: the line's start
  0829'                         JL_LS:
  0829'   EB                    	XCHG
  082A'                         JL_GO:
  082A'   D5                    	PUSH	D		; DE = step from the line start
  082B'   CD 0000*              	CALL	CUROFF
  082E'   D1                    	POP	D
  082F'   19                    	DAD	D
  0830'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0833'   AF                    VC_W:	XRA	A
  0834'   32 21DF'              	STA	WBIG
  0837'   C3 083F'              	JMP	WDO
  083A'   3E 01                 VCBGW:	MVI	A,1
  083C'   32 21DF'              	STA	WBIG
  083F'   CD 0507'              WDO:	CALL	SETMOV
  0842'   AF                    	XRA	A
  0843'   32 21E0'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0846'   CD 049A'              	CALL	GETCNT
  0849'   22 220B'              	SHLD	CNTV
  084C'   2A 220B'              WDO_LP: LHLD	CNTV
  084F'   7C                    	MOV	A,H
  0850'   B5                    	ORA	L
  0851'   CA 085E'              	JZ	WDO_DN
  0854'   2B                    	DCX	H
  0855'   22 220B'              	SHLD	CNTV
  0858'   CD 08AE'              	CALL	FWD1
  085B'   D2 084C'              	JNC	WDO_LP
  085E'                         WDO_DN:
  085E'   CD 07B1'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0861'   DA 086E'              	JC	WDO_NL
  0864'   FE 0D                 	CPI	CR
  0866'   CA 086E'              	JZ	WDO_NL
  0869'   FE 0A                 	CPI	LF
  086B'   C2 0384'              	JNZ	SETGL
  086E'                         WDO_NL:
  086E'   CD 0000*              	CALL	PEEKL
  0871'   DA 0384'              	JC	SETGL
  0874'   FE 0A                 	CPI	LF
  0876'   CA 0384'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0879'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  087B'   32 21E0'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  087E'   CD 09A9'              	CALL	DECC		; back onto its last char
  0881'   C3 0384'              	JMP	SETGL
                                
  0884'   AF                    VC_B:	XRA	A
  0885'   32 21DF'              	STA	WBIG
  0888'   C3 0890'              	JMP	BDO
  088B'   3E 01                 VCBGB:	MVI	A,1
  088D'   32 21DF'              	STA	WBIG
  0890'   CD 0507'              BDO:	CALL	SETMOV
  0893'   CD 049A'              	CALL	GETCNT
  0896'   22 220B'              	SHLD	CNTV
  0899'   2A 220B'              BDO_LP: LHLD	CNTV
  089C'   7C                    	MOV	A,H
  089D'   B5                    	ORA	L
  089E'   CA 0384'              	JZ	SETGL
  08A1'   2B                    	DCX	H
  08A2'   22 220B'              	SHLD	CNTV
  08A5'   CD 08FA'              	CALL	BCK1
  08A8'   D2 0899'              	JNC	BDO_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  08AB'   C3 0384'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  08AE'                         FWD1:
  08AE'   CD 092D'              	CALL	CCLS
  08B1'   32 2219'              	STA	WKCLS		; the starting class
  08B4'   CD 0967'              	CALL	INCC
  08B7'   B7                    	ORA	A
  08B8'   CA 08D0'              	JZ	FW_WD
  08BB'   37                    	STC
  08BC'   F8                    	RM			; -1: already at the end
  08BD'   FE 02                 	CPI	2
  08BF'   C2 08D0'              	JNZ	FW_WD		; 1: a next line was reached
  08C2'   CD 07B1'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  08C5'   D4 094E'              	CNC	NXLN
  08C8'   D2 08D0'              	JNC	FW_WD
  08CB'   CD 09A9'              	CALL	DECC		; yes: back onto its last char, failed
  08CE'   37                    	STC
  08CF'   C9                    	RET
  08D0'                         FW_WD:
  08D0'   3A 2219'              	LDA	WKCLS		; go past the rest of this word
  08D3'   B7                    	ORA	A
  08D4'   CA 08E9'              	JZ	FW_WS
  08D7'                         FW_WLP:
  08D7'   CD 092D'              	CALL	CCLS
  08DA'   21 2219'              	LXI	H,WKCLS
  08DD'   BE                    	CMP	M
  08DE'   C2 08E9'              	JNZ	FW_WS
  08E1'   CD 0967'              	CALL	INCC
  08E4'   B7                    	ORA	A
  08E5'   F8                    	RM			; the end of the file (NC)
  08E6'   C3 08D7'              	JMP	FW_WLP
  08E9'                         FW_WS:
  08E9'   CD 092D'              	CALL	CCLS		; then over blanks to the next word
  08EC'   B7                    	ORA	A
  08ED'   C0                    	RNZ
  08EE'   CD 0935'              	CALL	EMPTY
  08F1'   C8                    	RZ			; an empty line is a word
  08F2'   CD 0967'              	CALL	INCC
  08F5'   B7                    	ORA	A
  08F6'   F8                    	RM
  08F7'   C3 08E9'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  08FA'                         BCK1:
  08FA'   CD 09A9'              	CALL	DECC
  08FD'   B7                    	ORA	A
  08FE'   37                    	STC
  08FF'   F8                    	RM
  0900'                         BK_WS:
  0900'   CD 092D'              	CALL	CCLS		; back over blanks
  0903'   B7                    	ORA	A
  0904'   C2 0914'              	JNZ	BK_WD
  0907'   CD 0935'              	CALL	EMPTY
  090A'   C8                    	RZ			; an empty line is a word
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  090B'   CD 09A9'              	CALL	DECC
  090E'   B7                    	ORA	A
  090F'   F2 0900'              	JP	BK_WS
  0912'   AF                    	XRA	A		; the start of the file (NC)
  0913'   C9                    	RET
  0914'                         BK_WD:
  0914'   32 2219'              	STA	WKCLS		; back to the start of this word
  0917'                         BK_WLP:
  0917'   CD 09A9'              	CALL	DECC
  091A'   B7                    	ORA	A
  091B'   FA 092B'              	JM	BK_OK		; the start of the file
  091E'   CD 092D'              	CALL	CCLS
  0921'   21 2219'              	LXI	H,WKCLS
  0924'   BE                    	CMP	M
  0925'   CA 0917'              	JZ	BK_WLP
  0928'   CD 0967'              	CALL	INCC		; overshot: forward one
  092B'                         BK_OK:
  092B'   AF                    	XRA	A
  092C'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  092D'                         CCLS:
  092D'   CD 07B1'              	CALL	ATEOF
  0930'   D2 04BC'              	JNC	CLASSF
  0933'   AF                    	XRA	A
  0934'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0935'                         EMPTY:
  0935'   CD 07B1'              	CALL	ATEOF
  0938'   DA 0943'              	JC	EM_ST
  093B'   FE 0D                 	CPI	CR
  093D'   CA 0943'              	JZ	EM_ST
  0940'   FE 0A                 	CPI	LF
  0942'   C0                    	RNZ
  0943'                         EM_ST:
  0943'   CD 0000*              	CALL	PEEKL
  0946'   DA 094C'              	JC	EM_Y
  0949'   FE 0A                 	CPI	LF
  094B'   C9                    	RET
  094C'                         EM_Y:
  094C'   AF                    	XRA	A
  094D'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  094E'                         NXLN:
  094E'   FE 0A                 	CPI	LF
  0950'   CA 095F'              	JZ	NX_LF
  0953'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0956'   D8                    	RC
  0957'   FE 0A                 	CPI	LF
  0959'   CA 095F'              	JZ	NX_LF
  095C'   2B                    	DCX	H		; a lone CR
  095D'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  095E'   C9                    	RET
  095F'                         NX_LF:
  095F'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0962'   D8                    	RC
  0963'   2B                    	DCX	H
  0964'   3E 01                 	MVI	A,1
  0966'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0967'                         INCC:
  0967'   CD 07B1'              	CALL	ATEOF
  096A'   DA 09A5'              	JC	IC_END
  096D'   FE 0D                 	CPI	CR
  096F'   CA 0990'              	JZ	IC_NL
  0972'   FE 0A                 	CPI	LF
  0974'   CA 0990'              	JZ	IC_NL
  0977'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  097A'                         IC_CH:
  097A'   CD 07B1'              	CALL	ATEOF
  097D'   DA 098C'              	JC	IC_2
  0980'   FE 0D                 	CPI	CR
  0982'   CA 098C'              	JZ	IC_2
  0985'   FE 0A                 	CPI	LF
  0987'   CA 098C'              	JZ	IC_2
  098A'   AF                    	XRA	A
  098B'   C9                    	RET
  098C'                         IC_2:
  098C'   3E 02                 	MVI	A,2
  098E'   B7                    	ORA	A
  098F'   C9                    	RET
  0990'                         IC_NL:
  0990'   CD 094E'              	CALL	NXLN
  0993'   DA 09A5'              	JC	IC_END
  0996'   F5                    	PUSH	PSW
  0997'   CD 0000*              	CALL	PUTCUR
  099A'   F1                    	POP	PSW
  099B'   B7                    	ORA	A
  099C'   CA 097A'              	JZ	IC_CH		; a lone CR: stepped over as a char
  099F'   CD 09CB'              	CALL	LNINC
  09A2'   3E 01                 	MVI	A,1
  09A4'   C9                    	RET
  09A5'                         IC_END:
  09A5'   3E FF                 	MVI	A,0FFH
  09A7'   B7                    	ORA	A
  09A8'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  09A9'                         DECC:
  09A9'   CD 0000*              	CALL	PEEKL
  09AC'   DA 09A5'              	JC	IC_END
  09AF'   F5                    	PUSH	PSW
  09B0'   CD 0000*              	CALL	PUTCUR
  09B3'   F1                    	POP	PSW
