  2361'   5B 4E 6F 20           SNONM:	DB	'[No Name]',0
  2365'   4E 61 6D 65           
  2369'   5D 00                 
  236B'   5B 4D 6F 64           SMODM:	DB	'[Modified]',0
  236F'   69 66 69 65           
  2373'   64 5D 00              
  2376'   5B 72 65 61           SROM:	DB	'[readonly]',0
  237A'   64 6F 6E 6C           
  237E'   79 5D 00              
  2381'   5B 4E 65 77           SNEWM:	DB	'[New]',0
  2385'   5D 00                 
  2387'   20 6C 69 6E           SLINE:	DB	' line ',0
  238B'   65 20 00              
  238E'   20 63 6F 6C           SCOLM:	DB	' col ',0
  2392'   20 00                 
  2394'   20 2D 2D 42           SNOLIN: DB	' --Buffer empty--',0
  2398'   75 66 66 65           
  239C'   72 20 65 6D           
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  23A0'   70 74 79 2D           
  23A4'   2D 00                 
  23A6'   20 77 72 69           SWRIT:	DB	' written',0
  23AA'   74 74 65 6E           
  23AE'   00                    
  23AF'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  23B3'   74 20 6F 70           
  23B7'   65 6E 20 66           
  23BB'   69 6C 65 20           
  23BF'   00                    
  23C0'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  23C4'   6C 69 64 20           
  23C8'   72 61 6E 67           
  23CC'   65 00                 
  23CE'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  23D2'   20 66 75 6C           
  23D6'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  23D8'                         EXTAB:
  23D8'   77 00 01              	DB	'w',0,EO_W
  23DB'   71 00 02              	DB	'q',0,EO_Q
  23DE'   77 71 03              	DB	'w','q',EO_WQ
  23E1'   78 00 04              	DB	'x',0,EO_X
  23E4'   65 00 05              	DB	'e',0,EO_E
  23E7'   73 00 06              	DB	's',0,EO_S
  23EA'   76 65 07              	DB	'v','e',EO_V
  23ED'   72 00 08              	DB	'r',0,EO_R
  23F0'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  23F1'                         EXADDR:
  23F1'   AF                    	XRA	A
  23F2'   32 2A4B'              	STA	SRNGF
  23F5'   7E                    	MOV	A,M
  23F6'   FE 25                 	CPI	'%'
  23F8'   CA 2421'              	JZ	EXA_AL
  23FB'   EB                    	XCHG			; DE walks the line, HL takes the number
  23FC'   CD 2436'              	CALL	EXNUM
  23FF'   DA 241F'              	JC	EXA_NO
  2402'   22 2A4C'              	SHLD	SRNG1
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2405'   22 2A4E'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2408'   1A                    	LDAX	D
  2409'   FE 2C                 	CPI	','
  240B'   C2 2418'              	JNZ	EXA_YS
  240E'   13                    	INX	D
  240F'   CD 2436'              	CALL	EXNUM
  2412'   DA 241F'              	JC	EXA_NO		; ',' with no number: not a range at all
  2415'   22 2A4E'              	SHLD	SRNG2
  2418'                         EXA_YS:
  2418'   EB                    	XCHG
  2419'   3E 01                 	MVI	A,1
  241B'   32 2A4B'              	STA	SRNGF
  241E'   C9                    	RET
  241F'                         EXA_NO:
  241F'   EB                    	XCHG
  2420'   C9                    	RET
  2421'                         EXA_AL:
  2421'   23                    	INX	H
  2422'   E5                    	PUSH	H
  2423'   21 0001               	LXI	H,1
  2426'   22 2A4C'              	SHLD	SRNG1
  2429'   21 FFFF               	LXI	H,0FFFFH
  242C'   22 2A4E'              	SHLD	SRNG2
  242F'   E1                    	POP	H
  2430'   3E 01                 	MVI	A,1
  2432'   32 2A4B'              	STA	SRNGF
  2435'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2436'                         EXNUM:
  2436'   1A                    	LDAX	D
  2437'   D6 30                 	SUI	'0'
  2439'   D8                    	RC
  243A'   FE 0A                 	CPI	10
  243C'   3F                    	CMC
  243D'   D8                    	RC
  243E'   21 0000               	LXI	H,0
  2441'                         EXN_LP:
  2441'   1A                    	LDAX	D
  2442'   D6 30                 	SUI	'0'
  2444'   DA 245E'              	JC	EXN_DN
  2447'   FE 0A                 	CPI	10
  2449'   D2 245E'              	JNC	EXN_DN
  244C'   13                    	INX	D
  244D'   C5                    	PUSH	B
  244E'   4F                    	MOV	C,A
  244F'   06 00                 	MVI	B,0		; BC = the digit
  2451'   D5                    	PUSH	D
  2452'   54                    	MOV	D,H
  2453'   5D                    	MOV	E,L
  2454'   29                    	DAD	H		; *2
  2455'   29                    	DAD	H		; *4
  2456'   19                    	DAD	D		; *5
  2457'   29                    	DAD	H		; *10
  2458'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2459'   09                    	DAD	B
  245A'   C1                    	POP	B
  245B'   C3 2441'              	JMP	EXN_LP
  245E'                         EXN_DN:
  245E'   B7                    	ORA	A		; CY clear: there was a number
  245F'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2460'                         EX_S:
  2460'   7E                    	MOV	A,M
  2461'   B7                    	ORA	A
  2462'   CA 24A4'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2465'   32 2A50'              	STA	SDELIM
  2468'   23                    	INX	H
  2469'   11 0000*              	LXI	D,SRCHST
  246C'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  246F'   4F                    	MOV	C,A
  2470'   CD 24AA'              	CALL	SCOPY
  2473'   78                    	MOV	A,B
  2474'   B7                    	ORA	A
  2475'   CA 24A4'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2478'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  247B'   3E 01                 	MVI	A,1
  247D'   32 2A18'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2480'   11 2A62'              	LXI	D,SREPL
  2483'   0E 24                 	MVI	C,SREPMX
  2485'   CD 24AA'              	CALL	SCOPY
  2488'   78                    	MOV	A,B
  2489'   32 2A61'              	STA	SREPLN
  248C'   AF                    	XRA	A
  248D'   32 2A51'              	STA	SGFLAG
  2490'   7E                    	MOV	A,M
  2491'   FE 67                 	CPI	'g'
  2493'   C2 249C'              	JNZ	EX_SG
  2496'   23                    	INX	H
  2497'   3E 01                 	MVI	A,1
  2499'   32 2A51'              	STA	SGFLAG
  249C'                         EX_SG:
  249C'   7E                    	MOV	A,M
  249D'   B7                    	ORA	A
  249E'   C2 223B'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  24A1'   C3 24CA'              	JMP	SUBGO
  24A4'                         SUBNOP:
  24A4'   21 22F3'              	LXI	H,SNOPAT
  24A7'   C3 2249'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  24AA'                         SCOPY:
  24AA'   06 00                 	MVI	B,0
  24AC'                         SCP_LP:
  24AC'   78                    	MOV	A,B
  24AD'   B9                    	CMP	C
  24AE'   D2 24C7'              	JNC	SCP_DN		; full: what is left stays on the line, and so
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                				;   comes back as trailing characters
  24B1'   7E                    	MOV	A,M
  24B2'   B7                    	ORA	A
  24B3'   CA 24C7'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  24B6'   E5                    	PUSH	H
  24B7'   21 2A50'              	LXI	H,SDELIM
  24BA'   BE                    	CMP	M
  24BB'   E1                    	POP	H
  24BC'   CA 24C6'              	JZ	SCP_SK
  24BF'   12                    	STAX	D
  24C0'   13                    	INX	D
  24C1'   23                    	INX	H
  24C2'   04                    	INR	B
  24C3'   C3 24AC'              	JMP	SCP_LP
  24C6'                         SCP_SK:
  24C6'   23                    	INX	H
  24C7'                         SCP_DN:
  24C7'   AF                    	XRA	A
  24C8'   12                    	STAX	D
  24C9'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  24CA'                         SUBGO:
  24CA'   CD 0F60'              	CALL	GZONE
  24CD'   2A 0000*              	LHLD	LNDLT
  24D0'   22 2A5F'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  24D3'   21 2A5C'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  24D6'   CD 044F'              	CALL	FPSTO		;   search's SN_BAD does
  24D9'   AF                    	XRA	A
  24DA'   32 2A52'              	STA	SANY
  24DD'   21 0000               	LXI	H,0
  24E0'   22 2A54'              	SHLD	SBACK
  24E3'   3A 2A4B'              	LDA	SRNGF
  24E6'   B7                    	ORA	A
  24E7'   CA 24F9'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  24EA'   CD 1DC5'              	CALL	EXRNG		; SLINES = the lines in the range
  24ED'   DA 2575'              	JC	SUBBAD
  24F0'   2A 2A4C'              	LHLD	SRNG1
  24F3'   CD 0ECE'              	CALL	GOLN
  24F6'   C3 24FF'              	JMP	SUBLP
  24F9'                         SUB_1L:
  24F9'   21 0001               	LXI	H,1
  24FC'   22 2A56'              	SHLD	SLINES
  24FF'                         SUBLP:
  24FF'   CD 257B'              	CALL	SUBLIN		; A = 1 when this line changed
  2502'   B7                    	ORA	A
  2503'   CA 2511'              	JZ	SUB_NX
  2506'   3E 01                 	MVI	A,1
  2508'   32 2A52'              	STA	SANY
  250B'   21 0000               	LXI	H,0
  250E'   22 2A54'              	SHLD	SBACK		; the cursor is ON the last line changed
  2511'                         SUB_NX:
  2511'   2A 2A56'              	LHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2514'   2B                    	DCX	H
  2515'   22 2A56'              	SHLD	SLINES
  2518'   7C                    	MOV	A,H
  2519'   B5                    	ORA	L
  251A'   CA 2538'              	JZ	SUBDON		; the range is spent
  251D'   21 0001               	LXI	H,1
  2520'   AF                    	XRA	A
  2521'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2524'   3A 2A52'              	LDA	SANY
  2527'   B7                    	ORA	A
  2528'   CA 2532'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  252B'   2A 2A54'              	LHLD	SBACK
  252E'   23                    	INX	H
  252F'   22 2A54'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2532'                         SUB_AE:
  2532'   CD 0A04'              	CALL	ATEOF
  2535'   D2 24FF'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2538'                         SUBDON:
  2538'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  253B'   3A 2A52'              	LDA	SANY
  253E'   B7                    	ORA	A
  253F'   CA 255D'              	JZ	SUBNFD
  2542'   3E 01                 	MVI	A,1
  2544'   32 2999'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2547'   2A 2A54'              	LHLD	SBACK
  254A'   7C                    	MOV	A,H
  254B'   B5                    	ORA	L
  254C'   CA 2557'              	JZ	SUB_PL
  254F'   3E FF                 	MVI	A,0FFH
  2551'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2554'   CD 0000*              	CALL	CLRCNT
  2557'                         SUB_PL:
  2557'   CD 0F78'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  255A'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  255D'                         SUBNFD:
  255D'   21 2A5C'              	LXI	H,SOFFS
  2560'   CD 03F6'              	CALL	BACKTO
  2563'   2A 2A5F'              	LHLD	SLDLTS
  2566'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2569'   21 22D3'              	LXI	H,SNOTFD
  256C'   CD 2249'              	CALL	EXERR
  256F'   21 0000*              	LXI	H,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2572'   C3 2244'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2575'                         SUBBAD:
  2575'   21 22C1'              	LXI	H,SNOT
  2578'   C3 223E'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  257B'                         SUBLIN:
  257B'   AF                    	XRA	A
  257C'   32 2A53'              	STA	SLCHG
  257F'   CD 25FA'              	CALL	SUBBOL
  2582'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2585'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2585'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2588'   DA 2590'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  258B'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  258D'   C2 2585'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2590'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2590'   CD 0000*              	CALL	CUROFF
  2593'   E5                    	PUSH	H
  2594'   CD 147E'              	CALL	CEND
  2597'   D1                    	POP	D
  2598'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  259B'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  259C'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  259F'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  25A0'   B7                    	ORA	A		;   span is a line, not a pair.)
  25A1'   FA 25F3'              	JM	SUBL_D		; what is left is shorter than the pattern
  25A4'   44                    	MOV	B,H
  25A5'   4D                    	MOV	C,L		; BC = the start positions a match can take
  25A6'   11 0000*              	LXI	D,SRCHST
  25A9'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  25AC'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  25AF'   DA 25F3'              	JC	SUBL_D
  25B2'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  25B5'   EB                    	XCHG
  25B6'   2A 0000*              	LHLD	GAPEND
  25B9'   EB                    	XCHG
  25BA'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  25BD'   EB                    	XCHG
  25BE'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  25BF'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  25C2'   D1                    	POP	D
  25C3'   19                    	DAD	D		; ... and so the match's logical offset
  25C4'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  25C7'   3A 2A52'              	LDA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  25CA'   B7                    	ORA	A
  25CB'   C2 25D8'              	JNZ	SUBL_C
  25CE'   3A 2A53'              	LDA	SLCHG
  25D1'   B7                    	ORA	A
  25D2'   C2 25D8'              	JNZ	SUBL_C
  25D5'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  25D8'                         SUBL_C:
  25D8'   3A 0000*              	LDA	SRCHBF
  25DB'   6F                    	MOV	L,A
  25DC'   26 00                 	MVI	H,0
  25DE'   CD 0000*              	CALL	DELFWD		; the match goes
  25E1'   11 2A61'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  25E4'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  25E7'                         SUBL_I:
  25E7'   3E 01                 	MVI	A,1
  25E9'   32 2A53'              	STA	SLCHG
  25EC'   3A 2A51'              	LDA	SGFLAG
  25EF'   B7                    	ORA	A
  25F0'   C2 2590'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  25F3'                         SUBL_D:
  25F3'   CD 25FA'              	CALL	SUBBOL
  25F6'   3A 2A53'              	LDA	SLCHG
  25F9'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  25FA'                         SUBBOL:
  25FA'   CD 0000*              	CALL	CUROFF
  25FD'   CD 05E4'              	CALL	BOL
  2600'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2603'                         VC_SRCH:
  2603'   CD 075A'              	CALL	SETMOV
  2606'   C5                    	PUSH	B
  2607'   CD 068B'              	CALL	GETCNT
  260A'   22 2A41'              	SHLD	SCNT
  260D'   C1                    	POP	B
  260E'   79                    	MOV	A,C
  260F'   FE 2F                 	CPI	'/'
  2611'   3E 00                 	MVI	A,0
  2613'   CA 2618'              	JZ	VS_DIR
  2616'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2618'                         VS_DIR:
  2618'   32 2A16'              	STA	SDIR
  261B'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  261E'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2621'   47                    	MOV	B,A
  2622'   CD 1B61'              	CALL	RDLINE
  2625'   B7                    	ORA	A
  2626'   C0                    	RNZ			; cancelled: nothing happens at all
  2627'   3A 29EE'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  262A'   B7                    	ORA	A
  262B'   CA 2640'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  262E'   5F                    	MOV	E,A
  262F'   16 00                 	MVI	D,0
  2631'   21 0000*              	LXI	H,SRCHST
  2634'   19                    	DAD	D
  2635'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2637'   7B                    	MOV	A,E
  2638'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  263B'   3E 01                 	MVI	A,1
  263D'   32 2A18'              	STA	SHAVE
  2640'                         VS_OLD:
  2640'   3A 2A18'              	LDA	SHAVE
  2643'   B7                    	ORA	A
  2644'   CA 2650'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2647'   3A 2A16'              	LDA	SDIR
  264A'   32 2A17'              	STA	SDIRE
  264D'   C3 2679'              	JMP	SRCHN
  2650'                         VS_NOP:
  2650'   21 22F3'              	LXI	H,SNOPAT
  2653'   C3 2249'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2656'                         VC_N:
  2656'   CD 075A'              	CALL	SETMOV
  2659'   3A 2A16'              	LDA	SDIR
  265C'   C3 2666'              	JMP	VN_GO
  265F'                         VCB_N:
  265F'   CD 075A'              	CALL	SETMOV
  2662'   3A 2A16'              	LDA	SDIR
  2665'   2F                    	CMA			; the other way: 0 <-> FFH
  2666'                         VN_GO:
  2666'   32 2A17'              	STA	SDIRE
  2669'   CD 068B'              	CALL	GETCNT
  266C'   22 2A41'              	SHLD	SCNT
  266F'   3A 2A18'              	LDA	SHAVE
  2672'   B7                    	ORA	A
  2673'   CA 2650'              	JZ	VS_NOP
  2676'   C3 2679'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2679'                         SRCHN:
  2679'   CD 0F60'              	CALL	GZONE		; the screen's top line, before the cursor moves
  267C'   CD 06B4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and a ^C may stop it
  267F'                         SN_LP:
  267F'   CD 26B4'              	CALL	SRCHGO
  2682'   DA 269F'              	JC	SN_BAD
  2685'   2A 2A41'              	LHLD	SCNT
  2688'   2B                    	DCX	H
  2689'   22 2A41'              	SHLD	SCNT
  268C'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  268D'   B5                    	ORA	L
  268E'   C2 267F'              	JNZ	SN_LP
  2691'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2694'   CD 06EB'              	CALL	BRKOFF
  2697'   3E 01                 	MVI	A,1
  2699'   32 2A23'              	STA	GPKEEP		; land on the match, not the first non-blank
  269C'   C3 0F78'              	JMP	GPLACE		; (which sets LNDLT itself)
  269F'                         SN_BAD:
  269F'   CD 06EB'              	CALL	BRKOFF
  26A2'   DA 0703'              	JC	BRKBAK		; stopped, which is not the same as not found
  26A5'   CD 06F6'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  26A8'   21 22D3'              	LXI	H,SNOTFD
  26AB'   CD 2249'              	CALL	EXERR
  26AE'   21 0000*              	LXI	H,SRCHST
  26B1'   C3 2244'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  26B4'                         SRCHGO:
  26B4'   3E 01                 	MVI	A,1
  26B6'   32 2A4A'              	STA	SSKIP		; this pass starts one past the cursor
  26B9'   CD 26CF'              	CALL	SRCHW
  26BC'   D0                    	RNC
  26BD'   CD 06EF'              	CALL	BRKQ
  26C0'   D8                    	RC			; stopped: no second pass
  26C1'   3A 2A17'              	LDA	SDIRE
  26C4'   2F                    	CMA
  26C5'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  26C8'   AF                    	XRA	A
  26C9'   32 2A4A'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  26CC'   C3 26CF'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  26CF'                         SRCHW:
  26CF'   3A 2A17'              	LDA	SDIRE
  26D2'   32 0000*              	STA	DIRFLG
  26D5'   21 FFFF               	LXI	H,0FFFFH
  26D8'   22 2996'              	SHLD	CMDCNT
  26DB'   AF                    	XRA	A
  26DC'   32 0000*              	STA	AUXCNT
  26DF'                         SW_LP:
  26DF'   CD 06EF'              	CALL	BRKQ		; a ^C spent the count, here or on the way to
  26E2'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  26E3'   CD 26EF'              	CALL	SRCH1
  26E6'   D0                    	RNC
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  26E7'   CD 0000*              	CALL	SCRLST
  26EA'   D2 26DF'              	JNC	SW_LP
  26ED'   37                    	STC
  26EE'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  26EF'                         SRCH1:
  26EF'   11 0000*              	LXI	D,SRCHST
  26F2'   3A 0000*              	LDA	DIRFLG
  26F5'   B7                    	ORA	A
  26F6'   FA 271A'              	JM	SR1_BK
  26F9'   21 0000*              	LXI	H,GAPEND
  26FC'   CD 0000*              	CALL	FWDCNT
  26FF'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2702'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2703'   3A 2A4A'              	LDA	SSKIP
  2706'   B7                    	ORA	A
  2707'   CA 2710'              	JZ	SR1_FW
  270A'   78                    	MOV	A,B
  270B'   B1                    	ORA	C
  270C'   37                    	STC
  270D'   C8                    	RZ			; no room for a match even before the skip
  270E'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  270F'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2710'                         SR1_FW:
  2710'   CD 0000*              	CALL	MATCHF
  2713'   D8                    	RC
  2714'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2717'   C3 0000*              	JMP	PUTCUR
  271A'                         SR1_BK:
  271A'   21 0000*              	LXI	H,TXTBEG
  271D'   CD 0000*              	CALL	FWDCNT
  2720'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2723'   D8                    	RC
  2724'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2727'   CD 0000*              	CALL	MATCHB
  272A'   D8                    	RC
  272B'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  272E'                         MSGNAM:
  272E'   E5                    	PUSH	H
  272F'   3E 22                 	MVI	A,'"'
  2731'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2734'   E1                    	POP	H
  2735'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2736'   23                    	INX	H
  2737'   7E                    	MOV	A,M
  2738'   FE 20                 	CPI	' '
  273A'   C2 2747'              	JNZ	MN_HAS
  273D'   21 2361'              	LXI	H,SNONM
  2740'   CD 0000*              	CALL	OUTSTR
  2743'   E1                    	POP	H
  2744'   C3 2791'              	JMP	MN_END
  2747'                         MN_HAS:
  2747'   0E 19                 	MVI	C,BF_CURDSK
  2749'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  274C'   E1                    	POP	H
  274D'   E5                    	PUSH	H
  274E'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  274F'   BE                    	CMP	M
  2750'   CA 275E'              	JZ	MN_NAM
  2753'   7E                    	MOV	A,M
  2754'   C6 40                 	ADI	'A'-1
  2756'   CD 0000*              	CALL	OUTCH
  2759'   3E 3A                 	MVI	A,':'
  275B'   CD 0000*              	CALL	OUTCH
  275E'                         MN_NAM:
  275E'   E1                    	POP	H
  275F'   E5                    	PUSH	H
  2760'   23                    	INX	H
  2761'   0E 08                 	MVI	C,8
  2763'                         MN_NM:
  2763'   7E                    	MOV	A,M
  2764'   FE 20                 	CPI	' '
  2766'   CA 2771'              	JZ	MN_EXT
  2769'   CD 0000*              	CALL	OUTCH
  276C'   23                    	INX	H
  276D'   0D                    	DCR	C
  276E'   C2 2763'              	JNZ	MN_NM
  2771'                         MN_EXT:
  2771'   E1                    	POP	H
  2772'   11 0009               	LXI	D,9
  2775'   19                    	DAD	D		; the type field
  2776'   7E                    	MOV	A,M
  2777'   FE 20                 	CPI	' '
  2779'   CA 2791'              	JZ	MN_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  277C'   3E 2E                 	MVI	A,'.'
  277E'   CD 0000*              	CALL	OUTCH
  2781'   0E 03                 	MVI	C,3
  2783'                         MN_XL:
  2783'   7E                    	MOV	A,M
  2784'   FE 20                 	CPI	' '
  2786'   CA 2791'              	JZ	MN_END
  2789'   CD 0000*              	CALL	OUTCH
  278C'   23                    	INX	H
  278D'   0D                    	DCR	C
  278E'   C2 2783'              	JNZ	MN_XL
  2791'                         MN_END:
  2791'   3E 22                 	MVI	A,'"'
  2793'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2796'                         MSGFLG:
  2796'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2798'   B7                    	ORA	A
  2799'   CA 27A9'              	JZ	MF_RO
  279C'   3A 2999'              	LDA	MODF
  279F'   B7                    	ORA	A
  27A0'   CA 27A9'              	JZ	MF_RO
  27A3'   21 236B'              	LXI	H,SMODM
  27A6'   CD 27BE'              	CALL	MF_PUT
  27A9'                         MF_RO:
  27A9'   3A 2A04'              	LDA	ROFLAG
  27AC'   B7                    	ORA	A
  27AD'   CA 27B6'              	JZ	MF_NEW
  27B0'   21 2376'              	LXI	H,SROM
  27B3'   CD 27BE'              	CALL	MF_PUT
  27B6'                         MF_NEW:
  27B6'   3A 2A02'              	LDA	MSGNEW
  27B9'   B7                    	ORA	A
  27BA'   C8                    	RZ
  27BB'   21 2381'              	LXI	H,SNEWM
  27BE'                         MF_PUT:
  27BE'   78                    	MOV	A,B
  27BF'   B7                    	ORA	A
  27C0'   C2 27CC'              	JNZ	MF_STR
  27C3'   06 01                 	MVI	B,1
  27C5'   E5                    	PUSH	H
  27C6'   3E 20                 	MVI	A,' '
  27C8'   CD 0000*              	CALL	OUTCH
  27CB'   E1                    	POP	H
  27CC'                         MF_STR:
  27CC'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  27CF'                         EMITW:
  27CF'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27D0'   D5                    	PUSH	D
  27D1'   06 00                 	MVI	B,0
  27D3'   11 2710               	LXI	D,10000
  27D6'   CD 27F4'              	CALL	EWDIG
  27D9'   11 03E8               	LXI	D,1000
  27DC'   CD 27F4'              	CALL	EWDIG
  27DF'   11 0064               	LXI	D,100
  27E2'   CD 27F4'              	CALL	EWDIG
  27E5'   11 000A               	LXI	D,10
  27E8'   CD 27F4'              	CALL	EWDIG
  27EB'   7D                    	MOV	A,L		; the units digit is always printed
  27EC'   C6 30                 	ADI	'0'
  27EE'   CD 0000*              	CALL	OUTCH
  27F1'   D1                    	POP	D
  27F2'   C1                    	POP	B
  27F3'   C9                    	RET
  27F4'                         EWDIG:
  27F4'   0E 00                 	MVI	C,0
  27F6'                         EW_LP:
  27F6'   7D                    	MOV	A,L
  27F7'   93                    	SUB	E
  27F8'   6F                    	MOV	L,A
  27F9'   7C                    	MOV	A,H
  27FA'   9A                    	SBB	D
  27FB'   67                    	MOV	H,A
  27FC'   DA 2803'              	JC	EW_DN
  27FF'   0C                    	INR	C
  2800'   C3 27F6'              	JMP	EW_LP
  2803'                         EW_DN:
  2803'   19                    	DAD	D		; one subtraction too many: give it back
  2804'   79                    	MOV	A,C
  2805'   B7                    	ORA	A
  2806'   C2 280C'              	JNZ	EW_PR
  2809'   78                    	MOV	A,B
  280A'   B7                    	ORA	A
  280B'   C8                    	RZ			; a leading zero: write nothing
  280C'                         EW_PR:
  280C'   79                    	MOV	A,C
  280D'   C6 30                 	ADI	'0'
  280F'   CD 0000*              	CALL	OUTCH
  2812'   06 01                 	MVI	B,1
  2814'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2815'                         ISEMPT:
  2815'   2A 0000*              	LHLD	OUTPOS
  2818'   7C                    	MOV	A,H
  2819'   B5                    	ORA	L
  281A'   C0                    	RNZ
  281B'   CD 0000*              	CALL	LOGLEN
  281E'   7C                    	MOV	A,H
  281F'   B5                    	ORA	L
  2820'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2821'                         MSGCTG:
  2821'   21 0000*              	LXI	H,FNAME
  2824'   CD 272E'              	CALL	MSGNAM
  2827'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2829'   CD 2796'              	CALL	MSGFLG
  282C'   CD 2815'              	CALL	ISEMPT
  282F'   C2 2838'              	JNZ	MG_POS
  2832'   21 2394'              	LXI	H,SNOLIN
  2835'   C3 0000*              	JMP	OUTSTR
  2838'                         MG_POS:
  2838'   21 2387'              	LXI	H,SLINE
  283B'   CD 0000*              	CALL	OUTSTR
  283E'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2841'   23                    	INX	H		;   ... so the line it is on
  2842'   CD 27CF'              	CALL	EMITW
  2845'   21 238E'              	LXI	H,SCOLM
  2848'   CD 0000*              	CALL	OUTSTR
  284B'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  284E'   23                    	INX	H
  284F'   E5                    	PUSH	H
  2850'   CD 27CF'              	CALL	EMITW
  2853'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2856'   23                    	INX	H
  2857'   D1                    	POP	D
  2858'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  285B'   C8                    	RZ
  285C'   E5                    	PUSH	H
  285D'   3E 2D                 	MVI	A,'-'
  285F'   CD 0000*              	CALL	OUTCH
  2862'   E1                    	POP	H
  2863'   C3 27CF'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2866'                         FILMSG:
  2866'   3A 0001*              	LDA	FNAME+1
  2869'   FE 20                 	CPI	' '
  286B'   C8                    	RZ
  286C'   21 0000*              	LXI	H,FNAME
  286F'   CD 272E'              	CALL	MSGNAM
  2872'   AF                    	XRA	A		; nothing has been changed yet
  2873'   C3 2796'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2876'                         WRMSG:
  2876'   21 0000*              	LXI	H,TFCB
  2879'   CD 272E'              	CALL	MSGNAM
  287C'   21 23A6'              	LXI	H,SWRIT
  287F'   C3 0000*              	JMP	OUTSTR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2882'                         MSGPST:
  2882'   3A 2A01'              	LDA	MSGWHT
  2885'   B7                    	ORA	A
  2886'   C8                    	RZ
  2887'   47                    	MOV	B,A
  2888'   AF                    	XRA	A
  2889'   32 2A01'              	STA	MSGWHT
  288C'   78                    	MOV	A,B
  288D'   FE 01                 	CPI	MW_FIL
  288F'   CA 28AB'              	JZ	MP_FIL
  2892'   FE 02                 	CPI	MW_WRT
  2894'   CA 28B1'              	JZ	MP_WRT
  2897'   FE 04                 	CPI	MW_BIG
  2899'   CA 28A2'              	JZ	MP_BIG
  289C'   CD 2821'              	CALL	MSGCTG
  289F'   C3 0000*              	JMP	SCURS
  28A2'                         MP_BIG:
  28A2'   21 2342'              	LXI	H,SQBIG
  28A5'   CD 0000*              	CALL	EXMSG
  28A8'   C3 0000*              	JMP	SCURS
  28AB'                         MP_FIL:
  28AB'   CD 2866'              	CALL	FILMSG
  28AE'   C3 0000*              	JMP	SCURS
  28B1'                         MP_WRT:
  28B1'   CD 2876'              	CALL	WRMSG
  28B4'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  28B7'                         VC_CTLG:
  28B7'   3E 03                 	MVI	A,MW_CTG
  28B9'   32 2A01'              	STA	MSGWHT
  28BC'   3E 01                 	MVI	A,R_MOVE
  28BE'   32 299A'              	STA	RINTENT
  28C1'   C3 068B'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  28C4'                         CMDTAB:
  28C4'   07                    	DB	07H			; ^G -- where am I?
  28C5'   28B7'                 	DW	VC_CTLG
  28C7'   68                    	DB	'h'
  28C8'   07B3'                 	DW	VC_H
  28CA'   6C                    	DB	'l'
  28CB'   07DD'                 	DW	VC_L
  28CD'   6A                    	DB	'j'
  28CE'   08A2'                 	DW	VC_J
  28D0'   6B                    	DB	'k'
  28D1'   08B1'                 	DW	VC_K
  28D3'   30                    	DB	'0'
  28D4'   0804'                 	DW	VC_0
  28D6'   5E                    	DB	'^'
  28D7'   0822'                 	DW	VC_CRT
  28D9'   24                    	DB	'$'
  28DA'   0860'                 	DW	VC_EOL
