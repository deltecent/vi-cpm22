  09B5'   E5                    	PUSH	H
  09B6'   2A 0000*              	LHLD	LNDLT
  09B9'   7C                    	MOV	A,H
  09BA'   FE 40                 	CPI	40H
  09BC'   CA 09D1'              	JZ	LN_X
  09BF'   23                    	INX	H
  09C0'   C3 09CE'              	JMP	LN_ST
  09C3'                         LNDEC:
  09C3'   E5                    	PUSH	H
  09C4'   2A 0000*              	LHLD	LNDLT
  09C7'   7C                    	MOV	A,H
  09C8'   FE C0                 	CPI	0C0H
  09CA'   CA 09D1'              	JZ	LN_X
  09CD'   2B                    	DCX	H
  09CE'                         LN_ST:
  09CE'   22 0000*              	SHLD	LNDLT
  09D1'                         LN_X:
  09D1'   E1                    	POP	H
  09D2'   C9                    	RET
                                
  09D3'   AF                    VC_E:	XRA	A
  09D4'   32 2284'              	STA	WBIG
  09D7'   C3 09DF'              	JMP	EDO
  09DA'   3E 01                 VCBGE:	MVI	A,1
  09DC'   32 2284'              	STA	WBIG
  09DF'   CD 04F1'              EDO:	CALL	SETMOV
  09E2'   CD 0484'              	CALL	GETCNT
  09E5'   22 22B0'              	SHLD	CNTV
  09E8'   2A 22B0'              EDO_LP: LHLD	CNTV
  09EB'   7C                    	MOV	A,H
  09EC'   B5                    	ORA	L
  09ED'   C8                    	RZ
  09EE'   2B                    	DCX	H
