  0BEE'   CD 0000*              	CALL	CHARAT
  0BF1'   CD 0679'              	CALL	CLASSF
  0BF4'   B7                    	ORA	A
  0BF5'   C2 0C02'              	JNZ	ES_WD
  0BF8'   2A 24E7'              	LHLD	WKI
  0BFB'   23                    	INX	H
  0BFC'   22 24E7'              	SHLD	WKI
  0BFF'   C3 0BDE'              	JMP	ES_WS
