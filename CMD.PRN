  104A'   7A                    	MOV	A,D
  104B'   B7                    	ORA	A
  104C'   CA 1067'              	JZ	VHD_C		; the text stays
  104F'   4A                    	MOV	C,D
  1050'   CD 1159'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  1053'   79                    	MOV	A,C
  1054'   B7                    	ORA	A
  1055'   CA 1067'              	JZ	VHD_C
  1058'   BA                    	CMP	D
  1059'   C2 1064'              	JNZ	VHD_R
  105C'   7E                    	MOV	A,M		; the top line still: past all of it
  105D'   91                    	SUB	C
  105E'   83                    	ADD	E
  105F'   5F                    	MOV	E,A
  1060'   23                    	INX	H
  1061'   C3 1067'              	JMP	VHD_C
  1064'                         VHD_R:
  1064'   7B                    	MOV	A,E		; part of the way down a line: its start
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1065'   91                    	SUB	C
  1066'   5F                    	MOV	E,A
  1067'                         VHD_C:
  1067'   22 2E7A'              	SHLD	HFTP
  106A'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  106D'   83                    	ADD	E
  106E'   4F                    	MOV	C,A
  106F'   3A 2E7D'              	LDA	HTCUR
  1072'   CD 113B'              	CALL	HTPT
  1075'   CD 1159'              	CALL	HTFQ
  1078'   D2 107C'              	JNC	HFEND
  107B'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  107C'                         HFEND:
  107C'   EB                    	XCHG
  107D'   2A 2E7A'              	LHLD	HFTP
  1080'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1081'                         HTLAND:
  1081'   E5                    	PUSH	H
  1082'   D5                    	PUSH	D
  1083'   CD 114E'              	CALL	HTGO
  1086'   D1                    	POP	D
  1087'   E1                    	POP	H
  1088'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  108B'   7C                    	MOV	A,H
  108C'   B7                    	ORA	A
  108D'   7D                    	MOV	A,L
  108E'   CA 1092'              	JZ	HL_SET
  1091'   AF                    	XRA	A
  1092'                         HL_SET:
  1092'   CD 0E40'              	CALL	SETRWT
  1095'   C3 0954'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1098'                         VHD_TL:
  1098'   3A 0000*              	LDA	SKIPR
  109B'   47                    	MOV	B,A
  109C'   3A 0000*              	LDA	CSUB
  109F'   90                    	SUB	B		; A = that row
  10A0'   F5                    	PUSH	PSW
  10A1'   21 0001               	LXI	H,1
  10A4'   CD 0A0F'              	CALL	JCORE		; (on the last line: nowhere to go)
  10A7'   F1                    	POP	PSW
  10A8'   4F                    	MOV	C,A
  10A9'   C5                    	PUSH	B
  10AA'   0C                    	INR	C
  10AB'   06 00                 	MVI	B,0
  10AD'   CD 112F'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  10B0'   22 2E7A'              	SHLD	HFTP
  10B3'   D1                    	POP	D
  10B4'   4B                    	MOV	C,E
  10B5'   CD 1159'              	CALL	HTFQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10B8'   D2 107C'              	JNC	HFEND
  10BB'   2B                    	DCX	H
  10BC'   C3 107C'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  10BF'                         VC_HFUP:
  10BF'   CD 085B'              	CALL	SETMOV
  10C2'   CD 123D'              	CALL	HFCNT		; HFN = the rows
  10C5'   CD 121D'              	CALL	ONFST
  10C8'   C8                    	RZ			; the cursor is on the first line
  10C9'   0E 01                 	MVI	C,1
  10CB'   3A 2E79'              	LDA	HFN
  10CE'   CD 111A'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  10D1'   43                    	MOV	B,E
  10D2'   3A 2E79'              	LDA	HFN
  10D5'   4F                    	MOV	C,A
  10D6'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10D7'   CD 116A'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  10DA'   DA 10F5'              	JC	VHU_C		;   above it; or the file's first line
  10DD'   79                    	MOV	A,C
  10DE'   B7                    	ORA	A
  10DF'   CA 10F5'              	JZ	VHU_C
  10E2'   3A 2E7E'              	LDA	HTTP
  10E5'   3D                    	DCR	A
  10E6'   B8                    	CMP	B
  10E7'   CA 10F2'              	JZ	VHU_F
  10EA'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  10EB'   96                    	SUB	M
  10EC'   81                    	ADD	C
  10ED'   5F                    	MOV	E,A
  10EE'   23                    	INX	H
  10EF'   C3 10F5'              	JMP	VHU_C
  10F2'                         VHU_F:
  10F2'   7B                    	MOV	A,E		; ... the first line back: all of it
  10F3'   81                    	ADD	C
  10F4'   5F                    	MOV	E,A
  10F5'                         VHU_C:
  10F5'   22 2E7A'              	SHLD	HFTP
  10F8'   4B                    	MOV	C,E
  10F9'   3A 2E7D'              	LDA	HTCUR
  10FC'   CD 113B'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  10FF'   3A 0000*              	LDA	CSUB
  1102'   57                    	MOV	D,A
  1103'   79                    	MOV	A,C
  1104'   92                    	SUB	D		; the rows to go, less those of its own line above it
  1105'   DA 107C'              	JC	HFEND
  1108'   CA 107C'              	JZ	HFEND
  110B'   4F                    	MOV	C,A
  110C'   43                    	MOV	B,E
  110D'   CD 116A'              	CALL	HTBQ		; (off the top: the file's first line)
  1110'   C3 107C'              	JMP	HFEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  1113'                         HTSCR:
  1113'   CD 0E21'              	CALL	CURRW
  1116'   47                    	MOV	B,A
  1117'   C3 1125'              	JMP	HS_TP
  111A'                         HTSET:
  111A'   47                    	MOV	B,A
  111B'   CD 0E21'              	CALL	CURRW		; (keeps BC)
  111E'   F5                    	PUSH	PSW
  111F'   80                    	ADD	B
  1120'   47                    	MOV	B,A
  1121'   CD 112F'              	CALL	HTRB
  1124'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  1125'                         HS_TP:
  1125'   3A 2E7D'              	LDA	HTCUR
  1128'   90                    	SUB	B
  1129'   32 2E7E'              	STA	HTTP
  112C'   C3 113B'              	JMP	HTPT
  112F'                         HTRB:
  112F'   CD 130D'              	CALL	ZSAVE
  1132'   CD 0000*              	CALL	HTBLD
  1135'   CD 1320'              	CALL	ZREST
  1138'   3A 2E7D'              	LDA	HTCUR
  113B'                         HTPT:
  113B'   5F                    	MOV	E,A
  113C'   16 00                 	MVI	D,0
  113E'   21 0000*              	LXI	H,HTAB
  1141'   19                    	DAD	D
  1142'   3A 2E7C'              	LDA	HTN
  1145'   93                    	SUB	E
  1146'   47                    	MOV	B,A
  1147'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1148'                         HTIX:
  1148'   11 0000*              	LXI	D,HTAB
  114B'   7D                    	MOV	A,L
  114C'   93                    	SUB	E
  114D'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  114E'                         HTGO:
  114E'   CD 1148'              	CALL	HTIX
  1151'   47                    	MOV	B,A
  1152'   3A 2E7D'              	LDA	HTCUR
  1155'   90                    	SUB	B		; A = the lines up to it
  1156'   C3 0E58'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1159'                         HTFQ:
  1159'   78                    	MOV	A,B
  115A'   B7                    	ORA	A
  115B'   37                    	STC
  115C'   C8                    	RZ
  115D'   79                    	MOV	A,C
  115E'   96                    	SUB	M
  115F'   DA 1168'              	JC	HF_IN
  1162'   4F                    	MOV	C,A
  1163'   23                    	INX	H
  1164'   05                    	DCR	B
  1165'   C3 1159'              	JMP	HTFQ
  1168'                         HF_IN:
  1168'   B7                    	ORA	A
  1169'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  116A'                         HTBQ:
  116A'   78                    	MOV	A,B
  116B'   B7                    	ORA	A
  116C'   37                    	STC
  116D'   C8                    	RZ
  116E'   2B                    	DCX	H
  116F'   05                    	DCR	B
  1170'   7E                    	MOV	A,M
  1171'   91                    	SUB	C
  1172'   D2 117B'              	JNC	HQ_IN
  1175'   2F                    	CMA
  1176'   3C                    	INR	A
  1177'   4F                    	MOV	C,A
  1178'   C3 116A'              	JMP	HTBQ
  117B'                         HQ_IN:
  117B'   4F                    	MOV	C,A
  117C'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  117D'                         RWQ:
  117D'   0E 64                 	MVI	C,100
  117F'   3A 2E82'              	LDA	RWR+1
  1182'   B7                    	ORA	A
  1183'   C0                    	RNZ
  1184'   3A 2E81'              	LDA	RWR
  1187'   B9                    	CMP	C
  1188'   D0                    	RNC
  1189'   4F                    	MOV	C,A
  118A'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  118B'                         RWSUB:
  118B'   E5                    	PUSH	H
  118C'   5F                    	MOV	E,A
  118D'   16 00                 	MVI	D,0
  118F'   2A 2E81'              	LHLD	RWR
  1192'   CD 0000*              	CALL	SUBHD
  1195'   22 2E81'              	SHLD	RWR
  1198'   E1                    	POP	H
  1199'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  119A'                         RWFWD:
  119A'   CD 117D'              	CALL	RWQ
  119D'   51                    	MOV	D,C
  119E'   CD 1159'              	CALL	HTFQ
  11A1'   F5                    	PUSH	PSW
  11A2'   7A                    	MOV	A,D
  11A3'   91                    	SUB	C		; the rows that took it to that line's first
  11A4'   CD 118B'              	CALL	RWSUB
  11A7'   F1                    	POP	PSW
  11A8'   DA 11BC'              	JC	RF_OFF
  11AB'   3A 2E82'              	LDA	RWR+1		; is what is left inside this line?
  11AE'   B7                    	ORA	A
  11AF'   C2 11C6'              	JNZ	RF_GO
  11B2'   3A 2E81'              	LDA	RWR
  11B5'   BE                    	CMP	M
  11B6'   D2 11C6'              	JNC	RF_GO
  11B9'   4F                    	MOV	C,A
  11BA'   B7                    	ORA	A
  11BB'   C9                    	RET
  11BC'                         RF_OFF:
  11BC'   3A 2E7F'              	LDA	HTEOF
  11BF'   B7                    	ORA	A
  11C0'   CA 11C6'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  11C3'   2B                    	DCX	H
  11C4'   37                    	STC
  11C5'   C9                    	RET
  11C6'                         RF_GO:
  11C6'   CD 114E'              	CALL	HTGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11C9'   3E 01                 	MVI	A,1
  11CB'   32 2E83'              	STA	RWMV
  11CE'   CD 117D'              	CALL	RWQ
  11D1'   0C                    	INR	C
  11D2'   06 00                 	MVI	B,0
  11D4'   CD 112F'              	CALL	HTRB
  11D7'   C3 119A'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  11DA'                         RWBAK:
  11DA'   CD 117D'              	CALL	RWQ
  11DD'   51                    	MOV	D,C
  11DE'   CD 116A'              	CALL	HTBQ
  11E1'   DA 11FE'              	JC	RB_OFF
  11E4'   7A                    	MOV	A,D
  11E5'   81                    	ADD	C
  11E6'   5F                    	MOV	E,A		; E = the rows up to that line's first
  11E7'   3A 2E82'              	LDA	RWR+1
  11EA'   B7                    	ORA	A
  11EB'   C2 11FA'              	JNZ	RB_ON
  11EE'   3A 2E81'              	LDA	RWR
  11F1'   57                    	MOV	D,A
  11F2'   7B                    	MOV	A,E
  11F3'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  11F4'   DA 11FA'              	JC	RB_ON
  11F7'   4F                    	MOV	C,A
  11F8'   B7                    	ORA	A
  11F9'   C9                    	RET
  11FA'                         RB_ON:
  11FA'   7B                    	MOV	A,E
  11FB'   C3 1205'              	JMP	RB_GO
  11FE'                         RB_OFF:
  11FE'   3A 2E80'              	LDA	HTBOF
  1201'   0F                    	RRC			; CY: that is the file's first line
  1202'   D8                    	RC
  1203'   7A                    	MOV	A,D
  1204'   91                    	SUB	C
  1205'                         RB_GO:
  1205'   CD 118B'              	CALL	RWSUB
  1208'   CD 114E'              	CALL	HTGO
  120B'   3E 01                 	MVI	A,1
  120D'   32 2E83'              	STA	RWMV
  1210'   CD 117D'              	CALL	RWQ
  1213'   41                    	MOV	B,C
  1214'   0E 01                 	MVI	C,1
  1216'   CD 112F'              	CALL	HTRB
  1219'   43                    	MOV	B,E
  121A'   C3 11DA'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  121D'                         ONFST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  121D'   E5                    	PUSH	H
  121E'   2A 0000*              	LHLD	OUTPOS
  1221'   7C                    	MOV	A,H
  1222'   B5                    	ORA	L
  1223'   C2 123B'              	JNZ	OF_RET
  1226'   2A 0000*              	LHLD	TXTBEG
  1229'   EB                    	XCHG			; DE = TXTBEG
  122A'   2A 0000*              	LHLD	GAPBEG
  122D'                         OF_LP:
  122D'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1230'   CA 123B'              	JZ	OF_RET
  1233'   2B                    	DCX	H
  1234'   7E                    	MOV	A,M
  1235'   FE 0A                 	CPI	LF
  1237'   C2 122D'              	JNZ	OF_LP
  123A'   B7                    	ORA	A		; NZ
  123B'                         OF_RET:
  123B'   E1                    	POP	H
  123C'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  123D'                         HFCNT:
  123D'   2A 2E69'              	LHLD	CMDCNT
  1240'   7C                    	MOV	A,H
  1241'   B5                    	ORA	L
  1242'   CA 1259'              	JZ	HFC_AM
  1245'   CD 0786'              	CALL	GETCNT		; HL = count; clears it
  1248'   3A 0000*              	LDA	NEDIT
  124B'   5F                    	MOV	E,A
  124C'   16 00                 	MVI	D,0
  124E'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1251'   D2 1255'              	JNC	HFC_ST
  1254'   EB                    	XCHG			; HL = NEDIT
  1255'                         HFC_ST:
  1255'   7D                    	MOV	A,L
  1256'   32 2E78'              	STA	HFAMT
  1259'                         HFC_AM:
  1259'   3A 2E78'              	LDA	HFAMT
  125C'   B7                    	ORA	A
  125D'   C2 126A'              	JNZ	HFC_HL
  1260'   3A 0000*              	LDA	NEDIT
  1263'   B7                    	ORA	A
  1264'   1F                    	RAR
  1265'   B7                    	ORA	A
  1266'   C2 126A'              	JNZ	HFC_HL
  1269'   3C                    	INR	A		; at least one row
  126A'                         HFC_HL:
  126A'   32 2E79'              	STA	HFN
  126D'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  126E'                         VC_REDR:
  126E'   C3 0786'              	JMP	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1271'                         VC_G:
  1271'   CD 085B'              	CALL	SETMOV
  1274'   CD 1333'              	CALL	GZONE		; the screen's top line, before the move
  1277'   CD 07AF'              	CALL	BRKON		; ... and an ESC may stop it from here on
  127A'   2A 2E69'              	LHLD	CMDCNT
  127D'   7C                    	MOV	A,H
  127E'   B5                    	ORA	L
  127F'   C2 1292'              	JNZ	VG_N
  1282'   AF                    	XRA	A		; forward
  1283'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1286'   CD 07EC'              	CALL	BRKOFF
  1289'   DA 0804'              	JC	BRKBAK
  128C'   CD 0B43'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  128F'   C3 134B'              	JMP	GPLACE
  1292'                         VG_N:
  1292'   CD 0786'              	CALL	GETCNT		; HL = target line (1-based)
  1295'                         VG_LN:
  1295'   CD 12A1'              	CALL	GOLN
  1298'   CD 07EC'              	CALL	BRKOFF
  129B'   DA 0804'              	JC	BRKBAK
  129E'   C3 134B'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  12A1'                         GOLN:
  12A1'   E5                    	PUSH	H
  12A2'   CD 0000*              	CALL	CNTLF
  12A5'   23                    	INX	H		; HL = the cursor's line
  12A6'   D1                    	POP	D		; DE = the line wanted
  12A7'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  12AA'   DA 12B5'              	JC	GLN_BK
  12AD'   EB                    	XCHG
  12AE'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  12B1'   AF                    	XRA	A
  12B2'   C3 12BA'              	JMP	GLN_MV
  12B5'                         GLN_BK:
  12B5'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12B8'   3E FF                 	MVI	A,0FFH
  12BA'                         GLN_MV:
  12BA'   CD 0000*              	CALL	MVLIND
  12BD'   CD 0B3D'              	CALL	ATEOF
  12C0'   DC 0B43'              	CC	LASTLN		; past the last line: onto it
  12C3'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  12C4'                         VC_LG:
  12C4'   CD 085B'              	CALL	SETMOV
  12C7'   3A 2E9F'              	LDA	GSAVE
  12CA'   B7                    	ORA	A
  12CB'   C2 12D4'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  12CE'   3E 01                 	MVI	A,PG
  12D0'   32 2E9E'              	STA	GPEND
  12D3'   C9                    	RET
  12D4'                         VLG_GG:
  12D4'   CD 1333'              	CALL	GZONE
  12D7'   CD 07AF'              	CALL	BRKON
  12DA'   CD 0786'              	CALL	GETCNT		; HL = target line (no count: 1)
  12DD'   C3 1295'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  12E0'                         SUB24:
  12E0'   4F                    	MOV	C,A
  12E1'   7D                    	MOV	A,L
  12E2'   93                    	SUB	E
  12E3'   6F                    	MOV	L,A
  12E4'   7C                    	MOV	A,H
  12E5'   9A                    	SBB	D
  12E6'   67                    	MOV	H,A
  12E7'   79                    	MOV	A,C
  12E8'   98                    	SBB	B
  12E9'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  12EA'                         CURFP:
  12EA'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  12ED'                         FPOS:
  12ED'   C5                    	PUSH	B
  12EE'   D5                    	PUSH	D
  12EF'   EB                    	XCHG
  12F0'   2A 0000*              	LHLD	TXTBEG
  12F3'   EB                    	XCHG
  12F4'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  12F7'   EB                    	XCHG			; DE = that
  12F8'   2A 0000*              	LHLD	OUTPOS
  12FB'   7C                    	MOV	A,H
  12FC'   B7                    	ORA	A		; CY = 0
  12FD'   1F                    	RAR
  12FE'   47                    	MOV	B,A
  12FF'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1300'   1F                    	RAR
  1301'   67                    	MOV	H,A
  1302'   3E 00                 	MVI	A,0
  1304'   1F                    	RAR
  1305'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  1306'   19                    	DAD	D
  1307'   78                    	MOV	A,B
  1308'   CE 00                 	ACI	0		; A:HL = the position
  130A'   D1                    	POP	D
  130B'   C1                    	POP	B
  130C'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  130D'                         ZSAVE:
  130D'   2A 2E69'              	LHLD	CMDCNT
  1310'   22 2EDB'              	SHLD	ZSVCNT
  1313'   2A 0000*              	LHLD	AUXCNT
  1316'   22 2EDD'              	SHLD	ZSVAUX
  1319'   3A 0000*              	LDA	DIRFLG
  131C'   32 2EDF'              	STA	ZSVDIR
  131F'   C9                    	RET
  1320'                         ZREST:
  1320'   2A 2EDB'              	LHLD	ZSVCNT
  1323'   22 2E69'              	SHLD	CMDCNT
  1326'   2A 2EDD'              	LHLD	ZSVAUX
  1329'   22 0000*              	SHLD	AUXCNT
  132C'   3A 2EDF'              	LDA	ZSVDIR
  132F'   32 0000*              	STA	DIRFLG
  1332'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1333'                         GZONE:
  1333'   CD 130D'              	CALL	ZSAVE
  1336'   CD 0E21'              	CALL	CURRW
  1339'   6F                    	MOV	L,A
  133A'   26 00                 	MVI	H,0
  133C'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  133F'   CD 12ED'              	CALL	FPOS
  1342'   22 0000*              	SHLD	ZTOP
  1345'   32 0002*              	STA	ZTOP+2
  1348'   C3 1320'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  134B'                         GPLACE:
  134B'   CD 130D'              	CALL	ZSAVE
  134E'   CD 12EA'              	CALL	CURFP
  1351'   EB                    	XCHG
  1352'   2A 0000*              	LHLD	ZTOP
  1355'   EB                    	XCHG
  1356'   4F                    	MOV	C,A		; C:HL = the target's position
  1357'   3A 0002*              	LDA	ZTOP+2
  135A'   47                    	MOV	B,A		; B:DE = the top's
  135B'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  135C'   CD 12E0'              	CALL	SUB24
  135F'   22 2ED8'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1362'   DA 139C'              	JC	GP_UP
  1365'   B7                    	ORA	A
  1366'   C2 13E2'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1369'   3A 0000*              	LDA	NEDIT
  136C'   87                    	ADD	A
  136D'   3C                    	INR	A
  136E'   6F                    	MOV	L,A
  136F'   26 00                 	MVI	H,0
  1371'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1374'   CD 077F'              	CALL	GBSUB		; HL = bytes from there to the target
  1377'   EB                    	XCHG
  1378'   2A 2ED8'              	LHLD	ZDIF		; HL = bytes from the top to the target
  137B'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  137E'   DA 13E2'              	JC	GP_MID
  1381'   CD 077F'              	CALL	GBSUB		; HL = the top line's start (resident)
  1384'   01 0000               	LXI	B,0		; BC = lines from the top
  1387'                         GP_CNT:
  1387'   7A                    	MOV	A,D
  1388'   B3                    	ORA	E
  1389'   CA 1398'              	JZ	GP_DN
  138C'   7E                    	MOV	A,M
  138D'   23                    	INX	H
  138E'   1B                    	DCX	D
  138F'   FE 0A                 	CPI	LF
  1391'   C2 1387'              	JNZ	GP_CNT
  1394'   03                    	INX	B
  1395'   C3 1387'              	JMP	GP_CNT
  1398'                         GP_DN:
  1398'   79                    	MOV	A,C		; the lines from the top one to it
  1399'   C3 140C'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  139C'                         GP_UP:
  139C'   3C                    	INR	A
  139D'   C2 13E2'              	JNZ	GP_MID		; 64K bytes or more above
  13A0'   2A 2ED8'              	LHLD	ZDIF
  13A3'   EB                    	XCHG
  13A4'   21 0000               	LXI	H,0
  13A7'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  13AA'   7C                    	MOV	A,H
  13AB'   B5                    	ORA	L
  13AC'   CA 13E2'              	JZ	GP_MID		; exactly 64K
  13AF'   EB                    	XCHG			; DE = bytes to read
  13B0'   AF                    	XRA	A
  13B1'   32 2EDA'              	STA	ZLF
  13B4'   CD 0000*              	CALL	RGET0
  13B7'                         GP_RD:
  13B7'   CD 0000*              	CALL	RDGET		; (keeps DE)
  13BA'   DA 13E2'              	JC	GP_MID
  13BD'   FE 0A                 	CPI	LF
  13BF'   C2 13D3'              	JNZ	GP_RN
  13C2'   3A 0000*              	LDA	NEDIT
  13C5'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13C6'   1F                    	RAR
  13C7'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  13C9'   E5                    	PUSH	H
  13CA'   21 2EDA'              	LXI	H,ZLF
  13CD'   34                    	INR	M
  13CE'   BE                    	CMP	M		; CY iff more lines than that
  13CF'   E1                    	POP	H
  13D0'   DA 13E2'              	JC	GP_MID
  13D3'                         GP_RN:
  13D3'   1B                    	DCX	D
  13D4'   7A                    	MOV	A,D
  13D5'   B3                    	ORA	E
  13D6'   C2 13B7'              	JNZ	GP_RD
  13D9'   3E 01                 	MVI	A,PL_SET	; the top row
  13DB'   32 0000*              	STA	PLACE
  13DE'   AF                    	XRA	A
  13DF'   C3 13EC'              	JMP	GP_SET
  13E2'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  13E2'   3E 02                 	MVI	A,PL_MID
  13E4'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  13E7'   3A 0000*              	LDA	NEDIT
  13EA'   B7                    	ORA	A
  13EB'   1F                    	RAR			; (no more lines above it than this)
  13EC'                         GP_SET:
  13EC'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  13ED'   26 00                 	MVI	H,0
  13EF'   22 0000*              	SHLD	WINROW
  13F2'   21 0000               	LXI	H,0
  13F5'   22 0000*              	SHLD	LNDLT
  13F8'   CD 0898'              	CALL	SETFUL		; the window may have paged: full repaint
  13FB'                         GP_FIN:
  13FB'   CD 1320'              	CALL	ZREST
  13FE'   3A 2F03'              	LDA	GPKEEP
  1401'   B7                    	ORA	A
  1402'   CA 0954'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1405'   AF                    	XRA	A
  1406'   32 2F03'              	STA	GPKEEP
  1409'   C3 0611'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  140C'                         GP_ONS:
  140C'   6F                    	MOV	L,A
  140D'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  140F'   EB                    	XCHG
  1410'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1413'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1414'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1417'   22 0000*              	SHLD	LNDLT
  141A'   3E 01                 	MVI	A,R_MOVE
  141C'   32 2E6D'              	STA	RINTENT
  141F'   C3 13FB'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1422'                         OPPEND:
  1422'   AF                    	XRA	A
  1423'   32 2EA4'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1426'   3A 2EA1'              	LDA	PSAVE
  1429'   FE 63                 	CPI	'c'
  142B'   C2 1448'              	JNZ	OPP_ND
  142E'   79                    	MOV	A,C
  142F'   FE 77                 	CPI	'w'
  1431'   CA 1439'              	JZ	OPP_W
  1434'   FE 57                 	CPI	'W'
  1436'   C2 1448'              	JNZ	OPP_ND
  1439'                         OPP_W:
  1439'   CD 161B'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  143C'   DA 1448'              	JC	OPP_ND
  143F'   79                    	MOV	A,C
  1440'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1442'   4F                    	MOV	C,A
  1443'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1445'   32 2EA4'              	STA	CWEOL		;   char for the next word's: see ESTEP
  1448'                         OPP_ND:
  1448'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1449'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  144B'   C2 145F'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  144E'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1451'   DA 14EF'              	JC	OPABRT
  1454'   79                    	MOV	A,C
  1455'   FE 67                 	CPI	'g'
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1457'   C2 14EF'              	JNZ	OPABRT
  145A'   3E 01                 	MVI	A,PG
  145C'   32 2E9F'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  145F'                         OPP_NG:
  145F'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1460'   21 2EA1'              	LXI	H,PSAVE
  1463'   BE                    	CMP	M
  1464'   CA 163C'              	JZ	OPLINE
  1467'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1468'   CD 1652'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  146B'   DA 14EF'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  146E'   32 2EA3'              	STA	OPCLSV
  1471'   47                    	MOV	B,A		; B = the class
  1472'   3A 2EA1'              	LDA	PSAVE
  1475'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1477'   C2 1483'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  147A'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  147B'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  147D'   C2 14A5'              	JNZ	OPP_GO
  1480'   C3 148E'              	JMP	OPP_NO
  1483'                         OPP_NC:
  1483'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1485'   C2 14A5'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1488'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1489'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  148B'   CA 14A5'              	JZ	OPP_GO		;   within a line -- neither of which is built
  148E'                         OPP_NO:
  148E'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  148F'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1491'   CA 149F'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1494'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1496'   CA 149F'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1499'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  149C'   C2 14EF'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  149F'                         OPP_SW:
  149F'   CD 01F9'              	CALL	MKGETK
  14A2'   C3 14EF'              	JMP	OPABRT
  14A5'                         OPP_GO:
  14A5'   AF                    	XRA	A
  14A6'   32 2E77'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  14A9'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  14AC'   22 2EA5'              	SHLD	OPSTA
  14AF'   C5                    	PUSH	B
  14B0'   21 2EA9'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  14B3'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  14B6'   3A 2EA3'              	LDA	OPCLSV
  14B9'   FE 02                 	CPI	2
  14BB'   CC 14F2'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  14BE'   C1                    	POP	B
  14BF'   21 2DB0'              	LXI	H,CMDTAB
  14C2'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  14C5'   3A 2EA1'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  14C8'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  14C9'   CA 085B'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  14CC'   CD 151E'              	CALL	OPSFIX		; where the start is in the window NOW
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14CF'   D2 153A'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  14D2'   22 2EA5'              	SHLD	OPSTA
  14D5'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  14D8'   22 2EA7'              	SHLD	OPEND2
  14DB'   3A 2EA1'              	LDA	PSAVE
  14DE'   FE 79                 	CPI	'y'
  14E0'   CA 1BF4'              	JZ	OPYANK		; a yank takes the span without losing it
  14E3'   CD 168D'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  14E6'   3A 2EA1'              	LDA	PSAVE
  14E9'   FE 63                 	CPI	'c'
  14EB'   C0                    	RNZ
  14EC'   C3 19A8'              	JMP	SETINS
  14EF'                         OPABRT:				; not a motion -> the operator is dropped and
  14EF'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  14F2'                         OPENDS:
  14F2'   2A 2EA5'              	LHLD	OPSTA
  14F5'   CD 0678'              	CALL	BOL
  14F8'   11 2EAC'              	LXI	D,OPSLO
  14FB'   CD 1510'              	CALL	OPE_ST
  14FE'   2A 2EA5'              	LHLD	OPSTA
  1501'   CD 070F'              	CALL	NLSTART
  1504'   11 2EAF'              	LXI	D,OPSHI
  1507'   CD 1510'              	CALL	OPE_ST
  150A'   2A 2EA5'              	LHLD	OPSTA
  150D'   C3 0000*              	JMP	GOTO
  1510'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1510'   D5                    	PUSH	D
  1511'   CD 0000*              	CALL	GOTO
  1514'   E1                    	POP	H
  1515'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1518'                         CURBD:
  1518'   CD 12EA'              	CALL	CURFP
  151B'   EB                    	XCHG
  151C'   47                    	MOV	B,A
  151D'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  151E'                         OPSFIX:
  151E'   21 2EA9'              	LXI	H,OPSFP
  1521'   CD 03DC'              	CALL	MKLOAD
  1524'   CD 1518'              	CALL	CURBD
  1527'   2A 2F0D'              	LHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  152A'   3A 2F0F'              	LDA	MKPOS+2
  152D'   CD 12E0'              	CALL	SUB24
  1530'   B4                    	ORA	H
  1531'   B5                    	ORA	L
  1532'   C2 03E9'              	JNZ	MKWIN
  1535'   CD 0000*              	CALL	CUROFF
  1538'   37                    	STC
  1539'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  153A'                         OPPGD:
  153A'   47                    	MOV	B,A
  153B'   3A 2EA3'              	LDA	OPCLSV
  153E'   FE 02                 	CPI	2
  1540'   C2 15FC'              	JNZ	OPG_NO
  1543'   3A 2EA1'              	LDA	PSAVE
  1546'   FE 64                 	CPI	'd'
  1548'   C2 15FC'              	JNZ	OPG_NO
  154B'   04                    	INR	B
  154C'   CA 155B'              	JZ	OPG_FW
  154F'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1552'   CD 0678'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1555'   CD 0000*              	CALL	GOTO
  1558'   C3 1573'              	JMP	OPG_GO
  155B'                         OPG_FW:
  155B'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  155E'   CD 070F'              	CALL	NLSTART		;   landed on, and the low one is where the
  1561'   11 2EAF'              	LXI	D,OPSHI		;   start line began
  1564'   CD 1510'              	CALL	OPE_ST
  1567'   21 2EAC'              	LXI	H,OPSLO
  156A'   CD 03DC'              	CALL	MKLOAD
  156D'   CD 03A9'              	CALL	MKPAGE
  1570'   CD 0000*              	CALL	GOTO
  1573'                         OPG_GO:
  1573'   CD 1518'              	CALL	CURBD
  1576'   2A 2EAF'              	LHLD	OPSHI
  1579'   3A 2EB1'              	LDA	OPSHI+2
  157C'   CD 12E0'              	CALL	SUB24		; A:HL = the bytes to take
  157F'                         OPG_SV:
  157F'   22 2EB2'              	SHLD	OPTOGO
  1582'   32 2EB4'              	STA	OPTOGO+2
  1585'                         OPG_NX:
  1585'   CD 0762'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1588'   CD 0000*              	CALL	SUBHD
  158B'   EB                    	XCHG			; DE = what the window holds past the cursor
  158C'   2A 2EB2'              	LHLD	OPTOGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  158F'   3A 2EB4'              	LDA	OPTOGO+2
  1592'   B7                    	ORA	A
  1593'   C2 15C6'              	JNZ	OPG_PG		; 64K or more to go
  1596'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1599'   DA 15C6'              	JC	OPG_PG
  159C'   CA 15C6'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  159F'                         OPG_FN:				; the rest of it is here
  159F'   E5                    	PUSH	H
  15A0'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  15A3'   CD 0000*              	CALL	CUROFF
  15A6'   22 2EB5'              	SHLD	OPLO
  15A9'   D1                    	POP	D
  15AA'   19                    	DAD	D
  15AB'   22 2EB7'              	SHLD	OPHI
  15AE'   CD 17C0'              	CALL	OPDSPN
  15B1'   CD 0B3D'              	CALL	ATEOF
  15B4'   D2 1615'              	JNC	OPMID
  15B7'   CD 121D'              	CALL	ONFST		; deleted to the end of the file: onto the new
  15BA'   CA 1615'              	JZ	OPMID		;   last line, if there is one -- and the pager
  15BD'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  15C0'   CD 0000*              	CALL	SETBWD
  15C3'   C3 1615'              	JMP	OPMID
  15C6'                         OPG_PG:
  15C6'   7A                    	MOV	A,D
  15C7'   B3                    	ORA	E
  15C8'   C2 15E1'              	JNZ	OPG_DL
  15CB'   CD 0B3D'              	CALL	ATEOF		; nothing held past the cursor
  15CE'   21 0000               	LXI	H,0
  15D1'   DA 159F'              	JC	OPG_FN		; ... and no more to come: the file ran out
  15D4'   2B                    	DCX	H
  15D5'   CD 0000*              	CALL	SETC0
  15D8'   CD 0000*              	CALL	GOLINE
  15DB'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  15DE'   C3 1585'              	JMP	OPG_NX
  15E1'                         OPG_DL:
  15E1'   D5                    	PUSH	D
  15E2'   21 FFFF               	LXI	H,0FFFFH
  15E5'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  15E8'   E1                    	POP	H
  15E9'   E5                    	PUSH	H
  15EA'   CD 0000*              	CALL	DELFWD
  15ED'   D1                    	POP	D
  15EE'   06 00                 	MVI	B,0
  15F0'   2A 2EB2'              	LHLD	OPTOGO
  15F3'   3A 2EB4'              	LDA	OPTOGO+2
  15F6'   CD 12E0'              	CALL	SUB24
  15F9'   C3 157F'              	JMP	OPG_SV
  15FC'                         OPG_NO:
  15FC'   0E 07                 	MVI	C,BEL
  15FE'   CD 0000*              	CALL	BCONOU
  1601'                         OPG_HM:				; the cursor back where the command found it
  1601'   21 2EA9'              	LXI	H,OPSFP
  1604'   CD 03DC'              	CALL	MKLOAD
  1607'   CD 03A9'              	CALL	MKPAGE
  160A'   CD 0000*              	CALL	GOTO
  160D'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  160E'   32 2EA1'              	STA	PSAVE
  1611'   3C                    	INR	A
  1612'   32 2F03'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1615'                         OPMID:
  1615'   CD 130D'              	CALL	ZSAVE
  1618'   C3 13E2'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  161B'                         ONWHIT:
  161B'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  161E'   CA 163A'              	JZ	OW_YES
  1621'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1624'   FE 20                 	CPI	' '
  1626'   CA 163A'              	JZ	OW_YES
  1629'   FE 09                 	CPI	TAB
  162B'   CA 163A'              	JZ	OW_YES
  162E'   FE 0D                 	CPI	CR
  1630'   CA 163A'              	JZ	OW_YES
  1633'   FE 0A                 	CPI	LF
  1635'   CA 163A'              	JZ	OW_YES
  1638'   B7                    	ORA	A		; a char to change: CY clear
  1639'   C9                    	RET
  163A'                         OW_YES:
  163A'   37                    	STC
  163B'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  163C'                         OPLINE:
  163C'   3A 2EA1'              	LDA	PSAVE
  163F'   FE 63                 	CPI	'c'
  1641'   CA 085B'              	JZ	SETMOV
  1644'   FE 79                 	CPI	'y'
  1646'   CA 1BD3'              	JZ	VY_YY
  1649'   21 2EA9'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  164C'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  164F'   C3 1B49'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1652'                         OPCLS:
  1652'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1654'   CA 1661'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1657'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1659'   C2 1675'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  165C'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  165E'   C3 1663'              	JMP	OPC_FK
  1661'                         OPC_SEM:
  1661'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1663'                         OPC_FK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1663'   3A 2EF9'              	LDA	FNDKND
  1666'   B7                    	ORA	A
  1667'   37                    	STC
  1668'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1669'   A8                    	XRA	B		; ... and now the direction ',' asked for
  166A'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  166C'   CA 1673'              	JZ	OPC_EXC
  166F'   3E 01                 	MVI	A,1
  1671'   B7                    	ORA	A		; CY clear: a motion, class 1
  1672'   C9                    	RET
  1673'                         OPC_EXC:
  1673'   AF                    	XRA	A		; class 0, CY clear
  1674'   C9                    	RET
  1675'                         OPC_TB:
  1675'   47                    	MOV	B,A
  1676'   21 1865'              	LXI	H,OPCTAB
  1679'                         OPC_LP:
  1679'   7E                    	MOV	A,M
  167A'   B7                    	ORA	A
  167B'   CA 168B'              	JZ	OPC_MS		; end of table -> not a motion
  167E'   B8                    	CMP	B
  167F'   CA 1687'              	JZ	OPC_HT
  1682'   23                    	INX	H
  1683'   23                    	INX	H
  1684'   C3 1679'              	JMP	OPC_LP
  1687'                         OPC_HT:
  1687'   23                    	INX	H
  1688'   7E                    	MOV	A,M		; class byte
  1689'   B7                    	ORA	A		; clear CY
  168A'   C9                    	RET
  168B'                         OPC_MS:
  168B'   37                    	STC
  168C'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  168D'                         OPAPPL:
  168D'   3A 2EA3'              	LDA	OPCLSV
  1690'   FE 02                 	CPI	2
  1692'   CA 1839'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1695'   2A 2EA5'              	LHLD	OPSTA
  1698'   EB                    	XCHG			; DE = start
  1699'   2A 2EA7'              	LHLD	OPEND2		; HL = end
  169C'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  169F'   DA 16B2'              	JC	OPA_F
  16A2'   CA 16B2'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  16A5'   22 2EB5'              	SHLD	OPLO
  16A8'   EB                    	XCHG
  16A9'   22 2EB7'              	SHLD	OPHI
  16AC'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  16AF'   C3 1769'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16B2'                         OPA_F:
  16B2'   EB                    	XCHG			; HL = start, DE = end
  16B3'   22 2EB5'              	SHLD	OPLO
  16B6'   EB                    	XCHG			; HL = end
  16B7'   3A 2EA3'              	LDA	OPCLSV
  16BA'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  16BC'   CA 1766'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  16BF'   FE 01                 	CPI	1
  16C1'   C2 16E3'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  16C4'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  16C5'   22 2EB7'              	SHLD	OPHI		; park it: CEND clobbers DE
  16C8'   2B                    	DCX	H		; the line it landed on
  16C9'   CD 1926'              	CALL	CEND		; HL = that line's content end
  16CC'   EB                    	XCHG			; DE = it
  16CD'   2A 2EB7'              	LHLD	OPHI		; HL = hi
  16D0'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  16D3'   D2 16EE'              	JNC	OPA_HI		; hi is inside the line: keep it
  16D6'   2A 2EB5'              	LHLD	OPLO
  16D9'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  16DC'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  16DF'   EB                    	XCHG			; HL = the content end: the span stops there
  16E0'   C3 16EE'              	JMP	OPA_HI
  16E3'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  16E3'   22 2EB7'              	SHLD	OPHI
  16E6'   3A 2E77'              	LDA	WPULL
  16E9'   B7                    	ORA	A
  16EA'   CA 1769'              	JZ	OPA_C1
  16ED'   23                    	INX	H
  16EE'                         OPA_HI:
  16EE'   22 2EB7'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  16F1'                         OPA_DO:
  16F1'   CD 17B5'              	CALL	OPSPNL
  16F4'   7C                    	MOV	A,H
  16F5'   B5                    	ORA	L
  16F6'   C2 16FF'              	JNZ	OPA_D1
  16F9'   2A 2EB5'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  16FC'   C3 0000*              	JMP	GOTO		;   to where the span starts
  16FF'                         OPA_D1:
  16FF'   3A 2EA1'              	LDA	PSAVE
  1702'   FE 63                 	CPI	'c'
  1704'   CA 17C0'              	JZ	OPDSPN
  1707'   CD 17A8'              	CALL	SPNBRK
  170A'   D2 172B'              	JNC	OPA_D2
  170D'   2A 2EB7'              	LHLD	OPHI
  1710'   CD 1926'              	CALL	CEND
  1713'   EB                    	XCHG			; DE = the content end of the line it ends in
  1714'   2A 2EB7'              	LHLD	OPHI
  1717'                         OPA_BL:
  1717'   CD 0000*              	CALL	CMP16
  171A'   CA 1731'              	JZ	OPA_BI		; only blanks after it
  171D'   D5                    	PUSH	D
  171E'   E5                    	PUSH	H
  171F'   CD 0000*              	CALL	CHARAT
  1722'   E1                    	POP	H
  1723'   D1                    	POP	D
  1724'   23                    	INX	H
  1725'   CD 1760'              	CALL	BLANKQ
  1728'   CA 1717'              	JZ	OPA_BL
  172B'                         OPA_D2:
  172B'   CD 17C0'              	CALL	OPDSPN
  172E'   C3 1937'              	JMP	CLAMPE
  1731'                         OPA_BI:
  1731'   CD 1743'              	CALL	LOIND
  1734'   C2 172B'              	JNZ	OPA_D2
  1737'   2A 2EB7'              	LHLD	OPHI
  173A'   CD 070F'              	CALL	NLSTART
  173D'   22 2EB7'              	SHLD	OPHI
  1740'   C3 1794'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1743'                         LOIND:
  1743'   2A 2EB5'              	LHLD	OPLO
  1746'   CD 0678'              	CALL	BOL
  1749'                         LI_LP:
  1749'   E5                    	PUSH	H
  174A'   EB                    	XCHG
  174B'   2A 2EB5'              	LHLD	OPLO
  174E'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1751'   E1                    	POP	H
  1752'   C8                    	RZ
  1753'   E5                    	PUSH	H
  1754'   CD 0000*              	CALL	CHARAT
  1757'   E1                    	POP	H
  1758'   23                    	INX	H
  1759'   CD 1760'              	CALL	BLANKQ
  175C'   CA 1749'              	JZ	LI_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  175F'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1760'                         BLANKQ:
  1760'   FE 20                 	CPI	' '
  1762'   C8                    	RZ
  1763'   FE 09                 	CPI	TAB
  1765'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1766'                         OPA_JP:
  1766'   22 2EB7'              	SHLD	OPHI
  1769'                         OPA_C1:
  1769'   CD 17B5'              	CALL	OPSPNL
  176C'   7C                    	MOV	A,H
  176D'   B5                    	ORA	L
  176E'   CA 16F1'              	JZ	OPA_DO		; nothing spanned
  1771'   2A 2EB7'              	LHLD	OPHI
  1774'   CD 0678'              	CALL	BOL
  1777'   EB                    	XCHG
  1778'   2A 2EB7'              	LHLD	OPHI
  177B'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  177E'   C2 16F1'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1781'   CD 1743'              	CALL	LOIND
  1784'   CA 1794'              	JZ	C1_LW		; only blanks before lo: whole lines
  1787'                         C1_CH:
  1787'   2A 2EB7'              	LHLD	OPHI		; back over the line break to the content end
  178A'   2B                    	DCX	H		;   of the line before
  178B'   CD 1926'              	CALL	CEND
  178E'   22 2EB7'              	SHLD	OPHI
  1791'   C3 16F1'              	JMP	OPA_DO
  1794'                         C1_LW:
  1794'   2A 2EB5'              	LHLD	OPLO
  1797'   CD 0678'              	CALL	BOL
  179A'   22 2EB5'              	SHLD	OPLO
  179D'   3A 2EA1'              	LDA	PSAVE
  17A0'   FE 63                 	CPI	'c'
  17A2'   CA 1787'              	JZ	C1_CH
  17A5'   C3 184C'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  17A8'                         SPNBRK:
  17A8'   2A 2EB5'              	LHLD	OPLO
  17AB'   CD 06BB'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  17AE'   EB                    	XCHG			; DE = it
  17AF'   2A 2EB7'              	LHLD	OPHI
  17B2'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  17B5'                         OPSPNL:
  17B5'   2A 2EB7'              	LHLD	OPHI
  17B8'   EB                    	XCHG
  17B9'   2A 2EB5'              	LHLD	OPLO
  17BC'   EB                    	XCHG			; HL = hi, DE = lo
  17BD'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  17C0'                         OPDSPN:
  17C0'   CD 17A8'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  17C3'   F5                    	PUSH	PSW
  17C4'   2A 2EA5'              	LHLD	OPSTA
  17C7'   EB                    	XCHG
  17C8'   2A 2EB5'              	LHLD	OPLO
  17CB'   22 2EBD'              	SHLD	WKI
  17CE'   CD 0000*              	CALL	CMP16
  17D1'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  17D2'   CD 0000*              	CALL	GOTO
  17D5'   CD 17B5'              	CALL	OPSPNL		; HL = hi - lo
  17D8'   CD 0861'              	CALL	SETLIN
  17DB'   F1                    	POP	PSW
  17DC'   CC 18F5'              	CZ	DCHQ
  17DF'   CD 0000*              	CALL	DELFWD
  17E2'   CD 0174'              	CALL	MARKMOD
  17E5'   F1                    	POP	PSW
  17E6'   D0                    	RNC
  17E7'   C3 0898'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  17EA'                         UNDFNB:
  17EA'   CD 0000*              	CALL	CUROFF
  17ED'   E5                    	PUSH	H
  17EE'   CD 0954'              	CALL	FNBLNK
  17F1'   CD 0000*              	CALL	CUROFF
  17F4'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  17F5'   CD 0000*              	CALL	CMP16
  17F8'   D2 0000*              	JNC	UNDHER
  17FB'   EB                    	XCHG
  17FC'   CD 0000*              	CALL	GOTO
  17FF'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1802'                         OPALSP:
  1802'   2A 2EA5'              	LHLD	OPSTA
  1805'   EB                    	XCHG
  1806'   2A 2EA7'              	LHLD	OPEND2
  1809'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  180C'   DA 181C'              	JC	OPAL_F
  180F'   22 2EB5'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1812'   EB                    	XCHG
  1813'   22 2EB7'              	SHLD	OPHI		; hi-src = start
  1816'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1819'   C3 1826'              	JMP	OPAL_R
  181C'                         OPAL_F:
  181C'   EB                    	XCHG			; HL = start
  181D'   22 2EB5'              	SHLD	OPLO		; lo-src = start
  1820'   2A 2EA7'              	LHLD	OPEND2
  1823'   22 2EB7'              	SHLD	OPHI		; hi-src = end
  1826'                         OPAL_R:
  1826'   2A 2EB5'              	LHLD	OPLO
  1829'   CD 0678'              	CALL	BOL
  182C'   22 2EB5'              	SHLD	OPLO		; lo = BOL(low line)
  182F'   2A 2EB7'              	LHLD	OPHI
  1832'   CD 070F'              	CALL	NLSTART
  1835'   22 2EB7'              	SHLD	OPHI		; hi = start of line past the high line
  1838'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1839'                         OPALIN:
  1839'   CD 1802'              	CALL	OPALSP
  183C'   2A 2EB5'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  183F'   CD 070F'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1842'   EB                    	XCHG			;   the column)
  1843'   2A 2EB7'              	LHLD	OPHI
  1846'   CD 0000*              	CALL	CMP16
  1849'   CC 17EA'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  184C'                         OPDLIN:
  184C'   CD 17C0'              	CALL	OPDSPN
  184F'   CD 0762'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1852'   DA 1862'              	JC	OPDL_NB
  1855'   CD 0000*              	CALL	LOGLEN
  1858'   7C                    	MOV	A,H
  1859'   B5                    	ORA	L
  185A'   C8                    	RZ			; empty buffer
  185B'   2B                    	DCX	H
  185C'   CD 0678'              	CALL	BOL
  185F'   CD 0000*              	CALL	GOTO
  1862'                         OPDL_NB:
  1862'   C3 0954'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1865'                         OPCTAB:
  1865'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1869'   62 00 42 00           
  186D'   68 00 6C 00           
  1871'   30 00 5E 00           
  1875'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1877'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  187B'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  187F'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1883'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1887'   24 01                 
  1889'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  188D'   47 02 48 02           
  1891'   4D 02 4C 02           
  1895'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1897'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1899'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  189A'                         VCB_C:
  189A'   CD 18A6'              	CALL	VCB_CD
  189D'   C3 19A8'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  18A0'                         VCB_D:
  18A0'   CD 18A6'              	CALL	VCB_CD
  18A3'   C3 1937'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  18A6'                         VCB_CD:
  18A6'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18A9'   22 2EB5'              	SHLD	OPLO
  18AC'   22 2EA5'              	SHLD	OPSTA
  18AF'   CD 0000*              	CALL	CUROFF
  18B2'   CD 1926'              	CALL	CEND		; to the line's content end, the CR,LF left
  18B5'   22 2EB7'              	SHLD	OPHI
  18B8'   C3 17C0'              	JMP	OPDSPN
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  18BB'                         VC_X:
  18BB'   CD 0A06'              	CALL	GLSTAL
  18BE'   CD 0861'              	CALL	SETLIN
  18C1'   CD 0786'              	CALL	GETCNT
  18C4'   22 2EB9'              	SHLD	CNTV
  18C7'   CD 0000*              	CALL	CUROFF
  18CA'   22 2EBD'              	SHLD	WKI		; cur
  18CD'   CD 1926'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  18D0'   EB                    	XCHG			; DE = contentend
  18D1'   2A 2EBD'              	LHLD	WKI		; HL = cur
  18D4'   EB                    	XCHG			; HL = contentend, DE = cur
  18D5'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  18D8'   7C                    	MOV	A,H
  18D9'   B5                    	ORA	L
  18DA'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  18DB'   EB                    	XCHG			; DE = available
  18DC'   2A 2EB9'              	LHLD	CNTV		; HL = count
  18DF'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  18E2'   DA 18E8'              	JC	VX_USEA
  18E5'   C3 18E9'              	JMP	VX_DEL		; count <= available -> HL = count = del
  18E8'                         VX_USEA:
  18E8'   EB                    	XCHG			; HL = available
  18E9'                         VX_DEL:
  18E9'   CD 18F5'              	CALL	DCHQ
  18EC'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  18EF'   CD 0174'              	CALL	MARKMOD
  18F2'   C3 1937'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  18F5'                         DCHQ:
  18F5'   E5                    	PUSH	H
  18F6'   CD 089E'              	CALL	TAILTAB
  18F9'   E1                    	POP	H
  18FA'   47                    	MOV	B,A
  18FB'   7C                    	MOV	A,H		; (more of them than a byte counts)
  18FC'   B7                    	ORA	A
  18FD'   C0                    	RNZ
  18FE'   B5                    	ORA	L
  18FF'   C8                    	RZ			; (or none at all)
  1900'   32 2E70'              	STA	DCHN
  1903'   78                    	MOV	A,B
  1904'   87                    	ADD	A
  1905'   32 2E71'              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1908'   CA 1920'              	JZ	DQ_0
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  190B'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  190C'   FE 08                 	CPI	8
  190E'   D0                    	RNC
  190F'   E5                    	PUSH	H
  1910'   2A 2EBD'              	LHLD	WKI
  1913'   EB                    	XCHG
  1914'   2A 2EBB'              	LHLD	TTI
  1917'   CD 0000*              	CALL	SUBHD
  191A'   EB                    	XCHG			; DE = the chars before it
  191B'   E1                    	POP	H
  191C'   CD 0000*              	CALL	CMP16
  191F'   D8                    	RC
  1920'                         DQ_0:
  1920'   3E 07                 	MVI	A,R_DCH
  1922'   32 2E6D'              	STA	RINTENT
  1925'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1926'                         CEND:
  1926'   CD 06BB'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1929'   7C                    	MOV	A,H
  192A'   B5                    	ORA	L
  192B'   C8                    	RZ			; the start of the text: nothing before it
  192C'   2B                    	DCX	H
  192D'   E5                    	PUSH	H
  192E'   CD 0000*              	CALL	CHARAT
  1931'   E1                    	POP	H		; HL = term-1
  1932'   FE 0D                 	CPI	CR
  1934'   C8                    	RZ			; a CR before the LF -> the content ends there
  1935'   23                    	INX	H
  1936'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1937'                         CLAMPE:
  1937'   CD 0000*              	CALL	CUROFF
  193A'   E5                    	PUSH	H
  193B'   CD 071E'              	CALL	EOLC
  193E'   D1                    	POP	D		; DE = cur
  193F'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1942'   D8                    	RC
  1943'   C8                    	RZ
  1944'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1947'                         VC_I:
  1947'   CD 0786'              	CALL	GETCNT
  194A'   C3 19A5'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; over a CR would put the text between the CR and its LF.
  194D'                         VC_A:
  194D'   CD 0786'              	CALL	GETCNT
  1950'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1953'   CA 196A'              	JZ	VA_INS
  1956'   EB                    	XCHG			; HL = cur
  1957'   E5                    	PUSH	H
  1958'   CD 0000*              	CALL	CHARAT
  195B'   E1                    	POP	H
  195C'   FE 0A                 	CPI	LF
  195E'   CA 196A'              	JZ	VA_INS		; on the line terminator -> append in place
  1961'   FE 0D                 	CPI	CR
  1963'   CA 196A'              	JZ	VA_INS
  1966'   23                    	INX	H
  1967'   CD 0000*              	CALL	GOTO
  196A'                         VA_INS:
  196A'   C3 19A5'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  196D'                         VCB_A:
  196D'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1970'   CD 071E'              	CALL	EOLC		; HL = last content char (the start when empty)
  1973'   E5                    	PUSH	H
  1974'   CD 0000*              	CALL	CHARAT
  1977'   E1                    	POP	H
  1978'   FE 0D                 	CPI	CR
  197A'   CA 1983'              	JZ	VBA_IN		; an empty line: insert at its start
  197D'   FE 0A                 	CPI	LF
  197F'   CA 1983'              	JZ	VBA_IN
  1982'   23                    	INX	H		; past the last content char
  1983'                         VBA_IN:
  1983'   CD 0000*              	CALL	GOTO
  1986'   C3 19A5'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1989'                         VCB_I:
  1989'   CD 0786'              	CALL	GETCNT
  198C'   CD 0954'              	CALL	FNBLNK
  198F'   CD 0000*              	CALL	CUROFF
  1992'   E5                    	PUSH	H
  1993'   CD 0000*              	CALL	CHARAT
  1996'   E1                    	POP	H
  1997'   FE 20                 	CPI	' '
  1999'   CA 19A1'              	JZ	VBI_SK
  199C'   FE 09                 	CPI	TAB
  199E'   C2 19A5'              	JNZ	SETINM
  19A1'                         VBI_SK:
  19A1'   23                    	INX	H		; blanks only: past the last of them
  19A2'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  19A5'                         SETINM:
  19A5'   CD 085B'              	CALL	SETMOV
  19A8'                         SETINS:
  19A8'   3E 01                 	MVI	A,EM_INS
  19AA'   32 2E68'              	STA	EDMODE
  19AD'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  19AE'                         ATCEND:
  19AE'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19B1'   C8                    	RZ
  19B2'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  19B5'   FE 0D                 	CPI	CR
  19B7'   C8                    	RZ
  19B8'   FE 0A                 	CPI	LF
  19BA'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  19BB'                         OPNBRK:
  19BB'   CD 22E5'              	CALL	PUTBRK
  19BE'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  19C1'   23                    	INX	H
  19C2'   22 0000*              	SHLD	LNDLT
  19C5'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  19C8'                         ENDBRK:
  19C8'   CD 0762'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  19CB'   C0                    	RNZ
  19CC'   CD 19BB'              	CALL	OPNBRK
  19CF'   CD 0000*              	CALL	CUROFF
  19D2'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  19D3'   2B                    	DCX	H		;   line, with its own terminator after it
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19D4'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  19D7'                         VC_O:
  19D7'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19DA'   CD 1926'              	CALL	CEND
  19DD'   CD 0000*              	CALL	GOTO
  19E0'   CD 19BB'              	CALL	OPNBRK
  19E3'   CD 19C8'              	CALL	ENDBRK		; a last line with no line end: the opened line
  19E6'   CD 0883'              	CALL	SETILN		;   needs a terminator of its own to exist
  19E9'   C3 19A8'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  19EC'                         VCB_O:
  19EC'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19EF'   CD 0678'              	CALL	BOL
  19F2'   CD 0000*              	CALL	GOTO
  19F5'   CD 19BB'              	CALL	OPNBRK
  19F8'   CD 0000*              	CALL	CUROFF
  19FB'   2B                    	DCX	H
  19FC'   2B                    	DCX	H
  19FD'   CD 0000*              	CALL	GOTO
  1A00'   CD 0883'              	CALL	SETILN
  1A03'   C3 19A8'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1A06'                         VCB_J:
  1A06'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A09'   CD 1926'              	CALL	CEND		; the join point: this line's content end
  1A0C'   22 2EB5'              	SHLD	OPLO
  1A0F'   CD 0000*              	CALL	CUROFF
  1A12'   CD 070F'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1A15'   E5                    	PUSH	H
  1A16'   CD 0000*              	CALL	LOGLEN
  1A19'   D1                    	POP	D		; DE = that start
  1A1A'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1A1D'   CA 085B'              	JZ	SETMOV
  1A20'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1A21'                         VJ_WS:
  1A21'   E5                    	PUSH	H
  1A22'   CD 0000*              	CALL	LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A25'   D1                    	POP	D		; DE = the scan
  1A26'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1A29'   CA 1A40'              	JZ	VJ_DEL
  1A2C'   EB                    	XCHG			; HL = the scan
  1A2D'   E5                    	PUSH	H
  1A2E'   CD 0000*              	CALL	CHARAT
  1A31'   E1                    	POP	H
  1A32'   FE 20                 	CPI	' '
  1A34'   CA 1A3C'              	JZ	VJ_SKIP
  1A37'   FE 09                 	CPI	TAB
  1A39'   C2 1A40'              	JNZ	VJ_DEL
  1A3C'                         VJ_SKIP:
  1A3C'   23                    	INX	H
  1A3D'   C3 1A21'              	JMP	VJ_WS
  1A40'                         VJ_DEL:
  1A40'   22 2EB7'              	SHLD	OPHI
  1A43'   CD 17C0'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1A46'   CD 0892'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1A49'   CD 0762'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1A4C'   CA 1937'              	JZ	CLAMPE
  1A4F'   CD 076D'              	CALL	CURCHR		; the first char of what was appended
  1A52'   FE 0D                 	CPI	CR
  1A54'   CA 1937'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1A57'   FE 0A                 	CPI	LF
  1A59'   CA 1937'              	JZ	CLAMPE
  1A5C'   FE 29                 	CPI	')'
  1A5E'   CA 1937'              	JZ	CLAMPE		; vim puts no space before a ')'
  1A61'   CD 0000*              	CALL	CUROFF
  1A64'   7C                    	MOV	A,H
  1A65'   B5                    	ORA	L
  1A66'   CA 1A7C'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1A69'   2B                    	DCX	H
  1A6A'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1A6D'   FE 20                 	CPI	' '
  1A6F'   CA 1937'              	JZ	CLAMPE
  1A72'   FE 09                 	CPI	TAB
  1A74'   CA 1937'              	JZ	CLAMPE
  1A77'   FE 0A                 	CPI	LF
  1A79'   CA 1937'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1A7C'                         VJ_SP:
  1A7C'   3E 20                 	MVI	A,' '
  1A7E'   CD 0000*              	CALL	PUTGAP
  1A81'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A84'   2B                    	DCX	H
  1A85'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1A88'                         VC_TILD:
  1A88'   CD 0786'              	CALL	GETCNT
  1A8B'   CD 0861'              	CALL	SETLIN		; only this row changes
  1A8E'   CD 0A06'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A91'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A94'   CA 085B'              	JZ	SETMOV
  1A97'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1A9A'   FE 0D                 	CPI	CR
  1A9C'   CA 085B'              	JZ	SETMOV		; the line's end: nothing to toggle
  1A9F'   FE 0A                 	CPI	LF
  1AA1'   CA 085B'              	JZ	SETMOV
  1AA4'   47                    	MOV	B,A
  1AA5'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1AA7'   FE 41                 	CPI	'A'
  1AA9'   DA 1AB5'              	JC	VT_PUT		; below 'A': no case
  1AAC'   FE 5B                 	CPI	'Z'+1
  1AAE'   D2 1AB5'              	JNC	VT_PUT		; above 'Z': no case
  1AB1'   78                    	MOV	A,B
  1AB2'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1AB4'   47                    	MOV	B,A
  1AB5'                         VT_PUT:
  1AB5'   78                    	MOV	A,B
  1AB6'   32 2EC4'              	STA	VRCH		; the calls below do not preserve B
  1AB9'   CD 0174'              	CALL	MARKMOD
  1ABC'   21 0001               	LXI	H,1
  1ABF'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1AC2'   3A 2EC4'              	LDA	VRCH
  1AC5'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1AC8'   C3 1937'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1ACB'                         VC_R:
  1ACB'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  1ACE'   3E 03                 	MVI	A,PR
  1AD0'   32 2E9E'              	STA	GPEND
  1AD3'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1AD4'                         VR_DO:
  1AD4'   AF                    	XRA	A
  1AD5'   32 2E9E'              	STA	GPEND
  1AD8'   79                    	MOV	A,C
  1AD9'   32 2EC4'              	STA	VRCH		; the calls below do not preserve C
  1ADC'   CD 0861'              	CALL	SETLIN		; only this row changed
  1ADF'   CD 0A06'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1AE2'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1AE5'   CA 085B'              	JZ	SETMOV		; the end of the text: vim does nothing
  1AE8'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1AEB'   FE 0D                 	CPI	CR
  1AED'   CA 085B'              	JZ	SETMOV		; the line's end: nothing to replace
  1AF0'   FE 0A                 	CPI	LF
  1AF2'   CA 085B'              	JZ	SETMOV
  1AF5'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AF7'   CD 0867'              	CALL	SETCEL
  1AFA'   CD 0174'              	CALL	MARKMOD
  1AFD'   21 0001               	LXI	H,1
  1B00'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B03'   3A 2EC4'              	LDA	VRCH
  1B06'   FE 0D                 	CPI	CR
  1B08'   CA 1B15'              	JZ	VR_CR
  1B0B'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1B0E'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B11'   2B                    	DCX	H		;   out, which moves every logical offset
  1B12'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1B15'                         VR_CR:
  1B15'   CD 19BB'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1B18'   CD 19C8'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1B1B'   CD 0883'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1B1E'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1B20'   32 2E73'              	STA	ILABOV
  1B23'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1B24'                         VCB_R:
  1B24'   CD 0786'              	CALL	GETCNT
  1B27'   CD 085B'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1B2A'   21 0000               	LXI	H,0
  1B2D'   22 2EC5'              	SHLD	RPDEL		; nothing of ours to put back yet
  1B30'   22 2EC7'              	SHLD	RPAPP
  1B33'   3E 02                 	MVI	A,EM_REP
  1B35'   32 2E68'              	STA	EDMODE
  1B38'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1B39'                         VC_D:
  1B39'   3E 64                 	MVI	A,'d'
  1B3B'   32 2EA0'              	STA	PENDOP
  1B3E'   C3 085B'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1B41'                         VC_C:
  1B41'   3E 63                 	MVI	A,'c'
  1B43'   32 2EA0'              	STA	PENDOP
  1B46'   C3 085B'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1B49'                         VD_DD:
  1B49'   CD 0A06'              	CALL	GLSTAL
  1B4C'   CD 0786'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B4F'   22 2EB9'              	SHLD	CNTV
  1B52'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1B54'   32 2EA2'              	STA	DDSNG
  1B57'   2B                    	DCX	H
  1B58'   7C                    	MOV	A,H
  1B59'   B5                    	ORA	L
  1B5A'   C2 1B68'              	JNZ	VDD_LS
  1B5D'   3E 01                 	MVI	A,1
  1B5F'   32 2EA2'              	STA	DDSNG
  1B62'   CD 17EA'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1B65'   C3 1B6E'              	JMP	VDD_GO
  1B68'                         VDD_LS:
  1B68'   CD 09BF'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1B6B'   DA 085B'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1B6E'                         VDD_GO:
  1B6E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1B71'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1B74'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1B77'   CD 2548'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1B7A'   CD 093D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1B7D'   2A 2EB9'              	LHLD	CNTV
  1B80'   CD 0000*              	CALL	SETC0
  1B83'                         VDD_FW:
  1B83'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1B86'   DA 1CD4'              	JC	QREFUS		; ... which has no room for them
  1B89'   CD 079B'              	CALL	CNTTST
  1B8C'   C2 1B83'              	JNZ	VDD_FW
  1B8F'   CD 0174'              	CALL	MARKMOD
  1B92'   CD 0B3D'              	CALL	ATEOF
  1B95'   D2 1BB0'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1B98'   3E 00                 	MVI	A,0
  1B9A'   32 2EA2'              	STA	DDSNG		; deleted to the end: full repaint
  1B9D'   CD 121D'              	CALL	ONFST
  1BA0'   CA 0954'              	JZ	FNBLNK		; nothing left before it
  1BA3'   21 0001               	LXI	H,1		; onto the new last line
  1BA6'   CD 0000*              	CALL	SETBWD
  1BA9'   2A 0000*              	LHLD	LNDLT
  1BAC'   2B                    	DCX	H
  1BAD'   22 0000*              	SHLD	LNDLT
  1BB0'                         VDD_UP:
  1BB0'   CD 0954'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1BB3'   3A 2EA2'              	LDA	DDSNG
  1BB6'   B7                    	ORA	A
  1BB7'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1BB8'   3E 03                 	MVI	A,R_DLIN
  1BBA'   32 2E6D'              	STA	RINTENT
  1BBD'   C9                    	RET
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1BBE'                         QEMPTY:
  1BBE'   2A 0000*              	LHLD	QBEG
  1BC1'   EB                    	XCHG
  1BC2'   2A 0000*              	LHLD	QEND
  1BC5'   7C                    	MOV	A,H
  1BC6'   BA                    	CMP	D
  1BC7'   C0                    	RNZ
  1BC8'   7D                    	MOV	A,L
  1BC9'   BB                    	CMP	E
  1BCA'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1BCB'                         VC_Y:
  1BCB'   3E 79                 	MVI	A,'y'
  1BCD'   32 2EA0'              	STA	PENDOP
  1BD0'   C3 085B'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1BD3'                         VY_YY:
  1BD3'   21 2EA9'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1BD6'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1BD9'   CD 0000*              	CALL	CUROFF
  1BDC'   22 2EE8'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1BDF'   CD 0678'              	CALL	BOL
  1BE2'   22 2EEA'              	SHLD	YPT		; where the lines come from, to put them back
  1BE5'   CD 1D3A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1BE8'   CD 1D7D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1BEB'   D2 1D41'              	JNC	YNDONE
  1BEE'   21 1B49'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1BF1'   C3 1C1D'              	JMP	YKGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1BF4'                         OPYANK:
  1BF4'   CD 1802'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1BF7'   2A 2EA5'              	LHLD	OPSTA
  1BFA'   EB                    	XCHG			; DE = start
  1BFB'   2A 2EA7'              	LHLD	OPEND2		; HL = end
  1BFE'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1C01'   D2 1C05'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1C04'   EB                    	XCHG			; ... otherwise the start is
  1C05'                         OPY_LO:
  1C05'   22 2EE8'              	SHLD	YOFF
  1C08'   2A 2EB5'              	LHLD	OPLO
  1C0B'   22 2EEA'              	SHLD	YPT		; where the lines come from, to put them back
  1C0E'   CD 1D3A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C11'   CD 1DF5'              	CALL	YNSPAN		; copied where they lie, if there is room
  1C14'   D2 1D41'              	JNC	YNDONE
  1C17'   21 1CFB'              	LXI	H,YSPAN
  1C1A'   C3 1C1D'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1C1D'                         YKGO:
  1C1D'   22 2F12'              	SHLD	YACT
  1C20'   2A 2EEA'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1C23'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1C24'   2A 2EE8'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1C27'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1C2A'   22 2F18'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1C2D'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1C30'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1C31'   2A 2EEA'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1C34'   EB                    	XCHG			;   window as it was, then names other text
  1C35'   E1                    	POP	H
  1C36'   CD 0000*              	CALL	SUBHD
  1C39'   EB                    	XCHG			; DE = how far behind the cursor they start
  1C3A'   CD 12EA'              	CALL	CURFP
  1C3D'   06 00                 	MVI	B,0
  1C3F'   CD 12E0'              	CALL	SUB24
  1C42'   22 2F1A'              	SHLD	YPFP
  1C45'   32 2F1C'              	STA	YPFP+2
  1C48'   3A 2E6C'              	LDA	MODF
  1C4B'   32 2EE5'              	STA	YMODF
  1C4E'   3A 2E93'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1C51'   32 2EE6'              	STA	YDCHG		;   a yank must not become the last change
  1C54'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1C57'   32 2EE7'              	STA	YURPL		;   back are not a change to undo either
  1C5A'   3E 01                 	MVI	A,1
  1C5C'   32 0000*              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C5F'   32 2F11'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1C62'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1C65'   22 2EF4'              	SHLD	YLDLT
  1C68'   CD 0000*              	CALL	LOGLEN
  1C6B'   22 2F16'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1C6E'   2A 2F12'              	LHLD	YACT
  1C71'   CD 1CD3'              	CALL	YCALL		; the lines out of the file, into the register
  1C74'   3A 2EE0'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1C77'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1C79'   CA 1CB7'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1C7C'   CD 0000*              	CALL	LOGLEN
  1C7F'   EB                    	XCHG
  1C80'   2A 2F16'              	LHLD	YWAS
  1C83'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1C86'   CA 1C98'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1C89'   21 2F1A'              	LXI	H,YPFP		; back to where they came from, by its place in
  1C8C'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1C8F'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1C92'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1C95'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1C98'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1C98'   2A 2F1A'              	LHLD	YPFP		;   cursor is still owed its place)
  1C9B'   EB                    	XCHG
  1C9C'   2A 2F18'              	LHLD	YCOL
  1C9F'   19                    	DAD	D
  1CA0'   22 2F0D'              	SHLD	MKPOS
  1CA3'   3A 2F1C'              	LDA	YPFP+2
  1CA6'   CE 00                 	ACI	0
  1CA8'   32 2F0F'              	STA	MKPOS+2
  1CAB'   CD 03A9'              	CALL	MKPAGE
  1CAE'   CD 0000*              	CALL	GOTO
  1CB1'                         YK_RST:
  1CB1'   2A 2EF4'              	LHLD	YLDLT
  1CB4'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1CB7'                         YK_RF:
  1CB7'   3A 2EE5'              	LDA	YMODF
  1CBA'   32 2E6C'              	STA	MODF
  1CBD'   3A 2EE6'              	LDA	YDCHG
  1CC0'   32 2E93'              	STA	DOTCHG
  1CC3'   3A 2EE7'              	LDA	YURPL
  1CC6'   32 0000*              	STA	UNDRPL
  1CC9'   AF                    	XRA	A
  1CCA'   32 2F11'              	STA	MKHOLD
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CCD'   CD 0A06'              	CALL	GLSTAL
  1CD0'   C3 0898'              	JMP	SETFUL		; the cheap paint cannot carry this
  1CD3'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1CD4'                         QREFUS:
  1CD4'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1CD7'   CD 1BBE'              	CALL	QEMPTY
  1CDA'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1CDD'   CD 0000*              	CALL	QKILL
  1CE0'   3A 2F11'              	LDA	MKHOLD
  1CE3'   B7                    	ORA	A
  1CE4'   C2 1CF3'              	JNZ	QRF_Y
  1CE7'   21 0000*              	LXI	H,MKSAV
  1CEA'   11 0000*              	LXI	D,MKTAB
  1CED'   CD 2548'              	CALL	COPY12
  1CF0'   CD 0000*              	CALL	UNDCLR
  1CF3'                         QRF_Y:
  1CF3'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1CF5'   32 2EE0'              	STA	MSGWHT
  1CF8'   C3 1601'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1CFB'                         YSPAN:
  1CFB'   CD 0A06'              	CALL	GLSTAL
  1CFE'   CD 17B5'              	CALL	OPSPNL		; HL = the span's length
  1D01'   22 2F14'              	SHLD	YTGT
  1D04'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1D07'   EB                    	XCHG			; DE = it
  1D08'   2A 2F14'              	LHLD	YTGT
  1D0B'   EB                    	XCHG			; HL = the text's, DE = the span's
  1D0C'   CD 0000*              	CALL	SUBHD
  1D0F'   22 2F14'              	SHLD	YTGT		; what the text is left at when the span is out
  1D12'   2A 2EB5'              	LHLD	OPLO
  1D15'   CD 0000*              	CALL	GOTO
  1D18'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D1B'                         YS_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D1B'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1D1E'   CD 0000*              	CALL	SETC0
  1D21'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1D24'   DA 1CD4'              	JC	QREFUS		; ... which has no room for it
  1D27'   CD 0000*              	CALL	LOGLEN
  1D2A'   EB                    	XCHG			; DE = what is left
  1D2B'   2A 2F14'              	LHLD	YTGT
  1D2E'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1D31'   DA 1D37'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1D34'   C2 1D1B'              	JNZ	YS_LP		;   but never spin here if it ever did
  1D37'                         YS_END:
  1D37'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1D3A'                         YNPRE:
  1D3A'   2A 0000*              	LHLD	PGTOPM
  1D3D'   22 2F1D'              	SHLD	YNPG
  1D40'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1D41'                         YNDONE:
  1D41'   2A 2EE8'              	LHLD	YOFF
  1D44'   CD 0000*              	CALL	GOTO
  1D47'   2A 0000*              	LHLD	PGTOPM
  1D4A'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D4B'   2A 2F1D'              	LHLD	YNPG
  1D4E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1D51'   C2 0898'              	JNZ	SETFUL		; it moved under us: repaint after all
  1D54'   C3 085B'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1D57'                         YNROOM:
  1D57'   11 0100               	LXI	D,100H
  1D5A'   19                    	DAD	D
  1D5B'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1D5C'   E5                    	PUSH	H		; the span plus its slack
  1D5D'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1D60'   EB                    	XCHG			; HL = free
  1D61'   D1                    	POP	D		; DE = the span plus its slack
  1D62'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1D65'   DA 1D6D'              	JC	YNR_OK
  1D68'   CA 1D6D'              	JZ	YNR_OK
  1D6B'   37                    	STC			; not enough: the delete-and-put-back path
  1D6C'   C9                    	RET
  1D6D'                         YNR_OK:
  1D6D'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1D6E'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1D6F'                         YNGO:
  1D6F'   C5                    	PUSH	B
  1D70'   CD 0786'              	CALL	GETCNT		; spent here: this yank is happening
  1D73'   CD 0A06'              	CALL	GLSTAL
  1D76'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1D79'   C1                    	POP	B
  1D7A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1D7D'                         YNCOPY:
  1D7D'   2A 2E69'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1D80'   7C                    	MOV	A,H		;   the count itself
  1D81'   B5                    	ORA	L
  1D82'   C2 1D88'              	JNZ	YNC_HV
  1D85'   21 0001               	LXI	H,1
  1D88'                         YNC_HV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1D88'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1D89'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1D8A'   B4                    	ORA	H
  1D8B'   CA 1D96'              	JZ	YNC_M
  1D8E'   E5                    	PUSH	H
  1D8F'   CD 09BF'              	CALL	ONLAST		; vim: a count over one on the last line does
  1D92'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1D93'   DA 1DA8'              	JC	YNC_RF
  1D96'                         YNC_M:
  1D96'   E5                    	PUSH	H
  1D97'   CD 093D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1D9A'   E1                    	POP	H
  1D9B'   CD 1DB0'              	CALL	YNLINE		; BC = the span, measured where it stands
  1D9E'   D8                    	RC			; not measurable here: let the pager answer it
  1D9F'   60                    	MOV	H,B
  1DA0'   69                    	MOV	L,C
  1DA1'   CD 1D57'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1DA4'   D8                    	RC			; no: the delete-and-put-back path
  1DA5'   C3 1D6F'              	JMP	YNGO
  1DA8'                         YNC_RF:
  1DA8'   CD 0786'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1DAB'   CD 0A06'              	CALL	GLSTAL		;   register alone, and that is the command
  1DAE'   B7                    	ORA	A		; NC: done
  1DAF'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1DB0'                         YNLINE:
  1DB0'   22 2F1F'              	SHLD	YNCNT		; the lines it still wants
  1DB3'   2A 0000*              	LHLD	GAPEND
  1DB6'                         YNL_LP:
  1DB6'   EB                    	XCHG			; DE = the scan
  1DB7'   2A 0000*              	LHLD	TXTEND
  1DBA'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1DBD'   EB                    	XCHG			; HL = the scan
  1DBE'   D2 1DDE'              	JNC	YNL_EN		; the resident text ran out
  1DC1'   7E                    	MOV	A,M
  1DC2'   23                    	INX	H
  1DC3'   FE 0A                 	CPI	LF
  1DC5'   C2 1DB6'              	JNZ	YNL_LP
  1DC8'   E5                    	PUSH	H
  1DC9'   2A 2F1F'              	LHLD	YNCNT
  1DCC'   2B                    	DCX	H
  1DCD'   22 2F1F'              	SHLD	YNCNT
  1DD0'   7C                    	MOV	A,H
  1DD1'   B5                    	ORA	L
  1DD2'   E1                    	POP	H
  1DD3'   C2 1DB6'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1DD6'   EB                    	XCHG			; DE = past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1DD7'   2A 0000*              	LHLD	GAPEND
  1DDA'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1DDB'   C3 1DEC'              	JMP	YNL_BC
  1DDE'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1DDE'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1DE1'   C2 1DF3'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1DE4'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1DE7'   EB                    	XCHG			;   count clamps to it as vim's does
  1DE8'   2A 0000*              	LHLD	GAPEND
  1DEB'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1DEC'                         YNL_BC:
  1DEC'   CD 0000*              	CALL	SUBHD		; HL = the span
  1DEF'   44                    	MOV	B,H
  1DF0'   4D                    	MOV	C,L
  1DF1'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1DF2'   C9                    	RET
  1DF3'                         YNL_NO:
  1DF3'   37                    	STC
  1DF4'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1DF5'                         YNSPAN:
  1DF5'   CD 17B5'              	CALL	OPSPNL		; HL = the span's length
  1DF8'   44                    	MOV	B,H
  1DF9'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1DFA'   CD 1D57'              	CALL	YNROOM
  1DFD'   D8                    	RC			; no room: the delete-and-put-back path
  1DFE'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1DFF'   2A 2EB5'              	LHLD	OPLO
  1E02'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1E05'   C1                    	POP	B
  1E06'   C3 1D6F'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1E09'                         VC_P:
  1E09'   CD 1BBE'              	CALL	QEMPTY
  1E0C'   CA 1EDF'              	JZ	VP_BEL
  1E0F'   CD 0786'              	CALL	GETCNT
  1E12'   22 2EEC'              	SHLD	PCNT
  1E15'   CD 0000*              	CALL	CUROFF
  1E18'   CD 070F'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1E1B'   C3 1E30'              	JMP	VP_GO
  1E1E'                         VCB_P:
  1E1E'   CD 1BBE'              	CALL	QEMPTY
  1E21'   CA 1EDF'              	JZ	VP_BEL
  1E24'   CD 0786'              	CALL	GETCNT
  1E27'   22 2EEC'              	SHLD	PCNT
  1E2A'   CD 0000*              	CALL	CUROFF
  1E2D'   CD 0678'              	CALL	BOL
  1E30'                         VP_GO:
  1E30'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1E33'   CD 0000*              	CALL	CUROFF
  1E36'   EB                    	XCHG
  1E37'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1E3A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1E3D'   DA 1E52'              	JC	VP_IN
  1E40'   EB                    	XCHG			; HL = the put point = LOGLEN
  1E41'   7C                    	MOV	A,H
  1E42'   B5                    	ORA	L
  1E43'   CA 1E4F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1E46'   2B                    	DCX	H
  1E47'   CD 0000*              	CALL	CHARAT
  1E4A'   FE 0A                 	CPI	LF
  1E4C'   CA 1E52'              	JZ	VP_IN
  1E4F'                         VP_BRK:
  1E4F'   CD 19BB'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1E52'                         VP_IN:
  1E52'   21 2EEE'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1E55'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1E58'   CD 1333'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1E5B'   2A 0000*              	LHLD	QBEG
  1E5E'   EB                    	XCHG
  1E5F'   2A 0000*              	LHLD	QEND
  1E62'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1E65'   EB                    	XCHG
  1E66'   22 2EF1'              	SHLD	PLFS
  1E69'   2A 2EEC'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1E6C'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1E6D'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1E6E'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1E70'   C2 1E74'              	JNZ	VP_PZ
  1E73'   7D                    	MOV	A,L
  1E74'                         VP_PZ:
  1E74'   32 2EF3'              	STA	PCPY
  1E77'                         VP_LP:
  1E77'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1E7A'   2A 0000*              	LHLD	LNDLT
  1E7D'   EB                    	XCHG
  1E7E'   2A 2EF1'              	LHLD	PLFS
  1E81'   19                    	DAD	D
  1E82'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1E85'   2A 2EEC'              	LHLD	PCNT
  1E88'   2B                    	DCX	H
  1E89'   22 2EEC'              	SHLD	PCNT
  1E8C'   7C                    	MOV	A,H
  1E8D'   B5                    	ORA	L
  1E8E'   C2 1E77'              	JNZ	VP_LP
  1E91'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E94'   21 2EEE'              	LXI	H,PPFP
  1E97'   CD 03DC'              	CALL	MKLOAD
  1E9A'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1E9D'   D2 1ED0'              	JNC	VP_PGD
  1EA0'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1EA3'   CD 0A06'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1EA6'   3A 2EF3'              	LDA	PCPY
  1EA9'   B7                    	ORA	A
  1EAA'   CA 0954'              	JZ	FNBLNK
  1EAD'   2A 2EF1'              	LHLD	PLFS
  1EB0'   7C                    	MOV	A,H
  1EB1'   B7                    	ORA	A
  1EB2'   C2 0954'              	JNZ	FNBLNK
  1EB5'   3A 2EF3'              	LDA	PCPY
  1EB8'   CD 0FE5'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1EBB'   7C                    	MOV	A,H
  1EBC'   B7                    	ORA	A
  1EBD'   C2 0954'              	JNZ	FNBLNK
  1EC0'   7D                    	MOV	A,L
  1EC1'   B7                    	ORA	A
  1EC2'   CA 0954'              	JZ	FNBLNK
  1EC5'   F5                    	PUSH	PSW
  1EC6'   CD 0883'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1EC9'   F1                    	POP	PSW
  1ECA'   32 2E6E'              	STA	ILN		; ... which the lines put now replace
  1ECD'   C3 0954'              	JMP	FNBLNK
  1ED0'                         VP_PGD:				; the put paged its first line out: page back
  1ED0'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1ED3'   CD 0000*              	CALL	GOTO
  1ED6'   CD 0A06'              	CALL	GLSTAL
  1ED9'   CD 134B'              	CALL	GPLACE
  1EDC'   C3 0898'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1EDF'                         VP_BEL:
  1EDF'   CD 0786'              	CALL	GETCNT		; the count is spent either way
  1EE2'   0E 07                 	MVI	C,BEL
  1EE4'   CD 0000*              	CALL	BCONOU
  1EE7'   C3 085B'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1EEA'                         VIREP:
  1EEA'   79                    	MOV	A,C
  1EEB'   FE 1B                 	CPI	ESC
  1EED'   CA 2040'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1EF0'   FE 0D                 	CPI	CR
  1EF2'   CA 1F65'              	JZ	VP_CR
  1EF5'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1EF7'   CA 1F65'              	JZ	VP_CR
  1EFA'   FE 08                 	CPI	BS
  1EFC'   CA 1F71'              	JZ	VP_BS
  1EFF'   FE 7F                 	CPI	DEL
  1F01'   CA 1F71'              	JZ	VP_BS
  1F04'   32 2EC4'              	STA	VRCH		; the calls below do not preserve C
  1F07'   CD 0861'              	CALL	SETLIN		; this row changed
  1F0A'   CD 0174'              	CALL	MARKMOD
  1F0D'   CD 19AE'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1F10'   CA 1F50'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1F13'   CD 076D'              	CALL	CURCHR
  1F16'   06 01                 	MVI	B,1
  1F18'   CD 0867'              	CALL	SETCEL
  1F1B'   3A 2EC4'              	LDA	VRCH
  1F1E'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1F21'   2A 2EC5'              	LHLD	RPDEL
  1F24'   7C                    	MOV	A,H
  1F25'   B5                    	ORA	L
  1F26'   CA 1F3C'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1F29'   2A 0000*              	LHLD	GAPEND
  1F2C'   EB                    	XCHG
  1F2D'   2A 2EC9'              	LHLD	RPGE
  1F30'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1F33'   CA 1F3C'              	JZ	VP_OVW
  1F36'   21 0000               	LXI	H,0
  1F39'   22 2EC5'              	SHLD	RPDEL		; the text moved: those originals are gone
  1F3C'                         VP_OVW:
  1F3C'   21 0001               	LXI	H,1
  1F3F'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1F42'   2A 0000*              	LHLD	GAPEND
  1F45'   22 2EC9'              	SHLD	RPGE
  1F48'   2A 2EC5'              	LHLD	RPDEL
  1F4B'   23                    	INX	H
  1F4C'   22 2EC5'              	SHLD	RPDEL
  1F4F'   C9                    	RET
  1F50'                         VP_APP:
  1F50'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1F52'   06 01                 	MVI	B,1
  1F54'   CD 0867'              	CALL	SETCEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F57'   3A 2EC4'              	LDA	VRCH
  1F5A'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1F5D'   2A 2EC7'              	LHLD	RPAPP
  1F60'   23                    	INX	H
  1F61'   22 2EC7'              	SHLD	RPAPP
  1F64'   C9                    	RET
  1F65'                         VP_CR:
  1F65'   21 0000               	LXI	H,0
  1F68'   22 2EC5'              	SHLD	RPDEL		; a line break ends what BS can put back
  1F6B'   22 2EC7'              	SHLD	RPAPP
  1F6E'   C3 1FFC'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1F71'                         VP_BS:
  1F71'   2A 2EC7'              	LHLD	RPAPP
  1F74'   7C                    	MOV	A,H
  1F75'   B5                    	ORA	L
  1F76'   CA 1F83'              	JZ	VP_BSD
  1F79'   2B                    	DCX	H
  1F7A'   22 2EC7'              	SHLD	RPAPP		; an appended char: it just goes
  1F7D'   CD 0861'              	CALL	SETLIN
  1F80'   C3 0000*              	JMP	DELPRV
  1F83'                         VP_BSD:
  1F83'   2A 2EC5'              	LHLD	RPDEL
  1F86'   7C                    	MOV	A,H
  1F87'   B5                    	ORA	L
  1F88'   CA 1FAF'              	JZ	VP_BSM		; nothing of ours left
  1F8B'   2A 0000*              	LHLD	GAPEND
  1F8E'   EB                    	XCHG
  1F8F'   2A 2EC9'              	LHLD	RPGE
  1F92'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1F95'   C2 1FAF'              	JNZ	VP_BSM
  1F98'   2A 2EC5'              	LHLD	RPDEL
  1F9B'   2B                    	DCX	H
  1F9C'   22 2EC5'              	SHLD	RPDEL
  1F9F'   CD 0861'              	CALL	SETLIN
  1FA2'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1FA5'   CD 0000*              	CALL	UNDELF		; the original comes back
  1FA8'   2A 0000*              	LHLD	GAPEND
  1FAB'   22 2EC9'              	SHLD	RPGE
  1FAE'   C9                    	RET
  1FAF'                         VP_BSM:
  1FAF'   CD 085B'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1FB2'   C3 08E9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1FB5'                         VIINS:
  1FB5'   79                    	MOV	A,C
  1FB6'   FE 1B                 	CPI	ESC
  1FB8'   CA 2040'              	JZ	VI_ESC
  1FBB'   FE 0D                 	CPI	CR
  1FBD'   CA 1FFC'              	JZ	VI_CR
  1FC0'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1FC2'   CA 1FFC'              	JZ	VI_CR
  1FC5'   FE 08                 	CPI	BS
  1FC7'   CA 2014'              	JZ	VI_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FCA'   FE 7F                 	CPI	DEL
  1FCC'   CA 2014'              	JZ	VI_BS
  1FCF'   79                    	MOV	A,C
  1FD0'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1FD3'   CD 0174'              	CALL	MARKMOD
  1FD6'   CD 0861'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  1FD9'   79                    	MOV	A,C
  1FDA'   FE 20                 	CPI	' '
  1FDC'   D8                    	RC			; control char -> keep R_LINE
  1FDD'   FE 7F                 	CPI	DEL
  1FDF'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1FE0'   CD 089E'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1FE3'   47                    	MOV	B,A
  1FE4'   3E 04                 	MVI	A,R_ICH
  1FE6'   32 2E6D'              	STA	RINTENT
  1FE9'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  1FEB'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  1FEC'   CA 1FF8'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1FEF'   CD 19AE'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1FF2'   3E 00                 	MVI	A,0
  1FF4'   C2 1FF8'              	JNZ	VI_ICH
  1FF7'   3C                    	INR	A
  1FF8'                         VI_ICH:
  1FF8'   32 2E6F'              	STA	ICHAPP
  1FFB'   C9                    	RET
  1FFC'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1FFC'   CD 19AE'              	CALL	ATCEND
  1FFF'   3E 00                 	MVI	A,0
  2001'   CA 2005'              	JZ	VI_CRS
  2004'   3C                    	INR	A
  2005'                         VI_CRS:
  2005'   F5                    	PUSH	PSW
  2006'   CD 19BB'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  2009'   CD 19C8'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  200C'   CD 0883'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  200F'   F1                    	POP	PSW
  2010'   32 2E73'              	STA	ILABOV
  2013'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  2014'                         VI_BS:
  2014'   CD 0000*              	CALL	PEEKL
  2017'   D8                    	RC			; start of the file: nothing to delete
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2018'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  201A'   CA 203A'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  201D'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  201E'   CD 0861'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2021'   78                    	MOV	A,B
  2022'   CD 087C'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  2025'   D2 203A'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  2028'   CD 089E'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  202B'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  202C'   3C                    	INR	A
  202D'   32 2E71'              	STA	DCHBS		; 1, and 2 with it for the TAB
  2030'   3E 01                 	MVI	A,1
  2032'   32 2E70'              	STA	DCHN
  2035'   3E 07                 	MVI	A,R_DCH
  2037'   32 2E6D'              	STA	RINTENT
  203A'                         VI_BSJ:
  203A'   CD 0174'              	CALL	MARKMOD
  203D'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2040'                         VI_ESC:
  2040'   3E 00                 	MVI	A,EM_CMD
  2042'   32 2E68'              	STA	EDMODE
  2045'   CD 085B'              	CALL	SETMOV
  2048'   CD 08E9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  204B'   C3 0A06'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  204E'                         RDLINE:
  204E'   EB                    	XCHG			; HL = buffer
  204F'   22 2ECB'              	SHLD	RLPTR
  2052'   3E 00                 	MVI	A,0
  2054'   32 2ECD'              	STA	RLLEN
  2057'   78                    	MOV	A,B
  2058'   32 2ECE'              	STA	RLMAX
  205B'   79                    	MOV	A,C
  205C'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  205F'                         RL_LP:
  205F'   CD 0000*              	CALL	GETKEY
  2062'   FE 1B                 	CPI	ESC
  2064'   CA 20B4'              	JZ	RL_CAN
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2067'   FE 0D                 	CPI	CR
  2069'   CA 20BF'              	JZ	RL_DONE
  206C'   FE 08                 	CPI	BS
  206E'   CA 209C'              	JZ	RL_BS
  2071'   FE 7F                 	CPI	DEL
  2073'   CA 209C'              	JZ	RL_BS
  2076'   FE 20                 	CPI	' '
  2078'   DA 205F'              	JC	RL_LP		; control char -> ignore
  207B'   3A 2ECD'              	LDA	RLLEN
  207E'   47                    	MOV	B,A
  207F'   3A 2ECE'              	LDA	RLMAX
  2082'   B8                    	CMP	B
  2083'   CA 205F'              	JZ	RL_LP		; full -> ignore
  2086'   2A 2ECB'              	LHLD	RLPTR
  2089'   71                    	MOV	M,C
  208A'   23                    	INX	H
  208B'   22 2ECB'              	SHLD	RLPTR
  208E'   3A 2ECD'              	LDA	RLLEN
  2091'   3C                    	INR	A
  2092'   32 2ECD'              	STA	RLLEN
  2095'   79                    	MOV	A,C
  2096'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2099'   C3 205F'              	JMP	RL_LP
  209C'                         RL_BS:				; WM LINEPOP
  209C'   3A 2ECD'              	LDA	RLLEN
  209F'   B7                    	ORA	A
  20A0'   CA 20B4'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  20A3'   3D                    	DCR	A
  20A4'   32 2ECD'              	STA	RLLEN
  20A7'   2A 2ECB'              	LHLD	RLPTR
  20AA'   2B                    	DCX	H
  20AB'   22 2ECB'              	SHLD	RLPTR
  20AE'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  20B1'   C3 205F'              	JMP	RL_LP
  20B4'                         RL_CAN:
  20B4'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  20B6'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  20B9'   CD 0861'              	CALL	SETLIN		; redraw one row
  20BC'   3E FF                 	MVI	A,0FFH		; cancelled
  20BE'   C9                    	RET
  20BF'                         RL_DONE:
  20BF'   AF                    	XRA	A
  20C0'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  20C1'                         VC_BZ:
  20C1'   CD 085B'              	CALL	SETMOV
  20C4'   3A 2E9F'              	LDA	GSAVE
  20C7'   FE 02                 	CPI	PZ
  20C9'   CA 20D4'              	JZ	VZ_ZZ
  20CC'   B7                    	ORA	A
  20CD'   C0                    	RNZ			; 'g' was pending: vim drops both
  20CE'   3E 02                 	MVI	A,PZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20D0'   32 2E9E'              	STA	GPEND
  20D3'   C9                    	RET
  20D4'                         VZ_ZZ:
  20D4'   3E 04                 	MVI	A,EO_X
  20D6'   32 2ECF'              	STA	EXOP
  20D9'   3E 01                 	MVI	A,1
  20DB'   32 2EE2'              	STA	EXBANG		; no '!'
  20DE'   AF                    	XRA	A
  20DF'   32 2ED0'              	STA	EXARG		; no file name
  20E2'   3A 2E6C'              	LDA	MODF		; as ':x': a changed text is written first
  20E5'   B7                    	ORA	A
  20E6'   CA 2227'              	JZ	EX_Q
  20E9'   C3 21C1'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  20EC'                         VC_EX:
  20EC'   CD 0786'              	CALL	GETCNT
  20EF'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  20F2'   11 0000*              	LXI	D,EXBUF
  20F5'   06 28                 	MVI	B,EXMAX
  20F7'   0E 3A                 	MVI	C,':'
  20F9'   CD 204E'              	CALL	RDLINE
  20FC'   B7                    	ORA	A
  20FD'   C0                    	RNZ			; cancelled
  20FE'   3A 2ECD'              	LDA	RLLEN
  2101'   5F                    	MOV	E,A
  2102'   16 00                 	MVI	D,0
  2104'   21 0000*              	LXI	H,EXBUF
  2107'   19                    	DAD	D
  2108'   36 00                 	MVI	M,0		; the line ends with a 0
  210A'   21 0000*              	LXI	H,EXBUF
  210D'   CD 26D9'              	CALL	SKIPB
  2110'   C8                    	RZ			; nothing on it
  2111'   22 2ED2'              	SHLD	EXCMD
  2114'   CD 28DD'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  2117'   CD 26D9'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  211A'   56                    	MOV	D,M
  211B'   23                    	INX	H
  211C'   1E 00                 	MVI	E,0
  211E'   CD 26E5'              	CALL	ISLOW
  2121'   DA 212C'              	JC	EX_LK
  2124'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2125'   23                    	INX	H
  2126'   CD 26E5'              	CALL	ISLOW
  2129'   D2 2145'              	JNC	EX_NOT		; a third letter: none of ours
  212C'                         EX_LK:
  212C'   E5                    	PUSH	H
  212D'   21 28C4'              	LXI	H,EXTAB
  2130'                         EX_TL:
  2130'   7E                    	MOV	A,M
  2131'   B7                    	ORA	A
  2132'   CA 2144'              	JZ	EX_NTP		; not in the table
  2135'   23                    	INX	H
  2136'   BA                    	CMP	D
  2137'   7E                    	MOV	A,M
  2138'   23                    	INX	H
  2139'   C2 2140'              	JNZ	EX_TN
  213C'   BB                    	CMP	E
  213D'   CA 214B'              	JZ	EX_TF
  2140'                         EX_TN:
  2140'   23                    	INX	H
  2141'   C3 2130'              	JMP	EX_TL
  2144'                         EX_NTP:
  2144'   E1                    	POP	H
  2145'                         EX_NOT:
  2145'   21 279D'              	LXI	H,SNOT
  2148'   C3 271A'              	JMP	EXERT
  214B'                         EX_TF:
  214B'   7E                    	MOV	A,M
  214C'   32 2ECF'              	STA	EXOP
  214F'   E1                    	POP	H
  2150'   FE 06                 	CPI	EO_S
  2152'   CA 294C'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2155'   FE 01                 	CPI	EO_W
  2157'   CA 2166'              	JZ	EX_RG		; ':N,Mw name' takes a range
  215A'   FE 08                 	CPI	EO_R
  215C'   CA 2166'              	JZ	EX_RG		; ... and ':Nr name' a line
  215F'   3A 2F2B'              	LDA	SRNGF
  2162'   B7                    	ORA	A
  2163'   C2 2145'              	JNZ	EX_NOT		; a range on a command that does not take one
  2166'                         EX_RG:
                                	;--- '!', then the file name ---
  2166'   7E                    	MOV	A,M
  2167'   D6 21                 	SUI	'!'
  2169'   32 2EE2'              	STA	EXBANG		; 0 = '!'
  216C'   C2 2170'              	JNZ	EX_NB
  216F'   23                    	INX	H
  2170'                         EX_NB:
  2170'   CD 26D9'              	CALL	SKIPB
  2173'   32 2ED0'              	STA	EXARG		; 0 = no file name
  2176'   CA 218F'              	JZ	EX_RUN
  2179'   22 2ED2'              	SHLD	EXCMD
  217C'   3A 2ECF'              	LDA	EXOP
  217F'   FE 02                 	CPI	EO_Q
  2181'   CA 2717'              	JZ	EX_TRL		; :q takes none
  2184'   FE 07                 	CPI	EO_V
  2186'   CA 2717'              	JZ	EX_TRL		; nor :ve
  2189'   CD 2643'              	CALL	PARSFN
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  218C'   C2 270B'              	JNZ	EX_INV
  218F'                         EX_RUN:
  218F'   3A 2ECF'              	LDA	EXOP
  2192'   FE 05                 	CPI	EO_E
  2194'   CA 223E'              	JZ	EX_E
  2197'   FE 02                 	CPI	EO_Q
  2199'   CA 2227'              	JZ	EX_Q
  219C'   FE 07                 	CPI	EO_V
  219E'   CA 2711'              	JZ	EX_V
  21A1'   FE 08                 	CPI	EO_R
  21A3'   CA 23CF'              	JZ	EX_R
  21A6'   FE 04                 	CPI	EO_X
  21A8'   CA 21BA'              	JZ	EX_XM
  21AB'   FE 01                 	CPI	EO_W
  21AD'   C2 21C1'              	JNZ	EX_W		; :wq
  21B0'   3A 2F2B'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  21B3'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  21B4'   C2 22EF'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  21B7'   C3 21C1'              	JMP	EX_W
  21BA'                         EX_XM:
  21BA'   3A 2E6C'              	LDA	MODF		; :x writes only a changed text
  21BD'   B7                    	ORA	A
  21BE'   CA 2227'              	JZ	EX_Q
  21C1'                         EX_W:
  21C1'   CD 24AF'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  21C4'   D8                    	RC			; refused (message shown)
  21C5'   32 2ED1'              	STA	EXBAK
  21C8'   3A 2ECF'              	LDA	EXOP
  21CB'   FE 01                 	CPI	EO_W
  21CD'   CA 21E4'              	JZ	EX_WK
  21D0'   3A 2ED1'              	LDA	EXBAK
  21D3'   B7                    	ORA	A
  21D4'   C2 2224'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  21D7'   3A 2EE2'              	LDA	EXBANG
  21DA'   B7                    	ORA	A
  21DB'   CA 2224'              	JZ	EX_WQ		; so it does with '!'
  21DE'   CD 21E4'              	CALL	EX_WK		; else it may not: keep the text
  21E1'   C3 2227'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  21E4'                         EX_WK:
  21E4'   CD 0E21'              	CALL	CURRW		; the cursor's row and file position
  21E7'   32 2ED4'              	STA	WPROW
  21EA'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  21ED'   7D                    	MOV	A,L
  21EE'   E6 7F                 	ANI	7FH
  21F0'   32 2ED5'              	STA	WPBYT
  21F3'   7D                    	MOV	A,L
  21F4'   17                    	RAL
  21F5'   7C                    	MOV	A,H
  21F6'   17                    	RAL
  21F7'   5F                    	MOV	E,A
  21F8'   3E 00                 	MVI	A,0
  21FA'   17                    	RAL
  21FB'   57                    	MOV	D,A		; DE = HL / 128
  21FC'   2A 0000*              	LHLD	OUTPOS
  21FF'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  2200'   22 2ED6'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2203'   CD 24E4'              	CALL	WRITE
  2206'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  2209'   2A 2ED6'              	LHLD	WPREC
  220C'   EB                    	XCHG
  220D'   3A 2ED5'              	LDA	WPBYT
  2210'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2213'   CD 0000*              	CALL	GOTO
  2216'                         EX_WRW:
  2216'   21 0000               	LXI	H,0
  2219'   22 0000*              	SHLD	LNDLT
  221C'   3A 2ED4'              	LDA	WPROW
  221F'   6F                    	MOV	L,A
  2220'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2223'   C9                    	RET
  2224'                         EX_WQ:
  2224'   CD 24E4'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  2227'                         EX_Q:
  2227'   3A 2EE2'              	LDA	EXBANG
  222A'   B7                    	ORA	A
  222B'   CA 2235'              	JZ	EX_QT
  222E'   3A 2E6C'              	LDA	MODF
  2231'   B7                    	ORA	A
  2232'   C2 26FF'              	JNZ	MSGNWR		; changed, no '!': stay
  2235'                         EX_QT:
  2235'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  2238'   3E 01                 	MVI	A,1
  223A'   32 2E6B'              	STA	QUITF
  223D'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  223E'                         EX_E:
  223E'   3A 2EE2'              	LDA	EXBANG
  2241'   B7                    	ORA	A
  2242'   CA 224C'              	JZ	EE_GO
  2245'   3A 2E6C'              	LDA	MODF
  2248'   B7                    	ORA	A
  2249'   C2 26FF'              	JNZ	MSGNWR
  224C'                         EE_GO:
  224C'   3A 2ED0'              	LDA	EXARG
  224F'   B7                    	ORA	A
  2250'   C2 2257'              	JNZ	EE_ARG
  2253'   CD 2520'              	CALL	OWNTF		; no name: the buffer's own
  2256'   D8                    	RC
  2257'                         EE_ARG:
  2257'   CD 2536'              	CALL	ISOWN
  225A'   21 0001               	LXI	H,1
  225D'   C2 2264'              	JNZ	EE_LD		; another file: its first line
  2260'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2263'   23                    	INX	H		; HL = the cursor's line
  2264'                         EE_LD:
  2264'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2266'   32 2EE0'              	STA	MSGWHT
  2269'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  226A'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  226D'   21 0000*              	LXI	H,TFCB
  2270'   11 0000*              	LXI	D,FNAME
  2273'   CD 2548'              	CALL	COPY12		; the buffer's name
  2276'   CD 250D'              	CALL	SRCTF
  2279'   CD 0000*              	CALL	REOPEN
  227C'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  227F'   AF                    	XRA	A
  2280'   32 2E6C'              	STA	MODF
  2283'   E1                    	POP	H
  2284'   2B                    	DCX	H
  2285'   AF                    	XRA	A
  2286'   CD 0000*              	CALL	MVLIND		; down to the line
  2289'   CD 0B3D'              	CALL	ATEOF
  228C'   DC 0B43'              	CC	LASTLN		; past the last line: onto it
  228F'   CD 130D'              	CALL	ZSAVE
  2292'   C3 13E2'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2295'                         TFDOS:
  2295'   C5                    	PUSH	B
  2296'   11 0080               	LXI	D,CMDTAIL
  2299'   0E 1A                 	MVI	C,1AH		; set the DMA
  229B'   CD 0005               	CALL	BDOS
  229E'   C1                    	POP	B
  229F'   11 0000*              	LXI	D,TFCB
  22A2'   C3 0005               	JMP	BDOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  22A5'                         EXRNG:
  22A5'   2A 2F2C'              	LHLD	SRNG1
  22A8'   7C                    	MOV	A,H
  22A9'   B5                    	ORA	L
  22AA'   37                    	STC
  22AB'   C8                    	RZ
  22AC'   2A 2F2E'              	LHLD	SRNG2
  22AF'   EB                    	XCHG
  22B0'   2A 2F2C'              	LHLD	SRNG1
  22B3'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  22B6'   D8                    	RC
  22B7'   EB                    	XCHG			; HL = the last line, DE = the first
  22B8'   CD 0000*              	CALL	SUBHD
  22BB'   23                    	INX	H
  22BC'   22 2F36'              	SHLD	SLINES
  22BF'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  22C0'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  22C1'                         GOLNX:
  22C1'   E5                    	PUSH	H
  22C2'   CD 12A1'              	CALL	GOLN
  22C5'   CD 0000*              	CALL	CNTLF
  22C8'   23                    	INX	H		; the line the cursor came to rest on
  22C9'   D1                    	POP	D
  22CA'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  22CD'                         EXSAVP:
  22CD'   CD 0E21'              	CALL	CURRW
  22D0'   32 2ED4'              	STA	WPROW
  22D3'   21 2F0D'              	LXI	H,MKPOS
  22D6'   C3 0429'              	JMP	FPSTO
  22D9'                         EXRSTP:
  22D9'   CD 0000*              	CALL	CLRCNT
  22DC'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  22DF'   CD 0000*              	CALL	GOTO
  22E2'   C3 2216'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  22E5'                         PUTBRK:
  22E5'   3E 0D                 	MVI	A,CR
  22E7'   CD 0000*              	CALL	PUTGAP
  22EA'   3E 0A                 	MVI	A,LF
  22EC'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  22EF'                         EX_WR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22EF'   3A 2ED0'              	LDA	EXARG
  22F2'   B7                    	ORA	A
  22F3'   CA 26ED'              	JZ	MSGNFN		; No file name
  22F6'   CD 2536'              	CALL	ISOWN
  22F9'   CA 2399'              	JZ	EXW_OW
  22FC'   CD 0000*              	CALL	TEXIST
  22FF'   32 2F39'              	STA	RWERR		; nonzero: a file of that name is there
  2302'   CA 230C'              	JZ	EXW_GO
  2305'   3A 2EE2'              	LDA	EXBANG
  2308'   B7                    	ORA	A
  2309'   C2 26F3'              	JNZ	MSGEXI		; File exists (! to force)
  230C'                         EXW_GO:
  230C'   CD 22A5'              	CALL	EXRNG
  230F'   DA 2393'              	JC	EXW_BD
  2312'   CD 22CD'              	CALL	EXSAVP
  2315'   2A 2F2C'              	LHLD	SRNG1
  2318'   CD 22C1'              	CALL	GOLNX
  231B'   C2 2390'              	JNZ	EXW_NL		; the text has no line N
  231E'   3A 2F39'              	LDA	RWERR		; a delete scans the whole directory, there or
  2321'   B7                    	ORA	A		;   not: only when TEXIST found one
  2322'   0E 13                 	MVI	C,13H
  2324'   C4 2295'              	CNZ	TFDOS		; delete what is there
  2327'   0E 16                 	MVI	C,16H
  2329'   CD 2295'              	CALL	TFDOS		; ... and make it
  232C'   3C                    	INR	A
  232D'   CA 2382'              	JZ	EXW_FL		; no directory entry left
  2330'   3E 80                 	MVI	A,80H
  2332'   32 2F38'              	STA	RWPTR
  2335'   AF                    	XRA	A
  2336'   32 2F39'              	STA	RWERR
  2339'   2A 2F36'              	LHLD	SLINES
  233C'   CD 0000*              	CALL	SETC0		; that many lines, forward
  233F'                         EXW_LP:
  233F'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2342'   E5                    	PUSH	H
  2343'   EB                    	XCHG
  2344'   2A 0000*              	LHLD	GAPEND
  2347'   CD 239F'              	CALL	RWOUT		; the text from the cursor to there
  234A'   E1                    	POP	H
  234B'   3A 2F39'              	LDA	RWERR
  234E'   B7                    	ORA	A
  234F'   C2 236B'              	JNZ	EXW_EN
  2352'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2355'   CD 079B'              	CALL	CNTTST
  2358'   C2 233F'              	JNZ	EXW_LP
  235B'                         EXW_PD:				; the last record is padded out with ^Z
  235B'   3A 2F38'              	LDA	RWPTR
  235E'   FE 80                 	CPI	80H
  2360'   CA 236B'              	JZ	EXW_EN
  2363'   3E 1A                 	MVI	A,CPMEOF
  2365'   CD 23AB'              	CALL	RWPUT
  2368'   C3 235B'              	JMP	EXW_PD
  236B'                         EXW_EN:
  236B'   0E 10                 	MVI	C,10H
  236D'   CD 2295'              	CALL	TFDOS		; close
  2370'   3A 2F39'              	LDA	RWERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2373'   B7                    	ORA	A
  2374'   C2 2382'              	JNZ	EXW_FL
  2377'   CD 22D9'              	CALL	EXRSTP
  237A'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  237C'   32 2EE0'              	STA	MSGWHT
  237F'   C3 085B'              	JMP	SETMOV		; nothing on the screen has changed
  2382'                         EXW_FL:				; no room: the part written is not left behind
  2382'   0E 13                 	MVI	C,13H
  2384'   CD 2295'              	CALL	TFDOS
  2387'   CD 22D9'              	CALL	EXRSTP
  238A'   21 28BA'              	LXI	H,SDFUL
  238D'   C3 2725'              	JMP	EXERR
  2390'                         EXW_NL:
  2390'   CD 22D9'              	CALL	EXRSTP
  2393'                         EXW_BD:
  2393'   21 28AC'              	LXI	H,SRNGE
  2396'   C3 2725'              	JMP	EXERR
  2399'                         EXW_OW:
  2399'   21 2754'              	LXI	H,SEXI
  239C'   C3 2725'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  239F'                         RWOUT:
  239F'   CD 0000*              	CALL	CMP16
  23A2'   C8                    	RZ
  23A3'   7E                    	MOV	A,M
  23A4'   23                    	INX	H
  23A5'   CD 23AB'              	CALL	RWPUT
  23A8'   C3 239F'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  23AB'                         RWPUT:
  23AB'   E5                    	PUSH	H
  23AC'   F5                    	PUSH	PSW
  23AD'   3A 2F38'              	LDA	RWPTR
  23B0'   6F                    	MOV	L,A
  23B1'   26 00                 	MVI	H,0
  23B3'   F1                    	POP	PSW
  23B4'   77                    	MOV	M,A
  23B5'   2C                    	INR	L		; Z: that was the record's last byte
  23B6'   7D                    	MOV	A,L
  23B7'   C2 23CA'              	JNZ	RWP_ST
  23BA'   D5                    	PUSH	D
  23BB'   0E 15                 	MVI	C,15H
  23BD'   CD 2295'              	CALL	TFDOS		; write it
  23C0'   D1                    	POP	D
  23C1'   B7                    	ORA	A
  23C2'   CA 23C8'              	JZ	RWP_OK
  23C5'   32 2F39'              	STA	RWERR
  23C8'                         RWP_OK:
  23C8'   3E 80                 	MVI	A,80H
  23CA'                         RWP_ST:
  23CA'   32 2F38'              	STA	RWPTR
  23CD'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23CE'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  23CF'                         EX_R:
  23CF'   3A 2ED0'              	LDA	EXARG
  23D2'   B7                    	ORA	A
  23D3'   CA 26ED'              	JZ	MSGNFN		; No file name
  23D6'   0E 0F                 	MVI	C,0FH
  23D8'   CD 2295'              	CALL	TFDOS		; open
  23DB'   3C                    	INR	A
  23DC'   CA 24A9'              	JZ	ER_NOF
  23DF'   CD 1333'              	CALL	GZONE		; the screen's top line, before anything moves
  23E2'   CD 22CD'              	CALL	EXSAVP
  23E5'   3A 2F2B'              	LDA	SRNGF
  23E8'   B7                    	ORA	A
  23E9'   CA 2402'              	JZ	ER_NXT		; no line given: below the cursor's
  23EC'   2A 2F2E'              	LHLD	SRNG2
  23EF'   7C                    	MOV	A,H
  23F0'   B5                    	ORA	L
  23F1'   C2 23FC'              	JNZ	ER_LN
  23F4'   23                    	INX	H
  23F5'   CD 12A1'              	CALL	GOLN		; ':0r': above line 1 ...
  23F8'   AF                    	XRA	A		;   which never wants a line end put in first
  23F9'   C3 2424'              	JMP	ER_BRK
  23FC'                         ER_LN:
  23FC'   CD 22C1'              	CALL	GOLNX
  23FF'   C2 2390'              	JNZ	EXW_NL		; the text has no line N
  2402'                         ER_NXT:
  2402'   21 0001               	LXI	H,1
  2405'   AF                    	XRA	A
  2406'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2409'   CD 0B3D'              	CALL	ATEOF
  240C'   3E 00                 	MVI	A,0
  240E'   D2 2424'              	JNC	ER_BRK		; text follows
  2411'   2A 0000*              	LHLD	GAPBEG
  2414'   EB                    	XCHG
  2415'   2A 0000*              	LHLD	TXTBEG
  2418'   CD 0000*              	CALL	CMP16
  241B'   3E 01                 	MVI	A,1
  241D'   CA 2424'              	JZ	ER_BRK		; nothing before the cursor either
  2420'   1B                    	DCX	D
  2421'   1A                    	LDAX	D
  2422'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2424'                         ER_BRK:
  2424'   32 2F3B'              	STA	RDBRK
  2427'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  242A'   AF                    	XRA	A
  242B'   32 2F3A'              	STA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  242E'                         ER_LP:
  242E'   0E 14                 	MVI	C,14H
  2430'   CD 2295'              	CALL	TFDOS		; the next record
  2433'   B7                    	ORA	A
  2434'   C2 2467'              	JNZ	ER_END
  2437'   21 0080               	LXI	H,CMDTAIL
  243A'   0E 00                 	MVI	C,0
  243C'                         ER_SC:				; C = its bytes, up to a ^Z
  243C'   7E                    	MOV	A,M
  243D'   FE 1A                 	CPI	CPMEOF
  243F'   CA 2447'              	JZ	ER_GOT
  2442'   23                    	INX	H
  2443'   0C                    	INR	C
  2444'   F2 243C'              	JP	ER_SC		; (minus: all 128)
  2447'                         ER_GOT:
  2447'   79                    	MOV	A,C
  2448'   B7                    	ORA	A
  2449'   CA 2467'              	JZ	ER_END
  244C'   C5                    	PUSH	B
  244D'   3A 2F3A'              	LDA	RDANY
  2450'   B7                    	ORA	A
  2451'   CC 2498'              	CZ	ER_1ST
  2454'   C1                    	POP	B
  2455'   06 00                 	MVI	B,0
  2457'   11 0080               	LXI	D,CMDTAIL
  245A'   C5                    	PUSH	B
  245B'   CD 0000*              	CALL	INSBLK
  245E'   C1                    	POP	B
  245F'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2462'   79                    	MOV	A,C
  2463'   17                    	RAL
  2464'   DA 242E'              	JC	ER_LP		; a full record: there may be more
  2467'                         ER_END:
  2467'   3A 2F3A'              	LDA	RDANY
  246A'   B7                    	ORA	A
  246B'   CA 2489'              	JZ	ER_PL		; nothing in the file: nothing has changed
  246E'   CD 0B3D'              	CALL	ATEOF
  2471'   DA 247E'              	JC	ER_MD		; the text now ends as the file read ends
  2474'   2A 0000*              	LHLD	GAPBEG
  2477'   2B                    	DCX	H
  2478'   7E                    	MOV	A,M
  2479'   FE 0A                 	CPI	LF
  247B'   C4 22E5'              	CNZ	PUTBRK		; text follows: what was read ends a line
  247E'                         ER_MD:
  247E'   3E 01                 	MVI	A,1
  2480'   32 2E6C'              	STA	MODF
  2483'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2486'   CD 0000*              	CALL	GOTO
  2489'                         ER_PL:
  2489'   CD 0B3D'              	CALL	ATEOF
  248C'   DC 0B43'              	CC	LASTLN		; (nothing read, at the end: the last line)
  248F'   CD 0000*              	CALL	CLRCNT
  2492'   CD 134B'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2495'   C3 0898'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                ; if one is wanted, and where they start, for the cursor to come back to.
  2498'                         ER_1ST:
  2498'   3C                    	INR	A
  2499'   32 2F3A'              	STA	RDANY
  249C'   3A 2F3B'              	LDA	RDBRK
  249F'   B7                    	ORA	A
  24A0'   C4 22E5'              	CNZ	PUTBRK
  24A3'   21 2F0D'              	LXI	H,MKPOS
  24A6'   C3 0429'              	JMP	FPSTO
  24A9'                         ER_NOF:
  24A9'   21 289B'              	LXI	H,SNOPN
  24AC'   C3 271A'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  24AF'                         WRCHK:
  24AF'   3A 2ED0'              	LDA	EXARG
  24B2'   B7                    	ORA	A
  24B3'   C2 24BD'              	JNZ	WC_ARG
  24B6'   CD 2520'              	CALL	OWNTF
  24B9'   D8                    	RC
  24BA'   C3 24D2'              	JMP	WC_OWN
  24BD'                         WC_ARG:
  24BD'   CD 2536'              	CALL	ISOWN
  24C0'   CA 24D2'              	JZ	WC_OWN
  24C3'   3A 2EE2'              	LDA	EXBANG
  24C6'   B7                    	ORA	A
  24C7'   CA 24D0'              	JZ	WC_OTH
  24CA'   CD 0000*              	CALL	TEXIST
  24CD'   C2 26F3'              	JNZ	MSGEXI		; File exists (! to force)
  24D0'                         WC_OTH:
  24D0'   AF                    	XRA	A		; (NC)
  24D1'   C9                    	RET
  24D2'                         WC_OWN:
  24D2'   3A 2EE3'              	LDA	ROFLAG		; '-R': this is the file it may not write
  24D5'   B7                    	ORA	A
  24D6'   CA 24E0'              	JZ	WC_OK
  24D9'   3A 2EE2'              	LDA	EXBANG
  24DC'   B7                    	ORA	A
  24DD'   C2 26F9'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  24E0'                         WC_OK:
  24E0'   3E 01                 	MVI	A,1
  24E2'   B7                    	ORA	A		; (NC)
  24E3'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  24E4'                         WRITE:
  24E4'   3A 2ED1'              	LDA	EXBAK
  24E7'   CD 0000*              	CALL	WRTO
  24EA'   3A 0001*              	LDA	FNAME+1
  24ED'   FE 20                 	CPI	' '
  24EF'   C2 24FB'              	JNZ	WR_HAS
  24F2'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24F5'   11 0000*              	LXI	D,FNAME
  24F8'   CD 2548'              	CALL	COPY12
  24FB'                         WR_HAS:
  24FB'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  24FD'   32 2EE0'              	STA	MSGWHT
  2500'   CD 2536'              	CALL	ISOWN
  2503'   C2 250D'              	JNZ	SRCTF
  2506'   AF                    	XRA	A
  2507'   32 2E6C'              	STA	MODF
  250A'   32 2EE1'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  250D'                         SRCTF:
  250D'   21 0000*              	LXI	H,TFCB
  2510'   11 005C               	LXI	D,DFTFCB
  2513'   CD 2548'              	CALL	COPY12
  2516'   AF                    	XRA	A
  2517'   06 04                 	MVI	B,4
  2519'                         SRC_Z:
  2519'   12                    	STAX	D		; extent, s1, s2, record count: 0
  251A'   13                    	INX	D
  251B'   05                    	DCR	B
  251C'   C2 2519'              	JNZ	SRC_Z
  251F'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2520'                         OWNTF:
  2520'   3A 0001*              	LDA	FNAME+1
  2523'   FE 20                 	CPI	' '
  2525'   CA 26ED'              	JZ	MSGNFN
  2528'   CD 2553'              	CALL	TFCLR
  252B'   21 0000*              	LXI	H,FNAME
  252E'   11 0000*              	LXI	D,TFCB
  2531'   CD 2548'              	CALL	COPY12
  2534'   B7                    	ORA	A		; (NC)
  2535'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2536'                         ISOWN:
  2536'   21 0000*              	LXI	H,TFCB
  2539'   11 0000*              	LXI	D,FNAME
  253C'   06 0C                 	MVI	B,12
  253E'                         IO_LP:
  253E'   1A                    	LDAX	D
  253F'   BE                    	CMP	M
  2540'   C0                    	RNZ
  2541'   23                    	INX	H
  2542'   13                    	INX	D
  2543'   05                    	DCR	B
  2544'   C2 253E'              	JNZ	IO_LP
  2547'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  2548'                         COPY12:
  2548'   06 0C                 	MVI	B,12
  254A'                         CP_LP:
  254A'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  254B'   12                    	STAX	D
  254C'   23                    	INX	H
  254D'   13                    	INX	D
  254E'   05                    	DCR	B
  254F'   C2 254A'              	JNZ	CP_LP
  2552'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2553'                         TFCLR:
  2553'   11 0000*              	LXI	D,TFCB
  2556'   06 24                 	MVI	B,36
  2558'   AF                    	XRA	A
  2559'                         TC_LP:
  2559'   12                    	STAX	D
  255A'   13                    	INX	D
  255B'   05                    	DCR	B
  255C'   C2 2559'              	JNZ	TC_LP
  255F'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2560'                         FOPEN:
  2560'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2562'   32 2EE0'              	STA	MSGWHT
  2565'   21 005C               	LXI	H,DFTFCB
  2568'   CD 2636'              	CALL	NRMDRV
  256B'   11 0000*              	LXI	D,FNAME
  256E'   CD 2548'              	CALL	COPY12
  2571'   CD 0000*              	CALL	OPENZ
  2574'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2577'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2579'   C8                    	RZ
  257A'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  257D'   32 2EE1'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2580'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2581'                         ARGSCN:
  2581'   3A 0080               	LDA	CMDTAIL
  2584'   47                    	MOV	B,A		; B = what is left of the line
  2585'   B7                    	ORA	A
  2586'   C8                    	RZ
  2587'   21 0081               	LXI	H,CMDTAIL+1
  258A'                         AS_TOK:				; at a token, or the blanks before one
  258A'   7E                    	MOV	A,M
  258B'   FE 20                 	CPI	' '
  258D'   C2 2596'              	JNZ	AS_OPT
  2590'   23                    	INX	H
  2591'   05                    	DCR	B
  2592'   C2 258A'              	JNZ	AS_TOK
  2595'   C9                    	RET
  2596'                         AS_OPT:
  2596'   FE 2B                 	CPI	'+'
  2598'   CA 25C2'              	JZ	AS_PLS
  259B'   FE 2D                 	CPI	'-'
  259D'   CA 25B1'              	JZ	AS_SW
  25A0'   FE 2F                 	CPI	'/'
  25A2'   CA 25B1'              	JZ	AS_SW
  25A5'                         AS_SKP:				; not ours (the file name): on to the next one
  25A5'   23                    	INX	H
  25A6'   05                    	DCR	B
  25A7'   C8                    	RZ
  25A8'   7E                    	MOV	A,M
  25A9'   FE 20                 	CPI	' '
  25AB'   C2 25A5'              	JNZ	AS_SKP
  25AE'   C3 258A'              	JMP	AS_TOK
  25B1'                         AS_SW:
  25B1'   23                    	INX	H
  25B2'   05                    	DCR	B
  25B3'   C8                    	RZ
  25B4'   7E                    	MOV	A,M
  25B5'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  25B7'   FE 52                 	CPI	'R'
  25B9'   C2 25A5'              	JNZ	AS_SKP
  25BC'   32 2EE3'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  25BF'   C3 25A5'              	JMP	AS_SKP
  25C2'                         AS_PLS:
  25C2'   3E 01                 	MVI	A,1
  25C4'   32 2EE4'              	STA	PLUSF		; '+' gets the line even with no number on it
  25C7'   11 0000*              	LXI	D,PLUSB
  25CA'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  25CC'   23                    	INX	H		;   line space, so it is taken as '+' alone
  25CD'   05                    	DCR	B
  25CE'   CA 2605'              	JZ	AS_PE
  25D1'   7E                    	MOV	A,M
  25D2'   FE 30                 	CPI	'0'
  25D4'   C2 25EC'              	JNZ	AS_PD
  25D7'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25D7'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  25D8'   05                    	DCR	B
  25D9'   CA 260D'              	JZ	AS_P1
  25DC'   7E                    	MOV	A,M
  25DD'   FE 30                 	CPI	'0'
  25DF'   CA 25D7'              	JZ	AS_PZ
  25E2'   FE 31                 	CPI	'1'
  25E4'   DA 260D'              	JC	AS_P1		; zeros and then no digit at all: line 1
  25E7'   FE 3A                 	CPI	'9'+1
  25E9'   D2 260D'              	JNC	AS_P1
  25EC'                         AS_PD:				; the digits, as typed
  25EC'   7E                    	MOV	A,M
  25ED'   FE 30                 	CPI	'0'
  25EF'   DA 2605'              	JC	AS_PE
  25F2'   FE 3A                 	CPI	'9'+1
  25F4'   D2 2605'              	JNC	AS_PE
  25F7'   79                    	MOV	A,C
  25F8'   B7                    	ORA	A
  25F9'   CA 2614'              	JZ	AS_POV
  25FC'   0D                    	DCR	C
  25FD'   7E                    	MOV	A,M
  25FE'   12                    	STAX	D
  25FF'   13                    	INX	D
  2600'   23                    	INX	H
  2601'   05                    	DCR	B
  2602'   C2 25EC'              	JNZ	AS_PD
  2605'                         AS_PE:
  2605'   AF                    	XRA	A
  2606'   12                    	STAX	D		; the digits end with a 0
  2607'   78                    	MOV	A,B
  2608'   B7                    	ORA	A
  2609'   C8                    	RZ
  260A'   C3 258A'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  260D'                         AS_P1:
  260D'   3E 31                 	MVI	A,'1'
  260F'   12                    	STAX	D
  2610'   13                    	INX	D
  2611'   C3 2605'              	JMP	AS_PE
  2614'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2614'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2617'   C3 2605'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  261A'                         ARGGO:
  261A'   3A 2EE4'              	LDA	PLUSF
  261D'   B7                    	ORA	A
  261E'   C8                    	RZ
  261F'   21 0000*              	LXI	H,PLUSB
  2622'                         AG_LP:
  2622'   7E                    	MOV	A,M
  2623'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2624'   CA 2631'              	JZ	AG_G
  2627'   4F                    	MOV	C,A
  2628'   E5                    	PUSH	H
  2629'   CD 0023'              	CALL	VICMD
  262C'   E1                    	POP	H
  262D'   23                    	INX	H
  262E'   C3 2622'              	JMP	AG_LP
  2631'                         AG_G:
  2631'   0E 47                 	MVI	C,'G'
  2633'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  2636'                         NRMDRV:
  2636'   7E                    	MOV	A,M
  2637'   B7                    	ORA	A
  2638'   C0                    	RNZ
  2639'   E5                    	PUSH	H
  263A'   0E 19                 	MVI	C,BF_CURDSK
  263C'   CD 0005               	CALL	BDOS
  263F'   E1                    	POP	H
  2640'   3C                    	INR	A
  2641'   77                    	MOV	M,A
  2642'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  2643'                         PARSFN:
  2643'   CD 2553'              	CALL	TFCLR
  2646'   11 0000*              	LXI	D,TFCB
  2649'   23                    	INX	H
  264A'   7E                    	MOV	A,M
  264B'   2B                    	DCX	H
  264C'   FE 3A                 	CPI	':'
  264E'   C2 2660'              	JNZ	PF_NM
  2651'   CD 26A6'              	CALL	GETFNC
  2654'   CA 2660'              	JZ	PF_NM
  2657'   D6 40                 	SUI	40H
  2659'   12                    	STAX	D
  265A'   FE 11                 	CPI	17
  265C'   D2 2684'              	JNC	PF_BAD
  265F'   23                    	INX	H
  2660'                         PF_NM:
  2660'   13                    	INX	D
  2661'   0E 08                 	MVI	C,8
  2663'   CD 2688'              	CALL	CPYNAM
  2666'   FE 2E                 	CPI	'.'
  2668'   0E 03                 	MVI	C,3
  266A'   C4 269B'              	CNZ	PADFLD		; no type: blanks
  266D'   CC 2687'              	CZ	CPYNM0		; '.': the type
  2670'   3A 0001*              	LDA	TFCB+1
  2673'   FE 20                 	CPI	' '
  2675'   CA 2684'              	JZ	PF_BAD		; no name
  2678'   CD 26D9'              	CALL	SKIPB
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  267B'   C0                    	RNZ			; more after it
  267C'   21 0000*              	LXI	H,TFCB
  267F'   CD 2636'              	CALL	NRMDRV
  2682'   AF                    	XRA	A
  2683'   C9                    	RET
  2684'                         PF_BAD:
  2684'   F6 01                 	ORI	1
  2686'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2687'                         CPYNM0:
  2687'   23                    	INX	H
  2688'                         CPYNAM:
  2688'   CD 26A6'              	CALL	GETFNC
  268B'   CA 269B'              	JZ	PADFLD
  268E'   12                    	STAX	D
  268F'   13                    	INX	D
  2690'   0D                    	DCR	C
  2691'   C2 2688'              	JNZ	CPYNAM
  2694'                         CN_SKP:
  2694'   CD 26A6'              	CALL	GETFNC
  2697'   C2 2694'              	JNZ	CN_SKP
  269A'   C9                    	RET
  269B'                         PADFLD:
  269B'   F5                    	PUSH	PSW
  269C'                         PD_LP:
  269C'   3E 20                 	MVI	A,' '
  269E'   12                    	STAX	D
  269F'   13                    	INX	D
  26A0'   0D                    	DCR	C
  26A1'   C2 269C'              	JNZ	PD_LP
  26A4'   F1                    	POP	PSW
  26A5'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  26A6'                         GETFNC:
  26A6'   7E                    	MOV	A,M
  26A7'   FE 3D                 	CPI	'='
  26A9'   C8                    	RZ
  26AA'   FE 5F                 	CPI	'_'
  26AC'   C8                    	RZ
  26AD'   FE 3B                 	CPI	';'
  26AF'   C8                    	RZ
  26B0'   FE 3C                 	CPI	'<'
  26B2'   C8                    	RZ
  26B3'   FE 3E                 	CPI	'>'
  26B5'   C8                    	RZ
  26B6'   FE 2E                 	CPI	'.'
  26B8'   C8                    	RZ
  26B9'   FE 3A                 	CPI	':'
  26BB'   C8                    	RZ
  26BC'   FE 2A                 	CPI	'*'
  26BE'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26BF'   FE 3F                 	CPI	'?'
  26C1'   C8                    	RZ
  26C2'   FE 20                 	CPI	' '
  26C4'   DA 26D7'              	JC	GF_CTL
  26C7'   C8                    	RZ
  26C8'   23                    	INX	H
  26C9'   FE 61                 	CPI	'a'
  26CB'   DA 26D5'              	JC	GF_DN
  26CE'   FE 7B                 	CPI	'z'+1
  26D0'   D2 26D5'              	JNC	GF_DN
  26D3'   E6 DF                 	ANI	0DFH
  26D5'                         GF_DN:
  26D5'   B7                    	ORA	A
  26D6'   C9                    	RET
  26D7'                         GF_CTL:
  26D7'   BF                    	CMP	A
  26D8'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  26D9'                         SKIPB:
  26D9'   7E                    	MOV	A,M
  26DA'   FE 20                 	CPI	' '
  26DC'   C2 26E3'              	JNZ	SB_DN
  26DF'   23                    	INX	H
  26E0'   C3 26D9'              	JMP	SKIPB
  26E3'                         SB_DN:
  26E3'   B7                    	ORA	A
  26E4'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  26E5'                         ISLOW:
  26E5'   7E                    	MOV	A,M
  26E6'   FE 61                 	CPI	'a'
  26E8'   D8                    	RC
  26E9'   FE 7B                 	CPI	'z'+1
  26EB'   3F                    	CMC
  26EC'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  26ED'                         MSGNFN:
  26ED'   21 273A'              	LXI	H,SNFN
  26F0'   C3 2725'              	JMP	EXERR
  26F3'                         MSGEXI:
  26F3'   21 2754'              	LXI	H,SEXI
  26F6'   C3 2702'              	JMP	EXBNG
  26F9'                         MSGRO:
  26F9'   21 2760'              	LXI	H,SRO
  26FC'   C3 2702'              	JMP	EXBNG
  26FF'                         MSGNWR:
  26FF'   21 2747'              	LXI	H,SNWR
  2702'                         EXBNG:
  2702'   CD 2725'              	CALL	EXERR
  2705'   21 276C'              	LXI	H,SBNG
  2708'   C3 2720'              	JMP	EXOUT
  270B'                         EX_INV:
  270B'   21 277A'              	LXI	H,SINV
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  270E'   C3 2725'              	JMP	EXERR
  2711'                         EX_V:				; :ve -- the version, on the bottom row
  2711'   21 2735'              	LXI	H,SVER
  2714'   C3 2725'              	JMP	EXERR
  2717'                         EX_TRL:
  2717'   21 278C'              	LXI	H,STRL
  271A'                         EXERT:				; the message, then the text at EXCMD
  271A'   CD 2725'              	CALL	EXERR
  271D'   2A 2ED2'              	LHLD	EXCMD
  2720'                         EXOUT:
  2720'   CD 0000*              	CALL	OUTSTR
  2723'   37                    	STC
  2724'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  2725'                         EXERR:
  2725'   E5                    	PUSH	H
  2726'   AF                    	XRA	A		; an error outranks whatever this key meant to
  2727'   32 2EE0'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  272A'   E1                    	POP	H
  272B'   CD 0000*              	CALL	EXMSG
  272E'   3E 01                 	MVI	A,R_MOVE
  2730'   32 2E6D'              	STA	RINTENT
  2733'   37                    	STC
  2734'   C9                    	RET
                                
  2735'   56 31 2E 33           SVER:	DB	'V1.3',0
  2739'   00                    
  273A'   4E 6F 20 66           SNFN:	DB	'No file name',0
  273E'   69 6C 65 20           
  2742'   6E 61 6D 65           
  2746'   00                    
  2747'   46 69 6C 65           SNWR:	DB	'File changed',0
  274B'   20 63 68 61           
  274F'   6E 67 65 64           
  2753'   00                    
  2754'   46 69 6C 65           SEXI:	DB	'File exists',0
  2758'   20 65 78 69           
  275C'   73 74 73 00           
  2760'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  2764'   20 69 73 20           
  2768'   73 65 74 00           
  276C'   20 28 21 20           SBNG:	DB	' (! to force)',0
  2770'   74 6F 20 66           
  2774'   6F 72 63 65           
  2778'   29 00                 
  277A'   49 6E 76 61           SINV:	DB	'Invalid file name',0
  277E'   6C 69 64 20           
  2782'   66 69 6C 65           
  2786'   20 6E 61 6D           
  278A'   65 00                 
  278C'   54 72 61 69           STRL:	DB	'Trailing chars: ',0
  2790'   6C 69 6E 67           
  2794'   20 63 68 61           
  2798'   72 73 3A 20           
  279C'   00                    
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  279D'   49 6E 76 61           SNOT:	DB	'Invalid command: ',0
  27A1'   6C 69 64 20           
  27A5'   63 6F 6D 6D           
  27A9'   61 6E 64 3A           
  27AD'   20 00                 
  27AF'   50 61 74 74           SNOTFD: DB	'Pattern not found: ',0
  27B3'   65 72 6E 20           
  27B7'   6E 6F 74 20           
  27BB'   66 6F 75 6E           
  27BF'   64 3A 20 00           
  27C3'   49 6E 74 65           SINTR:	DB	'Interrupted',0
  27C7'   72 72 75 70           
  27CB'   74 65 64 00           
  27CF'   49 6E 74 65           SINTG:	DB	'Interrupting...',0
  27D3'   72 72 75 70           
  27D7'   74 69 6E 67           
