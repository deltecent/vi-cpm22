  0A22'   C2 0A2F'              	JNZ	ES_WD
  0A25'   2A 22B4'              	LHLD	WKI
  0A28'   23                    	INX	H
  0A29'   22 22B4'              	SHLD	WKI
  0A2C'   C3 0A0B'              	JMP	ES_WS
  0A2F'                         ES_WD:
  0A2F'   2A 22B4'              	LHLD	WKI
  0A32'   CD 0000*              	CALL	CHARAT
  0A35'   CD 04A6'              	CALL	CLASSF
  0A38'   32 22BC'              	STA	WKCLS
  0A3B'                         ES_RUN:
  0A3B'   2A 22B4'              	LHLD	WKI
  0A3E'   23                    	INX	H
  0A3F'   EB                    	XCHG			; DE = i+1
  0A40'   2A 22B6'              	LHLD	WKN
  0A43'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0A46'   D2 0A63'              	JNC	ES_LND
  0A49'   2A 22B4'              	LHLD	WKI
  0A4C'   23                    	INX	H
  0A4D'   E5                    	PUSH	H		; i+1
  0A4E'   CD 0000*              	CALL	CHARAT
  0A51'   CD 04A6'              	CALL	CLASSF
  0A54'   E1                    	POP	H		; HL = i+1
  0A55'   47                    	MOV	B,A
  0A56'   3A 22BC'              	LDA	WKCLS
  0A59'   B8                    	CMP	B
  0A5A'   C2 0A63'              	JNZ	ES_LND
  0A5D'   22 22B4'              	SHLD	WKI
  0A60'   C3 0A3B'              	JMP	ES_RUN
  0A63'                         ES_LND:
  0A63'   2A 22B6'              	LHLD	WKN
  0A66'   EB                    	XCHG
  0A67'   2A 22B4'              	LHLD	WKI
  0A6A'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0A6D'   DA 0A79'              	JC	ES_CL
  0A70'   CA 0A79'              	JZ	ES_CL
  0A73'   2A 22B4'              	LHLD	WKI
  0A76'   C3 0373'              	JMP	GOSET
  0A79'                         ES_CL:
  0A79'   2A 22B6'              	LHLD	WKN
  0A7C'   7C                    	MOV	A,H
  0A7D'   B5                    	ORA	L
  0A7E'   C8                    	RZ
  0A7F'   2B                    	DCX	H
  0A80'   C3 0373'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0A83'                         CURRW:
  0A83'   2A 0000*              	LHLD	WINROW
  0A86'   EB                    	XCHG
  0A87'   2A 0000*              	LHLD	LNDLT
  0A8A'   19                    	DAD	D		; HL = row (signed)
  0A8B'   7C                    	MOV	A,H
  0A8C'   B7                    	ORA	A
  0A8D'   FA 0AA0'              	JM	CRW_0		; above the screen -> top row
  0A90'   C2 0A9B'              	JNZ	CRW_BT		; far below -> bottom row
  0A93'   3A 0000*              	LDA	NEDIT
  0A96'   3D                    	DCR	A		; A = bottom row
  0A97'   BD                    	CMP	L		; CY iff bottom < row
  0A98'   D8                    	RC
  0A99'   7D                    	MOV	A,L
  0A9A'   C9                    	RET
  0A9B'                         CRW_BT:
  0A9B'   3A 0000*              	LDA	NEDIT
  0A9E'   3D                    	DCR	A
  0A9F'   C9                    	RET
  0AA0'                         CRW_0:
  0AA0'   AF                    	XRA	A
  0AA1'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0AA2'                         SETRWT:
  0AA2'   2A 0000*              	LHLD	LNDLT
  0AA5'   EB                    	XCHG
  0AA6'   6F                    	MOV	L,A
  0AA7'   26 00                 	MVI	H,0
  0AA9'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0AAC'   22 0000*              	SHLD	WINROW
  0AAF'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0AB0'                         MVROW:
  0AB0'   47                    	MOV	B,A
  0AB1'   CD 0A83'              	CALL	CURRW
  0AB4'   90                    	SUB	B		; A = row now - target
  0AB5'   C8                    	RZ
  0AB6'   DA 0ABF'              	JC	MR_DN
  0AB9'   6F                    	MOV	L,A
  0ABA'   26 00                 	MVI	H,0
  0ABC'   C3 070A'              	JMP	KCORE
  0ABF'                         MR_DN:
  0ABF'   2F                    	CMA
  0AC0'   3C                    	INR	A		; A = target - row now
  0AC1'   6F                    	MOV	L,A
  0AC2'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0AC4'   C3 066D'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0AC7'                         VC_HIGH:
  0AC7'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  0ACA'   2B                    	DCX	H		; row = count - 1
  0ACB'   7C                    	MOV	A,H
  0ACC'   B7                    	ORA	A
  0ACD'   3A 0000*              	LDA	SCBOT
  0AD0'   C2 0AD8'              	JNZ	VH_GO		; >= 256 -> the last text row
  0AD3'   BD                    	CMP	L		; CY iff SCBOT < row
  0AD4'   DA 0AD8'              	JC	VH_GO
  0AD7'   7D                    	MOV	A,L
  0AD8'                         VH_GO:
  0AD8'   CD 0AB0'              	CALL	MVROW
  0ADB'   C3 05BF'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0ADE'                         VC_MIDL:
  0ADE'   CD 0471'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0AE1'   3A 0000*              	LDA	SCBOT
  0AE4'   B7                    	ORA	A		; clear CY for the shift
  0AE5'   1F                    	RAR			; A = SCBOT / 2
  0AE6'   CD 0AB0'              	CALL	MVROW
  0AE9'   C3 05BF'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0AEC'                         VC_LOWL:
  0AEC'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  0AEF'   2B                    	DCX	H		; count - 1
  0AF0'   3A 0000*              	LDA	SCBOT
  0AF3'   5F                    	MOV	E,A
  0AF4'   16 00                 	MVI	D,0
  0AF6'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0AF7'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0AFA'   3E 00                 	MVI	A,0
  0AFC'   D2 0B03'              	JNC	VL_GO		; at or past the top -> row 0
  0AFF'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0B02'   7D                    	MOV	A,L
  0B03'                         VL_GO:
  0B03'   CD 0AB0'              	CALL	MVROW
  0B06'   C3 05BF'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0B09'                         VC_PGDN:
  0B09'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  0B0C'   3A 0000*              	LDA	SCEOF
  0B0F'   B7                    	ORA	A
  0B10'   CA 0B1E'              	JZ	VPD_N
  0B13'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0B16'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0B17'   C8                    	RZ			; it already is
  0B18'   CD 0AB0'              	CALL	MVROW
  0B1B'   C3 0B2F'              	JMP	VPD_TP
  0B1E'                         VPD_N:
  0B1E'   3A 0000*              	LDA	NEDIT
  0B21'   D6 02                 	SUI	2
  0B23'   CD 0B77'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0B26'   E5                    	PUSH	H
  0B27'   AF                    	XRA	A
  0B28'   CD 0AB0'              	CALL	MVROW		; the top line
  0B2B'   E1                    	POP	H
  0B2C'   CD 066D'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0B2F'                         VPD_TP:
  0B2F'   AF                    	XRA	A
  0B30'   CD 0AA2'              	CALL	SETRWT		; to the top row
  0B33'   C3 05BF'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0B36'                         VC_PGUP:
  0B36'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  0B39'   3A 0000*              	LDA	SCBOF
  0B3C'   B7                    	ORA	A
  0B3D'   C0                    	RNZ
  0B3E'   3A 0000*              	LDA	NEDIT
  0B41'   47                    	MOV	B,A
  0B42'   3A 0000*              	LDA	SCEOF
  0B45'   B7                    	ORA	A
  0B46'   CA 0B57'              	JZ	VPU_2
  0B49'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0B4C'   FE 02                 	CPI	2
  0B4E'   D2 0B57'              	JNC	VPU_2
  0B51'   2F                    	CMA
  0B52'   3C                    	INR	A
  0B53'   80                    	ADD	B
  0B54'   C3 0B5A'              	JMP	VPU_P
  0B57'                         VPU_2:
  0B57'   78                    	MOV	A,B
  0B58'   D6 02                 	SUI	2
  0B5A'                         VPU_P:
  0B5A'   CD 0B77'              	CALL	MULSAT		; HL = count * page
  0B5D'   E5                    	PUSH	H
  0B5E'   AF                    	XRA	A
  0B5F'   CD 0AB0'              	CALL	MVROW		; the top line
  0B62'   E1                    	POP	H
  0B63'   CD 070A'              	CALL	KCORE		; the new top line
  0B66'   AF                    	XRA	A
  0B67'   CD 0AA2'              	CALL	SETRWT		; on the top row
  0B6A'   3A 0000*              	LDA	NEDIT
  0B6D'   3D                    	DCR	A
  0B6E'   6F                    	MOV	L,A
  0B6F'   26 00                 	MVI	H,0
  0B71'   CD 066D'              	CALL	JCORE		; the bottom row's line
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B74'   C3 05BF'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0B77'                         MULSAT:
  0B77'   EB                    	XCHG
  0B78'   21 0000               	LXI	H,0
  0B7B'   B7                    	ORA	A
  0B7C'   C8                    	RZ
  0B7D'                         MS_LP:
  0B7D'   19                    	DAD	D
  0B7E'   DA 0B86'              	JC	MS_SAT
  0B81'   3D                    	DCR	A
  0B82'   C2 0B7D'              	JNZ	MS_LP
  0B85'   C9                    	RET
  0B86'                         MS_SAT:
  0B86'   21 FFFF               	LXI	H,0FFFFH
  0B89'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0B8A'                         VC_HFDN:
  0B8A'   CD 04F1'              	CALL	SETMOV
  0B8D'   CD 0A83'              	CALL	CURRW
  0B90'   32 2286'              	STA	HFROW
  0B93'   CD 0C01'              	CALL	HFCNT		; HL = lines
  0B96'   3A 2286'              	LDA	HFROW
  0B99'   47                    	MOV	B,A
  0B9A'   3A 0000*              	LDA	SCEOF
  0B9D'   B7                    	ORA	A
  0B9E'   CA 0BA6'              	JZ	VHD_GO
  0BA1'   3A 0000*              	LDA	SCBOT		; the last line's row
  0BA4'   B8                    	CMP	B
  0BA5'   C8                    	RZ			; the cursor is on it
  0BA6'                         VHD_GO:
  0BA6'   CD 066D'              	CALL	JCORE
  0BA9'   3A 0000*              	LDA	SCEOF
  0BAC'   B7                    	ORA	A
  0BAD'   C2 05BF'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0BB0'   3A 2286'              	LDA	HFROW
  0BB3'   CD 0AA2'              	CALL	SETRWT
  0BB6'   3E 01                 	MVI	A,1
  0BB8'   32 0000*              	STA	WFILL		; not past the end of the file
  0BBB'   C3 05BF'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0BBE'                         VC_HFUP:
  0BBE'   CD 04F1'              	CALL	SETMOV
  0BC1'   CD 0A83'              	CALL	CURRW
  0BC4'   32 2286'              	STA	HFROW
  0BC7'   CD 0C01'              	CALL	HFCNT		; HL = lines
  0BCA'   CD 0BE1'              	CALL	ONFST
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0BCD'   C8                    	RZ			; the cursor is on the first line
  0BCE'   CD 070A'              	CALL	KCORE
  0BD1'   3A 0000*              	LDA	SCBOF
  0BD4'   B7                    	ORA	A
  0BD5'   C2 05BF'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0BD8'   3A 2286'              	LDA	HFROW
  0BDB'   CD 0AA2'              	CALL	SETRWT
  0BDE'   C3 05BF'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0BE1'                         ONFST:
  0BE1'   E5                    	PUSH	H
  0BE2'   2A 0000*              	LHLD	OUTPOS
  0BE5'   7C                    	MOV	A,H
  0BE6'   B5                    	ORA	L
  0BE7'   C2 0BFF'              	JNZ	OF_RET
  0BEA'   2A 0000*              	LHLD	TXTBEG
  0BED'   EB                    	XCHG			; DE = TXTBEG
  0BEE'   2A 0000*              	LHLD	GAPBEG
  0BF1'                         OF_LP:
  0BF1'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0BF4'   CA 0BFF'              	JZ	OF_RET
  0BF7'   2B                    	DCX	H
  0BF8'   7E                    	MOV	A,M
  0BF9'   FE 0A                 	CPI	LF
  0BFB'   C2 0BF1'              	JNZ	OF_LP
  0BFE'   B7                    	ORA	A		; NZ
  0BFF'                         OF_RET:
  0BFF'   E1                    	POP	H
  0C00'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0C01'                         HFCNT:
  0C01'   2A 227A'              	LHLD	CMDCNT
  0C04'   7C                    	MOV	A,H
  0C05'   B5                    	ORA	L
  0C06'   CA 0C1D'              	JZ	HFC_AM
  0C09'   CD 0484'              	CALL	GETCNT		; HL = count; clears it
  0C0C'   3A 0000*              	LDA	NEDIT
  0C0F'   5F                    	MOV	E,A
  0C10'   16 00                 	MVI	D,0
  0C12'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0C15'   D2 0C19'              	JNC	HFC_ST
  0C18'   EB                    	XCHG			; HL = NEDIT
  0C19'                         HFC_ST:
  0C19'   7D                    	MOV	A,L
  0C1A'   32 2287'              	STA	HFAMT
  0C1D'                         HFC_AM:
  0C1D'   3A 2287'              	LDA	HFAMT
  0C20'   B7                    	ORA	A
  0C21'   C2 0C2E'              	JNZ	HFC_HL
  0C24'   3A 0000*              	LDA	NEDIT
  0C27'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C28'   1F                    	RAR
  0C29'   B7                    	ORA	A
  0C2A'   C2 0C2E'              	JNZ	HFC_HL
  0C2D'   3C                    	INR	A		; at least one line
  0C2E'                         HFC_HL:
  0C2E'   6F                    	MOV	L,A
  0C2F'   26 00                 	MVI	H,0
  0C31'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0C32'                         VC_REDR:
  0C32'   C3 0484'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0C35'                         VC_G:
  0C35'   CD 04F1'              	CALL	SETMOV
  0C38'   CD 0CC8'              	CALL	GZONE		; the screen's top line, before the move
  0C3B'   2A 227A'              	LHLD	CMDCNT
  0C3E'   7C                    	MOV	A,H
  0C3F'   B5                    	ORA	L
  0C40'   C2 0C4D'              	JNZ	VG_N
  0C43'   AF                    	XRA	A		; forward
  0C44'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0C47'   CD 07A1'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0C4A'   C3 0CE0'              	JMP	GPLACE
  0C4D'                         VG_N:
  0C4D'   CD 0484'              	CALL	GETCNT		; HL = target line (1-based)
  0C50'                         VG_LN:
  0C50'   CD 0C56'              	CALL	GOLN
  0C53'   C3 0CE0'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0C56'                         GOLN:
  0C56'   2B                    	DCX	H		; lines to move from line 1
  0C57'   E5                    	PUSH	H
  0C58'   3E FF                 	MVI	A,0FFH
  0C5A'   CD 0000*              	CALL	MVLMAX		; to BOF
  0C5D'   E1                    	POP	H
  0C5E'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C5F'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0C62'   CD 079B'              	CALL	ATEOF
  0C65'   DC 07A1'              	CC	LASTLN		; past the last line: onto it
  0C68'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0C69'                         VC_LG:
  0C69'   CD 04F1'              	CALL	SETMOV
  0C6C'   3A 22A2'              	LDA	GSAVE
  0C6F'   B7                    	ORA	A
  0C70'   C2 0C79'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0C73'   3E 01                 	MVI	A,PG
  0C75'   32 22A1'              	STA	GPEND
  0C78'   C9                    	RET
  0C79'                         VLG_GG:
  0C79'   CD 0CC8'              	CALL	GZONE
  0C7C'   CD 0484'              	CALL	GETCNT		; HL = target line (no count: 1)
  0C7F'   C3 0C50'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0C82'                         FPOS:
  0C82'   C5                    	PUSH	B
  0C83'   D5                    	PUSH	D
  0C84'   EB                    	XCHG
  0C85'   2A 0000*              	LHLD	TXTBEG
  0C88'   EB                    	XCHG
  0C89'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0C8C'   EB                    	XCHG			; DE = that
  0C8D'   2A 0000*              	LHLD	OUTPOS
  0C90'   7C                    	MOV	A,H
  0C91'   B7                    	ORA	A		; CY = 0
  0C92'   1F                    	RAR
  0C93'   47                    	MOV	B,A
  0C94'   7D                    	MOV	A,L
  0C95'   1F                    	RAR
  0C96'   67                    	MOV	H,A
  0C97'   3E 00                 	MVI	A,0
  0C99'   1F                    	RAR
  0C9A'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0C9B'   19                    	DAD	D
  0C9C'   78                    	MOV	A,B
  0C9D'   CE 00                 	ACI	0		; A:HL = the position
  0C9F'   D1                    	POP	D
  0CA0'   C1                    	POP	B
  0CA1'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0CA2'                         ZSAVE:
  0CA2'   2A 227A'              	LHLD	CMDCNT
  0CA5'   22 22D4'              	SHLD	ZSVCNT
  0CA8'   2A 0000*              	LHLD	AUXCNT
  0CAB'   22 22D6'              	SHLD	ZSVAUX
  0CAE'   3A 0000*              	LDA	DIRFLG
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CB1'   32 22D8'              	STA	ZSVDIR
  0CB4'   C9                    	RET
  0CB5'                         ZREST:
  0CB5'   2A 22D4'              	LHLD	ZSVCNT
  0CB8'   22 227A'              	SHLD	CMDCNT
  0CBB'   2A 22D6'              	LHLD	ZSVAUX
  0CBE'   22 0000*              	SHLD	AUXCNT
  0CC1'   3A 22D8'              	LDA	ZSVDIR
  0CC4'   32 0000*              	STA	DIRFLG
  0CC7'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0CC8'                         GZONE:
  0CC8'   CD 0CA2'              	CALL	ZSAVE
  0CCB'   CD 0A83'              	CALL	CURRW
  0CCE'   6F                    	MOV	L,A
  0CCF'   26 00                 	MVI	H,0
  0CD1'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0CD4'   CD 0C82'              	CALL	FPOS
  0CD7'   22 0000*              	SHLD	ZTOP
  0CDA'   32 0002*              	STA	ZTOP+2
  0CDD'   C3 0CB5'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0CE0'                         GPLACE:
  0CE0'   CD 0CA2'              	CALL	ZSAVE
  0CE3'   2A 0000*              	LHLD	GAPBEG
  0CE6'   CD 0C82'              	CALL	FPOS
  0CE9'   EB                    	XCHG
  0CEA'   4F                    	MOV	C,A		; C:DE = the target's position
  0CEB'   2A 0000*              	LHLD	ZTOP
  0CEE'   7B                    	MOV	A,E
  0CEF'   95                    	SUB	L
  0CF0'   6F                    	MOV	L,A
  0CF1'   7A                    	MOV	A,D
  0CF2'   9C                    	SBB	H
  0CF3'   67                    	MOV	H,A
  0CF4'   22 22D1'              	SHLD	ZDIF
  0CF7'   3A 0002*              	LDA	ZTOP+2
  0CFA'   47                    	MOV	B,A
  0CFB'   79                    	MOV	A,C
  0CFC'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0CFD'   DA 0D4A'              	JC	GP_UP
  0D00'   B7                    	ORA	A
  0D01'   C2 0D8B'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0D04'   3A 0000*              	LDA	NEDIT
  0D07'   5F                    	MOV	E,A
  0D08'   16 00                 	MVI	D,0
  0D0A'   B7                    	ORA	A
  0D0B'   1F                    	RAR
  0D0C'   6F                    	MOV	L,A
  0D0D'   26 00                 	MVI	H,0
  0D0F'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D10'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0D13'   CD 047D'              	CALL	GBSUB		; HL = bytes from there to the target
  0D16'   EB                    	XCHG
  0D17'   2A 22D1'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0D1A'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0D1D'   DA 0D8B'              	JC	GP_MID
  0D20'   CD 047D'              	CALL	GBSUB		; HL = the top line's start (resident)
  0D23'   01 0000               	LXI	B,0		; BC = lines from the top
  0D26'                         GP_CNT:
  0D26'   7A                    	MOV	A,D
  0D27'   B3                    	ORA	E
  0D28'   CA 0D37'              	JZ	GP_DN
  0D2B'   7E                    	MOV	A,M
  0D2C'   23                    	INX	H
  0D2D'   1B                    	DCX	D
  0D2E'   FE 0A                 	CPI	LF
  0D30'   C2 0D26'              	JNZ	GP_CNT
  0D33'   03                    	INX	B
  0D34'   C3 0D26'              	JMP	GP_CNT
  0D37'                         GP_DN:
  0D37'   3A 0000*              	LDA	NEDIT
  0D3A'   3D                    	DCR	A
  0D3B'   5F                    	MOV	E,A
  0D3C'   16 00                 	MVI	D,0		; DE = the bottom row
  0D3E'   60                    	MOV	H,B
  0D3F'   69                    	MOV	L,C
  0D40'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0D43'   DA 0D95'              	JC	GP_SET		; A = the bottom row
  0D46'   7D                    	MOV	A,L		; on the screen: its row
  0D47'   C3 0DB5'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0D4A'                         GP_UP:
  0D4A'   3C                    	INR	A
  0D4B'   C2 0D8B'              	JNZ	GP_MID		; 64K bytes or more above
  0D4E'   2A 22D1'              	LHLD	ZDIF
  0D51'   EB                    	XCHG
  0D52'   21 0000               	LXI	H,0
  0D55'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0D58'   7C                    	MOV	A,H
  0D59'   B5                    	ORA	L
  0D5A'   CA 0D8B'              	JZ	GP_MID		; exactly 64K
  0D5D'   EB                    	XCHG			; DE = bytes to read
  0D5E'   AF                    	XRA	A
  0D5F'   32 22D3'              	STA	ZLF
  0D62'   CD 0000*              	CALL	RGET0
  0D65'                         GP_RD:
  0D65'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0D68'   DA 0D8B'              	JC	GP_MID
  0D6B'   FE 0A                 	CPI	LF
  0D6D'   C2 0D81'              	JNZ	GP_RN
  0D70'   3A 0000*              	LDA	NEDIT
  0D73'   B7                    	ORA	A
  0D74'   1F                    	RAR
  0D75'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0D77'   E5                    	PUSH	H
  0D78'   21 22D3'              	LXI	H,ZLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D7B'   34                    	INR	M
  0D7C'   BE                    	CMP	M		; CY iff more lines than that
  0D7D'   E1                    	POP	H
  0D7E'   DA 0D8B'              	JC	GP_MID
  0D81'                         GP_RN:
  0D81'   1B                    	DCX	D
  0D82'   7A                    	MOV	A,D
  0D83'   B3                    	ORA	E
  0D84'   C2 0D65'              	JNZ	GP_RD
  0D87'   AF                    	XRA	A		; the top row
  0D88'   C3 0D95'              	JMP	GP_SET
  0D8B'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0D8B'   3E 01                 	MVI	A,1
  0D8D'   32 0000*              	STA	WFILL		; not past the end of the file
  0D90'   3A 0000*              	LDA	NEDIT
  0D93'   B7                    	ORA	A
  0D94'   1F                    	RAR			; the middle row
  0D95'                         GP_SET:
  0D95'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0D96'   26 00                 	MVI	H,0
  0D98'   22 0000*              	SHLD	WINROW
  0D9B'   21 0000               	LXI	H,0
  0D9E'   22 0000*              	SHLD	LNDLT
  0DA1'   CD 0512'              	CALL	SETFUL		; the window may have paged: full repaint
  0DA4'                         GP_FIN:
  0DA4'   CD 0CB5'              	CALL	ZREST
  0DA7'   3A 22F1'              	LDA	GPKEEP
  0DAA'   B7                    	ORA	A
  0DAB'   CA 05BF'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0DAE'   AF                    	XRA	A
  0DAF'   32 22F1'              	STA	GPKEEP
  0DB2'   C3 0376'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0DB5'                         GP_ONS:
  0DB5'   6F                    	MOV	L,A
  0DB6'   26 00                 	MVI	H,0		; HL = the row it lands on
  0DB8'   EB                    	XCHG
  0DB9'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0DBC'   EB                    	XCHG
  0DBD'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0DC0'   22 0000*              	SHLD	LNDLT
  0DC3'   3E 01                 	MVI	A,R_MOVE
  0DC5'   32 227E'              	STA	RINTENT
  0DC8'   C3 0DA4'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0DCB'                         OPPEND:
  0DCB'   AF                    	XRA	A
  0DCC'   32 22A7'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0DCF'   3A 22A4'              	LDA	PSAVE
  0DD2'   FE 63                 	CPI	'c'
  0DD4'   C2 0DF1'              	JNZ	OPP_ND
  0DD7'   79                    	MOV	A,C
  0DD8'   FE 77                 	CPI	'w'
  0DDA'   CA 0DE2'              	JZ	OPP_W
  0DDD'   FE 57                 	CPI	'W'
  0DDF'   C2 0DF1'              	JNZ	OPP_ND
  0DE2'                         OPP_W:
  0DE2'   CD 0E65'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0DE5'   DA 0DF1'              	JC	OPP_ND
  0DE8'   79                    	MOV	A,C
  0DE9'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0DEB'   4F                    	MOV	C,A
  0DEC'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0DEE'   32 22A7'              	STA	CWEOL		;   see the clamp in OPA_F
  0DF1'                         OPP_ND:
  0DF1'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0DF2'   21 22A4'              	LXI	H,PSAVE
  0DF5'   BE                    	CMP	M
  0DF6'   CA 0E86'              	JZ	OPLINE
  0DF9'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0DFA'   CD 0E96'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0DFD'   DA 0E62'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0E00'   32 22A6'              	STA	OPCLSV
  0E03'   47                    	MOV	B,A		; B = the class
  0E04'   3A 22A4'              	LDA	PSAVE
  0E07'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0E09'   C2 0E15'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0E0C'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0E0D'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0E0F'   C2 0E31'              	JNZ	OPP_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0E12'   C3 0E20'              	JMP	OPP_NO
  0E15'                         OPP_NC:
  0E15'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0E17'   C2 0E31'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0E1A'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0E1B'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0E1D'   CA 0E31'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0E20'                         OPP_NO:
  0E20'   79                    	MOV	A,C		; dropped -- but ''' and '`' still owe us their
  0E21'   FE 27                 	CPI	27H		;   mark letter, and an orphan would be dispatched
  0E23'   CA 0E2B'              	JZ	OPP_SW		;   as a command ('a' opens an insert and types
  0E26'   FE 60                 	CPI	60H		;   into the buffer), so swallow it before
  0E28'   C2 0E62'              	JNZ	OPABRT		;   dropping the command
  0E2B'                         OPP_SW:
  0E2B'   CD 021B'              	CALL	MKGETK
  0E2E'   C3 0E62'              	JMP	OPABRT
  0E31'                         OPP_GO:
  0E31'   AF                    	XRA	A
  0E32'   32 2285'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0E35'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  0E38'   22 22A8'              	SHLD	OPSTA
  0E3B'   21 21BA'              	LXI	H,CMDTAB
  0E3E'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0E41'   3A 22A4'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  0E44'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0E45'   CA 04F1'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0E48'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0E4B'   22 22AA'              	SHLD	OPEND2
  0E4E'   3A 22A4'              	LDA	PSAVE
  0E51'   FE 79                 	CPI	'y'
  0E53'   CA 1307'              	JZ	OPYANK		; a yank takes the span without losing it
  0E56'   CD 0EAE'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0E59'   3A 22A4'              	LDA	PSAVE
  0E5C'   FE 63                 	CPI	'c'
  0E5E'   C0                    	RNZ
  0E5F'   C3 10CE'              	JMP	SETINS
  0E62'                         OPABRT:
  0E62'   C3 04F1'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0E65'                         ONWHIT:
  0E65'   CD 0460'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0E68'   CA 0E84'              	JZ	OW_YES
  0E6B'   CD 046B'              	CALL	CURCHR		; A = the char under the cursor
  0E6E'   FE 20                 	CPI	' '
  0E70'   CA 0E84'              	JZ	OW_YES
  0E73'   FE 09                 	CPI	TAB
  0E75'   CA 0E84'              	JZ	OW_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E78'   FE 0D                 	CPI	CR
  0E7A'   CA 0E84'              	JZ	OW_YES
  0E7D'   FE 0A                 	CPI	LF
  0E7F'   CA 0E84'              	JZ	OW_YES
  0E82'   B7                    	ORA	A		; a char to change: CY clear
  0E83'   C9                    	RET
  0E84'                         OW_YES:
  0E84'   37                    	STC
  0E85'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  0E86'                         OPLINE:
  0E86'   3A 22A4'              	LDA	PSAVE
  0E89'   FE 63                 	CPI	'c'
  0E8B'   CA 04F1'              	JZ	SETMOV
  0E8E'   FE 79                 	CPI	'y'
  0E90'   CA 12EC'              	JZ	VY_YY
  0E93'   C3 1271'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  0E96'                         OPCLS:
  0E96'   47                    	MOV	B,A
  0E97'   21 0FD0'              	LXI	H,OPCTAB
  0E9A'                         OPC_LP:
  0E9A'   7E                    	MOV	A,M
  0E9B'   B7                    	ORA	A
  0E9C'   CA 0EAC'              	JZ	OPC_MS		; end of table -> not a motion
  0E9F'   B8                    	CMP	B
  0EA0'   CA 0EA8'              	JZ	OPC_HT
  0EA3'   23                    	INX	H
  0EA4'   23                    	INX	H
  0EA5'   C3 0E9A'              	JMP	OPC_LP
  0EA8'                         OPC_HT:
  0EA8'   23                    	INX	H
  0EA9'   7E                    	MOV	A,M		; class byte
  0EAA'   B7                    	ORA	A		; clear CY
  0EAB'   C9                    	RET
  0EAC'                         OPC_MS:
  0EAC'   37                    	STC
  0EAD'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  0EAE'                         OPAPPL:
  0EAE'   3A 22A6'              	LDA	OPCLSV
  0EB1'   FE 02                 	CPI	2
  0EB3'   CA 0FB4'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  0EB6'   2A 22A8'              	LHLD	OPSTA
  0EB9'   EB                    	XCHG			; DE = start
  0EBA'   2A 22AA'              	LHLD	OPEND2		; HL = end
  0EBD'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  0EC0'   DA 0ED0'              	JC	OPA_F
  0EC3'   CA 0ED0'              	JZ	OPA_F		; forward or empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                	;--- backward: lo = end (HL), hi = start (DE) ---
  0EC6'   22 22AC'              	SHLD	OPLO
  0EC9'   EB                    	XCHG
  0ECA'   22 22AE'              	SHLD	OPHI
  0ECD'   C3 0F28'              	JMP	OPA_DO
  0ED0'                         OPA_F:
  0ED0'   EB                    	XCHG			; HL = start, DE = end
  0ED1'   22 22AC'              	SHLD	OPLO
  0ED4'   EB                    	XCHG			; HL = end
  0ED5'   3A 22A6'              	LDA	OPCLSV
  0ED8'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  0EDA'   CA 0F25'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  0EDD'   FE 01                 	CPI	1
  0EDF'   C2 0F01'              	JNZ	OPA_EX
  0EE2'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  0EE3'   3A 22A7'              	LDA	CWEOL
  0EE6'   B7                    	ORA	A
  0EE7'   CA 0F25'              	JZ	OPA_HI
  0EEA'   22 22AE'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  0EED'   2A 22AC'              	LHLD	OPLO
  0EF0'   CD 104C'              	CALL	CEND		; HL = the start line's content end
  0EF3'   EB                    	XCHG			; DE = that content end
  0EF4'   2A 22AE'              	LHLD	OPHI		; HL = hi
  0EF7'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  0EFA'   D2 0F25'              	JNC	OPA_HI		; hi is inside the line: keep it
  0EFD'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  0EFE'   C3 0F25'              	JMP	OPA_HI
  0F01'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  0F01'   22 22AE'              	SHLD	OPHI		; the motion's own end, for now
  0F04'   2A 22AC'              	LHLD	OPLO
  0F07'   CD 104C'              	CALL	CEND		; HL = the start line's content end
  0F0A'   EB                    	XCHG			; DE = that content end
  0F0B'   3A 2285'              	LDA	WPULL		; the motion landed on a line's end and was
  0F0E'   B7                    	ORA	A		;   pulled back onto its last char (the command
  0F0F'   C2 0F1B'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  0F12'   2A 22AE'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  0F15'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  0F18'   D2 0F28'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  0F1B'                         OPA_CE:				;   deletes the word, not all but its last char
  0F1B'   2A 22AC'              	LHLD	OPLO
  0F1E'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  0F21'   CA 0F66'              	JZ	OPA_LN
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0F24'   EB                    	XCHG			; HL = the content end
  0F25'                         OPA_HI:
  0F25'   22 22AE'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  0F28'                         OPA_DO:
  0F28'   CD 0F4C'              	CALL	OPDSPN
  0F2B'   3A 22A4'              	LDA	PSAVE
  0F2E'   FE 63                 	CPI	'c'
  0F30'   C8                    	RZ
  0F31'   C3 105D'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  0F34'                         SPNBRK:
  0F34'   2A 22AC'              	LHLD	OPLO
  0F37'   CD 03F0'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  0F3A'   EB                    	XCHG			; DE = it
  0F3B'   2A 22AE'              	LHLD	OPHI
  0F3E'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  0F41'                         OPSPNL:
  0F41'   2A 22AE'              	LHLD	OPHI
  0F44'   EB                    	XCHG
  0F45'   2A 22AC'              	LHLD	OPLO
  0F48'   EB                    	XCHG			; HL = hi, DE = lo
  0F49'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  0F4C'                         OPDSPN:
  0F4C'   CD 0F34'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  0F4F'   F5                    	PUSH	PSW
  0F50'   2A 22AC'              	LHLD	OPLO
  0F53'   CD 0000*              	CALL	GOTO
  0F56'   CD 0F41'              	CALL	OPSPNL		; HL = hi - lo
  0F59'   CD 0000*              	CALL	DELFWD
  0F5C'   CD 0188'              	CALL	MARKMOD
  0F5F'   F1                    	POP	PSW
  0F60'   DA 0512'              	JC	SETFUL		; a break went: every row below it moved up
  0F63'   C3 04F7'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  0F66'                         OPA_LN:
  0F66'   3A 22A4'              	LDA	PSAVE
  0F69'   FE 63                 	CPI	'c'
  0F6B'   C2 0F74'              	JNZ	OPA_LD
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F6E'   2A 22AC'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  0F71'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  0F74'                         OPA_LD:
  0F74'   2A 22AC'              	LHLD	OPLO
  0F77'   22 22A8'              	SHLD	OPSTA
  0F7A'   22 22AA'              	SHLD	OPEND2
  0F7D'   C3 0FB4'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  0F80'                         OPALSP:
  0F80'   2A 22A8'              	LHLD	OPSTA
  0F83'   EB                    	XCHG
  0F84'   2A 22AA'              	LHLD	OPEND2
  0F87'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  0F8A'   DA 0F97'              	JC	OPAL_F
  0F8D'   22 22AC'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  0F90'   EB                    	XCHG
  0F91'   22 22AE'              	SHLD	OPHI		; hi-src = start
  0F94'   C3 0FA1'              	JMP	OPAL_R
  0F97'                         OPAL_F:
  0F97'   EB                    	XCHG			; HL = start
  0F98'   22 22AC'              	SHLD	OPLO		; lo-src = start
  0F9B'   2A 22AA'              	LHLD	OPEND2
  0F9E'   22 22AE'              	SHLD	OPHI		; hi-src = end
  0FA1'                         OPAL_R:
  0FA1'   2A 22AC'              	LHLD	OPLO
  0FA4'   CD 03DD'              	CALL	BOL
  0FA7'   22 22AC'              	SHLD	OPLO		; lo = BOL(low line)
  0FAA'   2A 22AE'              	LHLD	OPHI
  0FAD'   CD 040D'              	CALL	NLSTART
  0FB0'   22 22AE'              	SHLD	OPHI		; hi = start of line past the high line
  0FB3'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  0FB4'                         OPALIN:
  0FB4'   CD 0F80'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  0FB7'                         OPDLIN:
  0FB7'   CD 0F4C'              	CALL	OPDSPN
  0FBA'   CD 0460'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  0FBD'   DA 0FCD'              	JC	OPDL_NB
  0FC0'   CD 0000*              	CALL	LOGLEN
  0FC3'   7C                    	MOV	A,H
  0FC4'   B5                    	ORA	L
  0FC5'   C8                    	RZ			; empty buffer
  0FC6'   2B                    	DCX	H
  0FC7'   CD 03DD'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0FCA'   CD 0000*              	CALL	GOTO
  0FCD'                         OPDL_NB:
  0FCD'   C3 05BF'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  0FD0'                         OPCTAB:
  0FD0'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  0FD4'   62 00 42 00           
  0FD8'   68 00 6C 00           
  0FDC'   30 00 5E 00           
  0FE0'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  0FE2'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  0FE6'   24 01                 
  0FE8'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  0FEC'   47 02 48 02           
  0FF0'   4D 02 4C 02           
  0FF4'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  0FF6'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  0FF7'                         VCB_C:
  0FF7'   CD 1003'              	CALL	VCB_CD
  0FFA'   C3 10CE'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  0FFD'                         VCB_D:
  0FFD'   CD 1003'              	CALL	VCB_CD
  1000'   C3 105D'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1003'                         VCB_CD:
  1003'   CD 0477'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1006'   22 22AC'              	SHLD	OPLO
  1009'   CD 0000*              	CALL	CUROFF
  100C'   CD 104C'              	CALL	CEND		; to the line's content end, the CR,LF left
  100F'   22 22AE'              	SHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  1012'   C3 0F4C'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1015'                         VC_X:
  1015'   CD 0664'              	CALL	GLSTAL
  1018'   CD 04F7'              	CALL	SETLIN
  101B'   CD 0484'              	CALL	GETCNT
  101E'   22 22B0'              	SHLD	CNTV
  1021'   CD 0000*              	CALL	CUROFF
  1024'   22 22B4'              	SHLD	WKI		; cur
  1027'   CD 104C'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  102A'   EB                    	XCHG			; DE = contentend
  102B'   2A 22B4'              	LHLD	WKI		; HL = cur
  102E'   EB                    	XCHG			; HL = contentend, DE = cur
  102F'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1032'   7C                    	MOV	A,H
  1033'   B5                    	ORA	L
  1034'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1035'   EB                    	XCHG			; DE = available
  1036'   2A 22B0'              	LHLD	CNTV		; HL = count
  1039'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  103C'   DA 1042'              	JC	VX_USEA
  103F'   C3 1043'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1042'                         VX_USEA:
  1042'   EB                    	XCHG			; HL = available
  1043'                         VX_DEL:
  1043'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1046'   CD 0188'              	CALL	MARKMOD
  1049'   C3 105D'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  104C'                         CEND:
  104C'   CD 03F0'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  104F'   7C                    	MOV	A,H
  1050'   B5                    	ORA	L
  1051'   C8                    	RZ			; the start of the text: nothing before it
  1052'   2B                    	DCX	H
  1053'   E5                    	PUSH	H
  1054'   CD 0000*              	CALL	CHARAT
  1057'   E1                    	POP	H		; HL = term-1
  1058'   FE 0D                 	CPI	CR
  105A'   C8                    	RZ			; a CR before the LF -> the content ends there
  105B'   23                    	INX	H
  105C'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  105D'                         CLAMPE:
  105D'   CD 0000*              	CALL	CUROFF
  1060'   E5                    	PUSH	H
  1061'   CD 041C'              	CALL	EOLC
  1064'   D1                    	POP	D		; DE = cur
  1065'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1068'   D8                    	RC
  1069'   C8                    	RZ
  106A'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  106D'                         VC_I:
  106D'   CD 0484'              	CALL	GETCNT
  1070'   C3 10CB'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1073'                         VC_A:
  1073'   CD 0484'              	CALL	GETCNT
  1076'   CD 0460'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1079'   CA 1090'              	JZ	VA_INS
  107C'   EB                    	XCHG			; HL = cur
  107D'   E5                    	PUSH	H
  107E'   CD 0000*              	CALL	CHARAT
  1081'   E1                    	POP	H
  1082'   FE 0A                 	CPI	LF
  1084'   CA 1090'              	JZ	VA_INS		; on the line terminator -> append in place
  1087'   FE 0D                 	CPI	CR
  1089'   CA 1090'              	JZ	VA_INS
  108C'   23                    	INX	H
  108D'   CD 0000*              	CALL	GOTO
  1090'                         VA_INS:
  1090'   C3 10CB'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1093'                         VCB_A:
  1093'   CD 0477'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1096'   CD 041C'              	CALL	EOLC		; HL = last content char (the start when empty)
  1099'   E5                    	PUSH	H
  109A'   CD 0000*              	CALL	CHARAT
  109D'   E1                    	POP	H
  109E'   FE 0D                 	CPI	CR
  10A0'   CA 10A9'              	JZ	VBA_IN		; an empty line: insert at its start
  10A3'   FE 0A                 	CPI	LF
  10A5'   CA 10A9'              	JZ	VBA_IN
  10A8'   23                    	INX	H		; past the last content char
  10A9'                         VBA_IN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A9'   CD 0000*              	CALL	GOTO
  10AC'   C3 10CB'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  10AF'                         VCB_I:
  10AF'   CD 0484'              	CALL	GETCNT
  10B2'   CD 05BF'              	CALL	FNBLNK
  10B5'   CD 0000*              	CALL	CUROFF
  10B8'   E5                    	PUSH	H
  10B9'   CD 0000*              	CALL	CHARAT
  10BC'   E1                    	POP	H
  10BD'   FE 20                 	CPI	' '
  10BF'   CA 10C7'              	JZ	VBI_SK
  10C2'   FE 09                 	CPI	TAB
  10C4'   C2 10CB'              	JNZ	SETINM
  10C7'                         VBI_SK:
  10C7'   23                    	INX	H		; blanks only: past the last of them
  10C8'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  10CB'                         SETINM:
  10CB'   CD 04F1'              	CALL	SETMOV
  10CE'                         SETINS:
  10CE'   3E 01                 	MVI	A,EM_INS
  10D0'   32 2279'              	STA	EDMODE
  10D3'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  10D4'                         ATCEND:
  10D4'   CD 0460'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  10D7'   C8                    	RZ
  10D8'   CD 046B'              	CALL	CURCHR		; A = the char under the cursor
  10DB'   FE 0D                 	CPI	CR
  10DD'   C8                    	RZ
  10DE'   FE 0A                 	CPI	LF
  10E0'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  10E1'                         OPNBRK:
  10E1'   3E 0D                 	MVI	A,CR
  10E3'   CD 0000*              	CALL	PUTGAP
  10E6'   3E 0A                 	MVI	A,LF
  10E8'   CD 0000*              	CALL	PUTGAP
  10EB'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10EE'   23                    	INX	H
  10EF'   22 0000*              	SHLD	LNDLT
  10F2'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  10F5'                         ENDBRK:
  10F5'   CD 0460'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  10F8'   C0                    	RNZ
  10F9'   CD 10E1'              	CALL	OPNBRK
  10FC'   CD 0000*              	CALL	CUROFF
  10FF'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1100'   2B                    	DCX	H		;   line, with its own terminator after it
  1101'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1104'                         VC_O:
  1104'   CD 0477'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1107'   CD 104C'              	CALL	CEND
  110A'   CD 0000*              	CALL	GOTO
  110D'   CD 10E1'              	CALL	OPNBRK
  1110'   CD 10F5'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1113'   CD 04FD'              	CALL	SETILN		;   needs a terminator of its own to exist
  1116'   C3 10CE'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1119'                         VCB_O:
  1119'   CD 0477'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  111C'   CD 03DD'              	CALL	BOL
  111F'   CD 0000*              	CALL	GOTO
  1122'   CD 10E1'              	CALL	OPNBRK
  1125'   CD 0000*              	CALL	CUROFF
  1128'   2B                    	DCX	H
  1129'   2B                    	DCX	H
  112A'   CD 0000*              	CALL	GOTO
  112D'   CD 04FD'              	CALL	SETILN
  1130'   C3 10CE'              	JMP	SETINS
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1133'                         VCB_J:
  1133'   CD 0477'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1136'   CD 104C'              	CALL	CEND		; the join point: this line's content end
  1139'   22 22AC'              	SHLD	OPLO
  113C'   CD 0000*              	CALL	CUROFF
  113F'   CD 040D'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1142'   E5                    	PUSH	H
  1143'   CD 0000*              	CALL	LOGLEN
  1146'   D1                    	POP	D		; DE = that start
  1147'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  114A'   CA 04F1'              	JZ	SETMOV
  114D'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  114E'                         VJ_WS:
  114E'   E5                    	PUSH	H
  114F'   CD 0000*              	CALL	LOGLEN
  1152'   D1                    	POP	D		; DE = the scan
  1153'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1156'   CA 116D'              	JZ	VJ_DEL
  1159'   EB                    	XCHG			; HL = the scan
  115A'   E5                    	PUSH	H
  115B'   CD 0000*              	CALL	CHARAT
  115E'   E1                    	POP	H
  115F'   FE 20                 	CPI	' '
  1161'   CA 1169'              	JZ	VJ_SKIP
  1164'   FE 09                 	CPI	TAB
  1166'   C2 116D'              	JNZ	VJ_DEL
  1169'                         VJ_SKIP:
  1169'   23                    	INX	H
  116A'   C3 114E'              	JMP	VJ_WS
  116D'                         VJ_DEL:
  116D'   22 22AE'              	SHLD	OPHI
  1170'   CD 0F4C'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1173'   CD 050C'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1176'   CD 0460'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1179'   CA 105D'              	JZ	CLAMPE
  117C'   CD 046B'              	CALL	CURCHR		; the first char of what was appended
  117F'   FE 0D                 	CPI	CR
  1181'   CA 105D'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1184'   FE 0A                 	CPI	LF
  1186'   CA 105D'              	JZ	CLAMPE
  1189'   FE 29                 	CPI	')'
  118B'   CA 105D'              	JZ	CLAMPE		; vim puts no space before a ')'
  118E'   CD 0000*              	CALL	CUROFF
  1191'   7C                    	MOV	A,H
  1192'   B5                    	ORA	L
  1193'   CA 11A9'              	JZ	VJ_SP		; the very start of the text: nothing behind it
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1196'   2B                    	DCX	H
  1197'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  119A'   FE 20                 	CPI	' '
  119C'   CA 105D'              	JZ	CLAMPE
  119F'   FE 09                 	CPI	TAB
  11A1'   CA 105D'              	JZ	CLAMPE
  11A4'   FE 0A                 	CPI	LF
  11A6'   CA 105D'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  11A9'                         VJ_SP:
  11A9'   3E 20                 	MVI	A,' '
  11AB'   CD 0000*              	CALL	PUTGAP
  11AE'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  11B1'   2B                    	DCX	H
  11B2'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  11B5'                         VC_TILD:
  11B5'   CD 0484'              	CALL	GETCNT
  11B8'   CD 04F7'              	CALL	SETLIN		; only this row changes
  11BB'   CD 0664'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  11BE'   CD 0460'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11C1'   CA 04F1'              	JZ	SETMOV
  11C4'   CD 046B'              	CALL	CURCHR		; A = the char under the cursor
  11C7'   FE 0D                 	CPI	CR
  11C9'   CA 04F1'              	JZ	SETMOV		; the line's end: nothing to toggle
  11CC'   FE 0A                 	CPI	LF
  11CE'   CA 04F1'              	JZ	SETMOV
  11D1'   47                    	MOV	B,A
  11D2'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  11D4'   FE 41                 	CPI	'A'
  11D6'   DA 11E2'              	JC	VT_PUT		; below 'A': no case
  11D9'   FE 5B                 	CPI	'Z'+1
  11DB'   D2 11E2'              	JNC	VT_PUT		; above 'Z': no case
  11DE'   78                    	MOV	A,B
  11DF'   EE 20                 	XRI	20H		; a letter: flip the case bit
  11E1'   47                    	MOV	B,A
  11E2'                         VT_PUT:
  11E2'   78                    	MOV	A,B
  11E3'   32 22BD'              	STA	VRCH		; the calls below do not preserve B
  11E6'   CD 0188'              	CALL	MARKMOD
  11E9'   21 0001               	LXI	H,1
  11EC'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  11EF'   3A 22BD'              	LDA	VRCH
  11F2'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  11F5'   C3 105D'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11F8'                         VC_R:
  11F8'   CD 0471'              	CALL	MOVCNT		; a cursor motion, and its count
  11FB'   3E 03                 	MVI	A,PR
  11FD'   32 22A1'              	STA	GPEND
  1200'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1201'                         VR_DO:
  1201'   AF                    	XRA	A
  1202'   32 22A1'              	STA	GPEND
  1205'   79                    	MOV	A,C
  1206'   32 22BD'              	STA	VRCH		; the calls below do not preserve C
  1209'   CD 04F7'              	CALL	SETLIN		; only this row changed
  120C'   CD 0664'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  120F'   CD 0460'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1212'   CA 04F1'              	JZ	SETMOV		; the end of the text: vim does nothing
  1215'   CD 046B'              	CALL	CURCHR		; A = the char under the cursor
  1218'   FE 0D                 	CPI	CR
  121A'   CA 04F1'              	JZ	SETMOV		; the line's end: nothing to replace
  121D'   FE 0A                 	CPI	LF
  121F'   CA 04F1'              	JZ	SETMOV
  1222'   CD 0188'              	CALL	MARKMOD
  1225'   21 0001               	LXI	H,1
  1228'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  122B'   3A 22BD'              	LDA	VRCH
  122E'   FE 0D                 	CPI	CR
  1230'   CA 123D'              	JZ	VR_CR
  1233'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1236'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1239'   2B                    	DCX	H		;   out, which moves every logical offset
  123A'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  123D'                         VR_CR:
  123D'   CD 10E1'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1240'   CD 10F5'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1243'   CD 04FD'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1246'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1248'   32 2281'              	STA	ILABOV
  124B'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  124C'                         VCB_R:
  124C'   CD 0484'              	CALL	GETCNT
  124F'   CD 04F1'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1252'   21 0000               	LXI	H,0
  1255'   22 22BE'              	SHLD	RPDEL		; nothing of ours to put back yet
  1258'   22 22C0'              	SHLD	RPAPP
  125B'   3E 02                 	MVI	A,EM_REP
  125D'   32 2279'              	STA	EDMODE
  1260'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1261'                         VC_D:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1261'   3E 64                 	MVI	A,'d'
  1263'   32 22A3'              	STA	PENDOP
  1266'   C3 04F1'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1269'                         VC_C:
  1269'   3E 63                 	MVI	A,'c'
  126B'   32 22A3'              	STA	PENDOP
  126E'   C3 04F1'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1271'                         VD_DD:
  1271'   CD 0664'              	CALL	GLSTAL
  1274'   CD 0484'              	CALL	GETCNT
  1277'   22 22B0'              	SHLD	CNTV
  127A'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  127C'   32 22A5'              	STA	DDSNG
  127F'   2B                    	DCX	H
  1280'   7C                    	MOV	A,H
  1281'   B5                    	ORA	L
  1282'   C2 128D'              	JNZ	VDD_LS
  1285'   3E 01                 	MVI	A,1
  1287'   32 22A5'              	STA	DDSNG
  128A'   C3 1293'              	JMP	VDD_GO
  128D'                         VDD_LS:
  128D'   CD 062A'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1290'   DA 04F1'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1293'                         VDD_GO:
  1293'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1296'   CD 05A8'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1299'   2A 22B0'              	LHLD	CNTV
  129C'   CD 0000*              	CALL	SETC0
  129F'                         VDD_FW:
  129F'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  12A2'   CD 0499'              	CALL	CNTTST
  12A5'   C2 129F'              	JNZ	VDD_FW
  12A8'   CD 0188'              	CALL	MARKMOD
  12AB'   CD 079B'              	CALL	ATEOF
  12AE'   D2 12C9'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  12B1'   3E 00                 	MVI	A,0
  12B3'   32 22A5'              	STA	DDSNG		; deleted to the end: full repaint
  12B6'   CD 0BE1'              	CALL	ONFST
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12B9'   CA 05BF'              	JZ	FNBLNK		; nothing left before it
  12BC'   21 0001               	LXI	H,1		; onto the new last line
  12BF'   CD 0000*              	CALL	SETBWD
  12C2'   2A 0000*              	LHLD	LNDLT
  12C5'   2B                    	DCX	H
  12C6'   22 0000*              	SHLD	LNDLT
  12C9'                         VDD_UP:
  12C9'   CD 05BF'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  12CC'   3A 22A5'              	LDA	DDSNG
  12CF'   B7                    	ORA	A
  12D0'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  12D1'   3E 03                 	MVI	A,R_DLIN
  12D3'   32 227E'              	STA	RINTENT
  12D6'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  12D7'                         QEMPTY:
  12D7'   2A 0000*              	LHLD	QBEG
  12DA'   EB                    	XCHG
  12DB'   2A 0000*              	LHLD	QEND
  12DE'   7C                    	MOV	A,H
  12DF'   BA                    	CMP	D
  12E0'   C0                    	RNZ
  12E1'   7D                    	MOV	A,L
  12E2'   BB                    	CMP	E
  12E3'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  12E4'                         VC_Y:
  12E4'   3E 79                 	MVI	A,'y'
  12E6'   32 22A3'              	STA	PENDOP
  12E9'   C3 04F1'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  12EC'                         VY_YY:
  12EC'   CD 0000*              	CALL	CUROFF
  12EF'   22 22E1'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  12F2'   CD 03DD'              	CALL	BOL
  12F5'   22 22E3'              	SHLD	YPT		; where the lines come from, to put them back
  12F8'   CD 1409'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  12FB'   CD 144C'              	CALL	YNCOPY		; copied where they lie, if that can be done
  12FE'   D2 1410'              	JNC	YNDONE
  1301'   21 1271'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1304'   C3 1330'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1307'                         OPYANK:
  1307'   CD 0F80'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  130A'   2A 22A8'              	LHLD	OPSTA
  130D'   EB                    	XCHG			; DE = start
  130E'   2A 22AA'              	LHLD	OPEND2		; HL = end
  1311'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1314'   D2 1318'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1317'   EB                    	XCHG			; ... otherwise the start is
  1318'                         OPY_LO:
  1318'   22 22E1'              	SHLD	YOFF
  131B'   2A 22AC'              	LHLD	OPLO
  131E'   22 22E3'              	SHLD	YPT		; where the lines come from, to put them back
  1321'   CD 1409'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1324'   CD 14C4'              	CALL	YNSPAN		; copied where they lie, if there is room
  1327'   D2 1410'              	JNC	YNDONE
  132A'   21 13CD'              	LXI	H,YSPAN
  132D'   C3 1330'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1330'                         YKGO:
  1330'   22 22F9'              	SHLD	YACT
  1333'   2A 22E3'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1336'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1337'   2A 22E1'              	LHLD	YOFF		;   survive this -- the put-back below can page
  133A'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  133D'   22 22FF'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1340'   3A 227D'              	LDA	MODF
  1343'   32 22DE'              	STA	YMODF
  1346'   3A 2296'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1349'   32 22DF'              	STA	YDCHG		;   a yank must not become the last change
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  134C'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  134F'   32 22E0'              	STA	YURPL		;   back are not a change to undo either
  1352'   3E 01                 	MVI	A,1
  1354'   32 0000*              	STA	UNDRPL
  1357'   32 22F8'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  135A'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  135D'   22 22EC'              	SHLD	YLDLT
  1360'   CD 0000*              	CALL	LOGLEN
  1363'   22 22FD'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1366'   2A 22F9'              	LHLD	YACT
  1369'   CD 13CC'              	CALL	YCALL		; the lines out of the file, into the register
  136C'   CD 0000*              	CALL	LOGLEN
  136F'   EB                    	XCHG
  1370'   2A 22FD'              	LHLD	YWAS
  1373'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1376'   CA 13A4'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1379'   2A 22E3'              	LHLD	YPT
  137C'   CD 0000*              	CALL	GOTO
  137F'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1382'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  1385'   22 2301'              	SHLD	YBLK
  1388'   2A 0000*              	LHLD	QBEG
  138B'   EB                    	XCHG
  138C'   2A 0000*              	LHLD	QEND
  138F'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  1392'   EB                    	XCHG
  1393'   2A 2301'              	LHLD	YBLK
  1396'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  1399'   EB                    	XCHG
  139A'   2A 22FF'              	LHLD	YCOL
  139D'   19                    	DAD	D		; ... and the cursor is YCOL into them
  139E'   CD 0000*              	CALL	GOTO
  13A1'   C3 13AA'              	JMP	YK_RST
  13A4'                         YK_FIN:				; nothing came out, so nothing was put back and
  13A4'   2A 22E1'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  13A7'   CD 0000*              	CALL	GOTO		;   where it was
  13AA'                         YK_RST:
  13AA'   2A 22EC'              	LHLD	YLDLT
  13AD'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  13B0'   3A 22DE'              	LDA	YMODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13B3'   32 227D'              	STA	MODF
  13B6'   3A 22DF'              	LDA	YDCHG
  13B9'   32 2296'              	STA	DOTCHG
  13BC'   3A 22E0'              	LDA	YURPL
  13BF'   32 0000*              	STA	UNDRPL
  13C2'   AF                    	XRA	A
  13C3'   32 22F8'              	STA	MKHOLD
  13C6'   CD 0664'              	CALL	GLSTAL
  13C9'   C3 0512'              	JMP	SETFUL		; the cheap paint cannot carry this
  13CC'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  13CD'                         YSPAN:
  13CD'   CD 0664'              	CALL	GLSTAL
  13D0'   CD 0F41'              	CALL	OPSPNL		; HL = the span's length
  13D3'   22 22FB'              	SHLD	YTGT
  13D6'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  13D9'   EB                    	XCHG			; DE = it
  13DA'   2A 22FB'              	LHLD	YTGT
  13DD'   EB                    	XCHG			; HL = the text's, DE = the span's
  13DE'   CD 0000*              	CALL	SUBHD
  13E1'   22 22FB'              	SHLD	YTGT		; what the text is left at when the span is out
  13E4'   2A 22AC'              	LHLD	OPLO
  13E7'   CD 0000*              	CALL	GOTO
  13EA'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  13ED'                         YS_LP:
  13ED'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  13F0'   CD 0000*              	CALL	SETC0
  13F3'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  13F6'   CD 0000*              	CALL	LOGLEN
  13F9'   EB                    	XCHG			; DE = what is left
  13FA'   2A 22FB'              	LHLD	YTGT
  13FD'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1400'   DA 1406'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1403'   C2 13ED'              	JNZ	YS_LP		;   but never spin here if it ever did
  1406'                         YS_END:
  1406'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1409'                         YNPRE:
  1409'   2A 0000*              	LHLD	PGTOPM
  140C'   22 2303'              	SHLD	YNPG
  140F'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; dropped, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1410'                         YNDONE:
  1410'   2A 22E1'              	LHLD	YOFF
  1413'   CD 0000*              	CALL	GOTO
  1416'   2A 0000*              	LHLD	PGTOPM
  1419'   EB                    	XCHG
  141A'   2A 2303'              	LHLD	YNPG
  141D'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1420'   C2 0512'              	JNZ	SETFUL		; it moved under us: repaint after all
  1423'   C3 04F1'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1426'                         YNROOM:
  1426'   11 0100               	LXI	D,100H
  1429'   19                    	DAD	D
  142A'   D8                    	RC			; within a chunk of 64K: no arena holds that
  142B'   E5                    	PUSH	H		; the span plus its slack
  142C'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  142F'   EB                    	XCHG			; HL = free
  1430'   D1                    	POP	D		; DE = the span plus its slack
  1431'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1434'   DA 143C'              	JC	YNR_OK
  1437'   CA 143C'              	JZ	YNR_OK
  143A'   37                    	STC			; not enough: the delete-and-put-back path
  143B'   C9                    	RET
  143C'                         YNR_OK:
  143C'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  143D'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  143E'                         YNGO:
  143E'   C5                    	PUSH	B
  143F'   CD 0484'              	CALL	GETCNT		; spent here: this yank is happening
  1442'   CD 0664'              	CALL	GLSTAL
  1445'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1448'   C1                    	POP	B
  1449'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  144C'                         YNCOPY:
  144C'   2A 227A'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  144F'   7C                    	MOV	A,H		;   the count itself
  1450'   B5                    	ORA	L
  1451'   C2 1457'              	JNZ	YNC_HV
  1454'   21 0001               	LXI	H,1
  1457'                         YNC_HV:
  1457'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1458'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1459'   B4                    	ORA	H
  145A'   CA 1465'              	JZ	YNC_M
  145D'   E5                    	PUSH	H
  145E'   CD 062A'              	CALL	ONLAST		; vim: a count over one on the last line does
  1461'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1462'   DA 1477'              	JC	YNC_RF
  1465'                         YNC_M:
  1465'   E5                    	PUSH	H
  1466'   CD 05A8'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1469'   E1                    	POP	H
  146A'   CD 147F'              	CALL	YNLINE		; BC = the span, measured where it stands
  146D'   D8                    	RC			; not measurable here: let the pager answer it
  146E'   60                    	MOV	H,B
  146F'   69                    	MOV	L,C
  1470'   CD 1426'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1473'   D8                    	RC			; no: the delete-and-put-back path
  1474'   C3 143E'              	JMP	YNGO
  1477'                         YNC_RF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1477'   CD 0484'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  147A'   CD 0664'              	CALL	GLSTAL		;   register alone, and that is the command
  147D'   B7                    	ORA	A		; NC: done
  147E'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  147F'                         YNLINE:
  147F'   22 2305'              	SHLD	YNCNT		; the lines it still wants
  1482'   2A 0000*              	LHLD	GAPEND
  1485'                         YNL_LP:
  1485'   EB                    	XCHG			; DE = the scan
  1486'   2A 0000*              	LHLD	TXTEND
  1489'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  148C'   EB                    	XCHG			; HL = the scan
  148D'   D2 14AD'              	JNC	YNL_EN		; the resident text ran out
  1490'   7E                    	MOV	A,M
  1491'   23                    	INX	H
  1492'   FE 0A                 	CPI	LF
  1494'   C2 1485'              	JNZ	YNL_LP
  1497'   E5                    	PUSH	H
  1498'   2A 2305'              	LHLD	YNCNT
  149B'   2B                    	DCX	H
  149C'   22 2305'              	SHLD	YNCNT
  149F'   7C                    	MOV	A,H
  14A0'   B5                    	ORA	L
  14A1'   E1                    	POP	H
  14A2'   C2 1485'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  14A5'   EB                    	XCHG			; DE = past the last of them
  14A6'   2A 0000*              	LHLD	GAPEND
  14A9'   EB                    	XCHG			; HL = past them, DE = GAPEND
  14AA'   C3 14BB'              	JMP	YNL_BC
  14AD'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  14AD'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  14B0'   C2 14C2'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  14B3'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  14B6'   EB                    	XCHG			;   count clamps to it as vim's does
  14B7'   2A 0000*              	LHLD	GAPEND
  14BA'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  14BB'                         YNL_BC:
  14BB'   CD 0000*              	CALL	SUBHD		; HL = the span
  14BE'   44                    	MOV	B,H
  14BF'   4D                    	MOV	C,L
  14C0'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  14C1'   C9                    	RET
  14C2'                         YNL_NO:
  14C2'   37                    	STC
  14C3'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  14C4'                         YNSPAN:
  14C4'   CD 0F41'              	CALL	OPSPNL		; HL = the span's length
  14C7'   44                    	MOV	B,H
  14C8'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  14C9'   CD 1426'              	CALL	YNROOM
  14CC'   D8                    	RC			; no room: the delete-and-put-back path
  14CD'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  14CE'   2A 22AC'              	LHLD	OPLO
  14D1'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  14D4'   C1                    	POP	B
  14D5'   C3 143E'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  14D8'                         VC_P:
  14D8'   CD 12D7'              	CALL	QEMPTY
  14DB'   CA 1593'              	JZ	VP_BEL
  14DE'   CD 0484'              	CALL	GETCNT
  14E1'   22 22E5'              	SHLD	PCNT
  14E4'   CD 0000*              	CALL	CUROFF
  14E7'   CD 040D'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  14EA'   C3 14FF'              	JMP	VP_GO
  14ED'                         VCB_P:
  14ED'   CD 12D7'              	CALL	QEMPTY
  14F0'   CA 1593'              	JZ	VP_BEL
  14F3'   CD 0484'              	CALL	GETCNT
  14F6'   22 22E5'              	SHLD	PCNT
  14F9'   CD 0000*              	CALL	CUROFF
  14FC'   CD 03DD'              	CALL	BOL
  14FF'                         VP_GO:
  14FF'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1502'   CD 0000*              	CALL	CUROFF
  1505'   EB                    	XCHG
  1506'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1509'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  150C'   DA 1521'              	JC	VP_IN
  150F'   EB                    	XCHG			; HL = the put point = LOGLEN
  1510'   7C                    	MOV	A,H
  1511'   B5                    	ORA	L
  1512'   CA 151E'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1515'   2B                    	DCX	H
  1516'   CD 0000*              	CALL	CHARAT
  1519'   FE 0A                 	CPI	LF
  151B'   CA 1521'              	JZ	VP_IN
  151E'                         VP_BRK:
  151E'   CD 10E1'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1521'                         VP_IN:
  1521'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1524'   22 22E7'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1527'   2A 0000*              	LHLD	QBEG
  152A'   EB                    	XCHG
  152B'   2A 0000*              	LHLD	QEND
  152E'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1531'   EB                    	XCHG
  1532'   22 22E9'              	SHLD	PLFS
  1535'   2A 22E5'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1538'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1539'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  153A'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  153C'   C2 1540'              	JNZ	VP_PZ
  153F'   7D                    	MOV	A,L
  1540'                         VP_PZ:
  1540'   32 22EB'              	STA	PCPY
  1543'                         VP_LP:
  1543'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1546'   2A 0000*              	LHLD	LNDLT
  1549'   EB                    	XCHG
  154A'   2A 22E9'              	LHLD	PLFS
  154D'   19                    	DAD	D
  154E'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1551'   2A 22E5'              	LHLD	PCNT
  1554'   2B                    	DCX	H
  1555'   22 22E5'              	SHLD	PCNT
  1558'   7C                    	MOV	A,H
  1559'   B5                    	ORA	L
  155A'   C2 1543'              	JNZ	VP_LP
  155D'   CD 0188'              	CALL	MARKMOD
  1560'   2A 22E7'              	LHLD	PPT
  1563'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1566'   CD 0664'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1569'   3A 22EB'              	LDA	PCPY
  156C'   B7                    	ORA	A
  156D'   CA 05BF'              	JZ	FNBLNK
  1570'   2A 22E9'              	LHLD	PLFS
  1573'   7C                    	MOV	A,H
  1574'   B7                    	ORA	A
  1575'   C2 05BF'              	JNZ	FNBLNK
  1578'   3A 22EB'              	LDA	PCPY
  157B'   CD 0B77'              	CALL	MULSAT		; HL = the lines this put put, saturated
  157E'   7C                    	MOV	A,H
  157F'   B7                    	ORA	A
  1580'   C2 05BF'              	JNZ	FNBLNK
  1583'   7D                    	MOV	A,L
  1584'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1585'   CA 05BF'              	JZ	FNBLNK
  1588'   F5                    	PUSH	PSW
  1589'   CD 04FD'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  158C'   F1                    	POP	PSW
  158D'   32 227F'              	STA	ILN		; ... which the lines put now replace
  1590'   C3 05BF'              	JMP	FNBLNK
  1593'                         VP_BEL:
  1593'   CD 0484'              	CALL	GETCNT		; the count is spent either way
  1596'   0E 07                 	MVI	C,BEL
  1598'   CD 0000*              	CALL	BCONOU
  159B'   C3 04F1'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  159E'                         VIREP:
  159E'   78                    	MOV	A,B
  159F'   FE 01                 	CPI	KT_ACT
  15A1'   CA 16CE'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  15A4'   FE 02                 	CPI	KT_CHAR
  15A6'   C0                    	RNZ			; ignore anything else
  15A7'   79                    	MOV	A,C
  15A8'   FE 0D                 	CPI	CR
  15AA'   CA 160E'              	JZ	VP_CR
  15AD'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  15AF'   CA 160E'              	JZ	VP_CR
  15B2'   FE 08                 	CPI	BS
  15B4'   CA 161A'              	JZ	VP_BS
  15B7'   FE 7F                 	CPI	DEL
  15B9'   CA 161A'              	JZ	VP_BS
  15BC'   32 22BD'              	STA	VRCH		; the calls below do not preserve C
  15BF'   CD 04F7'              	CALL	SETLIN		; this row changed
  15C2'   CD 0188'              	CALL	MARKMOD
  15C5'   CD 10D4'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  15C8'   CA 1600'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  15CB'   3A 22BD'              	LDA	VRCH
  15CE'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15D1'   2A 22BE'              	LHLD	RPDEL
  15D4'   7C                    	MOV	A,H
  15D5'   B5                    	ORA	L
  15D6'   CA 15EC'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  15D9'   2A 0000*              	LHLD	GAPEND
  15DC'   EB                    	XCHG
  15DD'   2A 22C2'              	LHLD	RPGE
  15E0'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  15E3'   CA 15EC'              	JZ	VP_OVW
  15E6'   21 0000               	LXI	H,0
  15E9'   22 22BE'              	SHLD	RPDEL		; the text moved: those originals are gone
  15EC'                         VP_OVW:
  15EC'   21 0001               	LXI	H,1
  15EF'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  15F2'   2A 0000*              	LHLD	GAPEND
  15F5'   22 22C2'              	SHLD	RPGE
  15F8'   2A 22BE'              	LHLD	RPDEL
  15FB'   23                    	INX	H
  15FC'   22 22BE'              	SHLD	RPDEL
  15FF'   C9                    	RET
  1600'                         VP_APP:
  1600'   3A 22BD'              	LDA	VRCH
  1603'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1606'   2A 22C0'              	LHLD	RPAPP
  1609'   23                    	INX	H
  160A'   22 22C0'              	SHLD	RPAPP
  160D'   C9                    	RET
  160E'                         VP_CR:
  160E'   21 0000               	LXI	H,0
  1611'   22 22BE'              	SHLD	RPDEL		; a line break ends what BS can put back
  1614'   22 22C0'              	SHLD	RPAPP
  1617'   C3 16A4'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  161A'                         VP_BS:
  161A'   2A 22C0'              	LHLD	RPAPP
  161D'   7C                    	MOV	A,H
  161E'   B5                    	ORA	L
  161F'   CA 162C'              	JZ	VP_BSD
  1622'   2B                    	DCX	H
  1623'   22 22C0'              	SHLD	RPAPP		; an appended char: it just goes
  1626'   CD 04F7'              	CALL	SETLIN
  1629'   C3 0000*              	JMP	DELPRV
  162C'                         VP_BSD:
  162C'   2A 22BE'              	LHLD	RPDEL
  162F'   7C                    	MOV	A,H
  1630'   B5                    	ORA	L
  1631'   CA 1658'              	JZ	VP_BSM		; nothing of ours left
  1634'   2A 0000*              	LHLD	GAPEND
  1637'   EB                    	XCHG
  1638'   2A 22C2'              	LHLD	RPGE
  163B'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  163E'   C2 1658'              	JNZ	VP_BSM
  1641'   2A 22BE'              	LHLD	RPDEL
  1644'   2B                    	DCX	H
  1645'   22 22BE'              	SHLD	RPDEL
  1648'   CD 04F7'              	CALL	SETLIN
  164B'   CD 0000*              	CALL	DELPRV		; the typed char goes
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  164E'   CD 0000*              	CALL	UNDELF		; the original comes back
  1651'   2A 0000*              	LHLD	GAPEND
  1654'   22 22C2'              	SHLD	RPGE
  1657'   C9                    	RET
  1658'                         VP_BSM:
  1658'   CD 04F1'              	CALL	SETMOV		; nothing changed: back over the text as it is
  165B'   C3 0560'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  165E'                         VIINS:
  165E'   78                    	MOV	A,B
  165F'   FE 01                 	CPI	KT_ACT
  1661'   CA 16CE'              	JZ	VI_ACT
  1664'   FE 02                 	CPI	KT_CHAR
  1666'   C0                    	RNZ			; ignore anything else
  1667'   79                    	MOV	A,C
  1668'   FE 0D                 	CPI	CR
  166A'   CA 16A4'              	JZ	VI_CR
  166D'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  166F'   CA 16A4'              	JZ	VI_CR
  1672'   FE 08                 	CPI	BS
  1674'   CA 16BC'              	JZ	VI_BS
  1677'   FE 7F                 	CPI	DEL
  1679'   CA 16BC'              	JZ	VI_BS
  167C'   79                    	MOV	A,C
  167D'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1680'   CD 0188'              	CALL	MARKMOD
  1683'   CD 04F7'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1686'   79                    	MOV	A,C
  1687'   FE 20                 	CPI	' '
  1689'   D8                    	RC			; control char -> keep R_LINE
  168A'   FE 7F                 	CPI	DEL
  168C'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  168D'   CD 0518'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1690'   B7                    	ORA	A
  1691'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1692'   3E 04                 	MVI	A,R_ICH
  1694'   32 227E'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1697'   CD 10D4'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  169A'   3E 00                 	MVI	A,0
  169C'   C2 16A0'              	JNZ	VI_ICH
  169F'   3C                    	INR	A
  16A0'                         VI_ICH:
  16A0'   32 2280'              	STA	ICHAPP
  16A3'   C9                    	RET
  16A4'                         VI_CR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  16A4'   CD 10D4'              	CALL	ATCEND
  16A7'   3E 00                 	MVI	A,0
  16A9'   CA 16AD'              	JZ	VI_CRS
  16AC'   3C                    	INR	A
  16AD'                         VI_CRS:
  16AD'   F5                    	PUSH	PSW
  16AE'   CD 10E1'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  16B1'   CD 10F5'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  16B4'   CD 04FD'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  16B7'   F1                    	POP	PSW
  16B8'   32 2281'              	STA	ILABOV
  16BB'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  16BC'                         VI_BS:
  16BC'   CD 0000*              	CALL	PEEKL
  16BF'   D8                    	RC			; start of the file: nothing to delete
  16C0'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  16C2'   CA 16C8'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  16C5'   CD 04F7'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  16C8'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  16C8'   CD 0188'              	CALL	MARKMOD
  16CB'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  16CE'                         VI_ACT:
  16CE'   79                    	MOV	A,C
  16CF'   FE 0B                 	CPI	ACT_ESC
  16D1'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  16D2'   3E 00                 	MVI	A,EM_CMD
  16D4'   32 2279'              	STA	EDMODE
  16D7'   CD 04F1'              	CALL	SETMOV
  16DA'   CD 0560'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  16DD'   C3 0664'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does; a control char is ignored (WM stores it
                                ; and shows ^X).  WM's ^X ^U ^\ ^R ^E ^C line edits are not kept.
  16E0'                         RDLINE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16E0'   EB                    	XCHG			; HL = buffer
  16E1'   22 22C4'              	SHLD	RLPTR
  16E4'   3E 00                 	MVI	A,0
  16E6'   32 22C6'              	STA	RLLEN
  16E9'   78                    	MOV	A,B
  16EA'   32 22C7'              	STA	RLMAX
  16ED'   79                    	MOV	A,C
  16EE'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  16F1'                         RL_LP:
  16F1'   CD 0000*              	CALL	GETKEY
  16F4'   78                    	MOV	A,B
  16F5'   FE 01                 	CPI	KT_ACT
  16F7'   CA 174D'              	JZ	RL_ACT
  16FA'   FE 02                 	CPI	KT_CHAR
  16FC'   C2 16F1'              	JNZ	RL_LP		; ignore other keys
  16FF'   79                    	MOV	A,C
  1700'   FE 0D                 	CPI	CR
  1702'   CA 1759'              	JZ	RL_DONE
  1705'   FE 08                 	CPI	BS
  1707'   CA 1735'              	JZ	RL_BS
  170A'   FE 7F                 	CPI	DEL
  170C'   CA 1735'              	JZ	RL_BS
  170F'   FE 20                 	CPI	' '
  1711'   DA 16F1'              	JC	RL_LP		; control char -> ignore
  1714'   3A 22C6'              	LDA	RLLEN
  1717'   47                    	MOV	B,A
  1718'   3A 22C7'              	LDA	RLMAX
  171B'   B8                    	CMP	B
  171C'   CA 16F1'              	JZ	RL_LP		; full -> ignore
  171F'   2A 22C4'              	LHLD	RLPTR
  1722'   71                    	MOV	M,C
  1723'   23                    	INX	H
  1724'   22 22C4'              	SHLD	RLPTR
  1727'   3A 22C6'              	LDA	RLLEN
  172A'   3C                    	INR	A
  172B'   32 22C6'              	STA	RLLEN
  172E'   79                    	MOV	A,C
  172F'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1732'   C3 16F1'              	JMP	RL_LP
  1735'                         RL_BS:				; WM LINEPOP
  1735'   3A 22C6'              	LDA	RLLEN
  1738'   B7                    	ORA	A
  1739'   CA 1753'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  173C'   3D                    	DCR	A
  173D'   32 22C6'              	STA	RLLEN
  1740'   2A 22C4'              	LHLD	RLPTR
  1743'   2B                    	DCX	H
  1744'   22 22C4'              	SHLD	RLPTR
  1747'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  174A'   C3 16F1'              	JMP	RL_LP
  174D'                         RL_ACT:
  174D'   79                    	MOV	A,C
  174E'   FE 0B                 	CPI	ACT_ESC
  1750'   C2 16F1'              	JNZ	RL_LP
  1753'                         RL_CAN:
  1753'   CD 04F7'              	CALL	SETLIN		; redraw one row; the cancelled line stays, as vim's
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1756'   3E FF                 	MVI	A,0FFH		; cancelled
  1758'   C9                    	RET
  1759'                         RL_DONE:
  1759'   AF                    	XRA	A
  175A'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  175B'                         VC_BZ:
  175B'   CD 04F1'              	CALL	SETMOV
  175E'   3A 22A2'              	LDA	GSAVE
  1761'   FE 02                 	CPI	PZ
  1763'   CA 176E'              	JZ	VZ_ZZ
  1766'   B7                    	ORA	A
  1767'   C0                    	RNZ			; 'g' was pending: vim drops both
  1768'   3E 02                 	MVI	A,PZ
  176A'   32 22A1'              	STA	GPEND
  176D'   C9                    	RET
  176E'                         VZ_ZZ:
  176E'   3E 04                 	MVI	A,EO_X
  1770'   32 22C8'              	STA	EXOP
  1773'   3E 01                 	MVI	A,1
  1775'   32 22DB'              	STA	EXBANG		; no '!'
  1778'   AF                    	XRA	A
  1779'   32 22C9'              	STA	EXARG		; no file name
  177C'   3A 227D'              	LDA	MODF		; as ':x': a changed text is written first
  177F'   B7                    	ORA	A
  1780'   CA 18A3'              	JZ	EX_Q
  1783'   C3 183D'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1786'                         VC_EX:
  1786'   CD 0484'              	CALL	GETCNT
  1789'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  178C'   11 0000*              	LXI	D,EXBUF
  178F'   06 28                 	MVI	B,EXMAX
  1791'   0E 3A                 	MVI	C,':'
  1793'   CD 16E0'              	CALL	RDLINE
  1796'   B7                    	ORA	A
  1797'   C0                    	RNZ			; cancelled
  1798'   3A 22C6'              	LDA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  179B'   5F                    	MOV	E,A
  179C'   16 00                 	MVI	D,0
  179E'   21 0000*              	LXI	H,EXBUF
  17A1'   19                    	DAD	D
  17A2'   36 00                 	MVI	M,0		; the line ends with a 0
  17A4'   21 0000*              	LXI	H,EXBUF
  17A7'   CD 1B3F'              	CALL	SKIPB
  17AA'   C8                    	RZ			; nothing on it
  17AB'   22 22CB'              	SHLD	EXCMD
  17AE'   CD 1CDC'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  17B1'   CD 1B3F'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  17B4'   56                    	MOV	D,M
  17B5'   23                    	INX	H
  17B6'   1E 00                 	MVI	E,0
  17B8'   CD 1B4B'              	CALL	ISLOW
  17BB'   DA 17C6'              	JC	EX_LK
  17BE'   5F                    	MOV	E,A
  17BF'   23                    	INX	H
  17C0'   CD 1B4B'              	CALL	ISLOW
  17C3'   D2 17DF'              	JNC	EX_NOT		; a third letter: none of ours
  17C6'                         EX_LK:
  17C6'   E5                    	PUSH	H
  17C7'   21 1CC6'              	LXI	H,EXTAB
  17CA'                         EX_TL:
  17CA'   7E                    	MOV	A,M
  17CB'   B7                    	ORA	A
  17CC'   CA 17DE'              	JZ	EX_NTP		; not in the table
  17CF'   23                    	INX	H
  17D0'   BA                    	CMP	D
  17D1'   7E                    	MOV	A,M
  17D2'   23                    	INX	H
  17D3'   C2 17DA'              	JNZ	EX_TN
  17D6'   BB                    	CMP	E
  17D7'   CA 17E5'              	JZ	EX_TF
  17DA'                         EX_TN:
  17DA'   23                    	INX	H
  17DB'   C3 17CA'              	JMP	EX_TL
  17DE'                         EX_NTP:
  17DE'   E1                    	POP	H
  17DF'                         EX_NOT:
  17DF'   21 1C03'              	LXI	H,SNOT
  17E2'   C3 1B80'              	JMP	EXERT
  17E5'                         EX_TF:
  17E5'   7E                    	MOV	A,M
  17E6'   32 22C8'              	STA	EXOP
  17E9'   E1                    	POP	H
  17EA'   FE 06                 	CPI	EO_S
  17EC'   CA 1D4B'              	JZ	EX_S		; ':s' reads the rest of the line itself
  17EF'   3A 230E'              	LDA	SRNGF
  17F2'   B7                    	ORA	A
  17F3'   C2 17DF'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  17F6'   7E                    	MOV	A,M
  17F7'   D6 21                 	SUI	'!'
  17F9'   32 22DB'              	STA	EXBANG		; 0 = '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17FC'   C2 1800'              	JNZ	EX_NB
  17FF'   23                    	INX	H
  1800'                         EX_NB:
  1800'   CD 1B3F'              	CALL	SKIPB
  1803'   32 22C9'              	STA	EXARG		; 0 = no file name
  1806'   CA 181F'              	JZ	EX_RUN
  1809'   22 22CB'              	SHLD	EXCMD
  180C'   3A 22C8'              	LDA	EXOP
  180F'   FE 02                 	CPI	EO_Q
  1811'   CA 1B7D'              	JZ	EX_TRL		; :q takes none
  1814'   FE 07                 	CPI	EO_V
  1816'   CA 1B7D'              	JZ	EX_TRL		; nor :ve
  1819'   CD 1AA9'              	CALL	PARSFN
  181C'   C2 1B71'              	JNZ	EX_INV
  181F'                         EX_RUN:
  181F'   3A 22C8'              	LDA	EXOP
  1822'   FE 05                 	CPI	EO_E
  1824'   CA 18BA'              	JZ	EX_E
  1827'   FE 02                 	CPI	EO_Q
  1829'   CA 18A3'              	JZ	EX_Q
  182C'   FE 07                 	CPI	EO_V
  182E'   CA 1B77'              	JZ	EX_V
  1831'   FE 04                 	CPI	EO_X
  1833'   C2 183D'              	JNZ	EX_W
  1836'   3A 227D'              	LDA	MODF		; :x writes only a changed text
  1839'   B7                    	ORA	A
  183A'   CA 18A3'              	JZ	EX_Q
  183D'                         EX_W:
  183D'   CD 1911'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1840'   D8                    	RC			; refused (message shown)
  1841'   32 22CA'              	STA	EXBAK
  1844'   3A 22C8'              	LDA	EXOP
  1847'   FE 01                 	CPI	EO_W
  1849'   CA 1860'              	JZ	EX_WK
  184C'   3A 22CA'              	LDA	EXBAK
  184F'   B7                    	ORA	A
  1850'   C2 18A0'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1853'   3A 22DB'              	LDA	EXBANG
  1856'   B7                    	ORA	A
  1857'   CA 18A0'              	JZ	EX_WQ		; so it does with '!'
  185A'   CD 1860'              	CALL	EX_WK		; else it may not: keep the text
  185D'   C3 18A3'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1860'                         EX_WK:
  1860'   CD 0A83'              	CALL	CURRW		; the cursor's row and file position
  1863'   32 22CD'              	STA	WPROW
  1866'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1869'   7D                    	MOV	A,L
  186A'   E6 7F                 	ANI	7FH
  186C'   32 22CE'              	STA	WPBYT
  186F'   7D                    	MOV	A,L
