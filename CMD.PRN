  10DB'   3A 0000*              	LDA	HFN
  10DE'   57                    	MOV	D,A		; D = the rows the text moves
  10DF'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10E0'   3A 0000*              	LDA	HTEOF
