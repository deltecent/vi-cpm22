                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	HTN, HTCUR, HTEOF, HTBOF	; the row table's facts (SCRN.MAC HTBLD)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 2DEB'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00D7'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 011C'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2D2B'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1E97'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1DDB'              	JMP	VIREP
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   79                    	MOV	A,C
  0024'   FE 1B                 	CPI	ESC
  0026'   CA 00AC'              	JZ	VIC_ESC
  0029'   3A 2D5F'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002C'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002E'   CA 19CA'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0031'   79                    	MOV	A,C
  0032'   FE 31                 	CPI	'1'
  0034'   DA 003F'              	JC	VIC_NOTD	; < '1'
  0037'   FE 3A                 	CPI	'9'+1
  0039'   D2 003F'              	JNC	VIC_NOTD	; > '9'
  003C'   C3 004F'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003F'                         VIC_NOTD:
  003F'   79                    	MOV	A,C
  0040'   FE 30                 	CPI	'0'
  0042'   C2 0077'              	JNZ	VICDSP
  0045'   2A 2D2C'              	LHLD	CMDCNT
  0048'   7C                    	MOV	A,H
  0049'   B5                    	ORA	L
  004A'   CA 0077'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004D'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004F'                         VICDIG:
  004F'   2A 2D2C'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0052'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0053'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0054'   29                    	DAD	H		; *2
  0055'   DA 006E'              	JC	VIC_SAT
  0058'   29                    	DAD	H		; *4
  0059'   DA 006E'              	JC	VIC_SAT
  005C'   19                    	DAD	D		; *5
  005D'   DA 006E'              	JC	VIC_SAT
  0060'   29                    	DAD	H		; *10
  0061'   DA 006E'              	JC	VIC_SAT
  0064'   79                    	MOV	A,C
  0065'   D6 30                 	SUI	'0'
  0067'   5F                    	MOV	E,A
  0068'   16 00                 	MVI	D,0
  006A'   19                    	DAD	D
  006B'   D2 0071'              	JNC	VIC_CNT
  006E'                         VIC_SAT:
  006E'   21 FFFF               	LXI	H,0FFFFH
  0071'                         VIC_CNT:
  0071'   22 2D2C'              	SHLD	CMDCNT
  0074'   C3 07A0'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0077'                         VICDSP:
  0077'   3A 2D5F'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007A'   32 2D60'              	STA	GSAVE
  007D'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007E'   32 2D5F'              	STA	GPEND
  0081'   3A 2D61'              	LDA	PENDOP
  0084'   32 2D62'              	STA	PSAVE
  0087'   AF                    	XRA	A
  0088'   32 2D61'              	STA	PENDOP
  008B'   3A 2D62'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008E'   B7                    	ORA	A
  008F'   C2 134D'              	JNZ	OPPEND
  0092'   3A 2D60'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0095'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0097'   C2 00A0'              	JNZ	VIC_TB
  009A'   79                    	MOV	A,C
  009B'   FE 5A                 	CPI	'Z'
  009D'   C2 00A6'              	JNZ	VIC_SW
  00A0'                         VIC_TB:
  00A0'   21 2C73'              	LXI	H,CMDTAB
  00A3'   C3 00BC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A6'                         VIC_SW:
  00A6'   CD 07A0'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A9'   C3 06CB'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AC'                         VIC_ESC:
  00AC'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00AD'   32 2D5F'              	STA	GPEND
  00B0'   32 2D60'              	STA	GSAVE
  00B3'   32 2D61'              	STA	PENDOP
  00B6'   32 2D62'              	STA	PSAVE
  00B9'   C3 00A6'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BC'                         VSCANQ:
  00BC'   CD 00C8'              	CALL	VSCLK
  00BF'   CA 00A6'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C2'   E9                    	PCHL
  00C3'                         VSCAN:
  00C3'   CD 00C8'              	CALL	VSCLK
  00C6'   C8                    	RZ			; miss
  00C7'   E9                    	PCHL
  00C8'                         VSCLK:
  00C8'   7E                    VSCAN1: MOV	A,M
  00C9'   B7                    	ORA	A
  00CA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CB'   23                    	INX	H
  00CC'   B9                    	CMP	C
  00CD'   5E                    	MOV	E,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CE'   23                    	INX	H
  00CF'   56                    	MOV	D,M
  00D0'   23                    	INX	H
  00D1'   C2 00C8'              	JNZ	VSCAN1
  00D4'   EB                    	XCHG			; HL = the handler
  00D5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D7'                         DOTPRE:
  00D7'   3A 2D56'              	LDA	DOTRPL
  00DA'   B7                    	ORA	A
  00DB'   C0                    	RNZ			; the replay's own keys are not recorded
  00DC'   C5                    	PUSH	B
  00DD'   D5                    	PUSH	D
  00DE'   E5                    	PUSH	H
  00DF'   3A 2D55'              	LDA	DOTSTA
  00E2'   B7                    	ORA	A
  00E3'   CA 00F6'              	JZ	DOTP1
  00E6'   AF                    	XRA	A		; a new command: the recording starts over
  00E7'   32 2D55'              	STA	DOTSTA
  00EA'   32 2D57'              	STA	DOTOVF
  00ED'   21 0000*              	LXI	H,DOTSCR
  00F0'   22 2D59'              	SHLD	DOTSP
  00F3'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F6'                         DOTP1:
  00F6'   79                    	MOV	A,C
  00F7'   32 2D58'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00FA'   47                    	MOV	B,A
  00FB'   2A 2D59'              	LHLD	DOTSP
  00FE'   EB                    	XCHG
  00FF'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0102'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0105'   D2 0114'              	JNC	DOTPOV
  0108'   2A 2D59'              	LHLD	DOTSP
  010B'   70                    	MOV	M,B
  010C'   23                    	INX	H
  010D'   22 2D59'              	SHLD	DOTSP
  0110'                         DOTPX:
  0110'   E1                    	POP	H
  0111'   D1                    	POP	D
  0112'   C1                    	POP	B
  0113'   C9                    	RET
  0114'                         DOTPOV:
  0114'   3E 01                 	MVI	A,1
  0116'   32 2D57'              	STA	DOTOVF		; too long to record: give this recording up
  0119'   C3 0110'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011C'                         DOTPOST:
  011C'   3A 2D56'              	LDA	DOTRPL
  011F'   B7                    	ORA	A
  0120'   C0                    	RNZ
  0121'   3A 2D2B'              	LDA	EDMODE
  0124'   B7                    	ORA	A
  0125'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0126'   3A 2D5F'              	LDA	GPEND
  0129'   B7                    	ORA	A
  012A'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012B'   3A 2D61'              	LDA	PENDOP
  012E'   B7                    	ORA	A
  012F'   C0                    	RNZ			; an operator still waiting for its motion
  0130'   2A 2D2C'              	LHLD	CMDCNT
  0133'   7C                    	MOV	A,H
  0134'   B5                    	ORA	L
  0135'   CA 0143'              	JZ	DOTQ1
  0138'   3A 2D58'              	LDA	DOTLK		; a digit with the count still up: the command
  013B'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  013D'   DA 0143'              	JC	DOTQ1
  0140'   FE 3A                 	CPI	'9'+1
  0142'   D8                    	RC
  0143'                         DOTQ1:
  0143'   3E 01                 	MVI	A,1
  0145'   32 2D55'              	STA	DOTSTA		; the next key starts a new recording
  0148'   3A 2D54'              	LDA	DOTCHG
  014B'   B7                    	ORA	A
  014C'   C8                    	RZ			; changed nothing: not a repeatable command
  014D'   AF                    	XRA	A
  014E'   32 2D54'              	STA	DOTCHG
  0151'   32 2D5B'              	STA	DOTLEN
  0154'   3A 2D57'              	LDA	DOTOVF
  0157'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0158'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0159'   2A 2D59'              	LHLD	DOTSP
  015C'   11 0000*              	LXI	D,DOTSCR
  015F'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0162'   7D                    	MOV	A,L
  0163'   32 2D5B'              	STA	DOTLEN
  0166'   B7                    	ORA	A
  0167'   C8                    	RZ
  0168'   4F                    	MOV	C,A
  0169'   06 00                 	MVI	B,0
  016B'   21 0000*              	LXI	H,DOTSCR
  016E'   11 0000*              	LXI	D,DOTBUF
  0171'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0174'                         MARKMOD:
  0174'   3E 01                 	MVI	A,1
  0176'   32 2D2F'              	STA	MODF
  0179'   32 2D54'              	STA	DOTCHG
  017C'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  017D'                         VC_DOT:
  017D'   2A 2D2C'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0180'   22 2D5D'              	SHLD	DOTNCT
  0183'   21 0000               	LXI	H,0
  0186'   22 2D2C'              	SHLD	CMDCNT
  0189'   3A 2D5B'              	LDA	DOTLEN
  018C'   B7                    	ORA	A
  018D'   CA 01DC'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0190'   AF                    	XRA	A
  0191'   32 2D5C'              	STA	DOTIX
  0194'   2A 2D5D'              	LHLD	DOTNCT
  0197'   7C                    	MOV	A,H
  0198'   B5                    	ORA	L
  0199'   CA 01B9'              	JZ	DOTGO
  019C'   22 2D2C'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  019F'                         DOTSKP:
  019F'   CD 05A4'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A2'   DA 01B9'              	JC	DOTGO
  01A5'   FE 30                 	CPI	'0'
  01A7'   DA 01B9'              	JC	DOTGO
  01AA'   FE 3A                 	CPI	'9'+1
  01AC'   D2 01B9'              	JNC	DOTGO
  01AF'   3A 2D5C'              	LDA	DOTIX
  01B2'   3C                    	INR	A
  01B3'   32 2D5C'              	STA	DOTIX
  01B6'   C3 019F'              	JMP	DOTSKP
  01B9'                         DOTGO:
  01B9'   3E 01                 	MVI	A,1
  01BB'   32 2D56'              	STA	DOTRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01BE'                         DOTLP:
  01BE'   CD 05A4'              	CALL	DOTGET
  01C1'   DA 01D2'              	JC	DOTDN
  01C4'   4F                    	MOV	C,A
  01C5'   3A 2D5C'              	LDA	DOTIX
  01C8'   3C                    	INR	A
  01C9'   32 2D5C'              	STA	DOTIX
  01CC'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01CF'   C3 01BE'              	JMP	DOTLP
  01D2'                         DOTDN:
  01D2'   AF                    	XRA	A
  01D3'   32 2D56'              	STA	DOTRPL
  01D6'   32 2D54'              	STA	DOTCHG		; the '.' is not itself the new last change
  01D9'   C3 07C1'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DC'                         DOTBEL:
  01DC'   0E 07                 	MVI	C,BEL
  01DE'   CD 0000*              	CALL	BCONOU
  01E1'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E4'                         MKVAD:
  01E4'   16 00                 	MVI	D,0
  01E6'   59                    	MOV	E,C
  01E7'   21 2DC7'              	LXI	H,MKVAL
  01EA'   19                    	DAD	D
  01EB'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EC'                         MKCLR:
  01EC'   21 2DC7'              	LXI	H,MKVAL
  01EF'   06 03                 	MVI	B,MKMAX
  01F1'   AF                    	XRA	A
  01F2'                         MKC_LP:
  01F2'   77                    	MOV	M,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01F3'   23                    	INX	H
  01F4'   05                    	DCR	B
  01F5'   C2 01F2'              	JNZ	MKC_LP
  01F8'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01F9'                         MKGETK:
  01F9'   3A 2D56'              	LDA	DOTRPL
  01FC'   B7                    	ORA	A
  01FD'   CA 020E'              	JZ	MKG_KB
  0200'   CD 05A4'              	CALL	DOTGET		; the recording's next key
  0203'   D8                    	RC
  0204'   4F                    	MOV	C,A
  0205'   3A 2D5C'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0208'   3C                    	INR	A
  0209'   32 2D5C'              	STA	DOTIX
  020C'   B7                    	ORA	A		; CY clear
  020D'   C9                    	RET
  020E'                         MKG_KB:
  020E'   CD 0000*              	CALL	GETKEY
  0211'   FE 1B                 	CPI	ESC
  0213'   37                    	STC
  0214'   C8                    	RZ			; ESC cancels the command
  0215'   CD 00D7'              	CALL	DOTPRE		; C kept
  0218'   B7                    	ORA	A		; CY clear
  0219'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021A'                         VC_FF:				; 'f' -- forward, onto the character
  021A'   3E 66                 	MVI	A,'f'
  021C'   C3 022B'              	JMP	FNDNEW
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  021F'                         VC_FB:				; 'F' -- backward, onto it
  021F'   3E 46                 	MVI	A,'F'
  0221'   C3 022B'              	JMP	FNDNEW
  0224'                         VC_TF:				; 't' -- forward, up to it
  0224'   3E 74                 	MVI	A,'t'
  0226'   C3 022B'              	JMP	FNDNEW
  0229'                         VC_TB:				; 'T' -- backward, up to it
  0229'   3E 54                 	MVI	A,'T'
  022B'                         FNDNEW:
  022B'   32 2DBC'              	STA	FNDKND		; the find ';' and ',' will repeat
  022E'   CD 01F9'              	CALL	MKGETK		; the character it looks for
  0231'   DA 0263'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0234'   79                    	MOV	A,C
  0235'   32 2DBD'              	STA	FNDCH
  0238'   3A 2DBC'              	LDA	FNDKND
  023B'   06 01                 	MVI	B,1		; a find starts at the next character along
  023D'   C3 026A'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0240'                         VC_SEMI:
  0240'   3A 2DBC'              	LDA	FNDKND
  0243'   B7                    	ORA	A
  0244'   CA 0263'              	JZ	FNDNIL		; nothing has been looked for yet
  0247'   C3 0253'              	JMP	FNDREP
  024A'                         VC_COMMA:
  024A'   3A 2DBC'              	LDA	FNDKND
  024D'   B7                    	ORA	A
  024E'   CA 0263'              	JZ	FNDNIL
  0251'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0253'                         FNDREP:
  0253'   06 01                 	MVI	B,1
  0255'   F5                    	PUSH	PSW
  0256'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  0258'   FE 54                 	CPI	'T'
  025A'   C2 025F'              	JNZ	FNDR_GO
  025D'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  025F'                         FNDR_GO:
  025F'   F1                    	POP	PSW
  0260'   C3 026A'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0263'                         FNDNIL:
  0263'   AF                    	XRA	A
  0264'   32 2D62'              	STA	PSAVE
  0267'   C3 07A0'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026A'                         FNDGO:
  026A'   32 2DBE'              	STA	FNDRUN
  026D'   78                    	MOV	A,B
  026E'   32 2DBF'              	STA	FNDSTP
  0271'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0274'   22 2DC0'              	SHLD	FNDN		; the occurrence wanted
  0277'   CD 0000*              	CALL	CUROFF
  027A'   22 2DC2'              	SHLD	FNDCUR
  027D'   3A 2DBE'              	LDA	FNDRUN
  0280'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0282'   CA 02B6'              	JZ	FNDBWD
  0285'   2A 2DC2'              	LHLD	FNDCUR
  0288'   CD 0663'              	CALL	EOLC		; HL = the line's last content character
  028B'   22 2DC4'              	SHLD	FNDLIM
  028E'   2A 2DC2'              	LHLD	FNDCUR
  0291'   3A 2DBF'              	LDA	FNDSTP
  0294'   5F                    	MOV	E,A
  0295'   16 00                 	MVI	D,0
  0297'   19                    	DAD	D		; HL = where the scan starts
  0298'                         FNDF_LP:
  0298'   EB                    	XCHG			; DE = the scan
  0299'   2A 2DC4'              	LHLD	FNDLIM
  029C'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  029F'   EB                    	XCHG			; HL = the scan
  02A0'   CA 02A6'              	JZ	FNDF_AT		; the last character is still a candidate
  02A3'   D2 0308'              	JNC	FNDMIS		; past it: not on this line
  02A6'                         FNDF_AT:
  02A6'   CD 030F'              	CALL	FNDSEE		; Z iff this is the character
  02A9'   C2 02B2'              	JNZ	FNDF_NX
  02AC'   CD 031A'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02AF'   CA 02EE'              	JZ	FNDHIT
  02B2'                         FNDF_NX:
  02B2'   23                    	INX	H
  02B3'   C3 0298'              	JMP	FNDF_LP
  02B6'                         FNDBWD:
  02B6'   2A 2DC2'              	LHLD	FNDCUR
  02B9'   CD 0624'              	CALL	BOL		; HL = the line's first character
  02BC'   22 2DC4'              	SHLD	FNDLIM
  02BF'   2A 2DC2'              	LHLD	FNDCUR
  02C2'   3A 2DBF'              	LDA	FNDSTP
  02C5'   2F                    	CMA
  02C6'   5F                    	MOV	E,A
  02C7'   16 FF                 	MVI	D,0FFH
  02C9'   13                    	INX	D		; DE = -step
  02CA'   19                    	DAD	D		; HL = where the scan starts
  02CB'   D2 0308'              	JNC	FNDMIS		; ... off the front of the text altogether
  02CE'                         FNDB_LP:
  02CE'   EB                    	XCHG			; DE = the scan
  02CF'   2A 2DC4'              	LHLD	FNDLIM
  02D2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D5'   EB                    	XCHG			; HL = the scan
  02D6'   DA 0308'              	JC	FNDMIS		; before this line: not on it
  02D9'   CD 030F'              	CALL	FNDSEE
  02DC'   C2 02E5'              	JNZ	FNDB_NX
  02DF'   CD 031A'              	CALL	FNDCNT
  02E2'   CA 02EE'              	JZ	FNDHIT
  02E5'                         FNDB_NX:
  02E5'   7C                    	MOV	A,H
  02E6'   B5                    	ORA	L
  02E7'   CA 0308'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02EA'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EB'   C3 02CE'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02EE'                         FNDHIT:
  02EE'   3A 2DBE'              	LDA	FNDRUN
  02F1'   E6 5F                 	ANI	5FH
  02F3'   FE 54                 	CPI	'T'
  02F5'   C2 0305'              	JNZ	FNDLND
  02F8'   3A 2DBE'              	LDA	FNDRUN
  02FB'   E6 20                 	ANI	20H
  02FD'   CA 0304'              	JZ	FNDH_BW
  0300'   2B                    	DCX	H		; forward 't': the character before it
  0301'   C3 0305'              	JMP	FNDLND
  0304'                         FNDH_BW:
  0304'   23                    	INX	H		; backward 'T': the character after it
  0305'                         FNDLND:
  0305'   C3 05BA'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  0308'                         FNDMIS:
  0308'   AF                    	XRA	A
  0309'   32 2D62'              	STA	PSAVE
  030C'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  030F'                         FNDSEE:
  030F'   E5                    	PUSH	H
  0310'   CD 0000*              	CALL	CHARAT
  0313'   E1                    	POP	H
  0314'   47                    	MOV	B,A
  0315'   3A 2DBD'              	LDA	FNDCH
  0318'   B8                    	CMP	B
  0319'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031A'                         FNDCNT:
  031A'   E5                    	PUSH	H
  031B'   2A 2DC0'              	LHLD	FNDN
  031E'   2B                    	DCX	H
  031F'   22 2DC0'              	SHLD	FNDN
  0322'   7C                    	MOV	A,H
  0323'   B5                    	ORA	L
  0324'   E1                    	POP	H
  0325'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0326'                         ISFIND:
  0326'   E6 5F                 	ANI	5FH		; fold the case away
  0328'   FE 46                 	CPI	'F'
  032A'   C8                    	RZ
  032B'   FE 54                 	CPI	'T'
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  032D'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  032E'                         VC_MK:
  032E'   3E 04                 	MVI	A,PM
  0330'   C3 033A'              	JMP	MKGO
  0333'                         VC_BQ:
  0333'   3E 05                 	MVI	A,PJ
  0335'   C3 033A'              	JMP	MKGO
  0338'                         VC_AQ:
  0338'   3E 06                 	MVI	A,PJL
  033A'                         MKGO:
  033A'   32 2DD3'              	STA	MKWHAT
  033D'   CD 06B8'              	CALL	MOVCNT		; a count means nothing on any of the three
  0340'   CD 01F9'              	CALL	MKGETK		; the key that names the mark
  0343'   DA 0422'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0346'                         MKOP:
  0346'   79                    	MOV	A,C
  0347'   D6 61                 	SUI	'a'
  0349'   FE 03                 	CPI	MKMAX
  034B'   D2 041A'              	JNC	MKNOLT		; not a mark letter
  034E'   4F                    	MOV	C,A		; C = the mark's index
  034F'   87                    	ADD	A
  0350'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0351'   5F                    	MOV	E,A
  0352'   16 00                 	MVI	D,0
  0354'   21 0000*              	LXI	H,MKTAB
  0357'   19                    	DAD	D		; HL -> this mark's slot
  0358'   3A 2DD3'              	LDA	MKWHAT
  035B'   FE 04                 	CPI	PM
  035D'   CA 0435'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0360'                         MKJMP:
  0360'   E5                    	PUSH	H
  0361'   CD 01E4'              	CALL	MKVAD
  0364'   7E                    	MOV	A,M
  0365'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0366'   B7                    	ORA	A
  0367'   CA 0410'              	JZ	MKNSET		; never set
  036A'   CD 03DC'              	CALL	MKLOAD		; the file position it holds
  036D'   CD 03E9'              	CALL	MKWIN
  0370'   DA 0387'              	JC	MKJ_GO		; in the window: any command may go there
  0373'   3A 2D62'              	LDA	PSAVE
  0376'   B7                    	ORA	A
  0377'   CA 0387'              	JZ	MKJ_GO
  037A'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037C'   C2 0422'              	JNZ	MKBAD
  037F'   3A 2DD3'              	LDA	MKWHAT
  0382'   FE 06                 	CPI	PJL
  0384'   C2 0422'              	JNZ	MKBAD
  0387'                         MKJ_GO:
  0387'   CD 125E'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038A'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  038D'   CD 03A9'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0390'   CD 0731'              	CALL	BRKOFF		; (A only)
  0393'   DA 0749'              	JC	BRKBAK
  0396'   3A 2DD3'              	LDA	MKWHAT
  0399'   FE 06                 	CPI	PJL
  039B'   CA 03A3'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  039E'   3E 01                 	MVI	A,1		;   non-blank
  03A0'   32 2DC6'              	STA	GPKEEP		; '`': land on the column it was set at
  03A3'                         MKJ_LN:
  03A3'   CD 0000*              	CALL	GOTO
  03A6'   C3 1276'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03A9'                         MKPAGE:
  03A9'   CD 03E9'              	CALL	MKWIN
  03AC'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03AF'   32 0000*              	STA	DIRFLG
  03B2'   21 FFFF               	LXI	H,0FFFFH
  03B5'   22 2D2C'              	SHLD	CMDCNT
  03B8'   CD 0000*              	CALL	GOLINE
  03BB'   CD 0000*              	CALL	SCRLST
  03BE'   CD 06E0'              	CALL	CNTTST
  03C1'   C2 03A9'              	JNZ	MKPAGE
  03C4'   CD 03E9'              	CALL	MKWIN		; the file ran out: that was its last step
  03C7'   DA 0000*              	JC	CLRCNT
  03CA'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03CD'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03D0'                         BACKTO:
  03D0'   CD 03DC'              	CALL	MKLOAD
  03D3'   CD 0000*              	CALL	CLRCNT
  03D6'   CD 03A9'              	CALL	MKPAGE
  03D9'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03DC'                         MKLOAD:
  03DC'   5E                    	MOV	E,M
  03DD'   23                    	INX	H
  03DE'   56                    	MOV	D,M
  03DF'   23                    	INX	H
  03E0'   7E                    	MOV	A,M
  03E1'   EB                    	XCHG
  03E2'   22 2DD0'              	SHLD	MKPOS
  03E5'   32 2DD2'              	STA	MKPOS+2
  03E8'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  03E9'                         MKWIN:
  03E9'   2A 0000*              	LHLD	TXTBEG
  03EC'   CD 1218'              	CALL	FPOS
  03EF'   EB                    	XCHG
  03F0'   47                    	MOV	B,A		; B:DE = the window's first byte
  03F1'   2A 2DD0'              	LHLD	MKPOS
  03F4'   3A 2DD2'              	LDA	MKPOS+2
  03F7'   CD 120B'              	CALL	SUB24		; A:HL = the mark, from the window's top
  03FA'   DA 040C'              	JC	MKW_BK		; above it
  03FD'   C2 040A'              	JNZ	MKW_FW		; 64K or more below it
  0400'   E5                    	PUSH	H
  0401'   CD 0000*              	CALL	LOGLEN
  0404'   D1                    	POP	D
  0405'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0408'   EB                    	XCHG
  0409'   D8                    	RC			; inside
  040A'                         MKW_FW:
  040A'   AF                    	XRA	A
  040B'   C9                    	RET
  040C'                         MKW_BK:
  040C'   3E FF                 	MVI	A,0FFH
  040E'   B7                    	ORA	A
  040F'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0410'                         MKNSET:
  0410'   AF                    	XRA	A
  0411'   32 2D62'              	STA	PSAVE
  0414'   21 2703'              	LXI	H,SMKNS
  0417'   C3 25E8'              	JMP	EXERR
  041A'                         MKNOLT:
  041A'   3A 2DD3'              	LDA	MKWHAT
  041D'   FE 04                 	CPI	PM
  041F'   C2 0410'              	JNZ	MKNSET		; a jump: that mark is not set
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0422'                         MKBAD:
  0422'   AF                    	XRA	A
  0423'   32 2D62'              	STA	PSAVE
  0426'   C3 01DC'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0429'                         FPSTO:
  0429'   E5                    	PUSH	H
  042A'   CD 1215'              	CALL	CURFP		; A:HL = the cursor's file position
  042D'   EB                    	XCHG
  042E'   E1                    	POP	H
  042F'   73                    	MOV	M,E
  0430'   23                    	INX	H
  0431'   72                    	MOV	M,D
  0432'   23                    	INX	H
  0433'   77                    	MOV	M,A
  0434'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0435'                         MKSET:
  0435'   CD 0429'              	CALL	FPSTO
  0438'   CD 01E4'              	CALL	MKVAD
  043B'   36 01                 	MVI	M,1		; ... and the mark is live
  043D'   C3 07A0'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  0440'                         MKSNAP:
  0440'   C5                    	PUSH	B
  0441'   E5                    	PUSH	H
  0442'   21 0000*              	LXI	H,MKTAB
  0445'   11 0000*              	LXI	D,MKUND
  0448'   CD 240B'              	CALL	COPY12
  044B'   21 2DC7'              	LXI	H,MKVAL
  044E'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0451'   06 03                 	MVI	B,MKMAX
  0453'                         MSN_LP:
  0453'   7E                    	MOV	A,M
  0454'   12                    	STAX	D
  0455'   23                    	INX	H
  0456'   13                    	INX	D
  0457'   13                    	INX	D
  0458'   13                    	INX	D
  0459'   13                    	INX	D
  045A'   05                    	DCR	B
  045B'   C2 0453'              	JNZ	MSN_LP
  045E'   E1                    	POP	H
  045F'   C1                    	POP	B
  0460'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0461'                         MKREST:
  0461'   0E 02                 	MVI	C,MKMAX-1
  0463'                         MRS_LP:
  0463'   79                    	MOV	A,C
  0464'   87                    	ADD	A
  0465'   87                    	ADD	A
  0466'   5F                    	MOV	E,A
  0467'   16 00                 	MVI	D,0
  0469'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  046C'   19                    	DAD	D
  046D'   7E                    	MOV	A,M
  046E'   B7                    	ORA	A
  046F'   CA 048B'              	JZ	MRS_NX		; it was not set then
  0472'   2B                    	DCX	H
  0473'   2B                    	DCX	H
  0474'   2B                    	DCX	H
  0475'   E5                    	PUSH	H
  0476'   21 0000*              	LXI	H,MKTAB
  0479'   19                    	DAD	D
  047A'   EB                    	XCHG			; DE -> the mark
  047B'   E1                    	POP	H		; HL -> its copy
  047C'   06 03                 	MVI	B,MKSIZ-1
  047E'                         MRS_CP:
  047E'   7E                    	MOV	A,M
  047F'   12                    	STAX	D
  0480'   23                    	INX	H
  0481'   13                    	INX	D
  0482'   05                    	DCR	B
  0483'   C2 047E'              	JNZ	MRS_CP
  0486'   CD 01E4'              	CALL	MKVAD
  0489'   36 01                 	MVI	M,1
  048B'                         MRS_NX:
  048B'   0D                    	DCR	C
  048C'   F2 0463'              	JP	MRS_LP
  048F'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0490'                         MKSHFT:
  0490'   32 2DCF'              	STA	MKTYP
  0493'   3A 2DD4'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  0496'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0497'   C0                    	RNZ			;   every mark points into is still there
  0498'   3A 0000*              	LDA	UNDRPL
  049B'   B7                    	ORA	A
  049C'   C2 04A6'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  049F'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04A2'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04A3'   C4 0440'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04A6'                         MKS_GO:
  04A6'   C5                    	PUSH	B
  04A7'   50                    	MOV	D,B
  04A8'   59                    	MOV	E,C
  04A9'   EB                    	XCHG
  04AA'   22 2DCD'              	SHLD	MKN		; the edit's length
  04AD'   D5                    	PUSH	D		; ... and its offset
  04AE'   CD 0000*              	CALL	CUROFF
  04B1'   D1                    	POP	D
  04B2'   CD 0000*              	CALL	SUBHD
  04B5'   EB                    	XCHG			; DE = how far behind the cursor it is
  04B6'   CD 1215'              	CALL	CURFP		; A:HL = the cursor's file position
  04B9'   06 00                 	MVI	B,0
  04BB'   CD 120B'              	CALL	SUB24
  04BE'   22 2DCA'              	SHLD	MKEDIT
  04C1'   32 2DCC'              	STA	MKEDIT+2	; where in the file the edit is
  04C4'   21 2DC7'              	LXI	H,MKVAL
  04C7'   11 0000*              	LXI	D,MKTAB
  04CA'   06 03                 	MVI	B,MKMAX
  04CC'                         MKS_LP:
  04CC'   7E                    	MOV	A,M
  04CD'   B7                    	ORA	A
  04CE'   CA 053A'              	JZ	MKS_N0		; that mark is not set
  04D1'   E5                    	PUSH	H
  04D2'   C5                    	PUSH	B
  04D3'   21 2DCA'              	LXI	H,MKEDIT
  04D6'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04D7'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04D8'   4F                    	MOV	C,A
  04D9'   13                    	INX	D
  04DA'   23                    	INX	H
  04DB'   1A                    	LDAX	D
  04DC'   9E                    	SBB	M
  04DD'   47                    	MOV	B,A
  04DE'   13                    	INX	D
  04DF'   23                    	INX	H
  04E0'   1A                    	LDAX	D
  04E1'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04E2'   DA 0535'              	JC	MKS_PP		; before it: nothing moves
  04E5'   6F                    	MOV	L,A
  04E6'   3A 2DCF'              	LDA	MKTYP
  04E9'   3D                    	DCR	A
  04EA'   CA 050F'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04ED'   7D                    	MOV	A,L
  04EE'   2A 2DCD'              	LHLD	MKN
  04F1'   B7                    	ORA	A
  04F2'   C2 04FE'              	JNZ	MKS_DL		; 64K or more past it
  04F5'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F6'   95                    	SUB	L
  04F7'   78                    	MOV	A,B
  04F8'   9C                    	SBB	H
  04F9'   D2 04FE'              	JNC	MKS_DL		; past the end of what goes
  04FC'   60                    	MOV	H,B
  04FD'   69                    	MOV	L,C		; inside it: close up to the edit
  04FE'                         MKS_DL:
  04FE'   1B                    	DCX	D
  04FF'   1B                    	DCX	D
  0500'   1A                    	LDAX	D
  0501'   95                    	SUB	L
  0502'   12                    	STAX	D
  0503'   13                    	INX	D
  0504'   1A                    	LDAX	D
  0505'   9C                    	SBB	H
  0506'   12                    	STAX	D
  0507'   13                    	INX	D
  0508'   1A                    	LDAX	D
  0509'   DE 00                 	SBI	0
  050B'   12                    	STAX	D
  050C'   C3 0535'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  050F'                         MKS_IN:
  050F'   7D                    	MOV	A,L
  0510'   B0                    	ORA	B
  0511'   B1                    	ORA	C
  0512'   C2 0524'              	JNZ	MKS_AD		; the mark is past it
  0515'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0518'   2B                    	DCX	H
  0519'   7E                    	MOV	A,M		; the last byte that went in
  051A'   FE 0A                 	CPI	LF
  051C'   CA 0524'              	JZ	MKS_AD
  051F'   FE 0D                 	CPI	CR
  0521'   C2 0535'              	JNZ	MKS_PP
  0524'                         MKS_AD:
  0524'   2A 2DCD'              	LHLD	MKN
  0527'   1B                    	DCX	D
  0528'   1B                    	DCX	D
  0529'   1A                    	LDAX	D
  052A'   85                    	ADD	L
  052B'   12                    	STAX	D
  052C'   13                    	INX	D
  052D'   1A                    	LDAX	D
  052E'   8C                    	ADC	H
  052F'   12                    	STAX	D
  0530'   13                    	INX	D
  0531'   1A                    	LDAX	D
  0532'   CE 00                 	ACI	0
  0534'   12                    	STAX	D
  0535'                         MKS_PP:
  0535'   C1                    	POP	B
  0536'   E1                    	POP	H
  0537'   C3 053C'              	JMP	MKS_NX
  053A'                         MKS_N0:
  053A'   13                    	INX	D
  053B'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  053C'                         MKS_NX:
  053C'   13                    	INX	D
  053D'   13                    	INX	D
  053E'   23                    	INX	H
  053F'   05                    	DCR	B
  0540'   C2 04CC'              	JNZ	MKS_LP
  0543'   C1                    	POP	B
  0544'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0545'                         VC_UNDO:
  0545'   21 0000               	LXI	H,0
  0548'   22 2D2C'              	SHLD	CMDCNT
  054B'   CD 0000*              	CALL	UNDO
  054E'   DA 0587'              	JC	UNDNO
  0551'   3A 0000*              	LDA	UNDST
  0554'   FE 02                 	CPI	2
  0556'   CC 0461'              	CZ	MKREST		; undone (not redone): the marks go back too
  0559'   2A 0000*              	LHLD	UNDCUR
  055C'   CD 056D'              	CALL	UCLAMP		; vi never sits on a line terminator
  055F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0562'   3E 01                 	MVI	A,1
  0564'   32 2D2F'              	STA	MODF		; undone past a ':w' still differs from the file
  0567'   CD 0931'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  056A'   C3 07C1'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  056D'                         UCLAMP:
  056D'   E5                    	PUSH	H
  056E'   CD 181C'              	CALL	CEND		; HL = the line's content end
  0571'   D1                    	POP	D		; DE = the offset wanted
  0572'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0575'   D2 057A'              	JNC	UCL_BK
  0578'   EB                    	XCHG
  0579'   C9                    	RET
  057A'                         UCL_BK:
  057A'   E5                    	PUSH	H		; the content end
  057B'   EB                    	XCHG			; HL = the offset wanted
  057C'   CD 0624'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0580'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0583'   EB                    	XCHG			; HL = the content end
  0584'   C8                    	RZ
  0585'   2B                    	DCX	H		; ... its last character
  0586'   C9                    	RET
  0587'                         UNDNO:
  0587'   3A 0000*              	LDA	UNDWHY
  058A'   B7                    	ORA	A
  058B'   CA 059C'              	JZ	UNDBEL
  058E'   21 26BD'              	LXI	H,SUNDW		; the change has paged away: say so
  0591'   FE 01                 	CPI	1
  0593'   CA 25E8'              	JZ	EXERR
  0596'   21 26DF'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0599'   C3 25E8'              	JMP	EXERR
  059C'                         UNDBEL:
  059C'   0E 07                 	MVI	C,BEL
  059E'   CD 0000*              	CALL	BCONOU
  05A1'   C3 07A0'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  05A4'                         DOTGET:
  05A4'   3A 2D5C'              	LDA	DOTIX
  05A7'   5F                    	MOV	E,A
  05A8'   3A 2D5B'              	LDA	DOTLEN
  05AB'   BB                    	CMP	E
  05AC'   CA 05B8'              	JZ	DOTGEF
  05AF'   16 00                 	MVI	D,0
  05B1'   21 0000*              	LXI	H,DOTBUF
  05B4'   19                    	DAD	D
  05B5'   7E                    	MOV	A,M
  05B6'   B7                    	ORA	A		; CY clear: a key was returned
  05B7'   C9                    	RET
  05B8'                         DOTGEF:
  05B8'   37                    	STC
  05B9'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  05BA'                         GOSET:
  05BA'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  05BD'                         SETGL:
  05BD'   CD 1238'              	CALL	ZSAVE
  05C0'   21 0000               	LXI	H,0
  05C3'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C6'   E5                    	PUSH	H
  05C7'   CD 124B'              	CALL	ZREST
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05CA'   E1                    	POP	H
  05CB'   E5                    	PUSH	H
  05CC'   CD 06C4'              	CALL	GBSUB		; HL = bytes to the cursor
  05CF'   44                    	MOV	B,H
  05D0'   4D                    	MOV	C,L
  05D1'   E1                    	POP	H		; HL = the line's start
  05D2'   11 0000               	LXI	D,0		; DE = screen column
  05D5'                         SG_LP:
  05D5'   78                    	MOV	A,B
  05D6'   B1                    	ORA	C
  05D7'   CA 05EC'              	JZ	SG_CUR
  05DA'   7E                    	MOV	A,M
  05DB'   23                    	INX	H
  05DC'   0B                    	DCX	B
  05DD'   E5                    	PUSH	H
  05DE'   6B                    	MOV	L,E
  05DF'   CD 0611'              	CALL	CWID
  05E2'   E1                    	POP	H
  05E3'   83                    	ADD	E
  05E4'   5F                    	MOV	E,A
  05E5'   D2 05D5'              	JNC	SG_LP
  05E8'   14                    	INR	D
  05E9'   C3 05D5'              	JMP	SG_LP
  05EC'                         SG_CUR:
  05EC'   2A 0000*              	LHLD	TXTEND
  05EF'   D5                    	PUSH	D
  05F0'   EB                    	XCHG
  05F1'   2A 0000*              	LHLD	GAPEND
  05F4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05F7'   D1                    	POP	D
  05F8'   CA 060C'              	JZ	SG_SET
  05FB'   7E                    	MOV	A,M
  05FC'   FE 09                 	CPI	TAB
  05FE'   C2 060C'              	JNZ	SG_SET
  0601'   6B                    	MOV	L,E
  0602'   CD 0611'              	CALL	CWID
  0605'   3D                    	DCR	A		; the TAB's last column
  0606'   83                    	ADD	E
  0607'   5F                    	MOV	E,A
  0608'   D2 060C'              	JNC	SG_SET
  060B'   14                    	INR	D
  060C'                         SG_SET:
  060C'   EB                    	XCHG
  060D'   22 2D35'              	SHLD	GOALCOL
  0610'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0611'                         CWID:
  0611'   FE 0D                 	CPI	CR
  0613'   CA 0622'              	JZ	CW_0
  0616'   FE 09                 	CPI	TAB
  0618'   3E 01                 	MVI	A,1
  061A'   C0                    	RNZ
  061B'   7D                    	MOV	A,L
  061C'   E6 07                 	ANI	TABWID-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  061E'   2F                    	CMA
  061F'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0621'   C9                    	RET
  0622'                         CW_0:
  0622'   AF                    	XRA	A
  0623'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  0624'                         BOL:
  0624'                         BOL_LP:
  0624'   7C                    	MOV	A,H
  0625'   B5                    	ORA	L
  0626'   C8                    	RZ			; at 0
  0627'   2B                    	DCX	H		; look at off-1
  0628'   E5                    	PUSH	H
  0629'   CD 0000*              	CALL	CHARAT
  062C'   E1                    	POP	H		; HL = off-1
  062D'   FE 0A                 	CPI	LF
  062F'   CA 0635'              	JZ	BOL_DN
  0632'   C3 0624'              	JMP	BOL_LP
  0635'                         BOL_DN:
  0635'   23                    	INX	H		; line starts just after the LF
  0636'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  0637'                         EOLNL:
  0637'   E5                    	PUSH	H
  0638'   CD 0000*              	CALL	LOGLEN
  063B'   22 2D80'              	SHLD	WKN
  063E'   E1                    	POP	H
  063F'                         ENL_LP:
  063F'   EB                    	XCHG			; DE = i
  0640'   2A 2D80'              	LHLD	WKN
  0643'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0646'   EB                    	XCHG			; HL = i, DE = n
  0647'   D0                    	RNC			; i >= n: no LF on this line
  0648'   E5                    	PUSH	H
  0649'   CD 0000*              	CALL	CHARAT
  064C'   E1                    	POP	H
  064D'   FE 0A                 	CPI	LF
  064F'   C8                    	RZ			; the LF: HL is its offset
  0650'   23                    	INX	H
  0651'   C3 063F'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0654'                         NLSTART:
  0654'   CD 0637'              	CALL	EOLNL
  0657'   E5                    	PUSH	H
  0658'   CD 0000*              	CALL	LOGLEN
  065B'   D1                    	POP	D		; DE = eol result
  065C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  065F'   C8                    	RZ			; no next line: HL = LOGLEN
  0660'   EB                    	XCHG			; HL = eol
  0661'   23                    	INX	H
  0662'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0663'                         EOLC:
  0663'   E5                    	PUSH	H
  0664'   CD 0637'              	CALL	EOLNL
  0667'   22 2D82'              	SHLD	WKTERM
  066A'   E1                    	POP	H
  066B'   CD 0624'              	CALL	BOL
  066E'   22 2D84'              	SHLD	WKBOL
  0671'   2A 2D82'              	LHLD	WKTERM
  0674'   EB                    	XCHG			; DE = term
  0675'   2A 2D84'              	LHLD	WKBOL
  0678'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  067B'   CA 069A'              	JZ	EOLC_MT
  067E'   EB                    	XCHG			; HL = term
  067F'   2B                    	DCX	H		; term-1
  0680'   E5                    	PUSH	H
  0681'   CD 0000*              	CALL	CHARAT
  0684'   E1                    	POP	H		; HL = term-1
  0685'   FE 0D                 	CPI	CR
  0687'   CA 068D'              	JZ	EOLC_CR		; content ends at term-1
  068A'   C3 068E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  068D'                         EOLC_CR:
  068D'   2B                    	DCX	H		; last = (term-1) - 1
  068E'                         EOLC_LS:
  068E'   EB                    	XCHG			; DE = last
  068F'   2A 2D84'              	LHLD	WKBOL
  0692'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0695'   DA 069A'              	JC	EOLC_MT
  0698'   EB                    	XCHG			; HL = last
  0699'   C9                    	RET
  069A'                         EOLC_MT:
  069A'   2A 2D84'              	LHLD	WKBOL
  069D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  069E'                         COL:
  069E'   E5                    	PUSH	H
  069F'   CD 0624'              	CALL	BOL
  06A2'   D1                    	POP	D		; DE = off
  06A3'   EB                    	XCHG			; HL = off, DE = bol
  06A4'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  06A7'                         ATENDQ:
  06A7'   CD 0000*              	CALL	CUROFF
  06AA'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06AB'   CD 0000*              	CALL	LOGLEN
  06AE'   D1                    	POP	D		; DE = cur
  06AF'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  06B2'                         CURCHR:
  06B2'   CD 0000*              	CALL	CUROFF
  06B5'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  06B8'                         MOVCNT:
  06B8'   CD 07A0'              	CALL	SETMOV
  06BB'   C3 06CB'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  06BE'                         CNTOFF:
  06BE'   CD 06CB'              	CALL	GETCNT
  06C1'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  06C4'                         GBSUB:
  06C4'   EB                    	XCHG
  06C5'   2A 0000*              	LHLD	GAPBEG
  06C8'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  06CB'                         GETCNT:
  06CB'   2A 2D2C'              	LHLD	CMDCNT
  06CE'   7C                    	MOV	A,H
  06CF'   B5                    	ORA	L
  06D0'   C2 06D7'              	JNZ	GC_HAVE
  06D3'   21 0001               	LXI	H,1
  06D6'   C9                    	RET
  06D7'                         GC_HAVE:
  06D7'   E5                    	PUSH	H
  06D8'   21 0000               	LXI	H,0
  06DB'   22 2D2C'              	SHLD	CMDCNT
  06DE'   E1                    	POP	H
  06DF'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06E0'                         CNTTST:				; WM 1175
  06E0'   3A 2DEB'              	LDA	BRKARM
  06E3'   B7                    	ORA	A
  06E4'   C4 070E'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  06E7'   E5                    	PUSH	H
  06E8'   2A 2D2C'              	LHLD	CMDCNT
  06EB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06EE'   B4                    	ORA	H
  06EF'   B5                    	ORA	L
  06F0'   E1                    	POP	H
  06F1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  06F4'                         BRKON:
  06F4'   21 2DE6'              	LXI	H,SOFF
  06F7'   CD 0429'              	CALL	FPSTO
  06FA'   2A 0000*              	LHLD	LNDLT
  06FD'   22 2DE9'              	SHLD	SLDLT
  0700'   AF                    	XRA	A
  0701'   32 2DEC'              	STA	BRKHIT
  0704'   3A 2D62'              	LDA	PSAVE
  0707'   B7                    	ORA	A
  0708'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  0709'   3C                    	INR	A
  070A'   32 2DEB'              	STA	BRKARM
  070D'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  070E'                         BRKTST:
  070E'   C5                    	PUSH	B
  070F'   D5                    	PUSH	D
  0710'   E5                    	PUSH	H
  0711'   CD 0000*              	CALL	KBBRK
  0714'   CA 072D'              	JZ	BT_NO
  0717'   32 2DEC'              	STA	BRKHIT		; (A = FFH)
  071A'   21 2692'              	LXI	H,SINTG
  071D'   CD 0000*              	CALL	EXMSG
  0720'   AF                    	XRA	A
  0721'   32 2DEB'              	STA	BRKARM		; the way back is not stopped in its turn
  0724'   32 0000*              	STA	AUXCNT
  0727'   21 0000               	LXI	H,0
  072A'   22 2D2C'              	SHLD	CMDCNT
  072D'                         BT_NO:
  072D'   E1                    	POP	H
  072E'   D1                    	POP	D
  072F'   C1                    	POP	B
  0730'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  0731'                         BRKOFF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0731'   AF                    	XRA	A
  0732'   32 2DEB'              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  0735'                         BRKQ:
  0735'   3A 2DEC'              	LDA	BRKHIT
  0738'   B7                    	ORA	A
  0739'   C8                    	RZ
  073A'   37                    	STC
  073B'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  073C'                         RSTPL:
  073C'   21 2DE6'              	LXI	H,SOFF
  073F'   CD 03D0'              	CALL	BACKTO
  0742'   2A 2DE9'              	LHLD	SLDLT
  0745'   22 0000*              	SHLD	LNDLT
  0748'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0749'                         BRKBAK:
  0749'   CD 073C'              	CALL	RSTPL
  074C'   CD 0000*              	CALL	KBFLSH
  074F'   21 2686'              	LXI	H,SINTR
  0752'   C3 25E8'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0755'                         CLASSF:
  0755'   47                    	MOV	B,A
  0756'   FE 20                 	CPI	' '
  0758'   CA 0798'              	JZ	CLS0
  075B'   FE 09                 	CPI	TAB
  075D'   CA 0798'              	JZ	CLS0
  0760'   FE 0A                 	CPI	LF
  0762'   CA 0798'              	JZ	CLS0
  0765'   FE 0D                 	CPI	CR
  0767'   CA 0798'              	JZ	CLS0
  076A'   3A 2D37'              	LDA	WBIG
  076D'   B7                    	ORA	A
  076E'   C2 079A'              	JNZ	CLS1
  0771'   78                    	MOV	A,B
  0772'   FE 5F                 	CPI	'_'
  0774'   CA 079A'              	JZ	CLS1
  0777'   FE 30                 	CPI	'0'
  0779'   DA 079D'              	JC	CLS2
  077C'   FE 3A                 	CPI	'9'+1
  077E'   DA 079A'              	JC	CLS1
  0781'   FE 41                 	CPI	'A'
  0783'   DA 079D'              	JC	CLS2
  0786'   FE 5B                 	CPI	'Z'+1
  0788'   DA 079A'              	JC	CLS1
  078B'   FE 61                 	CPI	'a'
  078D'   DA 079D'              	JC	CLS2
  0790'   FE 7B                 	CPI	'z'+1
  0792'   DA 079A'              	JC	CLS1
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  0795'   C3 079D'              	JMP	CLS2
  0798'   AF                    CLS0:	XRA	A
  0799'   C9                    	RET
  079A'   3E 01                 CLS1:	MVI	A,1
  079C'   C9                    	RET
  079D'   3E 02                 CLS2:	MVI	A,2
  079F'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  07A0'                         SETMOV:
  07A0'   3E 01                 	MVI	A,R_MOVE
  07A2'   32 2D30'              	STA	RINTENT
  07A5'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  07A6'                         SETLIN:
  07A6'   3E 02                 	MVI	A,R_LINE
  07A8'   32 2D30'              	STA	RINTENT
  07AB'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  07AC'                         SETILN:
  07AC'   3E 01                 	MVI	A,1
  07AE'   32 2D31'              	STA	ILN		; one line, unless a put overwrites it below
  07B1'   3E 05                 	MVI	A,R_ILIN
  07B3'   32 2D30'              	STA	RINTENT
  07B6'   AF                    	XRA	A
  07B7'   32 2D34'              	STA	ILABOV		; the row above the opened ones is untouched
  07BA'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  07BB'                         SETJON:
  07BB'   3E 06                 	MVI	A,R_JOIN
  07BD'   32 2D30'              	STA	RINTENT
  07C0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  07C1'                         SETFUL:
  07C1'   3E 00                 	MVI	A,R_FULL
  07C3'   32 2D30'              	STA	RINTENT
  07C6'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  07C7'                         TAILTAB:
  07C7'   CD 0000*              	CALL	CUROFF
  07CA'   22 2D7C'              	SHLD	TTI
  07CD'                         TT_LP:
  07CD'   2A 2D7C'              	LHLD	TTI
  07D0'   EB                    	XCHG			; DE = TTI
  07D1'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  07D4'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  07D7'   D2 07FC'              	JNC	TT_NO		; reached end of text -> no tab
  07DA'   2A 2D7C'              	LHLD	TTI
  07DD'   CD 0000*              	CALL	CHARAT
  07E0'   FE 0A                 	CPI	LF
  07E2'   CA 07FC'              	JZ	TT_NO		; end of line -> no tab
  07E5'   FE 0D                 	CPI	CR
  07E7'   CA 07EF'              	JZ	TT_NX		; (the line end's own)
  07EA'   FE 20                 	CPI	' '
  07EC'   DA 07F9'              	JC	TT_YES
  07EF'                         TT_NX:
  07EF'   2A 2D7C'              	LHLD	TTI
  07F2'   23                    	INX	H
  07F3'   22 2D7C'              	SHLD	TTI
  07F6'   C3 07CD'              	JMP	TT_LP
  07F9'                         TT_YES:
  07F9'   3E 01                 	MVI	A,1
  07FB'   C9                    	RET
  07FC'                         TT_NO:
  07FC'   AF                    	XRA	A
  07FD'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07FE'                         VC_H:
  07FE'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0801'   22 2D7A'              	SHLD	CNTV
  0804'                         VCH_LP:
  0804'   2A 2D7A'              	LHLD	CNTV
  0807'   7C                    	MOV	A,H
  0808'   B5                    	ORA	L
  0809'   C8                    	RZ
  080A'   2B                    	DCX	H
  080B'   22 2D7A'              	SHLD	CNTV
  080E'   CD 0814'              	CALL	HSTEP
  0811'   C3 0804'              	JMP	VCH_LP
  0814'                         HSTEP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0814'   CD 0000*              	CALL	CUROFF		; HL = cur
  0817'   7C                    	MOV	A,H
  0818'   B5                    	ORA	L
  0819'   C8                    	RZ			; at 0
  081A'   E5                    	PUSH	H
  081B'   CD 0624'              	CALL	BOL		; HL = bol
  081E'   D1                    	POP	D		; DE = cur
  081F'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  0822'   C8                    	RZ			; at BOL, cannot go left
  0823'   EB                    	XCHG			; HL = cur
  0824'   2B                    	DCX	H
  0825'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  0828'                         VC_L:
  0828'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  082B'   22 2D7A'              	SHLD	CNTV
  082E'                         VCL_LP:
  082E'   2A 2D7A'              	LHLD	CNTV
  0831'   7C                    	MOV	A,H
  0832'   B5                    	ORA	L
  0833'   C8                    	RZ
  0834'   2B                    	DCX	H
  0835'   22 2D7A'              	SHLD	CNTV
  0838'   CD 083E'              	CALL	LSTEP
  083B'   C3 082E'              	JMP	VCL_LP
  083E'                         LSTEP:
  083E'   CD 0000*              	CALL	CUROFF		; HL = cur
  0841'   E5                    	PUSH	H
  0842'   CD 0663'              	CALL	EOLC		; HL = eolc
  0845'   D1                    	POP	D		; DE = cur
  0846'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0849'   D2 0851'              	JNC	LS_NO		; cur >= eolc, cannot go right
  084C'   EB                    	XCHG			; HL = cur
  084D'   23                    	INX	H
  084E'   C3 05BA'              	JMP	GOSET
  0851'                         LS_NO:				; on the line's last char.  An operator waiting on
  0851'   CD 0C1D'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0854'   C8                    	RZ			;   motion inclusive when it falls short), which
  0855'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0857'   32 2D38'              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  085A'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  085B'                         VC_0:
  085B'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  085E'   CD 0868'              	CALL	LNSTRT
  0861'   21 0000               	LXI	H,0
  0864'   22 2D35'              	SHLD	GOALCOL
  0867'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0868'                         LNSTRT:
  0868'   CD 1238'              	CALL	ZSAVE
  086B'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  086E'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0871'   E5                    	PUSH	H
  0872'   CD 124B'              	CALL	ZREST
  0875'   E1                    	POP	H
  0876'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0879'                         VC_CRT:
  0879'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  087C'   C3 087F'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  087F'                         FNBLNK:
  087F'   CD 0868'              	CALL	LNSTRT
  0882'   CD 0000*              	CALL	RGET0
  0885'   11 0000               	LXI	D,0		; DE = blanks skipped
  0888'                         FN_LP:
  0888'   CD 0000*              	CALL	RDGET
  088B'   DA 08AE'              	JC	FN_GO		; the end of the file
  088E'   FE 20                 	CPI	' '
  0890'   CA 0898'              	JZ	FN_WH
  0893'   FE 09                 	CPI	TAB
  0895'   C2 08AE'              	JNZ	FN_GO		; a non-blank, or the line's end
  0898'                         FN_WH:
  0898'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  089B'   DA 08AE'              	JC	FN_GO
  089E'   FE 0D                 	CPI	CR
  08A0'   CA 08AE'              	JZ	FN_GO
  08A3'   FE 0A                 	CPI	LF
  08A5'   CA 08AE'              	JZ	FN_GO
  08A8'   2B                    	DCX	H		; not yet: read that char again
  08A9'   03                    	INX	B
  08AA'   13                    	INX	D
  08AB'   C3 0888'              	JMP	FN_LP
  08AE'                         FN_GO:
  08AE'   D5                    	PUSH	D
  08AF'   CD 0000*              	CALL	CUROFF
  08B2'   D1                    	POP	D
  08B3'   19                    	DAD	D
  08B4'   C3 05BA'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  08B7'                         VC_EOL:
  08B7'   CD 07A0'              	CALL	SETMOV
  08BA'   21 FFFF               	LXI	H,0FFFFH
  08BD'   22 2D35'              	SHLD	GOALCOL
  08C0'   CD 06CB'              	CALL	GETCNT
  08C3'   2B                    	DCX	H		; count-1
  08C4'   7C                    	MOV	A,H
  08C5'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C6'   CA 08D5'              	JZ	VEOL_0
  08C9'   E5                    	PUSH	H
  08CA'   CD 08EA'              	CALL	ONLAST
  08CD'   E1                    	POP	H
  08CE'   D8                    	RC			; the last line: no move (vim)
  08CF'   CD 093A'              	CALL	JCORE
  08D2'   C3 0A89'              	JMP	JKLAND
  08D5'                         VEOL_0:
  08D5'   CD 0868'              	CALL	LNSTRT
  08D8'   C3 0A89'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  08DB'                         VC_CR:
  08DB'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  08DE'   E5                    	PUSH	H
  08DF'   CD 08EA'              	CALL	ONLAST
  08E2'   E1                    	POP	H
  08E3'   D8                    	RC
  08E4'   CD 093A'              	CALL	JCORE
  08E7'   C3 087F'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  08EA'                         ONLAST:
  08EA'   CD 0000*              	CALL	RGET0
  08ED'                         OL_LP:
  08ED'   CD 0000*              	CALL	RDGET
  08F0'   D8                    	RC			; the file ends on this line
  08F1'   FE 0A                 	CPI	LF
  08F3'   C2 08ED'              	JNZ	OL_LP
  08F6'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08F9'                         VC_J:
  08F9'   CD 07A0'              	CALL	SETMOV
  08FC'   CD 0924'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08FF'   CD 06CB'              	CALL	GETCNT		; HL = count
  0902'   CD 093A'              	CALL	JCORE
  0905'   CD 091D'              	CALL	JKDRP
  0908'   C3 0A89'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  090B'                         VC_K:
  090B'   CD 07A0'              	CALL	SETMOV
  090E'   CD 0924'              	CALL	GLCHK
  0911'   CD 06CB'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0914'   CD 09D7'              	CALL	KCORE
  0917'   CD 091D'              	CALL	JKDRP
  091A'   C3 0A89'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  091D'                         JKDRP:
  091D'   7A                    	MOV	A,D
  091E'   B3                    	ORA	E
  091F'   C0                    	RNZ
  0920'   32 2D62'              	STA	PSAVE
  0923'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0924'                         GLCHK:
  0924'   2A 2D35'              	LHLD	GOALCOL
  0927'   7C                    	MOV	A,H
  0928'   3C                    	INR	A
  0929'   C0                    	RNZ
  092A'   7D                    	MOV	A,L
  092B'   FE FE                 	CPI	0FEH
  092D'   C0                    	RNZ
  092E'   C3 05BD'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  0931'                         GLSTAL:
  0931'   E5                    	PUSH	H
  0932'   21 FFFE               	LXI	H,0FFFEH
  0935'   22 2D35'              	SHLD	GOALCOL
  0938'   E1                    	POP	H
  0939'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  093A'                         JCORE:
  093A'   7C                    	MOV	A,H
  093B'   B5                    	ORA	L
  093C'   C8                    	RZ
  093D'   22 2D46'              	SHLD	JKCNT
  0940'   CD 0D4C'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0943'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0944'   3A 0000*              	LDA	NEDIT
  0947'   3C                    	INR	A
  0948'   90                    	SUB	B
  0949'   5F                    	MOV	E,A
  094A'   16 00                 	MVI	D,0
  094C'   3A 0000*              	LDA	NEDIT
  094F'   6F                    	MOV	L,A
  0950'   26 00                 	MVI	H,0
  0952'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0953'   EB                    	XCHG			; DE = limit
  0954'   2A 2D46'              	LHLD	JKCNT
  0957'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  095A'   D2 095E'              	JNC	JC_N
  095D'   EB                    	XCHG			; HL = limit
  095E'                         JC_N:
  095E'   22 2D48'              	SHLD	JKN		; N = min(count, limit)
  0961'   EB                    	XCHG			; DE = LFs to find
  0962'   CD 0000*              	CALL	RGET0
  0965'                         JC_SC:
  0965'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0968'   DA 0987'              	JC	JC_EOF
  096B'   32 2D4F'              	STA	JKLST
  096E'   FE 0A                 	CPI	LF
  0970'   C2 0965'              	JNZ	JC_SC
  0973'   1B                    	DCX	D
  0974'   7A                    	MOV	A,D
  0975'   B3                    	ORA	E
  0976'   C2 0965'              	JNZ	JC_SC
  0979'   2A 2D46'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  097C'   22 2D4A'              	SHLD	JKMOV		;   one if the last LF found ends the file
  097F'   3E 01                 	MVI	A,1
  0981'   32 2D4E'              	STA	JKPHN
  0984'   C3 09A2'              	JMP	JC_MV
  0987'                         JC_EOF:
  0987'   2A 2D48'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  098A'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  098D'   7C                    	MOV	A,H
  098E'   B5                    	ORA	L
  098F'   CA 099B'              	JZ	JC_AV
  0992'   3A 2D4F'              	LDA	JKLST
  0995'   FE 0A                 	CPI	LF
  0997'   C2 099B'              	JNZ	JC_AV
  099A'   2B                    	DCX	H
  099B'                         JC_AV:
  099B'   22 2D4A'              	SHLD	JKMOV
  099E'   AF                    	XRA	A
  099F'   32 2D4E'              	STA	JKPHN
  09A2'                         JC_MV:
  09A2'   2A 2D46'              	LHLD	JKCNT
  09A5'   AF                    	XRA	A
  09A6'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  09A9'   CD 0A68'              	CALL	ATEOF
  09AC'   D2 09C0'              	JNC	JC_DN
  09AF'   CD 0A6E'              	CALL	LASTLN		; ran past the last line: back onto it
  09B2'   3A 2D4E'              	LDA	JKPHN
  09B5'   B7                    	ORA	A
  09B6'   CA 09C0'              	JZ	JC_DN
  09B9'   2A 2D4A'              	LHLD	JKMOV
  09BC'   2B                    	DCX	H
  09BD'   22 2D4A'              	SHLD	JKMOV
  09C0'                         JC_DN:
  09C0'   2A 2D48'              	LHLD	JKN		; LNDLT += min(moved, N)
  09C3'   EB                    	XCHG
  09C4'   2A 2D4A'              	LHLD	JKMOV
  09C7'   CD 0000*              	CALL	CMP16		; CY iff N < moved
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09CA'   D2 09CE'              	JNC	JC_AD
  09CD'   EB                    	XCHG
  09CE'                         JC_AD:
  09CE'   EB                    	XCHG			; DE = lines moved
  09CF'   2A 0000*              	LHLD	LNDLT
  09D2'   19                    	DAD	D
  09D3'   22 0000*              	SHLD	LNDLT
  09D6'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  09D7'                         KCORE:
  09D7'   7C                    	MOV	A,H
  09D8'   B5                    	ORA	L
  09D9'   C8                    	RZ
  09DA'   22 2D46'              	SHLD	JKCNT
  09DD'   CD 0D4C'              	CALL	CURRW		; limit = row + NEDIT
  09E0'   5F                    	MOV	E,A
  09E1'   16 00                 	MVI	D,0
  09E3'   3A 0000*              	LDA	NEDIT
  09E6'   6F                    	MOV	L,A
  09E7'   26 00                 	MVI	H,0
  09E9'   19                    	DAD	D
  09EA'   EB                    	XCHG			; DE = limit
  09EB'   2A 2D46'              	LHLD	JKCNT
  09EE'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  09F1'   D2 09F5'              	JNC	KC_N
  09F4'   EB                    	XCHG			; HL = limit
  09F5'                         KC_N:
  09F5'   22 2D48'              	SHLD	JKN		; N = min(count, limit)
  09F8'   EB                    	XCHG			; DE = LFs to find
  09F9'   21 0000               	LXI	H,0
  09FC'   22 2D4C'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  09FF'                         KC_ED:
  09FF'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0A00'   2A 2D4C'              	LHLD	JKBK
  0A03'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A06'   E5                    	PUSH	H
  0A07'   EB                    	XCHG
  0A08'   2A 0000*              	LHLD	TXTBEG
  0A0B'   EB                    	XCHG
  0A0C'   CD 0000*              	CALL	SUBHD
  0A0F'   44                    	MOV	B,H
  0A10'   4D                    	MOV	C,L
  0A11'   E1                    	POP	H
  0A12'   D1                    	POP	D
  0A13'                         KC_SC:
  0A13'   78                    	MOV	A,B
  0A14'   B1                    	ORA	C
  0A15'   CA 0A2C'              	JZ	KC_TB
  0A18'   2B                    	DCX	H
  0A19'   0B                    	DCX	B
  0A1A'   7E                    	MOV	A,M
  0A1B'   FE 0A                 	CPI	LF
  0A1D'   C2 0A13'              	JNZ	KC_SC
  0A20'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A21'   7A                    	MOV	A,D
  0A22'   B3                    	ORA	E
  0A23'   C2 0A13'              	JNZ	KC_SC
  0A26'   2A 2D46'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A29'   C3 0A4C'              	JMP	KC_MV
  0A2C'                         KC_TB:
  0A2C'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A2D'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A30'   22 2D4C'              	SHLD	JKBK
  0A33'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A36'   7C                    	MOV	A,H
  0A37'   B5                    	ORA	L
  0A38'   CA 0A45'              	JZ	KC_B0
  0A3B'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0A3E'   D1                    	POP	D
  0A3F'   DA 0A46'              	JC	KC_BOF
  0A42'   C3 09FF'              	JMP	KC_ED
  0A45'                         KC_B0:
  0A45'   D1                    	POP	D
  0A46'                         KC_BOF:
  0A46'   2A 2D48'              	LHLD	JKN		; moved = LFs found
  0A49'   CD 0000*              	CALL	SUBHD
  0A4C'                         KC_MV:
  0A4C'   E5                    	PUSH	H
  0A4D'   2A 2D46'              	LHLD	JKCNT
  0A50'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0A53'   D1                    	POP	D		; DE = moved
  0A54'   2A 2D48'              	LHLD	JKN
  0A57'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0A5A'   DA 0A5E'              	JC	KC_AD
  0A5D'   EB                    	XCHG			; DE = N
  0A5E'                         KC_AD:
  0A5E'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0A61'   CD 0000*              	CALL	SUBHD
  0A64'   22 0000*              	SHLD	LNDLT
  0A67'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A68'                         ATEOF:
  0A68'   CD 0000*              	CALL	RGET0
  0A6B'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A6E'                         LASTLN:
  0A6E'   2A 0000*              	LHLD	GAPBEG
  0A71'   EB                    	XCHG
  0A72'   2A 0000*              	LHLD	TXTBEG
  0A75'   CD 0000*              	CALL	CMP16
  0A78'   21 0000               	LXI	H,0
  0A7B'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A7E'   1B                    	DCX	D
  0A7F'   1A                    	LDAX	D
  0A80'   FE 0A                 	CPI	LF
  0A82'   C2 0000*              	JNZ	SETBWD
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A85'   23                    	INX	H
  0A86'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A89'                         JKLAND:
  0A89'   21 0000               	LXI	H,0
  0A8C'   22 2D50'              	SHLD	JKVC		; screen column
  0A8F'   2B                    	DCX	H
  0A90'   22 2D52'              	SHLD	JKLS		; last content char: none yet
  0A93'   CD 0000*              	CALL	RGET0
  0A96'   11 0000               	LXI	D,0		; DE = chars read
  0A99'                         JL_RD:
  0A99'   CD 0000*              	CALL	RDGET
  0A9C'   DA 0AD6'              	JC	JL_END
  0A9F'   FE 0A                 	CPI	LF
  0AA1'   CA 0AD6'              	JZ	JL_END
  0AA4'   E5                    	PUSH	H
  0AA5'   C5                    	PUSH	B
  0AA6'   2A 2D50'              	LHLD	JKVC
  0AA9'   CD 0611'              	CALL	CWID
  0AAC'   B7                    	ORA	A
  0AAD'   CA 0AD0'              	JZ	JL_NX		; a CR
  0AB0'   EB                    	XCHG
  0AB1'   22 2D52'              	SHLD	JKLS		; the last content char so far
  0AB4'   EB                    	XCHG
  0AB5'   4F                    	MOV	C,A
  0AB6'   06 00                 	MVI	B,0
  0AB8'   09                    	DAD	B		; HL = the column after this char
  0AB9'   22 2D50'              	SHLD	JKVC
  0ABC'   D5                    	PUSH	D
  0ABD'   EB                    	XCHG
  0ABE'   2A 2D35'              	LHLD	GOALCOL
  0AC1'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0AC4'   D1                    	POP	D
  0AC5'   DA 0AD0'              	JC	JL_NX
  0AC8'   CA 0AD0'              	JZ	JL_NX
  0ACB'   C1                    	POP	B		; this char holds the goal column
  0ACC'   E1                    	POP	H
  0ACD'   C3 0AE1'              	JMP	JL_GO
  0AD0'                         JL_NX:
  0AD0'   C1                    	POP	B
  0AD1'   E1                    	POP	H
  0AD2'   13                    	INX	D
  0AD3'   C3 0A99'              	JMP	JL_RD
  0AD6'                         JL_END:
  0AD6'   2A 2D52'              	LHLD	JKLS		; past the line's end: its last content char
  0AD9'   7C                    	MOV	A,H
  0ADA'   A5                    	ANA	L
  0ADB'   3C                    	INR	A
  0ADC'   C2 0AE0'              	JNZ	JL_LS
  0ADF'   23                    	INX	H		; no content: the line's start
  0AE0'                         JL_LS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AE0'   EB                    	XCHG
  0AE1'                         JL_GO:
  0AE1'   D5                    	PUSH	D		; DE = step from the line start
  0AE2'   CD 0000*              	CALL	CUROFF
  0AE5'   D1                    	POP	D
  0AE6'   19                    	DAD	D
  0AE7'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0AEA'   AF                    VC_W:	XRA	A
  0AEB'   32 2D37'              	STA	WBIG
  0AEE'   C3 0AF6'              	JMP	WDO
  0AF1'   3E 01                 VCBGW:	MVI	A,1
  0AF3'   32 2D37'              	STA	WBIG
  0AF6'   CD 07A0'              WDO:	CALL	SETMOV
  0AF9'   AF                    	XRA	A
  0AFA'   32 2D38'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AFD'   CD 06CB'              	CALL	GETCNT
  0B00'   22 2D7A'              	SHLD	CNTV
  0B03'   2A 2D7A'              WDO_LP: LHLD	CNTV
  0B06'   7C                    	MOV	A,H
  0B07'   B5                    	ORA	L
  0B08'   CA 0B15'              	JZ	WDO_DN
  0B0B'   2B                    	DCX	H
  0B0C'   22 2D7A'              	SHLD	CNTV
  0B0F'   CD 0B72'              	CALL	FWD1
  0B12'   D2 0B03'              	JNC	WDO_LP
  0B15'                         WDO_DN:
  0B15'   CD 0A68'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0B18'   DA 0B25'              	JC	WDO_NL
  0B1B'   FE 0D                 	CPI	CR
  0B1D'   CA 0B25'              	JZ	WDO_NL
  0B20'   FE 0A                 	CPI	LF
  0B22'   C2 05BD'              	JNZ	SETGL
  0B25'                         WDO_NL:
  0B25'   CD 0000*              	CALL	PEEKL
  0B28'   DA 05BD'              	JC	SETGL
  0B2B'   FE 0A                 	CPI	LF
  0B2D'   CA 05BD'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0B30'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0B32'   32 2D38'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0B35'   CD 0C91'              	CALL	DECC		; back onto its last char
  0B38'   C3 05BD'              	JMP	SETGL
                                
  0B3B'   AF                    VC_B:	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B3C'   32 2D37'              	STA	WBIG
  0B3F'   C3 0B47'              	JMP	BDO
  0B42'   3E 01                 VCBGB:	MVI	A,1
  0B44'   32 2D37'              	STA	WBIG
  0B47'   CD 07A0'              BDO:	CALL	SETMOV
  0B4A'   CD 06CB'              	CALL	GETCNT
  0B4D'   22 2D7A'              	SHLD	CNTV
  0B50'   CD 0BE2'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0B53'   D2 0B63'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0B56'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0B57'   32 2D62'              	STA	PSAVE		;   first char opened an insert).  A count that
  0B5A'   C3 05BD'              	JMP	SETGL		;   runs out at the start has still moved, and
  0B5D'                         BDO_LP:				;   its operator stands -- both as vim
  0B5D'   CD 0BE2'              	CALL	BCK1
  0B60'   DA 05BD'              	JC	SETGL
  0B63'   2A 2D7A'              BDO_NX: LHLD	CNTV
  0B66'   2B                    	DCX	H
  0B67'   22 2D7A'              	SHLD	CNTV
  0B6A'   7C                    	MOV	A,H
  0B6B'   B5                    	ORA	L
  0B6C'   C2 0B5D'              	JNZ	BDO_LP
  0B6F'   C3 05BD'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0B72'                         FWD1:
  0B72'   CD 0C15'              	CALL	CCLS
  0B75'   32 2D86'              	STA	WKCLS		; the starting class
  0B78'   CD 0C4F'              	CALL	INCC
  0B7B'   B7                    	ORA	A
  0B7C'   CA 0B95'              	JZ	FW_WD
  0B7F'   37                    	STC
  0B80'   F8                    	RM			; -1: already at the end
  0B81'   CD 0BCD'              	CALL	WLAST
  0B84'   C8                    	RZ
  0B85'   FE 02                 	CPI	2
  0B87'   C2 0B95'              	JNZ	FW_WD		; 1: a next line was reached
  0B8A'   CD 0A68'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B8D'   D4 0C36'              	CNC	NXLN
  0B90'   D2 0B95'              	JNC	FW_WD
  0B93'   37                    	STC			; yes: failed
  0B94'   C9                    	RET
  0B95'                         FW_WD:
  0B95'   3A 2D86'              	LDA	WKCLS		; go past the rest of this word
  0B98'   B7                    	ORA	A
  0B99'   CA 0BB5'              	JZ	FW_WS
  0B9C'                         FW_WLP:
  0B9C'   CD 0C15'              	CALL	CCLS
  0B9F'   21 2D86'              	LXI	H,WKCLS
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0BA2'   BE                    	CMP	M
  0BA3'   C2 0BB5'              	JNZ	FW_WS
  0BA6'   CD 0C4F'              	CALL	INCC
  0BA9'   B7                    	ORA	A
  0BAA'   F8                    	RM			; the end of the file (NC)
  0BAB'   CA 0B9C'              	JZ	FW_WLP
  0BAE'   CD 0BCD'              	CALL	WLAST
  0BB1'   C8                    	RZ
  0BB2'   C3 0B9C'              	JMP	FW_WLP
  0BB5'                         FW_WS:
  0BB5'   CD 0C15'              	CALL	CCLS		; then over blanks to the next word
  0BB8'   B7                    	ORA	A
  0BB9'   C0                    	RNZ
  0BBA'   CD 0C1D'              	CALL	EMPTY
  0BBD'   C8                    	RZ			; an empty line is a word
  0BBE'   CD 0C4F'              	CALL	INCC
  0BC1'   B7                    	ORA	A
  0BC2'   F8                    	RM
  0BC3'   CA 0BB5'              	JZ	FW_WS
  0BC6'   CD 0BCD'              	CALL	WLAST
  0BC9'   C8                    	RZ
  0BCA'   C3 0BB5'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0BCD'                         WLAST:
  0BCD'   47                    	MOV	B,A
  0BCE'   2A 2D7A'              	LHLD	CNTV
  0BD1'   7C                    	MOV	A,H
  0BD2'   B5                    	ORA	L
  0BD3'   C2 0BDE'              	JNZ	WL_X		; words still owed
  0BD6'   3A 2D62'              	LDA	PSAVE
  0BD9'   B7                    	ORA	A
  0BDA'   CA 0BE0'              	JZ	WL_NO		; a plain 'w'
  0BDD'   AF                    	XRA	A
  0BDE'   78                    WL_X:	MOV	A,B
  0BDF'   C9                    	RET
  0BE0'   B0                    WL_NO:	ORA	B
  0BE1'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0BE2'                         BCK1:
  0BE2'   CD 0C91'              	CALL	DECC
  0BE5'   B7                    	ORA	A
  0BE6'   37                    	STC
  0BE7'   F8                    	RM
  0BE8'                         BK_WS:
  0BE8'   CD 0C15'              	CALL	CCLS		; back over blanks
  0BEB'   B7                    	ORA	A
  0BEC'   C2 0BFC'              	JNZ	BK_WD
  0BEF'   CD 0C1D'              	CALL	EMPTY
  0BF2'   C8                    	RZ			; an empty line is a word
  0BF3'   CD 0C91'              	CALL	DECC
  0BF6'   B7                    	ORA	A
  0BF7'   F2 0BE8'              	JP	BK_WS
  0BFA'   AF                    	XRA	A		; the start of the file (NC)
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BFB'   C9                    	RET
  0BFC'                         BK_WD:
  0BFC'   32 2D86'              	STA	WKCLS		; back to the start of this word
  0BFF'                         BK_WLP:
  0BFF'   CD 0C91'              	CALL	DECC
  0C02'   B7                    	ORA	A
  0C03'   FA 0C13'              	JM	BK_OK		; the start of the file
  0C06'   CD 0C15'              	CALL	CCLS
  0C09'   21 2D86'              	LXI	H,WKCLS
  0C0C'   BE                    	CMP	M
  0C0D'   CA 0BFF'              	JZ	BK_WLP
  0C10'   CD 0C4F'              	CALL	INCC		; overshot: forward one
  0C13'                         BK_OK:
  0C13'   AF                    	XRA	A
  0C14'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0C15'                         CCLS:
  0C15'   CD 0A68'              	CALL	ATEOF
  0C18'   D2 0755'              	JNC	CLASSF
  0C1B'   AF                    	XRA	A
  0C1C'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0C1D'                         EMPTY:
  0C1D'   CD 0A68'              	CALL	ATEOF
  0C20'   DA 0C2B'              	JC	EM_ST
  0C23'   FE 0D                 	CPI	CR
  0C25'   CA 0C2B'              	JZ	EM_ST
  0C28'   FE 0A                 	CPI	LF
  0C2A'   C0                    	RNZ
  0C2B'                         EM_ST:
  0C2B'   CD 0000*              	CALL	PEEKL
  0C2E'   DA 0C34'              	JC	EM_Y
  0C31'   FE 0A                 	CPI	LF
  0C33'   C9                    	RET
  0C34'                         EM_Y:
  0C34'   AF                    	XRA	A
  0C35'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0C36'                         NXLN:
  0C36'   FE 0A                 	CPI	LF
  0C38'   CA 0C47'              	JZ	NX_LF
  0C3B'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0C3E'   D8                    	RC
  0C3F'   FE 0A                 	CPI	LF
  0C41'   CA 0C47'              	JZ	NX_LF
  0C44'   2B                    	DCX	H		; a lone CR
  0C45'   AF                    	XRA	A
  0C46'   C9                    	RET
  0C47'                         NX_LF:
  0C47'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0C4A'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C4B'   2B                    	DCX	H
  0C4C'   3E 01                 	MVI	A,1
  0C4E'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0C4F'                         INCC:
  0C4F'   CD 0A68'              	CALL	ATEOF
  0C52'   DA 0C8D'              	JC	IC_END
  0C55'   FE 0D                 	CPI	CR
  0C57'   CA 0C78'              	JZ	IC_NL
  0C5A'   FE 0A                 	CPI	LF
  0C5C'   CA 0C78'              	JZ	IC_NL
  0C5F'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0C62'                         IC_CH:
  0C62'   CD 0A68'              	CALL	ATEOF
  0C65'   DA 0C74'              	JC	IC_2
  0C68'   FE 0D                 	CPI	CR
  0C6A'   CA 0C74'              	JZ	IC_2
  0C6D'   FE 0A                 	CPI	LF
  0C6F'   CA 0C74'              	JZ	IC_2
  0C72'   AF                    	XRA	A
  0C73'   C9                    	RET
  0C74'                         IC_2:
  0C74'   3E 02                 	MVI	A,2
  0C76'   B7                    	ORA	A
  0C77'   C9                    	RET
  0C78'                         IC_NL:
  0C78'   CD 0C36'              	CALL	NXLN
  0C7B'   DA 0C8D'              	JC	IC_END
  0C7E'   F5                    	PUSH	PSW
  0C7F'   CD 0000*              	CALL	PUTCUR
  0C82'   F1                    	POP	PSW
  0C83'   B7                    	ORA	A
  0C84'   CA 0C62'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0C87'   CD 0CB3'              	CALL	LNINC
  0C8A'   3E 01                 	MVI	A,1
  0C8C'   C9                    	RET
  0C8D'                         IC_END:
  0C8D'   3E FF                 	MVI	A,0FFH
  0C8F'   B7                    	ORA	A
  0C90'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0C91'                         DECC:
  0C91'   CD 0000*              	CALL	PEEKL
  0C94'   DA 0C8D'              	JC	IC_END
  0C97'   F5                    	PUSH	PSW
  0C98'   CD 0000*              	CALL	PUTCUR
  0C9B'   F1                    	POP	PSW
  0C9C'   FE 0A                 	CPI	LF
  0C9E'   3E 00                 	MVI	A,0
  0CA0'   C0                    	RNZ
  0CA1'   CD 0CC1'              	CALL	LNDEC
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CA4'   CD 0000*              	CALL	PEEKL		; onto its CR
  0CA7'   DA 0CAF'              	JC	DC_1
  0CAA'   FE 0D                 	CPI	CR
  0CAC'   CC 0000*              	CZ	PUTCUR
  0CAF'                         DC_1:
  0CAF'   3E 01                 	MVI	A,1
  0CB1'   B7                    	ORA	A
  0CB2'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0CB3'                         LNINC:
  0CB3'   E5                    	PUSH	H
  0CB4'   2A 0000*              	LHLD	LNDLT
  0CB7'   7C                    	MOV	A,H
  0CB8'   FE 40                 	CPI	40H
  0CBA'   CA 0CCF'              	JZ	LN_X
  0CBD'   23                    	INX	H
  0CBE'   C3 0CCC'              	JMP	LN_ST
  0CC1'                         LNDEC:
  0CC1'   E5                    	PUSH	H
  0CC2'   2A 0000*              	LHLD	LNDLT
  0CC5'   7C                    	MOV	A,H
  0CC6'   FE C0                 	CPI	0C0H
  0CC8'   CA 0CCF'              	JZ	LN_X
  0CCB'   2B                    	DCX	H
  0CCC'                         LN_ST:
  0CCC'   22 0000*              	SHLD	LNDLT
  0CCF'                         LN_X:
  0CCF'   E1                    	POP	H
  0CD0'   C9                    	RET
                                
  0CD1'   AF                    VC_E:	XRA	A
  0CD2'   32 2D37'              	STA	WBIG
  0CD5'   C3 0CDD'              	JMP	EDO
  0CD8'   3E 01                 VCBGE:	MVI	A,1
  0CDA'   32 2D37'              	STA	WBIG
  0CDD'   CD 07A0'              EDO:	CALL	SETMOV
  0CE0'   CD 06CB'              	CALL	GETCNT
  0CE3'   22 2D7A'              	SHLD	CNTV
  0CE6'   2A 2D7A'              EDO_LP: LHLD	CNTV
  0CE9'   7C                    	MOV	A,H
  0CEA'   B5                    	ORA	L
  0CEB'   CA 0B15'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0CEE'   2B                    	DCX	H
  0CEF'   22 2D7A'              	SHLD	CNTV
  0CF2'   CD 0D00'              	CALL	ESTEP
  0CF5'   21 2D65'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0CF8'   36 00                 	MVI	M,0
  0CFA'   D2 0CE6'              	JNC	EDO_LP
  0CFD'   C3 0B15'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ; at the last line the window held.
  0D00'                         ESTEP:
  0D00'   CD 0C15'              	CALL	CCLS
  0D03'   32 2D86'              	STA	WKCLS		; the starting class
  0D06'   CD 0C4F'              	CALL	INCC
  0D09'   B7                    	ORA	A
  0D0A'   FA 0D30'              	JM	ES_F
  0D0D'   CD 0C15'              	CALL	CCLS
  0D10'   B7                    	ORA	A
  0D11'   CA 0D1B'              	JZ	ES_ST
  0D14'   21 2D86'              	LXI	H,WKCLS
  0D17'   BE                    	CMP	M
  0D18'   CA 0D32'              	JZ	ES_SK		; still in the word it started in: on to its end
  0D1B'                         ES_ST:
  0D1B'   3A 2D65'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0D1E'   B7                    	ORA	A		;   that char is the word's end already, and
  0D1F'   C2 0D49'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0D22'                         ES_WS:
  0D22'   CD 0C15'              	CALL	CCLS		; over blanks, line ends and empty lines
  0D25'   B7                    	ORA	A
  0D26'   C2 0D32'              	JNZ	ES_SK
  0D29'   CD 0C4F'              	CALL	INCC
  0D2C'   B7                    	ORA	A
  0D2D'   F2 0D22'              	JP	ES_WS
  0D30'                         ES_F:
  0D30'   37                    	STC
  0D31'   C9                    	RET
  0D32'                         ES_SK:
  0D32'   CD 0C15'              	CALL	CCLS		; past the rest of this word ...
  0D35'   32 2D86'              	STA	WKCLS
  0D38'                         ES_SL:
  0D38'   CD 0C4F'              	CALL	INCC
  0D3B'   B7                    	ORA	A
  0D3C'   FA 0D30'              	JM	ES_F
  0D3F'   CD 0C15'              	CALL	CCLS
  0D42'   21 2D86'              	LXI	H,WKCLS
  0D45'   BE                    	CMP	M
  0D46'   CA 0D38'              	JZ	ES_SL
  0D49'   C3 0C91'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D4C'                         CURRW:
  0D4C'   2A 0000*              	LHLD	WINROW
  0D4F'   EB                    	XCHG
  0D50'   2A 0000*              	LHLD	LNDLT
  0D53'   19                    	DAD	D		; HL = row (signed)
  0D54'   7C                    	MOV	A,H
  0D55'   B7                    	ORA	A
  0D56'   FA 0D69'              	JM	CRW_0		; above the screen -> top row
  0D59'   C2 0D64'              	JNZ	CRW_BT		; far below -> bottom row
  0D5C'   3A 0000*              	LDA	NEDIT
  0D5F'   3D                    	DCR	A		; A = bottom row
  0D60'   BD                    	CMP	L		; CY iff bottom < row
  0D61'   D8                    	RC
  0D62'   7D                    	MOV	A,L
  0D63'   C9                    	RET
  0D64'                         CRW_BT:
  0D64'   3A 0000*              	LDA	NEDIT
  0D67'   3D                    	DCR	A
  0D68'   C9                    	RET
  0D69'                         CRW_0:
  0D69'   AF                    	XRA	A
  0D6A'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0D6B'                         SETRWT:
  0D6B'   2A 0000*              	LHLD	LNDLT
  0D6E'   EB                    	XCHG
  0D6F'   6F                    	MOV	L,A
  0D70'   26 00                 	MVI	H,0
  0D72'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0D75'   22 0000*              	SHLD	WINROW
  0D78'   3E 01                 	MVI	A,PL_SET
  0D7A'   32 0000*              	STA	PLACE
  0D7D'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D7E'                         MVROW:
  0D7E'   47                    	MOV	B,A
  0D7F'   CD 0D4C'              	CALL	CURRW
  0D82'   90                    	SUB	B		; A = row now - target
  0D83'                         MR_GO:
  0D83'   C8                    	RZ
  0D84'   DA 0D8D'              	JC	MR_DN
  0D87'   6F                    	MOV	L,A
  0D88'   26 00                 	MVI	H,0
  0D8A'   C3 09D7'              	JMP	KCORE
  0D8D'                         MR_DN:
  0D8D'   2F                    	CMA
  0D8E'   3C                    	INR	A		; A = target - row now
  0D8F'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D90'   26 00                 	MVI	H,0
  0D92'   C3 093A'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D95'                         VC_HIGH:
  0D95'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0D98'   2B                    	DCX	H		; row = count - 1
  0D99'   7C                    	MOV	A,H
  0D9A'   B7                    	ORA	A
  0D9B'   3A 0000*              	LDA	SCBOT
  0D9E'   C2 0DA6'              	JNZ	VH_GO		; >= 256 -> the last text row
  0DA1'   BD                    	CMP	L		; CY iff SCBOT < row
  0DA2'   DA 0DA6'              	JC	VH_GO
  0DA5'   7D                    	MOV	A,L
  0DA6'                         VH_GO:
  0DA6'   CD 0D7E'              	CALL	MVROW
  0DA9'   C3 087F'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0DAC'                         VC_MIDL:
  0DAC'   CD 06B8'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0DAF'   CD 103E'              	CALL	HTSCR		; HL -> the top line's rows
  0DB2'   3A 0000*              	LDA	TXEND
  0DB5'   3C                    	INR	A
  0DB6'   B7                    	ORA	A
  0DB7'   1F                    	RAR
  0DB8'   3D                    	DCR	A
  0DB9'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0DBA'   CD 1084'              	CALL	HTFQ
  0DBD'   D2 0DC1'              	JNC	VM_GO
  0DC0'   2B                    	DCX	H
  0DC1'                         VM_GO:
  0DC1'   CD 1079'              	CALL	HTGO
  0DC4'   C3 087F'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0DC7'                         VC_LOWL:
  0DC7'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DCA'   2B                    	DCX	H		; count - 1
  0DCB'   3A 0000*              	LDA	SCBOT
  0DCE'   5F                    	MOV	E,A
  0DCF'   16 00                 	MVI	D,0
  0DD1'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0DD2'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0DD5'   3E 00                 	MVI	A,0
  0DD7'   D2 0DDE'              	JNC	VL_GO		; at or past the top -> row 0
  0DDA'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0DDD'   7D                    	MOV	A,L
  0DDE'                         VL_GO:
  0DDE'   CD 0D7E'              	CALL	MVROW
  0DE1'   C3 087F'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0DE4'                         VC_PGDN:
  0DE4'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0DE7'   22 2D42'              	SHLD	RWR
  0DEA'   3A 0000*              	LDA	SCEOF
  0DED'   B7                    	ORA	A
  0DEE'   CA 0DF6'              	JZ	VPD_N
  0DF1'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0DF4'   B7                    	ORA	A		;   top line
  0DF5'   C8                    	RZ			; it already is
  0DF6'                         VPD_N:
  0DF6'   3A 0000*              	LDA	NEDIT
  0DF9'   3C                    	INR	A
  0DFA'   4F                    	MOV	C,A
  0DFB'   3E 02                 	MVI	A,2
  0DFD'   CD 1045'              	CALL	HTSET		; HL -> the top line's rows
  0E00'   E5                    	PUSH	H
  0E01'   C5                    	PUSH	B
  0E02'   3A 0000*              	LDA	NEDIT
  0E05'   4F                    	MOV	C,A
  0E06'   CD 1084'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0E09'   3A 0000*              	LDA	NEDIT
  0E0C'   DA 0E19'              	JC	VPD_R		; there is none: no overlap
  0E0F'   3A 2D3D'              	LDA	HTN
  0E12'   90                    	SUB	B
  0E13'   3C                    	INR	A
  0E14'   47                    	MOV	B,A		; the lines from it up to the table's first
  0E15'   AF                    	XRA	A
  0E16'   CD 0EB3'              	CALL	OVLAP
  0E19'                         VPD_R:
  0E19'   CD 0F02'              	CALL	PGROWS		; RWR = the rows to go
  0E1C'   C1                    	POP	B
  0E1D'   E1                    	POP	H
  0E1E'   CD 10C5'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0E21'   DA 0E3D'              	JC	VPD_TP		; the text ended: its last line
  0E24'   79                    	MOV	A,C
  0E25'   B7                    	ORA	A
  0E26'   CA 0E3D'              	JZ	VPD_TP
  0E29'   3A 2D44'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0E2C'   B7                    	ORA	A		;   that is the top line still, then the next
  0E2D'   C2 0E3D'              	JNZ	VPD_TP
  0E30'   E5                    	PUSH	H
  0E31'   CD 1073'              	CALL	HTIX
  0E34'   21 2D3F'              	LXI	H,HTTP
  0E37'   BE                    	CMP	M
  0E38'   E1                    	POP	H
  0E39'   C2 0E3D'              	JNZ	VPD_TP
  0E3C'   23                    	INX	H
  0E3D'                         VPD_TP:
  0E3D'   54                    	MOV	D,H
  0E3E'   5D                    	MOV	E,L
  0E3F'   C3 0FAC'              	JMP	HTLAND
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0E42'                         VC_PGUP:
  0E42'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  0E45'   22 2D42'              	SHLD	RWR
  0E48'   3A 0000*              	LDA	SCBOF
  0E4B'   B7                    	ORA	A
  0E4C'   C0                    	RNZ
  0E4D'   CD 0D4C'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0E50'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0E52'   0E 01                 	MVI	C,1
  0E54'   D2 0E5B'              	JNC	VPU_1
  0E57'   3A 0000*              	LDA	NEDIT
  0E5A'   4F                    	MOV	C,A
  0E5B'                         VPU_1:
  0E5B'   3A 0000*              	LDA	NEDIT
  0E5E'   CD 1045'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0E61'   E5                    	PUSH	H
  0E62'   D5                    	PUSH	D
  0E63'   2B                    	DCX	H		; the line above the top one, and on down
  0E64'   04                    	INR	B
  0E65'   3E 01                 	MVI	A,1
  0E67'   CD 0EB3'              	CALL	OVLAP
  0E6A'   CD 0F02'              	CALL	PGROWS		; RWR = the rows to go
  0E6D'   D1                    	POP	D
  0E6E'   E1                    	POP	H
  0E6F'   43                    	MOV	B,E
  0E70'   CD 1105'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0E73'   DA 0E90'              	JC	VPU_3		;   above it; or the file's first line
  0E76'   79                    	MOV	A,C
  0E77'   B7                    	ORA	A
  0E78'   CA 0E90'              	JZ	VPU_3
  0E7B'   3A 2D44'              	LDA	RWMV
  0E7E'   B7                    	ORA	A
  0E7F'   C2 0E8F'              	JNZ	VPU_2
  0E82'   E5                    	PUSH	H
  0E83'   CD 1073'              	CALL	HTIX
  0E86'   3C                    	INR	A
  0E87'   21 2D3F'              	LXI	H,HTTP
  0E8A'   BE                    	CMP	M
  0E8B'   E1                    	POP	H
  0E8C'   CA 0E90'              	JZ	VPU_3		; the first line back: all of it
  0E8F'                         VPU_2:
  0E8F'   23                    	INX	H
  0E90'                         VPU_3:
  0E90'   CD 1079'              	CALL	HTGO		; the cursor on the new top line ...
  0E93'   3A 0000*              	LDA	NEDIT
  0E96'   4F                    	MOV	C,A
  0E97'   06 00                 	MVI	B,0
  0E99'   CD 105A'              	CALL	HTRB		; ... and the lines under it measured
  0E9C'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0E9D'   3A 0000*              	LDA	NEDIT
  0EA0'   4F                    	MOV	C,A
  0EA1'   CD 1084'              	CALL	HTFQ		; HL -> the first the screen has not room for
  0EA4'   2B                    	DCX	H
  0EA5'   D1                    	POP	D		; DE -> the top line's rows
  0EA6'   EB                    	XCHG
  0EA7'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  0EAA'   D2 0EAF'              	JNC	VPU_4		;   fills the screen)
  0EAD'   54                    	MOV	D,H
  0EAE'   5D                    	MOV	E,L
  0EAF'                         VPU_4:
  0EAF'   EB                    	XCHG
  0EB0'   C3 0FAC'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0EB3'                         OVLAP:
  0EB3'   32 2D45'              	STA	OVDIR
  0EB6'   3A 0000*              	LDA	NEDIT
  0EB9'   D6 02                 	SUI	2
  0EBB'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0EBC'   56                    	MOV	D,M		; D = h1
  0EBD'   CD 0EF4'              	CALL	OV_NX
  0EC0'   DA 0EF0'              	JC	OV_0
  0EC3'   5E                    	MOV	E,M		; E = h2
  0EC4'   7A                    	MOV	A,D
  0EC5'   83                    	ADD	E
  0EC6'   57                    	MOV	D,A		; D = h1 + h2
  0EC7'   79                    	MOV	A,C
  0EC8'   BA                    	CMP	D
  0EC9'   DA 0EF0'              	JC	OV_0
  0ECC'   CD 0EF4'              	CALL	OV_NX
  0ECF'   DA 0EF0'              	JC	OV_0
  0ED2'   7B                    	MOV	A,E
  0ED3'   86                    	ADD	M
  0ED4'   5F                    	MOV	E,A		; E = h2 + h3
  0ED5'   79                    	MOV	A,C
  0ED6'   BB                    	CMP	E
  0ED7'   DA 0EF0'              	JC	OV_0
  0EDA'   7A                    	MOV	A,D
  0EDB'   86                    	ADD	M
  0EDC'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0EDD'   CD 0EF4'              	CALL	OV_NX
  0EE0'   DA 0EED'              	JC	OV_1
  0EE3'   7B                    	MOV	A,E
  0EE4'   86                    	ADD	M		; h2 + h3 + h4
  0EE5'   5F                    	MOV	E,A
  0EE6'   79                    	MOV	A,C
  0EE7'   BB                    	CMP	E
  0EE8'   DA 0EED'              	JC	OV_1
  0EEB'   BA                    	CMP	D
  0EEC'   D0                    	RNC			; two lines of overlap
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EED'                         OV_1:
  0EED'   79                    	MOV	A,C
  0EEE'   3C                    	INR	A
  0EEF'   C9                    	RET
  0EF0'                         OV_0:
  0EF0'   79                    	MOV	A,C
  0EF1'   C6 02                 	ADI	2
  0EF3'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0EF4'                         OV_NX:
  0EF4'   05                    	DCR	B
  0EF5'   37                    	STC
  0EF6'   C8                    	RZ
  0EF7'   3A 2D45'              	LDA	OVDIR
  0EFA'   B7                    	ORA	A		; (CY off)
  0EFB'   CA 0F00'              	JZ	OV_UP
  0EFE'   23                    	INX	H
  0EFF'   23                    	INX	H
  0F00'                         OV_UP:
  0F00'   2B                    	DCX	H
  0F01'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  0F02'                         PGROWS:
  0F02'   2A 2D42'              	LHLD	RWR
  0F05'   CD 0F10'              	CALL	MULSAT
  0F08'   22 2D42'              	SHLD	RWR
  0F0B'   AF                    	XRA	A
  0F0C'   32 2D44'              	STA	RWMV
  0F0F'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0F10'                         MULSAT:
  0F10'   EB                    	XCHG
  0F11'   21 0000               	LXI	H,0
  0F14'   B7                    	ORA	A
  0F15'   C8                    	RZ
  0F16'                         MS_LP:
  0F16'   19                    	DAD	D
  0F17'   DA 0F1F'              	JC	MS_SAT
  0F1A'   3D                    	DCR	A
  0F1B'   C2 0F16'              	JNZ	MS_LP
  0F1E'   C9                    	RET
  0F1F'                         MS_SAT:
  0F1F'   21 FFFF               	LXI	H,0FFFFH
  0F22'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  0F23'                         VC_HFDN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F23'   CD 07A0'              	CALL	SETMOV
  0F26'   CD 1168'              	CALL	HFCNT		; HFN = the rows
  0F29'   3A 0000*              	LDA	TALLF
  0F2C'   B7                    	ORA	A
  0F2D'   C2 0FC3'              	JNZ	VHD_TL
  0F30'   CD 0D4C'              	CALL	CURRW
  0F33'   47                    	MOV	B,A
  0F34'   3A 0000*              	LDA	SCEOF
  0F37'   B7                    	ORA	A
  0F38'   CA 0F40'              	JZ	VHD_GO
  0F3B'   3A 0000*              	LDA	SCBOT		; the last line's place
  0F3E'   B8                    	CMP	B
  0F3F'   C8                    	RZ			; the cursor is on it
  0F40'                         VHD_GO:
  0F40'   3A 0000*              	LDA	NEDIT
  0F43'   21 2D3A'              	LXI	H,HFN
  0F46'   86                    	ADD	M
  0F47'   3C                    	INR	A
  0F48'   4F                    	MOV	C,A
  0F49'   AF                    	XRA	A
  0F4A'   CD 1045'              	CALL	HTSET		; HL -> the top line's rows
  0F4D'   3A 2D3A'              	LDA	HFN
  0F50'   57                    	MOV	D,A		; D = the rows the text moves
  0F51'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0F52'   3A 2D40'              	LDA	HTEOF
  0F55'   B7                    	ORA	A
  0F56'   CA 0F75'              	JZ	VHD_1
  0F59'   E5                    	PUSH	H
  0F5A'   C5                    	PUSH	B
  0F5B'   0E FF                 	MVI	C,255
  0F5D'   CD 1084'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0F60'   3A 0000*              	LDA	NEDIT
  0F63'   81                    	ADD	C
  0F64'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0F65'   C1                    	POP	B
  0F66'   E1                    	POP	H
  0F67'   B7                    	ORA	A
  0F68'   FA 0F73'              	JM	VHD_0		; none
  0F6B'   BA                    	CMP	D
  0F6C'   D2 0F75'              	JNC	VHD_1
  0F6F'   57                    	MOV	D,A
  0F70'   C3 0F75'              	JMP	VHD_1
  0F73'                         VHD_0:
  0F73'   16 00                 	MVI	D,0
  0F75'                         VHD_1:
  0F75'   7A                    	MOV	A,D
  0F76'   B7                    	ORA	A
  0F77'   CA 0F92'              	JZ	VHD_C		; the text stays
  0F7A'   4A                    	MOV	C,D
  0F7B'   CD 1084'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0F7E'   79                    	MOV	A,C
  0F7F'   B7                    	ORA	A
  0F80'   CA 0F92'              	JZ	VHD_C
  0F83'   BA                    	CMP	D
  0F84'   C2 0F8F'              	JNZ	VHD_R
  0F87'   7E                    	MOV	A,M		; the top line still: past all of it
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F88'   91                    	SUB	C
  0F89'   83                    	ADD	E
  0F8A'   5F                    	MOV	E,A
  0F8B'   23                    	INX	H
  0F8C'   C3 0F92'              	JMP	VHD_C
  0F8F'                         VHD_R:
  0F8F'   7B                    	MOV	A,E		; part of the way down a line: its start
  0F90'   91                    	SUB	C
  0F91'   5F                    	MOV	E,A
  0F92'                         VHD_C:
  0F92'   22 2D3B'              	SHLD	HFTP
  0F95'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  0F98'   83                    	ADD	E
  0F99'   4F                    	MOV	C,A
  0F9A'   3A 2D3E'              	LDA	HTCUR
  0F9D'   CD 1066'              	CALL	HTPT
  0FA0'   CD 1084'              	CALL	HTFQ
  0FA3'   D2 0FA7'              	JNC	HFEND
  0FA6'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  0FA7'                         HFEND:
  0FA7'   EB                    	XCHG
  0FA8'   2A 2D3B'              	LHLD	HFTP
  0FAB'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  0FAC'                         HTLAND:
  0FAC'   E5                    	PUSH	H
  0FAD'   D5                    	PUSH	D
  0FAE'   CD 1079'              	CALL	HTGO
  0FB1'   D1                    	POP	D
  0FB2'   E1                    	POP	H
  0FB3'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  0FB6'   7C                    	MOV	A,H
  0FB7'   B7                    	ORA	A
  0FB8'   7D                    	MOV	A,L
  0FB9'   CA 0FBD'              	JZ	HL_SET
  0FBC'   AF                    	XRA	A
  0FBD'                         HL_SET:
  0FBD'   CD 0D6B'              	CALL	SETRWT
  0FC0'   C3 087F'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  0FC3'                         VHD_TL:
  0FC3'   3A 0000*              	LDA	SKIPR
  0FC6'   47                    	MOV	B,A
  0FC7'   3A 0000*              	LDA	CSUB
  0FCA'   90                    	SUB	B		; A = that row
  0FCB'   F5                    	PUSH	PSW
  0FCC'   21 0001               	LXI	H,1
  0FCF'   CD 093A'              	CALL	JCORE		; (on the last line: nowhere to go)
  0FD2'   F1                    	POP	PSW
  0FD3'   4F                    	MOV	C,A
  0FD4'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FD5'   0C                    	INR	C
  0FD6'   06 00                 	MVI	B,0
  0FD8'   CD 105A'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  0FDB'   22 2D3B'              	SHLD	HFTP
  0FDE'   D1                    	POP	D
  0FDF'   4B                    	MOV	C,E
  0FE0'   CD 1084'              	CALL	HTFQ
  0FE3'   D2 0FA7'              	JNC	HFEND
  0FE6'   2B                    	DCX	H
  0FE7'   C3 0FA7'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  0FEA'                         VC_HFUP:
  0FEA'   CD 07A0'              	CALL	SETMOV
  0FED'   CD 1168'              	CALL	HFCNT		; HFN = the rows
  0FF0'   CD 1148'              	CALL	ONFST
  0FF3'   C8                    	RZ			; the cursor is on the first line
  0FF4'   0E 01                 	MVI	C,1
  0FF6'   3A 2D3A'              	LDA	HFN
  0FF9'   CD 1045'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FFC'   43                    	MOV	B,E
  0FFD'   3A 2D3A'              	LDA	HFN
  1000'   4F                    	MOV	C,A
  1001'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1002'   CD 1095'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1005'   DA 1020'              	JC	VHU_C		;   above it; or the file's first line
  1008'   79                    	MOV	A,C
  1009'   B7                    	ORA	A
  100A'   CA 1020'              	JZ	VHU_C
  100D'   3A 2D3F'              	LDA	HTTP
  1010'   3D                    	DCR	A
  1011'   B8                    	CMP	B
  1012'   CA 101D'              	JZ	VHU_F
  1015'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1016'   96                    	SUB	M
  1017'   81                    	ADD	C
  1018'   5F                    	MOV	E,A
  1019'   23                    	INX	H
  101A'   C3 1020'              	JMP	VHU_C
  101D'                         VHU_F:
  101D'   7B                    	MOV	A,E		; ... the first line back: all of it
  101E'   81                    	ADD	C
  101F'   5F                    	MOV	E,A
  1020'                         VHU_C:
  1020'   22 2D3B'              	SHLD	HFTP
  1023'   4B                    	MOV	C,E
  1024'   3A 2D3E'              	LDA	HTCUR
  1027'   CD 1066'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  102A'   3A 0000*              	LDA	CSUB
  102D'   57                    	MOV	D,A
  102E'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  102F'   92                    	SUB	D		; the rows to go, less those of its own line above it
  1030'   DA 0FA7'              	JC	HFEND
  1033'   CA 0FA7'              	JZ	HFEND
  1036'   4F                    	MOV	C,A
  1037'   43                    	MOV	B,E
  1038'   CD 1095'              	CALL	HTBQ		; (off the top: the file's first line)
  103B'   C3 0FA7'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  103E'                         HTSCR:
  103E'   CD 0D4C'              	CALL	CURRW
  1041'   47                    	MOV	B,A
  1042'   C3 1050'              	JMP	HS_TP
  1045'                         HTSET:
  1045'   47                    	MOV	B,A
  1046'   CD 0D4C'              	CALL	CURRW		; (keeps BC)
  1049'   F5                    	PUSH	PSW
  104A'   80                    	ADD	B
  104B'   47                    	MOV	B,A
  104C'   CD 105A'              	CALL	HTRB
  104F'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  1050'                         HS_TP:
  1050'   3A 2D3E'              	LDA	HTCUR
  1053'   90                    	SUB	B
  1054'   32 2D3F'              	STA	HTTP
  1057'   C3 1066'              	JMP	HTPT
  105A'                         HTRB:
  105A'   CD 1238'              	CALL	ZSAVE
  105D'   CD 0000*              	CALL	HTBLD
  1060'   CD 124B'              	CALL	ZREST
  1063'   3A 2D3E'              	LDA	HTCUR
  1066'                         HTPT:
  1066'   5F                    	MOV	E,A
  1067'   16 00                 	MVI	D,0
  1069'   21 0000*              	LXI	H,HTAB
  106C'   19                    	DAD	D
  106D'   3A 2D3D'              	LDA	HTN
  1070'   93                    	SUB	E
  1071'   47                    	MOV	B,A
  1072'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1073'                         HTIX:
  1073'   11 0000*              	LXI	D,HTAB
  1076'   7D                    	MOV	A,L
  1077'   93                    	SUB	E
  1078'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1079'                         HTGO:
  1079'   CD 1073'              	CALL	HTIX
  107C'   47                    	MOV	B,A
  107D'   3A 2D3E'              	LDA	HTCUR
  1080'   90                    	SUB	B		; A = the lines up to it
  1081'   C3 0D83'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1084'                         HTFQ:
  1084'   78                    	MOV	A,B
  1085'   B7                    	ORA	A
  1086'   37                    	STC
  1087'   C8                    	RZ
  1088'   79                    	MOV	A,C
  1089'   96                    	SUB	M
  108A'   DA 1093'              	JC	HF_IN
  108D'   4F                    	MOV	C,A
  108E'   23                    	INX	H
  108F'   05                    	DCR	B
  1090'   C3 1084'              	JMP	HTFQ
  1093'                         HF_IN:
  1093'   B7                    	ORA	A
  1094'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1095'                         HTBQ:
  1095'   78                    	MOV	A,B
  1096'   B7                    	ORA	A
  1097'   37                    	STC
  1098'   C8                    	RZ
  1099'   2B                    	DCX	H
  109A'   05                    	DCR	B
  109B'   7E                    	MOV	A,M
  109C'   91                    	SUB	C
  109D'   D2 10A6'              	JNC	HQ_IN
  10A0'   2F                    	CMA
  10A1'   3C                    	INR	A
  10A2'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10A3'   C3 1095'              	JMP	HTBQ
  10A6'                         HQ_IN:
  10A6'   4F                    	MOV	C,A
  10A7'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  10A8'                         RWQ:
  10A8'   0E 64                 	MVI	C,100
  10AA'   3A 2D43'              	LDA	RWR+1
  10AD'   B7                    	ORA	A
  10AE'   C0                    	RNZ
  10AF'   3A 2D42'              	LDA	RWR
  10B2'   B9                    	CMP	C
  10B3'   D0                    	RNC
  10B4'   4F                    	MOV	C,A
  10B5'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  10B6'                         RWSUB:
  10B6'   E5                    	PUSH	H
  10B7'   5F                    	MOV	E,A
  10B8'   16 00                 	MVI	D,0
  10BA'   2A 2D42'              	LHLD	RWR
  10BD'   CD 0000*              	CALL	SUBHD
  10C0'   22 2D42'              	SHLD	RWR
  10C3'   E1                    	POP	H
  10C4'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  10C5'                         RWFWD:
  10C5'   CD 10A8'              	CALL	RWQ
  10C8'   51                    	MOV	D,C
  10C9'   CD 1084'              	CALL	HTFQ
  10CC'   F5                    	PUSH	PSW
  10CD'   7A                    	MOV	A,D
  10CE'   91                    	SUB	C		; the rows that took it to that line's first
  10CF'   CD 10B6'              	CALL	RWSUB
  10D2'   F1                    	POP	PSW
  10D3'   DA 10E7'              	JC	RF_OFF
  10D6'   3A 2D43'              	LDA	RWR+1		; is what is left inside this line?
  10D9'   B7                    	ORA	A
  10DA'   C2 10F1'              	JNZ	RF_GO
  10DD'   3A 2D42'              	LDA	RWR
  10E0'   BE                    	CMP	M
  10E1'   D2 10F1'              	JNC	RF_GO
  10E4'   4F                    	MOV	C,A
  10E5'   B7                    	ORA	A
  10E6'   C9                    	RET
  10E7'                         RF_OFF:
  10E7'   3A 2D40'              	LDA	HTEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  10EA'   B7                    	ORA	A
  10EB'   CA 10F1'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  10EE'   2B                    	DCX	H
  10EF'   37                    	STC
  10F0'   C9                    	RET
  10F1'                         RF_GO:
  10F1'   CD 1079'              	CALL	HTGO
  10F4'   3E 01                 	MVI	A,1
  10F6'   32 2D44'              	STA	RWMV
  10F9'   CD 10A8'              	CALL	RWQ
  10FC'   0C                    	INR	C
  10FD'   06 00                 	MVI	B,0
  10FF'   CD 105A'              	CALL	HTRB
  1102'   C3 10C5'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1105'                         RWBAK:
  1105'   CD 10A8'              	CALL	RWQ
  1108'   51                    	MOV	D,C
  1109'   CD 1095'              	CALL	HTBQ
  110C'   DA 1129'              	JC	RB_OFF
  110F'   7A                    	MOV	A,D
  1110'   81                    	ADD	C
  1111'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1112'   3A 2D43'              	LDA	RWR+1
  1115'   B7                    	ORA	A
  1116'   C2 1125'              	JNZ	RB_ON
  1119'   3A 2D42'              	LDA	RWR
  111C'   57                    	MOV	D,A
  111D'   7B                    	MOV	A,E
  111E'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  111F'   DA 1125'              	JC	RB_ON
  1122'   4F                    	MOV	C,A
  1123'   B7                    	ORA	A
  1124'   C9                    	RET
  1125'                         RB_ON:
  1125'   7B                    	MOV	A,E
  1126'   C3 1130'              	JMP	RB_GO
  1129'                         RB_OFF:
  1129'   3A 2D41'              	LDA	HTBOF
  112C'   0F                    	RRC			; CY: that is the file's first line
  112D'   D8                    	RC
  112E'   7A                    	MOV	A,D
  112F'   91                    	SUB	C
  1130'                         RB_GO:
  1130'   CD 10B6'              	CALL	RWSUB
  1133'   CD 1079'              	CALL	HTGO
  1136'   3E 01                 	MVI	A,1
  1138'   32 2D44'              	STA	RWMV
  113B'   CD 10A8'              	CALL	RWQ
  113E'   41                    	MOV	B,C
  113F'   0E 01                 	MVI	C,1
  1141'   CD 105A'              	CALL	HTRB
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1144'   43                    	MOV	B,E
  1145'   C3 1105'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  1148'                         ONFST:
  1148'   E5                    	PUSH	H
  1149'   2A 0000*              	LHLD	OUTPOS
  114C'   7C                    	MOV	A,H
  114D'   B5                    	ORA	L
  114E'   C2 1166'              	JNZ	OF_RET
  1151'   2A 0000*              	LHLD	TXTBEG
  1154'   EB                    	XCHG			; DE = TXTBEG
  1155'   2A 0000*              	LHLD	GAPBEG
  1158'                         OF_LP:
  1158'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  115B'   CA 1166'              	JZ	OF_RET
  115E'   2B                    	DCX	H
  115F'   7E                    	MOV	A,M
  1160'   FE 0A                 	CPI	LF
  1162'   C2 1158'              	JNZ	OF_LP
  1165'   B7                    	ORA	A		; NZ
  1166'                         OF_RET:
  1166'   E1                    	POP	H
  1167'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1168'                         HFCNT:
  1168'   2A 2D2C'              	LHLD	CMDCNT
  116B'   7C                    	MOV	A,H
  116C'   B5                    	ORA	L
  116D'   CA 1184'              	JZ	HFC_AM
  1170'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  1173'   3A 0000*              	LDA	NEDIT
  1176'   5F                    	MOV	E,A
  1177'   16 00                 	MVI	D,0
  1179'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  117C'   D2 1180'              	JNC	HFC_ST
  117F'   EB                    	XCHG			; HL = NEDIT
  1180'                         HFC_ST:
  1180'   7D                    	MOV	A,L
  1181'   32 2D39'              	STA	HFAMT
  1184'                         HFC_AM:
  1184'   3A 2D39'              	LDA	HFAMT
  1187'   B7                    	ORA	A
  1188'   C2 1195'              	JNZ	HFC_HL
  118B'   3A 0000*              	LDA	NEDIT
  118E'   B7                    	ORA	A
  118F'   1F                    	RAR
  1190'   B7                    	ORA	A
  1191'   C2 1195'              	JNZ	HFC_HL
  1194'   3C                    	INR	A		; at least one row
  1195'                         HFC_HL:
  1195'   32 2D3A'              	STA	HFN
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1198'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1199'                         VC_REDR:
  1199'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  119C'                         VC_G:
  119C'   CD 07A0'              	CALL	SETMOV
  119F'   CD 125E'              	CALL	GZONE		; the screen's top line, before the move
  11A2'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  11A5'   2A 2D2C'              	LHLD	CMDCNT
  11A8'   7C                    	MOV	A,H
  11A9'   B5                    	ORA	L
  11AA'   C2 11BD'              	JNZ	VG_N
  11AD'   AF                    	XRA	A		; forward
  11AE'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  11B1'   CD 0731'              	CALL	BRKOFF
  11B4'   DA 0749'              	JC	BRKBAK
  11B7'   CD 0A6E'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  11BA'   C3 1276'              	JMP	GPLACE
  11BD'                         VG_N:
  11BD'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  11C0'                         VG_LN:
  11C0'   CD 11CC'              	CALL	GOLN
  11C3'   CD 0731'              	CALL	BRKOFF
  11C6'   DA 0749'              	JC	BRKBAK
  11C9'   C3 1276'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  11CC'                         GOLN:
  11CC'   E5                    	PUSH	H
  11CD'   CD 0000*              	CALL	CNTLF
  11D0'   23                    	INX	H		; HL = the cursor's line
  11D1'   D1                    	POP	D		; DE = the line wanted
  11D2'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11D5'   DA 11E0'              	JC	GLN_BK
  11D8'   EB                    	XCHG
  11D9'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  11DC'   AF                    	XRA	A
  11DD'   C3 11E5'              	JMP	GLN_MV
  11E0'                         GLN_BK:
  11E0'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  11E3'   3E FF                 	MVI	A,0FFH
  11E5'                         GLN_MV:
  11E5'   CD 0000*              	CALL	MVLIND
  11E8'   CD 0A68'              	CALL	ATEOF
  11EB'   DC 0A6E'              	CC	LASTLN		; past the last line: onto it
  11EE'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  11EF'                         VC_LG:
  11EF'   CD 07A0'              	CALL	SETMOV
  11F2'   3A 2D60'              	LDA	GSAVE
  11F5'   B7                    	ORA	A
  11F6'   C2 11FF'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  11F9'   3E 01                 	MVI	A,PG
  11FB'   32 2D5F'              	STA	GPEND
  11FE'   C9                    	RET
  11FF'                         VLG_GG:
  11FF'   CD 125E'              	CALL	GZONE
  1202'   CD 06F4'              	CALL	BRKON
  1205'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  1208'   C3 11C0'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  120B'                         SUB24:
  120B'   4F                    	MOV	C,A
  120C'   7D                    	MOV	A,L
  120D'   93                    	SUB	E
  120E'   6F                    	MOV	L,A
  120F'   7C                    	MOV	A,H
  1210'   9A                    	SBB	D
  1211'   67                    	MOV	H,A
  1212'   79                    	MOV	A,C
  1213'   98                    	SBB	B
  1214'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1215'                         CURFP:
  1215'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1218'                         FPOS:
  1218'   C5                    	PUSH	B
  1219'   D5                    	PUSH	D
  121A'   EB                    	XCHG
  121B'   2A 0000*              	LHLD	TXTBEG
  121E'   EB                    	XCHG
  121F'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1222'   EB                    	XCHG			; DE = that
  1223'   2A 0000*              	LHLD	OUTPOS
  1226'   7C                    	MOV	A,H
  1227'   B7                    	ORA	A		; CY = 0
  1228'   1F                    	RAR
  1229'   47                    	MOV	B,A
  122A'   7D                    	MOV	A,L
  122B'   1F                    	RAR
  122C'   67                    	MOV	H,A
  122D'   3E 00                 	MVI	A,0
  122F'   1F                    	RAR
  1230'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  1231'   19                    	DAD	D
  1232'   78                    	MOV	A,B
  1233'   CE 00                 	ACI	0		; A:HL = the position
  1235'   D1                    	POP	D
  1236'   C1                    	POP	B
  1237'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1238'                         ZSAVE:
  1238'   2A 2D2C'              	LHLD	CMDCNT
  123B'   22 2D9E'              	SHLD	ZSVCNT
  123E'   2A 0000*              	LHLD	AUXCNT
  1241'   22 2DA0'              	SHLD	ZSVAUX
  1244'   3A 0000*              	LDA	DIRFLG
  1247'   32 2DA2'              	STA	ZSVDIR
  124A'   C9                    	RET
  124B'                         ZREST:
  124B'   2A 2D9E'              	LHLD	ZSVCNT
  124E'   22 2D2C'              	SHLD	CMDCNT
  1251'   2A 2DA0'              	LHLD	ZSVAUX
  1254'   22 0000*              	SHLD	AUXCNT
  1257'   3A 2DA2'              	LDA	ZSVDIR
  125A'   32 0000*              	STA	DIRFLG
  125D'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  125E'                         GZONE:
  125E'   CD 1238'              	CALL	ZSAVE
  1261'   CD 0D4C'              	CALL	CURRW
  1264'   6F                    	MOV	L,A
  1265'   26 00                 	MVI	H,0
  1267'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  126A'   CD 1218'              	CALL	FPOS
  126D'   22 0000*              	SHLD	ZTOP
  1270'   32 0002*              	STA	ZTOP+2
  1273'   C3 124B'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1276'                         GPLACE:
  1276'   CD 1238'              	CALL	ZSAVE
  1279'   CD 1215'              	CALL	CURFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  127C'   EB                    	XCHG
  127D'   2A 0000*              	LHLD	ZTOP
  1280'   EB                    	XCHG
  1281'   4F                    	MOV	C,A		; C:HL = the target's position
  1282'   3A 0002*              	LDA	ZTOP+2
  1285'   47                    	MOV	B,A		; B:DE = the top's
  1286'   79                    	MOV	A,C
  1287'   CD 120B'              	CALL	SUB24
  128A'   22 2D9B'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  128D'   DA 12C7'              	JC	GP_UP
  1290'   B7                    	ORA	A
  1291'   C2 130D'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1294'   3A 0000*              	LDA	NEDIT
  1297'   87                    	ADD	A
  1298'   3C                    	INR	A
  1299'   6F                    	MOV	L,A
  129A'   26 00                 	MVI	H,0
  129C'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  129F'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  12A2'   EB                    	XCHG
  12A3'   2A 2D9B'              	LHLD	ZDIF		; HL = bytes from the top to the target
  12A6'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  12A9'   DA 130D'              	JC	GP_MID
  12AC'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  12AF'   01 0000               	LXI	B,0		; BC = lines from the top
  12B2'                         GP_CNT:
  12B2'   7A                    	MOV	A,D
  12B3'   B3                    	ORA	E
  12B4'   CA 12C3'              	JZ	GP_DN
  12B7'   7E                    	MOV	A,M
  12B8'   23                    	INX	H
  12B9'   1B                    	DCX	D
  12BA'   FE 0A                 	CPI	LF
  12BC'   C2 12B2'              	JNZ	GP_CNT
  12BF'   03                    	INX	B
  12C0'   C3 12B2'              	JMP	GP_CNT
  12C3'                         GP_DN:
  12C3'   79                    	MOV	A,C		; the lines from the top one to it
  12C4'   C3 1337'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  12C7'                         GP_UP:
  12C7'   3C                    	INR	A
  12C8'   C2 130D'              	JNZ	GP_MID		; 64K bytes or more above
  12CB'   2A 2D9B'              	LHLD	ZDIF
  12CE'   EB                    	XCHG
  12CF'   21 0000               	LXI	H,0
  12D2'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  12D5'   7C                    	MOV	A,H
  12D6'   B5                    	ORA	L
  12D7'   CA 130D'              	JZ	GP_MID		; exactly 64K
  12DA'   EB                    	XCHG			; DE = bytes to read
  12DB'   AF                    	XRA	A
  12DC'   32 2D9D'              	STA	ZLF
  12DF'   CD 0000*              	CALL	RGET0
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12E2'                         GP_RD:
  12E2'   CD 0000*              	CALL	RDGET		; (keeps DE)
  12E5'   DA 130D'              	JC	GP_MID
  12E8'   FE 0A                 	CPI	LF
  12EA'   C2 12FE'              	JNZ	GP_RN
  12ED'   3A 0000*              	LDA	NEDIT
  12F0'   B7                    	ORA	A
  12F1'   1F                    	RAR
  12F2'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  12F4'   E5                    	PUSH	H
  12F5'   21 2D9D'              	LXI	H,ZLF
  12F8'   34                    	INR	M
  12F9'   BE                    	CMP	M		; CY iff more lines than that
  12FA'   E1                    	POP	H
  12FB'   DA 130D'              	JC	GP_MID
  12FE'                         GP_RN:
  12FE'   1B                    	DCX	D
  12FF'   7A                    	MOV	A,D
  1300'   B3                    	ORA	E
  1301'   C2 12E2'              	JNZ	GP_RD
  1304'   3E 01                 	MVI	A,PL_SET	; the top row
  1306'   32 0000*              	STA	PLACE
  1309'   AF                    	XRA	A
  130A'   C3 1317'              	JMP	GP_SET
  130D'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  130D'   3E 02                 	MVI	A,PL_MID
  130F'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1312'   3A 0000*              	LDA	NEDIT
  1315'   B7                    	ORA	A
  1316'   1F                    	RAR			; (no more lines above it than this)
  1317'                         GP_SET:
  1317'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1318'   26 00                 	MVI	H,0
  131A'   22 0000*              	SHLD	WINROW
  131D'   21 0000               	LXI	H,0
  1320'   22 0000*              	SHLD	LNDLT
  1323'   CD 07C1'              	CALL	SETFUL		; the window may have paged: full repaint
  1326'                         GP_FIN:
  1326'   CD 124B'              	CALL	ZREST
  1329'   3A 2DC6'              	LDA	GPKEEP
  132C'   B7                    	ORA	A
  132D'   CA 087F'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1330'   AF                    	XRA	A
  1331'   32 2DC6'              	STA	GPKEEP
  1334'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; adds LNDLT to it and arrives at the same line.
  1337'                         GP_ONS:
  1337'   6F                    	MOV	L,A
  1338'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  133A'   EB                    	XCHG
  133B'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  133E'   EB                    	XCHG
  133F'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1342'   22 0000*              	SHLD	LNDLT
  1345'   3E 01                 	MVI	A,R_MOVE
  1347'   32 2D30'              	STA	RINTENT
  134A'   C3 1326'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  134D'                         OPPEND:
  134D'   AF                    	XRA	A
  134E'   32 2D65'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1351'   3A 2D62'              	LDA	PSAVE
  1354'   FE 63                 	CPI	'c'
  1356'   C2 1373'              	JNZ	OPP_ND
  1359'   79                    	MOV	A,C
  135A'   FE 77                 	CPI	'w'
  135C'   CA 1364'              	JZ	OPP_W
  135F'   FE 57                 	CPI	'W'
  1361'   C2 1373'              	JNZ	OPP_ND
  1364'                         OPP_W:
  1364'   CD 1546'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1367'   DA 1373'              	JC	OPP_ND
  136A'   79                    	MOV	A,C
  136B'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  136D'   4F                    	MOV	C,A
  136E'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1370'   32 2D65'              	STA	CWEOL		;   char for the next word's: see ESTEP
  1373'                         OPP_ND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1373'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1374'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1376'   C2 138A'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1379'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  137C'   DA 141A'              	JC	OPABRT
  137F'   79                    	MOV	A,C
  1380'   FE 67                 	CPI	'g'
  1382'   C2 141A'              	JNZ	OPABRT
  1385'   3E 01                 	MVI	A,PG
  1387'   32 2D60'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  138A'                         OPP_NG:
  138A'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  138B'   21 2D62'              	LXI	H,PSAVE
  138E'   BE                    	CMP	M
  138F'   CA 1567'              	JZ	OPLINE
  1392'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1393'   CD 157D'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1396'   DA 141A'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1399'   32 2D64'              	STA	OPCLSV
  139C'   47                    	MOV	B,A		; B = the class
  139D'   3A 2D62'              	LDA	PSAVE
  13A0'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  13A2'   C2 13AE'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  13A5'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  13A6'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  13A8'   C2 13D0'              	JNZ	OPP_GO
  13AB'   C3 13B9'              	JMP	OPP_NO
  13AE'                         OPP_NC:
  13AE'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  13B0'   C2 13D0'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  13B3'   78                    	MOV	A,B		;   a charwise register would need a type flag
  13B4'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  13B6'   CA 13D0'              	JZ	OPP_GO		;   within a line -- neither of which is built
  13B9'                         OPP_NO:
  13B9'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  13BA'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  13BC'   CA 13CA'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  13BF'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  13C1'   CA 13CA'              	JZ	OPP_SW		;   so swallow it before dropping the command
  13C4'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  13C7'   C2 141A'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  13CA'                         OPP_SW:
  13CA'   CD 01F9'              	CALL	MKGETK
  13CD'   C3 141A'              	JMP	OPABRT
  13D0'                         OPP_GO:
  13D0'   AF                    	XRA	A
  13D1'   32 2D38'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  13D4'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  13D7'   22 2D66'              	SHLD	OPSTA
  13DA'   C5                    	PUSH	B
  13DB'   21 2D6A'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  13DE'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  13E1'   3A 2D64'              	LDA	OPCLSV
  13E4'   FE 02                 	CPI	2
  13E6'   CC 141D'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  13E9'   C1                    	POP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13EA'   21 2C73'              	LXI	H,CMDTAB
  13ED'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  13F0'   3A 2D62'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  13F3'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  13F4'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  13F7'   CD 1449'              	CALL	OPSFIX		; where the start is in the window NOW
  13FA'   D2 1465'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  13FD'   22 2D66'              	SHLD	OPSTA
  1400'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1403'   22 2D68'              	SHLD	OPEND2
  1406'   3A 2D62'              	LDA	PSAVE
  1409'   FE 79                 	CPI	'y'
  140B'   CA 1AE5'              	JZ	OPYANK		; a yank takes the span without losing it
  140E'   CD 15B8'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1411'   3A 2D62'              	LDA	PSAVE
  1414'   FE 63                 	CPI	'c'
  1416'   C0                    	RNZ
  1417'   C3 189E'              	JMP	SETINS
  141A'                         OPABRT:				; not a motion -> the operator is dropped and
  141A'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  141D'                         OPENDS:
  141D'   2A 2D66'              	LHLD	OPSTA
  1420'   CD 0624'              	CALL	BOL
  1423'   11 2D6D'              	LXI	D,OPSLO
  1426'   CD 143B'              	CALL	OPE_ST
  1429'   2A 2D66'              	LHLD	OPSTA
  142C'   CD 0654'              	CALL	NLSTART
  142F'   11 2D70'              	LXI	D,OPSHI
  1432'   CD 143B'              	CALL	OPE_ST
  1435'   2A 2D66'              	LHLD	OPSTA
  1438'   C3 0000*              	JMP	GOTO
  143B'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  143B'   D5                    	PUSH	D
  143C'   CD 0000*              	CALL	GOTO
  143F'   E1                    	POP	H
  1440'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1443'                         CURBD:
  1443'   CD 1215'              	CALL	CURFP
  1446'   EB                    	XCHG
  1447'   47                    	MOV	B,A
  1448'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1449'                         OPSFIX:
  1449'   21 2D6A'              	LXI	H,OPSFP
  144C'   CD 03DC'              	CALL	MKLOAD
  144F'   CD 1443'              	CALL	CURBD
  1452'   2A 2DD0'              	LHLD	MKPOS
  1455'   3A 2DD2'              	LDA	MKPOS+2
  1458'   CD 120B'              	CALL	SUB24
  145B'   B4                    	ORA	H
  145C'   B5                    	ORA	L
  145D'   C2 03E9'              	JNZ	MKWIN
  1460'   CD 0000*              	CALL	CUROFF
  1463'   37                    	STC
  1464'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1465'                         OPPGD:
  1465'   47                    	MOV	B,A
  1466'   3A 2D64'              	LDA	OPCLSV
  1469'   FE 02                 	CPI	2
  146B'   C2 1527'              	JNZ	OPG_NO
  146E'   3A 2D62'              	LDA	PSAVE
  1471'   FE 64                 	CPI	'd'
  1473'   C2 1527'              	JNZ	OPG_NO
  1476'   04                    	INR	B
  1477'   CA 1486'              	JZ	OPG_FW
  147A'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  147D'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1480'   CD 0000*              	CALL	GOTO
  1483'   C3 149E'              	JMP	OPG_GO
  1486'                         OPG_FW:
  1486'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1489'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  148C'   11 2D70'              	LXI	D,OPSHI		;   start line began
  148F'   CD 143B'              	CALL	OPE_ST
  1492'   21 2D6D'              	LXI	H,OPSLO
  1495'   CD 03DC'              	CALL	MKLOAD
  1498'   CD 03A9'              	CALL	MKPAGE
  149B'   CD 0000*              	CALL	GOTO
  149E'                         OPG_GO:
  149E'   CD 1443'              	CALL	CURBD
  14A1'   2A 2D70'              	LHLD	OPSHI
  14A4'   3A 2D72'              	LDA	OPSHI+2
  14A7'   CD 120B'              	CALL	SUB24		; A:HL = the bytes to take
  14AA'                         OPG_SV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  14AA'   22 2D73'              	SHLD	OPTOGO
  14AD'   32 2D75'              	STA	OPTOGO+2
  14B0'                         OPG_NX:
  14B0'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  14B3'   CD 0000*              	CALL	SUBHD
  14B6'   EB                    	XCHG			; DE = what the window holds past the cursor
  14B7'   2A 2D73'              	LHLD	OPTOGO
  14BA'   3A 2D75'              	LDA	OPTOGO+2
  14BD'   B7                    	ORA	A
  14BE'   C2 14F1'              	JNZ	OPG_PG		; 64K or more to go
  14C1'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  14C4'   DA 14F1'              	JC	OPG_PG
  14C7'   CA 14F1'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  14CA'                         OPG_FN:				; the rest of it is here
  14CA'   E5                    	PUSH	H
  14CB'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  14CE'   CD 0000*              	CALL	CUROFF
  14D1'   22 2D76'              	SHLD	OPLO
  14D4'   D1                    	POP	D
  14D5'   19                    	DAD	D
  14D6'   22 2D78'              	SHLD	OPHI
  14D9'   CD 16EB'              	CALL	OPDSPN
  14DC'   CD 0A68'              	CALL	ATEOF
  14DF'   D2 1540'              	JNC	OPMID
  14E2'   CD 1148'              	CALL	ONFST		; deleted to the end of the file: onto the new
  14E5'   CA 1540'              	JZ	OPMID		;   last line, if there is one -- and the pager
  14E8'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  14EB'   CD 0000*              	CALL	SETBWD
  14EE'   C3 1540'              	JMP	OPMID
  14F1'                         OPG_PG:
  14F1'   7A                    	MOV	A,D
  14F2'   B3                    	ORA	E
  14F3'   C2 150C'              	JNZ	OPG_DL
  14F6'   CD 0A68'              	CALL	ATEOF		; nothing held past the cursor
  14F9'   21 0000               	LXI	H,0
  14FC'   DA 14CA'              	JC	OPG_FN		; ... and no more to come: the file ran out
  14FF'   2B                    	DCX	H
  1500'   CD 0000*              	CALL	SETC0
  1503'   CD 0000*              	CALL	GOLINE
  1506'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1509'   C3 14B0'              	JMP	OPG_NX
  150C'                         OPG_DL:
  150C'   D5                    	PUSH	D
  150D'   21 FFFF               	LXI	H,0FFFFH
  1510'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1513'   E1                    	POP	H
  1514'   E5                    	PUSH	H
  1515'   CD 0000*              	CALL	DELFWD
  1518'   D1                    	POP	D
  1519'   06 00                 	MVI	B,0
  151B'   2A 2D73'              	LHLD	OPTOGO
  151E'   3A 2D75'              	LDA	OPTOGO+2
  1521'   CD 120B'              	CALL	SUB24
  1524'   C3 14AA'              	JMP	OPG_SV
  1527'                         OPG_NO:
  1527'   0E 07                 	MVI	C,BEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1529'   CD 0000*              	CALL	BCONOU
  152C'                         OPG_HM:				; the cursor back where the command found it
  152C'   21 2D6A'              	LXI	H,OPSFP
  152F'   CD 03DC'              	CALL	MKLOAD
  1532'   CD 03A9'              	CALL	MKPAGE
  1535'   CD 0000*              	CALL	GOTO
  1538'   AF                    	XRA	A
  1539'   32 2D62'              	STA	PSAVE
  153C'   3C                    	INR	A
  153D'   32 2DC6'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1540'                         OPMID:
  1540'   CD 1238'              	CALL	ZSAVE
  1543'   C3 130D'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1546'                         ONWHIT:
  1546'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1549'   CA 1565'              	JZ	OW_YES
  154C'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  154F'   FE 20                 	CPI	' '
  1551'   CA 1565'              	JZ	OW_YES
  1554'   FE 09                 	CPI	TAB
  1556'   CA 1565'              	JZ	OW_YES
  1559'   FE 0D                 	CPI	CR
  155B'   CA 1565'              	JZ	OW_YES
  155E'   FE 0A                 	CPI	LF
  1560'   CA 1565'              	JZ	OW_YES
  1563'   B7                    	ORA	A		; a char to change: CY clear
  1564'   C9                    	RET
  1565'                         OW_YES:
  1565'   37                    	STC
  1566'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1567'                         OPLINE:
  1567'   3A 2D62'              	LDA	PSAVE
  156A'   FE 63                 	CPI	'c'
  156C'   CA 07A0'              	JZ	SETMOV
  156F'   FE 79                 	CPI	'y'
  1571'   CA 1AC4'              	JZ	VY_YY
  1574'   21 2D6A'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1577'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  157A'   C3 1A3A'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  157D'                         OPCLS:
  157D'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  157F'   CA 158C'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1582'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1584'   C2 15A0'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1587'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1589'   C3 158E'              	JMP	OPC_FK
  158C'                         OPC_SEM:
  158C'   06 00                 	MVI	B,0		; ';' runs it as it stands
  158E'                         OPC_FK:
  158E'   3A 2DBC'              	LDA	FNDKND
  1591'   B7                    	ORA	A
  1592'   37                    	STC
  1593'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1594'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1595'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1597'   CA 159E'              	JZ	OPC_EXC
  159A'   3E 01                 	MVI	A,1
  159C'   B7                    	ORA	A		; CY clear: a motion, class 1
  159D'   C9                    	RET
  159E'                         OPC_EXC:
  159E'   AF                    	XRA	A		; class 0, CY clear
  159F'   C9                    	RET
  15A0'                         OPC_TB:
  15A0'   47                    	MOV	B,A
  15A1'   21 1780'              	LXI	H,OPCTAB
  15A4'                         OPC_LP:
  15A4'   7E                    	MOV	A,M
  15A5'   B7                    	ORA	A
  15A6'   CA 15B6'              	JZ	OPC_MS		; end of table -> not a motion
  15A9'   B8                    	CMP	B
  15AA'   CA 15B2'              	JZ	OPC_HT
  15AD'   23                    	INX	H
  15AE'   23                    	INX	H
  15AF'   C3 15A4'              	JMP	OPC_LP
  15B2'                         OPC_HT:
  15B2'   23                    	INX	H
  15B3'   7E                    	MOV	A,M		; class byte
  15B4'   B7                    	ORA	A		; clear CY
  15B5'   C9                    	RET
  15B6'                         OPC_MS:
  15B6'   37                    	STC
  15B7'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  15B8'                         OPAPPL:
  15B8'   3A 2D64'              	LDA	OPCLSV
  15BB'   FE 02                 	CPI	2
  15BD'   CA 1754'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  15C0'   2A 2D66'              	LHLD	OPSTA
  15C3'   EB                    	XCHG			; DE = start
  15C4'   2A 2D68'              	LHLD	OPEND2		; HL = end
  15C7'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  15CA'   DA 15DD'              	JC	OPA_F
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  15CD'   CA 15DD'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  15D0'   22 2D76'              	SHLD	OPLO
  15D3'   EB                    	XCHG
  15D4'   22 2D78'              	SHLD	OPHI
  15D7'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  15DA'   C3 1694'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  15DD'                         OPA_F:
  15DD'   EB                    	XCHG			; HL = start, DE = end
  15DE'   22 2D76'              	SHLD	OPLO
  15E1'   EB                    	XCHG			; HL = end
  15E2'   3A 2D64'              	LDA	OPCLSV
  15E5'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  15E7'   CA 1691'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  15EA'   FE 01                 	CPI	1
  15EC'   C2 160E'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  15EF'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  15F0'   22 2D78'              	SHLD	OPHI		; park it: CEND clobbers DE
  15F3'   2B                    	DCX	H		; the line it landed on
  15F4'   CD 181C'              	CALL	CEND		; HL = that line's content end
  15F7'   EB                    	XCHG			; DE = it
  15F8'   2A 2D78'              	LHLD	OPHI		; HL = hi
  15FB'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  15FE'   D2 1619'              	JNC	OPA_HI		; hi is inside the line: keep it
  1601'   2A 2D76'              	LHLD	OPLO
  1604'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1607'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  160A'   EB                    	XCHG			; HL = the content end: the span stops there
  160B'   C3 1619'              	JMP	OPA_HI
  160E'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  160E'   22 2D78'              	SHLD	OPHI
  1611'   3A 2D38'              	LDA	WPULL
  1614'   B7                    	ORA	A
  1615'   CA 1694'              	JZ	OPA_C1
  1618'   23                    	INX	H
  1619'                         OPA_HI:
  1619'   22 2D78'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  161C'                         OPA_DO:
  161C'   CD 16E0'              	CALL	OPSPNL
  161F'   7C                    	MOV	A,H
  1620'   B5                    	ORA	L
  1621'   C2 162A'              	JNZ	OPA_D1
  1624'   2A 2D76'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1627'   C3 0000*              	JMP	GOTO		;   to where the span starts
  162A'                         OPA_D1:
  162A'   3A 2D62'              	LDA	PSAVE
  162D'   FE 63                 	CPI	'c'
  162F'   CA 16EB'              	JZ	OPDSPN
  1632'   CD 16D3'              	CALL	SPNBRK
  1635'   D2 1656'              	JNC	OPA_D2
  1638'   2A 2D78'              	LHLD	OPHI
  163B'   CD 181C'              	CALL	CEND
  163E'   EB                    	XCHG			; DE = the content end of the line it ends in
  163F'   2A 2D78'              	LHLD	OPHI
  1642'                         OPA_BL:
  1642'   CD 0000*              	CALL	CMP16
  1645'   CA 165C'              	JZ	OPA_BI		; only blanks after it
  1648'   D5                    	PUSH	D
  1649'   E5                    	PUSH	H
  164A'   CD 0000*              	CALL	CHARAT
  164D'   E1                    	POP	H
  164E'   D1                    	POP	D
  164F'   23                    	INX	H
  1650'   CD 168B'              	CALL	BLANKQ
  1653'   CA 1642'              	JZ	OPA_BL
  1656'                         OPA_D2:
  1656'   CD 16EB'              	CALL	OPDSPN
  1659'   C3 182D'              	JMP	CLAMPE
  165C'                         OPA_BI:
  165C'   CD 166E'              	CALL	LOIND
  165F'   C2 1656'              	JNZ	OPA_D2
  1662'   2A 2D78'              	LHLD	OPHI
  1665'   CD 0654'              	CALL	NLSTART
  1668'   22 2D78'              	SHLD	OPHI
  166B'   C3 16BF'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  166E'                         LOIND:
  166E'   2A 2D76'              	LHLD	OPLO
  1671'   CD 0624'              	CALL	BOL
  1674'                         LI_LP:
  1674'   E5                    	PUSH	H
  1675'   EB                    	XCHG
  1676'   2A 2D76'              	LHLD	OPLO
  1679'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  167C'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  167D'   C8                    	RZ
  167E'   E5                    	PUSH	H
  167F'   CD 0000*              	CALL	CHARAT
  1682'   E1                    	POP	H
  1683'   23                    	INX	H
  1684'   CD 168B'              	CALL	BLANKQ
  1687'   CA 1674'              	JZ	LI_LP
  168A'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  168B'                         BLANKQ:
  168B'   FE 20                 	CPI	' '
  168D'   C8                    	RZ
  168E'   FE 09                 	CPI	TAB
  1690'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1691'                         OPA_JP:
  1691'   22 2D78'              	SHLD	OPHI
  1694'                         OPA_C1:
  1694'   CD 16E0'              	CALL	OPSPNL
  1697'   7C                    	MOV	A,H
  1698'   B5                    	ORA	L
  1699'   CA 161C'              	JZ	OPA_DO		; nothing spanned
  169C'   2A 2D78'              	LHLD	OPHI
  169F'   CD 0624'              	CALL	BOL
  16A2'   EB                    	XCHG
  16A3'   2A 2D78'              	LHLD	OPHI
  16A6'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  16A9'   C2 161C'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  16AC'   CD 166E'              	CALL	LOIND
  16AF'   CA 16BF'              	JZ	C1_LW		; only blanks before lo: whole lines
  16B2'                         C1_CH:
  16B2'   2A 2D78'              	LHLD	OPHI		; back over the line break to the content end
  16B5'   2B                    	DCX	H		;   of the line before
  16B6'   CD 181C'              	CALL	CEND
  16B9'   22 2D78'              	SHLD	OPHI
  16BC'   C3 161C'              	JMP	OPA_DO
  16BF'                         C1_LW:
  16BF'   2A 2D76'              	LHLD	OPLO
  16C2'   CD 0624'              	CALL	BOL
  16C5'   22 2D76'              	SHLD	OPLO
  16C8'   3A 2D62'              	LDA	PSAVE
  16CB'   FE 63                 	CPI	'c'
  16CD'   CA 16B2'              	JZ	C1_CH
  16D0'   C3 1767'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ; offset) stops short of it, and takes none.
  16D3'                         SPNBRK:
  16D3'   2A 2D76'              	LHLD	OPLO
  16D6'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  16D9'   EB                    	XCHG			; DE = it
  16DA'   2A 2D78'              	LHLD	OPHI
  16DD'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  16E0'                         OPSPNL:
  16E0'   2A 2D78'              	LHLD	OPHI
  16E3'   EB                    	XCHG
  16E4'   2A 2D76'              	LHLD	OPLO
  16E7'   EB                    	XCHG			; HL = hi, DE = lo
  16E8'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  16EB'                         OPDSPN:
  16EB'   CD 16D3'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  16EE'   F5                    	PUSH	PSW
  16EF'   2A 2D76'              	LHLD	OPLO
  16F2'   CD 0000*              	CALL	GOTO
  16F5'   CD 16E0'              	CALL	OPSPNL		; HL = hi - lo
  16F8'   CD 0000*              	CALL	DELFWD
  16FB'   CD 0174'              	CALL	MARKMOD
  16FE'   F1                    	POP	PSW
  16FF'   DA 07C1'              	JC	SETFUL		; a break went: every row below it moved up
  1702'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1705'                         UNDFNB:
  1705'   CD 0000*              	CALL	CUROFF
  1708'   E5                    	PUSH	H
  1709'   CD 087F'              	CALL	FNBLNK
  170C'   CD 0000*              	CALL	CUROFF
  170F'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  1710'   CD 0000*              	CALL	CMP16
  1713'   D2 0000*              	JNC	UNDHER
  1716'   EB                    	XCHG
  1717'   CD 0000*              	CALL	GOTO
  171A'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  171D'                         OPALSP:
  171D'   2A 2D66'              	LHLD	OPSTA
  1720'   EB                    	XCHG
  1721'   2A 2D68'              	LHLD	OPEND2
  1724'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1727'   DA 1737'              	JC	OPAL_F
  172A'   22 2D76'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  172D'   EB                    	XCHG
  172E'   22 2D78'              	SHLD	OPHI		; hi-src = start
  1731'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1734'   C3 1741'              	JMP	OPAL_R
  1737'                         OPAL_F:
  1737'   EB                    	XCHG			; HL = start
  1738'   22 2D76'              	SHLD	OPLO		; lo-src = start
  173B'   2A 2D68'              	LHLD	OPEND2
  173E'   22 2D78'              	SHLD	OPHI		; hi-src = end
  1741'                         OPAL_R:
  1741'   2A 2D76'              	LHLD	OPLO
  1744'   CD 0624'              	CALL	BOL
  1747'   22 2D76'              	SHLD	OPLO		; lo = BOL(low line)
  174A'   2A 2D78'              	LHLD	OPHI
  174D'   CD 0654'              	CALL	NLSTART
  1750'   22 2D78'              	SHLD	OPHI		; hi = start of line past the high line
  1753'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1754'                         OPALIN:
  1754'   CD 171D'              	CALL	OPALSP
  1757'   2A 2D76'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  175A'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  175D'   EB                    	XCHG			;   the column)
  175E'   2A 2D78'              	LHLD	OPHI
  1761'   CD 0000*              	CALL	CMP16
  1764'   CC 1705'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1767'                         OPDLIN:
  1767'   CD 16EB'              	CALL	OPDSPN
  176A'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  176D'   DA 177D'              	JC	OPDL_NB
  1770'   CD 0000*              	CALL	LOGLEN
  1773'   7C                    	MOV	A,H
  1774'   B5                    	ORA	L
  1775'   C8                    	RZ			; empty buffer
  1776'   2B                    	DCX	H
  1777'   CD 0624'              	CALL	BOL
  177A'   CD 0000*              	CALL	GOTO
  177D'                         OPDL_NB:
  177D'   C3 087F'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1780'                         OPCTAB:
  1780'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1784'   62 00 42 00           
  1788'   68 00 6C 00           
  178C'   30 00 5E 00           
  1790'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1792'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1796'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  179A'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  179E'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  17A2'   24 01                 
  17A4'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  17A8'   47 02 48 02           
  17AC'   4D 02 4C 02           
  17B0'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  17B2'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  17B4'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  17B5'                         VCB_C:
  17B5'   CD 17C1'              	CALL	VCB_CD
  17B8'   C3 189E'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  17BB'                         VCB_D:
  17BB'   CD 17C1'              	CALL	VCB_CD
  17BE'   C3 182D'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  17C1'                         VCB_CD:
  17C1'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  17C4'   22 2D76'              	SHLD	OPLO
  17C7'   CD 0000*              	CALL	CUROFF
  17CA'   CD 181C'              	CALL	CEND		; to the line's content end, the CR,LF left
  17CD'   22 2D78'              	SHLD	OPHI
  17D0'   C3 16EB'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  17D3'                         VC_X:
  17D3'   CD 0931'              	CALL	GLSTAL
  17D6'   CD 07A6'              	CALL	SETLIN
  17D9'   CD 06CB'              	CALL	GETCNT
  17DC'   22 2D7A'              	SHLD	CNTV
  17DF'   CD 0000*              	CALL	CUROFF
  17E2'   22 2D7E'              	SHLD	WKI		; cur
  17E5'   CD 181C'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  17E8'   EB                    	XCHG			; DE = contentend
  17E9'   2A 2D7E'              	LHLD	WKI		; HL = cur
  17EC'   EB                    	XCHG			; HL = contentend, DE = cur
  17ED'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  17F0'   7C                    	MOV	A,H
  17F1'   B5                    	ORA	L
  17F2'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  17F3'   EB                    	XCHG			; DE = available
  17F4'   2A 2D7A'              	LHLD	CNTV		; HL = count
  17F7'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  17FA'   DA 1800'              	JC	VX_USEA
  17FD'   C3 1801'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1800'                         VX_USEA:
  1800'   EB                    	XCHG			; HL = available
  1801'                         VX_DEL:
                                	;--- plain chars, and plain chars after them: the terminal can close
                                	;    the cells up itself (R_DCH).  A TAB there would change width. ---
  1801'   E5                    	PUSH	H
  1802'   CD 07C7'              	CALL	TAILTAB
  1805'   E1                    	POP	H
  1806'   B4                    	ORA	H		; (or more of them than a byte counts)
  1807'   C2 1813'              	JNZ	VX_D1
  180A'   7D                    	MOV	A,L
  180B'   32 2D33'              	STA	DCHN
  180E'   3E 07                 	MVI	A,R_DCH
  1810'   32 2D30'              	STA	RINTENT
  1813'                         VX_D1:
  1813'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1816'   CD 0174'              	CALL	MARKMOD
  1819'   C3 182D'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  181C'                         CEND:
  181C'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  181F'   7C                    	MOV	A,H
  1820'   B5                    	ORA	L
  1821'   C8                    	RZ			; the start of the text: nothing before it
  1822'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1823'   E5                    	PUSH	H
  1824'   CD 0000*              	CALL	CHARAT
  1827'   E1                    	POP	H		; HL = term-1
  1828'   FE 0D                 	CPI	CR
  182A'   C8                    	RZ			; a CR before the LF -> the content ends there
  182B'   23                    	INX	H
  182C'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  182D'                         CLAMPE:
  182D'   CD 0000*              	CALL	CUROFF
  1830'   E5                    	PUSH	H
  1831'   CD 0663'              	CALL	EOLC
  1834'   D1                    	POP	D		; DE = cur
  1835'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1838'   D8                    	RC
  1839'   C8                    	RZ
  183A'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  183D'                         VC_I:
  183D'   CD 06CB'              	CALL	GETCNT
  1840'   C3 189B'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1843'                         VC_A:
  1843'   CD 06CB'              	CALL	GETCNT
  1846'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1849'   CA 1860'              	JZ	VA_INS
  184C'   EB                    	XCHG			; HL = cur
  184D'   E5                    	PUSH	H
  184E'   CD 0000*              	CALL	CHARAT
  1851'   E1                    	POP	H
  1852'   FE 0A                 	CPI	LF
  1854'   CA 1860'              	JZ	VA_INS		; on the line terminator -> append in place
  1857'   FE 0D                 	CPI	CR
  1859'   CA 1860'              	JZ	VA_INS
  185C'   23                    	INX	H
  185D'   CD 0000*              	CALL	GOTO
  1860'                         VA_INS:
  1860'   C3 189B'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1863'                         VCB_A:
  1863'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1866'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  1869'   E5                    	PUSH	H
  186A'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  186D'   E1                    	POP	H
  186E'   FE 0D                 	CPI	CR
  1870'   CA 1879'              	JZ	VBA_IN		; an empty line: insert at its start
  1873'   FE 0A                 	CPI	LF
  1875'   CA 1879'              	JZ	VBA_IN
  1878'   23                    	INX	H		; past the last content char
  1879'                         VBA_IN:
  1879'   CD 0000*              	CALL	GOTO
  187C'   C3 189B'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  187F'                         VCB_I:
  187F'   CD 06CB'              	CALL	GETCNT
  1882'   CD 087F'              	CALL	FNBLNK
  1885'   CD 0000*              	CALL	CUROFF
  1888'   E5                    	PUSH	H
  1889'   CD 0000*              	CALL	CHARAT
  188C'   E1                    	POP	H
  188D'   FE 20                 	CPI	' '
  188F'   CA 1897'              	JZ	VBI_SK
  1892'   FE 09                 	CPI	TAB
  1894'   C2 189B'              	JNZ	SETINM
  1897'                         VBI_SK:
  1897'   23                    	INX	H		; blanks only: past the last of them
  1898'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  189B'                         SETINM:
  189B'   CD 07A0'              	CALL	SETMOV
  189E'                         SETINS:
  189E'   3E 01                 	MVI	A,EM_INS
  18A0'   32 2D2B'              	STA	EDMODE
  18A3'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  18A4'                         ATCEND:
  18A4'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  18A7'   C8                    	RZ
  18A8'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  18AB'   FE 0D                 	CPI	CR
  18AD'   C8                    	RZ
  18AE'   FE 0A                 	CPI	LF
  18B0'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  18B1'                         OPNBRK:
  18B1'   CD 21A8'              	CALL	PUTBRK
  18B4'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  18B7'   23                    	INX	H
  18B8'   22 0000*              	SHLD	LNDLT
  18BB'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  18BE'                         ENDBRK:
  18BE'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  18C1'   C0                    	RNZ
  18C2'   CD 18B1'              	CALL	OPNBRK
  18C5'   CD 0000*              	CALL	CUROFF
  18C8'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  18C9'   2B                    	DCX	H		;   line, with its own terminator after it
  18CA'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  18CD'                         VC_O:
  18CD'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18D0'   CD 181C'              	CALL	CEND
  18D3'   CD 0000*              	CALL	GOTO
  18D6'   CD 18B1'              	CALL	OPNBRK
  18D9'   CD 18BE'              	CALL	ENDBRK		; a last line with no line end: the opened line
  18DC'   CD 07AC'              	CALL	SETILN		;   needs a terminator of its own to exist
  18DF'   C3 189E'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  18E2'                         VCB_O:
  18E2'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18E5'   CD 0624'              	CALL	BOL
  18E8'   CD 0000*              	CALL	GOTO
  18EB'   CD 18B1'              	CALL	OPNBRK
  18EE'   CD 0000*              	CALL	CUROFF
  18F1'   2B                    	DCX	H
  18F2'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18F3'   CD 0000*              	CALL	GOTO
  18F6'   CD 07AC'              	CALL	SETILN
  18F9'   C3 189E'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  18FC'                         VCB_J:
  18FC'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18FF'   CD 181C'              	CALL	CEND		; the join point: this line's content end
  1902'   22 2D76'              	SHLD	OPLO
  1905'   CD 0000*              	CALL	CUROFF
  1908'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  190B'   E5                    	PUSH	H
  190C'   CD 0000*              	CALL	LOGLEN
  190F'   D1                    	POP	D		; DE = that start
  1910'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1913'   CA 07A0'              	JZ	SETMOV
  1916'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1917'                         VJ_WS:
  1917'   E5                    	PUSH	H
  1918'   CD 0000*              	CALL	LOGLEN
  191B'   D1                    	POP	D		; DE = the scan
  191C'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  191F'   CA 1936'              	JZ	VJ_DEL
  1922'   EB                    	XCHG			; HL = the scan
  1923'   E5                    	PUSH	H
  1924'   CD 0000*              	CALL	CHARAT
  1927'   E1                    	POP	H
  1928'   FE 20                 	CPI	' '
  192A'   CA 1932'              	JZ	VJ_SKIP
  192D'   FE 09                 	CPI	TAB
  192F'   C2 1936'              	JNZ	VJ_DEL
  1932'                         VJ_SKIP:
  1932'   23                    	INX	H
  1933'   C3 1917'              	JMP	VJ_WS
  1936'                         VJ_DEL:
  1936'   22 2D78'              	SHLD	OPHI
  1939'   CD 16EB'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  193C'   CD 07BB'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  193F'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1942'   CA 182D'              	JZ	CLAMPE
  1945'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  1948'   FE 0D                 	CPI	CR
  194A'   CA 182D'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  194D'   FE 0A                 	CPI	LF
  194F'   CA 182D'              	JZ	CLAMPE
  1952'   FE 29                 	CPI	')'
  1954'   CA 182D'              	JZ	CLAMPE		; vim puts no space before a ')'
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1957'   CD 0000*              	CALL	CUROFF
  195A'   7C                    	MOV	A,H
  195B'   B5                    	ORA	L
  195C'   CA 1972'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  195F'   2B                    	DCX	H
  1960'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1963'   FE 20                 	CPI	' '
  1965'   CA 182D'              	JZ	CLAMPE
  1968'   FE 09                 	CPI	TAB
  196A'   CA 182D'              	JZ	CLAMPE
  196D'   FE 0A                 	CPI	LF
  196F'   CA 182D'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1972'                         VJ_SP:
  1972'   3E 20                 	MVI	A,' '
  1974'   CD 0000*              	CALL	PUTGAP
  1977'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  197A'   2B                    	DCX	H
  197B'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  197E'                         VC_TILD:
  197E'   CD 06CB'              	CALL	GETCNT
  1981'   CD 07A6'              	CALL	SETLIN		; only this row changes
  1984'   CD 0931'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1987'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  198A'   CA 07A0'              	JZ	SETMOV
  198D'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1990'   FE 0D                 	CPI	CR
  1992'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  1995'   FE 0A                 	CPI	LF
  1997'   CA 07A0'              	JZ	SETMOV
  199A'   47                    	MOV	B,A
  199B'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  199D'   FE 41                 	CPI	'A'
  199F'   DA 19AB'              	JC	VT_PUT		; below 'A': no case
  19A2'   FE 5B                 	CPI	'Z'+1
  19A4'   D2 19AB'              	JNC	VT_PUT		; above 'Z': no case
  19A7'   78                    	MOV	A,B
  19A8'   EE 20                 	XRI	20H		; a letter: flip the case bit
  19AA'   47                    	MOV	B,A
  19AB'                         VT_PUT:
  19AB'   78                    	MOV	A,B
  19AC'   32 2D87'              	STA	VRCH		; the calls below do not preserve B
  19AF'   CD 0174'              	CALL	MARKMOD
  19B2'   21 0001               	LXI	H,1
  19B5'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19B8'   3A 2D87'              	LDA	VRCH
  19BB'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  19BE'   C3 182D'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  19C1'                         VC_R:
  19C1'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  19C4'   3E 03                 	MVI	A,PR
  19C6'   32 2D5F'              	STA	GPEND
  19C9'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  19CA'                         VR_DO:
  19CA'   AF                    	XRA	A
  19CB'   32 2D5F'              	STA	GPEND
  19CE'   79                    	MOV	A,C
  19CF'   32 2D87'              	STA	VRCH		; the calls below do not preserve C
  19D2'   CD 07A6'              	CALL	SETLIN		; only this row changed
  19D5'   CD 0931'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  19D8'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19DB'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
  19DE'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  19E1'   FE 0D                 	CPI	CR
  19E3'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  19E6'   FE 0A                 	CPI	LF
  19E8'   CA 07A0'              	JZ	SETMOV
  19EB'   CD 0174'              	CALL	MARKMOD
  19EE'   21 0001               	LXI	H,1
  19F1'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19F4'   3A 2D87'              	LDA	VRCH
  19F7'   FE 0D                 	CPI	CR
  19F9'   CA 1A06'              	JZ	VR_CR
  19FC'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  19FF'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1A02'   2B                    	DCX	H		;   out, which moves every logical offset
  1A03'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1A06'                         VR_CR:
  1A06'   CD 18B1'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1A09'   CD 18BE'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1A0C'   CD 07AC'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1A0F'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1A11'   32 2D34'              	STA	ILABOV
  1A14'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1A15'                         VCB_R:
  1A15'   CD 06CB'              	CALL	GETCNT
  1A18'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1A1B'   21 0000               	LXI	H,0
  1A1E'   22 2D88'              	SHLD	RPDEL		; nothing of ours to put back yet
  1A21'   22 2D8A'              	SHLD	RPAPP
  1A24'   3E 02                 	MVI	A,EM_REP
  1A26'   32 2D2B'              	STA	EDMODE
  1A29'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1A2A'                         VC_D:
  1A2A'   3E 64                 	MVI	A,'d'
  1A2C'   32 2D61'              	STA	PENDOP
  1A2F'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1A32'                         VC_C:
  1A32'   3E 63                 	MVI	A,'c'
  1A34'   32 2D61'              	STA	PENDOP
  1A37'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1A3A'                         VD_DD:
  1A3A'   CD 0931'              	CALL	GLSTAL
  1A3D'   CD 06CB'              	CALL	GETCNT
  1A40'   22 2D7A'              	SHLD	CNTV
  1A43'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1A45'   32 2D63'              	STA	DDSNG
  1A48'   2B                    	DCX	H
  1A49'   7C                    	MOV	A,H
  1A4A'   B5                    	ORA	L
  1A4B'   C2 1A59'              	JNZ	VDD_LS
  1A4E'   3E 01                 	MVI	A,1
  1A50'   32 2D63'              	STA	DDSNG
  1A53'   CD 1705'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1A56'   C3 1A5F'              	JMP	VDD_GO
  1A59'                         VDD_LS:
  1A59'   CD 08EA'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1A5C'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1A5F'                         VDD_GO:
  1A5F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1A62'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1A65'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1A68'   CD 240B'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1A6B'   CD 0868'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1A6E'   2A 2D7A'              	LHLD	CNTV
  1A71'   CD 0000*              	CALL	SETC0
  1A74'                         VDD_FW:
  1A74'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1A77'   DA 1BC5'              	JC	QREFUS		; ... which has no room for them
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A7A'   CD 06E0'              	CALL	CNTTST
  1A7D'   C2 1A74'              	JNZ	VDD_FW
  1A80'   CD 0174'              	CALL	MARKMOD
  1A83'   CD 0A68'              	CALL	ATEOF
  1A86'   D2 1AA1'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1A89'   3E 00                 	MVI	A,0
  1A8B'   32 2D63'              	STA	DDSNG		; deleted to the end: full repaint
  1A8E'   CD 1148'              	CALL	ONFST
  1A91'   CA 087F'              	JZ	FNBLNK		; nothing left before it
  1A94'   21 0001               	LXI	H,1		; onto the new last line
  1A97'   CD 0000*              	CALL	SETBWD
  1A9A'   2A 0000*              	LHLD	LNDLT
  1A9D'   2B                    	DCX	H
  1A9E'   22 0000*              	SHLD	LNDLT
  1AA1'                         VDD_UP:
  1AA1'   CD 087F'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1AA4'   3A 2D63'              	LDA	DDSNG
  1AA7'   B7                    	ORA	A
  1AA8'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1AA9'   3E 03                 	MVI	A,R_DLIN
  1AAB'   32 2D30'              	STA	RINTENT
  1AAE'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1AAF'                         QEMPTY:
  1AAF'   2A 0000*              	LHLD	QBEG
  1AB2'   EB                    	XCHG
  1AB3'   2A 0000*              	LHLD	QEND
  1AB6'   7C                    	MOV	A,H
  1AB7'   BA                    	CMP	D
  1AB8'   C0                    	RNZ
  1AB9'   7D                    	MOV	A,L
  1ABA'   BB                    	CMP	E
  1ABB'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; linewise ones and turns the rest away.
  1ABC'                         VC_Y:
  1ABC'   3E 79                 	MVI	A,'y'
  1ABE'   32 2D61'              	STA	PENDOP
  1AC1'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1AC4'                         VY_YY:
  1AC4'   21 2D6A'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1AC7'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1ACA'   CD 0000*              	CALL	CUROFF
  1ACD'   22 2DAB'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1AD0'   CD 0624'              	CALL	BOL
  1AD3'   22 2DAD'              	SHLD	YPT		; where the lines come from, to put them back
  1AD6'   CD 1C2B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AD9'   CD 1C6E'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1ADC'   D2 1C32'              	JNC	YNDONE
  1ADF'   21 1A3A'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1AE2'   C3 1B0E'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1AE5'                         OPYANK:
  1AE5'   CD 171D'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1AE8'   2A 2D66'              	LHLD	OPSTA
  1AEB'   EB                    	XCHG			; DE = start
  1AEC'   2A 2D68'              	LHLD	OPEND2		; HL = end
  1AEF'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1AF2'   D2 1AF6'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1AF5'   EB                    	XCHG			; ... otherwise the start is
  1AF6'                         OPY_LO:
  1AF6'   22 2DAB'              	SHLD	YOFF
  1AF9'   2A 2D76'              	LHLD	OPLO
  1AFC'   22 2DAD'              	SHLD	YPT		; where the lines come from, to put them back
  1AFF'   CD 1C2B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1B02'   CD 1CE6'              	CALL	YNSPAN		; copied where they lie, if there is room
  1B05'   D2 1C32'              	JNC	YNDONE
  1B08'   21 1BEC'              	LXI	H,YSPAN
  1B0B'   C3 1B0E'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1B0E'                         YKGO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B0E'   22 2DD5'              	SHLD	YACT
  1B11'   2A 2DAD'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1B14'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1B15'   2A 2DAB'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1B18'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1B1B'   22 2DDB'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1B1E'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1B21'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1B22'   2A 2DAD'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1B25'   EB                    	XCHG			;   window as it was, then names other text
  1B26'   E1                    	POP	H
  1B27'   CD 0000*              	CALL	SUBHD
  1B2A'   EB                    	XCHG			; DE = how far behind the cursor they start
  1B2B'   CD 1215'              	CALL	CURFP
  1B2E'   06 00                 	MVI	B,0
  1B30'   CD 120B'              	CALL	SUB24
  1B33'   22 2DDD'              	SHLD	YPFP
  1B36'   32 2DDF'              	STA	YPFP+2
  1B39'   3A 2D2F'              	LDA	MODF
  1B3C'   32 2DA8'              	STA	YMODF
  1B3F'   3A 2D54'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1B42'   32 2DA9'              	STA	YDCHG		;   a yank must not become the last change
  1B45'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1B48'   32 2DAA'              	STA	YURPL		;   back are not a change to undo either
  1B4B'   3E 01                 	MVI	A,1
  1B4D'   32 0000*              	STA	UNDRPL
  1B50'   32 2DD4'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1B53'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1B56'   22 2DB7'              	SHLD	YLDLT
  1B59'   CD 0000*              	CALL	LOGLEN
  1B5C'   22 2DD9'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1B5F'   2A 2DD5'              	LHLD	YACT
  1B62'   CD 1BC4'              	CALL	YCALL		; the lines out of the file, into the register
  1B65'   3A 2DA3'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1B68'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1B6A'   CA 1BA8'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1B6D'   CD 0000*              	CALL	LOGLEN
  1B70'   EB                    	XCHG
  1B71'   2A 2DD9'              	LHLD	YWAS
  1B74'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1B77'   CA 1B89'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1B7A'   21 2DDD'              	LXI	H,YPFP		; back to where they came from, by its place in
  1B7D'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1B80'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1B83'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1B86'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1B89'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1B89'   2A 2DDD'              	LHLD	YPFP		;   cursor is still owed its place)
  1B8C'   EB                    	XCHG
  1B8D'   2A 2DDB'              	LHLD	YCOL
  1B90'   19                    	DAD	D
  1B91'   22 2DD0'              	SHLD	MKPOS
  1B94'   3A 2DDF'              	LDA	YPFP+2
  1B97'   CE 00                 	ACI	0
  1B99'   32 2DD2'              	STA	MKPOS+2
  1B9C'   CD 03A9'              	CALL	MKPAGE
  1B9F'   CD 0000*              	CALL	GOTO
  1BA2'                         YK_RST:
  1BA2'   2A 2DB7'              	LHLD	YLDLT
  1BA5'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1BA8'                         YK_RF:
  1BA8'   3A 2DA8'              	LDA	YMODF
  1BAB'   32 2D2F'              	STA	MODF
  1BAE'   3A 2DA9'              	LDA	YDCHG
  1BB1'   32 2D54'              	STA	DOTCHG
  1BB4'   3A 2DAA'              	LDA	YURPL
  1BB7'   32 0000*              	STA	UNDRPL
  1BBA'   AF                    	XRA	A
  1BBB'   32 2DD4'              	STA	MKHOLD
  1BBE'   CD 0931'              	CALL	GLSTAL
  1BC1'   C3 07C1'              	JMP	SETFUL		; the cheap paint cannot carry this
  1BC4'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1BC5'                         QREFUS:
  1BC5'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1BC8'   CD 1AAF'              	CALL	QEMPTY
  1BCB'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1BCE'   CD 0000*              	CALL	QKILL
  1BD1'   3A 2DD4'              	LDA	MKHOLD
  1BD4'   B7                    	ORA	A
  1BD5'   C2 1BE4'              	JNZ	QRF_Y
  1BD8'   21 0000*              	LXI	H,MKSAV
  1BDB'   11 0000*              	LXI	D,MKTAB
  1BDE'   CD 240B'              	CALL	COPY12
  1BE1'   CD 0000*              	CALL	UNDCLR
  1BE4'                         QRF_Y:
  1BE4'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1BE6'   32 2DA3'              	STA	MSGWHT
  1BE9'   C3 152C'              	JMP	OPG_HM
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1BEC'                         YSPAN:
  1BEC'   CD 0931'              	CALL	GLSTAL
  1BEF'   CD 16E0'              	CALL	OPSPNL		; HL = the span's length
  1BF2'   22 2DD7'              	SHLD	YTGT
  1BF5'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1BF8'   EB                    	XCHG			; DE = it
  1BF9'   2A 2DD7'              	LHLD	YTGT
  1BFC'   EB                    	XCHG			; HL = the text's, DE = the span's
  1BFD'   CD 0000*              	CALL	SUBHD
  1C00'   22 2DD7'              	SHLD	YTGT		; what the text is left at when the span is out
  1C03'   2A 2D76'              	LHLD	OPLO
  1C06'   CD 0000*              	CALL	GOTO
  1C09'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C0C'                         YS_LP:
  1C0C'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1C0F'   CD 0000*              	CALL	SETC0
  1C12'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1C15'   DA 1BC5'              	JC	QREFUS		; ... which has no room for it
  1C18'   CD 0000*              	CALL	LOGLEN
  1C1B'   EB                    	XCHG			; DE = what is left
  1C1C'   2A 2DD7'              	LHLD	YTGT
  1C1F'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1C22'   DA 1C28'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1C25'   C2 1C0C'              	JNZ	YS_LP		;   but never spin here if it ever did
  1C28'                         YS_END:
  1C28'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1C2B'                         YNPRE:
  1C2B'   2A 0000*              	LHLD	PGTOPM
  1C2E'   22 2DE0'              	SHLD	YNPG
  1C31'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1C32'                         YNDONE:
  1C32'   2A 2DAB'              	LHLD	YOFF
  1C35'   CD 0000*              	CALL	GOTO
  1C38'   2A 0000*              	LHLD	PGTOPM
  1C3B'   EB                    	XCHG
  1C3C'   2A 2DE0'              	LHLD	YNPG
  1C3F'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1C42'   C2 07C1'              	JNZ	SETFUL		; it moved under us: repaint after all
  1C45'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1C48'                         YNROOM:
  1C48'   11 0100               	LXI	D,100H
  1C4B'   19                    	DAD	D
  1C4C'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1C4D'   E5                    	PUSH	H		; the span plus its slack
  1C4E'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1C51'   EB                    	XCHG			; HL = free
  1C52'   D1                    	POP	D		; DE = the span plus its slack
  1C53'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1C56'   DA 1C5E'              	JC	YNR_OK
  1C59'   CA 1C5E'              	JZ	YNR_OK
  1C5C'   37                    	STC			; not enough: the delete-and-put-back path
  1C5D'   C9                    	RET
  1C5E'                         YNR_OK:
  1C5E'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1C5F'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; not touched.
  1C60'                         YNGO:
  1C60'   C5                    	PUSH	B
  1C61'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  1C64'   CD 0931'              	CALL	GLSTAL
  1C67'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C6A'   C1                    	POP	B
  1C6B'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1C6E'                         YNCOPY:
  1C6E'   2A 2D2C'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1C71'   7C                    	MOV	A,H		;   the count itself
  1C72'   B5                    	ORA	L
  1C73'   C2 1C79'              	JNZ	YNC_HV
  1C76'   21 0001               	LXI	H,1
  1C79'                         YNC_HV:
  1C79'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1C7A'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1C7B'   B4                    	ORA	H
  1C7C'   CA 1C87'              	JZ	YNC_M
  1C7F'   E5                    	PUSH	H
  1C80'   CD 08EA'              	CALL	ONLAST		; vim: a count over one on the last line does
  1C83'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1C84'   DA 1C99'              	JC	YNC_RF
  1C87'                         YNC_M:
  1C87'   E5                    	PUSH	H
  1C88'   CD 0868'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1C8B'   E1                    	POP	H
  1C8C'   CD 1CA1'              	CALL	YNLINE		; BC = the span, measured where it stands
  1C8F'   D8                    	RC			; not measurable here: let the pager answer it
  1C90'   60                    	MOV	H,B
  1C91'   69                    	MOV	L,C
  1C92'   CD 1C48'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1C95'   D8                    	RC			; no: the delete-and-put-back path
  1C96'   C3 1C60'              	JMP	YNGO
  1C99'                         YNC_RF:
  1C99'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1C9C'   CD 0931'              	CALL	GLSTAL		;   register alone, and that is the command
  1C9F'   B7                    	ORA	A		; NC: done
  1CA0'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1CA1'                         YNLINE:
  1CA1'   22 2DE2'              	SHLD	YNCNT		; the lines it still wants
  1CA4'   2A 0000*              	LHLD	GAPEND
  1CA7'                         YNL_LP:
  1CA7'   EB                    	XCHG			; DE = the scan
  1CA8'   2A 0000*              	LHLD	TXTEND
  1CAB'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1CAE'   EB                    	XCHG			; HL = the scan
  1CAF'   D2 1CCF'              	JNC	YNL_EN		; the resident text ran out
  1CB2'   7E                    	MOV	A,M
  1CB3'   23                    	INX	H
  1CB4'   FE 0A                 	CPI	LF
  1CB6'   C2 1CA7'              	JNZ	YNL_LP
  1CB9'   E5                    	PUSH	H
  1CBA'   2A 2DE2'              	LHLD	YNCNT
  1CBD'   2B                    	DCX	H
  1CBE'   22 2DE2'              	SHLD	YNCNT
  1CC1'   7C                    	MOV	A,H
  1CC2'   B5                    	ORA	L
  1CC3'   E1                    	POP	H
  1CC4'   C2 1CA7'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1CC7'   EB                    	XCHG			; DE = past the last of them
  1CC8'   2A 0000*              	LHLD	GAPEND
  1CCB'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1CCC'   C3 1CDD'              	JMP	YNL_BC
  1CCF'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1CCF'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1CD2'   C2 1CE4'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1CD5'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1CD8'   EB                    	XCHG			;   count clamps to it as vim's does
  1CD9'   2A 0000*              	LHLD	GAPEND
  1CDC'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1CDD'                         YNL_BC:
  1CDD'   CD 0000*              	CALL	SUBHD		; HL = the span
  1CE0'   44                    	MOV	B,H
  1CE1'   4D                    	MOV	C,L
  1CE2'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1CE3'   C9                    	RET
  1CE4'                         YNL_NO:
  1CE4'   37                    	STC
  1CE5'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1CE6'                         YNSPAN:
  1CE6'   CD 16E0'              	CALL	OPSPNL		; HL = the span's length
  1CE9'   44                    	MOV	B,H
  1CEA'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1CEB'   CD 1C48'              	CALL	YNROOM
  1CEE'   D8                    	RC			; no room: the delete-and-put-back path
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CEF'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1CF0'   2A 2D76'              	LHLD	OPLO
  1CF3'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1CF6'   C1                    	POP	B
  1CF7'   C3 1C60'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1CFA'                         VC_P:
  1CFA'   CD 1AAF'              	CALL	QEMPTY
  1CFD'   CA 1DD0'              	JZ	VP_BEL
  1D00'   CD 06CB'              	CALL	GETCNT
  1D03'   22 2DAF'              	SHLD	PCNT
  1D06'   CD 0000*              	CALL	CUROFF
  1D09'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1D0C'   C3 1D21'              	JMP	VP_GO
  1D0F'                         VCB_P:
  1D0F'   CD 1AAF'              	CALL	QEMPTY
  1D12'   CA 1DD0'              	JZ	VP_BEL
  1D15'   CD 06CB'              	CALL	GETCNT
  1D18'   22 2DAF'              	SHLD	PCNT
  1D1B'   CD 0000*              	CALL	CUROFF
  1D1E'   CD 0624'              	CALL	BOL
  1D21'                         VP_GO:
  1D21'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1D24'   CD 0000*              	CALL	CUROFF
  1D27'   EB                    	XCHG
  1D28'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1D2B'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1D2E'   DA 1D43'              	JC	VP_IN
  1D31'   EB                    	XCHG			; HL = the put point = LOGLEN
  1D32'   7C                    	MOV	A,H
  1D33'   B5                    	ORA	L
  1D34'   CA 1D40'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1D37'   2B                    	DCX	H
  1D38'   CD 0000*              	CALL	CHARAT
  1D3B'   FE 0A                 	CPI	LF
  1D3D'   CA 1D43'              	JZ	VP_IN
  1D40'                         VP_BRK:
  1D40'   CD 18B1'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1D43'                         VP_IN:
  1D43'   21 2DB1'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1D46'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1D49'   CD 125E'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1D4C'   2A 0000*              	LHLD	QBEG
  1D4F'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D50'   2A 0000*              	LHLD	QEND
  1D53'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1D56'   EB                    	XCHG
  1D57'   22 2DB4'              	SHLD	PLFS
  1D5A'   2A 2DAF'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1D5D'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1D5E'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1D5F'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1D61'   C2 1D65'              	JNZ	VP_PZ
  1D64'   7D                    	MOV	A,L
  1D65'                         VP_PZ:
  1D65'   32 2DB6'              	STA	PCPY
  1D68'                         VP_LP:
  1D68'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1D6B'   2A 0000*              	LHLD	LNDLT
  1D6E'   EB                    	XCHG
  1D6F'   2A 2DB4'              	LHLD	PLFS
  1D72'   19                    	DAD	D
  1D73'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1D76'   2A 2DAF'              	LHLD	PCNT
  1D79'   2B                    	DCX	H
  1D7A'   22 2DAF'              	SHLD	PCNT
  1D7D'   7C                    	MOV	A,H
  1D7E'   B5                    	ORA	L
  1D7F'   C2 1D68'              	JNZ	VP_LP
  1D82'   CD 0174'              	CALL	MARKMOD
  1D85'   21 2DB1'              	LXI	H,PPFP
  1D88'   CD 03DC'              	CALL	MKLOAD
  1D8B'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1D8E'   D2 1DC1'              	JNC	VP_PGD
  1D91'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1D94'   CD 0931'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1D97'   3A 2DB6'              	LDA	PCPY
  1D9A'   B7                    	ORA	A
  1D9B'   CA 087F'              	JZ	FNBLNK
  1D9E'   2A 2DB4'              	LHLD	PLFS
  1DA1'   7C                    	MOV	A,H
  1DA2'   B7                    	ORA	A
  1DA3'   C2 087F'              	JNZ	FNBLNK
  1DA6'   3A 2DB6'              	LDA	PCPY
  1DA9'   CD 0F10'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1DAC'   7C                    	MOV	A,H
  1DAD'   B7                    	ORA	A
  1DAE'   C2 087F'              	JNZ	FNBLNK
  1DB1'   7D                    	MOV	A,L
  1DB2'   B7                    	ORA	A
  1DB3'   CA 087F'              	JZ	FNBLNK
  1DB6'   F5                    	PUSH	PSW
  1DB7'   CD 07AC'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1DBA'   F1                    	POP	PSW
  1DBB'   32 2D31'              	STA	ILN		; ... which the lines put now replace
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DBE'   C3 087F'              	JMP	FNBLNK
  1DC1'                         VP_PGD:				; the put paged its first line out: page back
  1DC1'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1DC4'   CD 0000*              	CALL	GOTO
  1DC7'   CD 0931'              	CALL	GLSTAL
  1DCA'   CD 1276'              	CALL	GPLACE
  1DCD'   C3 07C1'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1DD0'                         VP_BEL:
  1DD0'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1DD3'   0E 07                 	MVI	C,BEL
  1DD5'   CD 0000*              	CALL	BCONOU
  1DD8'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1DDB'                         VIREP:
  1DDB'   79                    	MOV	A,C
  1DDC'   FE 1B                 	CPI	ESC
  1DDE'   CA 1F03'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1DE1'   FE 0D                 	CPI	CR
  1DE3'   CA 1E47'              	JZ	VP_CR
  1DE6'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1DE8'   CA 1E47'              	JZ	VP_CR
  1DEB'   FE 08                 	CPI	BS
  1DED'   CA 1E53'              	JZ	VP_BS
  1DF0'   FE 7F                 	CPI	DEL
  1DF2'   CA 1E53'              	JZ	VP_BS
  1DF5'   32 2D87'              	STA	VRCH		; the calls below do not preserve C
  1DF8'   CD 07A6'              	CALL	SETLIN		; this row changed
  1DFB'   CD 0174'              	CALL	MARKMOD
  1DFE'   CD 18A4'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1E01'   CA 1E39'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1E04'   3A 2D87'              	LDA	VRCH
  1E07'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1E0A'   2A 2D88'              	LHLD	RPDEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E0D'   7C                    	MOV	A,H
  1E0E'   B5                    	ORA	L
  1E0F'   CA 1E25'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1E12'   2A 0000*              	LHLD	GAPEND
  1E15'   EB                    	XCHG
  1E16'   2A 2D8C'              	LHLD	RPGE
  1E19'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1E1C'   CA 1E25'              	JZ	VP_OVW
  1E1F'   21 0000               	LXI	H,0
  1E22'   22 2D88'              	SHLD	RPDEL		; the text moved: those originals are gone
  1E25'                         VP_OVW:
  1E25'   21 0001               	LXI	H,1
  1E28'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1E2B'   2A 0000*              	LHLD	GAPEND
  1E2E'   22 2D8C'              	SHLD	RPGE
  1E31'   2A 2D88'              	LHLD	RPDEL
  1E34'   23                    	INX	H
  1E35'   22 2D88'              	SHLD	RPDEL
  1E38'   C9                    	RET
  1E39'                         VP_APP:
  1E39'   3A 2D87'              	LDA	VRCH
  1E3C'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1E3F'   2A 2D8A'              	LHLD	RPAPP
  1E42'   23                    	INX	H
  1E43'   22 2D8A'              	SHLD	RPAPP
  1E46'   C9                    	RET
  1E47'                         VP_CR:
  1E47'   21 0000               	LXI	H,0
  1E4A'   22 2D88'              	SHLD	RPDEL		; a line break ends what BS can put back
  1E4D'   22 2D8A'              	SHLD	RPAPP
  1E50'   C3 1ED9'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1E53'                         VP_BS:
  1E53'   2A 2D8A'              	LHLD	RPAPP
  1E56'   7C                    	MOV	A,H
  1E57'   B5                    	ORA	L
  1E58'   CA 1E65'              	JZ	VP_BSD
  1E5B'   2B                    	DCX	H
  1E5C'   22 2D8A'              	SHLD	RPAPP		; an appended char: it just goes
  1E5F'   CD 07A6'              	CALL	SETLIN
  1E62'   C3 0000*              	JMP	DELPRV
  1E65'                         VP_BSD:
  1E65'   2A 2D88'              	LHLD	RPDEL
  1E68'   7C                    	MOV	A,H
  1E69'   B5                    	ORA	L
  1E6A'   CA 1E91'              	JZ	VP_BSM		; nothing of ours left
  1E6D'   2A 0000*              	LHLD	GAPEND
  1E70'   EB                    	XCHG
  1E71'   2A 2D8C'              	LHLD	RPGE
  1E74'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1E77'   C2 1E91'              	JNZ	VP_BSM
  1E7A'   2A 2D88'              	LHLD	RPDEL
  1E7D'   2B                    	DCX	H
  1E7E'   22 2D88'              	SHLD	RPDEL
  1E81'   CD 07A6'              	CALL	SETLIN
  1E84'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1E87'   CD 0000*              	CALL	UNDELF		; the original comes back
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E8A'   2A 0000*              	LHLD	GAPEND
  1E8D'   22 2D8C'              	SHLD	RPGE
  1E90'   C9                    	RET
  1E91'                         VP_BSM:
  1E91'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1E94'   C3 0814'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1E97'                         VIINS:
  1E97'   79                    	MOV	A,C
  1E98'   FE 1B                 	CPI	ESC
  1E9A'   CA 1F03'              	JZ	VI_ESC
  1E9D'   FE 0D                 	CPI	CR
  1E9F'   CA 1ED9'              	JZ	VI_CR
  1EA2'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1EA4'   CA 1ED9'              	JZ	VI_CR
  1EA7'   FE 08                 	CPI	BS
  1EA9'   CA 1EF1'              	JZ	VI_BS
  1EAC'   FE 7F                 	CPI	DEL
  1EAE'   CA 1EF1'              	JZ	VI_BS
  1EB1'   79                    	MOV	A,C
  1EB2'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1EB5'   CD 0174'              	CALL	MARKMOD
  1EB8'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1EBB'   79                    	MOV	A,C
  1EBC'   FE 20                 	CPI	' '
  1EBE'   D8                    	RC			; control char -> keep R_LINE
  1EBF'   FE 7F                 	CPI	DEL
  1EC1'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1EC2'   CD 07C7'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1EC5'   B7                    	ORA	A
  1EC6'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1EC7'   3E 04                 	MVI	A,R_ICH
  1EC9'   32 2D30'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1ECC'   CD 18A4'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1ECF'   3E 00                 	MVI	A,0
  1ED1'   C2 1ED5'              	JNZ	VI_ICH
  1ED4'   3C                    	INR	A
  1ED5'                         VI_ICH:
  1ED5'   32 2D32'              	STA	ICHAPP
  1ED8'   C9                    	RET
  1ED9'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1ED9'   CD 18A4'              	CALL	ATCEND
  1EDC'   3E 00                 	MVI	A,0
  1EDE'   CA 1EE2'              	JZ	VI_CRS
  1EE1'   3C                    	INR	A
  1EE2'                         VI_CRS:
  1EE2'   F5                    	PUSH	PSW
  1EE3'   CD 18B1'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1EE6'   CD 18BE'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1EE9'   CD 07AC'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1EEC'   F1                    	POP	PSW
  1EED'   32 2D34'              	STA	ILABOV
  1EF0'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1EF1'                         VI_BS:
  1EF1'   CD 0000*              	CALL	PEEKL
  1EF4'   D8                    	RC			; start of the file: nothing to delete
  1EF5'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1EF7'   CA 1EFD'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1EFA'   CD 07A6'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1EFD'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1EFD'   CD 0174'              	CALL	MARKMOD
  1F00'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1F03'                         VI_ESC:
  1F03'   3E 00                 	MVI	A,EM_CMD
  1F05'   32 2D2B'              	STA	EDMODE
  1F08'   CD 07A0'              	CALL	SETMOV
  1F0B'   CD 0814'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1F0E'   C3 0931'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1F11'                         RDLINE:
  1F11'   EB                    	XCHG			; HL = buffer
  1F12'   22 2D8E'              	SHLD	RLPTR
  1F15'   3E 00                 	MVI	A,0
  1F17'   32 2D90'              	STA	RLLEN
  1F1A'   78                    	MOV	A,B
  1F1B'   32 2D91'              	STA	RLMAX
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F1E'   79                    	MOV	A,C
  1F1F'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1F22'                         RL_LP:
  1F22'   CD 0000*              	CALL	GETKEY
  1F25'   FE 1B                 	CPI	ESC
  1F27'   CA 1F77'              	JZ	RL_CAN
  1F2A'   FE 0D                 	CPI	CR
  1F2C'   CA 1F82'              	JZ	RL_DONE
  1F2F'   FE 08                 	CPI	BS
  1F31'   CA 1F5F'              	JZ	RL_BS
  1F34'   FE 7F                 	CPI	DEL
  1F36'   CA 1F5F'              	JZ	RL_BS
  1F39'   FE 20                 	CPI	' '
  1F3B'   DA 1F22'              	JC	RL_LP		; control char -> ignore
  1F3E'   3A 2D90'              	LDA	RLLEN
  1F41'   47                    	MOV	B,A
  1F42'   3A 2D91'              	LDA	RLMAX
  1F45'   B8                    	CMP	B
  1F46'   CA 1F22'              	JZ	RL_LP		; full -> ignore
  1F49'   2A 2D8E'              	LHLD	RLPTR
  1F4C'   71                    	MOV	M,C
  1F4D'   23                    	INX	H
  1F4E'   22 2D8E'              	SHLD	RLPTR
  1F51'   3A 2D90'              	LDA	RLLEN
  1F54'   3C                    	INR	A
  1F55'   32 2D90'              	STA	RLLEN
  1F58'   79                    	MOV	A,C
  1F59'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1F5C'   C3 1F22'              	JMP	RL_LP
  1F5F'                         RL_BS:				; WM LINEPOP
  1F5F'   3A 2D90'              	LDA	RLLEN
  1F62'   B7                    	ORA	A
  1F63'   CA 1F77'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1F66'   3D                    	DCR	A
  1F67'   32 2D90'              	STA	RLLEN
  1F6A'   2A 2D8E'              	LHLD	RLPTR
  1F6D'   2B                    	DCX	H
  1F6E'   22 2D8E'              	SHLD	RLPTR
  1F71'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1F74'   C3 1F22'              	JMP	RL_LP
  1F77'                         RL_CAN:
  1F77'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1F79'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1F7C'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1F7F'   3E FF                 	MVI	A,0FFH		; cancelled
  1F81'   C9                    	RET
  1F82'                         RL_DONE:
  1F82'   AF                    	XRA	A
  1F83'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1F84'                         VC_BZ:
  1F84'   CD 07A0'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F87'   3A 2D60'              	LDA	GSAVE
  1F8A'   FE 02                 	CPI	PZ
  1F8C'   CA 1F97'              	JZ	VZ_ZZ
  1F8F'   B7                    	ORA	A
  1F90'   C0                    	RNZ			; 'g' was pending: vim drops both
  1F91'   3E 02                 	MVI	A,PZ
  1F93'   32 2D5F'              	STA	GPEND
  1F96'   C9                    	RET
  1F97'                         VZ_ZZ:
  1F97'   3E 04                 	MVI	A,EO_X
  1F99'   32 2D92'              	STA	EXOP
  1F9C'   3E 01                 	MVI	A,1
  1F9E'   32 2DA5'              	STA	EXBANG		; no '!'
  1FA1'   AF                    	XRA	A
  1FA2'   32 2D93'              	STA	EXARG		; no file name
  1FA5'   3A 2D2F'              	LDA	MODF		; as ':x': a changed text is written first
  1FA8'   B7                    	ORA	A
  1FA9'   CA 20EA'              	JZ	EX_Q
  1FAC'   C3 2084'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1FAF'                         VC_EX:
  1FAF'   CD 06CB'              	CALL	GETCNT
  1FB2'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1FB5'   11 0000*              	LXI	D,EXBUF
  1FB8'   06 28                 	MVI	B,EXMAX
  1FBA'   0E 3A                 	MVI	C,':'
  1FBC'   CD 1F11'              	CALL	RDLINE
  1FBF'   B7                    	ORA	A
  1FC0'   C0                    	RNZ			; cancelled
  1FC1'   3A 2D90'              	LDA	RLLEN
  1FC4'   5F                    	MOV	E,A
  1FC5'   16 00                 	MVI	D,0
  1FC7'   21 0000*              	LXI	H,EXBUF
  1FCA'   19                    	DAD	D
  1FCB'   36 00                 	MVI	M,0		; the line ends with a 0
  1FCD'   21 0000*              	LXI	H,EXBUF
  1FD0'   CD 259C'              	CALL	SKIPB
  1FD3'   C8                    	RZ			; nothing on it
  1FD4'   22 2D95'              	SHLD	EXCMD
  1FD7'   CD 27A0'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1FDA'   CD 259C'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FDD'   56                    	MOV	D,M
  1FDE'   23                    	INX	H
  1FDF'   1E 00                 	MVI	E,0
  1FE1'   CD 25A8'              	CALL	ISLOW
  1FE4'   DA 1FEF'              	JC	EX_LK
  1FE7'   5F                    	MOV	E,A
  1FE8'   23                    	INX	H
  1FE9'   CD 25A8'              	CALL	ISLOW
  1FEC'   D2 2008'              	JNC	EX_NOT		; a third letter: none of ours
  1FEF'                         EX_LK:
  1FEF'   E5                    	PUSH	H
  1FF0'   21 2787'              	LXI	H,EXTAB
  1FF3'                         EX_TL:
  1FF3'   7E                    	MOV	A,M
  1FF4'   B7                    	ORA	A
  1FF5'   CA 2007'              	JZ	EX_NTP		; not in the table
  1FF8'   23                    	INX	H
  1FF9'   BA                    	CMP	D
  1FFA'   7E                    	MOV	A,M
  1FFB'   23                    	INX	H
  1FFC'   C2 2003'              	JNZ	EX_TN
  1FFF'   BB                    	CMP	E
  2000'   CA 200E'              	JZ	EX_TF
  2003'                         EX_TN:
  2003'   23                    	INX	H
  2004'   C3 1FF3'              	JMP	EX_TL
  2007'                         EX_NTP:
  2007'   E1                    	POP	H
  2008'                         EX_NOT:
  2008'   21 2660'              	LXI	H,SNOT
  200B'   C3 25DD'              	JMP	EXERT
  200E'                         EX_TF:
  200E'   7E                    	MOV	A,M
  200F'   32 2D92'              	STA	EXOP
  2012'   E1                    	POP	H
  2013'   FE 06                 	CPI	EO_S
  2015'   CA 280F'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2018'   FE 01                 	CPI	EO_W
  201A'   CA 2029'              	JZ	EX_RG		; ':N,Mw name' takes a range
  201D'   FE 08                 	CPI	EO_R
  201F'   CA 2029'              	JZ	EX_RG		; ... and ':Nr name' a line
  2022'   3A 2DEE'              	LDA	SRNGF
  2025'   B7                    	ORA	A
  2026'   C2 2008'              	JNZ	EX_NOT		; a range on a command that does not take one
  2029'                         EX_RG:
                                	;--- '!', then the file name ---
  2029'   7E                    	MOV	A,M
  202A'   D6 21                 	SUI	'!'
  202C'   32 2DA5'              	STA	EXBANG		; 0 = '!'
  202F'   C2 2033'              	JNZ	EX_NB
  2032'   23                    	INX	H
  2033'                         EX_NB:
  2033'   CD 259C'              	CALL	SKIPB
  2036'   32 2D93'              	STA	EXARG		; 0 = no file name
  2039'   CA 2052'              	JZ	EX_RUN
  203C'   22 2D95'              	SHLD	EXCMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  203F'   3A 2D92'              	LDA	EXOP
  2042'   FE 02                 	CPI	EO_Q
  2044'   CA 25DA'              	JZ	EX_TRL		; :q takes none
  2047'   FE 07                 	CPI	EO_V
  2049'   CA 25DA'              	JZ	EX_TRL		; nor :ve
  204C'   CD 2506'              	CALL	PARSFN
  204F'   C2 25CE'              	JNZ	EX_INV
  2052'                         EX_RUN:
  2052'   3A 2D92'              	LDA	EXOP
  2055'   FE 05                 	CPI	EO_E
  2057'   CA 2101'              	JZ	EX_E
  205A'   FE 02                 	CPI	EO_Q
  205C'   CA 20EA'              	JZ	EX_Q
  205F'   FE 07                 	CPI	EO_V
  2061'   CA 25D4'              	JZ	EX_V
  2064'   FE 08                 	CPI	EO_R
  2066'   CA 2292'              	JZ	EX_R
  2069'   FE 04                 	CPI	EO_X
  206B'   CA 207D'              	JZ	EX_XM
  206E'   FE 01                 	CPI	EO_W
  2070'   C2 2084'              	JNZ	EX_W		; :wq
  2073'   3A 2DEE'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2076'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2077'   C2 21B2'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  207A'   C3 2084'              	JMP	EX_W
  207D'                         EX_XM:
  207D'   3A 2D2F'              	LDA	MODF		; :x writes only a changed text
  2080'   B7                    	ORA	A
  2081'   CA 20EA'              	JZ	EX_Q
  2084'                         EX_W:
  2084'   CD 2372'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2087'   D8                    	RC			; refused (message shown)
  2088'   32 2D94'              	STA	EXBAK
  208B'   3A 2D92'              	LDA	EXOP
  208E'   FE 01                 	CPI	EO_W
  2090'   CA 20A7'              	JZ	EX_WK
  2093'   3A 2D94'              	LDA	EXBAK
  2096'   B7                    	ORA	A
  2097'   C2 20E7'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  209A'   3A 2DA5'              	LDA	EXBANG
  209D'   B7                    	ORA	A
  209E'   CA 20E7'              	JZ	EX_WQ		; so it does with '!'
  20A1'   CD 20A7'              	CALL	EX_WK		; else it may not: keep the text
  20A4'   C3 20EA'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  20A7'                         EX_WK:
  20A7'   CD 0D4C'              	CALL	CURRW		; the cursor's row and file position
  20AA'   32 2D97'              	STA	WPROW
  20AD'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  20B0'   7D                    	MOV	A,L
  20B1'   E6 7F                 	ANI	7FH
  20B3'   32 2D98'              	STA	WPBYT
  20B6'   7D                    	MOV	A,L
  20B7'   17                    	RAL
  20B8'   7C                    	MOV	A,H
  20B9'   17                    	RAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  20BA'   5F                    	MOV	E,A
  20BB'   3E 00                 	MVI	A,0
  20BD'   17                    	RAL
  20BE'   57                    	MOV	D,A		; DE = HL / 128
  20BF'   2A 0000*              	LHLD	OUTPOS
  20C2'   19                    	DAD	D
  20C3'   22 2D99'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  20C6'   CD 23A7'              	CALL	WRITE
  20C9'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  20CC'   2A 2D99'              	LHLD	WPREC
  20CF'   EB                    	XCHG
  20D0'   3A 2D98'              	LDA	WPBYT
  20D3'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  20D6'   CD 0000*              	CALL	GOTO
  20D9'                         EX_WRW:
  20D9'   21 0000               	LXI	H,0
  20DC'   22 0000*              	SHLD	LNDLT
  20DF'   3A 2D97'              	LDA	WPROW
  20E2'   6F                    	MOV	L,A
  20E3'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  20E6'   C9                    	RET
  20E7'                         EX_WQ:
  20E7'   CD 23A7'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  20EA'                         EX_Q:
  20EA'   3A 2DA5'              	LDA	EXBANG
  20ED'   B7                    	ORA	A
  20EE'   CA 20F8'              	JZ	EX_QT
  20F1'   3A 2D2F'              	LDA	MODF
  20F4'   B7                    	ORA	A
  20F5'   C2 25C2'              	JNZ	MSGNWR		; changed, no '!': stay
  20F8'                         EX_QT:
  20F8'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  20FB'   3E 01                 	MVI	A,1
  20FD'   32 2D2E'              	STA	QUITF
  2100'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2101'                         EX_E:
  2101'   3A 2DA5'              	LDA	EXBANG
  2104'   B7                    	ORA	A
  2105'   CA 210F'              	JZ	EE_GO
  2108'   3A 2D2F'              	LDA	MODF
  210B'   B7                    	ORA	A
  210C'   C2 25C2'              	JNZ	MSGNWR
  210F'                         EE_GO:
  210F'   3A 2D93'              	LDA	EXARG
  2112'   B7                    	ORA	A
  2113'   C2 211A'              	JNZ	EE_ARG
  2116'   CD 23E3'              	CALL	OWNTF		; no name: the buffer's own
  2119'   D8                    	RC
  211A'                         EE_ARG:
  211A'   CD 23F9'              	CALL	ISOWN
  211D'   21 0001               	LXI	H,1
  2120'   C2 2127'              	JNZ	EE_LD		; another file: its first line
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2123'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2126'   23                    	INX	H		; HL = the cursor's line
  2127'                         EE_LD:
  2127'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2129'   32 2DA3'              	STA	MSGWHT
  212C'   E5                    	PUSH	H
  212D'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2130'   21 0000*              	LXI	H,TFCB
  2133'   11 0000*              	LXI	D,FNAME
  2136'   CD 240B'              	CALL	COPY12		; the buffer's name
  2139'   CD 23D0'              	CALL	SRCTF
  213C'   CD 0000*              	CALL	REOPEN
  213F'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2142'   AF                    	XRA	A
  2143'   32 2D2F'              	STA	MODF
  2146'   E1                    	POP	H
  2147'   2B                    	DCX	H
  2148'   AF                    	XRA	A
  2149'   CD 0000*              	CALL	MVLIND		; down to the line
  214C'   CD 0A68'              	CALL	ATEOF
  214F'   DC 0A6E'              	CC	LASTLN		; past the last line: onto it
  2152'   CD 1238'              	CALL	ZSAVE
  2155'   C3 130D'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2158'                         TFDOS:
  2158'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2159'   11 0080               	LXI	D,CMDTAIL
  215C'   0E 1A                 	MVI	C,1AH		; set the DMA
  215E'   CD 0005               	CALL	BDOS
  2161'   C1                    	POP	B
  2162'   11 0000*              	LXI	D,TFCB
  2165'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2168'                         EXRNG:
  2168'   2A 2DEF'              	LHLD	SRNG1
  216B'   7C                    	MOV	A,H
  216C'   B5                    	ORA	L
  216D'   37                    	STC
  216E'   C8                    	RZ
  216F'   2A 2DF1'              	LHLD	SRNG2
  2172'   EB                    	XCHG
  2173'   2A 2DEF'              	LHLD	SRNG1
  2176'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2179'   D8                    	RC
  217A'   EB                    	XCHG			; HL = the last line, DE = the first
  217B'   CD 0000*              	CALL	SUBHD
  217E'   23                    	INX	H
  217F'   22 2DF9'              	SHLD	SLINES
  2182'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2183'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2184'                         GOLNX:
  2184'   E5                    	PUSH	H
  2185'   CD 11CC'              	CALL	GOLN
  2188'   CD 0000*              	CALL	CNTLF
  218B'   23                    	INX	H		; the line the cursor came to rest on
  218C'   D1                    	POP	D
  218D'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2190'                         EXSAVP:
  2190'   CD 0D4C'              	CALL	CURRW
  2193'   32 2D97'              	STA	WPROW
  2196'   21 2DD0'              	LXI	H,MKPOS
  2199'   C3 0429'              	JMP	FPSTO
  219C'                         EXRSTP:
  219C'   CD 0000*              	CALL	CLRCNT
  219F'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  21A2'   CD 0000*              	CALL	GOTO
  21A5'   C3 20D9'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  21A8'                         PUTBRK:
  21A8'   3E 0D                 	MVI	A,CR
  21AA'   CD 0000*              	CALL	PUTGAP
  21AD'   3E 0A                 	MVI	A,LF
  21AF'   C3 0000*              	JMP	PUTGAP
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  21B2'                         EX_WR:
  21B2'   3A 2D93'              	LDA	EXARG
  21B5'   B7                    	ORA	A
  21B6'   CA 25B0'              	JZ	MSGNFN		; No file name
  21B9'   CD 23F9'              	CALL	ISOWN
  21BC'   CA 225C'              	JZ	EXW_OW
  21BF'   CD 0000*              	CALL	TEXIST
  21C2'   32 2DFC'              	STA	RWERR		; nonzero: a file of that name is there
  21C5'   CA 21CF'              	JZ	EXW_GO
  21C8'   3A 2DA5'              	LDA	EXBANG
  21CB'   B7                    	ORA	A
  21CC'   C2 25B6'              	JNZ	MSGEXI		; File exists (! to force)
  21CF'                         EXW_GO:
  21CF'   CD 2168'              	CALL	EXRNG
  21D2'   DA 2256'              	JC	EXW_BD
  21D5'   CD 2190'              	CALL	EXSAVP
  21D8'   2A 2DEF'              	LHLD	SRNG1
  21DB'   CD 2184'              	CALL	GOLNX
  21DE'   C2 2253'              	JNZ	EXW_NL		; the text has no line N
  21E1'   3A 2DFC'              	LDA	RWERR		; a delete scans the whole directory, there or
  21E4'   B7                    	ORA	A		;   not: only when TEXIST found one
  21E5'   0E 13                 	MVI	C,13H
  21E7'   C4 2158'              	CNZ	TFDOS		; delete what is there
  21EA'   0E 16                 	MVI	C,16H
  21EC'   CD 2158'              	CALL	TFDOS		; ... and make it
  21EF'   3C                    	INR	A
  21F0'   CA 2245'              	JZ	EXW_FL		; no directory entry left
  21F3'   3E 80                 	MVI	A,80H
  21F5'   32 2DFB'              	STA	RWPTR
  21F8'   AF                    	XRA	A
  21F9'   32 2DFC'              	STA	RWERR
  21FC'   2A 2DF9'              	LHLD	SLINES
  21FF'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2202'                         EXW_LP:
  2202'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2205'   E5                    	PUSH	H
  2206'   EB                    	XCHG
  2207'   2A 0000*              	LHLD	GAPEND
  220A'   CD 2262'              	CALL	RWOUT		; the text from the cursor to there
  220D'   E1                    	POP	H
  220E'   3A 2DFC'              	LDA	RWERR
  2211'   B7                    	ORA	A
  2212'   C2 222E'              	JNZ	EXW_EN
  2215'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2218'   CD 06E0'              	CALL	CNTTST
  221B'   C2 2202'              	JNZ	EXW_LP
  221E'                         EXW_PD:				; the last record is padded out with ^Z
  221E'   3A 2DFB'              	LDA	RWPTR
  2221'   FE 80                 	CPI	80H
  2223'   CA 222E'              	JZ	EXW_EN
  2226'   3E 1A                 	MVI	A,CPMEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  2228'   CD 226E'              	CALL	RWPUT
  222B'   C3 221E'              	JMP	EXW_PD
  222E'                         EXW_EN:
  222E'   0E 10                 	MVI	C,10H
  2230'   CD 2158'              	CALL	TFDOS		; close
  2233'   3A 2DFC'              	LDA	RWERR
  2236'   B7                    	ORA	A
  2237'   C2 2245'              	JNZ	EXW_FL
  223A'   CD 219C'              	CALL	EXRSTP
  223D'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  223F'   32 2DA3'              	STA	MSGWHT
  2242'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  2245'                         EXW_FL:				; no room: the part written is not left behind
  2245'   0E 13                 	MVI	C,13H
  2247'   CD 2158'              	CALL	TFDOS
  224A'   CD 219C'              	CALL	EXRSTP
  224D'   21 277D'              	LXI	H,SDFUL
  2250'   C3 25E8'              	JMP	EXERR
  2253'                         EXW_NL:
  2253'   CD 219C'              	CALL	EXRSTP
  2256'                         EXW_BD:
  2256'   21 276F'              	LXI	H,SRNGE
  2259'   C3 25E8'              	JMP	EXERR
  225C'                         EXW_OW:
  225C'   21 2617'              	LXI	H,SEXI
  225F'   C3 25E8'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2262'                         RWOUT:
  2262'   CD 0000*              	CALL	CMP16
  2265'   C8                    	RZ
  2266'   7E                    	MOV	A,M
  2267'   23                    	INX	H
  2268'   CD 226E'              	CALL	RWPUT
  226B'   C3 2262'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  226E'                         RWPUT:
  226E'   E5                    	PUSH	H
  226F'   F5                    	PUSH	PSW
  2270'   3A 2DFB'              	LDA	RWPTR
  2273'   6F                    	MOV	L,A
  2274'   26 00                 	MVI	H,0
  2276'   F1                    	POP	PSW
  2277'   77                    	MOV	M,A
  2278'   2C                    	INR	L		; Z: that was the record's last byte
  2279'   7D                    	MOV	A,L
  227A'   C2 228D'              	JNZ	RWP_ST
  227D'   D5                    	PUSH	D
  227E'   0E 15                 	MVI	C,15H
  2280'   CD 2158'              	CALL	TFDOS		; write it
  2283'   D1                    	POP	D
  2284'   B7                    	ORA	A
  2285'   CA 228B'              	JZ	RWP_OK
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2288'   32 2DFC'              	STA	RWERR
  228B'                         RWP_OK:
  228B'   3E 80                 	MVI	A,80H
  228D'                         RWP_ST:
  228D'   32 2DFB'              	STA	RWPTR
  2290'   E1                    	POP	H
  2291'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2292'                         EX_R:
  2292'   3A 2D93'              	LDA	EXARG
  2295'   B7                    	ORA	A
  2296'   CA 25B0'              	JZ	MSGNFN		; No file name
  2299'   0E 0F                 	MVI	C,0FH
  229B'   CD 2158'              	CALL	TFDOS		; open
  229E'   3C                    	INR	A
  229F'   CA 236C'              	JZ	ER_NOF
  22A2'   CD 125E'              	CALL	GZONE		; the screen's top line, before anything moves
  22A5'   CD 2190'              	CALL	EXSAVP
  22A8'   3A 2DEE'              	LDA	SRNGF
  22AB'   B7                    	ORA	A
  22AC'   CA 22C5'              	JZ	ER_NXT		; no line given: below the cursor's
  22AF'   2A 2DF1'              	LHLD	SRNG2
  22B2'   7C                    	MOV	A,H
  22B3'   B5                    	ORA	L
  22B4'   C2 22BF'              	JNZ	ER_LN
  22B7'   23                    	INX	H
  22B8'   CD 11CC'              	CALL	GOLN		; ':0r': above line 1 ...
  22BB'   AF                    	XRA	A		;   which never wants a line end put in first
  22BC'   C3 22E7'              	JMP	ER_BRK
  22BF'                         ER_LN:
  22BF'   CD 2184'              	CALL	GOLNX
  22C2'   C2 2253'              	JNZ	EXW_NL		; the text has no line N
  22C5'                         ER_NXT:
  22C5'   21 0001               	LXI	H,1
  22C8'   AF                    	XRA	A
  22C9'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  22CC'   CD 0A68'              	CALL	ATEOF
  22CF'   3E 00                 	MVI	A,0
  22D1'   D2 22E7'              	JNC	ER_BRK		; text follows
  22D4'   2A 0000*              	LHLD	GAPBEG
  22D7'   EB                    	XCHG
  22D8'   2A 0000*              	LHLD	TXTBEG
  22DB'   CD 0000*              	CALL	CMP16
  22DE'   3E 01                 	MVI	A,1
  22E0'   CA 22E7'              	JZ	ER_BRK		; nothing before the cursor either
  22E3'   1B                    	DCX	D
  22E4'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22E5'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  22E7'                         ER_BRK:
  22E7'   32 2DFE'              	STA	RDBRK
  22EA'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  22ED'   AF                    	XRA	A
  22EE'   32 2DFD'              	STA	RDANY
  22F1'                         ER_LP:
  22F1'   0E 14                 	MVI	C,14H
  22F3'   CD 2158'              	CALL	TFDOS		; the next record
  22F6'   B7                    	ORA	A
  22F7'   C2 232A'              	JNZ	ER_END
  22FA'   21 0080               	LXI	H,CMDTAIL
  22FD'   0E 00                 	MVI	C,0
  22FF'                         ER_SC:				; C = its bytes, up to a ^Z
  22FF'   7E                    	MOV	A,M
  2300'   FE 1A                 	CPI	CPMEOF
  2302'   CA 230A'              	JZ	ER_GOT
  2305'   23                    	INX	H
  2306'   0C                    	INR	C
  2307'   F2 22FF'              	JP	ER_SC		; (minus: all 128)
  230A'                         ER_GOT:
  230A'   79                    	MOV	A,C
  230B'   B7                    	ORA	A
  230C'   CA 232A'              	JZ	ER_END
  230F'   C5                    	PUSH	B
  2310'   3A 2DFD'              	LDA	RDANY
  2313'   B7                    	ORA	A
  2314'   CC 235B'              	CZ	ER_1ST
  2317'   C1                    	POP	B
  2318'   06 00                 	MVI	B,0
  231A'   11 0080               	LXI	D,CMDTAIL
  231D'   C5                    	PUSH	B
  231E'   CD 0000*              	CALL	INSBLK
  2321'   C1                    	POP	B
  2322'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2325'   79                    	MOV	A,C
  2326'   17                    	RAL
  2327'   DA 22F1'              	JC	ER_LP		; a full record: there may be more
  232A'                         ER_END:
  232A'   3A 2DFD'              	LDA	RDANY
  232D'   B7                    	ORA	A
  232E'   CA 234C'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2331'   CD 0A68'              	CALL	ATEOF
  2334'   DA 2341'              	JC	ER_MD		; the text now ends as the file read ends
  2337'   2A 0000*              	LHLD	GAPBEG
  233A'   2B                    	DCX	H
  233B'   7E                    	MOV	A,M
  233C'   FE 0A                 	CPI	LF
  233E'   C4 21A8'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2341'                         ER_MD:
  2341'   3E 01                 	MVI	A,1
  2343'   32 2D2F'              	STA	MODF
  2346'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2349'   CD 0000*              	CALL	GOTO
  234C'                         ER_PL:
  234C'   CD 0A68'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  234F'   DC 0A6E'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2352'   CD 0000*              	CALL	CLRCNT
  2355'   CD 1276'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2358'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  235B'                         ER_1ST:
  235B'   3C                    	INR	A
  235C'   32 2DFD'              	STA	RDANY
  235F'   3A 2DFE'              	LDA	RDBRK
  2362'   B7                    	ORA	A
  2363'   C4 21A8'              	CNZ	PUTBRK
  2366'   21 2DD0'              	LXI	H,MKPOS
  2369'   C3 0429'              	JMP	FPSTO
  236C'                         ER_NOF:
  236C'   21 275E'              	LXI	H,SNOPN
  236F'   C3 25DD'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2372'                         WRCHK:
  2372'   3A 2D93'              	LDA	EXARG
  2375'   B7                    	ORA	A
  2376'   C2 2380'              	JNZ	WC_ARG
  2379'   CD 23E3'              	CALL	OWNTF
  237C'   D8                    	RC
  237D'   C3 2395'              	JMP	WC_OWN
  2380'                         WC_ARG:
  2380'   CD 23F9'              	CALL	ISOWN
  2383'   CA 2395'              	JZ	WC_OWN
  2386'   3A 2DA5'              	LDA	EXBANG
  2389'   B7                    	ORA	A
  238A'   CA 2393'              	JZ	WC_OTH
  238D'   CD 0000*              	CALL	TEXIST
  2390'   C2 25B6'              	JNZ	MSGEXI		; File exists (! to force)
  2393'                         WC_OTH:
  2393'   AF                    	XRA	A		; (NC)
  2394'   C9                    	RET
  2395'                         WC_OWN:
  2395'   3A 2DA6'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2398'   B7                    	ORA	A
  2399'   CA 23A3'              	JZ	WC_OK
  239C'   3A 2DA5'              	LDA	EXBANG
  239F'   B7                    	ORA	A
  23A0'   C2 25BC'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  23A3'                         WC_OK:
  23A3'   3E 01                 	MVI	A,1
  23A5'   B7                    	ORA	A		; (NC)
  23A6'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  23A7'                         WRITE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  23A7'   3A 2D94'              	LDA	EXBAK
  23AA'   CD 0000*              	CALL	WRTO
  23AD'   3A 0001*              	LDA	FNAME+1
  23B0'   FE 20                 	CPI	' '
  23B2'   C2 23BE'              	JNZ	WR_HAS
  23B5'   21 0000*              	LXI	H,TFCB
  23B8'   11 0000*              	LXI	D,FNAME
  23BB'   CD 240B'              	CALL	COPY12
  23BE'                         WR_HAS:
  23BE'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  23C0'   32 2DA3'              	STA	MSGWHT
  23C3'   CD 23F9'              	CALL	ISOWN
  23C6'   C2 23D0'              	JNZ	SRCTF
  23C9'   AF                    	XRA	A
  23CA'   32 2D2F'              	STA	MODF
  23CD'   32 2DA4'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  23D0'                         SRCTF:
  23D0'   21 0000*              	LXI	H,TFCB
  23D3'   11 005C               	LXI	D,DFTFCB
  23D6'   CD 240B'              	CALL	COPY12
  23D9'   AF                    	XRA	A
  23DA'   06 04                 	MVI	B,4
  23DC'                         SRC_Z:
  23DC'   12                    	STAX	D		; extent, s1, s2, record count: 0
  23DD'   13                    	INX	D
  23DE'   05                    	DCR	B
  23DF'   C2 23DC'              	JNZ	SRC_Z
  23E2'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  23E3'                         OWNTF:
  23E3'   3A 0001*              	LDA	FNAME+1
  23E6'   FE 20                 	CPI	' '
  23E8'   CA 25B0'              	JZ	MSGNFN
  23EB'   CD 2416'              	CALL	TFCLR
  23EE'   21 0000*              	LXI	H,FNAME
  23F1'   11 0000*              	LXI	D,TFCB
  23F4'   CD 240B'              	CALL	COPY12
  23F7'   B7                    	ORA	A		; (NC)
  23F8'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  23F9'                         ISOWN:
  23F9'   21 0000*              	LXI	H,TFCB
  23FC'   11 0000*              	LXI	D,FNAME
  23FF'   06 0C                 	MVI	B,12
  2401'                         IO_LP:
  2401'   1A                    	LDAX	D
  2402'   BE                    	CMP	M
  2403'   C0                    	RNZ
  2404'   23                    	INX	H
  2405'   13                    	INX	D
  2406'   05                    	DCR	B
  2407'   C2 2401'              	JNZ	IO_LP
  240A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  240B'                         COPY12:
  240B'   06 0C                 	MVI	B,12
  240D'                         CP_LP:
  240D'   7E                    	MOV	A,M
  240E'   12                    	STAX	D
  240F'   23                    	INX	H
  2410'   13                    	INX	D
  2411'   05                    	DCR	B
  2412'   C2 240D'              	JNZ	CP_LP
  2415'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2416'                         TFCLR:
  2416'   11 0000*              	LXI	D,TFCB
  2419'   06 24                 	MVI	B,36
  241B'   AF                    	XRA	A
  241C'                         TC_LP:
  241C'   12                    	STAX	D
  241D'   13                    	INX	D
  241E'   05                    	DCR	B
  241F'   C2 241C'              	JNZ	TC_LP
  2422'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2423'                         FOPEN:
  2423'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2425'   32 2DA3'              	STA	MSGWHT
  2428'   21 005C               	LXI	H,DFTFCB
  242B'   CD 24F9'              	CALL	NRMDRV
  242E'   11 0000*              	LXI	D,FNAME
  2431'   CD 240B'              	CALL	COPY12
  2434'   CD 0000*              	CALL	OPENZ
  2437'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  243A'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  243C'   C8                    	RZ
  243D'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2440'   32 2DA4'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2443'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2444'                         ARGSCN:
  2444'   3A 0080               	LDA	CMDTAIL
  2447'   47                    	MOV	B,A		; B = what is left of the line
  2448'   B7                    	ORA	A
  2449'   C8                    	RZ
  244A'   21 0081               	LXI	H,CMDTAIL+1
  244D'                         AS_TOK:				; at a token, or the blanks before one
  244D'   7E                    	MOV	A,M
  244E'   FE 20                 	CPI	' '
  2450'   C2 2459'              	JNZ	AS_OPT
  2453'   23                    	INX	H
  2454'   05                    	DCR	B
  2455'   C2 244D'              	JNZ	AS_TOK
  2458'   C9                    	RET
  2459'                         AS_OPT:
  2459'   FE 2B                 	CPI	'+'
  245B'   CA 2485'              	JZ	AS_PLS
  245E'   FE 2D                 	CPI	'-'
  2460'   CA 2474'              	JZ	AS_SW
  2463'   FE 2F                 	CPI	'/'
  2465'   CA 2474'              	JZ	AS_SW
  2468'                         AS_SKP:				; not ours (the file name): on to the next one
  2468'   23                    	INX	H
  2469'   05                    	DCR	B
  246A'   C8                    	RZ
  246B'   7E                    	MOV	A,M
  246C'   FE 20                 	CPI	' '
  246E'   C2 2468'              	JNZ	AS_SKP
  2471'   C3 244D'              	JMP	AS_TOK
  2474'                         AS_SW:
  2474'   23                    	INX	H
  2475'   05                    	DCR	B
  2476'   C8                    	RZ
  2477'   7E                    	MOV	A,M
  2478'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  247A'   FE 52                 	CPI	'R'
  247C'   C2 2468'              	JNZ	AS_SKP
  247F'   32 2DA6'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2482'   C3 2468'              	JMP	AS_SKP
  2485'                         AS_PLS:
  2485'   3E 01                 	MVI	A,1
  2487'   32 2DA7'              	STA	PLUSF		; '+' gets the line even with no number on it
  248A'   11 0000*              	LXI	D,PLUSB
  248D'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  248F'   23                    	INX	H		;   line space, so it is taken as '+' alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2490'   05                    	DCR	B
  2491'   CA 24C8'              	JZ	AS_PE
  2494'   7E                    	MOV	A,M
  2495'   FE 30                 	CPI	'0'
  2497'   C2 24AF'              	JNZ	AS_PD
  249A'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  249A'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  249B'   05                    	DCR	B
  249C'   CA 24D0'              	JZ	AS_P1
  249F'   7E                    	MOV	A,M
  24A0'   FE 30                 	CPI	'0'
  24A2'   CA 249A'              	JZ	AS_PZ
  24A5'   FE 31                 	CPI	'1'
  24A7'   DA 24D0'              	JC	AS_P1		; zeros and then no digit at all: line 1
  24AA'   FE 3A                 	CPI	'9'+1
  24AC'   D2 24D0'              	JNC	AS_P1
  24AF'                         AS_PD:				; the digits, as typed
  24AF'   7E                    	MOV	A,M
  24B0'   FE 30                 	CPI	'0'
  24B2'   DA 24C8'              	JC	AS_PE
  24B5'   FE 3A                 	CPI	'9'+1
  24B7'   D2 24C8'              	JNC	AS_PE
  24BA'   79                    	MOV	A,C
  24BB'   B7                    	ORA	A
  24BC'   CA 24D7'              	JZ	AS_POV
  24BF'   0D                    	DCR	C
  24C0'   7E                    	MOV	A,M
  24C1'   12                    	STAX	D
  24C2'   13                    	INX	D
  24C3'   23                    	INX	H
  24C4'   05                    	DCR	B
  24C5'   C2 24AF'              	JNZ	AS_PD
  24C8'                         AS_PE:
  24C8'   AF                    	XRA	A
  24C9'   12                    	STAX	D		; the digits end with a 0
  24CA'   78                    	MOV	A,B
  24CB'   B7                    	ORA	A
  24CC'   C8                    	RZ
  24CD'   C3 244D'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  24D0'                         AS_P1:
  24D0'   3E 31                 	MVI	A,'1'
  24D2'   12                    	STAX	D
  24D3'   13                    	INX	D
  24D4'   C3 24C8'              	JMP	AS_PE
  24D7'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  24D7'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  24DA'   C3 24C8'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  24DD'                         ARGGO:
  24DD'   3A 2DA7'              	LDA	PLUSF
