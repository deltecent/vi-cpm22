  0F7F'   D2 0F84'              	JNC	VPU_4		;   fills the screen)
  0F82'   54                    	MOV	D,H
  0F83'   5D                    	MOV	E,L
  0F84'                         VPU_4:
  0F84'   EB                    	XCHG
  0F85'   C3 1081'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  0F88'                         OVLAP:
  0F88'   32 2E84'              	STA	OVDIR
  0F8B'   3A 0000*              	LDA	NEDIT
  0F8E'   D6 02                 	SUI	2
  0F90'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  0F91'   56                    	MOV	D,M		; D = h1
  0F92'   CD 0FC9'              	CALL	OV_NX
  0F95'   DA 0FC5'              	JC	OV_0
  0F98'   5E                    	MOV	E,M		; E = h2
  0F99'   7A                    	MOV	A,D
  0F9A'   83                    	ADD	E
  0F9B'   57                    	MOV	D,A		; D = h1 + h2
  0F9C'   79                    	MOV	A,C
  0F9D'   BA                    	CMP	D
  0F9E'   DA 0FC5'              	JC	OV_0
  0FA1'   CD 0FC9'              	CALL	OV_NX
  0FA4'   DA 0FC5'              	JC	OV_0
  0FA7'   7B                    	MOV	A,E
  0FA8'   86                    	ADD	M
  0FA9'   5F                    	MOV	E,A		; E = h2 + h3
  0FAA'   79                    	MOV	A,C
  0FAB'   BB                    	CMP	E
  0FAC'   DA 0FC5'              	JC	OV_0
  0FAF'   7A                    	MOV	A,D
  0FB0'   86                    	ADD	M
  0FB1'   57                    	MOV	D,A		; D = h1 + h2 + h3
  0FB2'   CD 0FC9'              	CALL	OV_NX
  0FB5'   DA 0FC2'              	JC	OV_1
  0FB8'   7B                    	MOV	A,E
  0FB9'   86                    	ADD	M		; h2 + h3 + h4
  0FBA'   5F                    	MOV	E,A
  0FBB'   79                    	MOV	A,C
  0FBC'   BB                    	CMP	E
  0FBD'   DA 0FC2'              	JC	OV_1
  0FC0'   BA                    	CMP	D
  0FC1'   D0                    	RNC			; two lines of overlap
  0FC2'                         OV_1:
  0FC2'   79                    	MOV	A,C
  0FC3'   3C                    	INR	A
