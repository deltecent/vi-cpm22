  269E'   00                    EDMODE: DB	EM_CMD
  269F'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  26A1'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  26A2'   00                    MODF:	DB	0		; 1 = unsaved changes
  26A3'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  26A4'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  26A5'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  26A6'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  26A7'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  26A9'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  26AA'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  26AB'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  26AC'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  26AD'   0000                  JKCNT:	DW	0		; j/k: count
  26AF'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  26B1'   0000                  JKMOV:	DW	0		; j: lines moved
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  26B3'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  26B5'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  26B6'   00                    JKLST:	DB	0		; j: last byte of the scan
  26B7'   0000                  JKVC:	DW	0		; j/k landing: screen column
  26B9'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  26BB'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  26BC'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  26BD'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  26BE'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  26BF'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  26C0'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  26C2'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  26C3'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  26C4'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  26C6'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  26C7'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  26C8'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  26C9'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  26CA'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  26CB'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  26CC'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  26CD'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  26CF'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  26D1'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  26D4'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  26D7'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  26DA'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  26DD'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  26DF'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  26E1'   0000                  CNTV:	DW	0		; motion repeat counter
  26E3'   0000                  TTI:	DW	0		; TAILTAB scan index
  26E5'   0000                  WKI:	DW	0		; scan index
  26E7'   0000                  WKN:	DW	0		; cached LOGLEN
  26E9'   0000                  WKTERM: DW	0		; line terminator offset
  26EB'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  26ED'   00                    WKCLS:	DB	0		; word motion: class of the current run
  26EE'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  26EF'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  26F1'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  26F3'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  26F5'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  26F7'   00                    RLLEN:	DB	0		; RDLINE: chars stored
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  26F8'   00                    RLMAX:	DB	0		; RDLINE: capacity
  26F9'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  26FA'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  26FB'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  26FC'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  26FE'   00                    WPROW:	DB	0		; :w -- the cursor's row
  26FF'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2700'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2702'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2704'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2705'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2707'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2709'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  270A'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  270B'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  270C'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  270D'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  270E'   00                    PLUSF:	DB	0		; command line: '+' was given
  270F'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2710'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2711'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2712'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2714'   0000                  YPT:	DW	0		; yy: where the lines came from
  2716'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2718'   0000                  PPT:	DW	0		; p/P: the first line put
  271A'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  271C'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  271D'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  271F'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2720'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2721'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2722'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2723'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2724'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2725'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2726'   0000                  FNDN:	DW	0		; occurrences still to count off
  2728'   0000                  FNDCUR: DW	0		; the cursor it started from
  272A'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  272C'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  272D'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2730'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2733'   0000                  MKN:	DW	0		; ... how long it is
  2735'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2736'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2739'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  273A'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  273B'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  273D'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  273F'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2741'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2743'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2746'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2748'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  274A'   0000                  SCNT:	DW	0		; searches still to do (the count)
  274C'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  274E'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  2750'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2751'   00                    SRNGF:	DB	0		; ex: a line range was given
  2752'   0000                  SRNG1:	DW	0		; ex: its first line
  2754'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2756'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2757'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2758'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2759'   00                    SLCHG:	DB	0		; ':s' this line changed
  275A'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  275C'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  275E'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2760'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2762'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2763'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
