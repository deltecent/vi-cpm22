  0A36'   2A 2F21'              	LHLD	JKN
  0A39'   EB                    	XCHG			; DE = LFs to find
  0A3A'   CD 0000*              	CALL	RGET0
  0A3D'                         JC_SC:
  0A3D'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A40'   DA 0A5F'              	JC	JC_EOF
  0A43'   32 2F28'              	STA	JKLST
  0A46'   FE 0A                 	CPI	LF
  0A48'   C2 0A3D'              	JNZ	JC_SC
  0A4B'   1B                    	DCX	D
  0A4C'   7A                    	MOV	A,D
  0A4D'   B3                    	ORA	E
  0A4E'   C2 0A3D'              	JNZ	JC_SC
  0A51'   2A 2F1F'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A54'   22 2F23'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A57'   3E 01                 	MVI	A,1
  0A59'   32 2F27'              	STA	JKPHN
  0A5C'   C3 0ABA'              	JMP	JC_MV
  0A5F'                         JC_EOF:
  0A5F'   2A 2F21'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A62'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A65'   7C                    	MOV	A,H
  0A66'   B5                    	ORA	L
  0A67'   CA 0A73'              	JZ	JC_AV
  0A6A'   3A 2F28'              	LDA	JKLST
  0A6D'   FE 0A                 	CPI	LF
  0A6F'   C2 0A73'              	JNZ	JC_AV
  0A72'   2B                    	DCX	H
  0A73'                         JC_AV:
  0A73'   22 2F23'              	SHLD	JKMOV
  0A76'   AF                    	XRA	A
  0A77'   32 2F27'              	STA	JKPHN
  0A7A'   C3 0ABA'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0A7D'                         JC_QK:
  0A7D'   22 2F21'              	SHLD	JKN		; N = the count
  0A80'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0A83'   3A 2F21'              	LDA	JKN
  0A86'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0A87'   16 0A                 	MVI	D,LF
  0A89'   04                    	INR	B
  0A8A'   0C                    	INR	C
  0A8B'                         JQ_LP:
  0A8B'   0D                    	DCR	C
  0A8C'   C2 0A93'              	JNZ	JQ_CH
  0A8F'   05                    	DCR	B
  0A90'   CA 0A36'              	JZ	JC_SL
  0A93'                         JQ_CH:
  0A93'   7E                    	MOV	A,M
  0A94'   23                    	INX	H
  0A95'   BA                    	CMP	D
  0A96'   C2 0A8B'              	JNZ	JQ_LP
  0A99'   1D                    	DCR	E
