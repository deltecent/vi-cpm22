  1C68'   6C 69 6E 67           
  1C6C'   20 63 68 61           
  1C70'   72 73 3A 20           
  1C74'   00                    
  1C75'   49 6E 76 61           SNOT:	DB	'Invalid command: ',0
  1C79'   6C 69 64 20           
  1C7D'   63 6F 6D 6D           
  1C81'   61 6E 64 3A           
