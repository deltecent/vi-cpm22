                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDRUN, CMDDIS, QSNAP
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	TOFFV, TLINEV, TCOLV
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	DELLN, SETC0			; BUF.MAC -- WM line kill (dd)
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;============================================================
                                ; MAIN LOOP -- read a key, dispatch by mode, until QUITF.
                                ; The headless harnesses (CMDTST/MOTTST) drive CMDRUN; the on-screen editor
                                ; (VI.MAC) reads the key and repaints itself, calling CMDDIS per key.  Both share
                                ; the one mode-dispatch chokepoint, CMDDIS.
                                ;============================================================
  0000'                         CMDRUN:
  0000'   CD 0000*              	CALL	GETKEY		; B = KT_xxx, C = char / action
  0003'   CD 000E'              	CALL	CMDDIS
  0006'   3A 2333'              	LDA	QUITF
  0009'   B7                    	ORA	A
  000A'   CA 0000'              	JZ	CMDRUN
  000D'   C9                    	RET
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  000E'                         CMDDIS:
  000E'   CD 00E7'              	CALL	DOTPRE
  0011'   CD 0017'              	CALL	CDMODE
  0014'   C3 013E'              	JMP	DOTPOST
  0017'                         CDMODE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0017'   3A 2330'              	LDA	EDMODE
  001A'   FE 01                 	CPI	EM_INS
  001C'   CA 0027'              	JZ	CD_INS
  001F'   FE 02                 	CPI	EM_REP
  0021'   CA 002A'              	JZ	CD_REP
  0024'   C3 002D'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0027'                         CD_INS:
  0027'   C3 16D0'              	JMP	VIINS
  002A'                         CD_REP:
  002A'   C3 1610'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  002D'                         VICMD:
  002D'   78                    	MOV	A,B
  002E'   FE 00                 	CPI	KT_NONE
  0030'   C8                    	RZ			; discarded key
  0031'   FE 01                 	CPI	KT_ACT
  0033'   CA 00B9'              	JZ	VIC_ACT
  0036'   3A 2358'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  0039'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  003B'   CA 1214'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  003E'   79                    	MOV	A,C
  003F'   FE 31                 	CPI	'1'
  0041'   DA 004C'              	JC	VIC_NOTD	; < '1'
  0044'   FE 3A                 	CPI	'9'+1
  0046'   D2 004C'              	JNC	VIC_NOTD	; > '9'
  0049'   C3 005C'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  004C'                         VIC_NOTD:
  004C'   79                    	MOV	A,C
  004D'   FE 30                 	CPI	'0'
  004F'   C2 0084'              	JNZ	VICDSP
  0052'   2A 2331'              	LHLD	CMDCNT
  0055'   7C                    	MOV	A,H
  0056'   B5                    	ORA	L
  0057'   CA 0084'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  005A'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  005C'                         VICDIG:
  005C'   2A 2331'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  005F'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0060'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0061'   29                    	DAD	H		; *2
  0062'   DA 007B'              	JC	VIC_SAT
  0065'   29                    	DAD	H		; *4
  0066'   DA 007B'              	JC	VIC_SAT
  0069'   19                    	DAD	D		; *5
  006A'   DA 007B'              	JC	VIC_SAT
  006D'   29                    	DAD	H		; *10
  006E'   DA 007B'              	JC	VIC_SAT
  0071'   79                    	MOV	A,C
  0072'   D6 30                 	SUI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  0074'   5F                    	MOV	E,A
  0075'   16 00                 	MVI	D,0
  0077'   19                    	DAD	D
  0078'   D2 007E'              	JNC	VIC_CNT
  007B'                         VIC_SAT:
  007B'   21 FFFF               	LXI	H,0FFFFH
  007E'                         VIC_CNT:
  007E'   22 2331'              	SHLD	CMDCNT
  0081'   C3 0507'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0084'                         VICDSP:
  0084'   3A 2358'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0087'   32 2359'              	STA	GSAVE
  008A'   AF                    	XRA	A
  008B'   32 2358'              	STA	GPEND
  008E'   3A 235A'              	LDA	PENDOP
  0091'   32 235B'              	STA	PSAVE
  0094'   AF                    	XRA	A
  0095'   32 235A'              	STA	PENDOP
  0098'   3A 235B'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  009B'   B7                    	ORA	A
  009C'   C2 0DE1'              	JNZ	OPPEND
  009F'   3A 2359'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  00A2'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  00A4'   C2 00AD'              	JNZ	VIC_TB
  00A7'   79                    	MOV	A,C
  00A8'   FE 5A                 	CPI	'Z'
  00AA'   C2 00B3'              	JNZ	VIC_SW
  00AD'                         VIC_TB:
  00AD'   21 2271'              	LXI	H,CMDTAB
  00B0'   C3 00CC'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00B3'                         VIC_SW:
  00B3'   CD 0507'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00B6'   C3 049A'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00B9'                         VIC_ACT:
  00B9'   AF                    	XRA	A		; action key clears all pending state
  00BA'   32 2358'              	STA	GPEND
  00BD'   32 2359'              	STA	GSAVE
  00C0'   32 235A'              	STA	PENDOP
  00C3'   32 235B'              	STA	PSAVE
  00C6'   21 2317'              	LXI	H,ACTTAB
  00C9'   C3 00CC'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00CC'                         VSCANQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CC'   CD 00D8'              	CALL	VSCLK
  00CF'   CA 00B3'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00D2'   E9                    	PCHL
  00D3'                         VSCAN:
  00D3'   CD 00D8'              	CALL	VSCLK
  00D6'   C8                    	RZ			; miss
  00D7'   E9                    	PCHL
  00D8'                         VSCLK:
  00D8'   7E                    VSCAN1: MOV	A,M
  00D9'   B7                    	ORA	A
  00DA'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00DB'   23                    	INX	H
  00DC'   B9                    	CMP	C
  00DD'   5E                    	MOV	E,M
  00DE'   23                    	INX	H
  00DF'   56                    	MOV	D,M
  00E0'   23                    	INX	H
  00E1'   C2 00D8'              	JNZ	VSCAN1
  00E4'   EB                    	XCHG			; HL = the handler
  00E5'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00E6'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00E7'                         DOTPRE:
  00E7'   3A 234F'              	LDA	DOTRPL
  00EA'   B7                    	ORA	A
  00EB'   C0                    	RNZ			; the replay's own keys are not recorded
  00EC'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00ED'   D5                    	PUSH	D
  00EE'   E5                    	PUSH	H
  00EF'   3A 234E'              	LDA	DOTSTA
  00F2'   B7                    	ORA	A
  00F3'   CA 0106'              	JZ	DOTP1
  00F6'   AF                    	XRA	A		; a new command: the recording starts over
  00F7'   32 234E'              	STA	DOTSTA
  00FA'   32 2350'              	STA	DOTOVF
  00FD'   21 0000*              	LXI	H,DOTSCR
  0100'   22 2352'              	SHLD	DOTSP
  0103'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  0106'                         DOTP1:
  0106'   78                    	MOV	A,B
  0107'   FE 00                 	CPI	KT_NONE
  0109'   CA 0132'              	JZ	DOTPX		; a discarded key is not a keystroke
  010C'   FE 01                 	CPI	KT_ACT
  010E'   79                    	MOV	A,C
  010F'   CA 0117'              	JZ	DOTP2
  0112'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0114'   C3 0119'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0117'                         DOTP2:
  0117'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  0119'                         DOTP3:
  0119'   32 2351'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  011C'   47                    	MOV	B,A
  011D'   2A 2352'              	LHLD	DOTSP
  0120'   EB                    	XCHG
  0121'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0124'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0127'   D2 0136'              	JNC	DOTPOV
  012A'   2A 2352'              	LHLD	DOTSP
  012D'   70                    	MOV	M,B
  012E'   23                    	INX	H
  012F'   22 2352'              	SHLD	DOTSP
  0132'                         DOTPX:
  0132'   E1                    	POP	H
  0133'   D1                    	POP	D
  0134'   C1                    	POP	B
  0135'   C9                    	RET
  0136'                         DOTPOV:
  0136'   3E 01                 	MVI	A,1
  0138'   32 2350'              	STA	DOTOVF		; too long to record: give this recording up
  013B'   C3 0132'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  013E'                         DOTPOST:
  013E'   3A 234F'              	LDA	DOTRPL
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ
  0143'   3A 2330'              	LDA	EDMODE
  0146'   B7                    	ORA	A
  0147'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0148'   3A 2358'              	LDA	GPEND
  014B'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  014C'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  014D'   3A 235A'              	LDA	PENDOP
  0150'   B7                    	ORA	A
  0151'   C0                    	RNZ			; an operator still waiting for its motion
  0152'   2A 2331'              	LHLD	CMDCNT
  0155'   7C                    	MOV	A,H
  0156'   B5                    	ORA	L
  0157'   CA 0165'              	JZ	DOTQ1
  015A'   3A 2351'              	LDA	DOTLK		; a digit with the count still up: the command
  015D'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  015F'   DA 0165'              	JC	DOTQ1
  0162'   FE 3A                 	CPI	'9'+1
  0164'   D8                    	RC
  0165'                         DOTQ1:
  0165'   3E 01                 	MVI	A,1
  0167'   32 234E'              	STA	DOTSTA		; the next key starts a new recording
  016A'   3A 234D'              	LDA	DOTCHG
  016D'   B7                    	ORA	A
  016E'   C8                    	RZ			; changed nothing: not a repeatable command
  016F'   AF                    	XRA	A
  0170'   32 234D'              	STA	DOTCHG
  0173'   32 2354'              	STA	DOTLEN
  0176'   3A 2350'              	LDA	DOTOVF
  0179'   B7                    	ORA	A
  017A'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  017B'   2A 2352'              	LHLD	DOTSP
  017E'   11 0000*              	LXI	D,DOTSCR
  0181'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0184'   7D                    	MOV	A,L
  0185'   32 2354'              	STA	DOTLEN
  0188'   B7                    	ORA	A
  0189'   C8                    	RZ
  018A'   4F                    	MOV	C,A
  018B'   06 00                 	MVI	B,0
  018D'   21 0000*              	LXI	H,DOTSCR
  0190'   11 0000*              	LXI	D,DOTBUF
  0193'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0196'                         MARKMOD:
  0196'   CD 02D5'              	CALL	MKDROP		; any mark this edit leaves pointing wrong
  0199'   3E 01                 	MVI	A,1
  019B'   32 2334'              	STA	MODF
  019E'   32 234D'              	STA	DOTCHG
  01A1'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  01A2'                         VC_DOT:
  01A2'   2A 2331'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  01A5'   22 2356'              	SHLD	DOTNCT
  01A8'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01AB'   22 2331'              	SHLD	CMDCNT
  01AE'   3A 2354'              	LDA	DOTLEN
  01B1'   B7                    	ORA	A
  01B2'   CA 020C'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01B5'   AF                    	XRA	A
  01B6'   32 2355'              	STA	DOTIX
  01B9'   2A 2356'              	LHLD	DOTNCT
  01BC'   7C                    	MOV	A,H
  01BD'   B5                    	ORA	L
  01BE'   CA 01DE'              	JZ	DOTGO
  01C1'   22 2331'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01C4'                         DOTSKP:
  01C4'   CD 036B'              	CALL	DOTGET		; ... so step past the digits it recorded
  01C7'   DA 01DE'              	JC	DOTGO
  01CA'   FE 30                 	CPI	'0'
  01CC'   DA 01DE'              	JC	DOTGO
  01CF'   FE 3A                 	CPI	'9'+1
  01D1'   D2 01DE'              	JNC	DOTGO
  01D4'   3A 2355'              	LDA	DOTIX
  01D7'   3C                    	INR	A
  01D8'   32 2355'              	STA	DOTIX
  01DB'   C3 01C4'              	JMP	DOTSKP
  01DE'                         DOTGO:
  01DE'   3E 01                 	MVI	A,1
  01E0'   32 234F'              	STA	DOTRPL
  01E3'                         DOTLP:
  01E3'   CD 036B'              	CALL	DOTGET
  01E6'   DA 0202'              	JC	DOTDN
  01E9'   4F                    	MOV	C,A
  01EA'   06 02                 	MVI	B,KT_CHAR
  01EC'   B7                    	ORA	A
  01ED'   F2 01F5'              	JP	DOTLP2
  01F0'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01F2'   4F                    	MOV	C,A
  01F3'   06 01                 	MVI	B,KT_ACT
  01F5'                         DOTLP2:
  01F5'   3A 2355'              	LDA	DOTIX
  01F8'   3C                    	INR	A
  01F9'   32 2355'              	STA	DOTIX
  01FC'   CD 000E'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01FF'   C3 01E3'              	JMP	DOTLP
  0202'                         DOTDN:
  0202'   AF                    	XRA	A
  0203'   32 234F'              	STA	DOTRPL
  0206'   32 234D'              	STA	DOTCHG		; the '.' is not itself the new last change
  0209'   C3 0528'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  020C'                         DOTBEL:
  020C'   0E 07                 	MVI	C,BEL
  020E'   CD 0000*              	CALL	BCONOU
  0211'   C3 0507'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; A mark is a logical offset plus the PGTOPM the window carried when it was
                                ; set.  It is DROPPED, never shifted, the moment it could no longer point at
                                ; the same text: MKDROP clears it when an edit happens at or before it, and a
                                ; jump refuses when the window has paged since.  That is the decided
                                ; behaviour -- a mark that survived an edit above it would point somewhere
                                ; plausible and wrong, which is worse than one that admits it is gone.
                                ;
                                ; DEVIATION from vim, deliberate and in COMMANDS.md: vim shifts a mark to
                                ; follow the text.  A consequence worth knowing is that '.' after a 'd''a'
                                ; refuses, because the delete drops the very mark the replay would need.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0214'                         MKVAD:
  0214'   16 00                 	MVI	D,0
  0216'   59                    	MOV	E,C
  0217'   21 23B1'              	LXI	H,MKVAL
  021A'   19                    	DAD	D
  021B'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  021C'                         MKCLR:
  021C'   21 23B1'              	LXI	H,MKVAL
  021F'   06 03                 	MVI	B,MKMAX
  0221'   AF                    	XRA	A
  0222'                         MKC_LP:
  0222'   77                    	MOV	M,A
  0223'   23                    	INX	H
  0224'   05                    	DCR	B
  0225'   C2 0222'              	JNZ	MKC_LP
  0228'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  0229'                         MKGETK:
  0229'   3A 234F'              	LDA	DOTRPL
  022C'   B7                    	ORA	A
  022D'   CA 023E'              	JZ	MKG_KB
  0230'   CD 036B'              	CALL	DOTGET		; the recording's next key
  0233'   D8                    	RC
  0234'   4F                    	MOV	C,A
  0235'   3A 2355'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  0238'   3C                    	INR	A
  0239'   32 2355'              	STA	DOTIX
  023C'   B7                    	ORA	A		; CY clear
  023D'   C9                    	RET
  023E'                         MKG_KB:
  023E'   CD 0000*              	CALL	GETKEY
  0241'   78                    	MOV	A,B
  0242'   FE 02                 	CPI	KT_CHAR
  0244'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


  0245'   C0                    	RNZ			; an action key (ESC) cancels the command
  0246'   B7                    	ORA	A		; CY clear
  0247'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0248'                         VC_MK:
  0248'   3E 04                 	MVI	A,PM
  024A'   C3 0254'              	JMP	MKGO
  024D'                         VC_BQ:
  024D'   3E 05                 	MVI	A,PJ
  024F'   C3 0254'              	JMP	MKGO
  0252'                         VC_AQ:
  0252'   3E 06                 	MVI	A,PJL
  0254'                         MKGO:
  0254'   32 23B6'              	STA	MKWHAT
  0257'   CD 0487'              	CALL	MOVCNT		; a count means nothing on any of the three
  025A'   CD 0229'              	CALL	MKGETK		; the key that names the mark
  025D'   DA 02B5'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist; any other key drops the
                                ;whole thing, as vim's 'Z{other}' does.
  0260'                         MKOP:
  0260'   79                    	MOV	A,C
  0261'   D6 61                 	SUI	'a'
  0263'   FE 03                 	CPI	MKMAX
  0265'   D2 02B5'              	JNC	MKBAD		; not a mark letter: nothing happens
  0268'   4F                    	MOV	C,A		; C = the mark's index
  0269'   87                    	ADD	A
  026A'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  026B'   5F                    	MOV	E,A
  026C'   16 00                 	MVI	D,0
  026E'   21 0000*              	LXI	H,MKTAB
  0271'   19                    	DAD	D		; HL -> this mark's slot
  0272'   3A 23B6'              	LDA	MKWHAT
  0275'   FE 04                 	CPI	PM
  0277'   CA 02BC'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark.  It refuses, with the bell, when the mark was
                                ;never set or when the window has paged away from under it.
  027A'                         MKJMP:
  027A'   E5                    	PUSH	H
  027B'   CD 0214'              	CALL	MKVAD
  027E'   7E                    	MOV	A,M
  027F'   E1                    	POP	H
  0280'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0281'   CA 02B5'              	JZ	MKBAD		; never set
  0284'   5E                    	MOV	E,M
  0285'   23                    	INX	H
  0286'   56                    	MOV	D,M		; DE = the offset it holds
  0287'   23                    	INX	H
  0288'   7E                    	MOV	A,M
  0289'   23                    	INX	H
  028A'   66                    	MOV	H,M
  028B'   6F                    	MOV	L,A		; HL = the window signature it was set under
  028C'   D5                    	PUSH	D
  028D'   EB                    	XCHG			; DE = that signature
  028E'   2A 0000*              	LHLD	PGTOPM
  0291'   7D                    	MOV	A,L
  0292'   BB                    	CMP	E
  0293'   C2 02AF'              	JNZ	MKSTAL
  0296'   7C                    	MOV	A,H
  0297'   BA                    	CMP	D
  0298'   C2 02AF'              	JNZ	MKSTAL
  029B'   3A 23B6'              	LDA	MKWHAT		; decided BEFORE the GOTO, so no register of
  029E'   FE 06                 	CPI	PJL		;   ours has to survive a BUF primitive
  02A0'   CA 02A8'              	JZ	MKJ_GO		; ''': GPKEEP is 0, so GPLACE finds the first
  02A3'   3E 01                 	MVI	A,1		;   non-blank
  02A5'   32 23B0'              	STA	GPKEEP		; '`': land on the column it was set at
  02A8'                         MKJ_GO:
  02A8'   E1                    	POP	H		; HL = the offset
  02A9'   CD 0000*              	CALL	GOTO
  02AC'   C3 0CF6'              	JMP	GPLACE		; (which sets LNDLT itself)
  02AF'                         MKSTAL:
  02AF'   E1                    	POP	H		; the window paged: the mark is gone for good
  02B0'   CD 0214'              	CALL	MKVAD
  02B3'   36 00                 	MVI	M,0
                                				; ... and fall into MKBAD
                                
                                ;MKBAD -- this mark will not answer.  An operator running the motion is
                                ;cancelled whole: PSAVE is what OPPEND's tail reads to decide whether to open
                                ;an insert, so clearing it stops a "c`z" opening one over a span of nothing.
  02B5'                         MKBAD:
  02B5'   AF                    	XRA	A
  02B6'   32 235B'              	STA	PSAVE
  02B9'   C3 020C'              	JMP	DOTBEL
                                
                                ;MKSET -- remember where the cursor is, and which window it is in.
  02BC'                         MKSET:
  02BC'   E5                    	PUSH	H
  02BD'   CD 0000*              	CALL	CUROFF		; HL = the cursor's logical offset
  02C0'   EB                    	XCHG
  02C1'   2A 0000*              	LHLD	PGTOPM
  02C4'   E3                    	XTHL			; HL = the slot, (SP) = the signature
  02C5'   73                    	MOV	M,E
  02C6'   23                    	INX	H
  02C7'   72                    	MOV	M,D
  02C8'   23                    	INX	H
  02C9'   D1                    	POP	D
  02CA'   73                    	MOV	M,E
  02CB'   23                    	INX	H
  02CC'   72                    	MOV	M,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02CD'   CD 0214'              	CALL	MKVAD
  02D0'   36 01                 	MVI	M,1		; ... and the mark is live
  02D2'   C3 0507'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKDROP -- an edit is happening at the cursor: drop every mark it could have
                                ;left pointing at different text.  A mark BEFORE the edit still names what it
                                ;named; one at or after it does not, because the text moved under it.  Called
                                ;from MARKMOD, so it must come back with every register as it found it.
  02D5'                         MKDROP:
  02D5'   F5                    	PUSH	PSW
  02D6'   3A 23B7'              	LDA	MKHOLD		; a yank takes its lines out and puts them back
  02D9'   B7                    	ORA	A		;   unchanged (VY_YY): the text every mark points
  02DA'   C2 030F'              	JNZ	MKD_HL		;   into is still there, so none of them goes
  02DD'   C5                    	PUSH	B
  02DE'   D5                    	PUSH	D
  02DF'   E5                    	PUSH	H
  02E0'   CD 0000*              	CALL	CUROFF		; HL = where the edit is (CUROFF clobbers DE)
  02E3'   22 23B4'              	SHLD	MKEDIT
  02E6'   21 23B1'              	LXI	H,MKVAL
  02E9'   11 0000*              	LXI	D,MKTAB
  02EC'   06 03                 	MVI	B,MKMAX
  02EE'                         MKD_LP:
  02EE'   7E                    	MOV	A,M
  02EF'   B7                    	ORA	A
  02F0'   CA 0303'              	JZ	MKD_NX		; that mark is not set: nothing to drop
  02F3'   E5                    	PUSH	H
  02F4'   2A 23B4'              	LHLD	MKEDIT
  02F7'   1A                    	LDAX	D		; the mark's offset, low
  02F8'   95                    	SUB	L
  02F9'   13                    	INX	D
  02FA'   1A                    	LDAX	D		; ... and high (neither INX nor LDAX touch CY)
  02FB'   1B                    	DCX	D
  02FC'   9C                    	SBB	H		; CY iff the mark is BEFORE the edit
  02FD'   E1                    	POP	H
  02FE'   DA 0303'              	JC	MKD_NX
  0301'   36 00                 	MVI	M,0		; at it or after it: the mark is dropped
  0303'                         MKD_NX:
  0303'   23                    	INX	H
  0304'   13                    	INX	D
  0305'   13                    	INX	D
  0306'   13                    	INX	D
  0307'   13                    	INX	D
  0308'   05                    	DCR	B
  0309'   C2 02EE'              	JNZ	MKD_LP
  030C'   E1                    	POP	H
  030D'   D1                    	POP	D
  030E'   C1                    	POP	B
  030F'                         MKD_HL:
  030F'   F1                    	POP	PSW
  0310'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0311'                         VC_UNDO:
  0311'   21 0000               	LXI	H,0
  0314'   22 2331'              	SHLD	CMDCNT
  0317'   CD 0000*              	CALL	UNDO
  031A'   DA 034E'              	JC	UNDNO
  031D'   2A 0000*              	LHLD	UNDCUR
  0320'   CD 0334'              	CALL	UCLAMP		; vi never sits on a line terminator
  0323'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0326'   CD 02D5'              	CALL	MKDROP		; the undo moved text back under any mark past it
  0329'   3E 01                 	MVI	A,1
  032B'   32 2334'              	STA	MODF		; undone past a ':w' still differs from the file
  032E'   CD 067A'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0331'   C3 0528'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  0334'                         UCLAMP:
  0334'   E5                    	PUSH	H
  0335'   CD 105F'              	CALL	CEND		; HL = the line's content end
  0338'   D1                    	POP	D		; DE = the offset wanted
  0339'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  033C'   D2 0341'              	JNC	UCL_BK
  033F'   EB                    	XCHG
  0340'   C9                    	RET
  0341'                         UCL_BK:
  0341'   E5                    	PUSH	H		; the content end
  0342'   EB                    	XCHG			; HL = the offset wanted
  0343'   CD 03EB'              	CALL	BOL
  0346'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0347'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  034A'   EB                    	XCHG			; HL = the content end
  034B'   C8                    	RZ
  034C'   2B                    	DCX	H		; ... its last character
  034D'   C9                    	RET
  034E'                         UNDNO:
  034E'   3A 0000*              	LDA	UNDWHY
  0351'   B7                    	ORA	A
  0352'   CA 0363'              	JZ	UNDBEL
  0355'   21 1CB6'              	LXI	H,SUNDW		; the change has paged away: say so
  0358'   FE 01                 	CPI	1
  035A'   CA 1BFD'              	JZ	EXERR
  035D'   21 1CD8'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0360'   C3 1BFD'              	JMP	EXERR
  0363'                         UNDBEL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0363'   0E 07                 	MVI	C,BEL
  0365'   CD 0000*              	CALL	BCONOU
  0368'   C3 0507'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  036B'                         DOTGET:
  036B'   3A 2355'              	LDA	DOTIX
  036E'   5F                    	MOV	E,A
  036F'   3A 2354'              	LDA	DOTLEN
  0372'   BB                    	CMP	E
  0373'   CA 037F'              	JZ	DOTGEF
  0376'   16 00                 	MVI	D,0
  0378'   21 0000*              	LXI	H,DOTBUF
  037B'   19                    	DAD	D
  037C'   7E                    	MOV	A,M
  037D'   B7                    	ORA	A		; CY clear: a key was returned
  037E'   C9                    	RET
  037F'                         DOTGEF:
  037F'   37                    	STC
  0380'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  0381'                         GOSET:
  0381'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0384'                         SETGL:
  0384'   CD 0CB8'              	CALL	ZSAVE
  0387'   21 0000               	LXI	H,0
  038A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  038D'   E5                    	PUSH	H
  038E'   CD 0CCB'              	CALL	ZREST
  0391'   E1                    	POP	H
  0392'   E5                    	PUSH	H
  0393'   CD 0493'              	CALL	GBSUB		; HL = bytes to the cursor
  0396'   44                    	MOV	B,H
  0397'   4D                    	MOV	C,L
  0398'   E1                    	POP	H		; HL = the line's start
  0399'   11 0000               	LXI	D,0		; DE = screen column
  039C'                         SG_LP:
  039C'   78                    	MOV	A,B
  039D'   B1                    	ORA	C
  039E'   CA 03B3'              	JZ	SG_CUR
  03A1'   7E                    	MOV	A,M
  03A2'   23                    	INX	H
  03A3'   0B                    	DCX	B
  03A4'   E5                    	PUSH	H
  03A5'   6B                    	MOV	L,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03A6'   CD 03D8'              	CALL	CWID
  03A9'   E1                    	POP	H
  03AA'   83                    	ADD	E
  03AB'   5F                    	MOV	E,A
  03AC'   D2 039C'              	JNC	SG_LP
  03AF'   14                    	INR	D
  03B0'   C3 039C'              	JMP	SG_LP
  03B3'                         SG_CUR:
  03B3'   2A 0000*              	LHLD	TXTEND
  03B6'   D5                    	PUSH	D
  03B7'   EB                    	XCHG
  03B8'   2A 0000*              	LHLD	GAPEND
  03BB'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  03BE'   D1                    	POP	D
  03BF'   CA 03D3'              	JZ	SG_SET
  03C2'   7E                    	MOV	A,M
  03C3'   FE 09                 	CPI	TAB
  03C5'   C2 03D3'              	JNZ	SG_SET
  03C8'   6B                    	MOV	L,E
  03C9'   CD 03D8'              	CALL	CWID
  03CC'   3D                    	DCR	A		; the TAB's last column
  03CD'   83                    	ADD	E
  03CE'   5F                    	MOV	E,A
  03CF'   D2 03D3'              	JNC	SG_SET
  03D2'   14                    	INR	D
  03D3'                         SG_SET:
  03D3'   EB                    	XCHG
  03D4'   22 2339'              	SHLD	GOALCOL
  03D7'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  03D8'                         CWID:
  03D8'   FE 0D                 	CPI	CR
  03DA'   CA 03E9'              	JZ	CW_0
  03DD'   FE 09                 	CPI	TAB
  03DF'   3E 01                 	MVI	A,1
  03E1'   C0                    	RNZ
  03E2'   7D                    	MOV	A,L
  03E3'   E6 07                 	ANI	TABWID-1
  03E5'   2F                    	CMA
  03E6'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  03E8'   C9                    	RET
  03E9'                         CW_0:
  03E9'   AF                    	XRA	A
  03EA'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  03EB'                         BOL:
  03EB'                         BOL_LP:
  03EB'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  03EC'   B5                    	ORA	L
  03ED'   C8                    	RZ			; at 0
  03EE'   2B                    	DCX	H		; look at off-1
  03EF'   E5                    	PUSH	H
  03F0'   CD 0000*              	CALL	CHARAT
  03F3'   E1                    	POP	H		; HL = off-1
  03F4'   FE 0A                 	CPI	LF
  03F6'   CA 03FC'              	JZ	BOL_DN
  03F9'   C3 03EB'              	JMP	BOL_LP
  03FC'                         BOL_DN:
  03FC'   23                    	INX	H		; line starts just after the LF
  03FD'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  03FE'                         EOLNL:
  03FE'   E5                    	PUSH	H
  03FF'   CD 0000*              	CALL	LOGLEN
  0402'   22 236D'              	SHLD	WKN
  0405'   E1                    	POP	H
  0406'                         ENL_LP:
  0406'   EB                    	XCHG			; DE = i
  0407'   2A 236D'              	LHLD	WKN
  040A'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  040D'   EB                    	XCHG			; HL = i, DE = n
  040E'   D2 041F'              	JNC	ENL_DN		; i >= n
  0411'   E5                    	PUSH	H
  0412'   CD 0000*              	CALL	CHARAT
  0415'   E1                    	POP	H
  0416'   FE 0A                 	CPI	LF
  0418'   CA 041F'              	JZ	ENL_DN
  041B'   23                    	INX	H
  041C'   C3 0406'              	JMP	ENL_LP
  041F'                         ENL_DN:
  041F'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0420'                         NLSTART:
  0420'   CD 03FE'              	CALL	EOLNL
  0423'   E5                    	PUSH	H
  0424'   CD 0000*              	CALL	LOGLEN
  0427'   D1                    	POP	D		; DE = eol result
  0428'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  042B'   CA 0431'              	JZ	NLS_DN		; no next line
  042E'   EB                    	XCHG			; HL = eol
  042F'   23                    	INX	H
  0430'   C9                    	RET
  0431'                         NLS_DN:
  0431'   C9                    	RET			; HL = LOGLEN
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0432'                         EOLC:
  0432'   E5                    	PUSH	H
  0433'   CD 03FE'              	CALL	EOLNL
  0436'   22 2371'              	SHLD	WKTERM
  0439'   E1                    	POP	H
  043A'   CD 03EB'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  043D'   22 2373'              	SHLD	WKBOL
  0440'   2A 2371'              	LHLD	WKTERM
  0443'   EB                    	XCHG			; DE = term
  0444'   2A 2373'              	LHLD	WKBOL
  0447'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  044A'   CA 0469'              	JZ	EOLC_MT
  044D'   EB                    	XCHG			; HL = term
  044E'   2B                    	DCX	H		; term-1
  044F'   E5                    	PUSH	H
  0450'   CD 0000*              	CALL	CHARAT
  0453'   E1                    	POP	H		; HL = term-1
  0454'   FE 0D                 	CPI	CR
  0456'   CA 045C'              	JZ	EOLC_CR		; content ends at term-1
  0459'   C3 045D'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  045C'                         EOLC_CR:
  045C'   2B                    	DCX	H		; last = (term-1) - 1
  045D'                         EOLC_LS:
  045D'   EB                    	XCHG			; DE = last
  045E'   2A 2373'              	LHLD	WKBOL
  0461'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0464'   DA 0469'              	JC	EOLC_MT
  0467'   EB                    	XCHG			; HL = last
  0468'   C9                    	RET
  0469'                         EOLC_MT:
  0469'   2A 2373'              	LHLD	WKBOL
  046C'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  046D'                         COL:
  046D'   E5                    	PUSH	H
  046E'   CD 03EB'              	CALL	BOL
  0471'   D1                    	POP	D		; DE = off
  0472'   EB                    	XCHG			; HL = off, DE = bol
  0473'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0476'                         ATENDQ:
  0476'   CD 0000*              	CALL	CUROFF
  0479'   E5                    	PUSH	H
  047A'   CD 0000*              	CALL	LOGLEN
  047D'   D1                    	POP	D		; DE = cur
  047E'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0481'                         CURCHR:
  0481'   CD 0000*              	CALL	CUROFF
  0484'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0487'                         MOVCNT:
  0487'   CD 0507'              	CALL	SETMOV
  048A'   C3 049A'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  048D'                         CNTOFF:
  048D'   CD 049A'              	CALL	GETCNT
  0490'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0493'                         GBSUB:
  0493'   EB                    	XCHG
  0494'   2A 0000*              	LHLD	GAPBEG
  0497'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  049A'                         GETCNT:
  049A'   2A 2331'              	LHLD	CMDCNT
  049D'   7C                    	MOV	A,H
  049E'   B5                    	ORA	L
  049F'   C2 04A6'              	JNZ	GC_HAVE
  04A2'   21 0001               	LXI	H,1
  04A5'   C9                    	RET
  04A6'                         GC_HAVE:
  04A6'   E5                    	PUSH	H
  04A7'   21 0000               	LXI	H,0
  04AA'   22 2331'              	SHLD	CMDCNT
  04AD'   E1                    	POP	H
  04AE'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  04AF'                         CNTTST:				; WM 1175
  04AF'   E5                    	PUSH	H
  04B0'   2A 2331'              	LHLD	CMDCNT
  04B3'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  04B6'   B4                    	ORA	H
  04B7'   B5                    	ORA	L
  04B8'   E1                    	POP	H
  04B9'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  04BC'                         CLASSF:
  04BC'   47                    	MOV	B,A
  04BD'   FE 20                 	CPI	' '
  04BF'   CA 04FF'              	JZ	CLS0
  04C2'   FE 09                 	CPI	TAB
  04C4'   CA 04FF'              	JZ	CLS0
  04C7'   FE 0A                 	CPI	LF
  04C9'   CA 04FF'              	JZ	CLS0
  04CC'   FE 0D                 	CPI	CR
  04CE'   CA 04FF'              	JZ	CLS0
  04D1'   3A 233B'              	LDA	WBIG
  04D4'   B7                    	ORA	A
  04D5'   C2 0501'              	JNZ	CLS1
  04D8'   78                    	MOV	A,B
  04D9'   FE 5F                 	CPI	'_'
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04DB'   CA 0501'              	JZ	CLS1
  04DE'   FE 30                 	CPI	'0'
  04E0'   DA 0504'              	JC	CLS2
  04E3'   FE 3A                 	CPI	'9'+1
  04E5'   DA 0501'              	JC	CLS1
  04E8'   FE 41                 	CPI	'A'
  04EA'   DA 0504'              	JC	CLS2
  04ED'   FE 5B                 	CPI	'Z'+1
  04EF'   DA 0501'              	JC	CLS1
  04F2'   FE 61                 	CPI	'a'
  04F4'   DA 0504'              	JC	CLS2
  04F7'   FE 7B                 	CPI	'z'+1
  04F9'   DA 0501'              	JC	CLS1
  04FC'   C3 0504'              	JMP	CLS2
  04FF'   AF                    CLS0:	XRA	A
  0500'   C9                    	RET
  0501'   3E 01                 CLS1:	MVI	A,1
  0503'   C9                    	RET
  0504'   3E 02                 CLS2:	MVI	A,2
  0506'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0507'                         SETMOV:
  0507'   3E 01                 	MVI	A,R_MOVE
  0509'   32 2335'              	STA	RINTENT
  050C'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  050D'                         SETLIN:
  050D'   3E 02                 	MVI	A,R_LINE
  050F'   32 2335'              	STA	RINTENT
  0512'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0513'                         SETILN:
  0513'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0515'   32 2336'              	STA	ILN		; one line, unless a put overwrites it below
  0518'   3E 05                 	MVI	A,R_ILIN
  051A'   32 2335'              	STA	RINTENT
  051D'   AF                    	XRA	A
  051E'   32 2338'              	STA	ILABOV		; the row above the opened ones is untouched
  0521'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0522'                         SETJON:
  0522'   3E 06                 	MVI	A,R_JOIN
  0524'   32 2335'              	STA	RINTENT
  0527'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  0528'                         SETFUL:
  0528'   3E 00                 	MVI	A,R_FULL
  052A'   32 2335'              	STA	RINTENT
  052D'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  052E'                         TAILTAB:
  052E'   CD 0000*              	CALL	CUROFF
  0531'   22 2369'              	SHLD	TTI
  0534'                         TT_LP:
  0534'   2A 2369'              	LHLD	TTI
  0537'   EB                    	XCHG			; DE = TTI
  0538'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  053B'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  053E'   D2 055E'              	JNC	TT_NO		; reached end of text -> no tab
  0541'   2A 2369'              	LHLD	TTI
  0544'   CD 0000*              	CALL	CHARAT
  0547'   FE 0A                 	CPI	LF
  0549'   CA 055E'              	JZ	TT_NO		; end of line -> no tab
  054C'   FE 09                 	CPI	TAB
  054E'   CA 055B'              	JZ	TT_YES
  0551'   2A 2369'              	LHLD	TTI
  0554'   23                    	INX	H
  0555'   22 2369'              	SHLD	TTI
  0558'   C3 0534'              	JMP	TT_LP
  055B'                         TT_YES:
  055B'   3E 01                 	MVI	A,1
  055D'   C9                    	RET
  055E'                         TT_NO:
  055E'   AF                    	XRA	A
  055F'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0560'                         VC_H:
  0560'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0563'   22 2367'              	SHLD	CNTV
  0566'                         VCH_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  0566'   2A 2367'              	LHLD	CNTV
  0569'   7C                    	MOV	A,H
  056A'   B5                    	ORA	L
  056B'   C8                    	RZ
  056C'   2B                    	DCX	H
  056D'   22 2367'              	SHLD	CNTV
  0570'   CD 0576'              	CALL	HSTEP
  0573'   C3 0566'              	JMP	VCH_LP
  0576'                         HSTEP:
  0576'   CD 0000*              	CALL	CUROFF		; HL = cur
  0579'   7C                    	MOV	A,H
  057A'   B5                    	ORA	L
  057B'   C8                    	RZ			; at 0
  057C'   E5                    	PUSH	H
  057D'   CD 03EB'              	CALL	BOL		; HL = bol
  0580'   D1                    	POP	D		; DE = cur
  0581'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  0584'   C8                    	RZ			; at BOL, cannot go left
  0585'   EB                    	XCHG			; HL = cur
  0586'   2B                    	DCX	H
  0587'   C3 0381'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  058A'                         VC_L:
  058A'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  058D'   22 2367'              	SHLD	CNTV
  0590'                         VCL_LP:
  0590'   2A 2367'              	LHLD	CNTV
  0593'   7C                    	MOV	A,H
  0594'   B5                    	ORA	L
  0595'   C8                    	RZ
  0596'   2B                    	DCX	H
  0597'   22 2367'              	SHLD	CNTV
  059A'   CD 05A0'              	CALL	LSTEP
  059D'   C3 0590'              	JMP	VCL_LP
  05A0'                         LSTEP:
  05A0'   CD 0000*              	CALL	CUROFF		; HL = cur
  05A3'   E5                    	PUSH	H
  05A4'   CD 0432'              	CALL	EOLC		; HL = eolc
  05A7'   D1                    	POP	D		; DE = cur
  05A8'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  05AB'   D0                    	RNC			; cur >= eolc, cannot go right
  05AC'   EB                    	XCHG			; HL = cur
  05AD'   23                    	INX	H
  05AE'   C3 0381'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  05B1'                         VC_0:
  05B1'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  05B4'   CD 05BE'              	CALL	LNSTRT
  05B7'   21 0000               	LXI	H,0
  05BA'   22 2339'              	SHLD	GOALCOL
  05BD'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05BE'                         LNSTRT:
  05BE'   CD 0CB8'              	CALL	ZSAVE
  05C1'   21 0000               	LXI	H,0
  05C4'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  05C7'   E5                    	PUSH	H
  05C8'   CD 0CCB'              	CALL	ZREST
  05CB'   E1                    	POP	H
  05CC'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  05CF'                         VC_CRT:
  05CF'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  05D2'   C3 05D5'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  05D5'                         FNBLNK:
  05D5'   CD 05BE'              	CALL	LNSTRT
  05D8'   CD 0000*              	CALL	RGET0
  05DB'   11 0000               	LXI	D,0		; DE = blanks skipped
  05DE'                         FN_LP:
  05DE'   CD 0000*              	CALL	RDGET
  05E1'   DA 0604'              	JC	FN_GO		; the end of the file
  05E4'   FE 20                 	CPI	' '
  05E6'   CA 05EE'              	JZ	FN_WH
  05E9'   FE 09                 	CPI	TAB
  05EB'   C2 0604'              	JNZ	FN_GO		; a non-blank, or the line's end
  05EE'                         FN_WH:
  05EE'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  05F1'   DA 0604'              	JC	FN_GO
  05F4'   FE 0D                 	CPI	CR
  05F6'   CA 0604'              	JZ	FN_GO
  05F9'   FE 0A                 	CPI	LF
  05FB'   CA 0604'              	JZ	FN_GO
  05FE'   2B                    	DCX	H		; not yet: read that char again
  05FF'   03                    	INX	B
  0600'   13                    	INX	D
  0601'   C3 05DE'              	JMP	FN_LP
  0604'                         FN_GO:
  0604'   D5                    	PUSH	D
  0605'   CD 0000*              	CALL	CUROFF
  0608'   D1                    	POP	D
  0609'   19                    	DAD	D
  060A'   C3 0381'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  060D'                         VC_EOL:
  060D'   CD 0507'              	CALL	SETMOV
  0610'   21 FFFF               	LXI	H,0FFFFH
  0613'   22 2339'              	SHLD	GOALCOL
  0616'   CD 049A'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0619'   2B                    	DCX	H		; count-1
  061A'   7C                    	MOV	A,H
  061B'   B5                    	ORA	L
  061C'   CA 062B'              	JZ	VEOL_0
  061F'   E5                    	PUSH	H
  0620'   CD 0640'              	CALL	ONLAST
  0623'   E1                    	POP	H
  0624'   D8                    	RC			; the last line: no move (vim)
  0625'   CD 0683'              	CALL	JCORE
  0628'   C3 07D2'              	JMP	JKLAND
  062B'                         VEOL_0:
  062B'   CD 05BE'              	CALL	LNSTRT
  062E'   C3 07D2'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0631'                         VC_CR:
  0631'   CD 0487'              	CALL	MOVCNT		; a cursor motion, and its count
  0634'   E5                    	PUSH	H
  0635'   CD 0640'              	CALL	ONLAST
  0638'   E1                    	POP	H
  0639'   D8                    	RC
  063A'   CD 0683'              	CALL	JCORE
  063D'   C3 05D5'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0640'                         ONLAST:
  0640'   CD 0000*              	CALL	RGET0
  0643'                         OL_LP:
  0643'   CD 0000*              	CALL	RDGET
  0646'   D8                    	RC			; the file ends on this line
  0647'   FE 0A                 	CPI	LF
  0649'   C2 0643'              	JNZ	OL_LP
  064C'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  064F'                         VC_J:
  064F'   CD 0507'              	CALL	SETMOV
  0652'   CD 066D'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0655'   CD 049A'              	CALL	GETCNT		; HL = count
  0658'   CD 0683'              	CALL	JCORE
  065B'   C3 07D2'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  065E'                         VC_K:
  065E'   CD 0507'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0661'   CD 066D'              	CALL	GLCHK
  0664'   CD 049A'              	CALL	GETCNT
  0667'   CD 0720'              	CALL	KCORE
  066A'   C3 07D2'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  066D'                         GLCHK:
  066D'   2A 2339'              	LHLD	GOALCOL
  0670'   7C                    	MOV	A,H
  0671'   3C                    	INR	A
  0672'   C0                    	RNZ
  0673'   7D                    	MOV	A,L
  0674'   FE FE                 	CPI	0FEH
  0676'   C0                    	RNZ
  0677'   C3 0384'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  067A'                         GLSTAL:
  067A'   E5                    	PUSH	H
  067B'   21 FFFE               	LXI	H,0FFFEH
  067E'   22 2339'              	SHLD	GOALCOL
  0681'   E1                    	POP	H
  0682'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0683'                         JCORE:
  0683'   7C                    	MOV	A,H
  0684'   B5                    	ORA	L
  0685'   C8                    	RZ
  0686'   22 233F'              	SHLD	JKCNT
  0689'   CD 0A99'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  068C'   47                    	MOV	B,A
  068D'   3A 0000*              	LDA	NEDIT
  0690'   3D                    	DCR	A
  0691'   90                    	SUB	B
  0692'   5F                    	MOV	E,A
  0693'   16 00                 	MVI	D,0
  0695'   3A 0000*              	LDA	NEDIT
  0698'   6F                    	MOV	L,A
  0699'   26 00                 	MVI	H,0
  069B'   19                    	DAD	D
  069C'   EB                    	XCHG			; DE = limit
  069D'   2A 233F'              	LHLD	JKCNT
  06A0'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  06A3'   D2 06A7'              	JNC	JC_N
  06A6'   EB                    	XCHG			; HL = limit
  06A7'                         JC_N:
  06A7'   22 2341'              	SHLD	JKN		; N = min(count, limit)
  06AA'   EB                    	XCHG			; DE = LFs to find
  06AB'   CD 0000*              	CALL	RGET0
  06AE'                         JC_SC:
  06AE'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  06B1'   DA 06D0'              	JC	JC_EOF
  06B4'   32 2348'              	STA	JKLST
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B7'   FE 0A                 	CPI	LF
  06B9'   C2 06AE'              	JNZ	JC_SC
  06BC'   1B                    	DCX	D
  06BD'   7A                    	MOV	A,D
  06BE'   B3                    	ORA	E
  06BF'   C2 06AE'              	JNZ	JC_SC
  06C2'   2A 233F'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  06C5'   22 2343'              	SHLD	JKMOV		;   one if the last LF found ends the file
  06C8'   3E 01                 	MVI	A,1
  06CA'   32 2347'              	STA	JKPHN
  06CD'   C3 06EB'              	JMP	JC_MV
  06D0'                         JC_EOF:
  06D0'   2A 2341'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  06D3'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  06D6'   7C                    	MOV	A,H
  06D7'   B5                    	ORA	L
  06D8'   CA 06E4'              	JZ	JC_AV
  06DB'   3A 2348'              	LDA	JKLST
  06DE'   FE 0A                 	CPI	LF
  06E0'   C2 06E4'              	JNZ	JC_AV
  06E3'   2B                    	DCX	H
  06E4'                         JC_AV:
  06E4'   22 2343'              	SHLD	JKMOV
  06E7'   AF                    	XRA	A
  06E8'   32 2347'              	STA	JKPHN
  06EB'                         JC_MV:
  06EB'   2A 233F'              	LHLD	JKCNT
  06EE'   AF                    	XRA	A
  06EF'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  06F2'   CD 07B1'              	CALL	ATEOF
  06F5'   D2 0709'              	JNC	JC_DN
  06F8'   CD 07B7'              	CALL	LASTLN		; ran past the last line: back onto it
  06FB'   3A 2347'              	LDA	JKPHN
  06FE'   B7                    	ORA	A
  06FF'   CA 0709'              	JZ	JC_DN
  0702'   2A 2343'              	LHLD	JKMOV
  0705'   2B                    	DCX	H
  0706'   22 2343'              	SHLD	JKMOV
  0709'                         JC_DN:
  0709'   2A 2341'              	LHLD	JKN		; LNDLT += min(moved, N)
  070C'   EB                    	XCHG
  070D'   2A 2343'              	LHLD	JKMOV
  0710'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0713'   D2 0717'              	JNC	JC_AD
  0716'   EB                    	XCHG
  0717'                         JC_AD:
  0717'   EB                    	XCHG			; DE = lines moved
  0718'   2A 0000*              	LHLD	LNDLT
  071B'   19                    	DAD	D
  071C'   22 0000*              	SHLD	LNDLT
  071F'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0720'                         KCORE:
  0720'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  0721'   B5                    	ORA	L
  0722'   C8                    	RZ
  0723'   22 233F'              	SHLD	JKCNT
  0726'   CD 0A99'              	CALL	CURRW		; limit = row + NEDIT
  0729'   5F                    	MOV	E,A
  072A'   16 00                 	MVI	D,0
  072C'   3A 0000*              	LDA	NEDIT
  072F'   6F                    	MOV	L,A
  0730'   26 00                 	MVI	H,0
  0732'   19                    	DAD	D
  0733'   EB                    	XCHG			; DE = limit
  0734'   2A 233F'              	LHLD	JKCNT
  0737'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  073A'   D2 073E'              	JNC	KC_N
  073D'   EB                    	XCHG			; HL = limit
  073E'                         KC_N:
  073E'   22 2341'              	SHLD	JKN		; N = min(count, limit)
  0741'   EB                    	XCHG			; DE = LFs to find
  0742'   21 0000               	LXI	H,0
  0745'   22 2345'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0748'                         KC_ED:
  0748'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0749'   2A 2345'              	LHLD	JKBK
  074C'   CD 0493'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  074F'   E5                    	PUSH	H
  0750'   EB                    	XCHG
  0751'   2A 0000*              	LHLD	TXTBEG
  0754'   EB                    	XCHG
  0755'   CD 0000*              	CALL	SUBHD
  0758'   44                    	MOV	B,H
  0759'   4D                    	MOV	C,L
  075A'   E1                    	POP	H
  075B'   D1                    	POP	D
  075C'                         KC_SC:
  075C'   78                    	MOV	A,B
  075D'   B1                    	ORA	C
  075E'   CA 0775'              	JZ	KC_TB
  0761'   2B                    	DCX	H
  0762'   0B                    	DCX	B
  0763'   7E                    	MOV	A,M
  0764'   FE 0A                 	CPI	LF
  0766'   C2 075C'              	JNZ	KC_SC
  0769'   1B                    	DCX	D
  076A'   7A                    	MOV	A,D
  076B'   B3                    	ORA	E
  076C'   C2 075C'              	JNZ	KC_SC
  076F'   2A 233F'              	LHLD	JKCNT		; N lines above: the move is count lines
  0772'   C3 0795'              	JMP	KC_MV
  0775'                         KC_TB:
  0775'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0776'   CD 0493'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0779'   22 2345'              	SHLD	JKBK
  077C'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  077F'   7C                    	MOV	A,H
  0780'   B5                    	ORA	L
  0781'   CA 078E'              	JZ	KC_B0
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0784'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0787'   D1                    	POP	D
  0788'   DA 078F'              	JC	KC_BOF
  078B'   C3 0748'              	JMP	KC_ED
  078E'                         KC_B0:
  078E'   D1                    	POP	D
  078F'                         KC_BOF:
  078F'   2A 2341'              	LHLD	JKN		; moved = LFs found
  0792'   CD 0000*              	CALL	SUBHD
  0795'                         KC_MV:
  0795'   E5                    	PUSH	H
  0796'   2A 233F'              	LHLD	JKCNT
  0799'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  079C'   D1                    	POP	D		; DE = moved
  079D'   2A 2341'              	LHLD	JKN
  07A0'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  07A3'   DA 07A7'              	JC	KC_AD
  07A6'   EB                    	XCHG			; DE = N
  07A7'                         KC_AD:
  07A7'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  07AA'   CD 0000*              	CALL	SUBHD
  07AD'   22 0000*              	SHLD	LNDLT
  07B0'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  07B1'                         ATEOF:
  07B1'   CD 0000*              	CALL	RGET0
  07B4'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  07B7'                         LASTLN:
  07B7'   2A 0000*              	LHLD	GAPBEG
  07BA'   EB                    	XCHG
  07BB'   2A 0000*              	LHLD	TXTBEG
  07BE'   CD 0000*              	CALL	CMP16
  07C1'   21 0000               	LXI	H,0
  07C4'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  07C7'   1B                    	DCX	D
  07C8'   1A                    	LDAX	D
  07C9'   FE 0A                 	CPI	LF
  07CB'   C2 0000*              	JNZ	SETBWD
  07CE'   23                    	INX	H
  07CF'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  07D2'                         JKLAND:
  07D2'   21 0000               	LXI	H,0
  07D5'   22 2349'              	SHLD	JKVC		; screen column
  07D8'   2B                    	DCX	H
  07D9'   22 234B'              	SHLD	JKLS		; last content char: none yet
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  07DC'   CD 0000*              	CALL	RGET0
  07DF'   11 0000               	LXI	D,0		; DE = chars read
  07E2'                         JL_RD:
  07E2'   CD 0000*              	CALL	RDGET
  07E5'   DA 081F'              	JC	JL_END
  07E8'   FE 0A                 	CPI	LF
  07EA'   CA 081F'              	JZ	JL_END
  07ED'   E5                    	PUSH	H
  07EE'   C5                    	PUSH	B
  07EF'   2A 2349'              	LHLD	JKVC
  07F2'   CD 03D8'              	CALL	CWID
  07F5'   B7                    	ORA	A
  07F6'   CA 0819'              	JZ	JL_NX		; a CR
  07F9'   EB                    	XCHG
  07FA'   22 234B'              	SHLD	JKLS		; the last content char so far
  07FD'   EB                    	XCHG
  07FE'   4F                    	MOV	C,A
  07FF'   06 00                 	MVI	B,0
  0801'   09                    	DAD	B		; HL = the column after this char
  0802'   22 2349'              	SHLD	JKVC
  0805'   D5                    	PUSH	D
  0806'   EB                    	XCHG
  0807'   2A 2339'              	LHLD	GOALCOL
  080A'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  080D'   D1                    	POP	D
  080E'   DA 0819'              	JC	JL_NX
  0811'   CA 0819'              	JZ	JL_NX
  0814'   C1                    	POP	B		; this char holds the goal column
  0815'   E1                    	POP	H
  0816'   C3 082A'              	JMP	JL_GO
  0819'                         JL_NX:
  0819'   C1                    	POP	B
  081A'   E1                    	POP	H
  081B'   13                    	INX	D
  081C'   C3 07E2'              	JMP	JL_RD
  081F'                         JL_END:
  081F'   2A 234B'              	LHLD	JKLS		; past the line's end: its last content char
  0822'   7C                    	MOV	A,H
  0823'   A5                    	ANA	L
  0824'   3C                    	INR	A
  0825'   C2 0829'              	JNZ	JL_LS
  0828'   23                    	INX	H		; no content: the line's start
  0829'                         JL_LS:
  0829'   EB                    	XCHG
  082A'                         JL_GO:
  082A'   D5                    	PUSH	D		; DE = step from the line start
  082B'   CD 0000*              	CALL	CUROFF
  082E'   D1                    	POP	D
  082F'   19                    	DAD	D
  0830'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0833'   AF                    VC_W:	XRA	A
  0834'   32 233B'              	STA	WBIG
  0837'   C3 083F'              	JMP	WDO
  083A'   3E 01                 VCBGW:	MVI	A,1
  083C'   32 233B'              	STA	WBIG
  083F'   CD 0507'              WDO:	CALL	SETMOV
  0842'   AF                    	XRA	A
  0843'   32 233C'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0846'   CD 049A'              	CALL	GETCNT
  0849'   22 2367'              	SHLD	CNTV
  084C'   2A 2367'              WDO_LP: LHLD	CNTV
  084F'   7C                    	MOV	A,H
  0850'   B5                    	ORA	L
  0851'   CA 085E'              	JZ	WDO_DN
  0854'   2B                    	DCX	H
  0855'   22 2367'              	SHLD	CNTV
  0858'   CD 08AE'              	CALL	FWD1
  085B'   D2 084C'              	JNC	WDO_LP
  085E'                         WDO_DN:
  085E'   CD 07B1'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0861'   DA 086E'              	JC	WDO_NL
  0864'   FE 0D                 	CPI	CR
  0866'   CA 086E'              	JZ	WDO_NL
  0869'   FE 0A                 	CPI	LF
  086B'   C2 0384'              	JNZ	SETGL
  086E'                         WDO_NL:
  086E'   CD 0000*              	CALL	PEEKL
  0871'   DA 0384'              	JC	SETGL
  0874'   FE 0A                 	CPI	LF
  0876'   CA 0384'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0879'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  087B'   32 233C'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  087E'   CD 09A9'              	CALL	DECC		; back onto its last char
  0881'   C3 0384'              	JMP	SETGL
                                
  0884'   AF                    VC_B:	XRA	A
  0885'   32 233B'              	STA	WBIG
  0888'   C3 0890'              	JMP	BDO
  088B'   3E 01                 VCBGB:	MVI	A,1
  088D'   32 233B'              	STA	WBIG
  0890'   CD 0507'              BDO:	CALL	SETMOV
  0893'   CD 049A'              	CALL	GETCNT
  0896'   22 2367'              	SHLD	CNTV
  0899'   2A 2367'              BDO_LP: LHLD	CNTV
  089C'   7C                    	MOV	A,H
  089D'   B5                    	ORA	L
  089E'   CA 0384'              	JZ	SETGL
  08A1'   2B                    	DCX	H
  08A2'   22 2367'              	SHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  08A5'   CD 08FA'              	CALL	BCK1
  08A8'   D2 0899'              	JNC	BDO_LP
  08AB'   C3 0384'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  08AE'                         FWD1:
  08AE'   CD 092D'              	CALL	CCLS
  08B1'   32 2375'              	STA	WKCLS		; the starting class
  08B4'   CD 0967'              	CALL	INCC
  08B7'   B7                    	ORA	A
  08B8'   CA 08D0'              	JZ	FW_WD
  08BB'   37                    	STC
  08BC'   F8                    	RM			; -1: already at the end
  08BD'   FE 02                 	CPI	2
  08BF'   C2 08D0'              	JNZ	FW_WD		; 1: a next line was reached
  08C2'   CD 07B1'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  08C5'   D4 094E'              	CNC	NXLN
  08C8'   D2 08D0'              	JNC	FW_WD
  08CB'   CD 09A9'              	CALL	DECC		; yes: back onto its last char, failed
  08CE'   37                    	STC
  08CF'   C9                    	RET
  08D0'                         FW_WD:
  08D0'   3A 2375'              	LDA	WKCLS		; go past the rest of this word
  08D3'   B7                    	ORA	A
  08D4'   CA 08E9'              	JZ	FW_WS
  08D7'                         FW_WLP:
  08D7'   CD 092D'              	CALL	CCLS
  08DA'   21 2375'              	LXI	H,WKCLS
  08DD'   BE                    	CMP	M
  08DE'   C2 08E9'              	JNZ	FW_WS
  08E1'   CD 0967'              	CALL	INCC
  08E4'   B7                    	ORA	A
  08E5'   F8                    	RM			; the end of the file (NC)
  08E6'   C3 08D7'              	JMP	FW_WLP
  08E9'                         FW_WS:
  08E9'   CD 092D'              	CALL	CCLS		; then over blanks to the next word
  08EC'   B7                    	ORA	A
  08ED'   C0                    	RNZ
  08EE'   CD 0935'              	CALL	EMPTY
  08F1'   C8                    	RZ			; an empty line is a word
  08F2'   CD 0967'              	CALL	INCC
  08F5'   B7                    	ORA	A
  08F6'   F8                    	RM
  08F7'   C3 08E9'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  08FA'                         BCK1:
  08FA'   CD 09A9'              	CALL	DECC
  08FD'   B7                    	ORA	A
  08FE'   37                    	STC
  08FF'   F8                    	RM
  0900'                         BK_WS:
  0900'   CD 092D'              	CALL	CCLS		; back over blanks
  0903'   B7                    	ORA	A
  0904'   C2 0914'              	JNZ	BK_WD
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0907'   CD 0935'              	CALL	EMPTY
  090A'   C8                    	RZ			; an empty line is a word
  090B'   CD 09A9'              	CALL	DECC
  090E'   B7                    	ORA	A
  090F'   F2 0900'              	JP	BK_WS
  0912'   AF                    	XRA	A		; the start of the file (NC)
  0913'   C9                    	RET
  0914'                         BK_WD:
  0914'   32 2375'              	STA	WKCLS		; back to the start of this word
  0917'                         BK_WLP:
  0917'   CD 09A9'              	CALL	DECC
  091A'   B7                    	ORA	A
  091B'   FA 092B'              	JM	BK_OK		; the start of the file
  091E'   CD 092D'              	CALL	CCLS
  0921'   21 2375'              	LXI	H,WKCLS
  0924'   BE                    	CMP	M
  0925'   CA 0917'              	JZ	BK_WLP
  0928'   CD 0967'              	CALL	INCC		; overshot: forward one
  092B'                         BK_OK:
  092B'   AF                    	XRA	A
  092C'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  092D'                         CCLS:
  092D'   CD 07B1'              	CALL	ATEOF
  0930'   D2 04BC'              	JNC	CLASSF
  0933'   AF                    	XRA	A
  0934'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0935'                         EMPTY:
  0935'   CD 07B1'              	CALL	ATEOF
  0938'   DA 0943'              	JC	EM_ST
  093B'   FE 0D                 	CPI	CR
  093D'   CA 0943'              	JZ	EM_ST
  0940'   FE 0A                 	CPI	LF
  0942'   C0                    	RNZ
  0943'                         EM_ST:
  0943'   CD 0000*              	CALL	PEEKL
  0946'   DA 094C'              	JC	EM_Y
  0949'   FE 0A                 	CPI	LF
  094B'   C9                    	RET
  094C'                         EM_Y:
  094C'   AF                    	XRA	A
  094D'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  094E'                         NXLN:
  094E'   FE 0A                 	CPI	LF
  0950'   CA 095F'              	JZ	NX_LF
  0953'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0956'   D8                    	RC
  0957'   FE 0A                 	CPI	LF
  0959'   CA 095F'              	JZ	NX_LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  095C'   2B                    	DCX	H		; a lone CR
  095D'   AF                    	XRA	A
  095E'   C9                    	RET
  095F'                         NX_LF:
  095F'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0962'   D8                    	RC
  0963'   2B                    	DCX	H
  0964'   3E 01                 	MVI	A,1
  0966'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0967'                         INCC:
  0967'   CD 07B1'              	CALL	ATEOF
  096A'   DA 09A5'              	JC	IC_END
  096D'   FE 0D                 	CPI	CR
  096F'   CA 0990'              	JZ	IC_NL
  0972'   FE 0A                 	CPI	LF
  0974'   CA 0990'              	JZ	IC_NL
  0977'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  097A'                         IC_CH:
  097A'   CD 07B1'              	CALL	ATEOF
  097D'   DA 098C'              	JC	IC_2
  0980'   FE 0D                 	CPI	CR
  0982'   CA 098C'              	JZ	IC_2
  0985'   FE 0A                 	CPI	LF
  0987'   CA 098C'              	JZ	IC_2
  098A'   AF                    	XRA	A
  098B'   C9                    	RET
  098C'                         IC_2:
  098C'   3E 02                 	MVI	A,2
  098E'   B7                    	ORA	A
  098F'   C9                    	RET
  0990'                         IC_NL:
  0990'   CD 094E'              	CALL	NXLN
  0993'   DA 09A5'              	JC	IC_END
  0996'   F5                    	PUSH	PSW
  0997'   CD 0000*              	CALL	PUTCUR
  099A'   F1                    	POP	PSW
  099B'   B7                    	ORA	A
  099C'   CA 097A'              	JZ	IC_CH		; a lone CR: stepped over as a char
  099F'   CD 09CB'              	CALL	LNINC
  09A2'   3E 01                 	MVI	A,1
  09A4'   C9                    	RET
  09A5'                         IC_END:
  09A5'   3E FF                 	MVI	A,0FFH
  09A7'   B7                    	ORA	A
  09A8'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  09A9'                         DECC:
  09A9'   CD 0000*              	CALL	PEEKL
  09AC'   DA 09A5'              	JC	IC_END
  09AF'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  09B0'   CD 0000*              	CALL	PUTCUR
  09B3'   F1                    	POP	PSW
  09B4'   FE 0A                 	CPI	LF
  09B6'   3E 00                 	MVI	A,0
  09B8'   C0                    	RNZ
  09B9'   CD 09D9'              	CALL	LNDEC
  09BC'   CD 0000*              	CALL	PEEKL		; onto its CR
  09BF'   DA 09C7'              	JC	DC_1
  09C2'   FE 0D                 	CPI	CR
  09C4'   CC 0000*              	CZ	PUTCUR
  09C7'                         DC_1:
  09C7'   3E 01                 	MVI	A,1
  09C9'   B7                    	ORA	A
  09CA'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  09CB'                         LNINC:
  09CB'   E5                    	PUSH	H
  09CC'   2A 0000*              	LHLD	LNDLT
  09CF'   7C                    	MOV	A,H
  09D0'   FE 40                 	CPI	40H
  09D2'   CA 09E7'              	JZ	LN_X
  09D5'   23                    	INX	H
  09D6'   C3 09E4'              	JMP	LN_ST
  09D9'                         LNDEC:
  09D9'   E5                    	PUSH	H
  09DA'   2A 0000*              	LHLD	LNDLT
  09DD'   7C                    	MOV	A,H
  09DE'   FE C0                 	CPI	0C0H
  09E0'   CA 09E7'              	JZ	LN_X
  09E3'   2B                    	DCX	H
  09E4'                         LN_ST:
  09E4'   22 0000*              	SHLD	LNDLT
  09E7'                         LN_X:
  09E7'   E1                    	POP	H
  09E8'   C9                    	RET
                                
  09E9'   AF                    VC_E:	XRA	A
  09EA'   32 233B'              	STA	WBIG
  09ED'   C3 09F5'              	JMP	EDO
  09F0'   3E 01                 VCBGE:	MVI	A,1
  09F2'   32 233B'              	STA	WBIG
  09F5'   CD 0507'              EDO:	CALL	SETMOV
  09F8'   CD 049A'              	CALL	GETCNT
  09FB'   22 2367'              	SHLD	CNTV
  09FE'   2A 2367'              EDO_LP: LHLD	CNTV
  0A01'   7C                    	MOV	A,H
  0A02'   B5                    	ORA	L
  0A03'   C8                    	RZ
  0A04'   2B                    	DCX	H
  0A05'   22 2367'              	SHLD	CNTV
  0A08'   CD 0A0E'              	CALL	ESTEP
  0A0B'   C3 09FE'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
