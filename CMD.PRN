                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  0003                   C      CTRLC	EQU	03H		; ^C -- abandons a search or a long move
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- a ^C waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to a ^C by the
  0001'   32 2A48'              	STA	BRKARM		;   one before it (BRKON)
  0004'   CD 00DD'              	CALL	DOTPRE
  0007'   CD 000D'              	CALL	CDMODE
  000A'   C3 0134'              	JMP	DOTPOST
  000D'                         CDMODE:
  000D'   3A 2995'              	LDA	EDMODE
  0010'   FE 01                 	CPI	EM_INS
  0012'   CA 001D'              	JZ	CD_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  0015'   FE 02                 	CPI	EM_REP
  0017'   CA 0020'              	JZ	CD_REP
  001A'   C3 0023'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  001D'                         CD_INS:
  001D'   C3 1ADF'              	JMP	VIINS
  0020'                         CD_REP:
  0020'   C3 1A1F'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0023'                         VICMD:
  0023'   78                    	MOV	A,B
  0024'   FE 00                 	CPI	KT_NONE
  0026'   C8                    	RZ			; discarded key
  0027'   FE 01                 	CPI	KT_ACT
  0029'   CA 00AF'              	JZ	VIC_ACT
  002C'   3A 29BD'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 162C'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 2996'              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 2996'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 2996'              	SHLD	CMDCNT
  0077'   C3 075A'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 29BD'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 29BE'              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 29BD'              	STA	GPEND
  0084'   3A 29BF'              	LDA	PENDOP
  0087'   32 29C0'              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 29BF'              	STA	PENDOP
  008E'   3A 29C0'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 105D'              	JNZ	OPPEND
  0095'   3A 29BE'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 28C4'              	LXI	H,CMDTAB
  00A6'   C3 00C2'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 075A'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 068B'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ACT:
  00AF'   AF                    	XRA	A		; action key clears all pending state
  00B0'   32 29BD'              	STA	GPEND
  00B3'   32 29BE'              	STA	GSAVE
  00B6'   32 29BF'              	STA	PENDOP
  00B9'   32 29C0'              	STA	PSAVE
  00BC'   21 297C'              	LXI	H,ACTTAB
  00BF'   C3 00C2'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00C2'                         VSCANQ:
  00C2'   CD 00CE'              	CALL	VSCLK
  00C5'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C8'   E9                    	PCHL
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C9'                         VSCAN:
  00C9'   CD 00CE'              	CALL	VSCLK
  00CC'   C8                    	RZ			; miss
  00CD'   E9                    	PCHL
  00CE'                         VSCLK:
  00CE'   7E                    VSCAN1: MOV	A,M
  00CF'   B7                    	ORA	A
  00D0'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00D1'   23                    	INX	H
  00D2'   B9                    	CMP	C
  00D3'   5E                    	MOV	E,M
  00D4'   23                    	INX	H
  00D5'   56                    	MOV	D,M
  00D6'   23                    	INX	H
  00D7'   C2 00CE'              	JNZ	VSCAN1
  00DA'   EB                    	XCHG			; HL = the handler
  00DB'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00DC'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DD'                         DOTPRE:
  00DD'   3A 29B4'              	LDA	DOTRPL
  00E0'   B7                    	ORA	A
  00E1'   C0                    	RNZ			; the replay's own keys are not recorded
  00E2'   C5                    	PUSH	B
  00E3'   D5                    	PUSH	D
  00E4'   E5                    	PUSH	H
  00E5'   3A 29B3'              	LDA	DOTSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E8'   B7                    	ORA	A
  00E9'   CA 00FC'              	JZ	DOTP1
  00EC'   AF                    	XRA	A		; a new command: the recording starts over
  00ED'   32 29B3'              	STA	DOTSTA
  00F0'   32 29B5'              	STA	DOTOVF
  00F3'   21 0000*              	LXI	H,DOTSCR
  00F6'   22 29B7'              	SHLD	DOTSP
  00F9'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00FC'                         DOTP1:
  00FC'   78                    	MOV	A,B
  00FD'   FE 00                 	CPI	KT_NONE
  00FF'   CA 0128'              	JZ	DOTPX		; a discarded key is not a keystroke
  0102'   FE 01                 	CPI	KT_ACT
  0104'   79                    	MOV	A,C
  0105'   CA 010D'              	JZ	DOTP2
  0108'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  010A'   C3 010F'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  010D'                         DOTP2:
  010D'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010F'                         DOTP3:
  010F'   32 29B6'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  0112'   47                    	MOV	B,A
  0113'   2A 29B7'              	LHLD	DOTSP
  0116'   EB                    	XCHG
  0117'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  011A'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  011D'   D2 012C'              	JNC	DOTPOV
  0120'   2A 29B7'              	LHLD	DOTSP
  0123'   70                    	MOV	M,B
  0124'   23                    	INX	H
  0125'   22 29B7'              	SHLD	DOTSP
  0128'                         DOTPX:
  0128'   E1                    	POP	H
  0129'   D1                    	POP	D
  012A'   C1                    	POP	B
  012B'   C9                    	RET
  012C'                         DOTPOV:
  012C'   3E 01                 	MVI	A,1
  012E'   32 29B5'              	STA	DOTOVF		; too long to record: give this recording up
  0131'   C3 0128'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0134'                         DOTPOST:
  0134'   3A 29B4'              	LDA	DOTRPL
  0137'   B7                    	ORA	A
  0138'   C0                    	RNZ
  0139'   3A 2995'              	LDA	EDMODE
  013C'   B7                    	ORA	A
  013D'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013E'   3A 29BD'              	LDA	GPEND
  0141'   B7                    	ORA	A
  0142'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  0143'   3A 29BF'              	LDA	PENDOP
  0146'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0147'   C0                    	RNZ			; an operator still waiting for its motion
  0148'   2A 2996'              	LHLD	CMDCNT
  014B'   7C                    	MOV	A,H
  014C'   B5                    	ORA	L
  014D'   CA 015B'              	JZ	DOTQ1
  0150'   3A 29B6'              	LDA	DOTLK		; a digit with the count still up: the command
  0153'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0155'   DA 015B'              	JC	DOTQ1
  0158'   FE 3A                 	CPI	'9'+1
  015A'   D8                    	RC
  015B'                         DOTQ1:
  015B'   3E 01                 	MVI	A,1
  015D'   32 29B3'              	STA	DOTSTA		; the next key starts a new recording
  0160'   3A 29B2'              	LDA	DOTCHG
  0163'   B7                    	ORA	A
  0164'   C8                    	RZ			; changed nothing: not a repeatable command
  0165'   AF                    	XRA	A
  0166'   32 29B2'              	STA	DOTCHG
  0169'   32 29B9'              	STA	DOTLEN
  016C'   3A 29B5'              	LDA	DOTOVF
  016F'   B7                    	ORA	A
  0170'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  0171'   2A 29B7'              	LHLD	DOTSP
  0174'   11 0000*              	LXI	D,DOTSCR
  0177'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  017A'   7D                    	MOV	A,L
  017B'   32 29B9'              	STA	DOTLEN
  017E'   B7                    	ORA	A
  017F'   C8                    	RZ
  0180'   4F                    	MOV	C,A
  0181'   06 00                 	MVI	B,0
  0183'   21 0000*              	LXI	H,DOTSCR
  0186'   11 0000*              	LXI	D,DOTBUF
  0189'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  018C'                         MARKMOD:
  018C'   3E 01                 	MVI	A,1
  018E'   32 2999'              	STA	MODF
  0191'   32 29B2'              	STA	DOTCHG
  0194'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0195'                         VC_DOT:
  0195'   2A 2996'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0198'   22 29BB'              	SHLD	DOTNCT
  019B'   21 0000               	LXI	H,0
  019E'   22 2996'              	SHLD	CMDCNT
  01A1'   3A 29B9'              	LDA	DOTLEN
  01A4'   B7                    	ORA	A
  01A5'   CA 01FF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A8'   AF                    	XRA	A
  01A9'   32 29BA'              	STA	DOTIX
  01AC'   2A 29BB'              	LHLD	DOTNCT
  01AF'   7C                    	MOV	A,H
  01B0'   B5                    	ORA	L
  01B1'   CA 01D1'              	JZ	DOTGO
  01B4'   22 2996'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B7'                         DOTSKP:
  01B7'   CD 0564'              	CALL	DOTGET		; ... so step past the digits it recorded
  01BA'   DA 01D1'              	JC	DOTGO
  01BD'   FE 30                 	CPI	'0'
  01BF'   DA 01D1'              	JC	DOTGO
  01C2'   FE 3A                 	CPI	'9'+1
  01C4'   D2 01D1'              	JNC	DOTGO
  01C7'   3A 29BA'              	LDA	DOTIX
  01CA'   3C                    	INR	A
  01CB'   32 29BA'              	STA	DOTIX
  01CE'   C3 01B7'              	JMP	DOTSKP
  01D1'                         DOTGO:
  01D1'   3E 01                 	MVI	A,1
  01D3'   32 29B4'              	STA	DOTRPL
  01D6'                         DOTLP:
  01D6'   CD 0564'              	CALL	DOTGET
  01D9'   DA 01F5'              	JC	DOTDN
  01DC'   4F                    	MOV	C,A
  01DD'   06 02                 	MVI	B,KT_CHAR
  01DF'   B7                    	ORA	A
  01E0'   F2 01E8'              	JP	DOTLP2
  01E3'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E5'   4F                    	MOV	C,A
  01E6'   06 01                 	MVI	B,KT_ACT
  01E8'                         DOTLP2:
  01E8'   3A 29BA'              	LDA	DOTIX
  01EB'   3C                    	INR	A
  01EC'   32 29BA'              	STA	DOTIX
  01EF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F2'   C3 01D6'              	JMP	DOTLP
  01F5'                         DOTDN:
  01F5'   AF                    	XRA	A
  01F6'   32 29B4'              	STA	DOTRPL
  01F9'   32 29B2'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FC'   C3 077B'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FF'                         DOTBEL:
  01FF'   0E 07                 	MVI	C,BEL
  0201'   CD 0000*              	CALL	BCONOU
  0204'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  '.' after a 'd''a' still refuses: the mark letter is read inside
                                ; the command and never recorded.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0207'                         MKVAD:
  0207'   16 00                 	MVI	D,0
  0209'   59                    	MOV	E,C
  020A'   21 2A24'              	LXI	H,MKVAL
  020D'   19                    	DAD	D
  020E'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020F'                         MKCLR:
  020F'   21 2A24'              	LXI	H,MKVAL
  0212'   06 03                 	MVI	B,MKMAX
  0214'   AF                    	XRA	A
  0215'                         MKC_LP:
  0215'   77                    	MOV	M,A
  0216'   23                    	INX	H
  0217'   05                    	DCR	B
  0218'   C2 0215'              	JNZ	MKC_LP
  021B'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021C'                         MKGETK:
  021C'   3A 29B4'              	LDA	DOTRPL
  021F'   B7                    	ORA	A
  0220'   CA 0231'              	JZ	MKG_KB
  0223'   CD 0564'              	CALL	DOTGET		; the recording's next key
  0226'   D8                    	RC
  0227'   4F                    	MOV	C,A
  0228'   3A 29BA'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022B'   3C                    	INR	A
  022C'   32 29BA'              	STA	DOTIX
  022F'   B7                    	ORA	A		; CY clear
  0230'   C9                    	RET
  0231'                         MKG_KB:
  0231'   CD 0000*              	CALL	GETKEY
  0234'   78                    	MOV	A,B
  0235'   FE 02                 	CPI	KT_CHAR
  0237'   37                    	STC
  0238'   C0                    	RNZ			; an action key (ESC) cancels the command
  0239'   B7                    	ORA	A		; CY clear
  023A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023B'                         VC_FF:				; 'f' -- forward, onto the character
  023B'   3E 66                 	MVI	A,'f'
  023D'   C3 024C'              	JMP	FNDNEW
  0240'                         VC_FB:				; 'F' -- backward, onto it
  0240'   3E 46                 	MVI	A,'F'
  0242'   C3 024C'              	JMP	FNDNEW
  0245'                         VC_TF:				; 't' -- forward, up to it
  0245'   3E 74                 	MVI	A,'t'
  0247'   C3 024C'              	JMP	FNDNEW
  024A'                         VC_TB:				; 'T' -- backward, up to it
  024A'   3E 54                 	MVI	A,'T'
  024C'                         FNDNEW:
  024C'   32 2A19'              	STA	FNDKND		; the find ';' and ',' will repeat
  024F'   CD 021C'              	CALL	MKGETK		; the character it looks for
  0252'   DA 0289'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0255'   79                    	MOV	A,C
  0256'   32 2A1A'              	STA	FNDCH
  0259'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025B'   CD 00DD'              	CALL	DOTPRE
  025E'   3A 2A19'              	LDA	FNDKND
  0261'   06 01                 	MVI	B,1		; a find starts at the next character along
  0263'   C3 0290'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0266'                         VC_SEMI:
  0266'   3A 2A19'              	LDA	FNDKND
  0269'   B7                    	ORA	A
  026A'   CA 0289'              	JZ	FNDNIL		; nothing has been looked for yet
  026D'   C3 0279'              	JMP	FNDREP
  0270'                         VC_COMMA:
  0270'   3A 2A19'              	LDA	FNDKND
  0273'   B7                    	ORA	A
  0274'   CA 0289'              	JZ	FNDNIL
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0277'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0279'                         FNDREP:
  0279'   06 01                 	MVI	B,1
  027B'   F5                    	PUSH	PSW
  027C'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027E'   FE 54                 	CPI	'T'
  0280'   C2 0285'              	JNZ	FNDR_GO
  0283'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0285'                         FNDR_GO:
  0285'   F1                    	POP	PSW
  0286'   C3 0290'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0289'                         FNDNIL:
  0289'   AF                    	XRA	A
  028A'   32 29C0'              	STA	PSAVE
  028D'   C3 075A'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  0290'                         FNDGO:
  0290'   32 2A1B'              	STA	FNDRUN
  0293'   78                    	MOV	A,B
  0294'   32 2A1C'              	STA	FNDSTP
  0297'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  029A'   22 2A1D'              	SHLD	FNDN		; the occurrence wanted
  029D'   CD 0000*              	CALL	CUROFF
  02A0'   22 2A1F'              	SHLD	FNDCUR
  02A3'   3A 2A1B'              	LDA	FNDRUN
  02A6'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A8'   CA 02DC'              	JZ	FNDBWD
  02AB'   2A 2A1F'              	LHLD	FNDCUR
  02AE'   CD 0623'              	CALL	EOLC		; HL = the line's last content character
  02B1'   22 2A21'              	SHLD	FNDLIM
  02B4'   2A 2A1F'              	LHLD	FNDCUR
  02B7'   3A 2A1C'              	LDA	FNDSTP
  02BA'   5F                    	MOV	E,A
  02BB'   16 00                 	MVI	D,0
  02BD'   19                    	DAD	D		; HL = where the scan starts
  02BE'                         FNDF_LP:
  02BE'   EB                    	XCHG			; DE = the scan
  02BF'   2A 2A21'              	LHLD	FNDLIM
  02C2'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C5'   EB                    	XCHG			; HL = the scan
  02C6'   CA 02CC'              	JZ	FNDF_AT		; the last character is still a candidate
  02C9'   D2 032E'              	JNC	FNDMIS		; past it: not on this line
  02CC'                         FNDF_AT:
  02CC'   CD 0335'              	CALL	FNDSEE		; Z iff this is the character
  02CF'   C2 02D8'              	JNZ	FNDF_NX
  02D2'   CD 0340'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D5'   CA 0314'              	JZ	FNDHIT
  02D8'                         FNDF_NX:
  02D8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D9'   C3 02BE'              	JMP	FNDF_LP
  02DC'                         FNDBWD:
  02DC'   2A 2A1F'              	LHLD	FNDCUR
  02DF'   CD 05E4'              	CALL	BOL		; HL = the line's first character
  02E2'   22 2A21'              	SHLD	FNDLIM
  02E5'   2A 2A1F'              	LHLD	FNDCUR
  02E8'   3A 2A1C'              	LDA	FNDSTP
  02EB'   2F                    	CMA
  02EC'   5F                    	MOV	E,A
  02ED'   16 FF                 	MVI	D,0FFH
  02EF'   13                    	INX	D		; DE = -step
  02F0'   19                    	DAD	D		; HL = where the scan starts
  02F1'   D2 032E'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F4'                         FNDB_LP:
  02F4'   EB                    	XCHG			; DE = the scan
  02F5'   2A 2A21'              	LHLD	FNDLIM
  02F8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FB'   EB                    	XCHG			; HL = the scan
  02FC'   DA 032E'              	JC	FNDMIS		; before this line: not on it
  02FF'   CD 0335'              	CALL	FNDSEE
  0302'   C2 030B'              	JNZ	FNDB_NX
  0305'   CD 0340'              	CALL	FNDCNT
  0308'   CA 0314'              	JZ	FNDHIT
  030B'                         FNDB_NX:
  030B'   7C                    	MOV	A,H
  030C'   B5                    	ORA	L
  030D'   CA 032E'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  0310'   2B                    	DCX	H
  0311'   C3 02F4'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0314'                         FNDHIT:
  0314'   3A 2A1B'              	LDA	FNDRUN
  0317'   E6 5F                 	ANI	5FH
  0319'   FE 54                 	CPI	'T'
  031B'   C2 032B'              	JNZ	FNDLND
  031E'   3A 2A1B'              	LDA	FNDRUN
  0321'   E6 20                 	ANI	20H
  0323'   CA 032A'              	JZ	FNDH_BW
  0326'   2B                    	DCX	H		; forward 't': the character before it
  0327'   C3 032B'              	JMP	FNDLND
  032A'                         FNDH_BW:
  032A'   23                    	INX	H		; backward 'T': the character after it
  032B'                         FNDLND:
  032B'   C3 057A'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032E'                         FNDMIS:
  032E'   AF                    	XRA	A
  032F'   32 29C0'              	STA	PSAVE
  0332'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0335'                         FNDSEE:
  0335'   E5                    	PUSH	H
  0336'   CD 0000*              	CALL	CHARAT
  0339'   E1                    	POP	H
  033A'   47                    	MOV	B,A
  033B'   3A 2A1A'              	LDA	FNDCH
  033E'   B8                    	CMP	B
  033F'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  0340'                         FNDCNT:
  0340'   E5                    	PUSH	H
  0341'   2A 2A1D'              	LHLD	FNDN
  0344'   2B                    	DCX	H
  0345'   22 2A1D'              	SHLD	FNDN
  0348'   7C                    	MOV	A,H
  0349'   B5                    	ORA	L
  034A'   E1                    	POP	H
  034B'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034C'                         ISFIND:
  034C'   E6 5F                 	ANI	5FH		; fold the case away
  034E'   FE 46                 	CPI	'F'
  0350'   C8                    	RZ
  0351'   FE 54                 	CPI	'T'
  0353'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0354'                         VC_MK:
  0354'   3E 04                 	MVI	A,PM
  0356'   C3 0360'              	JMP	MKGO
  0359'                         VC_BQ:
  0359'   3E 05                 	MVI	A,PJ
  035B'   C3 0360'              	JMP	MKGO
  035E'                         VC_AQ:
  035E'   3E 06                 	MVI	A,PJL
  0360'                         MKGO:
  0360'   32 2A30'              	STA	MKWHAT
  0363'   CD 0678'              	CALL	MOVCNT		; a count means nothing on any of the three
  0366'   CD 021C'              	CALL	MKGETK		; the key that names the mark
  0369'   DA 0448'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  036C'                         MKOP:
  036C'   79                    	MOV	A,C
  036D'   D6 61                 	SUI	'a'
  036F'   FE 03                 	CPI	MKMAX
  0371'   D2 0440'              	JNC	MKNOLT		; not a mark letter
  0374'   4F                    	MOV	C,A		; C = the mark's index
  0375'   87                    	ADD	A
  0376'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0377'   5F                    	MOV	E,A
  0378'   16 00                 	MVI	D,0
  037A'   21 0000*              	LXI	H,MKTAB
  037D'   19                    	DAD	D		; HL -> this mark's slot
  037E'   3A 2A30'              	LDA	MKWHAT
  0381'   FE 04                 	CPI	PM
  0383'   CA 045B'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0386'                         MKJMP:
  0386'   E5                    	PUSH	H
  0387'   CD 0207'              	CALL	MKVAD
  038A'   7E                    	MOV	A,M
  038B'   E1                    	POP	H
  038C'   B7                    	ORA	A
  038D'   CA 0436'              	JZ	MKNSET		; never set
  0390'   CD 0402'              	CALL	MKLOAD		; the file position it holds
  0393'   CD 040F'              	CALL	MKWIN
  0396'   DA 03AD'              	JC	MKJ_GO		; in the window: any command may go there
  0399'   3A 29C0'              	LDA	PSAVE
  039C'   B7                    	ORA	A
  039D'   CA 03AD'              	JZ	MKJ_GO
  03A0'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  03A2'   C2 0448'              	JNZ	MKBAD
  03A5'   3A 2A30'              	LDA	MKWHAT
  03A8'   FE 06                 	CPI	PJL
  03AA'   C2 0448'              	JNZ	MKBAD
  03AD'                         MKJ_GO:
  03AD'   CD 0F60'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  03B0'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  03B3'   CD 03CF'              	CALL	MKPAGE		; HL = the mark's offset in the window
  03B6'   CD 06EB'              	CALL	BRKOFF		; (A only)
  03B9'   DA 0703'              	JC	BRKBAK
  03BC'   3A 2A30'              	LDA	MKWHAT
  03BF'   FE 06                 	CPI	PJL
  03C1'   CA 03C9'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03C4'   3E 01                 	MVI	A,1		;   non-blank
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03C6'   32 2A23'              	STA	GPKEEP		; '`': land on the column it was set at
  03C9'                         MKJ_LN:
  03C9'   CD 0000*              	CALL	GOTO
  03CC'   C3 0F78'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
  03CF'                         MKPAGE:
  03CF'   CD 040F'              	CALL	MKWIN
  03D2'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
  03D5'   32 0000*              	STA	DIRFLG
  03D8'   21 FFFF               	LXI	H,0FFFFH
  03DB'   22 2996'              	SHLD	CMDCNT
  03DE'   CD 0000*              	CALL	GOLINE
  03E1'   CD 0000*              	CALL	SCRLST
  03E4'   CD 06A0'              	CALL	CNTTST
  03E7'   C2 03CF'              	JNZ	MKPAGE
  03EA'   CD 040F'              	CALL	MKWIN		; the file ran out: that was its last step
  03ED'   DA 0000*              	JC	CLRCNT
  03F0'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03F3'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03F6'                         BACKTO:
  03F6'   CD 0402'              	CALL	MKLOAD
  03F9'   CD 0000*              	CALL	CLRCNT
  03FC'   CD 03CF'              	CALL	MKPAGE
  03FF'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  0402'                         MKLOAD:
  0402'   5E                    	MOV	E,M
  0403'   23                    	INX	H
  0404'   56                    	MOV	D,M
  0405'   23                    	INX	H
  0406'   7E                    	MOV	A,M
  0407'   EB                    	XCHG
  0408'   22 2A2D'              	SHLD	MKPOS
  040B'   32 2A2F'              	STA	MKPOS+2
  040E'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  040F'                         MKWIN:
  040F'   2A 0000*              	LHLD	TXTBEG
  0412'   CD 0F1A'              	CALL	FPOS
  0415'   EB                    	XCHG
  0416'   47                    	MOV	B,A		; B:DE = the window's first byte
  0417'   2A 2A2D'              	LHLD	MKPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  041A'   3A 2A2F'              	LDA	MKPOS+2
  041D'   CD 0F0D'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0420'   DA 0432'              	JC	MKW_BK		; above it
  0423'   C2 0430'              	JNZ	MKW_FW		; 64K or more below it
  0426'   E5                    	PUSH	H
  0427'   CD 0000*              	CALL	LOGLEN
  042A'   D1                    	POP	D
  042B'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  042E'   EB                    	XCHG
  042F'   D8                    	RC			; inside
  0430'                         MKW_FW:
  0430'   AF                    	XRA	A
  0431'   C9                    	RET
  0432'                         MKW_BK:
  0432'   3E FF                 	MVI	A,0FFH
  0434'   B7                    	ORA	A
  0435'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  0436'                         MKNSET:
  0436'   AF                    	XRA	A
  0437'   32 29C0'              	STA	PSAVE
  043A'   21 2354'              	LXI	H,SMKNS
  043D'   C3 2249'              	JMP	EXERR
  0440'                         MKNOLT:
  0440'   3A 2A30'              	LDA	MKWHAT
  0443'   FE 04                 	CPI	PM
  0445'   C2 0436'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0448'                         MKBAD:
  0448'   AF                    	XRA	A
  0449'   32 29C0'              	STA	PSAVE
  044C'   C3 01FF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  044F'                         FPSTO:
  044F'   E5                    	PUSH	H
  0450'   CD 0F17'              	CALL	CURFP		; A:HL = the cursor's file position
  0453'   EB                    	XCHG
  0454'   E1                    	POP	H
  0455'   73                    	MOV	M,E
  0456'   23                    	INX	H
  0457'   72                    	MOV	M,D
  0458'   23                    	INX	H
  0459'   77                    	MOV	M,A
  045A'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  045B'                         MKSET:
  045B'   CD 044F'              	CALL	FPSTO
  045E'   CD 0207'              	CALL	MKVAD
  0461'   36 01                 	MVI	M,1		; ... and the mark is live
  0463'   C3 075A'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  0466'                         MKSHFT:
  0466'   32 2A2C'              	STA	MKTYP
  0469'   3A 2A31'              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  046C'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  046D'   C0                    	RNZ			;   every mark points into is still there
  046E'   C5                    	PUSH	B
  046F'   50                    	MOV	D,B
  0470'   59                    	MOV	E,C
  0471'   EB                    	XCHG
  0472'   22 2A2A'              	SHLD	MKN		; the edit's length
  0475'   D5                    	PUSH	D		; ... and its offset
  0476'   CD 0000*              	CALL	CUROFF
  0479'   D1                    	POP	D
  047A'   CD 0000*              	CALL	SUBHD
  047D'   EB                    	XCHG			; DE = how far behind the cursor it is
  047E'   CD 0F17'              	CALL	CURFP		; A:HL = the cursor's file position
  0481'   06 00                 	MVI	B,0
  0483'   CD 0F0D'              	CALL	SUB24
  0486'   22 2A27'              	SHLD	MKEDIT
  0489'   32 2A29'              	STA	MKEDIT+2	; where in the file the edit is
  048C'   21 2A24'              	LXI	H,MKVAL
  048F'   11 0000*              	LXI	D,MKTAB
  0492'   06 03                 	MVI	B,MKMAX
  0494'                         MKS_LP:
  0494'   7E                    	MOV	A,M
  0495'   B7                    	ORA	A
  0496'   CA 0502'              	JZ	MKS_N0		; that mark is not set
  0499'   E5                    	PUSH	H
  049A'   C5                    	PUSH	B
  049B'   21 2A27'              	LXI	H,MKEDIT
  049E'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  049F'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04A0'   4F                    	MOV	C,A
  04A1'   13                    	INX	D
  04A2'   23                    	INX	H
  04A3'   1A                    	LDAX	D
  04A4'   9E                    	SBB	M
  04A5'   47                    	MOV	B,A
  04A6'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  04A7'   23                    	INX	H
  04A8'   1A                    	LDAX	D
  04A9'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  04AA'   DA 04FD'              	JC	MKS_PP		; before it: nothing moves
  04AD'   6F                    	MOV	L,A
  04AE'   3A 2A2C'              	LDA	MKTYP
  04B1'   3D                    	DCR	A
  04B2'   CA 04D7'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  04B5'   7D                    	MOV	A,L
  04B6'   2A 2A2A'              	LHLD	MKN
  04B9'   B7                    	ORA	A
  04BA'   C2 04C6'              	JNZ	MKS_DL		; 64K or more past it
  04BD'   79                    	MOV	A,C
  04BE'   95                    	SUB	L
  04BF'   78                    	MOV	A,B
  04C0'   9C                    	SBB	H
  04C1'   D2 04C6'              	JNC	MKS_DL		; past the end of what goes
  04C4'   60                    	MOV	H,B
  04C5'   69                    	MOV	L,C		; inside it: close up to the edit
  04C6'                         MKS_DL:
  04C6'   1B                    	DCX	D
  04C7'   1B                    	DCX	D
  04C8'   1A                    	LDAX	D
  04C9'   95                    	SUB	L
  04CA'   12                    	STAX	D
  04CB'   13                    	INX	D
  04CC'   1A                    	LDAX	D
  04CD'   9C                    	SBB	H
  04CE'   12                    	STAX	D
  04CF'   13                    	INX	D
  04D0'   1A                    	LDAX	D
  04D1'   DE 00                 	SBI	0
  04D3'   12                    	STAX	D
  04D4'   C3 04FD'              	JMP	MKS_PP
                                	;--- an insert: on by its length ---
  04D7'                         MKS_IN:
  04D7'   7D                    	MOV	A,L
  04D8'   B0                    	ORA	B
  04D9'   B1                    	ORA	C
  04DA'   C2 04EC'              	JNZ	MKS_AD		; the mark is past it
  04DD'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  04E0'   2B                    	DCX	H
  04E1'   7E                    	MOV	A,M		; the last byte that went in
  04E2'   FE 0A                 	CPI	LF
  04E4'   CA 04EC'              	JZ	MKS_AD
  04E7'   FE 0D                 	CPI	CR
  04E9'   C2 04FD'              	JNZ	MKS_PP
  04EC'                         MKS_AD:
  04EC'   2A 2A2A'              	LHLD	MKN
  04EF'   1B                    	DCX	D
  04F0'   1B                    	DCX	D
  04F1'   1A                    	LDAX	D
  04F2'   85                    	ADD	L
  04F3'   12                    	STAX	D
  04F4'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F5'   1A                    	LDAX	D
  04F6'   8C                    	ADC	H
  04F7'   12                    	STAX	D
  04F8'   13                    	INX	D
  04F9'   1A                    	LDAX	D
  04FA'   CE 00                 	ACI	0
  04FC'   12                    	STAX	D
  04FD'                         MKS_PP:
  04FD'   C1                    	POP	B
  04FE'   E1                    	POP	H
  04FF'   C3 0504'              	JMP	MKS_NX
  0502'                         MKS_N0:
  0502'   13                    	INX	D
  0503'   13                    	INX	D
  0504'                         MKS_NX:
  0504'   13                    	INX	D
  0505'   13                    	INX	D
  0506'   23                    	INX	H
  0507'   05                    	DCR	B
  0508'   C2 0494'              	JNZ	MKS_LP
  050B'   C1                    	POP	B
  050C'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  050D'                         VC_UNDO:
  050D'   21 0000               	LXI	H,0
  0510'   22 2996'              	SHLD	CMDCNT
  0513'   CD 0000*              	CALL	UNDO
  0516'   DA 0547'              	JC	UNDNO
  0519'   2A 0000*              	LHLD	UNDCUR
  051C'   CD 052D'              	CALL	UCLAMP		; vi never sits on a line terminator
  051F'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0522'   3E 01                 	MVI	A,1
  0524'   32 2999'              	STA	MODF		; undone past a ':w' still differs from the file
  0527'   CD 08CD'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  052A'   C3 077B'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  052D'                         UCLAMP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  052D'   E5                    	PUSH	H
  052E'   CD 147E'              	CALL	CEND		; HL = the line's content end
  0531'   D1                    	POP	D		; DE = the offset wanted
  0532'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0535'   D2 053A'              	JNC	UCL_BK
  0538'   EB                    	XCHG
  0539'   C9                    	RET
  053A'                         UCL_BK:
  053A'   E5                    	PUSH	H		; the content end
  053B'   EB                    	XCHG			; HL = the offset wanted
  053C'   CD 05E4'              	CALL	BOL
  053F'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0540'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0543'   EB                    	XCHG			; HL = the content end
  0544'   C8                    	RZ
  0545'   2B                    	DCX	H		; ... its last character
  0546'   C9                    	RET
  0547'                         UNDNO:
  0547'   3A 0000*              	LDA	UNDWHY
  054A'   B7                    	ORA	A
  054B'   CA 055C'              	JZ	UNDBEL
  054E'   21 230E'              	LXI	H,SUNDW		; the change has paged away: say so
  0551'   FE 01                 	CPI	1
  0553'   CA 2249'              	JZ	EXERR
  0556'   21 2330'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  0559'   C3 2249'              	JMP	EXERR
  055C'                         UNDBEL:
  055C'   0E 07                 	MVI	C,BEL
  055E'   CD 0000*              	CALL	BCONOU
  0561'   C3 075A'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0564'                         DOTGET:
  0564'   3A 29BA'              	LDA	DOTIX
  0567'   5F                    	MOV	E,A
  0568'   3A 29B9'              	LDA	DOTLEN
  056B'   BB                    	CMP	E
  056C'   CA 0578'              	JZ	DOTGEF
  056F'   16 00                 	MVI	D,0
  0571'   21 0000*              	LXI	H,DOTBUF
  0574'   19                    	DAD	D
  0575'   7E                    	MOV	A,M
  0576'   B7                    	ORA	A		; CY clear: a key was returned
  0577'   C9                    	RET
  0578'                         DOTGEF:
  0578'   37                    	STC
  0579'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057A'                         GOSET:
  057A'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  057D'                         SETGL:
  057D'   CD 0F3A'              	CALL	ZSAVE
  0580'   21 0000               	LXI	H,0
  0583'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0586'   E5                    	PUSH	H
  0587'   CD 0F4D'              	CALL	ZREST
  058A'   E1                    	POP	H
  058B'   E5                    	PUSH	H
  058C'   CD 0684'              	CALL	GBSUB		; HL = bytes to the cursor
  058F'   44                    	MOV	B,H
  0590'   4D                    	MOV	C,L
  0591'   E1                    	POP	H		; HL = the line's start
  0592'   11 0000               	LXI	D,0		; DE = screen column
  0595'                         SG_LP:
  0595'   78                    	MOV	A,B
  0596'   B1                    	ORA	C
  0597'   CA 05AC'              	JZ	SG_CUR
  059A'   7E                    	MOV	A,M
  059B'   23                    	INX	H
  059C'   0B                    	DCX	B
  059D'   E5                    	PUSH	H
  059E'   6B                    	MOV	L,E
  059F'   CD 05D1'              	CALL	CWID
  05A2'   E1                    	POP	H
  05A3'   83                    	ADD	E
  05A4'   5F                    	MOV	E,A
  05A5'   D2 0595'              	JNC	SG_LP
  05A8'   14                    	INR	D
  05A9'   C3 0595'              	JMP	SG_LP
  05AC'                         SG_CUR:
  05AC'   2A 0000*              	LHLD	TXTEND
  05AF'   D5                    	PUSH	D
  05B0'   EB                    	XCHG
  05B1'   2A 0000*              	LHLD	GAPEND
  05B4'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  05B7'   D1                    	POP	D
  05B8'   CA 05CC'              	JZ	SG_SET
  05BB'   7E                    	MOV	A,M
  05BC'   FE 09                 	CPI	TAB
  05BE'   C2 05CC'              	JNZ	SG_SET
  05C1'   6B                    	MOV	L,E
  05C2'   CD 05D1'              	CALL	CWID
  05C5'   3D                    	DCR	A		; the TAB's last column
  05C6'   83                    	ADD	E
  05C7'   5F                    	MOV	E,A
  05C8'   D2 05CC'              	JNC	SG_SET
  05CB'   14                    	INR	D
  05CC'                         SG_SET:
  05CC'   EB                    	XCHG
  05CD'   22 299E'              	SHLD	GOALCOL
  05D0'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  05D1'                         CWID:
  05D1'   FE 0D                 	CPI	CR
  05D3'   CA 05E2'              	JZ	CW_0
  05D6'   FE 09                 	CPI	TAB
  05D8'   3E 01                 	MVI	A,1
  05DA'   C0                    	RNZ
  05DB'   7D                    	MOV	A,L
  05DC'   E6 07                 	ANI	TABWID-1
  05DE'   2F                    	CMA
  05DF'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  05E1'   C9                    	RET
  05E2'                         CW_0:
  05E2'   AF                    	XRA	A
  05E3'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  05E4'                         BOL:
  05E4'                         BOL_LP:
  05E4'   7C                    	MOV	A,H
  05E5'   B5                    	ORA	L
  05E6'   C8                    	RZ			; at 0
  05E7'   2B                    	DCX	H		; look at off-1
  05E8'   E5                    	PUSH	H
  05E9'   CD 0000*              	CALL	CHARAT
  05EC'   E1                    	POP	H		; HL = off-1
  05ED'   FE 0A                 	CPI	LF
  05EF'   CA 05F5'              	JZ	BOL_DN
  05F2'   C3 05E4'              	JMP	BOL_LP
  05F5'                         BOL_DN:
  05F5'   23                    	INX	H		; line starts just after the LF
  05F6'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  05F7'                         EOLNL:
  05F7'   E5                    	PUSH	H
  05F8'   CD 0000*              	CALL	LOGLEN
  05FB'   22 29DE'              	SHLD	WKN
  05FE'   E1                    	POP	H
  05FF'                         ENL_LP:
  05FF'   EB                    	XCHG			; DE = i
  0600'   2A 29DE'              	LHLD	WKN
  0603'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0606'   EB                    	XCHG			; HL = i, DE = n
  0607'   D0                    	RNC			; i >= n: no LF on this line
  0608'   E5                    	PUSH	H
  0609'   CD 0000*              	CALL	CHARAT
  060C'   E1                    	POP	H
  060D'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  060F'   C8                    	RZ			; the LF: HL is its offset
  0610'   23                    	INX	H
  0611'   C3 05FF'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0614'                         NLSTART:
  0614'   CD 05F7'              	CALL	EOLNL
  0617'   E5                    	PUSH	H
  0618'   CD 0000*              	CALL	LOGLEN
  061B'   D1                    	POP	D		; DE = eol result
  061C'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  061F'   C8                    	RZ			; no next line: HL = LOGLEN
  0620'   EB                    	XCHG			; HL = eol
  0621'   23                    	INX	H
  0622'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0623'                         EOLC:
  0623'   E5                    	PUSH	H
  0624'   CD 05F7'              	CALL	EOLNL
  0627'   22 29E0'              	SHLD	WKTERM
  062A'   E1                    	POP	H
  062B'   CD 05E4'              	CALL	BOL
  062E'   22 29E2'              	SHLD	WKBOL
  0631'   2A 29E0'              	LHLD	WKTERM
  0634'   EB                    	XCHG			; DE = term
  0635'   2A 29E2'              	LHLD	WKBOL
  0638'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  063B'   CA 065A'              	JZ	EOLC_MT
  063E'   EB                    	XCHG			; HL = term
  063F'   2B                    	DCX	H		; term-1
  0640'   E5                    	PUSH	H
  0641'   CD 0000*              	CALL	CHARAT
  0644'   E1                    	POP	H		; HL = term-1
  0645'   FE 0D                 	CPI	CR
  0647'   CA 064D'              	JZ	EOLC_CR		; content ends at term-1
  064A'   C3 064E'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  064D'                         EOLC_CR:
  064D'   2B                    	DCX	H		; last = (term-1) - 1
  064E'                         EOLC_LS:
  064E'   EB                    	XCHG			; DE = last
  064F'   2A 29E2'              	LHLD	WKBOL
  0652'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0655'   DA 065A'              	JC	EOLC_MT
  0658'   EB                    	XCHG			; HL = last
  0659'   C9                    	RET
  065A'                         EOLC_MT:
  065A'   2A 29E2'              	LHLD	WKBOL
  065D'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  065E'                         COL:
  065E'   E5                    	PUSH	H
  065F'   CD 05E4'              	CALL	BOL
  0662'   D1                    	POP	D		; DE = off
  0663'   EB                    	XCHG			; HL = off, DE = bol
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  0664'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0667'                         ATENDQ:
  0667'   CD 0000*              	CALL	CUROFF
  066A'   E5                    	PUSH	H
  066B'   CD 0000*              	CALL	LOGLEN
  066E'   D1                    	POP	D		; DE = cur
  066F'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0672'                         CURCHR:
  0672'   CD 0000*              	CALL	CUROFF
  0675'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  0678'                         MOVCNT:
  0678'   CD 075A'              	CALL	SETMOV
  067B'   C3 068B'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  067E'                         CNTOFF:
  067E'   CD 068B'              	CALL	GETCNT
  0681'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0684'                         GBSUB:
  0684'   EB                    	XCHG
  0685'   2A 0000*              	LHLD	GAPBEG
  0688'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  068B'                         GETCNT:
  068B'   2A 2996'              	LHLD	CMDCNT
  068E'   7C                    	MOV	A,H
  068F'   B5                    	ORA	L
  0690'   C2 0697'              	JNZ	GC_HAVE
  0693'   21 0001               	LXI	H,1
  0696'   C9                    	RET
  0697'                         GC_HAVE:
  0697'   E5                    	PUSH	H
  0698'   21 0000               	LXI	H,0
  069B'   22 2996'              	SHLD	CMDCNT
  069E'   E1                    	POP	H
  069F'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  06A0'                         CNTTST:				; WM 1175
  06A0'   3A 2A48'              	LDA	BRKARM
  06A3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06A4'   C4 06CE'              	CNZ	BRKTST		; a ^C spends the count: every loop stops here
  06A7'   E5                    	PUSH	H
  06A8'   2A 2996'              	LHLD	CMDCNT
  06AB'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  06AE'   B4                    	ORA	H
  06AF'   B5                    	ORA	L
  06B0'   E1                    	POP	H
  06B1'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ^C -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where a ^C is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ^C.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ^C test unless an operator is waiting for this motion.
  06B4'                         BRKON:
  06B4'   21 2A43'              	LXI	H,SOFF
  06B7'   CD 044F'              	CALL	FPSTO
  06BA'   2A 0000*              	LHLD	LNDLT
  06BD'   22 2A46'              	SHLD	SLDLT
  06C0'   AF                    	XRA	A
  06C1'   32 2A49'              	STA	BRKHIT
  06C4'   3A 29C0'              	LDA	PSAVE
  06C7'   B7                    	ORA	A
  06C8'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  06C9'   3C                    	INR	A
  06CA'   32 2A48'              	STA	BRKARM
  06CD'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.
  06CE'                         BRKTST:
  06CE'   C5                    	PUSH	B
  06CF'   D5                    	PUSH	D
  06D0'   E5                    	PUSH	H
  06D1'   CD 0000*              	CALL	KBBRK
  06D4'   CA 06E7'              	JZ	BT_NO
  06D7'   32 2A49'              	STA	BRKHIT		; (A = FFH)
  06DA'   AF                    	XRA	A
  06DB'   32 2A48'              	STA	BRKARM		; the way back is not stopped in its turn
  06DE'   32 0000*              	STA	AUXCNT
  06E1'   21 0000               	LXI	H,0
  06E4'   22 2996'              	SHLD	CMDCNT
  06E7'                         BT_NO:
  06E7'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  06E8'   D1                    	POP	D
  06E9'   C1                    	POP	B
  06EA'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  06EB'                         BRKOFF:
  06EB'   AF                    	XRA	A
  06EC'   32 2A48'              	STA	BRKARM
                                ;BRKQ -- CY iff a ^C stopped it.
  06EF'                         BRKQ:
  06EF'   3A 2A49'              	LDA	BRKHIT
  06F2'   B7                    	ORA	A
  06F3'   C8                    	RZ
  06F4'   37                    	STC
  06F5'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  06F6'                         RSTPL:
  06F6'   21 2A43'              	LXI	H,SOFF
  06F9'   CD 03F6'              	CALL	BACKTO
  06FC'   2A 2A46'              	LHLD	SLDLT
  06FF'   22 0000*              	SHLD	LNDLT
  0702'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  0703'                         BRKBAK:
  0703'   CD 06F6'              	CALL	RSTPL
  0706'   CD 0000*              	CALL	KBFLSH
  0709'   21 22E7'              	LXI	H,SINTR
  070C'   C3 2249'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  070F'                         CLASSF:
  070F'   47                    	MOV	B,A
  0710'   FE 20                 	CPI	' '
  0712'   CA 0752'              	JZ	CLS0
  0715'   FE 09                 	CPI	TAB
  0717'   CA 0752'              	JZ	CLS0
  071A'   FE 0A                 	CPI	LF
  071C'   CA 0752'              	JZ	CLS0
  071F'   FE 0D                 	CPI	CR
  0721'   CA 0752'              	JZ	CLS0
  0724'   3A 29A0'              	LDA	WBIG
  0727'   B7                    	ORA	A
  0728'   C2 0754'              	JNZ	CLS1
  072B'   78                    	MOV	A,B
  072C'   FE 5F                 	CPI	'_'
  072E'   CA 0754'              	JZ	CLS1
  0731'   FE 30                 	CPI	'0'
  0733'   DA 0757'              	JC	CLS2
  0736'   FE 3A                 	CPI	'9'+1
  0738'   DA 0754'              	JC	CLS1
  073B'   FE 41                 	CPI	'A'
  073D'   DA 0757'              	JC	CLS2
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


  0740'   FE 5B                 	CPI	'Z'+1
  0742'   DA 0754'              	JC	CLS1
  0745'   FE 61                 	CPI	'a'
  0747'   DA 0757'              	JC	CLS2
  074A'   FE 7B                 	CPI	'z'+1
  074C'   DA 0754'              	JC	CLS1
  074F'   C3 0757'              	JMP	CLS2
  0752'   AF                    CLS0:	XRA	A
  0753'   C9                    	RET
  0754'   3E 01                 CLS1:	MVI	A,1
  0756'   C9                    	RET
  0757'   3E 02                 CLS2:	MVI	A,2
  0759'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  075A'                         SETMOV:
  075A'   3E 01                 	MVI	A,R_MOVE
  075C'   32 299A'              	STA	RINTENT
  075F'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0760'                         SETLIN:
  0760'   3E 02                 	MVI	A,R_LINE
  0762'   32 299A'              	STA	RINTENT
  0765'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0766'                         SETILN:
  0766'   3E 01                 	MVI	A,1
  0768'   32 299B'              	STA	ILN		; one line, unless a put overwrites it below
  076B'   3E 05                 	MVI	A,R_ILIN
  076D'   32 299A'              	STA	RINTENT
  0770'   AF                    	XRA	A
  0771'   32 299D'              	STA	ILABOV		; the row above the opened ones is untouched
  0774'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0775'                         SETJON:
  0775'   3E 06                 	MVI	A,R_JOIN
  0777'   32 299A'              	STA	RINTENT
  077A'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  077B'                         SETFUL:
  077B'   3E 00                 	MVI	A,R_FULL
  077D'   32 299A'              	STA	RINTENT
  0780'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0781'                         TAILTAB:
  0781'   CD 0000*              	CALL	CUROFF
  0784'   22 29DA'              	SHLD	TTI
  0787'                         TT_LP:
  0787'   2A 29DA'              	LHLD	TTI
  078A'   EB                    	XCHG			; DE = TTI
  078B'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  078E'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0791'   D2 07B1'              	JNC	TT_NO		; reached end of text -> no tab
  0794'   2A 29DA'              	LHLD	TTI
  0797'   CD 0000*              	CALL	CHARAT
  079A'   FE 0A                 	CPI	LF
  079C'   CA 07B1'              	JZ	TT_NO		; end of line -> no tab
  079F'   FE 09                 	CPI	TAB
  07A1'   CA 07AE'              	JZ	TT_YES
  07A4'   2A 29DA'              	LHLD	TTI
  07A7'   23                    	INX	H
  07A8'   22 29DA'              	SHLD	TTI
  07AB'   C3 0787'              	JMP	TT_LP
  07AE'                         TT_YES:
  07AE'   3E 01                 	MVI	A,1
  07B0'   C9                    	RET
  07B1'                         TT_NO:
  07B1'   AF                    	XRA	A
  07B2'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  07B3'                         VC_H:
  07B3'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07B6'   22 29D8'              	SHLD	CNTV
  07B9'                         VCH_LP:
  07B9'   2A 29D8'              	LHLD	CNTV
  07BC'   7C                    	MOV	A,H
  07BD'   B5                    	ORA	L
  07BE'   C8                    	RZ
  07BF'   2B                    	DCX	H
  07C0'   22 29D8'              	SHLD	CNTV
  07C3'   CD 07C9'              	CALL	HSTEP
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07C6'   C3 07B9'              	JMP	VCH_LP
  07C9'                         HSTEP:
  07C9'   CD 0000*              	CALL	CUROFF		; HL = cur
  07CC'   7C                    	MOV	A,H
  07CD'   B5                    	ORA	L
  07CE'   C8                    	RZ			; at 0
  07CF'   E5                    	PUSH	H
  07D0'   CD 05E4'              	CALL	BOL		; HL = bol
  07D3'   D1                    	POP	D		; DE = cur
  07D4'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  07D7'   C8                    	RZ			; at BOL, cannot go left
  07D8'   EB                    	XCHG			; HL = cur
  07D9'   2B                    	DCX	H
  07DA'   C3 057A'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  07DD'                         VC_L:
  07DD'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  07E0'   22 29D8'              	SHLD	CNTV
  07E3'                         VCL_LP:
  07E3'   2A 29D8'              	LHLD	CNTV
  07E6'   7C                    	MOV	A,H
  07E7'   B5                    	ORA	L
  07E8'   C8                    	RZ
  07E9'   2B                    	DCX	H
  07EA'   22 29D8'              	SHLD	CNTV
  07ED'   CD 07F3'              	CALL	LSTEP
  07F0'   C3 07E3'              	JMP	VCL_LP
  07F3'                         LSTEP:
  07F3'   CD 0000*              	CALL	CUROFF		; HL = cur
  07F6'   E5                    	PUSH	H
  07F7'   CD 0623'              	CALL	EOLC		; HL = eolc
  07FA'   D1                    	POP	D		; DE = cur
  07FB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  07FE'   D0                    	RNC			; cur >= eolc, cannot go right
  07FF'   EB                    	XCHG			; HL = cur
  0800'   23                    	INX	H
  0801'   C3 057A'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0804'                         VC_0:
  0804'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0807'   CD 0811'              	CALL	LNSTRT
  080A'   21 0000               	LXI	H,0
  080D'   22 299E'              	SHLD	GOALCOL
  0810'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0811'                         LNSTRT:
  0811'   CD 0F3A'              	CALL	ZSAVE
  0814'   21 0000               	LXI	H,0
  0817'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  081A'   E5                    	PUSH	H
  081B'   CD 0F4D'              	CALL	ZREST
  081E'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  081F'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0822'                         VC_CRT:
  0822'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0825'   C3 0828'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  0828'                         FNBLNK:
  0828'   CD 0811'              	CALL	LNSTRT
  082B'   CD 0000*              	CALL	RGET0
  082E'   11 0000               	LXI	D,0		; DE = blanks skipped
  0831'                         FN_LP:
  0831'   CD 0000*              	CALL	RDGET
  0834'   DA 0857'              	JC	FN_GO		; the end of the file
  0837'   FE 20                 	CPI	' '
  0839'   CA 0841'              	JZ	FN_WH
  083C'   FE 09                 	CPI	TAB
  083E'   C2 0857'              	JNZ	FN_GO		; a non-blank, or the line's end
  0841'                         FN_WH:
  0841'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0844'   DA 0857'              	JC	FN_GO
  0847'   FE 0D                 	CPI	CR
  0849'   CA 0857'              	JZ	FN_GO
  084C'   FE 0A                 	CPI	LF
  084E'   CA 0857'              	JZ	FN_GO
  0851'   2B                    	DCX	H		; not yet: read that char again
  0852'   03                    	INX	B
  0853'   13                    	INX	D
  0854'   C3 0831'              	JMP	FN_LP
  0857'                         FN_GO:
  0857'   D5                    	PUSH	D
  0858'   CD 0000*              	CALL	CUROFF
  085B'   D1                    	POP	D
  085C'   19                    	DAD	D
  085D'   C3 057A'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0860'                         VC_EOL:
  0860'   CD 075A'              	CALL	SETMOV
  0863'   21 FFFF               	LXI	H,0FFFFH
  0866'   22 299E'              	SHLD	GOALCOL
  0869'   CD 068B'              	CALL	GETCNT
  086C'   2B                    	DCX	H		; count-1
  086D'   7C                    	MOV	A,H
  086E'   B5                    	ORA	L
  086F'   CA 087E'              	JZ	VEOL_0
  0872'   E5                    	PUSH	H
  0873'   CD 0893'              	CALL	ONLAST
  0876'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  0877'   D8                    	RC			; the last line: no move (vim)
  0878'   CD 08D6'              	CALL	JCORE
  087B'   C3 0A25'              	JMP	JKLAND
  087E'                         VEOL_0:
  087E'   CD 0811'              	CALL	LNSTRT
  0881'   C3 0A25'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0884'                         VC_CR:
  0884'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0887'   E5                    	PUSH	H
  0888'   CD 0893'              	CALL	ONLAST
  088B'   E1                    	POP	H
  088C'   D8                    	RC
  088D'   CD 08D6'              	CALL	JCORE
  0890'   C3 0828'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0893'                         ONLAST:
  0893'   CD 0000*              	CALL	RGET0
  0896'                         OL_LP:
  0896'   CD 0000*              	CALL	RDGET
  0899'   D8                    	RC			; the file ends on this line
  089A'   FE 0A                 	CPI	LF
  089C'   C2 0896'              	JNZ	OL_LP
  089F'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  08A2'                         VC_J:
  08A2'   CD 075A'              	CALL	SETMOV
  08A5'   CD 08C0'              	CALL	GLCHK		; the goal column, from the cursor if stale
  08A8'   CD 068B'              	CALL	GETCNT		; HL = count
  08AB'   CD 08D6'              	CALL	JCORE
  08AE'   C3 0A25'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  08B1'                         VC_K:
  08B1'   CD 075A'              	CALL	SETMOV
  08B4'   CD 08C0'              	CALL	GLCHK
  08B7'   CD 068B'              	CALL	GETCNT
  08BA'   CD 0973'              	CALL	KCORE
  08BD'   C3 0A25'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08C0'                         GLCHK:
  08C0'   2A 299E'              	LHLD	GOALCOL
  08C3'   7C                    	MOV	A,H
  08C4'   3C                    	INR	A
  08C5'   C0                    	RNZ
  08C6'   7D                    	MOV	A,L
  08C7'   FE FE                 	CPI	0FEH
  08C9'   C0                    	RNZ
  08CA'   C3 057D'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  08CD'                         GLSTAL:
  08CD'   E5                    	PUSH	H
  08CE'   21 FFFE               	LXI	H,0FFFEH
  08D1'   22 299E'              	SHLD	GOALCOL
  08D4'   E1                    	POP	H
  08D5'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  08D6'                         JCORE:
  08D6'   7C                    	MOV	A,H
  08D7'   B5                    	ORA	L
  08D8'   C8                    	RZ
  08D9'   22 29A4'              	SHLD	JKCNT
  08DC'   CD 0CEC'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  08DF'   47                    	MOV	B,A
  08E0'   3A 0000*              	LDA	NEDIT
  08E3'   3D                    	DCR	A
  08E4'   90                    	SUB	B
  08E5'   5F                    	MOV	E,A
  08E6'   16 00                 	MVI	D,0
  08E8'   3A 0000*              	LDA	NEDIT
  08EB'   6F                    	MOV	L,A
  08EC'   26 00                 	MVI	H,0
  08EE'   19                    	DAD	D
  08EF'   EB                    	XCHG			; DE = limit
  08F0'   2A 29A4'              	LHLD	JKCNT
  08F3'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  08F6'   D2 08FA'              	JNC	JC_N
  08F9'   EB                    	XCHG			; HL = limit
  08FA'                         JC_N:
  08FA'   22 29A6'              	SHLD	JKN		; N = min(count, limit)
  08FD'   EB                    	XCHG			; DE = LFs to find
  08FE'   CD 0000*              	CALL	RGET0
  0901'                         JC_SC:
  0901'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0904'   DA 0923'              	JC	JC_EOF
  0907'   32 29AD'              	STA	JKLST
  090A'   FE 0A                 	CPI	LF
  090C'   C2 0901'              	JNZ	JC_SC
  090F'   1B                    	DCX	D
  0910'   7A                    	MOV	A,D
  0911'   B3                    	ORA	E
  0912'   C2 0901'              	JNZ	JC_SC
  0915'   2A 29A4'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0918'   22 29A8'              	SHLD	JKMOV		;   one if the last LF found ends the file
  091B'   3E 01                 	MVI	A,1
  091D'   32 29AC'              	STA	JKPHN
  0920'   C3 093E'              	JMP	JC_MV
  0923'                         JC_EOF:
  0923'   2A 29A6'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0926'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0929'   7C                    	MOV	A,H
  092A'   B5                    	ORA	L
  092B'   CA 0937'              	JZ	JC_AV
  092E'   3A 29AD'              	LDA	JKLST
  0931'   FE 0A                 	CPI	LF
  0933'   C2 0937'              	JNZ	JC_AV
  0936'   2B                    	DCX	H
  0937'                         JC_AV:
  0937'   22 29A8'              	SHLD	JKMOV
  093A'   AF                    	XRA	A
  093B'   32 29AC'              	STA	JKPHN
  093E'                         JC_MV:
  093E'   2A 29A4'              	LHLD	JKCNT
  0941'   AF                    	XRA	A
  0942'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0945'   CD 0A04'              	CALL	ATEOF
  0948'   D2 095C'              	JNC	JC_DN
  094B'   CD 0A0A'              	CALL	LASTLN		; ran past the last line: back onto it
  094E'   3A 29AC'              	LDA	JKPHN
  0951'   B7                    	ORA	A
  0952'   CA 095C'              	JZ	JC_DN
  0955'   2A 29A8'              	LHLD	JKMOV
  0958'   2B                    	DCX	H
  0959'   22 29A8'              	SHLD	JKMOV
  095C'                         JC_DN:
  095C'   2A 29A6'              	LHLD	JKN		; LNDLT += min(moved, N)
  095F'   EB                    	XCHG
  0960'   2A 29A8'              	LHLD	JKMOV
  0963'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0966'   D2 096A'              	JNC	JC_AD
  0969'   EB                    	XCHG
  096A'                         JC_AD:
  096A'   EB                    	XCHG			; DE = lines moved
  096B'   2A 0000*              	LHLD	LNDLT
  096E'   19                    	DAD	D
  096F'   22 0000*              	SHLD	LNDLT
  0972'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0973'                         KCORE:
  0973'   7C                    	MOV	A,H
  0974'   B5                    	ORA	L
  0975'   C8                    	RZ
  0976'   22 29A4'              	SHLD	JKCNT
  0979'   CD 0CEC'              	CALL	CURRW		; limit = row + NEDIT
  097C'   5F                    	MOV	E,A
  097D'   16 00                 	MVI	D,0
  097F'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  0982'   6F                    	MOV	L,A
  0983'   26 00                 	MVI	H,0
  0985'   19                    	DAD	D
  0986'   EB                    	XCHG			; DE = limit
  0987'   2A 29A4'              	LHLD	JKCNT
  098A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  098D'   D2 0991'              	JNC	KC_N
  0990'   EB                    	XCHG			; HL = limit
  0991'                         KC_N:
  0991'   22 29A6'              	SHLD	JKN		; N = min(count, limit)
  0994'   EB                    	XCHG			; DE = LFs to find
  0995'   21 0000               	LXI	H,0
  0998'   22 29AA'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  099B'                         KC_ED:
  099B'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  099C'   2A 29AA'              	LHLD	JKBK
  099F'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09A2'   E5                    	PUSH	H
  09A3'   EB                    	XCHG
  09A4'   2A 0000*              	LHLD	TXTBEG
  09A7'   EB                    	XCHG
  09A8'   CD 0000*              	CALL	SUBHD
  09AB'   44                    	MOV	B,H
  09AC'   4D                    	MOV	C,L
  09AD'   E1                    	POP	H
  09AE'   D1                    	POP	D
  09AF'                         KC_SC:
  09AF'   78                    	MOV	A,B
  09B0'   B1                    	ORA	C
  09B1'   CA 09C8'              	JZ	KC_TB
  09B4'   2B                    	DCX	H
  09B5'   0B                    	DCX	B
  09B6'   7E                    	MOV	A,M
  09B7'   FE 0A                 	CPI	LF
  09B9'   C2 09AF'              	JNZ	KC_SC
  09BC'   1B                    	DCX	D
  09BD'   7A                    	MOV	A,D
  09BE'   B3                    	ORA	E
  09BF'   C2 09AF'              	JNZ	KC_SC
  09C2'   2A 29A4'              	LHLD	JKCNT		; N lines above: the move is count lines
  09C5'   C3 09E8'              	JMP	KC_MV
  09C8'                         KC_TB:
  09C8'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  09C9'   CD 0684'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  09CC'   22 29AA'              	SHLD	JKBK
  09CF'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  09D2'   7C                    	MOV	A,H
  09D3'   B5                    	ORA	L
  09D4'   CA 09E1'              	JZ	KC_B0
  09D7'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  09DA'   D1                    	POP	D
  09DB'   DA 09E2'              	JC	KC_BOF
  09DE'   C3 099B'              	JMP	KC_ED
  09E1'                         KC_B0:
  09E1'   D1                    	POP	D
  09E2'                         KC_BOF:
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09E2'   2A 29A6'              	LHLD	JKN		; moved = LFs found
  09E5'   CD 0000*              	CALL	SUBHD
  09E8'                         KC_MV:
  09E8'   E5                    	PUSH	H
  09E9'   2A 29A4'              	LHLD	JKCNT
  09EC'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  09EF'   D1                    	POP	D		; DE = moved
  09F0'   2A 29A6'              	LHLD	JKN
  09F3'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  09F6'   DA 09FA'              	JC	KC_AD
  09F9'   EB                    	XCHG			; DE = N
  09FA'                         KC_AD:
  09FA'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  09FD'   CD 0000*              	CALL	SUBHD
  0A00'   22 0000*              	SHLD	LNDLT
  0A03'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0A04'                         ATEOF:
  0A04'   CD 0000*              	CALL	RGET0
  0A07'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0A0A'                         LASTLN:
  0A0A'   2A 0000*              	LHLD	GAPBEG
  0A0D'   EB                    	XCHG
  0A0E'   2A 0000*              	LHLD	TXTBEG
  0A11'   CD 0000*              	CALL	CMP16
  0A14'   21 0000               	LXI	H,0
  0A17'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0A1A'   1B                    	DCX	D
  0A1B'   1A                    	LDAX	D
  0A1C'   FE 0A                 	CPI	LF
  0A1E'   C2 0000*              	JNZ	SETBWD
  0A21'   23                    	INX	H
  0A22'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0A25'                         JKLAND:
  0A25'   21 0000               	LXI	H,0
  0A28'   22 29AE'              	SHLD	JKVC		; screen column
  0A2B'   2B                    	DCX	H
  0A2C'   22 29B0'              	SHLD	JKLS		; last content char: none yet
  0A2F'   CD 0000*              	CALL	RGET0
  0A32'   11 0000               	LXI	D,0		; DE = chars read
  0A35'                         JL_RD:
  0A35'   CD 0000*              	CALL	RDGET
  0A38'   DA 0A72'              	JC	JL_END
  0A3B'   FE 0A                 	CPI	LF
  0A3D'   CA 0A72'              	JZ	JL_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A40'   E5                    	PUSH	H
  0A41'   C5                    	PUSH	B
  0A42'   2A 29AE'              	LHLD	JKVC
  0A45'   CD 05D1'              	CALL	CWID
  0A48'   B7                    	ORA	A
  0A49'   CA 0A6C'              	JZ	JL_NX		; a CR
  0A4C'   EB                    	XCHG
  0A4D'   22 29B0'              	SHLD	JKLS		; the last content char so far
  0A50'   EB                    	XCHG
  0A51'   4F                    	MOV	C,A
  0A52'   06 00                 	MVI	B,0
  0A54'   09                    	DAD	B		; HL = the column after this char
  0A55'   22 29AE'              	SHLD	JKVC
  0A58'   D5                    	PUSH	D
  0A59'   EB                    	XCHG
  0A5A'   2A 299E'              	LHLD	GOALCOL
  0A5D'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0A60'   D1                    	POP	D
  0A61'   DA 0A6C'              	JC	JL_NX
  0A64'   CA 0A6C'              	JZ	JL_NX
  0A67'   C1                    	POP	B		; this char holds the goal column
  0A68'   E1                    	POP	H
  0A69'   C3 0A7D'              	JMP	JL_GO
