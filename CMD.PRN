  084F'   3D                    	DCR	A
  0850'   90                    	SUB	B
  0851'   5F                    	MOV	E,A
  0852'   16 00                 	MVI	D,0
  0854'   3A 0000*              	LDA	NEDIT
  0857'   6F                    	MOV	L,A
  0858'   26 00                 	MVI	H,0
  085A'   19                    	DAD	D
  085B'   EB                    	XCHG			; DE = limit
  085C'   2A 24BD'              	LHLD	JKCNT
  085F'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0862'   D2 0866'              	JNC	JC_N
  0865'   EB                    	XCHG			; HL = limit
  0866'                         JC_N:
  0866'   22 24BF'              	SHLD	JKN		; N = min(count, limit)
  0869'   EB                    	XCHG			; DE = LFs to find
  086A'   CD 0000*              	CALL	RGET0
  086D'                         JC_SC:
  086D'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0870'   DA 088F'              	JC	JC_EOF
  0873'   32 24C6'              	STA	JKLST
  0876'   FE 0A                 	CPI	LF
  0878'   C2 086D'              	JNZ	JC_SC
  087B'   1B                    	DCX	D
  087C'   7A                    	MOV	A,D
  087D'   B3                    	ORA	E
  087E'   C2 086D'              	JNZ	JC_SC
  0881'   2A 24BD'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0884'   22 24C1'              	SHLD	JKMOV		;   one if the last LF found ends the file
  0887'   3E 01                 	MVI	A,1
  0889'   32 24C5'              	STA	JKPHN
  088C'   C3 08AA'              	JMP	JC_MV
  088F'                         JC_EOF:
  088F'   2A 24BF'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0892'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
