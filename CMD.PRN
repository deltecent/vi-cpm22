  11CD'   C3 1139'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11D0'                         HTSCR:
  11D0'   CD 0EDE'              	CALL	CURRW
  11D3'   47                    	MOV	B,A
  11D4'   C3 11E2'              	JMP	HS_TP
  11D7'                         HTSET:
  11D7'   47                    	MOV	B,A
  11D8'   CD 0EDE'              	CALL	CURRW		; (keeps BC)
  11DB'   F5                    	PUSH	PSW
  11DC'   80                    	ADD	B
  11DD'   47                    	MOV	B,A
  11DE'   CD 11EC'              	CALL	HTRB
  11E1'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11E2'                         HS_TP:
  11E2'   3A 0000*              	LDA	HTCUR
  11E5'   90                    	SUB	B
  11E6'   32 0000*              	STA	HTTP
  11E9'   C3 11F8'              	JMP	HTPT
  11EC'                         HTRB:
  11EC'   CD 13DF'              	CALL	ZSAVE
  11EF'   CD 0000*              	CALL	HTBLD
  11F2'   CD 13F2'              	CALL	ZREST
  11F5'   3A 0000*              	LDA	HTCUR
  11F8'                         HTPT:
  11F8'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11F9'   16 00                 	MVI	D,0
  11FB'   21 0000*              	LXI	H,HTAB
  11FE'   19                    	DAD	D
  11FF'   3A 0000*              	LDA	HTN
  1202'   93                    	SUB	E
  1203'   47                    	MOV	B,A
  1204'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1205'                         HTIX:
  1205'   11 0000*              	LXI	D,HTAB
  1208'   7D                    	MOV	A,L
  1209'   93                    	SUB	E
  120A'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  120B'                         HTGO:
  120B'   CD 1205'              	CALL	HTIX
  120E'   47                    	MOV	B,A
  120F'   3A 0000*              	LDA	HTCUR
  1212'   90                    	SUB	B		; A = the lines up to it
  1213'   C3 0F15'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1216'                         HTFQ:
  1216'   78                    	MOV	A,B
  1217'   B7                    	ORA	A
  1218'   37                    	STC
  1219'   C8                    	RZ
  121A'   79                    	MOV	A,C
  121B'   96                    	SUB	M
  121C'   DA 1225'              	JC	HF_IN
  121F'   4F                    	MOV	C,A
  1220'   23                    	INX	H
  1221'   05                    	DCR	B
  1222'   C3 1216'              	JMP	HTFQ
  1225'                         HF_IN:
  1225'   B7                    	ORA	A
  1226'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1227'                         HTBQ:
  1227'   78                    	MOV	A,B
  1228'   B7                    	ORA	A
  1229'   37                    	STC
  122A'   C8                    	RZ
  122B'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122C'   05                    	DCR	B
  122D'   7E                    	MOV	A,M
  122E'   91                    	SUB	C
  122F'   D2 1238'              	JNC	HQ_IN
  1232'   2F                    	CMA
  1233'   3C                    	INR	A
  1234'   4F                    	MOV	C,A
  1235'   C3 1227'              	JMP	HTBQ
  1238'                         HQ_IN:
  1238'   4F                    	MOV	C,A
  1239'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  123A'                         RWQ:
  123A'   0E 64                 	MVI	C,100
  123C'   3A 0001*              	LDA	RWR+1
  123F'   B7                    	ORA	A
  1240'   C0                    	RNZ
  1241'   3A 0000*              	LDA	RWR
  1244'   B9                    	CMP	C
  1245'   D0                    	RNC
  1246'   4F                    	MOV	C,A
  1247'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1248'                         RWSUB:
  1248'   E5                    	PUSH	H
  1249'   5F                    	MOV	E,A
  124A'   16 00                 	MVI	D,0
  124C'   2A 0000*              	LHLD	RWR
  124F'   CD 0000*              	CALL	SUBHD
  1252'   22 0000*              	SHLD	RWR
  1255'   E1                    	POP	H
  1256'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1257'                         RWFWD:
  1257'   CD 123A'              	CALL	RWQ
  125A'   51                    	MOV	D,C
  125B'   CD 1216'              	CALL	HTFQ
  125E'   F5                    	PUSH	PSW
  125F'   7A                    	MOV	A,D
  1260'   91                    	SUB	C		; the rows that took it to that line's first
  1261'   CD 1248'              	CALL	RWSUB
  1264'   F1                    	POP	PSW
  1265'   DA 1279'              	JC	RF_OFF
  1268'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  126B'   B7                    	ORA	A
  126C'   C2 1283'              	JNZ	RF_GO
  126F'   3A 0000*              	LDA	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1272'   BE                    	CMP	M
  1273'   D2 1283'              	JNC	RF_GO
  1276'   4F                    	MOV	C,A
  1277'   B7                    	ORA	A
  1278'   C9                    	RET
  1279'                         RF_OFF:
  1279'   3A 0000*              	LDA	HTEOF
  127C'   B7                    	ORA	A
  127D'   CA 1283'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1280'   2B                    	DCX	H
  1281'   37                    	STC
  1282'   C9                    	RET
  1283'                         RF_GO:
  1283'   CD 120B'              	CALL	HTGO
  1286'   3E 01                 	MVI	A,1
  1288'   32 0000*              	STA	RWMV
  128B'   CD 123A'              	CALL	RWQ
  128E'   0C                    	INR	C
  128F'   06 00                 	MVI	B,0
  1291'   CD 11EC'              	CALL	HTRB
  1294'   C3 1257'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1297'                         RWBAK:
  1297'   CD 123A'              	CALL	RWQ
  129A'   51                    	MOV	D,C
  129B'   CD 1227'              	CALL	HTBQ
  129E'   DA 12BB'              	JC	RB_OFF
  12A1'   7A                    	MOV	A,D
  12A2'   81                    	ADD	C
  12A3'   5F                    	MOV	E,A		; E = the rows up to that line's first
  12A4'   3A 0001*              	LDA	RWR+1
  12A7'   B7                    	ORA	A
  12A8'   C2 12B7'              	JNZ	RB_ON
  12AB'   3A 0000*              	LDA	RWR
  12AE'   57                    	MOV	D,A
  12AF'   7B                    	MOV	A,E
  12B0'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  12B1'   DA 12B7'              	JC	RB_ON
  12B4'   4F                    	MOV	C,A
  12B5'   B7                    	ORA	A
  12B6'   C9                    	RET
  12B7'                         RB_ON:
  12B7'   7B                    	MOV	A,E
  12B8'   C3 12C2'              	JMP	RB_GO
  12BB'                         RB_OFF:
  12BB'   3A 0000*              	LDA	HTBOF
  12BE'   0F                    	RRC			; CY: that is the file's first line
  12BF'   D8                    	RC
  12C0'   7A                    	MOV	A,D
  12C1'   91                    	SUB	C
  12C2'                         RB_GO:
  12C2'   CD 1248'              	CALL	RWSUB
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12C5'   CD 120B'              	CALL	HTGO
  12C8'   3E 01                 	MVI	A,1
  12CA'   32 0000*              	STA	RWMV
  12CD'   CD 123A'              	CALL	RWQ
  12D0'   41                    	MOV	B,C
  12D1'   0E 01                 	MVI	C,1
  12D3'   CD 11EC'              	CALL	HTRB
  12D6'   43                    	MOV	B,E
  12D7'   C3 1297'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12DA'                         ONFST:
  12DA'   E5                    	PUSH	H
  12DB'   2A 0000*              	LHLD	OUTPOS
  12DE'   7C                    	MOV	A,H
  12DF'   B5                    	ORA	L
  12E0'   C2 12F8'              	JNZ	OF_RET
  12E3'   2A 0000*              	LHLD	TXTBEG
  12E6'   EB                    	XCHG			; DE = TXTBEG
  12E7'   2A 0000*              	LHLD	GAPBEG
  12EA'                         OF_LP:
  12EA'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12ED'   CA 12F8'              	JZ	OF_RET
  12F0'   2B                    	DCX	H
  12F1'   7E                    	MOV	A,M
  12F2'   FE 0A                 	CPI	LF
  12F4'   C2 12EA'              	JNZ	OF_LP
  12F7'   B7                    	ORA	A		; NZ
  12F8'                         OF_RET:
  12F8'   E1                    	POP	H
  12F9'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12FA'                         HFCNT:
  12FA'   2A 0000*              	LHLD	CMDCNT
  12FD'   7C                    	MOV	A,H
  12FE'   B5                    	ORA	L
  12FF'   CA 1316'              	JZ	HFC_AM
  1302'   CD 079C'              	CALL	GETCNT		; HL = count; clears it
  1305'   3A 0000*              	LDA	NEDIT
  1308'   5F                    	MOV	E,A
  1309'   16 00                 	MVI	D,0
  130B'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  130E'   D2 1312'              	JNC	HFC_ST
  1311'   EB                    	XCHG			; HL = NEDIT
  1312'                         HFC_ST:
  1312'   7D                    	MOV	A,L
  1313'   32 0000*              	STA	HFAMT
  1316'                         HFC_AM:
  1316'   3A 0000*              	LDA	HFAMT
  1319'   B7                    	ORA	A
  131A'   C2 1327'              	JNZ	HFC_HL
  131D'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1320'   B7                    	ORA	A
  1321'   1F                    	RAR
  1322'   B7                    	ORA	A
  1323'   C2 1327'              	JNZ	HFC_HL
  1326'   3C                    	INR	A		; at least one row
  1327'                         HFC_HL:
  1327'   32 0000*              	STA	HFN
  132A'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  132B'                         VC_REDR:
  132B'   C3 079C'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  132E'                         VC_G:
  132E'   CD 0871'              	CALL	SETMOV
  1331'   CD 1405'              	CALL	GZONE		; the screen's top line, before the move
  1334'   CD 07C5'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1337'   2A 0000*              	LHLD	CMDCNT
  133A'   7C                    	MOV	A,H
  133B'   B5                    	ORA	L
  133C'   C2 134F'              	JNZ	VG_N
  133F'   AF                    	XRA	A		; forward
  1340'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1343'   CD 0802'              	CALL	BRKOFF
  1346'   DA 081A'              	JC	BRKBAK
  1349'   CD 0C00'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  134C'   C3 141D'              	JMP	GPLACE
  134F'                         VG_N:
  134F'   CD 079C'              	CALL	GETCNT		; HL = target line (1-based)
  1352'                         VG_LN:
  1352'   CD 135E'              	CALL	GOLN
  1355'   CD 0802'              	CALL	BRKOFF
  1358'   DA 081A'              	JC	BRKBAK
  135B'   C3 141D'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;to go back to line 1 and count forward from there, whatever the distance.
                                ;A line less than half as far down as the window's top, on a file not changed
                                ;since it was opened or written, is the exception: PGJUMP reads the file
                                ;again from its start and the move counts forward from line 1 (#34 part B).
  135E'                         GOLN:
  135E'   E5                    	PUSH	H
  135F'   CD 0000*              	CALL	CNTLF
  1362'   23                    	INX	H		; HL = the cursor's line
  1363'   D1                    	POP	D		; DE = the line wanted
  1364'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1367'   DA 1372'              	JC	GLN_BK
  136A'   EB                    	XCHG
  136B'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  136E'   AF                    	XRA	A
  136F'   C3 138C'              	JMP	GLN_MV
  1372'                         GLN_BK:
  1372'   E5                    	PUSH	H
  1373'   D5                    	PUSH	D
  1374'   2A 0000*              	LHLD	TOPLF
  1377'   EB                    	XCHG			; DE = the lines behind the window
  1378'   2B                    	DCX	H		; HL = the lines above the one wanted
  1379'   CD 0000*              	CALL	PGJUMP
  137C'   D1                    	POP	D
  137D'   E1                    	POP	H
  137E'   D2 1387'              	JNC	GLN_UP
  1381'   EB                    	XCHG			; it jumped: the cursor is on line 1
  1382'   2B                    	DCX	H		; HL = the lines down to it
  1383'   AF                    	XRA	A
  1384'   C3 138C'              	JMP	GLN_MV
  1387'                         GLN_UP:
  1387'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  138A'   3E FF                 	MVI	A,0FFH
  138C'                         GLN_MV:
  138C'   CD 0000*              	CALL	MVLIND
  138F'   CD 0BFA'              	CALL	ATEOF
  1392'   DC 0C00'              	CC	LASTLN		; past the last line: onto it
  1395'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1396'                         VC_LG:
  1396'   CD 0871'              	CALL	SETMOV
  1399'   3A 0000*              	LDA	GSAVE
  139C'   B7                    	ORA	A
  139D'   C2 13A6'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  13A0'   3E 01                 	MVI	A,PG
  13A2'   32 0000*              	STA	GPEND
  13A5'   C9                    	RET
  13A6'                         VLG_GG:
  13A6'   CD 1405'              	CALL	GZONE
  13A9'   CD 07C5'              	CALL	BRKON
  13AC'   CD 079C'              	CALL	GETCNT		; HL = target line (no count: 1)
  13AF'   C3 1352'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13B2'                         SUB24:
  13B2'   4F                    	MOV	C,A
  13B3'   7D                    	MOV	A,L
  13B4'   93                    	SUB	E
  13B5'   6F                    	MOV	L,A
  13B6'   7C                    	MOV	A,H
  13B7'   9A                    	SBB	D
  13B8'   67                    	MOV	H,A
  13B9'   79                    	MOV	A,C
  13BA'   98                    	SBB	B
  13BB'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  13BC'                         CURFP:
  13BC'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  13BF'                         FPOS:
  13BF'   C5                    	PUSH	B
  13C0'   D5                    	PUSH	D
  13C1'   EB                    	XCHG
  13C2'   2A 0000*              	LHLD	TXTBEG
  13C5'   EB                    	XCHG
  13C6'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  13C9'   EB                    	XCHG			; DE = that
  13CA'   2A 0000*              	LHLD	OUTPOS
  13CD'   7C                    	MOV	A,H
  13CE'   B7                    	ORA	A		; CY = 0
  13CF'   1F                    	RAR
  13D0'   47                    	MOV	B,A
  13D1'   7D                    	MOV	A,L
  13D2'   1F                    	RAR
  13D3'   67                    	MOV	H,A
  13D4'   3E 00                 	MVI	A,0
  13D6'   1F                    	RAR
  13D7'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13D8'   19                    	DAD	D
  13D9'   78                    	MOV	A,B
  13DA'   CE 00                 	ACI	0		; A:HL = the position
  13DC'   D1                    	POP	D
  13DD'   C1                    	POP	B
  13DE'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13DF'                         ZSAVE:
  13DF'   2A 0000*              	LHLD	CMDCNT
  13E2'   22 0000*              	SHLD	ZSVCNT
  13E5'   2A 0000*              	LHLD	AUXCNT
  13E8'   22 0000*              	SHLD	ZSVAUX
  13EB'   3A 0000*              	LDA	DIRFLG
  13EE'   32 0000*              	STA	ZSVDIR
  13F1'   C9                    	RET
  13F2'                         ZREST:
  13F2'   2A 0000*              	LHLD	ZSVCNT
  13F5'   22 0000*              	SHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  13F8'   2A 0000*              	LHLD	ZSVAUX
  13FB'   22 0000*              	SHLD	AUXCNT
  13FE'   3A 0000*              	LDA	ZSVDIR
  1401'   32 0000*              	STA	DIRFLG
  1404'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1405'                         GZONE:
  1405'   CD 13DF'              	CALL	ZSAVE
  1408'   CD 0EDE'              	CALL	CURRW
  140B'   6F                    	MOV	L,A
  140C'   26 00                 	MVI	H,0
  140E'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1411'   CD 13BF'              	CALL	FPOS
  1414'   22 0000*              	SHLD	ZTOP
  1417'   32 0002*              	STA	ZTOP+2
  141A'   C3 13F2'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  141D'                         GPLACE:
  141D'   CD 13DF'              	CALL	ZSAVE
  1420'   CD 13BC'              	CALL	CURFP
  1423'   EB                    	XCHG
  1424'   2A 0000*              	LHLD	ZTOP
  1427'   EB                    	XCHG
  1428'   4F                    	MOV	C,A		; C:HL = the target's position
  1429'   3A 0002*              	LDA	ZTOP+2
  142C'   47                    	MOV	B,A		; B:DE = the top's
  142D'   79                    	MOV	A,C
  142E'   CD 13B2'              	CALL	SUB24
  1431'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1434'   DA 146E'              	JC	GP_UP
  1437'   B7                    	ORA	A
  1438'   C2 14B4'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  143B'   3A 0000*              	LDA	NEDIT
  143E'   87                    	ADD	A
  143F'   3C                    	INR	A
  1440'   6F                    	MOV	L,A
  1441'   26 00                 	MVI	H,0
  1443'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1446'   CD 0795'              	CALL	GBSUB		; HL = bytes from there to the target
  1449'   EB                    	XCHG
  144A'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  144D'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1450'   DA 14B4'              	JC	GP_MID
  1453'   CD 0795'              	CALL	GBSUB		; HL = the top line's start (resident)
  1456'   01 0000               	LXI	B,0		; BC = lines from the top
  1459'                         GP_CNT:
  1459'   7A                    	MOV	A,D
  145A'   B3                    	ORA	E
  145B'   CA 146A'              	JZ	GP_DN
  145E'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  145F'   23                    	INX	H
  1460'   1B                    	DCX	D
  1461'   FE 0A                 	CPI	LF
  1463'   C2 1459'              	JNZ	GP_CNT
  1466'   03                    	INX	B
  1467'   C3 1459'              	JMP	GP_CNT
  146A'                         GP_DN:
  146A'   79                    	MOV	A,C		; the lines from the top one to it
  146B'   C3 14DE'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  146E'                         GP_UP:
  146E'   3C                    	INR	A
  146F'   C2 14B4'              	JNZ	GP_MID		; 64K bytes or more above
  1472'   2A 0000*              	LHLD	ZDIF
  1475'   EB                    	XCHG
  1476'   21 0000               	LXI	H,0
  1479'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  147C'   7C                    	MOV	A,H
  147D'   B5                    	ORA	L
  147E'   CA 14B4'              	JZ	GP_MID		; exactly 64K
  1481'   EB                    	XCHG			; DE = bytes to read
  1482'   AF                    	XRA	A
  1483'   32 0000*              	STA	ZLF
  1486'   CD 0000*              	CALL	RGET0
  1489'                         GP_RD:
  1489'   CD 0000*              	CALL	RDGET		; (keeps DE)
  148C'   DA 14B4'              	JC	GP_MID
  148F'   FE 0A                 	CPI	LF
  1491'   C2 14A5'              	JNZ	GP_RN
  1494'   3A 0000*              	LDA	NEDIT
  1497'   B7                    	ORA	A
  1498'   1F                    	RAR
  1499'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  149B'   E5                    	PUSH	H
  149C'   21 0000*              	LXI	H,ZLF
  149F'   34                    	INR	M
  14A0'   BE                    	CMP	M		; CY iff more lines than that
  14A1'   E1                    	POP	H
  14A2'   DA 14B4'              	JC	GP_MID
  14A5'                         GP_RN:
  14A5'   1B                    	DCX	D
  14A6'   7A                    	MOV	A,D
  14A7'   B3                    	ORA	E
  14A8'   C2 1489'              	JNZ	GP_RD
  14AB'   3E 01                 	MVI	A,PL_SET	; the top row
  14AD'   32 0000*              	STA	PLACE
  14B0'   AF                    	XRA	A
  14B1'   C3 14BE'              	JMP	GP_SET
  14B4'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  14B4'   3E 02                 	MVI	A,PL_MID
  14B6'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  14B9'   3A 0000*              	LDA	NEDIT
  14BC'   B7                    	ORA	A
  14BD'   1F                    	RAR			; (no more lines above it than this)
  14BE'                         GP_SET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14BE'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  14BF'   26 00                 	MVI	H,0
  14C1'   22 0000*              	SHLD	WINROW
  14C4'   21 0000               	LXI	H,0
  14C7'   22 0000*              	SHLD	LNDLT
  14CA'   CD 08AE'              	CALL	SETFUL		; the window may have paged: full repaint
  14CD'                         GP_FIN:
  14CD'   CD 13F2'              	CALL	ZREST
  14D0'   3A 0000*              	LDA	GPKEEP
  14D3'   B7                    	ORA	A
  14D4'   CA 0977'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14D7'   AF                    	XRA	A
  14D8'   32 0000*              	STA	GPKEEP
  14DB'   C3 0630'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14DE'                         GP_ONS:
  14DE'   6F                    	MOV	L,A
  14DF'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14E1'   EB                    	XCHG
  14E2'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14E5'   EB                    	XCHG
  14E6'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14E9'   22 0000*              	SHLD	LNDLT
  14EC'   3E 01                 	MVI	A,R_MOVE
  14EE'   32 0000*              	STA	RINTENT
  14F1'   C3 14CD'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14F4'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  14F4'   AF                    	XRA	A
  14F5'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14F8'   3A 0000*              	LDA	PSAVE
  14FB'   FE 63                 	CPI	'c'
  14FD'   C2 151A'              	JNZ	OPP_ND
  1500'   79                    	MOV	A,C
  1501'   FE 77                 	CPI	'w'
  1503'   CA 150B'              	JZ	OPP_W
  1506'   FE 57                 	CPI	'W'
  1508'   C2 151A'              	JNZ	OPP_ND
  150B'                         OPP_W:
  150B'   CD 171A'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  150E'   DA 151A'              	JC	OPP_ND
  1511'   79                    	MOV	A,C
  1512'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1514'   4F                    	MOV	C,A
  1515'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1517'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  151A'                         OPP_ND:
  151A'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  151B'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  151D'   C2 1531'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1520'   CD 01FC'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1523'   DA 15EE'              	JC	OPABRT
  1526'   79                    	MOV	A,C
  1527'   FE 67                 	CPI	'g'
  1529'   C2 15EE'              	JNZ	OPABRT
  152C'   3E 01                 	MVI	A,PG
  152E'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1531'                         OPP_NG:
  1531'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1532'   21 0000*              	LXI	H,PSAVE
  1535'   BE                    	CMP	M
  1536'   CA 173B'              	JZ	OPLINE
  1539'   79                    	MOV	A,C		; (OPCLS classifies the key)
  153A'   CD 1751'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  153D'   DA 1577'              	JC	OPP_NM		;   -- and not a mark, so nothing is owed below
  1540'   32 0000*              	STA	OPCLSV
  1543'   47                    	MOV	B,A		; B = the class
  1544'   3A 0000*              	LDA	PSAVE
  1547'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1549'   C2 1555'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  154C'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  154D'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  154F'   C2 159C'              	JNZ	OPP_GO
  1552'   C3 1560'              	JMP	OPP_NO
  1555'                         OPP_NC:
  1555'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1557'   C2 159C'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  155A'   78                    	MOV	A,B		;   a charwise register would need a type flag
  155B'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  155D'   CA 159C'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1560'                         OPP_NO:
  1560'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1561'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1563'   CA 1571'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1566'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1568'   CA 1571'              	JZ	OPP_SW		;   so swallow it before dropping the command
  156B'   CD 0329'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  156E'   C2 15EE'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1571'                         OPP_SW:
  1571'   CD 01FC'              	CALL	MKGETK
  1574'   C3 15EE'              	JMP	OPABRT
                                ;OPP_NM -- not a motion.  A search ('/' '?' 'n' 'N') is one in vim, but not
                                ; here yet (issue #44), and it is the one drop that cannot be silent: a '/' or
                                ; '?' left to the next dispatch reads no line, so 'd/QJQK<CR>' would run the
                                ; pattern as commands ('J' joins two lines).  So the line is read the way a
                                ; search reads it, and thrown away, and the bell says nothing was done.
  1577'                         OPP_NM:
  1577'   79                    	MOV	A,C
  1578'   FE 2F                 	CPI	'/'
  157A'   CA 158C'              	JZ	OPP_SL
  157D'   FE 3F                 	CPI	'?'
  157F'   CA 158C'              	JZ	OPP_SL
  1582'   E6 DF                 	ANI	0DFH		; 'n' -> 'N'
  1584'   FE 4E                 	CPI	'N'
  1586'   C2 15EE'              	JNZ	OPABRT		; any other key: dropped, as before
  1589'   C3 1594'              	JMP	OPP_BL
  158C'                         OPP_SL:
  158C'   11 0000*              	LXI	D,EXBUF		; the ':' line's buffer, free between commands;
  158F'   06 28                 	MVI	B,EXMAX		;   C is the key, and so the prompt.  A cancel
  1591'   CD 2194'              	CALL	RDLINE		;   (ESC, or BS on an empty line) rings too
  1594'                         OPP_BL:
  1594'   0E 07                 	MVI	C,BEL
  1596'   CD 0000*              	CALL	BCONOU
  1599'   C3 15EE'              	JMP	OPABRT
  159C'                         OPP_GO:
  159C'   AF                    	XRA	A
  159D'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  15A0'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  15A3'   22 0000*              	SHLD	OPSTA
  15A6'   C5                    	PUSH	B
  15A7'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  15AA'   CD 0448'              	CALL	FPSTO		;   only good until the motion pages the window
  15AD'   3A 0000*              	LDA	OPCLSV
  15B0'   FE 02                 	CPI	2
  15B2'   CC 15F1'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  15B5'   C1                    	POP	B
  15B6'   21 315A'              	LXI	H,CMDTAB
  15B9'   CD 00C6'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  15BC'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  15BF'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  15C0'   CA 0871'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  15C3'   3A 0000*              	LDA	OPCLSV
  15C6'   FE 02                 	CPI	2
  15C8'   CC 0964'              	CZ	LNEND		; a line motion: the line it landed on whole, or
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  15CB'   CD 161D'              	CALL	OPSFIX		; where the start is in the window NOW
  15CE'   D2 1639'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  15D1'   22 0000*              	SHLD	OPSTA
  15D4'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  15D7'   22 0000*              	SHLD	OPEND2
  15DA'   3A 0000*              	LDA	PSAVE
  15DD'   FE 79                 	CPI	'y'
  15DF'   CA 1CF3'              	JZ	OPYANK		; a yank takes the span without losing it
  15E2'   CD 178C'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  15E5'   3A 0000*              	LDA	PSAVE
  15E8'   FE 63                 	CPI	'c'
  15EA'   C0                    	RNZ
  15EB'   C3 1AA7'              	JMP	SETINS
  15EE'                         OPABRT:				; not a motion -> the operator is dropped and
  15EE'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  15F1'                         OPENDS:
  15F1'   2A 0000*              	LHLD	OPSTA
  15F4'   CD 0697'              	CALL	BOL
  15F7'   11 0000*              	LXI	D,OPSLO
  15FA'   CD 160F'              	CALL	OPE_ST
  15FD'   2A 0000*              	LHLD	OPSTA
  1600'   CD 072E'              	CALL	NLSTART
  1603'   11 0000*              	LXI	D,OPSHI
  1606'   CD 160F'              	CALL	OPE_ST
  1609'   2A 0000*              	LHLD	OPSTA
  160C'   C3 0000*              	JMP	GOTO
  160F'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  160F'   D5                    	PUSH	D
  1610'   CD 0000*              	CALL	GOTO
  1613'   E1                    	POP	H
  1614'   C3 0448'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1617'                         CURBD:
  1617'   CD 13BC'              	CALL	CURFP
  161A'   EB                    	XCHG
  161B'   47                    	MOV	B,A
  161C'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  161D'                         OPSFIX:
  161D'   21 0000*              	LXI	H,OPSFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1620'   CD 03FB'              	CALL	MKLOAD
  1623'   CD 1617'              	CALL	CURBD
  1626'   2A 0000*              	LHLD	MKPOS
  1629'   3A 0002*              	LDA	MKPOS+2
  162C'   CD 13B2'              	CALL	SUB24
  162F'   B4                    	ORA	H
  1630'   B5                    	ORA	L
  1631'   C2 0408'              	JNZ	MKWIN
  1634'   CD 0000*              	CALL	CUROFF
  1637'   37                    	STC
  1638'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1639'                         OPPGD:
  1639'   47                    	MOV	B,A
  163A'   3A 0000*              	LDA	OPCLSV
  163D'   FE 02                 	CPI	2
  163F'   C2 16FB'              	JNZ	OPG_NO
  1642'   3A 0000*              	LDA	PSAVE
  1645'   FE 64                 	CPI	'd'
  1647'   C2 16FB'              	JNZ	OPG_NO
  164A'   04                    	INR	B
  164B'   CA 165A'              	JZ	OPG_FW
  164E'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1651'   CD 0697'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1654'   CD 0000*              	CALL	GOTO
  1657'   C3 1672'              	JMP	OPG_GO
  165A'                         OPG_FW:
  165A'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  165D'   CD 072E'              	CALL	NLSTART		;   landed on, and the low one is where the
  1660'   11 0000*              	LXI	D,OPSHI		;   start line began
  1663'   CD 160F'              	CALL	OPE_ST
  1666'   21 0000*              	LXI	H,OPSLO
  1669'   CD 03FB'              	CALL	MKLOAD
  166C'   CD 03AC'              	CALL	MKPAGE
  166F'   CD 0000*              	CALL	GOTO
  1672'                         OPG_GO:
  1672'   CD 1617'              	CALL	CURBD
  1675'   2A 0000*              	LHLD	OPSHI
  1678'   3A 0002*              	LDA	OPSHI+2
  167B'   CD 13B2'              	CALL	SUB24		; A:HL = the bytes to take
  167E'                         OPG_SV:
  167E'   22 0000*              	SHLD	OPTOGO
  1681'   32 0002*              	STA	OPTOGO+2
  1684'                         OPG_NX:
  1684'   CD 0778'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1687'   CD 0000*              	CALL	SUBHD
  168A'   EB                    	XCHG			; DE = what the window holds past the cursor
  168B'   2A 0000*              	LHLD	OPTOGO
  168E'   3A 0002*              	LDA	OPTOGO+2
  1691'   B7                    	ORA	A
  1692'   C2 16C5'              	JNZ	OPG_PG		; 64K or more to go
  1695'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1698'   DA 16C5'              	JC	OPG_PG
  169B'   CA 16C5'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  169E'                         OPG_FN:				; the rest of it is here
  169E'   E5                    	PUSH	H
  169F'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  16A2'   CD 0000*              	CALL	CUROFF
  16A5'   22 0000*              	SHLD	OPLO
  16A8'   D1                    	POP	D
  16A9'   19                    	DAD	D
  16AA'   22 0000*              	SHLD	OPHI
  16AD'   CD 18BF'              	CALL	OPDSPN
  16B0'   CD 0BFA'              	CALL	ATEOF
  16B3'   D2 1714'              	JNC	OPMID
  16B6'   CD 12DA'              	CALL	ONFST		; deleted to the end of the file: onto the new
  16B9'   CA 1714'              	JZ	OPMID		;   last line, if there is one -- and the pager
  16BC'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  16BF'   CD 0000*              	CALL	SETBWD
  16C2'   C3 1714'              	JMP	OPMID
  16C5'                         OPG_PG:
  16C5'   7A                    	MOV	A,D
  16C6'   B3                    	ORA	E
  16C7'   C2 16E0'              	JNZ	OPG_DL
  16CA'   CD 0BFA'              	CALL	ATEOF		; nothing held past the cursor
  16CD'   21 0000               	LXI	H,0
  16D0'   DA 169E'              	JC	OPG_FN		; ... and no more to come: the file ran out
  16D3'   2B                    	DCX	H
  16D4'   CD 0000*              	CALL	SETC0
  16D7'   CD 0000*              	CALL	GOLINE
  16DA'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  16DD'   C3 1684'              	JMP	OPG_NX
  16E0'                         OPG_DL:
  16E0'   D5                    	PUSH	D
  16E1'   21 FFFF               	LXI	H,0FFFFH
  16E4'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  16E7'   E1                    	POP	H
  16E8'   E5                    	PUSH	H
  16E9'   CD 0000*              	CALL	DELFWD
  16EC'   D1                    	POP	D
  16ED'   06 00                 	MVI	B,0
  16EF'   2A 0000*              	LHLD	OPTOGO
  16F2'   3A 0002*              	LDA	OPTOGO+2
  16F5'   CD 13B2'              	CALL	SUB24
  16F8'   C3 167E'              	JMP	OPG_SV
  16FB'                         OPG_NO:
  16FB'   0E 07                 	MVI	C,BEL
  16FD'   CD 0000*              	CALL	BCONOU
  1700'                         OPG_HM:				; the cursor back where the command found it
  1700'   21 0000*              	LXI	H,OPSFP
  1703'   CD 03FB'              	CALL	MKLOAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1706'   CD 03AC'              	CALL	MKPAGE
  1709'   CD 0000*              	CALL	GOTO
  170C'   AF                    	XRA	A
  170D'   32 0000*              	STA	PSAVE
  1710'   3C                    	INR	A
  1711'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1714'                         OPMID:
  1714'   CD 13DF'              	CALL	ZSAVE
  1717'   C3 14B4'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  171A'                         ONWHIT:
  171A'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  171D'   CA 1739'              	JZ	OW_YES
  1720'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1723'   FE 20                 	CPI	' '
  1725'   CA 1739'              	JZ	OW_YES
  1728'   FE 09                 	CPI	TAB
  172A'   CA 1739'              	JZ	OW_YES
  172D'   FE 0D                 	CPI	CR
  172F'   CA 1739'              	JZ	OW_YES
  1732'   FE 0A                 	CPI	LF
  1734'   CA 1739'              	JZ	OW_YES
  1737'   B7                    	ORA	A		; a char to change: CY clear
  1738'   C9                    	RET
  1739'                         OW_YES:
  1739'   37                    	STC
  173A'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  173B'                         OPLINE:
  173B'   3A 0000*              	LDA	PSAVE
  173E'   FE 63                 	CPI	'c'
  1740'   CA 0871'              	JZ	SETMOV
  1743'   FE 79                 	CPI	'y'
  1745'   CA 1CD2'              	JZ	VY_YY
  1748'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  174B'   CD 0448'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  174E'   C3 1C48'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1751'                         OPCLS:
  1751'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1753'   CA 1760'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1756'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1758'   C2 1774'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  175B'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  175D'   C3 1762'              	JMP	OPC_FK
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1760'                         OPC_SEM:
  1760'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1762'                         OPC_FK:
  1762'   3A 0000*              	LDA	FNDKND
  1765'   B7                    	ORA	A
  1766'   37                    	STC
  1767'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1768'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1769'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  176B'   CA 1772'              	JZ	OPC_EXC
  176E'   3E 01                 	MVI	A,1
  1770'   B7                    	ORA	A		; CY clear: a motion, class 1
  1771'   C9                    	RET
  1772'                         OPC_EXC:
  1772'   AF                    	XRA	A		; class 0, CY clear
  1773'   C9                    	RET
  1774'                         OPC_TB:
  1774'   47                    	MOV	B,A
  1775'   21 1964'              	LXI	H,OPCTAB
  1778'                         OPC_LP:
  1778'   7E                    	MOV	A,M
  1779'   B7                    	ORA	A
  177A'   CA 178A'              	JZ	OPC_MS		; end of table -> not a motion
  177D'   B8                    	CMP	B
  177E'   CA 1786'              	JZ	OPC_HT
  1781'   23                    	INX	H
  1782'   23                    	INX	H
  1783'   C3 1778'              	JMP	OPC_LP
  1786'                         OPC_HT:
  1786'   23                    	INX	H
  1787'   7E                    	MOV	A,M		; class byte
  1788'   B7                    	ORA	A		; clear CY
  1789'   C9                    	RET
  178A'                         OPC_MS:
  178A'   37                    	STC
  178B'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  178C'                         OPAPPL:
  178C'   3A 0000*              	LDA	OPCLSV
  178F'   FE 02                 	CPI	2
  1791'   CA 1938'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1794'   2A 0000*              	LHLD	OPSTA
  1797'   EB                    	XCHG			; DE = start
  1798'   2A 0000*              	LHLD	OPEND2		; HL = end
  179B'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  179E'   DA 17B1'              	JC	OPA_F
  17A1'   CA 17B1'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  17A4'   22 0000*              	SHLD	OPLO
  17A7'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17A8'   22 0000*              	SHLD	OPHI
  17AB'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  17AE'   C3 1868'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  17B1'                         OPA_F:
  17B1'   EB                    	XCHG			; HL = start, DE = end
  17B2'   22 0000*              	SHLD	OPLO
  17B5'   EB                    	XCHG			; HL = end
  17B6'   3A 0000*              	LDA	OPCLSV
  17B9'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  17BB'   CA 1865'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  17BE'   FE 01                 	CPI	1
  17C0'   C2 17E2'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  17C3'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  17C4'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  17C7'   2B                    	DCX	H		; the line it landed on
  17C8'   CD 1A25'              	CALL	CEND		; HL = that line's content end
  17CB'   EB                    	XCHG			; DE = it
  17CC'   2A 0000*              	LHLD	OPHI		; HL = hi
  17CF'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  17D2'   D2 17ED'              	JNC	OPA_HI		; hi is inside the line: keep it
  17D5'   2A 0000*              	LHLD	OPLO
  17D8'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  17DB'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  17DE'   EB                    	XCHG			; HL = the content end: the span stops there
  17DF'   C3 17ED'              	JMP	OPA_HI
  17E2'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  17E2'   22 0000*              	SHLD	OPHI
  17E5'   3A 0000*              	LDA	WPULL
  17E8'   B7                    	ORA	A
  17E9'   CA 1868'              	JZ	OPA_C1
  17EC'   23                    	INX	H
  17ED'                         OPA_HI:
  17ED'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  17F0'                         OPA_DO:
  17F0'   CD 18B4'              	CALL	OPSPNL
  17F3'   7C                    	MOV	A,H
  17F4'   B5                    	ORA	L
  17F5'   C2 17FE'              	JNZ	OPA_D1
  17F8'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17FB'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17FE'                         OPA_D1:
  17FE'   3A 0000*              	LDA	PSAVE
  1801'   FE 63                 	CPI	'c'
  1803'   CA 18BF'              	JZ	OPDSPN
  1806'   CD 18A7'              	CALL	SPNBRK
  1809'   D2 182A'              	JNC	OPA_D2
  180C'   2A 0000*              	LHLD	OPHI
  180F'   CD 1A25'              	CALL	CEND
  1812'   EB                    	XCHG			; DE = the content end of the line it ends in
  1813'   2A 0000*              	LHLD	OPHI
  1816'                         OPA_BL:
  1816'   CD 0000*              	CALL	CMP16
  1819'   CA 1830'              	JZ	OPA_BI		; only blanks after it
  181C'   D5                    	PUSH	D
  181D'   E5                    	PUSH	H
  181E'   CD 0000*              	CALL	CHARAT
  1821'   E1                    	POP	H
  1822'   D1                    	POP	D
  1823'   23                    	INX	H
  1824'   CD 185F'              	CALL	BLANKQ
  1827'   CA 1816'              	JZ	OPA_BL
  182A'                         OPA_D2:
  182A'   CD 18BF'              	CALL	OPDSPN
  182D'   C3 1A36'              	JMP	CLAMPE
  1830'                         OPA_BI:
  1830'   CD 1842'              	CALL	LOIND
  1833'   C2 182A'              	JNZ	OPA_D2
  1836'   2A 0000*              	LHLD	OPHI
  1839'   CD 072E'              	CALL	NLSTART
  183C'   22 0000*              	SHLD	OPHI
  183F'   C3 1893'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1842'                         LOIND:
  1842'   2A 0000*              	LHLD	OPLO
  1845'   CD 0697'              	CALL	BOL
  1848'                         LI_LP:
  1848'   E5                    	PUSH	H
  1849'   EB                    	XCHG
  184A'   2A 0000*              	LHLD	OPLO
  184D'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1850'   E1                    	POP	H
  1851'   C8                    	RZ
  1852'   E5                    	PUSH	H
  1853'   CD 0000*              	CALL	CHARAT
  1856'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1857'   23                    	INX	H
  1858'   CD 185F'              	CALL	BLANKQ
  185B'   CA 1848'              	JZ	LI_LP
  185E'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  185F'                         BLANKQ:
  185F'   FE 20                 	CPI	' '
  1861'   C8                    	RZ
  1862'   FE 09                 	CPI	TAB
  1864'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1865'                         OPA_JP:
  1865'   22 0000*              	SHLD	OPHI
  1868'                         OPA_C1:
  1868'   CD 18B4'              	CALL	OPSPNL
  186B'   7C                    	MOV	A,H
  186C'   B5                    	ORA	L
  186D'   CA 17F0'              	JZ	OPA_DO		; nothing spanned
  1870'   2A 0000*              	LHLD	OPHI
  1873'   CD 0697'              	CALL	BOL
  1876'   EB                    	XCHG
  1877'   2A 0000*              	LHLD	OPHI
  187A'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  187D'   C2 17F0'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1880'   CD 1842'              	CALL	LOIND
  1883'   CA 1893'              	JZ	C1_LW		; only blanks before lo: whole lines
  1886'                         C1_CH:
  1886'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1889'   2B                    	DCX	H		;   of the line before
  188A'   CD 1A25'              	CALL	CEND
  188D'   22 0000*              	SHLD	OPHI
  1890'   C3 17F0'              	JMP	OPA_DO
  1893'                         C1_LW:
  1893'   2A 0000*              	LHLD	OPLO
  1896'   CD 0697'              	CALL	BOL
  1899'   22 0000*              	SHLD	OPLO
  189C'   3A 0000*              	LDA	PSAVE
  189F'   FE 63                 	CPI	'c'
  18A1'   CA 1886'              	JZ	C1_CH
  18A4'   C3 194B'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  18A7'                         SPNBRK:
  18A7'   2A 0000*              	LHLD	OPLO
  18AA'   CD 06DA'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18AD'   EB                    	XCHG			; DE = it
  18AE'   2A 0000*              	LHLD	OPHI
  18B1'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  18B4'                         OPSPNL:
  18B4'   2A 0000*              	LHLD	OPHI
  18B7'   EB                    	XCHG
  18B8'   2A 0000*              	LHLD	OPLO
  18BB'   EB                    	XCHG			; HL = hi, DE = lo
  18BC'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  18BF'                         OPDSPN:
  18BF'   CD 18A7'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  18C2'   F5                    	PUSH	PSW
  18C3'   2A 0000*              	LHLD	OPSTA
  18C6'   EB                    	XCHG
  18C7'   2A 0000*              	LHLD	OPLO
  18CA'   22 0000*              	SHLD	WKI
  18CD'   CD 0000*              	CALL	CMP16
  18D0'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  18D1'   CD 0000*              	CALL	GOTO
  18D4'   CD 18B4'              	CALL	OPSPNL		; HL = hi - lo
  18D7'   CD 0877'              	CALL	SETLIN
  18DA'   F1                    	POP	PSW
  18DB'   CC 19F4'              	CZ	DCHQ
  18DE'   CD 0000*              	CALL	DELFWD
  18E1'   CD 0177'              	CALL	MARKMOD
  18E4'   F1                    	POP	PSW
  18E5'   D0                    	RNC
  18E6'   C3 08AE'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  18E9'                         UNDFNB:
  18E9'   CD 0000*              	CALL	CUROFF
  18EC'   E5                    	PUSH	H
  18ED'   CD 0977'              	CALL	FNBLNK
  18F0'   CD 0000*              	CALL	CUROFF
  18F3'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  18F4'   CD 0000*              	CALL	CMP16
  18F7'   D2 0000*              	JNC	UNDHER
  18FA'   EB                    	XCHG
  18FB'   CD 0000*              	CALL	GOTO
  18FE'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1901'                         OPALSP:
  1901'   2A 0000*              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1904'   EB                    	XCHG
  1905'   2A 0000*              	LHLD	OPEND2
  1908'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  190B'   DA 191B'              	JC	OPAL_F
  190E'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1911'   EB                    	XCHG
  1912'   22 0000*              	SHLD	OPHI		; hi-src = start
  1915'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1918'   C3 1925'              	JMP	OPAL_R
  191B'                         OPAL_F:
  191B'   EB                    	XCHG			; HL = start
  191C'   22 0000*              	SHLD	OPLO		; lo-src = start
  191F'   2A 0000*              	LHLD	OPEND2
  1922'   22 0000*              	SHLD	OPHI		; hi-src = end
  1925'                         OPAL_R:
  1925'   2A 0000*              	LHLD	OPLO
  1928'   CD 0697'              	CALL	BOL
  192B'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  192E'   2A 0000*              	LHLD	OPHI
  1931'   CD 072E'              	CALL	NLSTART
  1934'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  1937'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1938'                         OPALIN:
  1938'   CD 1901'              	CALL	OPALSP
  193B'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  193E'   CD 072E'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1941'   EB                    	XCHG			;   the column)
  1942'   2A 0000*              	LHLD	OPHI
  1945'   CD 0000*              	CALL	CMP16
  1948'   CC 18E9'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  194B'                         OPDLIN:
  194B'   CD 18BF'              	CALL	OPDSPN
  194E'   CD 0778'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1951'   DA 1961'              	JC	OPDL_NB
  1954'   CD 0000*              	CALL	LOGLEN
  1957'   7C                    	MOV	A,H
  1958'   B5                    	ORA	L
  1959'   C8                    	RZ			; empty buffer
  195A'   2B                    	DCX	H
  195B'   CD 0697'              	CALL	BOL
  195E'   CD 0000*              	CALL	GOTO
  1961'                         OPDL_NB:
  1961'   C3 0977'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1964'                         OPCTAB:
  1964'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1968'   62 00 42 00           
  196C'   68 00 6C 00           
  1970'   30 00 5E 00           
  1974'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1976'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  197A'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  197E'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1982'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1986'   24 01                 
  1988'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  198C'   47 02 48 02           
  1990'   4D 02 4C 02           
  1994'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1996'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1998'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1999'                         VCB_C:
  1999'   CD 19A5'              	CALL	VCB_CD
  199C'   C3 1AA7'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  199F'                         VCB_D:
  199F'   CD 19A5'              	CALL	VCB_CD
  19A2'   C3 1A36'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  19A5'                         VCB_CD:
  19A5'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19A8'   22 0000*              	SHLD	OPLO
  19AB'   22 0000*              	SHLD	OPSTA
  19AE'   CD 0000*              	CALL	CUROFF
  19B1'   CD 1A25'              	CALL	CEND		; to the line's content end, the CR,LF left
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19B4'   22 0000*              	SHLD	OPHI
  19B7'   C3 18BF'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  19BA'                         VC_X:
  19BA'   CD 0A29'              	CALL	GLSTAL
  19BD'   CD 0877'              	CALL	SETLIN
  19C0'   CD 079C'              	CALL	GETCNT
  19C3'   22 0000*              	SHLD	CNTV
  19C6'   CD 0000*              	CALL	CUROFF
  19C9'   22 0000*              	SHLD	WKI		; cur
  19CC'   CD 1A25'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  19CF'   EB                    	XCHG			; DE = contentend
  19D0'   2A 0000*              	LHLD	WKI		; HL = cur
  19D3'   EB                    	XCHG			; HL = contentend, DE = cur
  19D4'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  19D7'   7C                    	MOV	A,H
  19D8'   B5                    	ORA	L
  19D9'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  19DA'   EB                    	XCHG			; DE = available
  19DB'   2A 0000*              	LHLD	CNTV		; HL = count
  19DE'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  19E1'   DA 19E7'              	JC	VX_USEA
  19E4'   C3 19E8'              	JMP	VX_DEL		; count <= available -> HL = count = del
  19E7'                         VX_USEA:
  19E7'   EB                    	XCHG			; HL = available
  19E8'                         VX_DEL:
  19E8'   CD 19F4'              	CALL	DCHQ
  19EB'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  19EE'   CD 0177'              	CALL	MARKMOD
  19F1'   C3 1A36'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  19F4'                         DCHQ:
  19F4'   E5                    	PUSH	H
  19F5'   CD 08B4'              	CALL	TAILTAB
  19F8'   E1                    	POP	H
  19F9'   47                    	MOV	B,A
  19FA'   7C                    	MOV	A,H		; (more of them than a byte counts)
  19FB'   B7                    	ORA	A
  19FC'   C0                    	RNZ
  19FD'   B5                    	ORA	L
  19FE'   C8                    	RZ			; (or none at all)
  19FF'   32 3213'              	STA	DCHN
  1A02'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A03'   87                    	ADD	A
  1A04'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1A07'   CA 1A1F'              	JZ	DQ_0
  1A0A'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  1A0B'   FE 08                 	CPI	8
  1A0D'   D0                    	RNC
  1A0E'   E5                    	PUSH	H
  1A0F'   2A 0000*              	LHLD	WKI
  1A12'   EB                    	XCHG
  1A13'   2A 0000*              	LHLD	TTI
  1A16'   CD 0000*              	CALL	SUBHD
  1A19'   EB                    	XCHG			; DE = the chars before it
  1A1A'   E1                    	POP	H
  1A1B'   CD 0000*              	CALL	CMP16
  1A1E'   D8                    	RC
  1A1F'                         DQ_0:
  1A1F'   3E 07                 	MVI	A,R_DCH
  1A21'   32 0000*              	STA	RINTENT
  1A24'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1A25'                         CEND:
  1A25'   CD 06DA'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1A28'   7C                    	MOV	A,H
  1A29'   B5                    	ORA	L
  1A2A'   C8                    	RZ			; the start of the text: nothing before it
  1A2B'   2B                    	DCX	H
  1A2C'   E5                    	PUSH	H
  1A2D'   CD 0000*              	CALL	CHARAT
  1A30'   E1                    	POP	H		; HL = term-1
  1A31'   FE 0D                 	CPI	CR
  1A33'   C8                    	RZ			; a CR before the LF -> the content ends there
  1A34'   23                    	INX	H
  1A35'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1A36'                         CLAMPE:
  1A36'   CD 0000*              	CALL	CUROFF
  1A39'   E5                    	PUSH	H
  1A3A'   CD 073D'              	CALL	EOLC
  1A3D'   D1                    	POP	D		; DE = cur
  1A3E'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1A41'   D8                    	RC
  1A42'   C8                    	RZ
  1A43'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1A46'                         VC_I:
  1A46'   CD 079C'              	CALL	GETCNT
  1A49'   C3 1AA4'              	JMP	SETINM
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1A4C'                         VC_A:
  1A4C'   CD 079C'              	CALL	GETCNT
  1A4F'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A52'   CA 1A69'              	JZ	VA_INS
  1A55'   EB                    	XCHG			; HL = cur
  1A56'   E5                    	PUSH	H
  1A57'   CD 0000*              	CALL	CHARAT
  1A5A'   E1                    	POP	H
  1A5B'   FE 0A                 	CPI	LF
  1A5D'   CA 1A69'              	JZ	VA_INS		; on the line terminator -> append in place
  1A60'   FE 0D                 	CPI	CR
  1A62'   CA 1A69'              	JZ	VA_INS
  1A65'   23                    	INX	H
  1A66'   CD 0000*              	CALL	GOTO
  1A69'                         VA_INS:
  1A69'   C3 1AA4'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A6C'                         VCB_A:
  1A6C'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A6F'   CD 073D'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A72'   E5                    	PUSH	H
  1A73'   CD 0000*              	CALL	CHARAT
  1A76'   E1                    	POP	H
  1A77'   FE 0D                 	CPI	CR
  1A79'   CA 1A82'              	JZ	VBA_IN		; an empty line: insert at its start
  1A7C'   FE 0A                 	CPI	LF
  1A7E'   CA 1A82'              	JZ	VBA_IN
  1A81'   23                    	INX	H		; past the last content char
  1A82'                         VBA_IN:
  1A82'   CD 0000*              	CALL	GOTO
  1A85'   C3 1AA4'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A88'                         VCB_I:
  1A88'   CD 079C'              	CALL	GETCNT
  1A8B'   CD 0977'              	CALL	FNBLNK
  1A8E'   CD 0000*              	CALL	CUROFF
  1A91'   E5                    	PUSH	H
  1A92'   CD 0000*              	CALL	CHARAT
  1A95'   E1                    	POP	H
  1A96'   FE 20                 	CPI	' '
  1A98'   CA 1AA0'              	JZ	VBI_SK
  1A9B'   FE 09                 	CPI	TAB
  1A9D'   C2 1AA4'              	JNZ	SETINM
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1AA0'                         VBI_SK:
  1AA0'   23                    	INX	H		; blanks only: past the last of them
  1AA1'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1AA4'                         SETINM:
  1AA4'   CD 0871'              	CALL	SETMOV
  1AA7'                         SETINS:
  1AA7'   3E 01                 	MVI	A,EM_INS
  1AA9'   32 0000*              	STA	EDMODE
  1AAC'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1AAD'                         ATCEND:
  1AAD'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1AB0'   C8                    	RZ
  1AB1'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1AB4'   FE 0D                 	CPI	CR
  1AB6'   C8                    	RZ
  1AB7'   FE 0A                 	CPI	LF
  1AB9'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1ABA'                         OPNBRK:
  1ABA'   CD 2430'              	CALL	PUTBRK
  1ABD'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1AC0'   23                    	INX	H
  1AC1'   22 0000*              	SHLD	LNDLT
  1AC4'   C3 0177'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1AC7'                         ENDBRK:
  1AC7'   CD 0778'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1ACA'   C0                    	RNZ
  1ACB'   CD 1ABA'              	CALL	OPNBRK
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1ACE'   CD 0000*              	CALL	CUROFF
  1AD1'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1AD2'   2B                    	DCX	H		;   line, with its own terminator after it
  1AD3'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1AD6'                         VC_O:
  1AD6'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AD9'   CD 1A25'              	CALL	CEND
  1ADC'   CD 0000*              	CALL	GOTO
  1ADF'   CD 1ABA'              	CALL	OPNBRK
  1AE2'   CD 1AC7'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1AE5'   CD 0899'              	CALL	SETILN		;   needs a terminator of its own to exist
  1AE8'   C3 1AA7'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1AEB'                         VCB_O:
  1AEB'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AEE'   CD 0697'              	CALL	BOL
  1AF1'   CD 0000*              	CALL	GOTO
  1AF4'   CD 1ABA'              	CALL	OPNBRK
  1AF7'   CD 0000*              	CALL	CUROFF
  1AFA'   2B                    	DCX	H
  1AFB'   2B                    	DCX	H
  1AFC'   CD 0000*              	CALL	GOTO
  1AFF'   CD 0899'              	CALL	SETILN
  1B02'   C3 1AA7'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1B05'                         VCB_J:
  1B05'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1B08'   CD 1A25'              	CALL	CEND		; the join point: this line's content end
  1B0B'   22 0000*              	SHLD	OPLO
  1B0E'   CD 0000*              	CALL	CUROFF
  1B11'   CD 072E'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1B14'   E5                    	PUSH	H
  1B15'   CD 0000*              	CALL	LOGLEN
  1B18'   D1                    	POP	D		; DE = that start
  1B19'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1B1C'   CA 0871'              	JZ	SETMOV
  1B1F'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B20'                         VJ_WS:
  1B20'   E5                    	PUSH	H
  1B21'   CD 0000*              	CALL	LOGLEN
  1B24'   D1                    	POP	D		; DE = the scan
  1B25'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1B28'   CA 1B3F'              	JZ	VJ_DEL
  1B2B'   EB                    	XCHG			; HL = the scan
  1B2C'   E5                    	PUSH	H
  1B2D'   CD 0000*              	CALL	CHARAT
  1B30'   E1                    	POP	H
  1B31'   FE 20                 	CPI	' '
  1B33'   CA 1B3B'              	JZ	VJ_SKIP
  1B36'   FE 09                 	CPI	TAB
  1B38'   C2 1B3F'              	JNZ	VJ_DEL
  1B3B'                         VJ_SKIP:
  1B3B'   23                    	INX	H
  1B3C'   C3 1B20'              	JMP	VJ_WS
  1B3F'                         VJ_DEL:
  1B3F'   22 0000*              	SHLD	OPHI
  1B42'   CD 18BF'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1B45'   CD 08A8'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1B48'   CD 0778'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1B4B'   CA 1A36'              	JZ	CLAMPE
  1B4E'   CD 0783'              	CALL	CURCHR		; the first char of what was appended
  1B51'   FE 0D                 	CPI	CR
  1B53'   CA 1A36'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1B56'   FE 0A                 	CPI	LF
  1B58'   CA 1A36'              	JZ	CLAMPE
  1B5B'   FE 29                 	CPI	')'
  1B5D'   CA 1A36'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B60'   CD 0000*              	CALL	CUROFF
  1B63'   7C                    	MOV	A,H
  1B64'   B5                    	ORA	L
  1B65'   CA 1B7B'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B68'   2B                    	DCX	H
  1B69'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B6C'   FE 20                 	CPI	' '
  1B6E'   CA 1A36'              	JZ	CLAMPE
  1B71'   FE 09                 	CPI	TAB
  1B73'   CA 1A36'              	JZ	CLAMPE
  1B76'   FE 0A                 	CPI	LF
  1B78'   CA 1A36'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B7B'                         VJ_SP:
  1B7B'   3E 20                 	MVI	A,' '
  1B7D'   CD 0000*              	CALL	PUTGAP
  1B80'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B83'   2B                    	DCX	H
  1B84'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B87'                         VC_TILD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1B87'   CD 079C'              	CALL	GETCNT
  1B8A'   CD 0877'              	CALL	SETLIN		; only this row changes
  1B8D'   CD 0A29'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B90'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B93'   CA 0871'              	JZ	SETMOV
  1B96'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1B99'   FE 0D                 	CPI	CR
  1B9B'   CA 0871'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B9E'   FE 0A                 	CPI	LF
  1BA0'   CA 0871'              	JZ	SETMOV
  1BA3'   47                    	MOV	B,A
  1BA4'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1BA6'   FE 41                 	CPI	'A'
  1BA8'   DA 1BB4'              	JC	VT_PUT		; below 'A': no case
  1BAB'   FE 5B                 	CPI	'Z'+1
  1BAD'   D2 1BB4'              	JNC	VT_PUT		; above 'Z': no case
  1BB0'   78                    	MOV	A,B
  1BB1'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1BB3'   47                    	MOV	B,A
  1BB4'                         VT_PUT:
  1BB4'   78                    	MOV	A,B
  1BB5'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1BB8'   CD 0177'              	CALL	MARKMOD
  1BBB'   21 0001               	LXI	H,1
  1BBE'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1BC1'   3A 0000*              	LDA	VRCH
  1BC4'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1BC7'   C3 1A36'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1BCA'                         VC_R:
  1BCA'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  1BCD'   3E 03                 	MVI	A,PR
  1BCF'   32 0000*              	STA	GPEND
  1BD2'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1BD3'                         VR_DO:
  1BD3'   AF                    	XRA	A
  1BD4'   32 0000*              	STA	GPEND
  1BD7'   79                    	MOV	A,C
  1BD8'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1BDB'   CD 0877'              	CALL	SETLIN		; only this row changed
  1BDE'   CD 0A29'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1BE1'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1BE4'   CA 0871'              	JZ	SETMOV		; the end of the text: vim does nothing
  1BE7'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1BEA'   FE 0D                 	CPI	CR
  1BEC'   CA 0871'              	JZ	SETMOV		; the line's end: nothing to replace
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1BEF'   FE 0A                 	CPI	LF
  1BF1'   CA 0871'              	JZ	SETMOV
  1BF4'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1BF6'   CD 087D'              	CALL	SETCEL
  1BF9'   CD 0177'              	CALL	MARKMOD
  1BFC'   21 0001               	LXI	H,1
  1BFF'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1C02'   3A 0000*              	LDA	VRCH
  1C05'   FE 0D                 	CPI	CR
  1C07'   CA 1C14'              	JZ	VR_CR
  1C0A'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1C0D'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1C10'   2B                    	DCX	H		;   out, which moves every logical offset
  1C11'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1C14'                         VR_CR:
  1C14'   CD 1ABA'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1C17'   CD 1AC7'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1C1A'   CD 0899'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1C1D'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1C1F'   32 0000*              	STA	ILABOV
  1C22'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1C23'                         VCB_R:
  1C23'   CD 079C'              	CALL	GETCNT
  1C26'   CD 0871'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1C29'   21 0000               	LXI	H,0
  1C2C'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1C2F'   22 0000*              	SHLD	RPAPP
  1C32'   3E 02                 	MVI	A,EM_REP
  1C34'   32 0000*              	STA	EDMODE
  1C37'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1C38'                         VC_D:
  1C38'   3E 64                 	MVI	A,'d'
  1C3A'   32 0000*              	STA	PENDOP
  1C3D'   C3 0871'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1C40'                         VC_C:
  1C40'   3E 63                 	MVI	A,'c'
  1C42'   32 0000*              	STA	PENDOP
  1C45'   C3 0871'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C48'                         VD_DD:
  1C48'   CD 0A29'              	CALL	GLSTAL
  1C4B'   CD 079C'              	CALL	GETCNT
  1C4E'   22 0000*              	SHLD	CNTV
  1C51'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1C53'   32 0000*              	STA	DDSNG
  1C56'   2B                    	DCX	H
  1C57'   7C                    	MOV	A,H
  1C58'   B5                    	ORA	L
  1C59'   C2 1C67'              	JNZ	VDD_LS
  1C5C'   3E 01                 	MVI	A,1
  1C5E'   32 0000*              	STA	DDSNG
  1C61'   CD 18E9'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C64'   C3 1C6D'              	JMP	VDD_GO
  1C67'                         VDD_LS:
  1C67'   CD 09E2'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C6A'   DA 0871'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C6D'                         VDD_GO:
  1C6D'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C70'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C73'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C76'   CD 2693'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C79'   CD 0953'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C7C'   2A 0000*              	LHLD	CNTV
  1C7F'   CD 0000*              	CALL	SETC0
  1C82'                         VDD_FW:
  1C82'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C85'   DA 1DD3'              	JC	QREFUS		; ... which has no room for them
  1C88'   CD 07B1'              	CALL	CNTTST
  1C8B'   C2 1C82'              	JNZ	VDD_FW
  1C8E'   CD 0177'              	CALL	MARKMOD
  1C91'   CD 0BFA'              	CALL	ATEOF
  1C94'   D2 1CAF'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C97'   3E 00                 	MVI	A,0
  1C99'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1C9C'   CD 12DA'              	CALL	ONFST
  1C9F'   CA 0977'              	JZ	FNBLNK		; nothing left before it
  1CA2'   21 0001               	LXI	H,1		; onto the new last line
  1CA5'   CD 0000*              	CALL	SETBWD
  1CA8'   2A 0000*              	LHLD	LNDLT
  1CAB'   2B                    	DCX	H
  1CAC'   22 0000*              	SHLD	LNDLT
  1CAF'                         VDD_UP:
  1CAF'   CD 0977'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1CB2'   3A 0000*              	LDA	DDSNG
  1CB5'   B7                    	ORA	A
  1CB6'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1CB7'   3E 03                 	MVI	A,R_DLIN
  1CB9'   32 0000*              	STA	RINTENT
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CBC'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1CBD'                         QEMPTY:
  1CBD'   2A 0000*              	LHLD	QBEG
  1CC0'   EB                    	XCHG
  1CC1'   2A 0000*              	LHLD	QEND
  1CC4'   7C                    	MOV	A,H
  1CC5'   BA                    	CMP	D
  1CC6'   C0                    	RNZ
  1CC7'   7D                    	MOV	A,L
  1CC8'   BB                    	CMP	E
  1CC9'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1CCA'                         VC_Y:
  1CCA'   3E 79                 	MVI	A,'y'
  1CCC'   32 0000*              	STA	PENDOP
  1CCF'   C3 0871'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1CD2'                         VY_YY:
  1CD2'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1CD5'   CD 0448'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1CD8'   CD 0000*              	CALL	CUROFF
  1CDB'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1CDE'   CD 0697'              	CALL	BOL
  1CE1'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CE4'   CD 1E80'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CE7'   CD 1EC3'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1CEA'   D2 1E87'              	JNC	YNDONE
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CED'   21 1C48'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1CF0'   C3 1D1C'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1CF3'                         OPYANK:
  1CF3'   CD 1901'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1CF6'   2A 0000*              	LHLD	OPSTA
  1CF9'   EB                    	XCHG			; DE = start
  1CFA'   2A 0000*              	LHLD	OPEND2		; HL = end
  1CFD'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1D00'   D2 1D04'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1D03'   EB                    	XCHG			; ... otherwise the start is
  1D04'                         OPY_LO:
  1D04'   22 0000*              	SHLD	YOFF
  1D07'   2A 0000*              	LHLD	OPLO
  1D0A'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1D0D'   CD 1E80'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1D10'   CD 1F3B'              	CALL	YNSPAN		; copied where they lie, if there is room
  1D13'   D2 1E87'              	JNC	YNDONE
  1D16'   21 1E4B'              	LXI	H,YSPAN
  1D19'   C3 1D1C'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1D1C'                         YKGO:
  1D1C'   22 0000*              	SHLD	YACT
  1D1F'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1D22'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1D23'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1D26'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1D29'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1D2C'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1D2F'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1D30'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1D33'   EB                    	XCHG			;   window as it was, then names other text
  1D34'   E1                    	POP	H
  1D35'   CD 0000*              	CALL	SUBHD
  1D38'   EB                    	XCHG			; DE = how far behind the cursor they start
  1D39'   CD 13BC'              	CALL	CURFP
  1D3C'   06 00                 	MVI	B,0
  1D3E'   CD 13B2'              	CALL	SUB24
  1D41'   22 0000*              	SHLD	YPFP
  1D44'   32 0002*              	STA	YPFP+2
  1D47'   3A 0000*              	LDA	MODF
  1D4A'   32 0000*              	STA	YMODF
  1D4D'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1D50'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1D53'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D56'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D59'   3E 01                 	MVI	A,1
  1D5B'   32 0000*              	STA	UNDRPL
  1D5E'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D61'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D64'   22 0000*              	SHLD	YLDLT
  1D67'   CD 0000*              	CALL	LOGLEN
  1D6A'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D6D'   2A 0000*              	LHLD	YACT
  1D70'   CD 1DD2'              	CALL	YCALL		; the lines out of the file, into the register
  1D73'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D76'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D78'   CA 1DB6'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D7B'   CD 0000*              	CALL	LOGLEN
  1D7E'   EB                    	XCHG
  1D7F'   2A 0000*              	LHLD	YWAS
  1D82'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D85'   CA 1D97'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D88'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D8B'   CD 03FB'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D8E'   CD 03AC'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D91'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D94'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D97'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D97'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D9A'   EB                    	XCHG
  1D9B'   2A 0000*              	LHLD	YCOL
  1D9E'   19                    	DAD	D
  1D9F'   22 0000*              	SHLD	MKPOS
  1DA2'   3A 0002*              	LDA	YPFP+2
  1DA5'   CE 00                 	ACI	0
  1DA7'   32 0002*              	STA	MKPOS+2
  1DAA'   CD 03AC'              	CALL	MKPAGE
  1DAD'   CD 0000*              	CALL	GOTO
  1DB0'                         YK_RST:
  1DB0'   2A 0000*              	LHLD	YLDLT
  1DB3'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1DB6'                         YK_RF:
  1DB6'   3A 0000*              	LDA	YMODF
  1DB9'   32 0000*              	STA	MODF
  1DBC'   3A 0000*              	LDA	YDCHG
  1DBF'   32 0000*              	STA	DOTCHG
  1DC2'   3A 0000*              	LDA	YURPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DC5'   32 0000*              	STA	UNDRPL
  1DC8'   AF                    	XRA	A
  1DC9'   32 0000*              	STA	MKHOLD
  1DCC'   CD 0A29'              	CALL	GLSTAL
  1DCF'   C3 08AE'              	JMP	SETFUL		; the cheap paint cannot carry this
  1DD2'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1DD3'                         QREFUS:
  1DD3'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1DD6'   CD 1CBD'              	CALL	QEMPTY
  1DD9'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1DDC'   CD 0000*              	CALL	QKILL
  1DDF'   3A 0000*              	LDA	MKHOLD
  1DE2'   B7                    	ORA	A
  1DE3'   C2 1DF2'              	JNZ	QRF_Y
  1DE6'   21 0000*              	LXI	H,MKSAV
  1DE9'   11 0000*              	LXI	D,MKTAB
  1DEC'   CD 2693'              	CALL	COPY12
  1DEF'   CD 0000*              	CALL	UNDCLR
  1DF2'                         QRF_Y:
  1DF2'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1DF4'   32 0000*              	STA	MSGWHT
  1DF7'   C3 1700'              	JMP	OPG_HM
                                
                                ;MEMABT -- the arena has no room for what this key asked of it: WordMaster's
                                ; 'MEM SHORTAGE', 'MEM FULL' or 'QBUF FULL', which BUF.MAC's MEMERR sends here
                                ; once the screen is up (issue #39).  WordMaster abandons the command there and
                                ; goes back to its prompt, and so does this: the key's stack goes, and with it
                                ; whatever the key was part way through.  Each of those errors is raised before
                                ; a byte of text moves, so the text is whole, though not all of the change may
                                ; have been made.  The register is emptied -- it is what holds the room -- or
                                ; the repaint that follows would run into the same wall, and the half-done
                                ; command leaves nothing behind: no count, no pending operator, no '.' to repeat
                                ; it and no 'u' to undo half of it.  The bottom row says so.
                                ;
                                ; Two cases still end the editor, through ERRMSG as all three always did: a
                                ; second shortage before the next key (the repaint, with the register already
                                ; given back -- there is nothing left to give), and one in the middle of a yank
                                ; that took its lines OUT to put them back (YKGO, MKHOLD set): the register IS
                                ; those lines then, and emptying it would cut them from the file.
  1DFA'                         MEMABT:
  1DFA'   3A 0000*              	LDA	ABTFLG
  1DFD'   21 0000*              	LXI	H,MKHOLD
  1E00'   B6                    	ORA	M
  1E01'   C2 0000*              	JNZ	ERRMSG		; the message is still on the stack for it
  1E04'   3C                    	INR	A		; A = 1
  1E05'   32 0000*              	STA	ABTFLG		; ... until the next key (CMDDIS)
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E08'   31 0000*              	LXI	SP,VISTK	; the key's stack: VI.MAC's loop runs at the top
  1E0B'   32 0000*              	STA	MODF		; the text may have changed part way
  1E0E'   32 0000*              	STA	FORCEF		; the frame on the screen may be half drawn
  1E11'   32 0000*              	STA	DOTOVF		; a half command is no change for '.'
  1E14'   3A 0000*              	LDA	EDMODE		; in insert or replace mode the recording runs
  1E17'   B7                    	ORA	A		;   on to the ESC, DOTOVF keeping it from '.';
  1E18'   C2 1E22'              	JNZ	MAB_1		;   otherwise the next key starts a new one
  1E1B'   32 0000*              	STA	DOTCHG
  1E1E'   3C                    	INR	A
  1E1F'   32 3216'              	STA	DOTSTA
  1E22'                         MAB_1:
  1E22'   AF                    	XRA	A
  1E23'   32 0000*              	STA	GPEND
  1E26'   32 0000*              	STA	PENDOP
  1E29'   32 0000*              	STA	DOTRPL		; a '.' replay is over
  1E2C'   32 0000*              	STA	UNDRPL		; ... and so is a 'u' one
  1E2F'   32 0000*              	STA	BRKARM
  1E32'   32 0000*              	STA	BRKHIT
  1E35'   CD 0000*              	CALL	CLRCNT		; no count
  1E38'   CD 0000*              	CALL	UNDCLR		; nothing 'u' can trust
  1E3B'   CD 0000*              	CALL	QKILL		; the room back
  1E3E'   3E 05                 	MVI	A,MW_MEM
  1E40'   32 0000*              	STA	MSGWHT
  1E43'   3E 00                 	MVI	A,R_FULL
  1E45'   32 0000*              	STA	RINTENT
  1E48'   C3 0000*              	JMP	MLDRAW		; VI.MAC: the repaint, then the next key
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1E4B'                         YSPAN:
  1E4B'   CD 0A29'              	CALL	GLSTAL
  1E4E'   CD 18B4'              	CALL	OPSPNL		; HL = the span's length
  1E51'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1E54'   2A 0000*              	LHLD	OPLO
  1E57'   CD 0000*              	CALL	GOTO
  1E5A'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E5D'                         YS_LP:
  1E5D'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1E60'   CD 0000*              	CALL	SETC0
  1E63'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1E66'   DA 1DD3'              	JC	QREFUS		; ... which has no room for it
  1E69'   2A 0000*              	LHLD	QBEG
  1E6C'   EB                    	XCHG
  1E6D'   2A 0000*              	LHLD	QEND
  1E70'   CD 0000*              	CALL	SUBHD
  1E73'   EB                    	XCHG			; DE = what the register holds
  1E74'   2A 0000*              	LHLD	YTGT
  1E77'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1E7A'   DA 1E5D'              	JC	YS_LP		;   (never more than the span over whole lines)
  1E7D'   C3 0177'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1E80'                         YNPRE:
  1E80'   2A 0000*              	LHLD	PGTOPM
  1E83'   22 0000*              	SHLD	YNPG
  1E86'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1E87'                         YNDONE:
  1E87'   2A 0000*              	LHLD	YOFF
  1E8A'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E8D'   2A 0000*              	LHLD	PGTOPM
  1E90'   EB                    	XCHG
  1E91'   2A 0000*              	LHLD	YNPG
  1E94'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1E97'   C2 08AE'              	JNZ	SETFUL		; it moved under us: repaint after all
  1E9A'   C3 0871'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1E9D'                         YNROOM:
  1E9D'   11 0100               	LXI	D,100H
  1EA0'   19                    	DAD	D
  1EA1'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1EA2'   E5                    	PUSH	H		; the span plus its slack
  1EA3'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1EA6'   EB                    	XCHG			; HL = free
  1EA7'   D1                    	POP	D		; DE = the span plus its slack
  1EA8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1EAB'   DA 1EB3'              	JC	YNR_OK
  1EAE'   CA 1EB3'              	JZ	YNR_OK
  1EB1'   37                    	STC			; not enough: the delete-and-put-back path
  1EB2'   C9                    	RET
  1EB3'                         YNR_OK:
  1EB3'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1EB4'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1EB5'                         YNGO:
  1EB5'   C5                    	PUSH	B
  1EB6'   CD 079C'              	CALL	GETCNT		; spent here: this yank is happening
  1EB9'   CD 0A29'              	CALL	GLSTAL
  1EBC'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1EBF'   C1                    	POP	B
  1EC0'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1EC3'                         YNCOPY:
  1EC3'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1EC6'   7C                    	MOV	A,H		;   the count itself
  1EC7'   B5                    	ORA	L
  1EC8'   C2 1ECE'              	JNZ	YNC_HV
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1ECB'   21 0001               	LXI	H,1
  1ECE'                         YNC_HV:
  1ECE'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1ECF'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1ED0'   B4                    	ORA	H
  1ED1'   CA 1EDC'              	JZ	YNC_M
  1ED4'   E5                    	PUSH	H
  1ED5'   CD 09E2'              	CALL	ONLAST		; vim: a count over one on the last line does
  1ED8'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1ED9'   DA 1EEE'              	JC	YNC_RF
  1EDC'                         YNC_M:
  1EDC'   E5                    	PUSH	H
  1EDD'   CD 0953'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1EE0'   E1                    	POP	H
  1EE1'   CD 1EF6'              	CALL	YNLINE		; BC = the span, measured where it stands
  1EE4'   D8                    	RC			; not measurable here: let the pager answer it
  1EE5'   60                    	MOV	H,B
  1EE6'   69                    	MOV	L,C
  1EE7'   CD 1E9D'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1EEA'   D8                    	RC			; no: the delete-and-put-back path
  1EEB'   C3 1EB5'              	JMP	YNGO
  1EEE'                         YNC_RF:
  1EEE'   CD 079C'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1EF1'   CD 0A29'              	CALL	GLSTAL		;   register alone, and that is the command
  1EF4'   B7                    	ORA	A		; NC: done
  1EF5'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1EF6'                         YNLINE:
  1EF6'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1EF9'   2A 0000*              	LHLD	GAPEND
  1EFC'                         YNL_LP:
  1EFC'   EB                    	XCHG			; DE = the scan
  1EFD'   2A 0000*              	LHLD	TXTEND
  1F00'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1F03'   EB                    	XCHG			; HL = the scan
  1F04'   D2 1F24'              	JNC	YNL_EN		; the resident text ran out
  1F07'   7E                    	MOV	A,M
  1F08'   23                    	INX	H
  1F09'   FE 0A                 	CPI	LF
  1F0B'   C2 1EFC'              	JNZ	YNL_LP
  1F0E'   E5                    	PUSH	H
  1F0F'   2A 0000*              	LHLD	YNCNT
  1F12'   2B                    	DCX	H
  1F13'   22 0000*              	SHLD	YNCNT
  1F16'   7C                    	MOV	A,H
  1F17'   B5                    	ORA	L
  1F18'   E1                    	POP	H
  1F19'   C2 1EFC'              	JNZ	YNL_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                	;--- every line of the count is here: the span is what was walked ---
  1F1C'   EB                    	XCHG			; DE = past the last of them
  1F1D'   2A 0000*              	LHLD	GAPEND
  1F20'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1F21'   C3 1F32'              	JMP	YNL_BC
  1F24'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1F24'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1F27'   C2 1F39'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1F2A'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1F2D'   EB                    	XCHG			;   count clamps to it as vim's does
  1F2E'   2A 0000*              	LHLD	GAPEND
  1F31'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1F32'                         YNL_BC:
  1F32'   CD 0000*              	CALL	SUBHD		; HL = the span
  1F35'   44                    	MOV	B,H
  1F36'   4D                    	MOV	C,L
  1F37'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1F38'   C9                    	RET
  1F39'                         YNL_NO:
  1F39'   37                    	STC
  1F3A'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1F3B'                         YNSPAN:
  1F3B'   CD 18B4'              	CALL	OPSPNL		; HL = the span's length
  1F3E'   44                    	MOV	B,H
  1F3F'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1F40'   CD 1E9D'              	CALL	YNROOM
  1F43'   D8                    	RC			; no room: the delete-and-put-back path
  1F44'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1F45'   2A 0000*              	LHLD	OPLO
  1F48'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1F4B'   C1                    	POP	B
  1F4C'   C3 1EB5'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1F4F'                         VC_P:
  1F4F'   CD 1CBD'              	CALL	QEMPTY
  1F52'   CA 2025'              	JZ	VP_BEL
  1F55'   CD 079C'              	CALL	GETCNT
  1F58'   22 0000*              	SHLD	PCNT
  1F5B'   CD 0000*              	CALL	CUROFF
  1F5E'   CD 072E'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1F61'   C3 1F76'              	JMP	VP_GO
  1F64'                         VCB_P:
  1F64'   CD 1CBD'              	CALL	QEMPTY
  1F67'   CA 2025'              	JZ	VP_BEL
  1F6A'   CD 079C'              	CALL	GETCNT
  1F6D'   22 0000*              	SHLD	PCNT
  1F70'   CD 0000*              	CALL	CUROFF
  1F73'   CD 0697'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1F76'                         VP_GO:
  1F76'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1F79'   CD 0000*              	CALL	CUROFF
  1F7C'   EB                    	XCHG
  1F7D'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1F80'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1F83'   DA 1F98'              	JC	VP_IN
  1F86'   EB                    	XCHG			; HL = the put point = LOGLEN
  1F87'   7C                    	MOV	A,H
  1F88'   B5                    	ORA	L
  1F89'   CA 1F95'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1F8C'   2B                    	DCX	H
  1F8D'   CD 0000*              	CALL	CHARAT
  1F90'   FE 0A                 	CPI	LF
  1F92'   CA 1F98'              	JZ	VP_IN
  1F95'                         VP_BRK:
  1F95'   CD 1ABA'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1F98'                         VP_IN:
  1F98'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1F9B'   CD 0448'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1F9E'   CD 1405'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1FA1'   2A 0000*              	LHLD	QBEG
  1FA4'   EB                    	XCHG
  1FA5'   2A 0000*              	LHLD	QEND
  1FA8'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1FAB'   EB                    	XCHG
  1FAC'   22 0000*              	SHLD	PLFS
  1FAF'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1FB2'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1FB3'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1FB4'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1FB6'   C2 1FBA'              	JNZ	VP_PZ
  1FB9'   7D                    	MOV	A,L
  1FBA'                         VP_PZ:
  1FBA'   32 0000*              	STA	PCPY
  1FBD'                         VP_LP:
  1FBD'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1FC0'   2A 0000*              	LHLD	LNDLT
  1FC3'   EB                    	XCHG
  1FC4'   2A 0000*              	LHLD	PLFS
  1FC7'   19                    	DAD	D
  1FC8'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1FCB'   2A 0000*              	LHLD	PCNT
  1FCE'   2B                    	DCX	H
  1FCF'   22 0000*              	SHLD	PCNT
  1FD2'   7C                    	MOV	A,H
  1FD3'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  1FD4'   C2 1FBD'              	JNZ	VP_LP
  1FD7'   CD 0177'              	CALL	MARKMOD
  1FDA'   21 0000*              	LXI	H,PPFP
  1FDD'   CD 03FB'              	CALL	MKLOAD
  1FE0'   CD 0408'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1FE3'   D2 2016'              	JNC	VP_PGD
  1FE6'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1FE9'   CD 0A29'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1FEC'   3A 0000*              	LDA	PCPY
  1FEF'   B7                    	ORA	A
  1FF0'   CA 0977'              	JZ	FNBLNK
  1FF3'   2A 0000*              	LHLD	PLFS
  1FF6'   7C                    	MOV	A,H
  1FF7'   B7                    	ORA	A
  1FF8'   C2 0977'              	JNZ	FNBLNK
  1FFB'   3A 0000*              	LDA	PCPY
  1FFE'   CD 10A2'              	CALL	MULSAT		; HL = the lines this put put, saturated
  2001'   7C                    	MOV	A,H
  2002'   B7                    	ORA	A
  2003'   C2 0977'              	JNZ	FNBLNK
  2006'   7D                    	MOV	A,L
  2007'   B7                    	ORA	A
  2008'   CA 0977'              	JZ	FNBLNK
  200B'   F5                    	PUSH	PSW
  200C'   CD 0899'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  200F'   F1                    	POP	PSW
  2010'   32 3212'              	STA	ILN		; ... which the lines put now replace
  2013'   C3 0977'              	JMP	FNBLNK
  2016'                         VP_PGD:				; the put paged its first line out: page back
  2016'   CD 03AC'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  2019'   CD 0000*              	CALL	GOTO
  201C'   CD 0A29'              	CALL	GLSTAL
  201F'   CD 141D'              	CALL	GPLACE
  2022'   C3 08AE'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  2025'                         VP_BEL:
  2025'   CD 079C'              	CALL	GETCNT		; the count is spent either way
  2028'   0E 07                 	MVI	C,BEL
  202A'   CD 0000*              	CALL	BCONOU
  202D'   C3 0871'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  2030'                         VIREP:
  2030'   79                    	MOV	A,C
  2031'   FE 1B                 	CPI	ESC
  2033'   CA 2186'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  2036'   FE 0D                 	CPI	CR
  2038'   CA 20AB'              	JZ	VP_CR
  203B'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  203D'   CA 20AB'              	JZ	VP_CR
  2040'   FE 08                 	CPI	BS
  2042'   CA 20B7'              	JZ	VP_BS
  2045'   FE 7F                 	CPI	DEL
  2047'   CA 20B7'              	JZ	VP_BS
  204A'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  204D'   CD 0877'              	CALL	SETLIN		; this row changed
  2050'   CD 0177'              	CALL	MARKMOD
  2053'   CD 1AAD'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  2056'   CA 2096'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  2059'   CD 0783'              	CALL	CURCHR
  205C'   06 01                 	MVI	B,1
  205E'   CD 087D'              	CALL	SETCEL
  2061'   3A 0000*              	LDA	VRCH
  2064'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  2067'   2A 0000*              	LHLD	RPDEL
  206A'   7C                    	MOV	A,H
  206B'   B5                    	ORA	L
  206C'   CA 2082'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  206F'   2A 0000*              	LHLD	GAPEND
  2072'   EB                    	XCHG
  2073'   2A 0000*              	LHLD	RPGE
  2076'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  2079'   CA 2082'              	JZ	VP_OVW
  207C'   21 0000               	LXI	H,0
  207F'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  2082'                         VP_OVW:
  2082'   21 0001               	LXI	H,1
  2085'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  2088'   2A 0000*              	LHLD	GAPEND
  208B'   22 0000*              	SHLD	RPGE
  208E'   2A 0000*              	LHLD	RPDEL
  2091'   23                    	INX	H
  2092'   22 0000*              	SHLD	RPDEL
  2095'   C9                    	RET
  2096'                         VP_APP:
  2096'   3E 20                 	MVI	A,' '		; (the cell there is blank)
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  2098'   06 01                 	MVI	B,1
  209A'   CD 087D'              	CALL	SETCEL
  209D'   3A 0000*              	LDA	VRCH
  20A0'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  20A3'   2A 0000*              	LHLD	RPAPP
  20A6'   23                    	INX	H
  20A7'   22 0000*              	SHLD	RPAPP
  20AA'   C9                    	RET
  20AB'                         VP_CR:
  20AB'   21 0000               	LXI	H,0
  20AE'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  20B1'   22 0000*              	SHLD	RPAPP
  20B4'   C3 2142'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  20B7'                         VP_BS:
  20B7'   2A 0000*              	LHLD	RPAPP
  20BA'   7C                    	MOV	A,H
  20BB'   B5                    	ORA	L
  20BC'   CA 20C9'              	JZ	VP_BSD
  20BF'   2B                    	DCX	H
  20C0'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  20C3'   CD 0877'              	CALL	SETLIN
  20C6'   C3 0000*              	JMP	DELPRV
  20C9'                         VP_BSD:
  20C9'   2A 0000*              	LHLD	RPDEL
  20CC'   7C                    	MOV	A,H
  20CD'   B5                    	ORA	L
  20CE'   CA 20F5'              	JZ	VP_BSM		; nothing of ours left
  20D1'   2A 0000*              	LHLD	GAPEND
  20D4'   EB                    	XCHG
  20D5'   2A 0000*              	LHLD	RPGE
  20D8'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  20DB'   C2 20F5'              	JNZ	VP_BSM
  20DE'   2A 0000*              	LHLD	RPDEL
  20E1'   2B                    	DCX	H
  20E2'   22 0000*              	SHLD	RPDEL
  20E5'   CD 0877'              	CALL	SETLIN
  20E8'   CD 0000*              	CALL	DELPRV		; the typed char goes
  20EB'   CD 0000*              	CALL	UNDELF		; the original comes back
  20EE'   2A 0000*              	LHLD	GAPEND
  20F1'   22 0000*              	SHLD	RPGE
  20F4'   C9                    	RET
  20F5'                         VP_BSM:
  20F5'   CD 0871'              	CALL	SETMOV		; nothing changed: back over the text as it is
  20F8'   C3 08FF'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  20FB'                         VIINS:
  20FB'   79                    	MOV	A,C
  20FC'   FE 1B                 	CPI	ESC
  20FE'   CA 2186'              	JZ	VI_ESC
  2101'   FE 0D                 	CPI	CR
  2103'   CA 2142'              	JZ	VI_CR
  2106'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  2108'   CA 2142'              	JZ	VI_CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  210B'   FE 08                 	CPI	BS
  210D'   CA 215A'              	JZ	VI_BS
  2110'   FE 7F                 	CPI	DEL
  2112'   CA 215A'              	JZ	VI_BS
  2115'   79                    	MOV	A,C
  2116'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  2119'   CD 0177'              	CALL	MARKMOD
  211C'   CD 0877'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  211F'   79                    	MOV	A,C
  2120'   FE 20                 	CPI	' '
  2122'   D8                    	RC			; control char -> keep R_LINE
  2123'   FE 7F                 	CPI	DEL
  2125'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  2126'   CD 08B4'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  2129'   47                    	MOV	B,A
  212A'   3E 04                 	MVI	A,R_ICH
  212C'   32 0000*              	STA	RINTENT
  212F'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  2131'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  2132'   CA 213E'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  2135'   CD 1AAD'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  2138'   3E 00                 	MVI	A,0
  213A'   C2 213E'              	JNZ	VI_ICH
  213D'   3C                    	INR	A
  213E'                         VI_ICH:
  213E'   32 0000*              	STA	ICHAPP
  2141'   C9                    	RET
  2142'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  2142'   CD 1AAD'              	CALL	ATCEND
  2145'   3E 00                 	MVI	A,0
  2147'   CA 214B'              	JZ	VI_CRS
  214A'   3C                    	INR	A
  214B'                         VI_CRS:
  214B'   F5                    	PUSH	PSW
  214C'   CD 1ABA'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  214F'   CD 1AC7'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  2152'   CD 0899'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  2155'   F1                    	POP	PSW
  2156'   32 0000*              	STA	ILABOV
  2159'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  215A'                         VI_BS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  215A'   CD 0000*              	CALL	PEEKL
  215D'   D8                    	RC			; start of the file: nothing to delete
  215E'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  2160'   CA 2180'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  2163'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  2164'   CD 0877'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2167'   78                    	MOV	A,B
  2168'   CD 0892'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  216B'   D2 2180'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  216E'   CD 08B4'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  2171'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  2172'   3C                    	INR	A
  2173'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  2176'   3E 01                 	MVI	A,1
  2178'   32 3213'              	STA	DCHN
  217B'   3E 07                 	MVI	A,R_DCH
  217D'   32 0000*              	STA	RINTENT
  2180'                         VI_BSJ:
  2180'   CD 0177'              	CALL	MARKMOD
  2183'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2186'                         VI_ESC:
  2186'   3E 00                 	MVI	A,EM_CMD
  2188'   32 0000*              	STA	EDMODE
  218B'   CD 0871'              	CALL	SETMOV
  218E'   CD 08FF'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  2191'   C3 0A29'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  2194'                         RDLINE:
  2194'   EB                    	XCHG			; HL = buffer
  2195'   22 0000*              	SHLD	RLPTR
  2198'   3E 00                 	MVI	A,0
  219A'   32 0000*              	STA	RLLEN
  219D'   78                    	MOV	A,B
  219E'   32 0000*              	STA	RLMAX
  21A1'   79                    	MOV	A,C
  21A2'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  21A5'                         RL_LP:
  21A5'   CD 0000*              	CALL	GETKEY
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21A8'   FE 1B                 	CPI	ESC
  21AA'   CA 21FA'              	JZ	RL_CAN
  21AD'   FE 0D                 	CPI	CR
  21AF'   CA 2205'              	JZ	RL_DONE
  21B2'   FE 08                 	CPI	BS
  21B4'   CA 21E2'              	JZ	RL_BS
  21B7'   FE 7F                 	CPI	DEL
  21B9'   CA 21E2'              	JZ	RL_BS
  21BC'   FE 20                 	CPI	' '
  21BE'   DA 21A5'              	JC	RL_LP		; control char -> ignore
  21C1'   3A 0000*              	LDA	RLLEN
  21C4'   47                    	MOV	B,A
  21C5'   3A 0000*              	LDA	RLMAX
  21C8'   B8                    	CMP	B
  21C9'   CA 21A5'              	JZ	RL_LP		; full -> ignore
  21CC'   2A 0000*              	LHLD	RLPTR
  21CF'   71                    	MOV	M,C
  21D0'   23                    	INX	H
  21D1'   22 0000*              	SHLD	RLPTR
  21D4'   3A 0000*              	LDA	RLLEN
  21D7'   3C                    	INR	A
  21D8'   32 0000*              	STA	RLLEN
  21DB'   79                    	MOV	A,C
  21DC'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  21DF'   C3 21A5'              	JMP	RL_LP
  21E2'                         RL_BS:				; WM LINEPOP
  21E2'   3A 0000*              	LDA	RLLEN
  21E5'   B7                    	ORA	A
  21E6'   CA 21FA'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  21E9'   3D                    	DCR	A
  21EA'   32 0000*              	STA	RLLEN
  21ED'   2A 0000*              	LHLD	RLPTR
  21F0'   2B                    	DCX	H
  21F1'   22 0000*              	SHLD	RLPTR
  21F4'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  21F7'   C3 21A5'              	JMP	RL_LP
  21FA'                         RL_CAN:
  21FA'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  21FC'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  21FF'   CD 0877'              	CALL	SETLIN		; redraw one row
  2202'   3E FF                 	MVI	A,0FFH		; cancelled
  2204'   C9                    	RET
  2205'                         RL_DONE:
  2205'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
  2207'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  220A'   AF                    	XRA	A
  220B'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  220C'                         VC_BZ:
  220C'   CD 0871'              	CALL	SETMOV
  220F'   3A 0000*              	LDA	GSAVE
  2212'   FE 02                 	CPI	PZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2214'   CA 221F'              	JZ	VZ_ZZ
  2217'   B7                    	ORA	A
  2218'   C0                    	RNZ			; 'g' was pending: vim drops both
  2219'   3E 02                 	MVI	A,PZ
  221B'   32 0000*              	STA	GPEND
  221E'   C9                    	RET
  221F'                         VZ_ZZ:
  221F'   3E 04                 	MVI	A,EO_X
  2221'   32 0000*              	STA	EXOP
  2224'   3E 01                 	MVI	A,1
  2226'   32 0000*              	STA	EXBANG		; no '!'
  2229'   AF                    	XRA	A
  222A'   32 0000*              	STA	EXARG		; no file name
  222D'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  2230'   B7                    	ORA	A
  2231'   CA 2372'              	JZ	EX_Q
  2234'   C3 230C'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  2237'                         VC_EX:
  2237'   CD 079C'              	CALL	GETCNT
  223A'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  223D'   11 0000*              	LXI	D,EXBUF
  2240'   06 28                 	MVI	B,EXMAX
  2242'   0E 3A                 	MVI	C,':'
  2244'   CD 2194'              	CALL	RDLINE
  2247'   B7                    	ORA	A
  2248'   C0                    	RNZ			; cancelled
  2249'   3A 0000*              	LDA	RLLEN
  224C'   5F                    	MOV	E,A
  224D'   16 00                 	MVI	D,0
  224F'   21 0000*              	LXI	H,EXBUF
  2252'   19                    	DAD	D
  2253'   36 00                 	MVI	M,0		; the line ends with a 0
  2255'   21 0000*              	LXI	H,EXBUF
  2258'   CD 2824'              	CALL	SKIPB
  225B'   C8                    	RZ			; nothing on it
  225C'   22 0000*              	SHLD	EXCMD
  225F'   CD 2A48'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  2262'   CD 2824'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  2265'   56                    	MOV	D,M
  2266'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2267'   1E 00                 	MVI	E,0
  2269'   CD 2830'              	CALL	ISLOW
  226C'   DA 2277'              	JC	EX_LK
  226F'   5F                    	MOV	E,A
  2270'   23                    	INX	H
  2271'   CD 2830'              	CALL	ISLOW
  2274'   D2 2290'              	JNC	EX_NOT		; a third letter: none of ours
  2277'                         EX_LK:
  2277'   E5                    	PUSH	H
  2278'   21 2A2F'              	LXI	H,EXTAB
  227B'                         EX_TL:
  227B'   7E                    	MOV	A,M
  227C'   B7                    	ORA	A
  227D'   CA 228F'              	JZ	EX_NTP		; not in the table
  2280'   23                    	INX	H
  2281'   BA                    	CMP	D
  2282'   7E                    	MOV	A,M
  2283'   23                    	INX	H
  2284'   C2 228B'              	JNZ	EX_TN
  2287'   BB                    	CMP	E
  2288'   CA 2296'              	JZ	EX_TF
  228B'                         EX_TN:
  228B'   23                    	INX	H
  228C'   C3 227B'              	JMP	EX_TL
  228F'                         EX_NTP:
  228F'   E1                    	POP	H
  2290'                         EX_NOT:
  2290'   21 28E8'              	LXI	H,SNOT
  2293'   C3 2865'              	JMP	EXERT
  2296'                         EX_TF:
  2296'   7E                    	MOV	A,M
  2297'   32 0000*              	STA	EXOP
  229A'   E1                    	POP	H
  229B'   FE 06                 	CPI	EO_S
  229D'   CA 2AB7'              	JZ	EX_S		; ':s' reads the rest of the line itself
  22A0'   FE 01                 	CPI	EO_W
  22A2'   CA 22B1'              	JZ	EX_RG		; ':N,Mw name' takes a range
  22A5'   FE 08                 	CPI	EO_R
  22A7'   CA 22B1'              	JZ	EX_RG		; ... and ':Nr name' a line
  22AA'   3A 0000*              	LDA	SRNGF
  22AD'   B7                    	ORA	A
  22AE'   C2 2290'              	JNZ	EX_NOT		; a range on a command that does not take one
  22B1'                         EX_RG:
                                	;--- '!', then the file name ---
  22B1'   7E                    	MOV	A,M
  22B2'   D6 21                 	SUI	'!'
  22B4'   32 0000*              	STA	EXBANG		; 0 = '!'
  22B7'   C2 22BB'              	JNZ	EX_NB
  22BA'   23                    	INX	H
  22BB'                         EX_NB:
  22BB'   CD 2824'              	CALL	SKIPB
  22BE'   32 0000*              	STA	EXARG		; 0 = no file name
  22C1'   CA 22DA'              	JZ	EX_RUN
  22C4'   22 0000*              	SHLD	EXCMD
  22C7'   3A 0000*              	LDA	EXOP
  22CA'   FE 02                 	CPI	EO_Q
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22CC'   CA 2862'              	JZ	EX_TRL		; :q takes none
  22CF'   FE 07                 	CPI	EO_V
  22D1'   CA 2862'              	JZ	EX_TRL		; nor :ve
  22D4'   CD 278E'              	CALL	PARSFN
  22D7'   C2 2856'              	JNZ	EX_INV
  22DA'                         EX_RUN:
  22DA'   3A 0000*              	LDA	EXOP
  22DD'   FE 05                 	CPI	EO_E
  22DF'   CA 2389'              	JZ	EX_E
  22E2'   FE 02                 	CPI	EO_Q
  22E4'   CA 2372'              	JZ	EX_Q
  22E7'   FE 07                 	CPI	EO_V
  22E9'   CA 285C'              	JZ	EX_V
  22EC'   FE 08                 	CPI	EO_R
  22EE'   CA 251A'              	JZ	EX_R
  22F1'   FE 04                 	CPI	EO_X
  22F3'   CA 2305'              	JZ	EX_XM
  22F6'   FE 01                 	CPI	EO_W
  22F8'   C2 230C'              	JNZ	EX_W		; :wq
  22FB'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  22FE'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  22FF'   C2 243A'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2302'   C3 230C'              	JMP	EX_W
  2305'                         EX_XM:
  2305'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  2308'   B7                    	ORA	A
  2309'   CA 2372'              	JZ	EX_Q
  230C'                         EX_W:
  230C'   CD 25FA'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  230F'   D8                    	RC			; refused (message shown)
  2310'   32 0000*              	STA	EXBAK
  2313'   3A 0000*              	LDA	EXOP
  2316'   FE 01                 	CPI	EO_W
  2318'   CA 232F'              	JZ	EX_WK
  231B'   3A 0000*              	LDA	EXBAK
  231E'   B7                    	ORA	A
  231F'   C2 236F'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2322'   3A 0000*              	LDA	EXBANG
  2325'   B7                    	ORA	A
  2326'   CA 236F'              	JZ	EX_WQ		; so it does with '!'
  2329'   CD 232F'              	CALL	EX_WK		; else it may not: keep the text
  232C'   C3 2372'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  232F'                         EX_WK:
  232F'   CD 0EDE'              	CALL	CURRW		; the cursor's row and file position
  2332'   32 0000*              	STA	WPROW
  2335'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2338'   7D                    	MOV	A,L
  2339'   E6 7F                 	ANI	7FH
  233B'   32 0000*              	STA	WPBYT
  233E'   7D                    	MOV	A,L
  233F'   17                    	RAL
  2340'   7C                    	MOV	A,H
  2341'   17                    	RAL
  2342'   5F                    	MOV	E,A
  2343'   3E 00                 	MVI	A,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2345'   17                    	RAL
  2346'   57                    	MOV	D,A		; DE = HL / 128
  2347'   2A 0000*              	LHLD	OUTPOS
  234A'   19                    	DAD	D
  234B'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  234E'   CD 262F'              	CALL	WRITE
  2351'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  2354'   2A 0000*              	LHLD	WPREC
  2357'   EB                    	XCHG
  2358'   3A 0000*              	LDA	WPBYT
  235B'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  235E'   CD 0000*              	CALL	GOTO
  2361'                         EX_WRW:
  2361'   21 0000               	LXI	H,0
  2364'   22 0000*              	SHLD	LNDLT
  2367'   3A 0000*              	LDA	WPROW
  236A'   6F                    	MOV	L,A
  236B'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  236E'   C9                    	RET
  236F'                         EX_WQ:
  236F'   CD 262F'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  2372'                         EX_Q:
  2372'   3A 0000*              	LDA	EXBANG
  2375'   B7                    	ORA	A
  2376'   CA 2380'              	JZ	EX_QT
  2379'   3A 0000*              	LDA	MODF
  237C'   B7                    	ORA	A
  237D'   C2 284A'              	JNZ	MSGNWR		; changed, no '!': stay
  2380'                         EX_QT:
  2380'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  2383'   3E 01                 	MVI	A,1
  2385'   32 0000*              	STA	QUITF
  2388'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2389'                         EX_E:
  2389'   3A 0000*              	LDA	EXBANG
  238C'   B7                    	ORA	A
  238D'   CA 2397'              	JZ	EE_GO
  2390'   3A 0000*              	LDA	MODF
  2393'   B7                    	ORA	A
  2394'   C2 284A'              	JNZ	MSGNWR
  2397'                         EE_GO:
  2397'   3A 0000*              	LDA	EXARG
  239A'   B7                    	ORA	A
  239B'   C2 23A2'              	JNZ	EE_ARG
  239E'   CD 266B'              	CALL	OWNTF		; no name: the buffer's own
  23A1'   D8                    	RC
  23A2'                         EE_ARG:
  23A2'   CD 2681'              	CALL	ISOWN
  23A5'   21 0001               	LXI	H,1
  23A8'   C2 23AF'              	JNZ	EE_LD		; another file: its first line
  23AB'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  23AE'   23                    	INX	H		; HL = the cursor's line
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23AF'                         EE_LD:
  23AF'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  23B1'   32 0000*              	STA	MSGWHT
  23B4'   E5                    	PUSH	H
  23B5'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  23B8'   21 0000*              	LXI	H,TFCB
  23BB'   11 0000*              	LXI	D,FNAME
  23BE'   CD 2693'              	CALL	COPY12		; the buffer's name
  23C1'   CD 2658'              	CALL	SRCTF
  23C4'   CD 0000*              	CALL	REOPEN
  23C7'   CD 01EF'              	CALL	MKCLR		; the marks named the buffer that just went
  23CA'   AF                    	XRA	A
  23CB'   32 0000*              	STA	MODF
  23CE'   E1                    	POP	H
  23CF'   2B                    	DCX	H
  23D0'   AF                    	XRA	A
  23D1'   CD 0000*              	CALL	MVLIND		; down to the line
  23D4'   CD 0BFA'              	CALL	ATEOF
  23D7'   DC 0C00'              	CC	LASTLN		; past the last line: onto it
  23DA'   CD 13DF'              	CALL	ZSAVE
  23DD'   C3 14B4'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  23E0'                         TFDOS:
  23E0'   C5                    	PUSH	B
  23E1'   11 0080               	LXI	D,CMDTAIL
  23E4'   0E 1A                 	MVI	C,1AH		; set the DMA
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  23E6'   CD 0005               	CALL	BDOS
  23E9'   C1                    	POP	B
  23EA'   11 0000*              	LXI	D,TFCB
  23ED'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  23F0'                         EXRNG:
  23F0'   2A 0000*              	LHLD	SRNG1
  23F3'   7C                    	MOV	A,H
  23F4'   B5                    	ORA	L
  23F5'   37                    	STC
  23F6'   C8                    	RZ
  23F7'   2A 0000*              	LHLD	SRNG2
  23FA'   EB                    	XCHG
  23FB'   2A 0000*              	LHLD	SRNG1
  23FE'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2401'   D8                    	RC
  2402'   EB                    	XCHG			; HL = the last line, DE = the first
  2403'   CD 0000*              	CALL	SUBHD
  2406'   23                    	INX	H
  2407'   22 0000*              	SHLD	SLINES
  240A'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  240B'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  240C'                         GOLNX:
  240C'   E5                    	PUSH	H
  240D'   CD 135E'              	CALL	GOLN
  2410'   CD 0000*              	CALL	CNTLF
  2413'   23                    	INX	H		; the line the cursor came to rest on
  2414'   D1                    	POP	D
  2415'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2418'                         EXSAVP:
  2418'   CD 0EDE'              	CALL	CURRW
  241B'   32 0000*              	STA	WPROW
  241E'   21 0000*              	LXI	H,MKPOS
  2421'   C3 0448'              	JMP	FPSTO
  2424'                         EXRSTP:
  2424'   CD 0000*              	CALL	CLRCNT
  2427'   CD 03AC'              	CALL	MKPAGE		; page until that place is in the window again
  242A'   CD 0000*              	CALL	GOTO
  242D'   C3 2361'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2430'                         PUTBRK:
  2430'   3E 0D                 	MVI	A,CR
  2432'   CD 0000*              	CALL	PUTGAP
  2435'   3E 0A                 	MVI	A,LF
  2437'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  243A'                         EX_WR:
  243A'   3A 0000*              	LDA	EXARG
  243D'   B7                    	ORA	A
  243E'   CA 2838'              	JZ	MSGNFN		; No file name
  2441'   CD 2681'              	CALL	ISOWN
  2444'   CA 24E4'              	JZ	EXW_OW
  2447'   CD 0000*              	CALL	TEXIST
  244A'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  244D'   CA 2457'              	JZ	EXW_GO
  2450'   3A 0000*              	LDA	EXBANG
  2453'   B7                    	ORA	A
  2454'   C2 283E'              	JNZ	MSGEXI		; File exists (! to force)
  2457'                         EXW_GO:
  2457'   CD 23F0'              	CALL	EXRNG
  245A'   DA 24DE'              	JC	EXW_BD
  245D'   CD 2418'              	CALL	EXSAVP
  2460'   2A 0000*              	LHLD	SRNG1
  2463'   CD 240C'              	CALL	GOLNX
  2466'   C2 24DB'              	JNZ	EXW_NL		; the text has no line N
  2469'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  246C'   B7                    	ORA	A		;   not: only when TEXIST found one
  246D'   0E 13                 	MVI	C,13H
  246F'   C4 23E0'              	CNZ	TFDOS		; delete what is there
  2472'   0E 16                 	MVI	C,16H
  2474'   CD 23E0'              	CALL	TFDOS		; ... and make it
  2477'   3C                    	INR	A
  2478'   CA 24CD'              	JZ	EXW_FL		; no directory entry left
  247B'   3E 80                 	MVI	A,80H
  247D'   32 0000*              	STA	RWPTR
  2480'   AF                    	XRA	A
  2481'   32 0000*              	STA	RWERR
  2484'   2A 0000*              	LHLD	SLINES
  2487'   CD 0000*              	CALL	SETC0		; that many lines, forward
  248A'                         EXW_LP:
  248A'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  248D'   E5                    	PUSH	H
  248E'   EB                    	XCHG
  248F'   2A 0000*              	LHLD	GAPEND
  2492'   CD 24EA'              	CALL	RWOUT		; the text from the cursor to there
  2495'   E1                    	POP	H
  2496'   3A 0000*              	LDA	RWERR
  2499'   B7                    	ORA	A
  249A'   C2 24B6'              	JNZ	EXW_EN
  249D'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  24A0'   CD 07B1'              	CALL	CNTTST
  24A3'   C2 248A'              	JNZ	EXW_LP
  24A6'                         EXW_PD:				; the last record is padded out with ^Z
  24A6'   3A 0000*              	LDA	RWPTR
  24A9'   FE 80                 	CPI	80H
  24AB'   CA 24B6'              	JZ	EXW_EN
  24AE'   3E 1A                 	MVI	A,CPMEOF
  24B0'   CD 24F6'              	CALL	RWPUT
  24B3'   C3 24A6'              	JMP	EXW_PD
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24B6'                         EXW_EN:
  24B6'   0E 10                 	MVI	C,10H
  24B8'   CD 23E0'              	CALL	TFDOS		; close
  24BB'   3A 0000*              	LDA	RWERR
  24BE'   B7                    	ORA	A
  24BF'   C2 24CD'              	JNZ	EXW_FL
  24C2'   CD 2424'              	CALL	EXRSTP
  24C5'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  24C7'   32 0000*              	STA	MSGWHT
  24CA'   C3 0871'              	JMP	SETMOV		; nothing on the screen has changed
  24CD'                         EXW_FL:				; no room: the part written is not left behind
  24CD'   0E 13                 	MVI	C,13H
  24CF'   CD 23E0'              	CALL	TFDOS
  24D2'   CD 2424'              	CALL	EXRSTP
  24D5'   21 2A25'              	LXI	H,SDFUL
  24D8'   C3 2870'              	JMP	EXERR
  24DB'                         EXW_NL:
  24DB'   CD 2424'              	CALL	EXRSTP
  24DE'                         EXW_BD:
  24DE'   21 2A17'              	LXI	H,SRNGE
  24E1'   C3 2870'              	JMP	EXERR
  24E4'                         EXW_OW:
  24E4'   21 289F'              	LXI	H,SEXI
  24E7'   C3 2870'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  24EA'                         RWOUT:
  24EA'   CD 0000*              	CALL	CMP16
  24ED'   C8                    	RZ
  24EE'   7E                    	MOV	A,M
  24EF'   23                    	INX	H
  24F0'   CD 24F6'              	CALL	RWPUT
  24F3'   C3 24EA'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  24F6'                         RWPUT:
  24F6'   E5                    	PUSH	H
  24F7'   F5                    	PUSH	PSW
  24F8'   3A 0000*              	LDA	RWPTR
  24FB'   6F                    	MOV	L,A
  24FC'   26 00                 	MVI	H,0
  24FE'   F1                    	POP	PSW
  24FF'   77                    	MOV	M,A
  2500'   2C                    	INR	L		; Z: that was the record's last byte
  2501'   7D                    	MOV	A,L
  2502'   C2 2515'              	JNZ	RWP_ST
  2505'   D5                    	PUSH	D
  2506'   0E 15                 	MVI	C,15H
  2508'   CD 23E0'              	CALL	TFDOS		; write it
  250B'   D1                    	POP	D
  250C'   B7                    	ORA	A
  250D'   CA 2513'              	JZ	RWP_OK
  2510'   32 0000*              	STA	RWERR
  2513'                         RWP_OK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2513'   3E 80                 	MVI	A,80H
  2515'                         RWP_ST:
  2515'   32 0000*              	STA	RWPTR
  2518'   E1                    	POP	H
  2519'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  251A'                         EX_R:
  251A'   3A 0000*              	LDA	EXARG
  251D'   B7                    	ORA	A
  251E'   CA 2838'              	JZ	MSGNFN		; No file name
  2521'   0E 0F                 	MVI	C,0FH
  2523'   CD 23E0'              	CALL	TFDOS		; open
  2526'   3C                    	INR	A
  2527'   CA 25F4'              	JZ	ER_NOF
  252A'   CD 1405'              	CALL	GZONE		; the screen's top line, before anything moves
  252D'   CD 2418'              	CALL	EXSAVP
  2530'   3A 0000*              	LDA	SRNGF
  2533'   B7                    	ORA	A
  2534'   CA 254D'              	JZ	ER_NXT		; no line given: below the cursor's
  2537'   2A 0000*              	LHLD	SRNG2
  253A'   7C                    	MOV	A,H
  253B'   B5                    	ORA	L
  253C'   C2 2547'              	JNZ	ER_LN
  253F'   23                    	INX	H
  2540'   CD 135E'              	CALL	GOLN		; ':0r': above line 1 ...
  2543'   AF                    	XRA	A		;   which never wants a line end put in first
  2544'   C3 256F'              	JMP	ER_BRK
  2547'                         ER_LN:
  2547'   CD 240C'              	CALL	GOLNX
  254A'   C2 24DB'              	JNZ	EXW_NL		; the text has no line N
  254D'                         ER_NXT:
  254D'   21 0001               	LXI	H,1
  2550'   AF                    	XRA	A
  2551'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  2554'   CD 0BFA'              	CALL	ATEOF
  2557'   3E 00                 	MVI	A,0
  2559'   D2 256F'              	JNC	ER_BRK		; text follows
  255C'   2A 0000*              	LHLD	GAPBEG
  255F'   EB                    	XCHG
  2560'   2A 0000*              	LHLD	TXTBEG
  2563'   CD 0000*              	CALL	CMP16
  2566'   3E 01                 	MVI	A,1
  2568'   CA 256F'              	JZ	ER_BRK		; nothing before the cursor either
  256B'   1B                    	DCX	D
  256C'   1A                    	LDAX	D
  256D'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  256F'                         ER_BRK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  256F'   32 0000*              	STA	RDBRK
  2572'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2575'   AF                    	XRA	A
  2576'   32 0000*              	STA	RDANY
  2579'                         ER_LP:
  2579'   0E 14                 	MVI	C,14H
  257B'   CD 23E0'              	CALL	TFDOS		; the next record
  257E'   B7                    	ORA	A
  257F'   C2 25B2'              	JNZ	ER_END
  2582'   21 0080               	LXI	H,CMDTAIL
  2585'   0E 00                 	MVI	C,0
  2587'                         ER_SC:				; C = its bytes, up to a ^Z
  2587'   7E                    	MOV	A,M
  2588'   FE 1A                 	CPI	CPMEOF
  258A'   CA 2592'              	JZ	ER_GOT
  258D'   23                    	INX	H
  258E'   0C                    	INR	C
  258F'   F2 2587'              	JP	ER_SC		; (minus: all 128)
  2592'                         ER_GOT:
  2592'   79                    	MOV	A,C
  2593'   B7                    	ORA	A
  2594'   CA 25B2'              	JZ	ER_END
  2597'   C5                    	PUSH	B
  2598'   3A 0000*              	LDA	RDANY
  259B'   B7                    	ORA	A
  259C'   CC 25E3'              	CZ	ER_1ST
  259F'   C1                    	POP	B
  25A0'   06 00                 	MVI	B,0
  25A2'   11 0080               	LXI	D,CMDTAIL
  25A5'   C5                    	PUSH	B
  25A6'   CD 0000*              	CALL	INSBLK
  25A9'   C1                    	POP	B
  25AA'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  25AD'   79                    	MOV	A,C
  25AE'   17                    	RAL
  25AF'   DA 2579'              	JC	ER_LP		; a full record: there may be more
  25B2'                         ER_END:
  25B2'   3A 0000*              	LDA	RDANY
  25B5'   B7                    	ORA	A
  25B6'   CA 25D4'              	JZ	ER_PL		; nothing in the file: nothing has changed
  25B9'   CD 0BFA'              	CALL	ATEOF
  25BC'   DA 25C9'              	JC	ER_MD		; the text now ends as the file read ends
  25BF'   2A 0000*              	LHLD	GAPBEG
  25C2'   2B                    	DCX	H
  25C3'   7E                    	MOV	A,M
  25C4'   FE 0A                 	CPI	LF
  25C6'   C4 2430'              	CNZ	PUTBRK		; text follows: what was read ends a line
  25C9'                         ER_MD:
  25C9'   3E 01                 	MVI	A,1
  25CB'   32 0000*              	STA	MODF
  25CE'   CD 03AC'              	CALL	MKPAGE		; back to the first line read
  25D1'   CD 0000*              	CALL	GOTO
  25D4'                         ER_PL:
  25D4'   CD 0BFA'              	CALL	ATEOF
  25D7'   DC 0C00'              	CC	LASTLN		; (nothing read, at the end: the last line)
  25DA'   CD 0000*              	CALL	CLRCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25DD'   CD 141D'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  25E0'   C3 08AE'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  25E3'                         ER_1ST:
  25E3'   3C                    	INR	A
  25E4'   32 0000*              	STA	RDANY
  25E7'   3A 0000*              	LDA	RDBRK
  25EA'   B7                    	ORA	A
  25EB'   C4 2430'              	CNZ	PUTBRK
  25EE'   21 0000*              	LXI	H,MKPOS
  25F1'   C3 0448'              	JMP	FPSTO
  25F4'                         ER_NOF:
  25F4'   21 2A06'              	LXI	H,SNOPN
  25F7'   C3 2865'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  25FA'                         WRCHK:
  25FA'   3A 0000*              	LDA	EXARG
  25FD'   B7                    	ORA	A
  25FE'   C2 2608'              	JNZ	WC_ARG
  2601'   CD 266B'              	CALL	OWNTF
  2604'   D8                    	RC
  2605'   C3 261D'              	JMP	WC_OWN
  2608'                         WC_ARG:
  2608'   CD 2681'              	CALL	ISOWN
  260B'   CA 261D'              	JZ	WC_OWN
  260E'   3A 0000*              	LDA	EXBANG
  2611'   B7                    	ORA	A
  2612'   CA 261B'              	JZ	WC_OTH
  2615'   CD 0000*              	CALL	TEXIST
  2618'   C2 283E'              	JNZ	MSGEXI		; File exists (! to force)
  261B'                         WC_OTH:
  261B'   AF                    	XRA	A		; (NC)
  261C'   C9                    	RET
  261D'                         WC_OWN:
  261D'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  2620'   B7                    	ORA	A
  2621'   CA 262B'              	JZ	WC_OK
  2624'   3A 0000*              	LDA	EXBANG
  2627'   B7                    	ORA	A
  2628'   C2 2844'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  262B'                         WC_OK:
  262B'   3E 01                 	MVI	A,1
  262D'   B7                    	ORA	A		; (NC)
  262E'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  262F'                         WRITE:
  262F'   3A 0000*              	LDA	EXBAK
  2632'   CD 0000*              	CALL	WRTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2635'   3A 0001*              	LDA	FNAME+1
  2638'   FE 20                 	CPI	' '
  263A'   C2 2646'              	JNZ	WR_HAS
  263D'   21 0000*              	LXI	H,TFCB
  2640'   11 0000*              	LXI	D,FNAME
  2643'   CD 2693'              	CALL	COPY12
  2646'                         WR_HAS:
  2646'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2648'   32 0000*              	STA	MSGWHT
  264B'   CD 2681'              	CALL	ISOWN
  264E'   C2 2658'              	JNZ	SRCTF
  2651'   AF                    	XRA	A
  2652'   32 0000*              	STA	MODF
  2655'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2658'                         SRCTF:
  2658'   21 0000*              	LXI	H,TFCB
  265B'   11 005C               	LXI	D,DFTFCB
  265E'   CD 2693'              	CALL	COPY12
  2661'   AF                    	XRA	A
  2662'   06 04                 	MVI	B,4
  2664'                         SRC_Z:
  2664'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2665'   13                    	INX	D
  2666'   05                    	DCR	B
  2667'   C2 2664'              	JNZ	SRC_Z
  266A'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  266B'                         OWNTF:
  266B'   3A 0001*              	LDA	FNAME+1
  266E'   FE 20                 	CPI	' '
  2670'   CA 2838'              	JZ	MSGNFN
  2673'   CD 269E'              	CALL	TFCLR
  2676'   21 0000*              	LXI	H,FNAME
  2679'   11 0000*              	LXI	D,TFCB
  267C'   CD 2693'              	CALL	COPY12
  267F'   B7                    	ORA	A		; (NC)
  2680'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2681'                         ISOWN:
  2681'   21 0000*              	LXI	H,TFCB
  2684'   11 0000*              	LXI	D,FNAME
  2687'   06 0C                 	MVI	B,12
  2689'                         IO_LP:
  2689'   1A                    	LDAX	D
  268A'   BE                    	CMP	M
  268B'   C0                    	RNZ
  268C'   23                    	INX	H
  268D'   13                    	INX	D
  268E'   05                    	DCR	B
  268F'   C2 2689'              	JNZ	IO_LP
  2692'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  2693'                         COPY12:
  2693'   06 0C                 	MVI	B,12
  2695'                         CP_LP:
  2695'   7E                    	MOV	A,M
  2696'   12                    	STAX	D
  2697'   23                    	INX	H
  2698'   13                    	INX	D
  2699'   05                    	DCR	B
  269A'   C2 2695'              	JNZ	CP_LP
  269D'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  269E'                         TFCLR:
  269E'   11 0000*              	LXI	D,TFCB
  26A1'   06 24                 	MVI	B,36
  26A3'   AF                    	XRA	A
  26A4'                         TC_LP:
  26A4'   12                    	STAX	D
  26A5'   13                    	INX	D
  26A6'   05                    	DCR	B
  26A7'   C2 26A4'              	JNZ	TC_LP
  26AA'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  26AB'                         FOPEN:
  26AB'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  26AD'   32 0000*              	STA	MSGWHT
  26B0'   21 005C               	LXI	H,DFTFCB
  26B3'   CD 2781'              	CALL	NRMDRV
  26B6'   11 0000*              	LXI	D,FNAME
  26B9'   CD 2693'              	CALL	COPY12
  26BC'   CD 0000*              	CALL	OPENZ
  26BF'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  26C2'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  26C4'   C8                    	RZ
  26C5'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  26C8'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  26CB'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  26CC'                         ARGSCN:
  26CC'   3A 0080               	LDA	CMDTAIL
  26CF'   47                    	MOV	B,A		; B = what is left of the line
  26D0'   B7                    	ORA	A
  26D1'   C8                    	RZ
  26D2'   21 0081               	LXI	H,CMDTAIL+1
  26D5'                         AS_TOK:				; at a token, or the blanks before one
  26D5'   7E                    	MOV	A,M
  26D6'   FE 20                 	CPI	' '
  26D8'   C2 26E1'              	JNZ	AS_OPT
  26DB'   23                    	INX	H
  26DC'   05                    	DCR	B
  26DD'   C2 26D5'              	JNZ	AS_TOK
  26E0'   C9                    	RET
  26E1'                         AS_OPT:
  26E1'   FE 2B                 	CPI	'+'
  26E3'   CA 270D'              	JZ	AS_PLS
  26E6'   FE 2D                 	CPI	'-'
  26E8'   CA 26FC'              	JZ	AS_SW
  26EB'   FE 2F                 	CPI	'/'
  26ED'   CA 26FC'              	JZ	AS_SW
  26F0'                         AS_SKP:				; not ours (the file name): on to the next one
  26F0'   23                    	INX	H
  26F1'   05                    	DCR	B
  26F2'   C8                    	RZ
  26F3'   7E                    	MOV	A,M
  26F4'   FE 20                 	CPI	' '
  26F6'   C2 26F0'              	JNZ	AS_SKP
  26F9'   C3 26D5'              	JMP	AS_TOK
  26FC'                         AS_SW:
  26FC'   23                    	INX	H
  26FD'   05                    	DCR	B
  26FE'   C8                    	RZ
  26FF'   7E                    	MOV	A,M
  2700'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2702'   FE 52                 	CPI	'R'
  2704'   C2 26F0'              	JNZ	AS_SKP
  2707'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  270A'   C3 26F0'              	JMP	AS_SKP
  270D'                         AS_PLS:
  270D'   3E 01                 	MVI	A,1
  270F'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  2712'   11 0000*              	LXI	D,PLUSB
  2715'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2717'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2718'   05                    	DCR	B
  2719'   CA 2750'              	JZ	AS_PE
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  271C'   7E                    	MOV	A,M
  271D'   FE 30                 	CPI	'0'
  271F'   C2 2737'              	JNZ	AS_PD
  2722'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2722'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2723'   05                    	DCR	B
  2724'   CA 2758'              	JZ	AS_P1
  2727'   7E                    	MOV	A,M
  2728'   FE 30                 	CPI	'0'
  272A'   CA 2722'              	JZ	AS_PZ
  272D'   FE 31                 	CPI	'1'
  272F'   DA 2758'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2732'   FE 3A                 	CPI	'9'+1
  2734'   D2 2758'              	JNC	AS_P1
  2737'                         AS_PD:				; the digits, as typed
  2737'   7E                    	MOV	A,M
  2738'   FE 30                 	CPI	'0'
  273A'   DA 2750'              	JC	AS_PE
  273D'   FE 3A                 	CPI	'9'+1
  273F'   D2 2750'              	JNC	AS_PE
  2742'   79                    	MOV	A,C
  2743'   B7                    	ORA	A
  2744'   CA 275F'              	JZ	AS_POV
  2747'   0D                    	DCR	C
  2748'   7E                    	MOV	A,M
  2749'   12                    	STAX	D
  274A'   13                    	INX	D
  274B'   23                    	INX	H
  274C'   05                    	DCR	B
  274D'   C2 2737'              	JNZ	AS_PD
  2750'                         AS_PE:
  2750'   AF                    	XRA	A
  2751'   12                    	STAX	D		; the digits end with a 0
  2752'   78                    	MOV	A,B
  2753'   B7                    	ORA	A
  2754'   C8                    	RZ
  2755'   C3 26D5'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2758'                         AS_P1:
  2758'   3E 31                 	MVI	A,'1'
  275A'   12                    	STAX	D
  275B'   13                    	INX	D
  275C'   C3 2750'              	JMP	AS_PE
  275F'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  275F'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2762'   C3 2750'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2765'                         ARGGO:
  2765'   3A 0000*              	LDA	PLUSF
  2768'   B7                    	ORA	A
  2769'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  276A'   21 0000*              	LXI	H,PLUSB
  276D'                         AG_LP:
  276D'   7E                    	MOV	A,M
  276E'   B7                    	ORA	A
  276F'   CA 277C'              	JZ	AG_G
  2772'   4F                    	MOV	C,A
  2773'   E5                    	PUSH	H
  2774'   CD 0026'              	CALL	VICMD
  2777'   E1                    	POP	H
  2778'   23                    	INX	H
  2779'   C3 276D'              	JMP	AG_LP
  277C'                         AG_G:
  277C'   0E 47                 	MVI	C,'G'
  277E'   C3 0026'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  2781'                         NRMDRV:
  2781'   7E                    	MOV	A,M
  2782'   B7                    	ORA	A
  2783'   C0                    	RNZ
  2784'   E5                    	PUSH	H
  2785'   0E 19                 	MVI	C,BF_CURDSK
  2787'   CD 0005               	CALL	BDOS
  278A'   E1                    	POP	H
  278B'   3C                    	INR	A
  278C'   77                    	MOV	M,A
  278D'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
