  1ED1'   F5                    	PUSH	PSW
  1ED2'                         PD_LP:
  1ED2'   3E 20                 	MVI	A,' '
  1ED4'   12                    	STAX	D
  1ED5'   13                    	INX	D
  1ED6'   0D                    	DCR	C
  1ED7'   C2 1ED2'              	JNZ	PD_LP
  1EDA'   F1                    	POP	PSW
  1EDB'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
