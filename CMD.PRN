  2970'   0C66'                 	DW	VCBGE
  2972'   47                    	DB	'G'
  2973'   0EC1'                 	DW	VC_G
  2975'   67                    	DB	'g'
  2976'   0F14'                 	DW	VC_LG
  2978'   78                    	DB	'x'
  2979'   14C8'                 	DW	VC_X
