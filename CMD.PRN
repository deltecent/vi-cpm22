  1009'   3A 0000*              	LDA	SCEOF
  100C'   B7                    	ORA	A
  100D'   CA 1015'              	JZ	VHD_GO
  1010'   3A 0000*              	LDA	SCBOT		; the last line's place
  1013'   B8                    	CMP	B
  1014'   C8                    	RZ			; the cursor is on it
  1015'                         VHD_GO:
  1015'   3A 0000*              	LDA	NEDIT
  1018'   21 2E79'              	LXI	H,HFN
  101B'   86                    	ADD	M
  101C'   3C                    	INR	A
  101D'   4F                    	MOV	C,A
  101E'   AF                    	XRA	A
  101F'   CD 111A'              	CALL	HTSET		; HL -> the top line's rows
  1022'   3A 2E79'              	LDA	HFN
  1025'   57                    	MOV	D,A		; D = the rows the text moves
  1026'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1027'   3A 2E7F'              	LDA	HTEOF
  102A'   B7                    	ORA	A
