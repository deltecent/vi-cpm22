  1BE0'   49 6E 76 61           SINV:	DB	'Invalid file name',0
  1BE4'   6C 69 64 20           
  1BE8'   66 69 6C 65           
  1BEC'   20 6E 61 6D           
  1BF0'   65 00                 
  1BF2'   54 72 61 69           STRL:	DB	'Trailing chars: ',0
  1BF6'   6C 69 6E 67           
  1BFA'   20 63 68 61           
  1BFE'   72 73 3A 20           
  1C02'   00                    
