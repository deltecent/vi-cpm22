  235E'   4E 6F 20 70           SNOPAT: DB	'No previous search pattern',0
  2362'   72 65 76 69           
  2366'   6F 75 73 20           
  236A'   73 65 61 72           
  236E'   63 68 20 70           
  2372'   61 74 74 65           
  2376'   72 6E 00              
  2379'   43 61 6E 6E           SUNDW:	DB	'Cannot undo: change has paged out',0
  237D'   6F 74 20 75           
  2381'   6E 64 6F 3A           
  2385'   20 63 68 61           
  2389'   6E 67 65 20           
  238D'   68 61 73 20           
  2391'   70 61 67 65           
  2395'   64 20 6F 75           
  2399'   74 00                 
  239B'   54 6F 6F 20           SUNDB:	DB	'Too large to undo',0
  239F'   6C 61 72 67           
  23A3'   65 20 74 6F           
  23A7'   20 75 6E 64           
  23AB'   6F 00                 
  23AD'   54 6F 6F 20           SQBIG:	DB	'Too large to yank',0
  23B1'   6C 61 72 67           
  23B5'   65 20 74 6F           
  23B9'   20 79 61 6E           
  23BD'   6B 00                 
  23BF'   4D 61 72 6B           SMKNS:	DB	'Mark not set',0
  23C3'   20 6E 6F 74           
