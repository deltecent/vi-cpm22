  1093'   CD 109E'              	CALL	MULSAT
  1096'   22 0000*              	SHLD	RWR
  1099'   AF                    	XRA	A
  109A'   32 0000*              	STA	RWMV
  109D'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  109E'                         MULSAT:
  109E'   EB                    	XCHG
  109F'   21 0000               	LXI	H,0
  10A2'   B7                    	ORA	A
  10A3'   C8                    	RZ
