  112B'   AF                    	XRA	A
  112C'                         HL_SET:
  112C'   CD 0EDA'              	CALL	SETRWT
  112F'   C3 0954'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1132'                         VHD_TL:
  1132'   3A 0000*              	LDA	SKIPR
  1135'   47                    	MOV	B,A
  1136'   3A 0000*              	LDA	CSUB
  1139'   90                    	SUB	B		; A = that row
