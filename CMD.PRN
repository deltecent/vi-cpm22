  23A0'   74 74 65 6E           
  23A4'   00                    
  23A5'   43 61 6E 27           SNOPN:	DB	'Can''t open file ',0
  23A9'   74 20 6F 70           
  23AD'   65 6E 20 66           
  23B1'   69 6C 65 20           
  23B5'   00                    
  23B6'   49 6E 76 61           SRNGE:	DB	'Invalid range',0
  23BA'   6C 69 64 20           
  23BE'   72 61 6E 67           
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  23C2'   65 00                 
  23C4'   44 69 73 6B           SDFUL:	DB	'Disk full',0
  23C8'   20 66 75 6C           
  23CC'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  23CE'                         EXTAB:
  23CE'   77 00 01              	DB	'w',0,EO_W
  23D1'   71 00 02              	DB	'q',0,EO_Q
  23D4'   77 71 03              	DB	'w','q',EO_WQ
  23D7'   78 00 04              	DB	'x',0,EO_X
  23DA'   65 00 05              	DB	'e',0,EO_E
  23DD'   73 00 06              	DB	's',0,EO_S
  23E0'   76 65 07              	DB	'v','e',EO_V
  23E3'   72 00 08              	DB	'r',0,EO_R
  23E6'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  23E7'                         EXADDR:
  23E7'   AF                    	XRA	A
  23E8'   32 2A41'              	STA	SRNGF
  23EB'   7E                    	MOV	A,M
  23EC'   FE 25                 	CPI	'%'
  23EE'   CA 2417'              	JZ	EXA_AL
  23F1'   EB                    	XCHG			; DE walks the line, HL takes the number
  23F2'   CD 242C'              	CALL	EXNUM
  23F5'   DA 2415'              	JC	EXA_NO
  23F8'   22 2A42'              	SHLD	SRNG1
  23FB'   22 2A44'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  23FE'   1A                    	LDAX	D
  23FF'   FE 2C                 	CPI	','
  2401'   C2 240E'              	JNZ	EXA_YS
  2404'   13                    	INX	D
  2405'   CD 242C'              	CALL	EXNUM
  2408'   DA 2415'              	JC	EXA_NO		; ',' with no number: not a range at all
  240B'   22 2A44'              	SHLD	SRNG2
  240E'                         EXA_YS:
  240E'   EB                    	XCHG
  240F'   3E 01                 	MVI	A,1
  2411'   32 2A41'              	STA	SRNGF
  2414'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2415'                         EXA_NO:
  2415'   EB                    	XCHG
  2416'   C9                    	RET
  2417'                         EXA_AL:
  2417'   23                    	INX	H
  2418'   E5                    	PUSH	H
  2419'   21 0001               	LXI	H,1
  241C'   22 2A42'              	SHLD	SRNG1
  241F'   21 FFFF               	LXI	H,0FFFFH
  2422'   22 2A44'              	SHLD	SRNG2
  2425'   E1                    	POP	H
  2426'   3E 01                 	MVI	A,1
  2428'   32 2A41'              	STA	SRNGF
  242B'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  242C'                         EXNUM:
  242C'   1A                    	LDAX	D
  242D'   D6 30                 	SUI	'0'
  242F'   D8                    	RC
  2430'   FE 0A                 	CPI	10
  2432'   3F                    	CMC
  2433'   D8                    	RC
  2434'   21 0000               	LXI	H,0
  2437'                         EXN_LP:
  2437'   1A                    	LDAX	D
  2438'   D6 30                 	SUI	'0'
  243A'   DA 2454'              	JC	EXN_DN
  243D'   FE 0A                 	CPI	10
  243F'   D2 2454'              	JNC	EXN_DN
  2442'   13                    	INX	D
  2443'   C5                    	PUSH	B
  2444'   4F                    	MOV	C,A
  2445'   06 00                 	MVI	B,0		; BC = the digit
  2447'   D5                    	PUSH	D
  2448'   54                    	MOV	D,H
  2449'   5D                    	MOV	E,L
  244A'   29                    	DAD	H		; *2
  244B'   29                    	DAD	H		; *4
  244C'   19                    	DAD	D		; *5
  244D'   29                    	DAD	H		; *10
  244E'   D1                    	POP	D
  244F'   09                    	DAD	B
  2450'   C1                    	POP	B
  2451'   C3 2437'              	JMP	EXN_LP
  2454'                         EXN_DN:
  2454'   B7                    	ORA	A		; CY clear: there was a number
  2455'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2456'                         EX_S:
  2456'   7E                    	MOV	A,M
  2457'   B7                    	ORA	A
  2458'   CA 249A'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  245B'   32 2A46'              	STA	SDELIM
  245E'   23                    	INX	H
  245F'   11 0000*              	LXI	D,SRCHST
  2462'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2465'   4F                    	MOV	C,A
  2466'   CD 24A0'              	CALL	SCOPY
  2469'   78                    	MOV	A,B
  246A'   B7                    	ORA	A
  246B'   CA 249A'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  246E'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2471'   3E 01                 	MVI	A,1
  2473'   32 2A0E'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2476'   11 2A58'              	LXI	D,SREPL
  2479'   0E 24                 	MVI	C,SREPMX
  247B'   CD 24A0'              	CALL	SCOPY
  247E'   78                    	MOV	A,B
  247F'   32 2A57'              	STA	SREPLN
  2482'   AF                    	XRA	A
  2483'   32 2A47'              	STA	SGFLAG
  2486'   7E                    	MOV	A,M
  2487'   FE 67                 	CPI	'g'
  2489'   C2 2492'              	JNZ	EX_SG
  248C'   23                    	INX	H
  248D'   3E 01                 	MVI	A,1
  248F'   32 2A47'              	STA	SGFLAG
  2492'                         EX_SG:
  2492'   7E                    	MOV	A,M
  2493'   B7                    	ORA	A
  2494'   C2 2231'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2497'   C3 24C0'              	JMP	SUBGO
  249A'                         SUBNOP:
  249A'   21 22E9'              	LXI	H,SNOPAT
  249D'   C3 223F'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  24A0'                         SCOPY:
  24A0'   06 00                 	MVI	B,0
  24A2'                         SCP_LP:
  24A2'   78                    	MOV	A,B
  24A3'   B9                    	CMP	C
  24A4'   D2 24BD'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  24A7'   7E                    	MOV	A,M
  24A8'   B7                    	ORA	A
  24A9'   CA 24BD'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  24AC'   E5                    	PUSH	H
  24AD'   21 2A46'              	LXI	H,SDELIM
  24B0'   BE                    	CMP	M
  24B1'   E1                    	POP	H
  24B2'   CA 24BC'              	JZ	SCP_SK
  24B5'   12                    	STAX	D
  24B6'   13                    	INX	D
  24B7'   23                    	INX	H
  24B8'   04                    	INR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  24B9'   C3 24A2'              	JMP	SCP_LP
  24BC'                         SCP_SK:
  24BC'   23                    	INX	H
  24BD'                         SCP_DN:
  24BD'   AF                    	XRA	A
  24BE'   12                    	STAX	D
  24BF'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  24C0'                         SUBGO:
  24C0'   CD 0F60'              	CALL	GZONE
  24C3'   2A 0000*              	LHLD	LNDLT
  24C6'   22 2A55'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  24C9'   21 2A52'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  24CC'   CD 044F'              	CALL	FPSTO		;   search's SN_BAD does
  24CF'   AF                    	XRA	A
  24D0'   32 2A48'              	STA	SANY
  24D3'   21 0000               	LXI	H,0
  24D6'   22 2A4A'              	SHLD	SBACK
  24D9'   3A 2A41'              	LDA	SRNGF
  24DC'   B7                    	ORA	A
  24DD'   CA 24EF'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  24E0'   CD 1DBB'              	CALL	EXRNG		; SLINES = the lines in the range
  24E3'   DA 256B'              	JC	SUBBAD
  24E6'   2A 2A42'              	LHLD	SRNG1
  24E9'   CD 0ECE'              	CALL	GOLN
  24EC'   C3 24F5'              	JMP	SUBLP
  24EF'                         SUB_1L:
  24EF'   21 0001               	LXI	H,1
  24F2'   22 2A4C'              	SHLD	SLINES
  24F5'                         SUBLP:
  24F5'   CD 2571'              	CALL	SUBLIN		; A = 1 when this line changed
  24F8'   B7                    	ORA	A
  24F9'   CA 2507'              	JZ	SUB_NX
  24FC'   3E 01                 	MVI	A,1
  24FE'   32 2A48'              	STA	SANY
  2501'   21 0000               	LXI	H,0
  2504'   22 2A4A'              	SHLD	SBACK		; the cursor is ON the last line changed
  2507'                         SUB_NX:
  2507'   2A 2A4C'              	LHLD	SLINES
  250A'   2B                    	DCX	H
  250B'   22 2A4C'              	SHLD	SLINES
  250E'   7C                    	MOV	A,H
  250F'   B5                    	ORA	L
  2510'   CA 252E'              	JZ	SUBDON		; the range is spent
  2513'   21 0001               	LXI	H,1
  2516'   AF                    	XRA	A
  2517'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  251A'   3A 2A48'              	LDA	SANY
  251D'   B7                    	ORA	A
  251E'   CA 2528'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2521'   2A 2A4A'              	LHLD	SBACK
  2524'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2525'   22 2A4A'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2528'                         SUB_AE:
  2528'   CD 0A04'              	CALL	ATEOF
  252B'   D2 24F5'              	JNC	SUBLP		; ... unless that ran off the end of the file
  252E'                         SUBDON:
  252E'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2531'   3A 2A48'              	LDA	SANY
  2534'   B7                    	ORA	A
  2535'   CA 2553'              	JZ	SUBNFD
  2538'   3E 01                 	MVI	A,1
  253A'   32 298F'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  253D'   2A 2A4A'              	LHLD	SBACK
  2540'   7C                    	MOV	A,H
  2541'   B5                    	ORA	L
  2542'   CA 254D'              	JZ	SUB_PL
  2545'   3E FF                 	MVI	A,0FFH
  2547'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  254A'   CD 0000*              	CALL	CLRCNT
  254D'                         SUB_PL:
  254D'   CD 0F78'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2550'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2553'                         SUBNFD:
  2553'   21 2A52'              	LXI	H,SOFFS
  2556'   CD 03F6'              	CALL	BACKTO
  2559'   2A 2A55'              	LHLD	SLDLTS
  255C'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  255F'   21 22C9'              	LXI	H,SNOTFD
  2562'   CD 223F'              	CALL	EXERR
  2565'   21 0000*              	LXI	H,SRCHST
  2568'   C3 223A'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  256B'                         SUBBAD:
  256B'   21 22B7'              	LXI	H,SNOT
  256E'   C3 2234'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2571'                         SUBLIN:
  2571'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2572'   32 2A49'              	STA	SLCHG
  2575'   CD 25F0'              	CALL	SUBBOL
  2578'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  257B'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  257B'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  257E'   DA 2586'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2581'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2583'   C2 257B'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2586'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2586'   CD 0000*              	CALL	CUROFF
  2589'   E5                    	PUSH	H
  258A'   CD 1474'              	CALL	CEND
  258D'   D1                    	POP	D
  258E'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2591'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2592'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2595'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2596'   B7                    	ORA	A		;   span is a line, not a pair.)
  2597'   FA 25E9'              	JM	SUBL_D		; what is left is shorter than the pattern
  259A'   44                    	MOV	B,H
  259B'   4D                    	MOV	C,L		; BC = the start positions a match can take
  259C'   11 0000*              	LXI	D,SRCHST
  259F'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  25A2'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  25A5'   DA 25E9'              	JC	SUBL_D
  25A8'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  25AB'   EB                    	XCHG
  25AC'   2A 0000*              	LHLD	GAPEND
  25AF'   EB                    	XCHG
  25B0'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  25B3'   EB                    	XCHG
  25B4'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  25B5'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  25B8'   D1                    	POP	D
  25B9'   19                    	DAD	D		; ... and so the match's logical offset
  25BA'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  25BD'   3A 2A48'              	LDA	SANY
  25C0'   B7                    	ORA	A
  25C1'   C2 25CE'              	JNZ	SUBL_C
  25C4'   3A 2A49'              	LDA	SLCHG
  25C7'   B7                    	ORA	A
  25C8'   C2 25CE'              	JNZ	SUBL_C
  25CB'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  25CE'                         SUBL_C:
  25CE'   3A 0000*              	LDA	SRCHBF
  25D1'   6F                    	MOV	L,A
  25D2'   26 00                 	MVI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  25D4'   CD 0000*              	CALL	DELFWD		; the match goes
  25D7'   11 2A57'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  25DA'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  25DD'                         SUBL_I:
  25DD'   3E 01                 	MVI	A,1
  25DF'   32 2A49'              	STA	SLCHG
  25E2'   3A 2A47'              	LDA	SGFLAG
  25E5'   B7                    	ORA	A
  25E6'   C2 2586'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  25E9'                         SUBL_D:
  25E9'   CD 25F0'              	CALL	SUBBOL
  25EC'   3A 2A49'              	LDA	SLCHG
  25EF'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  25F0'                         SUBBOL:
  25F0'   CD 0000*              	CALL	CUROFF
  25F3'   CD 05E4'              	CALL	BOL
  25F6'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  25F9'                         VC_SRCH:
  25F9'   CD 075A'              	CALL	SETMOV
  25FC'   C5                    	PUSH	B
  25FD'   CD 068B'              	CALL	GETCNT
  2600'   22 2A37'              	SHLD	SCNT
  2603'   C1                    	POP	B
  2604'   79                    	MOV	A,C
  2605'   FE 2F                 	CPI	'/'
  2607'   3E 00                 	MVI	A,0
  2609'   CA 260E'              	JZ	VS_DIR
  260C'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  260E'                         VS_DIR:
  260E'   32 2A0C'              	STA	SDIR
  2611'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2614'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2617'   47                    	MOV	B,A
  2618'   CD 1B57'              	CALL	RDLINE
  261B'   B7                    	ORA	A
  261C'   C0                    	RNZ			; cancelled: nothing happens at all
  261D'   3A 29E4'              	LDA	RLLEN
  2620'   B7                    	ORA	A
  2621'   CA 2636'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2624'   5F                    	MOV	E,A
  2625'   16 00                 	MVI	D,0
  2627'   21 0000*              	LXI	H,SRCHST
  262A'   19                    	DAD	D
  262B'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  262D'   7B                    	MOV	A,E
  262E'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2631'   3E 01                 	MVI	A,1
  2633'   32 2A0E'              	STA	SHAVE
  2636'                         VS_OLD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2636'   3A 2A0E'              	LDA	SHAVE
  2639'   B7                    	ORA	A
  263A'   CA 2646'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  263D'   3A 2A0C'              	LDA	SDIR
  2640'   32 2A0D'              	STA	SDIRE
  2643'   C3 266F'              	JMP	SRCHN
  2646'                         VS_NOP:
  2646'   21 22E9'              	LXI	H,SNOPAT
  2649'   C3 223F'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  264C'                         VC_N:
  264C'   CD 075A'              	CALL	SETMOV
  264F'   3A 2A0C'              	LDA	SDIR
  2652'   C3 265C'              	JMP	VN_GO
  2655'                         VCB_N:
  2655'   CD 075A'              	CALL	SETMOV
  2658'   3A 2A0C'              	LDA	SDIR
  265B'   2F                    	CMA			; the other way: 0 <-> FFH
  265C'                         VN_GO:
  265C'   32 2A0D'              	STA	SDIRE
  265F'   CD 068B'              	CALL	GETCNT
  2662'   22 2A37'              	SHLD	SCNT
  2665'   3A 2A0E'              	LDA	SHAVE
  2668'   B7                    	ORA	A
  2669'   CA 2646'              	JZ	VS_NOP
  266C'   C3 266F'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  266F'                         SRCHN:
  266F'   CD 0F60'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2672'   CD 06B4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and a ^C may stop it
  2675'                         SN_LP:
  2675'   CD 26AA'              	CALL	SRCHGO
  2678'   DA 2695'              	JC	SN_BAD
  267B'   2A 2A37'              	LHLD	SCNT
  267E'   2B                    	DCX	H
  267F'   22 2A37'              	SHLD	SCNT
  2682'   7C                    	MOV	A,H
  2683'   B5                    	ORA	L
  2684'   C2 2675'              	JNZ	SN_LP
  2687'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  268A'   CD 06EB'              	CALL	BRKOFF
  268D'   3E 01                 	MVI	A,1
  268F'   32 2A19'              	STA	GPKEEP		; land on the match, not the first non-blank
  2692'   C3 0F78'              	JMP	GPLACE		; (which sets LNDLT itself)
  2695'                         SN_BAD:
  2695'   CD 06EB'              	CALL	BRKOFF
  2698'   DA 0703'              	JC	BRKBAK		; stopped, which is not the same as not found
  269B'   CD 06F6'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  269E'   21 22C9'              	LXI	H,SNOTFD
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  26A1'   CD 223F'              	CALL	EXERR
  26A4'   21 0000*              	LXI	H,SRCHST
  26A7'   C3 223A'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  26AA'                         SRCHGO:
  26AA'   3E 01                 	MVI	A,1
  26AC'   32 2A40'              	STA	SSKIP		; this pass starts one past the cursor
  26AF'   CD 26C5'              	CALL	SRCHW
  26B2'   D0                    	RNC
  26B3'   CD 06EF'              	CALL	BRKQ
  26B6'   D8                    	RC			; stopped: no second pass
  26B7'   3A 2A0D'              	LDA	SDIRE
  26BA'   2F                    	CMA
  26BB'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  26BE'   AF                    	XRA	A
  26BF'   32 2A40'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  26C2'   C3 26C5'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  26C5'                         SRCHW:
  26C5'   3A 2A0D'              	LDA	SDIRE
  26C8'   32 0000*              	STA	DIRFLG
  26CB'   21 FFFF               	LXI	H,0FFFFH
  26CE'   22 298C'              	SHLD	CMDCNT
  26D1'   AF                    	XRA	A
  26D2'   32 0000*              	STA	AUXCNT
  26D5'                         SW_LP:
  26D5'   CD 06EF'              	CALL	BRKQ		; a ^C spent the count, here or on the way to
  26D8'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  26D9'   CD 26E5'              	CALL	SRCH1
  26DC'   D0                    	RNC
  26DD'   CD 0000*              	CALL	SCRLST
  26E0'   D2 26D5'              	JNC	SW_LP
  26E3'   37                    	STC
  26E4'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  26E5'                         SRCH1:
  26E5'   11 0000*              	LXI	D,SRCHST
  26E8'   3A 0000*              	LDA	DIRFLG
  26EB'   B7                    	ORA	A
  26EC'   FA 2710'              	JM	SR1_BK
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  26EF'   21 0000*              	LXI	H,GAPEND
  26F2'   CD 0000*              	CALL	FWDCNT
  26F5'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  26F8'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  26F9'   3A 2A40'              	LDA	SSKIP
  26FC'   B7                    	ORA	A
  26FD'   CA 2706'              	JZ	SR1_FW
  2700'   78                    	MOV	A,B
  2701'   B1                    	ORA	C
  2702'   37                    	STC
  2703'   C8                    	RZ			; no room for a match even before the skip
  2704'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2705'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2706'                         SR1_FW:
  2706'   CD 0000*              	CALL	MATCHF
  2709'   D8                    	RC
  270A'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  270D'   C3 0000*              	JMP	PUTCUR
  2710'                         SR1_BK:
  2710'   21 0000*              	LXI	H,TXTBEG
  2713'   CD 0000*              	CALL	FWDCNT
  2716'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2719'   D8                    	RC
  271A'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  271D'   CD 0000*              	CALL	MATCHB
  2720'   D8                    	RC
  2721'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2724'                         MSGNAM:
  2724'   E5                    	PUSH	H
  2725'   3E 22                 	MVI	A,'"'
  2727'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  272A'   E1                    	POP	H
  272B'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  272C'   23                    	INX	H
  272D'   7E                    	MOV	A,M
  272E'   FE 20                 	CPI	' '
  2730'   C2 273D'              	JNZ	MN_HAS
  2733'   21 2357'              	LXI	H,SNONM
  2736'   CD 0000*              	CALL	OUTSTR
  2739'   E1                    	POP	H
  273A'   C3 2787'              	JMP	MN_END
  273D'                         MN_HAS:
  273D'   0E 19                 	MVI	C,BF_CURDSK
  273F'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2742'   E1                    	POP	H
  2743'   E5                    	PUSH	H
  2744'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2745'   BE                    	CMP	M
  2746'   CA 2754'              	JZ	MN_NAM
  2749'   7E                    	MOV	A,M
  274A'   C6 40                 	ADI	'A'-1
  274C'   CD 0000*              	CALL	OUTCH
  274F'   3E 3A                 	MVI	A,':'
  2751'   CD 0000*              	CALL	OUTCH
  2754'                         MN_NAM:
  2754'   E1                    	POP	H
  2755'   E5                    	PUSH	H
  2756'   23                    	INX	H
  2757'   0E 08                 	MVI	C,8
  2759'                         MN_NM:
  2759'   7E                    	MOV	A,M
  275A'   FE 20                 	CPI	' '
  275C'   CA 2767'              	JZ	MN_EXT
  275F'   CD 0000*              	CALL	OUTCH
  2762'   23                    	INX	H
  2763'   0D                    	DCR	C
  2764'   C2 2759'              	JNZ	MN_NM
  2767'                         MN_EXT:
  2767'   E1                    	POP	H
  2768'   11 0009               	LXI	D,9
  276B'   19                    	DAD	D		; the type field
  276C'   7E                    	MOV	A,M
  276D'   FE 20                 	CPI	' '
  276F'   CA 2787'              	JZ	MN_END
  2772'   3E 2E                 	MVI	A,'.'
  2774'   CD 0000*              	CALL	OUTCH
  2777'   0E 03                 	MVI	C,3
  2779'                         MN_XL:
  2779'   7E                    	MOV	A,M
  277A'   FE 20                 	CPI	' '
  277C'   CA 2787'              	JZ	MN_END
  277F'   CD 0000*              	CALL	OUTCH
  2782'   23                    	INX	H
  2783'   0D                    	DCR	C
  2784'   C2 2779'              	JNZ	MN_XL
  2787'                         MN_END:
  2787'   3E 22                 	MVI	A,'"'
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  2789'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  278C'                         MSGFLG:
  278C'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  278E'   B7                    	ORA	A
  278F'   CA 279F'              	JZ	MF_RO
  2792'   3A 298F'              	LDA	MODF
  2795'   B7                    	ORA	A
  2796'   CA 279F'              	JZ	MF_RO
  2799'   21 2361'              	LXI	H,SMODM
  279C'   CD 27B4'              	CALL	MF_PUT
  279F'                         MF_RO:
  279F'   3A 29FA'              	LDA	ROFLAG
  27A2'   B7                    	ORA	A
  27A3'   CA 27AC'              	JZ	MF_NEW
  27A6'   21 236C'              	LXI	H,SROM
  27A9'   CD 27B4'              	CALL	MF_PUT
  27AC'                         MF_NEW:
  27AC'   3A 29F8'              	LDA	MSGNEW
  27AF'   B7                    	ORA	A
  27B0'   C8                    	RZ
  27B1'   21 2377'              	LXI	H,SNEWM
  27B4'                         MF_PUT:
  27B4'   78                    	MOV	A,B
  27B5'   B7                    	ORA	A
  27B6'   C2 27C2'              	JNZ	MF_STR
  27B9'   06 01                 	MVI	B,1
  27BB'   E5                    	PUSH	H
  27BC'   3E 20                 	MVI	A,' '
  27BE'   CD 0000*              	CALL	OUTCH
  27C1'   E1                    	POP	H
  27C2'                         MF_STR:
  27C2'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  27C5'                         EMITW:
  27C5'   C5                    	PUSH	B
  27C6'   D5                    	PUSH	D
  27C7'   06 00                 	MVI	B,0
  27C9'   11 2710               	LXI	D,10000
  27CC'   CD 27EA'              	CALL	EWDIG
  27CF'   11 03E8               	LXI	D,1000
  27D2'   CD 27EA'              	CALL	EWDIG
  27D5'   11 0064               	LXI	D,100
  27D8'   CD 27EA'              	CALL	EWDIG
  27DB'   11 000A               	LXI	D,10
  27DE'   CD 27EA'              	CALL	EWDIG
  27E1'   7D                    	MOV	A,L		; the units digit is always printed
  27E2'   C6 30                 	ADI	'0'
  27E4'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27E7'   D1                    	POP	D
  27E8'   C1                    	POP	B
  27E9'   C9                    	RET
  27EA'                         EWDIG:
  27EA'   0E 00                 	MVI	C,0
  27EC'                         EW_LP:
  27EC'   7D                    	MOV	A,L
  27ED'   93                    	SUB	E
  27EE'   6F                    	MOV	L,A
  27EF'   7C                    	MOV	A,H
  27F0'   9A                    	SBB	D
  27F1'   67                    	MOV	H,A
  27F2'   DA 27F9'              	JC	EW_DN
  27F5'   0C                    	INR	C
  27F6'   C3 27EC'              	JMP	EW_LP
  27F9'                         EW_DN:
  27F9'   19                    	DAD	D		; one subtraction too many: give it back
  27FA'   79                    	MOV	A,C
  27FB'   B7                    	ORA	A
  27FC'   C2 2802'              	JNZ	EW_PR
  27FF'   78                    	MOV	A,B
  2800'   B7                    	ORA	A
  2801'   C8                    	RZ			; a leading zero: write nothing
  2802'                         EW_PR:
  2802'   79                    	MOV	A,C
  2803'   C6 30                 	ADI	'0'
  2805'   CD 0000*              	CALL	OUTCH
  2808'   06 01                 	MVI	B,1
  280A'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  280B'                         ISEMPT:
  280B'   2A 0000*              	LHLD	OUTPOS
  280E'   7C                    	MOV	A,H
  280F'   B5                    	ORA	L
  2810'   C0                    	RNZ
  2811'   CD 0000*              	CALL	LOGLEN
  2814'   7C                    	MOV	A,H
  2815'   B5                    	ORA	L
  2816'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2817'                         MSGCTG:
  2817'   21 0000*              	LXI	H,FNAME
  281A'   CD 2724'              	CALL	MSGNAM
  281D'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  281F'   CD 278C'              	CALL	MSGFLG
  2822'   CD 280B'              	CALL	ISEMPT
  2825'   C2 282E'              	JNZ	MG_POS
  2828'   21 238A'              	LXI	H,SNOLIN
  282B'   C3 0000*              	JMP	OUTSTR
  282E'                         MG_POS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  282E'   21 237D'              	LXI	H,SLINE
  2831'   CD 0000*              	CALL	OUTSTR
  2834'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2837'   23                    	INX	H		;   ... so the line it is on
  2838'   CD 27C5'              	CALL	EMITW
  283B'   21 2384'              	LXI	H,SCOLM
  283E'   CD 0000*              	CALL	OUTSTR
  2841'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2844'   23                    	INX	H
  2845'   E5                    	PUSH	H
  2846'   CD 27C5'              	CALL	EMITW
  2849'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  284C'   23                    	INX	H
  284D'   D1                    	POP	D
  284E'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2851'   C8                    	RZ
  2852'   E5                    	PUSH	H
  2853'   3E 2D                 	MVI	A,'-'
  2855'   CD 0000*              	CALL	OUTCH
  2858'   E1                    	POP	H
  2859'   C3 27C5'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  285C'                         FILMSG:
  285C'   3A 0001*              	LDA	FNAME+1
  285F'   FE 20                 	CPI	' '
  2861'   C8                    	RZ
  2862'   21 0000*              	LXI	H,FNAME
  2865'   CD 2724'              	CALL	MSGNAM
  2868'   AF                    	XRA	A		; nothing has been changed yet
  2869'   C3 278C'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  286C'                         WRMSG:
  286C'   21 0000*              	LXI	H,TFCB
  286F'   CD 2724'              	CALL	MSGNAM
  2872'   21 239C'              	LXI	H,SWRIT
  2875'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2878'                         MSGPST:
  2878'   3A 29F7'              	LDA	MSGWHT
  287B'   B7                    	ORA	A
  287C'   C8                    	RZ
  287D'   47                    	MOV	B,A
  287E'   AF                    	XRA	A
  287F'   32 29F7'              	STA	MSGWHT
  2882'   78                    	MOV	A,B
  2883'   FE 01                 	CPI	MW_FIL
  2885'   CA 28A1'              	JZ	MP_FIL
  2888'   FE 02                 	CPI	MW_WRT
