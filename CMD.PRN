  0588'   78                    	MOV	A,B
  0589'   B1                    	ORA	C
  058A'   CA 059F'              	JZ	SG_CUR
  058D'   7E                    	MOV	A,M
  058E'   23                    	INX	H
  058F'   0B                    	DCX	B
  0590'   E5                    	PUSH	H
