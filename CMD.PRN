  0B27'   DA 0B62'              	JC	IC_END
  0B2A'   FE 0D                 	CPI	CR
  0B2C'   CA 0B4D'              	JZ	IC_NL
  0B2F'   FE 0A                 	CPI	LF
  0B31'   CA 0B4D'              	JZ	IC_NL
  0B34'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0B37'                         IC_CH:
  0B37'   CD 096E'              	CALL	ATEOF
  0B3A'   DA 0B49'              	JC	IC_2
  0B3D'   FE 0D                 	CPI	CR
  0B3F'   CA 0B49'              	JZ	IC_2
  0B42'   FE 0A                 	CPI	LF
  0B44'   CA 0B49'              	JZ	IC_2
  0B47'   AF                    	XRA	A
  0B48'   C9                    	RET
  0B49'                         IC_2:
  0B49'   3E 02                 	MVI	A,2
  0B4B'   B7                    	ORA	A
  0B4C'   C9                    	RET
