  1182'   0E 01                 	MVI	C,1
  1184'   3A 0000*              	LDA	HFN
  1187'   CD 11D3'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  118A'   43                    	MOV	B,E
