  05BC'   78                    	MOV	A,B
  05BD'   32 2EF9'              	STA	ILN
  05C0'   C9                    	RET
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  05C1'                         UCLAMP:
  05C1'   E5                    	PUSH	H
  05C2'   CD 19B7'              	CALL	CEND		; HL = the line's content end
  05C5'   D1                    	POP	D		; DE = the offset wanted
  05C6'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  05C9'   D2 05CE'              	JNC	UCL_BK
  05CC'   EB                    	XCHG
  05CD'   C9                    	RET
  05CE'                         UCL_BK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05CE'   E5                    	PUSH	H		; the content end
  05CF'   EB                    	XCHG			; HL = the offset wanted
  05D0'   CD 0678'              	CALL	BOL
  05D3'   D1                    	POP	D		; DE = the content end, HL = the line's start
  05D4'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  05D7'   EB                    	XCHG			; HL = the content end
  05D8'   C8                    	RZ
  05D9'   2B                    	DCX	H		; ... its last character
  05DA'   C9                    	RET
