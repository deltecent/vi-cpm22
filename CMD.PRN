  06AE'   78                    	MOV	A,B
  06AF'   B1                    	ORA	C
  06B0'   CA 06BF'              	JZ	BOL_B		; back at the gap: the rest is before it
  06B3'   2B                    	DCX	H
  06B4'   7E                    	MOV	A,M
  06B5'   FE 0A                 	CPI	LF
  06B7'   CA 06D3'              	JZ	BOL_X
  06BA'   1B                    	DCX	D
  06BB'   0B                    	DCX	B
  06BC'   C3 06AE'              	JMP	BOL_A
