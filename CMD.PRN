  060C'   37                    	STC
  060D'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  060E'                         GOSET:
  060E'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0611'                         SETGL:
  0611'   CD 13AB'              	CALL	ZSAVE
  0614'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


  0617'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  061A'   E5                    	PUSH	H
  061B'   CD 13BE'              	CALL	ZREST
  061E'   E1                    	POP	H
  061F'   E5                    	PUSH	H
  0620'   CD 0776'              	CALL	GBSUB		; HL = bytes to the cursor
  0623'   44                    	MOV	B,H
  0624'   4D                    	MOV	C,L
  0625'   E1                    	POP	H		; HL = the line's start
  0626'   11 0000               	LXI	D,0		; DE = screen column
  0629'                         SG_LP:
  0629'   78                    	MOV	A,B
  062A'   B1                    	ORA	C
  062B'   CA 0640'              	JZ	SG_CUR
  062E'   7E                    	MOV	A,M
  062F'   23                    	INX	H
  0630'   0B                    	DCX	B
  0631'   E5                    	PUSH	H
  0632'   6B                    	MOV	L,E
  0633'   CD 0665'              	CALL	CWID
  0636'   E1                    	POP	H
  0637'   83                    	ADD	E
  0638'   5F                    	MOV	E,A
  0639'   D2 0629'              	JNC	SG_LP
  063C'   14                    	INR	D
  063D'   C3 0629'              	JMP	SG_LP
  0640'                         SG_CUR:
  0640'   2A 0000*              	LHLD	TXTEND
  0643'   D5                    	PUSH	D
  0644'   EB                    	XCHG
  0645'   2A 0000*              	LHLD	GAPEND
  0648'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  064B'   D1                    	POP	D
  064C'   CA 0660'              	JZ	SG_SET
  064F'   7E                    	MOV	A,M
  0650'   FE 09                 	CPI	TAB
  0652'   C2 0660'              	JNZ	SG_SET
  0655'   6B                    	MOV	L,E
  0656'   CD 0665'              	CALL	CWID
  0659'   3D                    	DCR	A		; the TAB's last column
  065A'   83                    	ADD	E
  065B'   5F                    	MOV	E,A
