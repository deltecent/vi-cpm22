                                ;============================================================
                                ; DATA
                                ;============================================================
  26AE'   00                    EDMODE: DB	EM_CMD
  26AF'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  26B1'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  26B2'   00                    MODF:	DB	0		; 1 = unsaved changes
  26B3'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  26B4'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  26B5'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


                                				;   nothing follows it to shift: no ICH needed
  26B6'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  26B7'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  26B9'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  26BA'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  26BB'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  26BC'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  26BD'   0000                  JKCNT:	DW	0		; j/k: count
  26BF'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  26C1'   0000                  JKMOV:	DW	0		; j: lines moved
  26C3'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  26C5'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  26C6'   00                    JKLST:	DB	0		; j: last byte of the scan
  26C7'   0000                  JKVC:	DW	0		; j/k landing: screen column
  26C9'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  26CB'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  26CC'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  26CD'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  26CE'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  26CF'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  26D0'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  26D2'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  26D3'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  26D4'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  26D6'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  26D7'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  26D8'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  26D9'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  26DA'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  26DB'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  26DC'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  26DD'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  26DF'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  26E1'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  26E4'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  26E7'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  26EA'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  26ED'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  26EF'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  26F1'   0000                  CNTV:	DW	0		; motion repeat counter
  26F3'   0000                  TTI:	DW	0		; TAILTAB scan index
  26F5'   0000                  WKI:	DW	0		; scan index
  26F7'   0000                  WKN:	DW	0		; cached LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  26F9'   0000                  WKTERM: DW	0		; line terminator offset
  26FB'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  26FD'   00                    WKCLS:	DB	0		; word motion: class of the current run
  26FE'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  26FF'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2701'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2703'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2705'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2707'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2708'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2709'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  270A'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  270B'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  270C'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  270E'   00                    WPROW:	DB	0		; :w -- the cursor's row
  270F'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2710'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2712'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2714'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2715'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2717'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2719'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  271A'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  271B'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  271C'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  271D'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  271E'   00                    PLUSF:	DB	0		; command line: '+' was given
  271F'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2720'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2721'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2722'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2724'   0000                  YPT:	DW	0		; yy: where the lines came from
  2726'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2728'   0000                  PPT:	DW	0		; p/P: the first line put
  272A'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  272C'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  272D'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  272F'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2730'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2731'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2732'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2733'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2734'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2735'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2736'   0000                  FNDN:	DW	0		; occurrences still to count off
  2738'   0000                  FNDCUR: DW	0		; the cursor it started from
  273A'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  273C'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  273D'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2740'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2743'   0000                  MKN:	DW	0		; ... how long it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  2745'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2746'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2749'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  274A'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  274B'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  274D'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  274F'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2751'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2753'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2756'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2758'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  275A'   0000                  SCNT:	DW	0		; searches still to do (the count)
  275C'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  275E'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  2760'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2761'   00                    SRNGF:	DB	0		; ex: a line range was given
  2762'   0000                  SRNG1:	DW	0		; ex: its first line
  2764'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2766'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2767'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2768'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2769'   00                    SLCHG:	DB	0		; ':s' this line changed
  276A'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  276C'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  276E'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2770'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2772'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2773'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
