  1915'   C2 191F'              	JNZ	WC_ARG
  1918'   CD 1982'              	CALL	OWNTF
  191B'   D8                    	RC
  191C'   C3 1934'              	JMP	WC_OWN
  191F'                         WC_ARG:
  191F'   CD 1998'              	CALL	ISOWN
  1922'   CA 1934'              	JZ	WC_OWN
  1925'   3A 22DB'              	LDA	EXBANG
  1928'   B7                    	ORA	A
  1929'   CA 1932'              	JZ	WC_OTH
  192C'   CD 0000*              	CALL	TEXIST
  192F'   C2 1B59'              	JNZ	MSGEXI		; File exists (! to force)
  1932'                         WC_OTH:
  1932'   AF                    	XRA	A		; (NC)
  1933'   C9                    	RET
  1934'                         WC_OWN:
  1934'   3A 22DC'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1937'   B7                    	ORA	A
  1938'   CA 1942'              	JZ	WC_OK
  193B'   3A 22DB'              	LDA	EXBANG
  193E'   B7                    	ORA	A
  193F'   C2 1B5F'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1942'                         WC_OK:
  1942'   3E 01                 	MVI	A,1
  1944'   B7                    	ORA	A		; (NC)
  1945'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; changed flag.  The file written is where the text is read from next.
  1946'                         WRITE:
  1946'   3A 22CA'              	LDA	EXBAK
  1949'   CD 0000*              	CALL	WRTO
  194C'   3A 0001*              	LDA	FNAME+1
  194F'   FE 20                 	CPI	' '
  1951'   C2 195D'              	JNZ	WR_HAS
  1954'   21 0000*              	LXI	H,TFCB
  1957'   11 0000*              	LXI	D,FNAME
  195A'   CD 19AA'              	CALL	COPY12
  195D'                         WR_HAS:
  195D'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  195F'   32 22D9'              	STA	MSGWHT
  1962'   CD 1998'              	CALL	ISOWN
  1965'   C2 196F'              	JNZ	SRCTF
  1968'   AF                    	XRA	A
  1969'   32 227D'              	STA	MODF
  196C'   32 22DA'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  196F'                         SRCTF:
  196F'   21 0000*              	LXI	H,TFCB
  1972'   11 005C               	LXI	D,DFTFCB
  1975'   CD 19AA'              	CALL	COPY12
  1978'   AF                    	XRA	A
  1979'   06 04                 	MVI	B,4
  197B'                         SRC_Z:
  197B'   12                    	STAX	D		; extent, s1, s2, record count: 0
  197C'   13                    	INX	D
  197D'   05                    	DCR	B
  197E'   C2 197B'              	JNZ	SRC_Z
  1981'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1982'                         OWNTF:
  1982'   3A 0001*              	LDA	FNAME+1
  1985'   FE 20                 	CPI	' '
  1987'   CA 1B53'              	JZ	MSGNFN
  198A'   CD 19B5'              	CALL	TFCLR
  198D'   21 0000*              	LXI	H,FNAME
  1990'   11 0000*              	LXI	D,TFCB
  1993'   CD 19AA'              	CALL	COPY12
  1996'   B7                    	ORA	A		; (NC)
  1997'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1998'                         ISOWN:
  1998'   21 0000*              	LXI	H,TFCB
  199B'   11 0000*              	LXI	D,FNAME
  199E'   06 0C                 	MVI	B,12
  19A0'                         IO_LP:
  19A0'   1A                    	LDAX	D
  19A1'   BE                    	CMP	M
  19A2'   C0                    	RNZ
  19A3'   23                    	INX	H
  19A4'   13                    	INX	D
  19A5'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  19A6'   C2 19A0'              	JNZ	IO_LP
  19A9'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  19AA'                         COPY12:
  19AA'   06 0C                 	MVI	B,12
  19AC'                         CP_LP:
  19AC'   7E                    	MOV	A,M
  19AD'   12                    	STAX	D
  19AE'   23                    	INX	H
  19AF'   13                    	INX	D
  19B0'   05                    	DCR	B
  19B1'   C2 19AC'              	JNZ	CP_LP
  19B4'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  19B5'                         TFCLR:
  19B5'   11 0000*              	LXI	D,TFCB
  19B8'   06 24                 	MVI	B,36
  19BA'   AF                    	XRA	A
  19BB'                         TC_LP:
  19BB'   12                    	STAX	D
  19BC'   13                    	INX	D
  19BD'   05                    	DCR	B
  19BE'   C2 19BB'              	JNZ	TC_LP
  19C1'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  19C2'                         FOPEN:
  19C2'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  19C4'   32 22D9'              	STA	MSGWHT
  19C7'   21 005C               	LXI	H,DFTFCB
  19CA'   CD 1A9C'              	CALL	NRMDRV
  19CD'   11 0000*              	LXI	D,FNAME
  19D0'   CD 19AA'              	CALL	COPY12
  19D3'   CD 0000*              	CALL	OPENZ
  19D6'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  19D9'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  19DB'   C8                    	RZ
  19DC'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  19DF'   32 22DA'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  19E2'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  19E3'                         ARGSCN:
  19E3'   3A 0080               	LDA	CMDTAIL
  19E6'   47                    	MOV	B,A		; B = what is left of the line
  19E7'   B7                    	ORA	A
  19E8'   C8                    	RZ
  19E9'   21 0081               	LXI	H,CMDTAIL+1
  19EC'                         AS_TOK:				; at a token, or the blanks before one
  19EC'   7E                    	MOV	A,M
  19ED'   FE 20                 	CPI	' '
  19EF'   C2 19F8'              	JNZ	AS_OPT
  19F2'   23                    	INX	H
  19F3'   05                    	DCR	B
  19F4'   C2 19EC'              	JNZ	AS_TOK
  19F7'   C9                    	RET
  19F8'                         AS_OPT:
  19F8'   FE 2B                 	CPI	'+'
  19FA'   CA 1A24'              	JZ	AS_PLS
  19FD'   FE 2D                 	CPI	'-'
  19FF'   CA 1A13'              	JZ	AS_SW
  1A02'   FE 2F                 	CPI	'/'
  1A04'   CA 1A13'              	JZ	AS_SW
  1A07'                         AS_SKP:				; not ours (the file name): on to the next one
  1A07'   23                    	INX	H
  1A08'   05                    	DCR	B
  1A09'   C8                    	RZ
  1A0A'   7E                    	MOV	A,M
  1A0B'   FE 20                 	CPI	' '
  1A0D'   C2 1A07'              	JNZ	AS_SKP
  1A10'   C3 19EC'              	JMP	AS_TOK
  1A13'                         AS_SW:
  1A13'   23                    	INX	H
  1A14'   05                    	DCR	B
  1A15'   C8                    	RZ
  1A16'   7E                    	MOV	A,M
  1A17'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1A19'   FE 52                 	CPI	'R'
  1A1B'   C2 1A07'              	JNZ	AS_SKP
  1A1E'   32 22DC'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1A21'   C3 1A07'              	JMP	AS_SKP
  1A24'                         AS_PLS:
  1A24'   3E 01                 	MVI	A,1
  1A26'   32 22DD'              	STA	PLUSF		; '+' gets the line even with no number on it
  1A29'   11 0000*              	LXI	D,PLUSB
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A2C'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1A2E'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1A2F'   05                    	DCR	B
  1A30'   CA 1A67'              	JZ	AS_PE
  1A33'   7E                    	MOV	A,M
  1A34'   FE 30                 	CPI	'0'
  1A36'   C2 1A4E'              	JNZ	AS_PD
  1A39'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1A39'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1A3A'   05                    	DCR	B
  1A3B'   CA 1A6F'              	JZ	AS_P1
  1A3E'   7E                    	MOV	A,M
  1A3F'   FE 30                 	CPI	'0'
  1A41'   CA 1A39'              	JZ	AS_PZ
  1A44'   FE 31                 	CPI	'1'
  1A46'   DA 1A6F'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1A49'   FE 3A                 	CPI	'9'+1
  1A4B'   D2 1A6F'              	JNC	AS_P1
  1A4E'                         AS_PD:				; the digits, as typed
  1A4E'   7E                    	MOV	A,M
  1A4F'   FE 30                 	CPI	'0'
  1A51'   DA 1A67'              	JC	AS_PE
  1A54'   FE 3A                 	CPI	'9'+1
  1A56'   D2 1A67'              	JNC	AS_PE
  1A59'   79                    	MOV	A,C
  1A5A'   B7                    	ORA	A
  1A5B'   CA 1A76'              	JZ	AS_POV
  1A5E'   0D                    	DCR	C
  1A5F'   7E                    	MOV	A,M
  1A60'   12                    	STAX	D
  1A61'   13                    	INX	D
  1A62'   23                    	INX	H
  1A63'   05                    	DCR	B
  1A64'   C2 1A4E'              	JNZ	AS_PD
  1A67'                         AS_PE:
  1A67'   AF                    	XRA	A
  1A68'   12                    	STAX	D		; the digits end with a 0
  1A69'   78                    	MOV	A,B
  1A6A'   B7                    	ORA	A
  1A6B'   C8                    	RZ
  1A6C'   C3 19EC'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1A6F'                         AS_P1:
  1A6F'   3E 31                 	MVI	A,'1'
  1A71'   12                    	STAX	D
  1A72'   13                    	INX	D
  1A73'   C3 1A67'              	JMP	AS_PE
  1A76'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1A76'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1A79'   C3 1A67'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A7C'                         ARGGO:
  1A7C'   3A 22DD'              	LDA	PLUSF
  1A7F'   B7                    	ORA	A
  1A80'   C8                    	RZ
  1A81'   21 0000*              	LXI	H,PLUSB
  1A84'                         AG_LP:
  1A84'   7E                    	MOV	A,M
  1A85'   B7                    	ORA	A
  1A86'   CA 1A95'              	JZ	AG_G
  1A89'   4F                    	MOV	C,A
  1A8A'   06 02                 	MVI	B,KT_CHAR
  1A8C'   E5                    	PUSH	H
  1A8D'   CD 001F'              	CALL	VICMD
  1A90'   E1                    	POP	H
  1A91'   23                    	INX	H
  1A92'   C3 1A84'              	JMP	AG_LP
  1A95'                         AG_G:
  1A95'   0E 47                 	MVI	C,'G'
  1A97'   06 02                 	MVI	B,KT_CHAR
  1A99'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1A9C'                         NRMDRV:
  1A9C'   7E                    	MOV	A,M
  1A9D'   B7                    	ORA	A
  1A9E'   C0                    	RNZ
  1A9F'   E5                    	PUSH	H
  1AA0'   0E 19                 	MVI	C,BF_CURDSK
  1AA2'   CD 0005               	CALL	BDOS
  1AA5'   E1                    	POP	H
  1AA6'   3C                    	INR	A
  1AA7'   77                    	MOV	M,A
  1AA8'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1AA9'                         PARSFN:
  1AA9'   CD 19B5'              	CALL	TFCLR
  1AAC'   11 0000*              	LXI	D,TFCB
  1AAF'   23                    	INX	H
  1AB0'   7E                    	MOV	A,M
  1AB1'   2B                    	DCX	H
  1AB2'   FE 3A                 	CPI	':'
  1AB4'   C2 1AC6'              	JNZ	PF_NM
  1AB7'   CD 1B0C'              	CALL	GETFNC
  1ABA'   CA 1AC6'              	JZ	PF_NM
  1ABD'   D6 40                 	SUI	40H
  1ABF'   12                    	STAX	D
  1AC0'   FE 11                 	CPI	17
  1AC2'   D2 1AEA'              	JNC	PF_BAD
  1AC5'   23                    	INX	H
  1AC6'                         PF_NM:
  1AC6'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AC7'   0E 08                 	MVI	C,8
  1AC9'   CD 1AEE'              	CALL	CPYNAM
  1ACC'   FE 2E                 	CPI	'.'
  1ACE'   0E 03                 	MVI	C,3
  1AD0'   C4 1B01'              	CNZ	PADFLD		; no type: blanks
  1AD3'   CC 1AED'              	CZ	CPYNM0		; '.': the type
  1AD6'   3A 0001*              	LDA	TFCB+1
  1AD9'   FE 20                 	CPI	' '
  1ADB'   CA 1AEA'              	JZ	PF_BAD		; no name
  1ADE'   CD 1B3F'              	CALL	SKIPB
  1AE1'   C0                    	RNZ			; more after it
  1AE2'   21 0000*              	LXI	H,TFCB
  1AE5'   CD 1A9C'              	CALL	NRMDRV
  1AE8'   AF                    	XRA	A
  1AE9'   C9                    	RET
  1AEA'                         PF_BAD:
  1AEA'   F6 01                 	ORI	1
  1AEC'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1AED'                         CPYNM0:
  1AED'   23                    	INX	H
  1AEE'                         CPYNAM:
  1AEE'   CD 1B0C'              	CALL	GETFNC
  1AF1'   CA 1B01'              	JZ	PADFLD
  1AF4'   12                    	STAX	D
  1AF5'   13                    	INX	D
  1AF6'   0D                    	DCR	C
  1AF7'   C2 1AEE'              	JNZ	CPYNAM
  1AFA'                         CN_SKP:
  1AFA'   CD 1B0C'              	CALL	GETFNC
  1AFD'   C2 1AFA'              	JNZ	CN_SKP
  1B00'   C9                    	RET
  1B01'                         PADFLD:
  1B01'   F5                    	PUSH	PSW
  1B02'                         PD_LP:
  1B02'   3E 20                 	MVI	A,' '
  1B04'   12                    	STAX	D
  1B05'   13                    	INX	D
  1B06'   0D                    	DCR	C
  1B07'   C2 1B02'              	JNZ	PD_LP
  1B0A'   F1                    	POP	PSW
  1B0B'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1B0C'                         GETFNC:
  1B0C'   7E                    	MOV	A,M
  1B0D'   FE 3D                 	CPI	'='
  1B0F'   C8                    	RZ
  1B10'   FE 5F                 	CPI	'_'
  1B12'   C8                    	RZ
  1B13'   FE 3B                 	CPI	';'
  1B15'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B16'   FE 3C                 	CPI	'<'
  1B18'   C8                    	RZ
  1B19'   FE 3E                 	CPI	'>'
  1B1B'   C8                    	RZ
  1B1C'   FE 2E                 	CPI	'.'
  1B1E'   C8                    	RZ
  1B1F'   FE 3A                 	CPI	':'
  1B21'   C8                    	RZ
  1B22'   FE 2A                 	CPI	'*'
  1B24'   C8                    	RZ
  1B25'   FE 3F                 	CPI	'?'
  1B27'   C8                    	RZ
  1B28'   FE 20                 	CPI	' '
  1B2A'   DA 1B3D'              	JC	GF_CTL
  1B2D'   C8                    	RZ
  1B2E'   23                    	INX	H
  1B2F'   FE 61                 	CPI	'a'
  1B31'   DA 1B3B'              	JC	GF_DN
  1B34'   FE 7B                 	CPI	'z'+1
  1B36'   D2 1B3B'              	JNC	GF_DN
  1B39'   E6 DF                 	ANI	0DFH
  1B3B'                         GF_DN:
  1B3B'   B7                    	ORA	A
  1B3C'   C9                    	RET
  1B3D'                         GF_CTL:
  1B3D'   BF                    	CMP	A
  1B3E'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1B3F'                         SKIPB:
  1B3F'   7E                    	MOV	A,M
  1B40'   FE 20                 	CPI	' '
  1B42'   C2 1B49'              	JNZ	SB_DN
  1B45'   23                    	INX	H
  1B46'   C3 1B3F'              	JMP	SKIPB
  1B49'                         SB_DN:
  1B49'   B7                    	ORA	A
  1B4A'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1B4B'                         ISLOW:
  1B4B'   7E                    	MOV	A,M
  1B4C'   FE 61                 	CPI	'a'
  1B4E'   D8                    	RC
  1B4F'   FE 7B                 	CPI	'z'+1
  1B51'   3F                    	CMC
  1B52'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1B53'                         MSGNFN:
  1B53'   21 1BA0'              	LXI	H,SNFN
  1B56'   C3 1B8B'              	JMP	EXERR
  1B59'                         MSGEXI:
  1B59'   21 1BBA'              	LXI	H,SEXI
  1B5C'   C3 1B68'              	JMP	EXBNG
  1B5F'                         MSGRO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B5F'   21 1BC6'              	LXI	H,SRO
  1B62'   C3 1B68'              	JMP	EXBNG
  1B65'                         MSGNWR:
  1B65'   21 1BAD'              	LXI	H,SNWR
  1B68'                         EXBNG:
  1B68'   CD 1B8B'              	CALL	EXERR
  1B6B'   21 1BD2'              	LXI	H,SBNG
  1B6E'   C3 1B86'              	JMP	EXOUT
  1B71'                         EX_INV:
  1B71'   21 1BE0'              	LXI	H,SINV
  1B74'   C3 1B8B'              	JMP	EXERR
  1B77'                         EX_V:				; :ve -- the version, on the bottom row
  1B77'   21 1B9B'              	LXI	H,SVER
  1B7A'   C3 1B8B'              	JMP	EXERR
  1B7D'                         EX_TRL:
  1B7D'   21 1BF2'              	LXI	H,STRL
  1B80'                         EXERT:				; the message, then the text at EXCMD
  1B80'   CD 1B8B'              	CALL	EXERR
  1B83'   2A 22CB'              	LHLD	EXCMD
  1B86'                         EXOUT:
  1B86'   CD 0000*              	CALL	OUTSTR
  1B89'   37                    	STC
  1B8A'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1B8B'                         EXERR:
  1B8B'   E5                    	PUSH	H
  1B8C'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1B8D'   32 22D9'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1B90'   E1                    	POP	H
  1B91'   CD 0000*              	CALL	EXMSG
  1B94'   3E 01                 	MVI	A,R_MOVE
  1B96'   32 227E'              	STA	RINTENT
  1B99'   37                    	STC
  1B9A'   C9                    	RET
                                
  1B9B'   56 31 2E 30           SVER:	DB	'V1.0',0
  1B9F'   00                    
  1BA0'   4E 6F 20 66           SNFN:	DB	'No file name',0
  1BA4'   69 6C 65 20           
  1BA8'   6E 61 6D 65           
  1BAC'   00                    
  1BAD'   46 69 6C 65           SNWR:	DB	'File changed',0
  1BB1'   20 63 68 61           
  1BB5'   6E 67 65 64           
  1BB9'   00                    
  1BBA'   46 69 6C 65           SEXI:	DB	'File exists',0
  1BBE'   20 65 78 69           
  1BC2'   73 74 73 00           
  1BC6'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  1BCA'   20 69 73 20           
  1BCE'   73 65 74 00           
  1BD2'   20 28 21 20           SBNG:	DB	' (! to force)',0
  1BD6'   74 6F 20 66           
  1BDA'   6F 72 63 65           
  1BDE'   29 00                 
