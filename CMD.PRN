  2A47'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  2A48'                         EXADDR:
  2A48'   AF                    	XRA	A
  2A49'   32 0000*              	STA	SRNGF
  2A4C'   7E                    	MOV	A,M
  2A4D'   FE 25                 	CPI	'%'
  2A4F'   CA 2A78'              	JZ	EXA_AL
  2A52'   EB                    	XCHG			; DE walks the line, HL takes the number
  2A53'   CD 2A8D'              	CALL	EXNUM
  2A56'   DA 2A76'              	JC	EXA_NO
  2A59'   22 0000*              	SHLD	SRNG1
  2A5C'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2A5F'   1A                    	LDAX	D
  2A60'   FE 2C                 	CPI	','
  2A62'   C2 2A6F'              	JNZ	EXA_YS
  2A65'   13                    	INX	D
  2A66'   CD 2A8D'              	CALL	EXNUM
  2A69'   DA 2A76'              	JC	EXA_NO		; ',' with no number: not a range at all
  2A6C'   22 0000*              	SHLD	SRNG2
  2A6F'                         EXA_YS:
  2A6F'   EB                    	XCHG
  2A70'   3E 01                 	MVI	A,1
  2A72'   32 0000*              	STA	SRNGF
  2A75'   C9                    	RET
  2A76'                         EXA_NO:
  2A76'   EB                    	XCHG
  2A77'   C9                    	RET
  2A78'                         EXA_AL:
  2A78'   23                    	INX	H
  2A79'   E5                    	PUSH	H
  2A7A'   21 0001               	LXI	H,1
  2A7D'   22 0000*              	SHLD	SRNG1
  2A80'   21 FFFF               	LXI	H,0FFFFH
  2A83'   22 0000*              	SHLD	SRNG2
  2A86'   E1                    	POP	H
  2A87'   3E 01                 	MVI	A,1
  2A89'   32 0000*              	STA	SRNGF
  2A8C'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2A8D'                         EXNUM:
  2A8D'   1A                    	LDAX	D
  2A8E'   D6 30                 	SUI	'0'
  2A90'   D8                    	RC
  2A91'   FE 0A                 	CPI	10
  2A93'   3F                    	CMC
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2A94'   D8                    	RC
  2A95'   21 0000               	LXI	H,0
  2A98'                         EXN_LP:
  2A98'   1A                    	LDAX	D
  2A99'   D6 30                 	SUI	'0'
  2A9B'   DA 2AB5'              	JC	EXN_DN
  2A9E'   FE 0A                 	CPI	10
  2AA0'   D2 2AB5'              	JNC	EXN_DN
  2AA3'   13                    	INX	D
  2AA4'   C5                    	PUSH	B
  2AA5'   4F                    	MOV	C,A
  2AA6'   06 00                 	MVI	B,0		; BC = the digit
  2AA8'   D5                    	PUSH	D
  2AA9'   54                    	MOV	D,H
  2AAA'   5D                    	MOV	E,L
  2AAB'   29                    	DAD	H		; *2
  2AAC'   29                    	DAD	H		; *4
  2AAD'   19                    	DAD	D		; *5
  2AAE'   29                    	DAD	H		; *10
  2AAF'   D1                    	POP	D
  2AB0'   09                    	DAD	B
  2AB1'   C1                    	POP	B
  2AB2'   C3 2A98'              	JMP	EXN_LP
  2AB5'                         EXN_DN:
  2AB5'   B7                    	ORA	A		; CY clear: there was a number
  2AB6'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2AB7'                         EX_S:
  2AB7'   7E                    	MOV	A,M
  2AB8'   B7                    	ORA	A
  2AB9'   CA 2AFB'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2ABC'   32 0000*              	STA	SDELIM
  2ABF'   23                    	INX	H
  2AC0'   11 0000*              	LXI	D,SRCHST
  2AC3'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2AC6'   4F                    	MOV	C,A
  2AC7'   CD 2B01'              	CALL	SCOPY
  2ACA'   78                    	MOV	A,B
  2ACB'   B7                    	ORA	A
  2ACC'   CA 2AFB'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2ACF'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2AD2'   3E 01                 	MVI	A,1
  2AD4'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2AD7'   11 0000*              	LXI	D,SREPL
  2ADA'   0E 24                 	MVI	C,SREPMX
  2ADC'   CD 2B01'              	CALL	SCOPY
  2ADF'   78                    	MOV	A,B
  2AE0'   32 0000*              	STA	SREPLN
  2AE3'   AF                    	XRA	A
  2AE4'   32 0000*              	STA	SGFLAG
  2AE7'   7E                    	MOV	A,M
  2AE8'   FE 67                 	CPI	'g'
  2AEA'   C2 2AF3'              	JNZ	EX_SG
  2AED'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2AEE'   3E 01                 	MVI	A,1
  2AF0'   32 0000*              	STA	SGFLAG
  2AF3'                         EX_SG:
  2AF3'   7E                    	MOV	A,M
  2AF4'   B7                    	ORA	A
  2AF5'   C2 2862'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2AF8'   C3 2B21'              	JMP	SUBGO
  2AFB'                         SUBNOP:
  2AFB'   21 292A'              	LXI	H,SNOPAT
  2AFE'   C3 2870'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2B01'                         SCOPY:
  2B01'   06 00                 	MVI	B,0
  2B03'                         SCP_LP:
  2B03'   78                    	MOV	A,B
  2B04'   B9                    	CMP	C
  2B05'   D2 2B1E'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2B08'   7E                    	MOV	A,M
  2B09'   B7                    	ORA	A
  2B0A'   CA 2B1E'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2B0D'   E5                    	PUSH	H
  2B0E'   21 0000*              	LXI	H,SDELIM
  2B11'   BE                    	CMP	M
  2B12'   E1                    	POP	H
  2B13'   CA 2B1D'              	JZ	SCP_SK
  2B16'   12                    	STAX	D
  2B17'   13                    	INX	D
  2B18'   23                    	INX	H
  2B19'   04                    	INR	B
  2B1A'   C3 2B03'              	JMP	SCP_LP
  2B1D'                         SCP_SK:
  2B1D'   23                    	INX	H
  2B1E'                         SCP_DN:
  2B1E'   AF                    	XRA	A
  2B1F'   12                    	STAX	D
  2B20'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2B21'                         SUBGO:
  2B21'   CD 1405'              	CALL	GZONE
  2B24'   2A 0000*              	LHLD	LNDLT
  2B27'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2B2A'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2B2D'   CD 0448'              	CALL	FPSTO		;   search's SN_BAD does
  2B30'   AF                    	XRA	A
  2B31'   32 0000*              	STA	SANY
  2B34'   21 0000               	LXI	H,0
  2B37'   22 0000*              	SHLD	SBACK
  2B3A'   3A 0000*              	LDA	SRNGF
  2B3D'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B3E'   CA 2B50'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2B41'   CD 23F0'              	CALL	EXRNG		; SLINES = the lines in the range
  2B44'   DA 2BCC'              	JC	SUBBAD
  2B47'   2A 0000*              	LHLD	SRNG1
  2B4A'   CD 135E'              	CALL	GOLN
  2B4D'   C3 2B56'              	JMP	SUBLP
  2B50'                         SUB_1L:
  2B50'   21 0001               	LXI	H,1
  2B53'   22 0000*              	SHLD	SLINES
  2B56'                         SUBLP:
  2B56'   CD 2BD2'              	CALL	SUBLIN		; A = 1 when this line changed
  2B59'   B7                    	ORA	A
  2B5A'   CA 2B68'              	JZ	SUB_NX
  2B5D'   3E 01                 	MVI	A,1
  2B5F'   32 0000*              	STA	SANY
  2B62'   21 0000               	LXI	H,0
  2B65'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2B68'                         SUB_NX:
  2B68'   2A 0000*              	LHLD	SLINES
  2B6B'   2B                    	DCX	H
  2B6C'   22 0000*              	SHLD	SLINES
  2B6F'   7C                    	MOV	A,H
  2B70'   B5                    	ORA	L
  2B71'   CA 2B8F'              	JZ	SUBDON		; the range is spent
  2B74'   21 0001               	LXI	H,1
  2B77'   AF                    	XRA	A
  2B78'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2B7B'   3A 0000*              	LDA	SANY
  2B7E'   B7                    	ORA	A
  2B7F'   CA 2B89'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2B82'   2A 0000*              	LHLD	SBACK
  2B85'   23                    	INX	H
  2B86'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2B89'                         SUB_AE:
  2B89'   CD 0BFA'              	CALL	ATEOF
  2B8C'   D2 2B56'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2B8F'                         SUBDON:
  2B8F'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2B92'   3A 0000*              	LDA	SANY
  2B95'   B7                    	ORA	A
  2B96'   CA 2BB4'              	JZ	SUBNFD
  2B99'   3E 01                 	MVI	A,1
  2B9B'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2B9E'   2A 0000*              	LHLD	SBACK
  2BA1'   7C                    	MOV	A,H
  2BA2'   B5                    	ORA	L
  2BA3'   CA 2BAE'              	JZ	SUB_PL
  2BA6'   3E FF                 	MVI	A,0FFH
  2BA8'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2BAB'   CD 0000*              	CALL	CLRCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BAE'                         SUB_PL:
  2BAE'   CD 141D'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2BB1'   C3 08AE'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2BB4'                         SUBNFD:
  2BB4'   21 0000*              	LXI	H,SOFFS
  2BB7'   CD 03EF'              	CALL	BACKTO
  2BBA'   2A 0000*              	LHLD	SLDLTS
  2BBD'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2BC0'   21 28FA'              	LXI	H,SNOTFD
  2BC3'   CD 2870'              	CALL	EXERR
  2BC6'   21 0000*              	LXI	H,SRCHST
  2BC9'   C3 286B'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2BCC'                         SUBBAD:
  2BCC'   21 28E8'              	LXI	H,SNOT
  2BCF'   C3 2865'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2BD2'                         SUBLIN:
  2BD2'   AF                    	XRA	A
  2BD3'   32 0000*              	STA	SLCHG
  2BD6'   CD 2C51'              	CALL	SUBBOL
  2BD9'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2BDC'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2BDC'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2BDF'   DA 2BE7'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2BE2'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2BE4'   C2 2BDC'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2BE7'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2BE7'   CD 0000*              	CALL	CUROFF
  2BEA'   E5                    	PUSH	H
  2BEB'   CD 1A25'              	CALL	CEND
  2BEE'   D1                    	POP	D
  2BEF'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2BF2'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2BF3'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2BF6'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2BF7'   B7                    	ORA	A		;   span is a line, not a pair.)
  2BF8'   FA 2C4A'              	JM	SUBL_D		; what is left is shorter than the pattern
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2BFB'   44                    	MOV	B,H
  2BFC'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2BFD'   11 0000*              	LXI	D,SRCHST
  2C00'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2C03'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2C06'   DA 2C4A'              	JC	SUBL_D
  2C09'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2C0C'   EB                    	XCHG
  2C0D'   2A 0000*              	LHLD	GAPEND
  2C10'   EB                    	XCHG
  2C11'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2C14'   EB                    	XCHG
  2C15'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2C16'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2C19'   D1                    	POP	D
  2C1A'   19                    	DAD	D		; ... and so the match's logical offset
  2C1B'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2C1E'   3A 0000*              	LDA	SANY
  2C21'   B7                    	ORA	A
  2C22'   C2 2C2F'              	JNZ	SUBL_C
  2C25'   3A 0000*              	LDA	SLCHG
  2C28'   B7                    	ORA	A
  2C29'   C2 2C2F'              	JNZ	SUBL_C
  2C2C'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2C2F'                         SUBL_C:
  2C2F'   3A 0000*              	LDA	SRCHBF
  2C32'   6F                    	MOV	L,A
  2C33'   26 00                 	MVI	H,0
  2C35'   CD 0000*              	CALL	DELFWD		; the match goes
  2C38'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2C3B'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2C3E'                         SUBL_I:
  2C3E'   3E 01                 	MVI	A,1
  2C40'   32 0000*              	STA	SLCHG
  2C43'   3A 0000*              	LDA	SGFLAG
  2C46'   B7                    	ORA	A
  2C47'   C2 2BE7'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2C4A'                         SUBL_D:
  2C4A'   CD 2C51'              	CALL	SUBBOL
  2C4D'   3A 0000*              	LDA	SLCHG
  2C50'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2C51'                         SUBBOL:
  2C51'   CD 0000*              	CALL	CUROFF
  2C54'   CD 0697'              	CALL	BOL
  2C57'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C5A'                         VC_SRCH:
  2C5A'   CD 0871'              	CALL	SETMOV
  2C5D'   C5                    	PUSH	B
  2C5E'   CD 079C'              	CALL	GETCNT
  2C61'   22 0000*              	SHLD	SCNT
  2C64'   C1                    	POP	B
  2C65'   79                    	MOV	A,C
  2C66'   FE 2F                 	CPI	'/'
  2C68'   3E 00                 	MVI	A,0
  2C6A'   CA 2C6F'              	JZ	VS_DIR
  2C6D'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2C6F'                         VS_DIR:
  2C6F'   32 0000*              	STA	SDIR
  2C72'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2C75'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2C78'   47                    	MOV	B,A
  2C79'   CD 2194'              	CALL	RDLINE
  2C7C'   B7                    	ORA	A
  2C7D'   C0                    	RNZ			; cancelled: nothing happens at all
  2C7E'   3A 0000*              	LDA	RLLEN
  2C81'   B7                    	ORA	A
  2C82'   CA 2C97'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2C85'   5F                    	MOV	E,A
  2C86'   16 00                 	MVI	D,0
  2C88'   21 0000*              	LXI	H,SRCHST
  2C8B'   19                    	DAD	D
  2C8C'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2C8E'   7B                    	MOV	A,E
  2C8F'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2C92'   3E 01                 	MVI	A,1
  2C94'   32 0000*              	STA	SHAVE
  2C97'                         VS_OLD:
  2C97'   3A 0000*              	LDA	SHAVE
  2C9A'   B7                    	ORA	A
  2C9B'   CA 2CA7'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2C9E'   3A 0000*              	LDA	SDIR
  2CA1'   32 0000*              	STA	SDIRE
  2CA4'   C3 2CD0'              	JMP	SRCHN
  2CA7'                         VS_NOP:
  2CA7'   21 292A'              	LXI	H,SNOPAT
  2CAA'   C3 2870'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2CAD'                         VC_N:
  2CAD'   CD 0871'              	CALL	SETMOV
  2CB0'   3A 0000*              	LDA	SDIR
  2CB3'   C3 2CBD'              	JMP	VN_GO
  2CB6'                         VCB_N:
  2CB6'   CD 0871'              	CALL	SETMOV
  2CB9'   3A 0000*              	LDA	SDIR
  2CBC'   2F                    	CMA			; the other way: 0 <-> FFH
  2CBD'                         VN_GO:
  2CBD'   32 0000*              	STA	SDIRE
  2CC0'   CD 079C'              	CALL	GETCNT
  2CC3'   22 0000*              	SHLD	SCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


  2CC6'   3A 0000*              	LDA	SHAVE
  2CC9'   B7                    	ORA	A
  2CCA'   CA 2CA7'              	JZ	VS_NOP
  2CCD'   C3 2CD0'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2CD0'                         SRCHN:
  2CD0'   CD 1405'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2CD3'   CD 07C5'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2CD6'                         SN_LP:
  2CD6'   CD 2D0B'              	CALL	SRCHGO
  2CD9'   DA 2CF6'              	JC	SN_BAD
  2CDC'   2A 0000*              	LHLD	SCNT
  2CDF'   2B                    	DCX	H
  2CE0'   22 0000*              	SHLD	SCNT
  2CE3'   7C                    	MOV	A,H
  2CE4'   B5                    	ORA	L
  2CE5'   C2 2CD6'              	JNZ	SN_LP
  2CE8'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2CEB'   CD 0802'              	CALL	BRKOFF
  2CEE'   3E 01                 	MVI	A,1
  2CF0'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2CF3'   C3 141D'              	JMP	GPLACE		; (which sets LNDLT itself)
  2CF6'                         SN_BAD:
  2CF6'   CD 0802'              	CALL	BRKOFF
  2CF9'   DA 081A'              	JC	BRKBAK		; stopped, which is not the same as not found
  2CFC'   CD 080D'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2CFF'   21 28FA'              	LXI	H,SNOTFD
  2D02'   CD 2870'              	CALL	EXERR
  2D05'   21 0000*              	LXI	H,SRCHST
  2D08'   C3 286B'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, paging as WM's find pages, then the rest of the
                                ; file READ where it lies (SCAN) and the window moved once, to the match --
                                ; not paged round the whole file a second time (issue #35).  CY = the pattern
                                ; is nowhere in the file, or an ESC stopped it (BRKQ says which); the cursor
                                ; is then at an end of the file, and SRCHN puts it back.
  2D0B'                         SRCHGO:
  2D0B'   21 0000*              	LXI	H,SGPOS
  2D0E'   CD 0448'              	CALL	FPSTO		; where this one starts: the wrapped pass ends
  2D11'   CD 2F61'              	CALL	SRCHW		;   there
  2D14'   D0                    	RNC
  2D15'   CD 0806'              	CALL	BRKQ
  2D18'   D8                    	RC			; stopped: no second pass
  2D19'   CD 2D26'              	CALL	SCAN
  2D1C'   D8                    	RC
  2D1D'   21 0000*              	LXI	H,SCHIT
  2D20'   CD 03EF'              	CALL	BACKTO		; to the match: one move, as a mark jump
  2D23'   C3 0806'              	JMP	BRKQ		; CY: stopped on the way there
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


                                ;SCAN -- the wrapped pass, without moving the window: the records above it,
                                ; the window, then the records below it, through SECBUF in file order (SCNEXT).
                                ; The last bytes of each piece, a pattern less one, are kept just below
                                ; SECBUF, so a match that straddles two pieces is seen whole there.  '/'
                                ; wants the FIRST match in the file and stops reading once a match could only
                                ; start past SGPOS -- the first pass found nothing there.  '?' wants the LAST,
                                ; so it reads to the end, but skips the records that end before SCLIM: the
                                ; first pass found nothing that ends before SGPOS.  NC: SCHIT = the match's
                                ; file position.  CY: there is none, or an ESC stopped it.
  2D26'                         SCAN:
  2D26'   AF                    	XRA	A
  2D27'   32 0000*              	STA	SCFND
  2D2A'   32 0000*              	STA	SCCRY
  2D2D'   32 0000*              	STA	SCPH		; the records above the window first
  2D30'   32 0002*              	STA	SCPOS+2
  2D33'   21 0000               	LXI	H,0
  2D36'   22 0000*              	SHLD	SCIX
  2D39'   22 0000*              	SHLD	SCPOS
  2D3C'   3A 0000*              	LDA	SRCHBF
  2D3F'   5F                    	MOV	E,A
  2D40'   16 00                 	MVI	D,0		; DE = the pattern's length
  2D42'   2A 0000*              	LHLD	SGPOS
  2D45'   3A 0000*              	LDA	SDIRE
  2D48'   B7                    	ORA	A
  2D49'   3A 0002*              	LDA	SGPOS+2
  2D4C'   FA 2D55'              	JM	SC_BK
  2D4F'   19                    	DAD	D		; '/': SGPOS + the length
  2D50'   CE 00                 	ACI	0
  2D52'   C3 2D5F'              	JMP	SC_LIM
  2D55'                         SC_BK:
  2D55'   42                    	MOV	B,D
  2D56'   CD 13B2'              	CALL	SUB24		; '?': SGPOS - the length (0 if that is less)
  2D59'   D2 2D5F'              	JNC	SC_LIM
  2D5C'   AF                    	XRA	A
  2D5D'   67                    	MOV	H,A
  2D5E'   6F                    	MOV	L,A
  2D5F'                         SC_LIM:
  2D5F'   22 0000*              	SHLD	SCLIM
  2D62'   32 0002*              	STA	SCLIM+2
  2D65'                         SC_LP:
  2D65'   3A 0000*              	LDA	BRKARM
  2D68'   B7                    	ORA	A
  2D69'   C4 07DF'              	CNZ	BRKTST		; an ESC, as CNTTST looks for one
  2D6C'   CD 0806'              	CALL	BRKQ
  2D6F'   D8                    	RC
  2D70'   3A 0000*              	LDA	SDIRE
  2D73'   B7                    	ORA	A
  2D74'   FA 2D90'              	JM	SC_RD		; '?' reads to the end
  2D77'   3A 0000*              	LDA	SCFND
  2D7A'   B7                    	ORA	A
  2D7B'   C0                    	RNZ			; '/': the first is all it wants (NC)
  2D7C'   2A 0000*              	LHLD	SCLIM
  2D7F'   EB                    	XCHG
  2D80'   3A 0002*              	LDA	SCLIM+2
  2D83'   47                    	MOV	B,A
  2D84'   2A 0000*              	LHLD	SCPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


  2D87'   3A 0002*              	LDA	SCPOS+2
  2D8A'   CD 13B2'              	CALL	SUB24		; NC: no match can start at SGPOS or before
  2D8D'   D2 2D9D'              	JNC	SC_END		;   from here on
  2D90'                         SC_RD:
  2D90'   CD 2E40'              	CALL	SCNEXT		; SECBUF = the next piece, A = its length
  2D93'   DA 2D9D'              	JC	SC_END		; the file has run out
  2D96'   B7                    	ORA	A
  2D97'   C4 2DA3'              	CNZ	SCMAT
  2D9A'   C3 2D65'              	JMP	SC_LP
  2D9D'                         SC_END:
  2D9D'   3A 0000*              	LDA	SCFND
  2DA0'   D6 01                 	SUI	1		; CY iff there is none
  2DA2'   C9                    	RET
                                
                                ;SCMAT -- look for the pattern in the A bytes in SECBUF and the carry below
                                ; it, then keep the last of them as the carry and move SCPOS past them.
  2DA3'                         SCMAT:
  2DA3'   4F                    	MOV	C,A
  2DA4'   06 00                 	MVI	B,0
  2DA6'   C5                    	PUSH	B		; the length of the piece
  2DA7'   3A 0000*              	LDA	SRCHBF
  2DAA'   67                    	MOV	H,A
  2DAB'   3A 0000*              	LDA	SCCRY
  2DAE'   81                    	ADD	C		; the carry and the piece
  2DAF'   94                    	SUB	H
  2DB0'   DA 2E07'              	JC	SCM_NO		; shorter than the pattern
  2DB3'   3C                    	INR	A
  2DB4'   4F                    	MOV	C,A		; BC = the places a match may start at
  2DB5'   11 0000*              	LXI	D,SRCHST
  2DB8'   3A 0000*              	LDA	SDIRE
  2DBB'   B7                    	ORA	A
  2DBC'   FA 2DD9'              	JM	SCM_BK
  2DBF'   3A 0000*              	LDA	SCCRY		; '/': the first, from the carry's first byte
  2DC2'   2F                    	CMA
  2DC3'   6F                    	MOV	L,A
  2DC4'   26 FF                 	MVI	H,0FFH
  2DC6'   23                    	INX	H		; HL = - the carry
  2DC7'   D5                    	PUSH	D
  2DC8'   11 0000*              	LXI	D,SECBUF
  2DCB'   19                    	DAD	D
  2DCC'   D1                    	POP	D
  2DCD'   CD 0000*              	CALL	MATCHF
  2DD0'   DA 2E07'              	JC	SCM_NO
  2DD3'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match
  2DD6'   C3 2DEA'              	JMP	SCM_HI
  2DD9'                         SCM_BK:
  2DD9'   E1                    	POP	H		; '?': the last, back from the piece's end
  2DDA'   E5                    	PUSH	H
  2DDB'   D5                    	PUSH	D
  2DDC'   11 0000*              	LXI	D,SECBUF
  2DDF'   19                    	DAD	D
  2DE0'   D1                    	POP	D
  2DE1'   CD 0000*              	CALL	SUBLEN		; the last place one can start
  2DE4'   CD 0000*              	CALL	MATCHB
  2DE7'   DA 2E07'              	JC	SCM_NO
  2DEA'                         SCM_HI:
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DEA'   EB                    	XCHG			; DE = the match, in SECBUF or below it
  2DEB'   2A 0000*              	LHLD	SCPOS
  2DEE'   19                    	DAD	D
  2DEF'   3A 0002*              	LDA	SCPOS+2
  2DF2'   CE 00                 	ACI	0
  2DF4'   11 0000*              	LXI	D,SECBUF
  2DF7'   06 00                 	MVI	B,0
  2DF9'   CD 13B2'              	CALL	SUB24		; its file position
  2DFC'   22 0000*              	SHLD	SCHIT
  2DFF'   32 0002*              	STA	SCHIT+2
  2E02'   3E 01                 	MVI	A,1
  2E04'   32 0000*              	STA	SCFND
  2E07'                         SCM_NO:
  2E07'   C1                    	POP	B		; BC = the piece's length
  2E08'   C5                    	PUSH	B
  2E09'   3A 0000*              	LDA	SCCRY
  2E0C'   81                    	ADD	C
  2E0D'   5F                    	MOV	E,A		; the carry and the piece
  2E0E'   3A 0000*              	LDA	SRCHBF
  2E11'   3D                    	DCR	A		; ... of which a pattern less one is kept
  2E12'   BB                    	CMP	E
  2E13'   DA 2E17'              	JC	SCM_T
  2E16'   7B                    	MOV	A,E
  2E17'                         SCM_T:
  2E17'   32 0000*              	STA	SCCRY
  2E1A'   5F                    	MOV	E,A
  2E1B'   16 00                 	MVI	D,0		; DE = the new carry
  2E1D'   21 0000*              	LXI	H,SECBUF
  2E20'   09                    	DAD	B
  2E21'   CD 0000*              	CALL	SUBHD		; the bytes it keeps
  2E24'   E5                    	PUSH	H
  2E25'   21 0000*              	LXI	H,SECBUF
  2E28'   CD 0000*              	CALL	SUBHD		; where they go
  2E2B'   42                    	MOV	B,D
  2E2C'   4B                    	MOV	C,E
  2E2D'   EB                    	XCHG
  2E2E'   E1                    	POP	H
  2E2F'   CD 0000*              	CALL	MEMCPY		; (down, so a forward copy is safe)
  2E32'   D1                    	POP	D		; the piece's length
                                ;SCADV -- SCPOS += DE.
  2E33'                         SCADV:
  2E33'   2A 0000*              	LHLD	SCPOS
  2E36'   19                    	DAD	D
  2E37'   22 0000*              	SHLD	SCPOS
  2E3A'   D0                    	RNC
  2E3B'   21 0002*              	LXI	H,SCPOS+2
  2E3E'   34                    	INR	M
  2E3F'   C9                    	RET
                                
                                ;SCNEXT -- the next piece of the file into SECBUF: A = its length, which is 0
                                ; for a record skipped.  CY: the file has run out.  SCPH is what it is in:
                                ; 0 the records above the window, 1 the window before the gap, 2 after it,
                                ; 3 VIBACKUP.$$$ (top down), 4 the source below, 5 nothing left.
  2E40'                         SCNEXT:
  2E40'   3A 0000*              	LDA	SCPH
  2E43'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E44'   CA 2E56'              	JZ	SN_AB
  2E47'   FE 03                 	CPI	3
  2E49'   DA 2E84'              	JC	SN_GP
  2E4C'   CA 2EFA'              	JZ	SN_BAK
  2E4F'   FE 04                 	CPI	4
  2E51'   CA 2F14'              	JZ	SN_SRC
  2E54'   37                    	STC
  2E55'   C9                    	RET
  2E56'                         SN_AB:
  2E56'   2A 0000*              	LHLD	OUTPOS
  2E59'   EB                    	XCHG
  2E5A'   2A 0000*              	LHLD	SCIX
  2E5D'   CD 0000*              	CALL	CMP16
  2E60'   CA 2E6E'              	JZ	SN_W0		; all of them read: the window
  2E63'   23                    	INX	H
  2E64'   22 0000*              	SHLD	SCIX
  2E67'   2B                    	DCX	H
  2E68'   AF                    	XRA	A		; above the window
  2E69'   CD 2F2B'              	CALL	SN_REC
  2E6C'   B7                    	ORA	A
  2E6D'   C9                    	RET
  2E6E'                         SN_W0:
  2E6E'   2A 0000*              	LHLD	TXTBEG
  2E71'   EB                    	XCHG
  2E72'   2A 0000*              	LHLD	GAPBEG
  2E75'   3E 01                 	MVI	A,1
  2E77'                         SN_PH:				; phase A, from DE up to HL
  2E77'   32 0000*              	STA	SCPH
  2E7A'   22 0000*              	SHLD	SCEND
  2E7D'   EB                    	XCHG
  2E7E'   22 0000*              	SHLD	SCIX
  2E81'   C3 2E40'              	JMP	SCNEXT
  2E84'                         SN_GP:				; the window: up to 128 bytes of it, copied
  2E84'   2A 0000*              	LHLD	SCIX
  2E87'   EB                    	XCHG
  2E88'   2A 0000*              	LHLD	SCEND
  2E8B'   CD 0000*              	CALL	SUBHD		; HL = what is left of this part
  2E8E'   7C                    	MOV	A,H
  2E8F'   B5                    	ORA	L
  2E90'   CA 2EB5'              	JZ	SN_GPX
  2E93'   7C                    	MOV	A,H
  2E94'   B7                    	ORA	A
  2E95'   C2 2E9E'              	JNZ	SN_128
  2E98'   7D                    	MOV	A,L
  2E99'   FE 81                 	CPI	81H
  2E9B'   DA 2EA1'              	JC	SN_GPN
  2E9E'                         SN_128:
  2E9E'   21 0080               	LXI	H,80H
  2EA1'                         SN_GPN:
  2EA1'   E5                    	PUSH	H
  2EA2'   44                    	MOV	B,H
  2EA3'   4D                    	MOV	C,L
  2EA4'   EB                    	XCHG
  2EA5'   E5                    	PUSH	H
  2EA6'   11 0000*              	LXI	D,SECBUF
  2EA9'   CD 0000*              	CALL	MEMCPY
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2EAC'   E1                    	POP	H
  2EAD'   C1                    	POP	B
  2EAE'   09                    	DAD	B
  2EAF'   22 0000*              	SHLD	SCIX
  2EB2'   79                    	MOV	A,C
  2EB3'   B7                    	ORA	A
  2EB4'   C9                    	RET
  2EB5'                         SN_GPX:
  2EB5'   3A 0000*              	LDA	SCPH
  2EB8'   FE 02                 	CPI	2
  2EBA'   CA 2EC9'              	JZ	SN_BLW
  2EBD'   2A 0000*              	LHLD	GAPEND
  2EC0'   EB                    	XCHG
  2EC1'   2A 0000*              	LHLD	TXTEND
  2EC4'   3E 02                 	MVI	A,2
  2EC6'   C3 2E77'              	JMP	SN_PH
  2EC9'                         SN_BLW:				; below the window: VIBACKUP.$$$ if it holds
  2EC9'   3A 0000*              	LDA	BAKRDY		;   anything, as RDIN reads it first
  2ECC'   B7                    	ORA	A
  2ECD'   CA 2EE3'              	JZ	SN_S0
  2ED0'   2A 0000*              	LHLD	BAKPOS
  2ED3'   7C                    	MOV	A,H
  2ED4'   B5                    	ORA	L
  2ED5'   CA 2EE3'              	JZ	SN_S0
  2ED8'   22 0000*              	SHLD	SCIX
  2EDB'   3E 03                 	MVI	A,3
  2EDD'   32 0000*              	STA	SCPH
  2EE0'   C3 2E40'              	JMP	SCNEXT
  2EE3'                         SN_S0:				; then the source, from where it is read to
  2EE3'   3A 005B               	LDA	5BH
  2EE6'   B7                    	ORA	A
  2EE7'   3E 05                 	MVI	A,5
  2EE9'   CA 2EF4'              	JZ	SN_END
  2EEC'   2A 007E               	LHLD	7EH
  2EEF'   22 0000*              	SHLD	SCIX
  2EF2'   3E 04                 	MVI	A,4
  2EF4'                         SN_END:
  2EF4'   32 0000*              	STA	SCPH
  2EF7'   C3 2E40'              	JMP	SCNEXT
  2EFA'                         SN_BAK:
  2EFA'   2A 0000*              	LHLD	SCIX
  2EFD'   7C                    	MOV	A,H
  2EFE'   B5                    	ORA	L
  2EFF'   CA 2EE3'              	JZ	SN_S0		; record 0 read
  2F02'   2B                    	DCX	H
  2F03'   22 0000*              	SHLD	SCIX
  2F06'   3E 01                 	MVI	A,1
  2F08'   CD 2F2B'              	CALL	SN_REC
  2F0B'   D0                    	RNC
  2F0C'   21 0000               	LXI	H,0		; a ^Z: the stack ends there (RDIN's IOEOF)
  2F0F'   22 0000*              	SHLD	SCIX
  2F12'   B7                    	ORA	A
  2F13'   C9                    	RET
  2F14'                         SN_SRC:
  2F14'   2A 0000*              	LHLD	SCIX
  2F17'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2F18'   22 0000*              	SHLD	SCIX
  2F1B'   2B                    	DCX	H
  2F1C'   3E 02                 	MVI	A,2
  2F1E'   CD 2F2B'              	CALL	SN_REC
  2F21'   D0                    	RNC
  2F22'   F5                    	PUSH	PSW		; a ^Z or no record: the end of the file
  2F23'   3E 05                 	MVI	A,5
  2F25'   32 0000*              	STA	SCPH
  2F28'   F1                    	POP	PSW
  2F29'   B7                    	ORA	A
  2F2A'   C9                    	RET
                                
                                ;SN_REC -- SCNREC (record HL, kind A), unless it is a '?' record that ends
                                ; before SCLIM, which is skipped: SCPOS moves past it and the carry goes (a
                                ; record is 128 bytes until the last, and that one is never skipped).
  2F2B'                         SN_REC:
  2F2B'   F5                    	PUSH	PSW
  2F2C'   E5                    	PUSH	H
  2F2D'   3A 0000*              	LDA	SDIRE
  2F30'   B7                    	ORA	A
  2F31'   F2 2F5C'              	JP	SN_RD		; '/' never skips
  2F34'   2A 0000*              	LHLD	SCPOS
  2F37'   11 0080               	LXI	D,80H
  2F3A'   19                    	DAD	D
  2F3B'   EB                    	XCHG
  2F3C'   3A 0002*              	LDA	SCPOS+2
  2F3F'   CE 00                 	ACI	0
  2F41'   47                    	MOV	B,A		; B:DE = past this record
  2F42'   2A 0000*              	LHLD	SCLIM
  2F45'   3A 0002*              	LDA	SCLIM+2
  2F48'   CD 13B2'              	CALL	SUB24		; NC: it ends at SCLIM or before
  2F4B'   DA 2F5C'              	JC	SN_RD
  2F4E'   E1                    	POP	H
  2F4F'   F1                    	POP	PSW
  2F50'   AF                    	XRA	A
  2F51'   32 0000*              	STA	SCCRY
  2F54'   11 0080               	LXI	D,80H
  2F57'   CD 2E33'              	CALL	SCADV
  2F5A'   AF                    	XRA	A		; nothing to look at, NC
  2F5B'   C9                    	RET
  2F5C'                         SN_RD:
  2F5C'   E1                    	POP	H
  2F5D'   F1                    	POP	PSW
  2F5E'   C3 0000*              	JMP	SCNREC
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller reads the rest of the file or restores the cursor outright.
  2F61'                         SRCHW:
  2F61'   3A 0000*              	LDA	SDIRE
  2F64'   32 0000*              	STA	DIRFLG
  2F67'   21 FFFF               	LXI	H,0FFFFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2F6A'   22 0000*              	SHLD	CMDCNT
  2F6D'   AF                    	XRA	A
  2F6E'   32 0000*              	STA	AUXCNT
  2F71'                         SW_LP:
  2F71'   CD 0806'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2F74'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2F75'   CD 2F81'              	CALL	SRCH1
  2F78'   D0                    	RNC
  2F79'   CD 0000*              	CALL	SCRLST
  2F7C'   D2 2F71'              	JNC	SW_LP
  2F7F'   37                    	STC
  2F80'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2F81'                         SRCH1:
  2F81'   11 0000*              	LXI	D,SRCHST
  2F84'   3A 0000*              	LDA	DIRFLG
  2F87'   B7                    	ORA	A
  2F88'   FA 2FA5'              	JM	SR1_BK
  2F8B'   21 0000*              	LXI	H,GAPEND
  2F8E'   CD 0000*              	CALL	FWDCNT
  2F91'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2F94'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2F95'   78                    	MOV	A,B
  2F96'   B1                    	ORA	C
  2F97'   37                    	STC
  2F98'   C8                    	RZ			; no room for a match even before the skip
  2F99'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2F9A'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2F9B'   CD 0000*              	CALL	MATCHF
  2F9E'   D8                    	RC
  2F9F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2FA2'   C3 0000*              	JMP	PUTCUR
  2FA5'                         SR1_BK:
  2FA5'   21 0000*              	LXI	H,TXTBEG
  2FA8'   CD 0000*              	CALL	FWDCNT
  2FAB'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2FAE'   D8                    	RC
  2FAF'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2FB2'   CD 0000*              	CALL	MATCHB
  2FB5'   D8                    	RC
  2FB6'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
	MACRO-80 3.44	09-Dec-81	PAGE	1-146


                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2FB9'                         MSGNAM:
  2FB9'   E5                    	PUSH	H
  2FBA'   3E 22                 	MVI	A,'"'
  2FBC'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2FBF'   E1                    	POP	H
  2FC0'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2FC1'   23                    	INX	H
  2FC2'   7E                    	MOV	A,M
  2FC3'   FE 20                 	CPI	' '
  2FC5'   C2 2FD2'              	JNZ	MN_HAS
  2FC8'   21 29B8'              	LXI	H,SNONM
  2FCB'   CD 0000*              	CALL	OUTSTR
  2FCE'   E1                    	POP	H
  2FCF'   C3 301C'              	JMP	MN_END
  2FD2'                         MN_HAS:
  2FD2'   0E 19                 	MVI	C,BF_CURDSK
  2FD4'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2FD7'   E1                    	POP	H
  2FD8'   E5                    	PUSH	H
  2FD9'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2FDA'   BE                    	CMP	M
  2FDB'   CA 2FE9'              	JZ	MN_NAM
  2FDE'   7E                    	MOV	A,M
  2FDF'   C6 40                 	ADI	'A'-1
  2FE1'   CD 0000*              	CALL	OUTCH
  2FE4'   3E 3A                 	MVI	A,':'
  2FE6'   CD 0000*              	CALL	OUTCH
  2FE9'                         MN_NAM:
  2FE9'   E1                    	POP	H
  2FEA'   E5                    	PUSH	H
  2FEB'   23                    	INX	H
  2FEC'   0E 08                 	MVI	C,8
  2FEE'                         MN_NM:
  2FEE'   7E                    	MOV	A,M
  2FEF'   FE 20                 	CPI	' '
  2FF1'   CA 2FFC'              	JZ	MN_EXT
  2FF4'   CD 0000*              	CALL	OUTCH
  2FF7'   23                    	INX	H
  2FF8'   0D                    	DCR	C
  2FF9'   C2 2FEE'              	JNZ	MN_NM
  2FFC'                         MN_EXT:
  2FFC'   E1                    	POP	H
  2FFD'   11 0009               	LXI	D,9
	MACRO-80 3.44	09-Dec-81	PAGE	1-147


  3000'   19                    	DAD	D		; the type field
  3001'   7E                    	MOV	A,M
  3002'   FE 20                 	CPI	' '
  3004'   CA 301C'              	JZ	MN_END
  3007'   3E 2E                 	MVI	A,'.'
  3009'   CD 0000*              	CALL	OUTCH
  300C'   0E 03                 	MVI	C,3
  300E'                         MN_XL:
  300E'   7E                    	MOV	A,M
  300F'   FE 20                 	CPI	' '
  3011'   CA 301C'              	JZ	MN_END
  3014'   CD 0000*              	CALL	OUTCH
  3017'   23                    	INX	H
  3018'   0D                    	DCR	C
  3019'   C2 300E'              	JNZ	MN_XL
  301C'                         MN_END:
  301C'   3E 22                 	MVI	A,'"'
  301E'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  3021'                         MSGFLG:
  3021'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  3023'   B7                    	ORA	A
  3024'   CA 3034'              	JZ	MF_RO
  3027'   3A 0000*              	LDA	MODF
  302A'   B7                    	ORA	A
  302B'   CA 3034'              	JZ	MF_RO
  302E'   21 29C2'              	LXI	H,SMODM
  3031'   CD 3049'              	CALL	MF_PUT
  3034'                         MF_RO:
  3034'   3A 0000*              	LDA	ROFLAG
  3037'   B7                    	ORA	A
  3038'   CA 3041'              	JZ	MF_NEW
  303B'   21 29CD'              	LXI	H,SROM
  303E'   CD 3049'              	CALL	MF_PUT
  3041'                         MF_NEW:
  3041'   3A 0000*              	LDA	MSGNEW
  3044'   B7                    	ORA	A
  3045'   C8                    	RZ
  3046'   21 29D8'              	LXI	H,SNEWM
  3049'                         MF_PUT:
  3049'   78                    	MOV	A,B
  304A'   B7                    	ORA	A
  304B'   C2 3057'              	JNZ	MF_STR
  304E'   06 01                 	MVI	B,1
  3050'   E5                    	PUSH	H
  3051'   3E 20                 	MVI	A,' '
  3053'   CD 0000*              	CALL	OUTCH
  3056'   E1                    	POP	H
  3057'                         MF_STR:
  3057'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
	MACRO-80 3.44	09-Dec-81	PAGE	1-148


                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  305A'                         EMITW:
  305A'   C5                    	PUSH	B
  305B'   D5                    	PUSH	D
  305C'   06 00                 	MVI	B,0
  305E'   11 2710               	LXI	D,10000
  3061'   CD 307F'              	CALL	EWDIG
  3064'   11 03E8               	LXI	D,1000
  3067'   CD 307F'              	CALL	EWDIG
  306A'   11 0064               	LXI	D,100
  306D'   CD 307F'              	CALL	EWDIG
  3070'   11 000A               	LXI	D,10
  3073'   CD 307F'              	CALL	EWDIG
  3076'   7D                    	MOV	A,L		; the units digit is always printed
  3077'   C6 30                 	ADI	'0'
  3079'   CD 0000*              	CALL	OUTCH
  307C'   D1                    	POP	D
  307D'   C1                    	POP	B
  307E'   C9                    	RET
  307F'                         EWDIG:
  307F'   0E 00                 	MVI	C,0
  3081'                         EW_LP:
  3081'   7D                    	MOV	A,L
  3082'   93                    	SUB	E
  3083'   6F                    	MOV	L,A
  3084'   7C                    	MOV	A,H
  3085'   9A                    	SBB	D
  3086'   67                    	MOV	H,A
  3087'   DA 308E'              	JC	EW_DN
  308A'   0C                    	INR	C
  308B'   C3 3081'              	JMP	EW_LP
  308E'                         EW_DN:
  308E'   19                    	DAD	D		; one subtraction too many: give it back
  308F'   79                    	MOV	A,C
  3090'   B7                    	ORA	A
  3091'   C2 3097'              	JNZ	EW_PR
  3094'   78                    	MOV	A,B
  3095'   B7                    	ORA	A
  3096'   C8                    	RZ			; a leading zero: write nothing
  3097'                         EW_PR:
  3097'   79                    	MOV	A,C
  3098'   C6 30                 	ADI	'0'
  309A'   CD 0000*              	CALL	OUTCH
  309D'   06 01                 	MVI	B,1
  309F'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  30A0'                         ISEMPT:
  30A0'   2A 0000*              	LHLD	OUTPOS
  30A3'   7C                    	MOV	A,H
  30A4'   B5                    	ORA	L
  30A5'   C0                    	RNZ
  30A6'   CD 0000*              	CALL	LOGLEN
  30A9'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-149


  30AA'   B5                    	ORA	L
  30AB'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  30AC'                         MSGCTG:
  30AC'   21 0000*              	LXI	H,FNAME
  30AF'   CD 2FB9'              	CALL	MSGNAM
  30B2'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  30B4'   CD 3021'              	CALL	MSGFLG
  30B7'   CD 30A0'              	CALL	ISEMPT
  30BA'   C2 30C3'              	JNZ	MG_POS
  30BD'   21 29EB'              	LXI	H,SNOLIN
  30C0'   C3 0000*              	JMP	OUTSTR
  30C3'                         MG_POS:
  30C3'   21 29DE'              	LXI	H,SLINE
  30C6'   CD 0000*              	CALL	OUTSTR
  30C9'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  30CC'   23                    	INX	H		;   ... so the line it is on
  30CD'   CD 305A'              	CALL	EMITW
  30D0'   21 29E5'              	LXI	H,SCOLM
  30D3'   CD 0000*              	CALL	OUTSTR
  30D6'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  30D9'   23                    	INX	H
  30DA'   E5                    	PUSH	H
  30DB'   CD 305A'              	CALL	EMITW
  30DE'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  30E1'   23                    	INX	H
  30E2'   D1                    	POP	D
  30E3'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  30E6'   C8                    	RZ
  30E7'   E5                    	PUSH	H
  30E8'   3E 2D                 	MVI	A,'-'
  30EA'   CD 0000*              	CALL	OUTCH
  30ED'   E1                    	POP	H
  30EE'   C3 305A'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  30F1'                         FILMSG:
  30F1'   3A 0001*              	LDA	FNAME+1
  30F4'   FE 20                 	CPI	' '
  30F6'   C8                    	RZ
  30F7'   21 0000*              	LXI	H,FNAME
  30FA'   CD 2FB9'              	CALL	MSGNAM
  30FD'   AF                    	XRA	A		; nothing has been changed yet
  30FE'   C3 3021'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  3101'                         WRMSG:
  3101'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-150


  3104'   CD 2FB9'              	CALL	MSGNAM
  3107'   21 29FD'              	LXI	H,SWRIT
  310A'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  310D'                         MSGPST:
  310D'   3A 0000*              	LDA	MSGWHT
  3110'   B7                    	ORA	A
  3111'   C8                    	RZ
  3112'   47                    	MOV	B,A
  3113'   AF                    	XRA	A
  3114'   32 0000*              	STA	MSGWHT
  3117'   78                    	MOV	A,B
  3118'   FE 01                 	CPI	MW_FIL
  311A'   CA 3141'              	JZ	MP_FIL
  311D'   FE 02                 	CPI	MW_WRT
  311F'   CA 3147'              	JZ	MP_WRT
  3122'   FE 04                 	CPI	MW_BIG
  3124'   CA 3138'              	JZ	MP_BIG
  3127'   FE 05                 	CPI	MW_MEM
  3129'   CA 3132'              	JZ	MP_MEM
  312C'   CD 30AC'              	CALL	MSGCTG
  312F'   C3 0000*              	JMP	SCURS
  3132'                         MP_MEM:
  3132'   21 298B'              	LXI	H,SMEM
  3135'   C3 313B'              	JMP	MP_BG
  3138'                         MP_BIG:
  3138'   21 2979'              	LXI	H,SQBIG
  313B'                         MP_BG:
  313B'   CD 0000*              	CALL	EXMSG
  313E'   C3 0000*              	JMP	SCURS
  3141'                         MP_FIL:
  3141'   CD 30F1'              	CALL	FILMSG
  3144'   C3 0000*              	JMP	SCURS
  3147'                         MP_WRT:
  3147'   CD 3101'              	CALL	WRMSG
  314A'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  314D'                         VC_CTLG:
  314D'   3E 03                 	MVI	A,MW_CTG
  314F'   32 0000*              	STA	MSGWHT
  3152'   3E 01                 	MVI	A,R_MOVE
  3154'   32 0000*              	STA	RINTENT
  3157'   C3 079C'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  315A'                         CMDTAB:
  315A'   07                    	DB	07H			; ^G -- where am I?
  315B'   314D'                 	DW	VC_CTLG
