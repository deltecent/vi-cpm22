  1D47'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1D48'   32 24B3'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1D4B'   E1                    	POP	H
  1D4C'   CD 0000*              	CALL	EXMSG
  1D4F'   3E 01                 	MVI	A,R_MOVE
  1D51'   32 2458'              	STA	RINTENT
  1D54'   37                    	STC
  1D55'   C9                    	RET
                                
