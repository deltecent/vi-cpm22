  2D94'   1289'                 	DW	VC_LG
  2D96'   78                    	DB	'x'
  2D97'   186D'                 	DW	VC_X
  2D99'   5A                    	DB	'Z'
  2D9A'   2074'                 	DW	VC_BZ
  2D9C'   66                    	DB	'f'
  2D9D'   021A'                 	DW	VC_FF
  2D9F'   46                    	DB	'F'
  2DA0'   021F'                 	DW	VC_FB
  2DA2'   74                    	DB	't'
  2DA3'   0224'                 	DW	VC_TF
  2DA5'   54                    	DB	'T'
