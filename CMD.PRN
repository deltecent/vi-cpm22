  1C0D'   E1                    	POP	H
  1C0E'   3C                    	INR	A
  1C0F'   77                    	MOV	M,A
  1C10'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1C11'                         PARSFN:
  1C11'   CD 1B1D'              	CALL	TFCLR
  1C14'   11 0000*              	LXI	D,TFCB
  1C17'   23                    	INX	H
  1C18'   7E                    	MOV	A,M
  1C19'   2B                    	DCX	H
  1C1A'   FE 3A                 	CPI	':'
  1C1C'   C2 1C2E'              	JNZ	PF_NM
  1C1F'   CD 1C74'              	CALL	GETFNC
  1C22'   CA 1C2E'              	JZ	PF_NM
  1C25'   D6 40                 	SUI	40H
  1C27'   12                    	STAX	D
  1C28'   FE 11                 	CPI	17
  1C2A'   D2 1C52'              	JNC	PF_BAD
  1C2D'   23                    	INX	H
  1C2E'                         PF_NM:
  1C2E'   13                    	INX	D
  1C2F'   0E 08                 	MVI	C,8
  1C31'   CD 1C56'              	CALL	CPYNAM
  1C34'   FE 2E                 	CPI	'.'
  1C36'   0E 03                 	MVI	C,3
  1C38'   C4 1C69'              	CNZ	PADFLD		; no type: blanks
