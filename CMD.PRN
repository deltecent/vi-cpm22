  0FC8'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  0FC9'                         OV_NX:
  0FC9'   05                    	DCR	B
  0FCA'   37                    	STC
  0FCB'   C8                    	RZ
  0FCC'   3A 2E84'              	LDA	OVDIR
