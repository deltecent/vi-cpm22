  11CD'   C3 1139'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11D0'                         HTSCR:
  11D0'   CD 0EDE'              	CALL	CURRW
  11D3'   47                    	MOV	B,A
  11D4'   C3 11E2'              	JMP	HS_TP
  11D7'                         HTSET:
  11D7'   47                    	MOV	B,A
  11D8'   CD 0EDE'              	CALL	CURRW		; (keeps BC)
  11DB'   F5                    	PUSH	PSW
  11DC'   80                    	ADD	B
  11DD'   47                    	MOV	B,A
  11DE'   CD 11EC'              	CALL	HTRB
  11E1'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11E2'                         HS_TP:
  11E2'   3A 0000*              	LDA	HTCUR
  11E5'   90                    	SUB	B
  11E6'   32 0000*              	STA	HTTP
  11E9'   C3 11F8'              	JMP	HTPT
  11EC'                         HTRB:
  11EC'   CD 13DF'              	CALL	ZSAVE
  11EF'   CD 0000*              	CALL	HTBLD
  11F2'   CD 13F2'              	CALL	ZREST
  11F5'   3A 0000*              	LDA	HTCUR
  11F8'                         HTPT:
  11F8'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11F9'   16 00                 	MVI	D,0
  11FB'   21 0000*              	LXI	H,HTAB
  11FE'   19                    	DAD	D
  11FF'   3A 0000*              	LDA	HTN
  1202'   93                    	SUB	E
  1203'   47                    	MOV	B,A
  1204'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1205'                         HTIX:
  1205'   11 0000*              	LXI	D,HTAB
  1208'   7D                    	MOV	A,L
  1209'   93                    	SUB	E
  120A'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  120B'                         HTGO:
  120B'   CD 1205'              	CALL	HTIX
  120E'   47                    	MOV	B,A
  120F'   3A 0000*              	LDA	HTCUR
  1212'   90                    	SUB	B		; A = the lines up to it
  1213'   C3 0F15'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1216'                         HTFQ:
  1216'   78                    	MOV	A,B
  1217'   B7                    	ORA	A
  1218'   37                    	STC
  1219'   C8                    	RZ
  121A'   79                    	MOV	A,C
  121B'   96                    	SUB	M
  121C'   DA 1225'              	JC	HF_IN
  121F'   4F                    	MOV	C,A
  1220'   23                    	INX	H
  1221'   05                    	DCR	B
  1222'   C3 1216'              	JMP	HTFQ
  1225'                         HF_IN:
  1225'   B7                    	ORA	A
  1226'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1227'                         HTBQ:
  1227'   78                    	MOV	A,B
  1228'   B7                    	ORA	A
  1229'   37                    	STC
  122A'   C8                    	RZ
  122B'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122C'   05                    	DCR	B
  122D'   7E                    	MOV	A,M
  122E'   91                    	SUB	C
  122F'   D2 1238'              	JNC	HQ_IN
  1232'   2F                    	CMA
  1233'   3C                    	INR	A
  1234'   4F                    	MOV	C,A
  1235'   C3 1227'              	JMP	HTBQ
  1238'                         HQ_IN:
  1238'   4F                    	MOV	C,A
  1239'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  123A'                         RWQ:
  123A'   0E 64                 	MVI	C,100
  123C'   3A 0001*              	LDA	RWR+1
  123F'   B7                    	ORA	A
  1240'   C0                    	RNZ
  1241'   3A 0000*              	LDA	RWR
  1244'   B9                    	CMP	C
  1245'   D0                    	RNC
  1246'   4F                    	MOV	C,A
  1247'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1248'                         RWSUB:
  1248'   E5                    	PUSH	H
  1249'   5F                    	MOV	E,A
  124A'   16 00                 	MVI	D,0
  124C'   2A 0000*              	LHLD	RWR
  124F'   CD 0000*              	CALL	SUBHD
  1252'   22 0000*              	SHLD	RWR
  1255'   E1                    	POP	H
  1256'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1257'                         RWFWD:
  1257'   CD 123A'              	CALL	RWQ
  125A'   51                    	MOV	D,C
  125B'   CD 1216'              	CALL	HTFQ
  125E'   F5                    	PUSH	PSW
  125F'   7A                    	MOV	A,D
  1260'   91                    	SUB	C		; the rows that took it to that line's first
  1261'   CD 1248'              	CALL	RWSUB
  1264'   F1                    	POP	PSW
  1265'   DA 1279'              	JC	RF_OFF
  1268'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  126B'   B7                    	ORA	A
  126C'   C2 1283'              	JNZ	RF_GO
  126F'   3A 0000*              	LDA	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1272'   BE                    	CMP	M
  1273'   D2 1283'              	JNC	RF_GO
  1276'   4F                    	MOV	C,A
  1277'   B7                    	ORA	A
  1278'   C9                    	RET
  1279'                         RF_OFF:
  1279'   3A 0000*              	LDA	HTEOF
  127C'   B7                    	ORA	A
  127D'   CA 1283'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1280'   2B                    	DCX	H
  1281'   37                    	STC
  1282'   C9                    	RET
  1283'                         RF_GO:
  1283'   CD 120B'              	CALL	HTGO
  1286'   3E 01                 	MVI	A,1
  1288'   32 0000*              	STA	RWMV
  128B'   CD 123A'              	CALL	RWQ
  128E'   0C                    	INR	C
  128F'   06 00                 	MVI	B,0
  1291'   CD 11EC'              	CALL	HTRB
  1294'   C3 1257'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1297'                         RWBAK:
  1297'   CD 123A'              	CALL	RWQ
  129A'   51                    	MOV	D,C
  129B'   CD 1227'              	CALL	HTBQ
  129E'   DA 12BB'              	JC	RB_OFF
  12A1'   7A                    	MOV	A,D
  12A2'   81                    	ADD	C
  12A3'   5F                    	MOV	E,A		; E = the rows up to that line's first
  12A4'   3A 0001*              	LDA	RWR+1
  12A7'   B7                    	ORA	A
  12A8'   C2 12B7'              	JNZ	RB_ON
  12AB'   3A 0000*              	LDA	RWR
  12AE'   57                    	MOV	D,A
  12AF'   7B                    	MOV	A,E
  12B0'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  12B1'   DA 12B7'              	JC	RB_ON
  12B4'   4F                    	MOV	C,A
  12B5'   B7                    	ORA	A
  12B6'   C9                    	RET
  12B7'                         RB_ON:
  12B7'   7B                    	MOV	A,E
  12B8'   C3 12C2'              	JMP	RB_GO
  12BB'                         RB_OFF:
  12BB'   3A 0000*              	LDA	HTBOF
  12BE'   0F                    	RRC			; CY: that is the file's first line
  12BF'   D8                    	RC
  12C0'   7A                    	MOV	A,D
  12C1'   91                    	SUB	C
  12C2'                         RB_GO:
  12C2'   CD 1248'              	CALL	RWSUB
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12C5'   CD 120B'              	CALL	HTGO
  12C8'   3E 01                 	MVI	A,1
  12CA'   32 0000*              	STA	RWMV
  12CD'   CD 123A'              	CALL	RWQ
  12D0'   41                    	MOV	B,C
  12D1'   0E 01                 	MVI	C,1
  12D3'   CD 11EC'              	CALL	HTRB
  12D6'   43                    	MOV	B,E
  12D7'   C3 1297'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12DA'                         ONFST:
  12DA'   E5                    	PUSH	H
  12DB'   2A 0000*              	LHLD	OUTPOS
  12DE'   7C                    	MOV	A,H
  12DF'   B5                    	ORA	L
  12E0'   C2 12F8'              	JNZ	OF_RET
  12E3'   2A 0000*              	LHLD	TXTBEG
  12E6'   EB                    	XCHG			; DE = TXTBEG
  12E7'   2A 0000*              	LHLD	GAPBEG
  12EA'                         OF_LP:
  12EA'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12ED'   CA 12F8'              	JZ	OF_RET
  12F0'   2B                    	DCX	H
  12F1'   7E                    	MOV	A,M
  12F2'   FE 0A                 	CPI	LF
  12F4'   C2 12EA'              	JNZ	OF_LP
  12F7'   B7                    	ORA	A		; NZ
  12F8'                         OF_RET:
  12F8'   E1                    	POP	H
  12F9'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12FA'                         HFCNT:
  12FA'   2A 0000*              	LHLD	CMDCNT
  12FD'   7C                    	MOV	A,H
  12FE'   B5                    	ORA	L
  12FF'   CA 1316'              	JZ	HFC_AM
  1302'   CD 079C'              	CALL	GETCNT		; HL = count; clears it
  1305'   3A 0000*              	LDA	NEDIT
  1308'   5F                    	MOV	E,A
  1309'   16 00                 	MVI	D,0
  130B'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  130E'   D2 1312'              	JNC	HFC_ST
  1311'   EB                    	XCHG			; HL = NEDIT
  1312'                         HFC_ST:
  1312'   7D                    	MOV	A,L
  1313'   32 0000*              	STA	HFAMT
  1316'                         HFC_AM:
  1316'   3A 0000*              	LDA	HFAMT
  1319'   B7                    	ORA	A
  131A'   C2 1327'              	JNZ	HFC_HL
  131D'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1320'   B7                    	ORA	A
  1321'   1F                    	RAR
  1322'   B7                    	ORA	A
  1323'   C2 1327'              	JNZ	HFC_HL
  1326'   3C                    	INR	A		; at least one row
  1327'                         HFC_HL:
  1327'   32 0000*              	STA	HFN
  132A'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  132B'                         VC_REDR:
  132B'   C3 079C'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  132E'                         VC_G:
  132E'   CD 0871'              	CALL	SETMOV
  1331'   CD 1405'              	CALL	GZONE		; the screen's top line, before the move
  1334'   CD 07C5'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1337'   2A 0000*              	LHLD	CMDCNT
  133A'   7C                    	MOV	A,H
  133B'   B5                    	ORA	L
  133C'   C2 134F'              	JNZ	VG_N
  133F'   AF                    	XRA	A		; forward
  1340'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1343'   CD 0802'              	CALL	BRKOFF
  1346'   DA 081A'              	JC	BRKBAK
  1349'   CD 0C00'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  134C'   C3 141D'              	JMP	GPLACE
  134F'                         VG_N:
  134F'   CD 079C'              	CALL	GETCNT		; HL = target line (1-based)
  1352'                         VG_LN:
  1352'   CD 135E'              	CALL	GOLN
  1355'   CD 0802'              	CALL	BRKOFF
  1358'   DA 081A'              	JC	BRKBAK
  135B'   C3 141D'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;to go back to line 1 and count forward from there, whatever the distance.
                                ;A line less than half as far down as the window's top, on a file not changed
                                ;since it was opened or written, is the exception: PGJUMP reads the file
                                ;again from its start and the move counts forward from line 1 (#34 part B).
  135E'                         GOLN:
  135E'   E5                    	PUSH	H
  135F'   CD 0000*              	CALL	CNTLF
  1362'   23                    	INX	H		; HL = the cursor's line
  1363'   D1                    	POP	D		; DE = the line wanted
  1364'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1367'   DA 1372'              	JC	GLN_BK
  136A'   EB                    	XCHG
  136B'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  136E'   AF                    	XRA	A
  136F'   C3 138C'              	JMP	GLN_MV
  1372'                         GLN_BK:
  1372'   E5                    	PUSH	H
  1373'   D5                    	PUSH	D
  1374'   2A 0000*              	LHLD	TOPLF
  1377'   EB                    	XCHG			; DE = the lines behind the window
  1378'   2B                    	DCX	H		; HL = the lines above the one wanted
  1379'   CD 0000*              	CALL	PGJUMP
  137C'   D1                    	POP	D
  137D'   E1                    	POP	H
  137E'   D2 1387'              	JNC	GLN_UP
  1381'   EB                    	XCHG			; it jumped: the cursor is on line 1
  1382'   2B                    	DCX	H		; HL = the lines down to it
  1383'   AF                    	XRA	A
  1384'   C3 138C'              	JMP	GLN_MV
  1387'                         GLN_UP:
  1387'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  138A'   3E FF                 	MVI	A,0FFH
  138C'                         GLN_MV:
  138C'   CD 0000*              	CALL	MVLIND
  138F'   CD 0BFA'              	CALL	ATEOF
  1392'   DC 0C00'              	CC	LASTLN		; past the last line: onto it
  1395'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1396'                         VC_LG:
  1396'   CD 0871'              	CALL	SETMOV
  1399'   3A 0000*              	LDA	GSAVE
  139C'   B7                    	ORA	A
  139D'   C2 13A6'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  13A0'   3E 01                 	MVI	A,PG
  13A2'   32 0000*              	STA	GPEND
  13A5'   C9                    	RET
  13A6'                         VLG_GG:
  13A6'   CD 1405'              	CALL	GZONE
  13A9'   CD 07C5'              	CALL	BRKON
  13AC'   CD 079C'              	CALL	GETCNT		; HL = target line (no count: 1)
  13AF'   C3 1352'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13B2'                         SUB24:
  13B2'   4F                    	MOV	C,A
  13B3'   7D                    	MOV	A,L
  13B4'   93                    	SUB	E
  13B5'   6F                    	MOV	L,A
  13B6'   7C                    	MOV	A,H
  13B7'   9A                    	SBB	D
  13B8'   67                    	MOV	H,A
  13B9'   79                    	MOV	A,C
  13BA'   98                    	SBB	B
  13BB'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  13BC'                         CURFP:
  13BC'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  13BF'                         FPOS:
  13BF'   C5                    	PUSH	B
  13C0'   D5                    	PUSH	D
  13C1'   EB                    	XCHG
  13C2'   2A 0000*              	LHLD	TXTBEG
  13C5'   EB                    	XCHG
  13C6'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  13C9'   EB                    	XCHG			; DE = that
  13CA'   2A 0000*              	LHLD	OUTPOS
  13CD'   7C                    	MOV	A,H
  13CE'   B7                    	ORA	A		; CY = 0
  13CF'   1F                    	RAR
  13D0'   47                    	MOV	B,A
  13D1'   7D                    	MOV	A,L
  13D2'   1F                    	RAR
  13D3'   67                    	MOV	H,A
  13D4'   3E 00                 	MVI	A,0
  13D6'   1F                    	RAR
  13D7'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13D8'   19                    	DAD	D
  13D9'   78                    	MOV	A,B
  13DA'   CE 00                 	ACI	0		; A:HL = the position
  13DC'   D1                    	POP	D
  13DD'   C1                    	POP	B
  13DE'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13DF'                         ZSAVE:
  13DF'   2A 0000*              	LHLD	CMDCNT
  13E2'   22 0000*              	SHLD	ZSVCNT
  13E5'   2A 0000*              	LHLD	AUXCNT
  13E8'   22 0000*              	SHLD	ZSVAUX
  13EB'   3A 0000*              	LDA	DIRFLG
  13EE'   32 0000*              	STA	ZSVDIR
  13F1'   C9                    	RET
  13F2'                         ZREST:
  13F2'   2A 0000*              	LHLD	ZSVCNT
  13F5'   22 0000*              	SHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  13F8'   2A 0000*              	LHLD	ZSVAUX
  13FB'   22 0000*              	SHLD	AUXCNT
  13FE'   3A 0000*              	LDA	ZSVDIR
  1401'   32 0000*              	STA	DIRFLG
  1404'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1405'                         GZONE:
  1405'   CD 13DF'              	CALL	ZSAVE
  1408'   CD 0EDE'              	CALL	CURRW
  140B'   6F                    	MOV	L,A
  140C'   26 00                 	MVI	H,0
  140E'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1411'   CD 13BF'              	CALL	FPOS
  1414'   22 0000*              	SHLD	ZTOP
  1417'   32 0002*              	STA	ZTOP+2
  141A'   C3 13F2'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  141D'                         GPLACE:
  141D'   CD 13DF'              	CALL	ZSAVE
  1420'   CD 13BC'              	CALL	CURFP
  1423'   EB                    	XCHG
  1424'   2A 0000*              	LHLD	ZTOP
  1427'   EB                    	XCHG
  1428'   4F                    	MOV	C,A		; C:HL = the target's position
  1429'   3A 0002*              	LDA	ZTOP+2
  142C'   47                    	MOV	B,A		; B:DE = the top's
  142D'   79                    	MOV	A,C
  142E'   CD 13B2'              	CALL	SUB24
  1431'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1434'   DA 146E'              	JC	GP_UP
  1437'   B7                    	ORA	A
  1438'   C2 14B4'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  143B'   3A 0000*              	LDA	NEDIT
  143E'   87                    	ADD	A
  143F'   3C                    	INR	A
  1440'   6F                    	MOV	L,A
  1441'   26 00                 	MVI	H,0
  1443'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1446'   CD 0795'              	CALL	GBSUB		; HL = bytes from there to the target
  1449'   EB                    	XCHG
  144A'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  144D'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1450'   DA 14B4'              	JC	GP_MID
  1453'   CD 0795'              	CALL	GBSUB		; HL = the top line's start (resident)
  1456'   01 0000               	LXI	B,0		; BC = lines from the top
  1459'                         GP_CNT:
  1459'   7A                    	MOV	A,D
  145A'   B3                    	ORA	E
  145B'   CA 146A'              	JZ	GP_DN
  145E'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  145F'   23                    	INX	H
  1460'   1B                    	DCX	D
  1461'   FE 0A                 	CPI	LF
  1463'   C2 1459'              	JNZ	GP_CNT
  1466'   03                    	INX	B
  1467'   C3 1459'              	JMP	GP_CNT
  146A'                         GP_DN:
  146A'   79                    	MOV	A,C		; the lines from the top one to it
  146B'   C3 14DE'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  146E'                         GP_UP:
  146E'   3C                    	INR	A
  146F'   C2 14B4'              	JNZ	GP_MID		; 64K bytes or more above
  1472'   2A 0000*              	LHLD	ZDIF
  1475'   EB                    	XCHG
  1476'   21 0000               	LXI	H,0
  1479'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  147C'   7C                    	MOV	A,H
  147D'   B5                    	ORA	L
  147E'   CA 14B4'              	JZ	GP_MID		; exactly 64K
  1481'   EB                    	XCHG			; DE = bytes to read
  1482'   AF                    	XRA	A
  1483'   32 0000*              	STA	ZLF
  1486'   CD 0000*              	CALL	RGET0
  1489'                         GP_RD:
  1489'   CD 0000*              	CALL	RDGET		; (keeps DE)
  148C'   DA 14B4'              	JC	GP_MID
  148F'   FE 0A                 	CPI	LF
  1491'   C2 14A5'              	JNZ	GP_RN
  1494'   3A 0000*              	LDA	NEDIT
  1497'   B7                    	ORA	A
  1498'   1F                    	RAR
  1499'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  149B'   E5                    	PUSH	H
  149C'   21 0000*              	LXI	H,ZLF
  149F'   34                    	INR	M
  14A0'   BE                    	CMP	M		; CY iff more lines than that
  14A1'   E1                    	POP	H
  14A2'   DA 14B4'              	JC	GP_MID
  14A5'                         GP_RN:
  14A5'   1B                    	DCX	D
  14A6'   7A                    	MOV	A,D
  14A7'   B3                    	ORA	E
  14A8'   C2 1489'              	JNZ	GP_RD
  14AB'   3E 01                 	MVI	A,PL_SET	; the top row
  14AD'   32 0000*              	STA	PLACE
  14B0'   AF                    	XRA	A
  14B1'   C3 14BE'              	JMP	GP_SET
  14B4'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  14B4'   3E 02                 	MVI	A,PL_MID
  14B6'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  14B9'   3A 0000*              	LDA	NEDIT
  14BC'   B7                    	ORA	A
  14BD'   1F                    	RAR			; (no more lines above it than this)
  14BE'                         GP_SET:
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14BE'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  14BF'   26 00                 	MVI	H,0
  14C1'   22 0000*              	SHLD	WINROW
  14C4'   21 0000               	LXI	H,0
  14C7'   22 0000*              	SHLD	LNDLT
  14CA'   CD 08AE'              	CALL	SETFUL		; the window may have paged: full repaint
  14CD'                         GP_FIN:
  14CD'   CD 13F2'              	CALL	ZREST
  14D0'   3A 0000*              	LDA	GPKEEP
  14D3'   B7                    	ORA	A
  14D4'   CA 0977'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14D7'   AF                    	XRA	A
  14D8'   32 0000*              	STA	GPKEEP
  14DB'   C3 0630'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14DE'                         GP_ONS:
  14DE'   6F                    	MOV	L,A
  14DF'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14E1'   EB                    	XCHG
  14E2'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14E5'   EB                    	XCHG
  14E6'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14E9'   22 0000*              	SHLD	LNDLT
  14EC'   3E 01                 	MVI	A,R_MOVE
  14EE'   32 0000*              	STA	RINTENT
  14F1'   C3 14CD'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14F4'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  14F4'   AF                    	XRA	A
  14F5'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14F8'   3A 0000*              	LDA	PSAVE
  14FB'   FE 63                 	CPI	'c'
  14FD'   C2 151A'              	JNZ	OPP_ND
  1500'   79                    	MOV	A,C
  1501'   FE 77                 	CPI	'w'
  1503'   CA 150B'              	JZ	OPP_W
  1506'   FE 57                 	CPI	'W'
  1508'   C2 151A'              	JNZ	OPP_ND
  150B'                         OPP_W:
  150B'   CD 16F5'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  150E'   DA 151A'              	JC	OPP_ND
  1511'   79                    	MOV	A,C
  1512'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1514'   4F                    	MOV	C,A
  1515'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1517'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  151A'                         OPP_ND:
  151A'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  151B'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  151D'   C2 1531'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1520'   CD 01FC'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1523'   DA 15C9'              	JC	OPABRT
  1526'   79                    	MOV	A,C
  1527'   FE 67                 	CPI	'g'
  1529'   C2 15C9'              	JNZ	OPABRT
  152C'   3E 01                 	MVI	A,PG
  152E'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1531'                         OPP_NG:
  1531'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1532'   21 0000*              	LXI	H,PSAVE
  1535'   BE                    	CMP	M
  1536'   CA 1716'              	JZ	OPLINE
  1539'   79                    	MOV	A,C		; (OPCLS classifies the key)
  153A'   CD 172C'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  153D'   DA 15C9'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1540'   32 0000*              	STA	OPCLSV
  1543'   47                    	MOV	B,A		; B = the class
  1544'   3A 0000*              	LDA	PSAVE
  1547'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1549'   C2 1555'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  154C'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  154D'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  154F'   C2 1577'              	JNZ	OPP_GO
  1552'   C3 1560'              	JMP	OPP_NO
  1555'                         OPP_NC:
  1555'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1557'   C2 1577'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  155A'   78                    	MOV	A,B		;   a charwise register would need a type flag
  155B'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  155D'   CA 1577'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1560'                         OPP_NO:
  1560'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1561'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1563'   CA 1571'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1566'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1568'   CA 1571'              	JZ	OPP_SW		;   so swallow it before dropping the command
  156B'   CD 0329'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  156E'   C2 15C9'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1571'                         OPP_SW:
  1571'   CD 01FC'              	CALL	MKGETK
  1574'   C3 15C9'              	JMP	OPABRT
  1577'                         OPP_GO:
  1577'   AF                    	XRA	A
  1578'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  157B'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  157E'   22 0000*              	SHLD	OPSTA
  1581'   C5                    	PUSH	B
  1582'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1585'   CD 0448'              	CALL	FPSTO		;   only good until the motion pages the window
  1588'   3A 0000*              	LDA	OPCLSV
  158B'   FE 02                 	CPI	2
  158D'   CC 15CC'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1590'   C1                    	POP	B
  1591'   21 3135'              	LXI	H,CMDTAB
  1594'   CD 00C6'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1597'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  159A'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  159B'   CA 0871'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  159E'   3A 0000*              	LDA	OPCLSV
  15A1'   FE 02                 	CPI	2
  15A3'   CC 0964'              	CZ	LNEND		; a line motion: the line it landed on whole, or
                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  15A6'   CD 15F8'              	CALL	OPSFIX		; where the start is in the window NOW
  15A9'   D2 1614'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  15AC'   22 0000*              	SHLD	OPSTA
  15AF'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  15B2'   22 0000*              	SHLD	OPEND2
  15B5'   3A 0000*              	LDA	PSAVE
  15B8'   FE 79                 	CPI	'y'
  15BA'   CA 1CCE'              	JZ	OPYANK		; a yank takes the span without losing it
  15BD'   CD 1767'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  15C0'   3A 0000*              	LDA	PSAVE
  15C3'   FE 63                 	CPI	'c'
  15C5'   C0                    	RNZ
  15C6'   C3 1A82'              	JMP	SETINS
  15C9'                         OPABRT:				; not a motion -> the operator is dropped and
  15C9'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  15CC'                         OPENDS:
  15CC'   2A 0000*              	LHLD	OPSTA
  15CF'   CD 0697'              	CALL	BOL
  15D2'   11 0000*              	LXI	D,OPSLO
  15D5'   CD 15EA'              	CALL	OPE_ST
  15D8'   2A 0000*              	LHLD	OPSTA
  15DB'   CD 072E'              	CALL	NLSTART
  15DE'   11 0000*              	LXI	D,OPSHI
  15E1'   CD 15EA'              	CALL	OPE_ST
  15E4'   2A 0000*              	LHLD	OPSTA
  15E7'   C3 0000*              	JMP	GOTO
  15EA'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  15EA'   D5                    	PUSH	D
  15EB'   CD 0000*              	CALL	GOTO
  15EE'   E1                    	POP	H
  15EF'   C3 0448'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  15F2'                         CURBD:
  15F2'   CD 13BC'              	CALL	CURFP
  15F5'   EB                    	XCHG
  15F6'   47                    	MOV	B,A
  15F7'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  15F8'                         OPSFIX:
  15F8'   21 0000*              	LXI	H,OPSFP
  15FB'   CD 03FB'              	CALL	MKLOAD
  15FE'   CD 15F2'              	CALL	CURBD
  1601'   2A 0000*              	LHLD	MKPOS
  1604'   3A 0002*              	LDA	MKPOS+2
  1607'   CD 13B2'              	CALL	SUB24
  160A'   B4                    	ORA	H
  160B'   B5                    	ORA	L
  160C'   C2 0408'              	JNZ	MKWIN
  160F'   CD 0000*              	CALL	CUROFF
  1612'   37                    	STC
  1613'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1614'                         OPPGD:
  1614'   47                    	MOV	B,A
  1615'   3A 0000*              	LDA	OPCLSV
  1618'   FE 02                 	CPI	2
  161A'   C2 16D6'              	JNZ	OPG_NO
  161D'   3A 0000*              	LDA	PSAVE
  1620'   FE 64                 	CPI	'd'
  1622'   C2 16D6'              	JNZ	OPG_NO
  1625'   04                    	INR	B
  1626'   CA 1635'              	JZ	OPG_FW
  1629'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  162C'   CD 0697'              	CALL	BOL		;   and the high end is OPSHI as it stands
  162F'   CD 0000*              	CALL	GOTO
  1632'   C3 164D'              	JMP	OPG_GO
  1635'                         OPG_FW:
  1635'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1638'   CD 072E'              	CALL	NLSTART		;   landed on, and the low one is where the
  163B'   11 0000*              	LXI	D,OPSHI		;   start line began
  163E'   CD 15EA'              	CALL	OPE_ST
  1641'   21 0000*              	LXI	H,OPSLO
  1644'   CD 03FB'              	CALL	MKLOAD
  1647'   CD 03AC'              	CALL	MKPAGE
  164A'   CD 0000*              	CALL	GOTO
  164D'                         OPG_GO:
  164D'   CD 15F2'              	CALL	CURBD
  1650'   2A 0000*              	LHLD	OPSHI
  1653'   3A 0002*              	LDA	OPSHI+2
  1656'   CD 13B2'              	CALL	SUB24		; A:HL = the bytes to take
  1659'                         OPG_SV:
  1659'   22 0000*              	SHLD	OPTOGO
  165C'   32 0002*              	STA	OPTOGO+2
  165F'                         OPG_NX:
  165F'   CD 0778'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1662'   CD 0000*              	CALL	SUBHD
  1665'   EB                    	XCHG			; DE = what the window holds past the cursor
  1666'   2A 0000*              	LHLD	OPTOGO
  1669'   3A 0002*              	LDA	OPTOGO+2
  166C'   B7                    	ORA	A
  166D'   C2 16A0'              	JNZ	OPG_PG		; 64K or more to go
  1670'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1673'   DA 16A0'              	JC	OPG_PG
  1676'   CA 16A0'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1679'                         OPG_FN:				; the rest of it is here
  1679'   E5                    	PUSH	H
  167A'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  167D'   CD 0000*              	CALL	CUROFF
  1680'   22 0000*              	SHLD	OPLO
  1683'   D1                    	POP	D
  1684'   19                    	DAD	D
  1685'   22 0000*              	SHLD	OPHI
  1688'   CD 189A'              	CALL	OPDSPN
  168B'   CD 0BFA'              	CALL	ATEOF
  168E'   D2 16EF'              	JNC	OPMID
  1691'   CD 12DA'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1694'   CA 16EF'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1697'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  169A'   CD 0000*              	CALL	SETBWD
  169D'   C3 16EF'              	JMP	OPMID
  16A0'                         OPG_PG:
  16A0'   7A                    	MOV	A,D
  16A1'   B3                    	ORA	E
  16A2'   C2 16BB'              	JNZ	OPG_DL
  16A5'   CD 0BFA'              	CALL	ATEOF		; nothing held past the cursor
  16A8'   21 0000               	LXI	H,0
  16AB'   DA 1679'              	JC	OPG_FN		; ... and no more to come: the file ran out
  16AE'   2B                    	DCX	H
  16AF'   CD 0000*              	CALL	SETC0
  16B2'   CD 0000*              	CALL	GOLINE
  16B5'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  16B8'   C3 165F'              	JMP	OPG_NX
  16BB'                         OPG_DL:
  16BB'   D5                    	PUSH	D
  16BC'   21 FFFF               	LXI	H,0FFFFH
  16BF'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  16C2'   E1                    	POP	H
  16C3'   E5                    	PUSH	H
  16C4'   CD 0000*              	CALL	DELFWD
  16C7'   D1                    	POP	D
  16C8'   06 00                 	MVI	B,0
  16CA'   2A 0000*              	LHLD	OPTOGO
  16CD'   3A 0002*              	LDA	OPTOGO+2
  16D0'   CD 13B2'              	CALL	SUB24
  16D3'   C3 1659'              	JMP	OPG_SV
  16D6'                         OPG_NO:
  16D6'   0E 07                 	MVI	C,BEL
  16D8'   CD 0000*              	CALL	BCONOU
  16DB'                         OPG_HM:				; the cursor back where the command found it
  16DB'   21 0000*              	LXI	H,OPSFP
  16DE'   CD 03FB'              	CALL	MKLOAD
  16E1'   CD 03AC'              	CALL	MKPAGE
  16E4'   CD 0000*              	CALL	GOTO
  16E7'   AF                    	XRA	A
  16E8'   32 0000*              	STA	PSAVE
  16EB'   3C                    	INR	A
  16EC'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  16EF'                         OPMID:
  16EF'   CD 13DF'              	CALL	ZSAVE
  16F2'   C3 14B4'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  16F5'                         ONWHIT:
  16F5'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16F8'   CA 1714'              	JZ	OW_YES
  16FB'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  16FE'   FE 20                 	CPI	' '
  1700'   CA 1714'              	JZ	OW_YES
  1703'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1705'   CA 1714'              	JZ	OW_YES
  1708'   FE 0D                 	CPI	CR
  170A'   CA 1714'              	JZ	OW_YES
  170D'   FE 0A                 	CPI	LF
  170F'   CA 1714'              	JZ	OW_YES
  1712'   B7                    	ORA	A		; a char to change: CY clear
  1713'   C9                    	RET
  1714'                         OW_YES:
  1714'   37                    	STC
  1715'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1716'                         OPLINE:
  1716'   3A 0000*              	LDA	PSAVE
  1719'   FE 63                 	CPI	'c'
  171B'   CA 0871'              	JZ	SETMOV
  171E'   FE 79                 	CPI	'y'
  1720'   CA 1CAD'              	JZ	VY_YY
  1723'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1726'   CD 0448'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1729'   C3 1C23'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  172C'                         OPCLS:
  172C'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  172E'   CA 173B'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1731'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1733'   C2 174F'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1736'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1738'   C3 173D'              	JMP	OPC_FK
  173B'                         OPC_SEM:
  173B'   06 00                 	MVI	B,0		; ';' runs it as it stands
  173D'                         OPC_FK:
  173D'   3A 0000*              	LDA	FNDKND
  1740'   B7                    	ORA	A
  1741'   37                    	STC
  1742'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1743'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1744'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1746'   CA 174D'              	JZ	OPC_EXC
  1749'   3E 01                 	MVI	A,1
  174B'   B7                    	ORA	A		; CY clear: a motion, class 1
  174C'   C9                    	RET
  174D'                         OPC_EXC:
  174D'   AF                    	XRA	A		; class 0, CY clear
  174E'   C9                    	RET
  174F'                         OPC_TB:
  174F'   47                    	MOV	B,A
  1750'   21 193F'              	LXI	H,OPCTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1753'                         OPC_LP:
  1753'   7E                    	MOV	A,M
  1754'   B7                    	ORA	A
  1755'   CA 1765'              	JZ	OPC_MS		; end of table -> not a motion
  1758'   B8                    	CMP	B
  1759'   CA 1761'              	JZ	OPC_HT
  175C'   23                    	INX	H
  175D'   23                    	INX	H
  175E'   C3 1753'              	JMP	OPC_LP
  1761'                         OPC_HT:
  1761'   23                    	INX	H
  1762'   7E                    	MOV	A,M		; class byte
  1763'   B7                    	ORA	A		; clear CY
  1764'   C9                    	RET
  1765'                         OPC_MS:
  1765'   37                    	STC
  1766'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1767'                         OPAPPL:
  1767'   3A 0000*              	LDA	OPCLSV
  176A'   FE 02                 	CPI	2
  176C'   CA 1913'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  176F'   2A 0000*              	LHLD	OPSTA
  1772'   EB                    	XCHG			; DE = start
  1773'   2A 0000*              	LHLD	OPEND2		; HL = end
  1776'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1779'   DA 178C'              	JC	OPA_F
  177C'   CA 178C'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  177F'   22 0000*              	SHLD	OPLO
  1782'   EB                    	XCHG
  1783'   22 0000*              	SHLD	OPHI
  1786'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1789'   C3 1843'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  178C'                         OPA_F:
  178C'   EB                    	XCHG			; HL = start, DE = end
  178D'   22 0000*              	SHLD	OPLO
  1790'   EB                    	XCHG			; HL = end
  1791'   3A 0000*              	LDA	OPCLSV
  1794'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1796'   CA 1840'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1799'   FE 01                 	CPI	1
  179B'   C2 17BD'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  179E'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  179F'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  17A2'   2B                    	DCX	H		; the line it landed on
  17A3'   CD 1A00'              	CALL	CEND		; HL = that line's content end
  17A6'   EB                    	XCHG			; DE = it
  17A7'   2A 0000*              	LHLD	OPHI		; HL = hi
  17AA'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  17AD'   D2 17C8'              	JNC	OPA_HI		; hi is inside the line: keep it
  17B0'   2A 0000*              	LHLD	OPLO
  17B3'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  17B6'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  17B9'   EB                    	XCHG			; HL = the content end: the span stops there
  17BA'   C3 17C8'              	JMP	OPA_HI
  17BD'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  17BD'   22 0000*              	SHLD	OPHI
  17C0'   3A 0000*              	LDA	WPULL
  17C3'   B7                    	ORA	A
  17C4'   CA 1843'              	JZ	OPA_C1
  17C7'   23                    	INX	H
  17C8'                         OPA_HI:
  17C8'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  17CB'                         OPA_DO:
  17CB'   CD 188F'              	CALL	OPSPNL
  17CE'   7C                    	MOV	A,H
  17CF'   B5                    	ORA	L
  17D0'   C2 17D9'              	JNZ	OPA_D1
  17D3'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17D6'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17D9'                         OPA_D1:
  17D9'   3A 0000*              	LDA	PSAVE
  17DC'   FE 63                 	CPI	'c'
  17DE'   CA 189A'              	JZ	OPDSPN
  17E1'   CD 1882'              	CALL	SPNBRK
  17E4'   D2 1805'              	JNC	OPA_D2
  17E7'   2A 0000*              	LHLD	OPHI
  17EA'   CD 1A00'              	CALL	CEND
  17ED'   EB                    	XCHG			; DE = the content end of the line it ends in
  17EE'   2A 0000*              	LHLD	OPHI
  17F1'                         OPA_BL:
  17F1'   CD 0000*              	CALL	CMP16
  17F4'   CA 180B'              	JZ	OPA_BI		; only blanks after it
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  17F7'   D5                    	PUSH	D
  17F8'   E5                    	PUSH	H
  17F9'   CD 0000*              	CALL	CHARAT
  17FC'   E1                    	POP	H
  17FD'   D1                    	POP	D
  17FE'   23                    	INX	H
  17FF'   CD 183A'              	CALL	BLANKQ
  1802'   CA 17F1'              	JZ	OPA_BL
  1805'                         OPA_D2:
  1805'   CD 189A'              	CALL	OPDSPN
  1808'   C3 1A11'              	JMP	CLAMPE
  180B'                         OPA_BI:
  180B'   CD 181D'              	CALL	LOIND
  180E'   C2 1805'              	JNZ	OPA_D2
  1811'   2A 0000*              	LHLD	OPHI
  1814'   CD 072E'              	CALL	NLSTART
  1817'   22 0000*              	SHLD	OPHI
  181A'   C3 186E'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  181D'                         LOIND:
  181D'   2A 0000*              	LHLD	OPLO
  1820'   CD 0697'              	CALL	BOL
  1823'                         LI_LP:
  1823'   E5                    	PUSH	H
  1824'   EB                    	XCHG
  1825'   2A 0000*              	LHLD	OPLO
  1828'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  182B'   E1                    	POP	H
  182C'   C8                    	RZ
  182D'   E5                    	PUSH	H
  182E'   CD 0000*              	CALL	CHARAT
  1831'   E1                    	POP	H
  1832'   23                    	INX	H
  1833'   CD 183A'              	CALL	BLANKQ
  1836'   CA 1823'              	JZ	LI_LP
  1839'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  183A'                         BLANKQ:
  183A'   FE 20                 	CPI	' '
  183C'   C8                    	RZ
  183D'   FE 09                 	CPI	TAB
  183F'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1840'                         OPA_JP:
  1840'   22 0000*              	SHLD	OPHI
  1843'                         OPA_C1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1843'   CD 188F'              	CALL	OPSPNL
  1846'   7C                    	MOV	A,H
  1847'   B5                    	ORA	L
  1848'   CA 17CB'              	JZ	OPA_DO		; nothing spanned
  184B'   2A 0000*              	LHLD	OPHI
  184E'   CD 0697'              	CALL	BOL
  1851'   EB                    	XCHG
  1852'   2A 0000*              	LHLD	OPHI
  1855'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1858'   C2 17CB'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  185B'   CD 181D'              	CALL	LOIND
  185E'   CA 186E'              	JZ	C1_LW		; only blanks before lo: whole lines
  1861'                         C1_CH:
  1861'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1864'   2B                    	DCX	H		;   of the line before
  1865'   CD 1A00'              	CALL	CEND
  1868'   22 0000*              	SHLD	OPHI
  186B'   C3 17CB'              	JMP	OPA_DO
  186E'                         C1_LW:
  186E'   2A 0000*              	LHLD	OPLO
  1871'   CD 0697'              	CALL	BOL
  1874'   22 0000*              	SHLD	OPLO
  1877'   3A 0000*              	LDA	PSAVE
  187A'   FE 63                 	CPI	'c'
  187C'   CA 1861'              	JZ	C1_CH
  187F'   C3 1926'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1882'                         SPNBRK:
  1882'   2A 0000*              	LHLD	OPLO
  1885'   CD 06DA'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1888'   EB                    	XCHG			; DE = it
  1889'   2A 0000*              	LHLD	OPHI
  188C'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  188F'                         OPSPNL:
  188F'   2A 0000*              	LHLD	OPHI
  1892'   EB                    	XCHG
  1893'   2A 0000*              	LHLD	OPLO
  1896'   EB                    	XCHG			; HL = hi, DE = lo
  1897'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  189A'                         OPDSPN:
  189A'   CD 1882'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  189D'   F5                    	PUSH	PSW
  189E'   2A 0000*              	LHLD	OPSTA
  18A1'   EB                    	XCHG
  18A2'   2A 0000*              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18A5'   22 0000*              	SHLD	WKI
  18A8'   CD 0000*              	CALL	CMP16
  18AB'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  18AC'   CD 0000*              	CALL	GOTO
  18AF'   CD 188F'              	CALL	OPSPNL		; HL = hi - lo
  18B2'   CD 0877'              	CALL	SETLIN
  18B5'   F1                    	POP	PSW
  18B6'   CC 19CF'              	CZ	DCHQ
  18B9'   CD 0000*              	CALL	DELFWD
  18BC'   CD 0177'              	CALL	MARKMOD
  18BF'   F1                    	POP	PSW
  18C0'   D0                    	RNC
  18C1'   C3 08AE'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  18C4'                         UNDFNB:
  18C4'   CD 0000*              	CALL	CUROFF
  18C7'   E5                    	PUSH	H
  18C8'   CD 0977'              	CALL	FNBLNK
  18CB'   CD 0000*              	CALL	CUROFF
  18CE'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  18CF'   CD 0000*              	CALL	CMP16
  18D2'   D2 0000*              	JNC	UNDHER
  18D5'   EB                    	XCHG
  18D6'   CD 0000*              	CALL	GOTO
  18D9'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  18DC'                         OPALSP:
  18DC'   2A 0000*              	LHLD	OPSTA
  18DF'   EB                    	XCHG
  18E0'   2A 0000*              	LHLD	OPEND2
  18E3'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  18E6'   DA 18F6'              	JC	OPAL_F
  18E9'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  18EC'   EB                    	XCHG
  18ED'   22 0000*              	SHLD	OPHI		; hi-src = start
  18F0'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  18F3'   C3 1900'              	JMP	OPAL_R
  18F6'                         OPAL_F:
  18F6'   EB                    	XCHG			; HL = start
  18F7'   22 0000*              	SHLD	OPLO		; lo-src = start
  18FA'   2A 0000*              	LHLD	OPEND2
  18FD'   22 0000*              	SHLD	OPHI		; hi-src = end
  1900'                         OPAL_R:
  1900'   2A 0000*              	LHLD	OPLO
  1903'   CD 0697'              	CALL	BOL
  1906'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  1909'   2A 0000*              	LHLD	OPHI
  190C'   CD 072E'              	CALL	NLSTART
  190F'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  1912'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1913'                         OPALIN:
  1913'   CD 18DC'              	CALL	OPALSP
  1916'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1919'   CD 072E'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  191C'   EB                    	XCHG			;   the column)
  191D'   2A 0000*              	LHLD	OPHI
  1920'   CD 0000*              	CALL	CMP16
  1923'   CC 18C4'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1926'                         OPDLIN:
  1926'   CD 189A'              	CALL	OPDSPN
  1929'   CD 0778'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  192C'   DA 193C'              	JC	OPDL_NB
  192F'   CD 0000*              	CALL	LOGLEN
  1932'   7C                    	MOV	A,H
  1933'   B5                    	ORA	L
  1934'   C8                    	RZ			; empty buffer
  1935'   2B                    	DCX	H
  1936'   CD 0697'              	CALL	BOL
  1939'   CD 0000*              	CALL	GOTO
  193C'                         OPDL_NB:
  193C'   C3 0977'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  193F'                         OPCTAB:
  193F'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1943'   62 00 42 00           
  1947'   68 00 6C 00           
  194B'   30 00 5E 00           
  194F'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1951'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1955'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1959'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  195D'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1961'   24 01                 
  1963'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1967'   47 02 48 02           
  196B'   4D 02 4C 02           
  196F'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1971'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1973'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1974'                         VCB_C:
  1974'   CD 1980'              	CALL	VCB_CD
  1977'   C3 1A82'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  197A'                         VCB_D:
  197A'   CD 1980'              	CALL	VCB_CD
  197D'   C3 1A11'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1980'                         VCB_CD:
  1980'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1983'   22 0000*              	SHLD	OPLO
  1986'   22 0000*              	SHLD	OPSTA
  1989'   CD 0000*              	CALL	CUROFF
  198C'   CD 1A00'              	CALL	CEND		; to the line's content end, the CR,LF left
  198F'   22 0000*              	SHLD	OPHI
  1992'   C3 189A'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1995'                         VC_X:
  1995'   CD 0A29'              	CALL	GLSTAL
  1998'   CD 0877'              	CALL	SETLIN
  199B'   CD 079C'              	CALL	GETCNT
  199E'   22 0000*              	SHLD	CNTV
  19A1'   CD 0000*              	CALL	CUROFF
  19A4'   22 0000*              	SHLD	WKI		; cur
  19A7'   CD 1A00'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  19AA'   EB                    	XCHG			; DE = contentend
  19AB'   2A 0000*              	LHLD	WKI		; HL = cur
  19AE'   EB                    	XCHG			; HL = contentend, DE = cur
  19AF'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19B2'   7C                    	MOV	A,H
  19B3'   B5                    	ORA	L
  19B4'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  19B5'   EB                    	XCHG			; DE = available
  19B6'   2A 0000*              	LHLD	CNTV		; HL = count
  19B9'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  19BC'   DA 19C2'              	JC	VX_USEA
  19BF'   C3 19C3'              	JMP	VX_DEL		; count <= available -> HL = count = del
  19C2'                         VX_USEA:
  19C2'   EB                    	XCHG			; HL = available
  19C3'                         VX_DEL:
  19C3'   CD 19CF'              	CALL	DCHQ
  19C6'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  19C9'   CD 0177'              	CALL	MARKMOD
  19CC'   C3 1A11'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  19CF'                         DCHQ:
  19CF'   E5                    	PUSH	H
  19D0'   CD 08B4'              	CALL	TAILTAB
  19D3'   E1                    	POP	H
  19D4'   47                    	MOV	B,A
  19D5'   7C                    	MOV	A,H		; (more of them than a byte counts)
  19D6'   B7                    	ORA	A
  19D7'   C0                    	RNZ
  19D8'   B5                    	ORA	L
  19D9'   C8                    	RZ			; (or none at all)
  19DA'   32 31EE'              	STA	DCHN
  19DD'   78                    	MOV	A,B
  19DE'   87                    	ADD	A
  19DF'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  19E2'   CA 19FA'              	JZ	DQ_0
  19E5'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  19E6'   FE 08                 	CPI	8
  19E8'   D0                    	RNC
  19E9'   E5                    	PUSH	H
  19EA'   2A 0000*              	LHLD	WKI
  19ED'   EB                    	XCHG
  19EE'   2A 0000*              	LHLD	TTI
  19F1'   CD 0000*              	CALL	SUBHD
  19F4'   EB                    	XCHG			; DE = the chars before it
  19F5'   E1                    	POP	H
  19F6'   CD 0000*              	CALL	CMP16
  19F9'   D8                    	RC
  19FA'                         DQ_0:
  19FA'   3E 07                 	MVI	A,R_DCH
  19FC'   32 0000*              	STA	RINTENT
  19FF'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1A00'                         CEND:
  1A00'   CD 06DA'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1A03'   7C                    	MOV	A,H
  1A04'   B5                    	ORA	L
  1A05'   C8                    	RZ			; the start of the text: nothing before it
  1A06'   2B                    	DCX	H
  1A07'   E5                    	PUSH	H
  1A08'   CD 0000*              	CALL	CHARAT
  1A0B'   E1                    	POP	H		; HL = term-1
  1A0C'   FE 0D                 	CPI	CR
  1A0E'   C8                    	RZ			; a CR before the LF -> the content ends there
  1A0F'   23                    	INX	H
  1A10'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1A11'                         CLAMPE:
  1A11'   CD 0000*              	CALL	CUROFF
  1A14'   E5                    	PUSH	H
  1A15'   CD 073D'              	CALL	EOLC
  1A18'   D1                    	POP	D		; DE = cur
  1A19'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1A1C'   D8                    	RC
  1A1D'   C8                    	RZ
  1A1E'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1A21'                         VC_I:
  1A21'   CD 079C'              	CALL	GETCNT
  1A24'   C3 1A7F'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1A27'                         VC_A:
  1A27'   CD 079C'              	CALL	GETCNT
  1A2A'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A2D'   CA 1A44'              	JZ	VA_INS
  1A30'   EB                    	XCHG			; HL = cur
  1A31'   E5                    	PUSH	H
  1A32'   CD 0000*              	CALL	CHARAT
  1A35'   E1                    	POP	H
  1A36'   FE 0A                 	CPI	LF
  1A38'   CA 1A44'              	JZ	VA_INS		; on the line terminator -> append in place
  1A3B'   FE 0D                 	CPI	CR
  1A3D'   CA 1A44'              	JZ	VA_INS
  1A40'   23                    	INX	H
  1A41'   CD 0000*              	CALL	GOTO
  1A44'                         VA_INS:
  1A44'   C3 1A7F'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A47'                         VCB_A:
  1A47'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A4A'   CD 073D'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A4D'   E5                    	PUSH	H
  1A4E'   CD 0000*              	CALL	CHARAT
  1A51'   E1                    	POP	H
  1A52'   FE 0D                 	CPI	CR
  1A54'   CA 1A5D'              	JZ	VBA_IN		; an empty line: insert at its start
  1A57'   FE 0A                 	CPI	LF
  1A59'   CA 1A5D'              	JZ	VBA_IN
  1A5C'   23                    	INX	H		; past the last content char
  1A5D'                         VBA_IN:
  1A5D'   CD 0000*              	CALL	GOTO
  1A60'   C3 1A7F'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A63'                         VCB_I:
  1A63'   CD 079C'              	CALL	GETCNT
  1A66'   CD 0977'              	CALL	FNBLNK
  1A69'   CD 0000*              	CALL	CUROFF
  1A6C'   E5                    	PUSH	H
  1A6D'   CD 0000*              	CALL	CHARAT
  1A70'   E1                    	POP	H
  1A71'   FE 20                 	CPI	' '
  1A73'   CA 1A7B'              	JZ	VBI_SK
  1A76'   FE 09                 	CPI	TAB
  1A78'   C2 1A7F'              	JNZ	SETINM
  1A7B'                         VBI_SK:
  1A7B'   23                    	INX	H		; blanks only: past the last of them
  1A7C'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1A7F'                         SETINM:
  1A7F'   CD 0871'              	CALL	SETMOV
  1A82'                         SETINS:
  1A82'   3E 01                 	MVI	A,EM_INS
  1A84'   32 0000*              	STA	EDMODE
  1A87'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1A88'                         ATCEND:
  1A88'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A8B'   C8                    	RZ
  1A8C'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1A8F'   FE 0D                 	CPI	CR
  1A91'   C8                    	RZ
  1A92'   FE 0A                 	CPI	LF
  1A94'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1A95'                         OPNBRK:
  1A95'   CD 240B'              	CALL	PUTBRK
  1A98'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1A9B'   23                    	INX	H
  1A9C'   22 0000*              	SHLD	LNDLT
  1A9F'   C3 0177'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1AA2'                         ENDBRK:
  1AA2'   CD 0778'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1AA5'   C0                    	RNZ
  1AA6'   CD 1A95'              	CALL	OPNBRK
  1AA9'   CD 0000*              	CALL	CUROFF
  1AAC'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1AAD'   2B                    	DCX	H		;   line, with its own terminator after it
  1AAE'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1AB1'                         VC_O:
  1AB1'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AB4'   CD 1A00'              	CALL	CEND
  1AB7'   CD 0000*              	CALL	GOTO
  1ABA'   CD 1A95'              	CALL	OPNBRK
  1ABD'   CD 1AA2'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1AC0'   CD 0899'              	CALL	SETILN		;   needs a terminator of its own to exist
  1AC3'   C3 1A82'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AC6'                         VCB_O:
  1AC6'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AC9'   CD 0697'              	CALL	BOL
  1ACC'   CD 0000*              	CALL	GOTO
  1ACF'   CD 1A95'              	CALL	OPNBRK
  1AD2'   CD 0000*              	CALL	CUROFF
  1AD5'   2B                    	DCX	H
  1AD6'   2B                    	DCX	H
  1AD7'   CD 0000*              	CALL	GOTO
  1ADA'   CD 0899'              	CALL	SETILN
  1ADD'   C3 1A82'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1AE0'                         VCB_J:
  1AE0'   CD 078F'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AE3'   CD 1A00'              	CALL	CEND		; the join point: this line's content end
  1AE6'   22 0000*              	SHLD	OPLO
  1AE9'   CD 0000*              	CALL	CUROFF
  1AEC'   CD 072E'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1AEF'   E5                    	PUSH	H
  1AF0'   CD 0000*              	CALL	LOGLEN
  1AF3'   D1                    	POP	D		; DE = that start
  1AF4'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1AF7'   CA 0871'              	JZ	SETMOV
  1AFA'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1AFB'                         VJ_WS:
  1AFB'   E5                    	PUSH	H
  1AFC'   CD 0000*              	CALL	LOGLEN
  1AFF'   D1                    	POP	D		; DE = the scan
  1B00'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1B03'   CA 1B1A'              	JZ	VJ_DEL
  1B06'   EB                    	XCHG			; HL = the scan
  1B07'   E5                    	PUSH	H
  1B08'   CD 0000*              	CALL	CHARAT
  1B0B'   E1                    	POP	H
  1B0C'   FE 20                 	CPI	' '
  1B0E'   CA 1B16'              	JZ	VJ_SKIP
  1B11'   FE 09                 	CPI	TAB
  1B13'   C2 1B1A'              	JNZ	VJ_DEL
  1B16'                         VJ_SKIP:
  1B16'   23                    	INX	H
  1B17'   C3 1AFB'              	JMP	VJ_WS
  1B1A'                         VJ_DEL:
  1B1A'   22 0000*              	SHLD	OPHI
  1B1D'   CD 189A'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1B20'   CD 08A8'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1B23'   CD 0778'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B26'   CA 1A11'              	JZ	CLAMPE
  1B29'   CD 0783'              	CALL	CURCHR		; the first char of what was appended
  1B2C'   FE 0D                 	CPI	CR
  1B2E'   CA 1A11'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1B31'   FE 0A                 	CPI	LF
  1B33'   CA 1A11'              	JZ	CLAMPE
  1B36'   FE 29                 	CPI	')'
  1B38'   CA 1A11'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B3B'   CD 0000*              	CALL	CUROFF
  1B3E'   7C                    	MOV	A,H
  1B3F'   B5                    	ORA	L
  1B40'   CA 1B56'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B43'   2B                    	DCX	H
  1B44'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B47'   FE 20                 	CPI	' '
  1B49'   CA 1A11'              	JZ	CLAMPE
  1B4C'   FE 09                 	CPI	TAB
  1B4E'   CA 1A11'              	JZ	CLAMPE
  1B51'   FE 0A                 	CPI	LF
  1B53'   CA 1A11'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B56'                         VJ_SP:
  1B56'   3E 20                 	MVI	A,' '
  1B58'   CD 0000*              	CALL	PUTGAP
  1B5B'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B5E'   2B                    	DCX	H
  1B5F'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B62'                         VC_TILD:
  1B62'   CD 079C'              	CALL	GETCNT
  1B65'   CD 0877'              	CALL	SETLIN		; only this row changes
  1B68'   CD 0A29'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B6B'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B6E'   CA 0871'              	JZ	SETMOV
  1B71'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1B74'   FE 0D                 	CPI	CR
  1B76'   CA 0871'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B79'   FE 0A                 	CPI	LF
  1B7B'   CA 0871'              	JZ	SETMOV
  1B7E'   47                    	MOV	B,A
  1B7F'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1B81'   FE 41                 	CPI	'A'
  1B83'   DA 1B8F'              	JC	VT_PUT		; below 'A': no case
  1B86'   FE 5B                 	CPI	'Z'+1
  1B88'   D2 1B8F'              	JNC	VT_PUT		; above 'Z': no case
  1B8B'   78                    	MOV	A,B
  1B8C'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1B8E'   47                    	MOV	B,A
  1B8F'                         VT_PUT:
  1B8F'   78                    	MOV	A,B
  1B90'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1B93'   CD 0177'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1B96'   21 0001               	LXI	H,1
  1B99'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B9C'   3A 0000*              	LDA	VRCH
  1B9F'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1BA2'   C3 1A11'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1BA5'                         VC_R:
  1BA5'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  1BA8'   3E 03                 	MVI	A,PR
  1BAA'   32 0000*              	STA	GPEND
  1BAD'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1BAE'                         VR_DO:
  1BAE'   AF                    	XRA	A
  1BAF'   32 0000*              	STA	GPEND
  1BB2'   79                    	MOV	A,C
  1BB3'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1BB6'   CD 0877'              	CALL	SETLIN		; only this row changed
  1BB9'   CD 0A29'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1BBC'   CD 0778'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1BBF'   CA 0871'              	JZ	SETMOV		; the end of the text: vim does nothing
  1BC2'   CD 0783'              	CALL	CURCHR		; A = the char under the cursor
  1BC5'   FE 0D                 	CPI	CR
  1BC7'   CA 0871'              	JZ	SETMOV		; the line's end: nothing to replace
  1BCA'   FE 0A                 	CPI	LF
  1BCC'   CA 0871'              	JZ	SETMOV
  1BCF'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1BD1'   CD 087D'              	CALL	SETCEL
  1BD4'   CD 0177'              	CALL	MARKMOD
  1BD7'   21 0001               	LXI	H,1
  1BDA'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1BDD'   3A 0000*              	LDA	VRCH
  1BE0'   FE 0D                 	CPI	CR
  1BE2'   CA 1BEF'              	JZ	VR_CR
  1BE5'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1BE8'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1BEB'   2B                    	DCX	H		;   out, which moves every logical offset
  1BEC'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1BEF'                         VR_CR:
  1BEF'   CD 1A95'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1BF2'   CD 1AA2'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1BF5'   CD 0899'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1BF8'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1BFA'   32 0000*              	STA	ILABOV
  1BFD'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1BFE'                         VCB_R:
  1BFE'   CD 079C'              	CALL	GETCNT
  1C01'   CD 0871'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1C04'   21 0000               	LXI	H,0
  1C07'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1C0A'   22 0000*              	SHLD	RPAPP
  1C0D'   3E 02                 	MVI	A,EM_REP
  1C0F'   32 0000*              	STA	EDMODE
  1C12'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1C13'                         VC_D:
  1C13'   3E 64                 	MVI	A,'d'
  1C15'   32 0000*              	STA	PENDOP
  1C18'   C3 0871'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1C1B'                         VC_C:
  1C1B'   3E 63                 	MVI	A,'c'
  1C1D'   32 0000*              	STA	PENDOP
  1C20'   C3 0871'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1C23'                         VD_DD:
  1C23'   CD 0A29'              	CALL	GLSTAL
  1C26'   CD 079C'              	CALL	GETCNT
  1C29'   22 0000*              	SHLD	CNTV
  1C2C'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1C2E'   32 0000*              	STA	DDSNG
  1C31'   2B                    	DCX	H
  1C32'   7C                    	MOV	A,H
  1C33'   B5                    	ORA	L
  1C34'   C2 1C42'              	JNZ	VDD_LS
  1C37'   3E 01                 	MVI	A,1
  1C39'   32 0000*              	STA	DDSNG
  1C3C'   CD 18C4'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C3F'   C3 1C48'              	JMP	VDD_GO
  1C42'                         VDD_LS:
  1C42'   CD 09E2'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C45'   DA 0871'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C48'                         VDD_GO:
  1C48'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C4B'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C4E'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C51'   CD 266E'              	CALL	COPY12		;   every mark in the lines has closed up by then
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C54'   CD 0953'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C57'   2A 0000*              	LHLD	CNTV
  1C5A'   CD 0000*              	CALL	SETC0
  1C5D'                         VDD_FW:
  1C5D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C60'   DA 1DAE'              	JC	QREFUS		; ... which has no room for them
  1C63'   CD 07B1'              	CALL	CNTTST
  1C66'   C2 1C5D'              	JNZ	VDD_FW
  1C69'   CD 0177'              	CALL	MARKMOD
  1C6C'   CD 0BFA'              	CALL	ATEOF
  1C6F'   D2 1C8A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C72'   3E 00                 	MVI	A,0
  1C74'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1C77'   CD 12DA'              	CALL	ONFST
  1C7A'   CA 0977'              	JZ	FNBLNK		; nothing left before it
  1C7D'   21 0001               	LXI	H,1		; onto the new last line
  1C80'   CD 0000*              	CALL	SETBWD
  1C83'   2A 0000*              	LHLD	LNDLT
  1C86'   2B                    	DCX	H
  1C87'   22 0000*              	SHLD	LNDLT
  1C8A'                         VDD_UP:
  1C8A'   CD 0977'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1C8D'   3A 0000*              	LDA	DDSNG
  1C90'   B7                    	ORA	A
  1C91'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1C92'   3E 03                 	MVI	A,R_DLIN
  1C94'   32 0000*              	STA	RINTENT
  1C97'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1C98'                         QEMPTY:
  1C98'   2A 0000*              	LHLD	QBEG
  1C9B'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1C9C'   2A 0000*              	LHLD	QEND
  1C9F'   7C                    	MOV	A,H
  1CA0'   BA                    	CMP	D
  1CA1'   C0                    	RNZ
  1CA2'   7D                    	MOV	A,L
  1CA3'   BB                    	CMP	E
  1CA4'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1CA5'                         VC_Y:
  1CA5'   3E 79                 	MVI	A,'y'
  1CA7'   32 0000*              	STA	PENDOP
  1CAA'   C3 0871'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1CAD'                         VY_YY:
  1CAD'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1CB0'   CD 0448'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1CB3'   CD 0000*              	CALL	CUROFF
  1CB6'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1CB9'   CD 0697'              	CALL	BOL
  1CBC'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CBF'   CD 1E5B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CC2'   CD 1E9E'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1CC5'   D2 1E62'              	JNC	YNDONE
  1CC8'   21 1C23'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1CCB'   C3 1CF7'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1CCE'                         OPYANK:
  1CCE'   CD 18DC'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1CD1'   2A 0000*              	LHLD	OPSTA
  1CD4'   EB                    	XCHG			; DE = start
  1CD5'   2A 0000*              	LHLD	OPEND2		; HL = end
  1CD8'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1CDB'   D2 1CDF'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1CDE'   EB                    	XCHG			; ... otherwise the start is
  1CDF'                         OPY_LO:
  1CDF'   22 0000*              	SHLD	YOFF
  1CE2'   2A 0000*              	LHLD	OPLO
  1CE5'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CE8'   CD 1E5B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CEB'   CD 1F16'              	CALL	YNSPAN		; copied where they lie, if there is room
  1CEE'   D2 1E62'              	JNC	YNDONE
  1CF1'   21 1E26'              	LXI	H,YSPAN
  1CF4'   C3 1CF7'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1CF7'                         YKGO:
  1CF7'   22 0000*              	SHLD	YACT
  1CFA'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1CFD'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1CFE'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1D01'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1D04'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1D07'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1D0A'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1D0B'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1D0E'   EB                    	XCHG			;   window as it was, then names other text
  1D0F'   E1                    	POP	H
  1D10'   CD 0000*              	CALL	SUBHD
  1D13'   EB                    	XCHG			; DE = how far behind the cursor they start
  1D14'   CD 13BC'              	CALL	CURFP
  1D17'   06 00                 	MVI	B,0
  1D19'   CD 13B2'              	CALL	SUB24
  1D1C'   22 0000*              	SHLD	YPFP
  1D1F'   32 0002*              	STA	YPFP+2
  1D22'   3A 0000*              	LDA	MODF
  1D25'   32 0000*              	STA	YMODF
  1D28'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1D2B'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1D2E'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1D31'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D34'   3E 01                 	MVI	A,1
  1D36'   32 0000*              	STA	UNDRPL
  1D39'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D3C'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D3F'   22 0000*              	SHLD	YLDLT
  1D42'   CD 0000*              	CALL	LOGLEN
  1D45'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D48'   2A 0000*              	LHLD	YACT
  1D4B'   CD 1DAD'              	CALL	YCALL		; the lines out of the file, into the register
  1D4E'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D51'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D53'   CA 1D91'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D56'   CD 0000*              	CALL	LOGLEN
  1D59'   EB                    	XCHG
  1D5A'   2A 0000*              	LHLD	YWAS
  1D5D'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D60'   CA 1D72'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                				;   vim refuses it too, register untouched.
  1D63'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D66'   CD 03FB'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D69'   CD 03AC'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D6C'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D6F'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D72'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D72'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D75'   EB                    	XCHG
  1D76'   2A 0000*              	LHLD	YCOL
  1D79'   19                    	DAD	D
  1D7A'   22 0000*              	SHLD	MKPOS
  1D7D'   3A 0002*              	LDA	YPFP+2
  1D80'   CE 00                 	ACI	0
  1D82'   32 0002*              	STA	MKPOS+2
  1D85'   CD 03AC'              	CALL	MKPAGE
  1D88'   CD 0000*              	CALL	GOTO
  1D8B'                         YK_RST:
  1D8B'   2A 0000*              	LHLD	YLDLT
  1D8E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1D91'                         YK_RF:
  1D91'   3A 0000*              	LDA	YMODF
  1D94'   32 0000*              	STA	MODF
  1D97'   3A 0000*              	LDA	YDCHG
  1D9A'   32 0000*              	STA	DOTCHG
  1D9D'   3A 0000*              	LDA	YURPL
  1DA0'   32 0000*              	STA	UNDRPL
  1DA3'   AF                    	XRA	A
  1DA4'   32 0000*              	STA	MKHOLD
  1DA7'   CD 0A29'              	CALL	GLSTAL
  1DAA'   C3 08AE'              	JMP	SETFUL		; the cheap paint cannot carry this
  1DAD'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1DAE'                         QREFUS:
  1DAE'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1DB1'   CD 1C98'              	CALL	QEMPTY
  1DB4'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1DB7'   CD 0000*              	CALL	QKILL
  1DBA'   3A 0000*              	LDA	MKHOLD
  1DBD'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DBE'   C2 1DCD'              	JNZ	QRF_Y
  1DC1'   21 0000*              	LXI	H,MKSAV
  1DC4'   11 0000*              	LXI	D,MKTAB
  1DC7'   CD 266E'              	CALL	COPY12
  1DCA'   CD 0000*              	CALL	UNDCLR
  1DCD'                         QRF_Y:
  1DCD'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1DCF'   32 0000*              	STA	MSGWHT
  1DD2'   C3 16DB'              	JMP	OPG_HM
                                
                                ;MEMABT -- the arena has no room for what this key asked of it: WordMaster's
                                ; 'MEM SHORTAGE', 'MEM FULL' or 'QBUF FULL', which BUF.MAC's MEMERR sends here
                                ; once the screen is up (issue #39).  WordMaster abandons the command there and
                                ; goes back to its prompt, and so does this: the key's stack goes, and with it
                                ; whatever the key was part way through.  Each of those errors is raised before
                                ; a byte of text moves, so the text is whole, though not all of the change may
                                ; have been made.  The register is emptied -- it is what holds the room -- or
                                ; the repaint that follows would run into the same wall, and the half-done
                                ; command leaves nothing behind: no count, no pending operator, no '.' to repeat
                                ; it and no 'u' to undo half of it.  The bottom row says so.
                                ;
                                ; Two cases still end the editor, through ERRMSG as all three always did: a
                                ; second shortage before the next key (the repaint, with the register already
                                ; given back -- there is nothing left to give), and one in the middle of a yank
                                ; that took its lines OUT to put them back (YKGO, MKHOLD set): the register IS
                                ; those lines then, and emptying it would cut them from the file.
  1DD5'                         MEMABT:
  1DD5'   3A 0000*              	LDA	ABTFLG
  1DD8'   21 0000*              	LXI	H,MKHOLD
  1DDB'   B6                    	ORA	M
  1DDC'   C2 0000*              	JNZ	ERRMSG		; the message is still on the stack for it
  1DDF'   3C                    	INR	A		; A = 1
  1DE0'   32 0000*              	STA	ABTFLG		; ... until the next key (CMDDIS)
  1DE3'   31 0000*              	LXI	SP,VISTK	; the key's stack: VI.MAC's loop runs at the top
  1DE6'   32 0000*              	STA	MODF		; the text may have changed part way
  1DE9'   32 0000*              	STA	FORCEF		; the frame on the screen may be half drawn
  1DEC'   32 0000*              	STA	DOTOVF		; a half command is no change for '.'
  1DEF'   3A 0000*              	LDA	EDMODE		; in insert or replace mode the recording runs
  1DF2'   B7                    	ORA	A		;   on to the ESC, DOTOVF keeping it from '.';
  1DF3'   C2 1DFD'              	JNZ	MAB_1		;   otherwise the next key starts a new one
  1DF6'   32 0000*              	STA	DOTCHG
  1DF9'   3C                    	INR	A
  1DFA'   32 31F1'              	STA	DOTSTA
  1DFD'                         MAB_1:
  1DFD'   AF                    	XRA	A
  1DFE'   32 0000*              	STA	GPEND
  1E01'   32 0000*              	STA	PENDOP
  1E04'   32 0000*              	STA	DOTRPL		; a '.' replay is over
  1E07'   32 0000*              	STA	UNDRPL		; ... and so is a 'u' one
  1E0A'   32 0000*              	STA	BRKARM
  1E0D'   32 0000*              	STA	BRKHIT
  1E10'   CD 0000*              	CALL	CLRCNT		; no count
  1E13'   CD 0000*              	CALL	UNDCLR		; nothing 'u' can trust
  1E16'   CD 0000*              	CALL	QKILL		; the room back
  1E19'   3E 05                 	MVI	A,MW_MEM
  1E1B'   32 0000*              	STA	MSGWHT
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E1E'   3E 00                 	MVI	A,R_FULL
  1E20'   32 0000*              	STA	RINTENT
  1E23'   C3 0000*              	JMP	MLDRAW		; VI.MAC: the repaint, then the next key
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1E26'                         YSPAN:
  1E26'   CD 0A29'              	CALL	GLSTAL
  1E29'   CD 188F'              	CALL	OPSPNL		; HL = the span's length
  1E2C'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1E2F'   2A 0000*              	LHLD	OPLO
  1E32'   CD 0000*              	CALL	GOTO
  1E35'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E38'                         YS_LP:
  1E38'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1E3B'   CD 0000*              	CALL	SETC0
  1E3E'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1E41'   DA 1DAE'              	JC	QREFUS		; ... which has no room for it
  1E44'   2A 0000*              	LHLD	QBEG
  1E47'   EB                    	XCHG
  1E48'   2A 0000*              	LHLD	QEND
  1E4B'   CD 0000*              	CALL	SUBHD
  1E4E'   EB                    	XCHG			; DE = what the register holds
  1E4F'   2A 0000*              	LHLD	YTGT
  1E52'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1E55'   DA 1E38'              	JC	YS_LP		;   (never more than the span over whole lines)
  1E58'   C3 0177'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1E5B'                         YNPRE:
  1E5B'   2A 0000*              	LHLD	PGTOPM
  1E5E'   22 0000*              	SHLD	YNPG
  1E61'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1E62'                         YNDONE:
  1E62'   2A 0000*              	LHLD	YOFF
  1E65'   CD 0000*              	CALL	GOTO
  1E68'   2A 0000*              	LHLD	PGTOPM
  1E6B'   EB                    	XCHG
  1E6C'   2A 0000*              	LHLD	YNPG
  1E6F'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1E72'   C2 08AE'              	JNZ	SETFUL		; it moved under us: repaint after all
  1E75'   C3 0871'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1E78'                         YNROOM:
  1E78'   11 0100               	LXI	D,100H
  1E7B'   19                    	DAD	D
  1E7C'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1E7D'   E5                    	PUSH	H		; the span plus its slack
  1E7E'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1E81'   EB                    	XCHG			; HL = free
  1E82'   D1                    	POP	D		; DE = the span plus its slack
  1E83'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1E86'   DA 1E8E'              	JC	YNR_OK
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E89'   CA 1E8E'              	JZ	YNR_OK
  1E8C'   37                    	STC			; not enough: the delete-and-put-back path
  1E8D'   C9                    	RET
  1E8E'                         YNR_OK:
  1E8E'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1E8F'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1E90'                         YNGO:
  1E90'   C5                    	PUSH	B
  1E91'   CD 079C'              	CALL	GETCNT		; spent here: this yank is happening
  1E94'   CD 0A29'              	CALL	GLSTAL
  1E97'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E9A'   C1                    	POP	B
  1E9B'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1E9E'                         YNCOPY:
  1E9E'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1EA1'   7C                    	MOV	A,H		;   the count itself
  1EA2'   B5                    	ORA	L
  1EA3'   C2 1EA9'              	JNZ	YNC_HV
  1EA6'   21 0001               	LXI	H,1
  1EA9'                         YNC_HV:
  1EA9'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1EAA'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1EAB'   B4                    	ORA	H
  1EAC'   CA 1EB7'              	JZ	YNC_M
  1EAF'   E5                    	PUSH	H
  1EB0'   CD 09E2'              	CALL	ONLAST		; vim: a count over one on the last line does
  1EB3'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1EB4'   DA 1EC9'              	JC	YNC_RF
  1EB7'                         YNC_M:
  1EB7'   E5                    	PUSH	H
  1EB8'   CD 0953'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1EBB'   E1                    	POP	H
  1EBC'   CD 1ED1'              	CALL	YNLINE		; BC = the span, measured where it stands
  1EBF'   D8                    	RC			; not measurable here: let the pager answer it
  1EC0'   60                    	MOV	H,B
  1EC1'   69                    	MOV	L,C
  1EC2'   CD 1E78'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1EC5'   D8                    	RC			; no: the delete-and-put-back path
  1EC6'   C3 1E90'              	JMP	YNGO
  1EC9'                         YNC_RF:
  1EC9'   CD 079C'              	CALL	GETCNT		; refused: vim does nothing and leaves the
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1ECC'   CD 0A29'              	CALL	GLSTAL		;   register alone, and that is the command
  1ECF'   B7                    	ORA	A		; NC: done
  1ED0'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1ED1'                         YNLINE:
  1ED1'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1ED4'   2A 0000*              	LHLD	GAPEND
  1ED7'                         YNL_LP:
  1ED7'   EB                    	XCHG			; DE = the scan
  1ED8'   2A 0000*              	LHLD	TXTEND
  1EDB'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1EDE'   EB                    	XCHG			; HL = the scan
  1EDF'   D2 1EFF'              	JNC	YNL_EN		; the resident text ran out
  1EE2'   7E                    	MOV	A,M
  1EE3'   23                    	INX	H
  1EE4'   FE 0A                 	CPI	LF
  1EE6'   C2 1ED7'              	JNZ	YNL_LP
  1EE9'   E5                    	PUSH	H
  1EEA'   2A 0000*              	LHLD	YNCNT
  1EED'   2B                    	DCX	H
  1EEE'   22 0000*              	SHLD	YNCNT
  1EF1'   7C                    	MOV	A,H
  1EF2'   B5                    	ORA	L
  1EF3'   E1                    	POP	H
  1EF4'   C2 1ED7'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1EF7'   EB                    	XCHG			; DE = past the last of them
  1EF8'   2A 0000*              	LHLD	GAPEND
  1EFB'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1EFC'   C3 1F0D'              	JMP	YNL_BC
  1EFF'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1EFF'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1F02'   C2 1F14'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1F05'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1F08'   EB                    	XCHG			;   count clamps to it as vim's does
  1F09'   2A 0000*              	LHLD	GAPEND
  1F0C'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1F0D'                         YNL_BC:
  1F0D'   CD 0000*              	CALL	SUBHD		; HL = the span
  1F10'   44                    	MOV	B,H
  1F11'   4D                    	MOV	C,L
  1F12'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1F13'   C9                    	RET
  1F14'                         YNL_NO:
  1F14'   37                    	STC
  1F15'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1F16'                         YNSPAN:
  1F16'   CD 188F'              	CALL	OPSPNL		; HL = the span's length
  1F19'   44                    	MOV	B,H
  1F1A'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1F1B'   CD 1E78'              	CALL	YNROOM
  1F1E'   D8                    	RC			; no room: the delete-and-put-back path
  1F1F'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1F20'   2A 0000*              	LHLD	OPLO
  1F23'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1F26'   C1                    	POP	B
  1F27'   C3 1E90'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1F2A'                         VC_P:
  1F2A'   CD 1C98'              	CALL	QEMPTY
  1F2D'   CA 2000'              	JZ	VP_BEL
  1F30'   CD 079C'              	CALL	GETCNT
  1F33'   22 0000*              	SHLD	PCNT
  1F36'   CD 0000*              	CALL	CUROFF
  1F39'   CD 072E'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1F3C'   C3 1F51'              	JMP	VP_GO
  1F3F'                         VCB_P:
  1F3F'   CD 1C98'              	CALL	QEMPTY
  1F42'   CA 2000'              	JZ	VP_BEL
  1F45'   CD 079C'              	CALL	GETCNT
  1F48'   22 0000*              	SHLD	PCNT
  1F4B'   CD 0000*              	CALL	CUROFF
  1F4E'   CD 0697'              	CALL	BOL
  1F51'                         VP_GO:
  1F51'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1F54'   CD 0000*              	CALL	CUROFF
  1F57'   EB                    	XCHG
  1F58'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1F5B'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1F5E'   DA 1F73'              	JC	VP_IN
  1F61'   EB                    	XCHG			; HL = the put point = LOGLEN
  1F62'   7C                    	MOV	A,H
  1F63'   B5                    	ORA	L
  1F64'   CA 1F70'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1F67'   2B                    	DCX	H
  1F68'   CD 0000*              	CALL	CHARAT
  1F6B'   FE 0A                 	CPI	LF
  1F6D'   CA 1F73'              	JZ	VP_IN
  1F70'                         VP_BRK:
  1F70'   CD 1A95'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1F73'                         VP_IN:
  1F73'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1F76'   CD 0448'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1F79'   CD 1405'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1F7C'   2A 0000*              	LHLD	QBEG
  1F7F'   EB                    	XCHG
  1F80'   2A 0000*              	LHLD	QEND
  1F83'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1F86'   EB                    	XCHG
  1F87'   22 0000*              	SHLD	PLFS
  1F8A'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1F8D'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1F8E'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1F8F'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1F91'   C2 1F95'              	JNZ	VP_PZ
  1F94'   7D                    	MOV	A,L
  1F95'                         VP_PZ:
  1F95'   32 0000*              	STA	PCPY
  1F98'                         VP_LP:
  1F98'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1F9B'   2A 0000*              	LHLD	LNDLT
  1F9E'   EB                    	XCHG
  1F9F'   2A 0000*              	LHLD	PLFS
  1FA2'   19                    	DAD	D
  1FA3'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1FA6'   2A 0000*              	LHLD	PCNT
  1FA9'   2B                    	DCX	H
  1FAA'   22 0000*              	SHLD	PCNT
  1FAD'   7C                    	MOV	A,H
  1FAE'   B5                    	ORA	L
  1FAF'   C2 1F98'              	JNZ	VP_LP
  1FB2'   CD 0177'              	CALL	MARKMOD
  1FB5'   21 0000*              	LXI	H,PPFP
  1FB8'   CD 03FB'              	CALL	MKLOAD
  1FBB'   CD 0408'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1FBE'   D2 1FF1'              	JNC	VP_PGD
  1FC1'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1FC4'   CD 0A29'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1FC7'   3A 0000*              	LDA	PCPY
  1FCA'   B7                    	ORA	A
  1FCB'   CA 0977'              	JZ	FNBLNK
  1FCE'   2A 0000*              	LHLD	PLFS
  1FD1'   7C                    	MOV	A,H
  1FD2'   B7                    	ORA	A
  1FD3'   C2 0977'              	JNZ	FNBLNK
  1FD6'   3A 0000*              	LDA	PCPY
  1FD9'   CD 10A2'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1FDC'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  1FDD'   B7                    	ORA	A
  1FDE'   C2 0977'              	JNZ	FNBLNK
  1FE1'   7D                    	MOV	A,L
  1FE2'   B7                    	ORA	A
  1FE3'   CA 0977'              	JZ	FNBLNK
  1FE6'   F5                    	PUSH	PSW
  1FE7'   CD 0899'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1FEA'   F1                    	POP	PSW
  1FEB'   32 31ED'              	STA	ILN		; ... which the lines put now replace
  1FEE'   C3 0977'              	JMP	FNBLNK
  1FF1'                         VP_PGD:				; the put paged its first line out: page back
  1FF1'   CD 03AC'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1FF4'   CD 0000*              	CALL	GOTO
  1FF7'   CD 0A29'              	CALL	GLSTAL
  1FFA'   CD 141D'              	CALL	GPLACE
  1FFD'   C3 08AE'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  2000'                         VP_BEL:
  2000'   CD 079C'              	CALL	GETCNT		; the count is spent either way
  2003'   0E 07                 	MVI	C,BEL
  2005'   CD 0000*              	CALL	BCONOU
  2008'   C3 0871'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  200B'                         VIREP:
  200B'   79                    	MOV	A,C
  200C'   FE 1B                 	CPI	ESC
  200E'   CA 2161'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  2011'   FE 0D                 	CPI	CR
  2013'   CA 2086'              	JZ	VP_CR
  2016'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  2018'   CA 2086'              	JZ	VP_CR
  201B'   FE 08                 	CPI	BS
  201D'   CA 2092'              	JZ	VP_BS
  2020'   FE 7F                 	CPI	DEL
  2022'   CA 2092'              	JZ	VP_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2025'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  2028'   CD 0877'              	CALL	SETLIN		; this row changed
  202B'   CD 0177'              	CALL	MARKMOD
  202E'   CD 1A88'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  2031'   CA 2071'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  2034'   CD 0783'              	CALL	CURCHR
  2037'   06 01                 	MVI	B,1
  2039'   CD 087D'              	CALL	SETCEL
  203C'   3A 0000*              	LDA	VRCH
  203F'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  2042'   2A 0000*              	LHLD	RPDEL
  2045'   7C                    	MOV	A,H
  2046'   B5                    	ORA	L
  2047'   CA 205D'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  204A'   2A 0000*              	LHLD	GAPEND
  204D'   EB                    	XCHG
  204E'   2A 0000*              	LHLD	RPGE
  2051'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  2054'   CA 205D'              	JZ	VP_OVW
  2057'   21 0000               	LXI	H,0
  205A'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  205D'                         VP_OVW:
  205D'   21 0001               	LXI	H,1
  2060'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  2063'   2A 0000*              	LHLD	GAPEND
  2066'   22 0000*              	SHLD	RPGE
  2069'   2A 0000*              	LHLD	RPDEL
  206C'   23                    	INX	H
  206D'   22 0000*              	SHLD	RPDEL
  2070'   C9                    	RET
  2071'                         VP_APP:
  2071'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  2073'   06 01                 	MVI	B,1
  2075'   CD 087D'              	CALL	SETCEL
  2078'   3A 0000*              	LDA	VRCH
  207B'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  207E'   2A 0000*              	LHLD	RPAPP
  2081'   23                    	INX	H
  2082'   22 0000*              	SHLD	RPAPP
  2085'   C9                    	RET
  2086'                         VP_CR:
  2086'   21 0000               	LXI	H,0
  2089'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  208C'   22 0000*              	SHLD	RPAPP
  208F'   C3 211D'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  2092'                         VP_BS:
  2092'   2A 0000*              	LHLD	RPAPP
  2095'   7C                    	MOV	A,H
  2096'   B5                    	ORA	L
  2097'   CA 20A4'              	JZ	VP_BSD
  209A'   2B                    	DCX	H
  209B'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  209E'   CD 0877'              	CALL	SETLIN
  20A1'   C3 0000*              	JMP	DELPRV
  20A4'                         VP_BSD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20A4'   2A 0000*              	LHLD	RPDEL
  20A7'   7C                    	MOV	A,H
  20A8'   B5                    	ORA	L
  20A9'   CA 20D0'              	JZ	VP_BSM		; nothing of ours left
  20AC'   2A 0000*              	LHLD	GAPEND
  20AF'   EB                    	XCHG
  20B0'   2A 0000*              	LHLD	RPGE
  20B3'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  20B6'   C2 20D0'              	JNZ	VP_BSM
  20B9'   2A 0000*              	LHLD	RPDEL
  20BC'   2B                    	DCX	H
  20BD'   22 0000*              	SHLD	RPDEL
  20C0'   CD 0877'              	CALL	SETLIN
  20C3'   CD 0000*              	CALL	DELPRV		; the typed char goes
  20C6'   CD 0000*              	CALL	UNDELF		; the original comes back
  20C9'   2A 0000*              	LHLD	GAPEND
  20CC'   22 0000*              	SHLD	RPGE
  20CF'   C9                    	RET
  20D0'                         VP_BSM:
  20D0'   CD 0871'              	CALL	SETMOV		; nothing changed: back over the text as it is
  20D3'   C3 08FF'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  20D6'                         VIINS:
  20D6'   79                    	MOV	A,C
  20D7'   FE 1B                 	CPI	ESC
  20D9'   CA 2161'              	JZ	VI_ESC
  20DC'   FE 0D                 	CPI	CR
  20DE'   CA 211D'              	JZ	VI_CR
  20E1'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  20E3'   CA 211D'              	JZ	VI_CR
  20E6'   FE 08                 	CPI	BS
  20E8'   CA 2135'              	JZ	VI_BS
  20EB'   FE 7F                 	CPI	DEL
  20ED'   CA 2135'              	JZ	VI_BS
  20F0'   79                    	MOV	A,C
  20F1'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  20F4'   CD 0177'              	CALL	MARKMOD
  20F7'   CD 0877'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  20FA'   79                    	MOV	A,C
  20FB'   FE 20                 	CPI	' '
  20FD'   D8                    	RC			; control char -> keep R_LINE
  20FE'   FE 7F                 	CPI	DEL
  2100'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  2101'   CD 08B4'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  2104'   47                    	MOV	B,A
  2105'   3E 04                 	MVI	A,R_ICH
  2107'   32 0000*              	STA	RINTENT
  210A'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  210C'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  210D'   CA 2119'              	JZ	VI_ICH
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  2110'   CD 1A88'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  2113'   3E 00                 	MVI	A,0
  2115'   C2 2119'              	JNZ	VI_ICH
  2118'   3C                    	INR	A
  2119'                         VI_ICH:
  2119'   32 0000*              	STA	ICHAPP
  211C'   C9                    	RET
  211D'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  211D'   CD 1A88'              	CALL	ATCEND
  2120'   3E 00                 	MVI	A,0
  2122'   CA 2126'              	JZ	VI_CRS
  2125'   3C                    	INR	A
  2126'                         VI_CRS:
  2126'   F5                    	PUSH	PSW
  2127'   CD 1A95'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  212A'   CD 1AA2'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  212D'   CD 0899'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  2130'   F1                    	POP	PSW
  2131'   32 0000*              	STA	ILABOV
  2134'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  2135'                         VI_BS:
  2135'   CD 0000*              	CALL	PEEKL
  2138'   D8                    	RC			; start of the file: nothing to delete
  2139'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  213B'   CA 215B'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  213E'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  213F'   CD 0877'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  2142'   78                    	MOV	A,B
  2143'   CD 0892'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  2146'   D2 215B'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  2149'   CD 08B4'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  214C'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  214D'   3C                    	INR	A
  214E'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  2151'   3E 01                 	MVI	A,1
  2153'   32 31EE'              	STA	DCHN
  2156'   3E 07                 	MVI	A,R_DCH
  2158'   32 0000*              	STA	RINTENT
  215B'                         VI_BSJ:
  215B'   CD 0177'              	CALL	MARKMOD
  215E'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  2161'                         VI_ESC:
  2161'   3E 00                 	MVI	A,EM_CMD
  2163'   32 0000*              	STA	EDMODE
  2166'   CD 0871'              	CALL	SETMOV
  2169'   CD 08FF'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  216C'   C3 0A29'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  216F'                         RDLINE:
  216F'   EB                    	XCHG			; HL = buffer
  2170'   22 0000*              	SHLD	RLPTR
  2173'   3E 00                 	MVI	A,0
  2175'   32 0000*              	STA	RLLEN
  2178'   78                    	MOV	A,B
  2179'   32 0000*              	STA	RLMAX
  217C'   79                    	MOV	A,C
  217D'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  2180'                         RL_LP:
  2180'   CD 0000*              	CALL	GETKEY
  2183'   FE 1B                 	CPI	ESC
  2185'   CA 21D5'              	JZ	RL_CAN
  2188'   FE 0D                 	CPI	CR
  218A'   CA 21E0'              	JZ	RL_DONE
  218D'   FE 08                 	CPI	BS
  218F'   CA 21BD'              	JZ	RL_BS
  2192'   FE 7F                 	CPI	DEL
  2194'   CA 21BD'              	JZ	RL_BS
  2197'   FE 20                 	CPI	' '
  2199'   DA 2180'              	JC	RL_LP		; control char -> ignore
  219C'   3A 0000*              	LDA	RLLEN
  219F'   47                    	MOV	B,A
  21A0'   3A 0000*              	LDA	RLMAX
  21A3'   B8                    	CMP	B
  21A4'   CA 2180'              	JZ	RL_LP		; full -> ignore
  21A7'   2A 0000*              	LHLD	RLPTR
  21AA'   71                    	MOV	M,C
  21AB'   23                    	INX	H
  21AC'   22 0000*              	SHLD	RLPTR
  21AF'   3A 0000*              	LDA	RLLEN
  21B2'   3C                    	INR	A
  21B3'   32 0000*              	STA	RLLEN
  21B6'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21B7'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  21BA'   C3 2180'              	JMP	RL_LP
  21BD'                         RL_BS:				; WM LINEPOP
  21BD'   3A 0000*              	LDA	RLLEN
  21C0'   B7                    	ORA	A
  21C1'   CA 21D5'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  21C4'   3D                    	DCR	A
  21C5'   32 0000*              	STA	RLLEN
  21C8'   2A 0000*              	LHLD	RLPTR
  21CB'   2B                    	DCX	H
  21CC'   22 0000*              	SHLD	RLPTR
  21CF'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  21D2'   C3 2180'              	JMP	RL_LP
  21D5'                         RL_CAN:
  21D5'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  21D7'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  21DA'   CD 0877'              	CALL	SETLIN		; redraw one row
  21DD'   3E FF                 	MVI	A,0FFH		; cancelled
  21DF'   C9                    	RET
  21E0'                         RL_DONE:
  21E0'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
  21E2'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  21E5'   AF                    	XRA	A
  21E6'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  21E7'                         VC_BZ:
  21E7'   CD 0871'              	CALL	SETMOV
  21EA'   3A 0000*              	LDA	GSAVE
  21ED'   FE 02                 	CPI	PZ
  21EF'   CA 21FA'              	JZ	VZ_ZZ
  21F2'   B7                    	ORA	A
  21F3'   C0                    	RNZ			; 'g' was pending: vim drops both
  21F4'   3E 02                 	MVI	A,PZ
  21F6'   32 0000*              	STA	GPEND
  21F9'   C9                    	RET
  21FA'                         VZ_ZZ:
  21FA'   3E 04                 	MVI	A,EO_X
  21FC'   32 0000*              	STA	EXOP
  21FF'   3E 01                 	MVI	A,1
  2201'   32 0000*              	STA	EXBANG		; no '!'
  2204'   AF                    	XRA	A
  2205'   32 0000*              	STA	EXARG		; no file name
  2208'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  220B'   B7                    	ORA	A
  220C'   CA 234D'              	JZ	EX_Q
  220F'   C3 22E7'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  2212'                         VC_EX:
  2212'   CD 079C'              	CALL	GETCNT
  2215'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  2218'   11 0000*              	LXI	D,EXBUF
  221B'   06 28                 	MVI	B,EXMAX
  221D'   0E 3A                 	MVI	C,':'
  221F'   CD 216F'              	CALL	RDLINE
  2222'   B7                    	ORA	A
  2223'   C0                    	RNZ			; cancelled
  2224'   3A 0000*              	LDA	RLLEN
  2227'   5F                    	MOV	E,A
  2228'   16 00                 	MVI	D,0
  222A'   21 0000*              	LXI	H,EXBUF
  222D'   19                    	DAD	D
  222E'   36 00                 	MVI	M,0		; the line ends with a 0
  2230'   21 0000*              	LXI	H,EXBUF
  2233'   CD 27FF'              	CALL	SKIPB
  2236'   C8                    	RZ			; nothing on it
  2237'   22 0000*              	SHLD	EXCMD
  223A'   CD 2A23'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  223D'   CD 27FF'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  2240'   56                    	MOV	D,M
  2241'   23                    	INX	H
  2242'   1E 00                 	MVI	E,0
  2244'   CD 280B'              	CALL	ISLOW
  2247'   DA 2252'              	JC	EX_LK
  224A'   5F                    	MOV	E,A
  224B'   23                    	INX	H
  224C'   CD 280B'              	CALL	ISLOW
  224F'   D2 226B'              	JNC	EX_NOT		; a third letter: none of ours
  2252'                         EX_LK:
  2252'   E5                    	PUSH	H
  2253'   21 2A0A'              	LXI	H,EXTAB
  2256'                         EX_TL:
  2256'   7E                    	MOV	A,M
  2257'   B7                    	ORA	A
  2258'   CA 226A'              	JZ	EX_NTP		; not in the table
  225B'   23                    	INX	H
  225C'   BA                    	CMP	D
  225D'   7E                    	MOV	A,M
  225E'   23                    	INX	H
  225F'   C2 2266'              	JNZ	EX_TN
  2262'   BB                    	CMP	E
  2263'   CA 2271'              	JZ	EX_TF
  2266'                         EX_TN:
  2266'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2267'   C3 2256'              	JMP	EX_TL
  226A'                         EX_NTP:
  226A'   E1                    	POP	H
  226B'                         EX_NOT:
  226B'   21 28C3'              	LXI	H,SNOT
  226E'   C3 2840'              	JMP	EXERT
  2271'                         EX_TF:
  2271'   7E                    	MOV	A,M
  2272'   32 0000*              	STA	EXOP
  2275'   E1                    	POP	H
  2276'   FE 06                 	CPI	EO_S
  2278'   CA 2A92'              	JZ	EX_S		; ':s' reads the rest of the line itself
  227B'   FE 01                 	CPI	EO_W
  227D'   CA 228C'              	JZ	EX_RG		; ':N,Mw name' takes a range
  2280'   FE 08                 	CPI	EO_R
  2282'   CA 228C'              	JZ	EX_RG		; ... and ':Nr name' a line
  2285'   3A 0000*              	LDA	SRNGF
  2288'   B7                    	ORA	A
  2289'   C2 226B'              	JNZ	EX_NOT		; a range on a command that does not take one
  228C'                         EX_RG:
                                	;--- '!', then the file name ---
  228C'   7E                    	MOV	A,M
  228D'   D6 21                 	SUI	'!'
  228F'   32 0000*              	STA	EXBANG		; 0 = '!'
  2292'   C2 2296'              	JNZ	EX_NB
  2295'   23                    	INX	H
  2296'                         EX_NB:
  2296'   CD 27FF'              	CALL	SKIPB
  2299'   32 0000*              	STA	EXARG		; 0 = no file name
  229C'   CA 22B5'              	JZ	EX_RUN
  229F'   22 0000*              	SHLD	EXCMD
  22A2'   3A 0000*              	LDA	EXOP
  22A5'   FE 02                 	CPI	EO_Q
  22A7'   CA 283D'              	JZ	EX_TRL		; :q takes none
  22AA'   FE 07                 	CPI	EO_V
  22AC'   CA 283D'              	JZ	EX_TRL		; nor :ve
  22AF'   CD 2769'              	CALL	PARSFN
  22B2'   C2 2831'              	JNZ	EX_INV
  22B5'                         EX_RUN:
  22B5'   3A 0000*              	LDA	EXOP
  22B8'   FE 05                 	CPI	EO_E
  22BA'   CA 2364'              	JZ	EX_E
  22BD'   FE 02                 	CPI	EO_Q
  22BF'   CA 234D'              	JZ	EX_Q
  22C2'   FE 07                 	CPI	EO_V
  22C4'   CA 2837'              	JZ	EX_V
  22C7'   FE 08                 	CPI	EO_R
  22C9'   CA 24F5'              	JZ	EX_R
  22CC'   FE 04                 	CPI	EO_X
  22CE'   CA 22E0'              	JZ	EX_XM
  22D1'   FE 01                 	CPI	EO_W
  22D3'   C2 22E7'              	JNZ	EX_W		; :wq
  22D6'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  22D9'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  22DA'   C2 2415'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  22DD'   C3 22E7'              	JMP	EX_W
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22E0'                         EX_XM:
  22E0'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  22E3'   B7                    	ORA	A
  22E4'   CA 234D'              	JZ	EX_Q
  22E7'                         EX_W:
  22E7'   CD 25D5'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  22EA'   D8                    	RC			; refused (message shown)
  22EB'   32 0000*              	STA	EXBAK
  22EE'   3A 0000*              	LDA	EXOP
  22F1'   FE 01                 	CPI	EO_W
  22F3'   CA 230A'              	JZ	EX_WK
  22F6'   3A 0000*              	LDA	EXBAK
  22F9'   B7                    	ORA	A
  22FA'   C2 234A'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  22FD'   3A 0000*              	LDA	EXBANG
  2300'   B7                    	ORA	A
  2301'   CA 234A'              	JZ	EX_WQ		; so it does with '!'
  2304'   CD 230A'              	CALL	EX_WK		; else it may not: keep the text
  2307'   C3 234D'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  230A'                         EX_WK:
  230A'   CD 0EDE'              	CALL	CURRW		; the cursor's row and file position
  230D'   32 0000*              	STA	WPROW
  2310'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2313'   7D                    	MOV	A,L
  2314'   E6 7F                 	ANI	7FH
  2316'   32 0000*              	STA	WPBYT
  2319'   7D                    	MOV	A,L
  231A'   17                    	RAL
  231B'   7C                    	MOV	A,H
  231C'   17                    	RAL
  231D'   5F                    	MOV	E,A
  231E'   3E 00                 	MVI	A,0
  2320'   17                    	RAL
  2321'   57                    	MOV	D,A		; DE = HL / 128
  2322'   2A 0000*              	LHLD	OUTPOS
  2325'   19                    	DAD	D
  2326'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2329'   CD 260A'              	CALL	WRITE
  232C'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  232F'   2A 0000*              	LHLD	WPREC
  2332'   EB                    	XCHG
  2333'   3A 0000*              	LDA	WPBYT
  2336'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2339'   CD 0000*              	CALL	GOTO
  233C'                         EX_WRW:
  233C'   21 0000               	LXI	H,0
  233F'   22 0000*              	SHLD	LNDLT
  2342'   3A 0000*              	LDA	WPROW
  2345'   6F                    	MOV	L,A
  2346'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2349'   C9                    	RET
  234A'                         EX_WQ:
  234A'   CD 260A'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  234D'                         EX_Q:
  234D'   3A 0000*              	LDA	EXBANG
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2350'   B7                    	ORA	A
  2351'   CA 235B'              	JZ	EX_QT
  2354'   3A 0000*              	LDA	MODF
  2357'   B7                    	ORA	A
  2358'   C2 2825'              	JNZ	MSGNWR		; changed, no '!': stay
  235B'                         EX_QT:
  235B'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  235E'   3E 01                 	MVI	A,1
  2360'   32 0000*              	STA	QUITF
  2363'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2364'                         EX_E:
  2364'   3A 0000*              	LDA	EXBANG
  2367'   B7                    	ORA	A
  2368'   CA 2372'              	JZ	EE_GO
  236B'   3A 0000*              	LDA	MODF
  236E'   B7                    	ORA	A
  236F'   C2 2825'              	JNZ	MSGNWR
  2372'                         EE_GO:
  2372'   3A 0000*              	LDA	EXARG
  2375'   B7                    	ORA	A
  2376'   C2 237D'              	JNZ	EE_ARG
  2379'   CD 2646'              	CALL	OWNTF		; no name: the buffer's own
  237C'   D8                    	RC
  237D'                         EE_ARG:
  237D'   CD 265C'              	CALL	ISOWN
  2380'   21 0001               	LXI	H,1
  2383'   C2 238A'              	JNZ	EE_LD		; another file: its first line
  2386'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2389'   23                    	INX	H		; HL = the cursor's line
  238A'                         EE_LD:
  238A'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  238C'   32 0000*              	STA	MSGWHT
  238F'   E5                    	PUSH	H
  2390'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2393'   21 0000*              	LXI	H,TFCB
  2396'   11 0000*              	LXI	D,FNAME
  2399'   CD 266E'              	CALL	COPY12		; the buffer's name
  239C'   CD 2633'              	CALL	SRCTF
  239F'   CD 0000*              	CALL	REOPEN
  23A2'   CD 01EF'              	CALL	MKCLR		; the marks named the buffer that just went
  23A5'   AF                    	XRA	A
  23A6'   32 0000*              	STA	MODF
  23A9'   E1                    	POP	H
  23AA'   2B                    	DCX	H
  23AB'   AF                    	XRA	A
  23AC'   CD 0000*              	CALL	MVLIND		; down to the line
  23AF'   CD 0BFA'              	CALL	ATEOF
  23B2'   DC 0C00'              	CC	LASTLN		; past the last line: onto it
  23B5'   CD 13DF'              	CALL	ZSAVE
  23B8'   C3 14B4'              	JMP	GP_MID
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  23BB'                         TFDOS:
  23BB'   C5                    	PUSH	B
  23BC'   11 0080               	LXI	D,CMDTAIL
  23BF'   0E 1A                 	MVI	C,1AH		; set the DMA
  23C1'   CD 0005               	CALL	BDOS
  23C4'   C1                    	POP	B
  23C5'   11 0000*              	LXI	D,TFCB
  23C8'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  23CB'                         EXRNG:
  23CB'   2A 0000*              	LHLD	SRNG1
  23CE'   7C                    	MOV	A,H
  23CF'   B5                    	ORA	L
  23D0'   37                    	STC
  23D1'   C8                    	RZ
  23D2'   2A 0000*              	LHLD	SRNG2
  23D5'   EB                    	XCHG
  23D6'   2A 0000*              	LHLD	SRNG1
  23D9'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  23DC'   D8                    	RC
  23DD'   EB                    	XCHG			; HL = the last line, DE = the first
  23DE'   CD 0000*              	CALL	SUBHD
  23E1'   23                    	INX	H
  23E2'   22 0000*              	SHLD	SLINES
  23E5'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  23E6'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  23E7'                         GOLNX:
  23E7'   E5                    	PUSH	H
  23E8'   CD 135E'              	CALL	GOLN
  23EB'   CD 0000*              	CALL	CNTLF
  23EE'   23                    	INX	H		; the line the cursor came to rest on
  23EF'   D1                    	POP	D
  23F0'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  23F3'                         EXSAVP:
  23F3'   CD 0EDE'              	CALL	CURRW
  23F6'   32 0000*              	STA	WPROW
  23F9'   21 0000*              	LXI	H,MKPOS
  23FC'   C3 0448'              	JMP	FPSTO
  23FF'                         EXRSTP:
  23FF'   CD 0000*              	CALL	CLRCNT
  2402'   CD 03AC'              	CALL	MKPAGE		; page until that place is in the window again
  2405'   CD 0000*              	CALL	GOTO
  2408'   C3 233C'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  240B'                         PUTBRK:
  240B'   3E 0D                 	MVI	A,CR
  240D'   CD 0000*              	CALL	PUTGAP
  2410'   3E 0A                 	MVI	A,LF
  2412'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2415'                         EX_WR:
  2415'   3A 0000*              	LDA	EXARG
  2418'   B7                    	ORA	A
  2419'   CA 2813'              	JZ	MSGNFN		; No file name
  241C'   CD 265C'              	CALL	ISOWN
  241F'   CA 24BF'              	JZ	EXW_OW
  2422'   CD 0000*              	CALL	TEXIST
  2425'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  2428'   CA 2432'              	JZ	EXW_GO
  242B'   3A 0000*              	LDA	EXBANG
  242E'   B7                    	ORA	A
  242F'   C2 2819'              	JNZ	MSGEXI		; File exists (! to force)
  2432'                         EXW_GO:
  2432'   CD 23CB'              	CALL	EXRNG
  2435'   DA 24B9'              	JC	EXW_BD
  2438'   CD 23F3'              	CALL	EXSAVP
  243B'   2A 0000*              	LHLD	SRNG1
  243E'   CD 23E7'              	CALL	GOLNX
  2441'   C2 24B6'              	JNZ	EXW_NL		; the text has no line N
  2444'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  2447'   B7                    	ORA	A		;   not: only when TEXIST found one
  2448'   0E 13                 	MVI	C,13H
  244A'   C4 23BB'              	CNZ	TFDOS		; delete what is there
  244D'   0E 16                 	MVI	C,16H
  244F'   CD 23BB'              	CALL	TFDOS		; ... and make it
  2452'   3C                    	INR	A
  2453'   CA 24A8'              	JZ	EXW_FL		; no directory entry left
  2456'   3E 80                 	MVI	A,80H
  2458'   32 0000*              	STA	RWPTR
  245B'   AF                    	XRA	A
  245C'   32 0000*              	STA	RWERR
  245F'   2A 0000*              	LHLD	SLINES
  2462'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2465'                         EXW_LP:
  2465'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2468'   E5                    	PUSH	H
  2469'   EB                    	XCHG
  246A'   2A 0000*              	LHLD	GAPEND
  246D'   CD 24C5'              	CALL	RWOUT		; the text from the cursor to there
  2470'   E1                    	POP	H
  2471'   3A 0000*              	LDA	RWERR
  2474'   B7                    	ORA	A
  2475'   C2 2491'              	JNZ	EXW_EN
  2478'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  247B'   CD 07B1'              	CALL	CNTTST
  247E'   C2 2465'              	JNZ	EXW_LP
  2481'                         EXW_PD:				; the last record is padded out with ^Z
  2481'   3A 0000*              	LDA	RWPTR
  2484'   FE 80                 	CPI	80H
  2486'   CA 2491'              	JZ	EXW_EN
  2489'   3E 1A                 	MVI	A,CPMEOF
  248B'   CD 24D1'              	CALL	RWPUT
  248E'   C3 2481'              	JMP	EXW_PD
  2491'                         EXW_EN:
  2491'   0E 10                 	MVI	C,10H
  2493'   CD 23BB'              	CALL	TFDOS		; close
  2496'   3A 0000*              	LDA	RWERR
  2499'   B7                    	ORA	A
  249A'   C2 24A8'              	JNZ	EXW_FL
  249D'   CD 23FF'              	CALL	EXRSTP
  24A0'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  24A2'   32 0000*              	STA	MSGWHT
  24A5'   C3 0871'              	JMP	SETMOV		; nothing on the screen has changed
  24A8'                         EXW_FL:				; no room: the part written is not left behind
  24A8'   0E 13                 	MVI	C,13H
  24AA'   CD 23BB'              	CALL	TFDOS
  24AD'   CD 23FF'              	CALL	EXRSTP
  24B0'   21 2A00'              	LXI	H,SDFUL
  24B3'   C3 284B'              	JMP	EXERR
  24B6'                         EXW_NL:
  24B6'   CD 23FF'              	CALL	EXRSTP
  24B9'                         EXW_BD:
  24B9'   21 29F2'              	LXI	H,SRNGE
  24BC'   C3 284B'              	JMP	EXERR
  24BF'                         EXW_OW:
  24BF'   21 287A'              	LXI	H,SEXI
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24C2'   C3 284B'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  24C5'                         RWOUT:
  24C5'   CD 0000*              	CALL	CMP16
  24C8'   C8                    	RZ
  24C9'   7E                    	MOV	A,M
  24CA'   23                    	INX	H
  24CB'   CD 24D1'              	CALL	RWPUT
  24CE'   C3 24C5'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  24D1'                         RWPUT:
  24D1'   E5                    	PUSH	H
  24D2'   F5                    	PUSH	PSW
  24D3'   3A 0000*              	LDA	RWPTR
  24D6'   6F                    	MOV	L,A
  24D7'   26 00                 	MVI	H,0
  24D9'   F1                    	POP	PSW
  24DA'   77                    	MOV	M,A
  24DB'   2C                    	INR	L		; Z: that was the record's last byte
  24DC'   7D                    	MOV	A,L
  24DD'   C2 24F0'              	JNZ	RWP_ST
  24E0'   D5                    	PUSH	D
  24E1'   0E 15                 	MVI	C,15H
  24E3'   CD 23BB'              	CALL	TFDOS		; write it
  24E6'   D1                    	POP	D
  24E7'   B7                    	ORA	A
  24E8'   CA 24EE'              	JZ	RWP_OK
  24EB'   32 0000*              	STA	RWERR
  24EE'                         RWP_OK:
  24EE'   3E 80                 	MVI	A,80H
  24F0'                         RWP_ST:
  24F0'   32 0000*              	STA	RWPTR
  24F3'   E1                    	POP	H
  24F4'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  24F5'                         EX_R:
  24F5'   3A 0000*              	LDA	EXARG
  24F8'   B7                    	ORA	A
  24F9'   CA 2813'              	JZ	MSGNFN		; No file name
  24FC'   0E 0F                 	MVI	C,0FH
  24FE'   CD 23BB'              	CALL	TFDOS		; open
  2501'   3C                    	INR	A
  2502'   CA 25CF'              	JZ	ER_NOF
  2505'   CD 1405'              	CALL	GZONE		; the screen's top line, before anything moves
  2508'   CD 23F3'              	CALL	EXSAVP
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  250B'   3A 0000*              	LDA	SRNGF
  250E'   B7                    	ORA	A
  250F'   CA 2528'              	JZ	ER_NXT		; no line given: below the cursor's
  2512'   2A 0000*              	LHLD	SRNG2
  2515'   7C                    	MOV	A,H
  2516'   B5                    	ORA	L
  2517'   C2 2522'              	JNZ	ER_LN
  251A'   23                    	INX	H
  251B'   CD 135E'              	CALL	GOLN		; ':0r': above line 1 ...
  251E'   AF                    	XRA	A		;   which never wants a line end put in first
  251F'   C3 254A'              	JMP	ER_BRK
  2522'                         ER_LN:
  2522'   CD 23E7'              	CALL	GOLNX
  2525'   C2 24B6'              	JNZ	EXW_NL		; the text has no line N
  2528'                         ER_NXT:
  2528'   21 0001               	LXI	H,1
  252B'   AF                    	XRA	A
  252C'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  252F'   CD 0BFA'              	CALL	ATEOF
  2532'   3E 00                 	MVI	A,0
  2534'   D2 254A'              	JNC	ER_BRK		; text follows
  2537'   2A 0000*              	LHLD	GAPBEG
  253A'   EB                    	XCHG
  253B'   2A 0000*              	LHLD	TXTBEG
  253E'   CD 0000*              	CALL	CMP16
  2541'   3E 01                 	MVI	A,1
  2543'   CA 254A'              	JZ	ER_BRK		; nothing before the cursor either
  2546'   1B                    	DCX	D
  2547'   1A                    	LDAX	D
  2548'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  254A'                         ER_BRK:
  254A'   32 0000*              	STA	RDBRK
  254D'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  2550'   AF                    	XRA	A
  2551'   32 0000*              	STA	RDANY
  2554'                         ER_LP:
  2554'   0E 14                 	MVI	C,14H
  2556'   CD 23BB'              	CALL	TFDOS		; the next record
  2559'   B7                    	ORA	A
  255A'   C2 258D'              	JNZ	ER_END
  255D'   21 0080               	LXI	H,CMDTAIL
  2560'   0E 00                 	MVI	C,0
  2562'                         ER_SC:				; C = its bytes, up to a ^Z
  2562'   7E                    	MOV	A,M
  2563'   FE 1A                 	CPI	CPMEOF
  2565'   CA 256D'              	JZ	ER_GOT
  2568'   23                    	INX	H
  2569'   0C                    	INR	C
  256A'   F2 2562'              	JP	ER_SC		; (minus: all 128)
  256D'                         ER_GOT:
  256D'   79                    	MOV	A,C
  256E'   B7                    	ORA	A
  256F'   CA 258D'              	JZ	ER_END
  2572'   C5                    	PUSH	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2573'   3A 0000*              	LDA	RDANY
  2576'   B7                    	ORA	A
  2577'   CC 25BE'              	CZ	ER_1ST
  257A'   C1                    	POP	B
  257B'   06 00                 	MVI	B,0
  257D'   11 0080               	LXI	D,CMDTAIL
  2580'   C5                    	PUSH	B
  2581'   CD 0000*              	CALL	INSBLK
  2584'   C1                    	POP	B
  2585'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2588'   79                    	MOV	A,C
  2589'   17                    	RAL
  258A'   DA 2554'              	JC	ER_LP		; a full record: there may be more
  258D'                         ER_END:
  258D'   3A 0000*              	LDA	RDANY
  2590'   B7                    	ORA	A
  2591'   CA 25AF'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2594'   CD 0BFA'              	CALL	ATEOF
  2597'   DA 25A4'              	JC	ER_MD		; the text now ends as the file read ends
  259A'   2A 0000*              	LHLD	GAPBEG
  259D'   2B                    	DCX	H
  259E'   7E                    	MOV	A,M
  259F'   FE 0A                 	CPI	LF
  25A1'   C4 240B'              	CNZ	PUTBRK		; text follows: what was read ends a line
  25A4'                         ER_MD:
  25A4'   3E 01                 	MVI	A,1
  25A6'   32 0000*              	STA	MODF
  25A9'   CD 03AC'              	CALL	MKPAGE		; back to the first line read
  25AC'   CD 0000*              	CALL	GOTO
  25AF'                         ER_PL:
  25AF'   CD 0BFA'              	CALL	ATEOF
  25B2'   DC 0C00'              	CC	LASTLN		; (nothing read, at the end: the last line)
  25B5'   CD 0000*              	CALL	CLRCNT
  25B8'   CD 141D'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  25BB'   C3 08AE'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  25BE'                         ER_1ST:
  25BE'   3C                    	INR	A
  25BF'   32 0000*              	STA	RDANY
  25C2'   3A 0000*              	LDA	RDBRK
  25C5'   B7                    	ORA	A
  25C6'   C4 240B'              	CNZ	PUTBRK
  25C9'   21 0000*              	LXI	H,MKPOS
  25CC'   C3 0448'              	JMP	FPSTO
  25CF'                         ER_NOF:
  25CF'   21 29E1'              	LXI	H,SNOPN
  25D2'   C3 2840'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  25D5'                         WRCHK:
  25D5'   3A 0000*              	LDA	EXARG
  25D8'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25D9'   C2 25E3'              	JNZ	WC_ARG
  25DC'   CD 2646'              	CALL	OWNTF
  25DF'   D8                    	RC
  25E0'   C3 25F8'              	JMP	WC_OWN
  25E3'                         WC_ARG:
  25E3'   CD 265C'              	CALL	ISOWN
  25E6'   CA 25F8'              	JZ	WC_OWN
  25E9'   3A 0000*              	LDA	EXBANG
  25EC'   B7                    	ORA	A
  25ED'   CA 25F6'              	JZ	WC_OTH
  25F0'   CD 0000*              	CALL	TEXIST
  25F3'   C2 2819'              	JNZ	MSGEXI		; File exists (! to force)
  25F6'                         WC_OTH:
  25F6'   AF                    	XRA	A		; (NC)
  25F7'   C9                    	RET
  25F8'                         WC_OWN:
  25F8'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  25FB'   B7                    	ORA	A
  25FC'   CA 2606'              	JZ	WC_OK
  25FF'   3A 0000*              	LDA	EXBANG
  2602'   B7                    	ORA	A
  2603'   C2 281F'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2606'                         WC_OK:
  2606'   3E 01                 	MVI	A,1
  2608'   B7                    	ORA	A		; (NC)
  2609'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  260A'                         WRITE:
  260A'   3A 0000*              	LDA	EXBAK
  260D'   CD 0000*              	CALL	WRTO
  2610'   3A 0001*              	LDA	FNAME+1
  2613'   FE 20                 	CPI	' '
  2615'   C2 2621'              	JNZ	WR_HAS
  2618'   21 0000*              	LXI	H,TFCB
  261B'   11 0000*              	LXI	D,FNAME
  261E'   CD 266E'              	CALL	COPY12
  2621'                         WR_HAS:
  2621'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2623'   32 0000*              	STA	MSGWHT
  2626'   CD 265C'              	CALL	ISOWN
  2629'   C2 2633'              	JNZ	SRCTF
  262C'   AF                    	XRA	A
  262D'   32 0000*              	STA	MODF
  2630'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2633'                         SRCTF:
  2633'   21 0000*              	LXI	H,TFCB
  2636'   11 005C               	LXI	D,DFTFCB
  2639'   CD 266E'              	CALL	COPY12
  263C'   AF                    	XRA	A
  263D'   06 04                 	MVI	B,4
  263F'                         SRC_Z:
  263F'   12                    	STAX	D		; extent, s1, s2, record count: 0
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2640'   13                    	INX	D
  2641'   05                    	DCR	B
  2642'   C2 263F'              	JNZ	SRC_Z
  2645'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2646'                         OWNTF:
  2646'   3A 0001*              	LDA	FNAME+1
  2649'   FE 20                 	CPI	' '
  264B'   CA 2813'              	JZ	MSGNFN
  264E'   CD 2679'              	CALL	TFCLR
  2651'   21 0000*              	LXI	H,FNAME
  2654'   11 0000*              	LXI	D,TFCB
  2657'   CD 266E'              	CALL	COPY12
  265A'   B7                    	ORA	A		; (NC)
  265B'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  265C'                         ISOWN:
  265C'   21 0000*              	LXI	H,TFCB
  265F'   11 0000*              	LXI	D,FNAME
  2662'   06 0C                 	MVI	B,12
  2664'                         IO_LP:
  2664'   1A                    	LDAX	D
  2665'   BE                    	CMP	M
  2666'   C0                    	RNZ
  2667'   23                    	INX	H
  2668'   13                    	INX	D
  2669'   05                    	DCR	B
  266A'   C2 2664'              	JNZ	IO_LP
  266D'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  266E'                         COPY12:
  266E'   06 0C                 	MVI	B,12
  2670'                         CP_LP:
  2670'   7E                    	MOV	A,M
  2671'   12                    	STAX	D
  2672'   23                    	INX	H
  2673'   13                    	INX	D
  2674'   05                    	DCR	B
  2675'   C2 2670'              	JNZ	CP_LP
  2678'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2679'                         TFCLR:
  2679'   11 0000*              	LXI	D,TFCB
  267C'   06 24                 	MVI	B,36
  267E'   AF                    	XRA	A
  267F'                         TC_LP:
  267F'   12                    	STAX	D
  2680'   13                    	INX	D
  2681'   05                    	DCR	B
  2682'   C2 267F'              	JNZ	TC_LP
  2685'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2686'                         FOPEN:
  2686'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2688'   32 0000*              	STA	MSGWHT
  268B'   21 005C               	LXI	H,DFTFCB
  268E'   CD 275C'              	CALL	NRMDRV
  2691'   11 0000*              	LXI	D,FNAME
  2694'   CD 266E'              	CALL	COPY12
  2697'   CD 0000*              	CALL	OPENZ
  269A'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  269D'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  269F'   C8                    	RZ
  26A0'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  26A3'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  26A6'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  26A7'                         ARGSCN:
  26A7'   3A 0080               	LDA	CMDTAIL
  26AA'   47                    	MOV	B,A		; B = what is left of the line
  26AB'   B7                    	ORA	A
  26AC'   C8                    	RZ
  26AD'   21 0081               	LXI	H,CMDTAIL+1
  26B0'                         AS_TOK:				; at a token, or the blanks before one
  26B0'   7E                    	MOV	A,M
  26B1'   FE 20                 	CPI	' '
  26B3'   C2 26BC'              	JNZ	AS_OPT
  26B6'   23                    	INX	H
  26B7'   05                    	DCR	B
  26B8'   C2 26B0'              	JNZ	AS_TOK
  26BB'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26BC'                         AS_OPT:
  26BC'   FE 2B                 	CPI	'+'
  26BE'   CA 26E8'              	JZ	AS_PLS
  26C1'   FE 2D                 	CPI	'-'
  26C3'   CA 26D7'              	JZ	AS_SW
  26C6'   FE 2F                 	CPI	'/'
  26C8'   CA 26D7'              	JZ	AS_SW
  26CB'                         AS_SKP:				; not ours (the file name): on to the next one
  26CB'   23                    	INX	H
  26CC'   05                    	DCR	B
  26CD'   C8                    	RZ
  26CE'   7E                    	MOV	A,M
  26CF'   FE 20                 	CPI	' '
  26D1'   C2 26CB'              	JNZ	AS_SKP
  26D4'   C3 26B0'              	JMP	AS_TOK
  26D7'                         AS_SW:
  26D7'   23                    	INX	H
  26D8'   05                    	DCR	B
  26D9'   C8                    	RZ
  26DA'   7E                    	MOV	A,M
  26DB'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  26DD'   FE 52                 	CPI	'R'
  26DF'   C2 26CB'              	JNZ	AS_SKP
  26E2'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  26E5'   C3 26CB'              	JMP	AS_SKP
  26E8'                         AS_PLS:
  26E8'   3E 01                 	MVI	A,1
  26EA'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  26ED'   11 0000*              	LXI	D,PLUSB
  26F0'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  26F2'   23                    	INX	H		;   line space, so it is taken as '+' alone
  26F3'   05                    	DCR	B
  26F4'   CA 272B'              	JZ	AS_PE
  26F7'   7E                    	MOV	A,M
  26F8'   FE 30                 	CPI	'0'
  26FA'   C2 2712'              	JNZ	AS_PD
  26FD'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  26FD'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  26FE'   05                    	DCR	B
  26FF'   CA 2733'              	JZ	AS_P1
  2702'   7E                    	MOV	A,M
  2703'   FE 30                 	CPI	'0'
  2705'   CA 26FD'              	JZ	AS_PZ
  2708'   FE 31                 	CPI	'1'
  270A'   DA 2733'              	JC	AS_P1		; zeros and then no digit at all: line 1
  270D'   FE 3A                 	CPI	'9'+1
  270F'   D2 2733'              	JNC	AS_P1
  2712'                         AS_PD:				; the digits, as typed
  2712'   7E                    	MOV	A,M
  2713'   FE 30                 	CPI	'0'
  2715'   DA 272B'              	JC	AS_PE
  2718'   FE 3A                 	CPI	'9'+1
  271A'   D2 272B'              	JNC	AS_PE
  271D'   79                    	MOV	A,C
  271E'   B7                    	ORA	A
  271F'   CA 273A'              	JZ	AS_POV
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2722'   0D                    	DCR	C
  2723'   7E                    	MOV	A,M
  2724'   12                    	STAX	D
  2725'   13                    	INX	D
  2726'   23                    	INX	H
  2727'   05                    	DCR	B
  2728'   C2 2712'              	JNZ	AS_PD
  272B'                         AS_PE:
  272B'   AF                    	XRA	A
  272C'   12                    	STAX	D		; the digits end with a 0
  272D'   78                    	MOV	A,B
  272E'   B7                    	ORA	A
  272F'   C8                    	RZ
  2730'   C3 26B0'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2733'                         AS_P1:
  2733'   3E 31                 	MVI	A,'1'
  2735'   12                    	STAX	D
  2736'   13                    	INX	D
  2737'   C3 272B'              	JMP	AS_PE
  273A'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  273A'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  273D'   C3 272B'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2740'                         ARGGO:
  2740'   3A 0000*              	LDA	PLUSF
  2743'   B7                    	ORA	A
  2744'   C8                    	RZ
  2745'   21 0000*              	LXI	H,PLUSB
  2748'                         AG_LP:
  2748'   7E                    	MOV	A,M
  2749'   B7                    	ORA	A
  274A'   CA 2757'              	JZ	AG_G
  274D'   4F                    	MOV	C,A
  274E'   E5                    	PUSH	H
  274F'   CD 0026'              	CALL	VICMD
  2752'   E1                    	POP	H
  2753'   23                    	INX	H
  2754'   C3 2748'              	JMP	AG_LP
  2757'                         AG_G:
  2757'   0E 47                 	MVI	C,'G'
  2759'   C3 0026'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  275C'                         NRMDRV:
  275C'   7E                    	MOV	A,M
  275D'   B7                    	ORA	A
  275E'   C0                    	RNZ
  275F'   E5                    	PUSH	H
  2760'   0E 19                 	MVI	C,BF_CURDSK
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  2762'   CD 0005               	CALL	BDOS
  2765'   E1                    	POP	H
  2766'   3C                    	INR	A
  2767'   77                    	MOV	M,A
  2768'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  2769'                         PARSFN:
  2769'   CD 2679'              	CALL	TFCLR
  276C'   11 0000*              	LXI	D,TFCB
  276F'   23                    	INX	H
  2770'   7E                    	MOV	A,M
  2771'   2B                    	DCX	H
  2772'   FE 3A                 	CPI	':'
  2774'   C2 2786'              	JNZ	PF_NM
  2777'   CD 27CC'              	CALL	GETFNC
  277A'   CA 2786'              	JZ	PF_NM
  277D'   D6 40                 	SUI	40H
  277F'   12                    	STAX	D
  2780'   FE 11                 	CPI	17
  2782'   D2 27AA'              	JNC	PF_BAD
  2785'   23                    	INX	H
  2786'                         PF_NM:
  2786'   13                    	INX	D
  2787'   0E 08                 	MVI	C,8
  2789'   CD 27AE'              	CALL	CPYNAM
  278C'   FE 2E                 	CPI	'.'
  278E'   0E 03                 	MVI	C,3
  2790'   C4 27C1'              	CNZ	PADFLD		; no type: blanks
  2793'   CC 27AD'              	CZ	CPYNM0		; '.': the type
  2796'   3A 0001*              	LDA	TFCB+1
  2799'   FE 20                 	CPI	' '
  279B'   CA 27AA'              	JZ	PF_BAD		; no name
  279E'   CD 27FF'              	CALL	SKIPB
