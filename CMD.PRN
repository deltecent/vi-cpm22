  062B'   37                    	STC
  062C'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  062D'                         GOSET:
  062D'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  0630'                         SETGL:
  0630'   CD 13DF'              	CALL	ZSAVE
  0633'   21 0000               	LXI	H,0
  0636'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0639'   E5                    	PUSH	H
  063A'   CD 13F2'              	CALL	ZREST
  063D'   E1                    	POP	H
  063E'   E5                    	PUSH	H
  063F'   CD 0795'              	CALL	GBSUB		; HL = bytes to the cursor
  0642'   44                    	MOV	B,H
  0643'   4D                    	MOV	C,L
  0644'   E1                    	POP	H		; HL = the line's start
  0645'   11 0000               	LXI	D,0		; DE = screen column
  0648'                         SG_LP:
  0648'   78                    	MOV	A,B
  0649'   B1                    	ORA	C
  064A'   CA 065F'              	JZ	SG_CUR
  064D'   7E                    	MOV	A,M
  064E'   23                    	INX	H
  064F'   0B                    	DCX	B
  0650'   E5                    	PUSH	H
  0651'   6B                    	MOV	L,E
  0652'   CD 0684'              	CALL	CWID
  0655'   E1                    	POP	H
  0656'   83                    	ADD	E
  0657'   5F                    	MOV	E,A
  0658'   D2 0648'              	JNC	SG_LP
  065B'   14                    	INR	D
  065C'   C3 0648'              	JMP	SG_LP
