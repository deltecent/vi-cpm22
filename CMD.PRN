  0990'   22 2A81'              	SHLD	JKMOV
  0993'   AF                    	XRA	A
  0994'   32 2A85'              	STA	JKPHN
  0997'                         JC_MV:
  0997'   2A 2A7D'              	LHLD	JKCNT
  099A'   AF                    	XRA	A
