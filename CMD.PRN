  0F4A'   3C                    	INR	A
  0F4B'   4F                    	MOV	C,A
  0F4C'   AF                    	XRA	A
  0F4D'   CD 1041'              	CALL	HTSET		; HL -> the top line's rows
  0F50'   3A 2D21'              	LDA	HFN
  0F53'   57                    	MOV	D,A		; D = the rows the text moves
  0F54'   5F                    	MOV	E,A		; E = the rows the cursor moves
  0F55'   3A 2D27'              	LDA	HTEOF
  0F58'   B7                    	ORA	A
  0F59'   CA 0F78'              	JZ	VHD_1
  0F5C'   E5                    	PUSH	H
  0F5D'   C5                    	PUSH	B
  0F5E'   0E FF                 	MVI	C,255
  0F60'   CD 1080'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  0F63'   3A 0000*              	LDA	NEDIT
  0F66'   81                    	ADD	C
  0F67'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  0F68'   C1                    	POP	B
  0F69'   E1                    	POP	H
  0F6A'   B7                    	ORA	A
  0F6B'   FA 0F76'              	JM	VHD_0		; none
  0F6E'   BA                    	CMP	D
  0F6F'   D2 0F78'              	JNC	VHD_1
  0F72'   57                    	MOV	D,A
  0F73'   C3 0F78'              	JMP	VHD_1
  0F76'                         VHD_0:
  0F76'   16 00                 	MVI	D,0
  0F78'                         VHD_1:
  0F78'   7A                    	MOV	A,D
  0F79'   B7                    	ORA	A
  0F7A'   CA 0F95'              	JZ	VHD_C		; the text stays
  0F7D'   4A                    	MOV	C,D
  0F7E'   CD 1080'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  0F81'   79                    	MOV	A,C
  0F82'   B7                    	ORA	A
  0F83'   CA 0F95'              	JZ	VHD_C
  0F86'   BA                    	CMP	D
  0F87'   C2 0F92'              	JNZ	VHD_R
  0F8A'   7E                    	MOV	A,M		; the top line still: past all of it
  0F8B'   91                    	SUB	C
  0F8C'   83                    	ADD	E
  0F8D'   5F                    	MOV	E,A
  0F8E'   23                    	INX	H
  0F8F'   C3 0F95'              	JMP	VHD_C
  0F92'                         VHD_R:
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F92'   7B                    	MOV	A,E		; part of the way down a line: its start
  0F93'   91                    	SUB	C
  0F94'   5F                    	MOV	E,A
  0F95'                         VHD_C:
  0F95'   22 2D22'              	SHLD	HFTP
  0F98'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  0F9B'   83                    	ADD	E
  0F9C'   4F                    	MOV	C,A
  0F9D'   3A 2D25'              	LDA	HTCUR
  0FA0'   CD 1062'              	CALL	HTPT
  0FA3'   CD 1080'              	CALL	HTFQ
  0FA6'   D2 0FAA'              	JNC	HFEND
  0FA9'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  0FAA'                         HFEND:
  0FAA'   EB                    	XCHG
  0FAB'   2A 2D22'              	LHLD	HFTP
  0FAE'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  0FAF'                         HTLAND:
  0FAF'   E5                    	PUSH	H
  0FB0'   D5                    	PUSH	D
  0FB1'   CD 1075'              	CALL	HTGO
  0FB4'   D1                    	POP	D
  0FB5'   E1                    	POP	H
  0FB6'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  0FB9'   7C                    	MOV	A,H
  0FBA'   B7                    	ORA	A
  0FBB'   7D                    	MOV	A,L
  0FBC'   CA 0FC0'              	JZ	HL_SET
  0FBF'   AF                    	XRA	A
  0FC0'                         HL_SET:
  0FC0'   CD 0D66'              	CALL	SETRWT
  0FC3'   C3 087A'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  0FC6'                         VHD_TL:
  0FC6'   3A 0000*              	LDA	SKIPR
  0FC9'   47                    	MOV	B,A
  0FCA'   3A 0000*              	LDA	CSUB
  0FCD'   90                    	SUB	B		; A = that row
  0FCE'   F5                    	PUSH	PSW
  0FCF'   21 0001               	LXI	H,1
  0FD2'   CD 0935'              	CALL	JCORE		; (on the last line: nowhere to go)
  0FD5'   F1                    	POP	PSW
  0FD6'   4F                    	MOV	C,A
  0FD7'   C5                    	PUSH	B
  0FD8'   0C                    	INR	C
  0FD9'   06 00                 	MVI	B,0
  0FDB'   CD 1056'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  0FDE'   22 2D22'              	SHLD	HFTP
  0FE1'   D1                    	POP	D
  0FE2'   4B                    	MOV	C,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FE3'   CD 1080'              	CALL	HTFQ
  0FE6'   D2 0FAA'              	JNC	HFEND
  0FE9'   2B                    	DCX	H
  0FEA'   C3 0FAA'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  0FED'                         VC_HFUP:
  0FED'   CD 07A0'              	CALL	SETMOV
  0FF0'   CD 1164'              	CALL	HFCNT		; HFN = the rows
  0FF3'   CD 1144'              	CALL	ONFST
  0FF6'   C8                    	RZ			; the cursor is on the first line
  0FF7'   0E 01                 	MVI	C,1
  0FF9'   3A 2D21'              	LDA	HFN
  0FFC'   CD 1041'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FFF'   43                    	MOV	B,E
  1000'   3A 2D21'              	LDA	HFN
  1003'   4F                    	MOV	C,A
  1004'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1005'   CD 1091'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1008'   DA 1023'              	JC	VHU_C		;   above it; or the file's first line
  100B'   79                    	MOV	A,C
  100C'   B7                    	ORA	A
  100D'   CA 1023'              	JZ	VHU_C
  1010'   3A 2D26'              	LDA	HTTP
  1013'   3D                    	DCR	A
  1014'   B8                    	CMP	B
  1015'   CA 1020'              	JZ	VHU_F
  1018'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1019'   96                    	SUB	M
  101A'   81                    	ADD	C
  101B'   5F                    	MOV	E,A
  101C'   23                    	INX	H
  101D'   C3 1023'              	JMP	VHU_C
  1020'                         VHU_F:
  1020'   7B                    	MOV	A,E		; ... the first line back: all of it
  1021'   81                    	ADD	C
  1022'   5F                    	MOV	E,A
  1023'                         VHU_C:
  1023'   22 2D22'              	SHLD	HFTP
  1026'   4B                    	MOV	C,E
  1027'   3A 2D25'              	LDA	HTCUR
  102A'   CD 1062'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  102D'   3A 0000*              	LDA	CSUB
  1030'   57                    	MOV	D,A
  1031'   79                    	MOV	A,C
  1032'   92                    	SUB	D		; the rows to go, less those of its own line above it
  1033'   DA 0FAA'              	JC	HFEND
  1036'   CA 0FAA'              	JZ	HFEND
  1039'   4F                    	MOV	C,A
  103A'   43                    	MOV	B,E
  103B'   CD 1091'              	CALL	HTBQ		; (off the top: the file's first line)
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  103E'   C3 0FAA'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
  1041'                         HTSET:
  1041'   47                    	MOV	B,A
  1042'   CD 0D47'              	CALL	CURRW		; (keeps BC)
  1045'   F5                    	PUSH	PSW
  1046'   80                    	ADD	B
  1047'   47                    	MOV	B,A
  1048'   CD 1056'              	CALL	HTRB
  104B'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  104C'   3A 2D25'              	LDA	HTCUR
  104F'   90                    	SUB	B
  1050'   32 2D26'              	STA	HTTP
  1053'   C3 1062'              	JMP	HTPT
  1056'                         HTRB:
  1056'   CD 1234'              	CALL	ZSAVE
  1059'   CD 0000*              	CALL	HTBLD
  105C'   CD 1247'              	CALL	ZREST
  105F'   3A 2D25'              	LDA	HTCUR
  1062'                         HTPT:
  1062'   5F                    	MOV	E,A
  1063'   16 00                 	MVI	D,0
  1065'   21 0000*              	LXI	H,HTAB
  1068'   19                    	DAD	D
  1069'   3A 2D24'              	LDA	HTN
  106C'   93                    	SUB	E
  106D'   47                    	MOV	B,A
  106E'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  106F'                         HTIX:
  106F'   11 0000*              	LXI	D,HTAB
  1072'   7D                    	MOV	A,L
  1073'   93                    	SUB	E
  1074'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1075'                         HTGO:
  1075'   CD 106F'              	CALL	HTIX
  1078'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1079'   3A 2D25'              	LDA	HTCUR
  107C'   90                    	SUB	B		; A = the lines up to it
  107D'   C3 0D7E'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1080'                         HTFQ:
  1080'   78                    	MOV	A,B
  1081'   B7                    	ORA	A
  1082'   37                    	STC
  1083'   C8                    	RZ
  1084'   79                    	MOV	A,C
  1085'   96                    	SUB	M
  1086'   DA 108F'              	JC	HF_IN
  1089'   4F                    	MOV	C,A
  108A'   23                    	INX	H
  108B'   05                    	DCR	B
  108C'   C3 1080'              	JMP	HTFQ
  108F'                         HF_IN:
  108F'   B7                    	ORA	A
  1090'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1091'                         HTBQ:
  1091'   78                    	MOV	A,B
  1092'   B7                    	ORA	A
  1093'   37                    	STC
  1094'   C8                    	RZ
  1095'   2B                    	DCX	H
  1096'   05                    	DCR	B
  1097'   7E                    	MOV	A,M
  1098'   91                    	SUB	C
  1099'   D2 10A2'              	JNC	HQ_IN
  109C'   2F                    	CMA
  109D'   3C                    	INR	A
  109E'   4F                    	MOV	C,A
  109F'   C3 1091'              	JMP	HTBQ
  10A2'                         HQ_IN:
  10A2'   4F                    	MOV	C,A
  10A3'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  10A4'                         RWQ:
  10A4'   0E 64                 	MVI	C,100
  10A6'   3A 2D2A'              	LDA	RWR+1
  10A9'   B7                    	ORA	A
  10AA'   C0                    	RNZ
  10AB'   3A 2D29'              	LDA	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10AE'   B9                    	CMP	C
  10AF'   D0                    	RNC
  10B0'   4F                    	MOV	C,A
  10B1'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  10B2'                         RWSUB:
  10B2'   E5                    	PUSH	H
  10B3'   5F                    	MOV	E,A
  10B4'   16 00                 	MVI	D,0
  10B6'   2A 2D29'              	LHLD	RWR
  10B9'   CD 0000*              	CALL	SUBHD
  10BC'   22 2D29'              	SHLD	RWR
  10BF'   E1                    	POP	H
  10C0'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  10C1'                         RWFWD:
  10C1'   CD 10A4'              	CALL	RWQ
  10C4'   51                    	MOV	D,C
  10C5'   CD 1080'              	CALL	HTFQ
  10C8'   F5                    	PUSH	PSW
  10C9'   7A                    	MOV	A,D
  10CA'   91                    	SUB	C		; the rows that took it to that line's first
  10CB'   CD 10B2'              	CALL	RWSUB
  10CE'   F1                    	POP	PSW
  10CF'   DA 10E3'              	JC	RF_OFF
  10D2'   3A 2D2A'              	LDA	RWR+1		; is what is left inside this line?
  10D5'   B7                    	ORA	A
  10D6'   C2 10ED'              	JNZ	RF_GO
  10D9'   3A 2D29'              	LDA	RWR
  10DC'   BE                    	CMP	M
  10DD'   D2 10ED'              	JNC	RF_GO
  10E0'   4F                    	MOV	C,A
  10E1'   B7                    	ORA	A
  10E2'   C9                    	RET
  10E3'                         RF_OFF:
  10E3'   3A 2D27'              	LDA	HTEOF
  10E6'   B7                    	ORA	A
  10E7'   CA 10ED'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  10EA'   2B                    	DCX	H
  10EB'   37                    	STC
  10EC'   C9                    	RET
  10ED'                         RF_GO:
  10ED'   CD 1075'              	CALL	HTGO
  10F0'   3E 01                 	MVI	A,1
  10F2'   32 2D2B'              	STA	RWMV
  10F5'   CD 10A4'              	CALL	RWQ
  10F8'   0C                    	INR	C
  10F9'   06 00                 	MVI	B,0
  10FB'   CD 1056'              	CALL	HTRB
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  10FE'   C3 10C1'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1101'                         RWBAK:
  1101'   CD 10A4'              	CALL	RWQ
  1104'   51                    	MOV	D,C
  1105'   CD 1091'              	CALL	HTBQ
  1108'   DA 1125'              	JC	RB_OFF
  110B'   7A                    	MOV	A,D
  110C'   81                    	ADD	C
  110D'   5F                    	MOV	E,A		; E = the rows up to that line's first
  110E'   3A 2D2A'              	LDA	RWR+1
  1111'   B7                    	ORA	A
  1112'   C2 1121'              	JNZ	RB_ON
  1115'   3A 2D29'              	LDA	RWR
  1118'   57                    	MOV	D,A
  1119'   7B                    	MOV	A,E
  111A'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  111B'   DA 1121'              	JC	RB_ON
  111E'   4F                    	MOV	C,A
  111F'   B7                    	ORA	A
  1120'   C9                    	RET
  1121'                         RB_ON:
  1121'   7B                    	MOV	A,E
  1122'   C3 112C'              	JMP	RB_GO
  1125'                         RB_OFF:
  1125'   3A 2D28'              	LDA	HTBOF
  1128'   0F                    	RRC			; CY: that is the file's first line
  1129'   D8                    	RC
  112A'   7A                    	MOV	A,D
  112B'   91                    	SUB	C
  112C'                         RB_GO:
  112C'   CD 10B2'              	CALL	RWSUB
  112F'   CD 1075'              	CALL	HTGO
  1132'   3E 01                 	MVI	A,1
  1134'   32 2D2B'              	STA	RWMV
  1137'   CD 10A4'              	CALL	RWQ
  113A'   41                    	MOV	B,C
  113B'   0E 01                 	MVI	C,1
  113D'   CD 1056'              	CALL	HTRB
  1140'   43                    	MOV	B,E
  1141'   C3 1101'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  1144'                         ONFST:
  1144'   E5                    	PUSH	H
  1145'   2A 0000*              	LHLD	OUTPOS
  1148'   7C                    	MOV	A,H
  1149'   B5                    	ORA	L
  114A'   C2 1162'              	JNZ	OF_RET
  114D'   2A 0000*              	LHLD	TXTBEG
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1150'   EB                    	XCHG			; DE = TXTBEG
  1151'   2A 0000*              	LHLD	GAPBEG
  1154'                         OF_LP:
  1154'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  1157'   CA 1162'              	JZ	OF_RET
  115A'   2B                    	DCX	H
  115B'   7E                    	MOV	A,M
  115C'   FE 0A                 	CPI	LF
  115E'   C2 1154'              	JNZ	OF_LP
  1161'   B7                    	ORA	A		; NZ
  1162'                         OF_RET:
  1162'   E1                    	POP	H
  1163'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  1164'                         HFCNT:
  1164'   2A 2D14'              	LHLD	CMDCNT
  1167'   7C                    	MOV	A,H
  1168'   B5                    	ORA	L
  1169'   CA 1180'              	JZ	HFC_AM
  116C'   CD 06CB'              	CALL	GETCNT		; HL = count; clears it
  116F'   3A 0000*              	LDA	NEDIT
  1172'   5F                    	MOV	E,A
  1173'   16 00                 	MVI	D,0
  1175'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  1178'   D2 117C'              	JNC	HFC_ST
  117B'   EB                    	XCHG			; HL = NEDIT
  117C'                         HFC_ST:
  117C'   7D                    	MOV	A,L
  117D'   32 2D20'              	STA	HFAMT
  1180'                         HFC_AM:
  1180'   3A 2D20'              	LDA	HFAMT
  1183'   B7                    	ORA	A
  1184'   C2 1191'              	JNZ	HFC_HL
  1187'   3A 0000*              	LDA	NEDIT
  118A'   B7                    	ORA	A
  118B'   1F                    	RAR
  118C'   B7                    	ORA	A
  118D'   C2 1191'              	JNZ	HFC_HL
  1190'   3C                    	INR	A		; at least one row
  1191'                         HFC_HL:
  1191'   32 2D21'              	STA	HFN
  1194'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1195'                         VC_REDR:
  1195'   C3 06CB'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1198'                         VC_G:
  1198'   CD 07A0'              	CALL	SETMOV
  119B'   CD 125A'              	CALL	GZONE		; the screen's top line, before the move
  119E'   CD 06F4'              	CALL	BRKON		; ... and an ESC may stop it from here on
  11A1'   2A 2D14'              	LHLD	CMDCNT
  11A4'   7C                    	MOV	A,H
  11A5'   B5                    	ORA	L
  11A6'   C2 11B9'              	JNZ	VG_N
  11A9'   AF                    	XRA	A		; forward
  11AA'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  11AD'   CD 0731'              	CALL	BRKOFF
  11B0'   DA 0749'              	JC	BRKBAK
  11B3'   CD 0A69'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  11B6'   C3 1272'              	JMP	GPLACE
  11B9'                         VG_N:
  11B9'   CD 06CB'              	CALL	GETCNT		; HL = target line (1-based)
  11BC'                         VG_LN:
  11BC'   CD 11C8'              	CALL	GOLN
  11BF'   CD 0731'              	CALL	BRKOFF
  11C2'   DA 0749'              	JC	BRKBAK
  11C5'   C3 1272'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  11C8'                         GOLN:
  11C8'   E5                    	PUSH	H
  11C9'   CD 0000*              	CALL	CNTLF
  11CC'   23                    	INX	H		; HL = the cursor's line
  11CD'   D1                    	POP	D		; DE = the line wanted
  11CE'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  11D1'   DA 11DC'              	JC	GLN_BK
  11D4'   EB                    	XCHG
  11D5'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  11D8'   AF                    	XRA	A
  11D9'   C3 11E1'              	JMP	GLN_MV
  11DC'                         GLN_BK:
  11DC'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  11DF'   3E FF                 	MVI	A,0FFH
  11E1'                         GLN_MV:
  11E1'   CD 0000*              	CALL	MVLIND
  11E4'   CD 0A63'              	CALL	ATEOF
  11E7'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  11EA'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  11EB'                         VC_LG:
  11EB'   CD 07A0'              	CALL	SETMOV
  11EE'   3A 2D47'              	LDA	GSAVE
  11F1'   B7                    	ORA	A
  11F2'   C2 11FB'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  11F5'   3E 01                 	MVI	A,PG
  11F7'   32 2D46'              	STA	GPEND
  11FA'   C9                    	RET
  11FB'                         VLG_GG:
  11FB'   CD 125A'              	CALL	GZONE
  11FE'   CD 06F4'              	CALL	BRKON
  1201'   CD 06CB'              	CALL	GETCNT		; HL = target line (no count: 1)
  1204'   C3 11BC'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1207'                         SUB24:
  1207'   4F                    	MOV	C,A
  1208'   7D                    	MOV	A,L
  1209'   93                    	SUB	E
  120A'   6F                    	MOV	L,A
  120B'   7C                    	MOV	A,H
  120C'   9A                    	SBB	D
  120D'   67                    	MOV	H,A
  120E'   79                    	MOV	A,C
  120F'   98                    	SBB	B
  1210'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1211'                         CURFP:
  1211'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1214'                         FPOS:
  1214'   C5                    	PUSH	B
  1215'   D5                    	PUSH	D
  1216'   EB                    	XCHG
  1217'   2A 0000*              	LHLD	TXTBEG
  121A'   EB                    	XCHG
  121B'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  121E'   EB                    	XCHG			; DE = that
  121F'   2A 0000*              	LHLD	OUTPOS
  1222'   7C                    	MOV	A,H
  1223'   B7                    	ORA	A		; CY = 0
  1224'   1F                    	RAR
  1225'   47                    	MOV	B,A
  1226'   7D                    	MOV	A,L
  1227'   1F                    	RAR
  1228'   67                    	MOV	H,A
  1229'   3E 00                 	MVI	A,0
  122B'   1F                    	RAR
  122C'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  122D'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122E'   78                    	MOV	A,B
  122F'   CE 00                 	ACI	0		; A:HL = the position
  1231'   D1                    	POP	D
  1232'   C1                    	POP	B
  1233'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  1234'                         ZSAVE:
  1234'   2A 2D14'              	LHLD	CMDCNT
  1237'   22 2D85'              	SHLD	ZSVCNT
  123A'   2A 0000*              	LHLD	AUXCNT
  123D'   22 2D87'              	SHLD	ZSVAUX
  1240'   3A 0000*              	LDA	DIRFLG
  1243'   32 2D89'              	STA	ZSVDIR
  1246'   C9                    	RET
  1247'                         ZREST:
  1247'   2A 2D85'              	LHLD	ZSVCNT
  124A'   22 2D14'              	SHLD	CMDCNT
  124D'   2A 2D87'              	LHLD	ZSVAUX
  1250'   22 0000*              	SHLD	AUXCNT
  1253'   3A 2D89'              	LDA	ZSVDIR
  1256'   32 0000*              	STA	DIRFLG
  1259'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  125A'                         GZONE:
  125A'   CD 1234'              	CALL	ZSAVE
  125D'   CD 0D47'              	CALL	CURRW
  1260'   6F                    	MOV	L,A
  1261'   26 00                 	MVI	H,0
  1263'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  1266'   CD 1214'              	CALL	FPOS
  1269'   22 0000*              	SHLD	ZTOP
  126C'   32 0002*              	STA	ZTOP+2
  126F'   C3 1247'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1272'                         GPLACE:
  1272'   CD 1234'              	CALL	ZSAVE
  1275'   CD 1211'              	CALL	CURFP
  1278'   EB                    	XCHG
  1279'   2A 0000*              	LHLD	ZTOP
  127C'   EB                    	XCHG
  127D'   4F                    	MOV	C,A		; C:HL = the target's position
  127E'   3A 0002*              	LDA	ZTOP+2
  1281'   47                    	MOV	B,A		; B:DE = the top's
  1282'   79                    	MOV	A,C
  1283'   CD 1207'              	CALL	SUB24
  1286'   22 2D82'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1289'   DA 12C3'              	JC	GP_UP
  128C'   B7                    	ORA	A
  128D'   C2 1304'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1290'   3A 0000*              	LDA	NEDIT
  1293'   87                    	ADD	A
  1294'   3C                    	INR	A
  1295'   6F                    	MOV	L,A
  1296'   26 00                 	MVI	H,0
  1298'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  129B'   CD 06C4'              	CALL	GBSUB		; HL = bytes from there to the target
  129E'   EB                    	XCHG
  129F'   2A 2D82'              	LHLD	ZDIF		; HL = bytes from the top to the target
  12A2'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  12A5'   DA 1304'              	JC	GP_MID
  12A8'   CD 06C4'              	CALL	GBSUB		; HL = the top line's start (resident)
  12AB'   01 0000               	LXI	B,0		; BC = lines from the top
  12AE'                         GP_CNT:
  12AE'   7A                    	MOV	A,D
  12AF'   B3                    	ORA	E
  12B0'   CA 12BF'              	JZ	GP_DN
  12B3'   7E                    	MOV	A,M
  12B4'   23                    	INX	H
  12B5'   1B                    	DCX	D
  12B6'   FE 0A                 	CPI	LF
  12B8'   C2 12AE'              	JNZ	GP_CNT
  12BB'   03                    	INX	B
  12BC'   C3 12AE'              	JMP	GP_CNT
  12BF'                         GP_DN:
  12BF'   79                    	MOV	A,C		; the lines from the top one to it
  12C0'   C3 1331'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  12C3'                         GP_UP:
  12C3'   3C                    	INR	A
  12C4'   C2 1304'              	JNZ	GP_MID		; 64K bytes or more above
  12C7'   2A 2D82'              	LHLD	ZDIF
  12CA'   EB                    	XCHG
  12CB'   21 0000               	LXI	H,0
  12CE'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  12D1'   7C                    	MOV	A,H
  12D2'   B5                    	ORA	L
  12D3'   CA 1304'              	JZ	GP_MID		; exactly 64K
  12D6'   EB                    	XCHG			; DE = bytes to read
  12D7'   AF                    	XRA	A
  12D8'   32 2D84'              	STA	ZLF
  12DB'   CD 0000*              	CALL	RGET0
  12DE'                         GP_RD:
  12DE'   CD 0000*              	CALL	RDGET		; (keeps DE)
  12E1'   DA 1304'              	JC	GP_MID
  12E4'   FE 0A                 	CPI	LF
  12E6'   C2 12FA'              	JNZ	GP_RN
  12E9'   3A 0000*              	LDA	NEDIT
  12EC'   B7                    	ORA	A
  12ED'   1F                    	RAR
  12EE'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  12F0'   E5                    	PUSH	H
  12F1'   21 2D84'              	LXI	H,ZLF
  12F4'   34                    	INR	M
  12F5'   BE                    	CMP	M		; CY iff more lines than that
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12F6'   E1                    	POP	H
  12F7'   DA 1304'              	JC	GP_MID
  12FA'                         GP_RN:
  12FA'   1B                    	DCX	D
  12FB'   7A                    	MOV	A,D
  12FC'   B3                    	ORA	E
  12FD'   C2 12DE'              	JNZ	GP_RD
  1300'   AF                    	XRA	A		; the top row
  1301'   C3 130E'              	JMP	GP_SET
  1304'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1304'   3E 02                 	MVI	A,2
  1306'   32 0000*              	STA	WFILL		; SCRN.MAC WF_MID: mid-screen, as the rows fall
  1309'   3A 0000*              	LDA	NEDIT
  130C'   B7                    	ORA	A
  130D'   1F                    	RAR			; (no more lines above it than this)
  130E'                         GP_SET:
  130E'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  130F'   26 00                 	MVI	H,0
  1311'   22 0000*              	SHLD	WINROW
  1314'   21 0000               	LXI	H,0
  1317'   22 0000*              	SHLD	LNDLT
  131A'   22 0000*              	SHLD	SKIPR		; (another line: from its first row)
  131D'   CD 07C1'              	CALL	SETFUL		; the window may have paged: full repaint
  1320'                         GP_FIN:
  1320'   CD 1247'              	CALL	ZREST
  1323'   3A 2DAD'              	LDA	GPKEEP
  1326'   B7                    	ORA	A
  1327'   CA 087A'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  132A'   AF                    	XRA	A
  132B'   32 2DAD'              	STA	GPKEEP
  132E'   C3 05BD'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  1331'                         GP_ONS:
  1331'   6F                    	MOV	L,A
  1332'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  1334'   EB                    	XCHG
  1335'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1338'   EB                    	XCHG
  1339'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  133C'   22 0000*              	SHLD	LNDLT
  133F'   3E 01                 	MVI	A,R_MOVE
  1341'   32 2D18'              	STA	RINTENT
  1344'   C3 1320'              	JMP	GP_FIN
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  1347'                         OPPEND:
  1347'   AF                    	XRA	A
  1348'   32 2D4C'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  134B'   3A 2D49'              	LDA	PSAVE
  134E'   FE 63                 	CPI	'c'
  1350'   C2 136D'              	JNZ	OPP_ND
  1353'   79                    	MOV	A,C
  1354'   FE 77                 	CPI	'w'
  1356'   CA 135E'              	JZ	OPP_W
  1359'   FE 57                 	CPI	'W'
  135B'   C2 136D'              	JNZ	OPP_ND
  135E'                         OPP_W:
  135E'   CD 1540'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1361'   DA 136D'              	JC	OPP_ND
  1364'   79                    	MOV	A,C
  1365'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1367'   4F                    	MOV	C,A
  1368'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  136A'   32 2D4C'              	STA	CWEOL		;   char for the next word's: see ESTEP
  136D'                         OPP_ND:
  136D'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  136E'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1370'   C2 1384'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1373'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  1376'   DA 1414'              	JC	OPABRT
  1379'   79                    	MOV	A,C
  137A'   FE 67                 	CPI	'g'
  137C'   C2 1414'              	JNZ	OPABRT
  137F'   3E 01                 	MVI	A,PG
  1381'   32 2D47'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  1384'                         OPP_NG:
  1384'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  1385'   21 2D49'              	LXI	H,PSAVE
  1388'   BE                    	CMP	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1389'   CA 1561'              	JZ	OPLINE
  138C'   79                    	MOV	A,C		; (OPCLS classifies the key)
  138D'   CD 1577'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1390'   DA 1414'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1393'   32 2D4B'              	STA	OPCLSV
  1396'   47                    	MOV	B,A		; B = the class
  1397'   3A 2D49'              	LDA	PSAVE
  139A'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  139C'   C2 13A8'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  139F'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  13A0'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  13A2'   C2 13CA'              	JNZ	OPP_GO
  13A5'   C3 13B3'              	JMP	OPP_NO
  13A8'                         OPP_NC:
  13A8'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  13AA'   C2 13CA'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  13AD'   78                    	MOV	A,B		;   a charwise register would need a type flag
  13AE'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  13B0'   CA 13CA'              	JZ	OPP_GO		;   within a line -- neither of which is built
  13B3'                         OPP_NO:
  13B3'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  13B4'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  13B6'   CA 13C4'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  13B9'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  13BB'   CA 13C4'              	JZ	OPP_SW		;   so swallow it before dropping the command
  13BE'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  13C1'   C2 1414'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  13C4'                         OPP_SW:
  13C4'   CD 01F9'              	CALL	MKGETK
  13C7'   C3 1414'              	JMP	OPABRT
  13CA'                         OPP_GO:
  13CA'   AF                    	XRA	A
  13CB'   32 2D1F'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  13CE'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  13D1'   22 2D4D'              	SHLD	OPSTA
  13D4'   C5                    	PUSH	B
  13D5'   21 2D51'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  13D8'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  13DB'   3A 2D4B'              	LDA	OPCLSV
  13DE'   FE 02                 	CPI	2
  13E0'   CC 1417'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  13E3'   C1                    	POP	B
  13E4'   21 2C5B'              	LXI	H,CMDTAB
  13E7'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  13EA'   3A 2D49'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  13ED'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  13EE'   CA 07A0'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  13F1'   CD 1443'              	CALL	OPSFIX		; where the start is in the window NOW
  13F4'   D2 145F'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  13F7'   22 2D4D'              	SHLD	OPSTA
  13FA'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  13FD'   22 2D4F'              	SHLD	OPEND2
  1400'   3A 2D49'              	LDA	PSAVE
  1403'   FE 79                 	CPI	'y'
  1405'   CA 1ACD'              	JZ	OPYANK		; a yank takes the span without losing it
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1408'   CD 15B2'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  140B'   3A 2D49'              	LDA	PSAVE
  140E'   FE 63                 	CPI	'c'
  1410'   C0                    	RNZ
  1411'   C3 1886'              	JMP	SETINS
  1414'                         OPABRT:				; not a motion -> the operator is dropped and
  1414'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1417'                         OPENDS:
  1417'   2A 2D4D'              	LHLD	OPSTA
  141A'   CD 0624'              	CALL	BOL
  141D'   11 2D54'              	LXI	D,OPSLO
  1420'   CD 1435'              	CALL	OPE_ST
  1423'   2A 2D4D'              	LHLD	OPSTA
  1426'   CD 0654'              	CALL	NLSTART
  1429'   11 2D57'              	LXI	D,OPSHI
  142C'   CD 1435'              	CALL	OPE_ST
  142F'   2A 2D4D'              	LHLD	OPSTA
  1432'   C3 0000*              	JMP	GOTO
  1435'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1435'   D5                    	PUSH	D
  1436'   CD 0000*              	CALL	GOTO
  1439'   E1                    	POP	H
  143A'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  143D'                         CURBD:
  143D'   CD 1211'              	CALL	CURFP
  1440'   EB                    	XCHG
  1441'   47                    	MOV	B,A
  1442'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1443'                         OPSFIX:
  1443'   21 2D51'              	LXI	H,OPSFP
  1446'   CD 03DC'              	CALL	MKLOAD
  1449'   CD 143D'              	CALL	CURBD
  144C'   2A 2DB7'              	LHLD	MKPOS
  144F'   3A 2DB9'              	LDA	MKPOS+2
  1452'   CD 1207'              	CALL	SUB24
  1455'   B4                    	ORA	H
  1456'   B5                    	ORA	L
  1457'   C2 03E9'              	JNZ	MKWIN
  145A'   CD 0000*              	CALL	CUROFF
  145D'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  145E'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  145F'                         OPPGD:
  145F'   47                    	MOV	B,A
  1460'   3A 2D4B'              	LDA	OPCLSV
  1463'   FE 02                 	CPI	2
  1465'   C2 1521'              	JNZ	OPG_NO
  1468'   3A 2D49'              	LDA	PSAVE
  146B'   FE 64                 	CPI	'd'
  146D'   C2 1521'              	JNZ	OPG_NO
  1470'   04                    	INR	B
  1471'   CA 1480'              	JZ	OPG_FW
  1474'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1477'   CD 0624'              	CALL	BOL		;   and the high end is OPSHI as it stands
  147A'   CD 0000*              	CALL	GOTO
  147D'   C3 1498'              	JMP	OPG_GO
  1480'                         OPG_FW:
  1480'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1483'   CD 0654'              	CALL	NLSTART		;   landed on, and the low one is where the
  1486'   11 2D57'              	LXI	D,OPSHI		;   start line began
  1489'   CD 1435'              	CALL	OPE_ST
  148C'   21 2D54'              	LXI	H,OPSLO
  148F'   CD 03DC'              	CALL	MKLOAD
  1492'   CD 03A9'              	CALL	MKPAGE
  1495'   CD 0000*              	CALL	GOTO
  1498'                         OPG_GO:
  1498'   CD 143D'              	CALL	CURBD
  149B'   2A 2D57'              	LHLD	OPSHI
  149E'   3A 2D59'              	LDA	OPSHI+2
  14A1'   CD 1207'              	CALL	SUB24		; A:HL = the bytes to take
  14A4'                         OPG_SV:
  14A4'   22 2D5A'              	SHLD	OPTOGO
  14A7'   32 2D5C'              	STA	OPTOGO+2
  14AA'                         OPG_NX:
  14AA'   CD 06A7'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  14AD'   CD 0000*              	CALL	SUBHD
  14B0'   EB                    	XCHG			; DE = what the window holds past the cursor
  14B1'   2A 2D5A'              	LHLD	OPTOGO
  14B4'   3A 2D5C'              	LDA	OPTOGO+2
  14B7'   B7                    	ORA	A
  14B8'   C2 14EB'              	JNZ	OPG_PG		; 64K or more to go
  14BB'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  14BE'   DA 14EB'              	JC	OPG_PG
  14C1'   CA 14EB'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  14C4'                         OPG_FN:				; the rest of it is here
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  14C4'   E5                    	PUSH	H
  14C5'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  14C8'   CD 0000*              	CALL	CUROFF
  14CB'   22 2D5D'              	SHLD	OPLO
  14CE'   D1                    	POP	D
  14CF'   19                    	DAD	D
  14D0'   22 2D5F'              	SHLD	OPHI
  14D3'   CD 16E5'              	CALL	OPDSPN
  14D6'   CD 0A63'              	CALL	ATEOF
  14D9'   D2 153A'              	JNC	OPMID
  14DC'   CD 1144'              	CALL	ONFST		; deleted to the end of the file: onto the new
  14DF'   CA 153A'              	JZ	OPMID		;   last line, if there is one -- and the pager
  14E2'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  14E5'   CD 0000*              	CALL	SETBWD
  14E8'   C3 153A'              	JMP	OPMID
  14EB'                         OPG_PG:
  14EB'   7A                    	MOV	A,D
  14EC'   B3                    	ORA	E
  14ED'   C2 1506'              	JNZ	OPG_DL
  14F0'   CD 0A63'              	CALL	ATEOF		; nothing held past the cursor
  14F3'   21 0000               	LXI	H,0
  14F6'   DA 14C4'              	JC	OPG_FN		; ... and no more to come: the file ran out
  14F9'   2B                    	DCX	H
  14FA'   CD 0000*              	CALL	SETC0
  14FD'   CD 0000*              	CALL	GOLINE
  1500'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1503'   C3 14AA'              	JMP	OPG_NX
  1506'                         OPG_DL:
  1506'   D5                    	PUSH	D
  1507'   21 FFFF               	LXI	H,0FFFFH
  150A'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  150D'   E1                    	POP	H
  150E'   E5                    	PUSH	H
  150F'   CD 0000*              	CALL	DELFWD
  1512'   D1                    	POP	D
  1513'   06 00                 	MVI	B,0
  1515'   2A 2D5A'              	LHLD	OPTOGO
  1518'   3A 2D5C'              	LDA	OPTOGO+2
  151B'   CD 1207'              	CALL	SUB24
  151E'   C3 14A4'              	JMP	OPG_SV
  1521'                         OPG_NO:
  1521'   0E 07                 	MVI	C,BEL
  1523'   CD 0000*              	CALL	BCONOU
  1526'                         OPG_HM:				; the cursor back where the command found it
  1526'   21 2D51'              	LXI	H,OPSFP
  1529'   CD 03DC'              	CALL	MKLOAD
  152C'   CD 03A9'              	CALL	MKPAGE
  152F'   CD 0000*              	CALL	GOTO
  1532'   AF                    	XRA	A
  1533'   32 2D49'              	STA	PSAVE
  1536'   3C                    	INR	A
  1537'   32 2DAD'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  153A'                         OPMID:
  153A'   CD 1234'              	CALL	ZSAVE
  153D'   C3 1304'              	JMP	GP_MID
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1540'                         ONWHIT:
  1540'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1543'   CA 155F'              	JZ	OW_YES
  1546'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1549'   FE 20                 	CPI	' '
  154B'   CA 155F'              	JZ	OW_YES
  154E'   FE 09                 	CPI	TAB
  1550'   CA 155F'              	JZ	OW_YES
  1553'   FE 0D                 	CPI	CR
  1555'   CA 155F'              	JZ	OW_YES
  1558'   FE 0A                 	CPI	LF
  155A'   CA 155F'              	JZ	OW_YES
  155D'   B7                    	ORA	A		; a char to change: CY clear
  155E'   C9                    	RET
  155F'                         OW_YES:
  155F'   37                    	STC
  1560'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1561'                         OPLINE:
  1561'   3A 2D49'              	LDA	PSAVE
  1564'   FE 63                 	CPI	'c'
  1566'   CA 07A0'              	JZ	SETMOV
  1569'   FE 79                 	CPI	'y'
  156B'   CA 1AAC'              	JZ	VY_YY
  156E'   21 2D51'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1571'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1574'   C3 1A22'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1577'                         OPCLS:
  1577'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1579'   CA 1586'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  157C'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  157E'   C2 159A'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1581'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1583'   C3 1588'              	JMP	OPC_FK
  1586'                         OPC_SEM:
  1586'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1588'                         OPC_FK:
  1588'   3A 2DA3'              	LDA	FNDKND
  158B'   B7                    	ORA	A
  158C'   37                    	STC
  158D'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


                                				;   made
  158E'   A8                    	XRA	B		; ... and now the direction ',' asked for
  158F'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1591'   CA 1598'              	JZ	OPC_EXC
  1594'   3E 01                 	MVI	A,1
  1596'   B7                    	ORA	A		; CY clear: a motion, class 1
  1597'   C9                    	RET
  1598'                         OPC_EXC:
  1598'   AF                    	XRA	A		; class 0, CY clear
  1599'   C9                    	RET
  159A'                         OPC_TB:
  159A'   47                    	MOV	B,A
  159B'   21 177A'              	LXI	H,OPCTAB
  159E'                         OPC_LP:
  159E'   7E                    	MOV	A,M
  159F'   B7                    	ORA	A
  15A0'   CA 15B0'              	JZ	OPC_MS		; end of table -> not a motion
  15A3'   B8                    	CMP	B
  15A4'   CA 15AC'              	JZ	OPC_HT
  15A7'   23                    	INX	H
  15A8'   23                    	INX	H
  15A9'   C3 159E'              	JMP	OPC_LP
  15AC'                         OPC_HT:
  15AC'   23                    	INX	H
  15AD'   7E                    	MOV	A,M		; class byte
  15AE'   B7                    	ORA	A		; clear CY
  15AF'   C9                    	RET
  15B0'                         OPC_MS:
  15B0'   37                    	STC
  15B1'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  15B2'                         OPAPPL:
  15B2'   3A 2D4B'              	LDA	OPCLSV
  15B5'   FE 02                 	CPI	2
  15B7'   CA 174E'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  15BA'   2A 2D4D'              	LHLD	OPSTA
  15BD'   EB                    	XCHG			; DE = start
  15BE'   2A 2D4F'              	LHLD	OPEND2		; HL = end
  15C1'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  15C4'   DA 15D7'              	JC	OPA_F
  15C7'   CA 15D7'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  15CA'   22 2D5D'              	SHLD	OPLO
  15CD'   EB                    	XCHG
  15CE'   22 2D5F'              	SHLD	OPHI
  15D1'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  15D4'   C3 168E'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  15D7'                         OPA_F:
  15D7'   EB                    	XCHG			; HL = start, DE = end
  15D8'   22 2D5D'              	SHLD	OPLO
  15DB'   EB                    	XCHG			; HL = end
  15DC'   3A 2D4B'              	LDA	OPCLSV
  15DF'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  15E1'   CA 168B'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  15E4'   FE 01                 	CPI	1
  15E6'   C2 1608'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  15E9'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  15EA'   22 2D5F'              	SHLD	OPHI		; park it: CEND clobbers DE
  15ED'   2B                    	DCX	H		; the line it landed on
  15EE'   CD 1804'              	CALL	CEND		; HL = that line's content end
  15F1'   EB                    	XCHG			; DE = it
  15F2'   2A 2D5F'              	LHLD	OPHI		; HL = hi
  15F5'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  15F8'   D2 1613'              	JNC	OPA_HI		; hi is inside the line: keep it
  15FB'   2A 2D5D'              	LHLD	OPLO
  15FE'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1601'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1604'   EB                    	XCHG			; HL = the content end: the span stops there
  1605'   C3 1613'              	JMP	OPA_HI
  1608'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1608'   22 2D5F'              	SHLD	OPHI
  160B'   3A 2D1F'              	LDA	WPULL
  160E'   B7                    	ORA	A
  160F'   CA 168E'              	JZ	OPA_C1
  1612'   23                    	INX	H
  1613'                         OPA_HI:
  1613'   22 2D5F'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1616'                         OPA_DO:
  1616'   CD 16DA'              	CALL	OPSPNL
  1619'   7C                    	MOV	A,H
  161A'   B5                    	ORA	L
  161B'   C2 1624'              	JNZ	OPA_D1
  161E'   2A 2D5D'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1621'   C3 0000*              	JMP	GOTO		;   to where the span starts
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1624'                         OPA_D1:
  1624'   3A 2D49'              	LDA	PSAVE
  1627'   FE 63                 	CPI	'c'
  1629'   CA 16E5'              	JZ	OPDSPN
  162C'   CD 16CD'              	CALL	SPNBRK
  162F'   D2 1650'              	JNC	OPA_D2
  1632'   2A 2D5F'              	LHLD	OPHI
  1635'   CD 1804'              	CALL	CEND
  1638'   EB                    	XCHG			; DE = the content end of the line it ends in
  1639'   2A 2D5F'              	LHLD	OPHI
  163C'                         OPA_BL:
  163C'   CD 0000*              	CALL	CMP16
  163F'   CA 1656'              	JZ	OPA_BI		; only blanks after it
  1642'   D5                    	PUSH	D
  1643'   E5                    	PUSH	H
  1644'   CD 0000*              	CALL	CHARAT
  1647'   E1                    	POP	H
  1648'   D1                    	POP	D
  1649'   23                    	INX	H
  164A'   CD 1685'              	CALL	BLANKQ
  164D'   CA 163C'              	JZ	OPA_BL
  1650'                         OPA_D2:
  1650'   CD 16E5'              	CALL	OPDSPN
  1653'   C3 1815'              	JMP	CLAMPE
  1656'                         OPA_BI:
  1656'   CD 1668'              	CALL	LOIND
  1659'   C2 1650'              	JNZ	OPA_D2
  165C'   2A 2D5F'              	LHLD	OPHI
  165F'   CD 0654'              	CALL	NLSTART
  1662'   22 2D5F'              	SHLD	OPHI
  1665'   C3 16B9'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  1668'                         LOIND:
  1668'   2A 2D5D'              	LHLD	OPLO
  166B'   CD 0624'              	CALL	BOL
  166E'                         LI_LP:
  166E'   E5                    	PUSH	H
  166F'   EB                    	XCHG
  1670'   2A 2D5D'              	LHLD	OPLO
  1673'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1676'   E1                    	POP	H
  1677'   C8                    	RZ
  1678'   E5                    	PUSH	H
  1679'   CD 0000*              	CALL	CHARAT
  167C'   E1                    	POP	H
  167D'   23                    	INX	H
  167E'   CD 1685'              	CALL	BLANKQ
  1681'   CA 166E'              	JZ	LI_LP
  1684'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1685'                         BLANKQ:
  1685'   FE 20                 	CPI	' '
  1687'   C8                    	RZ
  1688'   FE 09                 	CPI	TAB
  168A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  168B'                         OPA_JP:
  168B'   22 2D5F'              	SHLD	OPHI
  168E'                         OPA_C1:
  168E'   CD 16DA'              	CALL	OPSPNL
  1691'   7C                    	MOV	A,H
  1692'   B5                    	ORA	L
  1693'   CA 1616'              	JZ	OPA_DO		; nothing spanned
  1696'   2A 2D5F'              	LHLD	OPHI
  1699'   CD 0624'              	CALL	BOL
  169C'   EB                    	XCHG
  169D'   2A 2D5F'              	LHLD	OPHI
  16A0'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  16A3'   C2 1616'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  16A6'   CD 1668'              	CALL	LOIND
  16A9'   CA 16B9'              	JZ	C1_LW		; only blanks before lo: whole lines
  16AC'                         C1_CH:
  16AC'   2A 2D5F'              	LHLD	OPHI		; back over the line break to the content end
  16AF'   2B                    	DCX	H		;   of the line before
  16B0'   CD 1804'              	CALL	CEND
  16B3'   22 2D5F'              	SHLD	OPHI
  16B6'   C3 1616'              	JMP	OPA_DO
  16B9'                         C1_LW:
  16B9'   2A 2D5D'              	LHLD	OPLO
  16BC'   CD 0624'              	CALL	BOL
  16BF'   22 2D5D'              	SHLD	OPLO
  16C2'   3A 2D49'              	LDA	PSAVE
  16C5'   FE 63                 	CPI	'c'
  16C7'   CA 16AC'              	JZ	C1_CH
  16CA'   C3 1761'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  16CD'                         SPNBRK:
  16CD'   2A 2D5D'              	LHLD	OPLO
  16D0'   CD 0637'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  16D3'   EB                    	XCHG			; DE = it
  16D4'   2A 2D5F'              	LHLD	OPHI
  16D7'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  16DA'                         OPSPNL:
  16DA'   2A 2D5F'              	LHLD	OPHI
  16DD'   EB                    	XCHG
  16DE'   2A 2D5D'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16E1'   EB                    	XCHG			; HL = hi, DE = lo
  16E2'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  16E5'                         OPDSPN:
  16E5'   CD 16CD'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  16E8'   F5                    	PUSH	PSW
  16E9'   2A 2D5D'              	LHLD	OPLO
  16EC'   CD 0000*              	CALL	GOTO
  16EF'   CD 16DA'              	CALL	OPSPNL		; HL = hi - lo
  16F2'   CD 0000*              	CALL	DELFWD
  16F5'   CD 0174'              	CALL	MARKMOD
  16F8'   F1                    	POP	PSW
  16F9'   DA 07C1'              	JC	SETFUL		; a break went: every row below it moved up
  16FC'   C3 07A6'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  16FF'                         UNDFNB:
  16FF'   CD 0000*              	CALL	CUROFF
  1702'   E5                    	PUSH	H
  1703'   CD 087A'              	CALL	FNBLNK
  1706'   CD 0000*              	CALL	CUROFF
  1709'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  170A'   CD 0000*              	CALL	CMP16
  170D'   D2 0000*              	JNC	UNDHER
  1710'   EB                    	XCHG
  1711'   CD 0000*              	CALL	GOTO
  1714'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1717'                         OPALSP:
  1717'   2A 2D4D'              	LHLD	OPSTA
  171A'   EB                    	XCHG
  171B'   2A 2D4F'              	LHLD	OPEND2
  171E'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1721'   DA 1731'              	JC	OPAL_F
  1724'   22 2D5D'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1727'   EB                    	XCHG
  1728'   22 2D5F'              	SHLD	OPHI		; hi-src = start
  172B'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  172E'   C3 173B'              	JMP	OPAL_R
  1731'                         OPAL_F:
  1731'   EB                    	XCHG			; HL = start
  1732'   22 2D5D'              	SHLD	OPLO		; lo-src = start
  1735'   2A 2D4F'              	LHLD	OPEND2
  1738'   22 2D5F'              	SHLD	OPHI		; hi-src = end
  173B'                         OPAL_R:
  173B'   2A 2D5D'              	LHLD	OPLO
  173E'   CD 0624'              	CALL	BOL
  1741'   22 2D5D'              	SHLD	OPLO		; lo = BOL(low line)
  1744'   2A 2D5F'              	LHLD	OPHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1747'   CD 0654'              	CALL	NLSTART
  174A'   22 2D5F'              	SHLD	OPHI		; hi = start of line past the high line
  174D'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  174E'                         OPALIN:
  174E'   CD 1717'              	CALL	OPALSP
  1751'   2A 2D5D'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  1754'   CD 0654'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  1757'   EB                    	XCHG			;   the column)
  1758'   2A 2D5F'              	LHLD	OPHI
  175B'   CD 0000*              	CALL	CMP16
  175E'   CC 16FF'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1761'                         OPDLIN:
  1761'   CD 16E5'              	CALL	OPDSPN
  1764'   CD 06A7'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1767'   DA 1777'              	JC	OPDL_NB
  176A'   CD 0000*              	CALL	LOGLEN
  176D'   7C                    	MOV	A,H
  176E'   B5                    	ORA	L
  176F'   C8                    	RZ			; empty buffer
  1770'   2B                    	DCX	H
  1771'   CD 0624'              	CALL	BOL
  1774'   CD 0000*              	CALL	GOTO
  1777'                         OPDL_NB:
  1777'   C3 087A'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  177A'                         OPCTAB:
  177A'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  177E'   62 00 42 00           
  1782'   68 00 6C 00           
  1786'   30 00 5E 00           
  178A'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  178C'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1790'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1794'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                				;   these two only have to be IN the table
  1798'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  179C'   24 01                 
  179E'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  17A2'   47 02 48 02           
  17A6'   4D 02 4C 02           
  17AA'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  17AC'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  17AE'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  17AF'                         VCB_C:
  17AF'   CD 17BB'              	CALL	VCB_CD
  17B2'   C3 1886'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  17B5'                         VCB_D:
  17B5'   CD 17BB'              	CALL	VCB_CD
  17B8'   C3 1815'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  17BB'                         VCB_CD:
  17BB'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  17BE'   22 2D5D'              	SHLD	OPLO
  17C1'   CD 0000*              	CALL	CUROFF
  17C4'   CD 1804'              	CALL	CEND		; to the line's content end, the CR,LF left
  17C7'   22 2D5F'              	SHLD	OPHI
  17CA'   C3 16E5'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  17CD'                         VC_X:
  17CD'   CD 092C'              	CALL	GLSTAL
  17D0'   CD 07A6'              	CALL	SETLIN
  17D3'   CD 06CB'              	CALL	GETCNT
  17D6'   22 2D61'              	SHLD	CNTV
  17D9'   CD 0000*              	CALL	CUROFF
  17DC'   22 2D65'              	SHLD	WKI		; cur
  17DF'   CD 1804'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  17E2'   EB                    	XCHG			; DE = contentend
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17E3'   2A 2D65'              	LHLD	WKI		; HL = cur
  17E6'   EB                    	XCHG			; HL = contentend, DE = cur
  17E7'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  17EA'   7C                    	MOV	A,H
  17EB'   B5                    	ORA	L
  17EC'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  17ED'   EB                    	XCHG			; DE = available
  17EE'   2A 2D61'              	LHLD	CNTV		; HL = count
  17F1'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  17F4'   DA 17FA'              	JC	VX_USEA
  17F7'   C3 17FB'              	JMP	VX_DEL		; count <= available -> HL = count = del
  17FA'                         VX_USEA:
  17FA'   EB                    	XCHG			; HL = available
  17FB'                         VX_DEL:
  17FB'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  17FE'   CD 0174'              	CALL	MARKMOD
  1801'   C3 1815'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1804'                         CEND:
  1804'   CD 0637'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1807'   7C                    	MOV	A,H
  1808'   B5                    	ORA	L
  1809'   C8                    	RZ			; the start of the text: nothing before it
  180A'   2B                    	DCX	H
  180B'   E5                    	PUSH	H
  180C'   CD 0000*              	CALL	CHARAT
  180F'   E1                    	POP	H		; HL = term-1
  1810'   FE 0D                 	CPI	CR
  1812'   C8                    	RZ			; a CR before the LF -> the content ends there
  1813'   23                    	INX	H
  1814'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1815'                         CLAMPE:
  1815'   CD 0000*              	CALL	CUROFF
  1818'   E5                    	PUSH	H
  1819'   CD 0663'              	CALL	EOLC
  181C'   D1                    	POP	D		; DE = cur
  181D'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1820'   D8                    	RC
  1821'   C8                    	RZ
  1822'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1825'                         VC_I:
  1825'   CD 06CB'              	CALL	GETCNT
  1828'   C3 1883'              	JMP	SETINM
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  182B'                         VC_A:
  182B'   CD 06CB'              	CALL	GETCNT
  182E'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1831'   CA 1848'              	JZ	VA_INS
  1834'   EB                    	XCHG			; HL = cur
  1835'   E5                    	PUSH	H
  1836'   CD 0000*              	CALL	CHARAT
  1839'   E1                    	POP	H
  183A'   FE 0A                 	CPI	LF
  183C'   CA 1848'              	JZ	VA_INS		; on the line terminator -> append in place
  183F'   FE 0D                 	CPI	CR
  1841'   CA 1848'              	JZ	VA_INS
  1844'   23                    	INX	H
  1845'   CD 0000*              	CALL	GOTO
  1848'                         VA_INS:
  1848'   C3 1883'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  184B'                         VCB_A:
  184B'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  184E'   CD 0663'              	CALL	EOLC		; HL = last content char (the start when empty)
  1851'   E5                    	PUSH	H
  1852'   CD 0000*              	CALL	CHARAT
  1855'   E1                    	POP	H
  1856'   FE 0D                 	CPI	CR
  1858'   CA 1861'              	JZ	VBA_IN		; an empty line: insert at its start
  185B'   FE 0A                 	CPI	LF
  185D'   CA 1861'              	JZ	VBA_IN
  1860'   23                    	INX	H		; past the last content char
  1861'                         VBA_IN:
  1861'   CD 0000*              	CALL	GOTO
  1864'   C3 1883'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1867'                         VCB_I:
  1867'   CD 06CB'              	CALL	GETCNT
  186A'   CD 087A'              	CALL	FNBLNK
  186D'   CD 0000*              	CALL	CUROFF
  1870'   E5                    	PUSH	H
  1871'   CD 0000*              	CALL	CHARAT
  1874'   E1                    	POP	H
  1875'   FE 20                 	CPI	' '
  1877'   CA 187F'              	JZ	VBI_SK
  187A'   FE 09                 	CPI	TAB
  187C'   C2 1883'              	JNZ	SETINM
  187F'                         VBI_SK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  187F'   23                    	INX	H		; blanks only: past the last of them
  1880'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1883'                         SETINM:
  1883'   CD 07A0'              	CALL	SETMOV
  1886'                         SETINS:
  1886'   3E 01                 	MVI	A,EM_INS
  1888'   32 2D13'              	STA	EDMODE
  188B'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  188C'                         ATCEND:
  188C'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  188F'   C8                    	RZ
  1890'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1893'   FE 0D                 	CPI	CR
  1895'   C8                    	RZ
  1896'   FE 0A                 	CPI	LF
  1898'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1899'                         OPNBRK:
  1899'   CD 2190'              	CALL	PUTBRK
  189C'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  189F'   23                    	INX	H
  18A0'   22 0000*              	SHLD	LNDLT
  18A3'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  18A6'                         ENDBRK:
  18A6'   CD 06A7'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  18A9'   C0                    	RNZ
  18AA'   CD 1899'              	CALL	OPNBRK
  18AD'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18B0'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  18B1'   2B                    	DCX	H		;   line, with its own terminator after it
  18B2'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  18B5'                         VC_O:
  18B5'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18B8'   CD 1804'              	CALL	CEND
  18BB'   CD 0000*              	CALL	GOTO
  18BE'   CD 1899'              	CALL	OPNBRK
  18C1'   CD 18A6'              	CALL	ENDBRK		; a last line with no line end: the opened line
  18C4'   CD 07AC'              	CALL	SETILN		;   needs a terminator of its own to exist
  18C7'   C3 1886'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  18CA'                         VCB_O:
  18CA'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18CD'   CD 0624'              	CALL	BOL
  18D0'   CD 0000*              	CALL	GOTO
  18D3'   CD 1899'              	CALL	OPNBRK
  18D6'   CD 0000*              	CALL	CUROFF
  18D9'   2B                    	DCX	H
  18DA'   2B                    	DCX	H
  18DB'   CD 0000*              	CALL	GOTO
  18DE'   CD 07AC'              	CALL	SETILN
  18E1'   C3 1886'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  18E4'                         VCB_J:
  18E4'   CD 06BE'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  18E7'   CD 1804'              	CALL	CEND		; the join point: this line's content end
  18EA'   22 2D5D'              	SHLD	OPLO
  18ED'   CD 0000*              	CALL	CUROFF
  18F0'   CD 0654'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  18F3'   E5                    	PUSH	H
  18F4'   CD 0000*              	CALL	LOGLEN
  18F7'   D1                    	POP	D		; DE = that start
  18F8'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  18FB'   CA 07A0'              	JZ	SETMOV
  18FE'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  18FF'                         VJ_WS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  18FF'   E5                    	PUSH	H
  1900'   CD 0000*              	CALL	LOGLEN
  1903'   D1                    	POP	D		; DE = the scan
  1904'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1907'   CA 191E'              	JZ	VJ_DEL
  190A'   EB                    	XCHG			; HL = the scan
  190B'   E5                    	PUSH	H
  190C'   CD 0000*              	CALL	CHARAT
  190F'   E1                    	POP	H
  1910'   FE 20                 	CPI	' '
  1912'   CA 191A'              	JZ	VJ_SKIP
  1915'   FE 09                 	CPI	TAB
  1917'   C2 191E'              	JNZ	VJ_DEL
  191A'                         VJ_SKIP:
  191A'   23                    	INX	H
  191B'   C3 18FF'              	JMP	VJ_WS
  191E'                         VJ_DEL:
  191E'   22 2D5F'              	SHLD	OPHI
  1921'   CD 16E5'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1924'   CD 07BB'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1927'   CD 06A7'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  192A'   CA 1815'              	JZ	CLAMPE
  192D'   CD 06B2'              	CALL	CURCHR		; the first char of what was appended
  1930'   FE 0D                 	CPI	CR
  1932'   CA 1815'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1935'   FE 0A                 	CPI	LF
  1937'   CA 1815'              	JZ	CLAMPE
  193A'   FE 29                 	CPI	')'
  193C'   CA 1815'              	JZ	CLAMPE		; vim puts no space before a ')'
  193F'   CD 0000*              	CALL	CUROFF
  1942'   7C                    	MOV	A,H
  1943'   B5                    	ORA	L
  1944'   CA 195A'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1947'   2B                    	DCX	H
  1948'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  194B'   FE 20                 	CPI	' '
  194D'   CA 1815'              	JZ	CLAMPE
  1950'   FE 09                 	CPI	TAB
  1952'   CA 1815'              	JZ	CLAMPE
  1955'   FE 0A                 	CPI	LF
  1957'   CA 1815'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  195A'                         VJ_SP:
  195A'   3E 20                 	MVI	A,' '
  195C'   CD 0000*              	CALL	PUTGAP
  195F'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1962'   2B                    	DCX	H
  1963'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1966'                         VC_TILD:
  1966'   CD 06CB'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1969'   CD 07A6'              	CALL	SETLIN		; only this row changes
  196C'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  196F'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1972'   CA 07A0'              	JZ	SETMOV
  1975'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  1978'   FE 0D                 	CPI	CR
  197A'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to toggle
  197D'   FE 0A                 	CPI	LF
  197F'   CA 07A0'              	JZ	SETMOV
  1982'   47                    	MOV	B,A
  1983'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1985'   FE 41                 	CPI	'A'
  1987'   DA 1993'              	JC	VT_PUT		; below 'A': no case
  198A'   FE 5B                 	CPI	'Z'+1
  198C'   D2 1993'              	JNC	VT_PUT		; above 'Z': no case
  198F'   78                    	MOV	A,B
  1990'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1992'   47                    	MOV	B,A
  1993'                         VT_PUT:
  1993'   78                    	MOV	A,B
  1994'   32 2D6E'              	STA	VRCH		; the calls below do not preserve B
  1997'   CD 0174'              	CALL	MARKMOD
  199A'   21 0001               	LXI	H,1
  199D'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19A0'   3A 2D6E'              	LDA	VRCH
  19A3'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  19A6'   C3 1815'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  19A9'                         VC_R:
  19A9'   CD 06B8'              	CALL	MOVCNT		; a cursor motion, and its count
  19AC'   3E 03                 	MVI	A,PR
  19AE'   32 2D46'              	STA	GPEND
  19B1'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  19B2'                         VR_DO:
  19B2'   AF                    	XRA	A
  19B3'   32 2D46'              	STA	GPEND
  19B6'   79                    	MOV	A,C
  19B7'   32 2D6E'              	STA	VRCH		; the calls below do not preserve C
  19BA'   CD 07A6'              	CALL	SETLIN		; only this row changed
  19BD'   CD 092C'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  19C0'   CD 06A7'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19C3'   CA 07A0'              	JZ	SETMOV		; the end of the text: vim does nothing
  19C6'   CD 06B2'              	CALL	CURCHR		; A = the char under the cursor
  19C9'   FE 0D                 	CPI	CR
  19CB'   CA 07A0'              	JZ	SETMOV		; the line's end: nothing to replace
  19CE'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19D0'   CA 07A0'              	JZ	SETMOV
  19D3'   CD 0174'              	CALL	MARKMOD
  19D6'   21 0001               	LXI	H,1
  19D9'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  19DC'   3A 2D6E'              	LDA	VRCH
  19DF'   FE 0D                 	CPI	CR
  19E1'   CA 19EE'              	JZ	VR_CR
  19E4'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  19E7'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  19EA'   2B                    	DCX	H		;   out, which moves every logical offset
  19EB'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  19EE'                         VR_CR:
  19EE'   CD 1899'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  19F1'   CD 18A6'              	CALL	ENDBRK		;   replaced char may have been the text's last
  19F4'   CD 07AC'              	CALL	SETILN		;   row above it lost the char that was replaced,
  19F7'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  19F9'   32 2D1B'              	STA	ILABOV
  19FC'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  19FD'                         VCB_R:
  19FD'   CD 06CB'              	CALL	GETCNT
  1A00'   CD 07A0'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1A03'   21 0000               	LXI	H,0
  1A06'   22 2D6F'              	SHLD	RPDEL		; nothing of ours to put back yet
  1A09'   22 2D71'              	SHLD	RPAPP
  1A0C'   3E 02                 	MVI	A,EM_REP
  1A0E'   32 2D13'              	STA	EDMODE
  1A11'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1A12'                         VC_D:
  1A12'   3E 64                 	MVI	A,'d'
  1A14'   32 2D48'              	STA	PENDOP
  1A17'   C3 07A0'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1A1A'                         VC_C:
  1A1A'   3E 63                 	MVI	A,'c'
  1A1C'   32 2D48'              	STA	PENDOP
  1A1F'   C3 07A0'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1A22'                         VD_DD:
  1A22'   CD 092C'              	CALL	GLSTAL
  1A25'   CD 06CB'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A28'   22 2D61'              	SHLD	CNTV
  1A2B'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1A2D'   32 2D4A'              	STA	DDSNG
  1A30'   2B                    	DCX	H
  1A31'   7C                    	MOV	A,H
  1A32'   B5                    	ORA	L
  1A33'   C2 1A41'              	JNZ	VDD_LS
  1A36'   3E 01                 	MVI	A,1
  1A38'   32 2D4A'              	STA	DDSNG
  1A3B'   CD 16FF'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1A3E'   C3 1A47'              	JMP	VDD_GO
  1A41'                         VDD_LS:
  1A41'   CD 08E5'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1A44'   DA 07A0'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1A47'                         VDD_GO:
  1A47'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1A4A'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1A4D'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1A50'   CD 23F3'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1A53'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1A56'   2A 2D61'              	LHLD	CNTV
  1A59'   CD 0000*              	CALL	SETC0
  1A5C'                         VDD_FW:
  1A5C'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1A5F'   DA 1BAD'              	JC	QREFUS		; ... which has no room for them
  1A62'   CD 06E0'              	CALL	CNTTST
  1A65'   C2 1A5C'              	JNZ	VDD_FW
  1A68'   CD 0174'              	CALL	MARKMOD
  1A6B'   CD 0A63'              	CALL	ATEOF
  1A6E'   D2 1A89'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1A71'   3E 00                 	MVI	A,0
  1A73'   32 2D4A'              	STA	DDSNG		; deleted to the end: full repaint
  1A76'   CD 1144'              	CALL	ONFST
  1A79'   CA 087A'              	JZ	FNBLNK		; nothing left before it
  1A7C'   21 0001               	LXI	H,1		; onto the new last line
  1A7F'   CD 0000*              	CALL	SETBWD
  1A82'   2A 0000*              	LHLD	LNDLT
  1A85'   2B                    	DCX	H
  1A86'   22 0000*              	SHLD	LNDLT
  1A89'                         VDD_UP:
  1A89'   CD 087A'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1A8C'   3A 2D4A'              	LDA	DDSNG
  1A8F'   B7                    	ORA	A
  1A90'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1A91'   3E 03                 	MVI	A,R_DLIN
  1A93'   32 2D18'              	STA	RINTENT
  1A96'   C9                    	RET
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1A97'                         QEMPTY:
  1A97'   2A 0000*              	LHLD	QBEG
  1A9A'   EB                    	XCHG
  1A9B'   2A 0000*              	LHLD	QEND
  1A9E'   7C                    	MOV	A,H
  1A9F'   BA                    	CMP	D
  1AA0'   C0                    	RNZ
  1AA1'   7D                    	MOV	A,L
  1AA2'   BB                    	CMP	E
  1AA3'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1AA4'                         VC_Y:
  1AA4'   3E 79                 	MVI	A,'y'
  1AA6'   32 2D48'              	STA	PENDOP
  1AA9'   C3 07A0'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1AAC'                         VY_YY:
  1AAC'   21 2D51'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1AAF'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1AB2'   CD 0000*              	CALL	CUROFF
  1AB5'   22 2D92'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1AB8'   CD 0624'              	CALL	BOL
  1ABB'   22 2D94'              	SHLD	YPT		; where the lines come from, to put them back
  1ABE'   CD 1C13'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AC1'   CD 1C56'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1AC4'   D2 1C1A'              	JNC	YNDONE
  1AC7'   21 1A22'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1ACA'   C3 1AF6'              	JMP	YKGO
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1ACD'                         OPYANK:
  1ACD'   CD 1717'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1AD0'   2A 2D4D'              	LHLD	OPSTA
  1AD3'   EB                    	XCHG			; DE = start
  1AD4'   2A 2D4F'              	LHLD	OPEND2		; HL = end
  1AD7'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1ADA'   D2 1ADE'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1ADD'   EB                    	XCHG			; ... otherwise the start is
  1ADE'                         OPY_LO:
  1ADE'   22 2D92'              	SHLD	YOFF
  1AE1'   2A 2D5D'              	LHLD	OPLO
  1AE4'   22 2D94'              	SHLD	YPT		; where the lines come from, to put them back
  1AE7'   CD 1C13'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1AEA'   CD 1CCE'              	CALL	YNSPAN		; copied where they lie, if there is room
  1AED'   D2 1C1A'              	JNC	YNDONE
  1AF0'   21 1BD4'              	LXI	H,YSPAN
  1AF3'   C3 1AF6'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1AF6'                         YKGO:
  1AF6'   22 2DBC'              	SHLD	YACT
  1AF9'   2A 2D94'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1AFC'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1AFD'   2A 2D92'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1B00'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1B03'   22 2DC2'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1B06'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1B09'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1B0A'   2A 2D94'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1B0D'   EB                    	XCHG			;   window as it was, then names other text
  1B0E'   E1                    	POP	H
  1B0F'   CD 0000*              	CALL	SUBHD
  1B12'   EB                    	XCHG			; DE = how far behind the cursor they start
  1B13'   CD 1211'              	CALL	CURFP
  1B16'   06 00                 	MVI	B,0
  1B18'   CD 1207'              	CALL	SUB24
  1B1B'   22 2DC4'              	SHLD	YPFP
  1B1E'   32 2DC6'              	STA	YPFP+2
  1B21'   3A 2D17'              	LDA	MODF
  1B24'   32 2D8F'              	STA	YMODF
  1B27'   3A 2D3B'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1B2A'   32 2D90'              	STA	YDCHG		;   a yank must not become the last change
  1B2D'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1B30'   32 2D91'              	STA	YURPL		;   back are not a change to undo either
  1B33'   3E 01                 	MVI	A,1
  1B35'   32 0000*              	STA	UNDRPL
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1B38'   32 2DBB'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1B3B'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1B3E'   22 2D9E'              	SHLD	YLDLT
  1B41'   CD 0000*              	CALL	LOGLEN
  1B44'   22 2DC0'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1B47'   2A 2DBC'              	LHLD	YACT
  1B4A'   CD 1BAC'              	CALL	YCALL		; the lines out of the file, into the register
  1B4D'   3A 2D8A'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1B50'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1B52'   CA 1B90'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1B55'   CD 0000*              	CALL	LOGLEN
  1B58'   EB                    	XCHG
  1B59'   2A 2DC0'              	LHLD	YWAS
  1B5C'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1B5F'   CA 1B71'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1B62'   21 2DC4'              	LXI	H,YPFP		; back to where they came from, by its place in
  1B65'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1B68'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1B6B'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1B6E'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1B71'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1B71'   2A 2DC4'              	LHLD	YPFP		;   cursor is still owed its place)
  1B74'   EB                    	XCHG
  1B75'   2A 2DC2'              	LHLD	YCOL
  1B78'   19                    	DAD	D
  1B79'   22 2DB7'              	SHLD	MKPOS
  1B7C'   3A 2DC6'              	LDA	YPFP+2
  1B7F'   CE 00                 	ACI	0
  1B81'   32 2DB9'              	STA	MKPOS+2
  1B84'   CD 03A9'              	CALL	MKPAGE
  1B87'   CD 0000*              	CALL	GOTO
  1B8A'                         YK_RST:
  1B8A'   2A 2D9E'              	LHLD	YLDLT
  1B8D'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1B90'                         YK_RF:
  1B90'   3A 2D8F'              	LDA	YMODF
  1B93'   32 2D17'              	STA	MODF
  1B96'   3A 2D90'              	LDA	YDCHG
  1B99'   32 2D3B'              	STA	DOTCHG
  1B9C'   3A 2D91'              	LDA	YURPL
  1B9F'   32 0000*              	STA	UNDRPL
  1BA2'   AF                    	XRA	A
  1BA3'   32 2DBB'              	STA	MKHOLD
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BA6'   CD 092C'              	CALL	GLSTAL
  1BA9'   C3 07C1'              	JMP	SETFUL		; the cheap paint cannot carry this
  1BAC'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1BAD'                         QREFUS:
  1BAD'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1BB0'   CD 1A97'              	CALL	QEMPTY
  1BB3'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1BB6'   CD 0000*              	CALL	QKILL
  1BB9'   3A 2DBB'              	LDA	MKHOLD
  1BBC'   B7                    	ORA	A
  1BBD'   C2 1BCC'              	JNZ	QRF_Y
  1BC0'   21 0000*              	LXI	H,MKSAV
  1BC3'   11 0000*              	LXI	D,MKTAB
  1BC6'   CD 23F3'              	CALL	COPY12
  1BC9'   CD 0000*              	CALL	UNDCLR
  1BCC'                         QRF_Y:
  1BCC'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1BCE'   32 2D8A'              	STA	MSGWHT
  1BD1'   C3 1526'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1BD4'                         YSPAN:
  1BD4'   CD 092C'              	CALL	GLSTAL
  1BD7'   CD 16DA'              	CALL	OPSPNL		; HL = the span's length
  1BDA'   22 2DBE'              	SHLD	YTGT
  1BDD'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1BE0'   EB                    	XCHG			; DE = it
  1BE1'   2A 2DBE'              	LHLD	YTGT
  1BE4'   EB                    	XCHG			; HL = the text's, DE = the span's
  1BE5'   CD 0000*              	CALL	SUBHD
  1BE8'   22 2DBE'              	SHLD	YTGT		; what the text is left at when the span is out
  1BEB'   2A 2D5D'              	LHLD	OPLO
  1BEE'   CD 0000*              	CALL	GOTO
  1BF1'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1BF4'                         YS_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BF4'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1BF7'   CD 0000*              	CALL	SETC0
  1BFA'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1BFD'   DA 1BAD'              	JC	QREFUS		; ... which has no room for it
  1C00'   CD 0000*              	CALL	LOGLEN
  1C03'   EB                    	XCHG			; DE = what is left
  1C04'   2A 2DBE'              	LHLD	YTGT
  1C07'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1C0A'   DA 1C10'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1C0D'   C2 1BF4'              	JNZ	YS_LP		;   but never spin here if it ever did
  1C10'                         YS_END:
  1C10'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1C13'                         YNPRE:
  1C13'   2A 0000*              	LHLD	PGTOPM
  1C16'   22 2DC7'              	SHLD	YNPG
  1C19'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1C1A'                         YNDONE:
  1C1A'   2A 2D92'              	LHLD	YOFF
  1C1D'   CD 0000*              	CALL	GOTO
  1C20'   2A 0000*              	LHLD	PGTOPM
  1C23'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C24'   2A 2DC7'              	LHLD	YNPG
  1C27'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1C2A'   C2 07C1'              	JNZ	SETFUL		; it moved under us: repaint after all
  1C2D'   C3 07A0'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1C30'                         YNROOM:
  1C30'   11 0100               	LXI	D,100H
  1C33'   19                    	DAD	D
  1C34'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1C35'   E5                    	PUSH	H		; the span plus its slack
  1C36'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1C39'   EB                    	XCHG			; HL = free
  1C3A'   D1                    	POP	D		; DE = the span plus its slack
  1C3B'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1C3E'   DA 1C46'              	JC	YNR_OK
  1C41'   CA 1C46'              	JZ	YNR_OK
  1C44'   37                    	STC			; not enough: the delete-and-put-back path
  1C45'   C9                    	RET
  1C46'                         YNR_OK:
  1C46'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1C47'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1C48'                         YNGO:
  1C48'   C5                    	PUSH	B
  1C49'   CD 06CB'              	CALL	GETCNT		; spent here: this yank is happening
  1C4C'   CD 092C'              	CALL	GLSTAL
  1C4F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C52'   C1                    	POP	B
  1C53'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1C56'                         YNCOPY:
  1C56'   2A 2D14'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1C59'   7C                    	MOV	A,H		;   the count itself
  1C5A'   B5                    	ORA	L
  1C5B'   C2 1C61'              	JNZ	YNC_HV
  1C5E'   21 0001               	LXI	H,1
  1C61'                         YNC_HV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C61'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1C62'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1C63'   B4                    	ORA	H
  1C64'   CA 1C6F'              	JZ	YNC_M
  1C67'   E5                    	PUSH	H
  1C68'   CD 08E5'              	CALL	ONLAST		; vim: a count over one on the last line does
  1C6B'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1C6C'   DA 1C81'              	JC	YNC_RF
  1C6F'                         YNC_M:
  1C6F'   E5                    	PUSH	H
  1C70'   CD 0863'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1C73'   E1                    	POP	H
  1C74'   CD 1C89'              	CALL	YNLINE		; BC = the span, measured where it stands
  1C77'   D8                    	RC			; not measurable here: let the pager answer it
  1C78'   60                    	MOV	H,B
  1C79'   69                    	MOV	L,C
  1C7A'   CD 1C30'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1C7D'   D8                    	RC			; no: the delete-and-put-back path
  1C7E'   C3 1C48'              	JMP	YNGO
  1C81'                         YNC_RF:
  1C81'   CD 06CB'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1C84'   CD 092C'              	CALL	GLSTAL		;   register alone, and that is the command
  1C87'   B7                    	ORA	A		; NC: done
  1C88'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1C89'                         YNLINE:
  1C89'   22 2DC9'              	SHLD	YNCNT		; the lines it still wants
  1C8C'   2A 0000*              	LHLD	GAPEND
  1C8F'                         YNL_LP:
  1C8F'   EB                    	XCHG			; DE = the scan
  1C90'   2A 0000*              	LHLD	TXTEND
  1C93'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1C96'   EB                    	XCHG			; HL = the scan
  1C97'   D2 1CB7'              	JNC	YNL_EN		; the resident text ran out
  1C9A'   7E                    	MOV	A,M
  1C9B'   23                    	INX	H
  1C9C'   FE 0A                 	CPI	LF
  1C9E'   C2 1C8F'              	JNZ	YNL_LP
  1CA1'   E5                    	PUSH	H
  1CA2'   2A 2DC9'              	LHLD	YNCNT
  1CA5'   2B                    	DCX	H
  1CA6'   22 2DC9'              	SHLD	YNCNT
  1CA9'   7C                    	MOV	A,H
  1CAA'   B5                    	ORA	L
  1CAB'   E1                    	POP	H
  1CAC'   C2 1C8F'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1CAF'   EB                    	XCHG			; DE = past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CB0'   2A 0000*              	LHLD	GAPEND
  1CB3'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1CB4'   C3 1CC5'              	JMP	YNL_BC
  1CB7'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1CB7'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1CBA'   C2 1CCC'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1CBD'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1CC0'   EB                    	XCHG			;   count clamps to it as vim's does
  1CC1'   2A 0000*              	LHLD	GAPEND
  1CC4'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1CC5'                         YNL_BC:
  1CC5'   CD 0000*              	CALL	SUBHD		; HL = the span
  1CC8'   44                    	MOV	B,H
  1CC9'   4D                    	MOV	C,L
  1CCA'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1CCB'   C9                    	RET
  1CCC'                         YNL_NO:
  1CCC'   37                    	STC
  1CCD'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1CCE'                         YNSPAN:
  1CCE'   CD 16DA'              	CALL	OPSPNL		; HL = the span's length
  1CD1'   44                    	MOV	B,H
  1CD2'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1CD3'   CD 1C30'              	CALL	YNROOM
  1CD6'   D8                    	RC			; no room: the delete-and-put-back path
  1CD7'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1CD8'   2A 2D5D'              	LHLD	OPLO
  1CDB'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1CDE'   C1                    	POP	B
  1CDF'   C3 1C48'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1CE2'                         VC_P:
  1CE2'   CD 1A97'              	CALL	QEMPTY
  1CE5'   CA 1DB8'              	JZ	VP_BEL
  1CE8'   CD 06CB'              	CALL	GETCNT
  1CEB'   22 2D96'              	SHLD	PCNT
  1CEE'   CD 0000*              	CALL	CUROFF
  1CF1'   CD 0654'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1CF4'   C3 1D09'              	JMP	VP_GO
  1CF7'                         VCB_P:
  1CF7'   CD 1A97'              	CALL	QEMPTY
  1CFA'   CA 1DB8'              	JZ	VP_BEL
  1CFD'   CD 06CB'              	CALL	GETCNT
  1D00'   22 2D96'              	SHLD	PCNT
  1D03'   CD 0000*              	CALL	CUROFF
  1D06'   CD 0624'              	CALL	BOL
  1D09'                         VP_GO:
  1D09'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1D0C'   CD 0000*              	CALL	CUROFF
  1D0F'   EB                    	XCHG
  1D10'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1D13'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1D16'   DA 1D2B'              	JC	VP_IN
  1D19'   EB                    	XCHG			; HL = the put point = LOGLEN
  1D1A'   7C                    	MOV	A,H
  1D1B'   B5                    	ORA	L
  1D1C'   CA 1D28'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1D1F'   2B                    	DCX	H
  1D20'   CD 0000*              	CALL	CHARAT
  1D23'   FE 0A                 	CPI	LF
  1D25'   CA 1D2B'              	JZ	VP_IN
  1D28'                         VP_BRK:
  1D28'   CD 1899'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1D2B'                         VP_IN:
  1D2B'   21 2D98'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1D2E'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1D31'   CD 125A'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1D34'   2A 0000*              	LHLD	QBEG
  1D37'   EB                    	XCHG
  1D38'   2A 0000*              	LHLD	QEND
  1D3B'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1D3E'   EB                    	XCHG
  1D3F'   22 2D9B'              	SHLD	PLFS
  1D42'   2A 2D96'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1D45'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1D46'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1D47'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1D49'   C2 1D4D'              	JNZ	VP_PZ
  1D4C'   7D                    	MOV	A,L
  1D4D'                         VP_PZ:
  1D4D'   32 2D9D'              	STA	PCPY
  1D50'                         VP_LP:
  1D50'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1D53'   2A 0000*              	LHLD	LNDLT
  1D56'   EB                    	XCHG
  1D57'   2A 2D9B'              	LHLD	PLFS
  1D5A'   19                    	DAD	D
  1D5B'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1D5E'   2A 2D96'              	LHLD	PCNT
  1D61'   2B                    	DCX	H
  1D62'   22 2D96'              	SHLD	PCNT
  1D65'   7C                    	MOV	A,H
  1D66'   B5                    	ORA	L
  1D67'   C2 1D50'              	JNZ	VP_LP
  1D6A'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D6D'   21 2D98'              	LXI	H,PPFP
  1D70'   CD 03DC'              	CALL	MKLOAD
  1D73'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1D76'   D2 1DA9'              	JNC	VP_PGD
  1D79'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1D7C'   CD 092C'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1D7F'   3A 2D9D'              	LDA	PCPY
  1D82'   B7                    	ORA	A
  1D83'   CA 087A'              	JZ	FNBLNK
  1D86'   2A 2D9B'              	LHLD	PLFS
  1D89'   7C                    	MOV	A,H
  1D8A'   B7                    	ORA	A
  1D8B'   C2 087A'              	JNZ	FNBLNK
  1D8E'   3A 2D9D'              	LDA	PCPY
  1D91'   CD 0F13'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1D94'   7C                    	MOV	A,H
  1D95'   B7                    	ORA	A
  1D96'   C2 087A'              	JNZ	FNBLNK
  1D99'   7D                    	MOV	A,L
  1D9A'   B7                    	ORA	A
  1D9B'   CA 087A'              	JZ	FNBLNK
  1D9E'   F5                    	PUSH	PSW
  1D9F'   CD 07AC'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1DA2'   F1                    	POP	PSW
  1DA3'   32 2D19'              	STA	ILN		; ... which the lines put now replace
  1DA6'   C3 087A'              	JMP	FNBLNK
  1DA9'                         VP_PGD:				; the put paged its first line out: page back
  1DA9'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1DAC'   CD 0000*              	CALL	GOTO
  1DAF'   CD 092C'              	CALL	GLSTAL
  1DB2'   CD 1272'              	CALL	GPLACE
  1DB5'   C3 07C1'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1DB8'                         VP_BEL:
  1DB8'   CD 06CB'              	CALL	GETCNT		; the count is spent either way
  1DBB'   0E 07                 	MVI	C,BEL
  1DBD'   CD 0000*              	CALL	BCONOU
  1DC0'   C3 07A0'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1DC3'                         VIREP:
  1DC3'   79                    	MOV	A,C
  1DC4'   FE 1B                 	CPI	ESC
  1DC6'   CA 1EEB'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1DC9'   FE 0D                 	CPI	CR
  1DCB'   CA 1E2F'              	JZ	VP_CR
  1DCE'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1DD0'   CA 1E2F'              	JZ	VP_CR
  1DD3'   FE 08                 	CPI	BS
  1DD5'   CA 1E3B'              	JZ	VP_BS
  1DD8'   FE 7F                 	CPI	DEL
  1DDA'   CA 1E3B'              	JZ	VP_BS
  1DDD'   32 2D6E'              	STA	VRCH		; the calls below do not preserve C
  1DE0'   CD 07A6'              	CALL	SETLIN		; this row changed
  1DE3'   CD 0174'              	CALL	MARKMOD
  1DE6'   CD 188C'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1DE9'   CA 1E21'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1DEC'   3A 2D6E'              	LDA	VRCH
  1DEF'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1DF2'   2A 2D6F'              	LHLD	RPDEL
  1DF5'   7C                    	MOV	A,H
  1DF6'   B5                    	ORA	L
  1DF7'   CA 1E0D'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1DFA'   2A 0000*              	LHLD	GAPEND
  1DFD'   EB                    	XCHG
  1DFE'   2A 2D73'              	LHLD	RPGE
  1E01'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1E04'   CA 1E0D'              	JZ	VP_OVW
  1E07'   21 0000               	LXI	H,0
  1E0A'   22 2D6F'              	SHLD	RPDEL		; the text moved: those originals are gone
  1E0D'                         VP_OVW:
  1E0D'   21 0001               	LXI	H,1
  1E10'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1E13'   2A 0000*              	LHLD	GAPEND
  1E16'   22 2D73'              	SHLD	RPGE
  1E19'   2A 2D6F'              	LHLD	RPDEL
  1E1C'   23                    	INX	H
  1E1D'   22 2D6F'              	SHLD	RPDEL
  1E20'   C9                    	RET
  1E21'                         VP_APP:
  1E21'   3A 2D6E'              	LDA	VRCH
  1E24'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1E27'   2A 2D71'              	LHLD	RPAPP
  1E2A'   23                    	INX	H
  1E2B'   22 2D71'              	SHLD	RPAPP
  1E2E'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E2F'                         VP_CR:
  1E2F'   21 0000               	LXI	H,0
  1E32'   22 2D6F'              	SHLD	RPDEL		; a line break ends what BS can put back
  1E35'   22 2D71'              	SHLD	RPAPP
  1E38'   C3 1EC1'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1E3B'                         VP_BS:
  1E3B'   2A 2D71'              	LHLD	RPAPP
  1E3E'   7C                    	MOV	A,H
  1E3F'   B5                    	ORA	L
  1E40'   CA 1E4D'              	JZ	VP_BSD
  1E43'   2B                    	DCX	H
  1E44'   22 2D71'              	SHLD	RPAPP		; an appended char: it just goes
  1E47'   CD 07A6'              	CALL	SETLIN
  1E4A'   C3 0000*              	JMP	DELPRV
  1E4D'                         VP_BSD:
  1E4D'   2A 2D6F'              	LHLD	RPDEL
  1E50'   7C                    	MOV	A,H
  1E51'   B5                    	ORA	L
  1E52'   CA 1E79'              	JZ	VP_BSM		; nothing of ours left
  1E55'   2A 0000*              	LHLD	GAPEND
  1E58'   EB                    	XCHG
  1E59'   2A 2D73'              	LHLD	RPGE
  1E5C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1E5F'   C2 1E79'              	JNZ	VP_BSM
  1E62'   2A 2D6F'              	LHLD	RPDEL
  1E65'   2B                    	DCX	H
  1E66'   22 2D6F'              	SHLD	RPDEL
  1E69'   CD 07A6'              	CALL	SETLIN
  1E6C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1E6F'   CD 0000*              	CALL	UNDELF		; the original comes back
  1E72'   2A 0000*              	LHLD	GAPEND
  1E75'   22 2D73'              	SHLD	RPGE
  1E78'   C9                    	RET
  1E79'                         VP_BSM:
  1E79'   CD 07A0'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1E7C'   C3 080F'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  1E7F'                         VIINS:
  1E7F'   79                    	MOV	A,C
  1E80'   FE 1B                 	CPI	ESC
  1E82'   CA 1EEB'              	JZ	VI_ESC
  1E85'   FE 0D                 	CPI	CR
  1E87'   CA 1EC1'              	JZ	VI_CR
  1E8A'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1E8C'   CA 1EC1'              	JZ	VI_CR
  1E8F'   FE 08                 	CPI	BS
  1E91'   CA 1ED9'              	JZ	VI_BS
  1E94'   FE 7F                 	CPI	DEL
  1E96'   CA 1ED9'              	JZ	VI_BS
  1E99'   79                    	MOV	A,C
  1E9A'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1E9D'   CD 0174'              	CALL	MARKMOD
  1EA0'   CD 07A6'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1EA3'   79                    	MOV	A,C
  1EA4'   FE 20                 	CPI	' '
  1EA6'   D8                    	RC			; control char -> keep R_LINE
  1EA7'   FE 7F                 	CPI	DEL
  1EA9'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1EAA'   CD 07C7'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1EAD'   B7                    	ORA	A
  1EAE'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1EAF'   3E 04                 	MVI	A,R_ICH
  1EB1'   32 2D18'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1EB4'   CD 188C'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1EB7'   3E 00                 	MVI	A,0
  1EB9'   C2 1EBD'              	JNZ	VI_ICH
  1EBC'   3C                    	INR	A
  1EBD'                         VI_ICH:
  1EBD'   32 2D1A'              	STA	ICHAPP
  1EC0'   C9                    	RET
  1EC1'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1EC1'   CD 188C'              	CALL	ATCEND
  1EC4'   3E 00                 	MVI	A,0
  1EC6'   CA 1ECA'              	JZ	VI_CRS
  1EC9'   3C                    	INR	A
  1ECA'                         VI_CRS:
  1ECA'   F5                    	PUSH	PSW
  1ECB'   CD 1899'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1ECE'   CD 18A6'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1ED1'   CD 07AC'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1ED4'   F1                    	POP	PSW
  1ED5'   32 2D1B'              	STA	ILABOV
  1ED8'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1ED9'                         VI_BS:
  1ED9'   CD 0000*              	CALL	PEEKL
  1EDC'   D8                    	RC			; start of the file: nothing to delete
  1EDD'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1EDF'   CA 1EE5'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1EE2'   CD 07A6'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1EE5'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1EE5'   CD 0174'              	CALL	MARKMOD
  1EE8'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1EEB'                         VI_ESC:
  1EEB'   3E 00                 	MVI	A,EM_CMD
  1EED'   32 2D13'              	STA	EDMODE
  1EF0'   CD 07A0'              	CALL	SETMOV
  1EF3'   CD 080F'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1EF6'   C3 092C'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1EF9'                         RDLINE:
  1EF9'   EB                    	XCHG			; HL = buffer
  1EFA'   22 2D75'              	SHLD	RLPTR
  1EFD'   3E 00                 	MVI	A,0
  1EFF'   32 2D77'              	STA	RLLEN
  1F02'   78                    	MOV	A,B
  1F03'   32 2D78'              	STA	RLMAX
  1F06'   79                    	MOV	A,C
  1F07'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1F0A'                         RL_LP:
  1F0A'   CD 0000*              	CALL	GETKEY
  1F0D'   FE 1B                 	CPI	ESC
  1F0F'   CA 1F5F'              	JZ	RL_CAN
  1F12'   FE 0D                 	CPI	CR
  1F14'   CA 1F6A'              	JZ	RL_DONE
  1F17'   FE 08                 	CPI	BS
  1F19'   CA 1F47'              	JZ	RL_BS
  1F1C'   FE 7F                 	CPI	DEL
  1F1E'   CA 1F47'              	JZ	RL_BS
  1F21'   FE 20                 	CPI	' '
  1F23'   DA 1F0A'              	JC	RL_LP		; control char -> ignore
  1F26'   3A 2D77'              	LDA	RLLEN
  1F29'   47                    	MOV	B,A
  1F2A'   3A 2D78'              	LDA	RLMAX
  1F2D'   B8                    	CMP	B
  1F2E'   CA 1F0A'              	JZ	RL_LP		; full -> ignore
  1F31'   2A 2D75'              	LHLD	RLPTR
  1F34'   71                    	MOV	M,C
  1F35'   23                    	INX	H
  1F36'   22 2D75'              	SHLD	RLPTR
  1F39'   3A 2D77'              	LDA	RLLEN
  1F3C'   3C                    	INR	A
  1F3D'   32 2D77'              	STA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1F40'   79                    	MOV	A,C
  1F41'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1F44'   C3 1F0A'              	JMP	RL_LP
  1F47'                         RL_BS:				; WM LINEPOP
  1F47'   3A 2D77'              	LDA	RLLEN
  1F4A'   B7                    	ORA	A
  1F4B'   CA 1F5F'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1F4E'   3D                    	DCR	A
  1F4F'   32 2D77'              	STA	RLLEN
  1F52'   2A 2D75'              	LHLD	RLPTR
  1F55'   2B                    	DCX	H
  1F56'   22 2D75'              	SHLD	RLPTR
  1F59'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1F5C'   C3 1F0A'              	JMP	RL_LP
  1F5F'                         RL_CAN:
  1F5F'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1F61'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1F64'   CD 07A6'              	CALL	SETLIN		; redraw one row
  1F67'   3E FF                 	MVI	A,0FFH		; cancelled
  1F69'   C9                    	RET
  1F6A'                         RL_DONE:
  1F6A'   AF                    	XRA	A
  1F6B'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  1F6C'                         VC_BZ:
  1F6C'   CD 07A0'              	CALL	SETMOV
  1F6F'   3A 2D47'              	LDA	GSAVE
  1F72'   FE 02                 	CPI	PZ
  1F74'   CA 1F7F'              	JZ	VZ_ZZ
  1F77'   B7                    	ORA	A
  1F78'   C0                    	RNZ			; 'g' was pending: vim drops both
  1F79'   3E 02                 	MVI	A,PZ
  1F7B'   32 2D46'              	STA	GPEND
  1F7E'   C9                    	RET
  1F7F'                         VZ_ZZ:
  1F7F'   3E 04                 	MVI	A,EO_X
  1F81'   32 2D79'              	STA	EXOP
  1F84'   3E 01                 	MVI	A,1
  1F86'   32 2D8C'              	STA	EXBANG		; no '!'
  1F89'   AF                    	XRA	A
  1F8A'   32 2D7A'              	STA	EXARG		; no file name
  1F8D'   3A 2D17'              	LDA	MODF		; as ':x': a changed text is written first
  1F90'   B7                    	ORA	A
  1F91'   CA 20D2'              	JZ	EX_Q
  1F94'   C3 206C'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1F97'                         VC_EX:
  1F97'   CD 06CB'              	CALL	GETCNT
  1F9A'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1F9D'   11 0000*              	LXI	D,EXBUF
  1FA0'   06 28                 	MVI	B,EXMAX
  1FA2'   0E 3A                 	MVI	C,':'
  1FA4'   CD 1EF9'              	CALL	RDLINE
  1FA7'   B7                    	ORA	A
  1FA8'   C0                    	RNZ			; cancelled
  1FA9'   3A 2D77'              	LDA	RLLEN
  1FAC'   5F                    	MOV	E,A
  1FAD'   16 00                 	MVI	D,0
  1FAF'   21 0000*              	LXI	H,EXBUF
  1FB2'   19                    	DAD	D
  1FB3'   36 00                 	MVI	M,0		; the line ends with a 0
  1FB5'   21 0000*              	LXI	H,EXBUF
  1FB8'   CD 2584'              	CALL	SKIPB
  1FBB'   C8                    	RZ			; nothing on it
  1FBC'   22 2D7C'              	SHLD	EXCMD
  1FBF'   CD 2788'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1FC2'   CD 2584'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1FC5'   56                    	MOV	D,M
  1FC6'   23                    	INX	H
  1FC7'   1E 00                 	MVI	E,0
  1FC9'   CD 2590'              	CALL	ISLOW
  1FCC'   DA 1FD7'              	JC	EX_LK
  1FCF'   5F                    	MOV	E,A
  1FD0'   23                    	INX	H
  1FD1'   CD 2590'              	CALL	ISLOW
  1FD4'   D2 1FF0'              	JNC	EX_NOT		; a third letter: none of ours
  1FD7'                         EX_LK:
  1FD7'   E5                    	PUSH	H
  1FD8'   21 276F'              	LXI	H,EXTAB
  1FDB'                         EX_TL:
  1FDB'   7E                    	MOV	A,M
  1FDC'   B7                    	ORA	A
  1FDD'   CA 1FEF'              	JZ	EX_NTP		; not in the table
  1FE0'   23                    	INX	H
  1FE1'   BA                    	CMP	D
  1FE2'   7E                    	MOV	A,M
  1FE3'   23                    	INX	H
  1FE4'   C2 1FEB'              	JNZ	EX_TN
  1FE7'   BB                    	CMP	E
  1FE8'   CA 1FF6'              	JZ	EX_TF
  1FEB'                         EX_TN:
  1FEB'   23                    	INX	H
  1FEC'   C3 1FDB'              	JMP	EX_TL
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FEF'                         EX_NTP:
  1FEF'   E1                    	POP	H
  1FF0'                         EX_NOT:
  1FF0'   21 2648'              	LXI	H,SNOT
  1FF3'   C3 25C5'              	JMP	EXERT
  1FF6'                         EX_TF:
  1FF6'   7E                    	MOV	A,M
  1FF7'   32 2D79'              	STA	EXOP
  1FFA'   E1                    	POP	H
  1FFB'   FE 06                 	CPI	EO_S
  1FFD'   CA 27F7'              	JZ	EX_S		; ':s' reads the rest of the line itself
  2000'   FE 01                 	CPI	EO_W
  2002'   CA 2011'              	JZ	EX_RG		; ':N,Mw name' takes a range
  2005'   FE 08                 	CPI	EO_R
  2007'   CA 2011'              	JZ	EX_RG		; ... and ':Nr name' a line
  200A'   3A 2DD5'              	LDA	SRNGF
  200D'   B7                    	ORA	A
  200E'   C2 1FF0'              	JNZ	EX_NOT		; a range on a command that does not take one
  2011'                         EX_RG:
                                	;--- '!', then the file name ---
  2011'   7E                    	MOV	A,M
  2012'   D6 21                 	SUI	'!'
  2014'   32 2D8C'              	STA	EXBANG		; 0 = '!'
  2017'   C2 201B'              	JNZ	EX_NB
  201A'   23                    	INX	H
  201B'                         EX_NB:
  201B'   CD 2584'              	CALL	SKIPB
  201E'   32 2D7A'              	STA	EXARG		; 0 = no file name
  2021'   CA 203A'              	JZ	EX_RUN
  2024'   22 2D7C'              	SHLD	EXCMD
  2027'   3A 2D79'              	LDA	EXOP
  202A'   FE 02                 	CPI	EO_Q
  202C'   CA 25C2'              	JZ	EX_TRL		; :q takes none
  202F'   FE 07                 	CPI	EO_V
  2031'   CA 25C2'              	JZ	EX_TRL		; nor :ve
  2034'   CD 24EE'              	CALL	PARSFN
  2037'   C2 25B6'              	JNZ	EX_INV
  203A'                         EX_RUN:
  203A'   3A 2D79'              	LDA	EXOP
  203D'   FE 05                 	CPI	EO_E
  203F'   CA 20E9'              	JZ	EX_E
  2042'   FE 02                 	CPI	EO_Q
  2044'   CA 20D2'              	JZ	EX_Q
  2047'   FE 07                 	CPI	EO_V
  2049'   CA 25BC'              	JZ	EX_V
  204C'   FE 08                 	CPI	EO_R
  204E'   CA 227A'              	JZ	EX_R
  2051'   FE 04                 	CPI	EO_X
  2053'   CA 2065'              	JZ	EX_XM
  2056'   FE 01                 	CPI	EO_W
  2058'   C2 206C'              	JNZ	EX_W		; :wq
  205B'   3A 2DD5'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  205E'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  205F'   C2 219A'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2062'   C3 206C'              	JMP	EX_W
  2065'                         EX_XM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2065'   3A 2D17'              	LDA	MODF		; :x writes only a changed text
  2068'   B7                    	ORA	A
  2069'   CA 20D2'              	JZ	EX_Q
  206C'                         EX_W:
  206C'   CD 235A'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  206F'   D8                    	RC			; refused (message shown)
  2070'   32 2D7B'              	STA	EXBAK
  2073'   3A 2D79'              	LDA	EXOP
  2076'   FE 01                 	CPI	EO_W
  2078'   CA 208F'              	JZ	EX_WK
  207B'   3A 2D7B'              	LDA	EXBAK
  207E'   B7                    	ORA	A
  207F'   C2 20CF'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2082'   3A 2D8C'              	LDA	EXBANG
  2085'   B7                    	ORA	A
  2086'   CA 20CF'              	JZ	EX_WQ		; so it does with '!'
  2089'   CD 208F'              	CALL	EX_WK		; else it may not: keep the text
  208C'   C3 20D2'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  208F'                         EX_WK:
  208F'   CD 0D47'              	CALL	CURRW		; the cursor's row and file position
  2092'   32 2D7E'              	STA	WPROW
  2095'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2098'   7D                    	MOV	A,L
  2099'   E6 7F                 	ANI	7FH
  209B'   32 2D7F'              	STA	WPBYT
  209E'   7D                    	MOV	A,L
  209F'   17                    	RAL
  20A0'   7C                    	MOV	A,H
  20A1'   17                    	RAL
  20A2'   5F                    	MOV	E,A
  20A3'   3E 00                 	MVI	A,0
  20A5'   17                    	RAL
  20A6'   57                    	MOV	D,A		; DE = HL / 128
  20A7'   2A 0000*              	LHLD	OUTPOS
  20AA'   19                    	DAD	D
  20AB'   22 2D80'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  20AE'   CD 238F'              	CALL	WRITE
  20B1'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  20B4'   2A 2D80'              	LHLD	WPREC
  20B7'   EB                    	XCHG
  20B8'   3A 2D7F'              	LDA	WPBYT
  20BB'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  20BE'   CD 0000*              	CALL	GOTO
  20C1'                         EX_WRW:
  20C1'   21 0000               	LXI	H,0
  20C4'   22 0000*              	SHLD	LNDLT
  20C7'   3A 2D7E'              	LDA	WPROW
  20CA'   6F                    	MOV	L,A
  20CB'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  20CE'   C9                    	RET
  20CF'                         EX_WQ:
  20CF'   CD 238F'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  20D2'                         EX_Q:
  20D2'   3A 2D8C'              	LDA	EXBANG
  20D5'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  20D6'   CA 20E0'              	JZ	EX_QT
  20D9'   3A 2D17'              	LDA	MODF
  20DC'   B7                    	ORA	A
  20DD'   C2 25AA'              	JNZ	MSGNWR		; changed, no '!': stay
  20E0'                         EX_QT:
  20E0'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  20E3'   3E 01                 	MVI	A,1
  20E5'   32 2D16'              	STA	QUITF
  20E8'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  20E9'                         EX_E:
  20E9'   3A 2D8C'              	LDA	EXBANG
  20EC'   B7                    	ORA	A
  20ED'   CA 20F7'              	JZ	EE_GO
  20F0'   3A 2D17'              	LDA	MODF
  20F3'   B7                    	ORA	A
  20F4'   C2 25AA'              	JNZ	MSGNWR
  20F7'                         EE_GO:
  20F7'   3A 2D7A'              	LDA	EXARG
  20FA'   B7                    	ORA	A
  20FB'   C2 2102'              	JNZ	EE_ARG
  20FE'   CD 23CB'              	CALL	OWNTF		; no name: the buffer's own
  2101'   D8                    	RC
  2102'                         EE_ARG:
  2102'   CD 23E1'              	CALL	ISOWN
  2105'   21 0001               	LXI	H,1
  2108'   C2 210F'              	JNZ	EE_LD		; another file: its first line
  210B'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  210E'   23                    	INX	H		; HL = the cursor's line
  210F'                         EE_LD:
  210F'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2111'   32 2D8A'              	STA	MSGWHT
  2114'   E5                    	PUSH	H
  2115'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2118'   21 0000*              	LXI	H,TFCB
  211B'   11 0000*              	LXI	D,FNAME
  211E'   CD 23F3'              	CALL	COPY12		; the buffer's name
  2121'   CD 23B8'              	CALL	SRCTF
  2124'   CD 0000*              	CALL	REOPEN
  2127'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  212A'   AF                    	XRA	A
  212B'   32 2D17'              	STA	MODF
  212E'   E1                    	POP	H
  212F'   2B                    	DCX	H
  2130'   AF                    	XRA	A
  2131'   CD 0000*              	CALL	MVLIND		; down to the line
  2134'   CD 0A63'              	CALL	ATEOF
  2137'   DC 0A69'              	CC	LASTLN		; past the last line: onto it
  213A'   CD 1234'              	CALL	ZSAVE
  213D'   C3 1304'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2140'                         TFDOS:
  2140'   C5                    	PUSH	B
  2141'   11 0080               	LXI	D,CMDTAIL
  2144'   0E 1A                 	MVI	C,1AH		; set the DMA
  2146'   CD 0005               	CALL	BDOS
  2149'   C1                    	POP	B
  214A'   11 0000*              	LXI	D,TFCB
  214D'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2150'                         EXRNG:
  2150'   2A 2DD6'              	LHLD	SRNG1
  2153'   7C                    	MOV	A,H
  2154'   B5                    	ORA	L
  2155'   37                    	STC
  2156'   C8                    	RZ
  2157'   2A 2DD8'              	LHLD	SRNG2
  215A'   EB                    	XCHG
  215B'   2A 2DD6'              	LHLD	SRNG1
  215E'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2161'   D8                    	RC
  2162'   EB                    	XCHG			; HL = the last line, DE = the first
  2163'   CD 0000*              	CALL	SUBHD
  2166'   23                    	INX	H
  2167'   22 2DE0'              	SHLD	SLINES
  216A'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  216B'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  216C'                         GOLNX:
  216C'   E5                    	PUSH	H
  216D'   CD 11C8'              	CALL	GOLN
  2170'   CD 0000*              	CALL	CNTLF
  2173'   23                    	INX	H		; the line the cursor came to rest on
  2174'   D1                    	POP	D
  2175'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2178'                         EXSAVP:
  2178'   CD 0D47'              	CALL	CURRW
  217B'   32 2D7E'              	STA	WPROW
  217E'   21 2DB7'              	LXI	H,MKPOS
  2181'   C3 0429'              	JMP	FPSTO
  2184'                         EXRSTP:
  2184'   CD 0000*              	CALL	CLRCNT
  2187'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  218A'   CD 0000*              	CALL	GOTO
  218D'   C3 20C1'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2190'                         PUTBRK:
  2190'   3E 0D                 	MVI	A,CR
  2192'   CD 0000*              	CALL	PUTGAP
  2195'   3E 0A                 	MVI	A,LF
  2197'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  219A'                         EX_WR:
  219A'   3A 2D7A'              	LDA	EXARG
  219D'   B7                    	ORA	A
  219E'   CA 2598'              	JZ	MSGNFN		; No file name
  21A1'   CD 23E1'              	CALL	ISOWN
  21A4'   CA 2244'              	JZ	EXW_OW
  21A7'   CD 0000*              	CALL	TEXIST
  21AA'   32 2DE3'              	STA	RWERR		; nonzero: a file of that name is there
  21AD'   CA 21B7'              	JZ	EXW_GO
  21B0'   3A 2D8C'              	LDA	EXBANG
  21B3'   B7                    	ORA	A
  21B4'   C2 259E'              	JNZ	MSGEXI		; File exists (! to force)
  21B7'                         EXW_GO:
  21B7'   CD 2150'              	CALL	EXRNG
  21BA'   DA 223E'              	JC	EXW_BD
  21BD'   CD 2178'              	CALL	EXSAVP
  21C0'   2A 2DD6'              	LHLD	SRNG1
  21C3'   CD 216C'              	CALL	GOLNX
  21C6'   C2 223B'              	JNZ	EXW_NL		; the text has no line N
  21C9'   3A 2DE3'              	LDA	RWERR		; a delete scans the whole directory, there or
  21CC'   B7                    	ORA	A		;   not: only when TEXIST found one
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  21CD'   0E 13                 	MVI	C,13H
  21CF'   C4 2140'              	CNZ	TFDOS		; delete what is there
  21D2'   0E 16                 	MVI	C,16H
  21D4'   CD 2140'              	CALL	TFDOS		; ... and make it
  21D7'   3C                    	INR	A
  21D8'   CA 222D'              	JZ	EXW_FL		; no directory entry left
  21DB'   3E 80                 	MVI	A,80H
  21DD'   32 2DE2'              	STA	RWPTR
  21E0'   AF                    	XRA	A
  21E1'   32 2DE3'              	STA	RWERR
  21E4'   2A 2DE0'              	LHLD	SLINES
  21E7'   CD 0000*              	CALL	SETC0		; that many lines, forward
  21EA'                         EXW_LP:
  21EA'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  21ED'   E5                    	PUSH	H
  21EE'   EB                    	XCHG
  21EF'   2A 0000*              	LHLD	GAPEND
  21F2'   CD 224A'              	CALL	RWOUT		; the text from the cursor to there
  21F5'   E1                    	POP	H
  21F6'   3A 2DE3'              	LDA	RWERR
  21F9'   B7                    	ORA	A
  21FA'   C2 2216'              	JNZ	EXW_EN
  21FD'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  2200'   CD 06E0'              	CALL	CNTTST
  2203'   C2 21EA'              	JNZ	EXW_LP
  2206'                         EXW_PD:				; the last record is padded out with ^Z
  2206'   3A 2DE2'              	LDA	RWPTR
  2209'   FE 80                 	CPI	80H
  220B'   CA 2216'              	JZ	EXW_EN
  220E'   3E 1A                 	MVI	A,CPMEOF
  2210'   CD 2256'              	CALL	RWPUT
  2213'   C3 2206'              	JMP	EXW_PD
  2216'                         EXW_EN:
  2216'   0E 10                 	MVI	C,10H
  2218'   CD 2140'              	CALL	TFDOS		; close
  221B'   3A 2DE3'              	LDA	RWERR
  221E'   B7                    	ORA	A
  221F'   C2 222D'              	JNZ	EXW_FL
  2222'   CD 2184'              	CALL	EXRSTP
  2225'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2227'   32 2D8A'              	STA	MSGWHT
  222A'   C3 07A0'              	JMP	SETMOV		; nothing on the screen has changed
  222D'                         EXW_FL:				; no room: the part written is not left behind
  222D'   0E 13                 	MVI	C,13H
  222F'   CD 2140'              	CALL	TFDOS
  2232'   CD 2184'              	CALL	EXRSTP
  2235'   21 2765'              	LXI	H,SDFUL
  2238'   C3 25D0'              	JMP	EXERR
  223B'                         EXW_NL:
  223B'   CD 2184'              	CALL	EXRSTP
  223E'                         EXW_BD:
  223E'   21 2757'              	LXI	H,SRNGE
  2241'   C3 25D0'              	JMP	EXERR
  2244'                         EXW_OW:
  2244'   21 25FF'              	LXI	H,SEXI
  2247'   C3 25D0'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  224A'                         RWOUT:
  224A'   CD 0000*              	CALL	CMP16
  224D'   C8                    	RZ
  224E'   7E                    	MOV	A,M
  224F'   23                    	INX	H
  2250'   CD 2256'              	CALL	RWPUT
  2253'   C3 224A'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2256'                         RWPUT:
  2256'   E5                    	PUSH	H
  2257'   F5                    	PUSH	PSW
  2258'   3A 2DE2'              	LDA	RWPTR
  225B'   6F                    	MOV	L,A
  225C'   26 00                 	MVI	H,0
  225E'   F1                    	POP	PSW
  225F'   77                    	MOV	M,A
  2260'   2C                    	INR	L		; Z: that was the record's last byte
  2261'   7D                    	MOV	A,L
  2262'   C2 2275'              	JNZ	RWP_ST
  2265'   D5                    	PUSH	D
  2266'   0E 15                 	MVI	C,15H
  2268'   CD 2140'              	CALL	TFDOS		; write it
  226B'   D1                    	POP	D
  226C'   B7                    	ORA	A
  226D'   CA 2273'              	JZ	RWP_OK
  2270'   32 2DE3'              	STA	RWERR
  2273'                         RWP_OK:
  2273'   3E 80                 	MVI	A,80H
  2275'                         RWP_ST:
  2275'   32 2DE2'              	STA	RWPTR
  2278'   E1                    	POP	H
  2279'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  227A'                         EX_R:
  227A'   3A 2D7A'              	LDA	EXARG
  227D'   B7                    	ORA	A
  227E'   CA 2598'              	JZ	MSGNFN		; No file name
  2281'   0E 0F                 	MVI	C,0FH
  2283'   CD 2140'              	CALL	TFDOS		; open
  2286'   3C                    	INR	A
  2287'   CA 2354'              	JZ	ER_NOF
  228A'   CD 125A'              	CALL	GZONE		; the screen's top line, before anything moves
  228D'   CD 2178'              	CALL	EXSAVP
  2290'   3A 2DD5'              	LDA	SRNGF
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2293'   B7                    	ORA	A
  2294'   CA 22AD'              	JZ	ER_NXT		; no line given: below the cursor's
  2297'   2A 2DD8'              	LHLD	SRNG2
  229A'   7C                    	MOV	A,H
  229B'   B5                    	ORA	L
  229C'   C2 22A7'              	JNZ	ER_LN
  229F'   23                    	INX	H
  22A0'   CD 11C8'              	CALL	GOLN		; ':0r': above line 1 ...
  22A3'   AF                    	XRA	A		;   which never wants a line end put in first
  22A4'   C3 22CF'              	JMP	ER_BRK
  22A7'                         ER_LN:
  22A7'   CD 216C'              	CALL	GOLNX
  22AA'   C2 223B'              	JNZ	EXW_NL		; the text has no line N
  22AD'                         ER_NXT:
  22AD'   21 0001               	LXI	H,1
  22B0'   AF                    	XRA	A
  22B1'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  22B4'   CD 0A63'              	CALL	ATEOF
  22B7'   3E 00                 	MVI	A,0
  22B9'   D2 22CF'              	JNC	ER_BRK		; text follows
  22BC'   2A 0000*              	LHLD	GAPBEG
  22BF'   EB                    	XCHG
  22C0'   2A 0000*              	LHLD	TXTBEG
  22C3'   CD 0000*              	CALL	CMP16
  22C6'   3E 01                 	MVI	A,1
  22C8'   CA 22CF'              	JZ	ER_BRK		; nothing before the cursor either
  22CB'   1B                    	DCX	D
  22CC'   1A                    	LDAX	D
  22CD'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  22CF'                         ER_BRK:
  22CF'   32 2DE5'              	STA	RDBRK
  22D2'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  22D5'   AF                    	XRA	A
  22D6'   32 2DE4'              	STA	RDANY
  22D9'                         ER_LP:
  22D9'   0E 14                 	MVI	C,14H
  22DB'   CD 2140'              	CALL	TFDOS		; the next record
  22DE'   B7                    	ORA	A
  22DF'   C2 2312'              	JNZ	ER_END
  22E2'   21 0080               	LXI	H,CMDTAIL
  22E5'   0E 00                 	MVI	C,0
  22E7'                         ER_SC:				; C = its bytes, up to a ^Z
  22E7'   7E                    	MOV	A,M
  22E8'   FE 1A                 	CPI	CPMEOF
  22EA'   CA 22F2'              	JZ	ER_GOT
  22ED'   23                    	INX	H
  22EE'   0C                    	INR	C
  22EF'   F2 22E7'              	JP	ER_SC		; (minus: all 128)
  22F2'                         ER_GOT:
  22F2'   79                    	MOV	A,C
  22F3'   B7                    	ORA	A
  22F4'   CA 2312'              	JZ	ER_END
  22F7'   C5                    	PUSH	B
  22F8'   3A 2DE4'              	LDA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22FB'   B7                    	ORA	A
  22FC'   CC 2343'              	CZ	ER_1ST
  22FF'   C1                    	POP	B
  2300'   06 00                 	MVI	B,0
  2302'   11 0080               	LXI	D,CMDTAIL
  2305'   C5                    	PUSH	B
  2306'   CD 0000*              	CALL	INSBLK
  2309'   C1                    	POP	B
  230A'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  230D'   79                    	MOV	A,C
  230E'   17                    	RAL
  230F'   DA 22D9'              	JC	ER_LP		; a full record: there may be more
  2312'                         ER_END:
  2312'   3A 2DE4'              	LDA	RDANY
  2315'   B7                    	ORA	A
  2316'   CA 2334'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2319'   CD 0A63'              	CALL	ATEOF
  231C'   DA 2329'              	JC	ER_MD		; the text now ends as the file read ends
  231F'   2A 0000*              	LHLD	GAPBEG
  2322'   2B                    	DCX	H
  2323'   7E                    	MOV	A,M
  2324'   FE 0A                 	CPI	LF
  2326'   C4 2190'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2329'                         ER_MD:
  2329'   3E 01                 	MVI	A,1
  232B'   32 2D17'              	STA	MODF
  232E'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2331'   CD 0000*              	CALL	GOTO
  2334'                         ER_PL:
  2334'   CD 0A63'              	CALL	ATEOF
  2337'   DC 0A69'              	CC	LASTLN		; (nothing read, at the end: the last line)
  233A'   CD 0000*              	CALL	CLRCNT
  233D'   CD 1272'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2340'   C3 07C1'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2343'                         ER_1ST:
  2343'   3C                    	INR	A
  2344'   32 2DE4'              	STA	RDANY
  2347'   3A 2DE5'              	LDA	RDBRK
  234A'   B7                    	ORA	A
  234B'   C4 2190'              	CNZ	PUTBRK
  234E'   21 2DB7'              	LXI	H,MKPOS
  2351'   C3 0429'              	JMP	FPSTO
  2354'                         ER_NOF:
  2354'   21 2746'              	LXI	H,SNOPN
  2357'   C3 25C5'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  235A'                         WRCHK:
  235A'   3A 2D7A'              	LDA	EXARG
  235D'   B7                    	ORA	A
  235E'   C2 2368'              	JNZ	WC_ARG
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2361'   CD 23CB'              	CALL	OWNTF
  2364'   D8                    	RC
  2365'   C3 237D'              	JMP	WC_OWN
  2368'                         WC_ARG:
  2368'   CD 23E1'              	CALL	ISOWN
  236B'   CA 237D'              	JZ	WC_OWN
  236E'   3A 2D8C'              	LDA	EXBANG
  2371'   B7                    	ORA	A
  2372'   CA 237B'              	JZ	WC_OTH
  2375'   CD 0000*              	CALL	TEXIST
  2378'   C2 259E'              	JNZ	MSGEXI		; File exists (! to force)
  237B'                         WC_OTH:
  237B'   AF                    	XRA	A		; (NC)
  237C'   C9                    	RET
  237D'                         WC_OWN:
  237D'   3A 2D8D'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2380'   B7                    	ORA	A
  2381'   CA 238B'              	JZ	WC_OK
  2384'   3A 2D8C'              	LDA	EXBANG
  2387'   B7                    	ORA	A
  2388'   C2 25A4'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  238B'                         WC_OK:
  238B'   3E 01                 	MVI	A,1
  238D'   B7                    	ORA	A		; (NC)
  238E'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  238F'                         WRITE:
  238F'   3A 2D7B'              	LDA	EXBAK
  2392'   CD 0000*              	CALL	WRTO
  2395'   3A 0001*              	LDA	FNAME+1
  2398'   FE 20                 	CPI	' '
  239A'   C2 23A6'              	JNZ	WR_HAS
  239D'   21 0000*              	LXI	H,TFCB
  23A0'   11 0000*              	LXI	D,FNAME
  23A3'   CD 23F3'              	CALL	COPY12
  23A6'                         WR_HAS:
  23A6'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  23A8'   32 2D8A'              	STA	MSGWHT
  23AB'   CD 23E1'              	CALL	ISOWN
  23AE'   C2 23B8'              	JNZ	SRCTF
  23B1'   AF                    	XRA	A
  23B2'   32 2D17'              	STA	MODF
  23B5'   32 2D8B'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  23B8'                         SRCTF:
  23B8'   21 0000*              	LXI	H,TFCB
  23BB'   11 005C               	LXI	D,DFTFCB
  23BE'   CD 23F3'              	CALL	COPY12
  23C1'   AF                    	XRA	A
  23C2'   06 04                 	MVI	B,4
  23C4'                         SRC_Z:
  23C4'   12                    	STAX	D		; extent, s1, s2, record count: 0
  23C5'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  23C6'   05                    	DCR	B
  23C7'   C2 23C4'              	JNZ	SRC_Z
  23CA'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  23CB'                         OWNTF:
  23CB'   3A 0001*              	LDA	FNAME+1
  23CE'   FE 20                 	CPI	' '
  23D0'   CA 2598'              	JZ	MSGNFN
  23D3'   CD 23FE'              	CALL	TFCLR
  23D6'   21 0000*              	LXI	H,FNAME
  23D9'   11 0000*              	LXI	D,TFCB
  23DC'   CD 23F3'              	CALL	COPY12
  23DF'   B7                    	ORA	A		; (NC)
  23E0'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  23E1'                         ISOWN:
  23E1'   21 0000*              	LXI	H,TFCB
  23E4'   11 0000*              	LXI	D,FNAME
  23E7'   06 0C                 	MVI	B,12
  23E9'                         IO_LP:
  23E9'   1A                    	LDAX	D
  23EA'   BE                    	CMP	M
  23EB'   C0                    	RNZ
  23EC'   23                    	INX	H
  23ED'   13                    	INX	D
  23EE'   05                    	DCR	B
  23EF'   C2 23E9'              	JNZ	IO_LP
  23F2'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  23F3'                         COPY12:
  23F3'   06 0C                 	MVI	B,12
  23F5'                         CP_LP:
  23F5'   7E                    	MOV	A,M
  23F6'   12                    	STAX	D
  23F7'   23                    	INX	H
  23F8'   13                    	INX	D
  23F9'   05                    	DCR	B
  23FA'   C2 23F5'              	JNZ	CP_LP
  23FD'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  23FE'                         TFCLR:
  23FE'   11 0000*              	LXI	D,TFCB
  2401'   06 24                 	MVI	B,36
  2403'   AF                    	XRA	A
  2404'                         TC_LP:
  2404'   12                    	STAX	D
  2405'   13                    	INX	D
  2406'   05                    	DCR	B
  2407'   C2 2404'              	JNZ	TC_LP
  240A'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  240B'                         FOPEN:
  240B'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  240D'   32 2D8A'              	STA	MSGWHT
  2410'   21 005C               	LXI	H,DFTFCB
  2413'   CD 24E1'              	CALL	NRMDRV
  2416'   11 0000*              	LXI	D,FNAME
  2419'   CD 23F3'              	CALL	COPY12
  241C'   CD 0000*              	CALL	OPENZ
  241F'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2422'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2424'   C8                    	RZ
  2425'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2428'   32 2D8B'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  242B'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  242C'                         ARGSCN:
  242C'   3A 0080               	LDA	CMDTAIL
  242F'   47                    	MOV	B,A		; B = what is left of the line
  2430'   B7                    	ORA	A
  2431'   C8                    	RZ
  2432'   21 0081               	LXI	H,CMDTAIL+1
  2435'                         AS_TOK:				; at a token, or the blanks before one
  2435'   7E                    	MOV	A,M
  2436'   FE 20                 	CPI	' '
  2438'   C2 2441'              	JNZ	AS_OPT
  243B'   23                    	INX	H
  243C'   05                    	DCR	B
  243D'   C2 2435'              	JNZ	AS_TOK
  2440'   C9                    	RET
  2441'                         AS_OPT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2441'   FE 2B                 	CPI	'+'
  2443'   CA 246D'              	JZ	AS_PLS
  2446'   FE 2D                 	CPI	'-'
  2448'   CA 245C'              	JZ	AS_SW
  244B'   FE 2F                 	CPI	'/'
  244D'   CA 245C'              	JZ	AS_SW
  2450'                         AS_SKP:				; not ours (the file name): on to the next one
  2450'   23                    	INX	H
  2451'   05                    	DCR	B
  2452'   C8                    	RZ
  2453'   7E                    	MOV	A,M
  2454'   FE 20                 	CPI	' '
  2456'   C2 2450'              	JNZ	AS_SKP
  2459'   C3 2435'              	JMP	AS_TOK
  245C'                         AS_SW:
  245C'   23                    	INX	H
  245D'   05                    	DCR	B
  245E'   C8                    	RZ
  245F'   7E                    	MOV	A,M
  2460'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2462'   FE 52                 	CPI	'R'
  2464'   C2 2450'              	JNZ	AS_SKP
  2467'   32 2D8D'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  246A'   C3 2450'              	JMP	AS_SKP
  246D'                         AS_PLS:
  246D'   3E 01                 	MVI	A,1
  246F'   32 2D8E'              	STA	PLUSF		; '+' gets the line even with no number on it
  2472'   11 0000*              	LXI	D,PLUSB
  2475'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2477'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2478'   05                    	DCR	B
  2479'   CA 24B0'              	JZ	AS_PE
  247C'   7E                    	MOV	A,M
  247D'   FE 30                 	CPI	'0'
  247F'   C2 2497'              	JNZ	AS_PD
  2482'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2482'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2483'   05                    	DCR	B
  2484'   CA 24B8'              	JZ	AS_P1
  2487'   7E                    	MOV	A,M
  2488'   FE 30                 	CPI	'0'
  248A'   CA 2482'              	JZ	AS_PZ
  248D'   FE 31                 	CPI	'1'
  248F'   DA 24B8'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2492'   FE 3A                 	CPI	'9'+1
  2494'   D2 24B8'              	JNC	AS_P1
  2497'                         AS_PD:				; the digits, as typed
  2497'   7E                    	MOV	A,M
  2498'   FE 30                 	CPI	'0'
  249A'   DA 24B0'              	JC	AS_PE
  249D'   FE 3A                 	CPI	'9'+1
  249F'   D2 24B0'              	JNC	AS_PE
  24A2'   79                    	MOV	A,C
  24A3'   B7                    	ORA	A
  24A4'   CA 24BF'              	JZ	AS_POV
  24A7'   0D                    	DCR	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24A8'   7E                    	MOV	A,M
  24A9'   12                    	STAX	D
  24AA'   13                    	INX	D
  24AB'   23                    	INX	H
  24AC'   05                    	DCR	B
  24AD'   C2 2497'              	JNZ	AS_PD
  24B0'                         AS_PE:
  24B0'   AF                    	XRA	A
  24B1'   12                    	STAX	D		; the digits end with a 0
  24B2'   78                    	MOV	A,B
  24B3'   B7                    	ORA	A
  24B4'   C8                    	RZ
  24B5'   C3 2435'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  24B8'                         AS_P1:
  24B8'   3E 31                 	MVI	A,'1'
  24BA'   12                    	STAX	D
  24BB'   13                    	INX	D
  24BC'   C3 24B0'              	JMP	AS_PE
  24BF'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  24BF'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  24C2'   C3 24B0'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  24C5'                         ARGGO:
  24C5'   3A 2D8E'              	LDA	PLUSF
  24C8'   B7                    	ORA	A
  24C9'   C8                    	RZ
  24CA'   21 0000*              	LXI	H,PLUSB
  24CD'                         AG_LP:
  24CD'   7E                    	MOV	A,M
  24CE'   B7                    	ORA	A
  24CF'   CA 24DC'              	JZ	AG_G
  24D2'   4F                    	MOV	C,A
  24D3'   E5                    	PUSH	H
  24D4'   CD 0023'              	CALL	VICMD
  24D7'   E1                    	POP	H
  24D8'   23                    	INX	H
  24D9'   C3 24CD'              	JMP	AG_LP
  24DC'                         AG_G:
  24DC'   0E 47                 	MVI	C,'G'
  24DE'   C3 0023'              	JMP	VICMD
                                
