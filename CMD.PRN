                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1E8E'                         EXTAB:
  1E8E'   77 00 01              	DB	'w',0,EO_W
  1E91'   71 00 02              	DB	'q',0,EO_Q
  1E94'   77 71 03              	DB	'w','q',EO_WQ
  1E97'   78 00 04              	DB	'x',0,EO_X
  1E9A'   65 00 05              	DB	'e',0,EO_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E9D'   73 00 06              	DB	's',0,EO_S
  1EA0'   76 65 07              	DB	'v','e',EO_V
  1EA3'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1EA4'                         EXADDR:
  1EA4'   AF                    	XRA	A
  1EA5'   32 24F6'              	STA	SRNGF
  1EA8'   7E                    	MOV	A,M
  1EA9'   FE 25                 	CPI	'%'
  1EAB'   CA 1ED4'              	JZ	EXA_AL
  1EAE'   EB                    	XCHG			; DE walks the line, HL takes the number
  1EAF'   CD 1EE9'              	CALL	EXNUM
  1EB2'   DA 1ED2'              	JC	EXA_NO
  1EB5'   22 24F7'              	SHLD	SRNG1
  1EB8'   22 24F9'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1EBB'   1A                    	LDAX	D
  1EBC'   FE 2C                 	CPI	','
  1EBE'   C2 1ECB'              	JNZ	EXA_YS
  1EC1'   13                    	INX	D
  1EC2'   CD 1EE9'              	CALL	EXNUM
  1EC5'   DA 1ED2'              	JC	EXA_NO		; ',' with no number: not a range at all
  1EC8'   22 24F9'              	SHLD	SRNG2
  1ECB'                         EXA_YS:
  1ECB'   EB                    	XCHG
  1ECC'   3E 01                 	MVI	A,1
  1ECE'   32 24F6'              	STA	SRNGF
  1ED1'   C9                    	RET
  1ED2'                         EXA_NO:
  1ED2'   EB                    	XCHG
  1ED3'   C9                    	RET
  1ED4'                         EXA_AL:
  1ED4'   23                    	INX	H
  1ED5'   E5                    	PUSH	H
  1ED6'   21 0001               	LXI	H,1
  1ED9'   22 24F7'              	SHLD	SRNG1
  1EDC'   21 FFFF               	LXI	H,0FFFFH
  1EDF'   22 24F9'              	SHLD	SRNG2
  1EE2'   E1                    	POP	H
  1EE3'   3E 01                 	MVI	A,1
  1EE5'   32 24F6'              	STA	SRNGF
  1EE8'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1EE9'                         EXNUM:
  1EE9'   1A                    	LDAX	D
  1EEA'   D6 30                 	SUI	'0'
  1EEC'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EED'   FE 0A                 	CPI	10
  1EEF'   3F                    	CMC
  1EF0'   D8                    	RC
  1EF1'   21 0000               	LXI	H,0
  1EF4'                         EXN_LP:
  1EF4'   1A                    	LDAX	D
  1EF5'   D6 30                 	SUI	'0'
  1EF7'   DA 1F11'              	JC	EXN_DN
  1EFA'   FE 0A                 	CPI	10
  1EFC'   D2 1F11'              	JNC	EXN_DN
  1EFF'   13                    	INX	D
  1F00'   C5                    	PUSH	B
  1F01'   4F                    	MOV	C,A
  1F02'   06 00                 	MVI	B,0		; BC = the digit
  1F04'   D5                    	PUSH	D
  1F05'   54                    	MOV	D,H
  1F06'   5D                    	MOV	E,L
  1F07'   29                    	DAD	H		; *2
  1F08'   29                    	DAD	H		; *4
  1F09'   19                    	DAD	D		; *5
  1F0A'   29                    	DAD	H		; *10
  1F0B'   D1                    	POP	D
  1F0C'   09                    	DAD	B
  1F0D'   C1                    	POP	B
  1F0E'   C3 1EF4'              	JMP	EXN_LP
  1F11'                         EXN_DN:
  1F11'   B7                    	ORA	A		; CY clear: there was a number
  1F12'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1F13'                         EX_S:
  1F13'   7E                    	MOV	A,M
  1F14'   B7                    	ORA	A
  1F15'   CA 1F57'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1F18'   32 24FB'              	STA	SDELIM
  1F1B'   23                    	INX	H
  1F1C'   11 0000*              	LXI	D,SRCHST
  1F1F'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1F22'   4F                    	MOV	C,A
  1F23'   CD 1F5D'              	CALL	SCOPY
  1F26'   78                    	MOV	A,B
  1F27'   B7                    	ORA	A
  1F28'   CA 1F57'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1F2B'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1F2E'   3E 01                 	MVI	A,1
  1F30'   32 24CA'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1F33'   11 2508'              	LXI	D,SREPL
  1F36'   0E 24                 	MVI	C,SREPMX
  1F38'   CD 1F5D'              	CALL	SCOPY
  1F3B'   78                    	MOV	A,B
  1F3C'   32 2507'              	STA	SREPLN
  1F3F'   AF                    	XRA	A
  1F40'   32 24FC'              	STA	SGFLAG
  1F43'   7E                    	MOV	A,M
  1F44'   FE 67                 	CPI	'g'
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F46'   C2 1F4F'              	JNZ	EX_SG
  1F49'   23                    	INX	H
  1F4A'   3E 01                 	MVI	A,1
  1F4C'   32 24FC'              	STA	SGFLAG
  1F4F'                         EX_SG:
  1F4F'   7E                    	MOV	A,M
  1F50'   B7                    	ORA	A
  1F51'   C2 1D38'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1F54'   C3 1F7D'              	JMP	SUBGO
  1F57'                         SUBNOP:
  1F57'   21 1DE4'              	LXI	H,SNOPAT
  1F5A'   C3 1D46'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1F5D'                         SCOPY:
  1F5D'   06 00                 	MVI	B,0
  1F5F'                         SCP_LP:
  1F5F'   78                    	MOV	A,B
  1F60'   B9                    	CMP	C
  1F61'   D2 1F7A'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1F64'   7E                    	MOV	A,M
  1F65'   B7                    	ORA	A
  1F66'   CA 1F7A'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1F69'   E5                    	PUSH	H
  1F6A'   21 24FB'              	LXI	H,SDELIM
  1F6D'   BE                    	CMP	M
  1F6E'   E1                    	POP	H
  1F6F'   CA 1F79'              	JZ	SCP_SK
  1F72'   12                    	STAX	D
  1F73'   13                    	INX	D
  1F74'   23                    	INX	H
  1F75'   04                    	INR	B
  1F76'   C3 1F5F'              	JMP	SCP_LP
  1F79'                         SCP_SK:
  1F79'   23                    	INX	H
  1F7A'                         SCP_DN:
  1F7A'   AF                    	XRA	A
  1F7B'   12                    	STAX	D
  1F7C'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1F7D'                         SUBGO:
  1F7D'   CD 0E49'              	CALL	GZONE
  1F80'   2A 0000*              	LHLD	LNDLT
  1F83'   22 2505'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1F86'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1F89'   22 2503'              	SHLD	SOFFS		;   search's SN_BAD does
  1F8C'   AF                    	XRA	A
  1F8D'   32 24FD'              	STA	SANY
  1F90'   21 0000               	LXI	H,0
  1F93'   22 24FF'              	SHLD	SBACK
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F96'   3A 24F6'              	LDA	SRNGF
  1F99'   B7                    	ORA	A
  1F9A'   CA 1FC3'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1F9D'   2A 24F7'              	LHLD	SRNG1
  1FA0'   7C                    	MOV	A,H
  1FA1'   B5                    	ORA	L
  1FA2'   CA 203F'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1FA5'   2A 24F9'              	LHLD	SRNG2
  1FA8'   EB                    	XCHG
  1FA9'   2A 24F7'              	LHLD	SRNG1
  1FAC'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1FAF'   DA 203F'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1FB2'   EB                    	XCHG			; HL = the last line, DE = the first
  1FB3'   CD 0000*              	CALL	SUBHD
  1FB6'   23                    	INX	H		; HL = the lines in the range
  1FB7'   22 2501'              	SHLD	SLINES
  1FBA'   2A 24F7'              	LHLD	SRNG1
  1FBD'   CD 0DD7'              	CALL	GOLN
  1FC0'   C3 1FC9'              	JMP	SUBLP
  1FC3'                         SUB_1L:
  1FC3'   21 0001               	LXI	H,1
  1FC6'   22 2501'              	SHLD	SLINES
  1FC9'                         SUBLP:
  1FC9'   CD 2045'              	CALL	SUBLIN		; A = 1 when this line changed
  1FCC'   B7                    	ORA	A
  1FCD'   CA 1FDB'              	JZ	SUB_NX
  1FD0'   3E 01                 	MVI	A,1
  1FD2'   32 24FD'              	STA	SANY
  1FD5'   21 0000               	LXI	H,0
  1FD8'   22 24FF'              	SHLD	SBACK		; the cursor is ON the last line changed
  1FDB'                         SUB_NX:
  1FDB'   2A 2501'              	LHLD	SLINES
  1FDE'   2B                    	DCX	H
  1FDF'   22 2501'              	SHLD	SLINES
  1FE2'   7C                    	MOV	A,H
  1FE3'   B5                    	ORA	L
  1FE4'   CA 2002'              	JZ	SUBDON		; the range is spent
  1FE7'   21 0001               	LXI	H,1
  1FEA'   AF                    	XRA	A
  1FEB'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1FEE'   3A 24FD'              	LDA	SANY
  1FF1'   B7                    	ORA	A
  1FF2'   CA 1FFC'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1FF5'   2A 24FF'              	LHLD	SBACK
  1FF8'   23                    	INX	H
  1FF9'   22 24FF'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1FFC'                         SUB_AE:
  1FFC'   CD 091C'              	CALL	ATEOF
  1FFF'   D2 1FC9'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2002'                         SUBDON:
  2002'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2005'   3A 24FD'              	LDA	SANY
  2008'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2009'   CA 2027'              	JZ	SUBNFD
  200C'   3E 01                 	MVI	A,1
  200E'   32 2457'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2011'   2A 24FF'              	LHLD	SBACK
  2014'   7C                    	MOV	A,H
  2015'   B5                    	ORA	L
  2016'   CA 2021'              	JZ	SUB_PL
  2019'   3E FF                 	MVI	A,0FFH
  201B'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  201E'   CD 0000*              	CALL	CLRCNT
  2021'                         SUB_PL:
  2021'   CD 0E61'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2024'   C3 0693'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2027'                         SUBNFD:
  2027'   2A 2503'              	LHLD	SOFFS
  202A'   CD 0000*              	CALL	GOTO
  202D'   2A 2505'              	LHLD	SLDLTS
  2030'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2033'   21 1DD0'              	LXI	H,SNOTFD
  2036'   CD 1D46'              	CALL	EXERR
  2039'   21 0000*              	LXI	H,SRCHST
  203C'   C3 1D41'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  203F'                         SUBBAD:
  203F'   21 1DBE'              	LXI	H,SNOT
  2042'   C3 1D3B'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2045'                         SUBLIN:
  2045'   AF                    	XRA	A
  2046'   32 24FE'              	STA	SLCHG
  2049'   CD 20C4'              	CALL	SUBBOL
  204C'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  204F'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  204F'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2052'   DA 205A'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2055'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2057'   C2 204F'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                				;   every other line reader here does.
  205A'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  205A'   CD 0000*              	CALL	CUROFF
  205D'   E5                    	PUSH	H
  205E'   CD 1202'              	CALL	CEND
  2061'   D1                    	POP	D
  2062'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2065'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2066'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2069'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  206A'   B7                    	ORA	A		;   span is a line, not a pair.)
  206B'   FA 20BD'              	JM	SUBL_D		; what is left is shorter than the pattern
  206E'   44                    	MOV	B,H
  206F'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2070'   11 0000*              	LXI	D,SRCHST
  2073'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2076'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2079'   DA 20BD'              	JC	SUBL_D
  207C'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  207F'   EB                    	XCHG
  2080'   2A 0000*              	LHLD	GAPEND
  2083'   EB                    	XCHG
  2084'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2087'   EB                    	XCHG
  2088'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2089'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  208C'   D1                    	POP	D
  208D'   19                    	DAD	D		; ... and so the match's logical offset
  208E'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2091'   3A 24FD'              	LDA	SANY
  2094'   B7                    	ORA	A
  2095'   C2 20A2'              	JNZ	SUBL_C
  2098'   3A 24FE'              	LDA	SLCHG
  209B'   B7                    	ORA	A
  209C'   C2 20A2'              	JNZ	SUBL_C
  209F'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  20A2'                         SUBL_C:
  20A2'   3A 0000*              	LDA	SRCHBF
  20A5'   6F                    	MOV	L,A
  20A6'   26 00                 	MVI	H,0
  20A8'   CD 0000*              	CALL	DELFWD		; the match goes
  20AB'   11 2507'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  20AE'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  20B1'                         SUBL_I:
  20B1'   3E 01                 	MVI	A,1
  20B3'   32 24FE'              	STA	SLCHG
  20B6'   3A 24FC'              	LDA	SGFLAG
  20B9'   B7                    	ORA	A
  20BA'   C2 205A'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20BD'                         SUBL_D:
  20BD'   CD 20C4'              	CALL	SUBBOL
  20C0'   3A 24FE'              	LDA	SLCHG
  20C3'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  20C4'                         SUBBOL:
  20C4'   CD 0000*              	CALL	CUROFF
  20C7'   CD 055E'              	CALL	BOL
  20CA'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  20CD'                         VC_SRCH:
  20CD'   CD 0672'              	CALL	SETMOV
  20D0'   C5                    	PUSH	B
  20D1'   CD 0605'              	CALL	GETCNT
  20D4'   22 24EF'              	SHLD	SCNT
  20D7'   C1                    	POP	B
  20D8'   79                    	MOV	A,C
  20D9'   FE 2F                 	CPI	'/'
  20DB'   3E 00                 	MVI	A,0
  20DD'   CA 20E2'              	JZ	VS_DIR
  20E0'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  20E2'                         VS_DIR:
  20E2'   32 24C8'              	STA	SDIR
  20E5'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  20E8'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  20EB'   47                    	MOV	B,A
  20EC'   CD 1896'              	CALL	RDLINE
  20EF'   B7                    	ORA	A
  20F0'   C0                    	RNZ			; cancelled: nothing happens at all
  20F1'   3A 24A0'              	LDA	RLLEN
  20F4'   B7                    	ORA	A
  20F5'   CA 210A'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  20F8'   5F                    	MOV	E,A
  20F9'   16 00                 	MVI	D,0
  20FB'   21 0000*              	LXI	H,SRCHST
  20FE'   19                    	DAD	D
  20FF'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2101'   7B                    	MOV	A,E
  2102'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2105'   3E 01                 	MVI	A,1
  2107'   32 24CA'              	STA	SHAVE
  210A'                         VS_OLD:
  210A'   3A 24CA'              	LDA	SHAVE
  210D'   B7                    	ORA	A
  210E'   CA 211A'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2111'   3A 24C8'              	LDA	SDIR
  2114'   32 24C9'              	STA	SDIRE
  2117'   C3 2143'              	JMP	SRCHN
  211A'                         VS_NOP:
  211A'   21 1DE4'              	LXI	H,SNOPAT
  211D'   C3 1D46'              	JMP	EXERR
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2120'                         VC_N:
  2120'   CD 0672'              	CALL	SETMOV
  2123'   3A 24C8'              	LDA	SDIR
  2126'   C3 2130'              	JMP	VN_GO
  2129'                         VCB_N:
  2129'   CD 0672'              	CALL	SETMOV
  212C'   3A 24C8'              	LDA	SDIR
  212F'   2F                    	CMA			; the other way: 0 <-> FFH
  2130'                         VN_GO:
  2130'   32 24C9'              	STA	SDIRE
  2133'   CD 0605'              	CALL	GETCNT
  2136'   22 24EF'              	SHLD	SCNT
  2139'   3A 24CA'              	LDA	SHAVE
  213C'   B7                    	ORA	A
  213D'   CA 211A'              	JZ	VS_NOP
  2140'   C3 2143'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2143'                         SRCHN:
  2143'   CD 0E49'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2146'   2A 0000*              	LHLD	LNDLT
  2149'   22 24F3'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  214C'   CD 0000*              	CALL	CUROFF
  214F'   22 24F1'              	SHLD	SOFF
  2152'                         SN_LP:
  2152'   CD 218A'              	CALL	SRCHGO
  2155'   DA 216F'              	JC	SN_BAD
  2158'   2A 24EF'              	LHLD	SCNT
  215B'   2B                    	DCX	H
  215C'   22 24EF'              	SHLD	SCNT
  215F'   7C                    	MOV	A,H
  2160'   B5                    	ORA	L
  2161'   C2 2152'              	JNZ	SN_LP
  2164'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2167'   3E 01                 	MVI	A,1
  2169'   32 24D5'              	STA	GPKEEP		; land on the match, not the first non-blank
  216C'   C3 0E61'              	JMP	GPLACE		; (which sets LNDLT itself)
  216F'                         SN_BAD:
  216F'   CD 0000*              	CALL	CLRCNT
  2172'   2A 24F1'              	LHLD	SOFF
  2175'   CD 0000*              	CALL	GOTO
  2178'   2A 24F3'              	LHLD	SLDLT
  217B'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  217E'   21 1DD0'              	LXI	H,SNOTFD
  2181'   CD 1D46'              	CALL	EXERR
  2184'   21 0000*              	LXI	H,SRCHST
  2187'   C3 1D41'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ; SRCHN is what puts it back).
  218A'                         SRCHGO:
  218A'   3E 01                 	MVI	A,1
  218C'   32 24F5'              	STA	SSKIP		; this pass starts one past the cursor
  218F'   CD 21A1'              	CALL	SRCHW
  2192'   D0                    	RNC
  2193'   3A 24C9'              	LDA	SDIRE
  2196'   2F                    	CMA
  2197'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  219A'   AF                    	XRA	A
  219B'   32 24F5'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  219E'   C3 21A1'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  21A1'                         SRCHW:
  21A1'   3A 24C9'              	LDA	SDIRE
  21A4'   32 0000*              	STA	DIRFLG
  21A7'   21 FFFF               	LXI	H,0FFFFH
  21AA'   22 2454'              	SHLD	CMDCNT
  21AD'   AF                    	XRA	A
  21AE'   32 0000*              	STA	AUXCNT
  21B1'                         SW_LP:
  21B1'   CD 21BD'              	CALL	SRCH1
  21B4'   D0                    	RNC
  21B5'   CD 0000*              	CALL	SCRLST
  21B8'   D2 21B1'              	JNC	SW_LP
  21BB'   37                    	STC
  21BC'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  21BD'                         SRCH1:
  21BD'   11 0000*              	LXI	D,SRCHST
  21C0'   3A 0000*              	LDA	DIRFLG
  21C3'   B7                    	ORA	A
  21C4'   FA 21E8'              	JM	SR1_BK
  21C7'   21 0000*              	LXI	H,GAPEND
  21CA'   CD 0000*              	CALL	FWDCNT
  21CD'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  21D0'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  21D1'   3A 24F5'              	LDA	SSKIP
  21D4'   B7                    	ORA	A
  21D5'   CA 21DE'              	JZ	SR1_FW
  21D8'   78                    	MOV	A,B
  21D9'   B1                    	ORA	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21DA'   37                    	STC
  21DB'   C8                    	RZ			; no room for a match even before the skip
  21DC'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  21DD'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  21DE'                         SR1_FW:
  21DE'   CD 0000*              	CALL	MATCHF
  21E1'   D8                    	RC
  21E2'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  21E5'   C3 0000*              	JMP	PUTCUR
  21E8'                         SR1_BK:
  21E8'   21 0000*              	LXI	H,TXTBEG
  21EB'   CD 0000*              	CALL	FWDCNT
  21EE'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  21F1'   D8                    	RC
  21F2'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  21F5'   CD 0000*              	CALL	MATCHB
  21F8'   D8                    	RC
  21F9'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  21FC'                         MSGNAM:
  21FC'   E5                    	PUSH	H
  21FD'   3E 22                 	MVI	A,'"'
  21FF'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2202'   E1                    	POP	H
  2203'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2204'   23                    	INX	H
  2205'   7E                    	MOV	A,M
  2206'   FE 20                 	CPI	' '
  2208'   C2 2215'              	JNZ	MN_HAS
  220B'   21 1E40'              	LXI	H,SNONM
  220E'   CD 0000*              	CALL	OUTSTR
  2211'   E1                    	POP	H
  2212'   C3 225F'              	JMP	MN_END
  2215'                         MN_HAS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2215'   0E 19                 	MVI	C,BF_CURDSK
  2217'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  221A'   E1                    	POP	H
  221B'   E5                    	PUSH	H
  221C'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  221D'   BE                    	CMP	M
  221E'   CA 222C'              	JZ	MN_NAM
  2221'   7E                    	MOV	A,M
  2222'   C6 40                 	ADI	'A'-1
  2224'   CD 0000*              	CALL	OUTCH
  2227'   3E 3A                 	MVI	A,':'
  2229'   CD 0000*              	CALL	OUTCH
  222C'                         MN_NAM:
  222C'   E1                    	POP	H
  222D'   E5                    	PUSH	H
  222E'   23                    	INX	H
  222F'   0E 08                 	MVI	C,8
  2231'                         MN_NM:
  2231'   7E                    	MOV	A,M
  2232'   FE 20                 	CPI	' '
  2234'   CA 223F'              	JZ	MN_EXT
  2237'   CD 0000*              	CALL	OUTCH
  223A'   23                    	INX	H
  223B'   0D                    	DCR	C
  223C'   C2 2231'              	JNZ	MN_NM
  223F'                         MN_EXT:
  223F'   E1                    	POP	H
  2240'   11 0009               	LXI	D,9
  2243'   19                    	DAD	D		; the type field
  2244'   7E                    	MOV	A,M
  2245'   FE 20                 	CPI	' '
  2247'   CA 225F'              	JZ	MN_END
  224A'   3E 2E                 	MVI	A,'.'
  224C'   CD 0000*              	CALL	OUTCH
  224F'   0E 03                 	MVI	C,3
  2251'                         MN_XL:
  2251'   7E                    	MOV	A,M
  2252'   FE 20                 	CPI	' '
  2254'   CA 225F'              	JZ	MN_END
  2257'   CD 0000*              	CALL	OUTCH
  225A'   23                    	INX	H
  225B'   0D                    	DCR	C
  225C'   C2 2251'              	JNZ	MN_XL
  225F'                         MN_END:
  225F'   3E 22                 	MVI	A,'"'
  2261'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2264'                         MSGFLG:
  2264'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2266'   B7                    	ORA	A
  2267'   CA 2277'              	JZ	MF_RO
  226A'   3A 2457'              	LDA	MODF
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  226D'   B7                    	ORA	A
  226E'   CA 2277'              	JZ	MF_RO
  2271'   21 1E4A'              	LXI	H,SMODM
  2274'   CD 228C'              	CALL	MF_PUT
  2277'                         MF_RO:
  2277'   3A 24B6'              	LDA	ROFLAG
  227A'   B7                    	ORA	A
  227B'   CA 2284'              	JZ	MF_NEW
  227E'   21 1E55'              	LXI	H,SROM
  2281'   CD 228C'              	CALL	MF_PUT
  2284'                         MF_NEW:
  2284'   3A 24B4'              	LDA	MSGNEW
  2287'   B7                    	ORA	A
  2288'   C8                    	RZ
  2289'   21 1E60'              	LXI	H,SNEWM
  228C'                         MF_PUT:
  228C'   78                    	MOV	A,B
  228D'   B7                    	ORA	A
  228E'   C2 229A'              	JNZ	MF_STR
  2291'   06 01                 	MVI	B,1
  2293'   E5                    	PUSH	H
  2294'   3E 20                 	MVI	A,' '
  2296'   CD 0000*              	CALL	OUTCH
  2299'   E1                    	POP	H
  229A'                         MF_STR:
  229A'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  229D'                         EMITW:
  229D'   C5                    	PUSH	B
  229E'   D5                    	PUSH	D
  229F'   06 00                 	MVI	B,0
  22A1'   11 2710               	LXI	D,10000
  22A4'   CD 22C2'              	CALL	EWDIG
  22A7'   11 03E8               	LXI	D,1000
  22AA'   CD 22C2'              	CALL	EWDIG
  22AD'   11 0064               	LXI	D,100
  22B0'   CD 22C2'              	CALL	EWDIG
  22B3'   11 000A               	LXI	D,10
  22B6'   CD 22C2'              	CALL	EWDIG
  22B9'   7D                    	MOV	A,L		; the units digit is always printed
  22BA'   C6 30                 	ADI	'0'
  22BC'   CD 0000*              	CALL	OUTCH
  22BF'   D1                    	POP	D
  22C0'   C1                    	POP	B
  22C1'   C9                    	RET
  22C2'                         EWDIG:
  22C2'   0E 00                 	MVI	C,0
  22C4'                         EW_LP:
  22C4'   7D                    	MOV	A,L
  22C5'   93                    	SUB	E
  22C6'   6F                    	MOV	L,A
  22C7'   7C                    	MOV	A,H
  22C8'   9A                    	SBB	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22C9'   67                    	MOV	H,A
  22CA'   DA 22D1'              	JC	EW_DN
  22CD'   0C                    	INR	C
  22CE'   C3 22C4'              	JMP	EW_LP
  22D1'                         EW_DN:
  22D1'   19                    	DAD	D		; one subtraction too many: give it back
  22D2'   79                    	MOV	A,C
  22D3'   B7                    	ORA	A
  22D4'   C2 22DA'              	JNZ	EW_PR
  22D7'   78                    	MOV	A,B
  22D8'   B7                    	ORA	A
  22D9'   C8                    	RZ			; a leading zero: write nothing
  22DA'                         EW_PR:
  22DA'   79                    	MOV	A,C
  22DB'   C6 30                 	ADI	'0'
  22DD'   CD 0000*              	CALL	OUTCH
  22E0'   06 01                 	MVI	B,1
  22E2'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  22E3'                         ISEMPT:
  22E3'   2A 0000*              	LHLD	OUTPOS
  22E6'   7C                    	MOV	A,H
  22E7'   B5                    	ORA	L
  22E8'   C0                    	RNZ
  22E9'   CD 0000*              	CALL	LOGLEN
  22EC'   7C                    	MOV	A,H
  22ED'   B5                    	ORA	L
  22EE'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  22EF'                         MSGCTG:
  22EF'   21 0000*              	LXI	H,FNAME
  22F2'   CD 21FC'              	CALL	MSGNAM
  22F5'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  22F7'   CD 2264'              	CALL	MSGFLG
  22FA'   CD 22E3'              	CALL	ISEMPT
  22FD'   C2 2306'              	JNZ	MG_POS
  2300'   21 1E73'              	LXI	H,SNOLIN
  2303'   C3 0000*              	JMP	OUTSTR
  2306'                         MG_POS:
  2306'   21 1E66'              	LXI	H,SLINE
  2309'   CD 0000*              	CALL	OUTSTR
  230C'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  230F'   23                    	INX	H		;   ... so the line it is on
  2310'   CD 229D'              	CALL	EMITW
  2313'   21 1E6D'              	LXI	H,SCOLM
  2316'   CD 0000*              	CALL	OUTSTR
  2319'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  231C'   23                    	INX	H
  231D'   E5                    	PUSH	H
  231E'   CD 229D'              	CALL	EMITW
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2321'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2324'   23                    	INX	H
  2325'   D1                    	POP	D
  2326'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2329'   C8                    	RZ
  232A'   E5                    	PUSH	H
  232B'   3E 2D                 	MVI	A,'-'
  232D'   CD 0000*              	CALL	OUTCH
  2330'   E1                    	POP	H
  2331'   C3 229D'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2334'                         FILMSG:
  2334'   3A 0001*              	LDA	FNAME+1
  2337'   FE 20                 	CPI	' '
  2339'   C8                    	RZ
  233A'   21 0000*              	LXI	H,FNAME
  233D'   CD 21FC'              	CALL	MSGNAM
  2340'   AF                    	XRA	A		; nothing has been changed yet
  2341'   C3 2264'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2344'                         WRMSG:
  2344'   21 0000*              	LXI	H,TFCB
  2347'   CD 21FC'              	CALL	MSGNAM
  234A'   21 1E85'              	LXI	H,SWRIT
  234D'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2350'                         MSGPST:
  2350'   3A 24B3'              	LDA	MSGWHT
  2353'   B7                    	ORA	A
  2354'   C8                    	RZ
  2355'   47                    	MOV	B,A
  2356'   AF                    	XRA	A
  2357'   32 24B3'              	STA	MSGWHT
  235A'   78                    	MOV	A,B
  235B'   FE 01                 	CPI	MW_FIL
  235D'   CA 236B'              	JZ	MP_FIL
