  0741'   22 0000*              	SHLD	WKTERM
  0744'   E1                    	POP	H
  0745'   CD 0697'              	CALL	BOL
  0748'   22 0000*              	SHLD	WKBOL
  074B'   2A 0000*              	LHLD	WKTERM
  074E'   EB                    	XCHG			; DE = term
  074F'   2A 0000*              	LHLD	WKBOL
  0752'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0755'   CA 0774'              	JZ	EOLC_MT
  0758'   EB                    	XCHG			; HL = term
  0759'   2B                    	DCX	H		; term-1
  075A'   E5                    	PUSH	H
