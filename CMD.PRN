  1E14'   74 74 65 6E           
  1E18'   00                    
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1E19'                         EXTAB:
  1E19'   77 00 01              	DB	'w',0,EO_W
  1E1C'   71 00 02              	DB	'q',0,EO_Q
  1E1F'   77 71 03              	DB	'w','q',EO_WQ
  1E22'   78 00 04              	DB	'x',0,EO_X
  1E25'   65 00 05              	DB	'e',0,EO_E
  1E28'   73 00 06              	DB	's',0,EO_S
  1E2B'   76 65 07              	DB	'v','e',EO_V
  1E2E'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1E2F'                         EXADDR:
  1E2F'   AF                    	XRA	A
  1E30'   32 247D'              	STA	SRNGF
  1E33'   7E                    	MOV	A,M
  1E34'   FE 25                 	CPI	'%'
  1E36'   CA 1E5F'              	JZ	EXA_AL
  1E39'   EB                    	XCHG			; DE walks the line, HL takes the number
  1E3A'   CD 1E74'              	CALL	EXNUM
  1E3D'   DA 1E5D'              	JC	EXA_NO
  1E40'   22 247E'              	SHLD	SRNG1
  1E43'   22 2480'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E46'   1A                    	LDAX	D
  1E47'   FE 2C                 	CPI	','
  1E49'   C2 1E56'              	JNZ	EXA_YS
  1E4C'   13                    	INX	D
  1E4D'   CD 1E74'              	CALL	EXNUM
  1E50'   DA 1E5D'              	JC	EXA_NO		; ',' with no number: not a range at all
  1E53'   22 2480'              	SHLD	SRNG2
  1E56'                         EXA_YS:
  1E56'   EB                    	XCHG
  1E57'   3E 01                 	MVI	A,1
  1E59'   32 247D'              	STA	SRNGF
  1E5C'   C9                    	RET
  1E5D'                         EXA_NO:
  1E5D'   EB                    	XCHG
  1E5E'   C9                    	RET
  1E5F'                         EXA_AL:
  1E5F'   23                    	INX	H
  1E60'   E5                    	PUSH	H
  1E61'   21 0001               	LXI	H,1
  1E64'   22 247E'              	SHLD	SRNG1
  1E67'   21 FFFF               	LXI	H,0FFFFH
  1E6A'   22 2480'              	SHLD	SRNG2
  1E6D'   E1                    	POP	H
  1E6E'   3E 01                 	MVI	A,1
  1E70'   32 247D'              	STA	SRNGF
  1E73'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1E74'                         EXNUM:
  1E74'   1A                    	LDAX	D
  1E75'   D6 30                 	SUI	'0'
  1E77'   D8                    	RC
  1E78'   FE 0A                 	CPI	10
  1E7A'   3F                    	CMC
  1E7B'   D8                    	RC
  1E7C'   21 0000               	LXI	H,0
  1E7F'                         EXN_LP:
  1E7F'   1A                    	LDAX	D
  1E80'   D6 30                 	SUI	'0'
  1E82'   DA 1E9C'              	JC	EXN_DN
  1E85'   FE 0A                 	CPI	10
  1E87'   D2 1E9C'              	JNC	EXN_DN
  1E8A'   13                    	INX	D
  1E8B'   C5                    	PUSH	B
  1E8C'   4F                    	MOV	C,A
  1E8D'   06 00                 	MVI	B,0		; BC = the digit
  1E8F'   D5                    	PUSH	D
  1E90'   54                    	MOV	D,H
  1E91'   5D                    	MOV	E,L
  1E92'   29                    	DAD	H		; *2
  1E93'   29                    	DAD	H		; *4
  1E94'   19                    	DAD	D		; *5
  1E95'   29                    	DAD	H		; *10
  1E96'   D1                    	POP	D
  1E97'   09                    	DAD	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E98'   C1                    	POP	B
  1E99'   C3 1E7F'              	JMP	EXN_LP
  1E9C'                         EXN_DN:
  1E9C'   B7                    	ORA	A		; CY clear: there was a number
  1E9D'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1E9E'                         EX_S:
  1E9E'   7E                    	MOV	A,M
  1E9F'   B7                    	ORA	A
  1EA0'   CA 1EE2'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1EA3'   32 2482'              	STA	SDELIM
  1EA6'   23                    	INX	H
  1EA7'   11 0000*              	LXI	D,SRCHST
  1EAA'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1EAD'   4F                    	MOV	C,A
  1EAE'   CD 1EE8'              	CALL	SCOPY
  1EB1'   78                    	MOV	A,B
  1EB2'   B7                    	ORA	A
  1EB3'   CA 1EE2'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1EB6'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1EB9'   3E 01                 	MVI	A,1
  1EBB'   32 2455'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1EBE'   11 248F'              	LXI	D,SREPL
  1EC1'   0E 24                 	MVI	C,SREPMX
  1EC3'   CD 1EE8'              	CALL	SCOPY
  1EC6'   78                    	MOV	A,B
  1EC7'   32 248E'              	STA	SREPLN
  1ECA'   AF                    	XRA	A
  1ECB'   32 2483'              	STA	SGFLAG
  1ECE'   7E                    	MOV	A,M
  1ECF'   FE 67                 	CPI	'g'
  1ED1'   C2 1EDA'              	JNZ	EX_SG
  1ED4'   23                    	INX	H
  1ED5'   3E 01                 	MVI	A,1
  1ED7'   32 2483'              	STA	SGFLAG
  1EDA'                         EX_SG:
  1EDA'   7E                    	MOV	A,M
  1EDB'   B7                    	ORA	A
  1EDC'   C2 1CD0'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1EDF'   C3 1F08'              	JMP	SUBGO
  1EE2'                         SUBNOP:
  1EE2'   21 1D7C'              	LXI	H,SNOPAT
  1EE5'   C3 1CDE'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1EE8'                         SCOPY:
  1EE8'   06 00                 	MVI	B,0
  1EEA'                         SCP_LP:
  1EEA'   78                    	MOV	A,B
  1EEB'   B9                    	CMP	C
  1EEC'   D2 1F05'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EEF'   7E                    	MOV	A,M
  1EF0'   B7                    	ORA	A
  1EF1'   CA 1F05'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1EF4'   E5                    	PUSH	H
  1EF5'   21 2482'              	LXI	H,SDELIM
  1EF8'   BE                    	CMP	M
  1EF9'   E1                    	POP	H
  1EFA'   CA 1F04'              	JZ	SCP_SK
  1EFD'   12                    	STAX	D
  1EFE'   13                    	INX	D
  1EFF'   23                    	INX	H
  1F00'   04                    	INR	B
  1F01'   C3 1EEA'              	JMP	SCP_LP
  1F04'                         SCP_SK:
  1F04'   23                    	INX	H
  1F05'                         SCP_DN:
  1F05'   AF                    	XRA	A
  1F06'   12                    	STAX	D
  1F07'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1F08'                         SUBGO:
  1F08'   CD 0DE1'              	CALL	GZONE
  1F0B'   2A 0000*              	LHLD	LNDLT
  1F0E'   22 248C'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1F11'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1F14'   22 248A'              	SHLD	SOFFS		;   search's SN_BAD does
  1F17'   AF                    	XRA	A
  1F18'   32 2484'              	STA	SANY
  1F1B'   21 0000               	LXI	H,0
  1F1E'   22 2486'              	SHLD	SBACK
  1F21'   3A 247D'              	LDA	SRNGF
  1F24'   B7                    	ORA	A
  1F25'   CA 1F4E'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1F28'   2A 247E'              	LHLD	SRNG1
  1F2B'   7C                    	MOV	A,H
  1F2C'   B5                    	ORA	L
  1F2D'   CA 1FCA'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1F30'   2A 2480'              	LHLD	SRNG2
  1F33'   EB                    	XCHG
  1F34'   2A 247E'              	LHLD	SRNG1
  1F37'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1F3A'   DA 1FCA'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1F3D'   EB                    	XCHG			; HL = the last line, DE = the first
  1F3E'   CD 0000*              	CALL	SUBHD
  1F41'   23                    	INX	H		; HL = the lines in the range
  1F42'   22 2488'              	SHLD	SLINES
  1F45'   2A 247E'              	LHLD	SRNG1
  1F48'   CD 0D6F'              	CALL	GOLN
  1F4B'   C3 1F54'              	JMP	SUBLP
  1F4E'                         SUB_1L:
  1F4E'   21 0001               	LXI	H,1
  1F51'   22 2488'              	SHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F54'                         SUBLP:
  1F54'   CD 1FD0'              	CALL	SUBLIN		; A = 1 when this line changed
  1F57'   B7                    	ORA	A
  1F58'   CA 1F66'              	JZ	SUB_NX
  1F5B'   3E 01                 	MVI	A,1
  1F5D'   32 2484'              	STA	SANY
  1F60'   21 0000               	LXI	H,0
  1F63'   22 2486'              	SHLD	SBACK		; the cursor is ON the last line changed
  1F66'                         SUB_NX:
  1F66'   2A 2488'              	LHLD	SLINES
  1F69'   2B                    	DCX	H
  1F6A'   22 2488'              	SHLD	SLINES
  1F6D'   7C                    	MOV	A,H
  1F6E'   B5                    	ORA	L
  1F6F'   CA 1F8D'              	JZ	SUBDON		; the range is spent
  1F72'   21 0001               	LXI	H,1
  1F75'   AF                    	XRA	A
  1F76'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1F79'   3A 2484'              	LDA	SANY
  1F7C'   B7                    	ORA	A
  1F7D'   CA 1F87'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1F80'   2A 2486'              	LHLD	SBACK
  1F83'   23                    	INX	H
  1F84'   22 2486'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1F87'                         SUB_AE:
  1F87'   CD 08B4'              	CALL	ATEOF
  1F8A'   D2 1F54'              	JNC	SUBLP		; ... unless that ran off the end of the file
  1F8D'                         SUBDON:
  1F8D'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  1F90'   3A 2484'              	LDA	SANY
  1F93'   B7                    	ORA	A
  1F94'   CA 1FB2'              	JZ	SUBNFD
  1F97'   3E 01                 	MVI	A,1
  1F99'   32 23E2'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  1F9C'   2A 2486'              	LHLD	SBACK
  1F9F'   7C                    	MOV	A,H
  1FA0'   B5                    	ORA	L
  1FA1'   CA 1FAC'              	JZ	SUB_PL
  1FA4'   3E FF                 	MVI	A,0FFH
  1FA6'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  1FA9'   CD 0000*              	CALL	CLRCNT
  1FAC'                         SUB_PL:
  1FAC'   CD 0DF9'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  1FAF'   C3 062B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  1FB2'                         SUBNFD:
  1FB2'   2A 248A'              	LHLD	SOFFS
  1FB5'   CD 0000*              	CALL	GOTO
  1FB8'   2A 248C'              	LHLD	SLDLTS
  1FBB'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  1FBE'   21 1D68'              	LXI	H,SNOTFD
  1FC1'   CD 1CDE'              	CALL	EXERR
  1FC4'   21 0000*              	LXI	H,SRCHST
  1FC7'   C3 1CD9'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  1FCA'                         SUBBAD:
  1FCA'   21 1D56'              	LXI	H,SNOT
  1FCD'   C3 1CD3'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  1FD0'                         SUBLIN:
  1FD0'   AF                    	XRA	A
  1FD1'   32 2485'              	STA	SLCHG
  1FD4'   CD 204F'              	CALL	SUBBOL
  1FD7'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  1FDA'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  1FDA'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  1FDD'   DA 1FE5'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  1FE0'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  1FE2'   C2 1FDA'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  1FE5'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  1FE5'   CD 0000*              	CALL	CUROFF
  1FE8'   E5                    	PUSH	H
  1FE9'   CD 119A'              	CALL	CEND
  1FEC'   D1                    	POP	D
  1FED'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  1FF0'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  1FF1'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  1FF4'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  1FF5'   B7                    	ORA	A		;   span is a line, not a pair.)
  1FF6'   FA 2048'              	JM	SUBL_D		; what is left is shorter than the pattern
  1FF9'   44                    	MOV	B,H
  1FFA'   4D                    	MOV	C,L		; BC = the start positions a match can take
  1FFB'   11 0000*              	LXI	D,SRCHST
  1FFE'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2001'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2004'   DA 2048'              	JC	SUBL_D
  2007'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  200A'   EB                    	XCHG
  200B'   2A 0000*              	LHLD	GAPEND
  200E'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  200F'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2012'   EB                    	XCHG
  2013'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2014'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2017'   D1                    	POP	D
  2018'   19                    	DAD	D		; ... and so the match's logical offset
  2019'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  201C'   3A 2484'              	LDA	SANY
  201F'   B7                    	ORA	A
  2020'   C2 202D'              	JNZ	SUBL_C
  2023'   3A 2485'              	LDA	SLCHG
  2026'   B7                    	ORA	A
  2027'   C2 202D'              	JNZ	SUBL_C
  202A'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  202D'                         SUBL_C:
  202D'   3A 0000*              	LDA	SRCHBF
  2030'   6F                    	MOV	L,A
  2031'   26 00                 	MVI	H,0
  2033'   CD 0000*              	CALL	DELFWD		; the match goes
  2036'   11 248E'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2039'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  203C'                         SUBL_I:
  203C'   3E 01                 	MVI	A,1
  203E'   32 2485'              	STA	SLCHG
  2041'   3A 2483'              	LDA	SGFLAG
  2044'   B7                    	ORA	A
  2045'   C2 1FE5'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2048'                         SUBL_D:
  2048'   CD 204F'              	CALL	SUBBOL
  204B'   3A 2485'              	LDA	SLCHG
  204E'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  204F'                         SUBBOL:
  204F'   CD 0000*              	CALL	CUROFF
  2052'   CD 04F6'              	CALL	BOL
  2055'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2058'                         VC_SRCH:
  2058'   CD 060A'              	CALL	SETMOV
  205B'   C5                    	PUSH	B
  205C'   CD 059D'              	CALL	GETCNT
  205F'   22 2476'              	SHLD	SCNT
  2062'   C1                    	POP	B
  2063'   79                    	MOV	A,C
  2064'   FE 2F                 	CPI	'/'
  2066'   3E 00                 	MVI	A,0
  2068'   CA 206D'              	JZ	VS_DIR
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  206B'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  206D'                         VS_DIR:
  206D'   32 2453'              	STA	SDIR
  2070'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2073'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2076'   47                    	MOV	B,A
  2077'   CD 182E'              	CALL	RDLINE
  207A'   B7                    	ORA	A
  207B'   C0                    	RNZ			; cancelled: nothing happens at all
  207C'   3A 242B'              	LDA	RLLEN
  207F'   B7                    	ORA	A
  2080'   CA 2095'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2083'   5F                    	MOV	E,A
  2084'   16 00                 	MVI	D,0
  2086'   21 0000*              	LXI	H,SRCHST
  2089'   19                    	DAD	D
  208A'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  208C'   7B                    	MOV	A,E
  208D'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2090'   3E 01                 	MVI	A,1
  2092'   32 2455'              	STA	SHAVE
  2095'                         VS_OLD:
  2095'   3A 2455'              	LDA	SHAVE
  2098'   B7                    	ORA	A
  2099'   CA 20A5'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  209C'   3A 2453'              	LDA	SDIR
  209F'   32 2454'              	STA	SDIRE
  20A2'   C3 20CE'              	JMP	SRCHN
  20A5'                         VS_NOP:
  20A5'   21 1D7C'              	LXI	H,SNOPAT
  20A8'   C3 1CDE'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  20AB'                         VC_N:
  20AB'   CD 060A'              	CALL	SETMOV
  20AE'   3A 2453'              	LDA	SDIR
  20B1'   C3 20BB'              	JMP	VN_GO
  20B4'                         VCB_N:
  20B4'   CD 060A'              	CALL	SETMOV
  20B7'   3A 2453'              	LDA	SDIR
  20BA'   2F                    	CMA			; the other way: 0 <-> FFH
  20BB'                         VN_GO:
  20BB'   32 2454'              	STA	SDIRE
  20BE'   CD 059D'              	CALL	GETCNT
  20C1'   22 2476'              	SHLD	SCNT
  20C4'   3A 2455'              	LDA	SHAVE
  20C7'   B7                    	ORA	A
  20C8'   CA 20A5'              	JZ	VS_NOP
  20CB'   C3 20CE'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  20CE'                         SRCHN:
  20CE'   CD 0DE1'              	CALL	GZONE		; the screen's top line, before the cursor moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20D1'   2A 0000*              	LHLD	LNDLT
  20D4'   22 247A'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  20D7'   CD 0000*              	CALL	CUROFF
  20DA'   22 2478'              	SHLD	SOFF
  20DD'                         SN_LP:
  20DD'   CD 2115'              	CALL	SRCHGO
  20E0'   DA 20FA'              	JC	SN_BAD
  20E3'   2A 2476'              	LHLD	SCNT
  20E6'   2B                    	DCX	H
  20E7'   22 2476'              	SHLD	SCNT
  20EA'   7C                    	MOV	A,H
  20EB'   B5                    	ORA	L
  20EC'   C2 20DD'              	JNZ	SN_LP
  20EF'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  20F2'   3E 01                 	MVI	A,1
  20F4'   32 2460'              	STA	GPKEEP		; land on the match, not the first non-blank
  20F7'   C3 0DF9'              	JMP	GPLACE		; (which sets LNDLT itself)
  20FA'                         SN_BAD:
  20FA'   CD 0000*              	CALL	CLRCNT
  20FD'   2A 2478'              	LHLD	SOFF
  2100'   CD 0000*              	CALL	GOTO
  2103'   2A 247A'              	LHLD	SLDLT
  2106'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  2109'   21 1D68'              	LXI	H,SNOTFD
  210C'   CD 1CDE'              	CALL	EXERR
  210F'   21 0000*              	LXI	H,SRCHST
  2112'   C3 1CD9'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2115'                         SRCHGO:
  2115'   3E 01                 	MVI	A,1
  2117'   32 247C'              	STA	SSKIP		; this pass starts one past the cursor
  211A'   CD 212C'              	CALL	SRCHW
  211D'   D0                    	RNC
  211E'   3A 2454'              	LDA	SDIRE
  2121'   2F                    	CMA
  2122'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2125'   AF                    	XRA	A
  2126'   32 247C'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2129'   C3 212C'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  212C'                         SRCHW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  212C'   3A 2454'              	LDA	SDIRE
  212F'   32 0000*              	STA	DIRFLG
  2132'   21 FFFF               	LXI	H,0FFFFH
  2135'   22 23DF'              	SHLD	CMDCNT
  2138'   AF                    	XRA	A
  2139'   32 0000*              	STA	AUXCNT
  213C'                         SW_LP:
  213C'   CD 2148'              	CALL	SRCH1
  213F'   D0                    	RNC
  2140'   CD 0000*              	CALL	SCRLST
  2143'   D2 213C'              	JNC	SW_LP
  2146'   37                    	STC
  2147'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2148'                         SRCH1:
  2148'   11 0000*              	LXI	D,SRCHST
  214B'   3A 0000*              	LDA	DIRFLG
  214E'   B7                    	ORA	A
  214F'   FA 2173'              	JM	SR1_BK
  2152'   21 0000*              	LXI	H,GAPEND
  2155'   CD 0000*              	CALL	FWDCNT
  2158'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  215B'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  215C'   3A 247C'              	LDA	SSKIP
  215F'   B7                    	ORA	A
  2160'   CA 2169'              	JZ	SR1_FW
  2163'   78                    	MOV	A,B
  2164'   B1                    	ORA	C
  2165'   37                    	STC
  2166'   C8                    	RZ			; no room for a match even before the skip
  2167'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2168'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2169'                         SR1_FW:
  2169'   CD 0000*              	CALL	MATCHF
  216C'   D8                    	RC
  216D'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2170'   C3 0000*              	JMP	PUTCUR
  2173'                         SR1_BK:
  2173'   21 0000*              	LXI	H,TXTBEG
  2176'   CD 0000*              	CALL	FWDCNT
  2179'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  217C'   D8                    	RC
  217D'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2180'   CD 0000*              	CALL	MATCHB
  2183'   D8                    	RC
  2184'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2187'                         MSGNAM:
  2187'   E5                    	PUSH	H
  2188'   3E 22                 	MVI	A,'"'
  218A'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  218D'   E1                    	POP	H
  218E'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  218F'   23                    	INX	H
  2190'   7E                    	MOV	A,M
  2191'   FE 20                 	CPI	' '
  2193'   C2 21A0'              	JNZ	MN_HAS
  2196'   21 1DCB'              	LXI	H,SNONM
  2199'   CD 0000*              	CALL	OUTSTR
  219C'   E1                    	POP	H
  219D'   C3 21EA'              	JMP	MN_END
  21A0'                         MN_HAS:
  21A0'   0E 19                 	MVI	C,BF_CURDSK
  21A2'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  21A5'   E1                    	POP	H
  21A6'   E5                    	PUSH	H
  21A7'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  21A8'   BE                    	CMP	M
  21A9'   CA 21B7'              	JZ	MN_NAM
  21AC'   7E                    	MOV	A,M
  21AD'   C6 40                 	ADI	'A'-1
  21AF'   CD 0000*              	CALL	OUTCH
  21B2'   3E 3A                 	MVI	A,':'
  21B4'   CD 0000*              	CALL	OUTCH
  21B7'                         MN_NAM:
  21B7'   E1                    	POP	H
  21B8'   E5                    	PUSH	H
  21B9'   23                    	INX	H
  21BA'   0E 08                 	MVI	C,8
  21BC'                         MN_NM:
  21BC'   7E                    	MOV	A,M
  21BD'   FE 20                 	CPI	' '
  21BF'   CA 21CA'              	JZ	MN_EXT
  21C2'   CD 0000*              	CALL	OUTCH
  21C5'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21C6'   0D                    	DCR	C
  21C7'   C2 21BC'              	JNZ	MN_NM
  21CA'                         MN_EXT:
  21CA'   E1                    	POP	H
  21CB'   11 0009               	LXI	D,9
  21CE'   19                    	DAD	D		; the type field
  21CF'   7E                    	MOV	A,M
  21D0'   FE 20                 	CPI	' '
  21D2'   CA 21EA'              	JZ	MN_END
  21D5'   3E 2E                 	MVI	A,'.'
  21D7'   CD 0000*              	CALL	OUTCH
  21DA'   0E 03                 	MVI	C,3
  21DC'                         MN_XL:
  21DC'   7E                    	MOV	A,M
  21DD'   FE 20                 	CPI	' '
  21DF'   CA 21EA'              	JZ	MN_END
  21E2'   CD 0000*              	CALL	OUTCH
  21E5'   23                    	INX	H
  21E6'   0D                    	DCR	C
  21E7'   C2 21DC'              	JNZ	MN_XL
  21EA'                         MN_END:
  21EA'   3E 22                 	MVI	A,'"'
  21EC'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  21EF'                         MSGFLG:
  21EF'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  21F1'   B7                    	ORA	A
  21F2'   CA 2202'              	JZ	MF_RO
  21F5'   3A 23E2'              	LDA	MODF
  21F8'   B7                    	ORA	A
  21F9'   CA 2202'              	JZ	MF_RO
  21FC'   21 1DD5'              	LXI	H,SMODM
  21FF'   CD 2217'              	CALL	MF_PUT
  2202'                         MF_RO:
  2202'   3A 2441'              	LDA	ROFLAG
  2205'   B7                    	ORA	A
  2206'   CA 220F'              	JZ	MF_NEW
  2209'   21 1DE0'              	LXI	H,SROM
  220C'   CD 2217'              	CALL	MF_PUT
  220F'                         MF_NEW:
  220F'   3A 243F'              	LDA	MSGNEW
  2212'   B7                    	ORA	A
  2213'   C8                    	RZ
  2214'   21 1DEB'              	LXI	H,SNEWM
  2217'                         MF_PUT:
  2217'   78                    	MOV	A,B
  2218'   B7                    	ORA	A
  2219'   C2 2225'              	JNZ	MF_STR
  221C'   06 01                 	MVI	B,1
  221E'   E5                    	PUSH	H
  221F'   3E 20                 	MVI	A,' '
  2221'   CD 0000*              	CALL	OUTCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2224'   E1                    	POP	H
  2225'                         MF_STR:
  2225'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2228'                         EMITW:
  2228'   C5                    	PUSH	B
  2229'   D5                    	PUSH	D
  222A'   06 00                 	MVI	B,0
  222C'   11 2710               	LXI	D,10000
  222F'   CD 224D'              	CALL	EWDIG
  2232'   11 03E8               	LXI	D,1000
  2235'   CD 224D'              	CALL	EWDIG
  2238'   11 0064               	LXI	D,100
  223B'   CD 224D'              	CALL	EWDIG
  223E'   11 000A               	LXI	D,10
  2241'   CD 224D'              	CALL	EWDIG
  2244'   7D                    	MOV	A,L		; the units digit is always printed
  2245'   C6 30                 	ADI	'0'
  2247'   CD 0000*              	CALL	OUTCH
  224A'   D1                    	POP	D
  224B'   C1                    	POP	B
  224C'   C9                    	RET
  224D'                         EWDIG:
  224D'   0E 00                 	MVI	C,0
  224F'                         EW_LP:
  224F'   7D                    	MOV	A,L
  2250'   93                    	SUB	E
  2251'   6F                    	MOV	L,A
  2252'   7C                    	MOV	A,H
  2253'   9A                    	SBB	D
  2254'   67                    	MOV	H,A
  2255'   DA 225C'              	JC	EW_DN
  2258'   0C                    	INR	C
  2259'   C3 224F'              	JMP	EW_LP
  225C'                         EW_DN:
  225C'   19                    	DAD	D		; one subtraction too many: give it back
  225D'   79                    	MOV	A,C
  225E'   B7                    	ORA	A
  225F'   C2 2265'              	JNZ	EW_PR
  2262'   78                    	MOV	A,B
  2263'   B7                    	ORA	A
  2264'   C8                    	RZ			; a leading zero: write nothing
  2265'                         EW_PR:
  2265'   79                    	MOV	A,C
  2266'   C6 30                 	ADI	'0'
  2268'   CD 0000*              	CALL	OUTCH
  226B'   06 01                 	MVI	B,1
  226D'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  226E'                         ISEMPT:
  226E'   2A 0000*              	LHLD	OUTPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2271'   7C                    	MOV	A,H
  2272'   B5                    	ORA	L
  2273'   C0                    	RNZ
  2274'   CD 0000*              	CALL	LOGLEN
  2277'   7C                    	MOV	A,H
  2278'   B5                    	ORA	L
  2279'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  227A'                         MSGCTG:
  227A'   21 0000*              	LXI	H,FNAME
  227D'   CD 2187'              	CALL	MSGNAM
  2280'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2282'   CD 21EF'              	CALL	MSGFLG
  2285'   CD 226E'              	CALL	ISEMPT
  2288'   C2 2291'              	JNZ	MG_POS
  228B'   21 1DFE'              	LXI	H,SNOLIN
  228E'   C3 0000*              	JMP	OUTSTR
  2291'                         MG_POS:
  2291'   21 1DF1'              	LXI	H,SLINE
  2294'   CD 0000*              	CALL	OUTSTR
  2297'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  229A'   23                    	INX	H		;   ... so the line it is on
  229B'   CD 2228'              	CALL	EMITW
  229E'   21 1DF8'              	LXI	H,SCOLM
  22A1'   CD 0000*              	CALL	OUTSTR
  22A4'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  22A7'   23                    	INX	H
  22A8'   E5                    	PUSH	H
  22A9'   CD 2228'              	CALL	EMITW
  22AC'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  22AF'   23                    	INX	H
  22B0'   D1                    	POP	D
  22B1'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  22B4'   C8                    	RZ
  22B5'   E5                    	PUSH	H
  22B6'   3E 2D                 	MVI	A,'-'
  22B8'   CD 0000*              	CALL	OUTCH
  22BB'   E1                    	POP	H
  22BC'   C3 2228'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  22BF'                         FILMSG:
  22BF'   3A 0001*              	LDA	FNAME+1
  22C2'   FE 20                 	CPI	' '
  22C4'   C8                    	RZ
  22C5'   21 0000*              	LXI	H,FNAME
  22C8'   CD 2187'              	CALL	MSGNAM
  22CB'   AF                    	XRA	A		; nothing has been changed yet
  22CC'   C3 21EF'              	JMP	MSGFLG
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  22CF'                         WRMSG:
  22CF'   21 0000*              	LXI	H,TFCB
  22D2'   CD 2187'              	CALL	MSGNAM
  22D5'   21 1E10'              	LXI	H,SWRIT
  22D8'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  22DB'                         MSGPST:
  22DB'   3A 243E'              	LDA	MSGWHT
  22DE'   B7                    	ORA	A
  22DF'   C8                    	RZ
  22E0'   47                    	MOV	B,A
  22E1'   AF                    	XRA	A
  22E2'   32 243E'              	STA	MSGWHT
  22E5'   78                    	MOV	A,B
  22E6'   FE 01                 	CPI	MW_FIL
  22E8'   CA 22F6'              	JZ	MP_FIL
  22EB'   FE 02                 	CPI	MW_WRT
  22ED'   CA 22FC'              	JZ	MP_WRT
  22F0'   CD 227A'              	CALL	MSGCTG
  22F3'   C3 0000*              	JMP	SCURS
  22F6'                         MP_FIL:
  22F6'   CD 22BF'              	CALL	FILMSG
  22F9'   C3 0000*              	JMP	SCURS
  22FC'                         MP_WRT:
  22FC'   CD 22CF'              	CALL	WRMSG
  22FF'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2302'                         VC_CTLG:
  2302'   3E 03                 	MVI	A,MW_CTG
  2304'   32 243E'              	STA	MSGWHT
  2307'   3E 01                 	MVI	A,R_MOVE
  2309'   32 23E3'              	STA	RINTENT
  230C'   C9                    	RET
                                
  230D'                         CMDTAB:
  230D'   07                    	DB	07H			; ^G -- where am I?
  230E'   2302'                 	DW	VC_CTLG
  2310'   68                    	DB	'h'
  2311'   0663'                 	DW	VC_H
  2313'   6C                    	DB	'l'
  2314'   068D'                 	DW	VC_L
  2316'   6A                    	DB	'j'
  2317'   0752'                 	DW	VC_J
  2319'   6B                    	DB	'k'
  231A'   0761'                 	DW	VC_K
  231C'   30                    	DB	'0'
  231D'   06B4'                 	DW	VC_0
  231F'   5E                    	DB	'^'
  2320'   06D2'                 	DW	VC_CRT
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2322'   24                    	DB	'$'
  2323'   0710'                 	DW	VC_EOL
  2325'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2326'   0734'                 	DW	VC_CR
  2328'   77                    	DB	'w'
  2329'   0936'                 	DW	VC_W
  232B'   62                    	DB	'b'
  232C'   0987'                 	DW	VC_B
  232E'   65                    	DB	'e'
  232F'   0AEC'                 	DW	VC_E
  2331'   57                    	DB	'W'
  2332'   093D'                 	DW	VCBGW
  2334'   42                    	DB	'B'
  2335'   098E'                 	DW	VCBGB
  2337'   45                    	DB	'E'
  2338'   0AF3'                 	DW	VCBGE
  233A'   47                    	DB	'G'
  233B'   0D4E'                 	DW	VC_G
  233D'   67                    	DB	'g'
  233E'   0D82'                 	DW	VC_LG
  2340'   78                    	DB	'x'
  2341'   1163'                 	DW	VC_X
  2343'   5A                    	DB	'Z'
  2344'   18AE'                 	DW	VC_BZ
  2346'   66                    	DB	'f'
  2347'   023A'                 	DW	VC_FF
  2349'   46                    	DB	'F'
  234A'   023F'                 	DW	VC_FB
  234C'   74                    	DB	't'
  234D'   0244'                 	DW	VC_TF
  234F'   54                    	DB	'T'
  2350'   0249'                 	DW	VC_TB
  2352'   3B                    	DB	';'
  2353'   0265'                 	DW	VC_SEMI
  2355'   2C                    	DB	','
  2356'   026F'                 	DW	VC_COMMA
  2358'   79                    	DB	'y'
  2359'   1432'                 	DW	VC_Y
  235B'   59                    	DB	'Y'
  235C'   143A'                 	DW	VY_YY
  235E'   70                    	DB	'p'
  235F'   1626'                 	DW	VC_P
  2361'   50                    	DB	'P'
  2362'   163B'                 	DW	VCB_P
  2364'   69                    	DB	'i'
  2365'   11BB'                 	DW	VC_I
  2367'   61                    	DB	'a'
  2368'   11C1'                 	DW	VC_A
  236A'   41                    	DB	'A'
  236B'   11E1'                 	DW	VCB_A
  236D'   49                    	DB	'I'
  236E'   11FD'                 	DW	VCB_I
  2370'   72                    	DB	'r'
  2371'   1346'                 	DW	VC_R
  2373'   52                    	DB	'R'
