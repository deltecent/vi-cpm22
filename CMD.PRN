  0B97'                         LNINC:
  0B97'   E5                    	PUSH	H
  0B98'   2A 0000*              	LHLD	LNDLT
  0B9B'   7C                    	MOV	A,H
  0B9C'   FE 40                 	CPI	40H
  0B9E'   CA 0BB3'              	JZ	LN_X
  0BA1'   23                    	INX	H
  0BA2'   C3 0BB0'              	JMP	LN_ST
  0BA5'                         LNDEC:
  0BA5'   E5                    	PUSH	H
  0BA6'   2A 0000*              	LHLD	LNDLT
  0BA9'   7C                    	MOV	A,H
  0BAA'   FE C0                 	CPI	0C0H
  0BAC'   CA 0BB3'              	JZ	LN_X
  0BAF'   2B                    	DCX	H
  0BB0'                         LN_ST:
  0BB0'   22 0000*              	SHLD	LNDLT
  0BB3'                         LN_X:
  0BB3'   E1                    	POP	H
  0BB4'   C9                    	RET
                                
  0BB5'   AF                    VC_E:	XRA	A
  0BB6'   32 24BF'              	STA	WBIG
  0BB9'   C3 0BC1'              	JMP	EDO
  0BBC'   3E 01                 VCBGE:	MVI	A,1
  0BBE'   32 24BF'              	STA	WBIG
  0BC1'   CD 06D3'              EDO:	CALL	SETMOV
  0BC4'   CD 0666'              	CALL	GETCNT
  0BC7'   22 24EB'              	SHLD	CNTV
  0BCA'   2A 24EB'              EDO_LP: LHLD	CNTV
  0BCD'   7C                    	MOV	A,H
  0BCE'   B5                    	ORA	L
  0BCF'   C8                    	RZ
  0BD0'   2B                    	DCX	H
  0BD1'   22 24EB'              	SHLD	CNTV
  0BD4'   CD 0BDA'              	CALL	ESTEP
  0BD7'   C3 0BCA'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
