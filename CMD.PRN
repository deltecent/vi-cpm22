  2791'   11 0000*              	LXI	D,TFCB
  2794'   23                    	INX	H
  2795'   7E                    	MOV	A,M
  2796'   2B                    	DCX	H
  2797'   FE 3A                 	CPI	':'
  2799'   C2 27AB'              	JNZ	PF_NM
  279C'   CD 27F1'              	CALL	GETFNC
