  0907'   D1                    	POP	D		; DE = moved
  0908'   2A 2464'              	LHLD	JKN
  090B'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  090E'   DA 0912'              	JC	KC_AD
  0911'   EB                    	XCHG			; DE = N
  0912'                         KC_AD:
  0912'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0915'   CD 0000*              	CALL	SUBHD
  0918'   22 0000*              	SHLD	LNDLT
