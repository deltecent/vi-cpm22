  0C8D'   22 2A5F'              	SHLD	WKN
  0C90'   2A 2A5D'              	LHLD	WKI
  0C93'   23                    	INX	H
  0C94'   22 2A5D'              	SHLD	WKI
  0C97'                         ES_WS:
