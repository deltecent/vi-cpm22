  0B9A'   7C                    	MOV	A,H
  0B9B'   FE C0                 	CPI	0C0H
  0B9D'   CA 0BA4'              	JZ	LN_X
  0BA0'   2B                    	DCX	H
  0BA1'                         LN_ST:
  0BA1'   22 0000*              	SHLD	LNDLT
  0BA4'                         LN_X:
  0BA4'   E1                    	POP	H
