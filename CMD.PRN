  2979'   2E                    	DB	'.'			; '.' -- repeat the last change
  297A'   0195'                 	DW	VC_DOT
  297C'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  297D'   050D'                 	DW	VC_UNDO
  297F'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2980'   0354'                 	DW	VC_MK
  2982'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2983'   0359'                 	DW	VC_BQ
  2985'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2986'   035E'                 	DW	VC_AQ
