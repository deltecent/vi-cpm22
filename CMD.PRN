  0894'                         KC_B0:
  0894'   D1                    	POP	D
  0895'                         KC_BOF:
  0895'   2A 23F2'              	LHLD	JKN		; moved = LFs found
  0898'   CD 0000*              	CALL	SUBHD
  089B'                         KC_MV:
  089B'   E5                    	PUSH	H
  089C'   2A 23F0'              	LHLD	JKCNT
  089F'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  08A2'   D1                    	POP	D		; DE = moved
  08A3'   2A 23F2'              	LHLD	JKN
