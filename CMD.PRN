  0A62'   CA 0A85'              	JZ	JL_NX		; a CR
  0A65'   EB                    	XCHG
  0A66'   22 2A24'              	SHLD	JKLS		; the last content char so far
  0A69'   EB                    	XCHG
  0A6A'   4F                    	MOV	C,A
  0A6B'   06 00                 	MVI	B,0
  0A6D'   09                    	DAD	B		; HL = the column after this char
  0A6E'   22 2A22'              	SHLD	JKVC
  0A71'   D5                    	PUSH	D
  0A72'   EB                    	XCHG
  0A73'   2A 2A12'              	LHLD	GOALCOL
