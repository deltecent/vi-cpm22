  0ADB'   EB                    	XCHG
  0ADC'   2A 2F23'              	LHLD	JKMOV
  0ADF'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0AE2'   D2 0AE6'              	JNC	JC_AD
  0AE5'   EB                    	XCHG
