  27A2'   D6 40                 	SUI	40H
  27A4'   12                    	STAX	D
  27A5'   FE 11                 	CPI	17
  27A7'   D2 27CF'              	JNC	PF_BAD
  27AA'   23                    	INX	H
  27AB'                         PF_NM:
