  2648'                         GF_DN:
  2648'   B7                    	ORA	A
  2649'   C9                    	RET
  264A'                         GF_CTL:
  264A'   BF                    	CMP	A
  264B'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  264C'                         SKIPB:
  264C'   7E                    	MOV	A,M
  264D'   FE 20                 	CPI	' '
  264F'   C2 2656'              	JNZ	SB_DN
  2652'   23                    	INX	H
  2653'   C3 264C'              	JMP	SKIPB
  2656'                         SB_DN:
  2656'   B7                    	ORA	A
  2657'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
