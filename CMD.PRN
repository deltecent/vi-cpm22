  11A4'   96                    	SUB	M
  11A5'   81                    	ADD	C
  11A6'   5F                    	MOV	E,A
  11A7'   23                    	INX	H
  11A8'   C3 11AE'              	JMP	VHU_C
  11AB'                         VHU_F:
  11AB'   7B                    	MOV	A,E		; ... the first line back: all of it
  11AC'   81                    	ADD	C
  11AD'   5F                    	MOV	E,A
  11AE'                         VHU_C:
  11AE'   22 0000*              	SHLD	HFTP
