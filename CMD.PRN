  1185'   96                    	SUB	M
  1186'   81                    	ADD	C
  1187'   5F                    	MOV	E,A
  1188'   23                    	INX	H
  1189'   C3 118F'              	JMP	VHU_C
  118C'                         VHU_F:
  118C'   7B                    	MOV	A,E		; ... the first line back: all of it
  118D'   81                    	ADD	C
  118E'   5F                    	MOV	E,A
  118F'                         VHU_C:
  118F'   22 2F14'              	SHLD	HFTP
  1192'   4B                    	MOV	C,E
  1193'   3A 2F17'              	LDA	HTCUR
  1196'   CD 11D5'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  1199'   3A 0000*              	LDA	CSUB
  119C'   57                    	MOV	D,A
  119D'   79                    	MOV	A,C
  119E'   92                    	SUB	D		; the rows to go, less those of its own line above it
  119F'   DA 1116'              	JC	HFEND
  11A2'   CA 1116'              	JZ	HFEND
  11A5'   4F                    	MOV	C,A
  11A6'   43                    	MOV	B,E
  11A7'   CD 1204'              	CALL	HTBQ		; (off the top: the file's first line)
  11AA'   C3 1116'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11AD'                         HTSCR:
  11AD'   CD 0EBB'              	CALL	CURRW
  11B0'   47                    	MOV	B,A
  11B1'   C3 11BF'              	JMP	HS_TP
  11B4'                         HTSET:
  11B4'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  11B5'   CD 0EBB'              	CALL	CURRW		; (keeps BC)
  11B8'   F5                    	PUSH	PSW
  11B9'   80                    	ADD	B
  11BA'   47                    	MOV	B,A
  11BB'   CD 11C9'              	CALL	HTRB
  11BE'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11BF'                         HS_TP:
  11BF'   3A 2F17'              	LDA	HTCUR
  11C2'   90                    	SUB	B
  11C3'   32 2F18'              	STA	HTTP
  11C6'   C3 11D5'              	JMP	HTPT
  11C9'                         HTRB:
  11C9'   CD 13A7'              	CALL	ZSAVE
  11CC'   CD 0000*              	CALL	HTBLD
  11CF'   CD 13BA'              	CALL	ZREST
  11D2'   3A 2F17'              	LDA	HTCUR
  11D5'                         HTPT:
  11D5'   5F                    	MOV	E,A
  11D6'   16 00                 	MVI	D,0
  11D8'   21 0000*              	LXI	H,HTAB
  11DB'   19                    	DAD	D
  11DC'   3A 2F16'              	LDA	HTN
  11DF'   93                    	SUB	E
  11E0'   47                    	MOV	B,A
  11E1'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  11E2'                         HTIX:
  11E2'   11 0000*              	LXI	D,HTAB
  11E5'   7D                    	MOV	A,L
  11E6'   93                    	SUB	E
  11E7'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  11E8'                         HTGO:
  11E8'   CD 11E2'              	CALL	HTIX
  11EB'   47                    	MOV	B,A
  11EC'   3A 2F17'              	LDA	HTCUR
  11EF'   90                    	SUB	B		; A = the lines up to it
  11F0'   C3 0EF2'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  11F3'                         HTFQ:
  11F3'   78                    	MOV	A,B
  11F4'   B7                    	ORA	A
  11F5'   37                    	STC
  11F6'   C8                    	RZ
  11F7'   79                    	MOV	A,C
  11F8'   96                    	SUB	M
  11F9'   DA 1202'              	JC	HF_IN
  11FC'   4F                    	MOV	C,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11FD'   23                    	INX	H
  11FE'   05                    	DCR	B
  11FF'   C3 11F3'              	JMP	HTFQ
  1202'                         HF_IN:
  1202'   B7                    	ORA	A
  1203'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1204'                         HTBQ:
  1204'   78                    	MOV	A,B
  1205'   B7                    	ORA	A
  1206'   37                    	STC
  1207'   C8                    	RZ
  1208'   2B                    	DCX	H
  1209'   05                    	DCR	B
  120A'   7E                    	MOV	A,M
  120B'   91                    	SUB	C
  120C'   D2 1215'              	JNC	HQ_IN
  120F'   2F                    	CMA
  1210'   3C                    	INR	A
  1211'   4F                    	MOV	C,A
  1212'   C3 1204'              	JMP	HTBQ
  1215'                         HQ_IN:
  1215'   4F                    	MOV	C,A
  1216'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1217'                         RWQ:
  1217'   0E 64                 	MVI	C,100
  1219'   3A 2F1C'              	LDA	RWR+1
  121C'   B7                    	ORA	A
  121D'   C0                    	RNZ
  121E'   3A 2F1B'              	LDA	RWR
  1221'   B9                    	CMP	C
  1222'   D0                    	RNC
  1223'   4F                    	MOV	C,A
  1224'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1225'                         RWSUB:
  1225'   E5                    	PUSH	H
  1226'   5F                    	MOV	E,A
  1227'   16 00                 	MVI	D,0
  1229'   2A 2F1B'              	LHLD	RWR
  122C'   CD 0000*              	CALL	SUBHD
  122F'   22 2F1B'              	SHLD	RWR
  1232'   E1                    	POP	H
  1233'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1234'                         RWFWD:
  1234'   CD 1217'              	CALL	RWQ
  1237'   51                    	MOV	D,C
  1238'   CD 11F3'              	CALL	HTFQ
  123B'   F5                    	PUSH	PSW
  123C'   7A                    	MOV	A,D
  123D'   91                    	SUB	C		; the rows that took it to that line's first
  123E'   CD 1225'              	CALL	RWSUB
  1241'   F1                    	POP	PSW
  1242'   DA 1256'              	JC	RF_OFF
  1245'   3A 2F1C'              	LDA	RWR+1		; is what is left inside this line?
  1248'   B7                    	ORA	A
  1249'   C2 1260'              	JNZ	RF_GO
  124C'   3A 2F1B'              	LDA	RWR
  124F'   BE                    	CMP	M
  1250'   D2 1260'              	JNC	RF_GO
  1253'   4F                    	MOV	C,A
  1254'   B7                    	ORA	A
  1255'   C9                    	RET
  1256'                         RF_OFF:
  1256'   3A 2F19'              	LDA	HTEOF
  1259'   B7                    	ORA	A
  125A'   CA 1260'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  125D'   2B                    	DCX	H
  125E'   37                    	STC
  125F'   C9                    	RET
  1260'                         RF_GO:
  1260'   CD 11E8'              	CALL	HTGO
  1263'   3E 01                 	MVI	A,1
  1265'   32 2F1D'              	STA	RWMV
  1268'   CD 1217'              	CALL	RWQ
  126B'   0C                    	INR	C
  126C'   06 00                 	MVI	B,0
  126E'   CD 11C9'              	CALL	HTRB
  1271'   C3 1234'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1274'                         RWBAK:
  1274'   CD 1217'              	CALL	RWQ
  1277'   51                    	MOV	D,C
  1278'   CD 1204'              	CALL	HTBQ
  127B'   DA 1298'              	JC	RB_OFF
  127E'   7A                    	MOV	A,D
  127F'   81                    	ADD	C
  1280'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1281'   3A 2F1C'              	LDA	RWR+1
  1284'   B7                    	ORA	A
  1285'   C2 1294'              	JNZ	RB_ON
  1288'   3A 2F1B'              	LDA	RWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  128B'   57                    	MOV	D,A
  128C'   7B                    	MOV	A,E
  128D'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  128E'   DA 1294'              	JC	RB_ON
  1291'   4F                    	MOV	C,A
  1292'   B7                    	ORA	A
  1293'   C9                    	RET
  1294'                         RB_ON:
  1294'   7B                    	MOV	A,E
  1295'   C3 129F'              	JMP	RB_GO
  1298'                         RB_OFF:
  1298'   3A 2F1A'              	LDA	HTBOF
  129B'   0F                    	RRC			; CY: that is the file's first line
  129C'   D8                    	RC
  129D'   7A                    	MOV	A,D
  129E'   91                    	SUB	C
  129F'                         RB_GO:
  129F'   CD 1225'              	CALL	RWSUB
  12A2'   CD 11E8'              	CALL	HTGO
  12A5'   3E 01                 	MVI	A,1
  12A7'   32 2F1D'              	STA	RWMV
  12AA'   CD 1217'              	CALL	RWQ
  12AD'   41                    	MOV	B,C
  12AE'   0E 01                 	MVI	C,1
  12B0'   CD 11C9'              	CALL	HTRB
  12B3'   43                    	MOV	B,E
  12B4'   C3 1274'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12B7'                         ONFST:
  12B7'   E5                    	PUSH	H
  12B8'   2A 0000*              	LHLD	OUTPOS
  12BB'   7C                    	MOV	A,H
  12BC'   B5                    	ORA	L
  12BD'   C2 12D5'              	JNZ	OF_RET
  12C0'   2A 0000*              	LHLD	TXTBEG
  12C3'   EB                    	XCHG			; DE = TXTBEG
  12C4'   2A 0000*              	LHLD	GAPBEG
  12C7'                         OF_LP:
  12C7'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12CA'   CA 12D5'              	JZ	OF_RET
  12CD'   2B                    	DCX	H
  12CE'   7E                    	MOV	A,M
  12CF'   FE 0A                 	CPI	LF
  12D1'   C2 12C7'              	JNZ	OF_LP
  12D4'   B7                    	ORA	A		; NZ
  12D5'                         OF_RET:
  12D5'   E1                    	POP	H
  12D6'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12D7'                         HFCNT:
  12D7'   2A 2F03'              	LHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12DA'   7C                    	MOV	A,H
  12DB'   B5                    	ORA	L
  12DC'   CA 12F3'              	JZ	HFC_AM
  12DF'   CD 0786'              	CALL	GETCNT		; HL = count; clears it
  12E2'   3A 0000*              	LDA	NEDIT
  12E5'   5F                    	MOV	E,A
  12E6'   16 00                 	MVI	D,0
  12E8'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  12EB'   D2 12EF'              	JNC	HFC_ST
  12EE'   EB                    	XCHG			; HL = NEDIT
  12EF'                         HFC_ST:
  12EF'   7D                    	MOV	A,L
  12F0'   32 2F12'              	STA	HFAMT
  12F3'                         HFC_AM:
  12F3'   3A 2F12'              	LDA	HFAMT
  12F6'   B7                    	ORA	A
  12F7'   C2 1304'              	JNZ	HFC_HL
  12FA'   3A 0000*              	LDA	NEDIT
  12FD'   B7                    	ORA	A
  12FE'   1F                    	RAR
  12FF'   B7                    	ORA	A
  1300'   C2 1304'              	JNZ	HFC_HL
  1303'   3C                    	INR	A		; at least one row
  1304'                         HFC_HL:
  1304'   32 2F13'              	STA	HFN
  1307'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1308'                         VC_REDR:
  1308'   C3 0786'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  130B'                         VC_G:
  130B'   CD 085B'              	CALL	SETMOV
  130E'   CD 13CD'              	CALL	GZONE		; the screen's top line, before the move
  1311'   CD 07AF'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1314'   2A 2F03'              	LHLD	CMDCNT
  1317'   7C                    	MOV	A,H
  1318'   B5                    	ORA	L
  1319'   C2 132C'              	JNZ	VG_N
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  131C'   AF                    	XRA	A		; forward
  131D'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1320'   CD 07EC'              	CALL	BRKOFF
  1323'   DA 0804'              	JC	BRKBAK
  1326'   CD 0BDD'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1329'   C3 13E5'              	JMP	GPLACE
  132C'                         VG_N:
  132C'   CD 0786'              	CALL	GETCNT		; HL = target line (1-based)
  132F'                         VG_LN:
  132F'   CD 133B'              	CALL	GOLN
  1332'   CD 07EC'              	CALL	BRKOFF
  1335'   DA 0804'              	JC	BRKBAK
  1338'   C3 13E5'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  133B'                         GOLN:
  133B'   E5                    	PUSH	H
  133C'   CD 0000*              	CALL	CNTLF
  133F'   23                    	INX	H		; HL = the cursor's line
  1340'   D1                    	POP	D		; DE = the line wanted
  1341'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1344'   DA 134F'              	JC	GLN_BK
  1347'   EB                    	XCHG
  1348'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  134B'   AF                    	XRA	A
  134C'   C3 1354'              	JMP	GLN_MV
  134F'                         GLN_BK:
  134F'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1352'   3E FF                 	MVI	A,0FFH
  1354'                         GLN_MV:
  1354'   CD 0000*              	CALL	MVLIND
  1357'   CD 0BD7'              	CALL	ATEOF
  135A'   DC 0BDD'              	CC	LASTLN		; past the last line: onto it
  135D'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  135E'                         VC_LG:
  135E'   CD 085B'              	CALL	SETMOV
  1361'   3A 2F39'              	LDA	GSAVE
  1364'   B7                    	ORA	A
  1365'   C2 136E'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  1368'   3E 01                 	MVI	A,PG
  136A'   32 2F38'              	STA	GPEND
  136D'   C9                    	RET
  136E'                         VLG_GG:
  136E'   CD 13CD'              	CALL	GZONE
  1371'   CD 07AF'              	CALL	BRKON
  1374'   CD 0786'              	CALL	GETCNT		; HL = target line (no count: 1)
  1377'   C3 132F'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  137A'                         SUB24:
  137A'   4F                    	MOV	C,A
  137B'   7D                    	MOV	A,L
  137C'   93                    	SUB	E
  137D'   6F                    	MOV	L,A
  137E'   7C                    	MOV	A,H
  137F'   9A                    	SBB	D
  1380'   67                    	MOV	H,A
  1381'   79                    	MOV	A,C
  1382'   98                    	SBB	B
  1383'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1384'                         CURFP:
  1384'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  1387'                         FPOS:
  1387'   C5                    	PUSH	B
  1388'   D5                    	PUSH	D
  1389'   EB                    	XCHG
  138A'   2A 0000*              	LHLD	TXTBEG
  138D'   EB                    	XCHG
  138E'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  1391'   EB                    	XCHG			; DE = that
  1392'   2A 0000*              	LHLD	OUTPOS
  1395'   7C                    	MOV	A,H
  1396'   B7                    	ORA	A		; CY = 0
  1397'   1F                    	RAR
  1398'   47                    	MOV	B,A
  1399'   7D                    	MOV	A,L
  139A'   1F                    	RAR
  139B'   67                    	MOV	H,A
  139C'   3E 00                 	MVI	A,0
  139E'   1F                    	RAR
  139F'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13A0'   19                    	DAD	D
  13A1'   78                    	MOV	A,B
  13A2'   CE 00                 	ACI	0		; A:HL = the position
  13A4'   D1                    	POP	D
  13A5'   C1                    	POP	B
  13A6'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13A7'                         ZSAVE:
  13A7'   2A 2F03'              	LHLD	CMDCNT
  13AA'   22 2F75'              	SHLD	ZSVCNT
  13AD'   2A 0000*              	LHLD	AUXCNT
  13B0'   22 2F77'              	SHLD	ZSVAUX
  13B3'   3A 0000*              	LDA	DIRFLG
  13B6'   32 2F79'              	STA	ZSVDIR
  13B9'   C9                    	RET
  13BA'                         ZREST:
  13BA'   2A 2F75'              	LHLD	ZSVCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13BD'   22 2F03'              	SHLD	CMDCNT
  13C0'   2A 2F77'              	LHLD	ZSVAUX
  13C3'   22 0000*              	SHLD	AUXCNT
  13C6'   3A 2F79'              	LDA	ZSVDIR
  13C9'   32 0000*              	STA	DIRFLG
  13CC'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  13CD'                         GZONE:
  13CD'   CD 13A7'              	CALL	ZSAVE
  13D0'   CD 0EBB'              	CALL	CURRW
  13D3'   6F                    	MOV	L,A
  13D4'   26 00                 	MVI	H,0
  13D6'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  13D9'   CD 1387'              	CALL	FPOS
  13DC'   22 0000*              	SHLD	ZTOP
  13DF'   32 0002*              	STA	ZTOP+2
  13E2'   C3 13BA'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  13E5'                         GPLACE:
  13E5'   CD 13A7'              	CALL	ZSAVE
  13E8'   CD 1384'              	CALL	CURFP
  13EB'   EB                    	XCHG
  13EC'   2A 0000*              	LHLD	ZTOP
  13EF'   EB                    	XCHG
  13F0'   4F                    	MOV	C,A		; C:HL = the target's position
  13F1'   3A 0002*              	LDA	ZTOP+2
  13F4'   47                    	MOV	B,A		; B:DE = the top's
  13F5'   79                    	MOV	A,C
  13F6'   CD 137A'              	CALL	SUB24
  13F9'   22 2F72'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  13FC'   DA 1436'              	JC	GP_UP
  13FF'   B7                    	ORA	A
  1400'   C2 147C'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1403'   3A 0000*              	LDA	NEDIT
  1406'   87                    	ADD	A
  1407'   3C                    	INR	A
  1408'   6F                    	MOV	L,A
  1409'   26 00                 	MVI	H,0
  140B'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  140E'   CD 077F'              	CALL	GBSUB		; HL = bytes from there to the target
  1411'   EB                    	XCHG
  1412'   2A 2F72'              	LHLD	ZDIF		; HL = bytes from the top to the target
  1415'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  1418'   DA 147C'              	JC	GP_MID
  141B'   CD 077F'              	CALL	GBSUB		; HL = the top line's start (resident)
  141E'   01 0000               	LXI	B,0		; BC = lines from the top
  1421'                         GP_CNT:
  1421'   7A                    	MOV	A,D
  1422'   B3                    	ORA	E
  1423'   CA 1432'              	JZ	GP_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1426'   7E                    	MOV	A,M
  1427'   23                    	INX	H
  1428'   1B                    	DCX	D
  1429'   FE 0A                 	CPI	LF
  142B'   C2 1421'              	JNZ	GP_CNT
  142E'   03                    	INX	B
  142F'   C3 1421'              	JMP	GP_CNT
  1432'                         GP_DN:
  1432'   79                    	MOV	A,C		; the lines from the top one to it
  1433'   C3 14A6'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  1436'                         GP_UP:
  1436'   3C                    	INR	A
  1437'   C2 147C'              	JNZ	GP_MID		; 64K bytes or more above
  143A'   2A 2F72'              	LHLD	ZDIF
  143D'   EB                    	XCHG
  143E'   21 0000               	LXI	H,0
  1441'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1444'   7C                    	MOV	A,H
  1445'   B5                    	ORA	L
  1446'   CA 147C'              	JZ	GP_MID		; exactly 64K
  1449'   EB                    	XCHG			; DE = bytes to read
  144A'   AF                    	XRA	A
  144B'   32 2F74'              	STA	ZLF
  144E'   CD 0000*              	CALL	RGET0
  1451'                         GP_RD:
  1451'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1454'   DA 147C'              	JC	GP_MID
  1457'   FE 0A                 	CPI	LF
  1459'   C2 146D'              	JNZ	GP_RN
  145C'   3A 0000*              	LDA	NEDIT
  145F'   B7                    	ORA	A
  1460'   1F                    	RAR
  1461'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1463'   E5                    	PUSH	H
  1464'   21 2F74'              	LXI	H,ZLF
  1467'   34                    	INR	M
  1468'   BE                    	CMP	M		; CY iff more lines than that
  1469'   E1                    	POP	H
  146A'   DA 147C'              	JC	GP_MID
  146D'                         GP_RN:
  146D'   1B                    	DCX	D
  146E'   7A                    	MOV	A,D
  146F'   B3                    	ORA	E
  1470'   C2 1451'              	JNZ	GP_RD
  1473'   3E 01                 	MVI	A,PL_SET	; the top row
  1475'   32 0000*              	STA	PLACE
  1478'   AF                    	XRA	A
  1479'   C3 1486'              	JMP	GP_SET
  147C'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  147C'   3E 02                 	MVI	A,PL_MID
  147E'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1481'   3A 0000*              	LDA	NEDIT
  1484'   B7                    	ORA	A
  1485'   1F                    	RAR			; (no more lines above it than this)
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1486'                         GP_SET:
  1486'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1487'   26 00                 	MVI	H,0
  1489'   22 0000*              	SHLD	WINROW
  148C'   21 0000               	LXI	H,0
  148F'   22 0000*              	SHLD	LNDLT
  1492'   CD 0898'              	CALL	SETFUL		; the window may have paged: full repaint
  1495'                         GP_FIN:
  1495'   CD 13BA'              	CALL	ZREST
  1498'   3A 2F9D'              	LDA	GPKEEP
  149B'   B7                    	ORA	A
  149C'   CA 0954'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  149F'   AF                    	XRA	A
  14A0'   32 2F9D'              	STA	GPKEEP
  14A3'   C3 0611'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14A6'                         GP_ONS:
  14A6'   6F                    	MOV	L,A
  14A7'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14A9'   EB                    	XCHG
  14AA'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14AD'   EB                    	XCHG
  14AE'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14B1'   22 0000*              	SHLD	LNDLT
  14B4'   3E 01                 	MVI	A,R_MOVE
  14B6'   32 2F07'              	STA	RINTENT
  14B9'   C3 1495'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14BC'                         OPPEND:
  14BC'   AF                    	XRA	A
  14BD'   32 2F3E'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14C0'   3A 2F3B'              	LDA	PSAVE
  14C3'   FE 63                 	CPI	'c'
  14C5'   C2 14E2'              	JNZ	OPP_ND
  14C8'   79                    	MOV	A,C
  14C9'   FE 77                 	CPI	'w'
  14CB'   CA 14D3'              	JZ	OPP_W
  14CE'   FE 57                 	CPI	'W'
  14D0'   C2 14E2'              	JNZ	OPP_ND
  14D3'                         OPP_W:
  14D3'   CD 16B5'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  14D6'   DA 14E2'              	JC	OPP_ND
  14D9'   79                    	MOV	A,C
  14DA'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  14DC'   4F                    	MOV	C,A
  14DD'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  14DF'   32 2F3E'              	STA	CWEOL		;   char for the next word's: see ESTEP
  14E2'                         OPP_ND:
  14E2'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  14E3'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  14E5'   C2 14F9'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  14E8'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  14EB'   DA 1589'              	JC	OPABRT
  14EE'   79                    	MOV	A,C
  14EF'   FE 67                 	CPI	'g'
  14F1'   C2 1589'              	JNZ	OPABRT
  14F4'   3E 01                 	MVI	A,PG
  14F6'   32 2F39'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  14F9'                         OPP_NG:
  14F9'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  14FA'   21 2F3B'              	LXI	H,PSAVE
  14FD'   BE                    	CMP	M
  14FE'   CA 16D6'              	JZ	OPLINE
  1501'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1502'   CD 16EC'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1505'   DA 1589'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  1508'   32 2F3D'              	STA	OPCLSV
  150B'   47                    	MOV	B,A		; B = the class
  150C'   3A 2F3B'              	LDA	PSAVE
  150F'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1511'   C2 151D'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1514'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1515'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  1517'   C2 153F'              	JNZ	OPP_GO
  151A'   C3 1528'              	JMP	OPP_NO
  151D'                         OPP_NC:
  151D'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  151F'   C2 153F'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1522'   78                    	MOV	A,B		;   a charwise register would need a type flag
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1523'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1525'   CA 153F'              	JZ	OPP_GO		;   within a line -- neither of which is built
  1528'                         OPP_NO:
  1528'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1529'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  152B'   CA 1539'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  152E'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1530'   CA 1539'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1533'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1536'   C2 1589'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1539'                         OPP_SW:
  1539'   CD 01F9'              	CALL	MKGETK
  153C'   C3 1589'              	JMP	OPABRT
  153F'                         OPP_GO:
  153F'   AF                    	XRA	A
  1540'   32 2F11'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1543'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1546'   22 2F3F'              	SHLD	OPSTA
  1549'   C5                    	PUSH	B
  154A'   21 2F43'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  154D'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  1550'   3A 2F3D'              	LDA	OPCLSV
  1553'   FE 02                 	CPI	2
  1555'   CC 158C'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  1558'   C1                    	POP	B
  1559'   21 2E4A'              	LXI	H,CMDTAB
  155C'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  155F'   3A 2F3B'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1562'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1563'   CA 085B'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1566'   CD 15B8'              	CALL	OPSFIX		; where the start is in the window NOW
  1569'   D2 15D4'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  156C'   22 2F3F'              	SHLD	OPSTA
  156F'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1572'   22 2F41'              	SHLD	OPEND2
  1575'   3A 2F3B'              	LDA	PSAVE
  1578'   FE 79                 	CPI	'y'
  157A'   CA 1C8E'              	JZ	OPYANK		; a yank takes the span without losing it
  157D'   CD 1727'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1580'   3A 2F3B'              	LDA	PSAVE
  1583'   FE 63                 	CPI	'c'
  1585'   C0                    	RNZ
  1586'   C3 1A42'              	JMP	SETINS
  1589'                         OPABRT:				; not a motion -> the operator is dropped and
  1589'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  158C'                         OPENDS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  158C'   2A 2F3F'              	LHLD	OPSTA
  158F'   CD 0678'              	CALL	BOL
  1592'   11 2F46'              	LXI	D,OPSLO
  1595'   CD 15AA'              	CALL	OPE_ST
  1598'   2A 2F3F'              	LHLD	OPSTA
  159B'   CD 070F'              	CALL	NLSTART
  159E'   11 2F49'              	LXI	D,OPSHI
  15A1'   CD 15AA'              	CALL	OPE_ST
  15A4'   2A 2F3F'              	LHLD	OPSTA
  15A7'   C3 0000*              	JMP	GOTO
  15AA'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  15AA'   D5                    	PUSH	D
  15AB'   CD 0000*              	CALL	GOTO
  15AE'   E1                    	POP	H
  15AF'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  15B2'                         CURBD:
  15B2'   CD 1384'              	CALL	CURFP
  15B5'   EB                    	XCHG
  15B6'   47                    	MOV	B,A
  15B7'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  15B8'                         OPSFIX:
  15B8'   21 2F43'              	LXI	H,OPSFP
  15BB'   CD 03DC'              	CALL	MKLOAD
  15BE'   CD 15B2'              	CALL	CURBD
  15C1'   2A 2FA7'              	LHLD	MKPOS
  15C4'   3A 2FA9'              	LDA	MKPOS+2
  15C7'   CD 137A'              	CALL	SUB24
  15CA'   B4                    	ORA	H
  15CB'   B5                    	ORA	L
  15CC'   C2 03E9'              	JNZ	MKWIN
  15CF'   CD 0000*              	CALL	CUROFF
  15D2'   37                    	STC
  15D3'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  15D4'                         OPPGD:
  15D4'   47                    	MOV	B,A
  15D5'   3A 2F3D'              	LDA	OPCLSV
  15D8'   FE 02                 	CPI	2
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  15DA'   C2 1696'              	JNZ	OPG_NO
  15DD'   3A 2F3B'              	LDA	PSAVE
  15E0'   FE 64                 	CPI	'd'
  15E2'   C2 1696'              	JNZ	OPG_NO
  15E5'   04                    	INR	B
  15E6'   CA 15F5'              	JZ	OPG_FW
  15E9'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  15EC'   CD 0678'              	CALL	BOL		;   and the high end is OPSHI as it stands
  15EF'   CD 0000*              	CALL	GOTO
  15F2'   C3 160D'              	JMP	OPG_GO
  15F5'                         OPG_FW:
  15F5'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  15F8'   CD 070F'              	CALL	NLSTART		;   landed on, and the low one is where the
  15FB'   11 2F49'              	LXI	D,OPSHI		;   start line began
  15FE'   CD 15AA'              	CALL	OPE_ST
  1601'   21 2F46'              	LXI	H,OPSLO
  1604'   CD 03DC'              	CALL	MKLOAD
  1607'   CD 03A9'              	CALL	MKPAGE
  160A'   CD 0000*              	CALL	GOTO
  160D'                         OPG_GO:
  160D'   CD 15B2'              	CALL	CURBD
  1610'   2A 2F49'              	LHLD	OPSHI
  1613'   3A 2F4B'              	LDA	OPSHI+2
  1616'   CD 137A'              	CALL	SUB24		; A:HL = the bytes to take
  1619'                         OPG_SV:
  1619'   22 2F4C'              	SHLD	OPTOGO
  161C'   32 2F4E'              	STA	OPTOGO+2
  161F'                         OPG_NX:
  161F'   CD 0762'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1622'   CD 0000*              	CALL	SUBHD
  1625'   EB                    	XCHG			; DE = what the window holds past the cursor
  1626'   2A 2F4C'              	LHLD	OPTOGO
  1629'   3A 2F4E'              	LDA	OPTOGO+2
  162C'   B7                    	ORA	A
  162D'   C2 1660'              	JNZ	OPG_PG		; 64K or more to go
  1630'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1633'   DA 1660'              	JC	OPG_PG
  1636'   CA 1660'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1639'                         OPG_FN:				; the rest of it is here
  1639'   E5                    	PUSH	H
  163A'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  163D'   CD 0000*              	CALL	CUROFF
  1640'   22 2F4F'              	SHLD	OPLO
  1643'   D1                    	POP	D
  1644'   19                    	DAD	D
  1645'   22 2F51'              	SHLD	OPHI
  1648'   CD 185A'              	CALL	OPDSPN
  164B'   CD 0BD7'              	CALL	ATEOF
  164E'   D2 16AF'              	JNC	OPMID
  1651'   CD 12B7'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1654'   CA 16AF'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1657'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  165A'   CD 0000*              	CALL	SETBWD
  165D'   C3 16AF'              	JMP	OPMID
  1660'                         OPG_PG:
  1660'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1661'   B3                    	ORA	E
  1662'   C2 167B'              	JNZ	OPG_DL
  1665'   CD 0BD7'              	CALL	ATEOF		; nothing held past the cursor
  1668'   21 0000               	LXI	H,0
  166B'   DA 1639'              	JC	OPG_FN		; ... and no more to come: the file ran out
  166E'   2B                    	DCX	H
  166F'   CD 0000*              	CALL	SETC0
  1672'   CD 0000*              	CALL	GOLINE
  1675'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1678'   C3 161F'              	JMP	OPG_NX
  167B'                         OPG_DL:
  167B'   D5                    	PUSH	D
  167C'   21 FFFF               	LXI	H,0FFFFH
  167F'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1682'   E1                    	POP	H
  1683'   E5                    	PUSH	H
  1684'   CD 0000*              	CALL	DELFWD
  1687'   D1                    	POP	D
  1688'   06 00                 	MVI	B,0
  168A'   2A 2F4C'              	LHLD	OPTOGO
  168D'   3A 2F4E'              	LDA	OPTOGO+2
  1690'   CD 137A'              	CALL	SUB24
  1693'   C3 1619'              	JMP	OPG_SV
  1696'                         OPG_NO:
  1696'   0E 07                 	MVI	C,BEL
  1698'   CD 0000*              	CALL	BCONOU
  169B'                         OPG_HM:				; the cursor back where the command found it
  169B'   21 2F43'              	LXI	H,OPSFP
  169E'   CD 03DC'              	CALL	MKLOAD
  16A1'   CD 03A9'              	CALL	MKPAGE
  16A4'   CD 0000*              	CALL	GOTO
  16A7'   AF                    	XRA	A
  16A8'   32 2F3B'              	STA	PSAVE
  16AB'   3C                    	INR	A
  16AC'   32 2F9D'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  16AF'                         OPMID:
  16AF'   CD 13A7'              	CALL	ZSAVE
  16B2'   C3 147C'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  16B5'                         ONWHIT:
  16B5'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16B8'   CA 16D4'              	JZ	OW_YES
  16BB'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  16BE'   FE 20                 	CPI	' '
  16C0'   CA 16D4'              	JZ	OW_YES
  16C3'   FE 09                 	CPI	TAB
  16C5'   CA 16D4'              	JZ	OW_YES
  16C8'   FE 0D                 	CPI	CR
  16CA'   CA 16D4'              	JZ	OW_YES
  16CD'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16CF'   CA 16D4'              	JZ	OW_YES
  16D2'   B7                    	ORA	A		; a char to change: CY clear
  16D3'   C9                    	RET
  16D4'                         OW_YES:
  16D4'   37                    	STC
  16D5'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  16D6'                         OPLINE:
  16D6'   3A 2F3B'              	LDA	PSAVE
  16D9'   FE 63                 	CPI	'c'
  16DB'   CA 085B'              	JZ	SETMOV
  16DE'   FE 79                 	CPI	'y'
  16E0'   CA 1C6D'              	JZ	VY_YY
  16E3'   21 2F43'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  16E6'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  16E9'   C3 1BE3'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  16EC'                         OPCLS:
  16EC'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  16EE'   CA 16FB'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  16F1'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  16F3'   C2 170F'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  16F6'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  16F8'   C3 16FD'              	JMP	OPC_FK
  16FB'                         OPC_SEM:
  16FB'   06 00                 	MVI	B,0		; ';' runs it as it stands
  16FD'                         OPC_FK:
  16FD'   3A 2F93'              	LDA	FNDKND
  1700'   B7                    	ORA	A
  1701'   37                    	STC
  1702'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1703'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1704'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1706'   CA 170D'              	JZ	OPC_EXC
  1709'   3E 01                 	MVI	A,1
  170B'   B7                    	ORA	A		; CY clear: a motion, class 1
  170C'   C9                    	RET
  170D'                         OPC_EXC:
  170D'   AF                    	XRA	A		; class 0, CY clear
  170E'   C9                    	RET
  170F'                         OPC_TB:
  170F'   47                    	MOV	B,A
  1710'   21 18FF'              	LXI	H,OPCTAB
  1713'                         OPC_LP:
  1713'   7E                    	MOV	A,M
  1714'   B7                    	ORA	A
  1715'   CA 1725'              	JZ	OPC_MS		; end of table -> not a motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1718'   B8                    	CMP	B
  1719'   CA 1721'              	JZ	OPC_HT
  171C'   23                    	INX	H
  171D'   23                    	INX	H
  171E'   C3 1713'              	JMP	OPC_LP
  1721'                         OPC_HT:
  1721'   23                    	INX	H
  1722'   7E                    	MOV	A,M		; class byte
  1723'   B7                    	ORA	A		; clear CY
  1724'   C9                    	RET
  1725'                         OPC_MS:
  1725'   37                    	STC
  1726'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1727'                         OPAPPL:
  1727'   3A 2F3D'              	LDA	OPCLSV
  172A'   FE 02                 	CPI	2
  172C'   CA 18D3'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  172F'   2A 2F3F'              	LHLD	OPSTA
  1732'   EB                    	XCHG			; DE = start
  1733'   2A 2F41'              	LHLD	OPEND2		; HL = end
  1736'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1739'   DA 174C'              	JC	OPA_F
  173C'   CA 174C'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  173F'   22 2F4F'              	SHLD	OPLO
  1742'   EB                    	XCHG
  1743'   22 2F51'              	SHLD	OPHI
  1746'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1749'   C3 1803'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  174C'                         OPA_F:
  174C'   EB                    	XCHG			; HL = start, DE = end
  174D'   22 2F4F'              	SHLD	OPLO
  1750'   EB                    	XCHG			; HL = end
  1751'   3A 2F3D'              	LDA	OPCLSV
  1754'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1756'   CA 1800'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1759'   FE 01                 	CPI	1
  175B'   C2 177D'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  175E'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  175F'   22 2F51'              	SHLD	OPHI		; park it: CEND clobbers DE
  1762'   2B                    	DCX	H		; the line it landed on
  1763'   CD 19C0'              	CALL	CEND		; HL = that line's content end
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1766'   EB                    	XCHG			; DE = it
  1767'   2A 2F51'              	LHLD	OPHI		; HL = hi
  176A'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  176D'   D2 1788'              	JNC	OPA_HI		; hi is inside the line: keep it
  1770'   2A 2F4F'              	LHLD	OPLO
  1773'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1776'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1779'   EB                    	XCHG			; HL = the content end: the span stops there
  177A'   C3 1788'              	JMP	OPA_HI
  177D'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  177D'   22 2F51'              	SHLD	OPHI
  1780'   3A 2F11'              	LDA	WPULL
  1783'   B7                    	ORA	A
  1784'   CA 1803'              	JZ	OPA_C1
  1787'   23                    	INX	H
  1788'                         OPA_HI:
  1788'   22 2F51'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  178B'                         OPA_DO:
  178B'   CD 184F'              	CALL	OPSPNL
  178E'   7C                    	MOV	A,H
  178F'   B5                    	ORA	L
  1790'   C2 1799'              	JNZ	OPA_D1
  1793'   2A 2F4F'              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  1796'   C3 0000*              	JMP	GOTO		;   to where the span starts
  1799'                         OPA_D1:
  1799'   3A 2F3B'              	LDA	PSAVE
  179C'   FE 63                 	CPI	'c'
  179E'   CA 185A'              	JZ	OPDSPN
  17A1'   CD 1842'              	CALL	SPNBRK
  17A4'   D2 17C5'              	JNC	OPA_D2
  17A7'   2A 2F51'              	LHLD	OPHI
  17AA'   CD 19C0'              	CALL	CEND
  17AD'   EB                    	XCHG			; DE = the content end of the line it ends in
  17AE'   2A 2F51'              	LHLD	OPHI
  17B1'                         OPA_BL:
  17B1'   CD 0000*              	CALL	CMP16
  17B4'   CA 17CB'              	JZ	OPA_BI		; only blanks after it
  17B7'   D5                    	PUSH	D
  17B8'   E5                    	PUSH	H
  17B9'   CD 0000*              	CALL	CHARAT
  17BC'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17BD'   D1                    	POP	D
  17BE'   23                    	INX	H
  17BF'   CD 17FA'              	CALL	BLANKQ
  17C2'   CA 17B1'              	JZ	OPA_BL
  17C5'                         OPA_D2:
  17C5'   CD 185A'              	CALL	OPDSPN
  17C8'   C3 19D1'              	JMP	CLAMPE
  17CB'                         OPA_BI:
  17CB'   CD 17DD'              	CALL	LOIND
  17CE'   C2 17C5'              	JNZ	OPA_D2
  17D1'   2A 2F51'              	LHLD	OPHI
  17D4'   CD 070F'              	CALL	NLSTART
  17D7'   22 2F51'              	SHLD	OPHI
  17DA'   C3 182E'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  17DD'                         LOIND:
  17DD'   2A 2F4F'              	LHLD	OPLO
  17E0'   CD 0678'              	CALL	BOL
  17E3'                         LI_LP:
  17E3'   E5                    	PUSH	H
  17E4'   EB                    	XCHG
  17E5'   2A 2F4F'              	LHLD	OPLO
  17E8'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  17EB'   E1                    	POP	H
  17EC'   C8                    	RZ
  17ED'   E5                    	PUSH	H
  17EE'   CD 0000*              	CALL	CHARAT
  17F1'   E1                    	POP	H
  17F2'   23                    	INX	H
  17F3'   CD 17FA'              	CALL	BLANKQ
  17F6'   CA 17E3'              	JZ	LI_LP
  17F9'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  17FA'                         BLANKQ:
  17FA'   FE 20                 	CPI	' '
  17FC'   C8                    	RZ
  17FD'   FE 09                 	CPI	TAB
  17FF'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1800'                         OPA_JP:
  1800'   22 2F51'              	SHLD	OPHI
  1803'                         OPA_C1:
  1803'   CD 184F'              	CALL	OPSPNL
  1806'   7C                    	MOV	A,H
  1807'   B5                    	ORA	L
  1808'   CA 178B'              	JZ	OPA_DO		; nothing spanned
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  180B'   2A 2F51'              	LHLD	OPHI
  180E'   CD 0678'              	CALL	BOL
  1811'   EB                    	XCHG
  1812'   2A 2F51'              	LHLD	OPHI
  1815'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1818'   C2 178B'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  181B'   CD 17DD'              	CALL	LOIND
  181E'   CA 182E'              	JZ	C1_LW		; only blanks before lo: whole lines
  1821'                         C1_CH:
  1821'   2A 2F51'              	LHLD	OPHI		; back over the line break to the content end
  1824'   2B                    	DCX	H		;   of the line before
  1825'   CD 19C0'              	CALL	CEND
  1828'   22 2F51'              	SHLD	OPHI
  182B'   C3 178B'              	JMP	OPA_DO
  182E'                         C1_LW:
  182E'   2A 2F4F'              	LHLD	OPLO
  1831'   CD 0678'              	CALL	BOL
  1834'   22 2F4F'              	SHLD	OPLO
  1837'   3A 2F3B'              	LDA	PSAVE
  183A'   FE 63                 	CPI	'c'
  183C'   CA 1821'              	JZ	C1_CH
  183F'   C3 18E6'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1842'                         SPNBRK:
  1842'   2A 2F4F'              	LHLD	OPLO
  1845'   CD 06BB'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1848'   EB                    	XCHG			; DE = it
  1849'   2A 2F51'              	LHLD	OPHI
  184C'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  184F'                         OPSPNL:
  184F'   2A 2F51'              	LHLD	OPHI
  1852'   EB                    	XCHG
  1853'   2A 2F4F'              	LHLD	OPLO
  1856'   EB                    	XCHG			; HL = hi, DE = lo
  1857'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  185A'                         OPDSPN:
  185A'   CD 1842'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  185D'   F5                    	PUSH	PSW
  185E'   2A 2F3F'              	LHLD	OPSTA
  1861'   EB                    	XCHG
  1862'   2A 2F4F'              	LHLD	OPLO
  1865'   22 2F57'              	SHLD	WKI
  1868'   CD 0000*              	CALL	CMP16
  186B'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  186C'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  186F'   CD 184F'              	CALL	OPSPNL		; HL = hi - lo
  1872'   CD 0861'              	CALL	SETLIN
  1875'   F1                    	POP	PSW
  1876'   CC 198F'              	CZ	DCHQ
  1879'   CD 0000*              	CALL	DELFWD
  187C'   CD 0174'              	CALL	MARKMOD
  187F'   F1                    	POP	PSW
  1880'   D0                    	RNC
  1881'   C3 0898'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1884'                         UNDFNB:
  1884'   CD 0000*              	CALL	CUROFF
  1887'   E5                    	PUSH	H
  1888'   CD 0954'              	CALL	FNBLNK
  188B'   CD 0000*              	CALL	CUROFF
  188E'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  188F'   CD 0000*              	CALL	CMP16
  1892'   D2 0000*              	JNC	UNDHER
  1895'   EB                    	XCHG
  1896'   CD 0000*              	CALL	GOTO
  1899'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  189C'                         OPALSP:
  189C'   2A 2F3F'              	LHLD	OPSTA
  189F'   EB                    	XCHG
  18A0'   2A 2F41'              	LHLD	OPEND2
  18A3'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  18A6'   DA 18B6'              	JC	OPAL_F
  18A9'   22 2F4F'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  18AC'   EB                    	XCHG
  18AD'   22 2F51'              	SHLD	OPHI		; hi-src = start
  18B0'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  18B3'   C3 18C0'              	JMP	OPAL_R
  18B6'                         OPAL_F:
  18B6'   EB                    	XCHG			; HL = start
  18B7'   22 2F4F'              	SHLD	OPLO		; lo-src = start
  18BA'   2A 2F41'              	LHLD	OPEND2
  18BD'   22 2F51'              	SHLD	OPHI		; hi-src = end
  18C0'                         OPAL_R:
  18C0'   2A 2F4F'              	LHLD	OPLO
  18C3'   CD 0678'              	CALL	BOL
  18C6'   22 2F4F'              	SHLD	OPLO		; lo = BOL(low line)
  18C9'   2A 2F51'              	LHLD	OPHI
  18CC'   CD 070F'              	CALL	NLSTART
  18CF'   22 2F51'              	SHLD	OPHI		; hi = start of line past the high line
  18D2'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  18D3'                         OPALIN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18D3'   CD 189C'              	CALL	OPALSP
  18D6'   2A 2F4F'              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  18D9'   CD 070F'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  18DC'   EB                    	XCHG			;   the column)
  18DD'   2A 2F51'              	LHLD	OPHI
  18E0'   CD 0000*              	CALL	CMP16
  18E3'   CC 1884'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  18E6'                         OPDLIN:
  18E6'   CD 185A'              	CALL	OPDSPN
  18E9'   CD 0762'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  18EC'   DA 18FC'              	JC	OPDL_NB
  18EF'   CD 0000*              	CALL	LOGLEN
  18F2'   7C                    	MOV	A,H
  18F3'   B5                    	ORA	L
  18F4'   C8                    	RZ			; empty buffer
  18F5'   2B                    	DCX	H
  18F6'   CD 0678'              	CALL	BOL
  18F9'   CD 0000*              	CALL	GOTO
  18FC'                         OPDL_NB:
  18FC'   C3 0954'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  18FF'                         OPCTAB:
  18FF'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1903'   62 00 42 00           
  1907'   68 00 6C 00           
  190B'   30 00 5E 00           
  190F'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1911'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1915'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1919'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  191D'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1921'   24 01                 
  1923'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1927'   47 02 48 02           
  192B'   4D 02 4C 02           
  192F'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1931'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1933'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1934'                         VCB_C:
  1934'   CD 1940'              	CALL	VCB_CD
  1937'   C3 1A42'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  193A'                         VCB_D:
  193A'   CD 1940'              	CALL	VCB_CD
  193D'   C3 19D1'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1940'                         VCB_CD:
  1940'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1943'   22 2F4F'              	SHLD	OPLO
  1946'   22 2F3F'              	SHLD	OPSTA
  1949'   CD 0000*              	CALL	CUROFF
  194C'   CD 19C0'              	CALL	CEND		; to the line's content end, the CR,LF left
  194F'   22 2F51'              	SHLD	OPHI
  1952'   C3 185A'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1955'                         VC_X:
  1955'   CD 0A06'              	CALL	GLSTAL
  1958'   CD 0861'              	CALL	SETLIN
  195B'   CD 0786'              	CALL	GETCNT
  195E'   22 2F53'              	SHLD	CNTV
  1961'   CD 0000*              	CALL	CUROFF
  1964'   22 2F57'              	SHLD	WKI		; cur
  1967'   CD 19C0'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  196A'   EB                    	XCHG			; DE = contentend
  196B'   2A 2F57'              	LHLD	WKI		; HL = cur
  196E'   EB                    	XCHG			; HL = contentend, DE = cur
  196F'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1972'   7C                    	MOV	A,H
  1973'   B5                    	ORA	L
  1974'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1975'   EB                    	XCHG			; DE = available
  1976'   2A 2F53'              	LHLD	CNTV		; HL = count
  1979'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  197C'   DA 1982'              	JC	VX_USEA
  197F'   C3 1983'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1982'                         VX_USEA:
  1982'   EB                    	XCHG			; HL = available
  1983'                         VX_DEL:
  1983'   CD 198F'              	CALL	DCHQ
  1986'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1989'   CD 0174'              	CALL	MARKMOD
  198C'   C3 19D1'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  198F'                         DCHQ:
  198F'   E5                    	PUSH	H
  1990'   CD 089E'              	CALL	TAILTAB
  1993'   E1                    	POP	H
  1994'   47                    	MOV	B,A
  1995'   7C                    	MOV	A,H		; (more of them than a byte counts)
  1996'   B7                    	ORA	A
  1997'   C0                    	RNZ
  1998'   B5                    	ORA	L
  1999'   C8                    	RZ			; (or none at all)
  199A'   32 2F0A'              	STA	DCHN
  199D'   78                    	MOV	A,B
  199E'   87                    	ADD	A
  199F'   32 2F0B'              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  19A2'   CA 19BA'              	JZ	DQ_0
  19A5'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  19A6'   FE 08                 	CPI	8
  19A8'   D0                    	RNC
  19A9'   E5                    	PUSH	H
  19AA'   2A 2F57'              	LHLD	WKI
  19AD'   EB                    	XCHG
  19AE'   2A 2F55'              	LHLD	TTI
  19B1'   CD 0000*              	CALL	SUBHD
  19B4'   EB                    	XCHG			; DE = the chars before it
  19B5'   E1                    	POP	H
  19B6'   CD 0000*              	CALL	CMP16
  19B9'   D8                    	RC
  19BA'                         DQ_0:
  19BA'   3E 07                 	MVI	A,R_DCH
  19BC'   32 2F07'              	STA	RINTENT
  19BF'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  19C0'                         CEND:
  19C0'   CD 06BB'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19C3'   7C                    	MOV	A,H
  19C4'   B5                    	ORA	L
  19C5'   C8                    	RZ			; the start of the text: nothing before it
  19C6'   2B                    	DCX	H
  19C7'   E5                    	PUSH	H
  19C8'   CD 0000*              	CALL	CHARAT
  19CB'   E1                    	POP	H		; HL = term-1
  19CC'   FE 0D                 	CPI	CR
  19CE'   C8                    	RZ			; a CR before the LF -> the content ends there
  19CF'   23                    	INX	H
  19D0'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  19D1'                         CLAMPE:
  19D1'   CD 0000*              	CALL	CUROFF
  19D4'   E5                    	PUSH	H
  19D5'   CD 071E'              	CALL	EOLC
  19D8'   D1                    	POP	D		; DE = cur
  19D9'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  19DC'   D8                    	RC
  19DD'   C8                    	RZ
  19DE'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  19E1'                         VC_I:
  19E1'   CD 0786'              	CALL	GETCNT
  19E4'   C3 1A3F'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  19E7'                         VC_A:
  19E7'   CD 0786'              	CALL	GETCNT
  19EA'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19ED'   CA 1A04'              	JZ	VA_INS
  19F0'   EB                    	XCHG			; HL = cur
  19F1'   E5                    	PUSH	H
  19F2'   CD 0000*              	CALL	CHARAT
  19F5'   E1                    	POP	H
  19F6'   FE 0A                 	CPI	LF
  19F8'   CA 1A04'              	JZ	VA_INS		; on the line terminator -> append in place
  19FB'   FE 0D                 	CPI	CR
  19FD'   CA 1A04'              	JZ	VA_INS
  1A00'   23                    	INX	H
  1A01'   CD 0000*              	CALL	GOTO
  1A04'                         VA_INS:
  1A04'   C3 1A3F'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A07'                         VCB_A:
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A07'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A0A'   CD 071E'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A0D'   E5                    	PUSH	H
  1A0E'   CD 0000*              	CALL	CHARAT
  1A11'   E1                    	POP	H
  1A12'   FE 0D                 	CPI	CR
  1A14'   CA 1A1D'              	JZ	VBA_IN		; an empty line: insert at its start
  1A17'   FE 0A                 	CPI	LF
  1A19'   CA 1A1D'              	JZ	VBA_IN
  1A1C'   23                    	INX	H		; past the last content char
  1A1D'                         VBA_IN:
  1A1D'   CD 0000*              	CALL	GOTO
  1A20'   C3 1A3F'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A23'                         VCB_I:
  1A23'   CD 0786'              	CALL	GETCNT
  1A26'   CD 0954'              	CALL	FNBLNK
  1A29'   CD 0000*              	CALL	CUROFF
  1A2C'   E5                    	PUSH	H
  1A2D'   CD 0000*              	CALL	CHARAT
  1A30'   E1                    	POP	H
  1A31'   FE 20                 	CPI	' '
  1A33'   CA 1A3B'              	JZ	VBI_SK
  1A36'   FE 09                 	CPI	TAB
  1A38'   C2 1A3F'              	JNZ	SETINM
  1A3B'                         VBI_SK:
  1A3B'   23                    	INX	H		; blanks only: past the last of them
  1A3C'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1A3F'                         SETINM:
  1A3F'   CD 085B'              	CALL	SETMOV
  1A42'                         SETINS:
  1A42'   3E 01                 	MVI	A,EM_INS
  1A44'   32 2F02'              	STA	EDMODE
  1A47'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1A48'                         ATCEND:
  1A48'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A4B'   C8                    	RZ
  1A4C'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1A4F'   FE 0D                 	CPI	CR
  1A51'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A52'   FE 0A                 	CPI	LF
  1A54'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1A55'                         OPNBRK:
  1A55'   CD 237F'              	CALL	PUTBRK
  1A58'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1A5B'   23                    	INX	H
  1A5C'   22 0000*              	SHLD	LNDLT
  1A5F'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1A62'                         ENDBRK:
  1A62'   CD 0762'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1A65'   C0                    	RNZ
  1A66'   CD 1A55'              	CALL	OPNBRK
  1A69'   CD 0000*              	CALL	CUROFF
  1A6C'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1A6D'   2B                    	DCX	H		;   line, with its own terminator after it
  1A6E'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1A71'                         VC_O:
  1A71'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A74'   CD 19C0'              	CALL	CEND
  1A77'   CD 0000*              	CALL	GOTO
  1A7A'   CD 1A55'              	CALL	OPNBRK
  1A7D'   CD 1A62'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1A80'   CD 0883'              	CALL	SETILN		;   needs a terminator of its own to exist
  1A83'   C3 1A42'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1A86'                         VCB_O:
  1A86'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A89'   CD 0678'              	CALL	BOL
  1A8C'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A8F'   CD 1A55'              	CALL	OPNBRK
  1A92'   CD 0000*              	CALL	CUROFF
  1A95'   2B                    	DCX	H
  1A96'   2B                    	DCX	H
  1A97'   CD 0000*              	CALL	GOTO
  1A9A'   CD 0883'              	CALL	SETILN
  1A9D'   C3 1A42'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1AA0'                         VCB_J:
  1AA0'   CD 0779'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AA3'   CD 19C0'              	CALL	CEND		; the join point: this line's content end
  1AA6'   22 2F4F'              	SHLD	OPLO
  1AA9'   CD 0000*              	CALL	CUROFF
  1AAC'   CD 070F'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1AAF'   E5                    	PUSH	H
  1AB0'   CD 0000*              	CALL	LOGLEN
  1AB3'   D1                    	POP	D		; DE = that start
  1AB4'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1AB7'   CA 085B'              	JZ	SETMOV
  1ABA'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1ABB'                         VJ_WS:
  1ABB'   E5                    	PUSH	H
  1ABC'   CD 0000*              	CALL	LOGLEN
  1ABF'   D1                    	POP	D		; DE = the scan
  1AC0'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1AC3'   CA 1ADA'              	JZ	VJ_DEL
  1AC6'   EB                    	XCHG			; HL = the scan
  1AC7'   E5                    	PUSH	H
  1AC8'   CD 0000*              	CALL	CHARAT
  1ACB'   E1                    	POP	H
  1ACC'   FE 20                 	CPI	' '
  1ACE'   CA 1AD6'              	JZ	VJ_SKIP
  1AD1'   FE 09                 	CPI	TAB
  1AD3'   C2 1ADA'              	JNZ	VJ_DEL
  1AD6'                         VJ_SKIP:
  1AD6'   23                    	INX	H
  1AD7'   C3 1ABB'              	JMP	VJ_WS
  1ADA'                         VJ_DEL:
  1ADA'   22 2F51'              	SHLD	OPHI
  1ADD'   CD 185A'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1AE0'   CD 0892'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1AE3'   CD 0762'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1AE6'   CA 19D1'              	JZ	CLAMPE
  1AE9'   CD 076D'              	CALL	CURCHR		; the first char of what was appended
  1AEC'   FE 0D                 	CPI	CR
  1AEE'   CA 19D1'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AF1'   FE 0A                 	CPI	LF
  1AF3'   CA 19D1'              	JZ	CLAMPE
  1AF6'   FE 29                 	CPI	')'
  1AF8'   CA 19D1'              	JZ	CLAMPE		; vim puts no space before a ')'
  1AFB'   CD 0000*              	CALL	CUROFF
  1AFE'   7C                    	MOV	A,H
  1AFF'   B5                    	ORA	L
  1B00'   CA 1B16'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B03'   2B                    	DCX	H
  1B04'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B07'   FE 20                 	CPI	' '
  1B09'   CA 19D1'              	JZ	CLAMPE
  1B0C'   FE 09                 	CPI	TAB
  1B0E'   CA 19D1'              	JZ	CLAMPE
  1B11'   FE 0A                 	CPI	LF
  1B13'   CA 19D1'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B16'                         VJ_SP:
  1B16'   3E 20                 	MVI	A,' '
  1B18'   CD 0000*              	CALL	PUTGAP
  1B1B'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B1E'   2B                    	DCX	H
  1B1F'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B22'                         VC_TILD:
  1B22'   CD 0786'              	CALL	GETCNT
  1B25'   CD 0861'              	CALL	SETLIN		; only this row changes
  1B28'   CD 0A06'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B2B'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B2E'   CA 085B'              	JZ	SETMOV
  1B31'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1B34'   FE 0D                 	CPI	CR
  1B36'   CA 085B'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B39'   FE 0A                 	CPI	LF
  1B3B'   CA 085B'              	JZ	SETMOV
  1B3E'   47                    	MOV	B,A
  1B3F'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1B41'   FE 41                 	CPI	'A'
  1B43'   DA 1B4F'              	JC	VT_PUT		; below 'A': no case
  1B46'   FE 5B                 	CPI	'Z'+1
  1B48'   D2 1B4F'              	JNC	VT_PUT		; above 'Z': no case
  1B4B'   78                    	MOV	A,B
  1B4C'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1B4E'   47                    	MOV	B,A
  1B4F'                         VT_PUT:
  1B4F'   78                    	MOV	A,B
  1B50'   32 2F5E'              	STA	VRCH		; the calls below do not preserve B
  1B53'   CD 0174'              	CALL	MARKMOD
  1B56'   21 0001               	LXI	H,1
  1B59'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B5C'   3A 2F5E'              	LDA	VRCH
  1B5F'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B62'   C3 19D1'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1B65'                         VC_R:
  1B65'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  1B68'   3E 03                 	MVI	A,PR
  1B6A'   32 2F38'              	STA	GPEND
  1B6D'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1B6E'                         VR_DO:
  1B6E'   AF                    	XRA	A
  1B6F'   32 2F38'              	STA	GPEND
  1B72'   79                    	MOV	A,C
  1B73'   32 2F5E'              	STA	VRCH		; the calls below do not preserve C
  1B76'   CD 0861'              	CALL	SETLIN		; only this row changed
  1B79'   CD 0A06'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B7C'   CD 0762'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B7F'   CA 085B'              	JZ	SETMOV		; the end of the text: vim does nothing
  1B82'   CD 076D'              	CALL	CURCHR		; A = the char under the cursor
  1B85'   FE 0D                 	CPI	CR
  1B87'   CA 085B'              	JZ	SETMOV		; the line's end: nothing to replace
  1B8A'   FE 0A                 	CPI	LF
  1B8C'   CA 085B'              	JZ	SETMOV
  1B8F'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1B91'   CD 0867'              	CALL	SETCEL
  1B94'   CD 0174'              	CALL	MARKMOD
  1B97'   21 0001               	LXI	H,1
  1B9A'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B9D'   3A 2F5E'              	LDA	VRCH
  1BA0'   FE 0D                 	CPI	CR
  1BA2'   CA 1BAF'              	JZ	VR_CR
  1BA5'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1BA8'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1BAB'   2B                    	DCX	H		;   out, which moves every logical offset
  1BAC'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1BAF'                         VR_CR:
  1BAF'   CD 1A55'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1BB2'   CD 1A62'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1BB5'   CD 0883'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1BB8'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1BBA'   32 2F0D'              	STA	ILABOV
  1BBD'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1BBE'                         VCB_R:
  1BBE'   CD 0786'              	CALL	GETCNT
  1BC1'   CD 085B'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1BC4'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BC7'   22 2F5F'              	SHLD	RPDEL		; nothing of ours to put back yet
  1BCA'   22 2F61'              	SHLD	RPAPP
  1BCD'   3E 02                 	MVI	A,EM_REP
  1BCF'   32 2F02'              	STA	EDMODE
  1BD2'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1BD3'                         VC_D:
  1BD3'   3E 64                 	MVI	A,'d'
  1BD5'   32 2F3A'              	STA	PENDOP
  1BD8'   C3 085B'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1BDB'                         VC_C:
  1BDB'   3E 63                 	MVI	A,'c'
  1BDD'   32 2F3A'              	STA	PENDOP
  1BE0'   C3 085B'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1BE3'                         VD_DD:
  1BE3'   CD 0A06'              	CALL	GLSTAL
  1BE6'   CD 0786'              	CALL	GETCNT
  1BE9'   22 2F53'              	SHLD	CNTV
  1BEC'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1BEE'   32 2F3C'              	STA	DDSNG
  1BF1'   2B                    	DCX	H
  1BF2'   7C                    	MOV	A,H
  1BF3'   B5                    	ORA	L
  1BF4'   C2 1C02'              	JNZ	VDD_LS
  1BF7'   3E 01                 	MVI	A,1
  1BF9'   32 2F3C'              	STA	DDSNG
  1BFC'   CD 1884'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1BFF'   C3 1C08'              	JMP	VDD_GO
  1C02'                         VDD_LS:
  1C02'   CD 09BF'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C05'   DA 085B'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C08'                         VDD_GO:
  1C08'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C0B'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C0E'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C11'   CD 25E2'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C14'   CD 093D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


                                				;   so the line's head would be left out of it.
  1C17'   2A 2F53'              	LHLD	CNTV
  1C1A'   CD 0000*              	CALL	SETC0
  1C1D'                         VDD_FW:
  1C1D'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C20'   DA 1D6E'              	JC	QREFUS		; ... which has no room for them
  1C23'   CD 079B'              	CALL	CNTTST
  1C26'   C2 1C1D'              	JNZ	VDD_FW
  1C29'   CD 0174'              	CALL	MARKMOD
  1C2C'   CD 0BD7'              	CALL	ATEOF
  1C2F'   D2 1C4A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C32'   3E 00                 	MVI	A,0
  1C34'   32 2F3C'              	STA	DDSNG		; deleted to the end: full repaint
  1C37'   CD 12B7'              	CALL	ONFST
  1C3A'   CA 0954'              	JZ	FNBLNK		; nothing left before it
  1C3D'   21 0001               	LXI	H,1		; onto the new last line
  1C40'   CD 0000*              	CALL	SETBWD
  1C43'   2A 0000*              	LHLD	LNDLT
  1C46'   2B                    	DCX	H
  1C47'   22 0000*              	SHLD	LNDLT
  1C4A'                         VDD_UP:
  1C4A'   CD 0954'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1C4D'   3A 2F3C'              	LDA	DDSNG
  1C50'   B7                    	ORA	A
  1C51'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1C52'   3E 03                 	MVI	A,R_DLIN
  1C54'   32 2F07'              	STA	RINTENT
  1C57'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1C58'                         QEMPTY:
  1C58'   2A 0000*              	LHLD	QBEG
  1C5B'   EB                    	XCHG
  1C5C'   2A 0000*              	LHLD	QEND
  1C5F'   7C                    	MOV	A,H
  1C60'   BA                    	CMP	D
  1C61'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C62'   7D                    	MOV	A,L
  1C63'   BB                    	CMP	E
  1C64'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1C65'                         VC_Y:
  1C65'   3E 79                 	MVI	A,'y'
  1C67'   32 2F3A'              	STA	PENDOP
  1C6A'   C3 085B'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1C6D'                         VY_YY:
  1C6D'   21 2F43'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1C70'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1C73'   CD 0000*              	CALL	CUROFF
  1C76'   22 2F82'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1C79'   CD 0678'              	CALL	BOL
  1C7C'   22 2F84'              	SHLD	YPT		; where the lines come from, to put them back
  1C7F'   CD 1DD4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C82'   CD 1E17'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1C85'   D2 1DDB'              	JNC	YNDONE
  1C88'   21 1BE3'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1C8B'   C3 1CB7'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1C8E'                         OPYANK:
  1C8E'   CD 189C'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1C91'   2A 2F3F'              	LHLD	OPSTA
  1C94'   EB                    	XCHG			; DE = start
  1C95'   2A 2F41'              	LHLD	OPEND2		; HL = end
  1C98'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1C9B'   D2 1C9F'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1C9E'   EB                    	XCHG			; ... otherwise the start is
  1C9F'                         OPY_LO:
  1C9F'   22 2F82'              	SHLD	YOFF
  1CA2'   2A 2F4F'              	LHLD	OPLO
  1CA5'   22 2F84'              	SHLD	YPT		; where the lines come from, to put them back
  1CA8'   CD 1DD4'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CAB'   CD 1E8F'              	CALL	YNSPAN		; copied where they lie, if there is room
  1CAE'   D2 1DDB'              	JNC	YNDONE
  1CB1'   21 1D95'              	LXI	H,YSPAN
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CB4'   C3 1CB7'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1CB7'                         YKGO:
  1CB7'   22 2FAC'              	SHLD	YACT
  1CBA'   2A 2F84'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1CBD'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1CBE'   2A 2F82'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1CC1'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1CC4'   22 2FB2'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1CC7'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1CCA'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1CCB'   2A 2F84'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1CCE'   EB                    	XCHG			;   window as it was, then names other text
  1CCF'   E1                    	POP	H
  1CD0'   CD 0000*              	CALL	SUBHD
  1CD3'   EB                    	XCHG			; DE = how far behind the cursor they start
  1CD4'   CD 1384'              	CALL	CURFP
  1CD7'   06 00                 	MVI	B,0
  1CD9'   CD 137A'              	CALL	SUB24
  1CDC'   22 2FB4'              	SHLD	YPFP
  1CDF'   32 2FB6'              	STA	YPFP+2
  1CE2'   3A 2F06'              	LDA	MODF
  1CE5'   32 2F7F'              	STA	YMODF
  1CE8'   3A 2F2D'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1CEB'   32 2F80'              	STA	YDCHG		;   a yank must not become the last change
  1CEE'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1CF1'   32 2F81'              	STA	YURPL		;   back are not a change to undo either
  1CF4'   3E 01                 	MVI	A,1
  1CF6'   32 0000*              	STA	UNDRPL
  1CF9'   32 2FAB'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1CFC'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1CFF'   22 2F8E'              	SHLD	YLDLT
  1D02'   CD 0000*              	CALL	LOGLEN
  1D05'   22 2FB0'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D08'   2A 2FAC'              	LHLD	YACT
  1D0B'   CD 1D6D'              	CALL	YCALL		; the lines out of the file, into the register
  1D0E'   3A 2F7A'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D11'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D13'   CA 1D51'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D16'   CD 0000*              	CALL	LOGLEN
  1D19'   EB                    	XCHG
  1D1A'   2A 2FB0'              	LHLD	YWAS
  1D1D'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D20'   CA 1D32'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D23'   21 2FB4'              	LXI	H,YPFP		; back to where they came from, by its place in
  1D26'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D29'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D2C'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D2F'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D32'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D32'   2A 2FB4'              	LHLD	YPFP		;   cursor is still owed its place)
  1D35'   EB                    	XCHG
  1D36'   2A 2FB2'              	LHLD	YCOL
  1D39'   19                    	DAD	D
  1D3A'   22 2FA7'              	SHLD	MKPOS
  1D3D'   3A 2FB6'              	LDA	YPFP+2
  1D40'   CE 00                 	ACI	0
  1D42'   32 2FA9'              	STA	MKPOS+2
  1D45'   CD 03A9'              	CALL	MKPAGE
  1D48'   CD 0000*              	CALL	GOTO
  1D4B'                         YK_RST:
  1D4B'   2A 2F8E'              	LHLD	YLDLT
  1D4E'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1D51'                         YK_RF:
  1D51'   3A 2F7F'              	LDA	YMODF
  1D54'   32 2F06'              	STA	MODF
  1D57'   3A 2F80'              	LDA	YDCHG
  1D5A'   32 2F2D'              	STA	DOTCHG
  1D5D'   3A 2F81'              	LDA	YURPL
  1D60'   32 0000*              	STA	UNDRPL
  1D63'   AF                    	XRA	A
  1D64'   32 2FAB'              	STA	MKHOLD
  1D67'   CD 0A06'              	CALL	GLSTAL
  1D6A'   C3 0898'              	JMP	SETFUL		; the cheap paint cannot carry this
  1D6D'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1D6E'                         QREFUS:
  1D6E'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1D71'   CD 1C58'              	CALL	QEMPTY
  1D74'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1D77'   CD 0000*              	CALL	QKILL
  1D7A'   3A 2FAB'              	LDA	MKHOLD
  1D7D'   B7                    	ORA	A
  1D7E'   C2 1D8D'              	JNZ	QRF_Y
  1D81'   21 0000*              	LXI	H,MKSAV
  1D84'   11 0000*              	LXI	D,MKTAB
  1D87'   CD 25E2'              	CALL	COPY12
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D8A'   CD 0000*              	CALL	UNDCLR
  1D8D'                         QRF_Y:
  1D8D'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1D8F'   32 2F7A'              	STA	MSGWHT
  1D92'   C3 169B'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1D95'                         YSPAN:
  1D95'   CD 0A06'              	CALL	GLSTAL
  1D98'   CD 184F'              	CALL	OPSPNL		; HL = the span's length
  1D9B'   22 2FAE'              	SHLD	YTGT
  1D9E'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1DA1'   EB                    	XCHG			; DE = it
  1DA2'   2A 2FAE'              	LHLD	YTGT
  1DA5'   EB                    	XCHG			; HL = the text's, DE = the span's
  1DA6'   CD 0000*              	CALL	SUBHD
  1DA9'   22 2FAE'              	SHLD	YTGT		; what the text is left at when the span is out
  1DAC'   2A 2F4F'              	LHLD	OPLO
  1DAF'   CD 0000*              	CALL	GOTO
  1DB2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1DB5'                         YS_LP:
  1DB5'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1DB8'   CD 0000*              	CALL	SETC0
  1DBB'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1DBE'   DA 1D6E'              	JC	QREFUS		; ... which has no room for it
  1DC1'   CD 0000*              	CALL	LOGLEN
  1DC4'   EB                    	XCHG			; DE = what is left
  1DC5'   2A 2FAE'              	LHLD	YTGT
  1DC8'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1DCB'   DA 1DD1'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1DCE'   C2 1DB5'              	JNZ	YS_LP		;   but never spin here if it ever did
  1DD1'                         YS_END:
  1DD1'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1DD4'                         YNPRE:
  1DD4'   2A 0000*              	LHLD	PGTOPM
  1DD7'   22 2FB7'              	SHLD	YNPG
  1DDA'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1DDB'                         YNDONE:
  1DDB'   2A 2F82'              	LHLD	YOFF
  1DDE'   CD 0000*              	CALL	GOTO
  1DE1'   2A 0000*              	LHLD	PGTOPM
  1DE4'   EB                    	XCHG
  1DE5'   2A 2FB7'              	LHLD	YNPG
  1DE8'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1DEB'   C2 0898'              	JNZ	SETFUL		; it moved under us: repaint after all
  1DEE'   C3 085B'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1DF1'                         YNROOM:
  1DF1'   11 0100               	LXI	D,100H
  1DF4'   19                    	DAD	D
  1DF5'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1DF6'   E5                    	PUSH	H		; the span plus its slack
  1DF7'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1DFA'   EB                    	XCHG			; HL = free
  1DFB'   D1                    	POP	D		; DE = the span plus its slack
  1DFC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1DFF'   DA 1E07'              	JC	YNR_OK
  1E02'   CA 1E07'              	JZ	YNR_OK
  1E05'   37                    	STC			; not enough: the delete-and-put-back path
  1E06'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E07'                         YNR_OK:
  1E07'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1E08'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1E09'                         YNGO:
  1E09'   C5                    	PUSH	B
  1E0A'   CD 0786'              	CALL	GETCNT		; spent here: this yank is happening
  1E0D'   CD 0A06'              	CALL	GLSTAL
  1E10'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E13'   C1                    	POP	B
  1E14'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1E17'                         YNCOPY:
  1E17'   2A 2F03'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1E1A'   7C                    	MOV	A,H		;   the count itself
  1E1B'   B5                    	ORA	L
  1E1C'   C2 1E22'              	JNZ	YNC_HV
  1E1F'   21 0001               	LXI	H,1
  1E22'                         YNC_HV:
  1E22'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1E23'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1E24'   B4                    	ORA	H
  1E25'   CA 1E30'              	JZ	YNC_M
  1E28'   E5                    	PUSH	H
  1E29'   CD 09BF'              	CALL	ONLAST		; vim: a count over one on the last line does
  1E2C'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1E2D'   DA 1E42'              	JC	YNC_RF
  1E30'                         YNC_M:
  1E30'   E5                    	PUSH	H
  1E31'   CD 093D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1E34'   E1                    	POP	H
  1E35'   CD 1E4A'              	CALL	YNLINE		; BC = the span, measured where it stands
  1E38'   D8                    	RC			; not measurable here: let the pager answer it
  1E39'   60                    	MOV	H,B
  1E3A'   69                    	MOV	L,C
  1E3B'   CD 1DF1'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1E3E'   D8                    	RC			; no: the delete-and-put-back path
  1E3F'   C3 1E09'              	JMP	YNGO
  1E42'                         YNC_RF:
  1E42'   CD 0786'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1E45'   CD 0A06'              	CALL	GLSTAL		;   register alone, and that is the command
  1E48'   B7                    	ORA	A		; NC: done
  1E49'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1E4A'                         YNLINE:
  1E4A'   22 2FB9'              	SHLD	YNCNT		; the lines it still wants
  1E4D'   2A 0000*              	LHLD	GAPEND
  1E50'                         YNL_LP:
  1E50'   EB                    	XCHG			; DE = the scan
  1E51'   2A 0000*              	LHLD	TXTEND
  1E54'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1E57'   EB                    	XCHG			; HL = the scan
  1E58'   D2 1E78'              	JNC	YNL_EN		; the resident text ran out
  1E5B'   7E                    	MOV	A,M
  1E5C'   23                    	INX	H
  1E5D'   FE 0A                 	CPI	LF
  1E5F'   C2 1E50'              	JNZ	YNL_LP
  1E62'   E5                    	PUSH	H
  1E63'   2A 2FB9'              	LHLD	YNCNT
  1E66'   2B                    	DCX	H
  1E67'   22 2FB9'              	SHLD	YNCNT
  1E6A'   7C                    	MOV	A,H
  1E6B'   B5                    	ORA	L
  1E6C'   E1                    	POP	H
  1E6D'   C2 1E50'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1E70'   EB                    	XCHG			; DE = past the last of them
  1E71'   2A 0000*              	LHLD	GAPEND
  1E74'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1E75'   C3 1E86'              	JMP	YNL_BC
  1E78'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1E78'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1E7B'   C2 1E8D'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1E7E'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1E81'   EB                    	XCHG			;   count clamps to it as vim's does
  1E82'   2A 0000*              	LHLD	GAPEND
  1E85'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1E86'                         YNL_BC:
  1E86'   CD 0000*              	CALL	SUBHD		; HL = the span
  1E89'   44                    	MOV	B,H
  1E8A'   4D                    	MOV	C,L
  1E8B'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1E8C'   C9                    	RET
  1E8D'                         YNL_NO:
  1E8D'   37                    	STC
  1E8E'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E8F'                         YNSPAN:
  1E8F'   CD 184F'              	CALL	OPSPNL		; HL = the span's length
  1E92'   44                    	MOV	B,H
  1E93'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1E94'   CD 1DF1'              	CALL	YNROOM
  1E97'   D8                    	RC			; no room: the delete-and-put-back path
  1E98'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1E99'   2A 2F4F'              	LHLD	OPLO
  1E9C'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1E9F'   C1                    	POP	B
  1EA0'   C3 1E09'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1EA3'                         VC_P:
  1EA3'   CD 1C58'              	CALL	QEMPTY
  1EA6'   CA 1F79'              	JZ	VP_BEL
  1EA9'   CD 0786'              	CALL	GETCNT
  1EAC'   22 2F86'              	SHLD	PCNT
  1EAF'   CD 0000*              	CALL	CUROFF
  1EB2'   CD 070F'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1EB5'   C3 1ECA'              	JMP	VP_GO
  1EB8'                         VCB_P:
  1EB8'   CD 1C58'              	CALL	QEMPTY
  1EBB'   CA 1F79'              	JZ	VP_BEL
  1EBE'   CD 0786'              	CALL	GETCNT
  1EC1'   22 2F86'              	SHLD	PCNT
  1EC4'   CD 0000*              	CALL	CUROFF
  1EC7'   CD 0678'              	CALL	BOL
  1ECA'                         VP_GO:
  1ECA'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1ECD'   CD 0000*              	CALL	CUROFF
  1ED0'   EB                    	XCHG
  1ED1'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1ED4'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1ED7'   DA 1EEC'              	JC	VP_IN
  1EDA'   EB                    	XCHG			; HL = the put point = LOGLEN
  1EDB'   7C                    	MOV	A,H
  1EDC'   B5                    	ORA	L
  1EDD'   CA 1EE9'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1EE0'   2B                    	DCX	H
  1EE1'   CD 0000*              	CALL	CHARAT
  1EE4'   FE 0A                 	CPI	LF
  1EE6'   CA 1EEC'              	JZ	VP_IN
  1EE9'                         VP_BRK:
  1EE9'   CD 1A55'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1EEC'                         VP_IN:
  1EEC'   21 2F88'              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1EEF'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1EF2'   CD 13CD'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1EF5'   2A 0000*              	LHLD	QBEG
  1EF8'   EB                    	XCHG
  1EF9'   2A 0000*              	LHLD	QEND
  1EFC'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1EFF'   EB                    	XCHG
  1F00'   22 2F8B'              	SHLD	PLFS
  1F03'   2A 2F86'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1F06'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1F07'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1F08'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1F0A'   C2 1F0E'              	JNZ	VP_PZ
  1F0D'   7D                    	MOV	A,L
  1F0E'                         VP_PZ:
  1F0E'   32 2F8D'              	STA	PCPY
  1F11'                         VP_LP:
  1F11'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1F14'   2A 0000*              	LHLD	LNDLT
  1F17'   EB                    	XCHG
  1F18'   2A 2F8B'              	LHLD	PLFS
  1F1B'   19                    	DAD	D
  1F1C'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1F1F'   2A 2F86'              	LHLD	PCNT
  1F22'   2B                    	DCX	H
  1F23'   22 2F86'              	SHLD	PCNT
  1F26'   7C                    	MOV	A,H
  1F27'   B5                    	ORA	L
  1F28'   C2 1F11'              	JNZ	VP_LP
  1F2B'   CD 0174'              	CALL	MARKMOD
  1F2E'   21 2F88'              	LXI	H,PPFP
  1F31'   CD 03DC'              	CALL	MKLOAD
  1F34'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1F37'   D2 1F6A'              	JNC	VP_PGD
  1F3A'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1F3D'   CD 0A06'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1F40'   3A 2F8D'              	LDA	PCPY
  1F43'   B7                    	ORA	A
  1F44'   CA 0954'              	JZ	FNBLNK
  1F47'   2A 2F8B'              	LHLD	PLFS
  1F4A'   7C                    	MOV	A,H
  1F4B'   B7                    	ORA	A
  1F4C'   C2 0954'              	JNZ	FNBLNK
  1F4F'   3A 2F8D'              	LDA	PCPY
  1F52'   CD 107F'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1F55'   7C                    	MOV	A,H
  1F56'   B7                    	ORA	A
  1F57'   C2 0954'              	JNZ	FNBLNK
  1F5A'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F5B'   B7                    	ORA	A
  1F5C'   CA 0954'              	JZ	FNBLNK
  1F5F'   F5                    	PUSH	PSW
  1F60'   CD 0883'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1F63'   F1                    	POP	PSW
  1F64'   32 2F08'              	STA	ILN		; ... which the lines put now replace
  1F67'   C3 0954'              	JMP	FNBLNK
  1F6A'                         VP_PGD:				; the put paged its first line out: page back
  1F6A'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1F6D'   CD 0000*              	CALL	GOTO
  1F70'   CD 0A06'              	CALL	GLSTAL
  1F73'   CD 13E5'              	CALL	GPLACE
  1F76'   C3 0898'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1F79'                         VP_BEL:
  1F79'   CD 0786'              	CALL	GETCNT		; the count is spent either way
  1F7C'   0E 07                 	MVI	C,BEL
  1F7E'   CD 0000*              	CALL	BCONOU
  1F81'   C3 085B'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1F84'                         VIREP:
  1F84'   79                    	MOV	A,C
  1F85'   FE 1B                 	CPI	ESC
  1F87'   CA 20DA'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1F8A'   FE 0D                 	CPI	CR
  1F8C'   CA 1FFF'              	JZ	VP_CR
  1F8F'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1F91'   CA 1FFF'              	JZ	VP_CR
  1F94'   FE 08                 	CPI	BS
  1F96'   CA 200B'              	JZ	VP_BS
  1F99'   FE 7F                 	CPI	DEL
  1F9B'   CA 200B'              	JZ	VP_BS
  1F9E'   32 2F5E'              	STA	VRCH		; the calls below do not preserve C
  1FA1'   CD 0861'              	CALL	SETLIN		; this row changed
  1FA4'   CD 0174'              	CALL	MARKMOD
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FA7'   CD 1A48'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1FAA'   CA 1FEA'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1FAD'   CD 076D'              	CALL	CURCHR
  1FB0'   06 01                 	MVI	B,1
  1FB2'   CD 0867'              	CALL	SETCEL
  1FB5'   3A 2F5E'              	LDA	VRCH
  1FB8'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1FBB'   2A 2F5F'              	LHLD	RPDEL
  1FBE'   7C                    	MOV	A,H
  1FBF'   B5                    	ORA	L
  1FC0'   CA 1FD6'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1FC3'   2A 0000*              	LHLD	GAPEND
  1FC6'   EB                    	XCHG
  1FC7'   2A 2F63'              	LHLD	RPGE
  1FCA'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1FCD'   CA 1FD6'              	JZ	VP_OVW
  1FD0'   21 0000               	LXI	H,0
  1FD3'   22 2F5F'              	SHLD	RPDEL		; the text moved: those originals are gone
  1FD6'                         VP_OVW:
  1FD6'   21 0001               	LXI	H,1
  1FD9'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1FDC'   2A 0000*              	LHLD	GAPEND
  1FDF'   22 2F63'              	SHLD	RPGE
  1FE2'   2A 2F5F'              	LHLD	RPDEL
  1FE5'   23                    	INX	H
  1FE6'   22 2F5F'              	SHLD	RPDEL
  1FE9'   C9                    	RET
  1FEA'                         VP_APP:
  1FEA'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1FEC'   06 01                 	MVI	B,1
  1FEE'   CD 0867'              	CALL	SETCEL
  1FF1'   3A 2F5E'              	LDA	VRCH
  1FF4'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1FF7'   2A 2F61'              	LHLD	RPAPP
  1FFA'   23                    	INX	H
  1FFB'   22 2F61'              	SHLD	RPAPP
  1FFE'   C9                    	RET
  1FFF'                         VP_CR:
  1FFF'   21 0000               	LXI	H,0
  2002'   22 2F5F'              	SHLD	RPDEL		; a line break ends what BS can put back
  2005'   22 2F61'              	SHLD	RPAPP
  2008'   C3 2096'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  200B'                         VP_BS:
  200B'   2A 2F61'              	LHLD	RPAPP
  200E'   7C                    	MOV	A,H
  200F'   B5                    	ORA	L
  2010'   CA 201D'              	JZ	VP_BSD
  2013'   2B                    	DCX	H
  2014'   22 2F61'              	SHLD	RPAPP		; an appended char: it just goes
  2017'   CD 0861'              	CALL	SETLIN
  201A'   C3 0000*              	JMP	DELPRV
  201D'                         VP_BSD:
  201D'   2A 2F5F'              	LHLD	RPDEL
  2020'   7C                    	MOV	A,H
  2021'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2022'   CA 2049'              	JZ	VP_BSM		; nothing of ours left
  2025'   2A 0000*              	LHLD	GAPEND
  2028'   EB                    	XCHG
  2029'   2A 2F63'              	LHLD	RPGE
  202C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  202F'   C2 2049'              	JNZ	VP_BSM
  2032'   2A 2F5F'              	LHLD	RPDEL
  2035'   2B                    	DCX	H
  2036'   22 2F5F'              	SHLD	RPDEL
  2039'   CD 0861'              	CALL	SETLIN
  203C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  203F'   CD 0000*              	CALL	UNDELF		; the original comes back
  2042'   2A 0000*              	LHLD	GAPEND
  2045'   22 2F63'              	SHLD	RPGE
  2048'   C9                    	RET
  2049'                         VP_BSM:
  2049'   CD 085B'              	CALL	SETMOV		; nothing changed: back over the text as it is
  204C'   C3 08E9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  204F'                         VIINS:
  204F'   79                    	MOV	A,C
  2050'   FE 1B                 	CPI	ESC
  2052'   CA 20DA'              	JZ	VI_ESC
  2055'   FE 0D                 	CPI	CR
  2057'   CA 2096'              	JZ	VI_CR
  205A'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  205C'   CA 2096'              	JZ	VI_CR
  205F'   FE 08                 	CPI	BS
  2061'   CA 20AE'              	JZ	VI_BS
  2064'   FE 7F                 	CPI	DEL
  2066'   CA 20AE'              	JZ	VI_BS
  2069'   79                    	MOV	A,C
  206A'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  206D'   CD 0174'              	CALL	MARKMOD
  2070'   CD 0861'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  2073'   79                    	MOV	A,C
  2074'   FE 20                 	CPI	' '
  2076'   D8                    	RC			; control char -> keep R_LINE
  2077'   FE 7F                 	CPI	DEL
  2079'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  207A'   CD 089E'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  207D'   47                    	MOV	B,A
  207E'   3E 04                 	MVI	A,R_ICH
  2080'   32 2F07'              	STA	RINTENT
  2083'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  2085'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  2086'   CA 2092'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  2089'   CD 1A48'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  208C'   3E 00                 	MVI	A,0
  208E'   C2 2092'              	JNZ	VI_ICH
  2091'   3C                    	INR	A
  2092'                         VI_ICH:
  2092'   32 2F09'              	STA	ICHAPP
  2095'   C9                    	RET
  2096'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  2096'   CD 1A48'              	CALL	ATCEND
  2099'   3E 00                 	MVI	A,0
  209B'   CA 209F'              	JZ	VI_CRS
  209E'   3C                    	INR	A
  209F'                         VI_CRS:
  209F'   F5                    	PUSH	PSW
  20A0'   CD 1A55'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  20A3'   CD 1A62'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  20A6'   CD 0883'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  20A9'   F1                    	POP	PSW
  20AA'   32 2F0D'              	STA	ILABOV
  20AD'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  20AE'                         VI_BS:
  20AE'   CD 0000*              	CALL	PEEKL
  20B1'   D8                    	RC			; start of the file: nothing to delete
  20B2'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  20B4'   CA 20D4'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  20B7'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  20B8'   CD 0861'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  20BB'   78                    	MOV	A,B
  20BC'   CD 087C'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  20BF'   D2 20D4'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  20C2'   CD 089E'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  20C5'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  20C6'   3C                    	INR	A
  20C7'   32 2F0B'              	STA	DCHBS		; 1, and 2 with it for the TAB
  20CA'   3E 01                 	MVI	A,1
  20CC'   32 2F0A'              	STA	DCHN
  20CF'   3E 07                 	MVI	A,R_DCH
  20D1'   32 2F07'              	STA	RINTENT
  20D4'                         VI_BSJ:
  20D4'   CD 0174'              	CALL	MARKMOD
  20D7'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  20DA'                         VI_ESC:
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20DA'   3E 00                 	MVI	A,EM_CMD
  20DC'   32 2F02'              	STA	EDMODE
  20DF'   CD 085B'              	CALL	SETMOV
  20E2'   CD 08E9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  20E5'   C3 0A06'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  20E8'                         RDLINE:
  20E8'   EB                    	XCHG			; HL = buffer
  20E9'   22 2F65'              	SHLD	RLPTR
  20EC'   3E 00                 	MVI	A,0
  20EE'   32 2F67'              	STA	RLLEN
  20F1'   78                    	MOV	A,B
  20F2'   32 2F68'              	STA	RLMAX
  20F5'   79                    	MOV	A,C
  20F6'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  20F9'                         RL_LP:
  20F9'   CD 0000*              	CALL	GETKEY
  20FC'   FE 1B                 	CPI	ESC
  20FE'   CA 214E'              	JZ	RL_CAN
  2101'   FE 0D                 	CPI	CR
  2103'   CA 2159'              	JZ	RL_DONE
  2106'   FE 08                 	CPI	BS
  2108'   CA 2136'              	JZ	RL_BS
  210B'   FE 7F                 	CPI	DEL
  210D'   CA 2136'              	JZ	RL_BS
  2110'   FE 20                 	CPI	' '
  2112'   DA 20F9'              	JC	RL_LP		; control char -> ignore
  2115'   3A 2F67'              	LDA	RLLEN
  2118'   47                    	MOV	B,A
  2119'   3A 2F68'              	LDA	RLMAX
  211C'   B8                    	CMP	B
  211D'   CA 20F9'              	JZ	RL_LP		; full -> ignore
  2120'   2A 2F65'              	LHLD	RLPTR
  2123'   71                    	MOV	M,C
  2124'   23                    	INX	H
  2125'   22 2F65'              	SHLD	RLPTR
  2128'   3A 2F67'              	LDA	RLLEN
  212B'   3C                    	INR	A
  212C'   32 2F67'              	STA	RLLEN
  212F'   79                    	MOV	A,C
  2130'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2133'   C3 20F9'              	JMP	RL_LP
  2136'                         RL_BS:				; WM LINEPOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2136'   3A 2F67'              	LDA	RLLEN
  2139'   B7                    	ORA	A
  213A'   CA 214E'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  213D'   3D                    	DCR	A
  213E'   32 2F67'              	STA	RLLEN
  2141'   2A 2F65'              	LHLD	RLPTR
  2144'   2B                    	DCX	H
  2145'   22 2F65'              	SHLD	RLPTR
  2148'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  214B'   C3 20F9'              	JMP	RL_LP
  214E'                         RL_CAN:
  214E'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2150'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  2153'   CD 0861'              	CALL	SETLIN		; redraw one row
  2156'   3E FF                 	MVI	A,0FFH		; cancelled
  2158'   C9                    	RET
  2159'                         RL_DONE:
  2159'   AF                    	XRA	A
  215A'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  215B'                         VC_BZ:
  215B'   CD 085B'              	CALL	SETMOV
  215E'   3A 2F39'              	LDA	GSAVE
  2161'   FE 02                 	CPI	PZ
  2163'   CA 216E'              	JZ	VZ_ZZ
  2166'   B7                    	ORA	A
  2167'   C0                    	RNZ			; 'g' was pending: vim drops both
  2168'   3E 02                 	MVI	A,PZ
  216A'   32 2F38'              	STA	GPEND
  216D'   C9                    	RET
  216E'                         VZ_ZZ:
  216E'   3E 04                 	MVI	A,EO_X
  2170'   32 2F69'              	STA	EXOP
  2173'   3E 01                 	MVI	A,1
  2175'   32 2F7C'              	STA	EXBANG		; no '!'
  2178'   AF                    	XRA	A
  2179'   32 2F6A'              	STA	EXARG		; no file name
  217C'   3A 2F06'              	LDA	MODF		; as ':x': a changed text is written first
  217F'   B7                    	ORA	A
  2180'   CA 22C1'              	JZ	EX_Q
  2183'   C3 225B'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  2186'                         VC_EX:
  2186'   CD 0786'              	CALL	GETCNT
  2189'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  218C'   11 0000*              	LXI	D,EXBUF
  218F'   06 28                 	MVI	B,EXMAX
  2191'   0E 3A                 	MVI	C,':'
  2193'   CD 20E8'              	CALL	RDLINE
  2196'   B7                    	ORA	A
  2197'   C0                    	RNZ			; cancelled
  2198'   3A 2F67'              	LDA	RLLEN
  219B'   5F                    	MOV	E,A
  219C'   16 00                 	MVI	D,0
  219E'   21 0000*              	LXI	H,EXBUF
  21A1'   19                    	DAD	D
  21A2'   36 00                 	MVI	M,0		; the line ends with a 0
  21A4'   21 0000*              	LXI	H,EXBUF
  21A7'   CD 2773'              	CALL	SKIPB
  21AA'   C8                    	RZ			; nothing on it
  21AB'   22 2F6C'              	SHLD	EXCMD
  21AE'   CD 2977'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  21B1'   CD 2773'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  21B4'   56                    	MOV	D,M
  21B5'   23                    	INX	H
  21B6'   1E 00                 	MVI	E,0
  21B8'   CD 277F'              	CALL	ISLOW
  21BB'   DA 21C6'              	JC	EX_LK
  21BE'   5F                    	MOV	E,A
  21BF'   23                    	INX	H
  21C0'   CD 277F'              	CALL	ISLOW
  21C3'   D2 21DF'              	JNC	EX_NOT		; a third letter: none of ours
  21C6'                         EX_LK:
  21C6'   E5                    	PUSH	H
  21C7'   21 295E'              	LXI	H,EXTAB
  21CA'                         EX_TL:
  21CA'   7E                    	MOV	A,M
  21CB'   B7                    	ORA	A
  21CC'   CA 21DE'              	JZ	EX_NTP		; not in the table
  21CF'   23                    	INX	H
  21D0'   BA                    	CMP	D
  21D1'   7E                    	MOV	A,M
  21D2'   23                    	INX	H
  21D3'   C2 21DA'              	JNZ	EX_TN
  21D6'   BB                    	CMP	E
  21D7'   CA 21E5'              	JZ	EX_TF
  21DA'                         EX_TN:
  21DA'   23                    	INX	H
  21DB'   C3 21CA'              	JMP	EX_TL
  21DE'                         EX_NTP:
  21DE'   E1                    	POP	H
  21DF'                         EX_NOT:
  21DF'   21 2837'              	LXI	H,SNOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21E2'   C3 27B4'              	JMP	EXERT
  21E5'                         EX_TF:
  21E5'   7E                    	MOV	A,M
  21E6'   32 2F69'              	STA	EXOP
  21E9'   E1                    	POP	H
  21EA'   FE 06                 	CPI	EO_S
  21EC'   CA 29E6'              	JZ	EX_S		; ':s' reads the rest of the line itself
  21EF'   FE 01                 	CPI	EO_W
  21F1'   CA 2200'              	JZ	EX_RG		; ':N,Mw name' takes a range
  21F4'   FE 08                 	CPI	EO_R
  21F6'   CA 2200'              	JZ	EX_RG		; ... and ':Nr name' a line
  21F9'   3A 2FC5'              	LDA	SRNGF
  21FC'   B7                    	ORA	A
  21FD'   C2 21DF'              	JNZ	EX_NOT		; a range on a command that does not take one
  2200'                         EX_RG:
                                	;--- '!', then the file name ---
  2200'   7E                    	MOV	A,M
  2201'   D6 21                 	SUI	'!'
  2203'   32 2F7C'              	STA	EXBANG		; 0 = '!'
  2206'   C2 220A'              	JNZ	EX_NB
  2209'   23                    	INX	H
  220A'                         EX_NB:
  220A'   CD 2773'              	CALL	SKIPB
  220D'   32 2F6A'              	STA	EXARG		; 0 = no file name
  2210'   CA 2229'              	JZ	EX_RUN
  2213'   22 2F6C'              	SHLD	EXCMD
  2216'   3A 2F69'              	LDA	EXOP
  2219'   FE 02                 	CPI	EO_Q
  221B'   CA 27B1'              	JZ	EX_TRL		; :q takes none
  221E'   FE 07                 	CPI	EO_V
  2220'   CA 27B1'              	JZ	EX_TRL		; nor :ve
  2223'   CD 26DD'              	CALL	PARSFN
  2226'   C2 27A5'              	JNZ	EX_INV
  2229'                         EX_RUN:
  2229'   3A 2F69'              	LDA	EXOP
  222C'   FE 05                 	CPI	EO_E
  222E'   CA 22D8'              	JZ	EX_E
  2231'   FE 02                 	CPI	EO_Q
  2233'   CA 22C1'              	JZ	EX_Q
  2236'   FE 07                 	CPI	EO_V
  2238'   CA 27AB'              	JZ	EX_V
  223B'   FE 08                 	CPI	EO_R
  223D'   CA 2469'              	JZ	EX_R
  2240'   FE 04                 	CPI	EO_X
  2242'   CA 2254'              	JZ	EX_XM
  2245'   FE 01                 	CPI	EO_W
  2247'   C2 225B'              	JNZ	EX_W		; :wq
  224A'   3A 2FC5'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  224D'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  224E'   C2 2389'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2251'   C3 225B'              	JMP	EX_W
  2254'                         EX_XM:
  2254'   3A 2F06'              	LDA	MODF		; :x writes only a changed text
  2257'   B7                    	ORA	A
  2258'   CA 22C1'              	JZ	EX_Q
  225B'                         EX_W:
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  225B'   CD 2549'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  225E'   D8                    	RC			; refused (message shown)
  225F'   32 2F6B'              	STA	EXBAK
  2262'   3A 2F69'              	LDA	EXOP
  2265'   FE 01                 	CPI	EO_W
  2267'   CA 227E'              	JZ	EX_WK
  226A'   3A 2F6B'              	LDA	EXBAK
  226D'   B7                    	ORA	A
  226E'   C2 22BE'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2271'   3A 2F7C'              	LDA	EXBANG
  2274'   B7                    	ORA	A
  2275'   CA 22BE'              	JZ	EX_WQ		; so it does with '!'
  2278'   CD 227E'              	CALL	EX_WK		; else it may not: keep the text
  227B'   C3 22C1'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  227E'                         EX_WK:
  227E'   CD 0EBB'              	CALL	CURRW		; the cursor's row and file position
  2281'   32 2F6E'              	STA	WPROW
  2284'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  2287'   7D                    	MOV	A,L
  2288'   E6 7F                 	ANI	7FH
  228A'   32 2F6F'              	STA	WPBYT
  228D'   7D                    	MOV	A,L
  228E'   17                    	RAL
  228F'   7C                    	MOV	A,H
  2290'   17                    	RAL
  2291'   5F                    	MOV	E,A
  2292'   3E 00                 	MVI	A,0
  2294'   17                    	RAL
  2295'   57                    	MOV	D,A		; DE = HL / 128
  2296'   2A 0000*              	LHLD	OUTPOS
  2299'   19                    	DAD	D
  229A'   22 2F70'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  229D'   CD 257E'              	CALL	WRITE
  22A0'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  22A3'   2A 2F70'              	LHLD	WPREC
  22A6'   EB                    	XCHG
  22A7'   3A 2F6F'              	LDA	WPBYT
  22AA'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  22AD'   CD 0000*              	CALL	GOTO
  22B0'                         EX_WRW:
  22B0'   21 0000               	LXI	H,0
  22B3'   22 0000*              	SHLD	LNDLT
  22B6'   3A 2F6E'              	LDA	WPROW
  22B9'   6F                    	MOV	L,A
  22BA'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  22BD'   C9                    	RET
  22BE'                         EX_WQ:
  22BE'   CD 257E'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  22C1'                         EX_Q:
  22C1'   3A 2F7C'              	LDA	EXBANG
  22C4'   B7                    	ORA	A
  22C5'   CA 22CF'              	JZ	EX_QT
  22C8'   3A 2F06'              	LDA	MODF
  22CB'   B7                    	ORA	A
  22CC'   C2 2799'              	JNZ	MSGNWR		; changed, no '!': stay
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22CF'                         EX_QT:
  22CF'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  22D2'   3E 01                 	MVI	A,1
  22D4'   32 2F05'              	STA	QUITF
  22D7'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  22D8'                         EX_E:
  22D8'   3A 2F7C'              	LDA	EXBANG
  22DB'   B7                    	ORA	A
  22DC'   CA 22E6'              	JZ	EE_GO
  22DF'   3A 2F06'              	LDA	MODF
  22E2'   B7                    	ORA	A
  22E3'   C2 2799'              	JNZ	MSGNWR
  22E6'                         EE_GO:
  22E6'   3A 2F6A'              	LDA	EXARG
  22E9'   B7                    	ORA	A
  22EA'   C2 22F1'              	JNZ	EE_ARG
  22ED'   CD 25BA'              	CALL	OWNTF		; no name: the buffer's own
  22F0'   D8                    	RC
  22F1'                         EE_ARG:
  22F1'   CD 25D0'              	CALL	ISOWN
  22F4'   21 0001               	LXI	H,1
  22F7'   C2 22FE'              	JNZ	EE_LD		; another file: its first line
  22FA'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  22FD'   23                    	INX	H		; HL = the cursor's line
  22FE'                         EE_LD:
  22FE'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2300'   32 2F7A'              	STA	MSGWHT
  2303'   E5                    	PUSH	H
  2304'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  2307'   21 0000*              	LXI	H,TFCB
  230A'   11 0000*              	LXI	D,FNAME
  230D'   CD 25E2'              	CALL	COPY12		; the buffer's name
  2310'   CD 25A7'              	CALL	SRCTF
  2313'   CD 0000*              	CALL	REOPEN
  2316'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2319'   AF                    	XRA	A
  231A'   32 2F06'              	STA	MODF
  231D'   E1                    	POP	H
  231E'   2B                    	DCX	H
  231F'   AF                    	XRA	A
  2320'   CD 0000*              	CALL	MVLIND		; down to the line
  2323'   CD 0BD7'              	CALL	ATEOF
  2326'   DC 0BDD'              	CC	LASTLN		; past the last line: onto it
  2329'   CD 13A7'              	CALL	ZSAVE
  232C'   C3 147C'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  232F'                         TFDOS:
  232F'   C5                    	PUSH	B
  2330'   11 0080               	LXI	D,CMDTAIL
  2333'   0E 1A                 	MVI	C,1AH		; set the DMA
  2335'   CD 0005               	CALL	BDOS
  2338'   C1                    	POP	B
  2339'   11 0000*              	LXI	D,TFCB
  233C'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  233F'                         EXRNG:
  233F'   2A 2FC6'              	LHLD	SRNG1
  2342'   7C                    	MOV	A,H
  2343'   B5                    	ORA	L
  2344'   37                    	STC
  2345'   C8                    	RZ
  2346'   2A 2FC8'              	LHLD	SRNG2
  2349'   EB                    	XCHG
  234A'   2A 2FC6'              	LHLD	SRNG1
  234D'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2350'   D8                    	RC
  2351'   EB                    	XCHG			; HL = the last line, DE = the first
  2352'   CD 0000*              	CALL	SUBHD
  2355'   23                    	INX	H
  2356'   22 2FD0'              	SHLD	SLINES
  2359'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  235A'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  235B'                         GOLNX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  235B'   E5                    	PUSH	H
  235C'   CD 133B'              	CALL	GOLN
  235F'   CD 0000*              	CALL	CNTLF
  2362'   23                    	INX	H		; the line the cursor came to rest on
  2363'   D1                    	POP	D
  2364'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  2367'                         EXSAVP:
  2367'   CD 0EBB'              	CALL	CURRW
  236A'   32 2F6E'              	STA	WPROW
  236D'   21 2FA7'              	LXI	H,MKPOS
  2370'   C3 0429'              	JMP	FPSTO
  2373'                         EXRSTP:
  2373'   CD 0000*              	CALL	CLRCNT
  2376'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2379'   CD 0000*              	CALL	GOTO
  237C'   C3 22B0'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  237F'                         PUTBRK:
  237F'   3E 0D                 	MVI	A,CR
  2381'   CD 0000*              	CALL	PUTGAP
  2384'   3E 0A                 	MVI	A,LF
  2386'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2389'                         EX_WR:
  2389'   3A 2F6A'              	LDA	EXARG
  238C'   B7                    	ORA	A
  238D'   CA 2787'              	JZ	MSGNFN		; No file name
  2390'   CD 25D0'              	CALL	ISOWN
  2393'   CA 2433'              	JZ	EXW_OW
  2396'   CD 0000*              	CALL	TEXIST
  2399'   32 2FD3'              	STA	RWERR		; nonzero: a file of that name is there
  239C'   CA 23A6'              	JZ	EXW_GO
  239F'   3A 2F7C'              	LDA	EXBANG
  23A2'   B7                    	ORA	A
  23A3'   C2 278D'              	JNZ	MSGEXI		; File exists (! to force)
  23A6'                         EXW_GO:
  23A6'   CD 233F'              	CALL	EXRNG
  23A9'   DA 242D'              	JC	EXW_BD
  23AC'   CD 2367'              	CALL	EXSAVP
  23AF'   2A 2FC6'              	LHLD	SRNG1
  23B2'   CD 235B'              	CALL	GOLNX
  23B5'   C2 242A'              	JNZ	EXW_NL		; the text has no line N
  23B8'   3A 2FD3'              	LDA	RWERR		; a delete scans the whole directory, there or
  23BB'   B7                    	ORA	A		;   not: only when TEXIST found one
  23BC'   0E 13                 	MVI	C,13H
  23BE'   C4 232F'              	CNZ	TFDOS		; delete what is there
  23C1'   0E 16                 	MVI	C,16H
  23C3'   CD 232F'              	CALL	TFDOS		; ... and make it
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23C6'   3C                    	INR	A
  23C7'   CA 241C'              	JZ	EXW_FL		; no directory entry left
  23CA'   3E 80                 	MVI	A,80H
  23CC'   32 2FD2'              	STA	RWPTR
  23CF'   AF                    	XRA	A
  23D0'   32 2FD3'              	STA	RWERR
  23D3'   2A 2FD0'              	LHLD	SLINES
  23D6'   CD 0000*              	CALL	SETC0		; that many lines, forward
  23D9'                         EXW_LP:
  23D9'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  23DC'   E5                    	PUSH	H
  23DD'   EB                    	XCHG
  23DE'   2A 0000*              	LHLD	GAPEND
  23E1'   CD 2439'              	CALL	RWOUT		; the text from the cursor to there
  23E4'   E1                    	POP	H
  23E5'   3A 2FD3'              	LDA	RWERR
  23E8'   B7                    	ORA	A
  23E9'   C2 2405'              	JNZ	EXW_EN
  23EC'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  23EF'   CD 079B'              	CALL	CNTTST
  23F2'   C2 23D9'              	JNZ	EXW_LP
  23F5'                         EXW_PD:				; the last record is padded out with ^Z
  23F5'   3A 2FD2'              	LDA	RWPTR
  23F8'   FE 80                 	CPI	80H
  23FA'   CA 2405'              	JZ	EXW_EN
  23FD'   3E 1A                 	MVI	A,CPMEOF
  23FF'   CD 2445'              	CALL	RWPUT
  2402'   C3 23F5'              	JMP	EXW_PD
  2405'                         EXW_EN:
  2405'   0E 10                 	MVI	C,10H
  2407'   CD 232F'              	CALL	TFDOS		; close
  240A'   3A 2FD3'              	LDA	RWERR
  240D'   B7                    	ORA	A
  240E'   C2 241C'              	JNZ	EXW_FL
  2411'   CD 2373'              	CALL	EXRSTP
  2414'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  2416'   32 2F7A'              	STA	MSGWHT
  2419'   C3 085B'              	JMP	SETMOV		; nothing on the screen has changed
  241C'                         EXW_FL:				; no room: the part written is not left behind
  241C'   0E 13                 	MVI	C,13H
  241E'   CD 232F'              	CALL	TFDOS
  2421'   CD 2373'              	CALL	EXRSTP
  2424'   21 2954'              	LXI	H,SDFUL
  2427'   C3 27BF'              	JMP	EXERR
  242A'                         EXW_NL:
  242A'   CD 2373'              	CALL	EXRSTP
  242D'                         EXW_BD:
  242D'   21 2946'              	LXI	H,SRNGE
  2430'   C3 27BF'              	JMP	EXERR
  2433'                         EXW_OW:
  2433'   21 27EE'              	LXI	H,SEXI
  2436'   C3 27BF'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2439'                         RWOUT:
  2439'   CD 0000*              	CALL	CMP16
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  243C'   C8                    	RZ
  243D'   7E                    	MOV	A,M
  243E'   23                    	INX	H
  243F'   CD 2445'              	CALL	RWPUT
  2442'   C3 2439'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  2445'                         RWPUT:
  2445'   E5                    	PUSH	H
  2446'   F5                    	PUSH	PSW
  2447'   3A 2FD2'              	LDA	RWPTR
  244A'   6F                    	MOV	L,A
  244B'   26 00                 	MVI	H,0
  244D'   F1                    	POP	PSW
  244E'   77                    	MOV	M,A
  244F'   2C                    	INR	L		; Z: that was the record's last byte
  2450'   7D                    	MOV	A,L
  2451'   C2 2464'              	JNZ	RWP_ST
  2454'   D5                    	PUSH	D
  2455'   0E 15                 	MVI	C,15H
  2457'   CD 232F'              	CALL	TFDOS		; write it
  245A'   D1                    	POP	D
  245B'   B7                    	ORA	A
  245C'   CA 2462'              	JZ	RWP_OK
  245F'   32 2FD3'              	STA	RWERR
  2462'                         RWP_OK:
  2462'   3E 80                 	MVI	A,80H
  2464'                         RWP_ST:
  2464'   32 2FD2'              	STA	RWPTR
  2467'   E1                    	POP	H
  2468'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2469'                         EX_R:
  2469'   3A 2F6A'              	LDA	EXARG
  246C'   B7                    	ORA	A
  246D'   CA 2787'              	JZ	MSGNFN		; No file name
  2470'   0E 0F                 	MVI	C,0FH
  2472'   CD 232F'              	CALL	TFDOS		; open
  2475'   3C                    	INR	A
  2476'   CA 2543'              	JZ	ER_NOF
  2479'   CD 13CD'              	CALL	GZONE		; the screen's top line, before anything moves
  247C'   CD 2367'              	CALL	EXSAVP
  247F'   3A 2FC5'              	LDA	SRNGF
  2482'   B7                    	ORA	A
  2483'   CA 249C'              	JZ	ER_NXT		; no line given: below the cursor's
  2486'   2A 2FC8'              	LHLD	SRNG2
  2489'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  248A'   B5                    	ORA	L
  248B'   C2 2496'              	JNZ	ER_LN
  248E'   23                    	INX	H
  248F'   CD 133B'              	CALL	GOLN		; ':0r': above line 1 ...
  2492'   AF                    	XRA	A		;   which never wants a line end put in first
  2493'   C3 24BE'              	JMP	ER_BRK
  2496'                         ER_LN:
  2496'   CD 235B'              	CALL	GOLNX
  2499'   C2 242A'              	JNZ	EXW_NL		; the text has no line N
  249C'                         ER_NXT:
  249C'   21 0001               	LXI	H,1
  249F'   AF                    	XRA	A
  24A0'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  24A3'   CD 0BD7'              	CALL	ATEOF
  24A6'   3E 00                 	MVI	A,0
  24A8'   D2 24BE'              	JNC	ER_BRK		; text follows
  24AB'   2A 0000*              	LHLD	GAPBEG
  24AE'   EB                    	XCHG
  24AF'   2A 0000*              	LHLD	TXTBEG
  24B2'   CD 0000*              	CALL	CMP16
  24B5'   3E 01                 	MVI	A,1
  24B7'   CA 24BE'              	JZ	ER_BRK		; nothing before the cursor either
  24BA'   1B                    	DCX	D
  24BB'   1A                    	LDAX	D
  24BC'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  24BE'                         ER_BRK:
  24BE'   32 2FD5'              	STA	RDBRK
  24C1'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  24C4'   AF                    	XRA	A
  24C5'   32 2FD4'              	STA	RDANY
  24C8'                         ER_LP:
  24C8'   0E 14                 	MVI	C,14H
  24CA'   CD 232F'              	CALL	TFDOS		; the next record
  24CD'   B7                    	ORA	A
  24CE'   C2 2501'              	JNZ	ER_END
  24D1'   21 0080               	LXI	H,CMDTAIL
  24D4'   0E 00                 	MVI	C,0
  24D6'                         ER_SC:				; C = its bytes, up to a ^Z
  24D6'   7E                    	MOV	A,M
  24D7'   FE 1A                 	CPI	CPMEOF
  24D9'   CA 24E1'              	JZ	ER_GOT
  24DC'   23                    	INX	H
  24DD'   0C                    	INR	C
  24DE'   F2 24D6'              	JP	ER_SC		; (minus: all 128)
  24E1'                         ER_GOT:
  24E1'   79                    	MOV	A,C
  24E2'   B7                    	ORA	A
  24E3'   CA 2501'              	JZ	ER_END
  24E6'   C5                    	PUSH	B
  24E7'   3A 2FD4'              	LDA	RDANY
  24EA'   B7                    	ORA	A
  24EB'   CC 2532'              	CZ	ER_1ST
  24EE'   C1                    	POP	B
  24EF'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24F1'   11 0080               	LXI	D,CMDTAIL
  24F4'   C5                    	PUSH	B
  24F5'   CD 0000*              	CALL	INSBLK
  24F8'   C1                    	POP	B
  24F9'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  24FC'   79                    	MOV	A,C
  24FD'   17                    	RAL
  24FE'   DA 24C8'              	JC	ER_LP		; a full record: there may be more
  2501'                         ER_END:
  2501'   3A 2FD4'              	LDA	RDANY
  2504'   B7                    	ORA	A
  2505'   CA 2523'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2508'   CD 0BD7'              	CALL	ATEOF
  250B'   DA 2518'              	JC	ER_MD		; the text now ends as the file read ends
  250E'   2A 0000*              	LHLD	GAPBEG
  2511'   2B                    	DCX	H
  2512'   7E                    	MOV	A,M
  2513'   FE 0A                 	CPI	LF
  2515'   C4 237F'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2518'                         ER_MD:
  2518'   3E 01                 	MVI	A,1
  251A'   32 2F06'              	STA	MODF
  251D'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2520'   CD 0000*              	CALL	GOTO
  2523'                         ER_PL:
  2523'   CD 0BD7'              	CALL	ATEOF
  2526'   DC 0BDD'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2529'   CD 0000*              	CALL	CLRCNT
  252C'   CD 13E5'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  252F'   C3 0898'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2532'                         ER_1ST:
  2532'   3C                    	INR	A
  2533'   32 2FD4'              	STA	RDANY
  2536'   3A 2FD5'              	LDA	RDBRK
  2539'   B7                    	ORA	A
  253A'   C4 237F'              	CNZ	PUTBRK
  253D'   21 2FA7'              	LXI	H,MKPOS
  2540'   C3 0429'              	JMP	FPSTO
  2543'                         ER_NOF:
  2543'   21 2935'              	LXI	H,SNOPN
  2546'   C3 27B4'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2549'                         WRCHK:
  2549'   3A 2F6A'              	LDA	EXARG
  254C'   B7                    	ORA	A
  254D'   C2 2557'              	JNZ	WC_ARG
  2550'   CD 25BA'              	CALL	OWNTF
  2553'   D8                    	RC
  2554'   C3 256C'              	JMP	WC_OWN
  2557'                         WC_ARG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2557'   CD 25D0'              	CALL	ISOWN
  255A'   CA 256C'              	JZ	WC_OWN
  255D'   3A 2F7C'              	LDA	EXBANG
  2560'   B7                    	ORA	A
  2561'   CA 256A'              	JZ	WC_OTH
  2564'   CD 0000*              	CALL	TEXIST
  2567'   C2 278D'              	JNZ	MSGEXI		; File exists (! to force)
  256A'                         WC_OTH:
  256A'   AF                    	XRA	A		; (NC)
  256B'   C9                    	RET
  256C'                         WC_OWN:
  256C'   3A 2F7D'              	LDA	ROFLAG		; '-R': this is the file it may not write
  256F'   B7                    	ORA	A
  2570'   CA 257A'              	JZ	WC_OK
  2573'   3A 2F7C'              	LDA	EXBANG
  2576'   B7                    	ORA	A
  2577'   C2 2793'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  257A'                         WC_OK:
  257A'   3E 01                 	MVI	A,1
  257C'   B7                    	ORA	A		; (NC)
  257D'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  257E'                         WRITE:
  257E'   3A 2F6B'              	LDA	EXBAK
  2581'   CD 0000*              	CALL	WRTO
  2584'   3A 0001*              	LDA	FNAME+1
  2587'   FE 20                 	CPI	' '
  2589'   C2 2595'              	JNZ	WR_HAS
  258C'   21 0000*              	LXI	H,TFCB
  258F'   11 0000*              	LXI	D,FNAME
  2592'   CD 25E2'              	CALL	COPY12
  2595'                         WR_HAS:
  2595'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2597'   32 2F7A'              	STA	MSGWHT
  259A'   CD 25D0'              	CALL	ISOWN
  259D'   C2 25A7'              	JNZ	SRCTF
  25A0'   AF                    	XRA	A
  25A1'   32 2F06'              	STA	MODF
  25A4'   32 2F7B'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  25A7'                         SRCTF:
  25A7'   21 0000*              	LXI	H,TFCB
  25AA'   11 005C               	LXI	D,DFTFCB
  25AD'   CD 25E2'              	CALL	COPY12
  25B0'   AF                    	XRA	A
  25B1'   06 04                 	MVI	B,4
  25B3'                         SRC_Z:
  25B3'   12                    	STAX	D		; extent, s1, s2, record count: 0
  25B4'   13                    	INX	D
  25B5'   05                    	DCR	B
  25B6'   C2 25B3'              	JNZ	SRC_Z
  25B9'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  25BA'                         OWNTF:
  25BA'   3A 0001*              	LDA	FNAME+1
  25BD'   FE 20                 	CPI	' '
  25BF'   CA 2787'              	JZ	MSGNFN
  25C2'   CD 25ED'              	CALL	TFCLR
  25C5'   21 0000*              	LXI	H,FNAME
  25C8'   11 0000*              	LXI	D,TFCB
  25CB'   CD 25E2'              	CALL	COPY12
  25CE'   B7                    	ORA	A		; (NC)
  25CF'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  25D0'                         ISOWN:
  25D0'   21 0000*              	LXI	H,TFCB
  25D3'   11 0000*              	LXI	D,FNAME
  25D6'   06 0C                 	MVI	B,12
  25D8'                         IO_LP:
  25D8'   1A                    	LDAX	D
  25D9'   BE                    	CMP	M
  25DA'   C0                    	RNZ
  25DB'   23                    	INX	H
  25DC'   13                    	INX	D
  25DD'   05                    	DCR	B
  25DE'   C2 25D8'              	JNZ	IO_LP
  25E1'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  25E2'                         COPY12:
  25E2'   06 0C                 	MVI	B,12
  25E4'                         CP_LP:
  25E4'   7E                    	MOV	A,M
  25E5'   12                    	STAX	D
  25E6'   23                    	INX	H
  25E7'   13                    	INX	D
  25E8'   05                    	DCR	B
  25E9'   C2 25E4'              	JNZ	CP_LP
  25EC'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  25ED'                         TFCLR:
  25ED'   11 0000*              	LXI	D,TFCB
  25F0'   06 24                 	MVI	B,36
  25F2'   AF                    	XRA	A
  25F3'                         TC_LP:
  25F3'   12                    	STAX	D
  25F4'   13                    	INX	D
  25F5'   05                    	DCR	B
  25F6'   C2 25F3'              	JNZ	TC_LP
  25F9'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  25FA'                         FOPEN:
  25FA'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25FC'   32 2F7A'              	STA	MSGWHT
  25FF'   21 005C               	LXI	H,DFTFCB
  2602'   CD 26D0'              	CALL	NRMDRV
  2605'   11 0000*              	LXI	D,FNAME
  2608'   CD 25E2'              	CALL	COPY12
  260B'   CD 0000*              	CALL	OPENZ
  260E'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2611'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2613'   C8                    	RZ
  2614'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2617'   32 2F7B'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  261A'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  261B'                         ARGSCN:
  261B'   3A 0080               	LDA	CMDTAIL
  261E'   47                    	MOV	B,A		; B = what is left of the line
  261F'   B7                    	ORA	A
  2620'   C8                    	RZ
  2621'   21 0081               	LXI	H,CMDTAIL+1
  2624'                         AS_TOK:				; at a token, or the blanks before one
  2624'   7E                    	MOV	A,M
  2625'   FE 20                 	CPI	' '
  2627'   C2 2630'              	JNZ	AS_OPT
  262A'   23                    	INX	H
  262B'   05                    	DCR	B
  262C'   C2 2624'              	JNZ	AS_TOK
  262F'   C9                    	RET
  2630'                         AS_OPT:
  2630'   FE 2B                 	CPI	'+'
  2632'   CA 265C'              	JZ	AS_PLS
  2635'   FE 2D                 	CPI	'-'
  2637'   CA 264B'              	JZ	AS_SW
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  263A'   FE 2F                 	CPI	'/'
  263C'   CA 264B'              	JZ	AS_SW
  263F'                         AS_SKP:				; not ours (the file name): on to the next one
  263F'   23                    	INX	H
  2640'   05                    	DCR	B
  2641'   C8                    	RZ
  2642'   7E                    	MOV	A,M
  2643'   FE 20                 	CPI	' '
  2645'   C2 263F'              	JNZ	AS_SKP
  2648'   C3 2624'              	JMP	AS_TOK
  264B'                         AS_SW:
  264B'   23                    	INX	H
  264C'   05                    	DCR	B
  264D'   C8                    	RZ
  264E'   7E                    	MOV	A,M
  264F'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2651'   FE 52                 	CPI	'R'
  2653'   C2 263F'              	JNZ	AS_SKP
  2656'   32 2F7D'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2659'   C3 263F'              	JMP	AS_SKP
  265C'                         AS_PLS:
  265C'   3E 01                 	MVI	A,1
  265E'   32 2F7E'              	STA	PLUSF		; '+' gets the line even with no number on it
  2661'   11 0000*              	LXI	D,PLUSB
  2664'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2666'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2667'   05                    	DCR	B
  2668'   CA 269F'              	JZ	AS_PE
  266B'   7E                    	MOV	A,M
  266C'   FE 30                 	CPI	'0'
  266E'   C2 2686'              	JNZ	AS_PD
  2671'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2671'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2672'   05                    	DCR	B
  2673'   CA 26A7'              	JZ	AS_P1
  2676'   7E                    	MOV	A,M
  2677'   FE 30                 	CPI	'0'
  2679'   CA 2671'              	JZ	AS_PZ
  267C'   FE 31                 	CPI	'1'
  267E'   DA 26A7'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2681'   FE 3A                 	CPI	'9'+1
  2683'   D2 26A7'              	JNC	AS_P1
  2686'                         AS_PD:				; the digits, as typed
  2686'   7E                    	MOV	A,M
  2687'   FE 30                 	CPI	'0'
  2689'   DA 269F'              	JC	AS_PE
  268C'   FE 3A                 	CPI	'9'+1
  268E'   D2 269F'              	JNC	AS_PE
  2691'   79                    	MOV	A,C
  2692'   B7                    	ORA	A
  2693'   CA 26AE'              	JZ	AS_POV
  2696'   0D                    	DCR	C
  2697'   7E                    	MOV	A,M
  2698'   12                    	STAX	D
  2699'   13                    	INX	D
  269A'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  269B'   05                    	DCR	B
  269C'   C2 2686'              	JNZ	AS_PD
  269F'                         AS_PE:
  269F'   AF                    	XRA	A
  26A0'   12                    	STAX	D		; the digits end with a 0
  26A1'   78                    	MOV	A,B
  26A2'   B7                    	ORA	A
  26A3'   C8                    	RZ
  26A4'   C3 2624'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  26A7'                         AS_P1:
  26A7'   3E 31                 	MVI	A,'1'
  26A9'   12                    	STAX	D
  26AA'   13                    	INX	D
  26AB'   C3 269F'              	JMP	AS_PE
  26AE'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  26AE'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  26B1'   C3 269F'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  26B4'                         ARGGO:
  26B4'   3A 2F7E'              	LDA	PLUSF
  26B7'   B7                    	ORA	A
  26B8'   C8                    	RZ
  26B9'   21 0000*              	LXI	H,PLUSB
  26BC'                         AG_LP:
  26BC'   7E                    	MOV	A,M
  26BD'   B7                    	ORA	A
  26BE'   CA 26CB'              	JZ	AG_G
  26C1'   4F                    	MOV	C,A
  26C2'   E5                    	PUSH	H
  26C3'   CD 0023'              	CALL	VICMD
  26C6'   E1                    	POP	H
  26C7'   23                    	INX	H
  26C8'   C3 26BC'              	JMP	AG_LP
  26CB'                         AG_G:
  26CB'   0E 47                 	MVI	C,'G'
  26CD'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  26D0'                         NRMDRV:
  26D0'   7E                    	MOV	A,M
  26D1'   B7                    	ORA	A
  26D2'   C0                    	RNZ
  26D3'   E5                    	PUSH	H
  26D4'   0E 19                 	MVI	C,BF_CURDSK
  26D6'   CD 0005               	CALL	BDOS
  26D9'   E1                    	POP	H
  26DA'   3C                    	INR	A
  26DB'   77                    	MOV	M,A
  26DC'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  26DD'                         PARSFN:
  26DD'   CD 25ED'              	CALL	TFCLR
  26E0'   11 0000*              	LXI	D,TFCB
  26E3'   23                    	INX	H
  26E4'   7E                    	MOV	A,M
  26E5'   2B                    	DCX	H
  26E6'   FE 3A                 	CPI	':'
  26E8'   C2 26FA'              	JNZ	PF_NM
  26EB'   CD 2740'              	CALL	GETFNC
  26EE'   CA 26FA'              	JZ	PF_NM
  26F1'   D6 40                 	SUI	40H
  26F3'   12                    	STAX	D
  26F4'   FE 11                 	CPI	17
  26F6'   D2 271E'              	JNC	PF_BAD
  26F9'   23                    	INX	H
  26FA'                         PF_NM:
  26FA'   13                    	INX	D
  26FB'   0E 08                 	MVI	C,8
  26FD'   CD 2722'              	CALL	CPYNAM
  2700'   FE 2E                 	CPI	'.'
  2702'   0E 03                 	MVI	C,3
  2704'   C4 2735'              	CNZ	PADFLD		; no type: blanks
  2707'   CC 2721'              	CZ	CPYNM0		; '.': the type
  270A'   3A 0001*              	LDA	TFCB+1
  270D'   FE 20                 	CPI	' '
  270F'   CA 271E'              	JZ	PF_BAD		; no name
  2712'   CD 2773'              	CALL	SKIPB
  2715'   C0                    	RNZ			; more after it
  2716'   21 0000*              	LXI	H,TFCB
  2719'   CD 26D0'              	CALL	NRMDRV
  271C'   AF                    	XRA	A
  271D'   C9                    	RET
  271E'                         PF_BAD:
  271E'   F6 01                 	ORI	1
  2720'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2721'                         CPYNM0:
  2721'   23                    	INX	H
  2722'                         CPYNAM:
  2722'   CD 2740'              	CALL	GETFNC
  2725'   CA 2735'              	JZ	PADFLD
  2728'   12                    	STAX	D
  2729'   13                    	INX	D
  272A'   0D                    	DCR	C
  272B'   C2 2722'              	JNZ	CPYNAM
  272E'                         CN_SKP:
  272E'   CD 2740'              	CALL	GETFNC
  2731'   C2 272E'              	JNZ	CN_SKP
  2734'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2735'                         PADFLD:
  2735'   F5                    	PUSH	PSW
  2736'                         PD_LP:
  2736'   3E 20                 	MVI	A,' '
  2738'   12                    	STAX	D
  2739'   13                    	INX	D
  273A'   0D                    	DCR	C
  273B'   C2 2736'              	JNZ	PD_LP
  273E'   F1                    	POP	PSW
  273F'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2740'                         GETFNC:
  2740'   7E                    	MOV	A,M
  2741'   FE 3D                 	CPI	'='
  2743'   C8                    	RZ
  2744'   FE 5F                 	CPI	'_'
  2746'   C8                    	RZ
  2747'   FE 3B                 	CPI	';'
  2749'   C8                    	RZ
  274A'   FE 3C                 	CPI	'<'
  274C'   C8                    	RZ
  274D'   FE 3E                 	CPI	'>'
  274F'   C8                    	RZ
  2750'   FE 2E                 	CPI	'.'
  2752'   C8                    	RZ
  2753'   FE 3A                 	CPI	':'
  2755'   C8                    	RZ
  2756'   FE 2A                 	CPI	'*'
  2758'   C8                    	RZ
  2759'   FE 3F                 	CPI	'?'
  275B'   C8                    	RZ
  275C'   FE 20                 	CPI	' '
  275E'   DA 2771'              	JC	GF_CTL
  2761'   C8                    	RZ
  2762'   23                    	INX	H
  2763'   FE 61                 	CPI	'a'
  2765'   DA 276F'              	JC	GF_DN
