  0FB0'   54                    	MOV	D,H
  0FB1'   5D                    	MOV	E,L
  0FB2'   C3 111F'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FB5'                         VC_PGUP:
  0FB5'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0FB8'   22 0000*              	SHLD	RWR
  0FBB'   3A 0000*              	LDA	SCBOF
  0FBE'   B7                    	ORA	A
  0FBF'   C0                    	RNZ
  0FC0'   CD 0EBF'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FC3'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FC5'   0E 01                 	MVI	C,1
  0FC7'   D2 0FCE'              	JNC	VPU_1
  0FCA'   3A 0000*              	LDA	NEDIT
  0FCD'   4F                    	MOV	C,A
  0FCE'                         VPU_1:
  0FCE'   3A 0000*              	LDA	NEDIT
  0FD1'   CD 11B8'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FD4'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FD5'   D5                    	PUSH	D
  0FD6'   2B                    	DCX	H		; the line above the top one, and on down
  0FD7'   04                    	INR	B
  0FD8'   3E 01                 	MVI	A,1
  0FDA'   CD 1026'              	CALL	OVLAP
  0FDD'   CD 1075'              	CALL	PGROWS		; RWR = the rows to go
  0FE0'   D1                    	POP	D
  0FE1'   E1                    	POP	H
  0FE2'   43                    	MOV	B,E
  0FE3'   CD 1278'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0FE6'   DA 1003'              	JC	VPU_3		;   above it; or the file's first line
  0FE9'   79                    	MOV	A,C
  0FEA'   B7                    	ORA	A
  0FEB'   CA 1003'              	JZ	VPU_3
  0FEE'   3A 0000*              	LDA	RWMV
  0FF1'   B7                    	ORA	A
  0FF2'   C2 1002'              	JNZ	VPU_2
  0FF5'   E5                    	PUSH	H
  0FF6'   CD 11E6'              	CALL	HTIX
  0FF9'   3C                    	INR	A
  0FFA'   21 0000*              	LXI	H,HTTP
  0FFD'   BE                    	CMP	M
  0FFE'   E1                    	POP	H
  0FFF'   CA 1003'              	JZ	VPU_3		; the first line back: all of it
  1002'                         VPU_2:
  1002'   23                    	INX	H
  1003'                         VPU_3:
  1003'   CD 11EC'              	CALL	HTGO		; the cursor on the new top line ...
  1006'   3A 0000*              	LDA	NEDIT
  1009'   4F                    	MOV	C,A
  100A'   06 00                 	MVI	B,0
  100C'   CD 11CD'              	CALL	HTRB		; ... and the lines under it measured
  100F'   E5                    	PUSH	H
  1010'   3A 0000*              	LDA	NEDIT
  1013'   4F                    	MOV	C,A
  1014'   CD 11F7'              	CALL	HTFQ		; HL -> the first the screen has not room for
  1017'   2B                    	DCX	H
  1018'   D1                    	POP	D		; DE -> the top line's rows
  1019'   EB                    	XCHG
  101A'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  101D'   D2 1022'              	JNC	VPU_4		;   fills the screen)
  1020'   54                    	MOV	D,H
  1021'   5D                    	MOV	E,L
  1022'                         VPU_4:
  1022'   EB                    	XCHG
  1023'   C3 111F'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  1026'                         OVLAP:
  1026'   32 0000*              	STA	OVDIR
  1029'   3A 0000*              	LDA	NEDIT
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  102C'   D6 02                 	SUI	2
  102E'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  102F'   56                    	MOV	D,M		; D = h1
  1030'   CD 1067'              	CALL	OV_NX
  1033'   DA 1063'              	JC	OV_0
  1036'   5E                    	MOV	E,M		; E = h2
  1037'   7A                    	MOV	A,D
  1038'   83                    	ADD	E
  1039'   57                    	MOV	D,A		; D = h1 + h2
  103A'   79                    	MOV	A,C
  103B'   BA                    	CMP	D
  103C'   DA 1063'              	JC	OV_0
  103F'   CD 1067'              	CALL	OV_NX
  1042'   DA 1063'              	JC	OV_0
  1045'   7B                    	MOV	A,E
  1046'   86                    	ADD	M
  1047'   5F                    	MOV	E,A		; E = h2 + h3
  1048'   79                    	MOV	A,C
  1049'   BB                    	CMP	E
  104A'   DA 1063'              	JC	OV_0
  104D'   7A                    	MOV	A,D
  104E'   86                    	ADD	M
  104F'   57                    	MOV	D,A		; D = h1 + h2 + h3
  1050'   CD 1067'              	CALL	OV_NX
  1053'   DA 1060'              	JC	OV_1
  1056'   7B                    	MOV	A,E
  1057'   86                    	ADD	M		; h2 + h3 + h4
  1058'   5F                    	MOV	E,A
  1059'   79                    	MOV	A,C
  105A'   BB                    	CMP	E
  105B'   DA 1060'              	JC	OV_1
  105E'   BA                    	CMP	D
