  09FE'   D5                    	PUSH	D		; DE = step from the line start
  09FF'   CD 0000*              	CALL	CUROFF
  0A02'   D1                    	POP	D
  0A03'   19                    	DAD	D
  0A04'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A07'   AF                    VC_W:	XRA	A
  0A08'   32 2629'              	STA	WBIG
  0A0B'   C3 0A13'              	JMP	WDO
  0A0E'   3E 01                 VCBGW:	MVI	A,1
  0A10'   32 2629'              	STA	WBIG
  0A13'   CD 06DB'              WDO:	CALL	SETMOV
  0A16'   AF                    	XRA	A
  0A17'   32 262A'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0A1A'   CD 066E'              	CALL	GETCNT
  0A1D'   22 2661'              	SHLD	CNTV
  0A20'   2A 2661'              WDO_LP: LHLD	CNTV
  0A23'   7C                    	MOV	A,H
  0A24'   B5                    	ORA	L
  0A25'   CA 0A32'              	JZ	WDO_DN
  0A28'   2B                    	DCX	H
  0A29'   22 2661'              	SHLD	CNTV
  0A2C'   CD 0A82'              	CALL	FWD1
  0A2F'   D2 0A20'              	JNC	WDO_LP
  0A32'                         WDO_DN:
  0A32'   CD 0985'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0A35'   DA 0A42'              	JC	WDO_NL
  0A38'   FE 0D                 	CPI	CR
  0A3A'   CA 0A42'              	JZ	WDO_NL
  0A3D'   FE 0A                 	CPI	LF
  0A3F'   C2 0560'              	JNZ	SETGL
  0A42'                         WDO_NL:
  0A42'   CD 0000*              	CALL	PEEKL
  0A45'   DA 0560'              	JC	SETGL
  0A48'   FE 0A                 	CPI	LF
  0A4A'   CA 0560'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0A4D'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0A4F'   32 262A'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0A52'   CD 0B7D'              	CALL	DECC		; back onto its last char
  0A55'   C3 0560'              	JMP	SETGL
                                
  0A58'   AF                    VC_B:	XRA	A
  0A59'   32 2629'              	STA	WBIG
  0A5C'   C3 0A64'              	JMP	BDO
  0A5F'   3E 01                 VCBGB:	MVI	A,1
  0A61'   32 2629'              	STA	WBIG
  0A64'   CD 06DB'              BDO:	CALL	SETMOV
  0A67'   CD 066E'              	CALL	GETCNT
  0A6A'   22 2661'              	SHLD	CNTV
  0A6D'   2A 2661'              BDO_LP: LHLD	CNTV
  0A70'   7C                    	MOV	A,H
  0A71'   B5                    	ORA	L
  0A72'   CA 0560'              	JZ	SETGL
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A75'   2B                    	DCX	H
  0A76'   22 2661'              	SHLD	CNTV
  0A79'   CD 0ACE'              	CALL	BCK1
  0A7C'   D2 0A6D'              	JNC	BDO_LP
  0A7F'   C3 0560'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0A82'                         FWD1:
  0A82'   CD 0B01'              	CALL	CCLS
  0A85'   32 266D'              	STA	WKCLS		; the starting class
  0A88'   CD 0B3B'              	CALL	INCC
  0A8B'   B7                    	ORA	A
  0A8C'   CA 0AA4'              	JZ	FW_WD
  0A8F'   37                    	STC
  0A90'   F8                    	RM			; -1: already at the end
  0A91'   FE 02                 	CPI	2
  0A93'   C2 0AA4'              	JNZ	FW_WD		; 1: a next line was reached
  0A96'   CD 0985'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0A99'   D4 0B22'              	CNC	NXLN
  0A9C'   D2 0AA4'              	JNC	FW_WD
  0A9F'   CD 0B7D'              	CALL	DECC		; yes: back onto its last char, failed
  0AA2'   37                    	STC
  0AA3'   C9                    	RET
  0AA4'                         FW_WD:
  0AA4'   3A 266D'              	LDA	WKCLS		; go past the rest of this word
  0AA7'   B7                    	ORA	A
  0AA8'   CA 0ABD'              	JZ	FW_WS
  0AAB'                         FW_WLP:
  0AAB'   CD 0B01'              	CALL	CCLS
  0AAE'   21 266D'              	LXI	H,WKCLS
  0AB1'   BE                    	CMP	M
  0AB2'   C2 0ABD'              	JNZ	FW_WS
  0AB5'   CD 0B3B'              	CALL	INCC
  0AB8'   B7                    	ORA	A
  0AB9'   F8                    	RM			; the end of the file (NC)
  0ABA'   C3 0AAB'              	JMP	FW_WLP
  0ABD'                         FW_WS:
  0ABD'   CD 0B01'              	CALL	CCLS		; then over blanks to the next word
  0AC0'   B7                    	ORA	A
  0AC1'   C0                    	RNZ
  0AC2'   CD 0B09'              	CALL	EMPTY
  0AC5'   C8                    	RZ			; an empty line is a word
  0AC6'   CD 0B3B'              	CALL	INCC
  0AC9'   B7                    	ORA	A
  0ACA'   F8                    	RM
  0ACB'   C3 0ABD'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0ACE'                         BCK1:
  0ACE'   CD 0B7D'              	CALL	DECC
  0AD1'   B7                    	ORA	A
  0AD2'   37                    	STC
  0AD3'   F8                    	RM
  0AD4'                         BK_WS:
  0AD4'   CD 0B01'              	CALL	CCLS		; back over blanks
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AD7'   B7                    	ORA	A
  0AD8'   C2 0AE8'              	JNZ	BK_WD
  0ADB'   CD 0B09'              	CALL	EMPTY
  0ADE'   C8                    	RZ			; an empty line is a word
  0ADF'   CD 0B7D'              	CALL	DECC
  0AE2'   B7                    	ORA	A
  0AE3'   F2 0AD4'              	JP	BK_WS
  0AE6'   AF                    	XRA	A		; the start of the file (NC)
  0AE7'   C9                    	RET
  0AE8'                         BK_WD:
  0AE8'   32 266D'              	STA	WKCLS		; back to the start of this word
  0AEB'                         BK_WLP:
  0AEB'   CD 0B7D'              	CALL	DECC
  0AEE'   B7                    	ORA	A
  0AEF'   FA 0AFF'              	JM	BK_OK		; the start of the file
  0AF2'   CD 0B01'              	CALL	CCLS
  0AF5'   21 266D'              	LXI	H,WKCLS
  0AF8'   BE                    	CMP	M
  0AF9'   CA 0AEB'              	JZ	BK_WLP
  0AFC'   CD 0B3B'              	CALL	INCC		; overshot: forward one
  0AFF'                         BK_OK:
  0AFF'   AF                    	XRA	A
  0B00'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B01'                         CCLS:
  0B01'   CD 0985'              	CALL	ATEOF
  0B04'   D2 0690'              	JNC	CLASSF
  0B07'   AF                    	XRA	A
  0B08'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B09'                         EMPTY:
  0B09'   CD 0985'              	CALL	ATEOF
  0B0C'   DA 0B17'              	JC	EM_ST
  0B0F'   FE 0D                 	CPI	CR
  0B11'   CA 0B17'              	JZ	EM_ST
  0B14'   FE 0A                 	CPI	LF
  0B16'   C0                    	RNZ
  0B17'                         EM_ST:
  0B17'   CD 0000*              	CALL	PEEKL
  0B1A'   DA 0B20'              	JC	EM_Y
  0B1D'   FE 0A                 	CPI	LF
  0B1F'   C9                    	RET
  0B20'                         EM_Y:
  0B20'   AF                    	XRA	A
  0B21'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0B22'                         NXLN:
  0B22'   FE 0A                 	CPI	LF
  0B24'   CA 0B33'              	JZ	NX_LF
  0B27'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0B2A'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B2B'   FE 0A                 	CPI	LF
  0B2D'   CA 0B33'              	JZ	NX_LF
  0B30'   2B                    	DCX	H		; a lone CR
  0B31'   AF                    	XRA	A
  0B32'   C9                    	RET
  0B33'                         NX_LF:
  0B33'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0B36'   D8                    	RC
  0B37'   2B                    	DCX	H
  0B38'   3E 01                 	MVI	A,1
  0B3A'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0B3B'                         INCC:
  0B3B'   CD 0985'              	CALL	ATEOF
  0B3E'   DA 0B79'              	JC	IC_END
  0B41'   FE 0D                 	CPI	CR
  0B43'   CA 0B64'              	JZ	IC_NL
  0B46'   FE 0A                 	CPI	LF
  0B48'   CA 0B64'              	JZ	IC_NL
  0B4B'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0B4E'                         IC_CH:
  0B4E'   CD 0985'              	CALL	ATEOF
  0B51'   DA 0B60'              	JC	IC_2
  0B54'   FE 0D                 	CPI	CR
  0B56'   CA 0B60'              	JZ	IC_2
  0B59'   FE 0A                 	CPI	LF
  0B5B'   CA 0B60'              	JZ	IC_2
  0B5E'   AF                    	XRA	A
  0B5F'   C9                    	RET
  0B60'                         IC_2:
  0B60'   3E 02                 	MVI	A,2
  0B62'   B7                    	ORA	A
  0B63'   C9                    	RET
  0B64'                         IC_NL:
  0B64'   CD 0B22'              	CALL	NXLN
  0B67'   DA 0B79'              	JC	IC_END
  0B6A'   F5                    	PUSH	PSW
  0B6B'   CD 0000*              	CALL	PUTCUR
  0B6E'   F1                    	POP	PSW
  0B6F'   B7                    	ORA	A
  0B70'   CA 0B4E'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B73'   CD 0B9F'              	CALL	LNINC
  0B76'   3E 01                 	MVI	A,1
  0B78'   C9                    	RET
  0B79'                         IC_END:
  0B79'   3E FF                 	MVI	A,0FFH
  0B7B'   B7                    	ORA	A
  0B7C'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B7D'                         DECC:
  0B7D'   CD 0000*              	CALL	PEEKL
