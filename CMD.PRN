  10D1'   BA                    	CMP	D
  10D2'   D2 10DB'              	JNC	VHD_1
  10D5'   57                    	MOV	D,A
  10D6'   C3 10DB'              	JMP	VHD_1
  10D9'                         VHD_0:
  10D9'   16 00                 	MVI	D,0
  10DB'                         VHD_1:
  10DB'   7A                    	MOV	A,D
  10DC'   B7                    	ORA	A
  10DD'   CA 10F8'              	JZ	VHD_C		; the text stays
  10E0'   4A                    	MOV	C,D
  10E1'   CD 11EA'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  10E4'   79                    	MOV	A,C
  10E5'   B7                    	ORA	A
  10E6'   CA 10F8'              	JZ	VHD_C
  10E9'   BA                    	CMP	D
  10EA'   C2 10F5'              	JNZ	VHD_R
  10ED'   7E                    	MOV	A,M		; the top line still: past all of it
  10EE'   91                    	SUB	C
  10EF'   83                    	ADD	E
  10F0'   5F                    	MOV	E,A
  10F1'   23                    	INX	H
  10F2'   C3 10F8'              	JMP	VHD_C
  10F5'                         VHD_R:
  10F5'   7B                    	MOV	A,E		; part of the way down a line: its start
  10F6'   91                    	SUB	C
  10F7'   5F                    	MOV	E,A
  10F8'                         VHD_C:
  10F8'   22 0000*              	SHLD	HFTP
  10FB'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  10FE'   83                    	ADD	E
  10FF'   4F                    	MOV	C,A
  1100'   3A 0000*              	LDA	HTCUR
  1103'   CD 11CC'              	CALL	HTPT
  1106'   CD 11EA'              	CALL	HTFQ
  1109'   D2 110D'              	JNC	HFEND
  110C'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  110D'                         HFEND:
  110D'   EB                    	XCHG
  110E'   2A 0000*              	LHLD	HFTP
  1111'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  1112'                         HTLAND:
  1112'   E5                    	PUSH	H
  1113'   D5                    	PUSH	D
  1114'   CD 11DF'              	CALL	HTGO
  1117'   D1                    	POP	D
  1118'   E1                    	POP	H
  1119'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  111C'   7C                    	MOV	A,H
  111D'   B7                    	ORA	A
  111E'   7D                    	MOV	A,L
  111F'   CA 1123'              	JZ	HL_SET
  1122'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1123'                         HL_SET:
  1123'   CD 0ED1'              	CALL	SETRWT
  1126'   C3 094B'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1129'                         VHD_TL:
  1129'   3A 0000*              	LDA	SKIPR
  112C'   47                    	MOV	B,A
  112D'   3A 0000*              	LDA	CSUB
  1130'   90                    	SUB	B		; A = that row
  1131'   F5                    	PUSH	PSW
  1132'   21 0001               	LXI	H,1
  1135'   CD 0A06'              	CALL	JCORE		; (on the last line: nowhere to go)
  1138'   F1                    	POP	PSW
  1139'   4F                    	MOV	C,A
  113A'   C5                    	PUSH	B
  113B'   0C                    	INR	C
  113C'   06 00                 	MVI	B,0
  113E'   CD 11C0'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  1141'   22 0000*              	SHLD	HFTP
  1144'   D1                    	POP	D
  1145'   4B                    	MOV	C,E
  1146'   CD 11EA'              	CALL	HTFQ
  1149'   D2 110D'              	JNC	HFEND
  114C'   2B                    	DCX	H
  114D'   C3 110D'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  1150'                         VC_HFUP:
  1150'   CD 0852'              	CALL	SETMOV
  1153'   CD 12CE'              	CALL	HFCNT		; HFN = the rows
  1156'   CD 12AE'              	CALL	ONFST
  1159'   C8                    	RZ			; the cursor is on the first line
  115A'   0E 01                 	MVI	C,1
  115C'   3A 0000*              	LDA	HFN
  115F'   CD 11AB'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  1162'   43                    	MOV	B,E
  1163'   3A 0000*              	LDA	HFN
  1166'   4F                    	MOV	C,A
  1167'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1168'   CD 11FB'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  116B'   DA 1186'              	JC	VHU_C		;   above it; or the file's first line
  116E'   79                    	MOV	A,C
  116F'   B7                    	ORA	A
  1170'   CA 1186'              	JZ	VHU_C
  1173'   3A 0000*              	LDA	HTTP
  1176'   3D                    	DCR	A
  1177'   B8                    	CMP	B
  1178'   CA 1183'              	JZ	VHU_F
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  117B'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  117C'   96                    	SUB	M
  117D'   81                    	ADD	C
  117E'   5F                    	MOV	E,A
  117F'   23                    	INX	H
  1180'   C3 1186'              	JMP	VHU_C
  1183'                         VHU_F:
  1183'   7B                    	MOV	A,E		; ... the first line back: all of it
  1184'   81                    	ADD	C
  1185'   5F                    	MOV	E,A
  1186'                         VHU_C:
  1186'   22 0000*              	SHLD	HFTP
  1189'   4B                    	MOV	C,E
  118A'   3A 0000*              	LDA	HTCUR
  118D'   CD 11CC'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  1190'   3A 0000*              	LDA	CSUB
  1193'   57                    	MOV	D,A
  1194'   79                    	MOV	A,C
  1195'   92                    	SUB	D		; the rows to go, less those of its own line above it
  1196'   DA 110D'              	JC	HFEND
  1199'   CA 110D'              	JZ	HFEND
  119C'   4F                    	MOV	C,A
  119D'   43                    	MOV	B,E
  119E'   CD 11FB'              	CALL	HTBQ		; (off the top: the file's first line)
  11A1'   C3 110D'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11A4'                         HTSCR:
  11A4'   CD 0EB2'              	CALL	CURRW
  11A7'   47                    	MOV	B,A
  11A8'   C3 11B6'              	JMP	HS_TP
  11AB'                         HTSET:
  11AB'   47                    	MOV	B,A
  11AC'   CD 0EB2'              	CALL	CURRW		; (keeps BC)
  11AF'   F5                    	PUSH	PSW
  11B0'   80                    	ADD	B
  11B1'   47                    	MOV	B,A
  11B2'   CD 11C0'              	CALL	HTRB
  11B5'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11B6'                         HS_TP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  11B6'   3A 0000*              	LDA	HTCUR
  11B9'   90                    	SUB	B
  11BA'   32 0000*              	STA	HTTP
  11BD'   C3 11CC'              	JMP	HTPT
  11C0'                         HTRB:
  11C0'   CD 139E'              	CALL	ZSAVE
  11C3'   CD 0000*              	CALL	HTBLD
  11C6'   CD 13B1'              	CALL	ZREST
  11C9'   3A 0000*              	LDA	HTCUR
  11CC'                         HTPT:
  11CC'   5F                    	MOV	E,A
  11CD'   16 00                 	MVI	D,0
  11CF'   21 0000*              	LXI	H,HTAB
  11D2'   19                    	DAD	D
  11D3'   3A 0000*              	LDA	HTN
  11D6'   93                    	SUB	E
  11D7'   47                    	MOV	B,A
  11D8'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  11D9'                         HTIX:
  11D9'   11 0000*              	LXI	D,HTAB
  11DC'   7D                    	MOV	A,L
  11DD'   93                    	SUB	E
  11DE'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  11DF'                         HTGO:
  11DF'   CD 11D9'              	CALL	HTIX
  11E2'   47                    	MOV	B,A
  11E3'   3A 0000*              	LDA	HTCUR
  11E6'   90                    	SUB	B		; A = the lines up to it
  11E7'   C3 0EE9'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  11EA'                         HTFQ:
  11EA'   78                    	MOV	A,B
  11EB'   B7                    	ORA	A
  11EC'   37                    	STC
  11ED'   C8                    	RZ
  11EE'   79                    	MOV	A,C
  11EF'   96                    	SUB	M
  11F0'   DA 11F9'              	JC	HF_IN
  11F3'   4F                    	MOV	C,A
  11F4'   23                    	INX	H
  11F5'   05                    	DCR	B
  11F6'   C3 11EA'              	JMP	HTFQ
  11F9'                         HF_IN:
  11F9'   B7                    	ORA	A
  11FA'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  11FB'                         HTBQ:
  11FB'   78                    	MOV	A,B
  11FC'   B7                    	ORA	A
  11FD'   37                    	STC
  11FE'   C8                    	RZ
  11FF'   2B                    	DCX	H
  1200'   05                    	DCR	B
  1201'   7E                    	MOV	A,M
  1202'   91                    	SUB	C
  1203'   D2 120C'              	JNC	HQ_IN
  1206'   2F                    	CMA
  1207'   3C                    	INR	A
  1208'   4F                    	MOV	C,A
  1209'   C3 11FB'              	JMP	HTBQ
  120C'                         HQ_IN:
  120C'   4F                    	MOV	C,A
  120D'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  120E'                         RWQ:
  120E'   0E 64                 	MVI	C,100
  1210'   3A 0001*              	LDA	RWR+1
  1213'   B7                    	ORA	A
  1214'   C0                    	RNZ
  1215'   3A 0000*              	LDA	RWR
  1218'   B9                    	CMP	C
  1219'   D0                    	RNC
  121A'   4F                    	MOV	C,A
  121B'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  121C'                         RWSUB:
  121C'   E5                    	PUSH	H
  121D'   5F                    	MOV	E,A
  121E'   16 00                 	MVI	D,0
  1220'   2A 0000*              	LHLD	RWR
  1223'   CD 0000*              	CALL	SUBHD
  1226'   22 0000*              	SHLD	RWR
  1229'   E1                    	POP	H
  122A'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  122B'                         RWFWD:
  122B'   CD 120E'              	CALL	RWQ
  122E'   51                    	MOV	D,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122F'   CD 11EA'              	CALL	HTFQ
  1232'   F5                    	PUSH	PSW
  1233'   7A                    	MOV	A,D
  1234'   91                    	SUB	C		; the rows that took it to that line's first
  1235'   CD 121C'              	CALL	RWSUB
  1238'   F1                    	POP	PSW
  1239'   DA 124D'              	JC	RF_OFF
  123C'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  123F'   B7                    	ORA	A
  1240'   C2 1257'              	JNZ	RF_GO
  1243'   3A 0000*              	LDA	RWR
  1246'   BE                    	CMP	M
  1247'   D2 1257'              	JNC	RF_GO
  124A'   4F                    	MOV	C,A
  124B'   B7                    	ORA	A
  124C'   C9                    	RET
  124D'                         RF_OFF:
  124D'   3A 0000*              	LDA	HTEOF
  1250'   B7                    	ORA	A
  1251'   CA 1257'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1254'   2B                    	DCX	H
  1255'   37                    	STC
  1256'   C9                    	RET
  1257'                         RF_GO:
  1257'   CD 11DF'              	CALL	HTGO
  125A'   3E 01                 	MVI	A,1
  125C'   32 0000*              	STA	RWMV
  125F'   CD 120E'              	CALL	RWQ
  1262'   0C                    	INR	C
  1263'   06 00                 	MVI	B,0
  1265'   CD 11C0'              	CALL	HTRB
  1268'   C3 122B'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  126B'                         RWBAK:
  126B'   CD 120E'              	CALL	RWQ
  126E'   51                    	MOV	D,C
  126F'   CD 11FB'              	CALL	HTBQ
  1272'   DA 128F'              	JC	RB_OFF
  1275'   7A                    	MOV	A,D
  1276'   81                    	ADD	C
  1277'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1278'   3A 0001*              	LDA	RWR+1
  127B'   B7                    	ORA	A
  127C'   C2 128B'              	JNZ	RB_ON
  127F'   3A 0000*              	LDA	RWR
  1282'   57                    	MOV	D,A
  1283'   7B                    	MOV	A,E
  1284'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  1285'   DA 128B'              	JC	RB_ON
  1288'   4F                    	MOV	C,A
  1289'   B7                    	ORA	A
  128A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  128B'                         RB_ON:
  128B'   7B                    	MOV	A,E
  128C'   C3 1296'              	JMP	RB_GO
  128F'                         RB_OFF:
  128F'   3A 0000*              	LDA	HTBOF
  1292'   0F                    	RRC			; CY: that is the file's first line
  1293'   D8                    	RC
  1294'   7A                    	MOV	A,D
  1295'   91                    	SUB	C
  1296'                         RB_GO:
  1296'   CD 121C'              	CALL	RWSUB
  1299'   CD 11DF'              	CALL	HTGO
  129C'   3E 01                 	MVI	A,1
  129E'   32 0000*              	STA	RWMV
  12A1'   CD 120E'              	CALL	RWQ
  12A4'   41                    	MOV	B,C
  12A5'   0E 01                 	MVI	C,1
  12A7'   CD 11C0'              	CALL	HTRB
  12AA'   43                    	MOV	B,E
  12AB'   C3 126B'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12AE'                         ONFST:
  12AE'   E5                    	PUSH	H
  12AF'   2A 0000*              	LHLD	OUTPOS
  12B2'   7C                    	MOV	A,H
  12B3'   B5                    	ORA	L
  12B4'   C2 12CC'              	JNZ	OF_RET
  12B7'   2A 0000*              	LHLD	TXTBEG
  12BA'   EB                    	XCHG			; DE = TXTBEG
  12BB'   2A 0000*              	LHLD	GAPBEG
  12BE'                         OF_LP:
  12BE'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12C1'   CA 12CC'              	JZ	OF_RET
  12C4'   2B                    	DCX	H
  12C5'   7E                    	MOV	A,M
  12C6'   FE 0A                 	CPI	LF
  12C8'   C2 12BE'              	JNZ	OF_LP
  12CB'   B7                    	ORA	A		; NZ
  12CC'                         OF_RET:
  12CC'   E1                    	POP	H
  12CD'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12CE'                         HFCNT:
  12CE'   2A 0000*              	LHLD	CMDCNT
  12D1'   7C                    	MOV	A,H
  12D2'   B5                    	ORA	L
  12D3'   CA 12EA'              	JZ	HFC_AM
  12D6'   CD 077D'              	CALL	GETCNT		; HL = count; clears it
  12D9'   3A 0000*              	LDA	NEDIT
  12DC'   5F                    	MOV	E,A
  12DD'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12DF'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  12E2'   D2 12E6'              	JNC	HFC_ST
  12E5'   EB                    	XCHG			; HL = NEDIT
  12E6'                         HFC_ST:
  12E6'   7D                    	MOV	A,L
  12E7'   32 0000*              	STA	HFAMT
  12EA'                         HFC_AM:
  12EA'   3A 0000*              	LDA	HFAMT
  12ED'   B7                    	ORA	A
  12EE'   C2 12FB'              	JNZ	HFC_HL
  12F1'   3A 0000*              	LDA	NEDIT
  12F4'   B7                    	ORA	A
  12F5'   1F                    	RAR
  12F6'   B7                    	ORA	A
  12F7'   C2 12FB'              	JNZ	HFC_HL
  12FA'   3C                    	INR	A		; at least one row
  12FB'                         HFC_HL:
  12FB'   32 0000*              	STA	HFN
  12FE'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  12FF'                         VC_REDR:
  12FF'   C3 077D'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  1302'                         VC_G:
  1302'   CD 0852'              	CALL	SETMOV
  1305'   CD 13C4'              	CALL	GZONE		; the screen's top line, before the move
  1308'   CD 07A6'              	CALL	BRKON		; ... and an ESC may stop it from here on
  130B'   2A 0000*              	LHLD	CMDCNT
  130E'   7C                    	MOV	A,H
  130F'   B5                    	ORA	L
  1310'   C2 1323'              	JNZ	VG_N
  1313'   AF                    	XRA	A		; forward
  1314'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1317'   CD 07E3'              	CALL	BRKOFF
  131A'   DA 07FB'              	JC	BRKBAK
  131D'   CD 0BD4'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1320'   C3 13DC'              	JMP	GPLACE
  1323'                         VG_N:
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1323'   CD 077D'              	CALL	GETCNT		; HL = target line (1-based)
  1326'                         VG_LN:
  1326'   CD 1332'              	CALL	GOLN
  1329'   CD 07E3'              	CALL	BRKOFF
  132C'   DA 07FB'              	JC	BRKBAK
  132F'   C3 13DC'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  1332'                         GOLN:
  1332'   E5                    	PUSH	H
  1333'   CD 0000*              	CALL	CNTLF
  1336'   23                    	INX	H		; HL = the cursor's line
  1337'   D1                    	POP	D		; DE = the line wanted
  1338'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  133B'   DA 1346'              	JC	GLN_BK
  133E'   EB                    	XCHG
  133F'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  1342'   AF                    	XRA	A
  1343'   C3 134B'              	JMP	GLN_MV
  1346'                         GLN_BK:
  1346'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1349'   3E FF                 	MVI	A,0FFH
  134B'                         GLN_MV:
  134B'   CD 0000*              	CALL	MVLIND
  134E'   CD 0BCE'              	CALL	ATEOF
  1351'   DC 0BD4'              	CC	LASTLN		; past the last line: onto it
  1354'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1355'                         VC_LG:
  1355'   CD 0852'              	CALL	SETMOV
  1358'   3A 0000*              	LDA	GSAVE
  135B'   B7                    	ORA	A
  135C'   C2 1365'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  135F'   3E 01                 	MVI	A,PG
  1361'   32 0000*              	STA	GPEND
  1364'   C9                    	RET
  1365'                         VLG_GG:
  1365'   CD 13C4'              	CALL	GZONE
  1368'   CD 07A6'              	CALL	BRKON
  136B'   CD 077D'              	CALL	GETCNT		; HL = target line (no count: 1)
  136E'   C3 1326'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  1371'                         SUB24:
  1371'   4F                    	MOV	C,A
  1372'   7D                    	MOV	A,L
  1373'   93                    	SUB	E
  1374'   6F                    	MOV	L,A
  1375'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1376'   9A                    	SBB	D
  1377'   67                    	MOV	H,A
  1378'   79                    	MOV	A,C
  1379'   98                    	SBB	B
  137A'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  137B'                         CURFP:
  137B'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  137E'                         FPOS:
  137E'   C5                    	PUSH	B
  137F'   D5                    	PUSH	D
  1380'   EB                    	XCHG
  1381'   2A 0000*              	LHLD	TXTBEG
  1384'   EB                    	XCHG
  1385'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  1388'   EB                    	XCHG			; DE = that
  1389'   2A 0000*              	LHLD	OUTPOS
  138C'   7C                    	MOV	A,H
  138D'   B7                    	ORA	A		; CY = 0
  138E'   1F                    	RAR
  138F'   47                    	MOV	B,A
  1390'   7D                    	MOV	A,L
  1391'   1F                    	RAR
  1392'   67                    	MOV	H,A
  1393'   3E 00                 	MVI	A,0
  1395'   1F                    	RAR
  1396'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  1397'   19                    	DAD	D
  1398'   78                    	MOV	A,B
  1399'   CE 00                 	ACI	0		; A:HL = the position
  139B'   D1                    	POP	D
  139C'   C1                    	POP	B
  139D'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  139E'                         ZSAVE:
  139E'   2A 0000*              	LHLD	CMDCNT
  13A1'   22 0000*              	SHLD	ZSVCNT
  13A4'   2A 0000*              	LHLD	AUXCNT
  13A7'   22 0000*              	SHLD	ZSVAUX
  13AA'   3A 0000*              	LDA	DIRFLG
  13AD'   32 0000*              	STA	ZSVDIR
  13B0'   C9                    	RET
  13B1'                         ZREST:
  13B1'   2A 0000*              	LHLD	ZSVCNT
  13B4'   22 0000*              	SHLD	CMDCNT
  13B7'   2A 0000*              	LHLD	ZSVAUX
  13BA'   22 0000*              	SHLD	AUXCNT
  13BD'   3A 0000*              	LDA	ZSVDIR
  13C0'   32 0000*              	STA	DIRFLG
  13C3'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  13C4'                         GZONE:
  13C4'   CD 139E'              	CALL	ZSAVE
  13C7'   CD 0EB2'              	CALL	CURRW
  13CA'   6F                    	MOV	L,A
  13CB'   26 00                 	MVI	H,0
  13CD'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  13D0'   CD 137E'              	CALL	FPOS
  13D3'   22 0000*              	SHLD	ZTOP
  13D6'   32 0002*              	STA	ZTOP+2
  13D9'   C3 13B1'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  13DC'                         GPLACE:
  13DC'   CD 139E'              	CALL	ZSAVE
  13DF'   CD 137B'              	CALL	CURFP
  13E2'   EB                    	XCHG
  13E3'   2A 0000*              	LHLD	ZTOP
  13E6'   EB                    	XCHG
  13E7'   4F                    	MOV	C,A		; C:HL = the target's position
  13E8'   3A 0002*              	LDA	ZTOP+2
  13EB'   47                    	MOV	B,A		; B:DE = the top's
  13EC'   79                    	MOV	A,C
  13ED'   CD 1371'              	CALL	SUB24
  13F0'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  13F3'   DA 142D'              	JC	GP_UP
  13F6'   B7                    	ORA	A
  13F7'   C2 1473'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  13FA'   3A 0000*              	LDA	NEDIT
  13FD'   87                    	ADD	A
  13FE'   3C                    	INR	A
  13FF'   6F                    	MOV	L,A
  1400'   26 00                 	MVI	H,0
  1402'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1405'   CD 0776'              	CALL	GBSUB		; HL = bytes from there to the target
  1408'   EB                    	XCHG
  1409'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  140C'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  140F'   DA 1473'              	JC	GP_MID
  1412'   CD 0776'              	CALL	GBSUB		; HL = the top line's start (resident)
  1415'   01 0000               	LXI	B,0		; BC = lines from the top
  1418'                         GP_CNT:
  1418'   7A                    	MOV	A,D
  1419'   B3                    	ORA	E
  141A'   CA 1429'              	JZ	GP_DN
  141D'   7E                    	MOV	A,M
  141E'   23                    	INX	H
  141F'   1B                    	DCX	D
  1420'   FE 0A                 	CPI	LF
  1422'   C2 1418'              	JNZ	GP_CNT
  1425'   03                    	INX	B
  1426'   C3 1418'              	JMP	GP_CNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1429'                         GP_DN:
  1429'   79                    	MOV	A,C		; the lines from the top one to it
  142A'   C3 149D'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  142D'                         GP_UP:
  142D'   3C                    	INR	A
  142E'   C2 1473'              	JNZ	GP_MID		; 64K bytes or more above
  1431'   2A 0000*              	LHLD	ZDIF
  1434'   EB                    	XCHG
  1435'   21 0000               	LXI	H,0
  1438'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  143B'   7C                    	MOV	A,H
  143C'   B5                    	ORA	L
  143D'   CA 1473'              	JZ	GP_MID		; exactly 64K
  1440'   EB                    	XCHG			; DE = bytes to read
  1441'   AF                    	XRA	A
  1442'   32 0000*              	STA	ZLF
  1445'   CD 0000*              	CALL	RGET0
  1448'                         GP_RD:
  1448'   CD 0000*              	CALL	RDGET		; (keeps DE)
  144B'   DA 1473'              	JC	GP_MID
  144E'   FE 0A                 	CPI	LF
  1450'   C2 1464'              	JNZ	GP_RN
  1453'   3A 0000*              	LDA	NEDIT
  1456'   B7                    	ORA	A
  1457'   1F                    	RAR
  1458'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  145A'   E5                    	PUSH	H
  145B'   21 0000*              	LXI	H,ZLF
  145E'   34                    	INR	M
  145F'   BE                    	CMP	M		; CY iff more lines than that
  1460'   E1                    	POP	H
  1461'   DA 1473'              	JC	GP_MID
  1464'                         GP_RN:
  1464'   1B                    	DCX	D
  1465'   7A                    	MOV	A,D
  1466'   B3                    	ORA	E
  1467'   C2 1448'              	JNZ	GP_RD
  146A'   3E 01                 	MVI	A,PL_SET	; the top row
  146C'   32 0000*              	STA	PLACE
  146F'   AF                    	XRA	A
  1470'   C3 147D'              	JMP	GP_SET
  1473'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1473'   3E 02                 	MVI	A,PL_MID
  1475'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1478'   3A 0000*              	LDA	NEDIT
  147B'   B7                    	ORA	A
  147C'   1F                    	RAR			; (no more lines above it than this)
  147D'                         GP_SET:
  147D'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  147E'   26 00                 	MVI	H,0
  1480'   22 0000*              	SHLD	WINROW
  1483'   21 0000               	LXI	H,0
  1486'   22 0000*              	SHLD	LNDLT
  1489'   CD 088F'              	CALL	SETFUL		; the window may have paged: full repaint
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  148C'                         GP_FIN:
  148C'   CD 13B1'              	CALL	ZREST
  148F'   3A 0000*              	LDA	GPKEEP
  1492'   B7                    	ORA	A
  1493'   CA 094B'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1496'   AF                    	XRA	A
  1497'   32 0000*              	STA	GPKEEP
  149A'   C3 0611'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  149D'                         GP_ONS:
  149D'   6F                    	MOV	L,A
  149E'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14A0'   EB                    	XCHG
  14A1'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14A4'   EB                    	XCHG
  14A5'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14A8'   22 0000*              	SHLD	LNDLT
  14AB'   3E 01                 	MVI	A,R_MOVE
  14AD'   32 0000*              	STA	RINTENT
  14B0'   C3 148C'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14B3'                         OPPEND:
  14B3'   AF                    	XRA	A
  14B4'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                	;    blanks, and on an empty line it changes nothing at all). ---
  14B7'   3A 0000*              	LDA	PSAVE
  14BA'   FE 63                 	CPI	'c'
  14BC'   C2 14D9'              	JNZ	OPP_ND
  14BF'   79                    	MOV	A,C
  14C0'   FE 77                 	CPI	'w'
  14C2'   CA 14CA'              	JZ	OPP_W
  14C5'   FE 57                 	CPI	'W'
  14C7'   C2 14D9'              	JNZ	OPP_ND
  14CA'                         OPP_W:
  14CA'   CD 16AC'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  14CD'   DA 14D9'              	JC	OPP_ND
  14D0'   79                    	MOV	A,C
  14D1'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  14D3'   4F                    	MOV	C,A
  14D4'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  14D6'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  14D9'                         OPP_ND:
  14D9'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  14DA'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  14DC'   C2 14F0'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  14DF'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  14E2'   DA 1580'              	JC	OPABRT
  14E5'   79                    	MOV	A,C
  14E6'   FE 67                 	CPI	'g'
  14E8'   C2 1580'              	JNZ	OPABRT
  14EB'   3E 01                 	MVI	A,PG
  14ED'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  14F0'                         OPP_NG:
  14F0'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  14F1'   21 0000*              	LXI	H,PSAVE
  14F4'   BE                    	CMP	M
  14F5'   CA 16CD'              	JZ	OPLINE
  14F8'   79                    	MOV	A,C		; (OPCLS classifies the key)
  14F9'   CD 16E3'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  14FC'   DA 1580'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  14FF'   32 0000*              	STA	OPCLSV
  1502'   47                    	MOV	B,A		; B = the class
  1503'   3A 0000*              	LDA	PSAVE
  1506'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1508'   C2 1514'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  150B'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  150C'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  150E'   C2 1536'              	JNZ	OPP_GO
  1511'   C3 151F'              	JMP	OPP_NO
  1514'                         OPP_NC:
  1514'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1516'   C2 1536'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1519'   78                    	MOV	A,B		;   a charwise register would need a type flag
  151A'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  151C'   CA 1536'              	JZ	OPP_GO		;   within a line -- neither of which is built
  151F'                         OPP_NO:
  151F'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  1520'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  1522'   CA 1530'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1525'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1527'   CA 1530'              	JZ	OPP_SW		;   so swallow it before dropping the command
  152A'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  152D'   C2 1580'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  1530'                         OPP_SW:
  1530'   CD 01F9'              	CALL	MKGETK
  1533'   C3 1580'              	JMP	OPABRT
  1536'                         OPP_GO:
  1536'   AF                    	XRA	A
  1537'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  153A'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  153D'   22 0000*              	SHLD	OPSTA
  1540'   C5                    	PUSH	B
  1541'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1544'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  1547'   3A 0000*              	LDA	OPCLSV
  154A'   FE 02                 	CPI	2
  154C'   CC 1583'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  154F'   C1                    	POP	B
  1550'   21 2E41'              	LXI	H,CMDTAB
  1553'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1556'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1559'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  155A'   CA 0852'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  155D'   CD 15AF'              	CALL	OPSFIX		; where the start is in the window NOW
  1560'   D2 15CB'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1563'   22 0000*              	SHLD	OPSTA
  1566'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1569'   22 0000*              	SHLD	OPEND2
  156C'   3A 0000*              	LDA	PSAVE
  156F'   FE 79                 	CPI	'y'
  1571'   CA 1C85'              	JZ	OPYANK		; a yank takes the span without losing it
  1574'   CD 171E'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1577'   3A 0000*              	LDA	PSAVE
  157A'   FE 63                 	CPI	'c'
  157C'   C0                    	RNZ
  157D'   C3 1A39'              	JMP	SETINS
  1580'                         OPABRT:				; not a motion -> the operator is dropped and
  1580'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1583'                         OPENDS:
  1583'   2A 0000*              	LHLD	OPSTA
  1586'   CD 0678'              	CALL	BOL
  1589'   11 0000*              	LXI	D,OPSLO
  158C'   CD 15A1'              	CALL	OPE_ST
  158F'   2A 0000*              	LHLD	OPSTA
  1592'   CD 070F'              	CALL	NLSTART
  1595'   11 0000*              	LXI	D,OPSHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1598'   CD 15A1'              	CALL	OPE_ST
  159B'   2A 0000*              	LHLD	OPSTA
  159E'   C3 0000*              	JMP	GOTO
  15A1'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  15A1'   D5                    	PUSH	D
  15A2'   CD 0000*              	CALL	GOTO
  15A5'   E1                    	POP	H
  15A6'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  15A9'                         CURBD:
  15A9'   CD 137B'              	CALL	CURFP
  15AC'   EB                    	XCHG
  15AD'   47                    	MOV	B,A
  15AE'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  15AF'                         OPSFIX:
  15AF'   21 0000*              	LXI	H,OPSFP
  15B2'   CD 03DC'              	CALL	MKLOAD
  15B5'   CD 15A9'              	CALL	CURBD
  15B8'   2A 0000*              	LHLD	MKPOS
  15BB'   3A 0002*              	LDA	MKPOS+2
  15BE'   CD 1371'              	CALL	SUB24
  15C1'   B4                    	ORA	H
  15C2'   B5                    	ORA	L
  15C3'   C2 03E9'              	JNZ	MKWIN
  15C6'   CD 0000*              	CALL	CUROFF
  15C9'   37                    	STC
  15CA'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  15CB'                         OPPGD:
  15CB'   47                    	MOV	B,A
  15CC'   3A 0000*              	LDA	OPCLSV
  15CF'   FE 02                 	CPI	2
  15D1'   C2 168D'              	JNZ	OPG_NO
  15D4'   3A 0000*              	LDA	PSAVE
  15D7'   FE 64                 	CPI	'd'
  15D9'   C2 168D'              	JNZ	OPG_NO
  15DC'   04                    	INR	B
  15DD'   CA 15EC'              	JZ	OPG_FW
  15E0'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  15E3'   CD 0678'              	CALL	BOL		;   and the high end is OPSHI as it stands
  15E6'   CD 0000*              	CALL	GOTO
  15E9'   C3 1604'              	JMP	OPG_GO
  15EC'                         OPG_FW:
  15EC'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  15EF'   CD 070F'              	CALL	NLSTART		;   landed on, and the low one is where the
  15F2'   11 0000*              	LXI	D,OPSHI		;   start line began
  15F5'   CD 15A1'              	CALL	OPE_ST
  15F8'   21 0000*              	LXI	H,OPSLO
  15FB'   CD 03DC'              	CALL	MKLOAD
  15FE'   CD 03A9'              	CALL	MKPAGE
  1601'   CD 0000*              	CALL	GOTO
  1604'                         OPG_GO:
  1604'   CD 15A9'              	CALL	CURBD
  1607'   2A 0000*              	LHLD	OPSHI
  160A'   3A 0002*              	LDA	OPSHI+2
  160D'   CD 1371'              	CALL	SUB24		; A:HL = the bytes to take
  1610'                         OPG_SV:
  1610'   22 0000*              	SHLD	OPTOGO
  1613'   32 0002*              	STA	OPTOGO+2
  1616'                         OPG_NX:
  1616'   CD 0759'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1619'   CD 0000*              	CALL	SUBHD
  161C'   EB                    	XCHG			; DE = what the window holds past the cursor
  161D'   2A 0000*              	LHLD	OPTOGO
  1620'   3A 0002*              	LDA	OPTOGO+2
  1623'   B7                    	ORA	A
  1624'   C2 1657'              	JNZ	OPG_PG		; 64K or more to go
  1627'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  162A'   DA 1657'              	JC	OPG_PG
  162D'   CA 1657'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1630'                         OPG_FN:				; the rest of it is here
  1630'   E5                    	PUSH	H
  1631'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1634'   CD 0000*              	CALL	CUROFF
  1637'   22 0000*              	SHLD	OPLO
  163A'   D1                    	POP	D
  163B'   19                    	DAD	D
  163C'   22 0000*              	SHLD	OPHI
  163F'   CD 1851'              	CALL	OPDSPN
  1642'   CD 0BCE'              	CALL	ATEOF
  1645'   D2 16A6'              	JNC	OPMID
  1648'   CD 12AE'              	CALL	ONFST		; deleted to the end of the file: onto the new
  164B'   CA 16A6'              	JZ	OPMID		;   last line, if there is one -- and the pager
  164E'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1651'   CD 0000*              	CALL	SETBWD
  1654'   C3 16A6'              	JMP	OPMID
  1657'                         OPG_PG:
  1657'   7A                    	MOV	A,D
  1658'   B3                    	ORA	E
  1659'   C2 1672'              	JNZ	OPG_DL
  165C'   CD 0BCE'              	CALL	ATEOF		; nothing held past the cursor
  165F'   21 0000               	LXI	H,0
  1662'   DA 1630'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1665'   2B                    	DCX	H
  1666'   CD 0000*              	CALL	SETC0
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1669'   CD 0000*              	CALL	GOLINE
  166C'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  166F'   C3 1616'              	JMP	OPG_NX
  1672'                         OPG_DL:
  1672'   D5                    	PUSH	D
  1673'   21 FFFF               	LXI	H,0FFFFH
  1676'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1679'   E1                    	POP	H
  167A'   E5                    	PUSH	H
  167B'   CD 0000*              	CALL	DELFWD
  167E'   D1                    	POP	D
  167F'   06 00                 	MVI	B,0
  1681'   2A 0000*              	LHLD	OPTOGO
  1684'   3A 0002*              	LDA	OPTOGO+2
  1687'   CD 1371'              	CALL	SUB24
  168A'   C3 1610'              	JMP	OPG_SV
  168D'                         OPG_NO:
  168D'   0E 07                 	MVI	C,BEL
  168F'   CD 0000*              	CALL	BCONOU
  1692'                         OPG_HM:				; the cursor back where the command found it
  1692'   21 0000*              	LXI	H,OPSFP
  1695'   CD 03DC'              	CALL	MKLOAD
  1698'   CD 03A9'              	CALL	MKPAGE
  169B'   CD 0000*              	CALL	GOTO
  169E'   AF                    	XRA	A
  169F'   32 0000*              	STA	PSAVE
  16A2'   3C                    	INR	A
  16A3'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  16A6'                         OPMID:
  16A6'   CD 139E'              	CALL	ZSAVE
  16A9'   C3 1473'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  16AC'                         ONWHIT:
  16AC'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16AF'   CA 16CB'              	JZ	OW_YES
  16B2'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  16B5'   FE 20                 	CPI	' '
  16B7'   CA 16CB'              	JZ	OW_YES
  16BA'   FE 09                 	CPI	TAB
  16BC'   CA 16CB'              	JZ	OW_YES
  16BF'   FE 0D                 	CPI	CR
  16C1'   CA 16CB'              	JZ	OW_YES
  16C4'   FE 0A                 	CPI	LF
  16C6'   CA 16CB'              	JZ	OW_YES
  16C9'   B7                    	ORA	A		; a char to change: CY clear
  16CA'   C9                    	RET
  16CB'                         OW_YES:
  16CB'   37                    	STC
  16CC'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  16CD'                         OPLINE:
  16CD'   3A 0000*              	LDA	PSAVE
  16D0'   FE 63                 	CPI	'c'
  16D2'   CA 0852'              	JZ	SETMOV
  16D5'   FE 79                 	CPI	'y'
  16D7'   CA 1C64'              	JZ	VY_YY
  16DA'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  16DD'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  16E0'   C3 1BDA'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  16E3'                         OPCLS:
  16E3'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  16E5'   CA 16F2'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  16E8'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  16EA'   C2 1706'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  16ED'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  16EF'   C3 16F4'              	JMP	OPC_FK
  16F2'                         OPC_SEM:
  16F2'   06 00                 	MVI	B,0		; ';' runs it as it stands
  16F4'                         OPC_FK:
  16F4'   3A 0000*              	LDA	FNDKND
  16F7'   B7                    	ORA	A
  16F8'   37                    	STC
  16F9'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  16FA'   A8                    	XRA	B		; ... and now the direction ',' asked for
  16FB'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  16FD'   CA 1704'              	JZ	OPC_EXC
  1700'   3E 01                 	MVI	A,1
  1702'   B7                    	ORA	A		; CY clear: a motion, class 1
  1703'   C9                    	RET
  1704'                         OPC_EXC:
  1704'   AF                    	XRA	A		; class 0, CY clear
  1705'   C9                    	RET
  1706'                         OPC_TB:
  1706'   47                    	MOV	B,A
  1707'   21 18F6'              	LXI	H,OPCTAB
  170A'                         OPC_LP:
  170A'   7E                    	MOV	A,M
  170B'   B7                    	ORA	A
  170C'   CA 171C'              	JZ	OPC_MS		; end of table -> not a motion
  170F'   B8                    	CMP	B
  1710'   CA 1718'              	JZ	OPC_HT
  1713'   23                    	INX	H
  1714'   23                    	INX	H
  1715'   C3 170A'              	JMP	OPC_LP
  1718'                         OPC_HT:
  1718'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1719'   7E                    	MOV	A,M		; class byte
  171A'   B7                    	ORA	A		; clear CY
  171B'   C9                    	RET
  171C'                         OPC_MS:
  171C'   37                    	STC
  171D'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  171E'                         OPAPPL:
  171E'   3A 0000*              	LDA	OPCLSV
  1721'   FE 02                 	CPI	2
  1723'   CA 18CA'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1726'   2A 0000*              	LHLD	OPSTA
  1729'   EB                    	XCHG			; DE = start
  172A'   2A 0000*              	LHLD	OPEND2		; HL = end
  172D'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1730'   DA 1743'              	JC	OPA_F
  1733'   CA 1743'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1736'   22 0000*              	SHLD	OPLO
  1739'   EB                    	XCHG
  173A'   22 0000*              	SHLD	OPHI
  173D'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1740'   C3 17FA'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1743'                         OPA_F:
  1743'   EB                    	XCHG			; HL = start, DE = end
  1744'   22 0000*              	SHLD	OPLO
  1747'   EB                    	XCHG			; HL = end
  1748'   3A 0000*              	LDA	OPCLSV
  174B'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  174D'   CA 17F7'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1750'   FE 01                 	CPI	1
  1752'   C2 1774'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  1755'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1756'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  1759'   2B                    	DCX	H		; the line it landed on
  175A'   CD 19B7'              	CALL	CEND		; HL = that line's content end
  175D'   EB                    	XCHG			; DE = it
  175E'   2A 0000*              	LHLD	OPHI		; HL = hi
  1761'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1764'   D2 177F'              	JNC	OPA_HI		; hi is inside the line: keep it
  1767'   2A 0000*              	LHLD	OPLO
  176A'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  176D'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                				;   to where the command started
  1770'   EB                    	XCHG			; HL = the content end: the span stops there
  1771'   C3 177F'              	JMP	OPA_HI
  1774'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1774'   22 0000*              	SHLD	OPHI
  1777'   3A 0000*              	LDA	WPULL
  177A'   B7                    	ORA	A
  177B'   CA 17FA'              	JZ	OPA_C1
  177E'   23                    	INX	H
  177F'                         OPA_HI:
  177F'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1782'                         OPA_DO:
  1782'   CD 1846'              	CALL	OPSPNL
  1785'   7C                    	MOV	A,H
  1786'   B5                    	ORA	L
  1787'   C2 1790'              	JNZ	OPA_D1
  178A'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  178D'   C3 0000*              	JMP	GOTO		;   to where the span starts
  1790'                         OPA_D1:
  1790'   3A 0000*              	LDA	PSAVE
  1793'   FE 63                 	CPI	'c'
  1795'   CA 1851'              	JZ	OPDSPN
  1798'   CD 1839'              	CALL	SPNBRK
  179B'   D2 17BC'              	JNC	OPA_D2
  179E'   2A 0000*              	LHLD	OPHI
  17A1'   CD 19B7'              	CALL	CEND
  17A4'   EB                    	XCHG			; DE = the content end of the line it ends in
  17A5'   2A 0000*              	LHLD	OPHI
  17A8'                         OPA_BL:
  17A8'   CD 0000*              	CALL	CMP16
  17AB'   CA 17C2'              	JZ	OPA_BI		; only blanks after it
  17AE'   D5                    	PUSH	D
  17AF'   E5                    	PUSH	H
  17B0'   CD 0000*              	CALL	CHARAT
  17B3'   E1                    	POP	H
  17B4'   D1                    	POP	D
  17B5'   23                    	INX	H
  17B6'   CD 17F1'              	CALL	BLANKQ
  17B9'   CA 17A8'              	JZ	OPA_BL
  17BC'                         OPA_D2:
  17BC'   CD 1851'              	CALL	OPDSPN
  17BF'   C3 19C8'              	JMP	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17C2'                         OPA_BI:
  17C2'   CD 17D4'              	CALL	LOIND
  17C5'   C2 17BC'              	JNZ	OPA_D2
  17C8'   2A 0000*              	LHLD	OPHI
  17CB'   CD 070F'              	CALL	NLSTART
  17CE'   22 0000*              	SHLD	OPHI
  17D1'   C3 1825'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  17D4'                         LOIND:
  17D4'   2A 0000*              	LHLD	OPLO
  17D7'   CD 0678'              	CALL	BOL
  17DA'                         LI_LP:
  17DA'   E5                    	PUSH	H
  17DB'   EB                    	XCHG
  17DC'   2A 0000*              	LHLD	OPLO
  17DF'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  17E2'   E1                    	POP	H
  17E3'   C8                    	RZ
  17E4'   E5                    	PUSH	H
  17E5'   CD 0000*              	CALL	CHARAT
  17E8'   E1                    	POP	H
  17E9'   23                    	INX	H
  17EA'   CD 17F1'              	CALL	BLANKQ
  17ED'   CA 17DA'              	JZ	LI_LP
  17F0'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  17F1'                         BLANKQ:
  17F1'   FE 20                 	CPI	' '
  17F3'   C8                    	RZ
  17F4'   FE 09                 	CPI	TAB
  17F6'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  17F7'                         OPA_JP:
  17F7'   22 0000*              	SHLD	OPHI
  17FA'                         OPA_C1:
  17FA'   CD 1846'              	CALL	OPSPNL
  17FD'   7C                    	MOV	A,H
  17FE'   B5                    	ORA	L
  17FF'   CA 1782'              	JZ	OPA_DO		; nothing spanned
  1802'   2A 0000*              	LHLD	OPHI
  1805'   CD 0678'              	CALL	BOL
  1808'   EB                    	XCHG
  1809'   2A 0000*              	LHLD	OPHI
  180C'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  180F'   C2 1782'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1812'   CD 17D4'              	CALL	LOIND
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1815'   CA 1825'              	JZ	C1_LW		; only blanks before lo: whole lines
  1818'                         C1_CH:
  1818'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  181B'   2B                    	DCX	H		;   of the line before
  181C'   CD 19B7'              	CALL	CEND
  181F'   22 0000*              	SHLD	OPHI
  1822'   C3 1782'              	JMP	OPA_DO
  1825'                         C1_LW:
  1825'   2A 0000*              	LHLD	OPLO
  1828'   CD 0678'              	CALL	BOL
  182B'   22 0000*              	SHLD	OPLO
  182E'   3A 0000*              	LDA	PSAVE
  1831'   FE 63                 	CPI	'c'
  1833'   CA 1818'              	JZ	C1_CH
  1836'   C3 18DD'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1839'                         SPNBRK:
  1839'   2A 0000*              	LHLD	OPLO
  183C'   CD 06BB'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  183F'   EB                    	XCHG			; DE = it
  1840'   2A 0000*              	LHLD	OPHI
  1843'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1846'                         OPSPNL:
  1846'   2A 0000*              	LHLD	OPHI
  1849'   EB                    	XCHG
  184A'   2A 0000*              	LHLD	OPLO
  184D'   EB                    	XCHG			; HL = hi, DE = lo
  184E'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  1851'                         OPDSPN:
  1851'   CD 1839'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1854'   F5                    	PUSH	PSW
  1855'   2A 0000*              	LHLD	OPSTA
  1858'   EB                    	XCHG
  1859'   2A 0000*              	LHLD	OPLO
  185C'   22 0000*              	SHLD	WKI
  185F'   CD 0000*              	CALL	CMP16
  1862'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  1863'   CD 0000*              	CALL	GOTO
  1866'   CD 1846'              	CALL	OPSPNL		; HL = hi - lo
  1869'   CD 0858'              	CALL	SETLIN
  186C'   F1                    	POP	PSW
  186D'   CC 1986'              	CZ	DCHQ
  1870'   CD 0000*              	CALL	DELFWD
  1873'   CD 0174'              	CALL	MARKMOD
  1876'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  1877'   D0                    	RNC
  1878'   C3 088F'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  187B'                         UNDFNB:
  187B'   CD 0000*              	CALL	CUROFF
  187E'   E5                    	PUSH	H
  187F'   CD 094B'              	CALL	FNBLNK
  1882'   CD 0000*              	CALL	CUROFF
  1885'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  1886'   CD 0000*              	CALL	CMP16
  1889'   D2 0000*              	JNC	UNDHER
  188C'   EB                    	XCHG
  188D'   CD 0000*              	CALL	GOTO
  1890'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1893'                         OPALSP:
  1893'   2A 0000*              	LHLD	OPSTA
  1896'   EB                    	XCHG
  1897'   2A 0000*              	LHLD	OPEND2
  189A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  189D'   DA 18AD'              	JC	OPAL_F
  18A0'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  18A3'   EB                    	XCHG
  18A4'   22 0000*              	SHLD	OPHI		; hi-src = start
  18A7'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  18AA'   C3 18B7'              	JMP	OPAL_R
  18AD'                         OPAL_F:
  18AD'   EB                    	XCHG			; HL = start
  18AE'   22 0000*              	SHLD	OPLO		; lo-src = start
  18B1'   2A 0000*              	LHLD	OPEND2
  18B4'   22 0000*              	SHLD	OPHI		; hi-src = end
  18B7'                         OPAL_R:
  18B7'   2A 0000*              	LHLD	OPLO
  18BA'   CD 0678'              	CALL	BOL
  18BD'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  18C0'   2A 0000*              	LHLD	OPHI
  18C3'   CD 070F'              	CALL	NLSTART
  18C6'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  18C9'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  18CA'                         OPALIN:
  18CA'   CD 1893'              	CALL	OPALSP
  18CD'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  18D0'   CD 070F'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  18D3'   EB                    	XCHG			;   the column)
  18D4'   2A 0000*              	LHLD	OPHI
  18D7'   CD 0000*              	CALL	CMP16
  18DA'   CC 187B'              	CZ	UNDFNB
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  18DD'                         OPDLIN:
  18DD'   CD 1851'              	CALL	OPDSPN
  18E0'   CD 0759'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  18E3'   DA 18F3'              	JC	OPDL_NB
  18E6'   CD 0000*              	CALL	LOGLEN
  18E9'   7C                    	MOV	A,H
  18EA'   B5                    	ORA	L
  18EB'   C8                    	RZ			; empty buffer
  18EC'   2B                    	DCX	H
  18ED'   CD 0678'              	CALL	BOL
  18F0'   CD 0000*              	CALL	GOTO
  18F3'                         OPDL_NB:
  18F3'   C3 094B'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  18F6'                         OPCTAB:
  18F6'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  18FA'   62 00 42 00           
  18FE'   68 00 6C 00           
  1902'   30 00 5E 00           
  1906'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1908'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  190C'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1910'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1914'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1918'   24 01                 
  191A'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  191E'   47 02 48 02           
  1922'   4D 02 4C 02           
  1926'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  1928'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  192A'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  192B'                         VCB_C:
  192B'   CD 1937'              	CALL	VCB_CD
  192E'   C3 1A39'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1931'                         VCB_D:
  1931'   CD 1937'              	CALL	VCB_CD
  1934'   C3 19C8'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1937'                         VCB_CD:
  1937'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  193A'   22 0000*              	SHLD	OPLO
  193D'   22 0000*              	SHLD	OPSTA
  1940'   CD 0000*              	CALL	CUROFF
  1943'   CD 19B7'              	CALL	CEND		; to the line's content end, the CR,LF left
  1946'   22 0000*              	SHLD	OPHI
  1949'   C3 1851'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  194C'                         VC_X:
  194C'   CD 09FD'              	CALL	GLSTAL
  194F'   CD 0858'              	CALL	SETLIN
  1952'   CD 077D'              	CALL	GETCNT
  1955'   22 0000*              	SHLD	CNTV
  1958'   CD 0000*              	CALL	CUROFF
  195B'   22 0000*              	SHLD	WKI		; cur
  195E'   CD 19B7'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1961'   EB                    	XCHG			; DE = contentend
  1962'   2A 0000*              	LHLD	WKI		; HL = cur
  1965'   EB                    	XCHG			; HL = contentend, DE = cur
  1966'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1969'   7C                    	MOV	A,H
  196A'   B5                    	ORA	L
  196B'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  196C'   EB                    	XCHG			; DE = available
  196D'   2A 0000*              	LHLD	CNTV		; HL = count
  1970'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1973'   DA 1979'              	JC	VX_USEA
  1976'   C3 197A'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1979'                         VX_USEA:
  1979'   EB                    	XCHG			; HL = available
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  197A'                         VX_DEL:
  197A'   CD 1986'              	CALL	DCHQ
  197D'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1980'   CD 0174'              	CALL	MARKMOD
  1983'   C3 19C8'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  1986'                         DCHQ:
  1986'   E5                    	PUSH	H
  1987'   CD 0895'              	CALL	TAILTAB
  198A'   E1                    	POP	H
  198B'   47                    	MOV	B,A
  198C'   7C                    	MOV	A,H		; (more of them than a byte counts)
  198D'   B7                    	ORA	A
  198E'   C0                    	RNZ
  198F'   B5                    	ORA	L
  1990'   C8                    	RZ			; (or none at all)
  1991'   32 2EFA'              	STA	DCHN
  1994'   78                    	MOV	A,B
  1995'   87                    	ADD	A
  1996'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1999'   CA 19B1'              	JZ	DQ_0
  199C'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  199D'   FE 08                 	CPI	8
  199F'   D0                    	RNC
  19A0'   E5                    	PUSH	H
  19A1'   2A 0000*              	LHLD	WKI
  19A4'   EB                    	XCHG
  19A5'   2A 0000*              	LHLD	TTI
  19A8'   CD 0000*              	CALL	SUBHD
  19AB'   EB                    	XCHG			; DE = the chars before it
  19AC'   E1                    	POP	H
  19AD'   CD 0000*              	CALL	CMP16
  19B0'   D8                    	RC
  19B1'                         DQ_0:
  19B1'   3E 07                 	MVI	A,R_DCH
  19B3'   32 0000*              	STA	RINTENT
  19B6'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  19B7'                         CEND:
  19B7'   CD 06BB'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  19BA'   7C                    	MOV	A,H
  19BB'   B5                    	ORA	L
  19BC'   C8                    	RZ			; the start of the text: nothing before it
  19BD'   2B                    	DCX	H
  19BE'   E5                    	PUSH	H
  19BF'   CD 0000*              	CALL	CHARAT
  19C2'   E1                    	POP	H		; HL = term-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19C3'   FE 0D                 	CPI	CR
  19C5'   C8                    	RZ			; a CR before the LF -> the content ends there
  19C6'   23                    	INX	H
  19C7'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  19C8'                         CLAMPE:
  19C8'   CD 0000*              	CALL	CUROFF
  19CB'   E5                    	PUSH	H
  19CC'   CD 071E'              	CALL	EOLC
  19CF'   D1                    	POP	D		; DE = cur
  19D0'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  19D3'   D8                    	RC
  19D4'   C8                    	RZ
  19D5'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  19D8'                         VC_I:
  19D8'   CD 077D'              	CALL	GETCNT
  19DB'   C3 1A36'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  19DE'                         VC_A:
  19DE'   CD 077D'              	CALL	GETCNT
  19E1'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19E4'   CA 19FB'              	JZ	VA_INS
  19E7'   EB                    	XCHG			; HL = cur
  19E8'   E5                    	PUSH	H
  19E9'   CD 0000*              	CALL	CHARAT
  19EC'   E1                    	POP	H
  19ED'   FE 0A                 	CPI	LF
  19EF'   CA 19FB'              	JZ	VA_INS		; on the line terminator -> append in place
  19F2'   FE 0D                 	CPI	CR
  19F4'   CA 19FB'              	JZ	VA_INS
  19F7'   23                    	INX	H
  19F8'   CD 0000*              	CALL	GOTO
  19FB'                         VA_INS:
  19FB'   C3 1A36'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  19FE'                         VCB_A:
  19FE'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A01'   CD 071E'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A04'   E5                    	PUSH	H
  1A05'   CD 0000*              	CALL	CHARAT
  1A08'   E1                    	POP	H
  1A09'   FE 0D                 	CPI	CR
  1A0B'   CA 1A14'              	JZ	VBA_IN		; an empty line: insert at its start
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A0E'   FE 0A                 	CPI	LF
  1A10'   CA 1A14'              	JZ	VBA_IN
  1A13'   23                    	INX	H		; past the last content char
  1A14'                         VBA_IN:
  1A14'   CD 0000*              	CALL	GOTO
  1A17'   C3 1A36'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A1A'                         VCB_I:
  1A1A'   CD 077D'              	CALL	GETCNT
  1A1D'   CD 094B'              	CALL	FNBLNK
  1A20'   CD 0000*              	CALL	CUROFF
  1A23'   E5                    	PUSH	H
  1A24'   CD 0000*              	CALL	CHARAT
  1A27'   E1                    	POP	H
  1A28'   FE 20                 	CPI	' '
  1A2A'   CA 1A32'              	JZ	VBI_SK
  1A2D'   FE 09                 	CPI	TAB
  1A2F'   C2 1A36'              	JNZ	SETINM
  1A32'                         VBI_SK:
  1A32'   23                    	INX	H		; blanks only: past the last of them
  1A33'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1A36'                         SETINM:
  1A36'   CD 0852'              	CALL	SETMOV
  1A39'                         SETINS:
  1A39'   3E 01                 	MVI	A,EM_INS
  1A3B'   32 0000*              	STA	EDMODE
  1A3E'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1A3F'                         ATCEND:
  1A3F'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A42'   C8                    	RZ
  1A43'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1A46'   FE 0D                 	CPI	CR
  1A48'   C8                    	RZ
  1A49'   FE 0A                 	CPI	LF
  1A4B'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1A4C'                         OPNBRK:
  1A4C'   CD 2376'              	CALL	PUTBRK
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A4F'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1A52'   23                    	INX	H
  1A53'   22 0000*              	SHLD	LNDLT
  1A56'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1A59'                         ENDBRK:
  1A59'   CD 0759'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1A5C'   C0                    	RNZ
  1A5D'   CD 1A4C'              	CALL	OPNBRK
  1A60'   CD 0000*              	CALL	CUROFF
  1A63'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1A64'   2B                    	DCX	H		;   line, with its own terminator after it
  1A65'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1A68'                         VC_O:
  1A68'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A6B'   CD 19B7'              	CALL	CEND
  1A6E'   CD 0000*              	CALL	GOTO
  1A71'   CD 1A4C'              	CALL	OPNBRK
  1A74'   CD 1A59'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1A77'   CD 087A'              	CALL	SETILN		;   needs a terminator of its own to exist
  1A7A'   C3 1A39'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1A7D'                         VCB_O:
  1A7D'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A80'   CD 0678'              	CALL	BOL
  1A83'   CD 0000*              	CALL	GOTO
  1A86'   CD 1A4C'              	CALL	OPNBRK
  1A89'   CD 0000*              	CALL	CUROFF
  1A8C'   2B                    	DCX	H
  1A8D'   2B                    	DCX	H
  1A8E'   CD 0000*              	CALL	GOTO
  1A91'   CD 087A'              	CALL	SETILN
  1A94'   C3 1A39'              	JMP	SETINS
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1A97'                         VCB_J:
  1A97'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A9A'   CD 19B7'              	CALL	CEND		; the join point: this line's content end
  1A9D'   22 0000*              	SHLD	OPLO
  1AA0'   CD 0000*              	CALL	CUROFF
  1AA3'   CD 070F'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1AA6'   E5                    	PUSH	H
  1AA7'   CD 0000*              	CALL	LOGLEN
  1AAA'   D1                    	POP	D		; DE = that start
  1AAB'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1AAE'   CA 0852'              	JZ	SETMOV
  1AB1'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1AB2'                         VJ_WS:
  1AB2'   E5                    	PUSH	H
  1AB3'   CD 0000*              	CALL	LOGLEN
  1AB6'   D1                    	POP	D		; DE = the scan
  1AB7'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1ABA'   CA 1AD1'              	JZ	VJ_DEL
  1ABD'   EB                    	XCHG			; HL = the scan
  1ABE'   E5                    	PUSH	H
  1ABF'   CD 0000*              	CALL	CHARAT
  1AC2'   E1                    	POP	H
  1AC3'   FE 20                 	CPI	' '
  1AC5'   CA 1ACD'              	JZ	VJ_SKIP
  1AC8'   FE 09                 	CPI	TAB
  1ACA'   C2 1AD1'              	JNZ	VJ_DEL
  1ACD'                         VJ_SKIP:
  1ACD'   23                    	INX	H
  1ACE'   C3 1AB2'              	JMP	VJ_WS
  1AD1'                         VJ_DEL:
  1AD1'   22 0000*              	SHLD	OPHI
  1AD4'   CD 1851'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1AD7'   CD 0889'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1ADA'   CD 0759'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1ADD'   CA 19C8'              	JZ	CLAMPE
  1AE0'   CD 0764'              	CALL	CURCHR		; the first char of what was appended
  1AE3'   FE 0D                 	CPI	CR
  1AE5'   CA 19C8'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1AE8'   FE 0A                 	CPI	LF
  1AEA'   CA 19C8'              	JZ	CLAMPE
  1AED'   FE 29                 	CPI	')'
  1AEF'   CA 19C8'              	JZ	CLAMPE		; vim puts no space before a ')'
  1AF2'   CD 0000*              	CALL	CUROFF
  1AF5'   7C                    	MOV	A,H
  1AF6'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AF7'   CA 1B0D'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1AFA'   2B                    	DCX	H
  1AFB'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1AFE'   FE 20                 	CPI	' '
  1B00'   CA 19C8'              	JZ	CLAMPE
  1B03'   FE 09                 	CPI	TAB
  1B05'   CA 19C8'              	JZ	CLAMPE
  1B08'   FE 0A                 	CPI	LF
  1B0A'   CA 19C8'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B0D'                         VJ_SP:
  1B0D'   3E 20                 	MVI	A,' '
  1B0F'   CD 0000*              	CALL	PUTGAP
  1B12'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B15'   2B                    	DCX	H
  1B16'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B19'                         VC_TILD:
  1B19'   CD 077D'              	CALL	GETCNT
  1B1C'   CD 0858'              	CALL	SETLIN		; only this row changes
  1B1F'   CD 09FD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B22'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B25'   CA 0852'              	JZ	SETMOV
  1B28'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1B2B'   FE 0D                 	CPI	CR
  1B2D'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B30'   FE 0A                 	CPI	LF
  1B32'   CA 0852'              	JZ	SETMOV
  1B35'   47                    	MOV	B,A
  1B36'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1B38'   FE 41                 	CPI	'A'
  1B3A'   DA 1B46'              	JC	VT_PUT		; below 'A': no case
  1B3D'   FE 5B                 	CPI	'Z'+1
  1B3F'   D2 1B46'              	JNC	VT_PUT		; above 'Z': no case
  1B42'   78                    	MOV	A,B
  1B43'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1B45'   47                    	MOV	B,A
  1B46'                         VT_PUT:
  1B46'   78                    	MOV	A,B
  1B47'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1B4A'   CD 0174'              	CALL	MARKMOD
  1B4D'   21 0001               	LXI	H,1
  1B50'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B53'   3A 0000*              	LDA	VRCH
  1B56'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1B59'   C3 19C8'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B5C'                         VC_R:
  1B5C'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  1B5F'   3E 03                 	MVI	A,PR
  1B61'   32 0000*              	STA	GPEND
  1B64'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1B65'                         VR_DO:
  1B65'   AF                    	XRA	A
  1B66'   32 0000*              	STA	GPEND
  1B69'   79                    	MOV	A,C
  1B6A'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1B6D'   CD 0858'              	CALL	SETLIN		; only this row changed
  1B70'   CD 09FD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B73'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B76'   CA 0852'              	JZ	SETMOV		; the end of the text: vim does nothing
  1B79'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1B7C'   FE 0D                 	CPI	CR
  1B7E'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to replace
  1B81'   FE 0A                 	CPI	LF
  1B83'   CA 0852'              	JZ	SETMOV
  1B86'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1B88'   CD 085E'              	CALL	SETCEL
  1B8B'   CD 0174'              	CALL	MARKMOD
  1B8E'   21 0001               	LXI	H,1
  1B91'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B94'   3A 0000*              	LDA	VRCH
  1B97'   FE 0D                 	CPI	CR
  1B99'   CA 1BA6'              	JZ	VR_CR
  1B9C'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1B9F'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1BA2'   2B                    	DCX	H		;   out, which moves every logical offset
  1BA3'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1BA6'                         VR_CR:
  1BA6'   CD 1A4C'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1BA9'   CD 1A59'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1BAC'   CD 087A'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1BAF'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1BB1'   32 0000*              	STA	ILABOV
  1BB4'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1BB5'                         VCB_R:
  1BB5'   CD 077D'              	CALL	GETCNT
  1BB8'   CD 0852'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1BBB'   21 0000               	LXI	H,0
  1BBE'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1BC1'   22 0000*              	SHLD	RPAPP
  1BC4'   3E 02                 	MVI	A,EM_REP
  1BC6'   32 0000*              	STA	EDMODE
  1BC9'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1BCA'                         VC_D:
  1BCA'   3E 64                 	MVI	A,'d'
  1BCC'   32 0000*              	STA	PENDOP
  1BCF'   C3 0852'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1BD2'                         VC_C:
  1BD2'   3E 63                 	MVI	A,'c'
  1BD4'   32 0000*              	STA	PENDOP
  1BD7'   C3 0852'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1BDA'                         VD_DD:
  1BDA'   CD 09FD'              	CALL	GLSTAL
  1BDD'   CD 077D'              	CALL	GETCNT
  1BE0'   22 0000*              	SHLD	CNTV
  1BE3'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1BE5'   32 0000*              	STA	DDSNG
  1BE8'   2B                    	DCX	H
  1BE9'   7C                    	MOV	A,H
  1BEA'   B5                    	ORA	L
  1BEB'   C2 1BF9'              	JNZ	VDD_LS
  1BEE'   3E 01                 	MVI	A,1
  1BF0'   32 0000*              	STA	DDSNG
  1BF3'   CD 187B'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1BF6'   C3 1BFF'              	JMP	VDD_GO
  1BF9'                         VDD_LS:
  1BF9'   CD 09B6'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1BFC'   DA 0852'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1BFF'                         VDD_GO:
  1BFF'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C02'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C05'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C08'   CD 25D9'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C0B'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C0E'   2A 0000*              	LHLD	CNTV
  1C11'   CD 0000*              	CALL	SETC0
  1C14'                         VDD_FW:
  1C14'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C17'   DA 1D65'              	JC	QREFUS		; ... which has no room for them
  1C1A'   CD 0792'              	CALL	CNTTST
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C1D'   C2 1C14'              	JNZ	VDD_FW
  1C20'   CD 0174'              	CALL	MARKMOD
  1C23'   CD 0BCE'              	CALL	ATEOF
  1C26'   D2 1C41'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C29'   3E 00                 	MVI	A,0
  1C2B'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1C2E'   CD 12AE'              	CALL	ONFST
  1C31'   CA 094B'              	JZ	FNBLNK		; nothing left before it
  1C34'   21 0001               	LXI	H,1		; onto the new last line
  1C37'   CD 0000*              	CALL	SETBWD
  1C3A'   2A 0000*              	LHLD	LNDLT
  1C3D'   2B                    	DCX	H
  1C3E'   22 0000*              	SHLD	LNDLT
  1C41'                         VDD_UP:
  1C41'   CD 094B'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1C44'   3A 0000*              	LDA	DDSNG
  1C47'   B7                    	ORA	A
  1C48'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1C49'   3E 03                 	MVI	A,R_DLIN
  1C4B'   32 0000*              	STA	RINTENT
  1C4E'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1C4F'                         QEMPTY:
  1C4F'   2A 0000*              	LHLD	QBEG
  1C52'   EB                    	XCHG
  1C53'   2A 0000*              	LHLD	QEND
  1C56'   7C                    	MOV	A,H
  1C57'   BA                    	CMP	D
  1C58'   C0                    	RNZ
  1C59'   7D                    	MOV	A,L
  1C5A'   BB                    	CMP	E
  1C5B'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1C5C'                         VC_Y:
  1C5C'   3E 79                 	MVI	A,'y'
  1C5E'   32 0000*              	STA	PENDOP
  1C61'   C3 0852'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1C64'                         VY_YY:
  1C64'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1C67'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1C6A'   CD 0000*              	CALL	CUROFF
  1C6D'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1C70'   CD 0678'              	CALL	BOL
  1C73'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1C76'   CD 1DCB'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C79'   CD 1E0E'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1C7C'   D2 1DD2'              	JNC	YNDONE
  1C7F'   21 1BDA'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1C82'   C3 1CAE'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1C85'                         OPYANK:
  1C85'   CD 1893'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1C88'   2A 0000*              	LHLD	OPSTA
  1C8B'   EB                    	XCHG			; DE = start
  1C8C'   2A 0000*              	LHLD	OPEND2		; HL = end
  1C8F'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1C92'   D2 1C96'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1C95'   EB                    	XCHG			; ... otherwise the start is
  1C96'                         OPY_LO:
  1C96'   22 0000*              	SHLD	YOFF
  1C99'   2A 0000*              	LHLD	OPLO
  1C9C'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1C9F'   CD 1DCB'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CA2'   CD 1E86'              	CALL	YNSPAN		; copied where they lie, if there is room
  1CA5'   D2 1DD2'              	JNC	YNDONE
  1CA8'   21 1D8C'              	LXI	H,YSPAN
  1CAB'   C3 1CAE'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1CAE'                         YKGO:
  1CAE'   22 0000*              	SHLD	YACT
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CB1'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1CB4'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1CB5'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1CB8'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1CBB'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1CBE'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1CC1'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1CC2'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1CC5'   EB                    	XCHG			;   window as it was, then names other text
  1CC6'   E1                    	POP	H
  1CC7'   CD 0000*              	CALL	SUBHD
  1CCA'   EB                    	XCHG			; DE = how far behind the cursor they start
  1CCB'   CD 137B'              	CALL	CURFP
  1CCE'   06 00                 	MVI	B,0
  1CD0'   CD 1371'              	CALL	SUB24
  1CD3'   22 0000*              	SHLD	YPFP
  1CD6'   32 0002*              	STA	YPFP+2
  1CD9'   3A 0000*              	LDA	MODF
  1CDC'   32 0000*              	STA	YMODF
  1CDF'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1CE2'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1CE5'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1CE8'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1CEB'   3E 01                 	MVI	A,1
  1CED'   32 0000*              	STA	UNDRPL
  1CF0'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1CF3'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1CF6'   22 0000*              	SHLD	YLDLT
  1CF9'   CD 0000*              	CALL	LOGLEN
  1CFC'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1CFF'   2A 0000*              	LHLD	YACT
  1D02'   CD 1D64'              	CALL	YCALL		; the lines out of the file, into the register
  1D05'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D08'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D0A'   CA 1D48'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D0D'   CD 0000*              	CALL	LOGLEN
  1D10'   EB                    	XCHG
  1D11'   2A 0000*              	LHLD	YWAS
  1D14'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D17'   CA 1D29'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D1A'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D1D'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D20'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D23'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D26'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D29'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D29'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D2C'   EB                    	XCHG
  1D2D'   2A 0000*              	LHLD	YCOL
  1D30'   19                    	DAD	D
  1D31'   22 0000*              	SHLD	MKPOS
  1D34'   3A 0002*              	LDA	YPFP+2
  1D37'   CE 00                 	ACI	0
  1D39'   32 0002*              	STA	MKPOS+2
  1D3C'   CD 03A9'              	CALL	MKPAGE
  1D3F'   CD 0000*              	CALL	GOTO
  1D42'                         YK_RST:
  1D42'   2A 0000*              	LHLD	YLDLT
  1D45'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1D48'                         YK_RF:
  1D48'   3A 0000*              	LDA	YMODF
  1D4B'   32 0000*              	STA	MODF
  1D4E'   3A 0000*              	LDA	YDCHG
  1D51'   32 0000*              	STA	DOTCHG
  1D54'   3A 0000*              	LDA	YURPL
  1D57'   32 0000*              	STA	UNDRPL
  1D5A'   AF                    	XRA	A
  1D5B'   32 0000*              	STA	MKHOLD
  1D5E'   CD 09FD'              	CALL	GLSTAL
  1D61'   C3 088F'              	JMP	SETFUL		; the cheap paint cannot carry this
  1D64'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1D65'                         QREFUS:
  1D65'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1D68'   CD 1C4F'              	CALL	QEMPTY
  1D6B'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1D6E'   CD 0000*              	CALL	QKILL
  1D71'   3A 0000*              	LDA	MKHOLD
  1D74'   B7                    	ORA	A
  1D75'   C2 1D84'              	JNZ	QRF_Y
  1D78'   21 0000*              	LXI	H,MKSAV
  1D7B'   11 0000*              	LXI	D,MKTAB
  1D7E'   CD 25D9'              	CALL	COPY12
  1D81'   CD 0000*              	CALL	UNDCLR
  1D84'                         QRF_Y:
  1D84'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1D86'   32 0000*              	STA	MSGWHT
  1D89'   C3 1692'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1D8C'                         YSPAN:
  1D8C'   CD 09FD'              	CALL	GLSTAL
  1D8F'   CD 1846'              	CALL	OPSPNL		; HL = the span's length
  1D92'   22 0000*              	SHLD	YTGT
  1D95'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1D98'   EB                    	XCHG			; DE = it
  1D99'   2A 0000*              	LHLD	YTGT
  1D9C'   EB                    	XCHG			; HL = the text's, DE = the span's
  1D9D'   CD 0000*              	CALL	SUBHD
  1DA0'   22 0000*              	SHLD	YTGT		; what the text is left at when the span is out
  1DA3'   2A 0000*              	LHLD	OPLO
  1DA6'   CD 0000*              	CALL	GOTO
  1DA9'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1DAC'                         YS_LP:
  1DAC'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1DAF'   CD 0000*              	CALL	SETC0
  1DB2'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1DB5'   DA 1D65'              	JC	QREFUS		; ... which has no room for it
  1DB8'   CD 0000*              	CALL	LOGLEN
  1DBB'   EB                    	XCHG			; DE = what is left
  1DBC'   2A 0000*              	LHLD	YTGT
  1DBF'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1DC2'   DA 1DC8'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1DC5'   C2 1DAC'              	JNZ	YS_LP		;   but never spin here if it ever did
  1DC8'                         YS_END:
  1DC8'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1DCB'                         YNPRE:
  1DCB'   2A 0000*              	LHLD	PGTOPM
  1DCE'   22 0000*              	SHLD	YNPG
  1DD1'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1DD2'                         YNDONE:
  1DD2'   2A 0000*              	LHLD	YOFF
  1DD5'   CD 0000*              	CALL	GOTO
  1DD8'   2A 0000*              	LHLD	PGTOPM
  1DDB'   EB                    	XCHG
  1DDC'   2A 0000*              	LHLD	YNPG
  1DDF'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1DE2'   C2 088F'              	JNZ	SETFUL		; it moved under us: repaint after all
  1DE5'   C3 0852'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1DE8'                         YNROOM:
  1DE8'   11 0100               	LXI	D,100H
  1DEB'   19                    	DAD	D
  1DEC'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1DED'   E5                    	PUSH	H		; the span plus its slack
  1DEE'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1DF1'   EB                    	XCHG			; HL = free
  1DF2'   D1                    	POP	D		; DE = the span plus its slack
  1DF3'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1DF6'   DA 1DFE'              	JC	YNR_OK
  1DF9'   CA 1DFE'              	JZ	YNR_OK
  1DFC'   37                    	STC			; not enough: the delete-and-put-back path
  1DFD'   C9                    	RET
  1DFE'                         YNR_OK:
  1DFE'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1DFF'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1E00'                         YNGO:
  1E00'   C5                    	PUSH	B
  1E01'   CD 077D'              	CALL	GETCNT		; spent here: this yank is happening
  1E04'   CD 09FD'              	CALL	GLSTAL
  1E07'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E0A'   C1                    	POP	B
  1E0B'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1E0E'                         YNCOPY:
  1E0E'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1E11'   7C                    	MOV	A,H		;   the count itself
  1E12'   B5                    	ORA	L
  1E13'   C2 1E19'              	JNZ	YNC_HV
  1E16'   21 0001               	LXI	H,1
  1E19'                         YNC_HV:
  1E19'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1E1A'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1E1B'   B4                    	ORA	H
  1E1C'   CA 1E27'              	JZ	YNC_M
  1E1F'   E5                    	PUSH	H
  1E20'   CD 09B6'              	CALL	ONLAST		; vim: a count over one on the last line does
  1E23'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1E24'   DA 1E39'              	JC	YNC_RF
  1E27'                         YNC_M:
  1E27'   E5                    	PUSH	H
  1E28'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1E2B'   E1                    	POP	H
  1E2C'   CD 1E41'              	CALL	YNLINE		; BC = the span, measured where it stands
  1E2F'   D8                    	RC			; not measurable here: let the pager answer it
  1E30'   60                    	MOV	H,B
  1E31'   69                    	MOV	L,C
  1E32'   CD 1DE8'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1E35'   D8                    	RC			; no: the delete-and-put-back path
  1E36'   C3 1E00'              	JMP	YNGO
  1E39'                         YNC_RF:
  1E39'   CD 077D'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1E3C'   CD 09FD'              	CALL	GLSTAL		;   register alone, and that is the command
  1E3F'   B7                    	ORA	A		; NC: done
  1E40'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1E41'                         YNLINE:
  1E41'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1E44'   2A 0000*              	LHLD	GAPEND
  1E47'                         YNL_LP:
  1E47'   EB                    	XCHG			; DE = the scan
  1E48'   2A 0000*              	LHLD	TXTEND
  1E4B'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1E4E'   EB                    	XCHG			; HL = the scan
  1E4F'   D2 1E6F'              	JNC	YNL_EN		; the resident text ran out
  1E52'   7E                    	MOV	A,M
  1E53'   23                    	INX	H
  1E54'   FE 0A                 	CPI	LF
  1E56'   C2 1E47'              	JNZ	YNL_LP
  1E59'   E5                    	PUSH	H
  1E5A'   2A 0000*              	LHLD	YNCNT
  1E5D'   2B                    	DCX	H
  1E5E'   22 0000*              	SHLD	YNCNT
  1E61'   7C                    	MOV	A,H
  1E62'   B5                    	ORA	L
  1E63'   E1                    	POP	H
  1E64'   C2 1E47'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1E67'   EB                    	XCHG			; DE = past the last of them
  1E68'   2A 0000*              	LHLD	GAPEND
  1E6B'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1E6C'   C3 1E7D'              	JMP	YNL_BC
  1E6F'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1E6F'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1E72'   C2 1E84'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1E75'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1E78'   EB                    	XCHG			;   count clamps to it as vim's does
  1E79'   2A 0000*              	LHLD	GAPEND
  1E7C'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1E7D'                         YNL_BC:
  1E7D'   CD 0000*              	CALL	SUBHD		; HL = the span
  1E80'   44                    	MOV	B,H
  1E81'   4D                    	MOV	C,L
  1E82'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1E83'   C9                    	RET
  1E84'                         YNL_NO:
  1E84'   37                    	STC
  1E85'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1E86'                         YNSPAN:
  1E86'   CD 1846'              	CALL	OPSPNL		; HL = the span's length
  1E89'   44                    	MOV	B,H
  1E8A'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1E8B'   CD 1DE8'              	CALL	YNROOM
  1E8E'   D8                    	RC			; no room: the delete-and-put-back path
  1E8F'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E90'   2A 0000*              	LHLD	OPLO
  1E93'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1E96'   C1                    	POP	B
  1E97'   C3 1E00'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1E9A'                         VC_P:
  1E9A'   CD 1C4F'              	CALL	QEMPTY
  1E9D'   CA 1F70'              	JZ	VP_BEL
  1EA0'   CD 077D'              	CALL	GETCNT
  1EA3'   22 0000*              	SHLD	PCNT
  1EA6'   CD 0000*              	CALL	CUROFF
  1EA9'   CD 070F'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1EAC'   C3 1EC1'              	JMP	VP_GO
  1EAF'                         VCB_P:
  1EAF'   CD 1C4F'              	CALL	QEMPTY
  1EB2'   CA 1F70'              	JZ	VP_BEL
  1EB5'   CD 077D'              	CALL	GETCNT
  1EB8'   22 0000*              	SHLD	PCNT
  1EBB'   CD 0000*              	CALL	CUROFF
  1EBE'   CD 0678'              	CALL	BOL
  1EC1'                         VP_GO:
  1EC1'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1EC4'   CD 0000*              	CALL	CUROFF
  1EC7'   EB                    	XCHG
  1EC8'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1ECB'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1ECE'   DA 1EE3'              	JC	VP_IN
  1ED1'   EB                    	XCHG			; HL = the put point = LOGLEN
  1ED2'   7C                    	MOV	A,H
  1ED3'   B5                    	ORA	L
  1ED4'   CA 1EE0'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1ED7'   2B                    	DCX	H
  1ED8'   CD 0000*              	CALL	CHARAT
  1EDB'   FE 0A                 	CPI	LF
  1EDD'   CA 1EE3'              	JZ	VP_IN
  1EE0'                         VP_BRK:
  1EE0'   CD 1A4C'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1EE3'                         VP_IN:
  1EE3'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1EE6'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1EE9'   CD 13C4'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1EEC'   2A 0000*              	LHLD	QBEG
  1EEF'   EB                    	XCHG
  1EF0'   2A 0000*              	LHLD	QEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1EF3'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1EF6'   EB                    	XCHG
  1EF7'   22 0000*              	SHLD	PLFS
  1EFA'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1EFD'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1EFE'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1EFF'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1F01'   C2 1F05'              	JNZ	VP_PZ
  1F04'   7D                    	MOV	A,L
  1F05'                         VP_PZ:
  1F05'   32 0000*              	STA	PCPY
  1F08'                         VP_LP:
  1F08'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1F0B'   2A 0000*              	LHLD	LNDLT
  1F0E'   EB                    	XCHG
  1F0F'   2A 0000*              	LHLD	PLFS
  1F12'   19                    	DAD	D
  1F13'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1F16'   2A 0000*              	LHLD	PCNT
  1F19'   2B                    	DCX	H
  1F1A'   22 0000*              	SHLD	PCNT
  1F1D'   7C                    	MOV	A,H
  1F1E'   B5                    	ORA	L
  1F1F'   C2 1F08'              	JNZ	VP_LP
  1F22'   CD 0174'              	CALL	MARKMOD
  1F25'   21 0000*              	LXI	H,PPFP
  1F28'   CD 03DC'              	CALL	MKLOAD
  1F2B'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1F2E'   D2 1F61'              	JNC	VP_PGD
  1F31'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1F34'   CD 09FD'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1F37'   3A 0000*              	LDA	PCPY
  1F3A'   B7                    	ORA	A
  1F3B'   CA 094B'              	JZ	FNBLNK
  1F3E'   2A 0000*              	LHLD	PLFS
  1F41'   7C                    	MOV	A,H
  1F42'   B7                    	ORA	A
  1F43'   C2 094B'              	JNZ	FNBLNK
  1F46'   3A 0000*              	LDA	PCPY
  1F49'   CD 1076'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1F4C'   7C                    	MOV	A,H
  1F4D'   B7                    	ORA	A
  1F4E'   C2 094B'              	JNZ	FNBLNK
  1F51'   7D                    	MOV	A,L
  1F52'   B7                    	ORA	A
  1F53'   CA 094B'              	JZ	FNBLNK
  1F56'   F5                    	PUSH	PSW
  1F57'   CD 087A'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1F5A'   F1                    	POP	PSW
  1F5B'   32 2EF9'              	STA	ILN		; ... which the lines put now replace
  1F5E'   C3 094B'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F61'                         VP_PGD:				; the put paged its first line out: page back
  1F61'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1F64'   CD 0000*              	CALL	GOTO
  1F67'   CD 09FD'              	CALL	GLSTAL
  1F6A'   CD 13DC'              	CALL	GPLACE
  1F6D'   C3 088F'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1F70'                         VP_BEL:
  1F70'   CD 077D'              	CALL	GETCNT		; the count is spent either way
  1F73'   0E 07                 	MVI	C,BEL
  1F75'   CD 0000*              	CALL	BCONOU
  1F78'   C3 0852'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1F7B'                         VIREP:
  1F7B'   79                    	MOV	A,C
  1F7C'   FE 1B                 	CPI	ESC
  1F7E'   CA 20D1'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1F81'   FE 0D                 	CPI	CR
  1F83'   CA 1FF6'              	JZ	VP_CR
  1F86'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1F88'   CA 1FF6'              	JZ	VP_CR
  1F8B'   FE 08                 	CPI	BS
  1F8D'   CA 2002'              	JZ	VP_BS
  1F90'   FE 7F                 	CPI	DEL
  1F92'   CA 2002'              	JZ	VP_BS
  1F95'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1F98'   CD 0858'              	CALL	SETLIN		; this row changed
  1F9B'   CD 0174'              	CALL	MARKMOD
  1F9E'   CD 1A3F'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1FA1'   CA 1FE1'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1FA4'   CD 0764'              	CALL	CURCHR
  1FA7'   06 01                 	MVI	B,1
  1FA9'   CD 085E'              	CALL	SETCEL
  1FAC'   3A 0000*              	LDA	VRCH
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1FAF'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1FB2'   2A 0000*              	LHLD	RPDEL
  1FB5'   7C                    	MOV	A,H
  1FB6'   B5                    	ORA	L
  1FB7'   CA 1FCD'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1FBA'   2A 0000*              	LHLD	GAPEND
  1FBD'   EB                    	XCHG
  1FBE'   2A 0000*              	LHLD	RPGE
  1FC1'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1FC4'   CA 1FCD'              	JZ	VP_OVW
  1FC7'   21 0000               	LXI	H,0
  1FCA'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  1FCD'                         VP_OVW:
  1FCD'   21 0001               	LXI	H,1
  1FD0'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1FD3'   2A 0000*              	LHLD	GAPEND
  1FD6'   22 0000*              	SHLD	RPGE
  1FD9'   2A 0000*              	LHLD	RPDEL
  1FDC'   23                    	INX	H
  1FDD'   22 0000*              	SHLD	RPDEL
  1FE0'   C9                    	RET
  1FE1'                         VP_APP:
  1FE1'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1FE3'   06 01                 	MVI	B,1
  1FE5'   CD 085E'              	CALL	SETCEL
  1FE8'   3A 0000*              	LDA	VRCH
  1FEB'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1FEE'   2A 0000*              	LHLD	RPAPP
  1FF1'   23                    	INX	H
  1FF2'   22 0000*              	SHLD	RPAPP
  1FF5'   C9                    	RET
  1FF6'                         VP_CR:
  1FF6'   21 0000               	LXI	H,0
  1FF9'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  1FFC'   22 0000*              	SHLD	RPAPP
  1FFF'   C3 208D'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  2002'                         VP_BS:
  2002'   2A 0000*              	LHLD	RPAPP
  2005'   7C                    	MOV	A,H
  2006'   B5                    	ORA	L
  2007'   CA 2014'              	JZ	VP_BSD
  200A'   2B                    	DCX	H
  200B'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  200E'   CD 0858'              	CALL	SETLIN
  2011'   C3 0000*              	JMP	DELPRV
  2014'                         VP_BSD:
  2014'   2A 0000*              	LHLD	RPDEL
  2017'   7C                    	MOV	A,H
  2018'   B5                    	ORA	L
  2019'   CA 2040'              	JZ	VP_BSM		; nothing of ours left
  201C'   2A 0000*              	LHLD	GAPEND
  201F'   EB                    	XCHG
  2020'   2A 0000*              	LHLD	RPGE
  2023'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  2026'   C2 2040'              	JNZ	VP_BSM
  2029'   2A 0000*              	LHLD	RPDEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  202C'   2B                    	DCX	H
  202D'   22 0000*              	SHLD	RPDEL
  2030'   CD 0858'              	CALL	SETLIN
  2033'   CD 0000*              	CALL	DELPRV		; the typed char goes
  2036'   CD 0000*              	CALL	UNDELF		; the original comes back
  2039'   2A 0000*              	LHLD	GAPEND
  203C'   22 0000*              	SHLD	RPGE
  203F'   C9                    	RET
  2040'                         VP_BSM:
  2040'   CD 0852'              	CALL	SETMOV		; nothing changed: back over the text as it is
  2043'   C3 08E0'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  2046'                         VIINS:
  2046'   79                    	MOV	A,C
  2047'   FE 1B                 	CPI	ESC
  2049'   CA 20D1'              	JZ	VI_ESC
  204C'   FE 0D                 	CPI	CR
  204E'   CA 208D'              	JZ	VI_CR
  2051'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  2053'   CA 208D'              	JZ	VI_CR
  2056'   FE 08                 	CPI	BS
  2058'   CA 20A5'              	JZ	VI_BS
  205B'   FE 7F                 	CPI	DEL
  205D'   CA 20A5'              	JZ	VI_BS
  2060'   79                    	MOV	A,C
  2061'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  2064'   CD 0174'              	CALL	MARKMOD
  2067'   CD 0858'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  206A'   79                    	MOV	A,C
  206B'   FE 20                 	CPI	' '
  206D'   D8                    	RC			; control char -> keep R_LINE
  206E'   FE 7F                 	CPI	DEL
  2070'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  2071'   CD 0895'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  2074'   47                    	MOV	B,A
  2075'   3E 04                 	MVI	A,R_ICH
  2077'   32 0000*              	STA	RINTENT
  207A'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  207C'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  207D'   CA 2089'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  2080'   CD 1A3F'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  2083'   3E 00                 	MVI	A,0
  2085'   C2 2089'              	JNZ	VI_ICH
  2088'   3C                    	INR	A
  2089'                         VI_ICH:
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2089'   32 0000*              	STA	ICHAPP
  208C'   C9                    	RET
  208D'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  208D'   CD 1A3F'              	CALL	ATCEND
  2090'   3E 00                 	MVI	A,0
  2092'   CA 2096'              	JZ	VI_CRS
  2095'   3C                    	INR	A
  2096'                         VI_CRS:
  2096'   F5                    	PUSH	PSW
  2097'   CD 1A4C'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  209A'   CD 1A59'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  209D'   CD 087A'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  20A0'   F1                    	POP	PSW
  20A1'   32 0000*              	STA	ILABOV
  20A4'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  20A5'                         VI_BS:
  20A5'   CD 0000*              	CALL	PEEKL
  20A8'   D8                    	RC			; start of the file: nothing to delete
  20A9'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  20AB'   CA 20CB'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  20AE'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  20AF'   CD 0858'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  20B2'   78                    	MOV	A,B
  20B3'   CD 0873'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  20B6'   D2 20CB'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  20B9'   CD 0895'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  20BC'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  20BD'   3C                    	INR	A
  20BE'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  20C1'   3E 01                 	MVI	A,1
  20C3'   32 2EFA'              	STA	DCHN
  20C6'   3E 07                 	MVI	A,R_DCH
  20C8'   32 0000*              	STA	RINTENT
  20CB'                         VI_BSJ:
  20CB'   CD 0174'              	CALL	MARKMOD
  20CE'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  20D1'                         VI_ESC:
  20D1'   3E 00                 	MVI	A,EM_CMD
  20D3'   32 0000*              	STA	EDMODE
  20D6'   CD 0852'              	CALL	SETMOV
  20D9'   CD 08E0'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  20DC'   C3 09FD'              	JMP	GLSTAL
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  20DF'                         RDLINE:
  20DF'   EB                    	XCHG			; HL = buffer
  20E0'   22 0000*              	SHLD	RLPTR
  20E3'   3E 00                 	MVI	A,0
  20E5'   32 0000*              	STA	RLLEN
  20E8'   78                    	MOV	A,B
  20E9'   32 0000*              	STA	RLMAX
  20EC'   79                    	MOV	A,C
  20ED'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  20F0'                         RL_LP:
  20F0'   CD 0000*              	CALL	GETKEY
  20F3'   FE 1B                 	CPI	ESC
  20F5'   CA 2145'              	JZ	RL_CAN
  20F8'   FE 0D                 	CPI	CR
  20FA'   CA 2150'              	JZ	RL_DONE
  20FD'   FE 08                 	CPI	BS
  20FF'   CA 212D'              	JZ	RL_BS
  2102'   FE 7F                 	CPI	DEL
  2104'   CA 212D'              	JZ	RL_BS
  2107'   FE 20                 	CPI	' '
  2109'   DA 20F0'              	JC	RL_LP		; control char -> ignore
  210C'   3A 0000*              	LDA	RLLEN
  210F'   47                    	MOV	B,A
  2110'   3A 0000*              	LDA	RLMAX
  2113'   B8                    	CMP	B
  2114'   CA 20F0'              	JZ	RL_LP		; full -> ignore
  2117'   2A 0000*              	LHLD	RLPTR
  211A'   71                    	MOV	M,C
  211B'   23                    	INX	H
  211C'   22 0000*              	SHLD	RLPTR
  211F'   3A 0000*              	LDA	RLLEN
  2122'   3C                    	INR	A
  2123'   32 0000*              	STA	RLLEN
  2126'   79                    	MOV	A,C
  2127'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  212A'   C3 20F0'              	JMP	RL_LP
  212D'                         RL_BS:				; WM LINEPOP
  212D'   3A 0000*              	LDA	RLLEN
  2130'   B7                    	ORA	A
  2131'   CA 2145'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  2134'   3D                    	DCR	A
  2135'   32 0000*              	STA	RLLEN
  2138'   2A 0000*              	LHLD	RLPTR
  213B'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  213C'   22 0000*              	SHLD	RLPTR
  213F'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  2142'   C3 20F0'              	JMP	RL_LP
  2145'                         RL_CAN:
  2145'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2147'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  214A'   CD 0858'              	CALL	SETLIN		; redraw one row
  214D'   3E FF                 	MVI	A,0FFH		; cancelled
  214F'   C9                    	RET
  2150'                         RL_DONE:
  2150'   AF                    	XRA	A
  2151'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2152'                         VC_BZ:
  2152'   CD 0852'              	CALL	SETMOV
  2155'   3A 0000*              	LDA	GSAVE
  2158'   FE 02                 	CPI	PZ
  215A'   CA 2165'              	JZ	VZ_ZZ
  215D'   B7                    	ORA	A
  215E'   C0                    	RNZ			; 'g' was pending: vim drops both
  215F'   3E 02                 	MVI	A,PZ
  2161'   32 0000*              	STA	GPEND
  2164'   C9                    	RET
  2165'                         VZ_ZZ:
  2165'   3E 04                 	MVI	A,EO_X
  2167'   32 0000*              	STA	EXOP
  216A'   3E 01                 	MVI	A,1
  216C'   32 0000*              	STA	EXBANG		; no '!'
  216F'   AF                    	XRA	A
  2170'   32 0000*              	STA	EXARG		; no file name
  2173'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  2176'   B7                    	ORA	A
  2177'   CA 22B8'              	JZ	EX_Q
  217A'   C3 2252'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  217D'                         VC_EX:
  217D'   CD 077D'              	CALL	GETCNT
  2180'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2183'   11 0000*              	LXI	D,EXBUF
  2186'   06 28                 	MVI	B,EXMAX
  2188'   0E 3A                 	MVI	C,':'
  218A'   CD 20DF'              	CALL	RDLINE
  218D'   B7                    	ORA	A
  218E'   C0                    	RNZ			; cancelled
  218F'   3A 0000*              	LDA	RLLEN
  2192'   5F                    	MOV	E,A
  2193'   16 00                 	MVI	D,0
  2195'   21 0000*              	LXI	H,EXBUF
  2198'   19                    	DAD	D
  2199'   36 00                 	MVI	M,0		; the line ends with a 0
  219B'   21 0000*              	LXI	H,EXBUF
  219E'   CD 276A'              	CALL	SKIPB
  21A1'   C8                    	RZ			; nothing on it
  21A2'   22 0000*              	SHLD	EXCMD
  21A5'   CD 296E'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  21A8'   CD 276A'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  21AB'   56                    	MOV	D,M
  21AC'   23                    	INX	H
  21AD'   1E 00                 	MVI	E,0
  21AF'   CD 2776'              	CALL	ISLOW
  21B2'   DA 21BD'              	JC	EX_LK
  21B5'   5F                    	MOV	E,A
  21B6'   23                    	INX	H
  21B7'   CD 2776'              	CALL	ISLOW
  21BA'   D2 21D6'              	JNC	EX_NOT		; a third letter: none of ours
  21BD'                         EX_LK:
  21BD'   E5                    	PUSH	H
  21BE'   21 2955'              	LXI	H,EXTAB
  21C1'                         EX_TL:
  21C1'   7E                    	MOV	A,M
  21C2'   B7                    	ORA	A
  21C3'   CA 21D5'              	JZ	EX_NTP		; not in the table
  21C6'   23                    	INX	H
  21C7'   BA                    	CMP	D
  21C8'   7E                    	MOV	A,M
  21C9'   23                    	INX	H
  21CA'   C2 21D1'              	JNZ	EX_TN
  21CD'   BB                    	CMP	E
  21CE'   CA 21DC'              	JZ	EX_TF
  21D1'                         EX_TN:
  21D1'   23                    	INX	H
  21D2'   C3 21C1'              	JMP	EX_TL
  21D5'                         EX_NTP:
  21D5'   E1                    	POP	H
  21D6'                         EX_NOT:
  21D6'   21 282E'              	LXI	H,SNOT
  21D9'   C3 27AB'              	JMP	EXERT
  21DC'                         EX_TF:
  21DC'   7E                    	MOV	A,M
  21DD'   32 0000*              	STA	EXOP
  21E0'   E1                    	POP	H
  21E1'   FE 06                 	CPI	EO_S
  21E3'   CA 29DD'              	JZ	EX_S		; ':s' reads the rest of the line itself
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21E6'   FE 01                 	CPI	EO_W
  21E8'   CA 21F7'              	JZ	EX_RG		; ':N,Mw name' takes a range
  21EB'   FE 08                 	CPI	EO_R
  21ED'   CA 21F7'              	JZ	EX_RG		; ... and ':Nr name' a line
  21F0'   3A 0000*              	LDA	SRNGF
  21F3'   B7                    	ORA	A
  21F4'   C2 21D6'              	JNZ	EX_NOT		; a range on a command that does not take one
  21F7'                         EX_RG:
                                	;--- '!', then the file name ---
  21F7'   7E                    	MOV	A,M
  21F8'   D6 21                 	SUI	'!'
  21FA'   32 0000*              	STA	EXBANG		; 0 = '!'
  21FD'   C2 2201'              	JNZ	EX_NB
  2200'   23                    	INX	H
  2201'                         EX_NB:
  2201'   CD 276A'              	CALL	SKIPB
  2204'   32 0000*              	STA	EXARG		; 0 = no file name
  2207'   CA 2220'              	JZ	EX_RUN
  220A'   22 0000*              	SHLD	EXCMD
  220D'   3A 0000*              	LDA	EXOP
  2210'   FE 02                 	CPI	EO_Q
  2212'   CA 27A8'              	JZ	EX_TRL		; :q takes none
  2215'   FE 07                 	CPI	EO_V
  2217'   CA 27A8'              	JZ	EX_TRL		; nor :ve
  221A'   CD 26D4'              	CALL	PARSFN
  221D'   C2 279C'              	JNZ	EX_INV
  2220'                         EX_RUN:
  2220'   3A 0000*              	LDA	EXOP
  2223'   FE 05                 	CPI	EO_E
  2225'   CA 22CF'              	JZ	EX_E
  2228'   FE 02                 	CPI	EO_Q
  222A'   CA 22B8'              	JZ	EX_Q
  222D'   FE 07                 	CPI	EO_V
  222F'   CA 27A2'              	JZ	EX_V
  2232'   FE 08                 	CPI	EO_R
  2234'   CA 2460'              	JZ	EX_R
  2237'   FE 04                 	CPI	EO_X
  2239'   CA 224B'              	JZ	EX_XM
  223C'   FE 01                 	CPI	EO_W
  223E'   C2 2252'              	JNZ	EX_W		; :wq
  2241'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2244'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2245'   C2 2380'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2248'   C3 2252'              	JMP	EX_W
  224B'                         EX_XM:
  224B'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  224E'   B7                    	ORA	A
  224F'   CA 22B8'              	JZ	EX_Q
  2252'                         EX_W:
  2252'   CD 2540'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2255'   D8                    	RC			; refused (message shown)
  2256'   32 0000*              	STA	EXBAK
  2259'   3A 0000*              	LDA	EXOP
  225C'   FE 01                 	CPI	EO_W
  225E'   CA 2275'              	JZ	EX_WK
  2261'   3A 0000*              	LDA	EXBAK
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2264'   B7                    	ORA	A
  2265'   C2 22B5'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2268'   3A 0000*              	LDA	EXBANG
  226B'   B7                    	ORA	A
  226C'   CA 22B5'              	JZ	EX_WQ		; so it does with '!'
  226F'   CD 2275'              	CALL	EX_WK		; else it may not: keep the text
  2272'   C3 22B8'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  2275'                         EX_WK:
  2275'   CD 0EB2'              	CALL	CURRW		; the cursor's row and file position
  2278'   32 0000*              	STA	WPROW
  227B'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  227E'   7D                    	MOV	A,L
  227F'   E6 7F                 	ANI	7FH
  2281'   32 0000*              	STA	WPBYT
  2284'   7D                    	MOV	A,L
  2285'   17                    	RAL
  2286'   7C                    	MOV	A,H
  2287'   17                    	RAL
  2288'   5F                    	MOV	E,A
  2289'   3E 00                 	MVI	A,0
  228B'   17                    	RAL
  228C'   57                    	MOV	D,A		; DE = HL / 128
  228D'   2A 0000*              	LHLD	OUTPOS
  2290'   19                    	DAD	D
  2291'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2294'   CD 2575'              	CALL	WRITE
  2297'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  229A'   2A 0000*              	LHLD	WPREC
  229D'   EB                    	XCHG
  229E'   3A 0000*              	LDA	WPBYT
  22A1'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  22A4'   CD 0000*              	CALL	GOTO
  22A7'                         EX_WRW:
  22A7'   21 0000               	LXI	H,0
  22AA'   22 0000*              	SHLD	LNDLT
  22AD'   3A 0000*              	LDA	WPROW
  22B0'   6F                    	MOV	L,A
  22B1'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  22B4'   C9                    	RET
  22B5'                         EX_WQ:
  22B5'   CD 2575'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  22B8'                         EX_Q:
  22B8'   3A 0000*              	LDA	EXBANG
  22BB'   B7                    	ORA	A
  22BC'   CA 22C6'              	JZ	EX_QT
  22BF'   3A 0000*              	LDA	MODF
  22C2'   B7                    	ORA	A
  22C3'   C2 2790'              	JNZ	MSGNWR		; changed, no '!': stay
  22C6'                         EX_QT:
  22C6'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  22C9'   3E 01                 	MVI	A,1
  22CB'   32 0000*              	STA	QUITF
  22CE'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  22CF'                         EX_E:
  22CF'   3A 0000*              	LDA	EXBANG
  22D2'   B7                    	ORA	A
  22D3'   CA 22DD'              	JZ	EE_GO
  22D6'   3A 0000*              	LDA	MODF
  22D9'   B7                    	ORA	A
  22DA'   C2 2790'              	JNZ	MSGNWR
  22DD'                         EE_GO:
  22DD'   3A 0000*              	LDA	EXARG
  22E0'   B7                    	ORA	A
  22E1'   C2 22E8'              	JNZ	EE_ARG
  22E4'   CD 25B1'              	CALL	OWNTF		; no name: the buffer's own
  22E7'   D8                    	RC
  22E8'                         EE_ARG:
  22E8'   CD 25C7'              	CALL	ISOWN
  22EB'   21 0001               	LXI	H,1
  22EE'   C2 22F5'              	JNZ	EE_LD		; another file: its first line
  22F1'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  22F4'   23                    	INX	H		; HL = the cursor's line
  22F5'                         EE_LD:
  22F5'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  22F7'   32 0000*              	STA	MSGWHT
  22FA'   E5                    	PUSH	H
  22FB'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  22FE'   21 0000*              	LXI	H,TFCB
  2301'   11 0000*              	LXI	D,FNAME
  2304'   CD 25D9'              	CALL	COPY12		; the buffer's name
  2307'   CD 259E'              	CALL	SRCTF
  230A'   CD 0000*              	CALL	REOPEN
  230D'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2310'   AF                    	XRA	A
  2311'   32 0000*              	STA	MODF
  2314'   E1                    	POP	H
  2315'   2B                    	DCX	H
  2316'   AF                    	XRA	A
  2317'   CD 0000*              	CALL	MVLIND		; down to the line
  231A'   CD 0BCE'              	CALL	ATEOF
  231D'   DC 0BD4'              	CC	LASTLN		; past the last line: onto it
  2320'   CD 139E'              	CALL	ZSAVE
  2323'   C3 1473'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2326'                         TFDOS:
  2326'   C5                    	PUSH	B
  2327'   11 0080               	LXI	D,CMDTAIL
  232A'   0E 1A                 	MVI	C,1AH		; set the DMA
  232C'   CD 0005               	CALL	BDOS
  232F'   C1                    	POP	B
  2330'   11 0000*              	LXI	D,TFCB
  2333'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2336'                         EXRNG:
  2336'   2A 0000*              	LHLD	SRNG1
  2339'   7C                    	MOV	A,H
  233A'   B5                    	ORA	L
  233B'   37                    	STC
  233C'   C8                    	RZ
  233D'   2A 0000*              	LHLD	SRNG2
  2340'   EB                    	XCHG
  2341'   2A 0000*              	LHLD	SRNG1
  2344'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2347'   D8                    	RC
  2348'   EB                    	XCHG			; HL = the last line, DE = the first
  2349'   CD 0000*              	CALL	SUBHD
  234C'   23                    	INX	H
  234D'   22 0000*              	SHLD	SLINES
  2350'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2351'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2352'                         GOLNX:
  2352'   E5                    	PUSH	H
  2353'   CD 1332'              	CALL	GOLN
  2356'   CD 0000*              	CALL	CNTLF
  2359'   23                    	INX	H		; the line the cursor came to rest on
  235A'   D1                    	POP	D
  235B'   C3 0000*              	JMP	CMP16
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  235E'                         EXSAVP:
  235E'   CD 0EB2'              	CALL	CURRW
  2361'   32 0000*              	STA	WPROW
  2364'   21 0000*              	LXI	H,MKPOS
  2367'   C3 0429'              	JMP	FPSTO
  236A'                         EXRSTP:
  236A'   CD 0000*              	CALL	CLRCNT
  236D'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2370'   CD 0000*              	CALL	GOTO
  2373'   C3 22A7'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2376'                         PUTBRK:
  2376'   3E 0D                 	MVI	A,CR
  2378'   CD 0000*              	CALL	PUTGAP
  237B'   3E 0A                 	MVI	A,LF
  237D'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2380'                         EX_WR:
  2380'   3A 0000*              	LDA	EXARG
  2383'   B7                    	ORA	A
  2384'   CA 277E'              	JZ	MSGNFN		; No file name
  2387'   CD 25C7'              	CALL	ISOWN
  238A'   CA 242A'              	JZ	EXW_OW
  238D'   CD 0000*              	CALL	TEXIST
  2390'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  2393'   CA 239D'              	JZ	EXW_GO
  2396'   3A 0000*              	LDA	EXBANG
  2399'   B7                    	ORA	A
  239A'   C2 2784'              	JNZ	MSGEXI		; File exists (! to force)
  239D'                         EXW_GO:
  239D'   CD 2336'              	CALL	EXRNG
  23A0'   DA 2424'              	JC	EXW_BD
  23A3'   CD 235E'              	CALL	EXSAVP
  23A6'   2A 0000*              	LHLD	SRNG1
  23A9'   CD 2352'              	CALL	GOLNX
  23AC'   C2 2421'              	JNZ	EXW_NL		; the text has no line N
  23AF'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  23B2'   B7                    	ORA	A		;   not: only when TEXIST found one
  23B3'   0E 13                 	MVI	C,13H
  23B5'   C4 2326'              	CNZ	TFDOS		; delete what is there
  23B8'   0E 16                 	MVI	C,16H
  23BA'   CD 2326'              	CALL	TFDOS		; ... and make it
  23BD'   3C                    	INR	A
  23BE'   CA 2413'              	JZ	EXW_FL		; no directory entry left
  23C1'   3E 80                 	MVI	A,80H
  23C3'   32 0000*              	STA	RWPTR
  23C6'   AF                    	XRA	A
  23C7'   32 0000*              	STA	RWERR
  23CA'   2A 0000*              	LHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  23CD'   CD 0000*              	CALL	SETC0		; that many lines, forward
  23D0'                         EXW_LP:
  23D0'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  23D3'   E5                    	PUSH	H
  23D4'   EB                    	XCHG
  23D5'   2A 0000*              	LHLD	GAPEND
  23D8'   CD 2430'              	CALL	RWOUT		; the text from the cursor to there
  23DB'   E1                    	POP	H
  23DC'   3A 0000*              	LDA	RWERR
  23DF'   B7                    	ORA	A
  23E0'   C2 23FC'              	JNZ	EXW_EN
  23E3'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  23E6'   CD 0792'              	CALL	CNTTST
  23E9'   C2 23D0'              	JNZ	EXW_LP
  23EC'                         EXW_PD:				; the last record is padded out with ^Z
  23EC'   3A 0000*              	LDA	RWPTR
  23EF'   FE 80                 	CPI	80H
  23F1'   CA 23FC'              	JZ	EXW_EN
  23F4'   3E 1A                 	MVI	A,CPMEOF
  23F6'   CD 243C'              	CALL	RWPUT
  23F9'   C3 23EC'              	JMP	EXW_PD
  23FC'                         EXW_EN:
  23FC'   0E 10                 	MVI	C,10H
  23FE'   CD 2326'              	CALL	TFDOS		; close
  2401'   3A 0000*              	LDA	RWERR
  2404'   B7                    	ORA	A
  2405'   C2 2413'              	JNZ	EXW_FL
  2408'   CD 236A'              	CALL	EXRSTP
  240B'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  240D'   32 0000*              	STA	MSGWHT
  2410'   C3 0852'              	JMP	SETMOV		; nothing on the screen has changed
  2413'                         EXW_FL:				; no room: the part written is not left behind
  2413'   0E 13                 	MVI	C,13H
  2415'   CD 2326'              	CALL	TFDOS
  2418'   CD 236A'              	CALL	EXRSTP
  241B'   21 294B'              	LXI	H,SDFUL
  241E'   C3 27B6'              	JMP	EXERR
  2421'                         EXW_NL:
  2421'   CD 236A'              	CALL	EXRSTP
  2424'                         EXW_BD:
  2424'   21 293D'              	LXI	H,SRNGE
  2427'   C3 27B6'              	JMP	EXERR
  242A'                         EXW_OW:
  242A'   21 27E5'              	LXI	H,SEXI
  242D'   C3 27B6'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2430'                         RWOUT:
  2430'   CD 0000*              	CALL	CMP16
  2433'   C8                    	RZ
  2434'   7E                    	MOV	A,M
  2435'   23                    	INX	H
  2436'   CD 243C'              	CALL	RWPUT
  2439'   C3 2430'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  243C'                         RWPUT:
  243C'   E5                    	PUSH	H
  243D'   F5                    	PUSH	PSW
  243E'   3A 0000*              	LDA	RWPTR
  2441'   6F                    	MOV	L,A
  2442'   26 00                 	MVI	H,0
  2444'   F1                    	POP	PSW
  2445'   77                    	MOV	M,A
  2446'   2C                    	INR	L		; Z: that was the record's last byte
  2447'   7D                    	MOV	A,L
  2448'   C2 245B'              	JNZ	RWP_ST
  244B'   D5                    	PUSH	D
  244C'   0E 15                 	MVI	C,15H
  244E'   CD 2326'              	CALL	TFDOS		; write it
  2451'   D1                    	POP	D
  2452'   B7                    	ORA	A
  2453'   CA 2459'              	JZ	RWP_OK
  2456'   32 0000*              	STA	RWERR
  2459'                         RWP_OK:
  2459'   3E 80                 	MVI	A,80H
  245B'                         RWP_ST:
  245B'   32 0000*              	STA	RWPTR
  245E'   E1                    	POP	H
  245F'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2460'                         EX_R:
  2460'   3A 0000*              	LDA	EXARG
  2463'   B7                    	ORA	A
  2464'   CA 277E'              	JZ	MSGNFN		; No file name
  2467'   0E 0F                 	MVI	C,0FH
  2469'   CD 2326'              	CALL	TFDOS		; open
  246C'   3C                    	INR	A
  246D'   CA 253A'              	JZ	ER_NOF
  2470'   CD 13C4'              	CALL	GZONE		; the screen's top line, before anything moves
  2473'   CD 235E'              	CALL	EXSAVP
  2476'   3A 0000*              	LDA	SRNGF
  2479'   B7                    	ORA	A
  247A'   CA 2493'              	JZ	ER_NXT		; no line given: below the cursor's
  247D'   2A 0000*              	LHLD	SRNG2
  2480'   7C                    	MOV	A,H
  2481'   B5                    	ORA	L
  2482'   C2 248D'              	JNZ	ER_LN
  2485'   23                    	INX	H
  2486'   CD 1332'              	CALL	GOLN		; ':0r': above line 1 ...
  2489'   AF                    	XRA	A		;   which never wants a line end put in first
  248A'   C3 24B5'              	JMP	ER_BRK
  248D'                         ER_LN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  248D'   CD 2352'              	CALL	GOLNX
  2490'   C2 2421'              	JNZ	EXW_NL		; the text has no line N
  2493'                         ER_NXT:
  2493'   21 0001               	LXI	H,1
  2496'   AF                    	XRA	A
  2497'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  249A'   CD 0BCE'              	CALL	ATEOF
  249D'   3E 00                 	MVI	A,0
  249F'   D2 24B5'              	JNC	ER_BRK		; text follows
  24A2'   2A 0000*              	LHLD	GAPBEG
  24A5'   EB                    	XCHG
  24A6'   2A 0000*              	LHLD	TXTBEG
  24A9'   CD 0000*              	CALL	CMP16
  24AC'   3E 01                 	MVI	A,1
  24AE'   CA 24B5'              	JZ	ER_BRK		; nothing before the cursor either
  24B1'   1B                    	DCX	D
  24B2'   1A                    	LDAX	D
  24B3'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  24B5'                         ER_BRK:
  24B5'   32 0000*              	STA	RDBRK
  24B8'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  24BB'   AF                    	XRA	A
  24BC'   32 0000*              	STA	RDANY
  24BF'                         ER_LP:
  24BF'   0E 14                 	MVI	C,14H
  24C1'   CD 2326'              	CALL	TFDOS		; the next record
  24C4'   B7                    	ORA	A
  24C5'   C2 24F8'              	JNZ	ER_END
  24C8'   21 0080               	LXI	H,CMDTAIL
  24CB'   0E 00                 	MVI	C,0
  24CD'                         ER_SC:				; C = its bytes, up to a ^Z
  24CD'   7E                    	MOV	A,M
  24CE'   FE 1A                 	CPI	CPMEOF
  24D0'   CA 24D8'              	JZ	ER_GOT
  24D3'   23                    	INX	H
  24D4'   0C                    	INR	C
  24D5'   F2 24CD'              	JP	ER_SC		; (minus: all 128)
  24D8'                         ER_GOT:
  24D8'   79                    	MOV	A,C
  24D9'   B7                    	ORA	A
  24DA'   CA 24F8'              	JZ	ER_END
  24DD'   C5                    	PUSH	B
  24DE'   3A 0000*              	LDA	RDANY
  24E1'   B7                    	ORA	A
  24E2'   CC 2529'              	CZ	ER_1ST
  24E5'   C1                    	POP	B
  24E6'   06 00                 	MVI	B,0
  24E8'   11 0080               	LXI	D,CMDTAIL
  24EB'   C5                    	PUSH	B
  24EC'   CD 0000*              	CALL	INSBLK
  24EF'   C1                    	POP	B
  24F0'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  24F3'   79                    	MOV	A,C
  24F4'   17                    	RAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24F5'   DA 24BF'              	JC	ER_LP		; a full record: there may be more
  24F8'                         ER_END:
  24F8'   3A 0000*              	LDA	RDANY
  24FB'   B7                    	ORA	A
  24FC'   CA 251A'              	JZ	ER_PL		; nothing in the file: nothing has changed
  24FF'   CD 0BCE'              	CALL	ATEOF
  2502'   DA 250F'              	JC	ER_MD		; the text now ends as the file read ends
  2505'   2A 0000*              	LHLD	GAPBEG
  2508'   2B                    	DCX	H
  2509'   7E                    	MOV	A,M
  250A'   FE 0A                 	CPI	LF
  250C'   C4 2376'              	CNZ	PUTBRK		; text follows: what was read ends a line
  250F'                         ER_MD:
  250F'   3E 01                 	MVI	A,1
  2511'   32 0000*              	STA	MODF
  2514'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2517'   CD 0000*              	CALL	GOTO
  251A'                         ER_PL:
  251A'   CD 0BCE'              	CALL	ATEOF
  251D'   DC 0BD4'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2520'   CD 0000*              	CALL	CLRCNT
  2523'   CD 13DC'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2526'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2529'                         ER_1ST:
  2529'   3C                    	INR	A
  252A'   32 0000*              	STA	RDANY
  252D'   3A 0000*              	LDA	RDBRK
  2530'   B7                    	ORA	A
  2531'   C4 2376'              	CNZ	PUTBRK
  2534'   21 0000*              	LXI	H,MKPOS
  2537'   C3 0429'              	JMP	FPSTO
  253A'                         ER_NOF:
  253A'   21 292C'              	LXI	H,SNOPN
  253D'   C3 27AB'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2540'                         WRCHK:
  2540'   3A 0000*              	LDA	EXARG
  2543'   B7                    	ORA	A
  2544'   C2 254E'              	JNZ	WC_ARG
  2547'   CD 25B1'              	CALL	OWNTF
  254A'   D8                    	RC
  254B'   C3 2563'              	JMP	WC_OWN
  254E'                         WC_ARG:
  254E'   CD 25C7'              	CALL	ISOWN
  2551'   CA 2563'              	JZ	WC_OWN
  2554'   3A 0000*              	LDA	EXBANG
  2557'   B7                    	ORA	A
  2558'   CA 2561'              	JZ	WC_OTH
  255B'   CD 0000*              	CALL	TEXIST
  255E'   C2 2784'              	JNZ	MSGEXI		; File exists (! to force)
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2561'                         WC_OTH:
  2561'   AF                    	XRA	A		; (NC)
  2562'   C9                    	RET
  2563'                         WC_OWN:
  2563'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  2566'   B7                    	ORA	A
  2567'   CA 2571'              	JZ	WC_OK
  256A'   3A 0000*              	LDA	EXBANG
  256D'   B7                    	ORA	A
  256E'   C2 278A'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2571'                         WC_OK:
  2571'   3E 01                 	MVI	A,1
  2573'   B7                    	ORA	A		; (NC)
  2574'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2575'                         WRITE:
  2575'   3A 0000*              	LDA	EXBAK
  2578'   CD 0000*              	CALL	WRTO
  257B'   3A 0001*              	LDA	FNAME+1
  257E'   FE 20                 	CPI	' '
  2580'   C2 258C'              	JNZ	WR_HAS
  2583'   21 0000*              	LXI	H,TFCB
  2586'   11 0000*              	LXI	D,FNAME
  2589'   CD 25D9'              	CALL	COPY12
  258C'                         WR_HAS:
  258C'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  258E'   32 0000*              	STA	MSGWHT
  2591'   CD 25C7'              	CALL	ISOWN
  2594'   C2 259E'              	JNZ	SRCTF
  2597'   AF                    	XRA	A
  2598'   32 0000*              	STA	MODF
  259B'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  259E'                         SRCTF:
  259E'   21 0000*              	LXI	H,TFCB
  25A1'   11 005C               	LXI	D,DFTFCB
  25A4'   CD 25D9'              	CALL	COPY12
  25A7'   AF                    	XRA	A
  25A8'   06 04                 	MVI	B,4
  25AA'                         SRC_Z:
  25AA'   12                    	STAX	D		; extent, s1, s2, record count: 0
  25AB'   13                    	INX	D
  25AC'   05                    	DCR	B
  25AD'   C2 25AA'              	JNZ	SRC_Z
  25B0'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  25B1'                         OWNTF:
  25B1'   3A 0001*              	LDA	FNAME+1
  25B4'   FE 20                 	CPI	' '
  25B6'   CA 277E'              	JZ	MSGNFN
  25B9'   CD 25E4'              	CALL	TFCLR
  25BC'   21 0000*              	LXI	H,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  25BF'   11 0000*              	LXI	D,TFCB
  25C2'   CD 25D9'              	CALL	COPY12
  25C5'   B7                    	ORA	A		; (NC)
  25C6'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  25C7'                         ISOWN:
  25C7'   21 0000*              	LXI	H,TFCB
  25CA'   11 0000*              	LXI	D,FNAME
  25CD'   06 0C                 	MVI	B,12
  25CF'                         IO_LP:
  25CF'   1A                    	LDAX	D
  25D0'   BE                    	CMP	M
  25D1'   C0                    	RNZ
  25D2'   23                    	INX	H
  25D3'   13                    	INX	D
  25D4'   05                    	DCR	B
  25D5'   C2 25CF'              	JNZ	IO_LP
  25D8'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  25D9'                         COPY12:
  25D9'   06 0C                 	MVI	B,12
  25DB'                         CP_LP:
  25DB'   7E                    	MOV	A,M
  25DC'   12                    	STAX	D
  25DD'   23                    	INX	H
  25DE'   13                    	INX	D
  25DF'   05                    	DCR	B
  25E0'   C2 25DB'              	JNZ	CP_LP
  25E3'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  25E4'                         TFCLR:
  25E4'   11 0000*              	LXI	D,TFCB
  25E7'   06 24                 	MVI	B,36
  25E9'   AF                    	XRA	A
  25EA'                         TC_LP:
  25EA'   12                    	STAX	D
  25EB'   13                    	INX	D
  25EC'   05                    	DCR	B
  25ED'   C2 25EA'              	JNZ	TC_LP
  25F0'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  25F1'                         FOPEN:
  25F1'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  25F3'   32 0000*              	STA	MSGWHT
  25F6'   21 005C               	LXI	H,DFTFCB
  25F9'   CD 26C7'              	CALL	NRMDRV
  25FC'   11 0000*              	LXI	D,FNAME
  25FF'   CD 25D9'              	CALL	COPY12
  2602'   CD 0000*              	CALL	OPENZ
  2605'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  2608'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  260A'   C8                    	RZ
  260B'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  260E'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2611'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2612'                         ARGSCN:
  2612'   3A 0080               	LDA	CMDTAIL
  2615'   47                    	MOV	B,A		; B = what is left of the line
  2616'   B7                    	ORA	A
  2617'   C8                    	RZ
  2618'   21 0081               	LXI	H,CMDTAIL+1
  261B'                         AS_TOK:				; at a token, or the blanks before one
  261B'   7E                    	MOV	A,M
  261C'   FE 20                 	CPI	' '
  261E'   C2 2627'              	JNZ	AS_OPT
  2621'   23                    	INX	H
  2622'   05                    	DCR	B
  2623'   C2 261B'              	JNZ	AS_TOK
  2626'   C9                    	RET
  2627'                         AS_OPT:
  2627'   FE 2B                 	CPI	'+'
  2629'   CA 2653'              	JZ	AS_PLS
  262C'   FE 2D                 	CPI	'-'
  262E'   CA 2642'              	JZ	AS_SW
  2631'   FE 2F                 	CPI	'/'
  2633'   CA 2642'              	JZ	AS_SW
  2636'                         AS_SKP:				; not ours (the file name): on to the next one
  2636'   23                    	INX	H
  2637'   05                    	DCR	B
  2638'   C8                    	RZ
  2639'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  263A'   FE 20                 	CPI	' '
  263C'   C2 2636'              	JNZ	AS_SKP
  263F'   C3 261B'              	JMP	AS_TOK
  2642'                         AS_SW:
  2642'   23                    	INX	H
  2643'   05                    	DCR	B
  2644'   C8                    	RZ
  2645'   7E                    	MOV	A,M
  2646'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2648'   FE 52                 	CPI	'R'
  264A'   C2 2636'              	JNZ	AS_SKP
  264D'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2650'   C3 2636'              	JMP	AS_SKP
  2653'                         AS_PLS:
  2653'   3E 01                 	MVI	A,1
  2655'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  2658'   11 0000*              	LXI	D,PLUSB
  265B'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  265D'   23                    	INX	H		;   line space, so it is taken as '+' alone
  265E'   05                    	DCR	B
  265F'   CA 2696'              	JZ	AS_PE
  2662'   7E                    	MOV	A,M
  2663'   FE 30                 	CPI	'0'
  2665'   C2 267D'              	JNZ	AS_PD
  2668'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2668'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2669'   05                    	DCR	B
  266A'   CA 269E'              	JZ	AS_P1
  266D'   7E                    	MOV	A,M
  266E'   FE 30                 	CPI	'0'
  2670'   CA 2668'              	JZ	AS_PZ
  2673'   FE 31                 	CPI	'1'
  2675'   DA 269E'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2678'   FE 3A                 	CPI	'9'+1
  267A'   D2 269E'              	JNC	AS_P1
  267D'                         AS_PD:				; the digits, as typed
  267D'   7E                    	MOV	A,M
  267E'   FE 30                 	CPI	'0'
  2680'   DA 2696'              	JC	AS_PE
  2683'   FE 3A                 	CPI	'9'+1
  2685'   D2 2696'              	JNC	AS_PE
  2688'   79                    	MOV	A,C
  2689'   B7                    	ORA	A
  268A'   CA 26A5'              	JZ	AS_POV
  268D'   0D                    	DCR	C
  268E'   7E                    	MOV	A,M
  268F'   12                    	STAX	D
  2690'   13                    	INX	D
  2691'   23                    	INX	H
  2692'   05                    	DCR	B
  2693'   C2 267D'              	JNZ	AS_PD
  2696'                         AS_PE:
  2696'   AF                    	XRA	A
  2697'   12                    	STAX	D		; the digits end with a 0
  2698'   78                    	MOV	A,B
  2699'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  269A'   C8                    	RZ
  269B'   C3 261B'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  269E'                         AS_P1:
  269E'   3E 31                 	MVI	A,'1'
  26A0'   12                    	STAX	D
  26A1'   13                    	INX	D
  26A2'   C3 2696'              	JMP	AS_PE
  26A5'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  26A5'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  26A8'   C3 2696'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  26AB'                         ARGGO:
  26AB'   3A 0000*              	LDA	PLUSF
  26AE'   B7                    	ORA	A
  26AF'   C8                    	RZ
  26B0'   21 0000*              	LXI	H,PLUSB
  26B3'                         AG_LP:
  26B3'   7E                    	MOV	A,M
  26B4'   B7                    	ORA	A
  26B5'   CA 26C2'              	JZ	AG_G
  26B8'   4F                    	MOV	C,A
  26B9'   E5                    	PUSH	H
  26BA'   CD 0023'              	CALL	VICMD
  26BD'   E1                    	POP	H
  26BE'   23                    	INX	H
  26BF'   C3 26B3'              	JMP	AG_LP
  26C2'                         AG_G:
  26C2'   0E 47                 	MVI	C,'G'
  26C4'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  26C7'                         NRMDRV:
  26C7'   7E                    	MOV	A,M
  26C8'   B7                    	ORA	A
  26C9'   C0                    	RNZ
  26CA'   E5                    	PUSH	H
  26CB'   0E 19                 	MVI	C,BF_CURDSK
  26CD'   CD 0005               	CALL	BDOS
  26D0'   E1                    	POP	H
  26D1'   3C                    	INR	A
  26D2'   77                    	MOV	M,A
  26D3'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  26D4'                         PARSFN:
  26D4'   CD 25E4'              	CALL	TFCLR
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26D7'   11 0000*              	LXI	D,TFCB
  26DA'   23                    	INX	H
  26DB'   7E                    	MOV	A,M
  26DC'   2B                    	DCX	H
  26DD'   FE 3A                 	CPI	':'
  26DF'   C2 26F1'              	JNZ	PF_NM
  26E2'   CD 2737'              	CALL	GETFNC
  26E5'   CA 26F1'              	JZ	PF_NM
  26E8'   D6 40                 	SUI	40H
  26EA'   12                    	STAX	D
  26EB'   FE 11                 	CPI	17
  26ED'   D2 2715'              	JNC	PF_BAD
  26F0'   23                    	INX	H
  26F1'                         PF_NM:
  26F1'   13                    	INX	D
  26F2'   0E 08                 	MVI	C,8
  26F4'   CD 2719'              	CALL	CPYNAM
  26F7'   FE 2E                 	CPI	'.'
  26F9'   0E 03                 	MVI	C,3
  26FB'   C4 272C'              	CNZ	PADFLD		; no type: blanks
  26FE'   CC 2718'              	CZ	CPYNM0		; '.': the type
  2701'   3A 0001*              	LDA	TFCB+1
  2704'   FE 20                 	CPI	' '
  2706'   CA 2715'              	JZ	PF_BAD		; no name
  2709'   CD 276A'              	CALL	SKIPB
  270C'   C0                    	RNZ			; more after it
  270D'   21 0000*              	LXI	H,TFCB
  2710'   CD 26C7'              	CALL	NRMDRV
  2713'   AF                    	XRA	A
  2714'   C9                    	RET
  2715'                         PF_BAD:
  2715'   F6 01                 	ORI	1
  2717'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2718'                         CPYNM0:
  2718'   23                    	INX	H
  2719'                         CPYNAM:
  2719'   CD 2737'              	CALL	GETFNC
  271C'   CA 272C'              	JZ	PADFLD
  271F'   12                    	STAX	D
  2720'   13                    	INX	D
  2721'   0D                    	DCR	C
  2722'   C2 2719'              	JNZ	CPYNAM
  2725'                         CN_SKP:
  2725'   CD 2737'              	CALL	GETFNC
  2728'   C2 2725'              	JNZ	CN_SKP
  272B'   C9                    	RET
  272C'                         PADFLD:
  272C'   F5                    	PUSH	PSW
  272D'                         PD_LP:
  272D'   3E 20                 	MVI	A,' '
  272F'   12                    	STAX	D
  2730'   13                    	INX	D
  2731'   0D                    	DCR	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2732'   C2 272D'              	JNZ	PD_LP
  2735'   F1                    	POP	PSW
  2736'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2737'                         GETFNC:
  2737'   7E                    	MOV	A,M
  2738'   FE 3D                 	CPI	'='
  273A'   C8                    	RZ
  273B'   FE 5F                 	CPI	'_'
  273D'   C8                    	RZ
  273E'   FE 3B                 	CPI	';'
  2740'   C8                    	RZ
  2741'   FE 3C                 	CPI	'<'
  2743'   C8                    	RZ
  2744'   FE 3E                 	CPI	'>'
  2746'   C8                    	RZ
  2747'   FE 2E                 	CPI	'.'
  2749'   C8                    	RZ
  274A'   FE 3A                 	CPI	':'
  274C'   C8                    	RZ
  274D'   FE 2A                 	CPI	'*'
  274F'   C8                    	RZ
  2750'   FE 3F                 	CPI	'?'
  2752'   C8                    	RZ
  2753'   FE 20                 	CPI	' '
  2755'   DA 2768'              	JC	GF_CTL
  2758'   C8                    	RZ
  2759'   23                    	INX	H
  275A'   FE 61                 	CPI	'a'
  275C'   DA 2766'              	JC	GF_DN
  275F'   FE 7B                 	CPI	'z'+1
  2761'   D2 2766'              	JNC	GF_DN
  2764'   E6 DF                 	ANI	0DFH
  2766'                         GF_DN:
  2766'   B7                    	ORA	A
  2767'   C9                    	RET
  2768'                         GF_CTL:
  2768'   BF                    	CMP	A
  2769'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  276A'                         SKIPB:
  276A'   7E                    	MOV	A,M
  276B'   FE 20                 	CPI	' '
  276D'   C2 2774'              	JNZ	SB_DN
  2770'   23                    	INX	H
  2771'   C3 276A'              	JMP	SKIPB
  2774'                         SB_DN:
  2774'   B7                    	ORA	A
  2775'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  2776'                         ISLOW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  2776'   7E                    	MOV	A,M
  2777'   FE 61                 	CPI	'a'
  2779'   D8                    	RC
  277A'   FE 7B                 	CPI	'z'+1
  277C'   3F                    	CMC
  277D'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  277E'                         MSGNFN:
  277E'   21 27CB'              	LXI	H,SNFN
  2781'   C3 27B6'              	JMP	EXERR
  2784'                         MSGEXI:
  2784'   21 27E5'              	LXI	H,SEXI
  2787'   C3 2793'              	JMP	EXBNG
  278A'                         MSGRO:
  278A'   21 27F1'              	LXI	H,SRO
  278D'   C3 2793'              	JMP	EXBNG
  2790'                         MSGNWR:
  2790'   21 27D8'              	LXI	H,SNWR
  2793'                         EXBNG:
  2793'   CD 27B6'              	CALL	EXERR
  2796'   21 27FD'              	LXI	H,SBNG
  2799'   C3 27B1'              	JMP	EXOUT
  279C'                         EX_INV:
  279C'   21 280B'              	LXI	H,SINV
  279F'   C3 27B6'              	JMP	EXERR
  27A2'                         EX_V:				; :ve -- the version, on the bottom row
  27A2'   21 27C6'              	LXI	H,SVER
  27A5'   C3 27B6'              	JMP	EXERR
  27A8'                         EX_TRL:
  27A8'   21 281D'              	LXI	H,STRL
  27AB'                         EXERT:				; the message, then the text at EXCMD
  27AB'   CD 27B6'              	CALL	EXERR
  27AE'   2A 0000*              	LHLD	EXCMD
  27B1'                         EXOUT:
  27B1'   CD 0000*              	CALL	OUTSTR
  27B4'   37                    	STC
  27B5'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  27B6'                         EXERR:
  27B6'   E5                    	PUSH	H
  27B7'   AF                    	XRA	A		; an error outranks whatever this key meant to
  27B8'   32 0000*              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  27BB'   E1                    	POP	H
  27BC'   CD 0000*              	CALL	EXMSG
  27BF'   3E 01                 	MVI	A,R_MOVE
  27C1'   32 0000*              	STA	RINTENT
  27C4'   37                    	STC
  27C5'   C9                    	RET
                                
  27C6'   56 31 2E 34           SVER:	DB	'V1.4',0
  27CA'   00                    
  27CB'   4E 6F 20 66           SNFN:	DB	'No file name',0
  27CF'   69 6C 65 20           
  27D3'   6E 61 6D 65           
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


  27D7'   00                    
  27D8'   46 69 6C 65           SNWR:	DB	'File changed',0
  27DC'   20 63 68 61           
  27E0'   6E 67 65 64           
  27E4'   00                    
  27E5'   46 69 6C 65           SEXI:	DB	'File exists',0
  27E9'   20 65 78 69           
  27ED'   73 74 73 00           
  27F1'   27 2D 52 27           SRO:	DB	'''-R'' is set',0
  27F5'   20 69 73 20           
  27F9'   73 65 74 00           
  27FD'   20 28 21 20           SBNG:	DB	' (! to force)',0
  2801'   74 6F 20 66           
  2805'   6F 72 63 65           
  2809'   29 00                 
  280B'   49 6E 76 61           SINV:	DB	'Invalid file name',0
  280F'   6C 69 64 20           
  2813'   66 69 6C 65           
  2817'   20 6E 61 6D           
  281B'   65 00                 
  281D'   54 72 61 69           STRL:	DB	'Trailing chars: ',0
  2821'   6C 69 6E 67           
  2825'   20 63 68 61           
  2829'   72 73 3A 20           
  282D'   00                    
  282E'   49 6E 76 61           SNOT:	DB	'Invalid command: ',0
  2832'   6C 69 64 20           
  2836'   63 6F 6D 6D           
  283A'   61 6E 64 3A           
  283E'   20 00                 
  2840'   50 61 74 74           SNOTFD: DB	'Pattern not found: ',0
  2844'   65 72 6E 20           
  2848'   6E 6F 74 20           
  284C'   66 6F 75 6E           
  2850'   64 3A 20 00           
  2854'   49 6E 74 65           SINTR:	DB	'Interrupted',0
  2858'   72 72 75 70           
  285C'   74 65 64 00           
  2860'   49 6E 74 65           SINTG:	DB	'Interrupting...',0
  2864'   72 72 75 70           
  2868'   74 69 6E 67           
  286C'   2E 2E 2E 00           
  2870'   4E 6F 20 70           SNOPAT: DB	'No previous search pattern',0
  2874'   72 65 76 69           
  2878'   6F 75 73 20           
  287C'   73 65 61 72           
  2880'   63 68 20 70           
  2884'   61 74 74 65           
  2888'   72 6E 00              
