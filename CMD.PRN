  2A39'   1526'                 	DW	VCB_D
  2A3B'   43                    	DB	'C'
  2A3C'   1520'                 	DW	VCB_C
  2A3E'   63                    	DB	'c'
  2A3F'   178B'                 	DW	VC_C
  2A41'   6F                    	DB	'o'
