  0910'   2A 0000*              	LHLD	TXTBEG
  0913'   EB                    	XCHG
  0914'   CD 0000*              	CALL	SUBHD
  0917'   44                    	MOV	B,H
  0918'   4D                    	MOV	C,L
  0919'   E1                    	POP	H
