  0CCF'   EB                    	XCHG
  0CD0'   2A 29D2'              	LHLD	WKI
  0CD3'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0CD6'   DA 0CE2'              	JC	ES_CL
  0CD9'   CA 0CE2'              	JZ	ES_CL
  0CDC'   2A 29D2'              	LHLD	WKI
  0CDF'   C3 057A'              	JMP	GOSET
  0CE2'                         ES_CL:
  0CE2'   2A 29D4'              	LHLD	WKN
  0CE5'   7C                    	MOV	A,H
  0CE6'   B5                    	ORA	L
  0CE7'   C8                    	RZ
  0CE8'   2B                    	DCX	H
  0CE9'   C3 057A'              	JMP	GOSET
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0CEC'                         CURRW:
  0CEC'   2A 0000*              	LHLD	WINROW
  0CEF'   EB                    	XCHG
  0CF0'   2A 0000*              	LHLD	LNDLT
  0CF3'   19                    	DAD	D		; HL = row (signed)
  0CF4'   7C                    	MOV	A,H
  0CF5'   B7                    	ORA	A
  0CF6'   FA 0D09'              	JM	CRW_0		; above the screen -> top row
  0CF9'   C2 0D04'              	JNZ	CRW_BT		; far below -> bottom row
  0CFC'   3A 0000*              	LDA	NEDIT
  0CFF'   3D                    	DCR	A		; A = bottom row
  0D00'   BD                    	CMP	L		; CY iff bottom < row
  0D01'   D8                    	RC
  0D02'   7D                    	MOV	A,L
  0D03'   C9                    	RET
  0D04'                         CRW_BT:
  0D04'   3A 0000*              	LDA	NEDIT
  0D07'   3D                    	DCR	A
  0D08'   C9                    	RET
  0D09'                         CRW_0:
  0D09'   AF                    	XRA	A
  0D0A'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D0B'                         SETRWT:
  0D0B'   2A 0000*              	LHLD	LNDLT
  0D0E'   EB                    	XCHG
  0D0F'   6F                    	MOV	L,A
  0D10'   26 00                 	MVI	H,0
  0D12'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D15'   22 0000*              	SHLD	WINROW
  0D18'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D19'                         MVROW:
  0D19'   47                    	MOV	B,A
  0D1A'   CD 0CEC'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D1D'   90                    	SUB	B		; A = row now - target
  0D1E'   C8                    	RZ
  0D1F'   DA 0D28'              	JC	MR_DN
  0D22'   6F                    	MOV	L,A
  0D23'   26 00                 	MVI	H,0
  0D25'   C3 0973'              	JMP	KCORE
  0D28'                         MR_DN:
  0D28'   2F                    	CMA
  0D29'   3C                    	INR	A		; A = target - row now
  0D2A'   6F                    	MOV	L,A
  0D2B'   26 00                 	MVI	H,0
  0D2D'   C3 08D6'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D30'                         VC_HIGH:
  0D30'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D33'   2B                    	DCX	H		; row = count - 1
  0D34'   7C                    	MOV	A,H
  0D35'   B7                    	ORA	A
  0D36'   3A 0000*              	LDA	SCBOT
  0D39'   C2 0D41'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D3C'   BD                    	CMP	L		; CY iff SCBOT < row
  0D3D'   DA 0D41'              	JC	VH_GO
  0D40'   7D                    	MOV	A,L
  0D41'                         VH_GO:
  0D41'   CD 0D19'              	CALL	MVROW
  0D44'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D47'                         VC_MIDL:
  0D47'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D4A'   3A 0000*              	LDA	SCBOT
  0D4D'   B7                    	ORA	A		; clear CY for the shift
  0D4E'   1F                    	RAR			; A = SCBOT / 2
  0D4F'   CD 0D19'              	CALL	MVROW
  0D52'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D55'                         VC_LOWL:
  0D55'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D58'   2B                    	DCX	H		; count - 1
  0D59'   3A 0000*              	LDA	SCBOT
  0D5C'   5F                    	MOV	E,A
  0D5D'   16 00                 	MVI	D,0
  0D5F'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D60'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D63'   3E 00                 	MVI	A,0
  0D65'   D2 0D6C'              	JNC	VL_GO		; at or past the top -> row 0
  0D68'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D6B'   7D                    	MOV	A,L
  0D6C'                         VL_GO:
  0D6C'   CD 0D19'              	CALL	MVROW
  0D6F'   C3 0828'              	JMP	FNBLNK
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D72'                         VC_PGDN:
  0D72'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D75'   3A 0000*              	LDA	SCEOF
  0D78'   B7                    	ORA	A
  0D79'   CA 0D87'              	JZ	VPD_N
  0D7C'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D7F'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D80'   C8                    	RZ			; it already is
  0D81'   CD 0D19'              	CALL	MVROW
  0D84'   C3 0D98'              	JMP	VPD_TP
  0D87'                         VPD_N:
  0D87'   3A 0000*              	LDA	NEDIT
  0D8A'   D6 02                 	SUI	2
  0D8C'   CD 0DE0'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D8F'   E5                    	PUSH	H
  0D90'   AF                    	XRA	A
  0D91'   CD 0D19'              	CALL	MVROW		; the top line
  0D94'   E1                    	POP	H
  0D95'   CD 08D6'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D98'                         VPD_TP:
  0D98'   AF                    	XRA	A
  0D99'   CD 0D0B'              	CALL	SETRWT		; to the top row
  0D9C'   C3 0828'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D9F'                         VC_PGUP:
  0D9F'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DA2'   3A 0000*              	LDA	SCBOF
  0DA5'   B7                    	ORA	A
  0DA6'   C0                    	RNZ
  0DA7'   3A 0000*              	LDA	NEDIT
  0DAA'   47                    	MOV	B,A
  0DAB'   3A 0000*              	LDA	SCEOF
  0DAE'   B7                    	ORA	A
  0DAF'   CA 0DC0'              	JZ	VPU_2
  0DB2'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DB5'   FE 02                 	CPI	2
  0DB7'   D2 0DC0'              	JNC	VPU_2
  0DBA'   2F                    	CMA
  0DBB'   3C                    	INR	A
  0DBC'   80                    	ADD	B
  0DBD'   C3 0DC3'              	JMP	VPU_P
  0DC0'                         VPU_2:
  0DC0'   78                    	MOV	A,B
  0DC1'   D6 02                 	SUI	2
  0DC3'                         VPU_P:
  0DC3'   CD 0DE0'              	CALL	MULSAT		; HL = count * page
  0DC6'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DC7'   AF                    	XRA	A
  0DC8'   CD 0D19'              	CALL	MVROW		; the top line
  0DCB'   E1                    	POP	H
  0DCC'   CD 0973'              	CALL	KCORE		; the new top line
  0DCF'   AF                    	XRA	A
  0DD0'   CD 0D0B'              	CALL	SETRWT		; on the top row
  0DD3'   3A 0000*              	LDA	NEDIT
  0DD6'   3D                    	DCR	A
  0DD7'   6F                    	MOV	L,A
  0DD8'   26 00                 	MVI	H,0
  0DDA'   CD 08D6'              	CALL	JCORE		; the bottom row's line
  0DDD'   C3 0828'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DE0'                         MULSAT:
  0DE0'   EB                    	XCHG
  0DE1'   21 0000               	LXI	H,0
  0DE4'   B7                    	ORA	A
  0DE5'   C8                    	RZ
  0DE6'                         MS_LP:
  0DE6'   19                    	DAD	D
  0DE7'   DA 0DEF'              	JC	MS_SAT
  0DEA'   3D                    	DCR	A
  0DEB'   C2 0DE6'              	JNZ	MS_LP
  0DEE'   C9                    	RET
  0DEF'                         MS_SAT:
  0DEF'   21 FFFF               	LXI	H,0FFFFH
  0DF2'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0DF3'                         VC_HFDN:
  0DF3'   CD 075A'              	CALL	SETMOV
  0DF6'   CD 0CEC'              	CALL	CURRW
  0DF9'   32 2998'              	STA	HFROW
  0DFC'   CD 0E6A'              	CALL	HFCNT		; HL = lines
  0DFF'   3A 2998'              	LDA	HFROW
  0E02'   47                    	MOV	B,A
  0E03'   3A 0000*              	LDA	SCEOF
  0E06'   B7                    	ORA	A
  0E07'   CA 0E0F'              	JZ	VHD_GO
  0E0A'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E0D'   B8                    	CMP	B
  0E0E'   C8                    	RZ			; the cursor is on it
  0E0F'                         VHD_GO:
  0E0F'   CD 08D6'              	CALL	JCORE
  0E12'   3A 0000*              	LDA	SCEOF
  0E15'   B7                    	ORA	A
  0E16'   C2 0828'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E19'   3A 2998'              	LDA	HFROW
  0E1C'   CD 0D0B'              	CALL	SETRWT
  0E1F'   3E 01                 	MVI	A,1
  0E21'   32 0000*              	STA	WFILL		; not past the end of the file
  0E24'   C3 0828'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E27'                         VC_HFUP:
  0E27'   CD 075A'              	CALL	SETMOV
  0E2A'   CD 0CEC'              	CALL	CURRW
  0E2D'   32 2998'              	STA	HFROW
  0E30'   CD 0E6A'              	CALL	HFCNT		; HL = lines
  0E33'   CD 0E4A'              	CALL	ONFST
  0E36'   C8                    	RZ			; the cursor is on the first line
  0E37'   CD 0973'              	CALL	KCORE
  0E3A'   3A 0000*              	LDA	SCBOF
  0E3D'   B7                    	ORA	A
  0E3E'   C2 0828'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E41'   3A 2998'              	LDA	HFROW
  0E44'   CD 0D0B'              	CALL	SETRWT
  0E47'   C3 0828'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E4A'                         ONFST:
  0E4A'   E5                    	PUSH	H
  0E4B'   2A 0000*              	LHLD	OUTPOS
  0E4E'   7C                    	MOV	A,H
  0E4F'   B5                    	ORA	L
  0E50'   C2 0E68'              	JNZ	OF_RET
  0E53'   2A 0000*              	LHLD	TXTBEG
  0E56'   EB                    	XCHG			; DE = TXTBEG
  0E57'   2A 0000*              	LHLD	GAPBEG
  0E5A'                         OF_LP:
  0E5A'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E5D'   CA 0E68'              	JZ	OF_RET
  0E60'   2B                    	DCX	H
  0E61'   7E                    	MOV	A,M
  0E62'   FE 0A                 	CPI	LF
  0E64'   C2 0E5A'              	JNZ	OF_LP
  0E67'   B7                    	ORA	A		; NZ
  0E68'                         OF_RET:
  0E68'   E1                    	POP	H
  0E69'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E6A'                         HFCNT:
  0E6A'   2A 298C'              	LHLD	CMDCNT
  0E6D'   7C                    	MOV	A,H
  0E6E'   B5                    	ORA	L
  0E6F'   CA 0E86'              	JZ	HFC_AM
  0E72'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E75'   3A 0000*              	LDA	NEDIT
  0E78'   5F                    	MOV	E,A
  0E79'   16 00                 	MVI	D,0
  0E7B'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E7E'   D2 0E82'              	JNC	HFC_ST
  0E81'   EB                    	XCHG			; HL = NEDIT
  0E82'                         HFC_ST:
  0E82'   7D                    	MOV	A,L
  0E83'   32 2999'              	STA	HFAMT
  0E86'                         HFC_AM:
  0E86'   3A 2999'              	LDA	HFAMT
  0E89'   B7                    	ORA	A
  0E8A'   C2 0E97'              	JNZ	HFC_HL
  0E8D'   3A 0000*              	LDA	NEDIT
  0E90'   B7                    	ORA	A
  0E91'   1F                    	RAR
  0E92'   B7                    	ORA	A
  0E93'   C2 0E97'              	JNZ	HFC_HL
  0E96'   3C                    	INR	A		; at least one line
  0E97'                         HFC_HL:
  0E97'   6F                    	MOV	L,A
  0E98'   26 00                 	MVI	H,0
  0E9A'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E9B'                         VC_REDR:
  0E9B'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E9E'                         VC_G:
  0E9E'   CD 075A'              	CALL	SETMOV
  0EA1'   CD 0F60'              	CALL	GZONE		; the screen's top line, before the move
  0EA4'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EA7'   2A 298C'              	LHLD	CMDCNT
  0EAA'   7C                    	MOV	A,H
  0EAB'   B5                    	ORA	L
  0EAC'   C2 0EBF'              	JNZ	VG_N
  0EAF'   AF                    	XRA	A		; forward
  0EB0'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EB3'   CD 06EB'              	CALL	BRKOFF
  0EB6'   DA 0703'              	JC	BRKBAK
  0EB9'   CD 0A0A'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0EBC'   C3 0F78'              	JMP	GPLACE
  0EBF'                         VG_N:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EBF'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0EC2'                         VG_LN:
  0EC2'   CD 0ECE'              	CALL	GOLN
  0EC5'   CD 06EB'              	CALL	BRKOFF
  0EC8'   DA 0703'              	JC	BRKBAK
  0ECB'   C3 0F78'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0ECE'                         GOLN:
  0ECE'   E5                    	PUSH	H
  0ECF'   CD 0000*              	CALL	CNTLF
  0ED2'   23                    	INX	H		; HL = the cursor's line
  0ED3'   D1                    	POP	D		; DE = the line wanted
  0ED4'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0ED7'   DA 0EE2'              	JC	GLN_BK
  0EDA'   EB                    	XCHG
  0EDB'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EDE'   AF                    	XRA	A
  0EDF'   C3 0EE7'              	JMP	GLN_MV
  0EE2'                         GLN_BK:
  0EE2'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EE5'   3E FF                 	MVI	A,0FFH
  0EE7'                         GLN_MV:
  0EE7'   CD 0000*              	CALL	MVLIND
  0EEA'   CD 0A04'              	CALL	ATEOF
  0EED'   DC 0A0A'              	CC	LASTLN		; past the last line: onto it
  0EF0'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0EF1'                         VC_LG:
  0EF1'   CD 075A'              	CALL	SETMOV
  0EF4'   3A 29B4'              	LDA	GSAVE
  0EF7'   B7                    	ORA	A
  0EF8'   C2 0F01'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0EFB'   3E 01                 	MVI	A,PG
  0EFD'   32 29B3'              	STA	GPEND
  0F00'   C9                    	RET
  0F01'                         VLG_GG:
  0F01'   CD 0F60'              	CALL	GZONE
  0F04'   CD 06B4'              	CALL	BRKON
  0F07'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F0A'   C3 0EC2'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F0D'                         SUB24:
  0F0D'   4F                    	MOV	C,A
  0F0E'   7D                    	MOV	A,L
  0F0F'   93                    	SUB	E
  0F10'   6F                    	MOV	L,A
  0F11'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F12'   9A                    	SBB	D
  0F13'   67                    	MOV	H,A
  0F14'   79                    	MOV	A,C
  0F15'   98                    	SBB	B
  0F16'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F17'                         CURFP:
  0F17'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F1A'                         FPOS:
  0F1A'   C5                    	PUSH	B
  0F1B'   D5                    	PUSH	D
  0F1C'   EB                    	XCHG
  0F1D'   2A 0000*              	LHLD	TXTBEG
  0F20'   EB                    	XCHG
  0F21'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F24'   EB                    	XCHG			; DE = that
  0F25'   2A 0000*              	LHLD	OUTPOS
  0F28'   7C                    	MOV	A,H
  0F29'   B7                    	ORA	A		; CY = 0
  0F2A'   1F                    	RAR
  0F2B'   47                    	MOV	B,A
  0F2C'   7D                    	MOV	A,L
  0F2D'   1F                    	RAR
  0F2E'   67                    	MOV	H,A
  0F2F'   3E 00                 	MVI	A,0
  0F31'   1F                    	RAR
  0F32'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F33'   19                    	DAD	D
  0F34'   78                    	MOV	A,B
  0F35'   CE 00                 	ACI	0		; A:HL = the position
  0F37'   D1                    	POP	D
  0F38'   C1                    	POP	B
  0F39'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F3A'                         ZSAVE:
  0F3A'   2A 298C'              	LHLD	CMDCNT
  0F3D'   22 29F2'              	SHLD	ZSVCNT
  0F40'   2A 0000*              	LHLD	AUXCNT
  0F43'   22 29F4'              	SHLD	ZSVAUX
  0F46'   3A 0000*              	LDA	DIRFLG
  0F49'   32 29F6'              	STA	ZSVDIR
  0F4C'   C9                    	RET
  0F4D'                         ZREST:
  0F4D'   2A 29F2'              	LHLD	ZSVCNT
  0F50'   22 298C'              	SHLD	CMDCNT
  0F53'   2A 29F4'              	LHLD	ZSVAUX
  0F56'   22 0000*              	SHLD	AUXCNT
  0F59'   3A 29F6'              	LDA	ZSVDIR
  0F5C'   32 0000*              	STA	DIRFLG
  0F5F'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F60'                         GZONE:
  0F60'   CD 0F3A'              	CALL	ZSAVE
  0F63'   CD 0CEC'              	CALL	CURRW
  0F66'   6F                    	MOV	L,A
  0F67'   26 00                 	MVI	H,0
  0F69'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F6C'   CD 0F1A'              	CALL	FPOS
  0F6F'   22 0000*              	SHLD	ZTOP
  0F72'   32 0002*              	STA	ZTOP+2
  0F75'   C3 0F4D'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F78'                         GPLACE:
  0F78'   CD 0F3A'              	CALL	ZSAVE
  0F7B'   CD 0F17'              	CALL	CURFP
  0F7E'   EB                    	XCHG
  0F7F'   2A 0000*              	LHLD	ZTOP
  0F82'   EB                    	XCHG
  0F83'   4F                    	MOV	C,A		; C:HL = the target's position
  0F84'   3A 0002*              	LDA	ZTOP+2
  0F87'   47                    	MOV	B,A		; B:DE = the top's
  0F88'   79                    	MOV	A,C
  0F89'   CD 0F0D'              	CALL	SUB24
  0F8C'   22 29EF'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F8F'   DA 0FDC'              	JC	GP_UP
  0F92'   B7                    	ORA	A
  0F93'   C2 101D'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0F96'   3A 0000*              	LDA	NEDIT
  0F99'   5F                    	MOV	E,A
  0F9A'   16 00                 	MVI	D,0
  0F9C'   B7                    	ORA	A
  0F9D'   1F                    	RAR
  0F9E'   6F                    	MOV	L,A
  0F9F'   26 00                 	MVI	H,0
  0FA1'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FA2'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FA5'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FA8'   EB                    	XCHG
  0FA9'   2A 29EF'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FAC'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FAF'   DA 101D'              	JC	GP_MID
  0FB2'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FB5'   01 0000               	LXI	B,0		; BC = lines from the top
  0FB8'                         GP_CNT:
  0FB8'   7A                    	MOV	A,D
  0FB9'   B3                    	ORA	E
  0FBA'   CA 0FC9'              	JZ	GP_DN
  0FBD'   7E                    	MOV	A,M
  0FBE'   23                    	INX	H
  0FBF'   1B                    	DCX	D
  0FC0'   FE 0A                 	CPI	LF
  0FC2'   C2 0FB8'              	JNZ	GP_CNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FC5'   03                    	INX	B
  0FC6'   C3 0FB8'              	JMP	GP_CNT
  0FC9'                         GP_DN:
  0FC9'   3A 0000*              	LDA	NEDIT
  0FCC'   3D                    	DCR	A
  0FCD'   5F                    	MOV	E,A
  0FCE'   16 00                 	MVI	D,0		; DE = the bottom row
  0FD0'   60                    	MOV	H,B
  0FD1'   69                    	MOV	L,C
  0FD2'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FD5'   DA 1027'              	JC	GP_SET		; A = the bottom row
  0FD8'   7D                    	MOV	A,L		; on the screen: its row
  0FD9'   C3 1047'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FDC'                         GP_UP:
  0FDC'   3C                    	INR	A
  0FDD'   C2 101D'              	JNZ	GP_MID		; 64K bytes or more above
  0FE0'   2A 29EF'              	LHLD	ZDIF
  0FE3'   EB                    	XCHG
  0FE4'   21 0000               	LXI	H,0
  0FE7'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0FEA'   7C                    	MOV	A,H
  0FEB'   B5                    	ORA	L
  0FEC'   CA 101D'              	JZ	GP_MID		; exactly 64K
  0FEF'   EB                    	XCHG			; DE = bytes to read
  0FF0'   AF                    	XRA	A
  0FF1'   32 29F1'              	STA	ZLF
  0FF4'   CD 0000*              	CALL	RGET0
  0FF7'                         GP_RD:
  0FF7'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0FFA'   DA 101D'              	JC	GP_MID
  0FFD'   FE 0A                 	CPI	LF
  0FFF'   C2 1013'              	JNZ	GP_RN
  1002'   3A 0000*              	LDA	NEDIT
  1005'   B7                    	ORA	A
  1006'   1F                    	RAR
  1007'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1009'   E5                    	PUSH	H
  100A'   21 29F1'              	LXI	H,ZLF
  100D'   34                    	INR	M
  100E'   BE                    	CMP	M		; CY iff more lines than that
  100F'   E1                    	POP	H
  1010'   DA 101D'              	JC	GP_MID
  1013'                         GP_RN:
  1013'   1B                    	DCX	D
  1014'   7A                    	MOV	A,D
  1015'   B3                    	ORA	E
  1016'   C2 0FF7'              	JNZ	GP_RD
  1019'   AF                    	XRA	A		; the top row
  101A'   C3 1027'              	JMP	GP_SET
  101D'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  101D'   3E 01                 	MVI	A,1
  101F'   32 0000*              	STA	WFILL		; not past the end of the file
  1022'   3A 0000*              	LDA	NEDIT
  1025'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1026'   1F                    	RAR			; the middle row
  1027'                         GP_SET:
  1027'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  1028'   26 00                 	MVI	H,0
  102A'   22 0000*              	SHLD	WINROW
  102D'   21 0000               	LXI	H,0
  1030'   22 0000*              	SHLD	LNDLT
  1033'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  1036'                         GP_FIN:
  1036'   CD 0F4D'              	CALL	ZREST
  1039'   3A 2A19'              	LDA	GPKEEP
  103C'   B7                    	ORA	A
  103D'   CA 0828'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1040'   AF                    	XRA	A
  1041'   32 2A19'              	STA	GPKEEP
  1044'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  1047'                         GP_ONS:
  1047'   6F                    	MOV	L,A
  1048'   26 00                 	MVI	H,0		; HL = the row it lands on
  104A'   EB                    	XCHG
  104B'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  104E'   EB                    	XCHG
  104F'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1052'   22 0000*              	SHLD	LNDLT
  1055'   3E 01                 	MVI	A,R_MOVE
  1057'   32 2990'              	STA	RINTENT
  105A'   C3 1036'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  105D'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  105D'   AF                    	XRA	A
  105E'   32 29B9'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1061'   3A 29B6'              	LDA	PSAVE
  1064'   FE 63                 	CPI	'c'
  1066'   C2 1083'              	JNZ	OPP_ND
  1069'   79                    	MOV	A,C
  106A'   FE 77                 	CPI	'w'
  106C'   CA 1074'              	JZ	OPP_W
  106F'   FE 57                 	CPI	'W'
  1071'   C2 1083'              	JNZ	OPP_ND
  1074'                         OPP_W:
  1074'   CD 1256'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  1077'   DA 1083'              	JC	OPP_ND
  107A'   79                    	MOV	A,C
  107B'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  107D'   4F                    	MOV	C,A
  107E'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  1080'   32 29B9'              	STA	CWEOL		;   see the clamp in OPA_F
  1083'                         OPP_ND:
  1083'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1084'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1086'   C2 109A'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  1089'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  108C'   DA 112A'              	JC	OPABRT
  108F'   79                    	MOV	A,C
  1090'   FE 67                 	CPI	'g'
  1092'   C2 112A'              	JNZ	OPABRT
  1095'   3E 01                 	MVI	A,PG
  1097'   32 29B4'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  109A'                         OPP_NG:
  109A'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  109B'   21 29B6'              	LXI	H,PSAVE
  109E'   BE                    	CMP	M
  109F'   CA 1277'              	JZ	OPLINE
  10A2'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10A3'   CD 128D'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10A6'   DA 112A'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10A9'   32 29B8'              	STA	OPCLSV
  10AC'   47                    	MOV	B,A		; B = the class
  10AD'   3A 29B6'              	LDA	PSAVE
  10B0'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10B2'   C2 10BE'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10B5'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10B6'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10B8'   C2 10E0'              	JNZ	OPP_GO
  10BB'   C3 10C9'              	JMP	OPP_NO
  10BE'                         OPP_NC:
  10BE'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10C0'   C2 10E0'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10C3'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10C4'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10C6'   CA 10E0'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10C9'                         OPP_NO:
  10C9'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10CA'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10CC'   CA 10DA'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10CF'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10D1'   CA 10DA'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10D4'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10D7'   C2 112A'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10DA'                         OPP_SW:
  10DA'   CD 021C'              	CALL	MKGETK
  10DD'   C3 112A'              	JMP	OPABRT
  10E0'                         OPP_GO:
  10E0'   AF                    	XRA	A
  10E1'   32 2997'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10E4'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10E7'   22 29BA'              	SHLD	OPSTA
  10EA'   C5                    	PUSH	B
  10EB'   21 29BE'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  10EE'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  10F1'   3A 29B8'              	LDA	OPCLSV
  10F4'   FE 02                 	CPI	2
  10F6'   CC 112D'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  10F9'   C1                    	POP	B
  10FA'   21 28BA'              	LXI	H,CMDTAB
  10FD'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1100'   3A 29B6'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1103'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1104'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1107'   CD 1159'              	CALL	OPSFIX		; where the start is in the window NOW
  110A'   D2 1175'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  110D'   22 29BA'              	SHLD	OPSTA
  1110'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1113'   22 29BC'              	SHLD	OPEND2
  1116'   3A 29B6'              	LDA	PSAVE
  1119'   FE 79                 	CPI	'y'
  111B'   CA 173A'              	JZ	OPYANK		; a yank takes the span without losing it
  111E'   CD 12C8'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1121'   3A 29B6'              	LDA	PSAVE
  1124'   FE 63                 	CPI	'c'
  1126'   C0                    	RNZ
  1127'   C3 14F6'              	JMP	SETINS
  112A'                         OPABRT:				; not a motion -> the operator is dropped and
  112A'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  112D'                         OPENDS:
  112D'   2A 29BA'              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1130'   CD 05E4'              	CALL	BOL
  1133'   11 29C1'              	LXI	D,OPSLO
  1136'   CD 114B'              	CALL	OPE_ST
  1139'   2A 29BA'              	LHLD	OPSTA
  113C'   CD 0614'              	CALL	NLSTART
  113F'   11 29C4'              	LXI	D,OPSHI
  1142'   CD 114B'              	CALL	OPE_ST
  1145'   2A 29BA'              	LHLD	OPSTA
  1148'   C3 0000*              	JMP	GOTO
  114B'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  114B'   D5                    	PUSH	D
  114C'   CD 0000*              	CALL	GOTO
  114F'   E1                    	POP	H
  1150'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1153'                         CURBD:
  1153'   CD 0F17'              	CALL	CURFP
  1156'   EB                    	XCHG
  1157'   47                    	MOV	B,A
  1158'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1159'                         OPSFIX:
  1159'   21 29BE'              	LXI	H,OPSFP
  115C'   CD 0402'              	CALL	MKLOAD
  115F'   CD 1153'              	CALL	CURBD
  1162'   2A 2A23'              	LHLD	MKPOS
  1165'   3A 2A25'              	LDA	MKPOS+2
  1168'   CD 0F0D'              	CALL	SUB24
  116B'   B4                    	ORA	H
  116C'   B5                    	ORA	L
  116D'   C2 040F'              	JNZ	MKWIN
  1170'   CD 0000*              	CALL	CUROFF
  1173'   37                    	STC
  1174'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1175'                         OPPGD:
  1175'   47                    	MOV	B,A
  1176'   3A 29B8'              	LDA	OPCLSV
  1179'   FE 02                 	CPI	2
  117B'   C2 1237'              	JNZ	OPG_NO
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  117E'   3A 29B6'              	LDA	PSAVE
  1181'   FE 64                 	CPI	'd'
  1183'   C2 1237'              	JNZ	OPG_NO
  1186'   04                    	INR	B
  1187'   CA 1196'              	JZ	OPG_FW
  118A'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  118D'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1190'   CD 0000*              	CALL	GOTO
  1193'   C3 11AE'              	JMP	OPG_GO
  1196'                         OPG_FW:
  1196'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1199'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  119C'   11 29C4'              	LXI	D,OPSHI		;   start line began
  119F'   CD 114B'              	CALL	OPE_ST
  11A2'   21 29C1'              	LXI	H,OPSLO
  11A5'   CD 0402'              	CALL	MKLOAD
  11A8'   CD 03CF'              	CALL	MKPAGE
  11AB'   CD 0000*              	CALL	GOTO
  11AE'                         OPG_GO:
  11AE'   CD 1153'              	CALL	CURBD
  11B1'   2A 29C4'              	LHLD	OPSHI
  11B4'   3A 29C6'              	LDA	OPSHI+2
  11B7'   CD 0F0D'              	CALL	SUB24		; A:HL = the bytes to take
  11BA'                         OPG_SV:
  11BA'   22 29C7'              	SHLD	OPTOGO
  11BD'   32 29C9'              	STA	OPTOGO+2
  11C0'                         OPG_NX:
  11C0'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11C3'   CD 0000*              	CALL	SUBHD
  11C6'   EB                    	XCHG			; DE = what the window holds past the cursor
  11C7'   2A 29C7'              	LHLD	OPTOGO
  11CA'   3A 29C9'              	LDA	OPTOGO+2
  11CD'   B7                    	ORA	A
  11CE'   C2 1201'              	JNZ	OPG_PG		; 64K or more to go
  11D1'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11D4'   DA 1201'              	JC	OPG_PG
  11D7'   CA 1201'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11DA'                         OPG_FN:				; the rest of it is here
  11DA'   E5                    	PUSH	H
  11DB'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11DE'   CD 0000*              	CALL	CUROFF
  11E1'   22 29CA'              	SHLD	OPLO
  11E4'   D1                    	POP	D
  11E5'   19                    	DAD	D
  11E6'   22 29CC'              	SHLD	OPHI
  11E9'   CD 1366'              	CALL	OPDSPN
  11EC'   CD 0A04'              	CALL	ATEOF
  11EF'   D2 1250'              	JNC	OPMID
  11F2'   CD 0E4A'              	CALL	ONFST		; deleted to the end of the file: onto the new
  11F5'   CA 1250'              	JZ	OPMID		;   last line, if there is one -- and the pager
  11F8'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  11FB'   CD 0000*              	CALL	SETBWD
  11FE'   C3 1250'              	JMP	OPMID
  1201'                         OPG_PG:
  1201'   7A                    	MOV	A,D
  1202'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1203'   C2 121C'              	JNZ	OPG_DL
  1206'   CD 0A04'              	CALL	ATEOF		; nothing held past the cursor
  1209'   21 0000               	LXI	H,0
  120C'   DA 11DA'              	JC	OPG_FN		; ... and no more to come: the file ran out
  120F'   2B                    	DCX	H
  1210'   CD 0000*              	CALL	SETC0
  1213'   CD 0000*              	CALL	GOLINE
  1216'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1219'   C3 11C0'              	JMP	OPG_NX
  121C'                         OPG_DL:
  121C'   D5                    	PUSH	D
  121D'   21 FFFF               	LXI	H,0FFFFH
  1220'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1223'   E1                    	POP	H
  1224'   E5                    	PUSH	H
  1225'   CD 0000*              	CALL	DELFWD
  1228'   D1                    	POP	D
  1229'   06 00                 	MVI	B,0
  122B'   2A 29C7'              	LHLD	OPTOGO
  122E'   3A 29C9'              	LDA	OPTOGO+2
  1231'   CD 0F0D'              	CALL	SUB24
  1234'   C3 11BA'              	JMP	OPG_SV
  1237'                         OPG_NO:
  1237'   0E 07                 	MVI	C,BEL
  1239'   CD 0000*              	CALL	BCONOU
  123C'                         OPG_HM:				; the cursor back where the command found it
  123C'   21 29BE'              	LXI	H,OPSFP
  123F'   CD 0402'              	CALL	MKLOAD
  1242'   CD 03CF'              	CALL	MKPAGE
  1245'   CD 0000*              	CALL	GOTO
  1248'   AF                    	XRA	A
  1249'   32 29B6'              	STA	PSAVE
  124C'   3C                    	INR	A
  124D'   32 2A19'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1250'                         OPMID:
  1250'   CD 0F3A'              	CALL	ZSAVE
  1253'   C3 101D'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1256'                         ONWHIT:
  1256'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1259'   CA 1275'              	JZ	OW_YES
  125C'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  125F'   FE 20                 	CPI	' '
  1261'   CA 1275'              	JZ	OW_YES
  1264'   FE 09                 	CPI	TAB
  1266'   CA 1275'              	JZ	OW_YES
  1269'   FE 0D                 	CPI	CR
  126B'   CA 1275'              	JZ	OW_YES
  126E'   FE 0A                 	CPI	LF
  1270'   CA 1275'              	JZ	OW_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1273'   B7                    	ORA	A		; a char to change: CY clear
  1274'   C9                    	RET
  1275'                         OW_YES:
  1275'   37                    	STC
  1276'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1277'                         OPLINE:
  1277'   3A 29B6'              	LDA	PSAVE
  127A'   FE 63                 	CPI	'c'
  127C'   CA 075A'              	JZ	SETMOV
  127F'   FE 79                 	CPI	'y'
  1281'   CA 1719'              	JZ	VY_YY
  1284'   21 29BE'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1287'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  128A'   C3 1692'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  128D'                         OPCLS:
  128D'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  128F'   CA 129C'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1292'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1294'   C2 12B0'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1297'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1299'   C3 129E'              	JMP	OPC_FK
  129C'                         OPC_SEM:
  129C'   06 00                 	MVI	B,0		; ';' runs it as it stands
  129E'                         OPC_FK:
  129E'   3A 2A0F'              	LDA	FNDKND
  12A1'   B7                    	ORA	A
  12A2'   37                    	STC
  12A3'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12A4'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12A5'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12A7'   CA 12AE'              	JZ	OPC_EXC
  12AA'   3E 01                 	MVI	A,1
  12AC'   B7                    	ORA	A		; CY clear: a motion, class 1
  12AD'   C9                    	RET
  12AE'                         OPC_EXC:
  12AE'   AF                    	XRA	A		; class 0, CY clear
  12AF'   C9                    	RET
  12B0'                         OPC_TB:
  12B0'   47                    	MOV	B,A
  12B1'   21 13EA'              	LXI	H,OPCTAB
  12B4'                         OPC_LP:
  12B4'   7E                    	MOV	A,M
  12B5'   B7                    	ORA	A
  12B6'   CA 12C6'              	JZ	OPC_MS		; end of table -> not a motion
  12B9'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12BA'   CA 12C2'              	JZ	OPC_HT
  12BD'   23                    	INX	H
  12BE'   23                    	INX	H
  12BF'   C3 12B4'              	JMP	OPC_LP
  12C2'                         OPC_HT:
  12C2'   23                    	INX	H
  12C3'   7E                    	MOV	A,M		; class byte
  12C4'   B7                    	ORA	A		; clear CY
  12C5'   C9                    	RET
  12C6'                         OPC_MS:
  12C6'   37                    	STC
  12C7'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12C8'                         OPAPPL:
  12C8'   3A 29B8'              	LDA	OPCLSV
  12CB'   FE 02                 	CPI	2
  12CD'   CA 13CE'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12D0'   2A 29BA'              	LHLD	OPSTA
  12D3'   EB                    	XCHG			; DE = start
  12D4'   2A 29BC'              	LHLD	OPEND2		; HL = end
  12D7'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12DA'   DA 12EA'              	JC	OPA_F
  12DD'   CA 12EA'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12E0'   22 29CA'              	SHLD	OPLO
  12E3'   EB                    	XCHG
  12E4'   22 29CC'              	SHLD	OPHI
  12E7'   C3 1342'              	JMP	OPA_DO
  12EA'                         OPA_F:
  12EA'   EB                    	XCHG			; HL = start, DE = end
  12EB'   22 29CA'              	SHLD	OPLO
  12EE'   EB                    	XCHG			; HL = end
  12EF'   3A 29B8'              	LDA	OPCLSV
  12F2'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  12F4'   CA 133F'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  12F7'   FE 01                 	CPI	1
  12F9'   C2 131B'              	JNZ	OPA_EX
  12FC'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  12FD'   3A 29B9'              	LDA	CWEOL
  1300'   B7                    	ORA	A
  1301'   CA 133F'              	JZ	OPA_HI
  1304'   22 29CC'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1307'   2A 29CA'              	LHLD	OPLO
  130A'   CD 1474'              	CALL	CEND		; HL = the start line's content end
  130D'   EB                    	XCHG			; DE = that content end
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  130E'   2A 29CC'              	LHLD	OPHI		; HL = hi
  1311'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1314'   D2 133F'              	JNC	OPA_HI		; hi is inside the line: keep it
  1317'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1318'   C3 133F'              	JMP	OPA_HI
  131B'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  131B'   22 29CC'              	SHLD	OPHI		; the motion's own end, for now
  131E'   2A 29CA'              	LHLD	OPLO
  1321'   CD 1474'              	CALL	CEND		; HL = the start line's content end
  1324'   EB                    	XCHG			; DE = that content end
  1325'   3A 2997'              	LDA	WPULL		; the motion landed on a line's end and was
  1328'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1329'   C2 1335'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  132C'   2A 29CC'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  132F'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  1332'   D2 1342'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1335'                         OPA_CE:				;   deletes the word, not all but its last char
  1335'   2A 29CA'              	LHLD	OPLO
  1338'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  133B'   CA 1380'              	JZ	OPA_LN
  133E'   EB                    	XCHG			; HL = the content end
  133F'                         OPA_HI:
  133F'   22 29CC'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  1342'                         OPA_DO:
  1342'   CD 1366'              	CALL	OPDSPN
  1345'   3A 29B6'              	LDA	PSAVE
  1348'   FE 63                 	CPI	'c'
  134A'   C8                    	RZ
  134B'   C3 1485'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  134E'                         SPNBRK:
  134E'   2A 29CA'              	LHLD	OPLO
  1351'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1354'   EB                    	XCHG			; DE = it
  1355'   2A 29CC'              	LHLD	OPHI
  1358'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  135B'                         OPSPNL:
  135B'   2A 29CC'              	LHLD	OPHI
  135E'   EB                    	XCHG
  135F'   2A 29CA'              	LHLD	OPLO
  1362'   EB                    	XCHG			; HL = hi, DE = lo
  1363'   C3 0000*              	JMP	SUBHD
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1366'                         OPDSPN:
  1366'   CD 134E'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1369'   F5                    	PUSH	PSW
  136A'   2A 29CA'              	LHLD	OPLO
  136D'   CD 0000*              	CALL	GOTO
  1370'   CD 135B'              	CALL	OPSPNL		; HL = hi - lo
  1373'   CD 0000*              	CALL	DELFWD
  1376'   CD 018C'              	CALL	MARKMOD
  1379'   F1                    	POP	PSW
  137A'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  137D'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  1380'                         OPA_LN:
  1380'   3A 29B6'              	LDA	PSAVE
  1383'   FE 63                 	CPI	'c'
  1385'   C2 138E'              	JNZ	OPA_LD
  1388'   2A 29CA'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  138B'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  138E'                         OPA_LD:
  138E'   2A 29CA'              	LHLD	OPLO
  1391'   22 29BA'              	SHLD	OPSTA
  1394'   22 29BC'              	SHLD	OPEND2
  1397'   C3 13CE'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  139A'                         OPALSP:
  139A'   2A 29BA'              	LHLD	OPSTA
  139D'   EB                    	XCHG
  139E'   2A 29BC'              	LHLD	OPEND2
  13A1'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  13A4'   DA 13B1'              	JC	OPAL_F
  13A7'   22 29CA'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  13AA'   EB                    	XCHG
  13AB'   22 29CC'              	SHLD	OPHI		; hi-src = start
  13AE'   C3 13BB'              	JMP	OPAL_R
  13B1'                         OPAL_F:
  13B1'   EB                    	XCHG			; HL = start
  13B2'   22 29CA'              	SHLD	OPLO		; lo-src = start
  13B5'   2A 29BC'              	LHLD	OPEND2
  13B8'   22 29CC'              	SHLD	OPHI		; hi-src = end
  13BB'                         OPAL_R:
  13BB'   2A 29CA'              	LHLD	OPLO
  13BE'   CD 05E4'              	CALL	BOL
  13C1'   22 29CA'              	SHLD	OPLO		; lo = BOL(low line)
  13C4'   2A 29CC'              	LHLD	OPHI
  13C7'   CD 0614'              	CALL	NLSTART
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13CA'   22 29CC'              	SHLD	OPHI		; hi = start of line past the high line
  13CD'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  13CE'                         OPALIN:
  13CE'   CD 139A'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  13D1'                         OPDLIN:
  13D1'   CD 1366'              	CALL	OPDSPN
  13D4'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  13D7'   DA 13E7'              	JC	OPDL_NB
  13DA'   CD 0000*              	CALL	LOGLEN
  13DD'   7C                    	MOV	A,H
  13DE'   B5                    	ORA	L
  13DF'   C8                    	RZ			; empty buffer
  13E0'   2B                    	DCX	H
  13E1'   CD 05E4'              	CALL	BOL
  13E4'   CD 0000*              	CALL	GOTO
  13E7'                         OPDL_NB:
  13E7'   C3 0828'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  13EA'                         OPCTAB:
  13EA'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  13EE'   62 00 42 00           
  13F2'   68 00 6C 00           
  13F6'   30 00 5E 00           
  13FA'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  13FC'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1400'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1404'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1408'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  140C'   24 01                 
  140E'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1412'   47 02 48 02           
  1416'   4D 02 4C 02           
  141A'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  141C'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  141E'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  141F'                         VCB_C:
  141F'   CD 142B'              	CALL	VCB_CD
  1422'   C3 14F6'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1425'                         VCB_D:
  1425'   CD 142B'              	CALL	VCB_CD
  1428'   C3 1485'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  142B'                         VCB_CD:
  142B'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  142E'   22 29CA'              	SHLD	OPLO
  1431'   CD 0000*              	CALL	CUROFF
  1434'   CD 1474'              	CALL	CEND		; to the line's content end, the CR,LF left
  1437'   22 29CC'              	SHLD	OPHI
  143A'   C3 1366'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  143D'                         VC_X:
  143D'   CD 08CD'              	CALL	GLSTAL
  1440'   CD 0760'              	CALL	SETLIN
  1443'   CD 068B'              	CALL	GETCNT
  1446'   22 29CE'              	SHLD	CNTV
  1449'   CD 0000*              	CALL	CUROFF
  144C'   22 29D2'              	SHLD	WKI		; cur
  144F'   CD 1474'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1452'   EB                    	XCHG			; DE = contentend
  1453'   2A 29D2'              	LHLD	WKI		; HL = cur
  1456'   EB                    	XCHG			; HL = contentend, DE = cur
  1457'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  145A'   7C                    	MOV	A,H
  145B'   B5                    	ORA	L
  145C'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145D'   EB                    	XCHG			; DE = available
  145E'   2A 29CE'              	LHLD	CNTV		; HL = count
  1461'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1464'   DA 146A'              	JC	VX_USEA
  1467'   C3 146B'              	JMP	VX_DEL		; count <= available -> HL = count = del
  146A'                         VX_USEA:
  146A'   EB                    	XCHG			; HL = available
  146B'                         VX_DEL:
  146B'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  146E'   CD 018C'              	CALL	MARKMOD
  1471'   C3 1485'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1474'                         CEND:
  1474'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1477'   7C                    	MOV	A,H
  1478'   B5                    	ORA	L
  1479'   C8                    	RZ			; the start of the text: nothing before it
  147A'   2B                    	DCX	H
  147B'   E5                    	PUSH	H
  147C'   CD 0000*              	CALL	CHARAT
  147F'   E1                    	POP	H		; HL = term-1
  1480'   FE 0D                 	CPI	CR
  1482'   C8                    	RZ			; a CR before the LF -> the content ends there
  1483'   23                    	INX	H
  1484'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1485'                         CLAMPE:
  1485'   CD 0000*              	CALL	CUROFF
  1488'   E5                    	PUSH	H
  1489'   CD 0623'              	CALL	EOLC
  148C'   D1                    	POP	D		; DE = cur
  148D'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1490'   D8                    	RC
  1491'   C8                    	RZ
  1492'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1495'                         VC_I:
  1495'   CD 068B'              	CALL	GETCNT
  1498'   C3 14F3'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  149B'                         VC_A:
  149B'   CD 068B'              	CALL	GETCNT
  149E'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  14A1'   CA 14B8'              	JZ	VA_INS
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14A4'   EB                    	XCHG			; HL = cur
  14A5'   E5                    	PUSH	H
  14A6'   CD 0000*              	CALL	CHARAT
  14A9'   E1                    	POP	H
  14AA'   FE 0A                 	CPI	LF
  14AC'   CA 14B8'              	JZ	VA_INS		; on the line terminator -> append in place
  14AF'   FE 0D                 	CPI	CR
  14B1'   CA 14B8'              	JZ	VA_INS
  14B4'   23                    	INX	H
  14B5'   CD 0000*              	CALL	GOTO
  14B8'                         VA_INS:
  14B8'   C3 14F3'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  14BB'                         VCB_A:
  14BB'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14BE'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  14C1'   E5                    	PUSH	H
  14C2'   CD 0000*              	CALL	CHARAT
  14C5'   E1                    	POP	H
  14C6'   FE 0D                 	CPI	CR
  14C8'   CA 14D1'              	JZ	VBA_IN		; an empty line: insert at its start
  14CB'   FE 0A                 	CPI	LF
  14CD'   CA 14D1'              	JZ	VBA_IN
  14D0'   23                    	INX	H		; past the last content char
  14D1'                         VBA_IN:
  14D1'   CD 0000*              	CALL	GOTO
  14D4'   C3 14F3'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  14D7'                         VCB_I:
  14D7'   CD 068B'              	CALL	GETCNT
  14DA'   CD 0828'              	CALL	FNBLNK
  14DD'   CD 0000*              	CALL	CUROFF
  14E0'   E5                    	PUSH	H
  14E1'   CD 0000*              	CALL	CHARAT
  14E4'   E1                    	POP	H
  14E5'   FE 20                 	CPI	' '
  14E7'   CA 14EF'              	JZ	VBI_SK
  14EA'   FE 09                 	CPI	TAB
  14EC'   C2 14F3'              	JNZ	SETINM
  14EF'                         VBI_SK:
  14EF'   23                    	INX	H		; blanks only: past the last of them
  14F0'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                ; span has already said what it changed.
  14F3'                         SETINM:
  14F3'   CD 075A'              	CALL	SETMOV
  14F6'                         SETINS:
  14F6'   3E 01                 	MVI	A,EM_INS
  14F8'   32 298B'              	STA	EDMODE
  14FB'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  14FC'                         ATCEND:
  14FC'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  14FF'   C8                    	RZ
  1500'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1503'   FE 0D                 	CPI	CR
  1505'   C8                    	RZ
  1506'   FE 0A                 	CPI	LF
  1508'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1509'                         OPNBRK:
  1509'   CD 1DFB'              	CALL	PUTBRK
  150C'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  150F'   23                    	INX	H
  1510'   22 0000*              	SHLD	LNDLT
  1513'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1516'                         ENDBRK:
  1516'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1519'   C0                    	RNZ
  151A'   CD 1509'              	CALL	OPNBRK
  151D'   CD 0000*              	CALL	CUROFF
  1520'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1521'   2B                    	DCX	H		;   line, with its own terminator after it
  1522'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1525'                         VC_O:
  1525'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1528'   CD 1474'              	CALL	CEND
  152B'   CD 0000*              	CALL	GOTO
  152E'   CD 1509'              	CALL	OPNBRK
  1531'   CD 1516'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1534'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  1537'   C3 14F6'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  153A'                         VCB_O:
  153A'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  153D'   CD 05E4'              	CALL	BOL
  1540'   CD 0000*              	CALL	GOTO
  1543'   CD 1509'              	CALL	OPNBRK
  1546'   CD 0000*              	CALL	CUROFF
  1549'   2B                    	DCX	H
  154A'   2B                    	DCX	H
  154B'   CD 0000*              	CALL	GOTO
  154E'   CD 0766'              	CALL	SETILN
  1551'   C3 14F6'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1554'                         VCB_J:
  1554'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1557'   CD 1474'              	CALL	CEND		; the join point: this line's content end
  155A'   22 29CA'              	SHLD	OPLO
  155D'   CD 0000*              	CALL	CUROFF
  1560'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1563'   E5                    	PUSH	H
  1564'   CD 0000*              	CALL	LOGLEN
  1567'   D1                    	POP	D		; DE = that start
  1568'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  156B'   CA 075A'              	JZ	SETMOV
  156E'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  156F'                         VJ_WS:
  156F'   E5                    	PUSH	H
  1570'   CD 0000*              	CALL	LOGLEN
  1573'   D1                    	POP	D		; DE = the scan
  1574'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1577'   CA 158E'              	JZ	VJ_DEL
  157A'   EB                    	XCHG			; HL = the scan
  157B'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  157C'   CD 0000*              	CALL	CHARAT
  157F'   E1                    	POP	H
  1580'   FE 20                 	CPI	' '
  1582'   CA 158A'              	JZ	VJ_SKIP
  1585'   FE 09                 	CPI	TAB
  1587'   C2 158E'              	JNZ	VJ_DEL
  158A'                         VJ_SKIP:
  158A'   23                    	INX	H
  158B'   C3 156F'              	JMP	VJ_WS
  158E'                         VJ_DEL:
  158E'   22 29CC'              	SHLD	OPHI
  1591'   CD 1366'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1594'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1597'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  159A'   CA 1485'              	JZ	CLAMPE
  159D'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  15A0'   FE 0D                 	CPI	CR
  15A2'   CA 1485'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  15A5'   FE 0A                 	CPI	LF
  15A7'   CA 1485'              	JZ	CLAMPE
  15AA'   FE 29                 	CPI	')'
  15AC'   CA 1485'              	JZ	CLAMPE		; vim puts no space before a ')'
  15AF'   CD 0000*              	CALL	CUROFF
  15B2'   7C                    	MOV	A,H
  15B3'   B5                    	ORA	L
  15B4'   CA 15CA'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  15B7'   2B                    	DCX	H
  15B8'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  15BB'   FE 20                 	CPI	' '
  15BD'   CA 1485'              	JZ	CLAMPE
  15C0'   FE 09                 	CPI	TAB
  15C2'   CA 1485'              	JZ	CLAMPE
  15C5'   FE 0A                 	CPI	LF
  15C7'   CA 1485'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  15CA'                         VJ_SP:
  15CA'   3E 20                 	MVI	A,' '
  15CC'   CD 0000*              	CALL	PUTGAP
  15CF'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  15D2'   2B                    	DCX	H
  15D3'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  15D6'                         VC_TILD:
  15D6'   CD 068B'              	CALL	GETCNT
  15D9'   CD 0760'              	CALL	SETLIN		; only this row changes
  15DC'   CD 08CD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  15DF'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15E2'   CA 075A'              	JZ	SETMOV
  15E5'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  15E8'   FE 0D                 	CPI	CR
  15EA'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15ED'   FE 0A                 	CPI	LF
  15EF'   CA 075A'              	JZ	SETMOV
  15F2'   47                    	MOV	B,A
  15F3'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  15F5'   FE 41                 	CPI	'A'
  15F7'   DA 1603'              	JC	VT_PUT		; below 'A': no case
  15FA'   FE 5B                 	CPI	'Z'+1
  15FC'   D2 1603'              	JNC	VT_PUT		; above 'Z': no case
  15FF'   78                    	MOV	A,B
  1600'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1602'   47                    	MOV	B,A
  1603'                         VT_PUT:
  1603'   78                    	MOV	A,B
  1604'   32 29DB'              	STA	VRCH		; the calls below do not preserve B
  1607'   CD 018C'              	CALL	MARKMOD
  160A'   21 0001               	LXI	H,1
  160D'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1610'   3A 29DB'              	LDA	VRCH
  1613'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1616'   C3 1485'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1619'                         VC_R:
  1619'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  161C'   3E 03                 	MVI	A,PR
  161E'   32 29B3'              	STA	GPEND
  1621'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1622'                         VR_DO:
  1622'   AF                    	XRA	A
  1623'   32 29B3'              	STA	GPEND
  1626'   79                    	MOV	A,C
  1627'   32 29DB'              	STA	VRCH		; the calls below do not preserve C
  162A'   CD 0760'              	CALL	SETLIN		; only this row changed
  162D'   CD 08CD'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1630'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1633'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  1636'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1639'   FE 0D                 	CPI	CR
  163B'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  163E'   FE 0A                 	CPI	LF
  1640'   CA 075A'              	JZ	SETMOV
  1643'   CD 018C'              	CALL	MARKMOD
  1646'   21 0001               	LXI	H,1
  1649'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  164C'   3A 29DB'              	LDA	VRCH
  164F'   FE 0D                 	CPI	CR
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1651'   CA 165E'              	JZ	VR_CR
  1654'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1657'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  165A'   2B                    	DCX	H		;   out, which moves every logical offset
  165B'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  165E'                         VR_CR:
  165E'   CD 1509'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1661'   CD 1516'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1664'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1667'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1669'   32 2993'              	STA	ILABOV
  166C'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  166D'                         VCB_R:
  166D'   CD 068B'              	CALL	GETCNT
  1670'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1673'   21 0000               	LXI	H,0
  1676'   22 29DC'              	SHLD	RPDEL		; nothing of ours to put back yet
  1679'   22 29DE'              	SHLD	RPAPP
  167C'   3E 02                 	MVI	A,EM_REP
  167E'   32 298B'              	STA	EDMODE
  1681'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1682'                         VC_D:
  1682'   3E 64                 	MVI	A,'d'
  1684'   32 29B5'              	STA	PENDOP
  1687'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  168A'                         VC_C:
  168A'   3E 63                 	MVI	A,'c'
  168C'   32 29B5'              	STA	PENDOP
  168F'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1692'                         VD_DD:
  1692'   CD 08CD'              	CALL	GLSTAL
  1695'   CD 068B'              	CALL	GETCNT
  1698'   22 29CE'              	SHLD	CNTV
  169B'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  169D'   32 29B7'              	STA	DDSNG
  16A0'   2B                    	DCX	H
  16A1'   7C                    	MOV	A,H
  16A2'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16A3'   C2 16AE'              	JNZ	VDD_LS
  16A6'   3E 01                 	MVI	A,1
  16A8'   32 29B7'              	STA	DDSNG
  16AB'   C3 16B4'              	JMP	VDD_GO
  16AE'                         VDD_LS:
  16AE'   CD 0893'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  16B1'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  16B4'                         VDD_GO:
  16B4'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  16B7'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  16BA'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  16BD'   CD 205E'              	CALL	COPY12		;   every mark in the lines has closed up by then
  16C0'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  16C3'   2A 29CE'              	LHLD	CNTV
  16C6'   CD 0000*              	CALL	SETC0
  16C9'                         VDD_FW:
  16C9'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  16CC'   DA 181A'              	JC	QREFUS		; ... which has no room for them
  16CF'   CD 06A0'              	CALL	CNTTST
  16D2'   C2 16C9'              	JNZ	VDD_FW
  16D5'   CD 018C'              	CALL	MARKMOD
  16D8'   CD 0A04'              	CALL	ATEOF
  16DB'   D2 16F6'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  16DE'   3E 00                 	MVI	A,0
  16E0'   32 29B7'              	STA	DDSNG		; deleted to the end: full repaint
  16E3'   CD 0E4A'              	CALL	ONFST
  16E6'   CA 0828'              	JZ	FNBLNK		; nothing left before it
  16E9'   21 0001               	LXI	H,1		; onto the new last line
  16EC'   CD 0000*              	CALL	SETBWD
  16EF'   2A 0000*              	LHLD	LNDLT
  16F2'   2B                    	DCX	H
  16F3'   22 0000*              	SHLD	LNDLT
  16F6'                         VDD_UP:
  16F6'   CD 0828'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  16F9'   3A 29B7'              	LDA	DDSNG
  16FC'   B7                    	ORA	A
  16FD'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  16FE'   3E 03                 	MVI	A,R_DLIN
  1700'   32 2990'              	STA	RINTENT
  1703'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1704'                         QEMPTY:
  1704'   2A 0000*              	LHLD	QBEG
  1707'   EB                    	XCHG
  1708'   2A 0000*              	LHLD	QEND
  170B'   7C                    	MOV	A,H
  170C'   BA                    	CMP	D
  170D'   C0                    	RNZ
  170E'   7D                    	MOV	A,L
  170F'   BB                    	CMP	E
  1710'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1711'                         VC_Y:
  1711'   3E 79                 	MVI	A,'y'
  1713'   32 29B5'              	STA	PENDOP
  1716'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1719'                         VY_YY:
  1719'   21 29BE'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  171C'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  171F'   CD 0000*              	CALL	CUROFF
  1722'   22 29FF'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1725'   CD 05E4'              	CALL	BOL
  1728'   22 2A01'              	SHLD	YPT		; where the lines come from, to put them back
  172B'   CD 1880'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  172E'   CD 18C3'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1731'   D2 1887'              	JNC	YNDONE
  1734'   21 1692'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1737'   C3 1763'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ; endpoint's offset, not the line's start.
  173A'                         OPYANK:
  173A'   CD 139A'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  173D'   2A 29BA'              	LHLD	OPSTA
  1740'   EB                    	XCHG			; DE = start
  1741'   2A 29BC'              	LHLD	OPEND2		; HL = end
  1744'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1747'   D2 174B'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  174A'   EB                    	XCHG			; ... otherwise the start is
  174B'                         OPY_LO:
  174B'   22 29FF'              	SHLD	YOFF
  174E'   2A 29CA'              	LHLD	OPLO
  1751'   22 2A01'              	SHLD	YPT		; where the lines come from, to put them back
  1754'   CD 1880'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1757'   CD 193B'              	CALL	YNSPAN		; copied where they lie, if there is room
  175A'   D2 1887'              	JNC	YNDONE
  175D'   21 1841'              	LXI	H,YSPAN
  1760'   C3 1763'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1763'                         YKGO:
  1763'   22 2A28'              	SHLD	YACT
  1766'   2A 2A01'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1769'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  176A'   2A 29FF'              	LHLD	YOFF		;   survive this -- the put-back below can page
  176D'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1770'   22 2A2E'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1773'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1776'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1777'   2A 2A01'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  177A'   EB                    	XCHG			;   window as it was, then names other text
  177B'   E1                    	POP	H
  177C'   CD 0000*              	CALL	SUBHD
  177F'   EB                    	XCHG			; DE = how far behind the cursor they start
  1780'   CD 0F17'              	CALL	CURFP
  1783'   06 00                 	MVI	B,0
  1785'   CD 0F0D'              	CALL	SUB24
  1788'   22 2A30'              	SHLD	YPFP
  178B'   32 2A32'              	STA	YPFP+2
  178E'   3A 298F'              	LDA	MODF
  1791'   32 29FC'              	STA	YMODF
  1794'   3A 29A8'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1797'   32 29FD'              	STA	YDCHG		;   a yank must not become the last change
  179A'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  179D'   32 29FE'              	STA	YURPL		;   back are not a change to undo either
  17A0'   3E 01                 	MVI	A,1
  17A2'   32 0000*              	STA	UNDRPL
  17A5'   32 2A27'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  17A8'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  17AB'   22 2A0A'              	SHLD	YLDLT
  17AE'   CD 0000*              	CALL	LOGLEN
  17B1'   22 2A2C'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  17B4'   2A 2A28'              	LHLD	YACT
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  17B7'   CD 1819'              	CALL	YCALL		; the lines out of the file, into the register
  17BA'   3A 29F7'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  17BD'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  17BF'   CA 17FD'              	JZ	YK_RF		;   cursor: only the flags are still owed
  17C2'   CD 0000*              	CALL	LOGLEN
  17C5'   EB                    	XCHG
  17C6'   2A 2A2C'              	LHLD	YWAS
  17C9'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  17CC'   CA 17DE'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  17CF'   21 2A30'              	LXI	H,YPFP		; back to where they came from, by its place in
  17D2'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  17D5'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  17D8'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  17DB'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  17DE'                         YK_FIN:				; (nothing came out: nothing went back, and the
  17DE'   2A 2A30'              	LHLD	YPFP		;   cursor is still owed its place)
  17E1'   EB                    	XCHG
  17E2'   2A 2A2E'              	LHLD	YCOL
  17E5'   19                    	DAD	D
  17E6'   22 2A23'              	SHLD	MKPOS
  17E9'   3A 2A32'              	LDA	YPFP+2
  17EC'   CE 00                 	ACI	0
  17EE'   32 2A25'              	STA	MKPOS+2
  17F1'   CD 03CF'              	CALL	MKPAGE
  17F4'   CD 0000*              	CALL	GOTO
  17F7'                         YK_RST:
  17F7'   2A 2A0A'              	LHLD	YLDLT
  17FA'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  17FD'                         YK_RF:
  17FD'   3A 29FC'              	LDA	YMODF
  1800'   32 298F'              	STA	MODF
  1803'   3A 29FD'              	LDA	YDCHG
  1806'   32 29A8'              	STA	DOTCHG
  1809'   3A 29FE'              	LDA	YURPL
  180C'   32 0000*              	STA	UNDRPL
  180F'   AF                    	XRA	A
  1810'   32 2A27'              	STA	MKHOLD
  1813'   CD 08CD'              	CALL	GLSTAL
  1816'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  1819'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  181A'                         QREFUS:
  181A'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  181D'   CD 1704'              	CALL	QEMPTY
  1820'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1823'   CD 0000*              	CALL	QKILL
  1826'   3A 2A27'              	LDA	MKHOLD
  1829'   B7                    	ORA	A
  182A'   C2 1839'              	JNZ	QRF_Y
  182D'   21 0000*              	LXI	H,MKSAV
  1830'   11 0000*              	LXI	D,MKTAB
  1833'   CD 205E'              	CALL	COPY12
  1836'   CD 0000*              	CALL	UNDCLR
  1839'                         QRF_Y:
  1839'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  183B'   32 29F7'              	STA	MSGWHT
  183E'   C3 123C'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1841'                         YSPAN:
  1841'   CD 08CD'              	CALL	GLSTAL
  1844'   CD 135B'              	CALL	OPSPNL		; HL = the span's length
  1847'   22 2A2A'              	SHLD	YTGT
  184A'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  184D'   EB                    	XCHG			; DE = it
  184E'   2A 2A2A'              	LHLD	YTGT
  1851'   EB                    	XCHG			; HL = the text's, DE = the span's
  1852'   CD 0000*              	CALL	SUBHD
  1855'   22 2A2A'              	SHLD	YTGT		; what the text is left at when the span is out
  1858'   2A 29CA'              	LHLD	OPLO
  185B'   CD 0000*              	CALL	GOTO
  185E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1861'                         YS_LP:
  1861'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1864'   CD 0000*              	CALL	SETC0
  1867'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  186A'   DA 181A'              	JC	QREFUS		; ... which has no room for it
  186D'   CD 0000*              	CALL	LOGLEN
  1870'   EB                    	XCHG			; DE = what is left
  1871'   2A 2A2A'              	LHLD	YTGT
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1874'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1877'   DA 187D'              	JC	YS_END		; below it -- cannot happen over whole lines,
  187A'   C2 1861'              	JNZ	YS_LP		;   but never spin here if it ever did
  187D'                         YS_END:
  187D'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1880'                         YNPRE:
  1880'   2A 0000*              	LHLD	PGTOPM
  1883'   22 2A33'              	SHLD	YNPG
  1886'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1887'                         YNDONE:
  1887'   2A 29FF'              	LHLD	YOFF
  188A'   CD 0000*              	CALL	GOTO
  188D'   2A 0000*              	LHLD	PGTOPM
  1890'   EB                    	XCHG
  1891'   2A 2A33'              	LHLD	YNPG
  1894'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1897'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  189A'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  189D'                         YNROOM:
  189D'   11 0100               	LXI	D,100H
  18A0'   19                    	DAD	D
  18A1'   D8                    	RC			; within a chunk of 64K: no arena holds that
  18A2'   E5                    	PUSH	H		; the span plus its slack
  18A3'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  18A6'   EB                    	XCHG			; HL = free
  18A7'   D1                    	POP	D		; DE = the span plus its slack
  18A8'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  18AB'   DA 18B3'              	JC	YNR_OK
  18AE'   CA 18B3'              	JZ	YNR_OK
  18B1'   37                    	STC			; not enough: the delete-and-put-back path
  18B2'   C9                    	RET
  18B3'                         YNR_OK:
  18B3'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  18B4'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  18B5'                         YNGO:
  18B5'   C5                    	PUSH	B
  18B6'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  18B9'   CD 08CD'              	CALL	GLSTAL
  18BC'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18BF'   C1                    	POP	B
  18C0'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  18C3'                         YNCOPY:
  18C3'   2A 298C'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  18C6'   7C                    	MOV	A,H		;   the count itself
  18C7'   B5                    	ORA	L
  18C8'   C2 18CE'              	JNZ	YNC_HV
  18CB'   21 0001               	LXI	H,1
  18CE'                         YNC_HV:
  18CE'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  18CF'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  18D0'   B4                    	ORA	H
  18D1'   CA 18DC'              	JZ	YNC_M
  18D4'   E5                    	PUSH	H
  18D5'   CD 0893'              	CALL	ONLAST		; vim: a count over one on the last line does
  18D8'   E1                    	POP	H		;   nothing at all, and leaves the register alone
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18D9'   DA 18EE'              	JC	YNC_RF
  18DC'                         YNC_M:
  18DC'   E5                    	PUSH	H
  18DD'   CD 0811'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  18E0'   E1                    	POP	H
  18E1'   CD 18F6'              	CALL	YNLINE		; BC = the span, measured where it stands
  18E4'   D8                    	RC			; not measurable here: let the pager answer it
  18E5'   60                    	MOV	H,B
  18E6'   69                    	MOV	L,C
  18E7'   CD 189D'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  18EA'   D8                    	RC			; no: the delete-and-put-back path
  18EB'   C3 18B5'              	JMP	YNGO
  18EE'                         YNC_RF:
  18EE'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  18F1'   CD 08CD'              	CALL	GLSTAL		;   register alone, and that is the command
  18F4'   B7                    	ORA	A		; NC: done
  18F5'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  18F6'                         YNLINE:
  18F6'   22 2A35'              	SHLD	YNCNT		; the lines it still wants
  18F9'   2A 0000*              	LHLD	GAPEND
  18FC'                         YNL_LP:
  18FC'   EB                    	XCHG			; DE = the scan
  18FD'   2A 0000*              	LHLD	TXTEND
  1900'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1903'   EB                    	XCHG			; HL = the scan
  1904'   D2 1924'              	JNC	YNL_EN		; the resident text ran out
  1907'   7E                    	MOV	A,M
  1908'   23                    	INX	H
  1909'   FE 0A                 	CPI	LF
  190B'   C2 18FC'              	JNZ	YNL_LP
  190E'   E5                    	PUSH	H
  190F'   2A 2A35'              	LHLD	YNCNT
  1912'   2B                    	DCX	H
  1913'   22 2A35'              	SHLD	YNCNT
  1916'   7C                    	MOV	A,H
  1917'   B5                    	ORA	L
  1918'   E1                    	POP	H
  1919'   C2 18FC'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  191C'   EB                    	XCHG			; DE = past the last of them
  191D'   2A 0000*              	LHLD	GAPEND
  1920'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1921'   C3 1932'              	JMP	YNL_BC
  1924'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1924'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1927'   C2 1939'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  192A'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  192D'   EB                    	XCHG			;   count clamps to it as vim's does
  192E'   2A 0000*              	LHLD	GAPEND
  1931'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1932'                         YNL_BC:
  1932'   CD 0000*              	CALL	SUBHD		; HL = the span
  1935'   44                    	MOV	B,H
  1936'   4D                    	MOV	C,L
  1937'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1938'   C9                    	RET
  1939'                         YNL_NO:
  1939'   37                    	STC
  193A'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  193B'                         YNSPAN:
  193B'   CD 135B'              	CALL	OPSPNL		; HL = the span's length
  193E'   44                    	MOV	B,H
  193F'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1940'   CD 189D'              	CALL	YNROOM
  1943'   D8                    	RC			; no room: the delete-and-put-back path
  1944'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1945'   2A 29CA'              	LHLD	OPLO
  1948'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  194B'   C1                    	POP	B
  194C'   C3 18B5'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  194F'                         VC_P:
  194F'   CD 1704'              	CALL	QEMPTY
  1952'   CA 1A0A'              	JZ	VP_BEL
  1955'   CD 068B'              	CALL	GETCNT
  1958'   22 2A03'              	SHLD	PCNT
  195B'   CD 0000*              	CALL	CUROFF
  195E'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1961'   C3 1976'              	JMP	VP_GO
  1964'                         VCB_P:
  1964'   CD 1704'              	CALL	QEMPTY
  1967'   CA 1A0A'              	JZ	VP_BEL
  196A'   CD 068B'              	CALL	GETCNT
  196D'   22 2A03'              	SHLD	PCNT
  1970'   CD 0000*              	CALL	CUROFF
  1973'   CD 05E4'              	CALL	BOL
  1976'                         VP_GO:
  1976'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1979'   CD 0000*              	CALL	CUROFF
  197C'   EB                    	XCHG
  197D'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1980'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1983'   DA 1998'              	JC	VP_IN
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1986'   EB                    	XCHG			; HL = the put point = LOGLEN
  1987'   7C                    	MOV	A,H
  1988'   B5                    	ORA	L
  1989'   CA 1995'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  198C'   2B                    	DCX	H
  198D'   CD 0000*              	CALL	CHARAT
  1990'   FE 0A                 	CPI	LF
  1992'   CA 1998'              	JZ	VP_IN
  1995'                         VP_BRK:
  1995'   CD 1509'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1998'                         VP_IN:
  1998'   CD 0000*              	CALL	CUROFF
  199B'   22 2A05'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  199E'   2A 0000*              	LHLD	QBEG
  19A1'   EB                    	XCHG
  19A2'   2A 0000*              	LHLD	QEND
  19A5'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  19A8'   EB                    	XCHG
  19A9'   22 2A07'              	SHLD	PLFS
  19AC'   2A 2A03'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  19AF'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  19B0'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  19B1'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  19B3'   C2 19B7'              	JNZ	VP_PZ
  19B6'   7D                    	MOV	A,L
  19B7'                         VP_PZ:
  19B7'   32 2A09'              	STA	PCPY
  19BA'                         VP_LP:
  19BA'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  19BD'   2A 0000*              	LHLD	LNDLT
  19C0'   EB                    	XCHG
  19C1'   2A 2A07'              	LHLD	PLFS
  19C4'   19                    	DAD	D
  19C5'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  19C8'   2A 2A03'              	LHLD	PCNT
  19CB'   2B                    	DCX	H
  19CC'   22 2A03'              	SHLD	PCNT
  19CF'   7C                    	MOV	A,H
  19D0'   B5                    	ORA	L
  19D1'   C2 19BA'              	JNZ	VP_LP
  19D4'   CD 018C'              	CALL	MARKMOD
  19D7'   2A 2A05'              	LHLD	PPT
  19DA'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  19DD'   CD 08CD'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  19E0'   3A 2A09'              	LDA	PCPY
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19E3'   B7                    	ORA	A
  19E4'   CA 0828'              	JZ	FNBLNK
  19E7'   2A 2A07'              	LHLD	PLFS
  19EA'   7C                    	MOV	A,H
  19EB'   B7                    	ORA	A
  19EC'   C2 0828'              	JNZ	FNBLNK
  19EF'   3A 2A09'              	LDA	PCPY
  19F2'   CD 0DE0'              	CALL	MULSAT		; HL = the lines this put put, saturated
  19F5'   7C                    	MOV	A,H
  19F6'   B7                    	ORA	A
  19F7'   C2 0828'              	JNZ	FNBLNK
  19FA'   7D                    	MOV	A,L
  19FB'   B7                    	ORA	A
  19FC'   CA 0828'              	JZ	FNBLNK
  19FF'   F5                    	PUSH	PSW
  1A00'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A03'   F1                    	POP	PSW
  1A04'   32 2991'              	STA	ILN		; ... which the lines put now replace
  1A07'   C3 0828'              	JMP	FNBLNK
  1A0A'                         VP_BEL:
  1A0A'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A0D'   0E 07                 	MVI	C,BEL
  1A0F'   CD 0000*              	CALL	BCONOU
  1A12'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1A15'                         VIREP:
  1A15'   78                    	MOV	A,B
  1A16'   FE 01                 	CPI	KT_ACT
  1A18'   CA 1B45'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1A1B'   FE 02                 	CPI	KT_CHAR
  1A1D'   C0                    	RNZ			; ignore anything else
  1A1E'   79                    	MOV	A,C
  1A1F'   FE 0D                 	CPI	CR
  1A21'   CA 1A85'              	JZ	VP_CR
  1A24'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A26'   CA 1A85'              	JZ	VP_CR
  1A29'   FE 08                 	CPI	BS
  1A2B'   CA 1A91'              	JZ	VP_BS
  1A2E'   FE 7F                 	CPI	DEL
  1A30'   CA 1A91'              	JZ	VP_BS
  1A33'   32 29DB'              	STA	VRCH		; the calls below do not preserve C
  1A36'   CD 0760'              	CALL	SETLIN		; this row changed
  1A39'   CD 018C'              	CALL	MARKMOD
  1A3C'   CD 14FC'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1A3F'   CA 1A77'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1A42'   3A 29DB'              	LDA	VRCH
  1A45'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1A48'   2A 29DC'              	LHLD	RPDEL
  1A4B'   7C                    	MOV	A,H
  1A4C'   B5                    	ORA	L
  1A4D'   CA 1A63'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1A50'   2A 0000*              	LHLD	GAPEND
  1A53'   EB                    	XCHG
  1A54'   2A 29E0'              	LHLD	RPGE
  1A57'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1A5A'   CA 1A63'              	JZ	VP_OVW
  1A5D'   21 0000               	LXI	H,0
  1A60'   22 29DC'              	SHLD	RPDEL		; the text moved: those originals are gone
  1A63'                         VP_OVW:
  1A63'   21 0001               	LXI	H,1
  1A66'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1A69'   2A 0000*              	LHLD	GAPEND
  1A6C'   22 29E0'              	SHLD	RPGE
  1A6F'   2A 29DC'              	LHLD	RPDEL
  1A72'   23                    	INX	H
  1A73'   22 29DC'              	SHLD	RPDEL
  1A76'   C9                    	RET
  1A77'                         VP_APP:
  1A77'   3A 29DB'              	LDA	VRCH
  1A7A'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1A7D'   2A 29DE'              	LHLD	RPAPP
  1A80'   23                    	INX	H
  1A81'   22 29DE'              	SHLD	RPAPP
  1A84'   C9                    	RET
  1A85'                         VP_CR:
  1A85'   21 0000               	LXI	H,0
  1A88'   22 29DC'              	SHLD	RPDEL		; a line break ends what BS can put back
  1A8B'   22 29DE'              	SHLD	RPAPP
  1A8E'   C3 1B1B'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1A91'                         VP_BS:
  1A91'   2A 29DE'              	LHLD	RPAPP
  1A94'   7C                    	MOV	A,H
  1A95'   B5                    	ORA	L
  1A96'   CA 1AA3'              	JZ	VP_BSD
  1A99'   2B                    	DCX	H
  1A9A'   22 29DE'              	SHLD	RPAPP		; an appended char: it just goes
  1A9D'   CD 0760'              	CALL	SETLIN
  1AA0'   C3 0000*              	JMP	DELPRV
  1AA3'                         VP_BSD:
  1AA3'   2A 29DC'              	LHLD	RPDEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AA6'   7C                    	MOV	A,H
  1AA7'   B5                    	ORA	L
  1AA8'   CA 1ACF'              	JZ	VP_BSM		; nothing of ours left
  1AAB'   2A 0000*              	LHLD	GAPEND
  1AAE'   EB                    	XCHG
  1AAF'   2A 29E0'              	LHLD	RPGE
  1AB2'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1AB5'   C2 1ACF'              	JNZ	VP_BSM
  1AB8'   2A 29DC'              	LHLD	RPDEL
  1ABB'   2B                    	DCX	H
  1ABC'   22 29DC'              	SHLD	RPDEL
  1ABF'   CD 0760'              	CALL	SETLIN
  1AC2'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1AC5'   CD 0000*              	CALL	UNDELF		; the original comes back
  1AC8'   2A 0000*              	LHLD	GAPEND
  1ACB'   22 29E0'              	SHLD	RPGE
  1ACE'   C9                    	RET
  1ACF'                         VP_BSM:
  1ACF'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1AD2'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1AD5'                         VIINS:
  1AD5'   78                    	MOV	A,B
  1AD6'   FE 01                 	CPI	KT_ACT
  1AD8'   CA 1B45'              	JZ	VI_ACT
  1ADB'   FE 02                 	CPI	KT_CHAR
  1ADD'   C0                    	RNZ			; ignore anything else
  1ADE'   79                    	MOV	A,C
  1ADF'   FE 0D                 	CPI	CR
  1AE1'   CA 1B1B'              	JZ	VI_CR
  1AE4'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1AE6'   CA 1B1B'              	JZ	VI_CR
  1AE9'   FE 08                 	CPI	BS
  1AEB'   CA 1B33'              	JZ	VI_BS
  1AEE'   FE 7F                 	CPI	DEL
  1AF0'   CA 1B33'              	JZ	VI_BS
  1AF3'   79                    	MOV	A,C
  1AF4'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1AF7'   CD 018C'              	CALL	MARKMOD
  1AFA'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1AFD'   79                    	MOV	A,C
  1AFE'   FE 20                 	CPI	' '
  1B00'   D8                    	RC			; control char -> keep R_LINE
  1B01'   FE 7F                 	CPI	DEL
  1B03'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B04'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B07'   B7                    	ORA	A
  1B08'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B09'   3E 04                 	MVI	A,R_ICH
  1B0B'   32 2990'              	STA	RINTENT
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B0E'   CD 14FC'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B11'   3E 00                 	MVI	A,0
  1B13'   C2 1B17'              	JNZ	VI_ICH
  1B16'   3C                    	INR	A
  1B17'                         VI_ICH:
  1B17'   32 2992'              	STA	ICHAPP
  1B1A'   C9                    	RET
  1B1B'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1B1B'   CD 14FC'              	CALL	ATCEND
  1B1E'   3E 00                 	MVI	A,0
  1B20'   CA 1B24'              	JZ	VI_CRS
  1B23'   3C                    	INR	A
  1B24'                         VI_CRS:
  1B24'   F5                    	PUSH	PSW
  1B25'   CD 1509'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1B28'   CD 1516'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1B2B'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1B2E'   F1                    	POP	PSW
  1B2F'   32 2993'              	STA	ILABOV
  1B32'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1B33'                         VI_BS:
  1B33'   CD 0000*              	CALL	PEEKL
  1B36'   D8                    	RC			; start of the file: nothing to delete
  1B37'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1B39'   CA 1B3F'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1B3C'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1B3F'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1B3F'   CD 018C'              	CALL	MARKMOD
  1B42'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1B45'                         VI_ACT:
  1B45'   79                    	MOV	A,C
  1B46'   FE 0B                 	CPI	ACT_ESC
  1B48'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1B49'   3E 00                 	MVI	A,EM_CMD
  1B4B'   32 298B'              	STA	EDMODE
  1B4E'   CD 075A'              	CALL	SETMOV
  1B51'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1B54'   C3 08CD'              	JMP	GLSTAL
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1B57'                         RDLINE:
  1B57'   EB                    	XCHG			; HL = buffer
  1B58'   22 29E2'              	SHLD	RLPTR
  1B5B'   3E 00                 	MVI	A,0
  1B5D'   32 29E4'              	STA	RLLEN
  1B60'   78                    	MOV	A,B
  1B61'   32 29E5'              	STA	RLMAX
  1B64'   79                    	MOV	A,C
  1B65'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1B68'                         RL_LP:
  1B68'   CD 0000*              	CALL	GETKEY
  1B6B'   78                    	MOV	A,B
  1B6C'   FE 01                 	CPI	KT_ACT
  1B6E'   CA 1BC4'              	JZ	RL_ACT
  1B71'   FE 02                 	CPI	KT_CHAR
  1B73'   C2 1B68'              	JNZ	RL_LP		; ignore other keys
  1B76'   79                    	MOV	A,C
  1B77'   FE 0D                 	CPI	CR
  1B79'   CA 1BD5'              	JZ	RL_DONE
  1B7C'   FE 08                 	CPI	BS
  1B7E'   CA 1BAC'              	JZ	RL_BS
  1B81'   FE 7F                 	CPI	DEL
  1B83'   CA 1BAC'              	JZ	RL_BS
  1B86'   FE 20                 	CPI	' '
  1B88'   DA 1B68'              	JC	RL_LP		; control char -> ignore
  1B8B'   3A 29E4'              	LDA	RLLEN
  1B8E'   47                    	MOV	B,A
  1B8F'   3A 29E5'              	LDA	RLMAX
  1B92'   B8                    	CMP	B
  1B93'   CA 1B68'              	JZ	RL_LP		; full -> ignore
  1B96'   2A 29E2'              	LHLD	RLPTR
  1B99'   71                    	MOV	M,C
  1B9A'   23                    	INX	H
  1B9B'   22 29E2'              	SHLD	RLPTR
  1B9E'   3A 29E4'              	LDA	RLLEN
  1BA1'   3C                    	INR	A
  1BA2'   32 29E4'              	STA	RLLEN
  1BA5'   79                    	MOV	A,C
  1BA6'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1BA9'   C3 1B68'              	JMP	RL_LP
  1BAC'                         RL_BS:				; WM LINEPOP
  1BAC'   3A 29E4'              	LDA	RLLEN
  1BAF'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BB0'   CA 1BCA'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1BB3'   3D                    	DCR	A
  1BB4'   32 29E4'              	STA	RLLEN
  1BB7'   2A 29E2'              	LHLD	RLPTR
  1BBA'   2B                    	DCX	H
  1BBB'   22 29E2'              	SHLD	RLPTR
  1BBE'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1BC1'   C3 1B68'              	JMP	RL_LP
  1BC4'                         RL_ACT:
  1BC4'   79                    	MOV	A,C
  1BC5'   FE 0B                 	CPI	ACT_ESC
  1BC7'   C2 1B68'              	JNZ	RL_LP
  1BCA'                         RL_CAN:
  1BCA'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1BCC'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1BCF'   CD 0760'              	CALL	SETLIN		; redraw one row
  1BD2'   3E FF                 	MVI	A,0FFH		; cancelled
  1BD4'   C9                    	RET
  1BD5'                         RL_DONE:
  1BD5'   AF                    	XRA	A
  1BD6'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1BD7'                         VC_BZ:
  1BD7'   CD 075A'              	CALL	SETMOV
  1BDA'   3A 29B4'              	LDA	GSAVE
  1BDD'   FE 02                 	CPI	PZ
  1BDF'   CA 1BEA'              	JZ	VZ_ZZ
  1BE2'   B7                    	ORA	A
  1BE3'   C0                    	RNZ			; 'g' was pending: vim drops both
  1BE4'   3E 02                 	MVI	A,PZ
  1BE6'   32 29B3'              	STA	GPEND
  1BE9'   C9                    	RET
  1BEA'                         VZ_ZZ:
  1BEA'   3E 04                 	MVI	A,EO_X
  1BEC'   32 29E6'              	STA	EXOP
  1BEF'   3E 01                 	MVI	A,1
  1BF1'   32 29F9'              	STA	EXBANG		; no '!'
  1BF4'   AF                    	XRA	A
  1BF5'   32 29E7'              	STA	EXARG		; no file name
  1BF8'   3A 298F'              	LDA	MODF		; as ':x': a changed text is written first
  1BFB'   B7                    	ORA	A
  1BFC'   CA 1D3D'              	JZ	EX_Q
  1BFF'   C3 1CD7'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C02'                         VC_EX:
  1C02'   CD 068B'              	CALL	GETCNT
  1C05'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C08'   11 0000*              	LXI	D,EXBUF
  1C0B'   06 28                 	MVI	B,EXMAX
  1C0D'   0E 3A                 	MVI	C,':'
  1C0F'   CD 1B57'              	CALL	RDLINE
  1C12'   B7                    	ORA	A
  1C13'   C0                    	RNZ			; cancelled
  1C14'   3A 29E4'              	LDA	RLLEN
  1C17'   5F                    	MOV	E,A
  1C18'   16 00                 	MVI	D,0
  1C1A'   21 0000*              	LXI	H,EXBUF
  1C1D'   19                    	DAD	D
  1C1E'   36 00                 	MVI	M,0		; the line ends with a 0
  1C20'   21 0000*              	LXI	H,EXBUF
  1C23'   CD 21F3'              	CALL	SKIPB
  1C26'   C8                    	RZ			; nothing on it
  1C27'   22 29E9'              	SHLD	EXCMD
  1C2A'   CD 23E7'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1C2D'   CD 21F3'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1C30'   56                    	MOV	D,M
  1C31'   23                    	INX	H
  1C32'   1E 00                 	MVI	E,0
  1C34'   CD 21FF'              	CALL	ISLOW
  1C37'   DA 1C42'              	JC	EX_LK
  1C3A'   5F                    	MOV	E,A
  1C3B'   23                    	INX	H
  1C3C'   CD 21FF'              	CALL	ISLOW
  1C3F'   D2 1C5B'              	JNC	EX_NOT		; a third letter: none of ours
  1C42'                         EX_LK:
  1C42'   E5                    	PUSH	H
  1C43'   21 23CE'              	LXI	H,EXTAB
  1C46'                         EX_TL:
  1C46'   7E                    	MOV	A,M
  1C47'   B7                    	ORA	A
  1C48'   CA 1C5A'              	JZ	EX_NTP		; not in the table
  1C4B'   23                    	INX	H
  1C4C'   BA                    	CMP	D
  1C4D'   7E                    	MOV	A,M
  1C4E'   23                    	INX	H
  1C4F'   C2 1C56'              	JNZ	EX_TN
  1C52'   BB                    	CMP	E
  1C53'   CA 1C61'              	JZ	EX_TF
  1C56'                         EX_TN:
  1C56'   23                    	INX	H
  1C57'   C3 1C46'              	JMP	EX_TL
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C5A'                         EX_NTP:
  1C5A'   E1                    	POP	H
  1C5B'                         EX_NOT:
  1C5B'   21 22B7'              	LXI	H,SNOT
  1C5E'   C3 2234'              	JMP	EXERT
  1C61'                         EX_TF:
  1C61'   7E                    	MOV	A,M
  1C62'   32 29E6'              	STA	EXOP
  1C65'   E1                    	POP	H
  1C66'   FE 06                 	CPI	EO_S
  1C68'   CA 2456'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1C6B'   FE 01                 	CPI	EO_W
  1C6D'   CA 1C7C'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1C70'   FE 08                 	CPI	EO_R
  1C72'   CA 1C7C'              	JZ	EX_RG		; ... and ':Nr name' a line
  1C75'   3A 2A41'              	LDA	SRNGF
  1C78'   B7                    	ORA	A
  1C79'   C2 1C5B'              	JNZ	EX_NOT		; a range on a command that does not take one
  1C7C'                         EX_RG:
                                	;--- '!', then the file name ---
  1C7C'   7E                    	MOV	A,M
  1C7D'   D6 21                 	SUI	'!'
  1C7F'   32 29F9'              	STA	EXBANG		; 0 = '!'
  1C82'   C2 1C86'              	JNZ	EX_NB
  1C85'   23                    	INX	H
  1C86'                         EX_NB:
  1C86'   CD 21F3'              	CALL	SKIPB
  1C89'   32 29E7'              	STA	EXARG		; 0 = no file name
  1C8C'   CA 1CA5'              	JZ	EX_RUN
  1C8F'   22 29E9'              	SHLD	EXCMD
  1C92'   3A 29E6'              	LDA	EXOP
  1C95'   FE 02                 	CPI	EO_Q
  1C97'   CA 2231'              	JZ	EX_TRL		; :q takes none
  1C9A'   FE 07                 	CPI	EO_V
  1C9C'   CA 2231'              	JZ	EX_TRL		; nor :ve
  1C9F'   CD 215D'              	CALL	PARSFN
  1CA2'   C2 2225'              	JNZ	EX_INV
  1CA5'                         EX_RUN:
  1CA5'   3A 29E6'              	LDA	EXOP
  1CA8'   FE 05                 	CPI	EO_E
  1CAA'   CA 1D54'              	JZ	EX_E
  1CAD'   FE 02                 	CPI	EO_Q
  1CAF'   CA 1D3D'              	JZ	EX_Q
  1CB2'   FE 07                 	CPI	EO_V
  1CB4'   CA 222B'              	JZ	EX_V
  1CB7'   FE 08                 	CPI	EO_R
  1CB9'   CA 1EE5'              	JZ	EX_R
  1CBC'   FE 04                 	CPI	EO_X
  1CBE'   CA 1CD0'              	JZ	EX_XM
  1CC1'   FE 01                 	CPI	EO_W
  1CC3'   C2 1CD7'              	JNZ	EX_W		; :wq
  1CC6'   3A 2A41'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1CC9'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1CCA'   C2 1E05'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1CCD'   C3 1CD7'              	JMP	EX_W
  1CD0'                         EX_XM:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1CD0'   3A 298F'              	LDA	MODF		; :x writes only a changed text
  1CD3'   B7                    	ORA	A
  1CD4'   CA 1D3D'              	JZ	EX_Q
  1CD7'                         EX_W:
  1CD7'   CD 1FC5'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1CDA'   D8                    	RC			; refused (message shown)
  1CDB'   32 29E8'              	STA	EXBAK
  1CDE'   3A 29E6'              	LDA	EXOP
  1CE1'   FE 01                 	CPI	EO_W
  1CE3'   CA 1CFA'              	JZ	EX_WK
  1CE6'   3A 29E8'              	LDA	EXBAK
  1CE9'   B7                    	ORA	A
  1CEA'   C2 1D3A'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1CED'   3A 29F9'              	LDA	EXBANG
  1CF0'   B7                    	ORA	A
  1CF1'   CA 1D3A'              	JZ	EX_WQ		; so it does with '!'
  1CF4'   CD 1CFA'              	CALL	EX_WK		; else it may not: keep the text
  1CF7'   C3 1D3D'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1CFA'                         EX_WK:
  1CFA'   CD 0CEC'              	CALL	CURRW		; the cursor's row and file position
  1CFD'   32 29EB'              	STA	WPROW
  1D00'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D03'   7D                    	MOV	A,L
  1D04'   E6 7F                 	ANI	7FH
  1D06'   32 29EC'              	STA	WPBYT
  1D09'   7D                    	MOV	A,L
  1D0A'   17                    	RAL
  1D0B'   7C                    	MOV	A,H
  1D0C'   17                    	RAL
  1D0D'   5F                    	MOV	E,A
  1D0E'   3E 00                 	MVI	A,0
  1D10'   17                    	RAL
  1D11'   57                    	MOV	D,A		; DE = HL / 128
  1D12'   2A 0000*              	LHLD	OUTPOS
  1D15'   19                    	DAD	D
  1D16'   22 29ED'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1D19'   CD 1FFA'              	CALL	WRITE
  1D1C'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1D1F'   2A 29ED'              	LHLD	WPREC
  1D22'   EB                    	XCHG
  1D23'   3A 29EC'              	LDA	WPBYT
  1D26'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1D29'   CD 0000*              	CALL	GOTO
  1D2C'                         EX_WRW:
  1D2C'   21 0000               	LXI	H,0
  1D2F'   22 0000*              	SHLD	LNDLT
  1D32'   3A 29EB'              	LDA	WPROW
  1D35'   6F                    	MOV	L,A
  1D36'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1D39'   C9                    	RET
  1D3A'                         EX_WQ:
  1D3A'   CD 1FFA'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1D3D'                         EX_Q:
  1D3D'   3A 29F9'              	LDA	EXBANG
  1D40'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D41'   CA 1D4B'              	JZ	EX_QT
  1D44'   3A 298F'              	LDA	MODF
  1D47'   B7                    	ORA	A
  1D48'   C2 2219'              	JNZ	MSGNWR		; changed, no '!': stay
  1D4B'                         EX_QT:
  1D4B'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1D4E'   3E 01                 	MVI	A,1
  1D50'   32 298E'              	STA	QUITF
  1D53'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1D54'                         EX_E:
  1D54'   3A 29F9'              	LDA	EXBANG
  1D57'   B7                    	ORA	A
  1D58'   CA 1D62'              	JZ	EE_GO
  1D5B'   3A 298F'              	LDA	MODF
  1D5E'   B7                    	ORA	A
  1D5F'   C2 2219'              	JNZ	MSGNWR
  1D62'                         EE_GO:
  1D62'   3A 29E7'              	LDA	EXARG
  1D65'   B7                    	ORA	A
  1D66'   C2 1D6D'              	JNZ	EE_ARG
  1D69'   CD 2036'              	CALL	OWNTF		; no name: the buffer's own
  1D6C'   D8                    	RC
  1D6D'                         EE_ARG:
  1D6D'   CD 204C'              	CALL	ISOWN
  1D70'   21 0001               	LXI	H,1
  1D73'   C2 1D7A'              	JNZ	EE_LD		; another file: its first line
  1D76'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1D79'   23                    	INX	H		; HL = the cursor's line
  1D7A'                         EE_LD:
  1D7A'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1D7C'   32 29F7'              	STA	MSGWHT
  1D7F'   E5                    	PUSH	H
  1D80'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1D83'   21 0000*              	LXI	H,TFCB
  1D86'   11 0000*              	LXI	D,FNAME
  1D89'   CD 205E'              	CALL	COPY12		; the buffer's name
  1D8C'   CD 2023'              	CALL	SRCTF
  1D8F'   CD 0000*              	CALL	REOPEN
  1D92'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1D95'   AF                    	XRA	A
  1D96'   32 298F'              	STA	MODF
  1D99'   E1                    	POP	H
  1D9A'   2B                    	DCX	H
  1D9B'   AF                    	XRA	A
  1D9C'   CD 0000*              	CALL	MVLIND		; down to the line
  1D9F'   CD 0A04'              	CALL	ATEOF
  1DA2'   DC 0A0A'              	CC	LASTLN		; past the last line: onto it
  1DA5'   CD 0F3A'              	CALL	ZSAVE
  1DA8'   C3 101D'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1DAB'                         TFDOS:
  1DAB'   C5                    	PUSH	B
  1DAC'   11 0080               	LXI	D,CMDTAIL
  1DAF'   0E 1A                 	MVI	C,1AH		; set the DMA
  1DB1'   CD 0005               	CALL	BDOS
  1DB4'   C1                    	POP	B
  1DB5'   11 0000*              	LXI	D,TFCB
  1DB8'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1DBB'                         EXRNG:
  1DBB'   2A 2A42'              	LHLD	SRNG1
  1DBE'   7C                    	MOV	A,H
  1DBF'   B5                    	ORA	L
  1DC0'   37                    	STC
  1DC1'   C8                    	RZ
  1DC2'   2A 2A44'              	LHLD	SRNG2
  1DC5'   EB                    	XCHG
  1DC6'   2A 2A42'              	LHLD	SRNG1
  1DC9'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1DCC'   D8                    	RC
  1DCD'   EB                    	XCHG			; HL = the last line, DE = the first
  1DCE'   CD 0000*              	CALL	SUBHD
  1DD1'   23                    	INX	H
  1DD2'   22 2A4C'              	SHLD	SLINES
  1DD5'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1DD6'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1DD7'                         GOLNX:
  1DD7'   E5                    	PUSH	H
  1DD8'   CD 0ECE'              	CALL	GOLN
  1DDB'   CD 0000*              	CALL	CNTLF
  1DDE'   23                    	INX	H		; the line the cursor came to rest on
  1DDF'   D1                    	POP	D
  1DE0'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1DE3'                         EXSAVP:
  1DE3'   CD 0CEC'              	CALL	CURRW
  1DE6'   32 29EB'              	STA	WPROW
  1DE9'   21 2A23'              	LXI	H,MKPOS
  1DEC'   C3 044F'              	JMP	FPSTO
  1DEF'                         EXRSTP:
  1DEF'   CD 0000*              	CALL	CLRCNT
  1DF2'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1DF5'   CD 0000*              	CALL	GOTO
  1DF8'   C3 1D2C'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1DFB'                         PUTBRK:
  1DFB'   3E 0D                 	MVI	A,CR
  1DFD'   CD 0000*              	CALL	PUTGAP
  1E00'   3E 0A                 	MVI	A,LF
  1E02'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E05'                         EX_WR:
  1E05'   3A 29E7'              	LDA	EXARG
  1E08'   B7                    	ORA	A
  1E09'   CA 2207'              	JZ	MSGNFN		; No file name
  1E0C'   CD 204C'              	CALL	ISOWN
  1E0F'   CA 1EAF'              	JZ	EXW_OW
  1E12'   CD 0000*              	CALL	TEXIST
  1E15'   32 2A4F'              	STA	RWERR		; nonzero: a file of that name is there
  1E18'   CA 1E22'              	JZ	EXW_GO
  1E1B'   3A 29F9'              	LDA	EXBANG
  1E1E'   B7                    	ORA	A
  1E1F'   C2 220D'              	JNZ	MSGEXI		; File exists (! to force)
  1E22'                         EXW_GO:
  1E22'   CD 1DBB'              	CALL	EXRNG
  1E25'   DA 1EA9'              	JC	EXW_BD
  1E28'   CD 1DE3'              	CALL	EXSAVP
  1E2B'   2A 2A42'              	LHLD	SRNG1
  1E2E'   CD 1DD7'              	CALL	GOLNX
  1E31'   C2 1EA6'              	JNZ	EXW_NL		; the text has no line N
  1E34'   3A 2A4F'              	LDA	RWERR		; a delete scans the whole directory, there or
  1E37'   B7                    	ORA	A		;   not: only when TEXIST found one
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E38'   0E 13                 	MVI	C,13H
  1E3A'   C4 1DAB'              	CNZ	TFDOS		; delete what is there
  1E3D'   0E 16                 	MVI	C,16H
  1E3F'   CD 1DAB'              	CALL	TFDOS		; ... and make it
  1E42'   3C                    	INR	A
  1E43'   CA 1E98'              	JZ	EXW_FL		; no directory entry left
  1E46'   3E 80                 	MVI	A,80H
  1E48'   32 2A4E'              	STA	RWPTR
  1E4B'   AF                    	XRA	A
  1E4C'   32 2A4F'              	STA	RWERR
  1E4F'   2A 2A4C'              	LHLD	SLINES
  1E52'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1E55'                         EXW_LP:
  1E55'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1E58'   E5                    	PUSH	H
  1E59'   EB                    	XCHG
  1E5A'   2A 0000*              	LHLD	GAPEND
  1E5D'   CD 1EB5'              	CALL	RWOUT		; the text from the cursor to there
  1E60'   E1                    	POP	H
  1E61'   3A 2A4F'              	LDA	RWERR
  1E64'   B7                    	ORA	A
  1E65'   C2 1E81'              	JNZ	EXW_EN
  1E68'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1E6B'   CD 06A0'              	CALL	CNTTST
  1E6E'   C2 1E55'              	JNZ	EXW_LP
  1E71'                         EXW_PD:				; the last record is padded out with ^Z
  1E71'   3A 2A4E'              	LDA	RWPTR
  1E74'   FE 80                 	CPI	80H
  1E76'   CA 1E81'              	JZ	EXW_EN
  1E79'   3E 1A                 	MVI	A,CPMEOF
  1E7B'   CD 1EC1'              	CALL	RWPUT
  1E7E'   C3 1E71'              	JMP	EXW_PD
  1E81'                         EXW_EN:
  1E81'   0E 10                 	MVI	C,10H
  1E83'   CD 1DAB'              	CALL	TFDOS		; close
  1E86'   3A 2A4F'              	LDA	RWERR
  1E89'   B7                    	ORA	A
  1E8A'   C2 1E98'              	JNZ	EXW_FL
  1E8D'   CD 1DEF'              	CALL	EXRSTP
  1E90'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1E92'   32 29F7'              	STA	MSGWHT
  1E95'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1E98'                         EXW_FL:				; no room: the part written is not left behind
  1E98'   0E 13                 	MVI	C,13H
  1E9A'   CD 1DAB'              	CALL	TFDOS
  1E9D'   CD 1DEF'              	CALL	EXRSTP
  1EA0'   21 23C4'              	LXI	H,SDFUL
  1EA3'   C3 223F'              	JMP	EXERR
  1EA6'                         EXW_NL:
  1EA6'   CD 1DEF'              	CALL	EXRSTP
  1EA9'                         EXW_BD:
  1EA9'   21 23B6'              	LXI	H,SRNGE
  1EAC'   C3 223F'              	JMP	EXERR
  1EAF'                         EXW_OW:
  1EAF'   21 226E'              	LXI	H,SEXI
  1EB2'   C3 223F'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1EB5'                         RWOUT:
  1EB5'   CD 0000*              	CALL	CMP16
  1EB8'   C8                    	RZ
  1EB9'   7E                    	MOV	A,M
  1EBA'   23                    	INX	H
  1EBB'   CD 1EC1'              	CALL	RWPUT
  1EBE'   C3 1EB5'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1EC1'                         RWPUT:
  1EC1'   E5                    	PUSH	H
  1EC2'   F5                    	PUSH	PSW
  1EC3'   3A 2A4E'              	LDA	RWPTR
  1EC6'   6F                    	MOV	L,A
  1EC7'   26 00                 	MVI	H,0
  1EC9'   F1                    	POP	PSW
  1ECA'   77                    	MOV	M,A
  1ECB'   2C                    	INR	L		; Z: that was the record's last byte
  1ECC'   7D                    	MOV	A,L
  1ECD'   C2 1EE0'              	JNZ	RWP_ST
  1ED0'   D5                    	PUSH	D
  1ED1'   0E 15                 	MVI	C,15H
  1ED3'   CD 1DAB'              	CALL	TFDOS		; write it
  1ED6'   D1                    	POP	D
  1ED7'   B7                    	ORA	A
  1ED8'   CA 1EDE'              	JZ	RWP_OK
  1EDB'   32 2A4F'              	STA	RWERR
  1EDE'                         RWP_OK:
  1EDE'   3E 80                 	MVI	A,80H
  1EE0'                         RWP_ST:
  1EE0'   32 2A4E'              	STA	RWPTR
  1EE3'   E1                    	POP	H
  1EE4'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1EE5'                         EX_R:
  1EE5'   3A 29E7'              	LDA	EXARG
  1EE8'   B7                    	ORA	A
  1EE9'   CA 2207'              	JZ	MSGNFN		; No file name
  1EEC'   0E 0F                 	MVI	C,0FH
  1EEE'   CD 1DAB'              	CALL	TFDOS		; open
  1EF1'   3C                    	INR	A
  1EF2'   CA 1FBF'              	JZ	ER_NOF
  1EF5'   CD 0F60'              	CALL	GZONE		; the screen's top line, before anything moves
  1EF8'   CD 1DE3'              	CALL	EXSAVP
  1EFB'   3A 2A41'              	LDA	SRNGF
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EFE'   B7                    	ORA	A
  1EFF'   CA 1F18'              	JZ	ER_NXT		; no line given: below the cursor's
  1F02'   2A 2A44'              	LHLD	SRNG2
  1F05'   7C                    	MOV	A,H
  1F06'   B5                    	ORA	L
  1F07'   C2 1F12'              	JNZ	ER_LN
  1F0A'   23                    	INX	H
  1F0B'   CD 0ECE'              	CALL	GOLN		; ':0r': above line 1 ...
  1F0E'   AF                    	XRA	A		;   which never wants a line end put in first
  1F0F'   C3 1F3A'              	JMP	ER_BRK
  1F12'                         ER_LN:
  1F12'   CD 1DD7'              	CALL	GOLNX
  1F15'   C2 1EA6'              	JNZ	EXW_NL		; the text has no line N
  1F18'                         ER_NXT:
  1F18'   21 0001               	LXI	H,1
  1F1B'   AF                    	XRA	A
  1F1C'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1F1F'   CD 0A04'              	CALL	ATEOF
  1F22'   3E 00                 	MVI	A,0
  1F24'   D2 1F3A'              	JNC	ER_BRK		; text follows
  1F27'   2A 0000*              	LHLD	GAPBEG
  1F2A'   EB                    	XCHG
  1F2B'   2A 0000*              	LHLD	TXTBEG
  1F2E'   CD 0000*              	CALL	CMP16
  1F31'   3E 01                 	MVI	A,1
  1F33'   CA 1F3A'              	JZ	ER_BRK		; nothing before the cursor either
  1F36'   1B                    	DCX	D
  1F37'   1A                    	LDAX	D
  1F38'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1F3A'                         ER_BRK:
  1F3A'   32 2A51'              	STA	RDBRK
  1F3D'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1F40'   AF                    	XRA	A
  1F41'   32 2A50'              	STA	RDANY
  1F44'                         ER_LP:
  1F44'   0E 14                 	MVI	C,14H
  1F46'   CD 1DAB'              	CALL	TFDOS		; the next record
  1F49'   B7                    	ORA	A
  1F4A'   C2 1F7D'              	JNZ	ER_END
  1F4D'   21 0080               	LXI	H,CMDTAIL
  1F50'   0E 00                 	MVI	C,0
  1F52'                         ER_SC:				; C = its bytes, up to a ^Z
  1F52'   7E                    	MOV	A,M
  1F53'   FE 1A                 	CPI	CPMEOF
  1F55'   CA 1F5D'              	JZ	ER_GOT
  1F58'   23                    	INX	H
  1F59'   0C                    	INR	C
  1F5A'   F2 1F52'              	JP	ER_SC		; (minus: all 128)
  1F5D'                         ER_GOT:
  1F5D'   79                    	MOV	A,C
  1F5E'   B7                    	ORA	A
  1F5F'   CA 1F7D'              	JZ	ER_END
  1F62'   C5                    	PUSH	B
  1F63'   3A 2A50'              	LDA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F66'   B7                    	ORA	A
  1F67'   CC 1FAE'              	CZ	ER_1ST
  1F6A'   C1                    	POP	B
  1F6B'   06 00                 	MVI	B,0
  1F6D'   11 0080               	LXI	D,CMDTAIL
  1F70'   C5                    	PUSH	B
  1F71'   CD 0000*              	CALL	INSBLK
  1F74'   C1                    	POP	B
  1F75'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1F78'   79                    	MOV	A,C
  1F79'   17                    	RAL
  1F7A'   DA 1F44'              	JC	ER_LP		; a full record: there may be more
  1F7D'                         ER_END:
  1F7D'   3A 2A50'              	LDA	RDANY
  1F80'   B7                    	ORA	A
  1F81'   CA 1F9F'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1F84'   CD 0A04'              	CALL	ATEOF
  1F87'   DA 1F94'              	JC	ER_MD		; the text now ends as the file read ends
  1F8A'   2A 0000*              	LHLD	GAPBEG
  1F8D'   2B                    	DCX	H
  1F8E'   7E                    	MOV	A,M
  1F8F'   FE 0A                 	CPI	LF
  1F91'   C4 1DFB'              	CNZ	PUTBRK		; text follows: what was read ends a line
  1F94'                         ER_MD:
  1F94'   3E 01                 	MVI	A,1
  1F96'   32 298F'              	STA	MODF
  1F99'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  1F9C'   CD 0000*              	CALL	GOTO
  1F9F'                         ER_PL:
  1F9F'   CD 0A04'              	CALL	ATEOF
  1FA2'   DC 0A0A'              	CC	LASTLN		; (nothing read, at the end: the last line)
  1FA5'   CD 0000*              	CALL	CLRCNT
  1FA8'   CD 0F78'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  1FAB'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  1FAE'                         ER_1ST:
  1FAE'   3C                    	INR	A
  1FAF'   32 2A50'              	STA	RDANY
  1FB2'   3A 2A51'              	LDA	RDBRK
  1FB5'   B7                    	ORA	A
  1FB6'   C4 1DFB'              	CNZ	PUTBRK
  1FB9'   21 2A23'              	LXI	H,MKPOS
  1FBC'   C3 044F'              	JMP	FPSTO
  1FBF'                         ER_NOF:
  1FBF'   21 23A5'              	LXI	H,SNOPN
  1FC2'   C3 2234'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1FC5'                         WRCHK:
  1FC5'   3A 29E7'              	LDA	EXARG
  1FC8'   B7                    	ORA	A
  1FC9'   C2 1FD3'              	JNZ	WC_ARG
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FCC'   CD 2036'              	CALL	OWNTF
  1FCF'   D8                    	RC
  1FD0'   C3 1FE8'              	JMP	WC_OWN
  1FD3'                         WC_ARG:
  1FD3'   CD 204C'              	CALL	ISOWN
  1FD6'   CA 1FE8'              	JZ	WC_OWN
  1FD9'   3A 29F9'              	LDA	EXBANG
  1FDC'   B7                    	ORA	A
  1FDD'   CA 1FE6'              	JZ	WC_OTH
  1FE0'   CD 0000*              	CALL	TEXIST
  1FE3'   C2 220D'              	JNZ	MSGEXI		; File exists (! to force)
  1FE6'                         WC_OTH:
  1FE6'   AF                    	XRA	A		; (NC)
  1FE7'   C9                    	RET
  1FE8'                         WC_OWN:
  1FE8'   3A 29FA'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1FEB'   B7                    	ORA	A
  1FEC'   CA 1FF6'              	JZ	WC_OK
  1FEF'   3A 29F9'              	LDA	EXBANG
  1FF2'   B7                    	ORA	A
  1FF3'   C2 2213'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1FF6'                         WC_OK:
  1FF6'   3E 01                 	MVI	A,1
  1FF8'   B7                    	ORA	A		; (NC)
  1FF9'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1FFA'                         WRITE:
  1FFA'   3A 29E8'              	LDA	EXBAK
  1FFD'   CD 0000*              	CALL	WRTO
  2000'   3A 0001*              	LDA	FNAME+1
  2003'   FE 20                 	CPI	' '
  2005'   C2 2011'              	JNZ	WR_HAS
  2008'   21 0000*              	LXI	H,TFCB
  200B'   11 0000*              	LXI	D,FNAME
  200E'   CD 205E'              	CALL	COPY12
  2011'                         WR_HAS:
  2011'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2013'   32 29F7'              	STA	MSGWHT
  2016'   CD 204C'              	CALL	ISOWN
  2019'   C2 2023'              	JNZ	SRCTF
  201C'   AF                    	XRA	A
  201D'   32 298F'              	STA	MODF
  2020'   32 29F8'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  2023'                         SRCTF:
  2023'   21 0000*              	LXI	H,TFCB
  2026'   11 005C               	LXI	D,DFTFCB
  2029'   CD 205E'              	CALL	COPY12
  202C'   AF                    	XRA	A
  202D'   06 04                 	MVI	B,4
  202F'                         SRC_Z:
  202F'   12                    	STAX	D		; extent, s1, s2, record count: 0
  2030'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2031'   05                    	DCR	B
  2032'   C2 202F'              	JNZ	SRC_Z
  2035'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2036'                         OWNTF:
  2036'   3A 0001*              	LDA	FNAME+1
  2039'   FE 20                 	CPI	' '
  203B'   CA 2207'              	JZ	MSGNFN
  203E'   CD 2069'              	CALL	TFCLR
  2041'   21 0000*              	LXI	H,FNAME
  2044'   11 0000*              	LXI	D,TFCB
  2047'   CD 205E'              	CALL	COPY12
  204A'   B7                    	ORA	A		; (NC)
  204B'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  204C'                         ISOWN:
  204C'   21 0000*              	LXI	H,TFCB
  204F'   11 0000*              	LXI	D,FNAME
  2052'   06 0C                 	MVI	B,12
  2054'                         IO_LP:
  2054'   1A                    	LDAX	D
  2055'   BE                    	CMP	M
  2056'   C0                    	RNZ
  2057'   23                    	INX	H
  2058'   13                    	INX	D
  2059'   05                    	DCR	B
  205A'   C2 2054'              	JNZ	IO_LP
  205D'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  205E'                         COPY12:
  205E'   06 0C                 	MVI	B,12
  2060'                         CP_LP:
  2060'   7E                    	MOV	A,M
  2061'   12                    	STAX	D
  2062'   23                    	INX	H
  2063'   13                    	INX	D
  2064'   05                    	DCR	B
  2065'   C2 2060'              	JNZ	CP_LP
  2068'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  2069'                         TFCLR:
  2069'   11 0000*              	LXI	D,TFCB
  206C'   06 24                 	MVI	B,36
  206E'   AF                    	XRA	A
  206F'                         TC_LP:
  206F'   12                    	STAX	D
  2070'   13                    	INX	D
  2071'   05                    	DCR	B
  2072'   C2 206F'              	JNZ	TC_LP
  2075'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2076'                         FOPEN:
  2076'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2078'   32 29F7'              	STA	MSGWHT
  207B'   21 005C               	LXI	H,DFTFCB
  207E'   CD 2150'              	CALL	NRMDRV
  2081'   11 0000*              	LXI	D,FNAME
  2084'   CD 205E'              	CALL	COPY12
  2087'   CD 0000*              	CALL	OPENZ
  208A'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  208D'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  208F'   C8                    	RZ
  2090'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2093'   32 29F8'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2096'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2097'                         ARGSCN:
  2097'   3A 0080               	LDA	CMDTAIL
  209A'   47                    	MOV	B,A		; B = what is left of the line
  209B'   B7                    	ORA	A
  209C'   C8                    	RZ
  209D'   21 0081               	LXI	H,CMDTAIL+1
  20A0'                         AS_TOK:				; at a token, or the blanks before one
  20A0'   7E                    	MOV	A,M
  20A1'   FE 20                 	CPI	' '
  20A3'   C2 20AC'              	JNZ	AS_OPT
  20A6'   23                    	INX	H
  20A7'   05                    	DCR	B
  20A8'   C2 20A0'              	JNZ	AS_TOK
  20AB'   C9                    	RET
  20AC'                         AS_OPT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20AC'   FE 2B                 	CPI	'+'
  20AE'   CA 20D8'              	JZ	AS_PLS
  20B1'   FE 2D                 	CPI	'-'
  20B3'   CA 20C7'              	JZ	AS_SW
  20B6'   FE 2F                 	CPI	'/'
  20B8'   CA 20C7'              	JZ	AS_SW
  20BB'                         AS_SKP:				; not ours (the file name): on to the next one
  20BB'   23                    	INX	H
  20BC'   05                    	DCR	B
  20BD'   C8                    	RZ
  20BE'   7E                    	MOV	A,M
  20BF'   FE 20                 	CPI	' '
  20C1'   C2 20BB'              	JNZ	AS_SKP
  20C4'   C3 20A0'              	JMP	AS_TOK
  20C7'                         AS_SW:
  20C7'   23                    	INX	H
  20C8'   05                    	DCR	B
  20C9'   C8                    	RZ
  20CA'   7E                    	MOV	A,M
  20CB'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  20CD'   FE 52                 	CPI	'R'
  20CF'   C2 20BB'              	JNZ	AS_SKP
  20D2'   32 29FA'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  20D5'   C3 20BB'              	JMP	AS_SKP
  20D8'                         AS_PLS:
  20D8'   3E 01                 	MVI	A,1
  20DA'   32 29FB'              	STA	PLUSF		; '+' gets the line even with no number on it
  20DD'   11 0000*              	LXI	D,PLUSB
  20E0'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  20E2'   23                    	INX	H		;   line space, so it is taken as '+' alone
  20E3'   05                    	DCR	B
  20E4'   CA 211B'              	JZ	AS_PE
  20E7'   7E                    	MOV	A,M
  20E8'   FE 30                 	CPI	'0'
  20EA'   C2 2102'              	JNZ	AS_PD
  20ED'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  20ED'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  20EE'   05                    	DCR	B
  20EF'   CA 2123'              	JZ	AS_P1
  20F2'   7E                    	MOV	A,M
  20F3'   FE 30                 	CPI	'0'
  20F5'   CA 20ED'              	JZ	AS_PZ
  20F8'   FE 31                 	CPI	'1'
  20FA'   DA 2123'              	JC	AS_P1		; zeros and then no digit at all: line 1
  20FD'   FE 3A                 	CPI	'9'+1
  20FF'   D2 2123'              	JNC	AS_P1
  2102'                         AS_PD:				; the digits, as typed
  2102'   7E                    	MOV	A,M
  2103'   FE 30                 	CPI	'0'
  2105'   DA 211B'              	JC	AS_PE
  2108'   FE 3A                 	CPI	'9'+1
  210A'   D2 211B'              	JNC	AS_PE
  210D'   79                    	MOV	A,C
  210E'   B7                    	ORA	A
  210F'   CA 212A'              	JZ	AS_POV
  2112'   0D                    	DCR	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2113'   7E                    	MOV	A,M
  2114'   12                    	STAX	D
  2115'   13                    	INX	D
  2116'   23                    	INX	H
  2117'   05                    	DCR	B
  2118'   C2 2102'              	JNZ	AS_PD
  211B'                         AS_PE:
  211B'   AF                    	XRA	A
  211C'   12                    	STAX	D		; the digits end with a 0
  211D'   78                    	MOV	A,B
  211E'   B7                    	ORA	A
  211F'   C8                    	RZ
  2120'   C3 20A0'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  2123'                         AS_P1:
  2123'   3E 31                 	MVI	A,'1'
  2125'   12                    	STAX	D
  2126'   13                    	INX	D
  2127'   C3 211B'              	JMP	AS_PE
  212A'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  212A'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  212D'   C3 211B'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  2130'                         ARGGO:
  2130'   3A 29FB'              	LDA	PLUSF
  2133'   B7                    	ORA	A
  2134'   C8                    	RZ
  2135'   21 0000*              	LXI	H,PLUSB
  2138'                         AG_LP:
  2138'   7E                    	MOV	A,M
  2139'   B7                    	ORA	A
  213A'   CA 2149'              	JZ	AG_G
  213D'   4F                    	MOV	C,A
  213E'   06 02                 	MVI	B,KT_CHAR
  2140'   E5                    	PUSH	H
  2141'   CD 0023'              	CALL	VICMD
  2144'   E1                    	POP	H
  2145'   23                    	INX	H
  2146'   C3 2138'              	JMP	AG_LP
  2149'                         AG_G:
  2149'   0E 47                 	MVI	C,'G'
  214B'   06 02                 	MVI	B,KT_CHAR
  214D'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  2150'                         NRMDRV:
  2150'   7E                    	MOV	A,M
  2151'   B7                    	ORA	A
  2152'   C0                    	RNZ
  2153'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2154'   0E 19                 	MVI	C,BF_CURDSK
  2156'   CD 0005               	CALL	BDOS
  2159'   E1                    	POP	H
  215A'   3C                    	INR	A
  215B'   77                    	MOV	M,A
  215C'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  215D'                         PARSFN:
  215D'   CD 2069'              	CALL	TFCLR
  2160'   11 0000*              	LXI	D,TFCB
  2163'   23                    	INX	H
  2164'   7E                    	MOV	A,M
  2165'   2B                    	DCX	H
  2166'   FE 3A                 	CPI	':'
  2168'   C2 217A'              	JNZ	PF_NM
  216B'   CD 21C0'              	CALL	GETFNC
  216E'   CA 217A'              	JZ	PF_NM
  2171'   D6 40                 	SUI	40H
  2173'   12                    	STAX	D
  2174'   FE 11                 	CPI	17
  2176'   D2 219E'              	JNC	PF_BAD
  2179'   23                    	INX	H
  217A'                         PF_NM:
  217A'   13                    	INX	D
  217B'   0E 08                 	MVI	C,8
  217D'   CD 21A2'              	CALL	CPYNAM
  2180'   FE 2E                 	CPI	'.'
  2182'   0E 03                 	MVI	C,3
  2184'   C4 21B5'              	CNZ	PADFLD		; no type: blanks
  2187'   CC 21A1'              	CZ	CPYNM0		; '.': the type
  218A'   3A 0001*              	LDA	TFCB+1
  218D'   FE 20                 	CPI	' '
  218F'   CA 219E'              	JZ	PF_BAD		; no name
  2192'   CD 21F3'              	CALL	SKIPB
  2195'   C0                    	RNZ			; more after it
  2196'   21 0000*              	LXI	H,TFCB
  2199'   CD 2150'              	CALL	NRMDRV
  219C'   AF                    	XRA	A
  219D'   C9                    	RET
  219E'                         PF_BAD:
  219E'   F6 01                 	ORI	1
  21A0'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  21A1'                         CPYNM0:
  21A1'   23                    	INX	H
  21A2'                         CPYNAM:
  21A2'   CD 21C0'              	CALL	GETFNC
  21A5'   CA 21B5'              	JZ	PADFLD
  21A8'   12                    	STAX	D
  21A9'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AA'   0D                    	DCR	C
  21AB'   C2 21A2'              	JNZ	CPYNAM
  21AE'                         CN_SKP:
  21AE'   CD 21C0'              	CALL	GETFNC
  21B1'   C2 21AE'              	JNZ	CN_SKP
  21B4'   C9                    	RET
  21B5'                         PADFLD:
  21B5'   F5                    	PUSH	PSW
  21B6'                         PD_LP:
  21B6'   3E 20                 	MVI	A,' '
  21B8'   12                    	STAX	D
  21B9'   13                    	INX	D
  21BA'   0D                    	DCR	C
  21BB'   C2 21B6'              	JNZ	PD_LP
  21BE'   F1                    	POP	PSW
  21BF'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  21C0'                         GETFNC:
  21C0'   7E                    	MOV	A,M
  21C1'   FE 3D                 	CPI	'='
  21C3'   C8                    	RZ
  21C4'   FE 5F                 	CPI	'_'
  21C6'   C8                    	RZ
  21C7'   FE 3B                 	CPI	';'
  21C9'   C8                    	RZ
  21CA'   FE 3C                 	CPI	'<'
  21CC'   C8                    	RZ
  21CD'   FE 3E                 	CPI	'>'
  21CF'   C8                    	RZ
  21D0'   FE 2E                 	CPI	'.'
  21D2'   C8                    	RZ
  21D3'   FE 3A                 	CPI	':'
  21D5'   C8                    	RZ
  21D6'   FE 2A                 	CPI	'*'
  21D8'   C8                    	RZ
  21D9'   FE 3F                 	CPI	'?'
  21DB'   C8                    	RZ
  21DC'   FE 20                 	CPI	' '
  21DE'   DA 21F1'              	JC	GF_CTL
  21E1'   C8                    	RZ
  21E2'   23                    	INX	H
  21E3'   FE 61                 	CPI	'a'
  21E5'   DA 21EF'              	JC	GF_DN
  21E8'   FE 7B                 	CPI	'z'+1
  21EA'   D2 21EF'              	JNC	GF_DN
  21ED'   E6 DF                 	ANI	0DFH
  21EF'                         GF_DN:
  21EF'   B7                    	ORA	A
  21F0'   C9                    	RET
  21F1'                         GF_CTL:
  21F1'   BF                    	CMP	A
  21F2'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  21F3'                         SKIPB:
  21F3'   7E                    	MOV	A,M
  21F4'   FE 20                 	CPI	' '
  21F6'   C2 21FD'              	JNZ	SB_DN
  21F9'   23                    	INX	H
  21FA'   C3 21F3'              	JMP	SKIPB
  21FD'                         SB_DN:
  21FD'   B7                    	ORA	A
  21FE'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  21FF'                         ISLOW:
  21FF'   7E                    	MOV	A,M
  2200'   FE 61                 	CPI	'a'
  2202'   D8                    	RC
  2203'   FE 7B                 	CPI	'z'+1
  2205'   3F                    	CMC
  2206'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  2207'                         MSGNFN:
  2207'   21 2254'              	LXI	H,SNFN
  220A'   C3 223F'              	JMP	EXERR
  220D'                         MSGEXI:
  220D'   21 226E'              	LXI	H,SEXI
  2210'   C3 221C'              	JMP	EXBNG
  2213'                         MSGRO:
  2213'   21 227A'              	LXI	H,SRO
  2216'   C3 221C'              	JMP	EXBNG
  2219'                         MSGNWR:
  2219'   21 2261'              	LXI	H,SNWR
  221C'                         EXBNG:
  221C'   CD 223F'              	CALL	EXERR
  221F'   21 2286'              	LXI	H,SBNG
  2222'   C3 223A'              	JMP	EXOUT
  2225'                         EX_INV:
  2225'   21 2294'              	LXI	H,SINV
  2228'   C3 223F'              	JMP	EXERR
  222B'                         EX_V:				; :ve -- the version, on the bottom row
  222B'   21 224F'              	LXI	H,SVER
  222E'   C3 223F'              	JMP	EXERR
  2231'                         EX_TRL:
  2231'   21 22A6'              	LXI	H,STRL
  2234'                         EXERT:				; the message, then the text at EXCMD
  2234'   CD 223F'              	CALL	EXERR
  2237'   2A 29E9'              	LHLD	EXCMD
  223A'                         EXOUT:
  223A'   CD 0000*              	CALL	OUTSTR
  223D'   37                    	STC
  223E'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  223F'                         EXERR:
  223F'   E5                    	PUSH	H
  2240'   AF                    	XRA	A		; an error outranks whatever this key meant to
