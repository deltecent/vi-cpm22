  0C23'   CD 0694'              	CALL	CLASSF
  0C26'   32 26FD'              	STA	WKCLS
  0C29'                         ES_RUN:
  0C29'   2A 26F5'              	LHLD	WKI
  0C2C'   23                    	INX	H
  0C2D'   EB                    	XCHG			; DE = i+1
  0C2E'   2A 26F7'              	LHLD	WKN
  0C31'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C34'   D2 0C51'              	JNC	ES_LND
  0C37'   2A 26F5'              	LHLD	WKI
  0C3A'   23                    	INX	H
  0C3B'   E5                    	PUSH	H		; i+1
  0C3C'   CD 0000*              	CALL	CHARAT
