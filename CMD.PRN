                                ;============================================================
                                ; DATA
                                ;============================================================
  2E1B'   00                    EDMODE: DB	EM_CMD
  2E1C'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2E1E'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2E1F'   00                    MODF:	DB	0		; 1 = unsaved changes
  2E20'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2E21'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2E22'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2E23'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  2E24'   00                    DCHBS:	DB	0		; 1 = they went left of the cursor (insert's BS)
  2E25'   00                    LNALL:	DB	0		; 1 = this R_LINE is drawn from the line's first
                                				;   row, not the cursor's (SCRN.MAC clears it)
  2E26'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2E27'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2E29'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  2E2A'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  2E2B'   00                    HFAMT:	DB	0		; ^D/^U: rows (vim's 'scroll'); 0 = NEDIT/2
  2E2C'   00                    HFN:	DB	0		; ^D/^U: the rows this one goes
  2E2D'   0000                  HFTP:	DW	0		; ^D/^U: -> the new top line's entry
  2E2F'   00                    HTN:	DB	0		; row table: its entries
  2E30'   00                    HTCUR:	DB	0		; ... the cursor line's
  2E31'   00                    HTTP:	DB	0		; ... the top line's
  2E32'   00                    HTEOF:	DB	0		; ... 1 = its last is the file's last line
  2E33'   00                    HTBOF:	DB	0		; ... 1 = its first is the file's first
  2E34'   0000                  RWR:	DW	0		; ^F/^B: rows still to go
  2E36'   00                    RWMV:	DB	0		; ^F/^B: 1 = the table was made again on the way
  2E37'   00                    OVDIR:	DB	0		; OVLAP: 0 = h2.. are above h1 in the table
  2E38'   0000                  JKCNT:	DW	0		; j/k: count
  2E3A'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2E3C'   0000                  JKMOV:	DW	0		; j: lines moved
  2E3E'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2E40'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2E41'   00                    JKLST:	DB	0		; j: last byte of the scan
  2E42'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2E44'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  2E46'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  2E47'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  2E48'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  2E49'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  2E4A'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2E4B'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2E4D'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2E4E'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2E4F'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-143


  2E51'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2E52'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2E53'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2E54'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  2E55'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  2E56'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  2E57'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   and its first word is yet to be stepped
  2E58'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  2E5A'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2E5C'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2E5F'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2E62'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  2E65'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  2E68'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  2E6A'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2E6C'   0000                  CNTV:	DW	0		; motion repeat counter
  2E6E'   0000                  TTI:	DW	0		; TAILTAB scan index
  2E70'   0000                  WKI:	DW	0		; scan index
  2E72'   0000                  WKTERM: DW	0		; line terminator offset
  2E74'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  2E76'   00                    WKCLS:	DB	0		; word motion: class of the current run
  2E77'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  2E78'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2E7A'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2E7C'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2E7E'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2E80'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2E81'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2E82'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2E83'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2E84'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2E85'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2E87'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2E88'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2E89'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2E8B'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2E8D'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2E8E'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2E90'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2E92'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2E93'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2E94'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2E95'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2E96'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2E97'   00                    PLUSF:	DB	0		; command line: '+' was given
  2E98'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2E99'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2E9A'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2E9B'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2E9D'   0000                  YPT:	DW	0		; yy: where the lines came from
	MACRO-80 3.44	09-Dec-81	PAGE	1-144


  2E9F'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2EA1'   00 00 00              PPFP:	DB	0,0,0		; p/P: the first line put, a file position
  2EA4'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2EA6'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2EA7'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2EA9'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  2EAA'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  2EAB'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  2EAC'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  2EAD'   00                    FNDCH:	DB	0		; ... and the character it looked for
  2EAE'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  2EAF'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2EB0'   0000                  FNDN:	DW	0		; occurrences still to count off
  2EB2'   0000                  FNDCUR: DW	0		; the cursor it started from
  2EB4'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2EB6'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2EB7'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  2EBA'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  2EBD'   0000                  MKN:	DW	0		; ... how long it is
  2EBF'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2EC0'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2EC3'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2EC4'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2EC5'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2EC7'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2EC9'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  2ECB'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  2ECD'   00 00 00              YPFP:	DB	0,0,0		; ... and where in the file they start
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  2ED0'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2ED2'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2ED4'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2ED6'   00 00 00              SOFF:	DB	0,0,0		; BRKON: where in the FILE the command began
  2ED9'   0000                  SLDLT:	DW	0		; ... and LNDLT: for a search that fails, and
                                				;   any move an ESC stops
  2EDB'   00                    BRKARM: DB	0		; nonzero: CNTTST looks for an ESC
  2EDC'   00                    BRKHIT: DB	0		; nonzero: one was found, and the count spent
  2EDD'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  2EDE'   00                    SRNGF:	DB	0		; ex: a line range was given
  2EDF'   0000                  SRNG1:	DW	0		; ex: its first line
	MACRO-80 3.44	09-Dec-81	PAGE	1-145


  2EE1'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  2EE3'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2EE4'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2EE5'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2EE6'   00                    SLCHG:	DB	0		; ':s' this line changed
  2EE7'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2EE9'   0000                  SLINES: DW	0		; ':s' / ':N,Mw' lines of the range still to do
  2EEB'   00                    RWPTR:	DB	0		; ':N,Mw' the next free byte of the record at
                                				;   0080H, as that address's low byte
  2EEC'   00                    RWERR:	DB	0		; ':N,Mw' a record would not go: the disk is full
  2EED'   00                    RDANY:	DB	0		; ':r' something has been read in
  2EEE'   00                    RDBRK:	DB	0		; ':r' the line above wants a line end first
  2EEF'   00 00 00              SOFFS:	DB	0,0,0		; ':s' the cursor's place in the file, for one that
  2EF2'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  2EF4'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  2EF5'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
