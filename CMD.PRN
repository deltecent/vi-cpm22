  1D0E'   5D 00                 
  1D10'   20 6C 69 6E           SLINE:	DB	' line ',0
  1D14'   65 20 00              
  1D17'   20 63 6F 6C           SCOLM:	DB	' col ',0
  1D1B'   20 00                 
  1D1D'   20 2D 2D 42           SNOLIN: DB	' --Buffer empty--',0
  1D21'   75 66 66 65           
  1D25'   72 20 65 6D           
  1D29'   70 74 79 2D           
