  0C58'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C5B'   DA 0C67'              	JC	ES_CL
  0C5E'   CA 0C67'              	JZ	ES_CL
  0C61'   2A 26E5'              	LHLD	WKI
  0C64'   C3 0561'              	JMP	GOSET
  0C67'                         ES_CL:
  0C67'   2A 26E7'              	LHLD	WKN
  0C6A'   7C                    	MOV	A,H
  0C6B'   B5                    	ORA	L
  0C6C'   C8                    	RZ
  0C6D'   2B                    	DCX	H
  0C6E'   C3 0561'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C71'                         CURRW:
  0C71'   2A 0000*              	LHLD	WINROW
  0C74'   EB                    	XCHG
  0C75'   2A 0000*              	LHLD	LNDLT
  0C78'   19                    	DAD	D		; HL = row (signed)
  0C79'   7C                    	MOV	A,H
  0C7A'   B7                    	ORA	A
  0C7B'   FA 0C8E'              	JM	CRW_0		; above the screen -> top row
  0C7E'   C2 0C89'              	JNZ	CRW_BT		; far below -> bottom row
  0C81'   3A 0000*              	LDA	NEDIT
  0C84'   3D                    	DCR	A		; A = bottom row
  0C85'   BD                    	CMP	L		; CY iff bottom < row
  0C86'   D8                    	RC
  0C87'   7D                    	MOV	A,L
  0C88'   C9                    	RET
  0C89'                         CRW_BT:
  0C89'   3A 0000*              	LDA	NEDIT
  0C8C'   3D                    	DCR	A
  0C8D'   C9                    	RET
  0C8E'                         CRW_0:
  0C8E'   AF                    	XRA	A
  0C8F'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C90'                         SETRWT:
  0C90'   2A 0000*              	LHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C93'   EB                    	XCHG
  0C94'   6F                    	MOV	L,A
  0C95'   26 00                 	MVI	H,0
  0C97'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C9A'   22 0000*              	SHLD	WINROW
  0C9D'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C9E'                         MVROW:
  0C9E'   47                    	MOV	B,A
  0C9F'   CD 0C71'              	CALL	CURRW
  0CA2'   90                    	SUB	B		; A = row now - target
  0CA3'   C8                    	RZ
  0CA4'   DA 0CAD'              	JC	MR_DN
  0CA7'   6F                    	MOV	L,A
  0CA8'   26 00                 	MVI	H,0
  0CAA'   C3 08F8'              	JMP	KCORE
  0CAD'                         MR_DN:
  0CAD'   2F                    	CMA
  0CAE'   3C                    	INR	A		; A = target - row now
  0CAF'   6F                    	MOV	L,A
  0CB0'   26 00                 	MVI	H,0
  0CB2'   C3 085B'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CB5'                         VC_HIGH:
  0CB5'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CB8'   2B                    	DCX	H		; row = count - 1
  0CB9'   7C                    	MOV	A,H
  0CBA'   B7                    	ORA	A
  0CBB'   3A 0000*              	LDA	SCBOT
  0CBE'   C2 0CC6'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CC1'   BD                    	CMP	L		; CY iff SCBOT < row
  0CC2'   DA 0CC6'              	JC	VH_GO
  0CC5'   7D                    	MOV	A,L
  0CC6'                         VH_GO:
  0CC6'   CD 0C9E'              	CALL	MVROW
  0CC9'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CCC'                         VC_MIDL:
  0CCC'   CD 065F'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CCF'   3A 0000*              	LDA	SCBOT
  0CD2'   B7                    	ORA	A		; clear CY for the shift
  0CD3'   1F                    	RAR			; A = SCBOT / 2
  0CD4'   CD 0C9E'              	CALL	MVROW
  0CD7'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CDA'                         VC_LOWL:
  0CDA'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CDD'   2B                    	DCX	H		; count - 1
  0CDE'   3A 0000*              	LDA	SCBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CE1'   5F                    	MOV	E,A
  0CE2'   16 00                 	MVI	D,0
  0CE4'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CE5'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CE8'   3E 00                 	MVI	A,0
  0CEA'   D2 0CF1'              	JNC	VL_GO		; at or past the top -> row 0
  0CED'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CF0'   7D                    	MOV	A,L
  0CF1'                         VL_GO:
  0CF1'   CD 0C9E'              	CALL	MVROW
  0CF4'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CF7'                         VC_PGDN:
  0CF7'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CFA'   3A 0000*              	LDA	SCEOF
  0CFD'   B7                    	ORA	A
  0CFE'   CA 0D0C'              	JZ	VPD_N
  0D01'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D04'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D05'   C8                    	RZ			; it already is
  0D06'   CD 0C9E'              	CALL	MVROW
  0D09'   C3 0D1D'              	JMP	VPD_TP
  0D0C'                         VPD_N:
  0D0C'   3A 0000*              	LDA	NEDIT
  0D0F'   D6 02                 	SUI	2
  0D11'   CD 0D65'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D14'   E5                    	PUSH	H
  0D15'   AF                    	XRA	A
  0D16'   CD 0C9E'              	CALL	MVROW		; the top line
  0D19'   E1                    	POP	H
  0D1A'   CD 085B'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D1D'                         VPD_TP:
  0D1D'   AF                    	XRA	A
  0D1E'   CD 0C90'              	CALL	SETRWT		; to the top row
  0D21'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D24'                         VC_PGUP:
  0D24'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0D27'   3A 0000*              	LDA	SCBOF
  0D2A'   B7                    	ORA	A
  0D2B'   C0                    	RNZ
  0D2C'   3A 0000*              	LDA	NEDIT
  0D2F'   47                    	MOV	B,A
  0D30'   3A 0000*              	LDA	SCEOF
  0D33'   B7                    	ORA	A
  0D34'   CA 0D45'              	JZ	VPU_2
  0D37'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D3A'   FE 02                 	CPI	2
  0D3C'   D2 0D45'              	JNC	VPU_2
  0D3F'   2F                    	CMA
  0D40'   3C                    	INR	A
  0D41'   80                    	ADD	B
  0D42'   C3 0D48'              	JMP	VPU_P
  0D45'                         VPU_2:
  0D45'   78                    	MOV	A,B
  0D46'   D6 02                 	SUI	2
  0D48'                         VPU_P:
  0D48'   CD 0D65'              	CALL	MULSAT		; HL = count * page
  0D4B'   E5                    	PUSH	H
  0D4C'   AF                    	XRA	A
  0D4D'   CD 0C9E'              	CALL	MVROW		; the top line
  0D50'   E1                    	POP	H
  0D51'   CD 08F8'              	CALL	KCORE		; the new top line
  0D54'   AF                    	XRA	A
  0D55'   CD 0C90'              	CALL	SETRWT		; on the top row
  0D58'   3A 0000*              	LDA	NEDIT
  0D5B'   3D                    	DCR	A
  0D5C'   6F                    	MOV	L,A
  0D5D'   26 00                 	MVI	H,0
  0D5F'   CD 085B'              	CALL	JCORE		; the bottom row's line
  0D62'   C3 07AD'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D65'                         MULSAT:
  0D65'   EB                    	XCHG
  0D66'   21 0000               	LXI	H,0
  0D69'   B7                    	ORA	A
  0D6A'   C8                    	RZ
  0D6B'                         MS_LP:
  0D6B'   19                    	DAD	D
  0D6C'   DA 0D74'              	JC	MS_SAT
  0D6F'   3D                    	DCR	A
  0D70'   C2 0D6B'              	JNZ	MS_LP
  0D73'   C9                    	RET
  0D74'                         MS_SAT:
  0D74'   21 FFFF               	LXI	H,0FFFFH
  0D77'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D78'                         VC_HFDN:
  0D78'   CD 06DF'              	CALL	SETMOV
  0D7B'   CD 0C71'              	CALL	CURRW
  0D7E'   32 26AB'              	STA	HFROW
  0D81'   CD 0DEF'              	CALL	HFCNT		; HL = lines
  0D84'   3A 26AB'              	LDA	HFROW
  0D87'   47                    	MOV	B,A
  0D88'   3A 0000*              	LDA	SCEOF
  0D8B'   B7                    	ORA	A
  0D8C'   CA 0D94'              	JZ	VHD_GO
  0D8F'   3A 0000*              	LDA	SCBOT		; the last line's row
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D92'   B8                    	CMP	B
  0D93'   C8                    	RZ			; the cursor is on it
  0D94'                         VHD_GO:
  0D94'   CD 085B'              	CALL	JCORE
  0D97'   3A 0000*              	LDA	SCEOF
  0D9A'   B7                    	ORA	A
  0D9B'   C2 07AD'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D9E'   3A 26AB'              	LDA	HFROW
  0DA1'   CD 0C90'              	CALL	SETRWT
  0DA4'   3E 01                 	MVI	A,1
  0DA6'   32 0000*              	STA	WFILL		; not past the end of the file
  0DA9'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DAC'                         VC_HFUP:
  0DAC'   CD 06DF'              	CALL	SETMOV
  0DAF'   CD 0C71'              	CALL	CURRW
  0DB2'   32 26AB'              	STA	HFROW
  0DB5'   CD 0DEF'              	CALL	HFCNT		; HL = lines
  0DB8'   CD 0DCF'              	CALL	ONFST
  0DBB'   C8                    	RZ			; the cursor is on the first line
  0DBC'   CD 08F8'              	CALL	KCORE
  0DBF'   3A 0000*              	LDA	SCBOF
  0DC2'   B7                    	ORA	A
  0DC3'   C2 07AD'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DC6'   3A 26AB'              	LDA	HFROW
  0DC9'   CD 0C90'              	CALL	SETRWT
  0DCC'   C3 07AD'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DCF'                         ONFST:
  0DCF'   E5                    	PUSH	H
  0DD0'   2A 0000*              	LHLD	OUTPOS
  0DD3'   7C                    	MOV	A,H
  0DD4'   B5                    	ORA	L
  0DD5'   C2 0DED'              	JNZ	OF_RET
  0DD8'   2A 0000*              	LHLD	TXTBEG
  0DDB'   EB                    	XCHG			; DE = TXTBEG
  0DDC'   2A 0000*              	LHLD	GAPBEG
  0DDF'                         OF_LP:
  0DDF'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DE2'   CA 0DED'              	JZ	OF_RET
  0DE5'   2B                    	DCX	H
  0DE6'   7E                    	MOV	A,M
  0DE7'   FE 0A                 	CPI	LF
  0DE9'   C2 0DDF'              	JNZ	OF_LP
  0DEC'   B7                    	ORA	A		; NZ
  0DED'                         OF_RET:
  0DED'   E1                    	POP	H
  0DEE'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DEF'                         HFCNT:
  0DEF'   2A 269F'              	LHLD	CMDCNT
  0DF2'   7C                    	MOV	A,H
  0DF3'   B5                    	ORA	L
  0DF4'   CA 0E0B'              	JZ	HFC_AM
  0DF7'   CD 0672'              	CALL	GETCNT		; HL = count; clears it
  0DFA'   3A 0000*              	LDA	NEDIT
  0DFD'   5F                    	MOV	E,A
  0DFE'   16 00                 	MVI	D,0
  0E00'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E03'   D2 0E07'              	JNC	HFC_ST
  0E06'   EB                    	XCHG			; HL = NEDIT
  0E07'                         HFC_ST:
  0E07'   7D                    	MOV	A,L
  0E08'   32 26AC'              	STA	HFAMT
  0E0B'                         HFC_AM:
  0E0B'   3A 26AC'              	LDA	HFAMT
  0E0E'   B7                    	ORA	A
  0E0F'   C2 0E1C'              	JNZ	HFC_HL
  0E12'   3A 0000*              	LDA	NEDIT
  0E15'   B7                    	ORA	A
  0E16'   1F                    	RAR
  0E17'   B7                    	ORA	A
  0E18'   C2 0E1C'              	JNZ	HFC_HL
  0E1B'   3C                    	INR	A		; at least one line
  0E1C'                         HFC_HL:
  0E1C'   6F                    	MOV	L,A
  0E1D'   26 00                 	MVI	H,0
  0E1F'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E20'                         VC_REDR:
  0E20'   C3 0672'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E23'                         VC_G:
  0E23'   CD 06DF'              	CALL	SETMOV
  0E26'   CD 0EC3'              	CALL	GZONE		; the screen's top line, before the move
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E29'   2A 269F'              	LHLD	CMDCNT
  0E2C'   7C                    	MOV	A,H
  0E2D'   B5                    	ORA	L
  0E2E'   C2 0E3B'              	JNZ	VG_N
  0E31'   AF                    	XRA	A		; forward
  0E32'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E35'   CD 098F'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E38'   C3 0EDB'              	JMP	GPLACE
  0E3B'                         VG_N:
  0E3B'   CD 0672'              	CALL	GETCNT		; HL = target line (1-based)
  0E3E'                         VG_LN:
  0E3E'   CD 0E44'              	CALL	GOLN
  0E41'   C3 0EDB'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E44'                         GOLN:
  0E44'   2B                    	DCX	H		; lines to move from line 1
  0E45'   E5                    	PUSH	H
  0E46'   3E FF                 	MVI	A,0FFH
  0E48'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E4B'   E1                    	POP	H
  0E4C'   AF                    	XRA	A
  0E4D'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E50'   CD 0989'              	CALL	ATEOF
  0E53'   DC 098F'              	CC	LASTLN		; past the last line: onto it
  0E56'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E57'                         VC_LG:
  0E57'   CD 06DF'              	CALL	SETMOV
  0E5A'   3A 26C7'              	LDA	GSAVE
  0E5D'   B7                    	ORA	A
  0E5E'   C2 0E67'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E61'   3E 01                 	MVI	A,PG
  0E63'   32 26C6'              	STA	GPEND
  0E66'   C9                    	RET
  0E67'                         VLG_GG:
  0E67'   CD 0EC3'              	CALL	GZONE
  0E6A'   CD 0672'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E6D'   C3 0E3E'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E70'                         SUB24:
  0E70'   4F                    	MOV	C,A
  0E71'   7D                    	MOV	A,L
  0E72'   93                    	SUB	E
  0E73'   6F                    	MOV	L,A
  0E74'   7C                    	MOV	A,H
  0E75'   9A                    	SBB	D
  0E76'   67                    	MOV	H,A
  0E77'   79                    	MOV	A,C
  0E78'   98                    	SBB	B
  0E79'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E7A'                         CURFP:
  0E7A'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E7D'                         FPOS:
  0E7D'   C5                    	PUSH	B
  0E7E'   D5                    	PUSH	D
  0E7F'   EB                    	XCHG
  0E80'   2A 0000*              	LHLD	TXTBEG
  0E83'   EB                    	XCHG
  0E84'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E87'   EB                    	XCHG			; DE = that
  0E88'   2A 0000*              	LHLD	OUTPOS
  0E8B'   7C                    	MOV	A,H
  0E8C'   B7                    	ORA	A		; CY = 0
  0E8D'   1F                    	RAR
  0E8E'   47                    	MOV	B,A
  0E8F'   7D                    	MOV	A,L
  0E90'   1F                    	RAR
  0E91'   67                    	MOV	H,A
  0E92'   3E 00                 	MVI	A,0
  0E94'   1F                    	RAR
  0E95'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E96'   19                    	DAD	D
  0E97'   78                    	MOV	A,B
  0E98'   CE 00                 	ACI	0		; A:HL = the position
  0E9A'   D1                    	POP	D
  0E9B'   C1                    	POP	B
  0E9C'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E9D'                         ZSAVE:
  0E9D'   2A 269F'              	LHLD	CMDCNT
  0EA0'   22 2705'              	SHLD	ZSVCNT
  0EA3'   2A 0000*              	LHLD	AUXCNT
  0EA6'   22 2707'              	SHLD	ZSVAUX
  0EA9'   3A 0000*              	LDA	DIRFLG
  0EAC'   32 2709'              	STA	ZSVDIR
  0EAF'   C9                    	RET
  0EB0'                         ZREST:
  0EB0'   2A 2705'              	LHLD	ZSVCNT
  0EB3'   22 269F'              	SHLD	CMDCNT
  0EB6'   2A 2707'              	LHLD	ZSVAUX
  0EB9'   22 0000*              	SHLD	AUXCNT
  0EBC'   3A 2709'              	LDA	ZSVDIR
  0EBF'   32 0000*              	STA	DIRFLG
  0EC2'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EC3'                         GZONE:
  0EC3'   CD 0E9D'              	CALL	ZSAVE
  0EC6'   CD 0C71'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EC9'   6F                    	MOV	L,A
  0ECA'   26 00                 	MVI	H,0
  0ECC'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0ECF'   CD 0E7D'              	CALL	FPOS
  0ED2'   22 0000*              	SHLD	ZTOP
  0ED5'   32 0002*              	STA	ZTOP+2
  0ED8'   C3 0EB0'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EDB'                         GPLACE:
  0EDB'   CD 0E9D'              	CALL	ZSAVE
  0EDE'   CD 0E7A'              	CALL	CURFP
  0EE1'   EB                    	XCHG
  0EE2'   2A 0000*              	LHLD	ZTOP
  0EE5'   EB                    	XCHG
  0EE6'   4F                    	MOV	C,A		; C:HL = the target's position
  0EE7'   3A 0002*              	LDA	ZTOP+2
  0EEA'   47                    	MOV	B,A		; B:DE = the top's
  0EEB'   79                    	MOV	A,C
  0EEC'   CD 0E70'              	CALL	SUB24
  0EEF'   22 2702'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0EF2'   DA 0F3F'              	JC	GP_UP
  0EF5'   B7                    	ORA	A
  0EF6'   C2 0F80'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EF9'   3A 0000*              	LDA	NEDIT
  0EFC'   5F                    	MOV	E,A
  0EFD'   16 00                 	MVI	D,0
  0EFF'   B7                    	ORA	A
  0F00'   1F                    	RAR
  0F01'   6F                    	MOV	L,A
  0F02'   26 00                 	MVI	H,0
  0F04'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0F05'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F08'   CD 066B'              	CALL	GBSUB		; HL = bytes from there to the target
  0F0B'   EB                    	XCHG
  0F0C'   2A 2702'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F0F'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F12'   DA 0F80'              	JC	GP_MID
  0F15'   CD 066B'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F18'   01 0000               	LXI	B,0		; BC = lines from the top
  0F1B'                         GP_CNT:
  0F1B'   7A                    	MOV	A,D
  0F1C'   B3                    	ORA	E
  0F1D'   CA 0F2C'              	JZ	GP_DN
  0F20'   7E                    	MOV	A,M
  0F21'   23                    	INX	H
  0F22'   1B                    	DCX	D
  0F23'   FE 0A                 	CPI	LF
  0F25'   C2 0F1B'              	JNZ	GP_CNT
  0F28'   03                    	INX	B
  0F29'   C3 0F1B'              	JMP	GP_CNT
  0F2C'                         GP_DN:
  0F2C'   3A 0000*              	LDA	NEDIT
  0F2F'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F30'   5F                    	MOV	E,A
  0F31'   16 00                 	MVI	D,0		; DE = the bottom row
  0F33'   60                    	MOV	H,B
  0F34'   69                    	MOV	L,C
  0F35'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F38'   DA 0F8A'              	JC	GP_SET		; A = the bottom row
  0F3B'   7D                    	MOV	A,L		; on the screen: its row
  0F3C'   C3 0FAA'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F3F'                         GP_UP:
  0F3F'   3C                    	INR	A
  0F40'   C2 0F80'              	JNZ	GP_MID		; 64K bytes or more above
  0F43'   2A 2702'              	LHLD	ZDIF
  0F46'   EB                    	XCHG
  0F47'   21 0000               	LXI	H,0
  0F4A'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F4D'   7C                    	MOV	A,H
  0F4E'   B5                    	ORA	L
  0F4F'   CA 0F80'              	JZ	GP_MID		; exactly 64K
  0F52'   EB                    	XCHG			; DE = bytes to read
  0F53'   AF                    	XRA	A
  0F54'   32 2704'              	STA	ZLF
  0F57'   CD 0000*              	CALL	RGET0
  0F5A'                         GP_RD:
  0F5A'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F5D'   DA 0F80'              	JC	GP_MID
  0F60'   FE 0A                 	CPI	LF
  0F62'   C2 0F76'              	JNZ	GP_RN
  0F65'   3A 0000*              	LDA	NEDIT
  0F68'   B7                    	ORA	A
  0F69'   1F                    	RAR
  0F6A'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F6C'   E5                    	PUSH	H
  0F6D'   21 2704'              	LXI	H,ZLF
  0F70'   34                    	INR	M
  0F71'   BE                    	CMP	M		; CY iff more lines than that
  0F72'   E1                    	POP	H
  0F73'   DA 0F80'              	JC	GP_MID
  0F76'                         GP_RN:
  0F76'   1B                    	DCX	D
  0F77'   7A                    	MOV	A,D
  0F78'   B3                    	ORA	E
  0F79'   C2 0F5A'              	JNZ	GP_RD
  0F7C'   AF                    	XRA	A		; the top row
  0F7D'   C3 0F8A'              	JMP	GP_SET
  0F80'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F80'   3E 01                 	MVI	A,1
  0F82'   32 0000*              	STA	WFILL		; not past the end of the file
  0F85'   3A 0000*              	LDA	NEDIT
  0F88'   B7                    	ORA	A
  0F89'   1F                    	RAR			; the middle row
  0F8A'                         GP_SET:
  0F8A'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F8B'   26 00                 	MVI	H,0
  0F8D'   22 0000*              	SHLD	WINROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F90'   21 0000               	LXI	H,0
  0F93'   22 0000*              	SHLD	LNDLT
  0F96'   CD 0700'              	CALL	SETFUL		; the window may have paged: full repaint
  0F99'                         GP_FIN:
  0F99'   CD 0EB0'              	CALL	ZREST
  0F9C'   3A 272C'              	LDA	GPKEEP
  0F9F'   B7                    	ORA	A
  0FA0'   CA 07AD'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0FA3'   AF                    	XRA	A
  0FA4'   32 272C'              	STA	GPKEEP
  0FA7'   C3 0564'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0FAA'                         GP_ONS:
  0FAA'   6F                    	MOV	L,A
  0FAB'   26 00                 	MVI	H,0		; HL = the row it lands on
  0FAD'   EB                    	XCHG
  0FAE'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0FB1'   EB                    	XCHG
  0FB2'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FB5'   22 0000*              	SHLD	LNDLT
  0FB8'   3E 01                 	MVI	A,R_MOVE
  0FBA'   32 26A3'              	STA	RINTENT
  0FBD'   C3 0F99'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FC0'                         OPPEND:
  0FC0'   AF                    	XRA	A
  0FC1'   32 26CC'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FC4'   3A 26C9'              	LDA	PSAVE
  0FC7'   FE 63                 	CPI	'c'
  0FC9'   C2 0FE6'              	JNZ	OPP_ND
  0FCC'   79                    	MOV	A,C
  0FCD'   FE 77                 	CPI	'w'
  0FCF'   CA 0FD7'              	JZ	OPP_W
  0FD2'   FE 57                 	CPI	'W'
  0FD4'   C2 0FE6'              	JNZ	OPP_ND
  0FD7'                         OPP_W:
  0FD7'   CD 11B9'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FDA'   DA 0FE6'              	JC	OPP_ND
  0FDD'   79                    	MOV	A,C
  0FDE'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FE0'   4F                    	MOV	C,A
  0FE1'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FE3'   32 26CC'              	STA	CWEOL		;   see the clamp in OPA_F
  0FE6'                         OPP_ND:
  0FE6'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  0FE7'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  0FE9'   C2 0FFD'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  0FEC'   CD 0218'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  0FEF'   DA 108D'              	JC	OPABRT
  0FF2'   79                    	MOV	A,C
  0FF3'   FE 67                 	CPI	'g'
  0FF5'   C2 108D'              	JNZ	OPABRT
  0FF8'   3E 01                 	MVI	A,PG
  0FFA'   32 26C7'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  0FFD'                         OPP_NG:
  0FFD'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0FFE'   21 26C9'              	LXI	H,PSAVE
  1001'   BE                    	CMP	M
  1002'   CA 11DA'              	JZ	OPLINE
  1005'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1006'   CD 11F0'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1009'   DA 108D'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  100C'   32 26CB'              	STA	OPCLSV
  100F'   47                    	MOV	B,A		; B = the class
  1010'   3A 26C9'              	LDA	PSAVE
  1013'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1015'   C2 1021'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1018'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1019'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  101B'   C2 1043'              	JNZ	OPP_GO
  101E'   C3 102C'              	JMP	OPP_NO
  1021'                         OPP_NC:
  1021'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1023'   C2 1043'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1026'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1027'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1029'   CA 1043'              	JZ	OPP_GO		;   within a line -- neither of which is built
  102C'                         OPP_NO:
  102C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  102D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  102F'   CA 103D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1032'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1034'   CA 103D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1037'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  103A'   C2 108D'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  103D'                         OPP_SW:
  103D'   CD 0218'              	CALL	MKGETK
  1040'   C3 108D'              	JMP	OPABRT
  1043'                         OPP_GO:
  1043'   AF                    	XRA	A
  1044'   32 26AA'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1047'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  104A'   22 26CD'              	SHLD	OPSTA
  104D'   C5                    	PUSH	B
  104E'   21 26D1'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1051'   CD 0436'              	CALL	FPSTO		;   only good until the motion pages the window
  1054'   3A 26CB'              	LDA	OPCLSV
  1057'   FE 02                 	CPI	2
  1059'   CC 1090'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  105C'   C1                    	POP	B
  105D'   21 25CD'              	LXI	H,CMDTAB
  1060'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1063'   3A 26C9'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1066'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1067'   CA 06DF'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  106A'   CD 10BC'              	CALL	OPSFIX		; where the start is in the window NOW
  106D'   D2 10D8'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1070'   22 26CD'              	SHLD	OPSTA
  1073'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1076'   22 26CF'              	SHLD	OPEND2
  1079'   3A 26C9'              	LDA	PSAVE
  107C'   FE 79                 	CPI	'y'
  107E'   CA 16A4'              	JZ	OPYANK		; a yank takes the span without losing it
  1081'   CD 122B'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1084'   3A 26C9'              	LDA	PSAVE
  1087'   FE 63                 	CPI	'c'
  1089'   C0                    	RNZ
  108A'   C3 1459'              	JMP	SETINS
  108D'                         OPABRT:
  108D'   C3 06DF'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1090'                         OPENDS:
  1090'   2A 26CD'              	LHLD	OPSTA
  1093'   CD 05CB'              	CALL	BOL
  1096'   11 26D4'              	LXI	D,OPSLO
  1099'   CD 10AE'              	CALL	OPE_ST
  109C'   2A 26CD'              	LHLD	OPSTA
  109F'   CD 05FB'              	CALL	NLSTART
  10A2'   11 26D7'              	LXI	D,OPSHI
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A5'   CD 10AE'              	CALL	OPE_ST
  10A8'   2A 26CD'              	LHLD	OPSTA
  10AB'   C3 0000*              	JMP	GOTO
  10AE'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  10AE'   D5                    	PUSH	D
  10AF'   CD 0000*              	CALL	GOTO
  10B2'   E1                    	POP	H
  10B3'   C3 0436'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  10B6'                         CURBD:
  10B6'   CD 0E7A'              	CALL	CURFP
  10B9'   EB                    	XCHG
  10BA'   47                    	MOV	B,A
  10BB'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  10BC'                         OPSFIX:
  10BC'   21 26D1'              	LXI	H,OPSFP
  10BF'   CD 03E9'              	CALL	MKLOAD
  10C2'   CD 10B6'              	CALL	CURBD
  10C5'   2A 2736'              	LHLD	MKPOS
  10C8'   3A 2738'              	LDA	MKPOS+2
  10CB'   CD 0E70'              	CALL	SUB24
  10CE'   B4                    	ORA	H
  10CF'   B5                    	ORA	L
  10D0'   C2 03F6'              	JNZ	MKWIN
  10D3'   CD 0000*              	CALL	CUROFF
  10D6'   37                    	STC
  10D7'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  10D8'                         OPPGD:
  10D8'   47                    	MOV	B,A
  10D9'   3A 26CB'              	LDA	OPCLSV
  10DC'   FE 02                 	CPI	2
  10DE'   C2 119A'              	JNZ	OPG_NO
  10E1'   3A 26C9'              	LDA	PSAVE
  10E4'   FE 64                 	CPI	'd'
  10E6'   C2 119A'              	JNZ	OPG_NO
  10E9'   04                    	INR	B
  10EA'   CA 10F9'              	JZ	OPG_FW
  10ED'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10F0'   CD 05CB'              	CALL	BOL		;   and the high end is OPSHI as it stands
  10F3'   CD 0000*              	CALL	GOTO
  10F6'   C3 1111'              	JMP	OPG_GO
  10F9'                         OPG_FW:
  10F9'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  10FC'   CD 05FB'              	CALL	NLSTART		;   landed on, and the low one is where the
  10FF'   11 26D7'              	LXI	D,OPSHI		;   start line began
  1102'   CD 10AE'              	CALL	OPE_ST
  1105'   21 26D4'              	LXI	H,OPSLO
  1108'   CD 03E9'              	CALL	MKLOAD
  110B'   CD 03C2'              	CALL	MKPAGE
  110E'   CD 0000*              	CALL	GOTO
  1111'                         OPG_GO:
  1111'   CD 10B6'              	CALL	CURBD
  1114'   2A 26D7'              	LHLD	OPSHI
  1117'   3A 26D9'              	LDA	OPSHI+2
  111A'   CD 0E70'              	CALL	SUB24		; A:HL = the bytes to take
  111D'                         OPG_SV:
  111D'   22 26DA'              	SHLD	OPTOGO
  1120'   32 26DC'              	STA	OPTOGO+2
  1123'                         OPG_NX:
  1123'   CD 064E'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1126'   CD 0000*              	CALL	SUBHD
  1129'   EB                    	XCHG			; DE = what the window holds past the cursor
  112A'   2A 26DA'              	LHLD	OPTOGO
  112D'   3A 26DC'              	LDA	OPTOGO+2
  1130'   B7                    	ORA	A
  1131'   C2 1164'              	JNZ	OPG_PG		; 64K or more to go
  1134'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1137'   DA 1164'              	JC	OPG_PG
  113A'   CA 1164'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  113D'                         OPG_FN:				; the rest of it is here
  113D'   E5                    	PUSH	H
  113E'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1141'   CD 0000*              	CALL	CUROFF
  1144'   22 26DD'              	SHLD	OPLO
  1147'   D1                    	POP	D
  1148'   19                    	DAD	D
  1149'   22 26DF'              	SHLD	OPHI
  114C'   CD 12C9'              	CALL	OPDSPN
  114F'   CD 0989'              	CALL	ATEOF
  1152'   D2 11B3'              	JNC	OPMID
  1155'   CD 0DCF'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1158'   CA 11B3'              	JZ	OPMID		;   last line, if there is one -- and the pager
  115B'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  115E'   CD 0000*              	CALL	SETBWD
  1161'   C3 11B3'              	JMP	OPMID
  1164'                         OPG_PG:
  1164'   7A                    	MOV	A,D
  1165'   B3                    	ORA	E
  1166'   C2 117F'              	JNZ	OPG_DL
  1169'   CD 0989'              	CALL	ATEOF		; nothing held past the cursor
  116C'   21 0000               	LXI	H,0
  116F'   DA 113D'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1172'   2B                    	DCX	H
  1173'   CD 0000*              	CALL	SETC0
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1176'   CD 0000*              	CALL	GOLINE
  1179'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  117C'   C3 1123'              	JMP	OPG_NX
  117F'                         OPG_DL:
  117F'   D5                    	PUSH	D
  1180'   21 FFFF               	LXI	H,0FFFFH
  1183'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1186'   E1                    	POP	H
  1187'   E5                    	PUSH	H
  1188'   CD 0000*              	CALL	DELFWD
  118B'   D1                    	POP	D
  118C'   06 00                 	MVI	B,0
  118E'   2A 26DA'              	LHLD	OPTOGO
  1191'   3A 26DC'              	LDA	OPTOGO+2
  1194'   CD 0E70'              	CALL	SUB24
  1197'   C3 111D'              	JMP	OPG_SV
  119A'                         OPG_NO:
  119A'   0E 07                 	MVI	C,BEL
  119C'   CD 0000*              	CALL	BCONOU
  119F'                         OPG_HM:				; the cursor back where the command found it
  119F'   21 26D1'              	LXI	H,OPSFP
  11A2'   CD 03E9'              	CALL	MKLOAD
  11A5'   CD 03C2'              	CALL	MKPAGE
  11A8'   CD 0000*              	CALL	GOTO
  11AB'   AF                    	XRA	A
  11AC'   32 26C9'              	STA	PSAVE
  11AF'   3C                    	INR	A
  11B0'   32 272C'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  11B3'                         OPMID:
  11B3'   CD 0E9D'              	CALL	ZSAVE
  11B6'   C3 0F80'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  11B9'                         ONWHIT:
  11B9'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11BC'   CA 11D8'              	JZ	OW_YES
  11BF'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  11C2'   FE 20                 	CPI	' '
  11C4'   CA 11D8'              	JZ	OW_YES
  11C7'   FE 09                 	CPI	TAB
  11C9'   CA 11D8'              	JZ	OW_YES
  11CC'   FE 0D                 	CPI	CR
  11CE'   CA 11D8'              	JZ	OW_YES
  11D1'   FE 0A                 	CPI	LF
  11D3'   CA 11D8'              	JZ	OW_YES
  11D6'   B7                    	ORA	A		; a char to change: CY clear
  11D7'   C9                    	RET
  11D8'                         OW_YES:
  11D8'   37                    	STC
  11D9'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  11DA'                         OPLINE:
  11DA'   3A 26C9'              	LDA	PSAVE
  11DD'   FE 63                 	CPI	'c'
  11DF'   CA 06DF'              	JZ	SETMOV
  11E2'   FE 79                 	CPI	'y'
  11E4'   CA 1683'              	JZ	VY_YY
  11E7'   21 26D1'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  11EA'   CD 0436'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  11ED'   C3 15FC'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  11F0'                         OPCLS:
  11F0'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  11F2'   CA 11FF'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  11F5'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  11F7'   C2 1213'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  11FA'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  11FC'   C3 1201'              	JMP	OPC_FK
  11FF'                         OPC_SEM:
  11FF'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1201'                         OPC_FK:
  1201'   3A 2722'              	LDA	FNDKND
  1204'   B7                    	ORA	A
  1205'   37                    	STC
  1206'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1207'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1208'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  120A'   CA 1211'              	JZ	OPC_EXC
  120D'   3E 01                 	MVI	A,1
  120F'   B7                    	ORA	A		; CY clear: a motion, class 1
  1210'   C9                    	RET
  1211'                         OPC_EXC:
  1211'   AF                    	XRA	A		; class 0, CY clear
  1212'   C9                    	RET
  1213'                         OPC_TB:
  1213'   47                    	MOV	B,A
  1214'   21 134D'              	LXI	H,OPCTAB
  1217'                         OPC_LP:
  1217'   7E                    	MOV	A,M
  1218'   B7                    	ORA	A
  1219'   CA 1229'              	JZ	OPC_MS		; end of table -> not a motion
  121C'   B8                    	CMP	B
  121D'   CA 1225'              	JZ	OPC_HT
  1220'   23                    	INX	H
  1221'   23                    	INX	H
  1222'   C3 1217'              	JMP	OPC_LP
  1225'                         OPC_HT:
  1225'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1226'   7E                    	MOV	A,M		; class byte
  1227'   B7                    	ORA	A		; clear CY
  1228'   C9                    	RET
  1229'                         OPC_MS:
  1229'   37                    	STC
  122A'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  122B'                         OPAPPL:
  122B'   3A 26CB'              	LDA	OPCLSV
  122E'   FE 02                 	CPI	2
  1230'   CA 1331'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1233'   2A 26CD'              	LHLD	OPSTA
  1236'   EB                    	XCHG			; DE = start
  1237'   2A 26CF'              	LHLD	OPEND2		; HL = end
  123A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  123D'   DA 124D'              	JC	OPA_F
  1240'   CA 124D'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1243'   22 26DD'              	SHLD	OPLO
  1246'   EB                    	XCHG
  1247'   22 26DF'              	SHLD	OPHI
  124A'   C3 12A5'              	JMP	OPA_DO
  124D'                         OPA_F:
  124D'   EB                    	XCHG			; HL = start, DE = end
  124E'   22 26DD'              	SHLD	OPLO
  1251'   EB                    	XCHG			; HL = end
  1252'   3A 26CB'              	LDA	OPCLSV
  1255'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1257'   CA 12A2'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  125A'   FE 01                 	CPI	1
  125C'   C2 127E'              	JNZ	OPA_EX
  125F'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  1260'   3A 26CC'              	LDA	CWEOL
  1263'   B7                    	ORA	A
  1264'   CA 12A2'              	JZ	OPA_HI
  1267'   22 26DF'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  126A'   2A 26DD'              	LHLD	OPLO
  126D'   CD 13D7'              	CALL	CEND		; HL = the start line's content end
  1270'   EB                    	XCHG			; DE = that content end
  1271'   2A 26DF'              	LHLD	OPHI		; HL = hi
  1274'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1277'   D2 12A2'              	JNC	OPA_HI		; hi is inside the line: keep it
  127A'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  127B'   C3 12A2'              	JMP	OPA_HI
  127E'                         OPA_EX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  127E'   22 26DF'              	SHLD	OPHI		; the motion's own end, for now
  1281'   2A 26DD'              	LHLD	OPLO
  1284'   CD 13D7'              	CALL	CEND		; HL = the start line's content end
  1287'   EB                    	XCHG			; DE = that content end
  1288'   3A 26AA'              	LDA	WPULL		; the motion landed on a line's end and was
  128B'   B7                    	ORA	A		;   pulled back onto its last char (the command
  128C'   C2 1298'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  128F'   2A 26DF'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1292'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  1295'   D2 12A5'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1298'                         OPA_CE:				;   deletes the word, not all but its last char
  1298'   2A 26DD'              	LHLD	OPLO
  129B'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  129E'   CA 12E3'              	JZ	OPA_LN
  12A1'   EB                    	XCHG			; HL = the content end
  12A2'                         OPA_HI:
  12A2'   22 26DF'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  12A5'                         OPA_DO:
  12A5'   CD 12C9'              	CALL	OPDSPN
  12A8'   3A 26C9'              	LDA	PSAVE
  12AB'   FE 63                 	CPI	'c'
  12AD'   C8                    	RZ
  12AE'   C3 13E8'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  12B1'                         SPNBRK:
  12B1'   2A 26DD'              	LHLD	OPLO
  12B4'   CD 05DE'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  12B7'   EB                    	XCHG			; DE = it
  12B8'   2A 26DF'              	LHLD	OPHI
  12BB'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  12BE'                         OPSPNL:
  12BE'   2A 26DF'              	LHLD	OPHI
  12C1'   EB                    	XCHG
  12C2'   2A 26DD'              	LHLD	OPLO
  12C5'   EB                    	XCHG			; HL = hi, DE = lo
  12C6'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  12C9'                         OPDSPN:
  12C9'   CD 12B1'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  12CC'   F5                    	PUSH	PSW
  12CD'   2A 26DD'              	LHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12D0'   CD 0000*              	CALL	GOTO
  12D3'   CD 12BE'              	CALL	OPSPNL		; HL = hi - lo
  12D6'   CD 0000*              	CALL	DELFWD
  12D9'   CD 0188'              	CALL	MARKMOD
  12DC'   F1                    	POP	PSW
  12DD'   DA 0700'              	JC	SETFUL		; a break went: every row below it moved up
  12E0'   C3 06E5'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  12E3'                         OPA_LN:
  12E3'   3A 26C9'              	LDA	PSAVE
  12E6'   FE 63                 	CPI	'c'
  12E8'   C2 12F1'              	JNZ	OPA_LD
  12EB'   2A 26DD'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  12EE'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  12F1'                         OPA_LD:
  12F1'   2A 26DD'              	LHLD	OPLO
  12F4'   22 26CD'              	SHLD	OPSTA
  12F7'   22 26CF'              	SHLD	OPEND2
  12FA'   C3 1331'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  12FD'                         OPALSP:
  12FD'   2A 26CD'              	LHLD	OPSTA
  1300'   EB                    	XCHG
  1301'   2A 26CF'              	LHLD	OPEND2
  1304'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1307'   DA 1314'              	JC	OPAL_F
  130A'   22 26DD'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  130D'   EB                    	XCHG
  130E'   22 26DF'              	SHLD	OPHI		; hi-src = start
  1311'   C3 131E'              	JMP	OPAL_R
  1314'                         OPAL_F:
  1314'   EB                    	XCHG			; HL = start
  1315'   22 26DD'              	SHLD	OPLO		; lo-src = start
  1318'   2A 26CF'              	LHLD	OPEND2
  131B'   22 26DF'              	SHLD	OPHI		; hi-src = end
  131E'                         OPAL_R:
  131E'   2A 26DD'              	LHLD	OPLO
  1321'   CD 05CB'              	CALL	BOL
  1324'   22 26DD'              	SHLD	OPLO		; lo = BOL(low line)
  1327'   2A 26DF'              	LHLD	OPHI
  132A'   CD 05FB'              	CALL	NLSTART
  132D'   22 26DF'              	SHLD	OPHI		; hi = start of line past the high line
  1330'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1331'                         OPALIN:
  1331'   CD 12FD'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1334'                         OPDLIN:
  1334'   CD 12C9'              	CALL	OPDSPN
  1337'   CD 064E'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  133A'   DA 134A'              	JC	OPDL_NB
  133D'   CD 0000*              	CALL	LOGLEN
  1340'   7C                    	MOV	A,H
  1341'   B5                    	ORA	L
  1342'   C8                    	RZ			; empty buffer
  1343'   2B                    	DCX	H
  1344'   CD 05CB'              	CALL	BOL
  1347'   CD 0000*              	CALL	GOTO
  134A'                         OPDL_NB:
  134A'   C3 07AD'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  134D'                         OPCTAB:
  134D'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1351'   62 00 42 00           
  1355'   68 00 6C 00           
  1359'   30 00 5E 00           
  135D'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  135F'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1363'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1367'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  136B'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  136F'   24 01                 
  1371'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1375'   47 02 48 02           
  1379'   4D 02 4C 02           
  137D'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  137F'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1381'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1382'                         VCB_C:
  1382'   CD 138E'              	CALL	VCB_CD
  1385'   C3 1459'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1388'                         VCB_D:
  1388'   CD 138E'              	CALL	VCB_CD
  138B'   C3 13E8'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  138E'                         VCB_CD:
  138E'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1391'   22 26DD'              	SHLD	OPLO
  1394'   CD 0000*              	CALL	CUROFF
  1397'   CD 13D7'              	CALL	CEND		; to the line's content end, the CR,LF left
  139A'   22 26DF'              	SHLD	OPHI
  139D'   C3 12C9'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  13A0'                         VC_X:
  13A0'   CD 0852'              	CALL	GLSTAL
  13A3'   CD 06E5'              	CALL	SETLIN
  13A6'   CD 0672'              	CALL	GETCNT
  13A9'   22 26E1'              	SHLD	CNTV
  13AC'   CD 0000*              	CALL	CUROFF
  13AF'   22 26E5'              	SHLD	WKI		; cur
  13B2'   CD 13D7'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  13B5'   EB                    	XCHG			; DE = contentend
  13B6'   2A 26E5'              	LHLD	WKI		; HL = cur
  13B9'   EB                    	XCHG			; HL = contentend, DE = cur
  13BA'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  13BD'   7C                    	MOV	A,H
  13BE'   B5                    	ORA	L
  13BF'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  13C0'   EB                    	XCHG			; DE = available
  13C1'   2A 26E1'              	LHLD	CNTV		; HL = count
  13C4'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  13C7'   DA 13CD'              	JC	VX_USEA
  13CA'   C3 13CE'              	JMP	VX_DEL		; count <= available -> HL = count = del
  13CD'                         VX_USEA:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13CD'   EB                    	XCHG			; HL = available
  13CE'                         VX_DEL:
  13CE'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  13D1'   CD 0188'              	CALL	MARKMOD
  13D4'   C3 13E8'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  13D7'                         CEND:
  13D7'   CD 05DE'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  13DA'   7C                    	MOV	A,H
  13DB'   B5                    	ORA	L
  13DC'   C8                    	RZ			; the start of the text: nothing before it
  13DD'   2B                    	DCX	H
  13DE'   E5                    	PUSH	H
  13DF'   CD 0000*              	CALL	CHARAT
  13E2'   E1                    	POP	H		; HL = term-1
  13E3'   FE 0D                 	CPI	CR
  13E5'   C8                    	RZ			; a CR before the LF -> the content ends there
  13E6'   23                    	INX	H
  13E7'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  13E8'                         CLAMPE:
  13E8'   CD 0000*              	CALL	CUROFF
  13EB'   E5                    	PUSH	H
  13EC'   CD 060A'              	CALL	EOLC
  13EF'   D1                    	POP	D		; DE = cur
  13F0'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  13F3'   D8                    	RC
  13F4'   C8                    	RZ
  13F5'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  13F8'                         VC_I:
  13F8'   CD 0672'              	CALL	GETCNT
  13FB'   C3 1456'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  13FE'                         VC_A:
  13FE'   CD 0672'              	CALL	GETCNT
  1401'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1404'   CA 141B'              	JZ	VA_INS
  1407'   EB                    	XCHG			; HL = cur
  1408'   E5                    	PUSH	H
  1409'   CD 0000*              	CALL	CHARAT
  140C'   E1                    	POP	H
  140D'   FE 0A                 	CPI	LF
  140F'   CA 141B'              	JZ	VA_INS		; on the line terminator -> append in place
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  1412'   FE 0D                 	CPI	CR
  1414'   CA 141B'              	JZ	VA_INS
  1417'   23                    	INX	H
  1418'   CD 0000*              	CALL	GOTO
  141B'                         VA_INS:
  141B'   C3 1456'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  141E'                         VCB_A:
  141E'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1421'   CD 060A'              	CALL	EOLC		; HL = last content char (the start when empty)
  1424'   E5                    	PUSH	H
  1425'   CD 0000*              	CALL	CHARAT
  1428'   E1                    	POP	H
  1429'   FE 0D                 	CPI	CR
  142B'   CA 1434'              	JZ	VBA_IN		; an empty line: insert at its start
  142E'   FE 0A                 	CPI	LF
  1430'   CA 1434'              	JZ	VBA_IN
  1433'   23                    	INX	H		; past the last content char
  1434'                         VBA_IN:
  1434'   CD 0000*              	CALL	GOTO
  1437'   C3 1456'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  143A'                         VCB_I:
  143A'   CD 0672'              	CALL	GETCNT
  143D'   CD 07AD'              	CALL	FNBLNK
  1440'   CD 0000*              	CALL	CUROFF
  1443'   E5                    	PUSH	H
  1444'   CD 0000*              	CALL	CHARAT
  1447'   E1                    	POP	H
  1448'   FE 20                 	CPI	' '
  144A'   CA 1452'              	JZ	VBI_SK
  144D'   FE 09                 	CPI	TAB
  144F'   C2 1456'              	JNZ	SETINM
  1452'                         VBI_SK:
  1452'   23                    	INX	H		; blanks only: past the last of them
  1453'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1456'                         SETINM:
  1456'   CD 06DF'              	CALL	SETMOV
  1459'                         SETINS:
  1459'   3E 01                 	MVI	A,EM_INS
  145B'   32 269E'              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145E'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  145F'                         ATCEND:
  145F'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1462'   C8                    	RZ
  1463'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  1466'   FE 0D                 	CPI	CR
  1468'   C8                    	RZ
  1469'   FE 0A                 	CPI	LF
  146B'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  146C'                         OPNBRK:
  146C'   3E 0D                 	MVI	A,CR
  146E'   CD 0000*              	CALL	PUTGAP
  1471'   3E 0A                 	MVI	A,LF
  1473'   CD 0000*              	CALL	PUTGAP
  1476'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1479'   23                    	INX	H
  147A'   22 0000*              	SHLD	LNDLT
  147D'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1480'                         ENDBRK:
  1480'   CD 064E'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1483'   C0                    	RNZ
  1484'   CD 146C'              	CALL	OPNBRK
  1487'   CD 0000*              	CALL	CUROFF
  148A'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  148B'   2B                    	DCX	H		;   line, with its own terminator after it
  148C'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  148F'                         VC_O:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  148F'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1492'   CD 13D7'              	CALL	CEND
  1495'   CD 0000*              	CALL	GOTO
  1498'   CD 146C'              	CALL	OPNBRK
  149B'   CD 1480'              	CALL	ENDBRK		; a last line with no line end: the opened line
  149E'   CD 06EB'              	CALL	SETILN		;   needs a terminator of its own to exist
  14A1'   C3 1459'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  14A4'                         VCB_O:
  14A4'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14A7'   CD 05CB'              	CALL	BOL
  14AA'   CD 0000*              	CALL	GOTO
  14AD'   CD 146C'              	CALL	OPNBRK
  14B0'   CD 0000*              	CALL	CUROFF
  14B3'   2B                    	DCX	H
  14B4'   2B                    	DCX	H
  14B5'   CD 0000*              	CALL	GOTO
  14B8'   CD 06EB'              	CALL	SETILN
  14BB'   C3 1459'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  14BE'                         VCB_J:
  14BE'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14C1'   CD 13D7'              	CALL	CEND		; the join point: this line's content end
  14C4'   22 26DD'              	SHLD	OPLO
  14C7'   CD 0000*              	CALL	CUROFF
  14CA'   CD 05FB'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  14CD'   E5                    	PUSH	H
  14CE'   CD 0000*              	CALL	LOGLEN
  14D1'   D1                    	POP	D		; DE = that start
  14D2'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  14D5'   CA 06DF'              	JZ	SETMOV
  14D8'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  14D9'                         VJ_WS:
  14D9'   E5                    	PUSH	H
  14DA'   CD 0000*              	CALL	LOGLEN
  14DD'   D1                    	POP	D		; DE = the scan
  14DE'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  14E1'   CA 14F8'              	JZ	VJ_DEL
  14E4'   EB                    	XCHG			; HL = the scan
  14E5'   E5                    	PUSH	H
  14E6'   CD 0000*              	CALL	CHARAT
  14E9'   E1                    	POP	H
  14EA'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14EC'   CA 14F4'              	JZ	VJ_SKIP
  14EF'   FE 09                 	CPI	TAB
  14F1'   C2 14F8'              	JNZ	VJ_DEL
  14F4'                         VJ_SKIP:
  14F4'   23                    	INX	H
  14F5'   C3 14D9'              	JMP	VJ_WS
  14F8'                         VJ_DEL:
  14F8'   22 26DF'              	SHLD	OPHI
  14FB'   CD 12C9'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  14FE'   CD 06FA'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1501'   CD 064E'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1504'   CA 13E8'              	JZ	CLAMPE
  1507'   CD 0659'              	CALL	CURCHR		; the first char of what was appended
  150A'   FE 0D                 	CPI	CR
  150C'   CA 13E8'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  150F'   FE 0A                 	CPI	LF
  1511'   CA 13E8'              	JZ	CLAMPE
  1514'   FE 29                 	CPI	')'
  1516'   CA 13E8'              	JZ	CLAMPE		; vim puts no space before a ')'
  1519'   CD 0000*              	CALL	CUROFF
  151C'   7C                    	MOV	A,H
  151D'   B5                    	ORA	L
  151E'   CA 1534'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1521'   2B                    	DCX	H
  1522'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1525'   FE 20                 	CPI	' '
  1527'   CA 13E8'              	JZ	CLAMPE
  152A'   FE 09                 	CPI	TAB
  152C'   CA 13E8'              	JZ	CLAMPE
  152F'   FE 0A                 	CPI	LF
  1531'   CA 13E8'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1534'                         VJ_SP:
  1534'   3E 20                 	MVI	A,' '
  1536'   CD 0000*              	CALL	PUTGAP
  1539'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  153C'   2B                    	DCX	H
  153D'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1540'                         VC_TILD:
  1540'   CD 0672'              	CALL	GETCNT
  1543'   CD 06E5'              	CALL	SETLIN		; only this row changes
  1546'   CD 0852'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1549'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  154C'   CA 06DF'              	JZ	SETMOV
  154F'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  1552'   FE 0D                 	CPI	CR
  1554'   CA 06DF'              	JZ	SETMOV		; the line's end: nothing to toggle
  1557'   FE 0A                 	CPI	LF
  1559'   CA 06DF'              	JZ	SETMOV
  155C'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  155D'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  155F'   FE 41                 	CPI	'A'
  1561'   DA 156D'              	JC	VT_PUT		; below 'A': no case
  1564'   FE 5B                 	CPI	'Z'+1
  1566'   D2 156D'              	JNC	VT_PUT		; above 'Z': no case
  1569'   78                    	MOV	A,B
  156A'   EE 20                 	XRI	20H		; a letter: flip the case bit
  156C'   47                    	MOV	B,A
  156D'                         VT_PUT:
  156D'   78                    	MOV	A,B
  156E'   32 26EE'              	STA	VRCH		; the calls below do not preserve B
  1571'   CD 0188'              	CALL	MARKMOD
  1574'   21 0001               	LXI	H,1
  1577'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  157A'   3A 26EE'              	LDA	VRCH
  157D'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1580'   C3 13E8'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1583'                         VC_R:
  1583'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  1586'   3E 03                 	MVI	A,PR
  1588'   32 26C6'              	STA	GPEND
  158B'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  158C'                         VR_DO:
  158C'   AF                    	XRA	A
  158D'   32 26C6'              	STA	GPEND
  1590'   79                    	MOV	A,C
  1591'   32 26EE'              	STA	VRCH		; the calls below do not preserve C
  1594'   CD 06E5'              	CALL	SETLIN		; only this row changed
  1597'   CD 0852'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  159A'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  159D'   CA 06DF'              	JZ	SETMOV		; the end of the text: vim does nothing
  15A0'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  15A3'   FE 0D                 	CPI	CR
  15A5'   CA 06DF'              	JZ	SETMOV		; the line's end: nothing to replace
  15A8'   FE 0A                 	CPI	LF
  15AA'   CA 06DF'              	JZ	SETMOV
  15AD'   CD 0188'              	CALL	MARKMOD
  15B0'   21 0001               	LXI	H,1
  15B3'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  15B6'   3A 26EE'              	LDA	VRCH
  15B9'   FE 0D                 	CPI	CR
  15BB'   CA 15C8'              	JZ	VR_CR
  15BE'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  15C1'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15C4'   2B                    	DCX	H		;   out, which moves every logical offset
  15C5'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  15C8'                         VR_CR:
  15C8'   CD 146C'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  15CB'   CD 1480'              	CALL	ENDBRK		;   replaced char may have been the text's last
  15CE'   CD 06EB'              	CALL	SETILN		;   row above it lost the char that was replaced,
  15D1'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  15D3'   32 26A6'              	STA	ILABOV
  15D6'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  15D7'                         VCB_R:
  15D7'   CD 0672'              	CALL	GETCNT
  15DA'   CD 06DF'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  15DD'   21 0000               	LXI	H,0
  15E0'   22 26EF'              	SHLD	RPDEL		; nothing of ours to put back yet
  15E3'   22 26F1'              	SHLD	RPAPP
  15E6'   3E 02                 	MVI	A,EM_REP
  15E8'   32 269E'              	STA	EDMODE
  15EB'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  15EC'                         VC_D:
  15EC'   3E 64                 	MVI	A,'d'
  15EE'   32 26C8'              	STA	PENDOP
  15F1'   C3 06DF'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  15F4'                         VC_C:
  15F4'   3E 63                 	MVI	A,'c'
  15F6'   32 26C8'              	STA	PENDOP
  15F9'   C3 06DF'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  15FC'                         VD_DD:
  15FC'   CD 0852'              	CALL	GLSTAL
  15FF'   CD 0672'              	CALL	GETCNT
  1602'   22 26E1'              	SHLD	CNTV
  1605'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1607'   32 26CA'              	STA	DDSNG
  160A'   2B                    	DCX	H
  160B'   7C                    	MOV	A,H
  160C'   B5                    	ORA	L
  160D'   C2 1618'              	JNZ	VDD_LS
  1610'   3E 01                 	MVI	A,1
  1612'   32 26CA'              	STA	DDSNG
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1615'   C3 161E'              	JMP	VDD_GO
  1618'                         VDD_LS:
  1618'   CD 0818'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  161B'   DA 06DF'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  161E'                         VDD_GO:
  161E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1621'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1624'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1627'   CD 1D90'              	CALL	COPY12		;   every mark in the lines has closed up by then
  162A'   CD 0796'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  162D'   2A 26E1'              	LHLD	CNTV
  1630'   CD 0000*              	CALL	SETC0
  1633'                         VDD_FW:
  1633'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1636'   DA 1784'              	JC	QREFUS		; ... which has no room for them
  1639'   CD 0687'              	CALL	CNTTST
  163C'   C2 1633'              	JNZ	VDD_FW
  163F'   CD 0188'              	CALL	MARKMOD
  1642'   CD 0989'              	CALL	ATEOF
  1645'   D2 1660'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1648'   3E 00                 	MVI	A,0
  164A'   32 26CA'              	STA	DDSNG		; deleted to the end: full repaint
  164D'   CD 0DCF'              	CALL	ONFST
  1650'   CA 07AD'              	JZ	FNBLNK		; nothing left before it
  1653'   21 0001               	LXI	H,1		; onto the new last line
  1656'   CD 0000*              	CALL	SETBWD
  1659'   2A 0000*              	LHLD	LNDLT
  165C'   2B                    	DCX	H
  165D'   22 0000*              	SHLD	LNDLT
  1660'                         VDD_UP:
  1660'   CD 07AD'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1663'   3A 26CA'              	LDA	DDSNG
  1666'   B7                    	ORA	A
  1667'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1668'   3E 03                 	MVI	A,R_DLIN
  166A'   32 26A3'              	STA	RINTENT
  166D'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  166E'                         QEMPTY:
  166E'   2A 0000*              	LHLD	QBEG
  1671'   EB                    	XCHG
  1672'   2A 0000*              	LHLD	QEND
  1675'   7C                    	MOV	A,H
  1676'   BA                    	CMP	D
  1677'   C0                    	RNZ
  1678'   7D                    	MOV	A,L
  1679'   BB                    	CMP	E
  167A'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  167B'                         VC_Y:
  167B'   3E 79                 	MVI	A,'y'
  167D'   32 26C8'              	STA	PENDOP
  1680'   C3 06DF'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1683'                         VY_YY:
  1683'   21 26D1'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1686'   CD 0436'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1689'   CD 0000*              	CALL	CUROFF
  168C'   22 2712'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  168F'   CD 05CB'              	CALL	BOL
  1692'   22 2714'              	SHLD	YPT		; where the lines come from, to put them back
  1695'   CD 17EA'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1698'   CD 182D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  169B'   D2 17F1'              	JNC	YNDONE
  169E'   21 15FC'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  16A1'   C3 16CD'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  16A4'                         OPYANK:
  16A4'   CD 12FD'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  16A7'   2A 26CD'              	LHLD	OPSTA
  16AA'   EB                    	XCHG			; DE = start
  16AB'   2A 26CF'              	LHLD	OPEND2		; HL = end
  16AE'   CD 0000*              	CALL	CMP16		; CY iff start < end
  16B1'   D2 16B5'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  16B4'   EB                    	XCHG			; ... otherwise the start is
  16B5'                         OPY_LO:
  16B5'   22 2712'              	SHLD	YOFF
  16B8'   2A 26DD'              	LHLD	OPLO
  16BB'   22 2714'              	SHLD	YPT		; where the lines come from, to put them back
  16BE'   CD 17EA'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16C1'   CD 18A5'              	CALL	YNSPAN		; copied where they lie, if there is room
  16C4'   D2 17F1'              	JNC	YNDONE
  16C7'   21 17AB'              	LXI	H,YSPAN
  16CA'   C3 16CD'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  16CD'                         YKGO:
  16CD'   22 273B'              	SHLD	YACT
  16D0'   2A 2714'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  16D3'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  16D4'   2A 2712'              	LHLD	YOFF		;   survive this -- the put-back below can page
  16D7'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  16DA'   22 2741'              	SHLD	YCOL		;   them -- but a distance within the lines does
  16DD'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  16E0'   E5                    	PUSH	H		;   pages the window on when the count's lines
  16E1'   2A 2714'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  16E4'   EB                    	XCHG			;   window as it was, then names other text
  16E5'   E1                    	POP	H
  16E6'   CD 0000*              	CALL	SUBHD
  16E9'   EB                    	XCHG			; DE = how far behind the cursor they start
  16EA'   CD 0E7A'              	CALL	CURFP
  16ED'   06 00                 	MVI	B,0
  16EF'   CD 0E70'              	CALL	SUB24
  16F2'   22 2743'              	SHLD	YPFP
  16F5'   32 2745'              	STA	YPFP+2
  16F8'   3A 26A2'              	LDA	MODF
  16FB'   32 270F'              	STA	YMODF
  16FE'   3A 26BB'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1701'   32 2710'              	STA	YDCHG		;   a yank must not become the last change
  1704'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1707'   32 2711'              	STA	YURPL		;   back are not a change to undo either
  170A'   3E 01                 	MVI	A,1
  170C'   32 0000*              	STA	UNDRPL
  170F'   32 273A'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1712'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1715'   22 271D'              	SHLD	YLDLT
  1718'   CD 0000*              	CALL	LOGLEN
  171B'   22 273F'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  171E'   2A 273B'              	LHLD	YACT
  1721'   CD 1783'              	CALL	YCALL		; the lines out of the file, into the register
  1724'   3A 270A'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1727'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  1729'   CA 1767'              	JZ	YK_RF		;   cursor: only the flags are still owed
  172C'   CD 0000*              	CALL	LOGLEN
  172F'   EB                    	XCHG
  1730'   2A 273F'              	LHLD	YWAS
  1733'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1736'   CA 1748'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1739'   21 2743'              	LXI	H,YPFP		; back to where they came from, by its place in
  173C'   CD 03E9'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  173F'   CD 03C2'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1742'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1745'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1748'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1748'   2A 2743'              	LHLD	YPFP		;   cursor is still owed its place)
  174B'   EB                    	XCHG
  174C'   2A 2741'              	LHLD	YCOL
  174F'   19                    	DAD	D
  1750'   22 2736'              	SHLD	MKPOS
  1753'   3A 2745'              	LDA	YPFP+2
  1756'   CE 00                 	ACI	0
  1758'   32 2738'              	STA	MKPOS+2
  175B'   CD 03C2'              	CALL	MKPAGE
  175E'   CD 0000*              	CALL	GOTO
  1761'                         YK_RST:
  1761'   2A 271D'              	LHLD	YLDLT
  1764'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1767'                         YK_RF:
  1767'   3A 270F'              	LDA	YMODF
  176A'   32 26A2'              	STA	MODF
  176D'   3A 2710'              	LDA	YDCHG
  1770'   32 26BB'              	STA	DOTCHG
  1773'   3A 2711'              	LDA	YURPL
  1776'   32 0000*              	STA	UNDRPL
  1779'   AF                    	XRA	A
  177A'   32 273A'              	STA	MKHOLD
  177D'   CD 0852'              	CALL	GLSTAL
  1780'   C3 0700'              	JMP	SETFUL		; the cheap paint cannot carry this
  1783'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1784'                         QREFUS:
  1784'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1787'   CD 166E'              	CALL	QEMPTY
  178A'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  178D'   CD 0000*              	CALL	QKILL
  1790'   3A 273A'              	LDA	MKHOLD
  1793'   B7                    	ORA	A
  1794'   C2 17A3'              	JNZ	QRF_Y
  1797'   21 0000*              	LXI	H,MKSAV
  179A'   11 0000*              	LXI	D,MKTAB
  179D'   CD 1D90'              	CALL	COPY12
  17A0'   CD 0000*              	CALL	UNDCLR
  17A3'                         QRF_Y:
  17A3'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  17A5'   32 270A'              	STA	MSGWHT
  17A8'   C3 119F'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  17AB'                         YSPAN:
  17AB'   CD 0852'              	CALL	GLSTAL
  17AE'   CD 12BE'              	CALL	OPSPNL		; HL = the span's length
  17B1'   22 273D'              	SHLD	YTGT
  17B4'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  17B7'   EB                    	XCHG			; DE = it
  17B8'   2A 273D'              	LHLD	YTGT
  17BB'   EB                    	XCHG			; HL = the text's, DE = the span's
  17BC'   CD 0000*              	CALL	SUBHD
  17BF'   22 273D'              	SHLD	YTGT		; what the text is left at when the span is out
  17C2'   2A 26DD'              	LHLD	OPLO
  17C5'   CD 0000*              	CALL	GOTO
  17C8'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17CB'                         YS_LP:
  17CB'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  17CE'   CD 0000*              	CALL	SETC0
  17D1'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  17D4'   DA 1784'              	JC	QREFUS		; ... which has no room for it
  17D7'   CD 0000*              	CALL	LOGLEN
  17DA'   EB                    	XCHG			; DE = what is left
  17DB'   2A 273D'              	LHLD	YTGT
  17DE'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  17E1'   DA 17E7'              	JC	YS_END		; below it -- cannot happen over whole lines,
  17E4'   C2 17CB'              	JNZ	YS_LP		;   but never spin here if it ever did
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  17E7'                         YS_END:
  17E7'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  17EA'                         YNPRE:
  17EA'   2A 0000*              	LHLD	PGTOPM
  17ED'   22 2746'              	SHLD	YNPG
  17F0'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  17F1'                         YNDONE:
  17F1'   2A 2712'              	LHLD	YOFF
  17F4'   CD 0000*              	CALL	GOTO
  17F7'   2A 0000*              	LHLD	PGTOPM
  17FA'   EB                    	XCHG
  17FB'   2A 2746'              	LHLD	YNPG
  17FE'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1801'   C2 0700'              	JNZ	SETFUL		; it moved under us: repaint after all
  1804'   C3 06DF'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                ; whatever the regions below the text are not using.
  1807'                         YNROOM:
  1807'   11 0100               	LXI	D,100H
  180A'   19                    	DAD	D
  180B'   D8                    	RC			; within a chunk of 64K: no arena holds that
  180C'   E5                    	PUSH	H		; the span plus its slack
  180D'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1810'   EB                    	XCHG			; HL = free
  1811'   D1                    	POP	D		; DE = the span plus its slack
  1812'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1815'   DA 181D'              	JC	YNR_OK
  1818'   CA 181D'              	JZ	YNR_OK
  181B'   37                    	STC			; not enough: the delete-and-put-back path
  181C'   C9                    	RET
  181D'                         YNR_OK:
  181D'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  181E'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  181F'                         YNGO:
  181F'   C5                    	PUSH	B
  1820'   CD 0672'              	CALL	GETCNT		; spent here: this yank is happening
  1823'   CD 0852'              	CALL	GLSTAL
  1826'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1829'   C1                    	POP	B
  182A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  182D'                         YNCOPY:
  182D'   2A 269F'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1830'   7C                    	MOV	A,H		;   the count itself
  1831'   B5                    	ORA	L
  1832'   C2 1838'              	JNZ	YNC_HV
  1835'   21 0001               	LXI	H,1
  1838'                         YNC_HV:
  1838'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1839'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  183A'   B4                    	ORA	H
  183B'   CA 1846'              	JZ	YNC_M
  183E'   E5                    	PUSH	H
  183F'   CD 0818'              	CALL	ONLAST		; vim: a count over one on the last line does
  1842'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1843'   DA 1858'              	JC	YNC_RF
  1846'                         YNC_M:
  1846'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1847'   CD 0796'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  184A'   E1                    	POP	H
  184B'   CD 1860'              	CALL	YNLINE		; BC = the span, measured where it stands
  184E'   D8                    	RC			; not measurable here: let the pager answer it
  184F'   60                    	MOV	H,B
  1850'   69                    	MOV	L,C
  1851'   CD 1807'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1854'   D8                    	RC			; no: the delete-and-put-back path
  1855'   C3 181F'              	JMP	YNGO
  1858'                         YNC_RF:
  1858'   CD 0672'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  185B'   CD 0852'              	CALL	GLSTAL		;   register alone, and that is the command
  185E'   B7                    	ORA	A		; NC: done
  185F'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1860'                         YNLINE:
  1860'   22 2748'              	SHLD	YNCNT		; the lines it still wants
  1863'   2A 0000*              	LHLD	GAPEND
  1866'                         YNL_LP:
  1866'   EB                    	XCHG			; DE = the scan
  1867'   2A 0000*              	LHLD	TXTEND
  186A'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  186D'   EB                    	XCHG			; HL = the scan
  186E'   D2 188E'              	JNC	YNL_EN		; the resident text ran out
  1871'   7E                    	MOV	A,M
  1872'   23                    	INX	H
  1873'   FE 0A                 	CPI	LF
  1875'   C2 1866'              	JNZ	YNL_LP
  1878'   E5                    	PUSH	H
  1879'   2A 2748'              	LHLD	YNCNT
  187C'   2B                    	DCX	H
  187D'   22 2748'              	SHLD	YNCNT
  1880'   7C                    	MOV	A,H
  1881'   B5                    	ORA	L
  1882'   E1                    	POP	H
  1883'   C2 1866'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1886'   EB                    	XCHG			; DE = past the last of them
  1887'   2A 0000*              	LHLD	GAPEND
  188A'   EB                    	XCHG			; HL = past them, DE = GAPEND
  188B'   C3 189C'              	JMP	YNL_BC
  188E'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  188E'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1891'   C2 18A3'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1894'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1897'   EB                    	XCHG			;   count clamps to it as vim's does
  1898'   2A 0000*              	LHLD	GAPEND
  189B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  189C'                         YNL_BC:
  189C'   CD 0000*              	CALL	SUBHD		; HL = the span
  189F'   44                    	MOV	B,H
  18A0'   4D                    	MOV	C,L
  18A1'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  18A2'   C9                    	RET
  18A3'                         YNL_NO:
  18A3'   37                    	STC
  18A4'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  18A5'                         YNSPAN:
  18A5'   CD 12BE'              	CALL	OPSPNL		; HL = the span's length
  18A8'   44                    	MOV	B,H
  18A9'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  18AA'   CD 1807'              	CALL	YNROOM
  18AD'   D8                    	RC			; no room: the delete-and-put-back path
  18AE'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  18AF'   2A 26DD'              	LHLD	OPLO
  18B2'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  18B5'   C1                    	POP	B
  18B6'   C3 181F'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  18B9'                         VC_P:
  18B9'   CD 166E'              	CALL	QEMPTY
  18BC'   CA 1974'              	JZ	VP_BEL
  18BF'   CD 0672'              	CALL	GETCNT
  18C2'   22 2716'              	SHLD	PCNT
  18C5'   CD 0000*              	CALL	CUROFF
  18C8'   CD 05FB'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  18CB'   C3 18E0'              	JMP	VP_GO
  18CE'                         VCB_P:
  18CE'   CD 166E'              	CALL	QEMPTY
  18D1'   CA 1974'              	JZ	VP_BEL
  18D4'   CD 0672'              	CALL	GETCNT
  18D7'   22 2716'              	SHLD	PCNT
  18DA'   CD 0000*              	CALL	CUROFF
  18DD'   CD 05CB'              	CALL	BOL
  18E0'                         VP_GO:
  18E0'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  18E3'   CD 0000*              	CALL	CUROFF
  18E6'   EB                    	XCHG
  18E7'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  18EA'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  18ED'   DA 1902'              	JC	VP_IN
  18F0'   EB                    	XCHG			; HL = the put point = LOGLEN
  18F1'   7C                    	MOV	A,H
  18F2'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18F3'   CA 18FF'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  18F6'   2B                    	DCX	H
  18F7'   CD 0000*              	CALL	CHARAT
  18FA'   FE 0A                 	CPI	LF
  18FC'   CA 1902'              	JZ	VP_IN
  18FF'                         VP_BRK:
  18FF'   CD 146C'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1902'                         VP_IN:
  1902'   CD 0000*              	CALL	CUROFF
  1905'   22 2718'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1908'   2A 0000*              	LHLD	QBEG
  190B'   EB                    	XCHG
  190C'   2A 0000*              	LHLD	QEND
  190F'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1912'   EB                    	XCHG
  1913'   22 271A'              	SHLD	PLFS
  1916'   2A 2716'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1919'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  191A'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  191B'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  191D'   C2 1921'              	JNZ	VP_PZ
  1920'   7D                    	MOV	A,L
  1921'                         VP_PZ:
  1921'   32 271C'              	STA	PCPY
  1924'                         VP_LP:
  1924'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1927'   2A 0000*              	LHLD	LNDLT
  192A'   EB                    	XCHG
  192B'   2A 271A'              	LHLD	PLFS
  192E'   19                    	DAD	D
  192F'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1932'   2A 2716'              	LHLD	PCNT
  1935'   2B                    	DCX	H
  1936'   22 2716'              	SHLD	PCNT
  1939'   7C                    	MOV	A,H
  193A'   B5                    	ORA	L
  193B'   C2 1924'              	JNZ	VP_LP
  193E'   CD 0188'              	CALL	MARKMOD
  1941'   2A 2718'              	LHLD	PPT
  1944'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1947'   CD 0852'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  194A'   3A 271C'              	LDA	PCPY
  194D'   B7                    	ORA	A
  194E'   CA 07AD'              	JZ	FNBLNK
  1951'   2A 271A'              	LHLD	PLFS
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1954'   7C                    	MOV	A,H
  1955'   B7                    	ORA	A
  1956'   C2 07AD'              	JNZ	FNBLNK
  1959'   3A 271C'              	LDA	PCPY
  195C'   CD 0D65'              	CALL	MULSAT		; HL = the lines this put put, saturated
  195F'   7C                    	MOV	A,H
  1960'   B7                    	ORA	A
  1961'   C2 07AD'              	JNZ	FNBLNK
  1964'   7D                    	MOV	A,L
  1965'   B7                    	ORA	A
  1966'   CA 07AD'              	JZ	FNBLNK
  1969'   F5                    	PUSH	PSW
  196A'   CD 06EB'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  196D'   F1                    	POP	PSW
  196E'   32 26A4'              	STA	ILN		; ... which the lines put now replace
  1971'   C3 07AD'              	JMP	FNBLNK
  1974'                         VP_BEL:
  1974'   CD 0672'              	CALL	GETCNT		; the count is spent either way
  1977'   0E 07                 	MVI	C,BEL
  1979'   CD 0000*              	CALL	BCONOU
  197C'   C3 06DF'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  197F'                         VIREP:
  197F'   78                    	MOV	A,B
  1980'   FE 01                 	CPI	KT_ACT
  1982'   CA 1AAF'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1985'   FE 02                 	CPI	KT_CHAR
  1987'   C0                    	RNZ			; ignore anything else
  1988'   79                    	MOV	A,C
  1989'   FE 0D                 	CPI	CR
  198B'   CA 19EF'              	JZ	VP_CR
  198E'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1990'   CA 19EF'              	JZ	VP_CR
  1993'   FE 08                 	CPI	BS
  1995'   CA 19FB'              	JZ	VP_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1998'   FE 7F                 	CPI	DEL
  199A'   CA 19FB'              	JZ	VP_BS
  199D'   32 26EE'              	STA	VRCH		; the calls below do not preserve C
  19A0'   CD 06E5'              	CALL	SETLIN		; this row changed
  19A3'   CD 0188'              	CALL	MARKMOD
  19A6'   CD 145F'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  19A9'   CA 19E1'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  19AC'   3A 26EE'              	LDA	VRCH
  19AF'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  19B2'   2A 26EF'              	LHLD	RPDEL
  19B5'   7C                    	MOV	A,H
  19B6'   B5                    	ORA	L
  19B7'   CA 19CD'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  19BA'   2A 0000*              	LHLD	GAPEND
  19BD'   EB                    	XCHG
  19BE'   2A 26F3'              	LHLD	RPGE
  19C1'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  19C4'   CA 19CD'              	JZ	VP_OVW
  19C7'   21 0000               	LXI	H,0
  19CA'   22 26EF'              	SHLD	RPDEL		; the text moved: those originals are gone
  19CD'                         VP_OVW:
  19CD'   21 0001               	LXI	H,1
  19D0'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  19D3'   2A 0000*              	LHLD	GAPEND
  19D6'   22 26F3'              	SHLD	RPGE
  19D9'   2A 26EF'              	LHLD	RPDEL
  19DC'   23                    	INX	H
  19DD'   22 26EF'              	SHLD	RPDEL
  19E0'   C9                    	RET
  19E1'                         VP_APP:
  19E1'   3A 26EE'              	LDA	VRCH
  19E4'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  19E7'   2A 26F1'              	LHLD	RPAPP
  19EA'   23                    	INX	H
  19EB'   22 26F1'              	SHLD	RPAPP
  19EE'   C9                    	RET
  19EF'                         VP_CR:
  19EF'   21 0000               	LXI	H,0
  19F2'   22 26EF'              	SHLD	RPDEL		; a line break ends what BS can put back
  19F5'   22 26F1'              	SHLD	RPAPP
  19F8'   C3 1A85'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  19FB'                         VP_BS:
  19FB'   2A 26F1'              	LHLD	RPAPP
  19FE'   7C                    	MOV	A,H
  19FF'   B5                    	ORA	L
  1A00'   CA 1A0D'              	JZ	VP_BSD
  1A03'   2B                    	DCX	H
  1A04'   22 26F1'              	SHLD	RPAPP		; an appended char: it just goes
  1A07'   CD 06E5'              	CALL	SETLIN
  1A0A'   C3 0000*              	JMP	DELPRV
  1A0D'                         VP_BSD:
  1A0D'   2A 26EF'              	LHLD	RPDEL
  1A10'   7C                    	MOV	A,H
  1A11'   B5                    	ORA	L
  1A12'   CA 1A39'              	JZ	VP_BSM		; nothing of ours left
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A15'   2A 0000*              	LHLD	GAPEND
  1A18'   EB                    	XCHG
  1A19'   2A 26F3'              	LHLD	RPGE
  1A1C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1A1F'   C2 1A39'              	JNZ	VP_BSM
  1A22'   2A 26EF'              	LHLD	RPDEL
  1A25'   2B                    	DCX	H
  1A26'   22 26EF'              	SHLD	RPDEL
  1A29'   CD 06E5'              	CALL	SETLIN
  1A2C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1A2F'   CD 0000*              	CALL	UNDELF		; the original comes back
  1A32'   2A 0000*              	LHLD	GAPEND
  1A35'   22 26F3'              	SHLD	RPGE
  1A38'   C9                    	RET
  1A39'                         VP_BSM:
  1A39'   CD 06DF'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1A3C'   C3 074E'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1A3F'                         VIINS:
  1A3F'   78                    	MOV	A,B
  1A40'   FE 01                 	CPI	KT_ACT
  1A42'   CA 1AAF'              	JZ	VI_ACT
  1A45'   FE 02                 	CPI	KT_CHAR
  1A47'   C0                    	RNZ			; ignore anything else
  1A48'   79                    	MOV	A,C
  1A49'   FE 0D                 	CPI	CR
  1A4B'   CA 1A85'              	JZ	VI_CR
  1A4E'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1A50'   CA 1A85'              	JZ	VI_CR
  1A53'   FE 08                 	CPI	BS
  1A55'   CA 1A9D'              	JZ	VI_BS
  1A58'   FE 7F                 	CPI	DEL
  1A5A'   CA 1A9D'              	JZ	VI_BS
  1A5D'   79                    	MOV	A,C
  1A5E'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1A61'   CD 0188'              	CALL	MARKMOD
  1A64'   CD 06E5'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1A67'   79                    	MOV	A,C
  1A68'   FE 20                 	CPI	' '
  1A6A'   D8                    	RC			; control char -> keep R_LINE
  1A6B'   FE 7F                 	CPI	DEL
  1A6D'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1A6E'   CD 0706'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1A71'   B7                    	ORA	A
  1A72'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1A73'   3E 04                 	MVI	A,R_ICH
  1A75'   32 26A3'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1A78'   CD 145F'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1A7B'   3E 00                 	MVI	A,0
  1A7D'   C2 1A81'              	JNZ	VI_ICH
  1A80'   3C                    	INR	A
  1A81'                         VI_ICH:
  1A81'   32 26A5'              	STA	ICHAPP
  1A84'   C9                    	RET
  1A85'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1A85'   CD 145F'              	CALL	ATCEND
  1A88'   3E 00                 	MVI	A,0
  1A8A'   CA 1A8E'              	JZ	VI_CRS
  1A8D'   3C                    	INR	A
  1A8E'                         VI_CRS:
  1A8E'   F5                    	PUSH	PSW
  1A8F'   CD 146C'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1A92'   CD 1480'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1A95'   CD 06EB'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1A98'   F1                    	POP	PSW
  1A99'   32 26A6'              	STA	ILABOV
  1A9C'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1A9D'                         VI_BS:
  1A9D'   CD 0000*              	CALL	PEEKL
  1AA0'   D8                    	RC			; start of the file: nothing to delete
  1AA1'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1AA3'   CA 1AA9'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1AA6'   CD 06E5'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1AA9'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1AA9'   CD 0188'              	CALL	MARKMOD
  1AAC'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1AAF'                         VI_ACT:
  1AAF'   79                    	MOV	A,C
  1AB0'   FE 0B                 	CPI	ACT_ESC
  1AB2'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1AB3'   3E 00                 	MVI	A,EM_CMD
  1AB5'   32 269E'              	STA	EDMODE
  1AB8'   CD 06DF'              	CALL	SETMOV
  1ABB'   CD 074E'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1ABE'   C3 0852'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1AC1'                         RDLINE:
  1AC1'   EB                    	XCHG			; HL = buffer
  1AC2'   22 26F5'              	SHLD	RLPTR
  1AC5'   3E 00                 	MVI	A,0
  1AC7'   32 26F7'              	STA	RLLEN
  1ACA'   78                    	MOV	A,B
  1ACB'   32 26F8'              	STA	RLMAX
  1ACE'   79                    	MOV	A,C
  1ACF'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1AD2'                         RL_LP:
  1AD2'   CD 0000*              	CALL	GETKEY
  1AD5'   78                    	MOV	A,B
  1AD6'   FE 01                 	CPI	KT_ACT
  1AD8'   CA 1B2E'              	JZ	RL_ACT
  1ADB'   FE 02                 	CPI	KT_CHAR
  1ADD'   C2 1AD2'              	JNZ	RL_LP		; ignore other keys
  1AE0'   79                    	MOV	A,C
  1AE1'   FE 0D                 	CPI	CR
  1AE3'   CA 1B3F'              	JZ	RL_DONE
  1AE6'   FE 08                 	CPI	BS
  1AE8'   CA 1B16'              	JZ	RL_BS
  1AEB'   FE 7F                 	CPI	DEL
  1AED'   CA 1B16'              	JZ	RL_BS
  1AF0'   FE 20                 	CPI	' '
  1AF2'   DA 1AD2'              	JC	RL_LP		; control char -> ignore
  1AF5'   3A 26F7'              	LDA	RLLEN
  1AF8'   47                    	MOV	B,A
  1AF9'   3A 26F8'              	LDA	RLMAX
  1AFC'   B8                    	CMP	B
  1AFD'   CA 1AD2'              	JZ	RL_LP		; full -> ignore
  1B00'   2A 26F5'              	LHLD	RLPTR
  1B03'   71                    	MOV	M,C
  1B04'   23                    	INX	H
  1B05'   22 26F5'              	SHLD	RLPTR
  1B08'   3A 26F7'              	LDA	RLLEN
  1B0B'   3C                    	INR	A
  1B0C'   32 26F7'              	STA	RLLEN
  1B0F'   79                    	MOV	A,C
  1B10'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1B13'   C3 1AD2'              	JMP	RL_LP
  1B16'                         RL_BS:				; WM LINEPOP
  1B16'   3A 26F7'              	LDA	RLLEN
  1B19'   B7                    	ORA	A
  1B1A'   CA 1B34'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1B1D'   3D                    	DCR	A
  1B1E'   32 26F7'              	STA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B21'   2A 26F5'              	LHLD	RLPTR
  1B24'   2B                    	DCX	H
  1B25'   22 26F5'              	SHLD	RLPTR
  1B28'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1B2B'   C3 1AD2'              	JMP	RL_LP
  1B2E'                         RL_ACT:
  1B2E'   79                    	MOV	A,C
  1B2F'   FE 0B                 	CPI	ACT_ESC
  1B31'   C2 1AD2'              	JNZ	RL_LP
  1B34'                         RL_CAN:
  1B34'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1B36'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1B39'   CD 06E5'              	CALL	SETLIN		; redraw one row
  1B3C'   3E FF                 	MVI	A,0FFH		; cancelled
  1B3E'   C9                    	RET
  1B3F'                         RL_DONE:
  1B3F'   AF                    	XRA	A
  1B40'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1B41'                         VC_BZ:
  1B41'   CD 06DF'              	CALL	SETMOV
  1B44'   3A 26C7'              	LDA	GSAVE
  1B47'   FE 02                 	CPI	PZ
  1B49'   CA 1B54'              	JZ	VZ_ZZ
  1B4C'   B7                    	ORA	A
  1B4D'   C0                    	RNZ			; 'g' was pending: vim drops both
  1B4E'   3E 02                 	MVI	A,PZ
  1B50'   32 26C6'              	STA	GPEND
  1B53'   C9                    	RET
  1B54'                         VZ_ZZ:
  1B54'   3E 04                 	MVI	A,EO_X
  1B56'   32 26F9'              	STA	EXOP
  1B59'   3E 01                 	MVI	A,1
  1B5B'   32 270C'              	STA	EXBANG		; no '!'
  1B5E'   AF                    	XRA	A
  1B5F'   32 26FA'              	STA	EXARG		; no file name
  1B62'   3A 26A2'              	LDA	MODF		; as ':x': a changed text is written first
  1B65'   B7                    	ORA	A
  1B66'   CA 1C89'              	JZ	EX_Q
  1B69'   C3 1C23'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1B6C'                         VC_EX:
  1B6C'   CD 0672'              	CALL	GETCNT
  1B6F'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1B72'   11 0000*              	LXI	D,EXBUF
  1B75'   06 28                 	MVI	B,EXMAX
  1B77'   0E 3A                 	MVI	C,':'
  1B79'   CD 1AC1'              	CALL	RDLINE
  1B7C'   B7                    	ORA	A
  1B7D'   C0                    	RNZ			; cancelled
  1B7E'   3A 26F7'              	LDA	RLLEN
  1B81'   5F                    	MOV	E,A
  1B82'   16 00                 	MVI	D,0
  1B84'   21 0000*              	LXI	H,EXBUF
  1B87'   19                    	DAD	D
  1B88'   36 00                 	MVI	M,0		; the line ends with a 0
  1B8A'   21 0000*              	LXI	H,EXBUF
  1B8D'   CD 1F25'              	CALL	SKIPB
  1B90'   C8                    	RZ			; nothing on it
  1B91'   22 26FC'              	SHLD	EXCMD
  1B94'   CD 20E1'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1B97'   CD 1F25'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1B9A'   56                    	MOV	D,M
  1B9B'   23                    	INX	H
  1B9C'   1E 00                 	MVI	E,0
  1B9E'   CD 1F31'              	CALL	ISLOW
  1BA1'   DA 1BAC'              	JC	EX_LK
  1BA4'   5F                    	MOV	E,A
  1BA5'   23                    	INX	H
  1BA6'   CD 1F31'              	CALL	ISLOW
  1BA9'   D2 1BC5'              	JNC	EX_NOT		; a third letter: none of ours
  1BAC'                         EX_LK:
  1BAC'   E5                    	PUSH	H
  1BAD'   21 20CB'              	LXI	H,EXTAB
  1BB0'                         EX_TL:
  1BB0'   7E                    	MOV	A,M
  1BB1'   B7                    	ORA	A
  1BB2'   CA 1BC4'              	JZ	EX_NTP		; not in the table
  1BB5'   23                    	INX	H
  1BB6'   BA                    	CMP	D
  1BB7'   7E                    	MOV	A,M
  1BB8'   23                    	INX	H
  1BB9'   C2 1BC0'              	JNZ	EX_TN
  1BBC'   BB                    	CMP	E
  1BBD'   CA 1BCB'              	JZ	EX_TF
  1BC0'                         EX_TN:
  1BC0'   23                    	INX	H
  1BC1'   C3 1BB0'              	JMP	EX_TL
  1BC4'                         EX_NTP:
  1BC4'   E1                    	POP	H
  1BC5'                         EX_NOT:
  1BC5'   21 1FE9'              	LXI	H,SNOT
  1BC8'   C3 1F66'              	JMP	EXERT
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BCB'                         EX_TF:
  1BCB'   7E                    	MOV	A,M
  1BCC'   32 26F9'              	STA	EXOP
  1BCF'   E1                    	POP	H
  1BD0'   FE 06                 	CPI	EO_S
  1BD2'   CA 2150'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1BD5'   3A 2751'              	LDA	SRNGF
  1BD8'   B7                    	ORA	A
  1BD9'   C2 1BC5'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1BDC'   7E                    	MOV	A,M
  1BDD'   D6 21                 	SUI	'!'
  1BDF'   32 270C'              	STA	EXBANG		; 0 = '!'
  1BE2'   C2 1BE6'              	JNZ	EX_NB
  1BE5'   23                    	INX	H
  1BE6'                         EX_NB:
  1BE6'   CD 1F25'              	CALL	SKIPB
  1BE9'   32 26FA'              	STA	EXARG		; 0 = no file name
  1BEC'   CA 1C05'              	JZ	EX_RUN
  1BEF'   22 26FC'              	SHLD	EXCMD
  1BF2'   3A 26F9'              	LDA	EXOP
  1BF5'   FE 02                 	CPI	EO_Q
  1BF7'   CA 1F63'              	JZ	EX_TRL		; :q takes none
  1BFA'   FE 07                 	CPI	EO_V
  1BFC'   CA 1F63'              	JZ	EX_TRL		; nor :ve
  1BFF'   CD 1E8F'              	CALL	PARSFN
  1C02'   C2 1F57'              	JNZ	EX_INV
  1C05'                         EX_RUN:
  1C05'   3A 26F9'              	LDA	EXOP
  1C08'   FE 05                 	CPI	EO_E
  1C0A'   CA 1CA0'              	JZ	EX_E
  1C0D'   FE 02                 	CPI	EO_Q
  1C0F'   CA 1C89'              	JZ	EX_Q
  1C12'   FE 07                 	CPI	EO_V
  1C14'   CA 1F5D'              	JZ	EX_V
  1C17'   FE 04                 	CPI	EO_X
  1C19'   C2 1C23'              	JNZ	EX_W
  1C1C'   3A 26A2'              	LDA	MODF		; :x writes only a changed text
  1C1F'   B7                    	ORA	A
  1C20'   CA 1C89'              	JZ	EX_Q
  1C23'                         EX_W:
  1C23'   CD 1CF7'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1C26'   D8                    	RC			; refused (message shown)
  1C27'   32 26FB'              	STA	EXBAK
  1C2A'   3A 26F9'              	LDA	EXOP
  1C2D'   FE 01                 	CPI	EO_W
  1C2F'   CA 1C46'              	JZ	EX_WK
  1C32'   3A 26FB'              	LDA	EXBAK
  1C35'   B7                    	ORA	A
  1C36'   C2 1C86'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1C39'   3A 270C'              	LDA	EXBANG
  1C3C'   B7                    	ORA	A
  1C3D'   CA 1C86'              	JZ	EX_WQ		; so it does with '!'
  1C40'   CD 1C46'              	CALL	EX_WK		; else it may not: keep the text
  1C43'   C3 1C89'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C46'                         EX_WK:
  1C46'   CD 0C71'              	CALL	CURRW		; the cursor's row and file position
  1C49'   32 26FE'              	STA	WPROW
  1C4C'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1C4F'   7D                    	MOV	A,L
  1C50'   E6 7F                 	ANI	7FH
  1C52'   32 26FF'              	STA	WPBYT
  1C55'   7D                    	MOV	A,L
  1C56'   17                    	RAL
  1C57'   7C                    	MOV	A,H
  1C58'   17                    	RAL
  1C59'   5F                    	MOV	E,A
  1C5A'   3E 00                 	MVI	A,0
  1C5C'   17                    	RAL
  1C5D'   57                    	MOV	D,A		; DE = HL / 128
  1C5E'   2A 0000*              	LHLD	OUTPOS
  1C61'   19                    	DAD	D
  1C62'   22 2700'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1C65'   CD 1D2C'              	CALL	WRITE
  1C68'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1C6B'   2A 2700'              	LHLD	WPREC
  1C6E'   EB                    	XCHG
  1C6F'   3A 26FF'              	LDA	WPBYT
  1C72'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1C75'   CD 0000*              	CALL	GOTO
  1C78'   21 0000               	LXI	H,0
  1C7B'   22 0000*              	SHLD	LNDLT
  1C7E'   3A 26FE'              	LDA	WPROW
  1C81'   6F                    	MOV	L,A
  1C82'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1C85'   C9                    	RET
  1C86'                         EX_WQ:
  1C86'   CD 1D2C'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1C89'                         EX_Q:
  1C89'   3A 270C'              	LDA	EXBANG
  1C8C'   B7                    	ORA	A
  1C8D'   CA 1C97'              	JZ	EX_QT
  1C90'   3A 26A2'              	LDA	MODF
  1C93'   B7                    	ORA	A
  1C94'   C2 1F4B'              	JNZ	MSGNWR		; changed, no '!': stay
  1C97'                         EX_QT:
  1C97'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1C9A'   3E 01                 	MVI	A,1
  1C9C'   32 26A1'              	STA	QUITF
  1C9F'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1CA0'                         EX_E:
  1CA0'   3A 270C'              	LDA	EXBANG
  1CA3'   B7                    	ORA	A
  1CA4'   CA 1CAE'              	JZ	EE_GO
  1CA7'   3A 26A2'              	LDA	MODF
  1CAA'   B7                    	ORA	A
  1CAB'   C2 1F4B'              	JNZ	MSGNWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1CAE'                         EE_GO:
  1CAE'   3A 26FA'              	LDA	EXARG
  1CB1'   B7                    	ORA	A
  1CB2'   C2 1CB9'              	JNZ	EE_ARG
  1CB5'   CD 1D68'              	CALL	OWNTF		; no name: the buffer's own
  1CB8'   D8                    	RC
  1CB9'                         EE_ARG:
  1CB9'   CD 1D7E'              	CALL	ISOWN
  1CBC'   21 0001               	LXI	H,1
  1CBF'   C2 1CC6'              	JNZ	EE_LD		; another file: its first line
  1CC2'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1CC5'   23                    	INX	H		; HL = the cursor's line
  1CC6'                         EE_LD:
  1CC6'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1CC8'   32 270A'              	STA	MSGWHT
  1CCB'   E5                    	PUSH	H
  1CCC'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1CCF'   21 0000*              	LXI	H,TFCB
  1CD2'   11 0000*              	LXI	D,FNAME
  1CD5'   CD 1D90'              	CALL	COPY12		; the buffer's name
  1CD8'   CD 1D55'              	CALL	SRCTF
  1CDB'   CD 0000*              	CALL	REOPEN
  1CDE'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1CE1'   AF                    	XRA	A
  1CE2'   32 26A2'              	STA	MODF
  1CE5'   E1                    	POP	H
  1CE6'   2B                    	DCX	H
  1CE7'   AF                    	XRA	A
  1CE8'   CD 0000*              	CALL	MVLIND		; down to the line
  1CEB'   CD 0989'              	CALL	ATEOF
  1CEE'   DC 098F'              	CC	LASTLN		; past the last line: onto it
  1CF1'   CD 0E9D'              	CALL	ZSAVE
  1CF4'   C3 0F80'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1CF7'                         WRCHK:
  1CF7'   3A 26FA'              	LDA	EXARG
  1CFA'   B7                    	ORA	A
  1CFB'   C2 1D05'              	JNZ	WC_ARG
  1CFE'   CD 1D68'              	CALL	OWNTF
  1D01'   D8                    	RC
  1D02'   C3 1D1A'              	JMP	WC_OWN
  1D05'                         WC_ARG:
  1D05'   CD 1D7E'              	CALL	ISOWN
  1D08'   CA 1D1A'              	JZ	WC_OWN
  1D0B'   3A 270C'              	LDA	EXBANG
  1D0E'   B7                    	ORA	A
  1D0F'   CA 1D18'              	JZ	WC_OTH
  1D12'   CD 0000*              	CALL	TEXIST
  1D15'   C2 1F3F'              	JNZ	MSGEXI		; File exists (! to force)
  1D18'                         WC_OTH:
  1D18'   AF                    	XRA	A		; (NC)
  1D19'   C9                    	RET
  1D1A'                         WC_OWN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D1A'   3A 270D'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1D1D'   B7                    	ORA	A
  1D1E'   CA 1D28'              	JZ	WC_OK
  1D21'   3A 270C'              	LDA	EXBANG
  1D24'   B7                    	ORA	A
  1D25'   C2 1F45'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1D28'                         WC_OK:
  1D28'   3E 01                 	MVI	A,1
  1D2A'   B7                    	ORA	A		; (NC)
  1D2B'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1D2C'                         WRITE:
  1D2C'   3A 26FB'              	LDA	EXBAK
  1D2F'   CD 0000*              	CALL	WRTO
  1D32'   3A 0001*              	LDA	FNAME+1
  1D35'   FE 20                 	CPI	' '
  1D37'   C2 1D43'              	JNZ	WR_HAS
  1D3A'   21 0000*              	LXI	H,TFCB
  1D3D'   11 0000*              	LXI	D,FNAME
  1D40'   CD 1D90'              	CALL	COPY12
  1D43'                         WR_HAS:
  1D43'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1D45'   32 270A'              	STA	MSGWHT
  1D48'   CD 1D7E'              	CALL	ISOWN
  1D4B'   C2 1D55'              	JNZ	SRCTF
  1D4E'   AF                    	XRA	A
  1D4F'   32 26A2'              	STA	MODF
  1D52'   32 270B'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1D55'                         SRCTF:
  1D55'   21 0000*              	LXI	H,TFCB
  1D58'   11 005C               	LXI	D,DFTFCB
  1D5B'   CD 1D90'              	CALL	COPY12
  1D5E'   AF                    	XRA	A
  1D5F'   06 04                 	MVI	B,4
  1D61'                         SRC_Z:
  1D61'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1D62'   13                    	INX	D
  1D63'   05                    	DCR	B
  1D64'   C2 1D61'              	JNZ	SRC_Z
  1D67'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1D68'                         OWNTF:
  1D68'   3A 0001*              	LDA	FNAME+1
  1D6B'   FE 20                 	CPI	' '
  1D6D'   CA 1F39'              	JZ	MSGNFN
  1D70'   CD 1D9B'              	CALL	TFCLR
  1D73'   21 0000*              	LXI	H,FNAME
  1D76'   11 0000*              	LXI	D,TFCB
  1D79'   CD 1D90'              	CALL	COPY12
  1D7C'   B7                    	ORA	A		; (NC)
  1D7D'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1D7E'                         ISOWN:
  1D7E'   21 0000*              	LXI	H,TFCB
  1D81'   11 0000*              	LXI	D,FNAME
  1D84'   06 0C                 	MVI	B,12
  1D86'                         IO_LP:
  1D86'   1A                    	LDAX	D
  1D87'   BE                    	CMP	M
  1D88'   C0                    	RNZ
  1D89'   23                    	INX	H
  1D8A'   13                    	INX	D
  1D8B'   05                    	DCR	B
  1D8C'   C2 1D86'              	JNZ	IO_LP
  1D8F'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1D90'                         COPY12:
  1D90'   06 0C                 	MVI	B,12
  1D92'                         CP_LP:
  1D92'   7E                    	MOV	A,M
  1D93'   12                    	STAX	D
  1D94'   23                    	INX	H
  1D95'   13                    	INX	D
  1D96'   05                    	DCR	B
  1D97'   C2 1D92'              	JNZ	CP_LP
  1D9A'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1D9B'                         TFCLR:
  1D9B'   11 0000*              	LXI	D,TFCB
  1D9E'   06 24                 	MVI	B,36
  1DA0'   AF                    	XRA	A
  1DA1'                         TC_LP:
  1DA1'   12                    	STAX	D
  1DA2'   13                    	INX	D
  1DA3'   05                    	DCR	B
  1DA4'   C2 1DA1'              	JNZ	TC_LP
  1DA7'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1DA8'                         FOPEN:
  1DA8'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1DAA'   32 270A'              	STA	MSGWHT
  1DAD'   21 005C               	LXI	H,DFTFCB
  1DB0'   CD 1E82'              	CALL	NRMDRV
  1DB3'   11 0000*              	LXI	D,FNAME
  1DB6'   CD 1D90'              	CALL	COPY12
  1DB9'   CD 0000*              	CALL	OPENZ
  1DBC'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1DBF'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1DC1'   C8                    	RZ
  1DC2'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1DC5'   32 270B'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1DC8'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1DC9'                         ARGSCN:
  1DC9'   3A 0080               	LDA	CMDTAIL
  1DCC'   47                    	MOV	B,A		; B = what is left of the line
  1DCD'   B7                    	ORA	A
  1DCE'   C8                    	RZ
  1DCF'   21 0081               	LXI	H,CMDTAIL+1
  1DD2'                         AS_TOK:				; at a token, or the blanks before one
  1DD2'   7E                    	MOV	A,M
  1DD3'   FE 20                 	CPI	' '
  1DD5'   C2 1DDE'              	JNZ	AS_OPT
  1DD8'   23                    	INX	H
  1DD9'   05                    	DCR	B
  1DDA'   C2 1DD2'              	JNZ	AS_TOK
  1DDD'   C9                    	RET
  1DDE'                         AS_OPT:
  1DDE'   FE 2B                 	CPI	'+'
  1DE0'   CA 1E0A'              	JZ	AS_PLS
  1DE3'   FE 2D                 	CPI	'-'
  1DE5'   CA 1DF9'              	JZ	AS_SW
  1DE8'   FE 2F                 	CPI	'/'
  1DEA'   CA 1DF9'              	JZ	AS_SW
  1DED'                         AS_SKP:				; not ours (the file name): on to the next one
  1DED'   23                    	INX	H
  1DEE'   05                    	DCR	B
  1DEF'   C8                    	RZ
  1DF0'   7E                    	MOV	A,M
  1DF1'   FE 20                 	CPI	' '
  1DF3'   C2 1DED'              	JNZ	AS_SKP
  1DF6'   C3 1DD2'              	JMP	AS_TOK
  1DF9'                         AS_SW:
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DF9'   23                    	INX	H
  1DFA'   05                    	DCR	B
  1DFB'   C8                    	RZ
  1DFC'   7E                    	MOV	A,M
  1DFD'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1DFF'   FE 52                 	CPI	'R'
  1E01'   C2 1DED'              	JNZ	AS_SKP
  1E04'   32 270D'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1E07'   C3 1DED'              	JMP	AS_SKP
  1E0A'                         AS_PLS:
  1E0A'   3E 01                 	MVI	A,1
  1E0C'   32 270E'              	STA	PLUSF		; '+' gets the line even with no number on it
  1E0F'   11 0000*              	LXI	D,PLUSB
  1E12'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1E14'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1E15'   05                    	DCR	B
  1E16'   CA 1E4D'              	JZ	AS_PE
  1E19'   7E                    	MOV	A,M
  1E1A'   FE 30                 	CPI	'0'
  1E1C'   C2 1E34'              	JNZ	AS_PD
  1E1F'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1E1F'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1E20'   05                    	DCR	B
  1E21'   CA 1E55'              	JZ	AS_P1
  1E24'   7E                    	MOV	A,M
  1E25'   FE 30                 	CPI	'0'
  1E27'   CA 1E1F'              	JZ	AS_PZ
  1E2A'   FE 31                 	CPI	'1'
  1E2C'   DA 1E55'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1E2F'   FE 3A                 	CPI	'9'+1
  1E31'   D2 1E55'              	JNC	AS_P1
  1E34'                         AS_PD:				; the digits, as typed
  1E34'   7E                    	MOV	A,M
  1E35'   FE 30                 	CPI	'0'
  1E37'   DA 1E4D'              	JC	AS_PE
  1E3A'   FE 3A                 	CPI	'9'+1
  1E3C'   D2 1E4D'              	JNC	AS_PE
  1E3F'   79                    	MOV	A,C
  1E40'   B7                    	ORA	A
  1E41'   CA 1E5C'              	JZ	AS_POV
  1E44'   0D                    	DCR	C
  1E45'   7E                    	MOV	A,M
  1E46'   12                    	STAX	D
  1E47'   13                    	INX	D
  1E48'   23                    	INX	H
  1E49'   05                    	DCR	B
  1E4A'   C2 1E34'              	JNZ	AS_PD
  1E4D'                         AS_PE:
  1E4D'   AF                    	XRA	A
  1E4E'   12                    	STAX	D		; the digits end with a 0
  1E4F'   78                    	MOV	A,B
  1E50'   B7                    	ORA	A
  1E51'   C8                    	RZ
  1E52'   C3 1DD2'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E55'                         AS_P1:
  1E55'   3E 31                 	MVI	A,'1'
  1E57'   12                    	STAX	D
  1E58'   13                    	INX	D
  1E59'   C3 1E4D'              	JMP	AS_PE
  1E5C'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1E5C'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1E5F'   C3 1E4D'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1E62'                         ARGGO:
  1E62'   3A 270E'              	LDA	PLUSF
  1E65'   B7                    	ORA	A
  1E66'   C8                    	RZ
  1E67'   21 0000*              	LXI	H,PLUSB
  1E6A'                         AG_LP:
