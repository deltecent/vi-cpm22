  3006'   E5                    	PUSH	H
  3007'   23                    	INX	H
  3008'   0E 08                 	MVI	C,8
  300A'                         MN_NM:
  300A'   7E                    	MOV	A,M
  300B'   FE 20                 	CPI	' '
  300D'   CA 3018'              	JZ	MN_EXT
  3010'   CD 0000*              	CALL	OUTCH
  3013'   23                    	INX	H
  3014'   0D                    	DCR	C
  3015'   C2 300A'              	JNZ	MN_NM
  3018'                         MN_EXT:
  3018'   E1                    	POP	H
  3019'   11 0009               	LXI	D,9
  301C'   19                    	DAD	D		; the type field
  301D'   7E                    	MOV	A,M
  301E'   FE 20                 	CPI	' '
  3020'   CA 3038'              	JZ	MN_END
  3023'   3E 2E                 	MVI	A,'.'
  3025'   CD 0000*              	CALL	OUTCH
  3028'   0E 03                 	MVI	C,3
  302A'                         MN_XL:
  302A'   7E                    	MOV	A,M
  302B'   FE 20                 	CPI	' '
  302D'   CA 3038'              	JZ	MN_END
  3030'   CD 0000*              	CALL	OUTCH
  3033'   23                    	INX	H
  3034'   0D                    	DCR	C
  3035'   C2 302A'              	JNZ	MN_XL
  3038'                         MN_END:
  3038'   3E 22                 	MVI	A,'"'
  303A'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  303D'                         MSGFLG:
  303D'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  303F'   B7                    	ORA	A
  3040'   CA 3050'              	JZ	MF_RO
  3043'   3A 0000*              	LDA	MODF
  3046'   B7                    	ORA	A
  3047'   CA 3050'              	JZ	MF_RO
	MACRO-80 3.44	09-Dec-81	PAGE	1-148


  304A'   21 29D2'              	LXI	H,SMODM
  304D'   CD 3065'              	CALL	MF_PUT
  3050'                         MF_RO:
  3050'   3A 0000*              	LDA	ROFLAG
  3053'   B7                    	ORA	A
  3054'   CA 305D'              	JZ	MF_NEW
  3057'   21 29DD'              	LXI	H,SROM
  305A'   CD 3065'              	CALL	MF_PUT
  305D'                         MF_NEW:
  305D'   3A 0000*              	LDA	MSGNEW
  3060'   B7                    	ORA	A
  3061'   C8                    	RZ
  3062'   21 29E8'              	LXI	H,SNEWM
  3065'                         MF_PUT:
  3065'   78                    	MOV	A,B
  3066'   B7                    	ORA	A
  3067'   C2 3073'              	JNZ	MF_STR
  306A'   06 01                 	MVI	B,1
  306C'   E5                    	PUSH	H
  306D'   3E 20                 	MVI	A,' '
  306F'   CD 0000*              	CALL	OUTCH
  3072'   E1                    	POP	H
  3073'                         MF_STR:
  3073'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  3076'                         EMITW:
  3076'   C5                    	PUSH	B
  3077'   D5                    	PUSH	D
  3078'   06 00                 	MVI	B,0
  307A'   11 2710               	LXI	D,10000
  307D'   CD 309B'              	CALL	EWDIG
  3080'   11 03E8               	LXI	D,1000
  3083'   CD 309B'              	CALL	EWDIG
  3086'   11 0064               	LXI	D,100
  3089'   CD 309B'              	CALL	EWDIG
  308C'   11 000A               	LXI	D,10
  308F'   CD 309B'              	CALL	EWDIG
  3092'   7D                    	MOV	A,L		; the units digit is always printed
  3093'   C6 30                 	ADI	'0'
  3095'   CD 0000*              	CALL	OUTCH
  3098'   D1                    	POP	D
  3099'   C1                    	POP	B
  309A'   C9                    	RET
  309B'                         EWDIG:
  309B'   0E 00                 	MVI	C,0
  309D'                         EW_LP:
  309D'   7D                    	MOV	A,L
  309E'   93                    	SUB	E
  309F'   6F                    	MOV	L,A
  30A0'   7C                    	MOV	A,H
  30A1'   9A                    	SBB	D
  30A2'   67                    	MOV	H,A
  30A3'   DA 30AA'              	JC	EW_DN
	MACRO-80 3.44	09-Dec-81	PAGE	1-149


  30A6'   0C                    	INR	C
  30A7'   C3 309D'              	JMP	EW_LP
  30AA'                         EW_DN:
  30AA'   19                    	DAD	D		; one subtraction too many: give it back
  30AB'   79                    	MOV	A,C
  30AC'   B7                    	ORA	A
  30AD'   C2 30B3'              	JNZ	EW_PR
  30B0'   78                    	MOV	A,B
  30B1'   B7                    	ORA	A
  30B2'   C8                    	RZ			; a leading zero: write nothing
  30B3'                         EW_PR:
  30B3'   79                    	MOV	A,C
  30B4'   C6 30                 	ADI	'0'
  30B6'   CD 0000*              	CALL	OUTCH
  30B9'   06 01                 	MVI	B,1
  30BB'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  30BC'                         ISEMPT:
  30BC'   2A 0000*              	LHLD	OUTPOS
  30BF'   7C                    	MOV	A,H
  30C0'   B5                    	ORA	L
  30C1'   C0                    	RNZ
  30C2'   CD 0000*              	CALL	LOGLEN
  30C5'   7C                    	MOV	A,H
  30C6'   B5                    	ORA	L
  30C7'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  30C8'                         MSGCTG:
  30C8'   21 0000*              	LXI	H,FNAME
  30CB'   CD 2FD5'              	CALL	MSGNAM
  30CE'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  30D0'   CD 303D'              	CALL	MSGFLG
  30D3'   CD 30BC'              	CALL	ISEMPT
  30D6'   C2 30DF'              	JNZ	MG_POS
  30D9'   21 29FB'              	LXI	H,SNOLIN
  30DC'   C3 0000*              	JMP	OUTSTR
  30DF'                         MG_POS:
  30DF'   21 29EE'              	LXI	H,SLINE
  30E2'   CD 0000*              	CALL	OUTSTR
  30E5'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  30E8'   23                    	INX	H		;   ... so the line it is on
  30E9'   CD 3076'              	CALL	EMITW
  30EC'   21 29F5'              	LXI	H,SCOLM
  30EF'   CD 0000*              	CALL	OUTSTR
  30F2'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  30F5'   23                    	INX	H
  30F6'   E5                    	PUSH	H
  30F7'   CD 3076'              	CALL	EMITW
  30FA'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  30FD'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-150


  30FE'   D1                    	POP	D
  30FF'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  3102'   C8                    	RZ
  3103'   E5                    	PUSH	H
  3104'   3E 2D                 	MVI	A,'-'
  3106'   CD 0000*              	CALL	OUTCH
  3109'   E1                    	POP	H
  310A'   C3 3076'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  310D'                         FILMSG:
  310D'   3A 0001*              	LDA	FNAME+1
  3110'   FE 20                 	CPI	' '
  3112'   C8                    	RZ
  3113'   21 0000*              	LXI	H,FNAME
  3116'   CD 2FD5'              	CALL	MSGNAM
  3119'   AF                    	XRA	A		; nothing has been changed yet
  311A'   C3 303D'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  311D'                         WRMSG:
  311D'   21 0000*              	LXI	H,TFCB
  3120'   CD 2FD5'              	CALL	MSGNAM
  3123'   21 2A0D'              	LXI	H,SWRIT
  3126'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
