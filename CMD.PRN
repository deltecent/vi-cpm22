                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2A3F'                         EXTAB:
  2A3F'   77 00 01              	DB	'w',0,EO_W
  2A42'   71 00 02              	DB	'q',0,EO_Q
  2A45'   77 71 03              	DB	'w','q',EO_WQ
  2A48'   78 00 04              	DB	'x',0,EO_X
  2A4B'   65 00 05              	DB	'e',0,EO_E
  2A4E'   73 00 06              	DB	's',0,EO_S
