  1104'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  1107'   83                    	ADD	E
  1108'   4F                    	MOV	C,A
  1109'   3A 2F17'              	LDA	HTCUR
  110C'   CD 11D5'              	CALL	HTPT
  110F'   CD 11F3'              	CALL	HTFQ
  1112'   D2 1116'              	JNC	HFEND
  1115'   2B                    	DCX	H		; the file ends first: its last line
