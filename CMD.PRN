                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C56'                         CURRW:
  0C56'   2A 0000*              	LHLD	WINROW
  0C59'   EB                    	XCHG
  0C5A'   2A 0000*              	LHLD	LNDLT
  0C5D'   19                    	DAD	D		; HL = row (signed)
  0C5E'   7C                    	MOV	A,H
  0C5F'   B7                    	ORA	A
  0C60'   FA 0C73'              	JM	CRW_0		; above the screen -> top row
  0C63'   C2 0C6E'              	JNZ	CRW_BT		; far below -> bottom row
  0C66'   3A 0000*              	LDA	NEDIT
  0C69'   3D                    	DCR	A		; A = bottom row
  0C6A'   BD                    	CMP	L		; CY iff bottom < row
  0C6B'   D8                    	RC
  0C6C'   7D                    	MOV	A,L
  0C6D'   C9                    	RET
  0C6E'                         CRW_BT:
  0C6E'   3A 0000*              	LDA	NEDIT
  0C71'   3D                    	DCR	A
  0C72'   C9                    	RET
  0C73'                         CRW_0:
  0C73'   AF                    	XRA	A
  0C74'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C75'                         SETRWT:
  0C75'   2A 0000*              	LHLD	LNDLT
  0C78'   EB                    	XCHG
  0C79'   6F                    	MOV	L,A
  0C7A'   26 00                 	MVI	H,0
  0C7C'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C7F'   22 0000*              	SHLD	WINROW
  0C82'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C83'                         MVROW:
  0C83'   47                    	MOV	B,A
  0C84'   CD 0C56'              	CALL	CURRW
  0C87'   90                    	SUB	B		; A = row now - target
  0C88'   C8                    	RZ
  0C89'   DA 0C92'              	JC	MR_DN
  0C8C'   6F                    	MOV	L,A
  0C8D'   26 00                 	MVI	H,0
  0C8F'   C3 08DD'              	JMP	KCORE
  0C92'                         MR_DN:
  0C92'   2F                    	CMA
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C93'   3C                    	INR	A		; A = target - row now
  0C94'   6F                    	MOV	L,A
  0C95'   26 00                 	MVI	H,0
  0C97'   C3 0840'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0C9A'                         VC_HIGH:
  0C9A'   CD 0644'              	CALL	MOVCNT		; a cursor motion, and its count
  0C9D'   2B                    	DCX	H		; row = count - 1
  0C9E'   7C                    	MOV	A,H
  0C9F'   B7                    	ORA	A
  0CA0'   3A 0000*              	LDA	SCBOT
  0CA3'   C2 0CAB'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CA6'   BD                    	CMP	L		; CY iff SCBOT < row
  0CA7'   DA 0CAB'              	JC	VH_GO
  0CAA'   7D                    	MOV	A,L
  0CAB'                         VH_GO:
  0CAB'   CD 0C83'              	CALL	MVROW
  0CAE'   C3 0792'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CB1'                         VC_MIDL:
  0CB1'   CD 0644'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CB4'   3A 0000*              	LDA	SCBOT
  0CB7'   B7                    	ORA	A		; clear CY for the shift
  0CB8'   1F                    	RAR			; A = SCBOT / 2
  0CB9'   CD 0C83'              	CALL	MVROW
  0CBC'   C3 0792'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CBF'                         VC_LOWL:
  0CBF'   CD 0644'              	CALL	MOVCNT		; a cursor motion, and its count
  0CC2'   2B                    	DCX	H		; count - 1
  0CC3'   3A 0000*              	LDA	SCBOT
  0CC6'   5F                    	MOV	E,A
  0CC7'   16 00                 	MVI	D,0
  0CC9'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CCA'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CCD'   3E 00                 	MVI	A,0
  0CCF'   D2 0CD6'              	JNC	VL_GO		; at or past the top -> row 0
  0CD2'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CD5'   7D                    	MOV	A,L
  0CD6'                         VL_GO:
  0CD6'   CD 0C83'              	CALL	MVROW
  0CD9'   C3 0792'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CDC'                         VC_PGDN:
  0CDC'   CD 0644'              	CALL	MOVCNT		; a cursor motion, and its count
  0CDF'   3A 0000*              	LDA	SCEOF
  0CE2'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CE3'   CA 0CF1'              	JZ	VPD_N
  0CE6'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0CE9'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0CEA'   C8                    	RZ			; it already is
  0CEB'   CD 0C83'              	CALL	MVROW
  0CEE'   C3 0D02'              	JMP	VPD_TP
  0CF1'                         VPD_N:
  0CF1'   3A 0000*              	LDA	NEDIT
  0CF4'   D6 02                 	SUI	2
  0CF6'   CD 0D4A'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0CF9'   E5                    	PUSH	H
  0CFA'   AF                    	XRA	A
  0CFB'   CD 0C83'              	CALL	MVROW		; the top line
  0CFE'   E1                    	POP	H
  0CFF'   CD 0840'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D02'                         VPD_TP:
  0D02'   AF                    	XRA	A
  0D03'   CD 0C75'              	CALL	SETRWT		; to the top row
  0D06'   C3 0792'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D09'                         VC_PGUP:
  0D09'   CD 0644'              	CALL	MOVCNT		; a cursor motion, and its count
  0D0C'   3A 0000*              	LDA	SCBOF
  0D0F'   B7                    	ORA	A
  0D10'   C0                    	RNZ
  0D11'   3A 0000*              	LDA	NEDIT
  0D14'   47                    	MOV	B,A
  0D15'   3A 0000*              	LDA	SCEOF
  0D18'   B7                    	ORA	A
  0D19'   CA 0D2A'              	JZ	VPU_2
  0D1C'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D1F'   FE 02                 	CPI	2
  0D21'   D2 0D2A'              	JNC	VPU_2
  0D24'   2F                    	CMA
  0D25'   3C                    	INR	A
  0D26'   80                    	ADD	B
  0D27'   C3 0D2D'              	JMP	VPU_P
  0D2A'                         VPU_2:
  0D2A'   78                    	MOV	A,B
  0D2B'   D6 02                 	SUI	2
  0D2D'                         VPU_P:
  0D2D'   CD 0D4A'              	CALL	MULSAT		; HL = count * page
  0D30'   E5                    	PUSH	H
  0D31'   AF                    	XRA	A
  0D32'   CD 0C83'              	CALL	MVROW		; the top line
  0D35'   E1                    	POP	H
  0D36'   CD 08DD'              	CALL	KCORE		; the new top line
  0D39'   AF                    	XRA	A
  0D3A'   CD 0C75'              	CALL	SETRWT		; on the top row
  0D3D'   3A 0000*              	LDA	NEDIT
  0D40'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D41'   6F                    	MOV	L,A
  0D42'   26 00                 	MVI	H,0
  0D44'   CD 0840'              	CALL	JCORE		; the bottom row's line
  0D47'   C3 0792'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D4A'                         MULSAT:
  0D4A'   EB                    	XCHG
  0D4B'   21 0000               	LXI	H,0
  0D4E'   B7                    	ORA	A
  0D4F'   C8                    	RZ
  0D50'                         MS_LP:
  0D50'   19                    	DAD	D
  0D51'   DA 0D59'              	JC	MS_SAT
  0D54'   3D                    	DCR	A
  0D55'   C2 0D50'              	JNZ	MS_LP
  0D58'   C9                    	RET
  0D59'                         MS_SAT:
  0D59'   21 FFFF               	LXI	H,0FFFFH
  0D5C'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D5D'                         VC_HFDN:
  0D5D'   CD 06C4'              	CALL	SETMOV
  0D60'   CD 0C56'              	CALL	CURRW
  0D63'   32 24B9'              	STA	HFROW
  0D66'   CD 0DD4'              	CALL	HFCNT		; HL = lines
  0D69'   3A 24B9'              	LDA	HFROW
  0D6C'   47                    	MOV	B,A
  0D6D'   3A 0000*              	LDA	SCEOF
  0D70'   B7                    	ORA	A
  0D71'   CA 0D79'              	JZ	VHD_GO
  0D74'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D77'   B8                    	CMP	B
  0D78'   C8                    	RZ			; the cursor is on it
  0D79'                         VHD_GO:
  0D79'   CD 0840'              	CALL	JCORE
  0D7C'   3A 0000*              	LDA	SCEOF
  0D7F'   B7                    	ORA	A
  0D80'   C2 0792'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D83'   3A 24B9'              	LDA	HFROW
  0D86'   CD 0C75'              	CALL	SETRWT
  0D89'   3E 01                 	MVI	A,1
  0D8B'   32 0000*              	STA	WFILL		; not past the end of the file
  0D8E'   C3 0792'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0D91'                         VC_HFUP:
  0D91'   CD 06C4'              	CALL	SETMOV
  0D94'   CD 0C56'              	CALL	CURRW
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D97'   32 24B9'              	STA	HFROW
  0D9A'   CD 0DD4'              	CALL	HFCNT		; HL = lines
  0D9D'   CD 0DB4'              	CALL	ONFST
  0DA0'   C8                    	RZ			; the cursor is on the first line
  0DA1'   CD 08DD'              	CALL	KCORE
  0DA4'   3A 0000*              	LDA	SCBOF
  0DA7'   B7                    	ORA	A
  0DA8'   C2 0792'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DAB'   3A 24B9'              	LDA	HFROW
  0DAE'   CD 0C75'              	CALL	SETRWT
  0DB1'   C3 0792'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DB4'                         ONFST:
  0DB4'   E5                    	PUSH	H
  0DB5'   2A 0000*              	LHLD	OUTPOS
  0DB8'   7C                    	MOV	A,H
  0DB9'   B5                    	ORA	L
  0DBA'   C2 0DD2'              	JNZ	OF_RET
  0DBD'   2A 0000*              	LHLD	TXTBEG
  0DC0'   EB                    	XCHG			; DE = TXTBEG
  0DC1'   2A 0000*              	LHLD	GAPBEG
  0DC4'                         OF_LP:
  0DC4'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DC7'   CA 0DD2'              	JZ	OF_RET
  0DCA'   2B                    	DCX	H
  0DCB'   7E                    	MOV	A,M
  0DCC'   FE 0A                 	CPI	LF
  0DCE'   C2 0DC4'              	JNZ	OF_LP
  0DD1'   B7                    	ORA	A		; NZ
  0DD2'                         OF_RET:
  0DD2'   E1                    	POP	H
  0DD3'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DD4'                         HFCNT:
  0DD4'   2A 24AD'              	LHLD	CMDCNT
  0DD7'   7C                    	MOV	A,H
  0DD8'   B5                    	ORA	L
  0DD9'   CA 0DF0'              	JZ	HFC_AM
  0DDC'   CD 0657'              	CALL	GETCNT		; HL = count; clears it
  0DDF'   3A 0000*              	LDA	NEDIT
  0DE2'   5F                    	MOV	E,A
  0DE3'   16 00                 	MVI	D,0
  0DE5'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0DE8'   D2 0DEC'              	JNC	HFC_ST
  0DEB'   EB                    	XCHG			; HL = NEDIT
  0DEC'                         HFC_ST:
  0DEC'   7D                    	MOV	A,L
  0DED'   32 24BA'              	STA	HFAMT
  0DF0'                         HFC_AM:
  0DF0'   3A 24BA'              	LDA	HFAMT
  0DF3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DF4'   C2 0E01'              	JNZ	HFC_HL
  0DF7'   3A 0000*              	LDA	NEDIT
  0DFA'   B7                    	ORA	A
  0DFB'   1F                    	RAR
  0DFC'   B7                    	ORA	A
  0DFD'   C2 0E01'              	JNZ	HFC_HL
  0E00'   3C                    	INR	A		; at least one line
  0E01'                         HFC_HL:
  0E01'   6F                    	MOV	L,A
  0E02'   26 00                 	MVI	H,0
  0E04'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E05'                         VC_REDR:
  0E05'   C3 0657'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E08'                         VC_G:
  0E08'   CD 06C4'              	CALL	SETMOV
  0E0B'   CD 0EA8'              	CALL	GZONE		; the screen's top line, before the move
  0E0E'   2A 24AD'              	LHLD	CMDCNT
  0E11'   7C                    	MOV	A,H
  0E12'   B5                    	ORA	L
  0E13'   C2 0E20'              	JNZ	VG_N
  0E16'   AF                    	XRA	A		; forward
  0E17'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E1A'   CD 0974'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E1D'   C3 0EC0'              	JMP	GPLACE
  0E20'                         VG_N:
  0E20'   CD 0657'              	CALL	GETCNT		; HL = target line (1-based)
  0E23'                         VG_LN:
  0E23'   CD 0E29'              	CALL	GOLN
  0E26'   C3 0EC0'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0E29'                         GOLN:
  0E29'   2B                    	DCX	H		; lines to move from line 1
  0E2A'   E5                    	PUSH	H
  0E2B'   3E FF                 	MVI	A,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E2D'   CD 0000*              	CALL	MVLMAX		; to BOF
  0E30'   E1                    	POP	H
  0E31'   AF                    	XRA	A
  0E32'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0E35'   CD 096E'              	CALL	ATEOF
  0E38'   DC 0974'              	CC	LASTLN		; past the last line: onto it
  0E3B'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E3C'                         VC_LG:
  0E3C'   CD 06C4'              	CALL	SETMOV
  0E3F'   3A 24D5'              	LDA	GSAVE
  0E42'   B7                    	ORA	A
  0E43'   C2 0E4C'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E46'   3E 01                 	MVI	A,PG
  0E48'   32 24D4'              	STA	GPEND
  0E4B'   C9                    	RET
  0E4C'                         VLG_GG:
  0E4C'   CD 0EA8'              	CALL	GZONE
  0E4F'   CD 0657'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E52'   C3 0E23'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E55'                         SUB24:
  0E55'   4F                    	MOV	C,A
  0E56'   7D                    	MOV	A,L
  0E57'   93                    	SUB	E
  0E58'   6F                    	MOV	L,A
  0E59'   7C                    	MOV	A,H
  0E5A'   9A                    	SBB	D
  0E5B'   67                    	MOV	H,A
  0E5C'   79                    	MOV	A,C
  0E5D'   98                    	SBB	B
  0E5E'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E5F'                         CURFP:
  0E5F'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E62'                         FPOS:
  0E62'   C5                    	PUSH	B
  0E63'   D5                    	PUSH	D
  0E64'   EB                    	XCHG
  0E65'   2A 0000*              	LHLD	TXTBEG
  0E68'   EB                    	XCHG
  0E69'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E6C'   EB                    	XCHG			; DE = that
  0E6D'   2A 0000*              	LHLD	OUTPOS
  0E70'   7C                    	MOV	A,H
  0E71'   B7                    	ORA	A		; CY = 0
  0E72'   1F                    	RAR
  0E73'   47                    	MOV	B,A
  0E74'   7D                    	MOV	A,L
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E75'   1F                    	RAR
  0E76'   67                    	MOV	H,A
  0E77'   3E 00                 	MVI	A,0
  0E79'   1F                    	RAR
  0E7A'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0E7B'   19                    	DAD	D
  0E7C'   78                    	MOV	A,B
  0E7D'   CE 00                 	ACI	0		; A:HL = the position
  0E7F'   D1                    	POP	D
  0E80'   C1                    	POP	B
  0E81'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0E82'                         ZSAVE:
  0E82'   2A 24AD'              	LHLD	CMDCNT
  0E85'   22 2507'              	SHLD	ZSVCNT
  0E88'   2A 0000*              	LHLD	AUXCNT
  0E8B'   22 2509'              	SHLD	ZSVAUX
  0E8E'   3A 0000*              	LDA	DIRFLG
  0E91'   32 250B'              	STA	ZSVDIR
  0E94'   C9                    	RET
  0E95'                         ZREST:
  0E95'   2A 2507'              	LHLD	ZSVCNT
  0E98'   22 24AD'              	SHLD	CMDCNT
  0E9B'   2A 2509'              	LHLD	ZSVAUX
  0E9E'   22 0000*              	SHLD	AUXCNT
  0EA1'   3A 250B'              	LDA	ZSVDIR
  0EA4'   32 0000*              	STA	DIRFLG
  0EA7'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0EA8'                         GZONE:
  0EA8'   CD 0E82'              	CALL	ZSAVE
  0EAB'   CD 0C56'              	CALL	CURRW
  0EAE'   6F                    	MOV	L,A
  0EAF'   26 00                 	MVI	H,0
  0EB1'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0EB4'   CD 0E62'              	CALL	FPOS
  0EB7'   22 0000*              	SHLD	ZTOP
  0EBA'   32 0002*              	STA	ZTOP+2
  0EBD'   C3 0E95'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EC0'                         GPLACE:
  0EC0'   CD 0E82'              	CALL	ZSAVE
  0EC3'   CD 0E5F'              	CALL	CURFP
  0EC6'   EB                    	XCHG
  0EC7'   2A 0000*              	LHLD	ZTOP
  0ECA'   EB                    	XCHG
  0ECB'   4F                    	MOV	C,A		; C:HL = the target's position
  0ECC'   3A 0002*              	LDA	ZTOP+2
  0ECF'   47                    	MOV	B,A		; B:DE = the top's
  0ED0'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0ED1'   CD 0E55'              	CALL	SUB24
  0ED4'   22 2504'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0ED7'   DA 0F24'              	JC	GP_UP
  0EDA'   B7                    	ORA	A
  0EDB'   C2 0F65'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0EDE'   3A 0000*              	LDA	NEDIT
  0EE1'   5F                    	MOV	E,A
  0EE2'   16 00                 	MVI	D,0
  0EE4'   B7                    	ORA	A
  0EE5'   1F                    	RAR
  0EE6'   6F                    	MOV	L,A
  0EE7'   26 00                 	MVI	H,0
  0EE9'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0EEA'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0EED'   CD 0650'              	CALL	GBSUB		; HL = bytes from there to the target
  0EF0'   EB                    	XCHG
  0EF1'   2A 2504'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0EF4'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0EF7'   DA 0F65'              	JC	GP_MID
  0EFA'   CD 0650'              	CALL	GBSUB		; HL = the top line's start (resident)
  0EFD'   01 0000               	LXI	B,0		; BC = lines from the top
  0F00'                         GP_CNT:
  0F00'   7A                    	MOV	A,D
  0F01'   B3                    	ORA	E
  0F02'   CA 0F11'              	JZ	GP_DN
  0F05'   7E                    	MOV	A,M
  0F06'   23                    	INX	H
  0F07'   1B                    	DCX	D
  0F08'   FE 0A                 	CPI	LF
  0F0A'   C2 0F00'              	JNZ	GP_CNT
  0F0D'   03                    	INX	B
  0F0E'   C3 0F00'              	JMP	GP_CNT
  0F11'                         GP_DN:
  0F11'   3A 0000*              	LDA	NEDIT
  0F14'   3D                    	DCR	A
  0F15'   5F                    	MOV	E,A
  0F16'   16 00                 	MVI	D,0		; DE = the bottom row
  0F18'   60                    	MOV	H,B
  0F19'   69                    	MOV	L,C
  0F1A'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F1D'   DA 0F6F'              	JC	GP_SET		; A = the bottom row
  0F20'   7D                    	MOV	A,L		; on the screen: its row
  0F21'   C3 0F8F'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F24'                         GP_UP:
  0F24'   3C                    	INR	A
  0F25'   C2 0F65'              	JNZ	GP_MID		; 64K bytes or more above
  0F28'   2A 2504'              	LHLD	ZDIF
  0F2B'   EB                    	XCHG
  0F2C'   21 0000               	LXI	H,0
  0F2F'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F32'   7C                    	MOV	A,H
  0F33'   B5                    	ORA	L
  0F34'   CA 0F65'              	JZ	GP_MID		; exactly 64K
  0F37'   EB                    	XCHG			; DE = bytes to read
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F38'   AF                    	XRA	A
  0F39'   32 2506'              	STA	ZLF
  0F3C'   CD 0000*              	CALL	RGET0
  0F3F'                         GP_RD:
  0F3F'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F42'   DA 0F65'              	JC	GP_MID
  0F45'   FE 0A                 	CPI	LF
  0F47'   C2 0F5B'              	JNZ	GP_RN
  0F4A'   3A 0000*              	LDA	NEDIT
  0F4D'   B7                    	ORA	A
  0F4E'   1F                    	RAR
  0F4F'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F51'   E5                    	PUSH	H
  0F52'   21 2506'              	LXI	H,ZLF
  0F55'   34                    	INR	M
  0F56'   BE                    	CMP	M		; CY iff more lines than that
  0F57'   E1                    	POP	H
  0F58'   DA 0F65'              	JC	GP_MID
  0F5B'                         GP_RN:
  0F5B'   1B                    	DCX	D
  0F5C'   7A                    	MOV	A,D
  0F5D'   B3                    	ORA	E
  0F5E'   C2 0F3F'              	JNZ	GP_RD
  0F61'   AF                    	XRA	A		; the top row
  0F62'   C3 0F6F'              	JMP	GP_SET
  0F65'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F65'   3E 01                 	MVI	A,1
  0F67'   32 0000*              	STA	WFILL		; not past the end of the file
  0F6A'   3A 0000*              	LDA	NEDIT
  0F6D'   B7                    	ORA	A
  0F6E'   1F                    	RAR			; the middle row
  0F6F'                         GP_SET:
  0F6F'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F70'   26 00                 	MVI	H,0
  0F72'   22 0000*              	SHLD	WINROW
  0F75'   21 0000               	LXI	H,0
  0F78'   22 0000*              	SHLD	LNDLT
  0F7B'   CD 06E5'              	CALL	SETFUL		; the window may have paged: full repaint
  0F7E'                         GP_FIN:
  0F7E'   CD 0E95'              	CALL	ZREST
  0F81'   3A 252E'              	LDA	GPKEEP
  0F84'   B7                    	ORA	A
  0F85'   CA 0792'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0F88'   AF                    	XRA	A
  0F89'   32 252E'              	STA	GPKEEP
  0F8C'   C3 0549'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F8F'                         GP_ONS:
  0F8F'   6F                    	MOV	L,A
  0F90'   26 00                 	MVI	H,0		; HL = the row it lands on
  0F92'   EB                    	XCHG
  0F93'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0F96'   EB                    	XCHG
  0F97'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0F9A'   22 0000*              	SHLD	LNDLT
  0F9D'   3E 01                 	MVI	A,R_MOVE
  0F9F'   32 24B1'              	STA	RINTENT
  0FA2'   C3 0F7E'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FA5'                         OPPEND:
  0FA5'   AF                    	XRA	A
  0FA6'   32 24DA'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FA9'   3A 24D7'              	LDA	PSAVE
  0FAC'   FE 63                 	CPI	'c'
  0FAE'   C2 0FCB'              	JNZ	OPP_ND
  0FB1'   79                    	MOV	A,C
  0FB2'   FE 77                 	CPI	'w'
  0FB4'   CA 0FBC'              	JZ	OPP_W
  0FB7'   FE 57                 	CPI	'W'
  0FB9'   C2 0FCB'              	JNZ	OPP_ND
  0FBC'                         OPP_W:
  0FBC'   CD 1045'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FBF'   DA 0FCB'              	JC	OPP_ND
  0FC2'   79                    	MOV	A,C
  0FC3'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FC5'   4F                    	MOV	C,A
  0FC6'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FC8'   32 24DA'              	STA	CWEOL		;   see the clamp in OPA_F
  0FCB'                         OPP_ND:
  0FCB'   79                    	MOV	A,C		; doubled operator (dd / cc)?
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FCC'   21 24D7'              	LXI	H,PSAVE
  0FCF'   BE                    	CMP	M
  0FD0'   CA 1066'              	JZ	OPLINE
  0FD3'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0FD4'   CD 1076'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0FD7'   DA 1042'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0FDA'   32 24D9'              	STA	OPCLSV
  0FDD'   47                    	MOV	B,A		; B = the class
  0FDE'   3A 24D7'              	LDA	PSAVE
  0FE1'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0FE3'   C2 0FEF'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0FE6'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0FE7'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0FE9'   C2 1011'              	JNZ	OPP_GO
  0FEC'   C3 0FFA'              	JMP	OPP_NO
  0FEF'                         OPP_NC:
  0FEF'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0FF1'   C2 1011'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0FF4'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0FF5'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0FF7'   CA 1011'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0FFA'                         OPP_NO:
  0FFA'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0FFB'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0FFD'   CA 100B'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1000'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1002'   CA 100B'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1005'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  1008'   C2 1042'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  100B'                         OPP_SW:
  100B'   CD 0218'              	CALL	MKGETK
  100E'   C3 1042'              	JMP	OPABRT
  1011'                         OPP_GO:
  1011'   AF                    	XRA	A
  1012'   32 24B8'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1015'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  1018'   22 24DB'              	SHLD	OPSTA
  101B'   21 23DB'              	LXI	H,CMDTAB
  101E'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1021'   3A 24D7'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1024'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1025'   CA 06C4'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  1028'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  102B'   22 24DD'              	SHLD	OPEND2
  102E'   3A 24D7'              	LDA	PSAVE
  1031'   FE 79                 	CPI	'y'
  1033'   CA 1516'              	JZ	OPYANK		; a yank takes the span without losing it
  1036'   CD 10B1'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1039'   3A 24D7'              	LDA	PSAVE
  103C'   FE 63                 	CPI	'c'
  103E'   C0                    	RNZ
  103F'   C3 12DD'              	JMP	SETINS
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1042'                         OPABRT:
  1042'   C3 06C4'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1045'                         ONWHIT:
  1045'   CD 0633'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1048'   CA 1064'              	JZ	OW_YES
  104B'   CD 063E'              	CALL	CURCHR		; A = the char under the cursor
  104E'   FE 20                 	CPI	' '
  1050'   CA 1064'              	JZ	OW_YES
  1053'   FE 09                 	CPI	TAB
  1055'   CA 1064'              	JZ	OW_YES
  1058'   FE 0D                 	CPI	CR
  105A'   CA 1064'              	JZ	OW_YES
  105D'   FE 0A                 	CPI	LF
  105F'   CA 1064'              	JZ	OW_YES
  1062'   B7                    	ORA	A		; a char to change: CY clear
  1063'   C9                    	RET
  1064'                         OW_YES:
  1064'   37                    	STC
  1065'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1066'                         OPLINE:
  1066'   3A 24D7'              	LDA	PSAVE
  1069'   FE 63                 	CPI	'c'
  106B'   CA 06C4'              	JZ	SETMOV
  106E'   FE 79                 	CPI	'y'
  1070'   CA 14FB'              	JZ	VY_YY
  1073'   C3 1480'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1076'                         OPCLS:
  1076'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1078'   CA 1085'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  107B'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  107D'   C2 1099'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1080'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1082'   C3 1087'              	JMP	OPC_FK
  1085'                         OPC_SEM:
  1085'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1087'                         OPC_FK:
  1087'   3A 2524'              	LDA	FNDKND
  108A'   B7                    	ORA	A
  108B'   37                    	STC
  108C'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                				;   made
  108D'   A8                    	XRA	B		; ... and now the direction ',' asked for
  108E'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1090'   CA 1097'              	JZ	OPC_EXC
  1093'   3E 01                 	MVI	A,1
  1095'   B7                    	ORA	A		; CY clear: a motion, class 1
  1096'   C9                    	RET
  1097'                         OPC_EXC:
  1097'   AF                    	XRA	A		; class 0, CY clear
  1098'   C9                    	RET
  1099'                         OPC_TB:
  1099'   47                    	MOV	B,A
  109A'   21 11D3'              	LXI	H,OPCTAB
  109D'                         OPC_LP:
  109D'   7E                    	MOV	A,M
  109E'   B7                    	ORA	A
  109F'   CA 10AF'              	JZ	OPC_MS		; end of table -> not a motion
  10A2'   B8                    	CMP	B
  10A3'   CA 10AB'              	JZ	OPC_HT
  10A6'   23                    	INX	H
  10A7'   23                    	INX	H
  10A8'   C3 109D'              	JMP	OPC_LP
  10AB'                         OPC_HT:
  10AB'   23                    	INX	H
  10AC'   7E                    	MOV	A,M		; class byte
  10AD'   B7                    	ORA	A		; clear CY
  10AE'   C9                    	RET
  10AF'                         OPC_MS:
  10AF'   37                    	STC
  10B0'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  10B1'                         OPAPPL:
  10B1'   3A 24D9'              	LDA	OPCLSV
  10B4'   FE 02                 	CPI	2
  10B6'   CA 11B7'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  10B9'   2A 24DB'              	LHLD	OPSTA
  10BC'   EB                    	XCHG			; DE = start
  10BD'   2A 24DD'              	LHLD	OPEND2		; HL = end
  10C0'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  10C3'   DA 10D3'              	JC	OPA_F
  10C6'   CA 10D3'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  10C9'   22 24DF'              	SHLD	OPLO
  10CC'   EB                    	XCHG
  10CD'   22 24E1'              	SHLD	OPHI
  10D0'   C3 112B'              	JMP	OPA_DO
  10D3'                         OPA_F:
  10D3'   EB                    	XCHG			; HL = start, DE = end
  10D4'   22 24DF'              	SHLD	OPLO
  10D7'   EB                    	XCHG			; HL = end
  10D8'   3A 24D9'              	LDA	OPCLSV
  10DB'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  10DD'   CA 1128'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  10E0'   FE 01                 	CPI	1
  10E2'   C2 1104'              	JNZ	OPA_EX
  10E5'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  10E6'   3A 24DA'              	LDA	CWEOL
  10E9'   B7                    	ORA	A
  10EA'   CA 1128'              	JZ	OPA_HI
  10ED'   22 24E1'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  10F0'   2A 24DF'              	LHLD	OPLO
  10F3'   CD 125B'              	CALL	CEND		; HL = the start line's content end
  10F6'   EB                    	XCHG			; DE = that content end
  10F7'   2A 24E1'              	LHLD	OPHI		; HL = hi
  10FA'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  10FD'   D2 1128'              	JNC	OPA_HI		; hi is inside the line: keep it
  1100'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1101'   C3 1128'              	JMP	OPA_HI
  1104'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1104'   22 24E1'              	SHLD	OPHI		; the motion's own end, for now
  1107'   2A 24DF'              	LHLD	OPLO
  110A'   CD 125B'              	CALL	CEND		; HL = the start line's content end
  110D'   EB                    	XCHG			; DE = that content end
  110E'   3A 24B8'              	LDA	WPULL		; the motion landed on a line's end and was
  1111'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1112'   C2 111E'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1115'   2A 24E1'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1118'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  111B'   D2 112B'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  111E'                         OPA_CE:				;   deletes the word, not all but its last char
  111E'   2A 24DF'              	LHLD	OPLO
  1121'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1124'   CA 1169'              	JZ	OPA_LN
  1127'   EB                    	XCHG			; HL = the content end
  1128'                         OPA_HI:
  1128'   22 24E1'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  112B'                         OPA_DO:
  112B'   CD 114F'              	CALL	OPDSPN
  112E'   3A 24D7'              	LDA	PSAVE
  1131'   FE 63                 	CPI	'c'
  1133'   C8                    	RZ
  1134'   C3 126C'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1137'                         SPNBRK:
  1137'   2A 24DF'              	LHLD	OPLO
  113A'   CD 05C3'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  113D'   EB                    	XCHG			; DE = it
  113E'   2A 24E1'              	LHLD	OPHI
  1141'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1144'                         OPSPNL:
  1144'   2A 24E1'              	LHLD	OPHI
  1147'   EB                    	XCHG
  1148'   2A 24DF'              	LHLD	OPLO
  114B'   EB                    	XCHG			; HL = hi, DE = lo
  114C'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  114F'                         OPDSPN:
  114F'   CD 1137'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1152'   F5                    	PUSH	PSW
  1153'   2A 24DF'              	LHLD	OPLO
  1156'   CD 0000*              	CALL	GOTO
  1159'   CD 1144'              	CALL	OPSPNL		; HL = hi - lo
  115C'   CD 0000*              	CALL	DELFWD
  115F'   CD 0188'              	CALL	MARKMOD
  1162'   F1                    	POP	PSW
  1163'   DA 06E5'              	JC	SETFUL		; a break went: every row below it moved up
  1166'   C3 06CA'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  1169'                         OPA_LN:
  1169'   3A 24D7'              	LDA	PSAVE
  116C'   FE 63                 	CPI	'c'
  116E'   C2 1177'              	JNZ	OPA_LD
  1171'   2A 24DF'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1174'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1177'                         OPA_LD:
  1177'   2A 24DF'              	LHLD	OPLO
  117A'   22 24DB'              	SHLD	OPSTA
  117D'   22 24DD'              	SHLD	OPEND2
  1180'   C3 11B7'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1183'                         OPALSP:
  1183'   2A 24DB'              	LHLD	OPSTA
  1186'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1187'   2A 24DD'              	LHLD	OPEND2
  118A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  118D'   DA 119A'              	JC	OPAL_F
  1190'   22 24DF'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1193'   EB                    	XCHG
  1194'   22 24E1'              	SHLD	OPHI		; hi-src = start
  1197'   C3 11A4'              	JMP	OPAL_R
  119A'                         OPAL_F:
  119A'   EB                    	XCHG			; HL = start
  119B'   22 24DF'              	SHLD	OPLO		; lo-src = start
  119E'   2A 24DD'              	LHLD	OPEND2
  11A1'   22 24E1'              	SHLD	OPHI		; hi-src = end
  11A4'                         OPAL_R:
  11A4'   2A 24DF'              	LHLD	OPLO
  11A7'   CD 05B0'              	CALL	BOL
  11AA'   22 24DF'              	SHLD	OPLO		; lo = BOL(low line)
  11AD'   2A 24E1'              	LHLD	OPHI
  11B0'   CD 05E0'              	CALL	NLSTART
  11B3'   22 24E1'              	SHLD	OPHI		; hi = start of line past the high line
  11B6'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  11B7'                         OPALIN:
  11B7'   CD 1183'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  11BA'                         OPDLIN:
  11BA'   CD 114F'              	CALL	OPDSPN
  11BD'   CD 0633'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  11C0'   DA 11D0'              	JC	OPDL_NB
  11C3'   CD 0000*              	CALL	LOGLEN
  11C6'   7C                    	MOV	A,H
  11C7'   B5                    	ORA	L
  11C8'   C8                    	RZ			; empty buffer
  11C9'   2B                    	DCX	H
  11CA'   CD 05B0'              	CALL	BOL
  11CD'   CD 0000*              	CALL	GOTO
  11D0'                         OPDL_NB:
  11D0'   C3 0792'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


                                ; it and opened an insert: 'x' and 's' under another name.
  11D3'                         OPCTAB:
  11D3'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  11D7'   62 00 42 00           
  11DB'   68 00 6C 00           
  11DF'   30 00 5E 00           
  11E3'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  11E5'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  11E9'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  11ED'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  11F1'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  11F5'   24 01                 
  11F7'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  11FB'   47 02 48 02           
  11FF'   4D 02 4C 02           
  1203'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1205'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1206'                         VCB_C:
  1206'   CD 1212'              	CALL	VCB_CD
  1209'   C3 12DD'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  120C'                         VCB_D:
  120C'   CD 1212'              	CALL	VCB_CD
  120F'   C3 126C'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1212'                         VCB_CD:
  1212'   CD 064A'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1215'   22 24DF'              	SHLD	OPLO
  1218'   CD 0000*              	CALL	CUROFF
  121B'   CD 125B'              	CALL	CEND		; to the line's content end, the CR,LF left
  121E'   22 24E1'              	SHLD	OPHI
  1221'   C3 114F'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1224'                         VC_X:
  1224'   CD 0837'              	CALL	GLSTAL
  1227'   CD 06CA'              	CALL	SETLIN
  122A'   CD 0657'              	CALL	GETCNT
  122D'   22 24E3'              	SHLD	CNTV
  1230'   CD 0000*              	CALL	CUROFF
  1233'   22 24E7'              	SHLD	WKI		; cur
  1236'   CD 125B'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1239'   EB                    	XCHG			; DE = contentend
  123A'   2A 24E7'              	LHLD	WKI		; HL = cur
  123D'   EB                    	XCHG			; HL = contentend, DE = cur
  123E'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1241'   7C                    	MOV	A,H
  1242'   B5                    	ORA	L
  1243'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1244'   EB                    	XCHG			; DE = available
  1245'   2A 24E3'              	LHLD	CNTV		; HL = count
  1248'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  124B'   DA 1251'              	JC	VX_USEA
  124E'   C3 1252'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1251'                         VX_USEA:
  1251'   EB                    	XCHG			; HL = available
  1252'                         VX_DEL:
  1252'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1255'   CD 0188'              	CALL	MARKMOD
  1258'   C3 126C'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  125B'                         CEND:
  125B'   CD 05C3'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  125E'   7C                    	MOV	A,H
  125F'   B5                    	ORA	L
  1260'   C8                    	RZ			; the start of the text: nothing before it
  1261'   2B                    	DCX	H
  1262'   E5                    	PUSH	H
  1263'   CD 0000*              	CALL	CHARAT
  1266'   E1                    	POP	H		; HL = term-1
  1267'   FE 0D                 	CPI	CR
  1269'   C8                    	RZ			; a CR before the LF -> the content ends there
  126A'   23                    	INX	H
  126B'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  126C'                         CLAMPE:
  126C'   CD 0000*              	CALL	CUROFF
  126F'   E5                    	PUSH	H
  1270'   CD 05EF'              	CALL	EOLC
  1273'   D1                    	POP	D		; DE = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1274'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1277'   D8                    	RC
  1278'   C8                    	RZ
  1279'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  127C'                         VC_I:
  127C'   CD 0657'              	CALL	GETCNT
  127F'   C3 12DA'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1282'                         VC_A:
  1282'   CD 0657'              	CALL	GETCNT
  1285'   CD 0633'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1288'   CA 129F'              	JZ	VA_INS
  128B'   EB                    	XCHG			; HL = cur
  128C'   E5                    	PUSH	H
  128D'   CD 0000*              	CALL	CHARAT
  1290'   E1                    	POP	H
  1291'   FE 0A                 	CPI	LF
  1293'   CA 129F'              	JZ	VA_INS		; on the line terminator -> append in place
  1296'   FE 0D                 	CPI	CR
  1298'   CA 129F'              	JZ	VA_INS
  129B'   23                    	INX	H
  129C'   CD 0000*              	CALL	GOTO
  129F'                         VA_INS:
  129F'   C3 12DA'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  12A2'                         VCB_A:
  12A2'   CD 064A'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  12A5'   CD 05EF'              	CALL	EOLC		; HL = last content char (the start when empty)
  12A8'   E5                    	PUSH	H
  12A9'   CD 0000*              	CALL	CHARAT
  12AC'   E1                    	POP	H
  12AD'   FE 0D                 	CPI	CR
  12AF'   CA 12B8'              	JZ	VBA_IN		; an empty line: insert at its start
  12B2'   FE 0A                 	CPI	LF
  12B4'   CA 12B8'              	JZ	VBA_IN
  12B7'   23                    	INX	H		; past the last content char
  12B8'                         VBA_IN:
  12B8'   CD 0000*              	CALL	GOTO
  12BB'   C3 12DA'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  12BE'                         VCB_I:
  12BE'   CD 0657'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12C1'   CD 0792'              	CALL	FNBLNK
  12C4'   CD 0000*              	CALL	CUROFF
  12C7'   E5                    	PUSH	H
  12C8'   CD 0000*              	CALL	CHARAT
  12CB'   E1                    	POP	H
  12CC'   FE 20                 	CPI	' '
  12CE'   CA 12D6'              	JZ	VBI_SK
  12D1'   FE 09                 	CPI	TAB
  12D3'   C2 12DA'              	JNZ	SETINM
  12D6'                         VBI_SK:
  12D6'   23                    	INX	H		; blanks only: past the last of them
  12D7'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  12DA'                         SETINM:
  12DA'   CD 06C4'              	CALL	SETMOV
  12DD'                         SETINS:
  12DD'   3E 01                 	MVI	A,EM_INS
  12DF'   32 24AC'              	STA	EDMODE
  12E2'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  12E3'                         ATCEND:
  12E3'   CD 0633'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  12E6'   C8                    	RZ
  12E7'   CD 063E'              	CALL	CURCHR		; A = the char under the cursor
  12EA'   FE 0D                 	CPI	CR
  12EC'   C8                    	RZ
  12ED'   FE 0A                 	CPI	LF
  12EF'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  12F0'                         OPNBRK:
  12F0'   3E 0D                 	MVI	A,CR
  12F2'   CD 0000*              	CALL	PUTGAP
  12F5'   3E 0A                 	MVI	A,LF
  12F7'   CD 0000*              	CALL	PUTGAP
  12FA'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  12FD'   23                    	INX	H
  12FE'   22 0000*              	SHLD	LNDLT
  1301'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1304'                         ENDBRK:
  1304'   CD 0633'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1307'   C0                    	RNZ
  1308'   CD 12F0'              	CALL	OPNBRK
  130B'   CD 0000*              	CALL	CUROFF
  130E'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  130F'   2B                    	DCX	H		;   line, with its own terminator after it
  1310'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1313'                         VC_O:
  1313'   CD 064A'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1316'   CD 125B'              	CALL	CEND
  1319'   CD 0000*              	CALL	GOTO
  131C'   CD 12F0'              	CALL	OPNBRK
  131F'   CD 1304'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1322'   CD 06D0'              	CALL	SETILN		;   needs a terminator of its own to exist
  1325'   C3 12DD'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1328'                         VCB_O:
  1328'   CD 064A'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  132B'   CD 05B0'              	CALL	BOL
  132E'   CD 0000*              	CALL	GOTO
  1331'   CD 12F0'              	CALL	OPNBRK
  1334'   CD 0000*              	CALL	CUROFF
  1337'   2B                    	DCX	H
  1338'   2B                    	DCX	H
  1339'   CD 0000*              	CALL	GOTO
  133C'   CD 06D0'              	CALL	SETILN
  133F'   C3 12DD'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1342'                         VCB_J:
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  1342'   CD 064A'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1345'   CD 125B'              	CALL	CEND		; the join point: this line's content end
  1348'   22 24DF'              	SHLD	OPLO
  134B'   CD 0000*              	CALL	CUROFF
  134E'   CD 05E0'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1351'   E5                    	PUSH	H
  1352'   CD 0000*              	CALL	LOGLEN
  1355'   D1                    	POP	D		; DE = that start
  1356'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1359'   CA 06C4'              	JZ	SETMOV
  135C'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  135D'                         VJ_WS:
  135D'   E5                    	PUSH	H
  135E'   CD 0000*              	CALL	LOGLEN
  1361'   D1                    	POP	D		; DE = the scan
  1362'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1365'   CA 137C'              	JZ	VJ_DEL
  1368'   EB                    	XCHG			; HL = the scan
  1369'   E5                    	PUSH	H
  136A'   CD 0000*              	CALL	CHARAT
  136D'   E1                    	POP	H
  136E'   FE 20                 	CPI	' '
  1370'   CA 1378'              	JZ	VJ_SKIP
  1373'   FE 09                 	CPI	TAB
  1375'   C2 137C'              	JNZ	VJ_DEL
  1378'                         VJ_SKIP:
  1378'   23                    	INX	H
  1379'   C3 135D'              	JMP	VJ_WS
  137C'                         VJ_DEL:
  137C'   22 24E1'              	SHLD	OPHI
  137F'   CD 114F'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1382'   CD 06DF'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1385'   CD 0633'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1388'   CA 126C'              	JZ	CLAMPE
  138B'   CD 063E'              	CALL	CURCHR		; the first char of what was appended
  138E'   FE 0D                 	CPI	CR
  1390'   CA 126C'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1393'   FE 0A                 	CPI	LF
  1395'   CA 126C'              	JZ	CLAMPE
  1398'   FE 29                 	CPI	')'
  139A'   CA 126C'              	JZ	CLAMPE		; vim puts no space before a ')'
  139D'   CD 0000*              	CALL	CUROFF
  13A0'   7C                    	MOV	A,H
  13A1'   B5                    	ORA	L
  13A2'   CA 13B8'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  13A5'   2B                    	DCX	H
  13A6'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  13A9'   FE 20                 	CPI	' '
  13AB'   CA 126C'              	JZ	CLAMPE
  13AE'   FE 09                 	CPI	TAB
  13B0'   CA 126C'              	JZ	CLAMPE
  13B3'   FE 0A                 	CPI	LF
  13B5'   CA 126C'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  13B8'                         VJ_SP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13B8'   3E 20                 	MVI	A,' '
  13BA'   CD 0000*              	CALL	PUTGAP
  13BD'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  13C0'   2B                    	DCX	H
  13C1'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  13C4'                         VC_TILD:
  13C4'   CD 0657'              	CALL	GETCNT
  13C7'   CD 06CA'              	CALL	SETLIN		; only this row changes
  13CA'   CD 0837'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  13CD'   CD 0633'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  13D0'   CA 06C4'              	JZ	SETMOV
  13D3'   CD 063E'              	CALL	CURCHR		; A = the char under the cursor
  13D6'   FE 0D                 	CPI	CR
  13D8'   CA 06C4'              	JZ	SETMOV		; the line's end: nothing to toggle
  13DB'   FE 0A                 	CPI	LF
  13DD'   CA 06C4'              	JZ	SETMOV
  13E0'   47                    	MOV	B,A
  13E1'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  13E3'   FE 41                 	CPI	'A'
  13E5'   DA 13F1'              	JC	VT_PUT		; below 'A': no case
  13E8'   FE 5B                 	CPI	'Z'+1
  13EA'   D2 13F1'              	JNC	VT_PUT		; above 'Z': no case
  13ED'   78                    	MOV	A,B
  13EE'   EE 20                 	XRI	20H		; a letter: flip the case bit
  13F0'   47                    	MOV	B,A
  13F1'                         VT_PUT:
  13F1'   78                    	MOV	A,B
  13F2'   32 24F0'              	STA	VRCH		; the calls below do not preserve B
  13F5'   CD 0188'              	CALL	MARKMOD
  13F8'   21 0001               	LXI	H,1
  13FB'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  13FE'   3A 24F0'              	LDA	VRCH
  1401'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1404'   C3 126C'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1407'                         VC_R:
  1407'   CD 0644'              	CALL	MOVCNT		; a cursor motion, and its count
  140A'   3E 03                 	MVI	A,PR
  140C'   32 24D4'              	STA	GPEND
  140F'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ; line there), which changes the line count, so that case repaints in full.
  1410'                         VR_DO:
  1410'   AF                    	XRA	A
  1411'   32 24D4'              	STA	GPEND
  1414'   79                    	MOV	A,C
  1415'   32 24F0'              	STA	VRCH		; the calls below do not preserve C
  1418'   CD 06CA'              	CALL	SETLIN		; only this row changed
  141B'   CD 0837'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  141E'   CD 0633'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1421'   CA 06C4'              	JZ	SETMOV		; the end of the text: vim does nothing
  1424'   CD 063E'              	CALL	CURCHR		; A = the char under the cursor
  1427'   FE 0D                 	CPI	CR
  1429'   CA 06C4'              	JZ	SETMOV		; the line's end: nothing to replace
  142C'   FE 0A                 	CPI	LF
  142E'   CA 06C4'              	JZ	SETMOV
  1431'   CD 0188'              	CALL	MARKMOD
  1434'   21 0001               	LXI	H,1
  1437'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  143A'   3A 24F0'              	LDA	VRCH
  143D'   FE 0D                 	CPI	CR
  143F'   CA 144C'              	JZ	VR_CR
  1442'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1445'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1448'   2B                    	DCX	H		;   out, which moves every logical offset
  1449'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  144C'                         VR_CR:
  144C'   CD 12F0'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  144F'   CD 1304'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1452'   CD 06D0'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1455'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1457'   32 24B4'              	STA	ILABOV
  145A'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  145B'                         VCB_R:
  145B'   CD 0657'              	CALL	GETCNT
  145E'   CD 06C4'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1461'   21 0000               	LXI	H,0
  1464'   22 24F1'              	SHLD	RPDEL		; nothing of ours to put back yet
  1467'   22 24F3'              	SHLD	RPAPP
  146A'   3E 02                 	MVI	A,EM_REP
  146C'   32 24AC'              	STA	EDMODE
  146F'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1470'                         VC_D:
  1470'   3E 64                 	MVI	A,'d'
  1472'   32 24D6'              	STA	PENDOP
  1475'   C3 06C4'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1478'                         VC_C:
  1478'   3E 63                 	MVI	A,'c'
  147A'   32 24D6'              	STA	PENDOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  147D'   C3 06C4'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1480'                         VD_DD:
  1480'   CD 0837'              	CALL	GLSTAL
  1483'   CD 0657'              	CALL	GETCNT
  1486'   22 24E3'              	SHLD	CNTV
  1489'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  148B'   32 24D8'              	STA	DDSNG
  148E'   2B                    	DCX	H
  148F'   7C                    	MOV	A,H
  1490'   B5                    	ORA	L
  1491'   C2 149C'              	JNZ	VDD_LS
  1494'   3E 01                 	MVI	A,1
  1496'   32 24D8'              	STA	DDSNG
  1499'   C3 14A2'              	JMP	VDD_GO
  149C'                         VDD_LS:
  149C'   CD 07FD'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  149F'   DA 06C4'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  14A2'                         VDD_GO:
  14A2'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  14A5'   CD 077B'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  14A8'   2A 24E3'              	LHLD	CNTV
  14AB'   CD 0000*              	CALL	SETC0
  14AE'                         VDD_FW:
  14AE'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  14B1'   CD 066C'              	CALL	CNTTST
  14B4'   C2 14AE'              	JNZ	VDD_FW
  14B7'   CD 0188'              	CALL	MARKMOD
  14BA'   CD 096E'              	CALL	ATEOF
  14BD'   D2 14D8'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  14C0'   3E 00                 	MVI	A,0
  14C2'   32 24D8'              	STA	DDSNG		; deleted to the end: full repaint
  14C5'   CD 0DB4'              	CALL	ONFST
  14C8'   CA 0792'              	JZ	FNBLNK		; nothing left before it
  14CB'   21 0001               	LXI	H,1		; onto the new last line
  14CE'   CD 0000*              	CALL	SETBWD
  14D1'   2A 0000*              	LHLD	LNDLT
  14D4'   2B                    	DCX	H
  14D5'   22 0000*              	SHLD	LNDLT
  14D8'                         VDD_UP:
  14D8'   CD 0792'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                	;    DL + a bottom redraw. ---
  14DB'   3A 24D8'              	LDA	DDSNG
  14DE'   B7                    	ORA	A
  14DF'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  14E0'   3E 03                 	MVI	A,R_DLIN
  14E2'   32 24B1'              	STA	RINTENT
  14E5'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  14E6'                         QEMPTY:
  14E6'   2A 0000*              	LHLD	QBEG
  14E9'   EB                    	XCHG
  14EA'   2A 0000*              	LHLD	QEND
  14ED'   7C                    	MOV	A,H
  14EE'   BA                    	CMP	D
  14EF'   C0                    	RNZ
  14F0'   7D                    	MOV	A,L
  14F1'   BB                    	CMP	E
  14F2'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  14F3'                         VC_Y:
  14F3'   3E 79                 	MVI	A,'y'
  14F5'   32 24D6'              	STA	PENDOP
  14F8'   C3 06C4'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  14FB'                         VY_YY:
  14FB'   CD 0000*              	CALL	CUROFF
  14FE'   22 2514'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1501'   CD 05B0'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1504'   22 2516'              	SHLD	YPT		; where the lines come from, to put them back
  1507'   CD 1618'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  150A'   CD 165B'              	CALL	YNCOPY		; copied where they lie, if that can be done
  150D'   D2 161F'              	JNC	YNDONE
  1510'   21 1480'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1513'   C3 153F'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1516'                         OPYANK:
  1516'   CD 1183'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1519'   2A 24DB'              	LHLD	OPSTA
  151C'   EB                    	XCHG			; DE = start
  151D'   2A 24DD'              	LHLD	OPEND2		; HL = end
  1520'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1523'   D2 1527'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1526'   EB                    	XCHG			; ... otherwise the start is
  1527'                         OPY_LO:
  1527'   22 2514'              	SHLD	YOFF
  152A'   2A 24DF'              	LHLD	OPLO
  152D'   22 2516'              	SHLD	YPT		; where the lines come from, to put them back
  1530'   CD 1618'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1533'   CD 16D3'              	CALL	YNSPAN		; copied where they lie, if there is room
  1536'   D2 161F'              	JNC	YNDONE
  1539'   21 15DC'              	LXI	H,YSPAN
  153C'   C3 153F'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  153F'                         YKGO:
  153F'   22 253D'              	SHLD	YACT
  1542'   2A 2516'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1545'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1546'   2A 2514'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1549'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  154C'   22 2543'              	SHLD	YCOL		;   them -- but a distance within the lines does
  154F'   3A 24B0'              	LDA	MODF
  1552'   32 2511'              	STA	YMODF
  1555'   3A 24C9'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1558'   32 2512'              	STA	YDCHG		;   a yank must not become the last change
  155B'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  155E'   32 2513'              	STA	YURPL		;   back are not a change to undo either
  1561'   3E 01                 	MVI	A,1
  1563'   32 0000*              	STA	UNDRPL
  1566'   32 253C'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1569'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  156C'   22 251F'              	SHLD	YLDLT
  156F'   CD 0000*              	CALL	LOGLEN
  1572'   22 2541'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                				;   took lines from one that took none
  1575'   2A 253D'              	LHLD	YACT
  1578'   CD 15DB'              	CALL	YCALL		; the lines out of the file, into the register
  157B'   CD 0000*              	CALL	LOGLEN
  157E'   EB                    	XCHG
  157F'   2A 2541'              	LHLD	YWAS
  1582'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1585'   CA 15B3'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1588'   2A 2516'              	LHLD	YPT
  158B'   CD 0000*              	CALL	GOTO
  158E'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  1591'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  1594'   22 2545'              	SHLD	YBLK
  1597'   2A 0000*              	LHLD	QBEG
  159A'   EB                    	XCHG
  159B'   2A 0000*              	LHLD	QEND
  159E'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  15A1'   EB                    	XCHG
  15A2'   2A 2545'              	LHLD	YBLK
  15A5'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  15A8'   EB                    	XCHG
  15A9'   2A 2543'              	LHLD	YCOL
  15AC'   19                    	DAD	D		; ... and the cursor is YCOL into them
  15AD'   CD 0000*              	CALL	GOTO
  15B0'   C3 15B9'              	JMP	YK_RST
  15B3'                         YK_FIN:				; nothing came out, so nothing was put back and
  15B3'   2A 2514'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  15B6'   CD 0000*              	CALL	GOTO		;   where it was
  15B9'                         YK_RST:
  15B9'   2A 251F'              	LHLD	YLDLT
  15BC'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  15BF'   3A 2511'              	LDA	YMODF
  15C2'   32 24B0'              	STA	MODF
  15C5'   3A 2512'              	LDA	YDCHG
  15C8'   32 24C9'              	STA	DOTCHG
  15CB'   3A 2513'              	LDA	YURPL
  15CE'   32 0000*              	STA	UNDRPL
  15D1'   AF                    	XRA	A
  15D2'   32 253C'              	STA	MKHOLD
  15D5'   CD 0837'              	CALL	GLSTAL
  15D8'   C3 06E5'              	JMP	SETFUL		; the cheap paint cannot carry this
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15DB'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  15DC'                         YSPAN:
  15DC'   CD 0837'              	CALL	GLSTAL
  15DF'   CD 1144'              	CALL	OPSPNL		; HL = the span's length
  15E2'   22 253F'              	SHLD	YTGT
  15E5'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  15E8'   EB                    	XCHG			; DE = it
  15E9'   2A 253F'              	LHLD	YTGT
  15EC'   EB                    	XCHG			; HL = the text's, DE = the span's
  15ED'   CD 0000*              	CALL	SUBHD
  15F0'   22 253F'              	SHLD	YTGT		; what the text is left at when the span is out
  15F3'   2A 24DF'              	LHLD	OPLO
  15F6'   CD 0000*              	CALL	GOTO
  15F9'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  15FC'                         YS_LP:
  15FC'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  15FF'   CD 0000*              	CALL	SETC0
  1602'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1605'   CD 0000*              	CALL	LOGLEN
  1608'   EB                    	XCHG			; DE = what is left
  1609'   2A 253F'              	LHLD	YTGT
  160C'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  160F'   DA 1615'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1612'   C2 15FC'              	JNZ	YS_LP		;   but never spin here if it ever did
  1615'                         YS_END:
  1615'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1618'                         YNPRE:
  1618'   2A 0000*              	LHLD	PGTOPM
  161B'   22 2547'              	SHLD	YNPG
  161E'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  161F'                         YNDONE:
  161F'   2A 2514'              	LHLD	YOFF
  1622'   CD 0000*              	CALL	GOTO
  1625'   2A 0000*              	LHLD	PGTOPM
  1628'   EB                    	XCHG
  1629'   2A 2547'              	LHLD	YNPG
  162C'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  162F'   C2 06E5'              	JNZ	SETFUL		; it moved under us: repaint after all
  1632'   C3 06C4'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1635'                         YNROOM:
  1635'   11 0100               	LXI	D,100H
  1638'   19                    	DAD	D
  1639'   D8                    	RC			; within a chunk of 64K: no arena holds that
  163A'   E5                    	PUSH	H		; the span plus its slack
  163B'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  163E'   EB                    	XCHG			; HL = free
  163F'   D1                    	POP	D		; DE = the span plus its slack
  1640'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1643'   DA 164B'              	JC	YNR_OK
  1646'   CA 164B'              	JZ	YNR_OK
  1649'   37                    	STC			; not enough: the delete-and-put-back path
  164A'   C9                    	RET
  164B'                         YNR_OK:
  164B'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  164C'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  164D'                         YNGO:
  164D'   C5                    	PUSH	B
  164E'   CD 0657'              	CALL	GETCNT		; spent here: this yank is happening
  1651'   CD 0837'              	CALL	GLSTAL
  1654'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1657'   C1                    	POP	B
  1658'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  165B'                         YNCOPY:
  165B'   2A 24AD'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  165E'   7C                    	MOV	A,H		;   the count itself
  165F'   B5                    	ORA	L
  1660'   C2 1666'              	JNZ	YNC_HV
  1663'   21 0001               	LXI	H,1
  1666'                         YNC_HV:
  1666'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1667'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1668'   B4                    	ORA	H
  1669'   CA 1674'              	JZ	YNC_M
  166C'   E5                    	PUSH	H
  166D'   CD 07FD'              	CALL	ONLAST		; vim: a count over one on the last line does
  1670'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1671'   DA 1686'              	JC	YNC_RF
  1674'                         YNC_M:
  1674'   E5                    	PUSH	H
  1675'   CD 077B'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1678'   E1                    	POP	H
  1679'   CD 168E'              	CALL	YNLINE		; BC = the span, measured where it stands
  167C'   D8                    	RC			; not measurable here: let the pager answer it
  167D'   60                    	MOV	H,B
  167E'   69                    	MOV	L,C
  167F'   CD 1635'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1682'   D8                    	RC			; no: the delete-and-put-back path
  1683'   C3 164D'              	JMP	YNGO
  1686'                         YNC_RF:
  1686'   CD 0657'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1689'   CD 0837'              	CALL	GLSTAL		;   register alone, and that is the command
  168C'   B7                    	ORA	A		; NC: done
  168D'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  168E'                         YNLINE:
  168E'   22 2549'              	SHLD	YNCNT		; the lines it still wants
  1691'   2A 0000*              	LHLD	GAPEND
  1694'                         YNL_LP:
  1694'   EB                    	XCHG			; DE = the scan
  1695'   2A 0000*              	LHLD	TXTEND
  1698'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  169B'   EB                    	XCHG			; HL = the scan
  169C'   D2 16BC'              	JNC	YNL_EN		; the resident text ran out
  169F'   7E                    	MOV	A,M
  16A0'   23                    	INX	H
  16A1'   FE 0A                 	CPI	LF
  16A3'   C2 1694'              	JNZ	YNL_LP
  16A6'   E5                    	PUSH	H
  16A7'   2A 2549'              	LHLD	YNCNT
  16AA'   2B                    	DCX	H
  16AB'   22 2549'              	SHLD	YNCNT
  16AE'   7C                    	MOV	A,H
  16AF'   B5                    	ORA	L
  16B0'   E1                    	POP	H
  16B1'   C2 1694'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  16B4'   EB                    	XCHG			; DE = past the last of them
  16B5'   2A 0000*              	LHLD	GAPEND
  16B8'   EB                    	XCHG			; HL = past them, DE = GAPEND
  16B9'   C3 16CA'              	JMP	YNL_BC
  16BC'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  16BC'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  16BF'   C2 16D1'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  16C2'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  16C5'   EB                    	XCHG			;   count clamps to it as vim's does
  16C6'   2A 0000*              	LHLD	GAPEND
  16C9'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  16CA'                         YNL_BC:
  16CA'   CD 0000*              	CALL	SUBHD		; HL = the span
  16CD'   44                    	MOV	B,H
  16CE'   4D                    	MOV	C,L
  16CF'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  16D0'   C9                    	RET
  16D1'                         YNL_NO:
  16D1'   37                    	STC
  16D2'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  16D3'                         YNSPAN:
  16D3'   CD 1144'              	CALL	OPSPNL		; HL = the span's length
  16D6'   44                    	MOV	B,H
  16D7'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  16D8'   CD 1635'              	CALL	YNROOM
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  16DB'   D8                    	RC			; no room: the delete-and-put-back path
  16DC'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  16DD'   2A 24DF'              	LHLD	OPLO
  16E0'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  16E3'   C1                    	POP	B
  16E4'   C3 164D'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  16E7'                         VC_P:
  16E7'   CD 14E6'              	CALL	QEMPTY
  16EA'   CA 17A2'              	JZ	VP_BEL
  16ED'   CD 0657'              	CALL	GETCNT
  16F0'   22 2518'              	SHLD	PCNT
  16F3'   CD 0000*              	CALL	CUROFF
  16F6'   CD 05E0'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  16F9'   C3 170E'              	JMP	VP_GO
  16FC'                         VCB_P:
  16FC'   CD 14E6'              	CALL	QEMPTY
  16FF'   CA 17A2'              	JZ	VP_BEL
  1702'   CD 0657'              	CALL	GETCNT
  1705'   22 2518'              	SHLD	PCNT
  1708'   CD 0000*              	CALL	CUROFF
  170B'   CD 05B0'              	CALL	BOL
  170E'                         VP_GO:
  170E'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1711'   CD 0000*              	CALL	CUROFF
  1714'   EB                    	XCHG
  1715'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1718'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  171B'   DA 1730'              	JC	VP_IN
  171E'   EB                    	XCHG			; HL = the put point = LOGLEN
  171F'   7C                    	MOV	A,H
  1720'   B5                    	ORA	L
  1721'   CA 172D'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1724'   2B                    	DCX	H
  1725'   CD 0000*              	CALL	CHARAT
  1728'   FE 0A                 	CPI	LF
  172A'   CA 1730'              	JZ	VP_IN
  172D'                         VP_BRK:
  172D'   CD 12F0'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1730'                         VP_IN:
  1730'   CD 0000*              	CALL	CUROFF
  1733'   22 251A'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1736'   2A 0000*              	LHLD	QBEG
  1739'   EB                    	XCHG
  173A'   2A 0000*              	LHLD	QEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  173D'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1740'   EB                    	XCHG
  1741'   22 251C'              	SHLD	PLFS
  1744'   2A 2518'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1747'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1748'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1749'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  174B'   C2 174F'              	JNZ	VP_PZ
  174E'   7D                    	MOV	A,L
  174F'                         VP_PZ:
  174F'   32 251E'              	STA	PCPY
  1752'                         VP_LP:
  1752'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1755'   2A 0000*              	LHLD	LNDLT
  1758'   EB                    	XCHG
  1759'   2A 251C'              	LHLD	PLFS
  175C'   19                    	DAD	D
  175D'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1760'   2A 2518'              	LHLD	PCNT
  1763'   2B                    	DCX	H
  1764'   22 2518'              	SHLD	PCNT
  1767'   7C                    	MOV	A,H
  1768'   B5                    	ORA	L
  1769'   C2 1752'              	JNZ	VP_LP
  176C'   CD 0188'              	CALL	MARKMOD
  176F'   2A 251A'              	LHLD	PPT
  1772'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1775'   CD 0837'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1778'   3A 251E'              	LDA	PCPY
  177B'   B7                    	ORA	A
  177C'   CA 0792'              	JZ	FNBLNK
  177F'   2A 251C'              	LHLD	PLFS
  1782'   7C                    	MOV	A,H
  1783'   B7                    	ORA	A
  1784'   C2 0792'              	JNZ	FNBLNK
  1787'   3A 251E'              	LDA	PCPY
  178A'   CD 0D4A'              	CALL	MULSAT		; HL = the lines this put put, saturated
  178D'   7C                    	MOV	A,H
  178E'   B7                    	ORA	A
  178F'   C2 0792'              	JNZ	FNBLNK
  1792'   7D                    	MOV	A,L
  1793'   B7                    	ORA	A
  1794'   CA 0792'              	JZ	FNBLNK
  1797'   F5                    	PUSH	PSW
  1798'   CD 06D0'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  179B'   F1                    	POP	PSW
  179C'   32 24B2'              	STA	ILN		; ... which the lines put now replace
  179F'   C3 0792'              	JMP	FNBLNK
  17A2'                         VP_BEL:
  17A2'   CD 0657'              	CALL	GETCNT		; the count is spent either way
  17A5'   0E 07                 	MVI	C,BEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17A7'   CD 0000*              	CALL	BCONOU
  17AA'   C3 06C4'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  17AD'                         VIREP:
  17AD'   78                    	MOV	A,B
  17AE'   FE 01                 	CPI	KT_ACT
  17B0'   CA 18DD'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  17B3'   FE 02                 	CPI	KT_CHAR
  17B5'   C0                    	RNZ			; ignore anything else
  17B6'   79                    	MOV	A,C
  17B7'   FE 0D                 	CPI	CR
  17B9'   CA 181D'              	JZ	VP_CR
  17BC'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  17BE'   CA 181D'              	JZ	VP_CR
  17C1'   FE 08                 	CPI	BS
  17C3'   CA 1829'              	JZ	VP_BS
  17C6'   FE 7F                 	CPI	DEL
  17C8'   CA 1829'              	JZ	VP_BS
  17CB'   32 24F0'              	STA	VRCH		; the calls below do not preserve C
  17CE'   CD 06CA'              	CALL	SETLIN		; this row changed
  17D1'   CD 0188'              	CALL	MARKMOD
  17D4'   CD 12E3'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  17D7'   CA 180F'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  17DA'   3A 24F0'              	LDA	VRCH
  17DD'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  17E0'   2A 24F1'              	LHLD	RPDEL
  17E3'   7C                    	MOV	A,H
  17E4'   B5                    	ORA	L
  17E5'   CA 17FB'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  17E8'   2A 0000*              	LHLD	GAPEND
  17EB'   EB                    	XCHG
  17EC'   2A 24F5'              	LHLD	RPGE
  17EF'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  17F2'   CA 17FB'              	JZ	VP_OVW
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17F5'   21 0000               	LXI	H,0
  17F8'   22 24F1'              	SHLD	RPDEL		; the text moved: those originals are gone
  17FB'                         VP_OVW:
  17FB'   21 0001               	LXI	H,1
  17FE'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1801'   2A 0000*              	LHLD	GAPEND
  1804'   22 24F5'              	SHLD	RPGE
  1807'   2A 24F1'              	LHLD	RPDEL
  180A'   23                    	INX	H
  180B'   22 24F1'              	SHLD	RPDEL
  180E'   C9                    	RET
  180F'                         VP_APP:
  180F'   3A 24F0'              	LDA	VRCH
  1812'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1815'   2A 24F3'              	LHLD	RPAPP
  1818'   23                    	INX	H
  1819'   22 24F3'              	SHLD	RPAPP
  181C'   C9                    	RET
  181D'                         VP_CR:
  181D'   21 0000               	LXI	H,0
  1820'   22 24F1'              	SHLD	RPDEL		; a line break ends what BS can put back
  1823'   22 24F3'              	SHLD	RPAPP
  1826'   C3 18B3'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1829'                         VP_BS:
  1829'   2A 24F3'              	LHLD	RPAPP
  182C'   7C                    	MOV	A,H
  182D'   B5                    	ORA	L
  182E'   CA 183B'              	JZ	VP_BSD
  1831'   2B                    	DCX	H
  1832'   22 24F3'              	SHLD	RPAPP		; an appended char: it just goes
  1835'   CD 06CA'              	CALL	SETLIN
  1838'   C3 0000*              	JMP	DELPRV
  183B'                         VP_BSD:
  183B'   2A 24F1'              	LHLD	RPDEL
  183E'   7C                    	MOV	A,H
  183F'   B5                    	ORA	L
  1840'   CA 1867'              	JZ	VP_BSM		; nothing of ours left
  1843'   2A 0000*              	LHLD	GAPEND
  1846'   EB                    	XCHG
  1847'   2A 24F5'              	LHLD	RPGE
  184A'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  184D'   C2 1867'              	JNZ	VP_BSM
  1850'   2A 24F1'              	LHLD	RPDEL
  1853'   2B                    	DCX	H
  1854'   22 24F1'              	SHLD	RPDEL
  1857'   CD 06CA'              	CALL	SETLIN
  185A'   CD 0000*              	CALL	DELPRV		; the typed char goes
  185D'   CD 0000*              	CALL	UNDELF		; the original comes back
  1860'   2A 0000*              	LHLD	GAPEND
  1863'   22 24F5'              	SHLD	RPGE
  1866'   C9                    	RET
  1867'                         VP_BSM:
  1867'   CD 06C4'              	CALL	SETMOV		; nothing changed: back over the text as it is
  186A'   C3 0733'              	JMP	HSTEP
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  186D'                         VIINS:
  186D'   78                    	MOV	A,B
  186E'   FE 01                 	CPI	KT_ACT
  1870'   CA 18DD'              	JZ	VI_ACT
  1873'   FE 02                 	CPI	KT_CHAR
  1875'   C0                    	RNZ			; ignore anything else
  1876'   79                    	MOV	A,C
  1877'   FE 0D                 	CPI	CR
  1879'   CA 18B3'              	JZ	VI_CR
  187C'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  187E'   CA 18B3'              	JZ	VI_CR
  1881'   FE 08                 	CPI	BS
  1883'   CA 18CB'              	JZ	VI_BS
  1886'   FE 7F                 	CPI	DEL
  1888'   CA 18CB'              	JZ	VI_BS
  188B'   79                    	MOV	A,C
  188C'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  188F'   CD 0188'              	CALL	MARKMOD
  1892'   CD 06CA'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1895'   79                    	MOV	A,C
  1896'   FE 20                 	CPI	' '
  1898'   D8                    	RC			; control char -> keep R_LINE
  1899'   FE 7F                 	CPI	DEL
  189B'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  189C'   CD 06EB'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  189F'   B7                    	ORA	A
  18A0'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  18A1'   3E 04                 	MVI	A,R_ICH
  18A3'   32 24B1'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  18A6'   CD 12E3'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  18A9'   3E 00                 	MVI	A,0
  18AB'   C2 18AF'              	JNZ	VI_ICH
  18AE'   3C                    	INR	A
  18AF'                         VI_ICH:
  18AF'   32 24B3'              	STA	ICHAPP
  18B2'   C9                    	RET
  18B3'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  18B3'   CD 12E3'              	CALL	ATCEND
  18B6'   3E 00                 	MVI	A,0
  18B8'   CA 18BC'              	JZ	VI_CRS
  18BB'   3C                    	INR	A
  18BC'                         VI_CRS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18BC'   F5                    	PUSH	PSW
  18BD'   CD 12F0'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  18C0'   CD 1304'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  18C3'   CD 06D0'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  18C6'   F1                    	POP	PSW
  18C7'   32 24B4'              	STA	ILABOV
  18CA'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  18CB'                         VI_BS:
  18CB'   CD 0000*              	CALL	PEEKL
  18CE'   D8                    	RC			; start of the file: nothing to delete
  18CF'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  18D1'   CA 18D7'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  18D4'   CD 06CA'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  18D7'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  18D7'   CD 0188'              	CALL	MARKMOD
  18DA'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  18DD'                         VI_ACT:
  18DD'   79                    	MOV	A,C
  18DE'   FE 0B                 	CPI	ACT_ESC
  18E0'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  18E1'   3E 00                 	MVI	A,EM_CMD
  18E3'   32 24AC'              	STA	EDMODE
  18E6'   CD 06C4'              	CALL	SETMOV
  18E9'   CD 0733'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  18EC'   C3 0837'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  18EF'                         RDLINE:
  18EF'   EB                    	XCHG			; HL = buffer
  18F0'   22 24F7'              	SHLD	RLPTR
  18F3'   3E 00                 	MVI	A,0
  18F5'   32 24F9'              	STA	RLLEN
  18F8'   78                    	MOV	A,B
  18F9'   32 24FA'              	STA	RLMAX
  18FC'   79                    	MOV	A,C
  18FD'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1900'                         RL_LP:
  1900'   CD 0000*              	CALL	GETKEY
  1903'   78                    	MOV	A,B
  1904'   FE 01                 	CPI	KT_ACT
  1906'   CA 195C'              	JZ	RL_ACT
  1909'   FE 02                 	CPI	KT_CHAR
  190B'   C2 1900'              	JNZ	RL_LP		; ignore other keys
  190E'   79                    	MOV	A,C
  190F'   FE 0D                 	CPI	CR
  1911'   CA 196D'              	JZ	RL_DONE
  1914'   FE 08                 	CPI	BS
  1916'   CA 1944'              	JZ	RL_BS
  1919'   FE 7F                 	CPI	DEL
  191B'   CA 1944'              	JZ	RL_BS
  191E'   FE 20                 	CPI	' '
  1920'   DA 1900'              	JC	RL_LP		; control char -> ignore
  1923'   3A 24F9'              	LDA	RLLEN
  1926'   47                    	MOV	B,A
  1927'   3A 24FA'              	LDA	RLMAX
  192A'   B8                    	CMP	B
  192B'   CA 1900'              	JZ	RL_LP		; full -> ignore
  192E'   2A 24F7'              	LHLD	RLPTR
  1931'   71                    	MOV	M,C
  1932'   23                    	INX	H
  1933'   22 24F7'              	SHLD	RLPTR
  1936'   3A 24F9'              	LDA	RLLEN
  1939'   3C                    	INR	A
  193A'   32 24F9'              	STA	RLLEN
  193D'   79                    	MOV	A,C
  193E'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1941'   C3 1900'              	JMP	RL_LP
  1944'                         RL_BS:				; WM LINEPOP
  1944'   3A 24F9'              	LDA	RLLEN
  1947'   B7                    	ORA	A
  1948'   CA 1962'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  194B'   3D                    	DCR	A
  194C'   32 24F9'              	STA	RLLEN
  194F'   2A 24F7'              	LHLD	RLPTR
  1952'   2B                    	DCX	H
  1953'   22 24F7'              	SHLD	RLPTR
  1956'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1959'   C3 1900'              	JMP	RL_LP
  195C'                         RL_ACT:
  195C'   79                    	MOV	A,C
  195D'   FE 0B                 	CPI	ACT_ESC
  195F'   C2 1900'              	JNZ	RL_LP
  1962'                         RL_CAN:
  1962'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1964'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1967'   CD 06CA'              	CALL	SETLIN		; redraw one row
  196A'   3E FF                 	MVI	A,0FFH		; cancelled
  196C'   C9                    	RET
  196D'                         RL_DONE:
  196D'   AF                    	XRA	A
  196E'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  196F'                         VC_BZ:
  196F'   CD 06C4'              	CALL	SETMOV
  1972'   3A 24D5'              	LDA	GSAVE
  1975'   FE 02                 	CPI	PZ
  1977'   CA 1982'              	JZ	VZ_ZZ
  197A'   B7                    	ORA	A
  197B'   C0                    	RNZ			; 'g' was pending: vim drops both
  197C'   3E 02                 	MVI	A,PZ
  197E'   32 24D4'              	STA	GPEND
  1981'   C9                    	RET
  1982'                         VZ_ZZ:
  1982'   3E 04                 	MVI	A,EO_X
  1984'   32 24FB'              	STA	EXOP
  1987'   3E 01                 	MVI	A,1
  1989'   32 250E'              	STA	EXBANG		; no '!'
  198C'   AF                    	XRA	A
  198D'   32 24FC'              	STA	EXARG		; no file name
  1990'   3A 24B0'              	LDA	MODF		; as ':x': a changed text is written first
  1993'   B7                    	ORA	A
  1994'   CA 1AB7'              	JZ	EX_Q
  1997'   C3 1A51'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  199A'                         VC_EX:
  199A'   CD 0657'              	CALL	GETCNT
  199D'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  19A0'   11 0000*              	LXI	D,EXBUF
  19A3'   06 28                 	MVI	B,EXMAX
  19A5'   0E 3A                 	MVI	C,':'
  19A7'   CD 18EF'              	CALL	RDLINE
  19AA'   B7                    	ORA	A
  19AB'   C0                    	RNZ			; cancelled
  19AC'   3A 24F9'              	LDA	RLLEN
  19AF'   5F                    	MOV	E,A
  19B0'   16 00                 	MVI	D,0
  19B2'   21 0000*              	LXI	H,EXBUF
  19B5'   19                    	DAD	D
  19B6'   36 00                 	MVI	M,0		; the line ends with a 0
  19B8'   21 0000*              	LXI	H,EXBUF
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19BB'   CD 1D53'              	CALL	SKIPB
  19BE'   C8                    	RZ			; nothing on it
  19BF'   22 24FE'              	SHLD	EXCMD
  19C2'   CD 1EFD'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  19C5'   CD 1D53'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  19C8'   56                    	MOV	D,M
  19C9'   23                    	INX	H
  19CA'   1E 00                 	MVI	E,0
  19CC'   CD 1D5F'              	CALL	ISLOW
  19CF'   DA 19DA'              	JC	EX_LK
  19D2'   5F                    	MOV	E,A
  19D3'   23                    	INX	H
  19D4'   CD 1D5F'              	CALL	ISLOW
  19D7'   D2 19F3'              	JNC	EX_NOT		; a third letter: none of ours
  19DA'                         EX_LK:
  19DA'   E5                    	PUSH	H
  19DB'   21 1EE7'              	LXI	H,EXTAB
  19DE'                         EX_TL:
  19DE'   7E                    	MOV	A,M
  19DF'   B7                    	ORA	A
  19E0'   CA 19F2'              	JZ	EX_NTP		; not in the table
  19E3'   23                    	INX	H
  19E4'   BA                    	CMP	D
  19E5'   7E                    	MOV	A,M
  19E6'   23                    	INX	H
  19E7'   C2 19EE'              	JNZ	EX_TN
  19EA'   BB                    	CMP	E
  19EB'   CA 19F9'              	JZ	EX_TF
  19EE'                         EX_TN:
  19EE'   23                    	INX	H
  19EF'   C3 19DE'              	JMP	EX_TL
  19F2'                         EX_NTP:
  19F2'   E1                    	POP	H
  19F3'                         EX_NOT:
  19F3'   21 1E17'              	LXI	H,SNOT
  19F6'   C3 1D94'              	JMP	EXERT
  19F9'                         EX_TF:
  19F9'   7E                    	MOV	A,M
  19FA'   32 24FB'              	STA	EXOP
  19FD'   E1                    	POP	H
  19FE'   FE 06                 	CPI	EO_S
  1A00'   CA 1F6C'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1A03'   3A 2552'              	LDA	SRNGF
  1A06'   B7                    	ORA	A
  1A07'   C2 19F3'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1A0A'   7E                    	MOV	A,M
  1A0B'   D6 21                 	SUI	'!'
  1A0D'   32 250E'              	STA	EXBANG		; 0 = '!'
  1A10'   C2 1A14'              	JNZ	EX_NB
  1A13'   23                    	INX	H
  1A14'                         EX_NB:
  1A14'   CD 1D53'              	CALL	SKIPB
  1A17'   32 24FC'              	STA	EXARG		; 0 = no file name
  1A1A'   CA 1A33'              	JZ	EX_RUN
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A1D'   22 24FE'              	SHLD	EXCMD
  1A20'   3A 24FB'              	LDA	EXOP
  1A23'   FE 02                 	CPI	EO_Q
  1A25'   CA 1D91'              	JZ	EX_TRL		; :q takes none
  1A28'   FE 07                 	CPI	EO_V
  1A2A'   CA 1D91'              	JZ	EX_TRL		; nor :ve
  1A2D'   CD 1CBD'              	CALL	PARSFN
  1A30'   C2 1D85'              	JNZ	EX_INV
  1A33'                         EX_RUN:
  1A33'   3A 24FB'              	LDA	EXOP
  1A36'   FE 05                 	CPI	EO_E
  1A38'   CA 1ACE'              	JZ	EX_E
  1A3B'   FE 02                 	CPI	EO_Q
  1A3D'   CA 1AB7'              	JZ	EX_Q
  1A40'   FE 07                 	CPI	EO_V
  1A42'   CA 1D8B'              	JZ	EX_V
  1A45'   FE 04                 	CPI	EO_X
  1A47'   C2 1A51'              	JNZ	EX_W
  1A4A'   3A 24B0'              	LDA	MODF		; :x writes only a changed text
  1A4D'   B7                    	ORA	A
  1A4E'   CA 1AB7'              	JZ	EX_Q
  1A51'                         EX_W:
  1A51'   CD 1B25'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1A54'   D8                    	RC			; refused (message shown)
  1A55'   32 24FD'              	STA	EXBAK
  1A58'   3A 24FB'              	LDA	EXOP
  1A5B'   FE 01                 	CPI	EO_W
  1A5D'   CA 1A74'              	JZ	EX_WK
  1A60'   3A 24FD'              	LDA	EXBAK
  1A63'   B7                    	ORA	A
  1A64'   C2 1AB4'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1A67'   3A 250E'              	LDA	EXBANG
  1A6A'   B7                    	ORA	A
  1A6B'   CA 1AB4'              	JZ	EX_WQ		; so it does with '!'
  1A6E'   CD 1A74'              	CALL	EX_WK		; else it may not: keep the text
  1A71'   C3 1AB7'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1A74'                         EX_WK:
  1A74'   CD 0C56'              	CALL	CURRW		; the cursor's row and file position
  1A77'   32 2500'              	STA	WPROW
  1A7A'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1A7D'   7D                    	MOV	A,L
  1A7E'   E6 7F                 	ANI	7FH
  1A80'   32 2501'              	STA	WPBYT
  1A83'   7D                    	MOV	A,L
  1A84'   17                    	RAL
  1A85'   7C                    	MOV	A,H
  1A86'   17                    	RAL
  1A87'   5F                    	MOV	E,A
  1A88'   3E 00                 	MVI	A,0
  1A8A'   17                    	RAL
  1A8B'   57                    	MOV	D,A		; DE = HL / 128
  1A8C'   2A 0000*              	LHLD	OUTPOS
  1A8F'   19                    	DAD	D
  1A90'   22 2502'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1A93'   CD 1B5A'              	CALL	WRITE
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A96'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1A99'   2A 2502'              	LHLD	WPREC
  1A9C'   EB                    	XCHG
  1A9D'   3A 2501'              	LDA	WPBYT
  1AA0'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1AA3'   CD 0000*              	CALL	GOTO
  1AA6'   21 0000               	LXI	H,0
  1AA9'   22 0000*              	SHLD	LNDLT
  1AAC'   3A 2500'              	LDA	WPROW
  1AAF'   6F                    	MOV	L,A
  1AB0'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1AB3'   C9                    	RET
  1AB4'                         EX_WQ:
  1AB4'   CD 1B5A'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1AB7'                         EX_Q:
  1AB7'   3A 250E'              	LDA	EXBANG
  1ABA'   B7                    	ORA	A
  1ABB'   CA 1AC5'              	JZ	EX_QT
  1ABE'   3A 24B0'              	LDA	MODF
  1AC1'   B7                    	ORA	A
  1AC2'   C2 1D79'              	JNZ	MSGNWR		; changed, no '!': stay
  1AC5'                         EX_QT:
  1AC5'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1AC8'   3E 01                 	MVI	A,1
  1ACA'   32 24AF'              	STA	QUITF
  1ACD'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1ACE'                         EX_E:
  1ACE'   3A 250E'              	LDA	EXBANG
  1AD1'   B7                    	ORA	A
  1AD2'   CA 1ADC'              	JZ	EE_GO
  1AD5'   3A 24B0'              	LDA	MODF
  1AD8'   B7                    	ORA	A
  1AD9'   C2 1D79'              	JNZ	MSGNWR
  1ADC'                         EE_GO:
  1ADC'   3A 24FC'              	LDA	EXARG
  1ADF'   B7                    	ORA	A
  1AE0'   C2 1AE7'              	JNZ	EE_ARG
  1AE3'   CD 1B96'              	CALL	OWNTF		; no name: the buffer's own
  1AE6'   D8                    	RC
  1AE7'                         EE_ARG:
  1AE7'   CD 1BAC'              	CALL	ISOWN
  1AEA'   21 0001               	LXI	H,1
  1AED'   C2 1AF4'              	JNZ	EE_LD		; another file: its first line
  1AF0'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1AF3'   23                    	INX	H		; HL = the cursor's line
  1AF4'                         EE_LD:
  1AF4'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1AF6'   32 250C'              	STA	MSGWHT
  1AF9'   E5                    	PUSH	H
  1AFA'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1AFD'   21 0000*              	LXI	H,TFCB
  1B00'   11 0000*              	LXI	D,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B03'   CD 1BBE'              	CALL	COPY12		; the buffer's name
  1B06'   CD 1B83'              	CALL	SRCTF
  1B09'   CD 0000*              	CALL	REOPEN
  1B0C'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1B0F'   AF                    	XRA	A
  1B10'   32 24B0'              	STA	MODF
  1B13'   E1                    	POP	H
  1B14'   2B                    	DCX	H
  1B15'   AF                    	XRA	A
  1B16'   CD 0000*              	CALL	MVLIND		; down to the line
  1B19'   CD 096E'              	CALL	ATEOF
  1B1C'   DC 0974'              	CC	LASTLN		; past the last line: onto it
  1B1F'   CD 0E82'              	CALL	ZSAVE
  1B22'   C3 0F65'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1B25'                         WRCHK:
  1B25'   3A 24FC'              	LDA	EXARG
  1B28'   B7                    	ORA	A
  1B29'   C2 1B33'              	JNZ	WC_ARG
  1B2C'   CD 1B96'              	CALL	OWNTF
  1B2F'   D8                    	RC
  1B30'   C3 1B48'              	JMP	WC_OWN
  1B33'                         WC_ARG:
  1B33'   CD 1BAC'              	CALL	ISOWN
  1B36'   CA 1B48'              	JZ	WC_OWN
  1B39'   3A 250E'              	LDA	EXBANG
  1B3C'   B7                    	ORA	A
  1B3D'   CA 1B46'              	JZ	WC_OTH
  1B40'   CD 0000*              	CALL	TEXIST
  1B43'   C2 1D6D'              	JNZ	MSGEXI		; File exists (! to force)
  1B46'                         WC_OTH:
  1B46'   AF                    	XRA	A		; (NC)
  1B47'   C9                    	RET
  1B48'                         WC_OWN:
  1B48'   3A 250F'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1B4B'   B7                    	ORA	A
  1B4C'   CA 1B56'              	JZ	WC_OK
  1B4F'   3A 250E'              	LDA	EXBANG
  1B52'   B7                    	ORA	A
  1B53'   C2 1D73'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1B56'                         WC_OK:
  1B56'   3E 01                 	MVI	A,1
  1B58'   B7                    	ORA	A		; (NC)
  1B59'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1B5A'                         WRITE:
  1B5A'   3A 24FD'              	LDA	EXBAK
  1B5D'   CD 0000*              	CALL	WRTO
  1B60'   3A 0001*              	LDA	FNAME+1
  1B63'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B65'   C2 1B71'              	JNZ	WR_HAS
  1B68'   21 0000*              	LXI	H,TFCB
  1B6B'   11 0000*              	LXI	D,FNAME
  1B6E'   CD 1BBE'              	CALL	COPY12
  1B71'                         WR_HAS:
  1B71'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1B73'   32 250C'              	STA	MSGWHT
  1B76'   CD 1BAC'              	CALL	ISOWN
  1B79'   C2 1B83'              	JNZ	SRCTF
  1B7C'   AF                    	XRA	A
  1B7D'   32 24B0'              	STA	MODF
  1B80'   32 250D'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1B83'                         SRCTF:
  1B83'   21 0000*              	LXI	H,TFCB
  1B86'   11 005C               	LXI	D,DFTFCB
  1B89'   CD 1BBE'              	CALL	COPY12
  1B8C'   AF                    	XRA	A
  1B8D'   06 04                 	MVI	B,4
  1B8F'                         SRC_Z:
  1B8F'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1B90'   13                    	INX	D
  1B91'   05                    	DCR	B
  1B92'   C2 1B8F'              	JNZ	SRC_Z
  1B95'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1B96'                         OWNTF:
  1B96'   3A 0001*              	LDA	FNAME+1
  1B99'   FE 20                 	CPI	' '
  1B9B'   CA 1D67'              	JZ	MSGNFN
  1B9E'   CD 1BC9'              	CALL	TFCLR
  1BA1'   21 0000*              	LXI	H,FNAME
  1BA4'   11 0000*              	LXI	D,TFCB
  1BA7'   CD 1BBE'              	CALL	COPY12
  1BAA'   B7                    	ORA	A		; (NC)
  1BAB'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1BAC'                         ISOWN:
  1BAC'   21 0000*              	LXI	H,TFCB
  1BAF'   11 0000*              	LXI	D,FNAME
  1BB2'   06 0C                 	MVI	B,12
  1BB4'                         IO_LP:
  1BB4'   1A                    	LDAX	D
  1BB5'   BE                    	CMP	M
  1BB6'   C0                    	RNZ
  1BB7'   23                    	INX	H
  1BB8'   13                    	INX	D
  1BB9'   05                    	DCR	B
  1BBA'   C2 1BB4'              	JNZ	IO_LP
  1BBD'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1BBE'                         COPY12:
  1BBE'   06 0C                 	MVI	B,12
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC0'                         CP_LP:
  1BC0'   7E                    	MOV	A,M
  1BC1'   12                    	STAX	D
  1BC2'   23                    	INX	H
  1BC3'   13                    	INX	D
  1BC4'   05                    	DCR	B
  1BC5'   C2 1BC0'              	JNZ	CP_LP
  1BC8'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1BC9'                         TFCLR:
  1BC9'   11 0000*              	LXI	D,TFCB
  1BCC'   06 24                 	MVI	B,36
  1BCE'   AF                    	XRA	A
  1BCF'                         TC_LP:
  1BCF'   12                    	STAX	D
  1BD0'   13                    	INX	D
  1BD1'   05                    	DCR	B
  1BD2'   C2 1BCF'              	JNZ	TC_LP
  1BD5'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1BD6'                         FOPEN:
  1BD6'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1BD8'   32 250C'              	STA	MSGWHT
  1BDB'   21 005C               	LXI	H,DFTFCB
  1BDE'   CD 1CB0'              	CALL	NRMDRV
  1BE1'   11 0000*              	LXI	D,FNAME
  1BE4'   CD 1BBE'              	CALL	COPY12
  1BE7'   CD 0000*              	CALL	OPENZ
  1BEA'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1BED'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1BEF'   C8                    	RZ
  1BF0'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1BF3'   32 250D'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1BF6'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1BF7'                         ARGSCN:
  1BF7'   3A 0080               	LDA	CMDTAIL
  1BFA'   47                    	MOV	B,A		; B = what is left of the line
  1BFB'   B7                    	ORA	A
  1BFC'   C8                    	RZ
  1BFD'   21 0081               	LXI	H,CMDTAIL+1
  1C00'                         AS_TOK:				; at a token, or the blanks before one
  1C00'   7E                    	MOV	A,M
  1C01'   FE 20                 	CPI	' '
  1C03'   C2 1C0C'              	JNZ	AS_OPT
  1C06'   23                    	INX	H
  1C07'   05                    	DCR	B
  1C08'   C2 1C00'              	JNZ	AS_TOK
  1C0B'   C9                    	RET
  1C0C'                         AS_OPT:
  1C0C'   FE 2B                 	CPI	'+'
  1C0E'   CA 1C38'              	JZ	AS_PLS
  1C11'   FE 2D                 	CPI	'-'
  1C13'   CA 1C27'              	JZ	AS_SW
  1C16'   FE 2F                 	CPI	'/'
  1C18'   CA 1C27'              	JZ	AS_SW
  1C1B'                         AS_SKP:				; not ours (the file name): on to the next one
  1C1B'   23                    	INX	H
  1C1C'   05                    	DCR	B
  1C1D'   C8                    	RZ
  1C1E'   7E                    	MOV	A,M
  1C1F'   FE 20                 	CPI	' '
  1C21'   C2 1C1B'              	JNZ	AS_SKP
  1C24'   C3 1C00'              	JMP	AS_TOK
  1C27'                         AS_SW:
  1C27'   23                    	INX	H
  1C28'   05                    	DCR	B
  1C29'   C8                    	RZ
  1C2A'   7E                    	MOV	A,M
  1C2B'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1C2D'   FE 52                 	CPI	'R'
  1C2F'   C2 1C1B'              	JNZ	AS_SKP
  1C32'   32 250F'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1C35'   C3 1C1B'              	JMP	AS_SKP
  1C38'                         AS_PLS:
  1C38'   3E 01                 	MVI	A,1
  1C3A'   32 2510'              	STA	PLUSF		; '+' gets the line even with no number on it
  1C3D'   11 0000*              	LXI	D,PLUSB
  1C40'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1C42'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1C43'   05                    	DCR	B
  1C44'   CA 1C7B'              	JZ	AS_PE
  1C47'   7E                    	MOV	A,M
  1C48'   FE 30                 	CPI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C4A'   C2 1C62'              	JNZ	AS_PD
  1C4D'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1C4D'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1C4E'   05                    	DCR	B
  1C4F'   CA 1C83'              	JZ	AS_P1
  1C52'   7E                    	MOV	A,M
  1C53'   FE 30                 	CPI	'0'
  1C55'   CA 1C4D'              	JZ	AS_PZ
  1C58'   FE 31                 	CPI	'1'
  1C5A'   DA 1C83'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1C5D'   FE 3A                 	CPI	'9'+1
  1C5F'   D2 1C83'              	JNC	AS_P1
  1C62'                         AS_PD:				; the digits, as typed
  1C62'   7E                    	MOV	A,M
  1C63'   FE 30                 	CPI	'0'
  1C65'   DA 1C7B'              	JC	AS_PE
  1C68'   FE 3A                 	CPI	'9'+1
  1C6A'   D2 1C7B'              	JNC	AS_PE
  1C6D'   79                    	MOV	A,C
  1C6E'   B7                    	ORA	A
  1C6F'   CA 1C8A'              	JZ	AS_POV
  1C72'   0D                    	DCR	C
  1C73'   7E                    	MOV	A,M
  1C74'   12                    	STAX	D
  1C75'   13                    	INX	D
  1C76'   23                    	INX	H
  1C77'   05                    	DCR	B
  1C78'   C2 1C62'              	JNZ	AS_PD
  1C7B'                         AS_PE:
  1C7B'   AF                    	XRA	A
  1C7C'   12                    	STAX	D		; the digits end with a 0
  1C7D'   78                    	MOV	A,B
  1C7E'   B7                    	ORA	A
  1C7F'   C8                    	RZ
  1C80'   C3 1C00'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1C83'                         AS_P1:
  1C83'   3E 31                 	MVI	A,'1'
  1C85'   12                    	STAX	D
  1C86'   13                    	INX	D
  1C87'   C3 1C7B'              	JMP	AS_PE
  1C8A'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1C8A'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1C8D'   C3 1C7B'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1C90'                         ARGGO:
  1C90'   3A 2510'              	LDA	PLUSF
  1C93'   B7                    	ORA	A
  1C94'   C8                    	RZ
  1C95'   21 0000*              	LXI	H,PLUSB
  1C98'                         AG_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C98'   7E                    	MOV	A,M
  1C99'   B7                    	ORA	A
  1C9A'   CA 1CA9'              	JZ	AG_G
  1C9D'   4F                    	MOV	C,A
  1C9E'   06 02                 	MVI	B,KT_CHAR
  1CA0'   E5                    	PUSH	H
  1CA1'   CD 001F'              	CALL	VICMD
  1CA4'   E1                    	POP	H
  1CA5'   23                    	INX	H
  1CA6'   C3 1C98'              	JMP	AG_LP
  1CA9'                         AG_G:
  1CA9'   0E 47                 	MVI	C,'G'
  1CAB'   06 02                 	MVI	B,KT_CHAR
  1CAD'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1CB0'                         NRMDRV:
  1CB0'   7E                    	MOV	A,M
  1CB1'   B7                    	ORA	A
  1CB2'   C0                    	RNZ
  1CB3'   E5                    	PUSH	H
  1CB4'   0E 19                 	MVI	C,BF_CURDSK
  1CB6'   CD 0005               	CALL	BDOS
  1CB9'   E1                    	POP	H
  1CBA'   3C                    	INR	A
  1CBB'   77                    	MOV	M,A
  1CBC'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1CBD'                         PARSFN:
  1CBD'   CD 1BC9'              	CALL	TFCLR
  1CC0'   11 0000*              	LXI	D,TFCB
  1CC3'   23                    	INX	H
  1CC4'   7E                    	MOV	A,M
  1CC5'   2B                    	DCX	H
  1CC6'   FE 3A                 	CPI	':'
  1CC8'   C2 1CDA'              	JNZ	PF_NM
  1CCB'   CD 1D20'              	CALL	GETFNC
  1CCE'   CA 1CDA'              	JZ	PF_NM
  1CD1'   D6 40                 	SUI	40H
  1CD3'   12                    	STAX	D
  1CD4'   FE 11                 	CPI	17
  1CD6'   D2 1CFE'              	JNC	PF_BAD
  1CD9'   23                    	INX	H
  1CDA'                         PF_NM:
  1CDA'   13                    	INX	D
  1CDB'   0E 08                 	MVI	C,8
  1CDD'   CD 1D02'              	CALL	CPYNAM
  1CE0'   FE 2E                 	CPI	'.'
  1CE2'   0E 03                 	MVI	C,3
  1CE4'   C4 1D15'              	CNZ	PADFLD		; no type: blanks
  1CE7'   CC 1D01'              	CZ	CPYNM0		; '.': the type
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CEA'   3A 0001*              	LDA	TFCB+1
  1CED'   FE 20                 	CPI	' '
  1CEF'   CA 1CFE'              	JZ	PF_BAD		; no name
  1CF2'   CD 1D53'              	CALL	SKIPB
  1CF5'   C0                    	RNZ			; more after it
  1CF6'   21 0000*              	LXI	H,TFCB
  1CF9'   CD 1CB0'              	CALL	NRMDRV
  1CFC'   AF                    	XRA	A
  1CFD'   C9                    	RET
  1CFE'                         PF_BAD:
  1CFE'   F6 01                 	ORI	1
  1D00'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1D01'                         CPYNM0:
  1D01'   23                    	INX	H
  1D02'                         CPYNAM:
  1D02'   CD 1D20'              	CALL	GETFNC
  1D05'   CA 1D15'              	JZ	PADFLD
  1D08'   12                    	STAX	D
  1D09'   13                    	INX	D
  1D0A'   0D                    	DCR	C
  1D0B'   C2 1D02'              	JNZ	CPYNAM
  1D0E'                         CN_SKP:
  1D0E'   CD 1D20'              	CALL	GETFNC
  1D11'   C2 1D0E'              	JNZ	CN_SKP
  1D14'   C9                    	RET
  1D15'                         PADFLD:
  1D15'   F5                    	PUSH	PSW
  1D16'                         PD_LP:
  1D16'   3E 20                 	MVI	A,' '
  1D18'   12                    	STAX	D
  1D19'   13                    	INX	D
  1D1A'   0D                    	DCR	C
  1D1B'   C2 1D16'              	JNZ	PD_LP
  1D1E'   F1                    	POP	PSW
  1D1F'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1D20'                         GETFNC:
  1D20'   7E                    	MOV	A,M
  1D21'   FE 3D                 	CPI	'='
  1D23'   C8                    	RZ
  1D24'   FE 5F                 	CPI	'_'
  1D26'   C8                    	RZ
  1D27'   FE 3B                 	CPI	';'
  1D29'   C8                    	RZ
  1D2A'   FE 3C                 	CPI	'<'
  1D2C'   C8                    	RZ
  1D2D'   FE 3E                 	CPI	'>'
  1D2F'   C8                    	RZ
  1D30'   FE 2E                 	CPI	'.'
  1D32'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D33'   FE 3A                 	CPI	':'
  1D35'   C8                    	RZ
  1D36'   FE 2A                 	CPI	'*'
  1D38'   C8                    	RZ
  1D39'   FE 3F                 	CPI	'?'
  1D3B'   C8                    	RZ
  1D3C'   FE 20                 	CPI	' '
  1D3E'   DA 1D51'              	JC	GF_CTL
  1D41'   C8                    	RZ
  1D42'   23                    	INX	H
  1D43'   FE 61                 	CPI	'a'
  1D45'   DA 1D4F'              	JC	GF_DN
  1D48'   FE 7B                 	CPI	'z'+1
  1D4A'   D2 1D4F'              	JNC	GF_DN
  1D4D'   E6 DF                 	ANI	0DFH
  1D4F'                         GF_DN:
  1D4F'   B7                    	ORA	A
  1D50'   C9                    	RET
  1D51'                         GF_CTL:
  1D51'   BF                    	CMP	A
  1D52'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1D53'                         SKIPB:
  1D53'   7E                    	MOV	A,M
  1D54'   FE 20                 	CPI	' '
  1D56'   C2 1D5D'              	JNZ	SB_DN
  1D59'   23                    	INX	H
  1D5A'   C3 1D53'              	JMP	SKIPB
  1D5D'                         SB_DN:
  1D5D'   B7                    	ORA	A
  1D5E'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1D5F'                         ISLOW:
  1D5F'   7E                    	MOV	A,M
  1D60'   FE 61                 	CPI	'a'
  1D62'   D8                    	RC
  1D63'   FE 7B                 	CPI	'z'+1
  1D65'   3F                    	CMC
  1D66'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1D67'                         MSGNFN:
  1D67'   21 1DB4'              	LXI	H,SNFN
  1D6A'   C3 1D9F'              	JMP	EXERR
  1D6D'                         MSGEXI:
  1D6D'   21 1DCE'              	LXI	H,SEXI
  1D70'   C3 1D7C'              	JMP	EXBNG
  1D73'                         MSGRO:
  1D73'   21 1DDA'              	LXI	H,SRO
  1D76'   C3 1D7C'              	JMP	EXBNG
  1D79'                         MSGNWR:
  1D79'   21 1DC1'              	LXI	H,SNWR
  1D7C'                         EXBNG:
  1D7C'   CD 1D9F'              	CALL	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D7F'   21 1DE6'              	LXI	H,SBNG
  1D82'   C3 1D9A'              	JMP	EXOUT
  1D85'                         EX_INV:
  1D85'   21 1DF4'              	LXI	H,SINV
  1D88'   C3 1D9F'              	JMP	EXERR
  1D8B'                         EX_V:				; :ve -- the version, on the bottom row
  1D8B'   21 1DAF'              	LXI	H,SVER
  1D8E'   C3 1D9F'              	JMP	EXERR
  1D91'                         EX_TRL:
  1D91'   21 1E06'              	LXI	H,STRL
  1D94'                         EXERT:				; the message, then the text at EXCMD
  1D94'   CD 1D9F'              	CALL	EXERR
  1D97'   2A 24FE'              	LHLD	EXCMD
  1D9A'                         EXOUT:
  1D9A'   CD 0000*              	CALL	OUTSTR
  1D9D'   37                    	STC
  1D9E'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1D9F'                         EXERR:
  1D9F'   E5                    	PUSH	H
  1DA0'   AF                    	XRA	A		; an error outranks whatever this key meant to
  1DA1'   32 250C'              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  1DA4'   E1                    	POP	H
  1DA5'   CD 0000*              	CALL	EXMSG
  1DA8'   3E 01                 	MVI	A,R_MOVE
  1DAA'   32 24B1'              	STA	RINTENT
  1DAD'   37                    	STC
  1DAE'   C9                    	RET
                                
