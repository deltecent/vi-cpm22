  0BEB'   22 26D1'              	SHLD	WKN
  0BEE'   2A 26CF'              	LHLD	WKI
  0BF1'   23                    	INX	H
  0BF2'   22 26CF'              	SHLD	WKI
  0BF5'                         ES_WS:
  0BF5'   2A 26CF'              	LHLD	WKI
  0BF8'   EB                    	XCHG
  0BF9'   2A 26D1'              	LHLD	WKN
  0BFC'   CD 0000*              	CALL	CMP16
