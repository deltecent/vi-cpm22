  262E'   CD 2640'              	CALL	GETFNC
  2631'   C2 262E'              	JNZ	CN_SKP
  2634'   C9                    	RET
  2635'                         PADFLD:
  2635'   F5                    	PUSH	PSW
  2636'                         PD_LP:
  2636'   3E 20                 	MVI	A,' '
  2638'   12                    	STAX	D
  2639'   13                    	INX	D
  263A'   0D                    	DCR	C
  263B'   C2 2636'              	JNZ	PD_LP
  263E'   F1                    	POP	PSW
  263F'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2640'                         GETFNC:
  2640'   7E                    	MOV	A,M
  2641'   FE 3D                 	CPI	'='
  2643'   C8                    	RZ
  2644'   FE 5F                 	CPI	'_'
  2646'   C8                    	RZ
  2647'   FE 3B                 	CPI	';'
  2649'   C8                    	RZ
  264A'   FE 3C                 	CPI	'<'
  264C'   C8                    	RZ
  264D'   FE 3E                 	CPI	'>'
  264F'   C8                    	RZ
  2650'   FE 2E                 	CPI	'.'
  2652'   C8                    	RZ
  2653'   FE 3A                 	CPI	':'
  2655'   C8                    	RZ
  2656'   FE 2A                 	CPI	'*'
  2658'   C8                    	RZ
  2659'   FE 3F                 	CPI	'?'
  265B'   C8                    	RZ
  265C'   FE 20                 	CPI	' '
  265E'   DA 2671'              	JC	GF_CTL
  2661'   C8                    	RZ
  2662'   23                    	INX	H
