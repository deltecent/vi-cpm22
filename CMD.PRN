                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  1EE7'                         EXTAB:
  1EE7'   77 00 01              	DB	'w',0,EO_W
  1EEA'   71 00 02              	DB	'q',0,EO_Q
  1EED'   77 71 03              	DB	'w','q',EO_WQ
  1EF0'   78 00 04              	DB	'x',0,EO_X
  1EF3'   65 00 05              	DB	'e',0,EO_E
  1EF6'   73 00 06              	DB	's',0,EO_S
  1EF9'   76 65 07              	DB	'v','e',EO_V
  1EFC'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1EFD'                         EXADDR:
  1EFD'   AF                    	XRA	A
  1EFE'   32 2552'              	STA	SRNGF
  1F01'   7E                    	MOV	A,M
  1F02'   FE 25                 	CPI	'%'
  1F04'   CA 1F2D'              	JZ	EXA_AL
  1F07'   EB                    	XCHG			; DE walks the line, HL takes the number
  1F08'   CD 1F42'              	CALL	EXNUM
  1F0B'   DA 1F2B'              	JC	EXA_NO
  1F0E'   22 2553'              	SHLD	SRNG1
  1F11'   22 2555'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1F14'   1A                    	LDAX	D
  1F15'   FE 2C                 	CPI	','
  1F17'   C2 1F24'              	JNZ	EXA_YS
  1F1A'   13                    	INX	D
  1F1B'   CD 1F42'              	CALL	EXNUM
  1F1E'   DA 1F2B'              	JC	EXA_NO		; ',' with no number: not a range at all
  1F21'   22 2555'              	SHLD	SRNG2
  1F24'                         EXA_YS:
  1F24'   EB                    	XCHG
  1F25'   3E 01                 	MVI	A,1
  1F27'   32 2552'              	STA	SRNGF
  1F2A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F2B'                         EXA_NO:
  1F2B'   EB                    	XCHG
  1F2C'   C9                    	RET
  1F2D'                         EXA_AL:
  1F2D'   23                    	INX	H
  1F2E'   E5                    	PUSH	H
  1F2F'   21 0001               	LXI	H,1
  1F32'   22 2553'              	SHLD	SRNG1
  1F35'   21 FFFF               	LXI	H,0FFFFH
  1F38'   22 2555'              	SHLD	SRNG2
  1F3B'   E1                    	POP	H
  1F3C'   3E 01                 	MVI	A,1
  1F3E'   32 2552'              	STA	SRNGF
  1F41'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1F42'                         EXNUM:
  1F42'   1A                    	LDAX	D
  1F43'   D6 30                 	SUI	'0'
  1F45'   D8                    	RC
  1F46'   FE 0A                 	CPI	10
  1F48'   3F                    	CMC
  1F49'   D8                    	RC
  1F4A'   21 0000               	LXI	H,0
  1F4D'                         EXN_LP:
  1F4D'   1A                    	LDAX	D
  1F4E'   D6 30                 	SUI	'0'
  1F50'   DA 1F6A'              	JC	EXN_DN
  1F53'   FE 0A                 	CPI	10
  1F55'   D2 1F6A'              	JNC	EXN_DN
  1F58'   13                    	INX	D
  1F59'   C5                    	PUSH	B
  1F5A'   4F                    	MOV	C,A
  1F5B'   06 00                 	MVI	B,0		; BC = the digit
  1F5D'   D5                    	PUSH	D
  1F5E'   54                    	MOV	D,H
  1F5F'   5D                    	MOV	E,L
  1F60'   29                    	DAD	H		; *2
  1F61'   29                    	DAD	H		; *4
  1F62'   19                    	DAD	D		; *5
  1F63'   29                    	DAD	H		; *10
  1F64'   D1                    	POP	D
  1F65'   09                    	DAD	B
  1F66'   C1                    	POP	B
  1F67'   C3 1F4D'              	JMP	EXN_LP
  1F6A'                         EXN_DN:
  1F6A'   B7                    	ORA	A		; CY clear: there was a number
  1F6B'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1F6C'                         EX_S:
  1F6C'   7E                    	MOV	A,M
  1F6D'   B7                    	ORA	A
  1F6E'   CA 1FB0'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1F71'   32 2557'              	STA	SDELIM
  1F74'   23                    	INX	H
  1F75'   11 0000*              	LXI	D,SRCHST
  1F78'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1F7B'   4F                    	MOV	C,A
  1F7C'   CD 1FB6'              	CALL	SCOPY
  1F7F'   78                    	MOV	A,B
  1F80'   B7                    	ORA	A
  1F81'   CA 1FB0'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1F84'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1F87'   3E 01                 	MVI	A,1
  1F89'   32 2523'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1F8C'   11 2564'              	LXI	D,SREPL
  1F8F'   0E 24                 	MVI	C,SREPMX
  1F91'   CD 1FB6'              	CALL	SCOPY
  1F94'   78                    	MOV	A,B
  1F95'   32 2563'              	STA	SREPLN
  1F98'   AF                    	XRA	A
  1F99'   32 2558'              	STA	SGFLAG
  1F9C'   7E                    	MOV	A,M
  1F9D'   FE 67                 	CPI	'g'
  1F9F'   C2 1FA8'              	JNZ	EX_SG
  1FA2'   23                    	INX	H
  1FA3'   3E 01                 	MVI	A,1
  1FA5'   32 2558'              	STA	SGFLAG
  1FA8'                         EX_SG:
  1FA8'   7E                    	MOV	A,M
  1FA9'   B7                    	ORA	A
  1FAA'   C2 1D91'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1FAD'   C3 1FD6'              	JMP	SUBGO
  1FB0'                         SUBNOP:
  1FB0'   21 1E3D'              	LXI	H,SNOPAT
  1FB3'   C3 1D9F'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1FB6'                         SCOPY:
  1FB6'   06 00                 	MVI	B,0
  1FB8'                         SCP_LP:
  1FB8'   78                    	MOV	A,B
  1FB9'   B9                    	CMP	C
  1FBA'   D2 1FD3'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1FBD'   7E                    	MOV	A,M
  1FBE'   B7                    	ORA	A
  1FBF'   CA 1FD3'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1FC2'   E5                    	PUSH	H
  1FC3'   21 2557'              	LXI	H,SDELIM
  1FC6'   BE                    	CMP	M
  1FC7'   E1                    	POP	H
  1FC8'   CA 1FD2'              	JZ	SCP_SK
  1FCB'   12                    	STAX	D
  1FCC'   13                    	INX	D
  1FCD'   23                    	INX	H
  1FCE'   04                    	INR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1FCF'   C3 1FB8'              	JMP	SCP_LP
  1FD2'                         SCP_SK:
  1FD2'   23                    	INX	H
  1FD3'                         SCP_DN:
  1FD3'   AF                    	XRA	A
  1FD4'   12                    	STAX	D
  1FD5'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1FD6'                         SUBGO:
  1FD6'   CD 0EA8'              	CALL	GZONE
  1FD9'   2A 0000*              	LHLD	LNDLT
  1FDC'   22 2561'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1FDF'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1FE2'   22 255F'              	SHLD	SOFFS		;   search's SN_BAD does
  1FE5'   AF                    	XRA	A
  1FE6'   32 2559'              	STA	SANY
  1FE9'   21 0000               	LXI	H,0
  1FEC'   22 255B'              	SHLD	SBACK
  1FEF'   3A 2552'              	LDA	SRNGF
  1FF2'   B7                    	ORA	A
  1FF3'   CA 201C'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1FF6'   2A 2553'              	LHLD	SRNG1
  1FF9'   7C                    	MOV	A,H
  1FFA'   B5                    	ORA	L
  1FFB'   CA 2098'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1FFE'   2A 2555'              	LHLD	SRNG2
  2001'   EB                    	XCHG
  2002'   2A 2553'              	LHLD	SRNG1
  2005'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2008'   DA 2098'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  200B'   EB                    	XCHG			; HL = the last line, DE = the first
  200C'   CD 0000*              	CALL	SUBHD
  200F'   23                    	INX	H		; HL = the lines in the range
  2010'   22 255D'              	SHLD	SLINES
  2013'   2A 2553'              	LHLD	SRNG1
  2016'   CD 0E29'              	CALL	GOLN
  2019'   C3 2022'              	JMP	SUBLP
  201C'                         SUB_1L:
  201C'   21 0001               	LXI	H,1
  201F'   22 255D'              	SHLD	SLINES
  2022'                         SUBLP:
  2022'   CD 209E'              	CALL	SUBLIN		; A = 1 when this line changed
  2025'   B7                    	ORA	A
  2026'   CA 2034'              	JZ	SUB_NX
  2029'   3E 01                 	MVI	A,1
  202B'   32 2559'              	STA	SANY
  202E'   21 0000               	LXI	H,0
  2031'   22 255B'              	SHLD	SBACK		; the cursor is ON the last line changed
  2034'                         SUB_NX:
  2034'   2A 255D'              	LHLD	SLINES
  2037'   2B                    	DCX	H
  2038'   22 255D'              	SHLD	SLINES
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  203B'   7C                    	MOV	A,H
  203C'   B5                    	ORA	L
  203D'   CA 205B'              	JZ	SUBDON		; the range is spent
  2040'   21 0001               	LXI	H,1
  2043'   AF                    	XRA	A
  2044'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2047'   3A 2559'              	LDA	SANY
  204A'   B7                    	ORA	A
  204B'   CA 2055'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  204E'   2A 255B'              	LHLD	SBACK
  2051'   23                    	INX	H
  2052'   22 255B'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2055'                         SUB_AE:
  2055'   CD 096E'              	CALL	ATEOF
  2058'   D2 2022'              	JNC	SUBLP		; ... unless that ran off the end of the file
  205B'                         SUBDON:
  205B'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  205E'   3A 2559'              	LDA	SANY
  2061'   B7                    	ORA	A
  2062'   CA 2080'              	JZ	SUBNFD
  2065'   3E 01                 	MVI	A,1
  2067'   32 24B0'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  206A'   2A 255B'              	LHLD	SBACK
  206D'   7C                    	MOV	A,H
  206E'   B5                    	ORA	L
  206F'   CA 207A'              	JZ	SUB_PL
  2072'   3E FF                 	MVI	A,0FFH
  2074'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2077'   CD 0000*              	CALL	CLRCNT
  207A'                         SUB_PL:
  207A'   CD 0EC0'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  207D'   C3 06E5'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2080'                         SUBNFD:
  2080'   2A 255F'              	LHLD	SOFFS
  2083'   CD 0000*              	CALL	GOTO
  2086'   2A 2561'              	LHLD	SLDLTS
  2089'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  208C'   21 1E29'              	LXI	H,SNOTFD
  208F'   CD 1D9F'              	CALL	EXERR
  2092'   21 0000*              	LXI	H,SRCHST
  2095'   C3 1D9A'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2098'                         SUBBAD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  2098'   21 1E17'              	LXI	H,SNOT
  209B'   C3 1D94'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  209E'                         SUBLIN:
  209E'   AF                    	XRA	A
  209F'   32 255A'              	STA	SLCHG
  20A2'   CD 211D'              	CALL	SUBBOL
  20A5'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  20A8'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  20A8'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  20AB'   DA 20B3'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  20AE'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  20B0'   C2 20A8'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  20B3'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  20B3'   CD 0000*              	CALL	CUROFF
  20B6'   E5                    	PUSH	H
  20B7'   CD 125B'              	CALL	CEND
  20BA'   D1                    	POP	D
  20BB'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  20BE'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  20BF'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  20C2'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  20C3'   B7                    	ORA	A		;   span is a line, not a pair.)
  20C4'   FA 2116'              	JM	SUBL_D		; what is left is shorter than the pattern
  20C7'   44                    	MOV	B,H
  20C8'   4D                    	MOV	C,L		; BC = the start positions a match can take
  20C9'   11 0000*              	LXI	D,SRCHST
  20CC'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  20CF'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  20D2'   DA 2116'              	JC	SUBL_D
  20D5'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  20D8'   EB                    	XCHG
  20D9'   2A 0000*              	LHLD	GAPEND
  20DC'   EB                    	XCHG
  20DD'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  20E0'   EB                    	XCHG
  20E1'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  20E2'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  20E5'   D1                    	POP	D
  20E6'   19                    	DAD	D		; ... and so the match's logical offset
  20E7'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  20EA'   3A 2559'              	LDA	SANY
  20ED'   B7                    	ORA	A
  20EE'   C2 20FB'              	JNZ	SUBL_C
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  20F1'   3A 255A'              	LDA	SLCHG
  20F4'   B7                    	ORA	A
  20F5'   C2 20FB'              	JNZ	SUBL_C
  20F8'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  20FB'                         SUBL_C:
  20FB'   3A 0000*              	LDA	SRCHBF
  20FE'   6F                    	MOV	L,A
  20FF'   26 00                 	MVI	H,0
  2101'   CD 0000*              	CALL	DELFWD		; the match goes
  2104'   11 2563'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2107'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  210A'                         SUBL_I:
  210A'   3E 01                 	MVI	A,1
  210C'   32 255A'              	STA	SLCHG
  210F'   3A 2558'              	LDA	SGFLAG
  2112'   B7                    	ORA	A
  2113'   C2 20B3'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2116'                         SUBL_D:
  2116'   CD 211D'              	CALL	SUBBOL
  2119'   3A 255A'              	LDA	SLCHG
  211C'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  211D'                         SUBBOL:
  211D'   CD 0000*              	CALL	CUROFF
  2120'   CD 05B0'              	CALL	BOL
  2123'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2126'                         VC_SRCH:
  2126'   CD 06C4'              	CALL	SETMOV
  2129'   C5                    	PUSH	B
  212A'   CD 0657'              	CALL	GETCNT
  212D'   22 254B'              	SHLD	SCNT
  2130'   C1                    	POP	B
  2131'   79                    	MOV	A,C
  2132'   FE 2F                 	CPI	'/'
  2134'   3E 00                 	MVI	A,0
  2136'   CA 213B'              	JZ	VS_DIR
  2139'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  213B'                         VS_DIR:
  213B'   32 2521'              	STA	SDIR
  213E'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2141'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2144'   47                    	MOV	B,A
  2145'   CD 18EF'              	CALL	RDLINE
  2148'   B7                    	ORA	A
  2149'   C0                    	RNZ			; cancelled: nothing happens at all
  214A'   3A 24F9'              	LDA	RLLEN
  214D'   B7                    	ORA	A
  214E'   CA 2163'              	JZ	VS_OLD		; an empty line repeats the last pattern --
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                				;   RDLINE stored nothing, so it is still there
  2151'   5F                    	MOV	E,A
  2152'   16 00                 	MVI	D,0
  2154'   21 0000*              	LXI	H,SRCHST
  2157'   19                    	DAD	D
  2158'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  215A'   7B                    	MOV	A,E
  215B'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  215E'   3E 01                 	MVI	A,1
  2160'   32 2523'              	STA	SHAVE
  2163'                         VS_OLD:
  2163'   3A 2523'              	LDA	SHAVE
  2166'   B7                    	ORA	A
  2167'   CA 2173'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  216A'   3A 2521'              	LDA	SDIR
  216D'   32 2522'              	STA	SDIRE
  2170'   C3 219C'              	JMP	SRCHN
  2173'                         VS_NOP:
  2173'   21 1E3D'              	LXI	H,SNOPAT
  2176'   C3 1D9F'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2179'                         VC_N:
  2179'   CD 06C4'              	CALL	SETMOV
  217C'   3A 2521'              	LDA	SDIR
  217F'   C3 2189'              	JMP	VN_GO
  2182'                         VCB_N:
  2182'   CD 06C4'              	CALL	SETMOV
  2185'   3A 2521'              	LDA	SDIR
  2188'   2F                    	CMA			; the other way: 0 <-> FFH
  2189'                         VN_GO:
  2189'   32 2522'              	STA	SDIRE
  218C'   CD 0657'              	CALL	GETCNT
  218F'   22 254B'              	SHLD	SCNT
  2192'   3A 2523'              	LDA	SHAVE
  2195'   B7                    	ORA	A
  2196'   CA 2173'              	JZ	VS_NOP
  2199'   C3 219C'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  219C'                         SRCHN:
  219C'   CD 0EA8'              	CALL	GZONE		; the screen's top line, before the cursor moves
  219F'   2A 0000*              	LHLD	LNDLT
  21A2'   22 254F'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  21A5'   CD 0000*              	CALL	CUROFF
  21A8'   22 254D'              	SHLD	SOFF
  21AB'                         SN_LP:
  21AB'   CD 21E3'              	CALL	SRCHGO
  21AE'   DA 21C8'              	JC	SN_BAD
  21B1'   2A 254B'              	LHLD	SCNT
  21B4'   2B                    	DCX	H
  21B5'   22 254B'              	SHLD	SCNT
  21B8'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21B9'   B5                    	ORA	L
  21BA'   C2 21AB'              	JNZ	SN_LP
  21BD'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  21C0'   3E 01                 	MVI	A,1
  21C2'   32 252E'              	STA	GPKEEP		; land on the match, not the first non-blank
  21C5'   C3 0EC0'              	JMP	GPLACE		; (which sets LNDLT itself)
  21C8'                         SN_BAD:
  21C8'   CD 0000*              	CALL	CLRCNT
  21CB'   2A 254D'              	LHLD	SOFF
  21CE'   CD 0000*              	CALL	GOTO
  21D1'   2A 254F'              	LHLD	SLDLT
  21D4'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  21D7'   21 1E29'              	LXI	H,SNOTFD
  21DA'   CD 1D9F'              	CALL	EXERR
  21DD'   21 0000*              	LXI	H,SRCHST
  21E0'   C3 1D9A'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  21E3'                         SRCHGO:
  21E3'   3E 01                 	MVI	A,1
  21E5'   32 2551'              	STA	SSKIP		; this pass starts one past the cursor
  21E8'   CD 21FA'              	CALL	SRCHW
  21EB'   D0                    	RNC
  21EC'   3A 2522'              	LDA	SDIRE
  21EF'   2F                    	CMA
  21F0'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  21F3'   AF                    	XRA	A
  21F4'   32 2551'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  21F7'   C3 21FA'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  21FA'                         SRCHW:
  21FA'   3A 2522'              	LDA	SDIRE
  21FD'   32 0000*              	STA	DIRFLG
  2200'   21 FFFF               	LXI	H,0FFFFH
  2203'   22 24AD'              	SHLD	CMDCNT
  2206'   AF                    	XRA	A
  2207'   32 0000*              	STA	AUXCNT
  220A'                         SW_LP:
  220A'   CD 2216'              	CALL	SRCH1
  220D'   D0                    	RNC
  220E'   CD 0000*              	CALL	SCRLST
  2211'   D2 220A'              	JNC	SW_LP
  2214'   37                    	STC
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2215'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2216'                         SRCH1:
  2216'   11 0000*              	LXI	D,SRCHST
  2219'   3A 0000*              	LDA	DIRFLG
  221C'   B7                    	ORA	A
  221D'   FA 2241'              	JM	SR1_BK
  2220'   21 0000*              	LXI	H,GAPEND
  2223'   CD 0000*              	CALL	FWDCNT
  2226'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2229'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  222A'   3A 2551'              	LDA	SSKIP
  222D'   B7                    	ORA	A
  222E'   CA 2237'              	JZ	SR1_FW
  2231'   78                    	MOV	A,B
  2232'   B1                    	ORA	C
  2233'   37                    	STC
  2234'   C8                    	RZ			; no room for a match even before the skip
  2235'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2236'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2237'                         SR1_FW:
  2237'   CD 0000*              	CALL	MATCHF
  223A'   D8                    	RC
  223B'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  223E'   C3 0000*              	JMP	PUTCUR
  2241'                         SR1_BK:
  2241'   21 0000*              	LXI	H,TXTBEG
  2244'   CD 0000*              	CALL	FWDCNT
  2247'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  224A'   D8                    	RC
  224B'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  224E'   CD 0000*              	CALL	MATCHB
  2251'   D8                    	RC
  2252'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2255'                         MSGNAM:
  2255'   E5                    	PUSH	H
  2256'   3E 22                 	MVI	A,'"'
  2258'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  225B'   E1                    	POP	H
  225C'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  225D'   23                    	INX	H
  225E'   7E                    	MOV	A,M
  225F'   FE 20                 	CPI	' '
  2261'   C2 226E'              	JNZ	MN_HAS
  2264'   21 1E99'              	LXI	H,SNONM
  2267'   CD 0000*              	CALL	OUTSTR
  226A'   E1                    	POP	H
  226B'   C3 22B8'              	JMP	MN_END
  226E'                         MN_HAS:
  226E'   0E 19                 	MVI	C,BF_CURDSK
  2270'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2273'   E1                    	POP	H
  2274'   E5                    	PUSH	H
  2275'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2276'   BE                    	CMP	M
  2277'   CA 2285'              	JZ	MN_NAM
  227A'   7E                    	MOV	A,M
  227B'   C6 40                 	ADI	'A'-1
  227D'   CD 0000*              	CALL	OUTCH
  2280'   3E 3A                 	MVI	A,':'
  2282'   CD 0000*              	CALL	OUTCH
  2285'                         MN_NAM:
  2285'   E1                    	POP	H
  2286'   E5                    	PUSH	H
  2287'   23                    	INX	H
  2288'   0E 08                 	MVI	C,8
  228A'                         MN_NM:
  228A'   7E                    	MOV	A,M
  228B'   FE 20                 	CPI	' '
  228D'   CA 2298'              	JZ	MN_EXT
  2290'   CD 0000*              	CALL	OUTCH
  2293'   23                    	INX	H
  2294'   0D                    	DCR	C
  2295'   C2 228A'              	JNZ	MN_NM
  2298'                         MN_EXT:
  2298'   E1                    	POP	H
  2299'   11 0009               	LXI	D,9
  229C'   19                    	DAD	D		; the type field
  229D'   7E                    	MOV	A,M
  229E'   FE 20                 	CPI	' '
  22A0'   CA 22B8'              	JZ	MN_END
  22A3'   3E 2E                 	MVI	A,'.'
  22A5'   CD 0000*              	CALL	OUTCH
  22A8'   0E 03                 	MVI	C,3
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22AA'                         MN_XL:
  22AA'   7E                    	MOV	A,M
  22AB'   FE 20                 	CPI	' '
  22AD'   CA 22B8'              	JZ	MN_END
  22B0'   CD 0000*              	CALL	OUTCH
  22B3'   23                    	INX	H
  22B4'   0D                    	DCR	C
  22B5'   C2 22AA'              	JNZ	MN_XL
  22B8'                         MN_END:
  22B8'   3E 22                 	MVI	A,'"'
  22BA'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  22BD'                         MSGFLG:
  22BD'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  22BF'   B7                    	ORA	A
  22C0'   CA 22D0'              	JZ	MF_RO
  22C3'   3A 24B0'              	LDA	MODF
  22C6'   B7                    	ORA	A
  22C7'   CA 22D0'              	JZ	MF_RO
  22CA'   21 1EA3'              	LXI	H,SMODM
  22CD'   CD 22E5'              	CALL	MF_PUT
  22D0'                         MF_RO:
  22D0'   3A 250F'              	LDA	ROFLAG
  22D3'   B7                    	ORA	A
  22D4'   CA 22DD'              	JZ	MF_NEW
  22D7'   21 1EAE'              	LXI	H,SROM
  22DA'   CD 22E5'              	CALL	MF_PUT
  22DD'                         MF_NEW:
  22DD'   3A 250D'              	LDA	MSGNEW
  22E0'   B7                    	ORA	A
  22E1'   C8                    	RZ
  22E2'   21 1EB9'              	LXI	H,SNEWM
  22E5'                         MF_PUT:
  22E5'   78                    	MOV	A,B
  22E6'   B7                    	ORA	A
  22E7'   C2 22F3'              	JNZ	MF_STR
  22EA'   06 01                 	MVI	B,1
  22EC'   E5                    	PUSH	H
  22ED'   3E 20                 	MVI	A,' '
  22EF'   CD 0000*              	CALL	OUTCH
  22F2'   E1                    	POP	H
  22F3'                         MF_STR:
  22F3'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  22F6'                         EMITW:
  22F6'   C5                    	PUSH	B
  22F7'   D5                    	PUSH	D
  22F8'   06 00                 	MVI	B,0
  22FA'   11 2710               	LXI	D,10000
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  22FD'   CD 231B'              	CALL	EWDIG
  2300'   11 03E8               	LXI	D,1000
  2303'   CD 231B'              	CALL	EWDIG
  2306'   11 0064               	LXI	D,100
  2309'   CD 231B'              	CALL	EWDIG
  230C'   11 000A               	LXI	D,10
  230F'   CD 231B'              	CALL	EWDIG
  2312'   7D                    	MOV	A,L		; the units digit is always printed
  2313'   C6 30                 	ADI	'0'
  2315'   CD 0000*              	CALL	OUTCH
  2318'   D1                    	POP	D
  2319'   C1                    	POP	B
  231A'   C9                    	RET
  231B'                         EWDIG:
  231B'   0E 00                 	MVI	C,0
  231D'                         EW_LP:
  231D'   7D                    	MOV	A,L
  231E'   93                    	SUB	E
  231F'   6F                    	MOV	L,A
  2320'   7C                    	MOV	A,H
  2321'   9A                    	SBB	D
  2322'   67                    	MOV	H,A
  2323'   DA 232A'              	JC	EW_DN
  2326'   0C                    	INR	C
  2327'   C3 231D'              	JMP	EW_LP
  232A'                         EW_DN:
  232A'   19                    	DAD	D		; one subtraction too many: give it back
  232B'   79                    	MOV	A,C
  232C'   B7                    	ORA	A
  232D'   C2 2333'              	JNZ	EW_PR
  2330'   78                    	MOV	A,B
  2331'   B7                    	ORA	A
  2332'   C8                    	RZ			; a leading zero: write nothing
  2333'                         EW_PR:
  2333'   79                    	MOV	A,C
  2334'   C6 30                 	ADI	'0'
  2336'   CD 0000*              	CALL	OUTCH
  2339'   06 01                 	MVI	B,1
  233B'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  233C'                         ISEMPT:
  233C'   2A 0000*              	LHLD	OUTPOS
  233F'   7C                    	MOV	A,H
  2340'   B5                    	ORA	L
  2341'   C0                    	RNZ
  2342'   CD 0000*              	CALL	LOGLEN
  2345'   7C                    	MOV	A,H
  2346'   B5                    	ORA	L
  2347'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2348'                         MSGCTG:
  2348'   21 0000*              	LXI	H,FNAME
  234B'   CD 2255'              	CALL	MSGNAM
  234E'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2350'   CD 22BD'              	CALL	MSGFLG
  2353'   CD 233C'              	CALL	ISEMPT
  2356'   C2 235F'              	JNZ	MG_POS
  2359'   21 1ECC'              	LXI	H,SNOLIN
  235C'   C3 0000*              	JMP	OUTSTR
  235F'                         MG_POS:
  235F'   21 1EBF'              	LXI	H,SLINE
  2362'   CD 0000*              	CALL	OUTSTR
  2365'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2368'   23                    	INX	H		;   ... so the line it is on
  2369'   CD 22F6'              	CALL	EMITW
  236C'   21 1EC6'              	LXI	H,SCOLM
  236F'   CD 0000*              	CALL	OUTSTR
  2372'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2375'   23                    	INX	H
  2376'   E5                    	PUSH	H
  2377'   CD 22F6'              	CALL	EMITW
  237A'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  237D'   23                    	INX	H
  237E'   D1                    	POP	D
  237F'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2382'   C8                    	RZ
  2383'   E5                    	PUSH	H
  2384'   3E 2D                 	MVI	A,'-'
  2386'   CD 0000*              	CALL	OUTCH
  2389'   E1                    	POP	H
  238A'   C3 22F6'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  238D'                         FILMSG:
  238D'   3A 0001*              	LDA	FNAME+1
  2390'   FE 20                 	CPI	' '
  2392'   C8                    	RZ
  2393'   21 0000*              	LXI	H,FNAME
  2396'   CD 2255'              	CALL	MSGNAM
  2399'   AF                    	XRA	A		; nothing has been changed yet
  239A'   C3 22BD'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  239D'                         WRMSG:
  239D'   21 0000*              	LXI	H,TFCB
  23A0'   CD 2255'              	CALL	MSGNAM
  23A3'   21 1EDE'              	LXI	H,SWRIT
  23A6'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  23A9'                         MSGPST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  23A9'   3A 250C'              	LDA	MSGWHT
  23AC'   B7                    	ORA	A
  23AD'   C8                    	RZ
  23AE'   47                    	MOV	B,A
  23AF'   AF                    	XRA	A
  23B0'   32 250C'              	STA	MSGWHT
  23B3'   78                    	MOV	A,B
  23B4'   FE 01                 	CPI	MW_FIL
  23B6'   CA 23C4'              	JZ	MP_FIL
  23B9'   FE 02                 	CPI	MW_WRT
  23BB'   CA 23CA'              	JZ	MP_WRT
  23BE'   CD 2348'              	CALL	MSGCTG
  23C1'   C3 0000*              	JMP	SCURS
  23C4'                         MP_FIL:
  23C4'   CD 238D'              	CALL	FILMSG
  23C7'   C3 0000*              	JMP	SCURS
  23CA'                         MP_WRT:
  23CA'   CD 239D'              	CALL	WRMSG
  23CD'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  23D0'                         VC_CTLG:
  23D0'   3E 03                 	MVI	A,MW_CTG
  23D2'   32 250C'              	STA	MSGWHT
  23D5'   3E 01                 	MVI	A,R_MOVE
  23D7'   32 24B1'              	STA	RINTENT
  23DA'   C9                    	RET
                                
