  070C'   EB                    	XCHG
  070D'   C1                    	POP	B
  070E'   C9                    	RET
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  070F'                         NLSTART:
  070F'   CD 06BB'              	CALL	EOLNL
  0712'   E5                    	PUSH	H
  0713'   CD 0000*              	CALL	LOGLEN
  0716'   D1                    	POP	D		; DE = eol result
  0717'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
  071A'   C8                    	RZ			; no next line: HL = LOGLEN
  071B'   EB                    	XCHG			; HL = eol
  071C'   23                    	INX	H
  071D'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  071E'                         EOLC:
  071E'   E5                    	PUSH	H
  071F'   CD 06BB'              	CALL	EOLNL
  0722'   22 0000*              	SHLD	WKTERM
  0725'   E1                    	POP	H
  0726'   CD 0678'              	CALL	BOL
  0729'   22 0000*              	SHLD	WKBOL
  072C'   2A 0000*              	LHLD	WKTERM
  072F'   EB                    	XCHG			; DE = term
  0730'   2A 0000*              	LHLD	WKBOL
  0733'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  0736'   CA 0755'              	JZ	EOLC_MT
  0739'   EB                    	XCHG			; HL = term
  073A'   2B                    	DCX	H		; term-1
  073B'   E5                    	PUSH	H
  073C'   CD 0000*              	CALL	CHARAT
  073F'   E1                    	POP	H		; HL = term-1
  0740'   FE 0D                 	CPI	CR
  0742'   CA 0748'              	JZ	EOLC_CR		; content ends at term-1
  0745'   C3 0749'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0748'                         EOLC_CR:
  0748'   2B                    	DCX	H		; last = (term-1) - 1
  0749'                         EOLC_LS:
  0749'   EB                    	XCHG			; DE = last
  074A'   2A 0000*              	LHLD	WKBOL
  074D'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0750'   DA 0755'              	JC	EOLC_MT
  0753'   EB                    	XCHG			; HL = last
  0754'   C9                    	RET
  0755'                         EOLC_MT:
  0755'   2A 0000*              	LHLD	WKBOL
  0758'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0759'                         ATENDQ:
  0759'   CD 0000*              	CALL	CUROFF
  075C'   E5                    	PUSH	H
  075D'   CD 0000*              	CALL	LOGLEN
  0760'   D1                    	POP	D		; DE = cur
  0761'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0764'                         CURCHR:
  0764'   CD 0000*              	CALL	CUROFF
  0767'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  076A'                         MOVCNT:
  076A'   CD 0852'              	CALL	SETMOV
  076D'   C3 077D'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0770'                         CNTOFF:
  0770'   CD 077D'              	CALL	GETCNT
  0773'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0776'                         GBSUB:
  0776'   EB                    	XCHG
  0777'   2A 0000*              	LHLD	GAPBEG
  077A'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  077D'                         GETCNT:
  077D'   2A 0000*              	LHLD	CMDCNT
  0780'   7C                    	MOV	A,H
  0781'   B5                    	ORA	L
  0782'   C2 0789'              	JNZ	GC_HAVE
  0785'   21 0001               	LXI	H,1
  0788'   C9                    	RET
  0789'                         GC_HAVE:
  0789'   E5                    	PUSH	H
  078A'   21 0000               	LXI	H,0
  078D'   22 0000*              	SHLD	CMDCNT
  0790'   E1                    	POP	H
  0791'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for an ESC break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  0792'                         CNTTST:				; WM 1175
  0792'   3A 0000*              	LDA	BRKARM
  0795'   B7                    	ORA	A
  0796'   C4 07C0'              	CNZ	BRKTST		; an ESC spends the count: every loop stops here
  0799'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  079A'   2A 0000*              	LHLD	CMDCNT
  079D'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  07A0'   B4                    	ORA	H
  07A1'   B5                    	ORA	L
  07A2'   E1                    	POP	H
  07A3'   C3 0000*              	JMP	POLLBRK
                                
                                ;============================================================
                                ; ESC -- abandon a search or a long move.
                                ;
                                ; Every loop that pages asks CNTTST whether to go on, so that is where an ESC is
                                ; looked for: it zeroes the count, and the loop ends the way it ends when the
                                ; count runs out.  Nothing is half done, because the commands that can be
                                ; stopped change nothing -- BRKON arms the test only with no operator pending,
                                ; and only 'G' 'gg' the mark jumps and the searches call it.  A 'dd' count, a
                                ; ':s', a put or a write asks the same CNTTST and is never stopped.
                                ;
                                ; The command then goes back to where it started (BRKBAK), as a search that
                                ; found nothing does: the screen was not repainted, so it is already right.
                                ; Going back pages, and that is not stopped by a second ESC.
                                ;============================================================
                                
                                ;BRKON -- a command that may page a long way is starting: keep the place it
                                ; started from (the cursor's position in the file, and LNDLT for its row), and
                                ; arm the ESC test unless an operator is waiting for this motion.
  07A6'                         BRKON:
  07A6'   21 0000*              	LXI	H,SOFF
  07A9'   CD 0429'              	CALL	FPSTO
  07AC'   2A 0000*              	LHLD	LNDLT
  07AF'   22 0000*              	SHLD	SLDLT
  07B2'   AF                    	XRA	A
  07B3'   32 0000*              	STA	BRKHIT
  07B6'   3A 0000*              	LDA	PSAVE
  07B9'   B7                    	ORA	A
  07BA'   C0                    	RNZ			; 'dG' changes text: it runs to its end
  07BB'   3C                    	INR	A
  07BC'   32 0000*              	STA	BRKARM
  07BF'   C9                    	RET
                                
                                ;BRKTST -- CNTTST's question while armed.  Keeps BC, DE, HL.  The ESC is
                                ; answered on the bottom row at once: the way back pages, and that can take
                                ; as long again as the command had run, with nothing else to show for it.
                                ; BRKBAK's 'Interrupted' replaces it when the cursor is back.
  07C0'                         BRKTST:
  07C0'   C5                    	PUSH	B
  07C1'   D5                    	PUSH	D
  07C2'   E5                    	PUSH	H
  07C3'   CD 0000*              	CALL	KBBRK
  07C6'   CA 07DF'              	JZ	BT_NO
  07C9'   32 0000*              	STA	BRKHIT		; (A = FFH)
  07CC'   21 2860'              	LXI	H,SINTG
  07CF'   CD 0000*              	CALL	EXMSG
  07D2'   AF                    	XRA	A
  07D3'   32 0000*              	STA	BRKARM		; the way back is not stopped in its turn
  07D6'   32 0000*              	STA	AUXCNT
  07D9'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  07DC'   22 0000*              	SHLD	CMDCNT
  07DF'                         BT_NO:
  07DF'   E1                    	POP	H
  07E0'   D1                    	POP	D
  07E1'   C1                    	POP	B
  07E2'   C9                    	RET
                                
                                ;BRKOFF -- the move is over: disarm.  NOTE: falls into BRKQ.
  07E3'                         BRKOFF:
  07E3'   AF                    	XRA	A
  07E4'   32 0000*              	STA	BRKARM
                                ;BRKQ -- CY iff an ESC stopped it.
  07E7'                         BRKQ:
  07E7'   3A 0000*              	LDA	BRKHIT
  07EA'   B7                    	ORA	A
  07EB'   C8                    	RZ
  07EC'   37                    	STC
  07ED'   C9                    	RET
                                
                                ;RSTPL -- back to the place BRKON kept, on the row it was on.
  07EE'                         RSTPL:
  07EE'   21 0000*              	LXI	H,SOFF
  07F1'   CD 03D0'              	CALL	BACKTO
  07F4'   2A 0000*              	LHLD	SLDLT
  07F7'   22 0000*              	SHLD	LNDLT
  07FA'   C9                    	RET
                                
                                ;BRKBAK -- stopped: back to the start, drop whatever was typed meanwhile (it
                                ; was meant for a result that is not coming), and say so.  CY, as EXERR.
  07FB'                         BRKBAK:
  07FB'   CD 07EE'              	CALL	RSTPL
  07FE'   CD 0000*              	CALL	KBFLSH
  0801'   21 2854'              	LXI	H,SINTR
  0804'   C3 27B6'              	JMP	EXERR
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  0807'                         CLASSF:
  0807'   47                    	MOV	B,A
  0808'   FE 20                 	CPI	' '
  080A'   CA 084A'              	JZ	CLS0
  080D'   FE 09                 	CPI	TAB
  080F'   CA 084A'              	JZ	CLS0
  0812'   FE 0A                 	CPI	LF
  0814'   CA 084A'              	JZ	CLS0
  0817'   FE 0D                 	CPI	CR
  0819'   CA 084A'              	JZ	CLS0
  081C'   3A 0000*              	LDA	WBIG
  081F'   B7                    	ORA	A
  0820'   C2 084C'              	JNZ	CLS1
  0823'   78                    	MOV	A,B
  0824'   FE 5F                 	CPI	'_'
  0826'   CA 084C'              	JZ	CLS1
  0829'   FE 30                 	CPI	'0'
  082B'   DA 084F'              	JC	CLS2
  082E'   FE 3A                 	CPI	'9'+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  0830'   DA 084C'              	JC	CLS1
  0833'   FE 41                 	CPI	'A'
  0835'   DA 084F'              	JC	CLS2
  0838'   FE 5B                 	CPI	'Z'+1
  083A'   DA 084C'              	JC	CLS1
  083D'   FE 61                 	CPI	'a'
  083F'   DA 084F'              	JC	CLS2
  0842'   FE 7B                 	CPI	'z'+1
  0844'   DA 084C'              	JC	CLS1
  0847'   C3 084F'              	JMP	CLS2
  084A'   AF                    CLS0:	XRA	A
  084B'   C9                    	RET
  084C'   3E 01                 CLS1:	MVI	A,1
  084E'   C9                    	RET
  084F'   3E 02                 CLS2:	MVI	A,2
  0851'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  0852'                         SETMOV:
  0852'   3E 01                 	MVI	A,R_MOVE
  0854'   32 0000*              	STA	RINTENT
  0857'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0858'                         SETLIN:
  0858'   3E 02                 	MVI	A,R_LINE
  085A'   32 0000*              	STA	RINTENT
  085D'   C9                    	RET
                                
                                ;SETCEL -- one cell of the cursor's row was written over and nothing else
                                ; changed: the char alone is the paint (R_ICH with no cell opened), provided
                                ; the char that was there (A) and the one that is (VRCH) are each one cell
                                ; wide.  B = ICHAPP's value: 1 the cursor went past the char, 2 it is on it.
  085E'                         SETCEL:
  085E'   CD 0873'              	CALL	PLAINQ
  0861'   D0                    	RNC
  0862'   3A 0000*              	LDA	VRCH
  0865'   CD 0873'              	CALL	PLAINQ
  0868'   D0                    	RNC
  0869'   78                    	MOV	A,B
  086A'   32 0000*              	STA	ICHAPP
  086D'   3E 04                 	MVI	A,R_ICH
  086F'   32 0000*              	STA	RINTENT
  0872'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


                                
                                ;PLAINQ -- CY iff the char in A takes one cell: printable ASCII.  Keeps all
                                ; but the flags.
  0873'                         PLAINQ:
  0873'   FE 20                 	CPI	' '
  0875'   3F                    	CMC
  0876'   D0                    	RNC
  0877'   FE 7F                 	CPI	DEL
  0879'   C9                    	RET
                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  087A'                         SETILN:
  087A'   3E 01                 	MVI	A,1
  087C'   32 2EF9'              	STA	ILN		; one line, unless a put overwrites it below
  087F'   3E 05                 	MVI	A,R_ILIN
  0881'   32 0000*              	STA	RINTENT
  0884'   AF                    	XRA	A
  0885'   32 0000*              	STA	ILABOV		; the row above the opened ones is untouched
  0888'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0889'                         SETJON:
  0889'   3E 06                 	MVI	A,R_JOIN
  088B'   32 0000*              	STA	RINTENT
  088E'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  088F'                         SETFUL:
  088F'   3E 00                 	MVI	A,R_FULL
  0891'   32 0000*              	STA	RINTENT
  0894'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB (or any control char) occurs from the cursor to the
                                ; end of its line, else 0; TTI = its offset when there is one.
                                ; The tail is read where it lies, after the gap.  Keeps BC.
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0895'                         TAILTAB:
  0895'   C5                    	PUSH	B
  0896'   CD 0000*              	CALL	CUROFF
  0899'   E5                    	PUSH	H
  089A'   2A 0000*              	LHLD	TXTEND
  089D'   44                    	MOV	B,H
  089E'   4D                    	MOV	C,L
  089F'   2A 0000*              	LHLD	GAPEND
  08A2'   D1                    	POP	D		; DE = the offset of the byte at HL
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  08A3'                         TT_LP:
  08A3'   7D                    	MOV	A,L
  08A4'   91                    	SUB	C
  08A5'   7C                    	MOV	A,H
  08A6'   98                    	SBB	B
  08A7'   D2 08C7'              	JNC	TT_NO		; reached end of text -> no tab
  08AA'   7E                    	MOV	A,M
  08AB'   FE 0A                 	CPI	LF
  08AD'   CA 08C7'              	JZ	TT_NO		; end of line -> no tab
  08B0'   FE 0D                 	CPI	CR
  08B2'   CA 08BA'              	JZ	TT_NX		; (the line end's own)
  08B5'   FE 20                 	CPI	' '
  08B7'   DA 08BF'              	JC	TT_YES
  08BA'                         TT_NX:
  08BA'   23                    	INX	H
  08BB'   13                    	INX	D
  08BC'   C3 08A3'              	JMP	TT_LP
  08BF'                         TT_YES:
  08BF'   EB                    	XCHG
  08C0'   22 0000*              	SHLD	TTI
  08C3'   C1                    	POP	B
  08C4'   3E 01                 	MVI	A,1
  08C6'   C9                    	RET
  08C7'                         TT_NO:
  08C7'   C1                    	POP	B
  08C8'   AF                    	XRA	A
  08C9'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  08CA'                         VC_H:
  08CA'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  08CD'   22 0000*              	SHLD	CNTV
  08D0'                         VCH_LP:
  08D0'   2A 0000*              	LHLD	CNTV
  08D3'   7C                    	MOV	A,H
  08D4'   B5                    	ORA	L
  08D5'   C8                    	RZ
  08D6'   2B                    	DCX	H
  08D7'   22 0000*              	SHLD	CNTV
  08DA'   CD 08E0'              	CALL	HSTEP
  08DD'   C3 08D0'              	JMP	VCH_LP
  08E0'                         HSTEP:
  08E0'   CD 0000*              	CALL	CUROFF		; HL = cur
  08E3'   7C                    	MOV	A,H
  08E4'   B5                    	ORA	L
  08E5'   C8                    	RZ			; at 0
  08E6'   E5                    	PUSH	H
  08E7'   CD 0678'              	CALL	BOL		; HL = bol
  08EA'   D1                    	POP	D		; DE = cur
  08EB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  08EE'   C8                    	RZ			; at BOL, cannot go left
  08EF'   EB                    	XCHG			; HL = cur
  08F0'   2B                    	DCX	H
  08F1'   C3 060E'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  08F4'                         VC_L:
  08F4'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  08F7'   22 0000*              	SHLD	CNTV
  08FA'                         VCL_LP:
  08FA'   2A 0000*              	LHLD	CNTV
  08FD'   7C                    	MOV	A,H
  08FE'   B5                    	ORA	L
  08FF'   C8                    	RZ
  0900'   2B                    	DCX	H
  0901'   22 0000*              	SHLD	CNTV
  0904'   CD 090A'              	CALL	LSTEP
  0907'   C3 08FA'              	JMP	VCL_LP
  090A'                         LSTEP:
  090A'   CD 0000*              	CALL	CUROFF		; HL = cur
  090D'   E5                    	PUSH	H
  090E'   CD 071E'              	CALL	EOLC		; HL = eolc
  0911'   D1                    	POP	D		; DE = cur
  0912'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  0915'   D2 091D'              	JNC	LS_NO		; cur >= eolc, cannot go right
  0918'   EB                    	XCHG			; HL = cur
  0919'   23                    	INX	H
  091A'   C3 060E'              	JMP	GOSET
  091D'                         LS_NO:				; on the line's last char.  An operator waiting on
  091D'   CD 0D83'              	CALL	EMPTY		;   this 'l' takes that char too (vim makes the
  0920'   C8                    	RZ			;   motion inclusive when it falls short), which
  0921'   3E 01                 	MVI	A,1		;   is what WPULL tells OPA_EX: 'dl' there is 'x',
  0923'   32 0000*              	STA	WPULL		;   and 'd3l' two from the end takes both.  An
  0926'   C9                    	RET			;   empty line has no char to take
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  0927'                         VC_0:
  0927'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  092A'   CD 0934'              	CALL	LNSTRT
  092D'   21 0000               	LXI	H,0
  0930'   22 2EFB'              	SHLD	GOALCOL
  0933'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  0934'                         LNSTRT:
  0934'   CD 139E'              	CALL	ZSAVE
  0937'   21 0000               	LXI	H,0
  093A'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  093D'   E5                    	PUSH	H
  093E'   CD 13B1'              	CALL	ZREST
  0941'   E1                    	POP	H
  0942'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  0945'                         VC_CRT:
  0945'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0948'   C3 094B'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  094B'                         FNBLNK:
  094B'   CD 0934'              	CALL	LNSTRT
  094E'   CD 0000*              	CALL	RGET0
  0951'   11 0000               	LXI	D,0		; DE = blanks skipped
  0954'                         FN_LP:
  0954'   CD 0000*              	CALL	RDGET
  0957'   DA 097A'              	JC	FN_GO		; the end of the file
  095A'   FE 20                 	CPI	' '
  095C'   CA 0964'              	JZ	FN_WH
  095F'   FE 09                 	CPI	TAB
  0961'   C2 097A'              	JNZ	FN_GO		; a non-blank, or the line's end
  0964'                         FN_WH:
  0964'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  0967'   DA 097A'              	JC	FN_GO
  096A'   FE 0D                 	CPI	CR
  096C'   CA 097A'              	JZ	FN_GO
  096F'   FE 0A                 	CPI	LF
  0971'   CA 097A'              	JZ	FN_GO
  0974'   2B                    	DCX	H		; not yet: read that char again
  0975'   03                    	INX	B
  0976'   13                    	INX	D
  0977'   C3 0954'              	JMP	FN_LP
  097A'                         FN_GO:
  097A'   D5                    	PUSH	D
  097B'   CD 0000*              	CALL	CUROFF
  097E'   D1                    	POP	D
  097F'   19                    	DAD	D
  0980'   C3 060E'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0983'                         VC_EOL:
  0983'   CD 0852'              	CALL	SETMOV
  0986'   21 FFFF               	LXI	H,0FFFFH
  0989'   22 2EFB'              	SHLD	GOALCOL
  098C'   CD 077D'              	CALL	GETCNT
  098F'   2B                    	DCX	H		; count-1
  0990'   7C                    	MOV	A,H
  0991'   B5                    	ORA	L
  0992'   CA 09A1'              	JZ	VEOL_0
  0995'   E5                    	PUSH	H
  0996'   CD 09B6'              	CALL	ONLAST
  0999'   E1                    	POP	H
  099A'   D8                    	RC			; the last line: no move (vim)
  099B'   CD 0A06'              	CALL	JCORE
  099E'   C3 0BEF'              	JMP	JKLAND
  09A1'                         VEOL_0:
  09A1'   CD 0934'              	CALL	LNSTRT
  09A4'   C3 0BEF'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  09A7'                         VC_CR:
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  09A7'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  09AA'   E5                    	PUSH	H
  09AB'   CD 09B6'              	CALL	ONLAST
  09AE'   E1                    	POP	H
  09AF'   D8                    	RC
  09B0'   CD 0A06'              	CALL	JCORE
  09B3'   C3 094B'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  09B6'                         ONLAST:
  09B6'   CD 0000*              	CALL	RGET0
  09B9'                         OL_LP:
  09B9'   CD 0000*              	CALL	RDGET
  09BC'   D8                    	RC			; the file ends on this line
  09BD'   FE 0A                 	CPI	LF
  09BF'   C2 09B9'              	JNZ	OL_LP
  09C2'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
                                
                                ;VC_J -- down count lines, clamped at the last line.
  09C5'                         VC_J:
  09C5'   CD 0852'              	CALL	SETMOV
  09C8'   CD 09F0'              	CALL	GLCHK		; the goal column, from the cursor if stale
  09CB'   CD 077D'              	CALL	GETCNT		; HL = count
  09CE'   CD 0A06'              	CALL	JCORE
  09D1'   CD 09E9'              	CALL	JKDRP
  09D4'   C3 0BEF'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  09D7'                         VC_K:
  09D7'   CD 0852'              	CALL	SETMOV
  09DA'   CD 09F0'              	CALL	GLCHK
  09DD'   CD 077D'              	CALL	GETCNT
  09E0'   CD 0AE6'              	CALL	KCORE
  09E3'   CD 09E9'              	CALL	JKDRP
  09E6'   C3 0BEF'              	JMP	JKLAND
                                
                                ;JKDRP -- DE = the lines JCORE / KCORE moved.  None -- 'j' on the last line,
                                ; 'k' on the first -- and the motion has failed: an operator waiting on it is
                                ; dropped, as vim drops it, where a line span that starts and ends on one line
                                ; would take that line ('dj' on the last line deleted it).  A count that runs
                                ; out of lines short has still moved, and its operator stands.  It is asked
                                ; here and not in the cores: 'dH' on the top row moves no lines either, and
                                ; takes its line.
  09E9'                         JKDRP:
  09E9'   7A                    	MOV	A,D
  09EA'   B3                    	ORA	E
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  09EB'   C0                    	RNZ
  09EC'   32 0000*              	STA	PSAVE
  09EF'   C9                    	RET
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  09F0'                         GLCHK:
  09F0'   2A 2EFB'              	LHLD	GOALCOL
  09F3'   7C                    	MOV	A,H
  09F4'   3C                    	INR	A
  09F5'   C0                    	RNZ
  09F6'   7D                    	MOV	A,L
  09F7'   FE FE                 	CPI	0FEH
  09F9'   C0                    	RNZ
  09FA'   C3 0611'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  09FD'                         GLSTAL:
  09FD'   E5                    	PUSH	H
  09FE'   21 FFFE               	LXI	H,0FFFEH
  0A01'   22 2EFB'              	SHLD	GOALCOL
  0A04'   E1                    	POP	H
  0A05'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0A06'                         JCORE:
  0A06'   7C                    	MOV	A,H
  0A07'   B5                    	ORA	L
  0A08'   C8                    	RZ
  0A09'   22 0000*              	SHLD	JKCNT
  0A0C'   CD 0EB2'              	CALL	CURRW		; limit = lines under the cursor's + NEDIT + 2:
  0A0F'   47                    	MOV	B,A		;   enough for LYFAR to know it for far off
  0A10'   3A 0000*              	LDA	NEDIT
  0A13'   3C                    	INR	A
  0A14'   90                    	SUB	B
  0A15'   5F                    	MOV	E,A
  0A16'   16 00                 	MVI	D,0
  0A18'   3A 0000*              	LDA	NEDIT
  0A1B'   6F                    	MOV	L,A
  0A1C'   26 00                 	MVI	H,0
  0A1E'   19                    	DAD	D
  0A1F'   EB                    	XCHG			; DE = limit
  0A20'   2A 0000*              	LHLD	JKCNT
  0A23'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0A26'   D2 0A74'              	JNC	JC_QK
  0A29'   EB                    	XCHG			; HL = limit
  0A2A'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0A2D'                         JC_SL:
  0A2D'   2A 0000*              	LHLD	JKN
  0A30'   EB                    	XCHG			; DE = LFs to find
  0A31'   CD 0000*              	CALL	RGET0
  0A34'                         JC_SC:
  0A34'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  0A37'   DA 0A56'              	JC	JC_EOF
  0A3A'   32 0000*              	STA	JKLST
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0A3D'   FE 0A                 	CPI	LF
  0A3F'   C2 0A34'              	JNZ	JC_SC
  0A42'   1B                    	DCX	D
  0A43'   7A                    	MOV	A,D
  0A44'   B3                    	ORA	E
  0A45'   C2 0A34'              	JNZ	JC_SC
  0A48'   2A 0000*              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  0A4B'   22 0000*              	SHLD	JKMOV		;   one if the last LF found ends the file
  0A4E'   3E 01                 	MVI	A,1
  0A50'   32 0000*              	STA	JKPHN
  0A53'   C3 0AB1'              	JMP	JC_MV
  0A56'                         JC_EOF:
  0A56'   2A 0000*              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  0A59'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  0A5C'   7C                    	MOV	A,H
  0A5D'   B5                    	ORA	L
  0A5E'   CA 0A6A'              	JZ	JC_AV
  0A61'   3A 0000*              	LDA	JKLST
  0A64'   FE 0A                 	CPI	LF
  0A66'   C2 0A6A'              	JNZ	JC_AV
  0A69'   2B                    	DCX	H
  0A6A'                         JC_AV:
  0A6A'   22 0000*              	SHLD	JKMOV
  0A6D'   AF                    	XRA	A
  0A6E'   32 0000*              	STA	JKPHN
  0A71'   C3 0AB1'              	JMP	JC_MV
                                ;--- the count is no more than the screen can show, and its lines are most
                                ;    times in memory: they are looked for where they lie, once, and the
                                ;    cursor put there in one move.  A line that starts where the window ends
                                ;    may be the file's end: that, and lines not here, go the long way ---
  0A74'                         JC_QK:
  0A74'   22 0000*              	SHLD	JKN		; N = the count
  0A77'   CD 0000*              	CALL	RGET0		; HL = the text after the cursor, BC = its bytes
  0A7A'   3A 0000*              	LDA	JKN
  0A7D'   5F                    	MOV	E,A		; E = LFs to find (the limit is under 256)
  0A7E'   16 0A                 	MVI	D,LF
  0A80'   04                    	INR	B
  0A81'   0C                    	INR	C
  0A82'                         JQ_LP:
  0A82'   0D                    	DCR	C
  0A83'   C2 0A8A'              	JNZ	JQ_CH
  0A86'   05                    	DCR	B
  0A87'   CA 0A2D'              	JZ	JC_SL
  0A8A'                         JQ_CH:
  0A8A'   7E                    	MOV	A,M
  0A8B'   23                    	INX	H
  0A8C'   BA                    	CMP	D
  0A8D'   C2 0A82'              	JNZ	JQ_LP
  0A90'   1D                    	DCR	E
  0A91'   C2 0A82'              	JNZ	JQ_LP
  0A94'   EB                    	XCHG			; DE = the line's start
  0A95'   2A 0000*              	LHLD	TXTEND
  0A98'   CD 0000*              	CALL	CMP16		; CY iff it is inside the window
  0A9B'   D2 0A2D'              	JNC	JC_SL
  0A9E'   EB                    	XCHG
  0A9F'   CD 0000*              	CALL	PUTCUR
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0AA2'   21 0000               	LXI	H,0
  0AA5'   CD 0000*              	CALL	SETC0		; the count spent, forward: as MVLIND leaves it
  0AA8'   2A 0000*              	LHLD	JKCNT
  0AAB'   22 0000*              	SHLD	JKMOV
  0AAE'   C3 0ACF'              	JMP	JC_DN
  0AB1'                         JC_MV:
  0AB1'   2A 0000*              	LHLD	JKCNT
  0AB4'   AF                    	XRA	A
  0AB5'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  0AB8'   CD 0BCE'              	CALL	ATEOF
  0ABB'   D2 0ACF'              	JNC	JC_DN
  0ABE'   CD 0BD4'              	CALL	LASTLN		; ran past the last line: back onto it
  0AC1'   3A 0000*              	LDA	JKPHN
  0AC4'   B7                    	ORA	A
  0AC5'   CA 0ACF'              	JZ	JC_DN
  0AC8'   2A 0000*              	LHLD	JKMOV
  0ACB'   2B                    	DCX	H
  0ACC'   22 0000*              	SHLD	JKMOV
  0ACF'                         JC_DN:
  0ACF'   2A 0000*              	LHLD	JKN		; LNDLT += min(moved, N)
  0AD2'   EB                    	XCHG
  0AD3'   2A 0000*              	LHLD	JKMOV
  0AD6'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0AD9'   D2 0ADD'              	JNC	JC_AD
  0ADC'   EB                    	XCHG
  0ADD'                         JC_AD:
  0ADD'   EB                    	XCHG			; DE = lines moved
  0ADE'   2A 0000*              	LHLD	LNDLT
  0AE1'   19                    	DAD	D
  0AE2'   22 0000*              	SHLD	LNDLT
  0AE5'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0AE6'                         KCORE:
  0AE6'   7C                    	MOV	A,H
  0AE7'   B5                    	ORA	L
  0AE8'   C8                    	RZ
  0AE9'   22 0000*              	SHLD	JKCNT
  0AEC'   CD 0EB2'              	CALL	CURRW		; limit = row + NEDIT
  0AEF'   5F                    	MOV	E,A
  0AF0'   16 00                 	MVI	D,0
  0AF2'   3A 0000*              	LDA	NEDIT
  0AF5'   6F                    	MOV	L,A
  0AF6'   26 00                 	MVI	H,0
  0AF8'   19                    	DAD	D
  0AF9'   EB                    	XCHG			; DE = limit
  0AFA'   2A 0000*              	LHLD	JKCNT
  0AFD'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0B00'   D2 0B7A'              	JNC	KC_QK
  0B03'   EB                    	XCHG			; HL = limit
  0B04'   22 0000*              	SHLD	JKN		; N = min(count, limit)
  0B07'                         KC_SL:
  0B07'   2A 0000*              	LHLD	JKN
  0B0A'   EB                    	XCHG			; DE = LFs to find
  0B0B'   21 0000               	LXI	H,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B0E'   22 0000*              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0B11'                         KC_ED:
  0B11'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0B12'   2A 0000*              	LHLD	JKBK
  0B15'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B18'   E5                    	PUSH	H
  0B19'   EB                    	XCHG
  0B1A'   2A 0000*              	LHLD	TXTBEG
  0B1D'   EB                    	XCHG
  0B1E'   CD 0000*              	CALL	SUBHD
  0B21'   44                    	MOV	B,H
  0B22'   4D                    	MOV	C,L
  0B23'   E1                    	POP	H
  0B24'   D1                    	POP	D
  0B25'                         KC_SC:
  0B25'   78                    	MOV	A,B
  0B26'   B1                    	ORA	C
  0B27'   CA 0B3E'              	JZ	KC_TB
  0B2A'   2B                    	DCX	H
  0B2B'   0B                    	DCX	B
  0B2C'   7E                    	MOV	A,M
  0B2D'   FE 0A                 	CPI	LF
  0B2F'   C2 0B25'              	JNZ	KC_SC
  0B32'   1B                    	DCX	D
  0B33'   7A                    	MOV	A,D
  0B34'   B3                    	ORA	E
  0B35'   C2 0B25'              	JNZ	KC_SC
  0B38'   2A 0000*              	LHLD	JKCNT		; N lines above: the move is count lines
  0B3B'   C3 0B5E'              	JMP	KC_MV
  0B3E'                         KC_TB:
  0B3E'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B3F'   CD 0776'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B42'   22 0000*              	SHLD	JKBK
  0B45'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B48'   7C                    	MOV	A,H
  0B49'   B5                    	ORA	L
  0B4A'   CA 0B57'              	JZ	KC_B0
  0B4D'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  0B50'   D1                    	POP	D
  0B51'   DA 0B58'              	JC	KC_BOF
  0B54'   C3 0B11'              	JMP	KC_ED
  0B57'                         KC_B0:
  0B57'   D1                    	POP	D
  0B58'                         KC_BOF:
  0B58'   2A 0000*              	LHLD	JKN		; moved = LFs found
  0B5B'   CD 0000*              	CALL	SUBHD
  0B5E'                         KC_MV:
  0B5E'   E5                    	PUSH	H
  0B5F'   2A 0000*              	LHLD	JKCNT
  0B62'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B65'   D1                    	POP	D		; DE = moved
  0B66'   2A 0000*              	LHLD	JKN
  0B69'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B6C'   DA 0B70'              	JC	KC_AD
  0B6F'   EB                    	XCHG			; DE = N
  0B70'                         KC_AD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0B70'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B73'   CD 0000*              	CALL	SUBHD
  0B76'   22 0000*              	SHLD	LNDLT
  0B79'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0B7A'                         KC_QK:
  0B7A'   22 0000*              	SHLD	JKN		; N = the count
  0B7D'   2A 0000*              	LHLD	TXTBEG
  0B80'   EB                    	XCHG
  0B81'   2A 0000*              	LHLD	GAPBEG
  0B84'   E5                    	PUSH	H
  0B85'   CD 0000*              	CALL	SUBHD
  0B88'   44                    	MOV	B,H
  0B89'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0B8A'   E1                    	POP	H
  0B8B'   3A 0000*              	LDA	JKN
  0B8E'   3C                    	INR	A
  0B8F'   5F                    	MOV	E,A		; E = LFs to find
  0B90'   16 0A                 	MVI	D,LF
  0B92'   04                    	INR	B
  0B93'   0C                    	INR	C
  0B94'                         KQ_LP:
  0B94'   0D                    	DCR	C
  0B95'   C2 0B9C'              	JNZ	KQ_CH
  0B98'   05                    	DCR	B
  0B99'   CA 0BBC'              	JZ	KQ_TB
  0B9C'                         KQ_CH:
  0B9C'   2B                    	DCX	H
  0B9D'   7E                    	MOV	A,M
  0B9E'   BA                    	CMP	D
  0B9F'   C2 0B94'              	JNZ	KQ_LP
  0BA2'   1D                    	DCR	E
  0BA3'   C2 0B94'              	JNZ	KQ_LP
  0BA6'   23                    	INX	H
  0BA7'                         KQ_GO:
  0BA7'   CD 0000*              	CALL	PUTCUR
  0BAA'   21 0000               	LXI	H,0
  0BAD'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BB0'   3E FF                 	MVI	A,0FFH
  0BB2'   32 0000*              	STA	DIRFLG
  0BB5'   2A 0000*              	LHLD	JKCNT
  0BB8'   EB                    	XCHG			; DE = the lines moved
  0BB9'   C3 0B70'              	JMP	KC_AD
  0BBC'                         KQ_TB:
  0BBC'   1D                    	DCR	E
  0BBD'   C2 0B07'              	JNZ	KC_SL
  0BC0'   2A 0000*              	LHLD	OUTPOS
  0BC3'   7C                    	MOV	A,H
  0BC4'   B5                    	ORA	L
  0BC5'   C2 0B07'              	JNZ	KC_SL
  0BC8'   2A 0000*              	LHLD	TXTBEG
  0BCB'   C3 0BA7'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BCE'                         ATEOF:
  0BCE'   CD 0000*              	CALL	RGET0
  0BD1'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0BD4'                         LASTLN:
  0BD4'   2A 0000*              	LHLD	GAPBEG
  0BD7'   EB                    	XCHG
  0BD8'   2A 0000*              	LHLD	TXTBEG
  0BDB'   CD 0000*              	CALL	CMP16
  0BDE'   21 0000               	LXI	H,0
  0BE1'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0BE4'   1B                    	DCX	D
  0BE5'   1A                    	LDAX	D
  0BE6'   FE 0A                 	CPI	LF
  0BE8'   C2 0000*              	JNZ	SETBWD
  0BEB'   23                    	INX	H
  0BEC'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0BEF'                         JKLAND:
  0BEF'   21 0000               	LXI	H,0
  0BF2'   22 0000*              	SHLD	JKVC		; screen column
  0BF5'   2B                    	DCX	H
  0BF6'   22 0000*              	SHLD	JKLS		; last content char: none yet
  0BF9'   CD 0000*              	CALL	RGET0
  0BFC'   11 0000               	LXI	D,0		; DE = chars read
  0BFF'                         JL_RD:
  0BFF'   CD 0000*              	CALL	RDGET
  0C02'   DA 0C3C'              	JC	JL_END
  0C05'   FE 0A                 	CPI	LF
  0C07'   CA 0C3C'              	JZ	JL_END
  0C0A'   E5                    	PUSH	H
  0C0B'   C5                    	PUSH	B
  0C0C'   2A 0000*              	LHLD	JKVC
  0C0F'   CD 0665'              	CALL	CWID
  0C12'   B7                    	ORA	A
  0C13'   CA 0C36'              	JZ	JL_NX		; a CR
  0C16'   EB                    	XCHG
  0C17'   22 0000*              	SHLD	JKLS		; the last content char so far
  0C1A'   EB                    	XCHG
  0C1B'   4F                    	MOV	C,A
  0C1C'   06 00                 	MVI	B,0
  0C1E'   09                    	DAD	B		; HL = the column after this char
  0C1F'   22 0000*              	SHLD	JKVC
  0C22'   D5                    	PUSH	D
  0C23'   EB                    	XCHG
  0C24'   2A 2EFB'              	LHLD	GOALCOL
  0C27'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C2A'   D1                    	POP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C2B'   DA 0C36'              	JC	JL_NX
  0C2E'   CA 0C36'              	JZ	JL_NX
  0C31'   C1                    	POP	B		; this char holds the goal column
  0C32'   E1                    	POP	H
  0C33'   C3 0C47'              	JMP	JL_GO
  0C36'                         JL_NX:
  0C36'   C1                    	POP	B
  0C37'   E1                    	POP	H
  0C38'   13                    	INX	D
  0C39'   C3 0BFF'              	JMP	JL_RD
  0C3C'                         JL_END:
  0C3C'   2A 0000*              	LHLD	JKLS		; past the line's end: its last content char
  0C3F'   7C                    	MOV	A,H
  0C40'   A5                    	ANA	L
  0C41'   3C                    	INR	A
  0C42'   C2 0C46'              	JNZ	JL_LS
  0C45'   23                    	INX	H		; no content: the line's start
  0C46'                         JL_LS:
  0C46'   EB                    	XCHG
  0C47'                         JL_GO:
  0C47'   D5                    	PUSH	D		; DE = step from the line start
  0C48'   CD 0000*              	CALL	CUROFF
  0C4B'   D1                    	POP	D
  0C4C'   19                    	DAD	D
  0C4D'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C50'   AF                    VC_W:	XRA	A
  0C51'   32 0000*              	STA	WBIG
  0C54'   C3 0C5C'              	JMP	WDO
  0C57'   3E 01                 VCBGW:	MVI	A,1
  0C59'   32 0000*              	STA	WBIG
  0C5C'   CD 0852'              WDO:	CALL	SETMOV
  0C5F'   AF                    	XRA	A
  0C60'   32 0000*              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C63'   CD 077D'              	CALL	GETCNT
  0C66'   22 0000*              	SHLD	CNTV
  0C69'   2A 0000*              WDO_LP: LHLD	CNTV
  0C6C'   7C                    	MOV	A,H
  0C6D'   B5                    	ORA	L
  0C6E'   CA 0C7B'              	JZ	WDO_DN
  0C71'   2B                    	DCX	H
  0C72'   22 0000*              	SHLD	CNTV
  0C75'   CD 0CD8'              	CALL	FWD1
  0C78'   D2 0C69'              	JNC	WDO_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C7B'                         WDO_DN:
  0C7B'   CD 0BCE'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0C7E'   DA 0C8B'              	JC	WDO_NL
  0C81'   FE 0D                 	CPI	CR
  0C83'   CA 0C8B'              	JZ	WDO_NL
  0C86'   FE 0A                 	CPI	LF
  0C88'   C2 0611'              	JNZ	SETGL
  0C8B'                         WDO_NL:
  0C8B'   CD 0000*              	CALL	PEEKL
  0C8E'   DA 0611'              	JC	SETGL
  0C91'   FE 0A                 	CPI	LF
  0C93'   CA 0611'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0C96'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0C98'   32 0000*              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0C9B'   CD 0DF7'              	CALL	DECC		; back onto its last char
  0C9E'   C3 0611'              	JMP	SETGL
                                
  0CA1'   AF                    VC_B:	XRA	A
  0CA2'   32 0000*              	STA	WBIG
  0CA5'   C3 0CAD'              	JMP	BDO
  0CA8'   3E 01                 VCBGB:	MVI	A,1
  0CAA'   32 0000*              	STA	WBIG
  0CAD'   CD 0852'              BDO:	CALL	SETMOV
  0CB0'   CD 077D'              	CALL	GETCNT
  0CB3'   22 0000*              	SHLD	CNTV
  0CB6'   CD 0D48'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CB9'   D2 0CC9'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CBC'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CBD'   32 0000*              	STA	PSAVE		;   first char opened an insert).  A count that
  0CC0'   C3 0611'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CC3'                         BDO_LP:				;   its operator stands -- both as vim
  0CC3'   CD 0D48'              	CALL	BCK1
  0CC6'   DA 0611'              	JC	SETGL
  0CC9'   2A 0000*              BDO_NX: LHLD	CNTV
  0CCC'   2B                    	DCX	H
  0CCD'   22 0000*              	SHLD	CNTV
  0CD0'   7C                    	MOV	A,H
  0CD1'   B5                    	ORA	L
  0CD2'   C2 0CC3'              	JNZ	BDO_LP
  0CD5'   C3 0611'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
                                ; the next line's first word as well.
  0CD8'                         FWD1:
  0CD8'   CD 0D7B'              	CALL	CCLS
  0CDB'   32 0000*              	STA	WKCLS		; the starting class
  0CDE'   CD 0DB5'              	CALL	INCC
  0CE1'   B7                    	ORA	A
  0CE2'   CA 0CFB'              	JZ	FW_WD
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0CE5'   37                    	STC
  0CE6'   F8                    	RM			; -1: already at the end
  0CE7'   CD 0D33'              	CALL	WLAST
  0CEA'   C8                    	RZ
  0CEB'   FE 02                 	CPI	2
  0CED'   C2 0CFB'              	JNZ	FW_WD		; 1: a next line was reached
  0CF0'   CD 0BCE'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0CF3'   D4 0D9C'              	CNC	NXLN
  0CF6'   D2 0CFB'              	JNC	FW_WD
  0CF9'   37                    	STC			; yes: failed
  0CFA'   C9                    	RET
  0CFB'                         FW_WD:
  0CFB'   3A 0000*              	LDA	WKCLS		; go past the rest of this word
  0CFE'   B7                    	ORA	A
  0CFF'   CA 0D1B'              	JZ	FW_WS
  0D02'                         FW_WLP:
  0D02'   CD 0D7B'              	CALL	CCLS
  0D05'   21 0000*              	LXI	H,WKCLS
  0D08'   BE                    	CMP	M
  0D09'   C2 0D1B'              	JNZ	FW_WS
  0D0C'   CD 0DB5'              	CALL	INCC
  0D0F'   B7                    	ORA	A
  0D10'   F8                    	RM			; the end of the file (NC)
  0D11'   CA 0D02'              	JZ	FW_WLP
  0D14'   CD 0D33'              	CALL	WLAST
  0D17'   C8                    	RZ
  0D18'   C3 0D02'              	JMP	FW_WLP
  0D1B'                         FW_WS:
  0D1B'   CD 0D7B'              	CALL	CCLS		; then over blanks to the next word
  0D1E'   B7                    	ORA	A
  0D1F'   C0                    	RNZ
  0D20'   CD 0D83'              	CALL	EMPTY
  0D23'   C8                    	RZ			; an empty line is a word
  0D24'   CD 0DB5'              	CALL	INCC
  0D27'   B7                    	ORA	A
  0D28'   F8                    	RM
  0D29'   CA 0D1B'              	JZ	FW_WS
  0D2C'   CD 0D33'              	CALL	WLAST
  0D2F'   C8                    	RZ
  0D30'   C3 0D1B'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D33'                         WLAST:
  0D33'   47                    	MOV	B,A
  0D34'   2A 0000*              	LHLD	CNTV
  0D37'   7C                    	MOV	A,H
  0D38'   B5                    	ORA	L
  0D39'   C2 0D44'              	JNZ	WL_X		; words still owed
  0D3C'   3A 0000*              	LDA	PSAVE
  0D3F'   B7                    	ORA	A
  0D40'   CA 0D46'              	JZ	WL_NO		; a plain 'w'
  0D43'   AF                    	XRA	A
  0D44'   78                    WL_X:	MOV	A,B
  0D45'   C9                    	RET
  0D46'   B0                    WL_NO:	ORA	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D47'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D48'                         BCK1:
  0D48'   CD 0DF7'              	CALL	DECC
  0D4B'   B7                    	ORA	A
  0D4C'   37                    	STC
  0D4D'   F8                    	RM
  0D4E'                         BK_WS:
  0D4E'   CD 0D7B'              	CALL	CCLS		; back over blanks
  0D51'   B7                    	ORA	A
  0D52'   C2 0D62'              	JNZ	BK_WD
  0D55'   CD 0D83'              	CALL	EMPTY
  0D58'   C8                    	RZ			; an empty line is a word
  0D59'   CD 0DF7'              	CALL	DECC
  0D5C'   B7                    	ORA	A
  0D5D'   F2 0D4E'              	JP	BK_WS
  0D60'   AF                    	XRA	A		; the start of the file (NC)
  0D61'   C9                    	RET
  0D62'                         BK_WD:
  0D62'   32 0000*              	STA	WKCLS		; back to the start of this word
  0D65'                         BK_WLP:
  0D65'   CD 0DF7'              	CALL	DECC
  0D68'   B7                    	ORA	A
  0D69'   FA 0D79'              	JM	BK_OK		; the start of the file
  0D6C'   CD 0D7B'              	CALL	CCLS
  0D6F'   21 0000*              	LXI	H,WKCLS
  0D72'   BE                    	CMP	M
  0D73'   CA 0D65'              	JZ	BK_WLP
  0D76'   CD 0DB5'              	CALL	INCC		; overshot: forward one
  0D79'                         BK_OK:
  0D79'   AF                    	XRA	A
  0D7A'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0D7B'                         CCLS:
  0D7B'   CD 0BCE'              	CALL	ATEOF
  0D7E'   D2 0807'              	JNC	CLASSF
  0D81'   AF                    	XRA	A
  0D82'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0D83'                         EMPTY:
  0D83'   CD 0BCE'              	CALL	ATEOF
  0D86'   DA 0D91'              	JC	EM_ST
  0D89'   FE 0D                 	CPI	CR
  0D8B'   CA 0D91'              	JZ	EM_ST
  0D8E'   FE 0A                 	CPI	LF
  0D90'   C0                    	RNZ
  0D91'                         EM_ST:
  0D91'   CD 0000*              	CALL	PEEKL
  0D94'   DA 0D9A'              	JC	EM_Y
  0D97'   FE 0A                 	CPI	LF
  0D99'   C9                    	RET
  0D9A'                         EM_Y:
  0D9A'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D9B'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0D9C'                         NXLN:
  0D9C'   FE 0A                 	CPI	LF
  0D9E'   CA 0DAD'              	JZ	NX_LF
  0DA1'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DA4'   D8                    	RC
  0DA5'   FE 0A                 	CPI	LF
  0DA7'   CA 0DAD'              	JZ	NX_LF
  0DAA'   2B                    	DCX	H		; a lone CR
  0DAB'   AF                    	XRA	A
  0DAC'   C9                    	RET
  0DAD'                         NX_LF:
  0DAD'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DB0'   D8                    	RC
  0DB1'   2B                    	DCX	H
  0DB2'   3E 01                 	MVI	A,1
  0DB4'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DB5'                         INCC:
  0DB5'   CD 0BCE'              	CALL	ATEOF
  0DB8'   DA 0DF3'              	JC	IC_END
  0DBB'   FE 0D                 	CPI	CR
  0DBD'   CA 0DDE'              	JZ	IC_NL
  0DC0'   FE 0A                 	CPI	LF
  0DC2'   CA 0DDE'              	JZ	IC_NL
  0DC5'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DC8'                         IC_CH:
  0DC8'   CD 0BCE'              	CALL	ATEOF
  0DCB'   DA 0DDA'              	JC	IC_2
  0DCE'   FE 0D                 	CPI	CR
  0DD0'   CA 0DDA'              	JZ	IC_2
  0DD3'   FE 0A                 	CPI	LF
  0DD5'   CA 0DDA'              	JZ	IC_2
  0DD8'   AF                    	XRA	A
  0DD9'   C9                    	RET
  0DDA'                         IC_2:
  0DDA'   3E 02                 	MVI	A,2
  0DDC'   B7                    	ORA	A
  0DDD'   C9                    	RET
  0DDE'                         IC_NL:
  0DDE'   CD 0D9C'              	CALL	NXLN
  0DE1'   DA 0DF3'              	JC	IC_END
  0DE4'   F5                    	PUSH	PSW
  0DE5'   CD 0000*              	CALL	PUTCUR
  0DE8'   F1                    	POP	PSW
  0DE9'   B7                    	ORA	A
  0DEA'   CA 0DC8'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0DED'   CD 0E19'              	CALL	LNINC
  0DF0'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DF2'   C9                    	RET
  0DF3'                         IC_END:
  0DF3'   3E FF                 	MVI	A,0FFH
  0DF5'   B7                    	ORA	A
  0DF6'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0DF7'                         DECC:
  0DF7'   CD 0000*              	CALL	PEEKL
  0DFA'   DA 0DF3'              	JC	IC_END
  0DFD'   F5                    	PUSH	PSW
  0DFE'   CD 0000*              	CALL	PUTCUR
  0E01'   F1                    	POP	PSW
  0E02'   FE 0A                 	CPI	LF
  0E04'   3E 00                 	MVI	A,0
  0E06'   C0                    	RNZ
  0E07'   CD 0E27'              	CALL	LNDEC
  0E0A'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E0D'   DA 0E15'              	JC	DC_1
  0E10'   FE 0D                 	CPI	CR
  0E12'   CC 0000*              	CZ	PUTCUR
  0E15'                         DC_1:
  0E15'   3E 01                 	MVI	A,1
  0E17'   B7                    	ORA	A
  0E18'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E19'                         LNINC:
  0E19'   E5                    	PUSH	H
  0E1A'   2A 0000*              	LHLD	LNDLT
  0E1D'   7C                    	MOV	A,H
  0E1E'   FE 40                 	CPI	40H
  0E20'   CA 0E35'              	JZ	LN_X
  0E23'   23                    	INX	H
  0E24'   C3 0E32'              	JMP	LN_ST
  0E27'                         LNDEC:
  0E27'   E5                    	PUSH	H
  0E28'   2A 0000*              	LHLD	LNDLT
  0E2B'   7C                    	MOV	A,H
  0E2C'   FE C0                 	CPI	0C0H
  0E2E'   CA 0E35'              	JZ	LN_X
  0E31'   2B                    	DCX	H
  0E32'                         LN_ST:
  0E32'   22 0000*              	SHLD	LNDLT
  0E35'                         LN_X:
  0E35'   E1                    	POP	H
  0E36'   C9                    	RET
                                
  0E37'   AF                    VC_E:	XRA	A
  0E38'   32 0000*              	STA	WBIG
  0E3B'   C3 0E43'              	JMP	EDO
  0E3E'   3E 01                 VCBGE:	MVI	A,1
  0E40'   32 0000*              	STA	WBIG
  0E43'   CD 0852'              EDO:	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E46'   CD 077D'              	CALL	GETCNT
  0E49'   22 0000*              	SHLD	CNTV
  0E4C'   2A 0000*              EDO_LP: LHLD	CNTV
  0E4F'   7C                    	MOV	A,H
  0E50'   B5                    	ORA	L
  0E51'   CA 0C7B'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E54'   2B                    	DCX	H
  0E55'   22 0000*              	SHLD	CNTV
  0E58'   CD 0E66'              	CALL	ESTEP
  0E5B'   21 0000*              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E5E'   36 00                 	MVI	M,0
  0E60'   D2 0E4C'              	JNC	EDO_LP
  0E63'   C3 0C7B'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E66'                         ESTEP:
  0E66'   CD 0D7B'              	CALL	CCLS
  0E69'   32 0000*              	STA	WKCLS		; the starting class
  0E6C'   CD 0DB5'              	CALL	INCC
  0E6F'   B7                    	ORA	A
  0E70'   FA 0E96'              	JM	ES_F
  0E73'   CD 0D7B'              	CALL	CCLS
  0E76'   B7                    	ORA	A
  0E77'   CA 0E81'              	JZ	ES_ST
  0E7A'   21 0000*              	LXI	H,WKCLS
  0E7D'   BE                    	CMP	M
  0E7E'   CA 0E98'              	JZ	ES_SK		; still in the word it started in: on to its end
  0E81'                         ES_ST:
  0E81'   3A 0000*              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0E84'   B7                    	ORA	A		;   that char is the word's end already, and
  0E85'   C2 0EAF'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0E88'                         ES_WS:
  0E88'   CD 0D7B'              	CALL	CCLS		; over blanks, line ends and empty lines
  0E8B'   B7                    	ORA	A
  0E8C'   C2 0E98'              	JNZ	ES_SK
  0E8F'   CD 0DB5'              	CALL	INCC
  0E92'   B7                    	ORA	A
  0E93'   F2 0E88'              	JP	ES_WS
  0E96'                         ES_F:
  0E96'   37                    	STC
  0E97'   C9                    	RET
  0E98'                         ES_SK:
  0E98'   CD 0D7B'              	CALL	CCLS		; past the rest of this word ...
  0E9B'   32 0000*              	STA	WKCLS
  0E9E'                         ES_SL:
  0E9E'   CD 0DB5'              	CALL	INCC
  0EA1'   B7                    	ORA	A
  0EA2'   FA 0E96'              	JM	ES_F
  0EA5'   CD 0D7B'              	CALL	CCLS
  0EA8'   21 0000*              	LXI	H,WKCLS
  0EAB'   BE                    	CMP	M
  0EAC'   CA 0E9E'              	JZ	ES_SL
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EAF'   C3 0DF7'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EB2'                         CURRW:
  0EB2'   2A 0000*              	LHLD	WINROW
  0EB5'   EB                    	XCHG
  0EB6'   2A 0000*              	LHLD	LNDLT
  0EB9'   19                    	DAD	D		; HL = row (signed)
  0EBA'   7C                    	MOV	A,H
  0EBB'   B7                    	ORA	A
  0EBC'   FA 0ECF'              	JM	CRW_0		; above the screen -> top row
  0EBF'   C2 0ECA'              	JNZ	CRW_BT		; far below -> bottom row
  0EC2'   3A 0000*              	LDA	NEDIT
  0EC5'   3D                    	DCR	A		; A = bottom row
  0EC6'   BD                    	CMP	L		; CY iff bottom < row
  0EC7'   D8                    	RC
  0EC8'   7D                    	MOV	A,L
  0EC9'   C9                    	RET
  0ECA'                         CRW_BT:
  0ECA'   3A 0000*              	LDA	NEDIT
  0ECD'   3D                    	DCR	A
  0ECE'   C9                    	RET
  0ECF'                         CRW_0:
  0ECF'   AF                    	XRA	A
  0ED0'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0ED1'                         SETRWT:
  0ED1'   2A 0000*              	LHLD	LNDLT
  0ED4'   EB                    	XCHG
  0ED5'   6F                    	MOV	L,A
  0ED6'   26 00                 	MVI	H,0
  0ED8'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0EDB'   22 0000*              	SHLD	WINROW
  0EDE'   3E 01                 	MVI	A,PL_SET
  0EE0'   32 0000*              	STA	PLACE
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EE3'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0EE4'                         MVROW:
  0EE4'   47                    	MOV	B,A
  0EE5'   CD 0EB2'              	CALL	CURRW
  0EE8'   90                    	SUB	B		; A = row now - target
  0EE9'                         MR_GO:
  0EE9'   C8                    	RZ
  0EEA'   DA 0EF3'              	JC	MR_DN
  0EED'   6F                    	MOV	L,A
  0EEE'   26 00                 	MVI	H,0
  0EF0'   C3 0AE6'              	JMP	KCORE
  0EF3'                         MR_DN:
  0EF3'   2F                    	CMA
  0EF4'   3C                    	INR	A		; A = target - row now
  0EF5'   6F                    	MOV	L,A
  0EF6'   26 00                 	MVI	H,0
  0EF8'   C3 0A06'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0EFB'                         VC_HIGH:
  0EFB'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0EFE'   2B                    	DCX	H		; row = count - 1
  0EFF'   7C                    	MOV	A,H
  0F00'   B7                    	ORA	A
  0F01'   3A 0000*              	LDA	SCBOT
  0F04'   C2 0F0C'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F07'   BD                    	CMP	L		; CY iff SCBOT < row
  0F08'   DA 0F0C'              	JC	VH_GO
  0F0B'   7D                    	MOV	A,L
  0F0C'                         VH_GO:
  0F0C'   CD 0EE4'              	CALL	MVROW
  0F0F'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F12'                         VC_MIDL:
  0F12'   CD 076A'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0F15'   CD 11A4'              	CALL	HTSCR		; HL -> the top line's rows
  0F18'   3A 0000*              	LDA	TXEND
  0F1B'   3C                    	INR	A
  0F1C'   B7                    	ORA	A
  0F1D'   1F                    	RAR
  0F1E'   3D                    	DCR	A
  0F1F'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F20'   CD 11EA'              	CALL	HTFQ
  0F23'   D2 0F27'              	JNC	VM_GO
  0F26'   2B                    	DCX	H
  0F27'                         VM_GO:
  0F27'   CD 11DF'              	CALL	HTGO
  0F2A'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                ; above the top row, then first non-blank.
  0F2D'                         VC_LOWL:
  0F2D'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F30'   2B                    	DCX	H		; count - 1
  0F31'   3A 0000*              	LDA	SCBOT
  0F34'   5F                    	MOV	E,A
  0F35'   16 00                 	MVI	D,0
  0F37'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F38'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F3B'   3E 00                 	MVI	A,0
  0F3D'   D2 0F44'              	JNC	VL_GO		; at or past the top -> row 0
  0F40'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0F43'   7D                    	MOV	A,L
  0F44'                         VL_GO:
  0F44'   CD 0EE4'              	CALL	MVROW
  0F47'   C3 094B'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F4A'                         VC_PGDN:
  0F4A'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0F4D'   22 0000*              	SHLD	RWR
  0F50'   3A 0000*              	LDA	SCEOF
  0F53'   B7                    	ORA	A
  0F54'   CA 0F5C'              	JZ	VPD_N
  0F57'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F5A'   B7                    	ORA	A		;   top line
  0F5B'   C8                    	RZ			; it already is
  0F5C'                         VPD_N:
  0F5C'   3A 0000*              	LDA	NEDIT
  0F5F'   3C                    	INR	A
  0F60'   4F                    	MOV	C,A
  0F61'   3E 02                 	MVI	A,2
  0F63'   CD 11AB'              	CALL	HTSET		; HL -> the top line's rows
  0F66'   E5                    	PUSH	H
  0F67'   C5                    	PUSH	B
  0F68'   3A 0000*              	LDA	NEDIT
  0F6B'   4F                    	MOV	C,A
  0F6C'   CD 11EA'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F6F'   3A 0000*              	LDA	NEDIT
  0F72'   DA 0F7F'              	JC	VPD_R		; there is none: no overlap
  0F75'   3A 0000*              	LDA	HTN
  0F78'   90                    	SUB	B
  0F79'   3C                    	INR	A
  0F7A'   47                    	MOV	B,A		; the lines from it up to the table's first
  0F7B'   AF                    	XRA	A
  0F7C'   CD 1019'              	CALL	OVLAP
  0F7F'                         VPD_R:
  0F7F'   CD 1068'              	CALL	PGROWS		; RWR = the rows to go
  0F82'   C1                    	POP	B
  0F83'   E1                    	POP	H
  0F84'   CD 122B'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F87'   DA 0FA3'              	JC	VPD_TP		; the text ended: its last line
  0F8A'   79                    	MOV	A,C
  0F8B'   B7                    	ORA	A
  0F8C'   CA 0FA3'              	JZ	VPD_TP
  0F8F'   3A 0000*              	LDA	RWMV		; part of the way down a line: its start -- unless
  0F92'   B7                    	ORA	A		;   that is the top line still, then the next
  0F93'   C2 0FA3'              	JNZ	VPD_TP
  0F96'   E5                    	PUSH	H
  0F97'   CD 11D9'              	CALL	HTIX
  0F9A'   21 0000*              	LXI	H,HTTP
  0F9D'   BE                    	CMP	M
  0F9E'   E1                    	POP	H
  0F9F'   C2 0FA3'              	JNZ	VPD_TP
  0FA2'   23                    	INX	H
  0FA3'                         VPD_TP:
  0FA3'   54                    	MOV	D,H
  0FA4'   5D                    	MOV	E,L
  0FA5'   C3 1112'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FA8'                         VC_PGUP:
  0FA8'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  0FAB'   22 0000*              	SHLD	RWR
  0FAE'   3A 0000*              	LDA	SCBOF
  0FB1'   B7                    	ORA	A
  0FB2'   C0                    	RNZ
  0FB3'   CD 0EB2'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FB6'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FB8'   0E 01                 	MVI	C,1
  0FBA'   D2 0FC1'              	JNC	VPU_1
  0FBD'   3A 0000*              	LDA	NEDIT
  0FC0'   4F                    	MOV	C,A
  0FC1'                         VPU_1:
  0FC1'   3A 0000*              	LDA	NEDIT
  0FC4'   CD 11AB'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FC7'   E5                    	PUSH	H
  0FC8'   D5                    	PUSH	D
  0FC9'   2B                    	DCX	H		; the line above the top one, and on down
  0FCA'   04                    	INR	B
  0FCB'   3E 01                 	MVI	A,1
  0FCD'   CD 1019'              	CALL	OVLAP
  0FD0'   CD 1068'              	CALL	PGROWS		; RWR = the rows to go
  0FD3'   D1                    	POP	D
  0FD4'   E1                    	POP	H
  0FD5'   43                    	MOV	B,E
  0FD6'   CD 126B'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0FD9'   DA 0FF6'              	JC	VPU_3		;   above it; or the file's first line
  0FDC'   79                    	MOV	A,C
  0FDD'   B7                    	ORA	A
  0FDE'   CA 0FF6'              	JZ	VPU_3
  0FE1'   3A 0000*              	LDA	RWMV
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FE4'   B7                    	ORA	A
  0FE5'   C2 0FF5'              	JNZ	VPU_2
  0FE8'   E5                    	PUSH	H
  0FE9'   CD 11D9'              	CALL	HTIX
  0FEC'   3C                    	INR	A
  0FED'   21 0000*              	LXI	H,HTTP
  0FF0'   BE                    	CMP	M
  0FF1'   E1                    	POP	H
  0FF2'   CA 0FF6'              	JZ	VPU_3		; the first line back: all of it
  0FF5'                         VPU_2:
  0FF5'   23                    	INX	H
  0FF6'                         VPU_3:
  0FF6'   CD 11DF'              	CALL	HTGO		; the cursor on the new top line ...
  0FF9'   3A 0000*              	LDA	NEDIT
  0FFC'   4F                    	MOV	C,A
  0FFD'   06 00                 	MVI	B,0
  0FFF'   CD 11C0'              	CALL	HTRB		; ... and the lines under it measured
  1002'   E5                    	PUSH	H
  1003'   3A 0000*              	LDA	NEDIT
  1006'   4F                    	MOV	C,A
  1007'   CD 11EA'              	CALL	HTFQ		; HL -> the first the screen has not room for
  100A'   2B                    	DCX	H
  100B'   D1                    	POP	D		; DE -> the top line's rows
  100C'   EB                    	XCHG
  100D'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  1010'   D2 1015'              	JNC	VPU_4		;   fills the screen)
  1013'   54                    	MOV	D,H
  1014'   5D                    	MOV	E,L
  1015'                         VPU_4:
  1015'   EB                    	XCHG
  1016'   C3 1112'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  1019'                         OVLAP:
  1019'   32 0000*              	STA	OVDIR
  101C'   3A 0000*              	LDA	NEDIT
  101F'   D6 02                 	SUI	2
  1021'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  1022'   56                    	MOV	D,M		; D = h1
  1023'   CD 105A'              	CALL	OV_NX
  1026'   DA 1056'              	JC	OV_0
  1029'   5E                    	MOV	E,M		; E = h2
  102A'   7A                    	MOV	A,D
  102B'   83                    	ADD	E
  102C'   57                    	MOV	D,A		; D = h1 + h2
  102D'   79                    	MOV	A,C
  102E'   BA                    	CMP	D
  102F'   DA 1056'              	JC	OV_0
  1032'   CD 105A'              	CALL	OV_NX
  1035'   DA 1056'              	JC	OV_0
  1038'   7B                    	MOV	A,E
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  1039'   86                    	ADD	M
  103A'   5F                    	MOV	E,A		; E = h2 + h3
  103B'   79                    	MOV	A,C
  103C'   BB                    	CMP	E
  103D'   DA 1056'              	JC	OV_0
  1040'   7A                    	MOV	A,D
  1041'   86                    	ADD	M
  1042'   57                    	MOV	D,A		; D = h1 + h2 + h3
  1043'   CD 105A'              	CALL	OV_NX
  1046'   DA 1053'              	JC	OV_1
  1049'   7B                    	MOV	A,E
  104A'   86                    	ADD	M		; h2 + h3 + h4
  104B'   5F                    	MOV	E,A
  104C'   79                    	MOV	A,C
  104D'   BB                    	CMP	E
  104E'   DA 1053'              	JC	OV_1
  1051'   BA                    	CMP	D
  1052'   D0                    	RNC			; two lines of overlap
  1053'                         OV_1:
  1053'   79                    	MOV	A,C
  1054'   3C                    	INR	A
  1055'   C9                    	RET
  1056'                         OV_0:
  1056'   79                    	MOV	A,C
  1057'   C6 02                 	ADI	2
  1059'   C9                    	RET
                                ;OV_NX -- HL -> the next line's rows, that way.  CY if the table has no more.
  105A'                         OV_NX:
  105A'   05                    	DCR	B
  105B'   37                    	STC
  105C'   C8                    	RZ
  105D'   3A 0000*              	LDA	OVDIR
  1060'   B7                    	ORA	A		; (CY off)
  1061'   CA 1066'              	JZ	OV_UP
  1064'   23                    	INX	H
  1065'   23                    	INX	H
  1066'                         OV_UP:
  1066'   2B                    	DCX	H
  1067'   C9                    	RET
                                
                                ;PGROWS -- A = the rows of a page: RWR = the count (in RWR) of them, and no
                                ; line gone past yet (RWMV).
  1068'                         PGROWS:
  1068'   2A 0000*              	LHLD	RWR
  106B'   CD 1076'              	CALL	MULSAT
  106E'   22 0000*              	SHLD	RWR
  1071'   AF                    	XRA	A
  1072'   32 0000*              	STA	RWMV
  1075'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  1076'                         MULSAT:
  1076'   EB                    	XCHG
  1077'   21 0000               	LXI	H,0
  107A'   B7                    	ORA	A
  107B'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  107C'                         MS_LP:
  107C'   19                    	DAD	D
  107D'   DA 1085'              	JC	MS_SAT
  1080'   3D                    	DCR	A
  1081'   C2 107C'              	JNZ	MS_LP
  1084'   C9                    	RET
  1085'                         MS_SAT:
  1085'   21 FFFF               	LXI	H,0FFFFH
  1088'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  1089'                         VC_HFDN:
  1089'   CD 0852'              	CALL	SETMOV
  108C'   CD 12CE'              	CALL	HFCNT		; HFN = the rows
  108F'   3A 0000*              	LDA	TALLF
  1092'   B7                    	ORA	A
  1093'   C2 1129'              	JNZ	VHD_TL
  1096'   CD 0EB2'              	CALL	CURRW
  1099'   47                    	MOV	B,A
  109A'   3A 0000*              	LDA	SCEOF
  109D'   B7                    	ORA	A
  109E'   CA 10A6'              	JZ	VHD_GO
  10A1'   3A 0000*              	LDA	SCBOT		; the last line's place
  10A4'   B8                    	CMP	B
  10A5'   C8                    	RZ			; the cursor is on it
  10A6'                         VHD_GO:
  10A6'   3A 0000*              	LDA	NEDIT
  10A9'   21 0000*              	LXI	H,HFN
  10AC'   86                    	ADD	M
  10AD'   3C                    	INR	A
  10AE'   4F                    	MOV	C,A
  10AF'   AF                    	XRA	A
  10B0'   CD 11AB'              	CALL	HTSET		; HL -> the top line's rows
  10B3'   3A 0000*              	LDA	HFN
  10B6'   57                    	MOV	D,A		; D = the rows the text moves
  10B7'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10B8'   3A 0000*              	LDA	HTEOF
  10BB'   B7                    	ORA	A
  10BC'   CA 10DB'              	JZ	VHD_1
  10BF'   E5                    	PUSH	H
  10C0'   C5                    	PUSH	B
  10C1'   0E FF                 	MVI	C,255
  10C3'   CD 11EA'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  10C6'   3A 0000*              	LDA	NEDIT
  10C9'   81                    	ADD	C
  10CA'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  10CB'   C1                    	POP	B
  10CC'   E1                    	POP	H
  10CD'   B7                    	ORA	A
  10CE'   FA 10D9'              	JM	VHD_0		; none
