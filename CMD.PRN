  1144'   0C                    	INR	C
  1145'   06 00                 	MVI	B,0
  1147'   CD 11C9'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  114A'   22 2F14'              	SHLD	HFTP
  114D'   D1                    	POP	D
  114E'   4B                    	MOV	C,E
  114F'   CD 11F3'              	CALL	HTFQ
  1152'   D2 1116'              	JNC	HFEND
  1155'   2B                    	DCX	H
  1156'   C3 1116'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  1159'                         VC_HFUP:
  1159'   CD 085B'              	CALL	SETMOV
  115C'   CD 12D7'              	CALL	HFCNT		; HFN = the rows
  115F'   CD 12B7'              	CALL	ONFST
  1162'   C8                    	RZ			; the cursor is on the first line
  1163'   0E 01                 	MVI	C,1
  1165'   3A 2F13'              	LDA	HFN
  1168'   CD 11B4'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  116B'   43                    	MOV	B,E
  116C'   3A 2F13'              	LDA	HFN
  116F'   4F                    	MOV	C,A
  1170'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1171'   CD 1204'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1174'   DA 118F'              	JC	VHU_C		;   above it; or the file's first line
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1177'   79                    	MOV	A,C
  1178'   B7                    	ORA	A
  1179'   CA 118F'              	JZ	VHU_C
  117C'   3A 2F18'              	LDA	HTTP
