  0ADF'                         LNDEC:
  0ADF'   E5                    	PUSH	H
  0AE0'   2A 0000*              	LHLD	LNDLT
  0AE3'   7C                    	MOV	A,H
  0AE4'   FE C0                 	CPI	0C0H
  0AE6'   CA 0AED'              	JZ	LN_X
  0AE9'   2B                    	DCX	H
  0AEA'                         LN_ST:
  0AEA'   22 0000*              	SHLD	LNDLT
  0AED'                         LN_X:
  0AED'   E1                    	POP	H
  0AEE'   C9                    	RET
                                
  0AEF'   AF                    VC_E:	XRA	A
  0AF0'   32 23EC'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AF3'   C3 0AFB'              	JMP	EDO
  0AF6'   3E 01                 VCBGE:	MVI	A,1
  0AF8'   32 23EC'              	STA	WBIG
  0AFB'   CD 060D'              EDO:	CALL	SETMOV
  0AFE'   CD 05A0'              	CALL	GETCNT
  0B01'   22 2418'              	SHLD	CNTV
  0B04'   2A 2418'              EDO_LP: LHLD	CNTV
  0B07'   7C                    	MOV	A,H
  0B08'   B5                    	ORA	L
  0B09'   C8                    	RZ
  0B0A'   2B                    	DCX	H
  0B0B'   22 2418'              	SHLD	CNTV
  0B0E'   CD 0B14'              	CALL	ESTEP
  0B11'   C3 0B04'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0B14'                         ESTEP:
  0B14'   CD 0000*              	CALL	CUROFF
  0B17'   22 241C'              	SHLD	WKI
  0B1A'   CD 0000*              	CALL	LOGLEN
  0B1D'   22 241E'              	SHLD	WKN
  0B20'   2A 241C'              	LHLD	WKI
  0B23'   23                    	INX	H
  0B24'   22 241C'              	SHLD	WKI
  0B27'                         ES_WS:
  0B27'   2A 241C'              	LHLD	WKI
  0B2A'   EB                    	XCHG
  0B2B'   2A 241E'              	LHLD	WKN
  0B2E'   CD 0000*              	CALL	CMP16
  0B31'   D2 0B7F'              	JNC	ES_LND
  0B34'   2A 241C'              	LHLD	WKI
  0B37'   CD 0000*              	CALL	CHARAT
  0B3A'   CD 05C2'              	CALL	CLASSF
  0B3D'   B7                    	ORA	A
  0B3E'   C2 0B4B'              	JNZ	ES_WD
  0B41'   2A 241C'              	LHLD	WKI
  0B44'   23                    	INX	H
  0B45'   22 241C'              	SHLD	WKI
  0B48'   C3 0B27'              	JMP	ES_WS
  0B4B'                         ES_WD:
  0B4B'   2A 241C'              	LHLD	WKI
  0B4E'   CD 0000*              	CALL	CHARAT
  0B51'   CD 05C2'              	CALL	CLASSF
  0B54'   32 2424'              	STA	WKCLS
  0B57'                         ES_RUN:
  0B57'   2A 241C'              	LHLD	WKI
  0B5A'   23                    	INX	H
  0B5B'   EB                    	XCHG			; DE = i+1
  0B5C'   2A 241E'              	LHLD	WKN
  0B5F'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0B62'   D2 0B7F'              	JNC	ES_LND
  0B65'   2A 241C'              	LHLD	WKI
  0B68'   23                    	INX	H
  0B69'   E5                    	PUSH	H		; i+1
  0B6A'   CD 0000*              	CALL	CHARAT
  0B6D'   CD 05C2'              	CALL	CLASSF
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B70'   E1                    	POP	H		; HL = i+1
  0B71'   47                    	MOV	B,A
  0B72'   3A 2424'              	LDA	WKCLS
  0B75'   B8                    	CMP	B
  0B76'   C2 0B7F'              	JNZ	ES_LND
  0B79'   22 241C'              	SHLD	WKI
  0B7C'   C3 0B57'              	JMP	ES_RUN
  0B7F'                         ES_LND:
  0B7F'   2A 241E'              	LHLD	WKN
  0B82'   EB                    	XCHG
  0B83'   2A 241C'              	LHLD	WKI
  0B86'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0B89'   DA 0B95'              	JC	ES_CL
  0B8C'   CA 0B95'              	JZ	ES_CL
  0B8F'   2A 241C'              	LHLD	WKI
  0B92'   C3 048F'              	JMP	GOSET
  0B95'                         ES_CL:
  0B95'   2A 241E'              	LHLD	WKN
  0B98'   7C                    	MOV	A,H
  0B99'   B5                    	ORA	L
  0B9A'   C8                    	RZ
  0B9B'   2B                    	DCX	H
  0B9C'   C3 048F'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0B9F'                         CURRW:
  0B9F'   2A 0000*              	LHLD	WINROW
  0BA2'   EB                    	XCHG
  0BA3'   2A 0000*              	LHLD	LNDLT
  0BA6'   19                    	DAD	D		; HL = row (signed)
  0BA7'   7C                    	MOV	A,H
  0BA8'   B7                    	ORA	A
  0BA9'   FA 0BBC'              	JM	CRW_0		; above the screen -> top row
  0BAC'   C2 0BB7'              	JNZ	CRW_BT		; far below -> bottom row
  0BAF'   3A 0000*              	LDA	NEDIT
  0BB2'   3D                    	DCR	A		; A = bottom row
  0BB3'   BD                    	CMP	L		; CY iff bottom < row
  0BB4'   D8                    	RC
  0BB5'   7D                    	MOV	A,L
  0BB6'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0BB7'                         CRW_BT:
  0BB7'   3A 0000*              	LDA	NEDIT
  0BBA'   3D                    	DCR	A
  0BBB'   C9                    	RET
  0BBC'                         CRW_0:
  0BBC'   AF                    	XRA	A
  0BBD'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0BBE'                         SETRWT:
  0BBE'   2A 0000*              	LHLD	LNDLT
  0BC1'   EB                    	XCHG
  0BC2'   6F                    	MOV	L,A
  0BC3'   26 00                 	MVI	H,0
  0BC5'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0BC8'   22 0000*              	SHLD	WINROW
  0BCB'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0BCC'                         MVROW:
  0BCC'   47                    	MOV	B,A
  0BCD'   CD 0B9F'              	CALL	CURRW
  0BD0'   90                    	SUB	B		; A = row now - target
  0BD1'   C8                    	RZ
  0BD2'   DA 0BDB'              	JC	MR_DN
  0BD5'   6F                    	MOV	L,A
  0BD6'   26 00                 	MVI	H,0
  0BD8'   C3 0826'              	JMP	KCORE
  0BDB'                         MR_DN:
  0BDB'   2F                    	CMA
  0BDC'   3C                    	INR	A		; A = target - row now
  0BDD'   6F                    	MOV	L,A
  0BDE'   26 00                 	MVI	H,0
  0BE0'   C3 0789'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0BE3'                         VC_HIGH:
  0BE3'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0BE6'   2B                    	DCX	H		; row = count - 1
  0BE7'   7C                    	MOV	A,H
  0BE8'   B7                    	ORA	A
  0BE9'   3A 0000*              	LDA	SCBOT
  0BEC'   C2 0BF4'              	JNZ	VH_GO		; >= 256 -> the last text row
  0BEF'   BD                    	CMP	L		; CY iff SCBOT < row
  0BF0'   DA 0BF4'              	JC	VH_GO
  0BF3'   7D                    	MOV	A,L
  0BF4'                         VH_GO:
  0BF4'   CD 0BCC'              	CALL	MVROW
  0BF7'   C3 06DB'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0BFA'                         VC_MIDL:
  0BFA'   CD 058D'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0BFD'   3A 0000*              	LDA	SCBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


  0C00'   B7                    	ORA	A		; clear CY for the shift
  0C01'   1F                    	RAR			; A = SCBOT / 2
  0C02'   CD 0BCC'              	CALL	MVROW
  0C05'   C3 06DB'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0C08'                         VC_LOWL:
  0C08'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0C0B'   2B                    	DCX	H		; count - 1
  0C0C'   3A 0000*              	LDA	SCBOT
  0C0F'   5F                    	MOV	E,A
  0C10'   16 00                 	MVI	D,0
  0C12'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0C13'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0C16'   3E 00                 	MVI	A,0
  0C18'   D2 0C1F'              	JNC	VL_GO		; at or past the top -> row 0
  0C1B'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0C1E'   7D                    	MOV	A,L
  0C1F'                         VL_GO:
  0C1F'   CD 0BCC'              	CALL	MVROW
  0C22'   C3 06DB'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0C25'                         VC_PGDN:
  0C25'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0C28'   3A 0000*              	LDA	SCEOF
  0C2B'   B7                    	ORA	A
  0C2C'   CA 0C3A'              	JZ	VPD_N
  0C2F'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0C32'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0C33'   C8                    	RZ			; it already is
  0C34'   CD 0BCC'              	CALL	MVROW
  0C37'   C3 0C4B'              	JMP	VPD_TP
  0C3A'                         VPD_N:
  0C3A'   3A 0000*              	LDA	NEDIT
  0C3D'   D6 02                 	SUI	2
  0C3F'   CD 0C93'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0C42'   E5                    	PUSH	H
  0C43'   AF                    	XRA	A
  0C44'   CD 0BCC'              	CALL	MVROW		; the top line
  0C47'   E1                    	POP	H
  0C48'   CD 0789'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0C4B'                         VPD_TP:
  0C4B'   AF                    	XRA	A
  0C4C'   CD 0BBE'              	CALL	SETRWT		; to the top row
  0C4F'   C3 06DB'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C52'                         VC_PGUP:
  0C52'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  0C55'   3A 0000*              	LDA	SCBOF
  0C58'   B7                    	ORA	A
  0C59'   C0                    	RNZ
  0C5A'   3A 0000*              	LDA	NEDIT
  0C5D'   47                    	MOV	B,A
  0C5E'   3A 0000*              	LDA	SCEOF
  0C61'   B7                    	ORA	A
  0C62'   CA 0C73'              	JZ	VPU_2
  0C65'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0C68'   FE 02                 	CPI	2
  0C6A'   D2 0C73'              	JNC	VPU_2
  0C6D'   2F                    	CMA
  0C6E'   3C                    	INR	A
  0C6F'   80                    	ADD	B
  0C70'   C3 0C76'              	JMP	VPU_P
  0C73'                         VPU_2:
  0C73'   78                    	MOV	A,B
  0C74'   D6 02                 	SUI	2
  0C76'                         VPU_P:
  0C76'   CD 0C93'              	CALL	MULSAT		; HL = count * page
  0C79'   E5                    	PUSH	H
  0C7A'   AF                    	XRA	A
  0C7B'   CD 0BCC'              	CALL	MVROW		; the top line
  0C7E'   E1                    	POP	H
  0C7F'   CD 0826'              	CALL	KCORE		; the new top line
  0C82'   AF                    	XRA	A
  0C83'   CD 0BBE'              	CALL	SETRWT		; on the top row
  0C86'   3A 0000*              	LDA	NEDIT
  0C89'   3D                    	DCR	A
  0C8A'   6F                    	MOV	L,A
  0C8B'   26 00                 	MVI	H,0
  0C8D'   CD 0789'              	CALL	JCORE		; the bottom row's line
  0C90'   C3 06DB'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0C93'                         MULSAT:
  0C93'   EB                    	XCHG
  0C94'   21 0000               	LXI	H,0
  0C97'   B7                    	ORA	A
  0C98'   C8                    	RZ
  0C99'                         MS_LP:
  0C99'   19                    	DAD	D
  0C9A'   DA 0CA2'              	JC	MS_SAT
  0C9D'   3D                    	DCR	A
  0C9E'   C2 0C99'              	JNZ	MS_LP
  0CA1'   C9                    	RET
  0CA2'                         MS_SAT:
  0CA2'   21 FFFF               	LXI	H,0FFFFH
  0CA5'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CA6'                         VC_HFDN:
  0CA6'   CD 060D'              	CALL	SETMOV
  0CA9'   CD 0B9F'              	CALL	CURRW
  0CAC'   32 23EE'              	STA	HFROW
  0CAF'   CD 0D1D'              	CALL	HFCNT		; HL = lines
  0CB2'   3A 23EE'              	LDA	HFROW
  0CB5'   47                    	MOV	B,A
  0CB6'   3A 0000*              	LDA	SCEOF
  0CB9'   B7                    	ORA	A
  0CBA'   CA 0CC2'              	JZ	VHD_GO
  0CBD'   3A 0000*              	LDA	SCBOT		; the last line's row
  0CC0'   B8                    	CMP	B
  0CC1'   C8                    	RZ			; the cursor is on it
  0CC2'                         VHD_GO:
  0CC2'   CD 0789'              	CALL	JCORE
  0CC5'   3A 0000*              	LDA	SCEOF
  0CC8'   B7                    	ORA	A
  0CC9'   C2 06DB'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0CCC'   3A 23EE'              	LDA	HFROW
  0CCF'   CD 0BBE'              	CALL	SETRWT
  0CD2'   3E 01                 	MVI	A,1
  0CD4'   32 0000*              	STA	WFILL		; not past the end of the file
  0CD7'   C3 06DB'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0CDA'                         VC_HFUP:
  0CDA'   CD 060D'              	CALL	SETMOV
  0CDD'   CD 0B9F'              	CALL	CURRW
  0CE0'   32 23EE'              	STA	HFROW
  0CE3'   CD 0D1D'              	CALL	HFCNT		; HL = lines
  0CE6'   CD 0CFD'              	CALL	ONFST
  0CE9'   C8                    	RZ			; the cursor is on the first line
  0CEA'   CD 0826'              	CALL	KCORE
  0CED'   3A 0000*              	LDA	SCBOF
  0CF0'   B7                    	ORA	A
  0CF1'   C2 06DB'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0CF4'   3A 23EE'              	LDA	HFROW
  0CF7'   CD 0BBE'              	CALL	SETRWT
  0CFA'   C3 06DB'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0CFD'                         ONFST:
  0CFD'   E5                    	PUSH	H
  0CFE'   2A 0000*              	LHLD	OUTPOS
  0D01'   7C                    	MOV	A,H
  0D02'   B5                    	ORA	L
  0D03'   C2 0D1B'              	JNZ	OF_RET
  0D06'   2A 0000*              	LHLD	TXTBEG
  0D09'   EB                    	XCHG			; DE = TXTBEG
  0D0A'   2A 0000*              	LHLD	GAPBEG
  0D0D'                         OF_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D0D'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0D10'   CA 0D1B'              	JZ	OF_RET
  0D13'   2B                    	DCX	H
  0D14'   7E                    	MOV	A,M
  0D15'   FE 0A                 	CPI	LF
  0D17'   C2 0D0D'              	JNZ	OF_LP
  0D1A'   B7                    	ORA	A		; NZ
  0D1B'                         OF_RET:
  0D1B'   E1                    	POP	H
  0D1C'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0D1D'                         HFCNT:
  0D1D'   2A 23E2'              	LHLD	CMDCNT
  0D20'   7C                    	MOV	A,H
  0D21'   B5                    	ORA	L
  0D22'   CA 0D39'              	JZ	HFC_AM
  0D25'   CD 05A0'              	CALL	GETCNT		; HL = count; clears it
  0D28'   3A 0000*              	LDA	NEDIT
  0D2B'   5F                    	MOV	E,A
  0D2C'   16 00                 	MVI	D,0
  0D2E'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0D31'   D2 0D35'              	JNC	HFC_ST
  0D34'   EB                    	XCHG			; HL = NEDIT
  0D35'                         HFC_ST:
  0D35'   7D                    	MOV	A,L
  0D36'   32 23EF'              	STA	HFAMT
  0D39'                         HFC_AM:
  0D39'   3A 23EF'              	LDA	HFAMT
  0D3C'   B7                    	ORA	A
  0D3D'   C2 0D4A'              	JNZ	HFC_HL
  0D40'   3A 0000*              	LDA	NEDIT
  0D43'   B7                    	ORA	A
  0D44'   1F                    	RAR
  0D45'   B7                    	ORA	A
  0D46'   C2 0D4A'              	JNZ	HFC_HL
  0D49'   3C                    	INR	A		; at least one line
  0D4A'                         HFC_HL:
  0D4A'   6F                    	MOV	L,A
  0D4B'   26 00                 	MVI	H,0
  0D4D'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0D4E'                         VC_REDR:
  0D4E'   C3 05A0'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0D51'                         VC_G:
  0D51'   CD 060D'              	CALL	SETMOV
  0D54'   CD 0DE4'              	CALL	GZONE		; the screen's top line, before the move
  0D57'   2A 23E2'              	LHLD	CMDCNT
  0D5A'   7C                    	MOV	A,H
  0D5B'   B5                    	ORA	L
  0D5C'   C2 0D69'              	JNZ	VG_N
  0D5F'   AF                    	XRA	A		; forward
  0D60'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0D63'   CD 08BD'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0D66'   C3 0DFC'              	JMP	GPLACE
  0D69'                         VG_N:
  0D69'   CD 05A0'              	CALL	GETCNT		; HL = target line (1-based)
  0D6C'                         VG_LN:
  0D6C'   CD 0D72'              	CALL	GOLN
  0D6F'   C3 0DFC'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0D72'                         GOLN:
  0D72'   2B                    	DCX	H		; lines to move from line 1
  0D73'   E5                    	PUSH	H
  0D74'   3E FF                 	MVI	A,0FFH
  0D76'   CD 0000*              	CALL	MVLMAX		; to BOF
  0D79'   E1                    	POP	H
  0D7A'   AF                    	XRA	A
  0D7B'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0D7E'   CD 08B7'              	CALL	ATEOF
  0D81'   DC 08BD'              	CC	LASTLN		; past the last line: onto it
  0D84'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0D85'                         VC_LG:
  0D85'   CD 060D'              	CALL	SETMOV
  0D88'   3A 240A'              	LDA	GSAVE
  0D8B'   B7                    	ORA	A
  0D8C'   C2 0D95'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0D8F'   3E 01                 	MVI	A,PG
  0D91'   32 2409'              	STA	GPEND
  0D94'   C9                    	RET
  0D95'                         VLG_GG:
  0D95'   CD 0DE4'              	CALL	GZONE
  0D98'   CD 05A0'              	CALL	GETCNT		; HL = target line (no count: 1)
  0D9B'   C3 0D6C'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D9E'                         FPOS:
  0D9E'   C5                    	PUSH	B
  0D9F'   D5                    	PUSH	D
  0DA0'   EB                    	XCHG
  0DA1'   2A 0000*              	LHLD	TXTBEG
  0DA4'   EB                    	XCHG
  0DA5'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0DA8'   EB                    	XCHG			; DE = that
  0DA9'   2A 0000*              	LHLD	OUTPOS
  0DAC'   7C                    	MOV	A,H
  0DAD'   B7                    	ORA	A		; CY = 0
  0DAE'   1F                    	RAR
  0DAF'   47                    	MOV	B,A
  0DB0'   7D                    	MOV	A,L
  0DB1'   1F                    	RAR
  0DB2'   67                    	MOV	H,A
  0DB3'   3E 00                 	MVI	A,0
  0DB5'   1F                    	RAR
  0DB6'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0DB7'   19                    	DAD	D
  0DB8'   78                    	MOV	A,B
  0DB9'   CE 00                 	ACI	0		; A:HL = the position
  0DBB'   D1                    	POP	D
  0DBC'   C1                    	POP	B
  0DBD'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0DBE'                         ZSAVE:
  0DBE'   2A 23E2'              	LHLD	CMDCNT
  0DC1'   22 243C'              	SHLD	ZSVCNT
  0DC4'   2A 0000*              	LHLD	AUXCNT
  0DC7'   22 243E'              	SHLD	ZSVAUX
  0DCA'   3A 0000*              	LDA	DIRFLG
  0DCD'   32 2440'              	STA	ZSVDIR
  0DD0'   C9                    	RET
  0DD1'                         ZREST:
  0DD1'   2A 243C'              	LHLD	ZSVCNT
  0DD4'   22 23E2'              	SHLD	CMDCNT
  0DD7'   2A 243E'              	LHLD	ZSVAUX
  0DDA'   22 0000*              	SHLD	AUXCNT
  0DDD'   3A 2440'              	LDA	ZSVDIR
  0DE0'   32 0000*              	STA	DIRFLG
  0DE3'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0DE4'                         GZONE:
  0DE4'   CD 0DBE'              	CALL	ZSAVE
  0DE7'   CD 0B9F'              	CALL	CURRW
  0DEA'   6F                    	MOV	L,A
  0DEB'   26 00                 	MVI	H,0
  0DED'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0DF0'   CD 0D9E'              	CALL	FPOS
  0DF3'   22 0000*              	SHLD	ZTOP
  0DF6'   32 0002*              	STA	ZTOP+2
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DF9'   C3 0DD1'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0DFC'                         GPLACE:
  0DFC'   CD 0DBE'              	CALL	ZSAVE
  0DFF'   2A 0000*              	LHLD	GAPBEG
  0E02'   CD 0D9E'              	CALL	FPOS
  0E05'   EB                    	XCHG
  0E06'   4F                    	MOV	C,A		; C:DE = the target's position
  0E07'   2A 0000*              	LHLD	ZTOP
  0E0A'   7B                    	MOV	A,E
  0E0B'   95                    	SUB	L
  0E0C'   6F                    	MOV	L,A
  0E0D'   7A                    	MOV	A,D
  0E0E'   9C                    	SBB	H
  0E0F'   67                    	MOV	H,A
  0E10'   22 2439'              	SHLD	ZDIF
  0E13'   3A 0002*              	LDA	ZTOP+2
  0E16'   47                    	MOV	B,A
  0E17'   79                    	MOV	A,C
  0E18'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0E19'   DA 0E66'              	JC	GP_UP
  0E1C'   B7                    	ORA	A
  0E1D'   C2 0EA7'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0E20'   3A 0000*              	LDA	NEDIT
  0E23'   5F                    	MOV	E,A
  0E24'   16 00                 	MVI	D,0
  0E26'   B7                    	ORA	A
  0E27'   1F                    	RAR
  0E28'   6F                    	MOV	L,A
  0E29'   26 00                 	MVI	H,0
  0E2B'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0E2C'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0E2F'   CD 0599'              	CALL	GBSUB		; HL = bytes from there to the target
  0E32'   EB                    	XCHG
  0E33'   2A 2439'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0E36'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0E39'   DA 0EA7'              	JC	GP_MID
  0E3C'   CD 0599'              	CALL	GBSUB		; HL = the top line's start (resident)
  0E3F'   01 0000               	LXI	B,0		; BC = lines from the top
  0E42'                         GP_CNT:
  0E42'   7A                    	MOV	A,D
  0E43'   B3                    	ORA	E
  0E44'   CA 0E53'              	JZ	GP_DN
  0E47'   7E                    	MOV	A,M
  0E48'   23                    	INX	H
  0E49'   1B                    	DCX	D
  0E4A'   FE 0A                 	CPI	LF
  0E4C'   C2 0E42'              	JNZ	GP_CNT
  0E4F'   03                    	INX	B
  0E50'   C3 0E42'              	JMP	GP_CNT
  0E53'                         GP_DN:
  0E53'   3A 0000*              	LDA	NEDIT
  0E56'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E57'   5F                    	MOV	E,A
  0E58'   16 00                 	MVI	D,0		; DE = the bottom row
  0E5A'   60                    	MOV	H,B
  0E5B'   69                    	MOV	L,C
  0E5C'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0E5F'   DA 0EB1'              	JC	GP_SET		; A = the bottom row
  0E62'   7D                    	MOV	A,L		; on the screen: its row
  0E63'   C3 0ED1'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0E66'                         GP_UP:
  0E66'   3C                    	INR	A
  0E67'   C2 0EA7'              	JNZ	GP_MID		; 64K bytes or more above
  0E6A'   2A 2439'              	LHLD	ZDIF
  0E6D'   EB                    	XCHG
  0E6E'   21 0000               	LXI	H,0
  0E71'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0E74'   7C                    	MOV	A,H
  0E75'   B5                    	ORA	L
  0E76'   CA 0EA7'              	JZ	GP_MID		; exactly 64K
  0E79'   EB                    	XCHG			; DE = bytes to read
  0E7A'   AF                    	XRA	A
  0E7B'   32 243B'              	STA	ZLF
  0E7E'   CD 0000*              	CALL	RGET0
  0E81'                         GP_RD:
  0E81'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0E84'   DA 0EA7'              	JC	GP_MID
  0E87'   FE 0A                 	CPI	LF
  0E89'   C2 0E9D'              	JNZ	GP_RN
  0E8C'   3A 0000*              	LDA	NEDIT
  0E8F'   B7                    	ORA	A
  0E90'   1F                    	RAR
  0E91'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0E93'   E5                    	PUSH	H
  0E94'   21 243B'              	LXI	H,ZLF
  0E97'   34                    	INR	M
  0E98'   BE                    	CMP	M		; CY iff more lines than that
  0E99'   E1                    	POP	H
  0E9A'   DA 0EA7'              	JC	GP_MID
  0E9D'                         GP_RN:
  0E9D'   1B                    	DCX	D
  0E9E'   7A                    	MOV	A,D
  0E9F'   B3                    	ORA	E
  0EA0'   C2 0E81'              	JNZ	GP_RD
  0EA3'   AF                    	XRA	A		; the top row
  0EA4'   C3 0EB1'              	JMP	GP_SET
  0EA7'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0EA7'   3E 01                 	MVI	A,1
  0EA9'   32 0000*              	STA	WFILL		; not past the end of the file
  0EAC'   3A 0000*              	LDA	NEDIT
  0EAF'   B7                    	ORA	A
  0EB0'   1F                    	RAR			; the middle row
  0EB1'                         GP_SET:
  0EB1'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0EB2'   26 00                 	MVI	H,0
  0EB4'   22 0000*              	SHLD	WINROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0EB7'   21 0000               	LXI	H,0
  0EBA'   22 0000*              	SHLD	LNDLT
  0EBD'   CD 062E'              	CALL	SETFUL		; the window may have paged: full repaint
  0EC0'                         GP_FIN:
  0EC0'   CD 0DD1'              	CALL	ZREST
  0EC3'   3A 2463'              	LDA	GPKEEP
  0EC6'   B7                    	ORA	A
  0EC7'   CA 06DB'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0ECA'   AF                    	XRA	A
  0ECB'   32 2463'              	STA	GPKEEP
  0ECE'   C3 0492'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0ED1'                         GP_ONS:
  0ED1'   6F                    	MOV	L,A
  0ED2'   26 00                 	MVI	H,0		; HL = the row it lands on
  0ED4'   EB                    	XCHG
  0ED5'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0ED8'   EB                    	XCHG
  0ED9'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0EDC'   22 0000*              	SHLD	LNDLT
  0EDF'   3E 01                 	MVI	A,R_MOVE
  0EE1'   32 23E6'              	STA	RINTENT
  0EE4'   C3 0EC0'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0EE7'                         OPPEND:
  0EE7'   AF                    	XRA	A
  0EE8'   32 240F'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0EEB'   3A 240C'              	LDA	PSAVE
  0EEE'   FE 63                 	CPI	'c'
  0EF0'   C2 0F0D'              	JNZ	OPP_ND
  0EF3'   79                    	MOV	A,C
  0EF4'   FE 77                 	CPI	'w'
  0EF6'   CA 0EFE'              	JZ	OPP_W
  0EF9'   FE 57                 	CPI	'W'
  0EFB'   C2 0F0D'              	JNZ	OPP_ND
  0EFE'                         OPP_W:
  0EFE'   CD 0F87'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0F01'   DA 0F0D'              	JC	OPP_ND
  0F04'   79                    	MOV	A,C
  0F05'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0F07'   4F                    	MOV	C,A
  0F08'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0F0A'   32 240F'              	STA	CWEOL		;   see the clamp in OPA_F
  0F0D'                         OPP_ND:
  0F0D'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0F0E'   21 240C'              	LXI	H,PSAVE
  0F11'   BE                    	CMP	M
  0F12'   CA 0FA8'              	JZ	OPLINE
  0F15'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0F16'   CD 0FB8'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0F19'   DA 0F84'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0F1C'   32 240E'              	STA	OPCLSV
  0F1F'   47                    	MOV	B,A		; B = the class
  0F20'   3A 240C'              	LDA	PSAVE
  0F23'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0F25'   C2 0F31'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0F28'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0F29'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0F2B'   C2 0F53'              	JNZ	OPP_GO
  0F2E'   C3 0F3C'              	JMP	OPP_NO
  0F31'                         OPP_NC:
  0F31'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0F33'   C2 0F53'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0F36'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0F37'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0F39'   CA 0F53'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0F3C'                         OPP_NO:
  0F3C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0F3D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0F3F'   CA 0F4D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  0F42'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  0F44'   CA 0F4D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  0F47'   CD 034B'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  0F4A'   C2 0F84'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  0F4D'                         OPP_SW:
  0F4D'   CD 021B'              	CALL	MKGETK
  0F50'   C3 0F84'              	JMP	OPABRT
  0F53'                         OPP_GO:
  0F53'   AF                    	XRA	A
  0F54'   32 23ED'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0F57'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F5A'   22 2410'              	SHLD	OPSTA
  0F5D'   21 2310'              	LXI	H,CMDTAB
  0F60'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0F63'   3A 240C'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  0F66'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0F67'   CA 060D'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0F6A'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0F6D'   22 2412'              	SHLD	OPEND2
  0F70'   3A 240C'              	LDA	PSAVE
  0F73'   FE 79                 	CPI	'y'
  0F75'   CA 1458'              	JZ	OPYANK		; a yank takes the span without losing it
  0F78'   CD 0FF3'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0F7B'   3A 240C'              	LDA	PSAVE
  0F7E'   FE 63                 	CPI	'c'
  0F80'   C0                    	RNZ
  0F81'   C3 121F'              	JMP	SETINS
  0F84'                         OPABRT:
  0F84'   C3 060D'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0F87'                         ONWHIT:
  0F87'   CD 057C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0F8A'   CA 0FA6'              	JZ	OW_YES
  0F8D'   CD 0587'              	CALL	CURCHR		; A = the char under the cursor
  0F90'   FE 20                 	CPI	' '
  0F92'   CA 0FA6'              	JZ	OW_YES
  0F95'   FE 09                 	CPI	TAB
  0F97'   CA 0FA6'              	JZ	OW_YES
  0F9A'   FE 0D                 	CPI	CR
  0F9C'   CA 0FA6'              	JZ	OW_YES
  0F9F'   FE 0A                 	CPI	LF
  0FA1'   CA 0FA6'              	JZ	OW_YES
  0FA4'   B7                    	ORA	A		; a char to change: CY clear
  0FA5'   C9                    	RET
  0FA6'                         OW_YES:
  0FA6'   37                    	STC
  0FA7'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  0FA8'                         OPLINE:
  0FA8'   3A 240C'              	LDA	PSAVE
  0FAB'   FE 63                 	CPI	'c'
  0FAD'   CA 060D'              	JZ	SETMOV
  0FB0'   FE 79                 	CPI	'y'
  0FB2'   CA 143D'              	JZ	VY_YY
  0FB5'   C3 13C2'              	JMP	VD_DD
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  0FB8'                         OPCLS:
  0FB8'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  0FBA'   CA 0FC7'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  0FBD'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  0FBF'   C2 0FDB'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  0FC2'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  0FC4'   C3 0FC9'              	JMP	OPC_FK
  0FC7'                         OPC_SEM:
  0FC7'   06 00                 	MVI	B,0		; ';' runs it as it stands
  0FC9'                         OPC_FK:
  0FC9'   3A 2459'              	LDA	FNDKND
  0FCC'   B7                    	ORA	A
  0FCD'   37                    	STC
  0FCE'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  0FCF'   A8                    	XRA	B		; ... and now the direction ',' asked for
  0FD0'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  0FD2'   CA 0FD9'              	JZ	OPC_EXC
  0FD5'   3E 01                 	MVI	A,1
  0FD7'   B7                    	ORA	A		; CY clear: a motion, class 1
  0FD8'   C9                    	RET
  0FD9'                         OPC_EXC:
  0FD9'   AF                    	XRA	A		; class 0, CY clear
  0FDA'   C9                    	RET
  0FDB'                         OPC_TB:
  0FDB'   47                    	MOV	B,A
  0FDC'   21 1115'              	LXI	H,OPCTAB
  0FDF'                         OPC_LP:
  0FDF'   7E                    	MOV	A,M
  0FE0'   B7                    	ORA	A
  0FE1'   CA 0FF1'              	JZ	OPC_MS		; end of table -> not a motion
  0FE4'   B8                    	CMP	B
  0FE5'   CA 0FED'              	JZ	OPC_HT
  0FE8'   23                    	INX	H
  0FE9'   23                    	INX	H
  0FEA'   C3 0FDF'              	JMP	OPC_LP
  0FED'                         OPC_HT:
  0FED'   23                    	INX	H
  0FEE'   7E                    	MOV	A,M		; class byte
  0FEF'   B7                    	ORA	A		; clear CY
  0FF0'   C9                    	RET
  0FF1'                         OPC_MS:
  0FF1'   37                    	STC
  0FF2'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  0FF3'                         OPAPPL:
  0FF3'   3A 240E'              	LDA	OPCLSV
  0FF6'   FE 02                 	CPI	2
  0FF8'   CA 10F9'              	JZ	OPALIN		; linewise
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                	;--- charwise: order the endpoints, adjust for inclusive ---
  0FFB'   2A 2410'              	LHLD	OPSTA
  0FFE'   EB                    	XCHG			; DE = start
  0FFF'   2A 2412'              	LHLD	OPEND2		; HL = end
  1002'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1005'   DA 1015'              	JC	OPA_F
  1008'   CA 1015'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  100B'   22 2414'              	SHLD	OPLO
  100E'   EB                    	XCHG
  100F'   22 2416'              	SHLD	OPHI
  1012'   C3 106D'              	JMP	OPA_DO
  1015'                         OPA_F:
  1015'   EB                    	XCHG			; HL = start, DE = end
  1016'   22 2414'              	SHLD	OPLO
  1019'   EB                    	XCHG			; HL = end
  101A'   3A 240E'              	LDA	OPCLSV
  101D'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  101F'   CA 106A'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  1022'   FE 01                 	CPI	1
  1024'   C2 1046'              	JNZ	OPA_EX
  1027'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  1028'   3A 240F'              	LDA	CWEOL
  102B'   B7                    	ORA	A
  102C'   CA 106A'              	JZ	OPA_HI
  102F'   22 2416'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  1032'   2A 2414'              	LHLD	OPLO
  1035'   CD 119D'              	CALL	CEND		; HL = the start line's content end
  1038'   EB                    	XCHG			; DE = that content end
  1039'   2A 2416'              	LHLD	OPHI		; HL = hi
  103C'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  103F'   D2 106A'              	JNC	OPA_HI		; hi is inside the line: keep it
  1042'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1043'   C3 106A'              	JMP	OPA_HI
  1046'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1046'   22 2416'              	SHLD	OPHI		; the motion's own end, for now
  1049'   2A 2414'              	LHLD	OPLO
  104C'   CD 119D'              	CALL	CEND		; HL = the start line's content end
  104F'   EB                    	XCHG			; DE = that content end
  1050'   3A 23ED'              	LDA	WPULL		; the motion landed on a line's end and was
  1053'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1054'   C2 1060'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1057'   2A 2416'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  105A'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  105D'   D2 106D'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1060'                         OPA_CE:				;   deletes the word, not all but its last char
  1060'   2A 2414'              	LHLD	OPLO
  1063'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1066'   CA 10AB'              	JZ	OPA_LN
  1069'   EB                    	XCHG			; HL = the content end
  106A'                         OPA_HI:
  106A'   22 2416'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  106D'                         OPA_DO:
  106D'   CD 1091'              	CALL	OPDSPN
  1070'   3A 240C'              	LDA	PSAVE
  1073'   FE 63                 	CPI	'c'
  1075'   C8                    	RZ
  1076'   C3 11AE'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1079'                         SPNBRK:
  1079'   2A 2414'              	LHLD	OPLO
  107C'   CD 050C'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  107F'   EB                    	XCHG			; DE = it
  1080'   2A 2416'              	LHLD	OPHI
  1083'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1086'                         OPSPNL:
  1086'   2A 2416'              	LHLD	OPHI
  1089'   EB                    	XCHG
  108A'   2A 2414'              	LHLD	OPLO
  108D'   EB                    	XCHG			; HL = hi, DE = lo
  108E'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  1091'                         OPDSPN:
  1091'   CD 1079'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1094'   F5                    	PUSH	PSW
  1095'   2A 2414'              	LHLD	OPLO
  1098'   CD 0000*              	CALL	GOTO
  109B'   CD 1086'              	CALL	OPSPNL		; HL = hi - lo
  109E'   CD 0000*              	CALL	DELFWD
  10A1'   CD 0188'              	CALL	MARKMOD
  10A4'   F1                    	POP	PSW
  10A5'   DA 062E'              	JC	SETFUL		; a break went: every row below it moved up
  10A8'   C3 0613'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  10AB'                         OPA_LN:
  10AB'   3A 240C'              	LDA	PSAVE
  10AE'   FE 63                 	CPI	'c'
  10B0'   C2 10B9'              	JNZ	OPA_LD
  10B3'   2A 2414'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  10B6'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  10B9'                         OPA_LD:
  10B9'   2A 2414'              	LHLD	OPLO
  10BC'   22 2410'              	SHLD	OPSTA
  10BF'   22 2412'              	SHLD	OPEND2
  10C2'   C3 10F9'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  10C5'                         OPALSP:
  10C5'   2A 2410'              	LHLD	OPSTA
  10C8'   EB                    	XCHG
  10C9'   2A 2412'              	LHLD	OPEND2
  10CC'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  10CF'   DA 10DC'              	JC	OPAL_F
  10D2'   22 2414'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  10D5'   EB                    	XCHG
  10D6'   22 2416'              	SHLD	OPHI		; hi-src = start
  10D9'   C3 10E6'              	JMP	OPAL_R
  10DC'                         OPAL_F:
  10DC'   EB                    	XCHG			; HL = start
  10DD'   22 2414'              	SHLD	OPLO		; lo-src = start
  10E0'   2A 2412'              	LHLD	OPEND2
  10E3'   22 2416'              	SHLD	OPHI		; hi-src = end
  10E6'                         OPAL_R:
  10E6'   2A 2414'              	LHLD	OPLO
  10E9'   CD 04F9'              	CALL	BOL
  10EC'   22 2414'              	SHLD	OPLO		; lo = BOL(low line)
  10EF'   2A 2416'              	LHLD	OPHI
  10F2'   CD 0529'              	CALL	NLSTART
  10F5'   22 2416'              	SHLD	OPHI		; hi = start of line past the high line
  10F8'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  10F9'                         OPALIN:
  10F9'   CD 10C5'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  10FC'                         OPDLIN:
  10FC'   CD 1091'              	CALL	OPDSPN
  10FF'   CD 057C'              	CALL	ATENDQ		; CY iff the cursor is short of the end
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1102'   DA 1112'              	JC	OPDL_NB
  1105'   CD 0000*              	CALL	LOGLEN
  1108'   7C                    	MOV	A,H
  1109'   B5                    	ORA	L
  110A'   C8                    	RZ			; empty buffer
  110B'   2B                    	DCX	H
  110C'   CD 04F9'              	CALL	BOL
  110F'   CD 0000*              	CALL	GOTO
  1112'                         OPDL_NB:
  1112'   C3 06DB'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1115'                         OPCTAB:
  1115'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1119'   62 00 42 00           
  111D'   68 00 6C 00           
  1121'   30 00 5E 00           
  1125'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1127'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  112B'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  112F'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1133'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1137'   24 01                 
  1139'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  113D'   47 02 48 02           
  1141'   4D 02 4C 02           
  1145'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1147'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1148'                         VCB_C:
  1148'   CD 1154'              	CALL	VCB_CD
  114B'   C3 121F'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  114E'                         VCB_D:
  114E'   CD 1154'              	CALL	VCB_CD
  1151'   C3 11AE'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1154'                         VCB_CD:
  1154'   CD 0593'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1157'   22 2414'              	SHLD	OPLO
  115A'   CD 0000*              	CALL	CUROFF
  115D'   CD 119D'              	CALL	CEND		; to the line's content end, the CR,LF left
  1160'   22 2416'              	SHLD	OPHI
  1163'   C3 1091'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1166'                         VC_X:
  1166'   CD 0780'              	CALL	GLSTAL
  1169'   CD 0613'              	CALL	SETLIN
  116C'   CD 05A0'              	CALL	GETCNT
  116F'   22 2418'              	SHLD	CNTV
  1172'   CD 0000*              	CALL	CUROFF
  1175'   22 241C'              	SHLD	WKI		; cur
  1178'   CD 119D'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  117B'   EB                    	XCHG			; DE = contentend
  117C'   2A 241C'              	LHLD	WKI		; HL = cur
  117F'   EB                    	XCHG			; HL = contentend, DE = cur
  1180'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1183'   7C                    	MOV	A,H
  1184'   B5                    	ORA	L
  1185'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1186'   EB                    	XCHG			; DE = available
  1187'   2A 2418'              	LHLD	CNTV		; HL = count
  118A'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  118D'   DA 1193'              	JC	VX_USEA
  1190'   C3 1194'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1193'                         VX_USEA:
  1193'   EB                    	XCHG			; HL = available
  1194'                         VX_DEL:
  1194'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1197'   CD 0188'              	CALL	MARKMOD
  119A'   C3 11AE'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  119D'                         CEND:
  119D'   CD 050C'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  11A0'   7C                    	MOV	A,H
  11A1'   B5                    	ORA	L
  11A2'   C8                    	RZ			; the start of the text: nothing before it
  11A3'   2B                    	DCX	H
  11A4'   E5                    	PUSH	H
  11A5'   CD 0000*              	CALL	CHARAT
  11A8'   E1                    	POP	H		; HL = term-1
  11A9'   FE 0D                 	CPI	CR
  11AB'   C8                    	RZ			; a CR before the LF -> the content ends there
  11AC'   23                    	INX	H
  11AD'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  11AE'                         CLAMPE:
  11AE'   CD 0000*              	CALL	CUROFF
  11B1'   E5                    	PUSH	H
  11B2'   CD 0538'              	CALL	EOLC
  11B5'   D1                    	POP	D		; DE = cur
  11B6'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  11B9'   D8                    	RC
  11BA'   C8                    	RZ
  11BB'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  11BE'                         VC_I:
  11BE'   CD 05A0'              	CALL	GETCNT
  11C1'   C3 121C'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  11C4'                         VC_A:
  11C4'   CD 05A0'              	CALL	GETCNT
  11C7'   CD 057C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11CA'   CA 11E1'              	JZ	VA_INS
  11CD'   EB                    	XCHG			; HL = cur
  11CE'   E5                    	PUSH	H
  11CF'   CD 0000*              	CALL	CHARAT
  11D2'   E1                    	POP	H
  11D3'   FE 0A                 	CPI	LF
  11D5'   CA 11E1'              	JZ	VA_INS		; on the line terminator -> append in place
  11D8'   FE 0D                 	CPI	CR
  11DA'   CA 11E1'              	JZ	VA_INS
  11DD'   23                    	INX	H
  11DE'   CD 0000*              	CALL	GOTO
  11E1'                         VA_INS:
  11E1'   C3 121C'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  11E4'                         VCB_A:
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11E4'   CD 0593'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  11E7'   CD 0538'              	CALL	EOLC		; HL = last content char (the start when empty)
  11EA'   E5                    	PUSH	H
  11EB'   CD 0000*              	CALL	CHARAT
  11EE'   E1                    	POP	H
  11EF'   FE 0D                 	CPI	CR
  11F1'   CA 11FA'              	JZ	VBA_IN		; an empty line: insert at its start
  11F4'   FE 0A                 	CPI	LF
  11F6'   CA 11FA'              	JZ	VBA_IN
  11F9'   23                    	INX	H		; past the last content char
  11FA'                         VBA_IN:
  11FA'   CD 0000*              	CALL	GOTO
  11FD'   C3 121C'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1200'                         VCB_I:
  1200'   CD 05A0'              	CALL	GETCNT
  1203'   CD 06DB'              	CALL	FNBLNK
  1206'   CD 0000*              	CALL	CUROFF
  1209'   E5                    	PUSH	H
  120A'   CD 0000*              	CALL	CHARAT
  120D'   E1                    	POP	H
  120E'   FE 20                 	CPI	' '
  1210'   CA 1218'              	JZ	VBI_SK
  1213'   FE 09                 	CPI	TAB
  1215'   C2 121C'              	JNZ	SETINM
  1218'                         VBI_SK:
  1218'   23                    	INX	H		; blanks only: past the last of them
  1219'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  121C'                         SETINM:
  121C'   CD 060D'              	CALL	SETMOV
  121F'                         SETINS:
  121F'   3E 01                 	MVI	A,EM_INS
  1221'   32 23E1'              	STA	EDMODE
  1224'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1225'                         ATCEND:
  1225'   CD 057C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1228'   C8                    	RZ
  1229'   CD 0587'              	CALL	CURCHR		; A = the char under the cursor
  122C'   FE 0D                 	CPI	CR
  122E'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  122F'   FE 0A                 	CPI	LF
  1231'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1232'                         OPNBRK:
  1232'   3E 0D                 	MVI	A,CR
  1234'   CD 0000*              	CALL	PUTGAP
  1237'   3E 0A                 	MVI	A,LF
  1239'   CD 0000*              	CALL	PUTGAP
  123C'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  123F'   23                    	INX	H
  1240'   22 0000*              	SHLD	LNDLT
  1243'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1246'                         ENDBRK:
  1246'   CD 057C'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1249'   C0                    	RNZ
  124A'   CD 1232'              	CALL	OPNBRK
  124D'   CD 0000*              	CALL	CUROFF
  1250'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1251'   2B                    	DCX	H		;   line, with its own terminator after it
  1252'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1255'                         VC_O:
  1255'   CD 0593'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1258'   CD 119D'              	CALL	CEND
  125B'   CD 0000*              	CALL	GOTO
  125E'   CD 1232'              	CALL	OPNBRK
  1261'   CD 1246'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1264'   CD 0619'              	CALL	SETILN		;   needs a terminator of its own to exist
  1267'   C3 121F'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  126A'                         VCB_O:
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  126A'   CD 0593'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  126D'   CD 04F9'              	CALL	BOL
  1270'   CD 0000*              	CALL	GOTO
  1273'   CD 1232'              	CALL	OPNBRK
  1276'   CD 0000*              	CALL	CUROFF
  1279'   2B                    	DCX	H
  127A'   2B                    	DCX	H
  127B'   CD 0000*              	CALL	GOTO
  127E'   CD 0619'              	CALL	SETILN
  1281'   C3 121F'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1284'                         VCB_J:
  1284'   CD 0593'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1287'   CD 119D'              	CALL	CEND		; the join point: this line's content end
  128A'   22 2414'              	SHLD	OPLO
  128D'   CD 0000*              	CALL	CUROFF
  1290'   CD 0529'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1293'   E5                    	PUSH	H
  1294'   CD 0000*              	CALL	LOGLEN
  1297'   D1                    	POP	D		; DE = that start
  1298'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  129B'   CA 060D'              	JZ	SETMOV
  129E'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  129F'                         VJ_WS:
  129F'   E5                    	PUSH	H
  12A0'   CD 0000*              	CALL	LOGLEN
  12A3'   D1                    	POP	D		; DE = the scan
  12A4'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  12A7'   CA 12BE'              	JZ	VJ_DEL
  12AA'   EB                    	XCHG			; HL = the scan
  12AB'   E5                    	PUSH	H
  12AC'   CD 0000*              	CALL	CHARAT
  12AF'   E1                    	POP	H
  12B0'   FE 20                 	CPI	' '
  12B2'   CA 12BA'              	JZ	VJ_SKIP
  12B5'   FE 09                 	CPI	TAB
  12B7'   C2 12BE'              	JNZ	VJ_DEL
  12BA'                         VJ_SKIP:
  12BA'   23                    	INX	H
  12BB'   C3 129F'              	JMP	VJ_WS
  12BE'                         VJ_DEL:
  12BE'   22 2416'              	SHLD	OPHI
  12C1'   CD 1091'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  12C4'   CD 0628'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  12C7'   CD 057C'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  12CA'   CA 11AE'              	JZ	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12CD'   CD 0587'              	CALL	CURCHR		; the first char of what was appended
  12D0'   FE 0D                 	CPI	CR
  12D2'   CA 11AE'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  12D5'   FE 0A                 	CPI	LF
  12D7'   CA 11AE'              	JZ	CLAMPE
  12DA'   FE 29                 	CPI	')'
  12DC'   CA 11AE'              	JZ	CLAMPE		; vim puts no space before a ')'
  12DF'   CD 0000*              	CALL	CUROFF
  12E2'   7C                    	MOV	A,H
  12E3'   B5                    	ORA	L
  12E4'   CA 12FA'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  12E7'   2B                    	DCX	H
  12E8'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  12EB'   FE 20                 	CPI	' '
  12ED'   CA 11AE'              	JZ	CLAMPE
  12F0'   FE 09                 	CPI	TAB
  12F2'   CA 11AE'              	JZ	CLAMPE
  12F5'   FE 0A                 	CPI	LF
  12F7'   CA 11AE'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  12FA'                         VJ_SP:
  12FA'   3E 20                 	MVI	A,' '
  12FC'   CD 0000*              	CALL	PUTGAP
  12FF'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1302'   2B                    	DCX	H
  1303'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1306'                         VC_TILD:
  1306'   CD 05A0'              	CALL	GETCNT
  1309'   CD 0613'              	CALL	SETLIN		; only this row changes
  130C'   CD 0780'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  130F'   CD 057C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1312'   CA 060D'              	JZ	SETMOV
  1315'   CD 0587'              	CALL	CURCHR		; A = the char under the cursor
  1318'   FE 0D                 	CPI	CR
  131A'   CA 060D'              	JZ	SETMOV		; the line's end: nothing to toggle
  131D'   FE 0A                 	CPI	LF
  131F'   CA 060D'              	JZ	SETMOV
  1322'   47                    	MOV	B,A
  1323'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1325'   FE 41                 	CPI	'A'
  1327'   DA 1333'              	JC	VT_PUT		; below 'A': no case
  132A'   FE 5B                 	CPI	'Z'+1
  132C'   D2 1333'              	JNC	VT_PUT		; above 'Z': no case
  132F'   78                    	MOV	A,B
  1330'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1332'   47                    	MOV	B,A
  1333'                         VT_PUT:
  1333'   78                    	MOV	A,B
  1334'   32 2425'              	STA	VRCH		; the calls below do not preserve B
  1337'   CD 0188'              	CALL	MARKMOD
  133A'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  133D'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1340'   3A 2425'              	LDA	VRCH
  1343'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1346'   C3 11AE'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1349'                         VC_R:
  1349'   CD 058D'              	CALL	MOVCNT		; a cursor motion, and its count
  134C'   3E 03                 	MVI	A,PR
  134E'   32 2409'              	STA	GPEND
  1351'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1352'                         VR_DO:
  1352'   AF                    	XRA	A
  1353'   32 2409'              	STA	GPEND
  1356'   79                    	MOV	A,C
  1357'   32 2425'              	STA	VRCH		; the calls below do not preserve C
  135A'   CD 0613'              	CALL	SETLIN		; only this row changed
  135D'   CD 0780'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1360'   CD 057C'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1363'   CA 060D'              	JZ	SETMOV		; the end of the text: vim does nothing
  1366'   CD 0587'              	CALL	CURCHR		; A = the char under the cursor
  1369'   FE 0D                 	CPI	CR
  136B'   CA 060D'              	JZ	SETMOV		; the line's end: nothing to replace
  136E'   FE 0A                 	CPI	LF
  1370'   CA 060D'              	JZ	SETMOV
  1373'   CD 0188'              	CALL	MARKMOD
  1376'   21 0001               	LXI	H,1
  1379'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  137C'   3A 2425'              	LDA	VRCH
  137F'   FE 0D                 	CPI	CR
  1381'   CA 138E'              	JZ	VR_CR
  1384'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1387'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  138A'   2B                    	DCX	H		;   out, which moves every logical offset
  138B'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  138E'                         VR_CR:
  138E'   CD 1232'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1391'   CD 1246'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1394'   CD 0619'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1397'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1399'   32 23E9'              	STA	ILABOV
  139C'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  139D'                         VCB_R:
  139D'   CD 05A0'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13A0'   CD 060D'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  13A3'   21 0000               	LXI	H,0
  13A6'   22 2426'              	SHLD	RPDEL		; nothing of ours to put back yet
  13A9'   22 2428'              	SHLD	RPAPP
  13AC'   3E 02                 	MVI	A,EM_REP
  13AE'   32 23E1'              	STA	EDMODE
  13B1'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  13B2'                         VC_D:
  13B2'   3E 64                 	MVI	A,'d'
  13B4'   32 240B'              	STA	PENDOP
  13B7'   C3 060D'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  13BA'                         VC_C:
  13BA'   3E 63                 	MVI	A,'c'
  13BC'   32 240B'              	STA	PENDOP
  13BF'   C3 060D'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  13C2'                         VD_DD:
  13C2'   CD 0780'              	CALL	GLSTAL
  13C5'   CD 05A0'              	CALL	GETCNT
  13C8'   22 2418'              	SHLD	CNTV
  13CB'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  13CD'   32 240D'              	STA	DDSNG
  13D0'   2B                    	DCX	H
  13D1'   7C                    	MOV	A,H
  13D2'   B5                    	ORA	L
  13D3'   C2 13DE'              	JNZ	VDD_LS
  13D6'   3E 01                 	MVI	A,1
  13D8'   32 240D'              	STA	DDSNG
  13DB'   C3 13E4'              	JMP	VDD_GO
  13DE'                         VDD_LS:
  13DE'   CD 0746'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  13E1'   DA 060D'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  13E4'                         VDD_GO:
  13E4'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  13E7'   CD 06C4'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  13EA'   2A 2418'              	LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13ED'   CD 0000*              	CALL	SETC0
  13F0'                         VDD_FW:
  13F0'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  13F3'   CD 05B5'              	CALL	CNTTST
  13F6'   C2 13F0'              	JNZ	VDD_FW
  13F9'   CD 0188'              	CALL	MARKMOD
  13FC'   CD 08B7'              	CALL	ATEOF
  13FF'   D2 141A'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1402'   3E 00                 	MVI	A,0
  1404'   32 240D'              	STA	DDSNG		; deleted to the end: full repaint
  1407'   CD 0CFD'              	CALL	ONFST
  140A'   CA 06DB'              	JZ	FNBLNK		; nothing left before it
  140D'   21 0001               	LXI	H,1		; onto the new last line
  1410'   CD 0000*              	CALL	SETBWD
  1413'   2A 0000*              	LHLD	LNDLT
  1416'   2B                    	DCX	H
  1417'   22 0000*              	SHLD	LNDLT
  141A'                         VDD_UP:
  141A'   CD 06DB'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  141D'   3A 240D'              	LDA	DDSNG
  1420'   B7                    	ORA	A
  1421'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1422'   3E 03                 	MVI	A,R_DLIN
  1424'   32 23E6'              	STA	RINTENT
  1427'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1428'                         QEMPTY:
  1428'   2A 0000*              	LHLD	QBEG
  142B'   EB                    	XCHG
  142C'   2A 0000*              	LHLD	QEND
  142F'   7C                    	MOV	A,H
  1430'   BA                    	CMP	D
  1431'   C0                    	RNZ
  1432'   7D                    	MOV	A,L
  1433'   BB                    	CMP	E
  1434'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1435'                         VC_Y:
  1435'   3E 79                 	MVI	A,'y'
  1437'   32 240B'              	STA	PENDOP
  143A'   C3 060D'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  143D'                         VY_YY:
  143D'   CD 0000*              	CALL	CUROFF
  1440'   22 2449'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1443'   CD 04F9'              	CALL	BOL
  1446'   22 244B'              	SHLD	YPT		; where the lines come from, to put them back
  1449'   CD 155A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  144C'   CD 159D'              	CALL	YNCOPY		; copied where they lie, if that can be done
  144F'   D2 1561'              	JNC	YNDONE
  1452'   21 13C2'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1455'   C3 1481'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1458'                         OPYANK:
  1458'   CD 10C5'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  145B'   2A 2410'              	LHLD	OPSTA
  145E'   EB                    	XCHG			; DE = start
  145F'   2A 2412'              	LHLD	OPEND2		; HL = end
  1462'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1465'   D2 1469'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1468'   EB                    	XCHG			; ... otherwise the start is
  1469'                         OPY_LO:
  1469'   22 2449'              	SHLD	YOFF
  146C'   2A 2414'              	LHLD	OPLO
  146F'   22 244B'              	SHLD	YPT		; where the lines come from, to put them back
  1472'   CD 155A'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1475'   CD 1615'              	CALL	YNSPAN		; copied where they lie, if there is room
  1478'   D2 1561'              	JNC	YNDONE
  147B'   21 151E'              	LXI	H,YSPAN
  147E'   C3 1481'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1481'                         YKGO:
  1481'   22 246B'              	SHLD	YACT
  1484'   2A 244B'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1487'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1488'   2A 2449'              	LHLD	YOFF		;   survive this -- the put-back below can page
  148B'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  148E'   22 2471'              	SHLD	YCOL		;   them -- but a distance within the lines does
  1491'   3A 23E5'              	LDA	MODF
  1494'   32 2446'              	STA	YMODF
  1497'   3A 23FE'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  149A'   32 2447'              	STA	YDCHG		;   a yank must not become the last change
  149D'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  14A0'   32 2448'              	STA	YURPL		;   back are not a change to undo either
  14A3'   3E 01                 	MVI	A,1
  14A5'   32 0000*              	STA	UNDRPL
  14A8'   32 246A'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  14AB'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  14AE'   22 2454'              	SHLD	YLDLT
  14B1'   CD 0000*              	CALL	LOGLEN
  14B4'   22 246F'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  14B7'   2A 246B'              	LHLD	YACT
  14BA'   CD 151D'              	CALL	YCALL		; the lines out of the file, into the register
  14BD'   CD 0000*              	CALL	LOGLEN
  14C0'   EB                    	XCHG
  14C1'   2A 246F'              	LHLD	YWAS
  14C4'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  14C7'   CA 14F5'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  14CA'   2A 244B'              	LHLD	YPT
  14CD'   CD 0000*              	CALL	GOTO
  14D0'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  14D3'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  14D6'   22 2473'              	SHLD	YBLK
  14D9'   2A 0000*              	LHLD	QBEG
  14DC'   EB                    	XCHG
  14DD'   2A 0000*              	LHLD	QEND
  14E0'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  14E3'   EB                    	XCHG
  14E4'   2A 2473'              	LHLD	YBLK
  14E7'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  14EA'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14EB'   2A 2471'              	LHLD	YCOL
  14EE'   19                    	DAD	D		; ... and the cursor is YCOL into them
  14EF'   CD 0000*              	CALL	GOTO
  14F2'   C3 14FB'              	JMP	YK_RST
  14F5'                         YK_FIN:				; nothing came out, so nothing was put back and
  14F5'   2A 2449'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  14F8'   CD 0000*              	CALL	GOTO		;   where it was
  14FB'                         YK_RST:
  14FB'   2A 2454'              	LHLD	YLDLT
  14FE'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1501'   3A 2446'              	LDA	YMODF
  1504'   32 23E5'              	STA	MODF
  1507'   3A 2447'              	LDA	YDCHG
  150A'   32 23FE'              	STA	DOTCHG
  150D'   3A 2448'              	LDA	YURPL
  1510'   32 0000*              	STA	UNDRPL
  1513'   AF                    	XRA	A
  1514'   32 246A'              	STA	MKHOLD
  1517'   CD 0780'              	CALL	GLSTAL
  151A'   C3 062E'              	JMP	SETFUL		; the cheap paint cannot carry this
  151D'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  151E'                         YSPAN:
  151E'   CD 0780'              	CALL	GLSTAL
  1521'   CD 1086'              	CALL	OPSPNL		; HL = the span's length
  1524'   22 246D'              	SHLD	YTGT
  1527'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  152A'   EB                    	XCHG			; DE = it
  152B'   2A 246D'              	LHLD	YTGT
  152E'   EB                    	XCHG			; HL = the text's, DE = the span's
  152F'   CD 0000*              	CALL	SUBHD
  1532'   22 246D'              	SHLD	YTGT		; what the text is left at when the span is out
  1535'   2A 2414'              	LHLD	OPLO
  1538'   CD 0000*              	CALL	GOTO
  153B'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  153E'                         YS_LP:
  153E'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1541'   CD 0000*              	CALL	SETC0
  1544'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1547'   CD 0000*              	CALL	LOGLEN
  154A'   EB                    	XCHG			; DE = what is left
  154B'   2A 246D'              	LHLD	YTGT
  154E'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1551'   DA 1557'              	JC	YS_END		; below it -- cannot happen over whole lines,
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1554'   C2 153E'              	JNZ	YS_LP		;   but never spin here if it ever did
  1557'                         YS_END:
  1557'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  155A'                         YNPRE:
  155A'   2A 0000*              	LHLD	PGTOPM
  155D'   22 2475'              	SHLD	YNPG
  1560'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; dropped, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1561'                         YNDONE:
  1561'   2A 2449'              	LHLD	YOFF
  1564'   CD 0000*              	CALL	GOTO
  1567'   2A 0000*              	LHLD	PGTOPM
  156A'   EB                    	XCHG
  156B'   2A 2475'              	LHLD	YNPG
  156E'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1571'   C2 062E'              	JNZ	SETFUL		; it moved under us: repaint after all
  1574'   C3 060D'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1577'                         YNROOM:
  1577'   11 0100               	LXI	D,100H
  157A'   19                    	DAD	D
  157B'   D8                    	RC			; within a chunk of 64K: no arena holds that
  157C'   E5                    	PUSH	H		; the span plus its slack
  157D'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1580'   EB                    	XCHG			; HL = free
  1581'   D1                    	POP	D		; DE = the span plus its slack
  1582'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1585'   DA 158D'              	JC	YNR_OK
  1588'   CA 158D'              	JZ	YNR_OK
  158B'   37                    	STC			; not enough: the delete-and-put-back path
  158C'   C9                    	RET
  158D'                         YNR_OK:
  158D'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  158E'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  158F'                         YNGO:
  158F'   C5                    	PUSH	B
  1590'   CD 05A0'              	CALL	GETCNT		; spent here: this yank is happening
  1593'   CD 0780'              	CALL	GLSTAL
  1596'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1599'   C1                    	POP	B
  159A'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  159D'                         YNCOPY:
  159D'   2A 23E2'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  15A0'   7C                    	MOV	A,H		;   the count itself
  15A1'   B5                    	ORA	L
  15A2'   C2 15A8'              	JNZ	YNC_HV
  15A5'   21 0001               	LXI	H,1
  15A8'                         YNC_HV:
  15A8'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  15A9'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  15AA'   B4                    	ORA	H
  15AB'   CA 15B6'              	JZ	YNC_M
  15AE'   E5                    	PUSH	H
  15AF'   CD 0746'              	CALL	ONLAST		; vim: a count over one on the last line does
  15B2'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  15B3'   DA 15C8'              	JC	YNC_RF
  15B6'                         YNC_M:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15B6'   E5                    	PUSH	H
  15B7'   CD 06C4'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  15BA'   E1                    	POP	H
  15BB'   CD 15D0'              	CALL	YNLINE		; BC = the span, measured where it stands
  15BE'   D8                    	RC			; not measurable here: let the pager answer it
  15BF'   60                    	MOV	H,B
  15C0'   69                    	MOV	L,C
  15C1'   CD 1577'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  15C4'   D8                    	RC			; no: the delete-and-put-back path
  15C5'   C3 158F'              	JMP	YNGO
  15C8'                         YNC_RF:
  15C8'   CD 05A0'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  15CB'   CD 0780'              	CALL	GLSTAL		;   register alone, and that is the command
  15CE'   B7                    	ORA	A		; NC: done
  15CF'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  15D0'                         YNLINE:
  15D0'   22 2477'              	SHLD	YNCNT		; the lines it still wants
  15D3'   2A 0000*              	LHLD	GAPEND
  15D6'                         YNL_LP:
  15D6'   EB                    	XCHG			; DE = the scan
  15D7'   2A 0000*              	LHLD	TXTEND
  15DA'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  15DD'   EB                    	XCHG			; HL = the scan
  15DE'   D2 15FE'              	JNC	YNL_EN		; the resident text ran out
  15E1'   7E                    	MOV	A,M
  15E2'   23                    	INX	H
  15E3'   FE 0A                 	CPI	LF
  15E5'   C2 15D6'              	JNZ	YNL_LP
  15E8'   E5                    	PUSH	H
  15E9'   2A 2477'              	LHLD	YNCNT
  15EC'   2B                    	DCX	H
  15ED'   22 2477'              	SHLD	YNCNT
  15F0'   7C                    	MOV	A,H
  15F1'   B5                    	ORA	L
  15F2'   E1                    	POP	H
  15F3'   C2 15D6'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  15F6'   EB                    	XCHG			; DE = past the last of them
  15F7'   2A 0000*              	LHLD	GAPEND
  15FA'   EB                    	XCHG			; HL = past them, DE = GAPEND
  15FB'   C3 160C'              	JMP	YNL_BC
  15FE'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  15FE'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1601'   C2 1613'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1604'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1607'   EB                    	XCHG			;   count clamps to it as vim's does
  1608'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  160B'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  160C'                         YNL_BC:
  160C'   CD 0000*              	CALL	SUBHD		; HL = the span
  160F'   44                    	MOV	B,H
  1610'   4D                    	MOV	C,L
  1611'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1612'   C9                    	RET
  1613'                         YNL_NO:
  1613'   37                    	STC
  1614'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1615'                         YNSPAN:
  1615'   CD 1086'              	CALL	OPSPNL		; HL = the span's length
  1618'   44                    	MOV	B,H
  1619'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  161A'   CD 1577'              	CALL	YNROOM
  161D'   D8                    	RC			; no room: the delete-and-put-back path
  161E'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  161F'   2A 2414'              	LHLD	OPLO
  1622'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1625'   C1                    	POP	B
  1626'   C3 158F'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1629'                         VC_P:
  1629'   CD 1428'              	CALL	QEMPTY
  162C'   CA 16E4'              	JZ	VP_BEL
  162F'   CD 05A0'              	CALL	GETCNT
  1632'   22 244D'              	SHLD	PCNT
  1635'   CD 0000*              	CALL	CUROFF
  1638'   CD 0529'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  163B'   C3 1650'              	JMP	VP_GO
  163E'                         VCB_P:
  163E'   CD 1428'              	CALL	QEMPTY
  1641'   CA 16E4'              	JZ	VP_BEL
  1644'   CD 05A0'              	CALL	GETCNT
  1647'   22 244D'              	SHLD	PCNT
  164A'   CD 0000*              	CALL	CUROFF
  164D'   CD 04F9'              	CALL	BOL
  1650'                         VP_GO:
  1650'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1653'   CD 0000*              	CALL	CUROFF
  1656'   EB                    	XCHG
  1657'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  165A'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  165D'   DA 1672'              	JC	VP_IN
  1660'   EB                    	XCHG			; HL = the put point = LOGLEN
  1661'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1662'   B5                    	ORA	L
  1663'   CA 166F'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1666'   2B                    	DCX	H
  1667'   CD 0000*              	CALL	CHARAT
  166A'   FE 0A                 	CPI	LF
  166C'   CA 1672'              	JZ	VP_IN
  166F'                         VP_BRK:
  166F'   CD 1232'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1672'                         VP_IN:
  1672'   CD 0000*              	CALL	CUROFF
  1675'   22 244F'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1678'   2A 0000*              	LHLD	QBEG
  167B'   EB                    	XCHG
  167C'   2A 0000*              	LHLD	QEND
  167F'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1682'   EB                    	XCHG
  1683'   22 2451'              	SHLD	PLFS
  1686'   2A 244D'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1689'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  168A'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  168B'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  168D'   C2 1691'              	JNZ	VP_PZ
  1690'   7D                    	MOV	A,L
  1691'                         VP_PZ:
  1691'   32 2453'              	STA	PCPY
  1694'                         VP_LP:
  1694'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1697'   2A 0000*              	LHLD	LNDLT
  169A'   EB                    	XCHG
  169B'   2A 2451'              	LHLD	PLFS
  169E'   19                    	DAD	D
  169F'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  16A2'   2A 244D'              	LHLD	PCNT
  16A5'   2B                    	DCX	H
  16A6'   22 244D'              	SHLD	PCNT
  16A9'   7C                    	MOV	A,H
  16AA'   B5                    	ORA	L
  16AB'   C2 1694'              	JNZ	VP_LP
  16AE'   CD 0188'              	CALL	MARKMOD
  16B1'   2A 244F'              	LHLD	PPT
  16B4'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  16B7'   CD 0780'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  16BA'   3A 2453'              	LDA	PCPY
  16BD'   B7                    	ORA	A
  16BE'   CA 06DB'              	JZ	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16C1'   2A 2451'              	LHLD	PLFS
  16C4'   7C                    	MOV	A,H
  16C5'   B7                    	ORA	A
  16C6'   C2 06DB'              	JNZ	FNBLNK
  16C9'   3A 2453'              	LDA	PCPY
  16CC'   CD 0C93'              	CALL	MULSAT		; HL = the lines this put put, saturated
  16CF'   7C                    	MOV	A,H
  16D0'   B7                    	ORA	A
  16D1'   C2 06DB'              	JNZ	FNBLNK
  16D4'   7D                    	MOV	A,L
  16D5'   B7                    	ORA	A
  16D6'   CA 06DB'              	JZ	FNBLNK
  16D9'   F5                    	PUSH	PSW
  16DA'   CD 0619'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  16DD'   F1                    	POP	PSW
  16DE'   32 23E7'              	STA	ILN		; ... which the lines put now replace
  16E1'   C3 06DB'              	JMP	FNBLNK
  16E4'                         VP_BEL:
  16E4'   CD 05A0'              	CALL	GETCNT		; the count is spent either way
  16E7'   0E 07                 	MVI	C,BEL
  16E9'   CD 0000*              	CALL	BCONOU
  16EC'   C3 060D'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  16EF'                         VIREP:
  16EF'   78                    	MOV	A,B
  16F0'   FE 01                 	CPI	KT_ACT
  16F2'   CA 181F'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  16F5'   FE 02                 	CPI	KT_CHAR
  16F7'   C0                    	RNZ			; ignore anything else
  16F8'   79                    	MOV	A,C
  16F9'   FE 0D                 	CPI	CR
  16FB'   CA 175F'              	JZ	VP_CR
  16FE'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1700'   CA 175F'              	JZ	VP_CR
  1703'   FE 08                 	CPI	BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1705'   CA 176B'              	JZ	VP_BS
  1708'   FE 7F                 	CPI	DEL
  170A'   CA 176B'              	JZ	VP_BS
  170D'   32 2425'              	STA	VRCH		; the calls below do not preserve C
  1710'   CD 0613'              	CALL	SETLIN		; this row changed
  1713'   CD 0188'              	CALL	MARKMOD
  1716'   CD 1225'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1719'   CA 1751'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  171C'   3A 2425'              	LDA	VRCH
  171F'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1722'   2A 2426'              	LHLD	RPDEL
  1725'   7C                    	MOV	A,H
  1726'   B5                    	ORA	L
  1727'   CA 173D'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  172A'   2A 0000*              	LHLD	GAPEND
  172D'   EB                    	XCHG
  172E'   2A 242A'              	LHLD	RPGE
  1731'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1734'   CA 173D'              	JZ	VP_OVW
  1737'   21 0000               	LXI	H,0
  173A'   22 2426'              	SHLD	RPDEL		; the text moved: those originals are gone
  173D'                         VP_OVW:
  173D'   21 0001               	LXI	H,1
  1740'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1743'   2A 0000*              	LHLD	GAPEND
  1746'   22 242A'              	SHLD	RPGE
  1749'   2A 2426'              	LHLD	RPDEL
  174C'   23                    	INX	H
  174D'   22 2426'              	SHLD	RPDEL
  1750'   C9                    	RET
  1751'                         VP_APP:
  1751'   3A 2425'              	LDA	VRCH
  1754'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1757'   2A 2428'              	LHLD	RPAPP
  175A'   23                    	INX	H
  175B'   22 2428'              	SHLD	RPAPP
  175E'   C9                    	RET
  175F'                         VP_CR:
  175F'   21 0000               	LXI	H,0
  1762'   22 2426'              	SHLD	RPDEL		; a line break ends what BS can put back
  1765'   22 2428'              	SHLD	RPAPP
  1768'   C3 17F5'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  176B'                         VP_BS:
  176B'   2A 2428'              	LHLD	RPAPP
  176E'   7C                    	MOV	A,H
  176F'   B5                    	ORA	L
  1770'   CA 177D'              	JZ	VP_BSD
  1773'   2B                    	DCX	H
  1774'   22 2428'              	SHLD	RPAPP		; an appended char: it just goes
  1777'   CD 0613'              	CALL	SETLIN
  177A'   C3 0000*              	JMP	DELPRV
  177D'                         VP_BSD:
  177D'   2A 2426'              	LHLD	RPDEL
  1780'   7C                    	MOV	A,H
  1781'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1782'   CA 17A9'              	JZ	VP_BSM		; nothing of ours left
  1785'   2A 0000*              	LHLD	GAPEND
  1788'   EB                    	XCHG
  1789'   2A 242A'              	LHLD	RPGE
  178C'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  178F'   C2 17A9'              	JNZ	VP_BSM
  1792'   2A 2426'              	LHLD	RPDEL
  1795'   2B                    	DCX	H
  1796'   22 2426'              	SHLD	RPDEL
  1799'   CD 0613'              	CALL	SETLIN
  179C'   CD 0000*              	CALL	DELPRV		; the typed char goes
  179F'   CD 0000*              	CALL	UNDELF		; the original comes back
  17A2'   2A 0000*              	LHLD	GAPEND
  17A5'   22 242A'              	SHLD	RPGE
  17A8'   C9                    	RET
  17A9'                         VP_BSM:
  17A9'   CD 060D'              	CALL	SETMOV		; nothing changed: back over the text as it is
  17AC'   C3 067C'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  17AF'                         VIINS:
  17AF'   78                    	MOV	A,B
  17B0'   FE 01                 	CPI	KT_ACT
  17B2'   CA 181F'              	JZ	VI_ACT
  17B5'   FE 02                 	CPI	KT_CHAR
  17B7'   C0                    	RNZ			; ignore anything else
  17B8'   79                    	MOV	A,C
  17B9'   FE 0D                 	CPI	CR
  17BB'   CA 17F5'              	JZ	VI_CR
  17BE'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  17C0'   CA 17F5'              	JZ	VI_CR
  17C3'   FE 08                 	CPI	BS
  17C5'   CA 180D'              	JZ	VI_BS
  17C8'   FE 7F                 	CPI	DEL
  17CA'   CA 180D'              	JZ	VI_BS
  17CD'   79                    	MOV	A,C
  17CE'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  17D1'   CD 0188'              	CALL	MARKMOD
  17D4'   CD 0613'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  17D7'   79                    	MOV	A,C
  17D8'   FE 20                 	CPI	' '
  17DA'   D8                    	RC			; control char -> keep R_LINE
  17DB'   FE 7F                 	CPI	DEL
  17DD'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  17DE'   CD 0634'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  17E1'   B7                    	ORA	A
  17E2'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  17E3'   3E 04                 	MVI	A,R_ICH
  17E5'   32 23E6'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  17E8'   CD 1225'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  17EB'   3E 00                 	MVI	A,0
  17ED'   C2 17F1'              	JNZ	VI_ICH
  17F0'   3C                    	INR	A
  17F1'                         VI_ICH:
  17F1'   32 23E8'              	STA	ICHAPP
  17F4'   C9                    	RET
  17F5'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  17F5'   CD 1225'              	CALL	ATCEND
  17F8'   3E 00                 	MVI	A,0
  17FA'   CA 17FE'              	JZ	VI_CRS
  17FD'   3C                    	INR	A
  17FE'                         VI_CRS:
  17FE'   F5                    	PUSH	PSW
  17FF'   CD 1232'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1802'   CD 1246'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1805'   CD 0619'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1808'   F1                    	POP	PSW
  1809'   32 23E9'              	STA	ILABOV
  180C'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  180D'                         VI_BS:
  180D'   CD 0000*              	CALL	PEEKL
  1810'   D8                    	RC			; start of the file: nothing to delete
  1811'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1813'   CA 1819'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1816'   CD 0613'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1819'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1819'   CD 0188'              	CALL	MARKMOD
  181C'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  181F'                         VI_ACT:
  181F'   79                    	MOV	A,C
  1820'   FE 0B                 	CPI	ACT_ESC
  1822'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1823'   3E 00                 	MVI	A,EM_CMD
  1825'   32 23E1'              	STA	EDMODE
  1828'   CD 060D'              	CALL	SETMOV
  182B'   CD 067C'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  182E'   C3 0780'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1831'                         RDLINE:
  1831'   EB                    	XCHG			; HL = buffer
  1832'   22 242C'              	SHLD	RLPTR
  1835'   3E 00                 	MVI	A,0
  1837'   32 242E'              	STA	RLLEN
  183A'   78                    	MOV	A,B
  183B'   32 242F'              	STA	RLMAX
  183E'   79                    	MOV	A,C
  183F'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1842'                         RL_LP:
  1842'   CD 0000*              	CALL	GETKEY
  1845'   78                    	MOV	A,B
  1846'   FE 01                 	CPI	KT_ACT
  1848'   CA 189E'              	JZ	RL_ACT
  184B'   FE 02                 	CPI	KT_CHAR
  184D'   C2 1842'              	JNZ	RL_LP		; ignore other keys
  1850'   79                    	MOV	A,C
  1851'   FE 0D                 	CPI	CR
  1853'   CA 18AF'              	JZ	RL_DONE
  1856'   FE 08                 	CPI	BS
  1858'   CA 1886'              	JZ	RL_BS
  185B'   FE 7F                 	CPI	DEL
  185D'   CA 1886'              	JZ	RL_BS
  1860'   FE 20                 	CPI	' '
  1862'   DA 1842'              	JC	RL_LP		; control char -> ignore
  1865'   3A 242E'              	LDA	RLLEN
  1868'   47                    	MOV	B,A
  1869'   3A 242F'              	LDA	RLMAX
  186C'   B8                    	CMP	B
  186D'   CA 1842'              	JZ	RL_LP		; full -> ignore
  1870'   2A 242C'              	LHLD	RLPTR
  1873'   71                    	MOV	M,C
  1874'   23                    	INX	H
  1875'   22 242C'              	SHLD	RLPTR
  1878'   3A 242E'              	LDA	RLLEN
  187B'   3C                    	INR	A
  187C'   32 242E'              	STA	RLLEN
  187F'   79                    	MOV	A,C
  1880'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1883'   C3 1842'              	JMP	RL_LP
  1886'                         RL_BS:				; WM LINEPOP
  1886'   3A 242E'              	LDA	RLLEN
  1889'   B7                    	ORA	A
  188A'   CA 18A4'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  188D'   3D                    	DCR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  188E'   32 242E'              	STA	RLLEN
  1891'   2A 242C'              	LHLD	RLPTR
  1894'   2B                    	DCX	H
  1895'   22 242C'              	SHLD	RLPTR
  1898'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  189B'   C3 1842'              	JMP	RL_LP
  189E'                         RL_ACT:
  189E'   79                    	MOV	A,C
  189F'   FE 0B                 	CPI	ACT_ESC
  18A1'   C2 1842'              	JNZ	RL_LP
  18A4'                         RL_CAN:
  18A4'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  18A6'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  18A9'   CD 0613'              	CALL	SETLIN		; redraw one row
  18AC'   3E FF                 	MVI	A,0FFH		; cancelled
  18AE'   C9                    	RET
  18AF'                         RL_DONE:
  18AF'   AF                    	XRA	A
  18B0'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  18B1'                         VC_BZ:
  18B1'   CD 060D'              	CALL	SETMOV
  18B4'   3A 240A'              	LDA	GSAVE
  18B7'   FE 02                 	CPI	PZ
  18B9'   CA 18C4'              	JZ	VZ_ZZ
  18BC'   B7                    	ORA	A
  18BD'   C0                    	RNZ			; 'g' was pending: vim drops both
  18BE'   3E 02                 	MVI	A,PZ
  18C0'   32 2409'              	STA	GPEND
  18C3'   C9                    	RET
  18C4'                         VZ_ZZ:
  18C4'   3E 04                 	MVI	A,EO_X
  18C6'   32 2430'              	STA	EXOP
  18C9'   3E 01                 	MVI	A,1
  18CB'   32 2443'              	STA	EXBANG		; no '!'
  18CE'   AF                    	XRA	A
  18CF'   32 2431'              	STA	EXARG		; no file name
  18D2'   3A 23E5'              	LDA	MODF		; as ':x': a changed text is written first
  18D5'   B7                    	ORA	A
  18D6'   CA 19F9'              	JZ	EX_Q
  18D9'   C3 1993'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  18DC'                         VC_EX:
  18DC'   CD 05A0'              	CALL	GETCNT
  18DF'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  18E2'   11 0000*              	LXI	D,EXBUF
  18E5'   06 28                 	MVI	B,EXMAX
  18E7'   0E 3A                 	MVI	C,':'
  18E9'   CD 1831'              	CALL	RDLINE
  18EC'   B7                    	ORA	A
  18ED'   C0                    	RNZ			; cancelled
  18EE'   3A 242E'              	LDA	RLLEN
  18F1'   5F                    	MOV	E,A
  18F2'   16 00                 	MVI	D,0
  18F4'   21 0000*              	LXI	H,EXBUF
  18F7'   19                    	DAD	D
  18F8'   36 00                 	MVI	M,0		; the line ends with a 0
  18FA'   21 0000*              	LXI	H,EXBUF
  18FD'   CD 1C95'              	CALL	SKIPB
  1900'   C8                    	RZ			; nothing on it
  1901'   22 2433'              	SHLD	EXCMD
  1904'   CD 1E32'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1907'   CD 1C95'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  190A'   56                    	MOV	D,M
  190B'   23                    	INX	H
  190C'   1E 00                 	MVI	E,0
  190E'   CD 1CA1'              	CALL	ISLOW
  1911'   DA 191C'              	JC	EX_LK
  1914'   5F                    	MOV	E,A
  1915'   23                    	INX	H
  1916'   CD 1CA1'              	CALL	ISLOW
  1919'   D2 1935'              	JNC	EX_NOT		; a third letter: none of ours
  191C'                         EX_LK:
  191C'   E5                    	PUSH	H
  191D'   21 1E1C'              	LXI	H,EXTAB
  1920'                         EX_TL:
  1920'   7E                    	MOV	A,M
  1921'   B7                    	ORA	A
  1922'   CA 1934'              	JZ	EX_NTP		; not in the table
  1925'   23                    	INX	H
  1926'   BA                    	CMP	D
  1927'   7E                    	MOV	A,M
  1928'   23                    	INX	H
  1929'   C2 1930'              	JNZ	EX_TN
  192C'   BB                    	CMP	E
  192D'   CA 193B'              	JZ	EX_TF
  1930'                         EX_TN:
  1930'   23                    	INX	H
  1931'   C3 1920'              	JMP	EX_TL
  1934'                         EX_NTP:
  1934'   E1                    	POP	H
  1935'                         EX_NOT:
  1935'   21 1D59'              	LXI	H,SNOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1938'   C3 1CD6'              	JMP	EXERT
  193B'                         EX_TF:
  193B'   7E                    	MOV	A,M
  193C'   32 2430'              	STA	EXOP
  193F'   E1                    	POP	H
  1940'   FE 06                 	CPI	EO_S
  1942'   CA 1EA1'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1945'   3A 2480'              	LDA	SRNGF
  1948'   B7                    	ORA	A
  1949'   C2 1935'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  194C'   7E                    	MOV	A,M
  194D'   D6 21                 	SUI	'!'
  194F'   32 2443'              	STA	EXBANG		; 0 = '!'
  1952'   C2 1956'              	JNZ	EX_NB
  1955'   23                    	INX	H
  1956'                         EX_NB:
  1956'   CD 1C95'              	CALL	SKIPB
  1959'   32 2431'              	STA	EXARG		; 0 = no file name
  195C'   CA 1975'              	JZ	EX_RUN
  195F'   22 2433'              	SHLD	EXCMD
  1962'   3A 2430'              	LDA	EXOP
  1965'   FE 02                 	CPI	EO_Q
  1967'   CA 1CD3'              	JZ	EX_TRL		; :q takes none
  196A'   FE 07                 	CPI	EO_V
  196C'   CA 1CD3'              	JZ	EX_TRL		; nor :ve
  196F'   CD 1BFF'              	CALL	PARSFN
  1972'   C2 1CC7'              	JNZ	EX_INV
  1975'                         EX_RUN:
  1975'   3A 2430'              	LDA	EXOP
  1978'   FE 05                 	CPI	EO_E
  197A'   CA 1A10'              	JZ	EX_E
  197D'   FE 02                 	CPI	EO_Q
  197F'   CA 19F9'              	JZ	EX_Q
  1982'   FE 07                 	CPI	EO_V
  1984'   CA 1CCD'              	JZ	EX_V
  1987'   FE 04                 	CPI	EO_X
  1989'   C2 1993'              	JNZ	EX_W
  198C'   3A 23E5'              	LDA	MODF		; :x writes only a changed text
  198F'   B7                    	ORA	A
  1990'   CA 19F9'              	JZ	EX_Q
  1993'                         EX_W:
  1993'   CD 1A67'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1996'   D8                    	RC			; refused (message shown)
  1997'   32 2432'              	STA	EXBAK
  199A'   3A 2430'              	LDA	EXOP
  199D'   FE 01                 	CPI	EO_W
  199F'   CA 19B6'              	JZ	EX_WK
  19A2'   3A 2432'              	LDA	EXBAK
  19A5'   B7                    	ORA	A
  19A6'   C2 19F6'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  19A9'   3A 2443'              	LDA	EXBANG
  19AC'   B7                    	ORA	A
  19AD'   CA 19F6'              	JZ	EX_WQ		; so it does with '!'
  19B0'   CD 19B6'              	CALL	EX_WK		; else it may not: keep the text
  19B3'   C3 19F9'              	JMP	EX_Q
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ;EX_WK -- write, then keep editing where the cursor was.
  19B6'                         EX_WK:
  19B6'   CD 0B9F'              	CALL	CURRW		; the cursor's row and file position
  19B9'   32 2435'              	STA	WPROW
  19BC'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  19BF'   7D                    	MOV	A,L
  19C0'   E6 7F                 	ANI	7FH
  19C2'   32 2436'              	STA	WPBYT
  19C5'   7D                    	MOV	A,L
  19C6'   17                    	RAL
  19C7'   7C                    	MOV	A,H
  19C8'   17                    	RAL
  19C9'   5F                    	MOV	E,A
  19CA'   3E 00                 	MVI	A,0
  19CC'   17                    	RAL
  19CD'   57                    	MOV	D,A		; DE = HL / 128
  19CE'   2A 0000*              	LHLD	OUTPOS
  19D1'   19                    	DAD	D
  19D2'   22 2437'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  19D5'   CD 1A9C'              	CALL	WRITE
  19D8'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  19DB'   2A 2437'              	LHLD	WPREC
  19DE'   EB                    	XCHG
  19DF'   3A 2436'              	LDA	WPBYT
  19E2'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  19E5'   CD 0000*              	CALL	GOTO
  19E8'   21 0000               	LXI	H,0
  19EB'   22 0000*              	SHLD	LNDLT
  19EE'   3A 2435'              	LDA	WPROW
  19F1'   6F                    	MOV	L,A
  19F2'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  19F5'   C9                    	RET
  19F6'                         EX_WQ:
  19F6'   CD 1A9C'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  19F9'                         EX_Q:
  19F9'   3A 2443'              	LDA	EXBANG
  19FC'   B7                    	ORA	A
  19FD'   CA 1A07'              	JZ	EX_QT
  1A00'   3A 23E5'              	LDA	MODF
  1A03'   B7                    	ORA	A
  1A04'   C2 1CBB'              	JNZ	MSGNWR		; changed, no '!': stay
  1A07'                         EX_QT:
  1A07'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1A0A'   3E 01                 	MVI	A,1
  1A0C'   32 23E4'              	STA	QUITF
  1A0F'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1A10'                         EX_E:
  1A10'   3A 2443'              	LDA	EXBANG
  1A13'   B7                    	ORA	A
  1A14'   CA 1A1E'              	JZ	EE_GO
  1A17'   3A 23E5'              	LDA	MODF
  1A1A'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A1B'   C2 1CBB'              	JNZ	MSGNWR
  1A1E'                         EE_GO:
  1A1E'   3A 2431'              	LDA	EXARG
  1A21'   B7                    	ORA	A
  1A22'   C2 1A29'              	JNZ	EE_ARG
  1A25'   CD 1AD8'              	CALL	OWNTF		; no name: the buffer's own
  1A28'   D8                    	RC
  1A29'                         EE_ARG:
  1A29'   CD 1AEE'              	CALL	ISOWN
  1A2C'   21 0001               	LXI	H,1
  1A2F'   C2 1A36'              	JNZ	EE_LD		; another file: its first line
  1A32'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1A35'   23                    	INX	H		; HL = the cursor's line
  1A36'                         EE_LD:
  1A36'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1A38'   32 2441'              	STA	MSGWHT
  1A3B'   E5                    	PUSH	H
  1A3C'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1A3F'   21 0000*              	LXI	H,TFCB
  1A42'   11 0000*              	LXI	D,FNAME
  1A45'   CD 1B00'              	CALL	COPY12		; the buffer's name
  1A48'   CD 1AC5'              	CALL	SRCTF
  1A4B'   CD 0000*              	CALL	REOPEN
  1A4E'   CD 020E'              	CALL	MKCLR		; the marks named the buffer that just went
  1A51'   AF                    	XRA	A
  1A52'   32 23E5'              	STA	MODF
  1A55'   E1                    	POP	H
  1A56'   2B                    	DCX	H
  1A57'   AF                    	XRA	A
  1A58'   CD 0000*              	CALL	MVLIND		; down to the line
  1A5B'   CD 08B7'              	CALL	ATEOF
  1A5E'   DC 08BD'              	CC	LASTLN		; past the last line: onto it
  1A61'   CD 0DBE'              	CALL	ZSAVE
  1A64'   C3 0EA7'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1A67'                         WRCHK:
  1A67'   3A 2431'              	LDA	EXARG
  1A6A'   B7                    	ORA	A
  1A6B'   C2 1A75'              	JNZ	WC_ARG
  1A6E'   CD 1AD8'              	CALL	OWNTF
  1A71'   D8                    	RC
  1A72'   C3 1A8A'              	JMP	WC_OWN
  1A75'                         WC_ARG:
  1A75'   CD 1AEE'              	CALL	ISOWN
  1A78'   CA 1A8A'              	JZ	WC_OWN
  1A7B'   3A 2443'              	LDA	EXBANG
  1A7E'   B7                    	ORA	A
  1A7F'   CA 1A88'              	JZ	WC_OTH
  1A82'   CD 0000*              	CALL	TEXIST
  1A85'   C2 1CAF'              	JNZ	MSGEXI		; File exists (! to force)
  1A88'                         WC_OTH:
  1A88'   AF                    	XRA	A		; (NC)
  1A89'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A8A'                         WC_OWN:
  1A8A'   3A 2444'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1A8D'   B7                    	ORA	A
  1A8E'   CA 1A98'              	JZ	WC_OK
  1A91'   3A 2443'              	LDA	EXBANG
  1A94'   B7                    	ORA	A
  1A95'   C2 1CB5'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1A98'                         WC_OK:
  1A98'   3E 01                 	MVI	A,1
  1A9A'   B7                    	ORA	A		; (NC)
  1A9B'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1A9C'                         WRITE:
  1A9C'   3A 2432'              	LDA	EXBAK
  1A9F'   CD 0000*              	CALL	WRTO
  1AA2'   3A 0001*              	LDA	FNAME+1
  1AA5'   FE 20                 	CPI	' '
  1AA7'   C2 1AB3'              	JNZ	WR_HAS
  1AAA'   21 0000*              	LXI	H,TFCB
  1AAD'   11 0000*              	LXI	D,FNAME
  1AB0'   CD 1B00'              	CALL	COPY12
  1AB3'                         WR_HAS:
  1AB3'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1AB5'   32 2441'              	STA	MSGWHT
  1AB8'   CD 1AEE'              	CALL	ISOWN
  1ABB'   C2 1AC5'              	JNZ	SRCTF
  1ABE'   AF                    	XRA	A
  1ABF'   32 23E5'              	STA	MODF
  1AC2'   32 2442'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1AC5'                         SRCTF:
  1AC5'   21 0000*              	LXI	H,TFCB
  1AC8'   11 005C               	LXI	D,DFTFCB
  1ACB'   CD 1B00'              	CALL	COPY12
  1ACE'   AF                    	XRA	A
  1ACF'   06 04                 	MVI	B,4
  1AD1'                         SRC_Z:
  1AD1'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1AD2'   13                    	INX	D
  1AD3'   05                    	DCR	B
  1AD4'   C2 1AD1'              	JNZ	SRC_Z
  1AD7'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1AD8'                         OWNTF:
  1AD8'   3A 0001*              	LDA	FNAME+1
  1ADB'   FE 20                 	CPI	' '
  1ADD'   CA 1CA9'              	JZ	MSGNFN
  1AE0'   CD 1B0B'              	CALL	TFCLR
  1AE3'   21 0000*              	LXI	H,FNAME
  1AE6'   11 0000*              	LXI	D,TFCB
  1AE9'   CD 1B00'              	CALL	COPY12
  1AEC'   B7                    	ORA	A		; (NC)
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AED'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1AEE'                         ISOWN:
  1AEE'   21 0000*              	LXI	H,TFCB
  1AF1'   11 0000*              	LXI	D,FNAME
  1AF4'   06 0C                 	MVI	B,12
  1AF6'                         IO_LP:
  1AF6'   1A                    	LDAX	D
  1AF7'   BE                    	CMP	M
  1AF8'   C0                    	RNZ
  1AF9'   23                    	INX	H
  1AFA'   13                    	INX	D
  1AFB'   05                    	DCR	B
  1AFC'   C2 1AF6'              	JNZ	IO_LP
  1AFF'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1B00'                         COPY12:
  1B00'   06 0C                 	MVI	B,12
  1B02'                         CP_LP:
  1B02'   7E                    	MOV	A,M
  1B03'   12                    	STAX	D
  1B04'   23                    	INX	H
  1B05'   13                    	INX	D
  1B06'   05                    	DCR	B
  1B07'   C2 1B02'              	JNZ	CP_LP
  1B0A'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1B0B'                         TFCLR:
  1B0B'   11 0000*              	LXI	D,TFCB
  1B0E'   06 24                 	MVI	B,36
  1B10'   AF                    	XRA	A
  1B11'                         TC_LP:
  1B11'   12                    	STAX	D
  1B12'   13                    	INX	D
  1B13'   05                    	DCR	B
  1B14'   C2 1B11'              	JNZ	TC_LP
  1B17'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1B18'                         FOPEN:
  1B18'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1B1A'   32 2441'              	STA	MSGWHT
  1B1D'   21 005C               	LXI	H,DFTFCB
  1B20'   CD 1BF2'              	CALL	NRMDRV
  1B23'   11 0000*              	LXI	D,FNAME
  1B26'   CD 1B00'              	CALL	COPY12
  1B29'   CD 0000*              	CALL	OPENZ
  1B2C'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1B2F'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1B31'   C8                    	RZ
  1B32'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B35'   32 2442'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1B38'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1B39'                         ARGSCN:
  1B39'   3A 0080               	LDA	CMDTAIL
  1B3C'   47                    	MOV	B,A		; B = what is left of the line
  1B3D'   B7                    	ORA	A
  1B3E'   C8                    	RZ
  1B3F'   21 0081               	LXI	H,CMDTAIL+1
  1B42'                         AS_TOK:				; at a token, or the blanks before one
  1B42'   7E                    	MOV	A,M
  1B43'   FE 20                 	CPI	' '
  1B45'   C2 1B4E'              	JNZ	AS_OPT
  1B48'   23                    	INX	H
  1B49'   05                    	DCR	B
  1B4A'   C2 1B42'              	JNZ	AS_TOK
  1B4D'   C9                    	RET
  1B4E'                         AS_OPT:
  1B4E'   FE 2B                 	CPI	'+'
  1B50'   CA 1B7A'              	JZ	AS_PLS
  1B53'   FE 2D                 	CPI	'-'
  1B55'   CA 1B69'              	JZ	AS_SW
  1B58'   FE 2F                 	CPI	'/'
  1B5A'   CA 1B69'              	JZ	AS_SW
  1B5D'                         AS_SKP:				; not ours (the file name): on to the next one
  1B5D'   23                    	INX	H
  1B5E'   05                    	DCR	B
  1B5F'   C8                    	RZ
  1B60'   7E                    	MOV	A,M
  1B61'   FE 20                 	CPI	' '
  1B63'   C2 1B5D'              	JNZ	AS_SKP
  1B66'   C3 1B42'              	JMP	AS_TOK
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B69'                         AS_SW:
  1B69'   23                    	INX	H
  1B6A'   05                    	DCR	B
  1B6B'   C8                    	RZ
  1B6C'   7E                    	MOV	A,M
  1B6D'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1B6F'   FE 52                 	CPI	'R'
  1B71'   C2 1B5D'              	JNZ	AS_SKP
  1B74'   32 2444'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1B77'   C3 1B5D'              	JMP	AS_SKP
  1B7A'                         AS_PLS:
  1B7A'   3E 01                 	MVI	A,1
  1B7C'   32 2445'              	STA	PLUSF		; '+' gets the line even with no number on it
  1B7F'   11 0000*              	LXI	D,PLUSB
  1B82'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1B84'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1B85'   05                    	DCR	B
  1B86'   CA 1BBD'              	JZ	AS_PE
  1B89'   7E                    	MOV	A,M
  1B8A'   FE 30                 	CPI	'0'
  1B8C'   C2 1BA4'              	JNZ	AS_PD
  1B8F'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1B8F'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1B90'   05                    	DCR	B
  1B91'   CA 1BC5'              	JZ	AS_P1
  1B94'   7E                    	MOV	A,M
  1B95'   FE 30                 	CPI	'0'
  1B97'   CA 1B8F'              	JZ	AS_PZ
  1B9A'   FE 31                 	CPI	'1'
  1B9C'   DA 1BC5'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1B9F'   FE 3A                 	CPI	'9'+1
  1BA1'   D2 1BC5'              	JNC	AS_P1
  1BA4'                         AS_PD:				; the digits, as typed
  1BA4'   7E                    	MOV	A,M
  1BA5'   FE 30                 	CPI	'0'
  1BA7'   DA 1BBD'              	JC	AS_PE
  1BAA'   FE 3A                 	CPI	'9'+1
  1BAC'   D2 1BBD'              	JNC	AS_PE
  1BAF'   79                    	MOV	A,C
  1BB0'   B7                    	ORA	A
  1BB1'   CA 1BCC'              	JZ	AS_POV
  1BB4'   0D                    	DCR	C
  1BB5'   7E                    	MOV	A,M
  1BB6'   12                    	STAX	D
  1BB7'   13                    	INX	D
  1BB8'   23                    	INX	H
  1BB9'   05                    	DCR	B
  1BBA'   C2 1BA4'              	JNZ	AS_PD
  1BBD'                         AS_PE:
  1BBD'   AF                    	XRA	A
  1BBE'   12                    	STAX	D		; the digits end with a 0
  1BBF'   78                    	MOV	A,B
  1BC0'   B7                    	ORA	A
  1BC1'   C8                    	RZ
  1BC2'   C3 1B42'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                				;   take a '-R' after them for a file name
  1BC5'                         AS_P1:
  1BC5'   3E 31                 	MVI	A,'1'
  1BC7'   12                    	STAX	D
  1BC8'   13                    	INX	D
  1BC9'   C3 1BBD'              	JMP	AS_PE
  1BCC'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1BCC'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1BCF'   C3 1BBD'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1BD2'                         ARGGO:
  1BD2'   3A 2445'              	LDA	PLUSF
  1BD5'   B7                    	ORA	A
  1BD6'   C8                    	RZ
  1BD7'   21 0000*              	LXI	H,PLUSB
  1BDA'                         AG_LP:
  1BDA'   7E                    	MOV	A,M
  1BDB'   B7                    	ORA	A
  1BDC'   CA 1BEB'              	JZ	AG_G
  1BDF'   4F                    	MOV	C,A
  1BE0'   06 02                 	MVI	B,KT_CHAR
  1BE2'   E5                    	PUSH	H
  1BE3'   CD 001F'              	CALL	VICMD
  1BE6'   E1                    	POP	H
  1BE7'   23                    	INX	H
  1BE8'   C3 1BDA'              	JMP	AG_LP
  1BEB'                         AG_G:
  1BEB'   0E 47                 	MVI	C,'G'
  1BED'   06 02                 	MVI	B,KT_CHAR
  1BEF'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
