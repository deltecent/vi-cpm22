  31ED'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  31EE'   01                    DCHN:	DB	1		; the cells an R_DCH paint deletes (SCRN.MAC reads)
  31EF'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  31F1'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  31F2'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
                                
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                
                                	END
