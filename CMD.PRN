  0A06'   7C                    	MOV	A,H
  0A07'   A5                    	ANA	L
  0A08'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A09'   C2 0A0D'              	JNZ	JL_LS
  0A0C'   23                    	INX	H		; no content: the line's start
  0A0D'                         JL_LS:
  0A0D'   EB                    	XCHG
  0A0E'                         JL_GO:
  0A0E'   D5                    	PUSH	D		; DE = step from the line start
  0A0F'   CD 0000*              	CALL	CUROFF
  0A12'   D1                    	POP	D
  0A13'   19                    	DAD	D
  0A14'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A17'   AF                    VC_W:	XRA	A
  0A18'   32 2908'              	STA	WBIG
  0A1B'   C3 0A23'              	JMP	WDO
  0A1E'   3E 01                 VCBGW:	MVI	A,1
  0A20'   32 2908'              	STA	WBIG
  0A23'   CD 06EB'              WDO:	CALL	SETMOV
  0A26'   AF                    	XRA	A
  0A27'   32 2909'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0A2A'   CD 067E'              	CALL	GETCNT
  0A2D'   22 2940'              	SHLD	CNTV
  0A30'   2A 2940'              WDO_LP: LHLD	CNTV
  0A33'   7C                    	MOV	A,H
  0A34'   B5                    	ORA	L
  0A35'   CA 0A42'              	JZ	WDO_DN
  0A38'   2B                    	DCX	H
  0A39'   22 2940'              	SHLD	CNTV
  0A3C'   CD 0A92'              	CALL	FWD1
  0A3F'   D2 0A30'              	JNC	WDO_LP
  0A42'                         WDO_DN:
  0A42'   CD 0995'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0A45'   DA 0A52'              	JC	WDO_NL
  0A48'   FE 0D                 	CPI	CR
  0A4A'   CA 0A52'              	JZ	WDO_NL
  0A4D'   FE 0A                 	CPI	LF
  0A4F'   C2 0570'              	JNZ	SETGL
  0A52'                         WDO_NL:
  0A52'   CD 0000*              	CALL	PEEKL
  0A55'   DA 0570'              	JC	SETGL
  0A58'   FE 0A                 	CPI	LF
  0A5A'   CA 0570'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0A5D'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0A5F'   32 2909'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0A62'   CD 0B8D'              	CALL	DECC		; back onto its last char
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0A65'   C3 0570'              	JMP	SETGL
                                
  0A68'   AF                    VC_B:	XRA	A
  0A69'   32 2908'              	STA	WBIG
  0A6C'   C3 0A74'              	JMP	BDO
  0A6F'   3E 01                 VCBGB:	MVI	A,1
  0A71'   32 2908'              	STA	WBIG
  0A74'   CD 06EB'              BDO:	CALL	SETMOV
  0A77'   CD 067E'              	CALL	GETCNT
  0A7A'   22 2940'              	SHLD	CNTV
  0A7D'   2A 2940'              BDO_LP: LHLD	CNTV
  0A80'   7C                    	MOV	A,H
  0A81'   B5                    	ORA	L
  0A82'   CA 0570'              	JZ	SETGL
  0A85'   2B                    	DCX	H
  0A86'   22 2940'              	SHLD	CNTV
  0A89'   CD 0ADE'              	CALL	BCK1
  0A8C'   D2 0A7D'              	JNC	BDO_LP
  0A8F'   C3 0570'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0A92'                         FWD1:
  0A92'   CD 0B11'              	CALL	CCLS
  0A95'   32 294C'              	STA	WKCLS		; the starting class
  0A98'   CD 0B4B'              	CALL	INCC
  0A9B'   B7                    	ORA	A
  0A9C'   CA 0AB4'              	JZ	FW_WD
  0A9F'   37                    	STC
  0AA0'   F8                    	RM			; -1: already at the end
  0AA1'   FE 02                 	CPI	2
  0AA3'   C2 0AB4'              	JNZ	FW_WD		; 1: a next line was reached
  0AA6'   CD 0995'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0AA9'   D4 0B32'              	CNC	NXLN
  0AAC'   D2 0AB4'              	JNC	FW_WD
  0AAF'   CD 0B8D'              	CALL	DECC		; yes: back onto its last char, failed
  0AB2'   37                    	STC
  0AB3'   C9                    	RET
  0AB4'                         FW_WD:
  0AB4'   3A 294C'              	LDA	WKCLS		; go past the rest of this word
  0AB7'   B7                    	ORA	A
  0AB8'   CA 0ACD'              	JZ	FW_WS
  0ABB'                         FW_WLP:
  0ABB'   CD 0B11'              	CALL	CCLS
  0ABE'   21 294C'              	LXI	H,WKCLS
  0AC1'   BE                    	CMP	M
  0AC2'   C2 0ACD'              	JNZ	FW_WS
  0AC5'   CD 0B4B'              	CALL	INCC
  0AC8'   B7                    	ORA	A
  0AC9'   F8                    	RM			; the end of the file (NC)
  0ACA'   C3 0ABB'              	JMP	FW_WLP
  0ACD'                         FW_WS:
  0ACD'   CD 0B11'              	CALL	CCLS		; then over blanks to the next word
  0AD0'   B7                    	ORA	A
  0AD1'   C0                    	RNZ
  0AD2'   CD 0B19'              	CALL	EMPTY
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AD5'   C8                    	RZ			; an empty line is a word
  0AD6'   CD 0B4B'              	CALL	INCC
  0AD9'   B7                    	ORA	A
  0ADA'   F8                    	RM
  0ADB'   C3 0ACD'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0ADE'                         BCK1:
  0ADE'   CD 0B8D'              	CALL	DECC
  0AE1'   B7                    	ORA	A
  0AE2'   37                    	STC
  0AE3'   F8                    	RM
  0AE4'                         BK_WS:
  0AE4'   CD 0B11'              	CALL	CCLS		; back over blanks
  0AE7'   B7                    	ORA	A
  0AE8'   C2 0AF8'              	JNZ	BK_WD
  0AEB'   CD 0B19'              	CALL	EMPTY
  0AEE'   C8                    	RZ			; an empty line is a word
  0AEF'   CD 0B8D'              	CALL	DECC
  0AF2'   B7                    	ORA	A
  0AF3'   F2 0AE4'              	JP	BK_WS
  0AF6'   AF                    	XRA	A		; the start of the file (NC)
  0AF7'   C9                    	RET
  0AF8'                         BK_WD:
  0AF8'   32 294C'              	STA	WKCLS		; back to the start of this word
  0AFB'                         BK_WLP:
  0AFB'   CD 0B8D'              	CALL	DECC
  0AFE'   B7                    	ORA	A
  0AFF'   FA 0B0F'              	JM	BK_OK		; the start of the file
  0B02'   CD 0B11'              	CALL	CCLS
  0B05'   21 294C'              	LXI	H,WKCLS
  0B08'   BE                    	CMP	M
  0B09'   CA 0AFB'              	JZ	BK_WLP
  0B0C'   CD 0B4B'              	CALL	INCC		; overshot: forward one
  0B0F'                         BK_OK:
  0B0F'   AF                    	XRA	A
  0B10'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0B11'                         CCLS:
  0B11'   CD 0995'              	CALL	ATEOF
  0B14'   D2 06A0'              	JNC	CLASSF
  0B17'   AF                    	XRA	A
  0B18'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0B19'                         EMPTY:
  0B19'   CD 0995'              	CALL	ATEOF
  0B1C'   DA 0B27'              	JC	EM_ST
  0B1F'   FE 0D                 	CPI	CR
  0B21'   CA 0B27'              	JZ	EM_ST
  0B24'   FE 0A                 	CPI	LF
  0B26'   C0                    	RNZ
  0B27'                         EM_ST:
  0B27'   CD 0000*              	CALL	PEEKL
  0B2A'   DA 0B30'              	JC	EM_Y
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B2D'   FE 0A                 	CPI	LF
  0B2F'   C9                    	RET
  0B30'                         EM_Y:
  0B30'   AF                    	XRA	A
  0B31'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0B32'                         NXLN:
  0B32'   FE 0A                 	CPI	LF
  0B34'   CA 0B43'              	JZ	NX_LF
  0B37'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0B3A'   D8                    	RC
  0B3B'   FE 0A                 	CPI	LF
  0B3D'   CA 0B43'              	JZ	NX_LF
  0B40'   2B                    	DCX	H		; a lone CR
  0B41'   AF                    	XRA	A
  0B42'   C9                    	RET
  0B43'                         NX_LF:
  0B43'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0B46'   D8                    	RC
  0B47'   2B                    	DCX	H
  0B48'   3E 01                 	MVI	A,1
  0B4A'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0B4B'                         INCC:
  0B4B'   CD 0995'              	CALL	ATEOF
  0B4E'   DA 0B89'              	JC	IC_END
  0B51'   FE 0D                 	CPI	CR
  0B53'   CA 0B74'              	JZ	IC_NL
  0B56'   FE 0A                 	CPI	LF
  0B58'   CA 0B74'              	JZ	IC_NL
  0B5B'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0B5E'                         IC_CH:
  0B5E'   CD 0995'              	CALL	ATEOF
  0B61'   DA 0B70'              	JC	IC_2
  0B64'   FE 0D                 	CPI	CR
  0B66'   CA 0B70'              	JZ	IC_2
  0B69'   FE 0A                 	CPI	LF
  0B6B'   CA 0B70'              	JZ	IC_2
  0B6E'   AF                    	XRA	A
  0B6F'   C9                    	RET
  0B70'                         IC_2:
  0B70'   3E 02                 	MVI	A,2
  0B72'   B7                    	ORA	A
  0B73'   C9                    	RET
  0B74'                         IC_NL:
  0B74'   CD 0B32'              	CALL	NXLN
  0B77'   DA 0B89'              	JC	IC_END
  0B7A'   F5                    	PUSH	PSW
  0B7B'   CD 0000*              	CALL	PUTCUR
  0B7E'   F1                    	POP	PSW
