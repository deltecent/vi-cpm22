  06EF'   7D                    	MOV	A,L
  06F0'   91                    	SUB	C
  06F1'   7C                    	MOV	A,H
  06F2'   98                    	SBB	B
  06F3'   D2 070F'              	JNC	ENL_G		; at the gap: on from its far side
