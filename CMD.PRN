  29B3'   CD 296E'              	CALL	FILMSG
  29B6'   C3 0000*              	JMP	SCURS
  29B9'                         MP_WRT:
  29B9'   CD 297E'              	CALL	WRMSG
  29BC'   C3 0000*              	JMP	SCURS
                                
