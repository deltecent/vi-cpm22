  1C3E'   3A 0001*              	LDA	TFCB+1
  1C41'   FE 20                 	CPI	' '
  1C43'   CA 1C52'              	JZ	PF_BAD		; no name
  1C46'   CD 1CA7'              	CALL	SKIPB
  1C49'   C0                    	RNZ			; more after it
  1C4A'   21 0000*              	LXI	H,TFCB
  1C4D'   CD 1C04'              	CALL	NRMDRV
  1C50'   AF                    	XRA	A
  1C51'   C9                    	RET
  1C52'                         PF_BAD:
  1C52'   F6 01                 	ORI	1
  1C54'   C9                    	RET
                                
