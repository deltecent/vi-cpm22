  0895'   7C                    	MOV	A,H
  0896'   B5                    	ORA	L
  0897'   CA 08A3'              	JZ	JC_AV
  089A'   3A 24C6'              	LDA	JKLST
  089D'   FE 0A                 	CPI	LF
  089F'   C2 08A3'              	JNZ	JC_AV
  08A2'   2B                    	DCX	H
  08A3'                         JC_AV:
  08A3'   22 24C1'              	SHLD	JKMOV
  08A6'   AF                    	XRA	A
  08A7'   32 24C5'              	STA	JKPHN
  08AA'                         JC_MV:
  08AA'   2A 24BD'              	LHLD	JKCNT
  08AD'   AF                    	XRA	A
  08AE'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  08B1'   CD 0970'              	CALL	ATEOF
  08B4'   D2 08C8'              	JNC	JC_DN
  08B7'   CD 0976'              	CALL	LASTLN		; ran past the last line: back onto it
  08BA'   3A 24C5'              	LDA	JKPHN
  08BD'   B7                    	ORA	A
  08BE'   CA 08C8'              	JZ	JC_DN
  08C1'   2A 24C1'              	LHLD	JKMOV
  08C4'   2B                    	DCX	H
  08C5'   22 24C1'              	SHLD	JKMOV
  08C8'                         JC_DN:
  08C8'   2A 24BF'              	LHLD	JKN		; LNDLT += min(moved, N)
  08CB'   EB                    	XCHG
  08CC'   2A 24C1'              	LHLD	JKMOV
  08CF'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  08D2'   D2 08D6'              	JNC	JC_AD
  08D5'   EB                    	XCHG
