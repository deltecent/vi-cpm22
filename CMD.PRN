  2920'   C3 0000*              	JMP	SCURS
  2923'                         MP_BIG:
  2923'   21 23C3'              	LXI	H,SQBIG
  2926'   CD 0000*              	CALL	EXMSG
  2929'   C3 0000*              	JMP	SCURS
  292C'                         MP_FIL:
  292C'   CD 28E7'              	CALL	FILMSG
  292F'   C3 0000*              	JMP	SCURS
  2932'                         MP_WRT:
  2932'   CD 28F7'              	CALL	WRMSG
  2935'   C3 0000*              	JMP	SCURS
                                
