  2DBA'   1836'                 	DW	VCB_C
  2DBC'   63                    	DB	'c'
  2DBD'   1ADB'                 	DW	VC_C
  2DBF'   6F                    	DB	'o'
  2DC0'   1971'                 	DW	VC_O
