  11B1'   4B                    	MOV	C,E
  11B2'   3A 0000*              	LDA	HTCUR
  11B5'   CD 11F4'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  11B8'   3A 0000*              	LDA	CSUB
  11BB'   57                    	MOV	D,A
  11BC'   79                    	MOV	A,C
  11BD'   92                    	SUB	D		; the rows to go, less those of its own line above it
  11BE'   DA 1135'              	JC	HFEND
  11C1'   CA 1135'              	JZ	HFEND
  11C4'   4F                    	MOV	C,A
  11C5'   43                    	MOV	B,E
  11C6'   CD 1223'              	CALL	HTBQ		; (off the top: the file's first line)
  11C9'   C3 1135'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11CC'                         HTSCR:
  11CC'   CD 0EDA'              	CALL	CURRW
  11CF'   47                    	MOV	B,A
  11D0'   C3 11DE'              	JMP	HS_TP
  11D3'                         HTSET:
  11D3'   47                    	MOV	B,A
  11D4'   CD 0EDA'              	CALL	CURRW		; (keeps BC)
  11D7'   F5                    	PUSH	PSW
  11D8'   80                    	ADD	B
  11D9'   47                    	MOV	B,A
  11DA'   CD 11E8'              	CALL	HTRB
  11DD'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11DE'                         HS_TP:
  11DE'   3A 0000*              	LDA	HTCUR
  11E1'   90                    	SUB	B
  11E2'   32 0000*              	STA	HTTP
  11E5'   C3 11F4'              	JMP	HTPT
  11E8'                         HTRB:
  11E8'   CD 13DB'              	CALL	ZSAVE
  11EB'   CD 0000*              	CALL	HTBLD
  11EE'   CD 13EE'              	CALL	ZREST
  11F1'   3A 0000*              	LDA	HTCUR
  11F4'                         HTPT:
  11F4'   5F                    	MOV	E,A
  11F5'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11F7'   21 0000*              	LXI	H,HTAB
  11FA'   19                    	DAD	D
  11FB'   3A 0000*              	LDA	HTN
  11FE'   93                    	SUB	E
  11FF'   47                    	MOV	B,A
  1200'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  1201'                         HTIX:
  1201'   11 0000*              	LXI	D,HTAB
  1204'   7D                    	MOV	A,L
  1205'   93                    	SUB	E
  1206'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  1207'                         HTGO:
  1207'   CD 1201'              	CALL	HTIX
  120A'   47                    	MOV	B,A
  120B'   3A 0000*              	LDA	HTCUR
  120E'   90                    	SUB	B		; A = the lines up to it
  120F'   C3 0F11'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  1212'                         HTFQ:
  1212'   78                    	MOV	A,B
  1213'   B7                    	ORA	A
  1214'   37                    	STC
  1215'   C8                    	RZ
  1216'   79                    	MOV	A,C
  1217'   96                    	SUB	M
  1218'   DA 1221'              	JC	HF_IN
  121B'   4F                    	MOV	C,A
  121C'   23                    	INX	H
  121D'   05                    	DCR	B
  121E'   C3 1212'              	JMP	HTFQ
  1221'                         HF_IN:
  1221'   B7                    	ORA	A
  1222'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1223'                         HTBQ:
  1223'   78                    	MOV	A,B
  1224'   B7                    	ORA	A
  1225'   37                    	STC
  1226'   C8                    	RZ
  1227'   2B                    	DCX	H
  1228'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1229'   7E                    	MOV	A,M
  122A'   91                    	SUB	C
  122B'   D2 1234'              	JNC	HQ_IN
  122E'   2F                    	CMA
  122F'   3C                    	INR	A
  1230'   4F                    	MOV	C,A
  1231'   C3 1223'              	JMP	HTBQ
  1234'                         HQ_IN:
  1234'   4F                    	MOV	C,A
  1235'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  1236'                         RWQ:
  1236'   0E 64                 	MVI	C,100
  1238'   3A 0001*              	LDA	RWR+1
  123B'   B7                    	ORA	A
  123C'   C0                    	RNZ
  123D'   3A 0000*              	LDA	RWR
  1240'   B9                    	CMP	C
  1241'   D0                    	RNC
  1242'   4F                    	MOV	C,A
  1243'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1244'                         RWSUB:
  1244'   E5                    	PUSH	H
  1245'   5F                    	MOV	E,A
  1246'   16 00                 	MVI	D,0
  1248'   2A 0000*              	LHLD	RWR
  124B'   CD 0000*              	CALL	SUBHD
  124E'   22 0000*              	SHLD	RWR
  1251'   E1                    	POP	H
  1252'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1253'                         RWFWD:
  1253'   CD 1236'              	CALL	RWQ
  1256'   51                    	MOV	D,C
  1257'   CD 1212'              	CALL	HTFQ
  125A'   F5                    	PUSH	PSW
  125B'   7A                    	MOV	A,D
  125C'   91                    	SUB	C		; the rows that took it to that line's first
  125D'   CD 1244'              	CALL	RWSUB
  1260'   F1                    	POP	PSW
  1261'   DA 1275'              	JC	RF_OFF
  1264'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  1267'   B7                    	ORA	A
  1268'   C2 127F'              	JNZ	RF_GO
  126B'   3A 0000*              	LDA	RWR
  126E'   BE                    	CMP	M
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  126F'   D2 127F'              	JNC	RF_GO
  1272'   4F                    	MOV	C,A
  1273'   B7                    	ORA	A
  1274'   C9                    	RET
  1275'                         RF_OFF:
  1275'   3A 0000*              	LDA	HTEOF
  1278'   B7                    	ORA	A
  1279'   CA 127F'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  127C'   2B                    	DCX	H
  127D'   37                    	STC
  127E'   C9                    	RET
  127F'                         RF_GO:
  127F'   CD 1207'              	CALL	HTGO
  1282'   3E 01                 	MVI	A,1
  1284'   32 0000*              	STA	RWMV
  1287'   CD 1236'              	CALL	RWQ
  128A'   0C                    	INR	C
  128B'   06 00                 	MVI	B,0
  128D'   CD 11E8'              	CALL	HTRB
  1290'   C3 1253'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1293'                         RWBAK:
  1293'   CD 1236'              	CALL	RWQ
  1296'   51                    	MOV	D,C
  1297'   CD 1223'              	CALL	HTBQ
  129A'   DA 12B7'              	JC	RB_OFF
  129D'   7A                    	MOV	A,D
  129E'   81                    	ADD	C
  129F'   5F                    	MOV	E,A		; E = the rows up to that line's first
  12A0'   3A 0001*              	LDA	RWR+1
  12A3'   B7                    	ORA	A
  12A4'   C2 12B3'              	JNZ	RB_ON
  12A7'   3A 0000*              	LDA	RWR
  12AA'   57                    	MOV	D,A
  12AB'   7B                    	MOV	A,E
  12AC'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  12AD'   DA 12B3'              	JC	RB_ON
  12B0'   4F                    	MOV	C,A
  12B1'   B7                    	ORA	A
  12B2'   C9                    	RET
  12B3'                         RB_ON:
  12B3'   7B                    	MOV	A,E
  12B4'   C3 12BE'              	JMP	RB_GO
  12B7'                         RB_OFF:
  12B7'   3A 0000*              	LDA	HTBOF
  12BA'   0F                    	RRC			; CY: that is the file's first line
  12BB'   D8                    	RC
  12BC'   7A                    	MOV	A,D
  12BD'   91                    	SUB	C
  12BE'                         RB_GO:
  12BE'   CD 1244'              	CALL	RWSUB
  12C1'   CD 1207'              	CALL	HTGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12C4'   3E 01                 	MVI	A,1
  12C6'   32 0000*              	STA	RWMV
  12C9'   CD 1236'              	CALL	RWQ
  12CC'   41                    	MOV	B,C
  12CD'   0E 01                 	MVI	C,1
  12CF'   CD 11E8'              	CALL	HTRB
  12D2'   43                    	MOV	B,E
  12D3'   C3 1293'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12D6'                         ONFST:
  12D6'   E5                    	PUSH	H
  12D7'   2A 0000*              	LHLD	OUTPOS
  12DA'   7C                    	MOV	A,H
  12DB'   B5                    	ORA	L
  12DC'   C2 12F4'              	JNZ	OF_RET
  12DF'   2A 0000*              	LHLD	TXTBEG
  12E2'   EB                    	XCHG			; DE = TXTBEG
  12E3'   2A 0000*              	LHLD	GAPBEG
  12E6'                         OF_LP:
  12E6'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12E9'   CA 12F4'              	JZ	OF_RET
  12EC'   2B                    	DCX	H
  12ED'   7E                    	MOV	A,M
  12EE'   FE 0A                 	CPI	LF
  12F0'   C2 12E6'              	JNZ	OF_LP
  12F3'   B7                    	ORA	A		; NZ
  12F4'                         OF_RET:
  12F4'   E1                    	POP	H
  12F5'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12F6'                         HFCNT:
  12F6'   2A 0000*              	LHLD	CMDCNT
  12F9'   7C                    	MOV	A,H
  12FA'   B5                    	ORA	L
  12FB'   CA 1312'              	JZ	HFC_AM
  12FE'   CD 0798'              	CALL	GETCNT		; HL = count; clears it
  1301'   3A 0000*              	LDA	NEDIT
  1304'   5F                    	MOV	E,A
  1305'   16 00                 	MVI	D,0
  1307'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  130A'   D2 130E'              	JNC	HFC_ST
  130D'   EB                    	XCHG			; HL = NEDIT
  130E'                         HFC_ST:
  130E'   7D                    	MOV	A,L
  130F'   32 0000*              	STA	HFAMT
  1312'                         HFC_AM:
  1312'   3A 0000*              	LDA	HFAMT
  1315'   B7                    	ORA	A
  1316'   C2 1323'              	JNZ	HFC_HL
  1319'   3A 0000*              	LDA	NEDIT
  131C'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  131D'   1F                    	RAR
  131E'   B7                    	ORA	A
  131F'   C2 1323'              	JNZ	HFC_HL
  1322'   3C                    	INR	A		; at least one row
  1323'                         HFC_HL:
  1323'   32 0000*              	STA	HFN
  1326'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  1327'                         VC_REDR:
  1327'   C3 0798'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  132A'                         VC_G:
  132A'   CD 086D'              	CALL	SETMOV
  132D'   CD 1401'              	CALL	GZONE		; the screen's top line, before the move
  1330'   CD 07C1'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1333'   2A 0000*              	LHLD	CMDCNT
  1336'   7C                    	MOV	A,H
  1337'   B5                    	ORA	L
  1338'   C2 134B'              	JNZ	VG_N
  133B'   AF                    	XRA	A		; forward
  133C'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  133F'   CD 07FE'              	CALL	BRKOFF
  1342'   DA 0816'              	JC	BRKBAK
  1345'   CD 0BFC'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  1348'   C3 1419'              	JMP	GPLACE
  134B'                         VG_N:
  134B'   CD 0798'              	CALL	GETCNT		; HL = target line (1-based)
  134E'                         VG_LN:
  134E'   CD 135A'              	CALL	GOLN
  1351'   CD 07FE'              	CALL	BRKOFF
  1354'   DA 0816'              	JC	BRKBAK
  1357'   C3 1419'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


                                ;A line less than half as far down as the window's top, on a file not changed
                                ;since it was opened or written, is the exception: PGJUMP reads the file
                                ;again from its start and the move counts forward from line 1 (#34 part B).
  135A'                         GOLN:
  135A'   E5                    	PUSH	H
  135B'   CD 0000*              	CALL	CNTLF
  135E'   23                    	INX	H		; HL = the cursor's line
  135F'   D1                    	POP	D		; DE = the line wanted
  1360'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1363'   DA 136E'              	JC	GLN_BK
  1366'   EB                    	XCHG
  1367'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  136A'   AF                    	XRA	A
  136B'   C3 1388'              	JMP	GLN_MV
  136E'                         GLN_BK:
  136E'   E5                    	PUSH	H
  136F'   D5                    	PUSH	D
  1370'   2A 0000*              	LHLD	TOPLF
  1373'   EB                    	XCHG			; DE = the lines behind the window
  1374'   2B                    	DCX	H		; HL = the lines above the one wanted
  1375'   CD 0000*              	CALL	PGJUMP
  1378'   D1                    	POP	D
  1379'   E1                    	POP	H
  137A'   D2 1383'              	JNC	GLN_UP
  137D'   EB                    	XCHG			; it jumped: the cursor is on line 1
  137E'   2B                    	DCX	H		; HL = the lines down to it
  137F'   AF                    	XRA	A
  1380'   C3 1388'              	JMP	GLN_MV
  1383'                         GLN_UP:
  1383'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1386'   3E FF                 	MVI	A,0FFH
  1388'                         GLN_MV:
  1388'   CD 0000*              	CALL	MVLIND
  138B'   CD 0BF6'              	CALL	ATEOF
  138E'   DC 0BFC'              	CC	LASTLN		; past the last line: onto it
  1391'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1392'                         VC_LG:
  1392'   CD 086D'              	CALL	SETMOV
  1395'   3A 0000*              	LDA	GSAVE
  1398'   B7                    	ORA	A
  1399'   C2 13A2'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  139C'   3E 01                 	MVI	A,PG
  139E'   32 0000*              	STA	GPEND
  13A1'   C9                    	RET
  13A2'                         VLG_GG:
  13A2'   CD 1401'              	CALL	GZONE
  13A5'   CD 07C1'              	CALL	BRKON
  13A8'   CD 0798'              	CALL	GETCNT		; HL = target line (no count: 1)
  13AB'   C3 134E'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  13AE'                         SUB24:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13AE'   4F                    	MOV	C,A
  13AF'   7D                    	MOV	A,L
  13B0'   93                    	SUB	E
  13B1'   6F                    	MOV	L,A
  13B2'   7C                    	MOV	A,H
  13B3'   9A                    	SBB	D
  13B4'   67                    	MOV	H,A
  13B5'   79                    	MOV	A,C
  13B6'   98                    	SBB	B
  13B7'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  13B8'                         CURFP:
  13B8'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  13BB'                         FPOS:
  13BB'   C5                    	PUSH	B
  13BC'   D5                    	PUSH	D
  13BD'   EB                    	XCHG
  13BE'   2A 0000*              	LHLD	TXTBEG
  13C1'   EB                    	XCHG
  13C2'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  13C5'   EB                    	XCHG			; DE = that
  13C6'   2A 0000*              	LHLD	OUTPOS
  13C9'   7C                    	MOV	A,H
  13CA'   B7                    	ORA	A		; CY = 0
  13CB'   1F                    	RAR
  13CC'   47                    	MOV	B,A
  13CD'   7D                    	MOV	A,L
  13CE'   1F                    	RAR
  13CF'   67                    	MOV	H,A
  13D0'   3E 00                 	MVI	A,0
  13D2'   1F                    	RAR
  13D3'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13D4'   19                    	DAD	D
  13D5'   78                    	MOV	A,B
  13D6'   CE 00                 	ACI	0		; A:HL = the position
  13D8'   D1                    	POP	D
  13D9'   C1                    	POP	B
  13DA'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13DB'                         ZSAVE:
  13DB'   2A 0000*              	LHLD	CMDCNT
  13DE'   22 0000*              	SHLD	ZSVCNT
  13E1'   2A 0000*              	LHLD	AUXCNT
  13E4'   22 0000*              	SHLD	ZSVAUX
  13E7'   3A 0000*              	LDA	DIRFLG
  13EA'   32 0000*              	STA	ZSVDIR
  13ED'   C9                    	RET
  13EE'                         ZREST:
  13EE'   2A 0000*              	LHLD	ZSVCNT
  13F1'   22 0000*              	SHLD	CMDCNT
  13F4'   2A 0000*              	LHLD	ZSVAUX
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  13F7'   22 0000*              	SHLD	AUXCNT
  13FA'   3A 0000*              	LDA	ZSVDIR
  13FD'   32 0000*              	STA	DIRFLG
  1400'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  1401'                         GZONE:
  1401'   CD 13DB'              	CALL	ZSAVE
  1404'   CD 0EDA'              	CALL	CURRW
  1407'   6F                    	MOV	L,A
  1408'   26 00                 	MVI	H,0
  140A'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  140D'   CD 13BB'              	CALL	FPOS
  1410'   22 0000*              	SHLD	ZTOP
  1413'   32 0002*              	STA	ZTOP+2
  1416'   C3 13EE'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  1419'                         GPLACE:
  1419'   CD 13DB'              	CALL	ZSAVE
  141C'   CD 13B8'              	CALL	CURFP
  141F'   EB                    	XCHG
  1420'   2A 0000*              	LHLD	ZTOP
  1423'   EB                    	XCHG
  1424'   4F                    	MOV	C,A		; C:HL = the target's position
  1425'   3A 0002*              	LDA	ZTOP+2
  1428'   47                    	MOV	B,A		; B:DE = the top's
  1429'   79                    	MOV	A,C
  142A'   CD 13AE'              	CALL	SUB24
  142D'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1430'   DA 146A'              	JC	GP_UP
  1433'   B7                    	ORA	A
  1434'   C2 14B0'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1437'   3A 0000*              	LDA	NEDIT
  143A'   87                    	ADD	A
  143B'   3C                    	INR	A
  143C'   6F                    	MOV	L,A
  143D'   26 00                 	MVI	H,0
  143F'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1442'   CD 0791'              	CALL	GBSUB		; HL = bytes from there to the target
  1445'   EB                    	XCHG
  1446'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
  1449'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  144C'   DA 14B0'              	JC	GP_MID
  144F'   CD 0791'              	CALL	GBSUB		; HL = the top line's start (resident)
  1452'   01 0000               	LXI	B,0		; BC = lines from the top
  1455'                         GP_CNT:
  1455'   7A                    	MOV	A,D
  1456'   B3                    	ORA	E
  1457'   CA 1466'              	JZ	GP_DN
  145A'   7E                    	MOV	A,M
  145B'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  145C'   1B                    	DCX	D
  145D'   FE 0A                 	CPI	LF
  145F'   C2 1455'              	JNZ	GP_CNT
  1462'   03                    	INX	B
  1463'   C3 1455'              	JMP	GP_CNT
  1466'                         GP_DN:
  1466'   79                    	MOV	A,C		; the lines from the top one to it
  1467'   C3 14DA'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  146A'                         GP_UP:
  146A'   3C                    	INR	A
  146B'   C2 14B0'              	JNZ	GP_MID		; 64K bytes or more above
  146E'   2A 0000*              	LHLD	ZDIF
  1471'   EB                    	XCHG
  1472'   21 0000               	LXI	H,0
  1475'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1478'   7C                    	MOV	A,H
  1479'   B5                    	ORA	L
  147A'   CA 14B0'              	JZ	GP_MID		; exactly 64K
  147D'   EB                    	XCHG			; DE = bytes to read
  147E'   AF                    	XRA	A
  147F'   32 0000*              	STA	ZLF
  1482'   CD 0000*              	CALL	RGET0
  1485'                         GP_RD:
  1485'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1488'   DA 14B0'              	JC	GP_MID
  148B'   FE 0A                 	CPI	LF
  148D'   C2 14A1'              	JNZ	GP_RN
  1490'   3A 0000*              	LDA	NEDIT
  1493'   B7                    	ORA	A
  1494'   1F                    	RAR
  1495'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1497'   E5                    	PUSH	H
  1498'   21 0000*              	LXI	H,ZLF
  149B'   34                    	INR	M
  149C'   BE                    	CMP	M		; CY iff more lines than that
  149D'   E1                    	POP	H
  149E'   DA 14B0'              	JC	GP_MID
  14A1'                         GP_RN:
  14A1'   1B                    	DCX	D
  14A2'   7A                    	MOV	A,D
  14A3'   B3                    	ORA	E
  14A4'   C2 1485'              	JNZ	GP_RD
  14A7'   3E 01                 	MVI	A,PL_SET	; the top row
  14A9'   32 0000*              	STA	PLACE
  14AC'   AF                    	XRA	A
  14AD'   C3 14BA'              	JMP	GP_SET
  14B0'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  14B0'   3E 02                 	MVI	A,PL_MID
  14B2'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  14B5'   3A 0000*              	LDA	NEDIT
  14B8'   B7                    	ORA	A
  14B9'   1F                    	RAR			; (no more lines above it than this)
  14BA'                         GP_SET:
  14BA'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  14BB'   26 00                 	MVI	H,0
  14BD'   22 0000*              	SHLD	WINROW
  14C0'   21 0000               	LXI	H,0
  14C3'   22 0000*              	SHLD	LNDLT
  14C6'   CD 08AA'              	CALL	SETFUL		; the window may have paged: full repaint
  14C9'                         GP_FIN:
  14C9'   CD 13EE'              	CALL	ZREST
  14CC'   3A 0000*              	LDA	GPKEEP
  14CF'   B7                    	ORA	A
  14D0'   CA 0973'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14D3'   AF                    	XRA	A
  14D4'   32 0000*              	STA	GPKEEP
  14D7'   C3 062C'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14DA'                         GP_ONS:
  14DA'   6F                    	MOV	L,A
  14DB'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14DD'   EB                    	XCHG
  14DE'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14E1'   EB                    	XCHG
  14E2'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14E5'   22 0000*              	SHLD	LNDLT
  14E8'   3E 01                 	MVI	A,R_MOVE
  14EA'   32 0000*              	STA	RINTENT
  14ED'   C3 14C9'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ; A jump (` and the searches / ? n N) is charwise exclusive across lines.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14F0'                         OPPEND:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  14F0'   AF                    	XRA	A
  14F1'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14F4'   3A 0000*              	LDA	PSAVE
  14F7'   FE 63                 	CPI	'c'
  14F9'   C2 1516'              	JNZ	OPP_ND
  14FC'   79                    	MOV	A,C
  14FD'   FE 77                 	CPI	'w'
  14FF'   CA 1507'              	JZ	OPP_W
  1502'   FE 57                 	CPI	'W'
  1504'   C2 1516'              	JNZ	OPP_ND
  1507'                         OPP_W:
  1507'   CD 1716'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  150A'   DA 1516'              	JC	OPP_ND
  150D'   79                    	MOV	A,C
  150E'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1510'   4F                    	MOV	C,A
  1511'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  1513'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  1516'                         OPP_ND:
  1516'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  1517'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  1519'   C2 152D'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  151C'   CD 01FC'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  151F'   DA 15EA'              	JC	OPABRT
  1522'   79                    	MOV	A,C
  1523'   FE 67                 	CPI	'g'
  1525'   C2 15EA'              	JNZ	OPABRT
  1528'   3E 01                 	MVI	A,PG
  152A'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  152D'                         OPP_NG:
  152D'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  152E'   21 0000*              	LXI	H,PSAVE
  1531'   BE                    	CMP	M
  1532'   CA 1737'              	JZ	OPLINE
  1535'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1536'   CD 174D'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1539'   DA 1573'              	JC	OPP_NM		;   -- and not a mark, so nothing is owed below
  153C'   32 0000*              	STA	OPCLSV
  153F'   47                    	MOV	B,A		; B = the class
  1540'   3A 0000*              	LDA	PSAVE
  1543'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1545'   C2 1551'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1548'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1549'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  154B'   C2 1598'              	JNZ	OPP_GO
  154E'   C3 155C'              	JMP	OPP_NO
  1551'                         OPP_NC:
  1551'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1553'   C2 1598'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1556'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1557'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1559'   CA 1598'              	JZ	OPP_GO		;   within a line -- neither of which is built
  155C'                         OPP_NO:
  155C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  155D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  155F'   CA 156D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1562'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1564'   CA 156D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1567'   CD 0329'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  156A'   C2 1573'              	JNZ	OPP_NM		;   motions only, so the find is dropped here);
                                				;   a search reads a whole line: OPP_NM
  156D'                         OPP_SW:
  156D'   CD 01FC'              	CALL	MKGETK
  1570'   C3 15EA'              	JMP	OPABRT
                                ;OPP_NM -- not a motion, or not one this operator takes.  A search ('/' '?'
                                ; 'n' 'N') is a motion for 'd' and 'c' (OPCTAB class 3), but a charwise one,
                                ; and 'y' takes linewise motions only, so 'y/' and 'yn' arrive here from
                                ; OPP_NO.  That is the one drop that cannot be silent: a '/' or '?' left to the
                                ; next dispatch reads no line, so 'y/QJQK<CR>' would run the pattern as
                                ; commands ('J' joins two lines).  So the line is read the way a search reads
                                ; it, and thrown away, and the bell says nothing was done.
  1573'                         OPP_NM:
  1573'   79                    	MOV	A,C
  1574'   FE 2F                 	CPI	'/'
  1576'   CA 1588'              	JZ	OPP_SL
  1579'   FE 3F                 	CPI	'?'
  157B'   CA 1588'              	JZ	OPP_SL
  157E'   E6 DF                 	ANI	0DFH		; 'n' -> 'N'
  1580'   FE 4E                 	CPI	'N'
  1582'   C2 15EA'              	JNZ	OPABRT		; any other key: dropped, as before
  1585'   C3 1590'              	JMP	OPP_BL
  1588'                         OPP_SL:
  1588'   11 0000*              	LXI	D,EXBUF		; the ':' line's buffer, free between commands;
  158B'   06 28                 	MVI	B,EXMAX		;   C is the key, and so the prompt.  A cancel
  158D'   CD 2198'              	CALL	RDLINE		;   (ESC, or BS on an empty line) rings too
  1590'                         OPP_BL:
  1590'   0E 07                 	MVI	C,BEL
  1592'   CD 0000*              	CALL	BCONOU
  1595'   C3 15EA'              	JMP	OPABRT
  1598'                         OPP_GO:
  1598'   AF                    	XRA	A
  1599'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  159C'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  159F'   22 0000*              	SHLD	OPSTA
  15A2'   C5                    	PUSH	B
  15A3'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  15A6'   CD 0444'              	CALL	FPSTO		;   only good until the motion pages the window
  15A9'   3A 0000*              	LDA	OPCLSV
  15AC'   FE 02                 	CPI	2
  15AE'   CC 15ED'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  15B1'   C1                    	POP	B
  15B2'   21 3170'              	LXI	H,CMDTAB
  15B5'   CD 00C6'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  15B8'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  15BB'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  15BC'   CA 086D'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  15BF'   3A 0000*              	LDA	OPCLSV
  15C2'   FE 02                 	CPI	2
  15C4'   CC 0960'              	CZ	LNEND		; a line motion: the line it landed on whole, or
                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  15C7'   CD 1619'              	CALL	OPSFIX		; where the start is in the window NOW
  15CA'   D2 1635'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  15CD'   22 0000*              	SHLD	OPSTA
  15D0'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  15D3'   22 0000*              	SHLD	OPEND2
  15D6'   3A 0000*              	LDA	PSAVE
  15D9'   FE 79                 	CPI	'y'
  15DB'   CA 1CF7'              	JZ	OPYANK		; a yank takes the span without losing it
  15DE'   CD 1788'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  15E1'   3A 0000*              	LDA	PSAVE
  15E4'   FE 63                 	CPI	'c'
  15E6'   C0                    	RNZ
  15E7'   C3 1AAB'              	JMP	SETINS
  15EA'                         OPABRT:				; not a motion -> the operator is dropped and
  15EA'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  15ED'                         OPENDS:
  15ED'   2A 0000*              	LHLD	OPSTA
  15F0'   CD 0693'              	CALL	BOL
  15F3'   11 0000*              	LXI	D,OPSLO
  15F6'   CD 160B'              	CALL	OPE_ST
  15F9'   2A 0000*              	LHLD	OPSTA
  15FC'   CD 072A'              	CALL	NLSTART
  15FF'   11 0000*              	LXI	D,OPSHI
  1602'   CD 160B'              	CALL	OPE_ST
  1605'   2A 0000*              	LHLD	OPSTA
  1608'   C3 0000*              	JMP	GOTO
  160B'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  160B'   D5                    	PUSH	D
  160C'   CD 0000*              	CALL	GOTO
  160F'   E1                    	POP	H
  1610'   C3 0444'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1613'                         CURBD:
  1613'   CD 13B8'              	CALL	CURFP
  1616'   EB                    	XCHG
  1617'   47                    	MOV	B,A
  1618'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  1619'                         OPSFIX:
  1619'   21 0000*              	LXI	H,OPSFP
  161C'   CD 03FB'              	CALL	MKLOAD
  161F'   CD 1613'              	CALL	CURBD
  1622'   2A 0000*              	LHLD	MKPOS
  1625'   3A 0002*              	LDA	MKPOS+2
  1628'   CD 13AE'              	CALL	SUB24
  162B'   B4                    	ORA	H
  162C'   B5                    	ORA	L
  162D'   C2 0408'              	JNZ	MKWIN
  1630'   CD 0000*              	CALL	CUROFF
  1633'   37                    	STC
  1634'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1635'                         OPPGD:
  1635'   47                    	MOV	B,A
  1636'   3A 0000*              	LDA	OPCLSV
  1639'   FE 02                 	CPI	2
  163B'   C2 16F7'              	JNZ	OPG_NO
  163E'   3A 0000*              	LDA	PSAVE
  1641'   FE 64                 	CPI	'd'
  1643'   C2 16F7'              	JNZ	OPG_NO
  1646'   04                    	INR	B
  1647'   CA 1656'              	JZ	OPG_FW
  164A'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  164D'   CD 0693'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1650'   CD 0000*              	CALL	GOTO
  1653'   C3 166E'              	JMP	OPG_GO
  1656'                         OPG_FW:
  1656'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1659'   CD 072A'              	CALL	NLSTART		;   landed on, and the low one is where the
  165C'   11 0000*              	LXI	D,OPSHI		;   start line began
  165F'   CD 160B'              	CALL	OPE_ST
  1662'   21 0000*              	LXI	H,OPSLO
  1665'   CD 03FB'              	CALL	MKLOAD
  1668'   CD 03AC'              	CALL	MKPAGE
  166B'   CD 0000*              	CALL	GOTO
  166E'                         OPG_GO:
  166E'   CD 1613'              	CALL	CURBD
  1671'   2A 0000*              	LHLD	OPSHI
  1674'   3A 0002*              	LDA	OPSHI+2
  1677'   CD 13AE'              	CALL	SUB24		; A:HL = the bytes to take
  167A'                         OPG_SV:
  167A'   22 0000*              	SHLD	OPTOGO
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  167D'   32 0002*              	STA	OPTOGO+2
  1680'                         OPG_NX:
  1680'   CD 0774'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1683'   CD 0000*              	CALL	SUBHD
  1686'   EB                    	XCHG			; DE = what the window holds past the cursor
  1687'   2A 0000*              	LHLD	OPTOGO
  168A'   3A 0002*              	LDA	OPTOGO+2
  168D'   B7                    	ORA	A
  168E'   C2 16C1'              	JNZ	OPG_PG		; 64K or more to go
  1691'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1694'   DA 16C1'              	JC	OPG_PG
  1697'   CA 16C1'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  169A'                         OPG_FN:				; the rest of it is here
  169A'   E5                    	PUSH	H
  169B'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  169E'   CD 0000*              	CALL	CUROFF
  16A1'   22 0000*              	SHLD	OPLO
  16A4'   D1                    	POP	D
  16A5'   19                    	DAD	D
  16A6'   22 0000*              	SHLD	OPHI
  16A9'   CD 18BB'              	CALL	OPDSPN
  16AC'   CD 0BF6'              	CALL	ATEOF
  16AF'   D2 1710'              	JNC	OPMID
  16B2'   CD 12D6'              	CALL	ONFST		; deleted to the end of the file: onto the new
  16B5'   CA 1710'              	JZ	OPMID		;   last line, if there is one -- and the pager
  16B8'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  16BB'   CD 0000*              	CALL	SETBWD
  16BE'   C3 1710'              	JMP	OPMID
  16C1'                         OPG_PG:
  16C1'   7A                    	MOV	A,D
  16C2'   B3                    	ORA	E
  16C3'   C2 16DC'              	JNZ	OPG_DL
  16C6'   CD 0BF6'              	CALL	ATEOF		; nothing held past the cursor
  16C9'   21 0000               	LXI	H,0
  16CC'   DA 169A'              	JC	OPG_FN		; ... and no more to come: the file ran out
  16CF'   2B                    	DCX	H
  16D0'   CD 0000*              	CALL	SETC0
  16D3'   CD 0000*              	CALL	GOLINE
  16D6'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  16D9'   C3 1680'              	JMP	OPG_NX
  16DC'                         OPG_DL:
  16DC'   D5                    	PUSH	D
  16DD'   21 FFFF               	LXI	H,0FFFFH
  16E0'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  16E3'   E1                    	POP	H
  16E4'   E5                    	PUSH	H
  16E5'   CD 0000*              	CALL	DELFWD
  16E8'   D1                    	POP	D
  16E9'   06 00                 	MVI	B,0
  16EB'   2A 0000*              	LHLD	OPTOGO
  16EE'   3A 0002*              	LDA	OPTOGO+2
  16F1'   CD 13AE'              	CALL	SUB24
  16F4'   C3 167A'              	JMP	OPG_SV
  16F7'                         OPG_NO:
  16F7'   0E 07                 	MVI	C,BEL
  16F9'   CD 0000*              	CALL	BCONOU
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  16FC'                         OPG_HM:				; the cursor back where the command found it
  16FC'   21 0000*              	LXI	H,OPSFP
  16FF'   CD 03FB'              	CALL	MKLOAD
  1702'   CD 03AC'              	CALL	MKPAGE
  1705'   CD 0000*              	CALL	GOTO
  1708'   AF                    	XRA	A
  1709'   32 0000*              	STA	PSAVE
  170C'   3C                    	INR	A
  170D'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1710'                         OPMID:
  1710'   CD 13DB'              	CALL	ZSAVE
  1713'   C3 14B0'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1716'                         ONWHIT:
  1716'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1719'   CA 1735'              	JZ	OW_YES
  171C'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  171F'   FE 20                 	CPI	' '
  1721'   CA 1735'              	JZ	OW_YES
  1724'   FE 09                 	CPI	TAB
  1726'   CA 1735'              	JZ	OW_YES
  1729'   FE 0D                 	CPI	CR
  172B'   CA 1735'              	JZ	OW_YES
  172E'   FE 0A                 	CPI	LF
  1730'   CA 1735'              	JZ	OW_YES
  1733'   B7                    	ORA	A		; a char to change: CY clear
  1734'   C9                    	RET
  1735'                         OW_YES:
  1735'   37                    	STC
  1736'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  1737'                         OPLINE:
  1737'   3A 0000*              	LDA	PSAVE
  173A'   FE 63                 	CPI	'c'
  173C'   CA 086D'              	JZ	SETMOV
  173F'   FE 79                 	CPI	'y'
  1741'   CA 1CD6'              	JZ	VY_YY
  1744'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1747'   CD 0444'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  174A'   C3 1C4C'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  174D'                         OPCLS:
  174D'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  174F'   CA 175C'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1752'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1754'   C2 1770'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1757'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1759'   C3 175E'              	JMP	OPC_FK
  175C'                         OPC_SEM:
  175C'   06 00                 	MVI	B,0		; ';' runs it as it stands
  175E'                         OPC_FK:
  175E'   3A 0000*              	LDA	FNDKND
  1761'   B7                    	ORA	A
  1762'   37                    	STC
  1763'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1764'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1765'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1767'   CA 176E'              	JZ	OPC_EXC
  176A'   3E 01                 	MVI	A,1
  176C'   B7                    	ORA	A		; CY clear: a motion, class 1
  176D'   C9                    	RET
  176E'                         OPC_EXC:
  176E'   AF                    	XRA	A		; class 0, CY clear
  176F'   C9                    	RET
  1770'                         OPC_TB:
  1770'   47                    	MOV	B,A
  1771'   21 1960'              	LXI	H,OPCTAB
  1774'                         OPC_LP:
  1774'   7E                    	MOV	A,M
  1775'   B7                    	ORA	A
  1776'   CA 1786'              	JZ	OPC_MS		; end of table -> not a motion
  1779'   B8                    	CMP	B
  177A'   CA 1782'              	JZ	OPC_HT
  177D'   23                    	INX	H
  177E'   23                    	INX	H
  177F'   C3 1774'              	JMP	OPC_LP
  1782'                         OPC_HT:
  1782'   23                    	INX	H
  1783'   7E                    	MOV	A,M		; class byte
  1784'   B7                    	ORA	A		; clear CY
  1785'   C9                    	RET
  1786'                         OPC_MS:
  1786'   37                    	STC
  1787'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1788'                         OPAPPL:
  1788'   3A 0000*              	LDA	OPCLSV
  178B'   FE 02                 	CPI	2
  178D'   CA 1934'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1790'   2A 0000*              	LHLD	OPSTA
  1793'   EB                    	XCHG			; DE = start
  1794'   2A 0000*              	LHLD	OPEND2		; HL = end
  1797'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  179A'   DA 17AD'              	JC	OPA_F
  179D'   CA 17AD'              	JZ	OPA_F		; forward or empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                	;--- backward: lo = end (HL), hi = start (DE) ---
  17A0'   22 0000*              	SHLD	OPLO
  17A3'   EB                    	XCHG
  17A4'   22 0000*              	SHLD	OPHI
  17A7'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  17AA'   C3 1864'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  17AD'                         OPA_F:
  17AD'   EB                    	XCHG			; HL = start, DE = end
  17AE'   22 0000*              	SHLD	OPLO
  17B1'   EB                    	XCHG			; HL = end
  17B2'   3A 0000*              	LDA	OPCLSV
  17B5'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  17B7'   CA 1861'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  17BA'   FE 01                 	CPI	1
  17BC'   C2 17DE'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  17BF'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  17C0'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  17C3'   2B                    	DCX	H		; the line it landed on
  17C4'   CD 1A29'              	CALL	CEND		; HL = that line's content end
  17C7'   EB                    	XCHG			; DE = it
  17C8'   2A 0000*              	LHLD	OPHI		; HL = hi
  17CB'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  17CE'   D2 17E9'              	JNC	OPA_HI		; hi is inside the line: keep it
  17D1'   2A 0000*              	LHLD	OPLO
  17D4'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  17D7'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  17DA'   EB                    	XCHG			; HL = the content end: the span stops there
  17DB'   C3 17E9'              	JMP	OPA_HI
  17DE'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  17DE'   22 0000*              	SHLD	OPHI
  17E1'   3A 0000*              	LDA	WPULL
  17E4'   B7                    	ORA	A
  17E5'   CA 1864'              	JZ	OPA_C1
  17E8'   23                    	INX	H
  17E9'                         OPA_HI:
  17E9'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  17EC'                         OPA_DO:
  17EC'   CD 18B0'              	CALL	OPSPNL
  17EF'   7C                    	MOV	A,H
  17F0'   B5                    	ORA	L
  17F1'   C2 17FA'              	JNZ	OPA_D1
  17F4'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17F7'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17FA'                         OPA_D1:
  17FA'   3A 0000*              	LDA	PSAVE
  17FD'   FE 63                 	CPI	'c'
  17FF'   CA 18BB'              	JZ	OPDSPN
  1802'   CD 18A3'              	CALL	SPNBRK
  1805'   D2 1826'              	JNC	OPA_D2
  1808'   2A 0000*              	LHLD	OPHI
  180B'   CD 1A29'              	CALL	CEND
  180E'   EB                    	XCHG			; DE = the content end of the line it ends in
  180F'   2A 0000*              	LHLD	OPHI
  1812'                         OPA_BL:
  1812'   CD 0000*              	CALL	CMP16
  1815'   CA 182C'              	JZ	OPA_BI		; only blanks after it
  1818'   D5                    	PUSH	D
  1819'   E5                    	PUSH	H
  181A'   CD 0000*              	CALL	CHARAT
  181D'   E1                    	POP	H
  181E'   D1                    	POP	D
  181F'   23                    	INX	H
  1820'   CD 185B'              	CALL	BLANKQ
  1823'   CA 1812'              	JZ	OPA_BL
  1826'                         OPA_D2:
  1826'   CD 18BB'              	CALL	OPDSPN
  1829'   C3 1A3A'              	JMP	CLAMPE
  182C'                         OPA_BI:
  182C'   CD 183E'              	CALL	LOIND
  182F'   C2 1826'              	JNZ	OPA_D2
  1832'   2A 0000*              	LHLD	OPHI
  1835'   CD 072A'              	CALL	NLSTART
  1838'   22 0000*              	SHLD	OPHI
  183B'   C3 188F'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  183E'                         LOIND:
  183E'   2A 0000*              	LHLD	OPLO
  1841'   CD 0693'              	CALL	BOL
  1844'                         LI_LP:
  1844'   E5                    	PUSH	H
  1845'   EB                    	XCHG
  1846'   2A 0000*              	LHLD	OPLO
  1849'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  184C'   E1                    	POP	H
  184D'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  184E'   E5                    	PUSH	H
  184F'   CD 0000*              	CALL	CHARAT
  1852'   E1                    	POP	H
  1853'   23                    	INX	H
  1854'   CD 185B'              	CALL	BLANKQ
  1857'   CA 1844'              	JZ	LI_LP
  185A'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  185B'                         BLANKQ:
  185B'   FE 20                 	CPI	' '
  185D'   C8                    	RZ
  185E'   FE 09                 	CPI	TAB
  1860'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  1861'                         OPA_JP:
  1861'   22 0000*              	SHLD	OPHI
  1864'                         OPA_C1:
  1864'   CD 18B0'              	CALL	OPSPNL
  1867'   7C                    	MOV	A,H
  1868'   B5                    	ORA	L
  1869'   CA 17EC'              	JZ	OPA_DO		; nothing spanned
  186C'   2A 0000*              	LHLD	OPHI
  186F'   CD 0693'              	CALL	BOL
  1872'   EB                    	XCHG
  1873'   2A 0000*              	LHLD	OPHI
  1876'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1879'   C2 17EC'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  187C'   CD 183E'              	CALL	LOIND
  187F'   CA 188F'              	JZ	C1_LW		; only blanks before lo: whole lines
  1882'                         C1_CH:
  1882'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1885'   2B                    	DCX	H		;   of the line before
  1886'   CD 1A29'              	CALL	CEND
  1889'   22 0000*              	SHLD	OPHI
  188C'   C3 17EC'              	JMP	OPA_DO
  188F'                         C1_LW:
  188F'   2A 0000*              	LHLD	OPLO
  1892'   CD 0693'              	CALL	BOL
  1895'   22 0000*              	SHLD	OPLO
  1898'   3A 0000*              	LDA	PSAVE
  189B'   FE 63                 	CPI	'c'
  189D'   CA 1882'              	JZ	C1_CH
  18A0'   C3 1947'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18A3'                         SPNBRK:
  18A3'   2A 0000*              	LHLD	OPLO
  18A6'   CD 06D6'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  18A9'   EB                    	XCHG			; DE = it
  18AA'   2A 0000*              	LHLD	OPHI
  18AD'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  18B0'                         OPSPNL:
  18B0'   2A 0000*              	LHLD	OPHI
  18B3'   EB                    	XCHG
  18B4'   2A 0000*              	LHLD	OPLO
  18B7'   EB                    	XCHG			; HL = hi, DE = lo
  18B8'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  18BB'                         OPDSPN:
  18BB'   CD 18A3'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  18BE'   F5                    	PUSH	PSW
  18BF'   2A 0000*              	LHLD	OPSTA
  18C2'   EB                    	XCHG
  18C3'   2A 0000*              	LHLD	OPLO
  18C6'   22 0000*              	SHLD	WKI
  18C9'   CD 0000*              	CALL	CMP16
  18CC'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  18CD'   CD 0000*              	CALL	GOTO
  18D0'   CD 18B0'              	CALL	OPSPNL		; HL = hi - lo
  18D3'   CD 0873'              	CALL	SETLIN
  18D6'   F1                    	POP	PSW
  18D7'   CC 19F8'              	CZ	DCHQ
  18DA'   CD 0000*              	CALL	DELFWD
  18DD'   CD 0177'              	CALL	MARKMOD
  18E0'   F1                    	POP	PSW
  18E1'   D0                    	RNC
  18E2'   C3 08AA'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  18E5'                         UNDFNB:
  18E5'   CD 0000*              	CALL	CUROFF
  18E8'   E5                    	PUSH	H
  18E9'   CD 0973'              	CALL	FNBLNK
  18EC'   CD 0000*              	CALL	CUROFF
  18EF'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  18F0'   CD 0000*              	CALL	CMP16
  18F3'   D2 0000*              	JNC	UNDHER
  18F6'   EB                    	XCHG
  18F7'   CD 0000*              	CALL	GOTO
  18FA'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  18FD'                         OPALSP:
  18FD'   2A 0000*              	LHLD	OPSTA
  1900'   EB                    	XCHG
  1901'   2A 0000*              	LHLD	OPEND2
  1904'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1907'   DA 1917'              	JC	OPAL_F
  190A'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  190D'   EB                    	XCHG
  190E'   22 0000*              	SHLD	OPHI		; hi-src = start
  1911'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  1914'   C3 1921'              	JMP	OPAL_R
  1917'                         OPAL_F:
  1917'   EB                    	XCHG			; HL = start
  1918'   22 0000*              	SHLD	OPLO		; lo-src = start
  191B'   2A 0000*              	LHLD	OPEND2
  191E'   22 0000*              	SHLD	OPHI		; hi-src = end
  1921'                         OPAL_R:
  1921'   2A 0000*              	LHLD	OPLO
  1924'   CD 0693'              	CALL	BOL
  1927'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  192A'   2A 0000*              	LHLD	OPHI
  192D'   CD 072A'              	CALL	NLSTART
  1930'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  1933'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1934'                         OPALIN:
  1934'   CD 18FD'              	CALL	OPALSP
  1937'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  193A'   CD 072A'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  193D'   EB                    	XCHG			;   the column)
  193E'   2A 0000*              	LHLD	OPHI
  1941'   CD 0000*              	CALL	CMP16
  1944'   CC 18E5'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1947'                         OPDLIN:
  1947'   CD 18BB'              	CALL	OPDSPN
  194A'   CD 0774'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  194D'   DA 195D'              	JC	OPDL_NB
  1950'   CD 0000*              	CALL	LOGLEN
  1953'   7C                    	MOV	A,H
  1954'   B5                    	ORA	L
  1955'   C8                    	RZ			; empty buffer
  1956'   2B                    	DCX	H
  1957'   CD 0693'              	CALL	BOL
  195A'   CD 0000*              	CALL	GOTO
  195D'                         OPDL_NB:
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  195D'   C3 0973'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; A search is class 3, as in vim (charwise exclusive, and a jump): '/' and '?'
                                ; read their line inside the VSCAN, so 'd/pat<CR>' is measured whole, and a
                                ; span that ends in a line's first column follows OPA_C1's rule (issue #44).
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1960'                         OPCTAB:
  1960'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1964'   62 00 42 00           
  1968'   68 00 6C 00           
  196C'   30 00 5E 00           
  1970'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1972'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1976'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  197A'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  197E'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1982'   24 01                 
  1984'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1988'   47 02 48 02           
  198C'   4D 02 4C 02           
  1990'   2F 03 3F 03           	DB	'/',3, '?',3, 'n',3, 'N',3	; the searches: jumps, as '`' is
  1994'   6E 03 4E 03           
  1998'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  199A'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  199C'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  199D'                         VCB_C:
  199D'   CD 19A9'              	CALL	VCB_CD
  19A0'   C3 1AAB'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  19A3'                         VCB_D:
  19A3'   CD 19A9'              	CALL	VCB_CD
  19A6'   C3 1A3A'              	JMP	CLAMPE		; pull the cursor onto the new last content char
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  19A9'                         VCB_CD:
  19A9'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  19AC'   22 0000*              	SHLD	OPLO
  19AF'   22 0000*              	SHLD	OPSTA
  19B2'   CD 0000*              	CALL	CUROFF
  19B5'   CD 1A29'              	CALL	CEND		; to the line's content end, the CR,LF left
  19B8'   22 0000*              	SHLD	OPHI
  19BB'   C3 18BB'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  19BE'                         VC_X:
  19BE'   CD 0A25'              	CALL	GLSTAL
  19C1'   CD 0873'              	CALL	SETLIN
  19C4'   CD 0798'              	CALL	GETCNT
  19C7'   22 0000*              	SHLD	CNTV
  19CA'   CD 0000*              	CALL	CUROFF
  19CD'   22 0000*              	SHLD	WKI		; cur
  19D0'   CD 1A29'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  19D3'   EB                    	XCHG			; DE = contentend
  19D4'   2A 0000*              	LHLD	WKI		; HL = cur
  19D7'   EB                    	XCHG			; HL = contentend, DE = cur
  19D8'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  19DB'   7C                    	MOV	A,H
  19DC'   B5                    	ORA	L
  19DD'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  19DE'   EB                    	XCHG			; DE = available
  19DF'   2A 0000*              	LHLD	CNTV		; HL = count
  19E2'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  19E5'   DA 19EB'              	JC	VX_USEA
  19E8'   C3 19EC'              	JMP	VX_DEL		; count <= available -> HL = count = del
  19EB'                         VX_USEA:
  19EB'   EB                    	XCHG			; HL = available
  19EC'                         VX_DEL:
  19EC'   CD 19F8'              	CALL	DCHQ
  19EF'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  19F2'   CD 0177'              	CALL	MARKMOD
  19F5'   C3 1A3A'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  19F8'                         DCHQ:
  19F8'   E5                    	PUSH	H
  19F9'   CD 08B0'              	CALL	TAILTAB
  19FC'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  19FD'   47                    	MOV	B,A
  19FE'   7C                    	MOV	A,H		; (more of them than a byte counts)
  19FF'   B7                    	ORA	A
  1A00'   C0                    	RNZ
  1A01'   B5                    	ORA	L
  1A02'   C8                    	RZ			; (or none at all)
  1A03'   32 3229'              	STA	DCHN
  1A06'   78                    	MOV	A,B
  1A07'   87                    	ADD	A
  1A08'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  1A0B'   CA 1A23'              	JZ	DQ_0
  1A0E'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  1A0F'   FE 08                 	CPI	8
  1A11'   D0                    	RNC
  1A12'   E5                    	PUSH	H
  1A13'   2A 0000*              	LHLD	WKI
  1A16'   EB                    	XCHG
  1A17'   2A 0000*              	LHLD	TTI
  1A1A'   CD 0000*              	CALL	SUBHD
  1A1D'   EB                    	XCHG			; DE = the chars before it
  1A1E'   E1                    	POP	H
  1A1F'   CD 0000*              	CALL	CMP16
  1A22'   D8                    	RC
  1A23'                         DQ_0:
  1A23'   3E 07                 	MVI	A,R_DCH
  1A25'   32 0000*              	STA	RINTENT
  1A28'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  1A29'                         CEND:
  1A29'   CD 06D6'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1A2C'   7C                    	MOV	A,H
  1A2D'   B5                    	ORA	L
  1A2E'   C8                    	RZ			; the start of the text: nothing before it
  1A2F'   2B                    	DCX	H
  1A30'   E5                    	PUSH	H
  1A31'   CD 0000*              	CALL	CHARAT
  1A34'   E1                    	POP	H		; HL = term-1
  1A35'   FE 0D                 	CPI	CR
  1A37'   C8                    	RZ			; a CR before the LF -> the content ends there
  1A38'   23                    	INX	H
  1A39'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1A3A'                         CLAMPE:
  1A3A'   CD 0000*              	CALL	CUROFF
  1A3D'   E5                    	PUSH	H
  1A3E'   CD 0739'              	CALL	EOLC
  1A41'   D1                    	POP	D		; DE = cur
  1A42'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A45'   D8                    	RC
  1A46'   C8                    	RZ
  1A47'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1A4A'                         VC_I:
  1A4A'   CD 0798'              	CALL	GETCNT
  1A4D'   C3 1AA8'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1A50'                         VC_A:
  1A50'   CD 0798'              	CALL	GETCNT
  1A53'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A56'   CA 1A6D'              	JZ	VA_INS
  1A59'   EB                    	XCHG			; HL = cur
  1A5A'   E5                    	PUSH	H
  1A5B'   CD 0000*              	CALL	CHARAT
  1A5E'   E1                    	POP	H
  1A5F'   FE 0A                 	CPI	LF
  1A61'   CA 1A6D'              	JZ	VA_INS		; on the line terminator -> append in place
  1A64'   FE 0D                 	CPI	CR
  1A66'   CA 1A6D'              	JZ	VA_INS
  1A69'   23                    	INX	H
  1A6A'   CD 0000*              	CALL	GOTO
  1A6D'                         VA_INS:
  1A6D'   C3 1AA8'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A70'                         VCB_A:
  1A70'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A73'   CD 0739'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A76'   E5                    	PUSH	H
  1A77'   CD 0000*              	CALL	CHARAT
  1A7A'   E1                    	POP	H
  1A7B'   FE 0D                 	CPI	CR
  1A7D'   CA 1A86'              	JZ	VBA_IN		; an empty line: insert at its start
  1A80'   FE 0A                 	CPI	LF
  1A82'   CA 1A86'              	JZ	VBA_IN
  1A85'   23                    	INX	H		; past the last content char
  1A86'                         VBA_IN:
  1A86'   CD 0000*              	CALL	GOTO
  1A89'   C3 1AA8'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A8C'                         VCB_I:
  1A8C'   CD 0798'              	CALL	GETCNT
  1A8F'   CD 0973'              	CALL	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A92'   CD 0000*              	CALL	CUROFF
  1A95'   E5                    	PUSH	H
  1A96'   CD 0000*              	CALL	CHARAT
  1A99'   E1                    	POP	H
  1A9A'   FE 20                 	CPI	' '
  1A9C'   CA 1AA4'              	JZ	VBI_SK
  1A9F'   FE 09                 	CPI	TAB
  1AA1'   C2 1AA8'              	JNZ	SETINM
  1AA4'                         VBI_SK:
  1AA4'   23                    	INX	H		; blanks only: past the last of them
  1AA5'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1AA8'                         SETINM:
  1AA8'   CD 086D'              	CALL	SETMOV
  1AAB'                         SETINS:
  1AAB'   3E 01                 	MVI	A,EM_INS
  1AAD'   32 0000*              	STA	EDMODE
  1AB0'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1AB1'                         ATCEND:
  1AB1'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1AB4'   C8                    	RZ
  1AB5'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1AB8'   FE 0D                 	CPI	CR
  1ABA'   C8                    	RZ
  1ABB'   FE 0A                 	CPI	LF
  1ABD'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1ABE'                         OPNBRK:
  1ABE'   CD 2437'              	CALL	PUTBRK
  1AC1'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1AC4'   23                    	INX	H
  1AC5'   22 0000*              	SHLD	LNDLT
  1AC8'   C3 0177'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1ACB'                         ENDBRK:
  1ACB'   CD 0774'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1ACE'   C0                    	RNZ
  1ACF'   CD 1ABE'              	CALL	OPNBRK
  1AD2'   CD 0000*              	CALL	CUROFF
  1AD5'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1AD6'   2B                    	DCX	H		;   line, with its own terminator after it
  1AD7'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1ADA'                         VC_O:
  1ADA'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1ADD'   CD 1A29'              	CALL	CEND
  1AE0'   CD 0000*              	CALL	GOTO
  1AE3'   CD 1ABE'              	CALL	OPNBRK
  1AE6'   CD 1ACB'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1AE9'   CD 0895'              	CALL	SETILN		;   needs a terminator of its own to exist
  1AEC'   C3 1AAB'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1AEF'                         VCB_O:
  1AEF'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AF2'   CD 0693'              	CALL	BOL
  1AF5'   CD 0000*              	CALL	GOTO
  1AF8'   CD 1ABE'              	CALL	OPNBRK
  1AFB'   CD 0000*              	CALL	CUROFF
  1AFE'   2B                    	DCX	H
  1AFF'   2B                    	DCX	H
  1B00'   CD 0000*              	CALL	GOTO
  1B03'   CD 0895'              	CALL	SETILN
  1B06'   C3 1AAB'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1B09'                         VCB_J:
  1B09'   CD 078B'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1B0C'   CD 1A29'              	CALL	CEND		; the join point: this line's content end
  1B0F'   22 0000*              	SHLD	OPLO
  1B12'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B15'   CD 072A'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1B18'   E5                    	PUSH	H
  1B19'   CD 0000*              	CALL	LOGLEN
  1B1C'   D1                    	POP	D		; DE = that start
  1B1D'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1B20'   CA 086D'              	JZ	SETMOV
  1B23'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1B24'                         VJ_WS:
  1B24'   E5                    	PUSH	H
  1B25'   CD 0000*              	CALL	LOGLEN
  1B28'   D1                    	POP	D		; DE = the scan
  1B29'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1B2C'   CA 1B43'              	JZ	VJ_DEL
  1B2F'   EB                    	XCHG			; HL = the scan
  1B30'   E5                    	PUSH	H
  1B31'   CD 0000*              	CALL	CHARAT
  1B34'   E1                    	POP	H
  1B35'   FE 20                 	CPI	' '
  1B37'   CA 1B3F'              	JZ	VJ_SKIP
  1B3A'   FE 09                 	CPI	TAB
  1B3C'   C2 1B43'              	JNZ	VJ_DEL
  1B3F'                         VJ_SKIP:
  1B3F'   23                    	INX	H
  1B40'   C3 1B24'              	JMP	VJ_WS
  1B43'                         VJ_DEL:
  1B43'   22 0000*              	SHLD	OPHI
  1B46'   CD 18BB'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1B49'   CD 08A4'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1B4C'   CD 0774'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1B4F'   CA 1A3A'              	JZ	CLAMPE
  1B52'   CD 077F'              	CALL	CURCHR		; the first char of what was appended
  1B55'   FE 0D                 	CPI	CR
  1B57'   CA 1A3A'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1B5A'   FE 0A                 	CPI	LF
  1B5C'   CA 1A3A'              	JZ	CLAMPE
  1B5F'   FE 29                 	CPI	')'
  1B61'   CA 1A3A'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B64'   CD 0000*              	CALL	CUROFF
  1B67'   7C                    	MOV	A,H
  1B68'   B5                    	ORA	L
  1B69'   CA 1B7F'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B6C'   2B                    	DCX	H
  1B6D'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B70'   FE 20                 	CPI	' '
  1B72'   CA 1A3A'              	JZ	CLAMPE
  1B75'   FE 09                 	CPI	TAB
  1B77'   CA 1A3A'              	JZ	CLAMPE
  1B7A'   FE 0A                 	CPI	LF
  1B7C'   CA 1A3A'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B7F'                         VJ_SP:
  1B7F'   3E 20                 	MVI	A,' '
  1B81'   CD 0000*              	CALL	PUTGAP
  1B84'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B87'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1B88'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B8B'                         VC_TILD:
  1B8B'   CD 0798'              	CALL	GETCNT
  1B8E'   CD 0873'              	CALL	SETLIN		; only this row changes
  1B91'   CD 0A25'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B94'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B97'   CA 086D'              	JZ	SETMOV
  1B9A'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1B9D'   FE 0D                 	CPI	CR
  1B9F'   CA 086D'              	JZ	SETMOV		; the line's end: nothing to toggle
  1BA2'   FE 0A                 	CPI	LF
  1BA4'   CA 086D'              	JZ	SETMOV
  1BA7'   47                    	MOV	B,A
  1BA8'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1BAA'   FE 41                 	CPI	'A'
  1BAC'   DA 1BB8'              	JC	VT_PUT		; below 'A': no case
  1BAF'   FE 5B                 	CPI	'Z'+1
  1BB1'   D2 1BB8'              	JNC	VT_PUT		; above 'Z': no case
  1BB4'   78                    	MOV	A,B
  1BB5'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1BB7'   47                    	MOV	B,A
  1BB8'                         VT_PUT:
  1BB8'   78                    	MOV	A,B
  1BB9'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1BBC'   CD 0177'              	CALL	MARKMOD
  1BBF'   21 0001               	LXI	H,1
  1BC2'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1BC5'   3A 0000*              	LDA	VRCH
  1BC8'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1BCB'   C3 1A3A'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1BCE'                         VC_R:
  1BCE'   CD 0785'              	CALL	MOVCNT		; a cursor motion, and its count
  1BD1'   3E 03                 	MVI	A,PR
  1BD3'   32 0000*              	STA	GPEND
  1BD6'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1BD7'                         VR_DO:
  1BD7'   AF                    	XRA	A
  1BD8'   32 0000*              	STA	GPEND
  1BDB'   79                    	MOV	A,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1BDC'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1BDF'   CD 0873'              	CALL	SETLIN		; only this row changed
  1BE2'   CD 0A25'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1BE5'   CD 0774'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1BE8'   CA 086D'              	JZ	SETMOV		; the end of the text: vim does nothing
  1BEB'   CD 077F'              	CALL	CURCHR		; A = the char under the cursor
  1BEE'   FE 0D                 	CPI	CR
  1BF0'   CA 086D'              	JZ	SETMOV		; the line's end: nothing to replace
  1BF3'   FE 0A                 	CPI	LF
  1BF5'   CA 086D'              	JZ	SETMOV
  1BF8'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1BFA'   CD 0879'              	CALL	SETCEL
  1BFD'   CD 0177'              	CALL	MARKMOD
  1C00'   21 0001               	LXI	H,1
  1C03'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1C06'   3A 0000*              	LDA	VRCH
  1C09'   FE 0D                 	CPI	CR
  1C0B'   CA 1C18'              	JZ	VR_CR
  1C0E'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1C11'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1C14'   2B                    	DCX	H		;   out, which moves every logical offset
  1C15'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  1C18'                         VR_CR:
  1C18'   CD 1ABE'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1C1B'   CD 1ACB'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1C1E'   CD 0895'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1C21'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1C23'   32 0000*              	STA	ILABOV
  1C26'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1C27'                         VCB_R:
  1C27'   CD 0798'              	CALL	GETCNT
  1C2A'   CD 086D'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1C2D'   21 0000               	LXI	H,0
  1C30'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1C33'   22 0000*              	SHLD	RPAPP
  1C36'   3E 02                 	MVI	A,EM_REP
  1C38'   32 0000*              	STA	EDMODE
  1C3B'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1C3C'                         VC_D:
  1C3C'   3E 64                 	MVI	A,'d'
  1C3E'   32 0000*              	STA	PENDOP
  1C41'   C3 086D'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1C44'                         VC_C:
  1C44'   3E 63                 	MVI	A,'c'
  1C46'   32 0000*              	STA	PENDOP
  1C49'   C3 086D'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1C4C'                         VD_DD:
  1C4C'   CD 0A25'              	CALL	GLSTAL
  1C4F'   CD 0798'              	CALL	GETCNT
  1C52'   22 0000*              	SHLD	CNTV
  1C55'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1C57'   32 0000*              	STA	DDSNG
  1C5A'   2B                    	DCX	H
  1C5B'   7C                    	MOV	A,H
  1C5C'   B5                    	ORA	L
  1C5D'   C2 1C6B'              	JNZ	VDD_LS
  1C60'   3E 01                 	MVI	A,1
  1C62'   32 0000*              	STA	DDSNG
  1C65'   CD 18E5'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C68'   C3 1C71'              	JMP	VDD_GO
  1C6B'                         VDD_LS:
  1C6B'   CD 09DE'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C6E'   DA 086D'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C71'                         VDD_GO:
  1C71'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C74'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C77'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C7A'   CD 269A'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C7D'   CD 094F'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C80'   2A 0000*              	LHLD	CNTV
  1C83'   CD 0000*              	CALL	SETC0
  1C86'                         VDD_FW:
  1C86'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C89'   DA 1DD7'              	JC	QREFUS		; ... which has no room for them
  1C8C'   CD 07AD'              	CALL	CNTTST
  1C8F'   C2 1C86'              	JNZ	VDD_FW
  1C92'   CD 0177'              	CALL	MARKMOD
  1C95'   CD 0BF6'              	CALL	ATEOF
  1C98'   D2 1CB3'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C9B'   3E 00                 	MVI	A,0
  1C9D'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1CA0'   CD 12D6'              	CALL	ONFST
  1CA3'   CA 0973'              	JZ	FNBLNK		; nothing left before it
  1CA6'   21 0001               	LXI	H,1		; onto the new last line
  1CA9'   CD 0000*              	CALL	SETBWD
  1CAC'   2A 0000*              	LHLD	LNDLT
  1CAF'   2B                    	DCX	H
  1CB0'   22 0000*              	SHLD	LNDLT
  1CB3'                         VDD_UP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CB3'   CD 0973'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1CB6'   3A 0000*              	LDA	DDSNG
  1CB9'   B7                    	ORA	A
  1CBA'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1CBB'   3E 03                 	MVI	A,R_DLIN
  1CBD'   32 0000*              	STA	RINTENT
  1CC0'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1CC1'                         QEMPTY:
  1CC1'   2A 0000*              	LHLD	QBEG
  1CC4'   EB                    	XCHG
  1CC5'   2A 0000*              	LHLD	QEND
  1CC8'   7C                    	MOV	A,H
  1CC9'   BA                    	CMP	D
  1CCA'   C0                    	RNZ
  1CCB'   7D                    	MOV	A,L
  1CCC'   BB                    	CMP	E
  1CCD'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1CCE'                         VC_Y:
  1CCE'   3E 79                 	MVI	A,'y'
  1CD0'   32 0000*              	STA	PENDOP
  1CD3'   C3 086D'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1CD6'                         VY_YY:
  1CD6'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1CD9'   CD 0444'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1CDC'   CD 0000*              	CALL	CUROFF
  1CDF'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1CE2'   CD 0693'              	CALL	BOL
  1CE5'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CE8'   CD 1E84'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CEB'   CD 1EC7'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1CEE'   D2 1E8B'              	JNC	YNDONE
  1CF1'   21 1C4C'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1CF4'   C3 1D20'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1CF7'                         OPYANK:
  1CF7'   CD 18FD'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1CFA'   2A 0000*              	LHLD	OPSTA
  1CFD'   EB                    	XCHG			; DE = start
  1CFE'   2A 0000*              	LHLD	OPEND2		; HL = end
  1D01'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1D04'   D2 1D08'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1D07'   EB                    	XCHG			; ... otherwise the start is
  1D08'                         OPY_LO:
  1D08'   22 0000*              	SHLD	YOFF
  1D0B'   2A 0000*              	LHLD	OPLO
  1D0E'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1D11'   CD 1E84'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1D14'   CD 1F3F'              	CALL	YNSPAN		; copied where they lie, if there is room
  1D17'   D2 1E8B'              	JNC	YNDONE
  1D1A'   21 1E4F'              	LXI	H,YSPAN
  1D1D'   C3 1D20'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1D20'                         YKGO:
  1D20'   22 0000*              	SHLD	YACT
  1D23'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1D26'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1D27'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1D2A'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1D2D'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1D30'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1D33'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1D34'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1D37'   EB                    	XCHG			;   window as it was, then names other text
  1D38'   E1                    	POP	H
  1D39'   CD 0000*              	CALL	SUBHD
  1D3C'   EB                    	XCHG			; DE = how far behind the cursor they start
  1D3D'   CD 13B8'              	CALL	CURFP
  1D40'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1D42'   CD 13AE'              	CALL	SUB24
  1D45'   22 0000*              	SHLD	YPFP
  1D48'   32 0002*              	STA	YPFP+2
  1D4B'   3A 0000*              	LDA	MODF
  1D4E'   32 0000*              	STA	YMODF
  1D51'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1D54'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1D57'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1D5A'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D5D'   3E 01                 	MVI	A,1
  1D5F'   32 0000*              	STA	UNDRPL
  1D62'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D65'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D68'   22 0000*              	SHLD	YLDLT
  1D6B'   CD 0000*              	CALL	LOGLEN
  1D6E'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D71'   2A 0000*              	LHLD	YACT
  1D74'   CD 1DD6'              	CALL	YCALL		; the lines out of the file, into the register
  1D77'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D7A'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D7C'   CA 1DBA'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1D7F'   CD 0000*              	CALL	LOGLEN
  1D82'   EB                    	XCHG
  1D83'   2A 0000*              	LHLD	YWAS
  1D86'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D89'   CA 1D9B'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D8C'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D8F'   CD 03FB'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D92'   CD 03AC'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D95'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D98'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D9B'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D9B'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D9E'   EB                    	XCHG
  1D9F'   2A 0000*              	LHLD	YCOL
  1DA2'   19                    	DAD	D
  1DA3'   22 0000*              	SHLD	MKPOS
  1DA6'   3A 0002*              	LDA	YPFP+2
  1DA9'   CE 00                 	ACI	0
  1DAB'   32 0002*              	STA	MKPOS+2
  1DAE'   CD 03AC'              	CALL	MKPAGE
  1DB1'   CD 0000*              	CALL	GOTO
  1DB4'                         YK_RST:
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DB4'   2A 0000*              	LHLD	YLDLT
  1DB7'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1DBA'                         YK_RF:
  1DBA'   3A 0000*              	LDA	YMODF
  1DBD'   32 0000*              	STA	MODF
  1DC0'   3A 0000*              	LDA	YDCHG
  1DC3'   32 0000*              	STA	DOTCHG
  1DC6'   3A 0000*              	LDA	YURPL
  1DC9'   32 0000*              	STA	UNDRPL
  1DCC'   AF                    	XRA	A
  1DCD'   32 0000*              	STA	MKHOLD
  1DD0'   CD 0A25'              	CALL	GLSTAL
  1DD3'   C3 08AA'              	JMP	SETFUL		; the cheap paint cannot carry this
  1DD6'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1DD7'                         QREFUS:
  1DD7'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1DDA'   CD 1CC1'              	CALL	QEMPTY
  1DDD'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1DE0'   CD 0000*              	CALL	QKILL
  1DE3'   3A 0000*              	LDA	MKHOLD
  1DE6'   B7                    	ORA	A
  1DE7'   C2 1DF6'              	JNZ	QRF_Y
  1DEA'   21 0000*              	LXI	H,MKSAV
  1DED'   11 0000*              	LXI	D,MKTAB
  1DF0'   CD 269A'              	CALL	COPY12
  1DF3'   CD 0000*              	CALL	UNDCLR
  1DF6'                         QRF_Y:
  1DF6'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1DF8'   32 0000*              	STA	MSGWHT
  1DFB'   C3 16FC'              	JMP	OPG_HM
                                
                                ;MEMABT -- the arena has no room for what this key asked of it: WordMaster's
                                ; 'MEM SHORTAGE', 'MEM FULL' or 'QBUF FULL', which BUF.MAC's MEMERR sends here
                                ; once the screen is up (issue #39).  WordMaster abandons the command there and
                                ; goes back to its prompt, and so does this: the key's stack goes, and with it
                                ; whatever the key was part way through.  Each of those errors is raised before
                                ; a byte of text moves, so the text is whole, though not all of the change may
                                ; have been made.  The register is emptied -- it is what holds the room -- or
                                ; the repaint that follows would run into the same wall, and the half-done
                                ; command leaves nothing behind: no count, no pending operator, no '.' to repeat
                                ; it and no 'u' to undo half of it.  The bottom row says so.
                                ;
                                ; Two cases still end the editor, through ERRMSG as all three always did: a
                                ; second shortage before the next key (the repaint, with the register already
                                ; given back -- there is nothing left to give), and one in the middle of a yank
                                ; that took its lines OUT to put them back (YKGO, MKHOLD set): the register IS
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; those lines then, and emptying it would cut them from the file.
  1DFE'                         MEMABT:
  1DFE'   3A 0000*              	LDA	ABTFLG
  1E01'   21 0000*              	LXI	H,MKHOLD
  1E04'   B6                    	ORA	M
  1E05'   C2 0000*              	JNZ	ERRMSG		; the message is still on the stack for it
  1E08'   3C                    	INR	A		; A = 1
  1E09'   32 0000*              	STA	ABTFLG		; ... until the next key (CMDDIS)
  1E0C'   31 0000*              	LXI	SP,VISTK	; the key's stack: VI.MAC's loop runs at the top
  1E0F'   32 0000*              	STA	MODF		; the text may have changed part way
  1E12'   32 0000*              	STA	FORCEF		; the frame on the screen may be half drawn
  1E15'   32 0000*              	STA	DOTOVF		; a half command is no change for '.'
  1E18'   3A 0000*              	LDA	EDMODE		; in insert or replace mode the recording runs
  1E1B'   B7                    	ORA	A		;   on to the ESC, DOTOVF keeping it from '.';
  1E1C'   C2 1E26'              	JNZ	MAB_1		;   otherwise the next key starts a new one
  1E1F'   32 0000*              	STA	DOTCHG
  1E22'   3C                    	INR	A
  1E23'   32 322C'              	STA	DOTSTA
  1E26'                         MAB_1:
  1E26'   AF                    	XRA	A
  1E27'   32 0000*              	STA	GPEND
  1E2A'   32 0000*              	STA	PENDOP
  1E2D'   32 0000*              	STA	DOTRPL		; a '.' replay is over
  1E30'   32 0000*              	STA	UNDRPL		; ... and so is a 'u' one
  1E33'   32 0000*              	STA	BRKARM
  1E36'   32 0000*              	STA	BRKHIT
  1E39'   CD 0000*              	CALL	CLRCNT		; no count
  1E3C'   CD 0000*              	CALL	UNDCLR		; nothing 'u' can trust
  1E3F'   CD 0000*              	CALL	QKILL		; the room back
  1E42'   3E 05                 	MVI	A,MW_MEM
  1E44'   32 0000*              	STA	MSGWHT
  1E47'   3E 00                 	MVI	A,R_FULL
  1E49'   32 0000*              	STA	RINTENT
  1E4C'   C3 0000*              	JMP	MLDRAW		; VI.MAC: the repaint, then the next key
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


                                ; that moved fewer bytes, which the byte target below already allows for.
  1E4F'                         YSPAN:
  1E4F'   CD 0A25'              	CALL	GLSTAL
  1E52'   CD 18B0'              	CALL	OPSPNL		; HL = the span's length
  1E55'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1E58'   2A 0000*              	LHLD	OPLO
  1E5B'   CD 0000*              	CALL	GOTO
  1E5E'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E61'                         YS_LP:
  1E61'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1E64'   CD 0000*              	CALL	SETC0
  1E67'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1E6A'   DA 1DD7'              	JC	QREFUS		; ... which has no room for it
  1E6D'   2A 0000*              	LHLD	QBEG
  1E70'   EB                    	XCHG
  1E71'   2A 0000*              	LHLD	QEND
  1E74'   CD 0000*              	CALL	SUBHD
  1E77'   EB                    	XCHG			; DE = what the register holds
  1E78'   2A 0000*              	LHLD	YTGT
  1E7B'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1E7E'   DA 1E61'              	JC	YS_LP		;   (never more than the span over whole lines)
  1E81'   C3 0177'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1E84'                         YNPRE:
  1E84'   2A 0000*              	LHLD	PGTOPM
  1E87'   22 0000*              	SHLD	YNPG
  1E8A'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1E8B'                         YNDONE:
  1E8B'   2A 0000*              	LHLD	YOFF
  1E8E'   CD 0000*              	CALL	GOTO
  1E91'   2A 0000*              	LHLD	PGTOPM
  1E94'   EB                    	XCHG
  1E95'   2A 0000*              	LHLD	YNPG
  1E98'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1E9B'   C2 08AA'              	JNZ	SETFUL		; it moved under us: repaint after all
  1E9E'   C3 086D'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1EA1'                         YNROOM:
  1EA1'   11 0100               	LXI	D,100H
  1EA4'   19                    	DAD	D
  1EA5'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1EA6'   E5                    	PUSH	H		; the span plus its slack
  1EA7'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1EAA'   EB                    	XCHG			; HL = free
  1EAB'   D1                    	POP	D		; DE = the span plus its slack
  1EAC'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1EAF'   DA 1EB7'              	JC	YNR_OK
  1EB2'   CA 1EB7'              	JZ	YNR_OK
  1EB5'   37                    	STC			; not enough: the delete-and-put-back path
  1EB6'   C9                    	RET
  1EB7'                         YNR_OK:
  1EB7'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1EB8'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1EB9'                         YNGO:
  1EB9'   C5                    	PUSH	B
  1EBA'   CD 0798'              	CALL	GETCNT		; spent here: this yank is happening
  1EBD'   CD 0A25'              	CALL	GLSTAL
  1EC0'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1EC3'   C1                    	POP	B
  1EC4'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1EC7'                         YNCOPY:
  1EC7'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1ECA'   7C                    	MOV	A,H		;   the count itself
  1ECB'   B5                    	ORA	L
  1ECC'   C2 1ED2'              	JNZ	YNC_HV
  1ECF'   21 0001               	LXI	H,1
  1ED2'                         YNC_HV:
  1ED2'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1ED3'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1ED4'   B4                    	ORA	H
  1ED5'   CA 1EE0'              	JZ	YNC_M
  1ED8'   E5                    	PUSH	H
  1ED9'   CD 09DE'              	CALL	ONLAST		; vim: a count over one on the last line does
  1EDC'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1EDD'   DA 1EF2'              	JC	YNC_RF
  1EE0'                         YNC_M:
  1EE0'   E5                    	PUSH	H
  1EE1'   CD 094F'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1EE4'   E1                    	POP	H
  1EE5'   CD 1EFA'              	CALL	YNLINE		; BC = the span, measured where it stands
  1EE8'   D8                    	RC			; not measurable here: let the pager answer it
  1EE9'   60                    	MOV	H,B
  1EEA'   69                    	MOV	L,C
  1EEB'   CD 1EA1'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1EEE'   D8                    	RC			; no: the delete-and-put-back path
  1EEF'   C3 1EB9'              	JMP	YNGO
  1EF2'                         YNC_RF:
  1EF2'   CD 0798'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1EF5'   CD 0A25'              	CALL	GLSTAL		;   register alone, and that is the command
  1EF8'   B7                    	ORA	A		; NC: done
  1EF9'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1EFA'                         YNLINE:
  1EFA'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1EFD'   2A 0000*              	LHLD	GAPEND
  1F00'                         YNL_LP:
  1F00'   EB                    	XCHG			; DE = the scan
  1F01'   2A 0000*              	LHLD	TXTEND
  1F04'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1F07'   EB                    	XCHG			; HL = the scan
  1F08'   D2 1F28'              	JNC	YNL_EN		; the resident text ran out
  1F0B'   7E                    	MOV	A,M
  1F0C'   23                    	INX	H
  1F0D'   FE 0A                 	CPI	LF
  1F0F'   C2 1F00'              	JNZ	YNL_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F12'   E5                    	PUSH	H
  1F13'   2A 0000*              	LHLD	YNCNT
  1F16'   2B                    	DCX	H
  1F17'   22 0000*              	SHLD	YNCNT
  1F1A'   7C                    	MOV	A,H
  1F1B'   B5                    	ORA	L
  1F1C'   E1                    	POP	H
  1F1D'   C2 1F00'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1F20'   EB                    	XCHG			; DE = past the last of them
  1F21'   2A 0000*              	LHLD	GAPEND
  1F24'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1F25'   C3 1F36'              	JMP	YNL_BC
  1F28'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1F28'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1F2B'   C2 1F3D'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1F2E'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1F31'   EB                    	XCHG			;   count clamps to it as vim's does
  1F32'   2A 0000*              	LHLD	GAPEND
  1F35'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1F36'                         YNL_BC:
  1F36'   CD 0000*              	CALL	SUBHD		; HL = the span
  1F39'   44                    	MOV	B,H
  1F3A'   4D                    	MOV	C,L
  1F3B'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1F3C'   C9                    	RET
  1F3D'                         YNL_NO:
  1F3D'   37                    	STC
  1F3E'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1F3F'                         YNSPAN:
  1F3F'   CD 18B0'              	CALL	OPSPNL		; HL = the span's length
  1F42'   44                    	MOV	B,H
  1F43'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1F44'   CD 1EA1'              	CALL	YNROOM
  1F47'   D8                    	RC			; no room: the delete-and-put-back path
  1F48'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1F49'   2A 0000*              	LHLD	OPLO
  1F4C'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1F4F'   C1                    	POP	B
  1F50'   C3 1EB9'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1F53'                         VC_P:
  1F53'   CD 1CC1'              	CALL	QEMPTY
  1F56'   CA 2029'              	JZ	VP_BEL
  1F59'   CD 0798'              	CALL	GETCNT
  1F5C'   22 0000*              	SHLD	PCNT
  1F5F'   CD 0000*              	CALL	CUROFF
  1F62'   CD 072A'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  1F65'   C3 1F7A'              	JMP	VP_GO
  1F68'                         VCB_P:
  1F68'   CD 1CC1'              	CALL	QEMPTY
  1F6B'   CA 2029'              	JZ	VP_BEL
  1F6E'   CD 0798'              	CALL	GETCNT
  1F71'   22 0000*              	SHLD	PCNT
  1F74'   CD 0000*              	CALL	CUROFF
  1F77'   CD 0693'              	CALL	BOL
  1F7A'                         VP_GO:
  1F7A'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1F7D'   CD 0000*              	CALL	CUROFF
  1F80'   EB                    	XCHG
  1F81'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1F84'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1F87'   DA 1F9C'              	JC	VP_IN
  1F8A'   EB                    	XCHG			; HL = the put point = LOGLEN
  1F8B'   7C                    	MOV	A,H
  1F8C'   B5                    	ORA	L
  1F8D'   CA 1F99'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1F90'   2B                    	DCX	H
  1F91'   CD 0000*              	CALL	CHARAT
  1F94'   FE 0A                 	CPI	LF
  1F96'   CA 1F9C'              	JZ	VP_IN
  1F99'                         VP_BRK:
  1F99'   CD 1ABE'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1F9C'                         VP_IN:
  1F9C'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1F9F'   CD 0444'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1FA2'   CD 1401'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1FA5'   2A 0000*              	LHLD	QBEG
  1FA8'   EB                    	XCHG
  1FA9'   2A 0000*              	LHLD	QEND
  1FAC'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1FAF'   EB                    	XCHG
  1FB0'   22 0000*              	SHLD	PLFS
  1FB3'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1FB6'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1FB7'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1FB8'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1FBA'   C2 1FBE'              	JNZ	VP_PZ
  1FBD'   7D                    	MOV	A,L
  1FBE'                         VP_PZ:
  1FBE'   32 0000*              	STA	PCPY
  1FC1'                         VP_LP:
  1FC1'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1FC4'   2A 0000*              	LHLD	LNDLT
  1FC7'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  1FC8'   2A 0000*              	LHLD	PLFS
  1FCB'   19                    	DAD	D
  1FCC'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1FCF'   2A 0000*              	LHLD	PCNT
  1FD2'   2B                    	DCX	H
  1FD3'   22 0000*              	SHLD	PCNT
  1FD6'   7C                    	MOV	A,H
  1FD7'   B5                    	ORA	L
  1FD8'   C2 1FC1'              	JNZ	VP_LP
  1FDB'   CD 0177'              	CALL	MARKMOD
  1FDE'   21 0000*              	LXI	H,PPFP
  1FE1'   CD 03FB'              	CALL	MKLOAD
  1FE4'   CD 0408'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1FE7'   D2 201A'              	JNC	VP_PGD
  1FEA'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1FED'   CD 0A25'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1FF0'   3A 0000*              	LDA	PCPY
  1FF3'   B7                    	ORA	A
  1FF4'   CA 0973'              	JZ	FNBLNK
  1FF7'   2A 0000*              	LHLD	PLFS
  1FFA'   7C                    	MOV	A,H
  1FFB'   B7                    	ORA	A
  1FFC'   C2 0973'              	JNZ	FNBLNK
  1FFF'   3A 0000*              	LDA	PCPY
  2002'   CD 109E'              	CALL	MULSAT		; HL = the lines this put put, saturated
  2005'   7C                    	MOV	A,H
  2006'   B7                    	ORA	A
  2007'   C2 0973'              	JNZ	FNBLNK
  200A'   7D                    	MOV	A,L
  200B'   B7                    	ORA	A
  200C'   CA 0973'              	JZ	FNBLNK
  200F'   F5                    	PUSH	PSW
  2010'   CD 0895'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  2013'   F1                    	POP	PSW
  2014'   32 3228'              	STA	ILN		; ... which the lines put now replace
  2017'   C3 0973'              	JMP	FNBLNK
  201A'                         VP_PGD:				; the put paged its first line out: page back
  201A'   CD 03AC'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  201D'   CD 0000*              	CALL	GOTO
  2020'   CD 0A25'              	CALL	GLSTAL
  2023'   CD 1419'              	CALL	GPLACE
  2026'   C3 08AA'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  2029'                         VP_BEL:
  2029'   CD 0798'              	CALL	GETCNT		; the count is spent either way
  202C'   0E 07                 	MVI	C,BEL
  202E'   CD 0000*              	CALL	BCONOU
  2031'   C3 086D'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  2034'                         VIREP:
  2034'   79                    	MOV	A,C
  2035'   FE 1B                 	CPI	ESC
  2037'   CA 218A'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  203A'   FE 0D                 	CPI	CR
  203C'   CA 20AF'              	JZ	VP_CR
  203F'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  2041'   CA 20AF'              	JZ	VP_CR
  2044'   FE 08                 	CPI	BS
  2046'   CA 20BB'              	JZ	VP_BS
  2049'   FE 7F                 	CPI	DEL
  204B'   CA 20BB'              	JZ	VP_BS
  204E'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  2051'   CD 0873'              	CALL	SETLIN		; this row changed
  2054'   CD 0177'              	CALL	MARKMOD
  2057'   CD 1AB1'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  205A'   CA 209A'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  205D'   CD 077F'              	CALL	CURCHR
  2060'   06 01                 	MVI	B,1
  2062'   CD 0879'              	CALL	SETCEL
  2065'   3A 0000*              	LDA	VRCH
  2068'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  206B'   2A 0000*              	LHLD	RPDEL
  206E'   7C                    	MOV	A,H
  206F'   B5                    	ORA	L
  2070'   CA 2086'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  2073'   2A 0000*              	LHLD	GAPEND
  2076'   EB                    	XCHG
  2077'   2A 0000*              	LHLD	RPGE
  207A'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  207D'   CA 2086'              	JZ	VP_OVW
  2080'   21 0000               	LXI	H,0
  2083'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  2086'                         VP_OVW:
  2086'   21 0001               	LXI	H,1
  2089'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  208C'   2A 0000*              	LHLD	GAPEND
  208F'   22 0000*              	SHLD	RPGE
  2092'   2A 0000*              	LHLD	RPDEL
  2095'   23                    	INX	H
  2096'   22 0000*              	SHLD	RPDEL
  2099'   C9                    	RET
  209A'                         VP_APP:
  209A'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  209C'   06 01                 	MVI	B,1
  209E'   CD 0879'              	CALL	SETCEL
  20A1'   3A 0000*              	LDA	VRCH
  20A4'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  20A7'   2A 0000*              	LHLD	RPAPP
  20AA'   23                    	INX	H
  20AB'   22 0000*              	SHLD	RPAPP
  20AE'   C9                    	RET
  20AF'                         VP_CR:
  20AF'   21 0000               	LXI	H,0
  20B2'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  20B5'   22 0000*              	SHLD	RPAPP
  20B8'   C3 2146'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  20BB'                         VP_BS:
  20BB'   2A 0000*              	LHLD	RPAPP
  20BE'   7C                    	MOV	A,H
  20BF'   B5                    	ORA	L
  20C0'   CA 20CD'              	JZ	VP_BSD
  20C3'   2B                    	DCX	H
  20C4'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  20C7'   CD 0873'              	CALL	SETLIN
  20CA'   C3 0000*              	JMP	DELPRV
  20CD'                         VP_BSD:
  20CD'   2A 0000*              	LHLD	RPDEL
  20D0'   7C                    	MOV	A,H
  20D1'   B5                    	ORA	L
  20D2'   CA 20F9'              	JZ	VP_BSM		; nothing of ours left
  20D5'   2A 0000*              	LHLD	GAPEND
  20D8'   EB                    	XCHG
  20D9'   2A 0000*              	LHLD	RPGE
  20DC'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  20DF'   C2 20F9'              	JNZ	VP_BSM
  20E2'   2A 0000*              	LHLD	RPDEL
  20E5'   2B                    	DCX	H
  20E6'   22 0000*              	SHLD	RPDEL
  20E9'   CD 0873'              	CALL	SETLIN
  20EC'   CD 0000*              	CALL	DELPRV		; the typed char goes
  20EF'   CD 0000*              	CALL	UNDELF		; the original comes back
  20F2'   2A 0000*              	LHLD	GAPEND
  20F5'   22 0000*              	SHLD	RPGE
  20F8'   C9                    	RET
  20F9'                         VP_BSM:
  20F9'   CD 086D'              	CALL	SETMOV		; nothing changed: back over the text as it is
  20FC'   C3 08FB'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  20FF'                         VIINS:
  20FF'   79                    	MOV	A,C
  2100'   FE 1B                 	CPI	ESC
  2102'   CA 218A'              	JZ	VI_ESC
  2105'   FE 0D                 	CPI	CR
  2107'   CA 2146'              	JZ	VI_CR
  210A'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  210C'   CA 2146'              	JZ	VI_CR
  210F'   FE 08                 	CPI	BS
  2111'   CA 215E'              	JZ	VI_BS
  2114'   FE 7F                 	CPI	DEL
  2116'   CA 215E'              	JZ	VI_BS
  2119'   79                    	MOV	A,C
  211A'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  211D'   CD 0177'              	CALL	MARKMOD
  2120'   CD 0873'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  2123'   79                    	MOV	A,C
  2124'   FE 20                 	CPI	' '
  2126'   D8                    	RC			; control char -> keep R_LINE
  2127'   FE 7F                 	CPI	DEL
  2129'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  212A'   CD 08B0'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  212D'   47                    	MOV	B,A
  212E'   3E 04                 	MVI	A,R_ICH
  2130'   32 0000*              	STA	RINTENT
  2133'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  2135'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  2136'   CA 2142'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  2139'   CD 1AB1'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  213C'   3E 00                 	MVI	A,0
  213E'   C2 2142'              	JNZ	VI_ICH
  2141'   3C                    	INR	A
  2142'                         VI_ICH:
  2142'   32 0000*              	STA	ICHAPP
  2145'   C9                    	RET
  2146'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  2146'   CD 1AB1'              	CALL	ATCEND
  2149'   3E 00                 	MVI	A,0
  214B'   CA 214F'              	JZ	VI_CRS
  214E'   3C                    	INR	A
  214F'                         VI_CRS:
  214F'   F5                    	PUSH	PSW
  2150'   CD 1ABE'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  2153'   CD 1ACB'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2156'   CD 0895'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  2159'   F1                    	POP	PSW
  215A'   32 0000*              	STA	ILABOV
  215D'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  215E'                         VI_BS:
  215E'   CD 0000*              	CALL	PEEKL
  2161'   D8                    	RC			; start of the file: nothing to delete
  2162'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  2164'   CA 2184'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  2167'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  2168'   CD 0873'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  216B'   78                    	MOV	A,B
  216C'   CD 088E'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
  216F'   D2 2184'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  2172'   CD 08B0'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  2175'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  2176'   3C                    	INR	A
  2177'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  217A'   3E 01                 	MVI	A,1
  217C'   32 3229'              	STA	DCHN
  217F'   3E 07                 	MVI	A,R_DCH
  2181'   32 0000*              	STA	RINTENT
  2184'                         VI_BSJ:
  2184'   CD 0177'              	CALL	MARKMOD
  2187'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  218A'                         VI_ESC:
  218A'   3E 00                 	MVI	A,EM_CMD
  218C'   32 0000*              	STA	EDMODE
  218F'   CD 086D'              	CALL	SETMOV
  2192'   CD 08FB'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  2195'   C3 0A25'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
                                ; The keys come through MKGETK, as a mark's letter does: they join the '.'
                                ; recording, and a '.' replay reads them back from it ('d/pat<CR>' then '.').
  2198'                         RDLINE:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  2198'   EB                    	XCHG			; HL = buffer
  2199'   22 0000*              	SHLD	RLPTR
  219C'   3E 00                 	MVI	A,0
  219E'   32 0000*              	STA	RLLEN
  21A1'   78                    	MOV	A,B
  21A2'   32 0000*              	STA	RLMAX
  21A5'   79                    	MOV	A,C
  21A6'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  21A9'                         RL_LP:
  21A9'   CD 01FC'              	CALL	MKGETK		; a '.' replay reads the line it recorded, and a
  21AC'   DA 21FD'              	JC	RL_CAN		;   typed one is recorded ('d/pat<CR>'); ESC
  21AF'   79                    	MOV	A,C
  21B0'   FE 0D                 	CPI	CR
  21B2'   CA 220C'              	JZ	RL_DONE
  21B5'   FE 08                 	CPI	BS
  21B7'   CA 21E5'              	JZ	RL_BS
  21BA'   FE 7F                 	CPI	DEL
  21BC'   CA 21E5'              	JZ	RL_BS
  21BF'   FE 20                 	CPI	' '
  21C1'   DA 21A9'              	JC	RL_LP		; control char -> ignore
  21C4'   3A 0000*              	LDA	RLLEN
  21C7'   47                    	MOV	B,A
  21C8'   3A 0000*              	LDA	RLMAX
  21CB'   B8                    	CMP	B
  21CC'   CA 21A9'              	JZ	RL_LP		; full -> ignore
  21CF'   2A 0000*              	LHLD	RLPTR
  21D2'   71                    	MOV	M,C
  21D3'   23                    	INX	H
  21D4'   22 0000*              	SHLD	RLPTR
  21D7'   3A 0000*              	LDA	RLLEN
  21DA'   3C                    	INR	A
  21DB'   32 0000*              	STA	RLLEN
  21DE'   79                    	MOV	A,C
  21DF'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  21E2'   C3 21A9'              	JMP	RL_LP
  21E5'                         RL_BS:				; WM LINEPOP
  21E5'   3A 0000*              	LDA	RLLEN
  21E8'   B7                    	ORA	A
  21E9'   CA 21FD'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  21EC'   3D                    	DCR	A
  21ED'   32 0000*              	STA	RLLEN
  21F0'   2A 0000*              	LHLD	RLPTR
  21F3'   2B                    	DCX	H
  21F4'   22 0000*              	SHLD	RLPTR
  21F7'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  21FA'   C3 21A9'              	JMP	RL_LP
  21FD'                         RL_CAN:
  21FD'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  21FF'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  2202'   CD 0873'              	CALL	SETLIN		; redraw one row
  2205'   AF                    	XRA	A
  2206'   32 0000*              	STA	PSAVE		; ... and a 'd/' or 'c?' with it
  2209'   3E FF                 	MVI	A,0FFH		; cancelled
  220B'   C9                    	RET
  220C'                         RL_DONE:
  220C'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  220E'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  2211'   AF                    	XRA	A
  2212'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2213'                         VC_BZ:
  2213'   CD 086D'              	CALL	SETMOV
  2216'   3A 0000*              	LDA	GSAVE
  2219'   FE 02                 	CPI	PZ
  221B'   CA 2226'              	JZ	VZ_ZZ
  221E'   B7                    	ORA	A
  221F'   C0                    	RNZ			; 'g' was pending: vim drops both
  2220'   3E 02                 	MVI	A,PZ
  2222'   32 0000*              	STA	GPEND
  2225'   C9                    	RET
  2226'                         VZ_ZZ:
  2226'   3E 04                 	MVI	A,EO_X
  2228'   32 0000*              	STA	EXOP
  222B'   3E 01                 	MVI	A,1
  222D'   32 0000*              	STA	EXBANG		; no '!'
  2230'   AF                    	XRA	A
  2231'   32 0000*              	STA	EXARG		; no file name
  2234'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  2237'   B7                    	ORA	A
  2238'   CA 2379'              	JZ	EX_Q
  223B'   C3 2313'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  223E'                         VC_EX:
  223E'   CD 0798'              	CALL	GETCNT
  2241'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  2244'   11 0000*              	LXI	D,EXBUF
  2247'   06 28                 	MVI	B,EXMAX
  2249'   0E 3A                 	MVI	C,':'
  224B'   CD 2198'              	CALL	RDLINE
  224E'   B7                    	ORA	A
  224F'   C0                    	RNZ			; cancelled
  2250'   3A 0000*              	LDA	RLLEN
  2253'   5F                    	MOV	E,A
  2254'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  2256'   21 0000*              	LXI	H,EXBUF
  2259'   19                    	DAD	D
  225A'   36 00                 	MVI	M,0		; the line ends with a 0
  225C'   21 0000*              	LXI	H,EXBUF
  225F'   CD 282B'              	CALL	SKIPB
  2262'   C8                    	RZ			; nothing on it
  2263'   22 0000*              	SHLD	EXCMD
  2266'   CD 2A52'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  2269'   CD 282B'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  226C'   56                    	MOV	D,M
  226D'   23                    	INX	H
  226E'   1E 00                 	MVI	E,0
  2270'   CD 2837'              	CALL	ISLOW
  2273'   DA 227E'              	JC	EX_LK
  2276'   5F                    	MOV	E,A
  2277'   23                    	INX	H
  2278'   CD 2837'              	CALL	ISLOW
  227B'   D2 2297'              	JNC	EX_NOT		; a third letter: none of ours
  227E'                         EX_LK:
  227E'   E5                    	PUSH	H
  227F'   21 2A39'              	LXI	H,EXTAB
  2282'                         EX_TL:
  2282'   7E                    	MOV	A,M
  2283'   B7                    	ORA	A
  2284'   CA 2296'              	JZ	EX_NTP		; not in the table
  2287'   23                    	INX	H
  2288'   BA                    	CMP	D
  2289'   7E                    	MOV	A,M
  228A'   23                    	INX	H
  228B'   C2 2292'              	JNZ	EX_TN
  228E'   BB                    	CMP	E
  228F'   CA 229D'              	JZ	EX_TF
  2292'                         EX_TN:
  2292'   23                    	INX	H
  2293'   C3 2282'              	JMP	EX_TL
  2296'                         EX_NTP:
  2296'   E1                    	POP	H
  2297'                         EX_NOT:
  2297'   21 28F2'              	LXI	H,SNOT
  229A'   C3 286C'              	JMP	EXERT
  229D'                         EX_TF:
  229D'   7E                    	MOV	A,M
  229E'   32 0000*              	STA	EXOP
  22A1'   E1                    	POP	H
  22A2'   FE 06                 	CPI	EO_S
  22A4'   CA 2AC1'              	JZ	EX_S		; ':s' reads the rest of the line itself
  22A7'   FE 01                 	CPI	EO_W
  22A9'   CA 22B8'              	JZ	EX_RG		; ':N,Mw name' takes a range
  22AC'   FE 08                 	CPI	EO_R
  22AE'   CA 22B8'              	JZ	EX_RG		; ... and ':Nr name' a line
  22B1'   3A 0000*              	LDA	SRNGF
  22B4'   B7                    	ORA	A
  22B5'   C2 2297'              	JNZ	EX_NOT		; a range on a command that does not take one
  22B8'                         EX_RG:
                                	;--- '!', then the file name ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  22B8'   7E                    	MOV	A,M
  22B9'   D6 21                 	SUI	'!'
  22BB'   32 0000*              	STA	EXBANG		; 0 = '!'
  22BE'   C2 22C2'              	JNZ	EX_NB
  22C1'   23                    	INX	H
  22C2'                         EX_NB:
  22C2'   CD 282B'              	CALL	SKIPB
  22C5'   32 0000*              	STA	EXARG		; 0 = no file name
  22C8'   CA 22E1'              	JZ	EX_RUN
  22CB'   22 0000*              	SHLD	EXCMD
  22CE'   3A 0000*              	LDA	EXOP
  22D1'   FE 02                 	CPI	EO_Q
  22D3'   CA 2869'              	JZ	EX_TRL		; :q takes none
  22D6'   FE 07                 	CPI	EO_V
  22D8'   CA 2869'              	JZ	EX_TRL		; nor :ve
  22DB'   CD 2795'              	CALL	PARSFN
  22DE'   C2 285D'              	JNZ	EX_INV
  22E1'                         EX_RUN:
  22E1'   3A 0000*              	LDA	EXOP
  22E4'   FE 05                 	CPI	EO_E
  22E6'   CA 2390'              	JZ	EX_E
  22E9'   FE 02                 	CPI	EO_Q
  22EB'   CA 2379'              	JZ	EX_Q
  22EE'   FE 07                 	CPI	EO_V
  22F0'   CA 2863'              	JZ	EX_V
  22F3'   FE 08                 	CPI	EO_R
  22F5'   CA 2521'              	JZ	EX_R
  22F8'   FE 04                 	CPI	EO_X
  22FA'   CA 230C'              	JZ	EX_XM
  22FD'   FE 01                 	CPI	EO_W
  22FF'   C2 2313'              	JNZ	EX_W		; :wq
  2302'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2305'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2306'   C2 2441'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2309'   C3 2313'              	JMP	EX_W
  230C'                         EX_XM:
  230C'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  230F'   B7                    	ORA	A
  2310'   CA 2379'              	JZ	EX_Q
  2313'                         EX_W:
  2313'   CD 2601'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2316'   D8                    	RC			; refused (message shown)
  2317'   32 0000*              	STA	EXBAK
  231A'   3A 0000*              	LDA	EXOP
  231D'   FE 01                 	CPI	EO_W
  231F'   CA 2336'              	JZ	EX_WK
  2322'   3A 0000*              	LDA	EXBAK
  2325'   B7                    	ORA	A
  2326'   C2 2376'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2329'   3A 0000*              	LDA	EXBANG
  232C'   B7                    	ORA	A
  232D'   CA 2376'              	JZ	EX_WQ		; so it does with '!'
  2330'   CD 2336'              	CALL	EX_WK		; else it may not: keep the text
  2333'   C3 2379'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  2336'                         EX_WK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2336'   CD 0EDA'              	CALL	CURRW		; the cursor's row and file position
  2339'   32 0000*              	STA	WPROW
  233C'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  233F'   7D                    	MOV	A,L
  2340'   E6 7F                 	ANI	7FH
  2342'   32 0000*              	STA	WPBYT
  2345'   7D                    	MOV	A,L
  2346'   17                    	RAL
  2347'   7C                    	MOV	A,H
  2348'   17                    	RAL
  2349'   5F                    	MOV	E,A
  234A'   3E 00                 	MVI	A,0
  234C'   17                    	RAL
  234D'   57                    	MOV	D,A		; DE = HL / 128
  234E'   2A 0000*              	LHLD	OUTPOS
  2351'   19                    	DAD	D
  2352'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  2355'   CD 2636'              	CALL	WRITE
  2358'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  235B'   2A 0000*              	LHLD	WPREC
  235E'   EB                    	XCHG
  235F'   3A 0000*              	LDA	WPBYT
  2362'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  2365'   CD 0000*              	CALL	GOTO
  2368'                         EX_WRW:
  2368'   21 0000               	LXI	H,0
  236B'   22 0000*              	SHLD	LNDLT
  236E'   3A 0000*              	LDA	WPROW
  2371'   6F                    	MOV	L,A
  2372'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  2375'   C9                    	RET
  2376'                         EX_WQ:
  2376'   CD 2636'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  2379'                         EX_Q:
  2379'   3A 0000*              	LDA	EXBANG
  237C'   B7                    	ORA	A
  237D'   CA 2387'              	JZ	EX_QT
  2380'   3A 0000*              	LDA	MODF
  2383'   B7                    	ORA	A
  2384'   C2 2851'              	JNZ	MSGNWR		; changed, no '!': stay
  2387'                         EX_QT:
  2387'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  238A'   3E 01                 	MVI	A,1
  238C'   32 0000*              	STA	QUITF
  238F'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  2390'                         EX_E:
  2390'   3A 0000*              	LDA	EXBANG
  2393'   B7                    	ORA	A
  2394'   CA 239E'              	JZ	EE_GO
  2397'   3A 0000*              	LDA	MODF
  239A'   B7                    	ORA	A
  239B'   C2 2851'              	JNZ	MSGNWR
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  239E'                         EE_GO:
  239E'   3A 0000*              	LDA	EXARG
  23A1'   B7                    	ORA	A
  23A2'   C2 23A9'              	JNZ	EE_ARG
  23A5'   CD 2672'              	CALL	OWNTF		; no name: the buffer's own
  23A8'   D8                    	RC
  23A9'                         EE_ARG:
  23A9'   CD 2688'              	CALL	ISOWN
  23AC'   21 0001               	LXI	H,1
  23AF'   C2 23B6'              	JNZ	EE_LD		; another file: its first line
  23B2'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  23B5'   23                    	INX	H		; HL = the cursor's line
  23B6'                         EE_LD:
  23B6'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  23B8'   32 0000*              	STA	MSGWHT
  23BB'   E5                    	PUSH	H
  23BC'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  23BF'   21 0000*              	LXI	H,TFCB
  23C2'   11 0000*              	LXI	D,FNAME
  23C5'   CD 269A'              	CALL	COPY12		; the buffer's name
  23C8'   CD 265F'              	CALL	SRCTF
  23CB'   CD 0000*              	CALL	REOPEN
  23CE'   CD 01EF'              	CALL	MKCLR		; the marks named the buffer that just went
  23D1'   AF                    	XRA	A
  23D2'   32 0000*              	STA	MODF
  23D5'   E1                    	POP	H
  23D6'   2B                    	DCX	H
  23D7'   AF                    	XRA	A
  23D8'   CD 0000*              	CALL	MVLIND		; down to the line
  23DB'   CD 0BF6'              	CALL	ATEOF
  23DE'   DC 0BFC'              	CC	LASTLN		; past the last line: onto it
  23E1'   CD 13DB'              	CALL	ZSAVE
  23E4'   C3 14B0'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  23E7'                         TFDOS:
  23E7'   C5                    	PUSH	B
  23E8'   11 0080               	LXI	D,CMDTAIL
  23EB'   0E 1A                 	MVI	C,1AH		; set the DMA
  23ED'   CD 0005               	CALL	BDOS
  23F0'   C1                    	POP	B
  23F1'   11 0000*              	LXI	D,TFCB
  23F4'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  23F7'                         EXRNG:
  23F7'   2A 0000*              	LHLD	SRNG1
  23FA'   7C                    	MOV	A,H
  23FB'   B5                    	ORA	L
  23FC'   37                    	STC
  23FD'   C8                    	RZ
  23FE'   2A 0000*              	LHLD	SRNG2
  2401'   EB                    	XCHG
  2402'   2A 0000*              	LHLD	SRNG1
  2405'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2408'   D8                    	RC
  2409'   EB                    	XCHG			; HL = the last line, DE = the first
  240A'   CD 0000*              	CALL	SUBHD
  240D'   23                    	INX	H
  240E'   22 0000*              	SHLD	SLINES
  2411'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2412'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2413'                         GOLNX:
  2413'   E5                    	PUSH	H
  2414'   CD 135A'              	CALL	GOLN
  2417'   CD 0000*              	CALL	CNTLF
  241A'   23                    	INX	H		; the line the cursor came to rest on
  241B'   D1                    	POP	D
  241C'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  241F'                         EXSAVP:
  241F'   CD 0EDA'              	CALL	CURRW
  2422'   32 0000*              	STA	WPROW
  2425'   21 0000*              	LXI	H,MKPOS
  2428'   C3 0444'              	JMP	FPSTO
  242B'                         EXRSTP:
  242B'   CD 0000*              	CALL	CLRCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  242E'   CD 03AC'              	CALL	MKPAGE		; page until that place is in the window again
  2431'   CD 0000*              	CALL	GOTO
  2434'   C3 2368'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2437'                         PUTBRK:
  2437'   3E 0D                 	MVI	A,CR
  2439'   CD 0000*              	CALL	PUTGAP
  243C'   3E 0A                 	MVI	A,LF
  243E'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2441'                         EX_WR:
  2441'   3A 0000*              	LDA	EXARG
  2444'   B7                    	ORA	A
  2445'   CA 283F'              	JZ	MSGNFN		; No file name
  2448'   CD 2688'              	CALL	ISOWN
  244B'   CA 24EB'              	JZ	EXW_OW
  244E'   CD 0000*              	CALL	TEXIST
  2451'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  2454'   CA 245E'              	JZ	EXW_GO
  2457'   3A 0000*              	LDA	EXBANG
  245A'   B7                    	ORA	A
  245B'   C2 2845'              	JNZ	MSGEXI		; File exists (! to force)
  245E'                         EXW_GO:
  245E'   CD 23F7'              	CALL	EXRNG
  2461'   DA 24E5'              	JC	EXW_BD
  2464'   CD 241F'              	CALL	EXSAVP
  2467'   2A 0000*              	LHLD	SRNG1
  246A'   CD 2413'              	CALL	GOLNX
  246D'   C2 24E2'              	JNZ	EXW_NL		; the text has no line N
  2470'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  2473'   B7                    	ORA	A		;   not: only when TEXIST found one
  2474'   0E 13                 	MVI	C,13H
  2476'   C4 23E7'              	CNZ	TFDOS		; delete what is there
  2479'   0E 16                 	MVI	C,16H
  247B'   CD 23E7'              	CALL	TFDOS		; ... and make it
  247E'   3C                    	INR	A
  247F'   CA 24D4'              	JZ	EXW_FL		; no directory entry left
  2482'   3E 80                 	MVI	A,80H
  2484'   32 0000*              	STA	RWPTR
  2487'   AF                    	XRA	A
  2488'   32 0000*              	STA	RWERR
  248B'   2A 0000*              	LHLD	SLINES
  248E'   CD 0000*              	CALL	SETC0		; that many lines, forward
  2491'                         EXW_LP:
  2491'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  2494'   E5                    	PUSH	H
  2495'   EB                    	XCHG
  2496'   2A 0000*              	LHLD	GAPEND
  2499'   CD 24F1'              	CALL	RWOUT		; the text from the cursor to there
  249C'   E1                    	POP	H
  249D'   3A 0000*              	LDA	RWERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24A0'   B7                    	ORA	A
  24A1'   C2 24BD'              	JNZ	EXW_EN
  24A4'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  24A7'   CD 07AD'              	CALL	CNTTST
  24AA'   C2 2491'              	JNZ	EXW_LP
  24AD'                         EXW_PD:				; the last record is padded out with ^Z
  24AD'   3A 0000*              	LDA	RWPTR
  24B0'   FE 80                 	CPI	80H
  24B2'   CA 24BD'              	JZ	EXW_EN
  24B5'   3E 1A                 	MVI	A,CPMEOF
  24B7'   CD 24FD'              	CALL	RWPUT
  24BA'   C3 24AD'              	JMP	EXW_PD
  24BD'                         EXW_EN:
  24BD'   0E 10                 	MVI	C,10H
  24BF'   CD 23E7'              	CALL	TFDOS		; close
  24C2'   3A 0000*              	LDA	RWERR
  24C5'   B7                    	ORA	A
  24C6'   C2 24D4'              	JNZ	EXW_FL
  24C9'   CD 242B'              	CALL	EXRSTP
  24CC'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  24CE'   32 0000*              	STA	MSGWHT
  24D1'   C3 086D'              	JMP	SETMOV		; nothing on the screen has changed
  24D4'                         EXW_FL:				; no room: the part written is not left behind
  24D4'   0E 13                 	MVI	C,13H
  24D6'   CD 23E7'              	CALL	TFDOS
  24D9'   CD 242B'              	CALL	EXRSTP
  24DC'   21 2A2F'              	LXI	H,SDFUL
  24DF'   C3 2877'              	JMP	EXERR
  24E2'                         EXW_NL:
  24E2'   CD 242B'              	CALL	EXRSTP
  24E5'                         EXW_BD:
  24E5'   21 2A21'              	LXI	H,SRNGE
  24E8'   C3 2877'              	JMP	EXERR
  24EB'                         EXW_OW:
  24EB'   21 28A9'              	LXI	H,SEXI
  24EE'   C3 2877'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  24F1'                         RWOUT:
  24F1'   CD 0000*              	CALL	CMP16
  24F4'   C8                    	RZ
  24F5'   7E                    	MOV	A,M
  24F6'   23                    	INX	H
  24F7'   CD 24FD'              	CALL	RWPUT
  24FA'   C3 24F1'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  24FD'                         RWPUT:
  24FD'   E5                    	PUSH	H
  24FE'   F5                    	PUSH	PSW
  24FF'   3A 0000*              	LDA	RWPTR
  2502'   6F                    	MOV	L,A
  2503'   26 00                 	MVI	H,0
  2505'   F1                    	POP	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2506'   77                    	MOV	M,A
  2507'   2C                    	INR	L		; Z: that was the record's last byte
  2508'   7D                    	MOV	A,L
  2509'   C2 251C'              	JNZ	RWP_ST
  250C'   D5                    	PUSH	D
  250D'   0E 15                 	MVI	C,15H
  250F'   CD 23E7'              	CALL	TFDOS		; write it
  2512'   D1                    	POP	D
  2513'   B7                    	ORA	A
  2514'   CA 251A'              	JZ	RWP_OK
  2517'   32 0000*              	STA	RWERR
  251A'                         RWP_OK:
  251A'   3E 80                 	MVI	A,80H
  251C'                         RWP_ST:
  251C'   32 0000*              	STA	RWPTR
  251F'   E1                    	POP	H
  2520'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2521'                         EX_R:
  2521'   3A 0000*              	LDA	EXARG
  2524'   B7                    	ORA	A
  2525'   CA 283F'              	JZ	MSGNFN		; No file name
  2528'   0E 0F                 	MVI	C,0FH
  252A'   CD 23E7'              	CALL	TFDOS		; open
  252D'   3C                    	INR	A
  252E'   CA 25FB'              	JZ	ER_NOF
  2531'   CD 1401'              	CALL	GZONE		; the screen's top line, before anything moves
  2534'   CD 241F'              	CALL	EXSAVP
  2537'   3A 0000*              	LDA	SRNGF
  253A'   B7                    	ORA	A
  253B'   CA 2554'              	JZ	ER_NXT		; no line given: below the cursor's
  253E'   2A 0000*              	LHLD	SRNG2
  2541'   7C                    	MOV	A,H
  2542'   B5                    	ORA	L
  2543'   C2 254E'              	JNZ	ER_LN
  2546'   23                    	INX	H
  2547'   CD 135A'              	CALL	GOLN		; ':0r': above line 1 ...
  254A'   AF                    	XRA	A		;   which never wants a line end put in first
  254B'   C3 2576'              	JMP	ER_BRK
  254E'                         ER_LN:
  254E'   CD 2413'              	CALL	GOLNX
  2551'   C2 24E2'              	JNZ	EXW_NL		; the text has no line N
  2554'                         ER_NXT:
  2554'   21 0001               	LXI	H,1
  2557'   AF                    	XRA	A
  2558'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  255B'   CD 0BF6'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  255E'   3E 00                 	MVI	A,0
  2560'   D2 2576'              	JNC	ER_BRK		; text follows
  2563'   2A 0000*              	LHLD	GAPBEG
  2566'   EB                    	XCHG
  2567'   2A 0000*              	LHLD	TXTBEG
  256A'   CD 0000*              	CALL	CMP16
  256D'   3E 01                 	MVI	A,1
  256F'   CA 2576'              	JZ	ER_BRK		; nothing before the cursor either
  2572'   1B                    	DCX	D
  2573'   1A                    	LDAX	D
  2574'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  2576'                         ER_BRK:
  2576'   32 0000*              	STA	RDBRK
  2579'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  257C'   AF                    	XRA	A
  257D'   32 0000*              	STA	RDANY
  2580'                         ER_LP:
  2580'   0E 14                 	MVI	C,14H
  2582'   CD 23E7'              	CALL	TFDOS		; the next record
  2585'   B7                    	ORA	A
  2586'   C2 25B9'              	JNZ	ER_END
  2589'   21 0080               	LXI	H,CMDTAIL
  258C'   0E 00                 	MVI	C,0
  258E'                         ER_SC:				; C = its bytes, up to a ^Z
  258E'   7E                    	MOV	A,M
  258F'   FE 1A                 	CPI	CPMEOF
  2591'   CA 2599'              	JZ	ER_GOT
  2594'   23                    	INX	H
  2595'   0C                    	INR	C
  2596'   F2 258E'              	JP	ER_SC		; (minus: all 128)
  2599'                         ER_GOT:
  2599'   79                    	MOV	A,C
  259A'   B7                    	ORA	A
  259B'   CA 25B9'              	JZ	ER_END
  259E'   C5                    	PUSH	B
  259F'   3A 0000*              	LDA	RDANY
  25A2'   B7                    	ORA	A
  25A3'   CC 25EA'              	CZ	ER_1ST
  25A6'   C1                    	POP	B
  25A7'   06 00                 	MVI	B,0
  25A9'   11 0080               	LXI	D,CMDTAIL
  25AC'   C5                    	PUSH	B
  25AD'   CD 0000*              	CALL	INSBLK
  25B0'   C1                    	POP	B
  25B1'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  25B4'   79                    	MOV	A,C
  25B5'   17                    	RAL
  25B6'   DA 2580'              	JC	ER_LP		; a full record: there may be more
  25B9'                         ER_END:
  25B9'   3A 0000*              	LDA	RDANY
  25BC'   B7                    	ORA	A
  25BD'   CA 25DB'              	JZ	ER_PL		; nothing in the file: nothing has changed
  25C0'   CD 0BF6'              	CALL	ATEOF
  25C3'   DA 25D0'              	JC	ER_MD		; the text now ends as the file read ends
  25C6'   2A 0000*              	LHLD	GAPBEG
  25C9'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25CA'   7E                    	MOV	A,M
  25CB'   FE 0A                 	CPI	LF
  25CD'   C4 2437'              	CNZ	PUTBRK		; text follows: what was read ends a line
  25D0'                         ER_MD:
  25D0'   3E 01                 	MVI	A,1
  25D2'   32 0000*              	STA	MODF
  25D5'   CD 03AC'              	CALL	MKPAGE		; back to the first line read
  25D8'   CD 0000*              	CALL	GOTO
  25DB'                         ER_PL:
  25DB'   CD 0BF6'              	CALL	ATEOF
  25DE'   DC 0BFC'              	CC	LASTLN		; (nothing read, at the end: the last line)
  25E1'   CD 0000*              	CALL	CLRCNT
  25E4'   CD 1419'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  25E7'   C3 08AA'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  25EA'                         ER_1ST:
  25EA'   3C                    	INR	A
  25EB'   32 0000*              	STA	RDANY
  25EE'   3A 0000*              	LDA	RDBRK
  25F1'   B7                    	ORA	A
  25F2'   C4 2437'              	CNZ	PUTBRK
  25F5'   21 0000*              	LXI	H,MKPOS
  25F8'   C3 0444'              	JMP	FPSTO
  25FB'                         ER_NOF:
  25FB'   21 2A10'              	LXI	H,SNOPN
  25FE'   C3 286C'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2601'                         WRCHK:
  2601'   3A 0000*              	LDA	EXARG
  2604'   B7                    	ORA	A
  2605'   C2 260F'              	JNZ	WC_ARG
  2608'   CD 2672'              	CALL	OWNTF
  260B'   D8                    	RC
  260C'   C3 2624'              	JMP	WC_OWN
  260F'                         WC_ARG:
  260F'   CD 2688'              	CALL	ISOWN
  2612'   CA 2624'              	JZ	WC_OWN
  2615'   3A 0000*              	LDA	EXBANG
  2618'   B7                    	ORA	A
  2619'   CA 2622'              	JZ	WC_OTH
  261C'   CD 0000*              	CALL	TEXIST
  261F'   C2 2845'              	JNZ	MSGEXI		; File exists (! to force)
  2622'                         WC_OTH:
  2622'   AF                    	XRA	A		; (NC)
  2623'   C9                    	RET
  2624'                         WC_OWN:
  2624'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  2627'   B7                    	ORA	A
  2628'   CA 2632'              	JZ	WC_OK
  262B'   3A 0000*              	LDA	EXBANG
  262E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  262F'   C2 284B'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2632'                         WC_OK:
  2632'   3E 01                 	MVI	A,1
  2634'   B7                    	ORA	A		; (NC)
  2635'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2636'                         WRITE:
  2636'   3A 0000*              	LDA	EXBAK
  2639'   CD 0000*              	CALL	WRTO
  263C'   3A 0001*              	LDA	FNAME+1
  263F'   FE 20                 	CPI	' '
  2641'   C2 264D'              	JNZ	WR_HAS
  2644'   21 0000*              	LXI	H,TFCB
  2647'   11 0000*              	LXI	D,FNAME
  264A'   CD 269A'              	CALL	COPY12
  264D'                         WR_HAS:
  264D'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  264F'   32 0000*              	STA	MSGWHT
  2652'   CD 2688'              	CALL	ISOWN
  2655'   C2 265F'              	JNZ	SRCTF
  2658'   AF                    	XRA	A
  2659'   32 0000*              	STA	MODF
  265C'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  265F'                         SRCTF:
  265F'   21 0000*              	LXI	H,TFCB
  2662'   11 005C               	LXI	D,DFTFCB
  2665'   CD 269A'              	CALL	COPY12
  2668'   AF                    	XRA	A
  2669'   06 04                 	MVI	B,4
  266B'                         SRC_Z:
  266B'   12                    	STAX	D		; extent, s1, s2, record count: 0
  266C'   13                    	INX	D
  266D'   05                    	DCR	B
  266E'   C2 266B'              	JNZ	SRC_Z
  2671'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  2672'                         OWNTF:
  2672'   3A 0001*              	LDA	FNAME+1
  2675'   FE 20                 	CPI	' '
  2677'   CA 283F'              	JZ	MSGNFN
  267A'   CD 26A5'              	CALL	TFCLR
  267D'   21 0000*              	LXI	H,FNAME
  2680'   11 0000*              	LXI	D,TFCB
  2683'   CD 269A'              	CALL	COPY12
  2686'   B7                    	ORA	A		; (NC)
  2687'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  2688'                         ISOWN:
  2688'   21 0000*              	LXI	H,TFCB
  268B'   11 0000*              	LXI	D,FNAME
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  268E'   06 0C                 	MVI	B,12
  2690'                         IO_LP:
  2690'   1A                    	LDAX	D
  2691'   BE                    	CMP	M
  2692'   C0                    	RNZ
  2693'   23                    	INX	H
  2694'   13                    	INX	D
  2695'   05                    	DCR	B
  2696'   C2 2690'              	JNZ	IO_LP
  2699'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  269A'                         COPY12:
  269A'   06 0C                 	MVI	B,12
  269C'                         CP_LP:
  269C'   7E                    	MOV	A,M
  269D'   12                    	STAX	D
  269E'   23                    	INX	H
  269F'   13                    	INX	D
  26A0'   05                    	DCR	B
  26A1'   C2 269C'              	JNZ	CP_LP
  26A4'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  26A5'                         TFCLR:
  26A5'   11 0000*              	LXI	D,TFCB
  26A8'   06 24                 	MVI	B,36
  26AA'   AF                    	XRA	A
  26AB'                         TC_LP:
  26AB'   12                    	STAX	D
  26AC'   13                    	INX	D
  26AD'   05                    	DCR	B
  26AE'   C2 26AB'              	JNZ	TC_LP
  26B1'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  26B2'                         FOPEN:
  26B2'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  26B4'   32 0000*              	STA	MSGWHT
  26B7'   21 005C               	LXI	H,DFTFCB
  26BA'   CD 2788'              	CALL	NRMDRV
  26BD'   11 0000*              	LXI	D,FNAME
  26C0'   CD 269A'              	CALL	COPY12
  26C3'   CD 0000*              	CALL	OPENZ
  26C6'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  26C9'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  26CB'   C8                    	RZ
  26CC'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  26CF'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  26D2'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  26D3'                         ARGSCN:
  26D3'   3A 0080               	LDA	CMDTAIL
  26D6'   47                    	MOV	B,A		; B = what is left of the line
  26D7'   B7                    	ORA	A
  26D8'   C8                    	RZ
  26D9'   21 0081               	LXI	H,CMDTAIL+1
  26DC'                         AS_TOK:				; at a token, or the blanks before one
  26DC'   7E                    	MOV	A,M
  26DD'   FE 20                 	CPI	' '
  26DF'   C2 26E8'              	JNZ	AS_OPT
  26E2'   23                    	INX	H
  26E3'   05                    	DCR	B
  26E4'   C2 26DC'              	JNZ	AS_TOK
  26E7'   C9                    	RET
  26E8'                         AS_OPT:
  26E8'   FE 2B                 	CPI	'+'
  26EA'   CA 2714'              	JZ	AS_PLS
  26ED'   FE 2D                 	CPI	'-'
  26EF'   CA 2703'              	JZ	AS_SW
  26F2'   FE 2F                 	CPI	'/'
  26F4'   CA 2703'              	JZ	AS_SW
  26F7'                         AS_SKP:				; not ours (the file name): on to the next one
  26F7'   23                    	INX	H
  26F8'   05                    	DCR	B
  26F9'   C8                    	RZ
  26FA'   7E                    	MOV	A,M
  26FB'   FE 20                 	CPI	' '
  26FD'   C2 26F7'              	JNZ	AS_SKP
  2700'   C3 26DC'              	JMP	AS_TOK
  2703'                         AS_SW:
  2703'   23                    	INX	H
  2704'   05                    	DCR	B
  2705'   C8                    	RZ
  2706'   7E                    	MOV	A,M
  2707'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2709'   FE 52                 	CPI	'R'
  270B'   C2 26F7'              	JNZ	AS_SKP
  270E'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2711'   C3 26F7'              	JMP	AS_SKP
  2714'                         AS_PLS:
  2714'   3E 01                 	MVI	A,1
  2716'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  2719'   11 0000*              	LXI	D,PLUSB
  271C'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  271E'   23                    	INX	H		;   line space, so it is taken as '+' alone
  271F'   05                    	DCR	B
  2720'   CA 2757'              	JZ	AS_PE
  2723'   7E                    	MOV	A,M
  2724'   FE 30                 	CPI	'0'
  2726'   C2 273E'              	JNZ	AS_PD
  2729'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2729'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  272A'   05                    	DCR	B
  272B'   CA 275F'              	JZ	AS_P1
  272E'   7E                    	MOV	A,M
  272F'   FE 30                 	CPI	'0'
  2731'   CA 2729'              	JZ	AS_PZ
  2734'   FE 31                 	CPI	'1'
  2736'   DA 275F'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2739'   FE 3A                 	CPI	'9'+1
  273B'   D2 275F'              	JNC	AS_P1
  273E'                         AS_PD:				; the digits, as typed
  273E'   7E                    	MOV	A,M
  273F'   FE 30                 	CPI	'0'
  2741'   DA 2757'              	JC	AS_PE
  2744'   FE 3A                 	CPI	'9'+1
  2746'   D2 2757'              	JNC	AS_PE
  2749'   79                    	MOV	A,C
  274A'   B7                    	ORA	A
  274B'   CA 2766'              	JZ	AS_POV
  274E'   0D                    	DCR	C
  274F'   7E                    	MOV	A,M
  2750'   12                    	STAX	D
  2751'   13                    	INX	D
  2752'   23                    	INX	H
  2753'   05                    	DCR	B
  2754'   C2 273E'              	JNZ	AS_PD
  2757'                         AS_PE:
  2757'   AF                    	XRA	A
  2758'   12                    	STAX	D		; the digits end with a 0
  2759'   78                    	MOV	A,B
  275A'   B7                    	ORA	A
  275B'   C8                    	RZ
  275C'   C3 26DC'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  275F'                         AS_P1:
  275F'   3E 31                 	MVI	A,'1'
  2761'   12                    	STAX	D
  2762'   13                    	INX	D
  2763'   C3 2757'              	JMP	AS_PE
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  2766'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  2766'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  2769'   C3 2757'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  276C'                         ARGGO:
  276C'   3A 0000*              	LDA	PLUSF
  276F'   B7                    	ORA	A
  2770'   C8                    	RZ
  2771'   21 0000*              	LXI	H,PLUSB
  2774'                         AG_LP:
  2774'   7E                    	MOV	A,M
  2775'   B7                    	ORA	A
  2776'   CA 2783'              	JZ	AG_G
  2779'   4F                    	MOV	C,A
  277A'   E5                    	PUSH	H
  277B'   CD 0026'              	CALL	VICMD
  277E'   E1                    	POP	H
  277F'   23                    	INX	H
  2780'   C3 2774'              	JMP	AG_LP
  2783'                         AG_G:
