  107E'   AF                    	XRA	A
  107F'   32 0000*              	STA	RWMV
  1082'   C9                    	RET
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  1083'                         MULSAT:
  1083'   EB                    	XCHG
  1084'   21 0000               	LXI	H,0
  1087'   B7                    	ORA	A
  1088'   C8                    	RZ
  1089'                         MS_LP:
  1089'   19                    	DAD	D
  108A'   DA 1092'              	JC	MS_SAT
  108D'   3D                    	DCR	A
  108E'   C2 1089'              	JNZ	MS_LP
  1091'   C9                    	RET
  1092'                         MS_SAT:
  1092'   21 FFFF               	LXI	H,0FFFFH
  1095'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': the text and the cursor down HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text goes
                                ; no farther than brings the last row of the file to the bottom row; the line
                                ; that many rows down becomes the top line -- from its first row, vim never
                                ; showing part of one, and the cursor moves as many rows less (more, where
                                ; the top line alone was taller than that and the text had to go past it).
                                ; On the last line nothing moves, the column included.
  1096'                         VC_HFDN:
  1096'   CD 0852'              	CALL	SETMOV
  1099'   CD 12DB'              	CALL	HFCNT		; HFN = the rows
  109C'   3A 0000*              	LDA	TALLF
  109F'   B7                    	ORA	A
  10A0'   C2 1136'              	JNZ	VHD_TL
  10A3'   CD 0EBF'              	CALL	CURRW
  10A6'   47                    	MOV	B,A
  10A7'   3A 0000*              	LDA	SCEOF
  10AA'   B7                    	ORA	A
  10AB'   CA 10B3'              	JZ	VHD_GO
  10AE'   3A 0000*              	LDA	SCBOT		; the last line's place
  10B1'   B8                    	CMP	B
  10B2'   C8                    	RZ			; the cursor is on it
  10B3'                         VHD_GO:
  10B3'   3A 0000*              	LDA	NEDIT
  10B6'   21 0000*              	LXI	H,HFN
  10B9'   86                    	ADD	M
  10BA'   3C                    	INR	A
  10BB'   4F                    	MOV	C,A
  10BC'   AF                    	XRA	A
  10BD'   CD 11B8'              	CALL	HTSET		; HL -> the top line's rows
  10C0'   3A 0000*              	LDA	HFN
  10C3'   57                    	MOV	D,A		; D = the rows the text moves
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  10C4'   5F                    	MOV	E,A		; E = the rows the cursor moves
  10C5'   3A 0000*              	LDA	HTEOF
  10C8'   B7                    	ORA	A
  10C9'   CA 10E8'              	JZ	VHD_1
  10CC'   E5                    	PUSH	H
  10CD'   C5                    	PUSH	B
  10CE'   0E FF                 	MVI	C,255
  10D0'   CD 11F7'              	CALL	HTFQ		; (runs off: C = 255 - the rows to the file's end)
  10D3'   3A 0000*              	LDA	NEDIT
  10D6'   81                    	ADD	C
  10D7'   2F                    	CMA			; A = those rows - NEDIT: the rows off the screen
  10D8'   C1                    	POP	B
  10D9'   E1                    	POP	H
  10DA'   B7                    	ORA	A
