  082F'   5F                    	MOV	E,A
  0830'   16 00                 	MVI	D,0
  0832'   3A 0000*              	LDA	NEDIT
  0835'   6F                    	MOV	L,A
  0836'   26 00                 	MVI	H,0
  0838'   19                    	DAD	D
  0839'   EB                    	XCHG			; DE = limit
  083A'   2A 23F0'              	LHLD	JKCNT
  083D'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  0840'   D2 0844'              	JNC	KC_N
  0843'   EB                    	XCHG			; HL = limit
  0844'                         KC_N:
  0844'   22 23F2'              	SHLD	JKN		; N = min(count, limit)
  0847'   EB                    	XCHG			; DE = LFs to find
