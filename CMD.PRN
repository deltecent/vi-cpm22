  18E0'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  18E2'   32 22D9'              	STA	MSGWHT
  18E5'   E5                    	PUSH	H
  18E6'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  18E9'   21 0000*              	LXI	H,TFCB
  18EC'   11 0000*              	LXI	D,FNAME
  18EF'   CD 19AA'              	CALL	COPY12		; the buffer's name
  18F2'   CD 196F'              	CALL	SRCTF
  18F5'   CD 0000*              	CALL	REOPEN
  18F8'   CD 020E'              	CALL	MKCLR		; the marks named the buffer that just went
  18FB'   AF                    	XRA	A
  18FC'   32 227D'              	STA	MODF
  18FF'   E1                    	POP	H
  1900'   2B                    	DCX	H
  1901'   AF                    	XRA	A
