  0BAE'   2A 0000*              	LHLD	LNDLT
  0BB1'   7C                    	MOV	A,H
  0BB2'   FE C0                 	CPI	0C0H
  0BB4'   CA 0BBB'              	JZ	LN_X
  0BB7'   2B                    	DCX	H
  0BB8'                         LN_ST:
  0BB8'   22 0000*              	SHLD	LNDLT
  0BBB'                         LN_X:
  0BBB'   E1                    	POP	H
  0BBC'   C9                    	RET
                                
  0BBD'   AF                    VC_E:	XRA	A
