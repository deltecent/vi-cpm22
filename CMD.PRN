  0CF9'   DA 0D05'              	JC	ES_CL
  0CFC'   CA 0D05'              	JZ	ES_CL
  0CFF'   2A 2A5D'              	LHLD	WKI
  0D02'   C3 057A'              	JMP	GOSET
  0D05'                         ES_CL:
  0D05'   2A 2A5F'              	LHLD	WKN
  0D08'   7C                    	MOV	A,H
  0D09'   B5                    	ORA	L
  0D0A'   C8                    	RZ
  0D0B'   2B                    	DCX	H
