  0BDC'   2B                    	DCX	H
  0BDD'   22 2937'              	SHLD	CNTV
  0BE0'   CD 0BE6'              	CALL	ESTEP
  0BE3'   C3 0BD6'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0BE6'                         ESTEP:
  0BE6'   CD 0000*              	CALL	CUROFF
  0BE9'   22 293B'              	SHLD	WKI
  0BEC'   CD 0000*              	CALL	LOGLEN
  0BEF'   22 293D'              	SHLD	WKN
  0BF2'   2A 293B'              	LHLD	WKI
  0BF5'   23                    	INX	H
  0BF6'   22 293B'              	SHLD	WKI
  0BF9'                         ES_WS:
  0BF9'   2A 293B'              	LHLD	WKI
  0BFC'   EB                    	XCHG
  0BFD'   2A 293D'              	LHLD	WKN
  0C00'   CD 0000*              	CALL	CMP16
  0C03'   D2 0C51'              	JNC	ES_LND
  0C06'   2A 293B'              	LHLD	WKI
  0C09'   CD 0000*              	CALL	CHARAT
  0C0C'   CD 0694'              	CALL	CLASSF
  0C0F'   B7                    	ORA	A
  0C10'   C2 0C1D'              	JNZ	ES_WD
  0C13'   2A 293B'              	LHLD	WKI
  0C16'   23                    	INX	H
  0C17'   22 293B'              	SHLD	WKI
  0C1A'   C3 0BF9'              	JMP	ES_WS
  0C1D'                         ES_WD:
  0C1D'   2A 293B'              	LHLD	WKI
  0C20'   CD 0000*              	CALL	CHARAT
  0C23'   CD 0694'              	CALL	CLASSF
  0C26'   32 2943'              	STA	WKCLS
  0C29'                         ES_RUN:
  0C29'   2A 293B'              	LHLD	WKI
  0C2C'   23                    	INX	H
  0C2D'   EB                    	XCHG			; DE = i+1
  0C2E'   2A 293D'              	LHLD	WKN
  0C31'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0C34'   D2 0C51'              	JNC	ES_LND
  0C37'   2A 293B'              	LHLD	WKI
  0C3A'   23                    	INX	H
  0C3B'   E5                    	PUSH	H		; i+1
  0C3C'   CD 0000*              	CALL	CHARAT
  0C3F'   CD 0694'              	CALL	CLASSF
  0C42'   E1                    	POP	H		; HL = i+1
  0C43'   47                    	MOV	B,A
  0C44'   3A 2943'              	LDA	WKCLS
  0C47'   B8                    	CMP	B
  0C48'   C2 0C51'              	JNZ	ES_LND
  0C4B'   22 293B'              	SHLD	WKI
  0C4E'   C3 0C29'              	JMP	ES_RUN
  0C51'                         ES_LND:
  0C51'   2A 293D'              	LHLD	WKN
  0C54'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C55'   2A 293B'              	LHLD	WKI
  0C58'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0C5B'   DA 0C67'              	JC	ES_CL
  0C5E'   CA 0C67'              	JZ	ES_CL
  0C61'   2A 293B'              	LHLD	WKI
  0C64'   C3 0561'              	JMP	GOSET
  0C67'                         ES_CL:
  0C67'   2A 293D'              	LHLD	WKN
  0C6A'   7C                    	MOV	A,H
  0C6B'   B5                    	ORA	L
  0C6C'   C8                    	RZ
  0C6D'   2B                    	DCX	H
  0C6E'   C3 0561'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0C71'                         CURRW:
  0C71'   2A 0000*              	LHLD	WINROW
  0C74'   EB                    	XCHG
  0C75'   2A 0000*              	LHLD	LNDLT
  0C78'   19                    	DAD	D		; HL = row (signed)
  0C79'   7C                    	MOV	A,H
  0C7A'   B7                    	ORA	A
  0C7B'   FA 0C8E'              	JM	CRW_0		; above the screen -> top row
  0C7E'   C2 0C89'              	JNZ	CRW_BT		; far below -> bottom row
  0C81'   3A 0000*              	LDA	NEDIT
  0C84'   3D                    	DCR	A		; A = bottom row
  0C85'   BD                    	CMP	L		; CY iff bottom < row
  0C86'   D8                    	RC
  0C87'   7D                    	MOV	A,L
  0C88'   C9                    	RET
  0C89'                         CRW_BT:
  0C89'   3A 0000*              	LDA	NEDIT
  0C8C'   3D                    	DCR	A
  0C8D'   C9                    	RET
  0C8E'                         CRW_0:
  0C8E'   AF                    	XRA	A
  0C8F'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0C90'                         SETRWT:
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C90'   2A 0000*              	LHLD	LNDLT
  0C93'   EB                    	XCHG
  0C94'   6F                    	MOV	L,A
  0C95'   26 00                 	MVI	H,0
  0C97'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0C9A'   22 0000*              	SHLD	WINROW
  0C9D'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0C9E'                         MVROW:
  0C9E'   47                    	MOV	B,A
  0C9F'   CD 0C71'              	CALL	CURRW
  0CA2'   90                    	SUB	B		; A = row now - target
  0CA3'   C8                    	RZ
  0CA4'   DA 0CAD'              	JC	MR_DN
  0CA7'   6F                    	MOV	L,A
  0CA8'   26 00                 	MVI	H,0
  0CAA'   C3 08F8'              	JMP	KCORE
  0CAD'                         MR_DN:
  0CAD'   2F                    	CMA
  0CAE'   3C                    	INR	A		; A = target - row now
  0CAF'   6F                    	MOV	L,A
  0CB0'   26 00                 	MVI	H,0
  0CB2'   C3 085B'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0CB5'                         VC_HIGH:
  0CB5'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CB8'   2B                    	DCX	H		; row = count - 1
  0CB9'   7C                    	MOV	A,H
  0CBA'   B7                    	ORA	A
  0CBB'   3A 0000*              	LDA	SCBOT
  0CBE'   C2 0CC6'              	JNZ	VH_GO		; >= 256 -> the last text row
  0CC1'   BD                    	CMP	L		; CY iff SCBOT < row
  0CC2'   DA 0CC6'              	JC	VH_GO
  0CC5'   7D                    	MOV	A,L
  0CC6'                         VH_GO:
  0CC6'   CD 0C9E'              	CALL	MVROW
  0CC9'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0CCC'                         VC_MIDL:
  0CCC'   CD 065F'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0CCF'   3A 0000*              	LDA	SCBOT
  0CD2'   B7                    	ORA	A		; clear CY for the shift
  0CD3'   1F                    	RAR			; A = SCBOT / 2
  0CD4'   CD 0C9E'              	CALL	MVROW
  0CD7'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0CDA'                         VC_LOWL:
  0CDA'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CDD'   2B                    	DCX	H		; count - 1
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0CDE'   3A 0000*              	LDA	SCBOT
  0CE1'   5F                    	MOV	E,A
  0CE2'   16 00                 	MVI	D,0
  0CE4'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0CE5'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0CE8'   3E 00                 	MVI	A,0
  0CEA'   D2 0CF1'              	JNC	VL_GO		; at or past the top -> row 0
  0CED'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0CF0'   7D                    	MOV	A,L
  0CF1'                         VL_GO:
  0CF1'   CD 0C9E'              	CALL	MVROW
  0CF4'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0CF7'                         VC_PGDN:
  0CF7'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0CFA'   3A 0000*              	LDA	SCEOF
  0CFD'   B7                    	ORA	A
  0CFE'   CA 0D0C'              	JZ	VPD_N
  0D01'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D04'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D05'   C8                    	RZ			; it already is
  0D06'   CD 0C9E'              	CALL	MVROW
  0D09'   C3 0D1D'              	JMP	VPD_TP
  0D0C'                         VPD_N:
  0D0C'   3A 0000*              	LDA	NEDIT
  0D0F'   D6 02                 	SUI	2
  0D11'   CD 0D65'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0D14'   E5                    	PUSH	H
  0D15'   AF                    	XRA	A
  0D16'   CD 0C9E'              	CALL	MVROW		; the top line
  0D19'   E1                    	POP	H
  0D1A'   CD 085B'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0D1D'                         VPD_TP:
  0D1D'   AF                    	XRA	A
  0D1E'   CD 0C90'              	CALL	SETRWT		; to the top row
  0D21'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0D24'                         VC_PGUP:
  0D24'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  0D27'   3A 0000*              	LDA	SCBOF
  0D2A'   B7                    	ORA	A
  0D2B'   C0                    	RNZ
  0D2C'   3A 0000*              	LDA	NEDIT
  0D2F'   47                    	MOV	B,A
  0D30'   3A 0000*              	LDA	SCEOF
  0D33'   B7                    	ORA	A
  0D34'   CA 0D45'              	JZ	VPU_2
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D37'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0D3A'   FE 02                 	CPI	2
  0D3C'   D2 0D45'              	JNC	VPU_2
  0D3F'   2F                    	CMA
  0D40'   3C                    	INR	A
  0D41'   80                    	ADD	B
  0D42'   C3 0D48'              	JMP	VPU_P
  0D45'                         VPU_2:
  0D45'   78                    	MOV	A,B
  0D46'   D6 02                 	SUI	2
  0D48'                         VPU_P:
  0D48'   CD 0D65'              	CALL	MULSAT		; HL = count * page
  0D4B'   E5                    	PUSH	H
  0D4C'   AF                    	XRA	A
  0D4D'   CD 0C9E'              	CALL	MVROW		; the top line
  0D50'   E1                    	POP	H
  0D51'   CD 08F8'              	CALL	KCORE		; the new top line
  0D54'   AF                    	XRA	A
  0D55'   CD 0C90'              	CALL	SETRWT		; on the top row
  0D58'   3A 0000*              	LDA	NEDIT
  0D5B'   3D                    	DCR	A
  0D5C'   6F                    	MOV	L,A
  0D5D'   26 00                 	MVI	H,0
  0D5F'   CD 085B'              	CALL	JCORE		; the bottom row's line
  0D62'   C3 07AD'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0D65'                         MULSAT:
  0D65'   EB                    	XCHG
  0D66'   21 0000               	LXI	H,0
  0D69'   B7                    	ORA	A
  0D6A'   C8                    	RZ
  0D6B'                         MS_LP:
  0D6B'   19                    	DAD	D
  0D6C'   DA 0D74'              	JC	MS_SAT
  0D6F'   3D                    	DCR	A
  0D70'   C2 0D6B'              	JNZ	MS_LP
  0D73'   C9                    	RET
  0D74'                         MS_SAT:
  0D74'   21 FFFF               	LXI	H,0FFFFH
  0D77'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0D78'                         VC_HFDN:
  0D78'   CD 06DF'              	CALL	SETMOV
  0D7B'   CD 0C71'              	CALL	CURRW
  0D7E'   32 2901'              	STA	HFROW
  0D81'   CD 0DEF'              	CALL	HFCNT		; HL = lines
  0D84'   3A 2901'              	LDA	HFROW
  0D87'   47                    	MOV	B,A
  0D88'   3A 0000*              	LDA	SCEOF
  0D8B'   B7                    	ORA	A
  0D8C'   CA 0D94'              	JZ	VHD_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D8F'   3A 0000*              	LDA	SCBOT		; the last line's row
  0D92'   B8                    	CMP	B
  0D93'   C8                    	RZ			; the cursor is on it
  0D94'                         VHD_GO:
  0D94'   CD 085B'              	CALL	JCORE
  0D97'   3A 0000*              	LDA	SCEOF
  0D9A'   B7                    	ORA	A
  0D9B'   C2 07AD'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0D9E'   3A 2901'              	LDA	HFROW
  0DA1'   CD 0C90'              	CALL	SETRWT
  0DA4'   3E 01                 	MVI	A,1
  0DA6'   32 0000*              	STA	WFILL		; not past the end of the file
  0DA9'   C3 07AD'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0DAC'                         VC_HFUP:
  0DAC'   CD 06DF'              	CALL	SETMOV
  0DAF'   CD 0C71'              	CALL	CURRW
  0DB2'   32 2901'              	STA	HFROW
  0DB5'   CD 0DEF'              	CALL	HFCNT		; HL = lines
  0DB8'   CD 0DCF'              	CALL	ONFST
  0DBB'   C8                    	RZ			; the cursor is on the first line
  0DBC'   CD 08F8'              	CALL	KCORE
  0DBF'   3A 0000*              	LDA	SCBOF
  0DC2'   B7                    	ORA	A
  0DC3'   C2 07AD'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0DC6'   3A 2901'              	LDA	HFROW
  0DC9'   CD 0C90'              	CALL	SETRWT
  0DCC'   C3 07AD'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0DCF'                         ONFST:
  0DCF'   E5                    	PUSH	H
  0DD0'   2A 0000*              	LHLD	OUTPOS
  0DD3'   7C                    	MOV	A,H
  0DD4'   B5                    	ORA	L
  0DD5'   C2 0DED'              	JNZ	OF_RET
  0DD8'   2A 0000*              	LHLD	TXTBEG
  0DDB'   EB                    	XCHG			; DE = TXTBEG
  0DDC'   2A 0000*              	LHLD	GAPBEG
  0DDF'                         OF_LP:
  0DDF'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0DE2'   CA 0DED'              	JZ	OF_RET
  0DE5'   2B                    	DCX	H
  0DE6'   7E                    	MOV	A,M
  0DE7'   FE 0A                 	CPI	LF
  0DE9'   C2 0DDF'              	JNZ	OF_LP
  0DEC'   B7                    	ORA	A		; NZ
  0DED'                         OF_RET:
  0DED'   E1                    	POP	H
  0DEE'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0DEF'                         HFCNT:
  0DEF'   2A 28F5'              	LHLD	CMDCNT
  0DF2'   7C                    	MOV	A,H
  0DF3'   B5                    	ORA	L
  0DF4'   CA 0E0B'              	JZ	HFC_AM
  0DF7'   CD 0672'              	CALL	GETCNT		; HL = count; clears it
  0DFA'   3A 0000*              	LDA	NEDIT
  0DFD'   5F                    	MOV	E,A
  0DFE'   16 00                 	MVI	D,0
  0E00'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E03'   D2 0E07'              	JNC	HFC_ST
  0E06'   EB                    	XCHG			; HL = NEDIT
  0E07'                         HFC_ST:
  0E07'   7D                    	MOV	A,L
  0E08'   32 2902'              	STA	HFAMT
  0E0B'                         HFC_AM:
  0E0B'   3A 2902'              	LDA	HFAMT
  0E0E'   B7                    	ORA	A
  0E0F'   C2 0E1C'              	JNZ	HFC_HL
  0E12'   3A 0000*              	LDA	NEDIT
  0E15'   B7                    	ORA	A
  0E16'   1F                    	RAR
  0E17'   B7                    	ORA	A
  0E18'   C2 0E1C'              	JNZ	HFC_HL
  0E1B'   3C                    	INR	A		; at least one line
  0E1C'                         HFC_HL:
  0E1C'   6F                    	MOV	L,A
  0E1D'   26 00                 	MVI	H,0
  0E1F'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0E20'                         VC_REDR:
  0E20'   C3 0672'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0E23'                         VC_G:
  0E23'   CD 06DF'              	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E26'   CD 0ED3'              	CALL	GZONE		; the screen's top line, before the move
  0E29'   2A 28F5'              	LHLD	CMDCNT
  0E2C'   7C                    	MOV	A,H
  0E2D'   B5                    	ORA	L
  0E2E'   C2 0E3B'              	JNZ	VG_N
  0E31'   AF                    	XRA	A		; forward
  0E32'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0E35'   CD 098F'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0E38'   C3 0EEB'              	JMP	GPLACE
  0E3B'                         VG_N:
  0E3B'   CD 0672'              	CALL	GETCNT		; HL = target line (1-based)
  0E3E'                         VG_LN:
  0E3E'   CD 0E44'              	CALL	GOLN
  0E41'   C3 0EEB'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0E44'                         GOLN:
  0E44'   E5                    	PUSH	H
  0E45'   CD 0000*              	CALL	CNTLF
  0E48'   23                    	INX	H		; HL = the cursor's line
  0E49'   D1                    	POP	D		; DE = the line wanted
  0E4A'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0E4D'   DA 0E58'              	JC	GLN_BK
  0E50'   EB                    	XCHG
  0E51'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0E54'   AF                    	XRA	A
  0E55'   C3 0E5D'              	JMP	GLN_MV
  0E58'                         GLN_BK:
  0E58'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0E5B'   3E FF                 	MVI	A,0FFH
  0E5D'                         GLN_MV:
  0E5D'   CD 0000*              	CALL	MVLIND
  0E60'   CD 0989'              	CALL	ATEOF
  0E63'   DC 098F'              	CC	LASTLN		; past the last line: onto it
  0E66'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0E67'                         VC_LG:
  0E67'   CD 06DF'              	CALL	SETMOV
  0E6A'   3A 291D'              	LDA	GSAVE
  0E6D'   B7                    	ORA	A
  0E6E'   C2 0E77'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0E71'   3E 01                 	MVI	A,PG
  0E73'   32 291C'              	STA	GPEND
  0E76'   C9                    	RET
  0E77'                         VLG_GG:
  0E77'   CD 0ED3'              	CALL	GZONE
  0E7A'   CD 0672'              	CALL	GETCNT		; HL = target line (no count: 1)
  0E7D'   C3 0E3E'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0E80'                         SUB24:
  0E80'   4F                    	MOV	C,A
  0E81'   7D                    	MOV	A,L
  0E82'   93                    	SUB	E
  0E83'   6F                    	MOV	L,A
  0E84'   7C                    	MOV	A,H
  0E85'   9A                    	SBB	D
  0E86'   67                    	MOV	H,A
  0E87'   79                    	MOV	A,C
  0E88'   98                    	SBB	B
  0E89'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0E8A'                         CURFP:
  0E8A'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0E8D'                         FPOS:
  0E8D'   C5                    	PUSH	B
  0E8E'   D5                    	PUSH	D
  0E8F'   EB                    	XCHG
  0E90'   2A 0000*              	LHLD	TXTBEG
  0E93'   EB                    	XCHG
  0E94'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0E97'   EB                    	XCHG			; DE = that
  0E98'   2A 0000*              	LHLD	OUTPOS
  0E9B'   7C                    	MOV	A,H
  0E9C'   B7                    	ORA	A		; CY = 0
  0E9D'   1F                    	RAR
  0E9E'   47                    	MOV	B,A
  0E9F'   7D                    	MOV	A,L
  0EA0'   1F                    	RAR
  0EA1'   67                    	MOV	H,A
  0EA2'   3E 00                 	MVI	A,0
  0EA4'   1F                    	RAR
  0EA5'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0EA6'   19                    	DAD	D
  0EA7'   78                    	MOV	A,B
  0EA8'   CE 00                 	ACI	0		; A:HL = the position
  0EAA'   D1                    	POP	D
  0EAB'   C1                    	POP	B
  0EAC'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0EAD'                         ZSAVE:
  0EAD'   2A 28F5'              	LHLD	CMDCNT
  0EB0'   22 295B'              	SHLD	ZSVCNT
  0EB3'   2A 0000*              	LHLD	AUXCNT
  0EB6'   22 295D'              	SHLD	ZSVAUX
  0EB9'   3A 0000*              	LDA	DIRFLG
  0EBC'   32 295F'              	STA	ZSVDIR
  0EBF'   C9                    	RET
  0EC0'                         ZREST:
  0EC0'   2A 295B'              	LHLD	ZSVCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EC3'   22 28F5'              	SHLD	CMDCNT
  0EC6'   2A 295D'              	LHLD	ZSVAUX
  0EC9'   22 0000*              	SHLD	AUXCNT
  0ECC'   3A 295F'              	LDA	ZSVDIR
  0ECF'   32 0000*              	STA	DIRFLG
  0ED2'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0ED3'                         GZONE:
  0ED3'   CD 0EAD'              	CALL	ZSAVE
  0ED6'   CD 0C71'              	CALL	CURRW
  0ED9'   6F                    	MOV	L,A
  0EDA'   26 00                 	MVI	H,0
  0EDC'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0EDF'   CD 0E8D'              	CALL	FPOS
  0EE2'   22 0000*              	SHLD	ZTOP
  0EE5'   32 0002*              	STA	ZTOP+2
  0EE8'   C3 0EC0'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0EEB'                         GPLACE:
  0EEB'   CD 0EAD'              	CALL	ZSAVE
  0EEE'   CD 0E8A'              	CALL	CURFP
  0EF1'   EB                    	XCHG
  0EF2'   2A 0000*              	LHLD	ZTOP
  0EF5'   EB                    	XCHG
  0EF6'   4F                    	MOV	C,A		; C:HL = the target's position
  0EF7'   3A 0002*              	LDA	ZTOP+2
  0EFA'   47                    	MOV	B,A		; B:DE = the top's
  0EFB'   79                    	MOV	A,C
  0EFC'   CD 0E80'              	CALL	SUB24
  0EFF'   22 2958'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0F02'   DA 0F4F'              	JC	GP_UP
  0F05'   B7                    	ORA	A
  0F06'   C2 0F90'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0F09'   3A 0000*              	LDA	NEDIT
  0F0C'   5F                    	MOV	E,A
  0F0D'   16 00                 	MVI	D,0
  0F0F'   B7                    	ORA	A
  0F10'   1F                    	RAR
  0F11'   6F                    	MOV	L,A
  0F12'   26 00                 	MVI	H,0
  0F14'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0F15'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0F18'   CD 066B'              	CALL	GBSUB		; HL = bytes from there to the target
  0F1B'   EB                    	XCHG
  0F1C'   2A 2958'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0F1F'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0F22'   DA 0F90'              	JC	GP_MID
  0F25'   CD 066B'              	CALL	GBSUB		; HL = the top line's start (resident)
  0F28'   01 0000               	LXI	B,0		; BC = lines from the top
  0F2B'                         GP_CNT:
  0F2B'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F2C'   B3                    	ORA	E
  0F2D'   CA 0F3C'              	JZ	GP_DN
  0F30'   7E                    	MOV	A,M
  0F31'   23                    	INX	H
  0F32'   1B                    	DCX	D
  0F33'   FE 0A                 	CPI	LF
  0F35'   C2 0F2B'              	JNZ	GP_CNT
  0F38'   03                    	INX	B
  0F39'   C3 0F2B'              	JMP	GP_CNT
  0F3C'                         GP_DN:
  0F3C'   3A 0000*              	LDA	NEDIT
  0F3F'   3D                    	DCR	A
  0F40'   5F                    	MOV	E,A
  0F41'   16 00                 	MVI	D,0		; DE = the bottom row
  0F43'   60                    	MOV	H,B
  0F44'   69                    	MOV	L,C
  0F45'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0F48'   DA 0F9A'              	JC	GP_SET		; A = the bottom row
  0F4B'   7D                    	MOV	A,L		; on the screen: its row
  0F4C'   C3 0FBA'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0F4F'                         GP_UP:
  0F4F'   3C                    	INR	A
  0F50'   C2 0F90'              	JNZ	GP_MID		; 64K bytes or more above
  0F53'   2A 2958'              	LHLD	ZDIF
  0F56'   EB                    	XCHG
  0F57'   21 0000               	LXI	H,0
  0F5A'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0F5D'   7C                    	MOV	A,H
  0F5E'   B5                    	ORA	L
  0F5F'   CA 0F90'              	JZ	GP_MID		; exactly 64K
  0F62'   EB                    	XCHG			; DE = bytes to read
  0F63'   AF                    	XRA	A
  0F64'   32 295A'              	STA	ZLF
  0F67'   CD 0000*              	CALL	RGET0
  0F6A'                         GP_RD:
  0F6A'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0F6D'   DA 0F90'              	JC	GP_MID
  0F70'   FE 0A                 	CPI	LF
  0F72'   C2 0F86'              	JNZ	GP_RN
  0F75'   3A 0000*              	LDA	NEDIT
  0F78'   B7                    	ORA	A
  0F79'   1F                    	RAR
  0F7A'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0F7C'   E5                    	PUSH	H
  0F7D'   21 295A'              	LXI	H,ZLF
  0F80'   34                    	INR	M
  0F81'   BE                    	CMP	M		; CY iff more lines than that
  0F82'   E1                    	POP	H
  0F83'   DA 0F90'              	JC	GP_MID
  0F86'                         GP_RN:
  0F86'   1B                    	DCX	D
  0F87'   7A                    	MOV	A,D
  0F88'   B3                    	ORA	E
  0F89'   C2 0F6A'              	JNZ	GP_RD
  0F8C'   AF                    	XRA	A		; the top row
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F8D'   C3 0F9A'              	JMP	GP_SET
  0F90'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0F90'   3E 01                 	MVI	A,1
  0F92'   32 0000*              	STA	WFILL		; not past the end of the file
  0F95'   3A 0000*              	LDA	NEDIT
  0F98'   B7                    	ORA	A
  0F99'   1F                    	RAR			; the middle row
  0F9A'                         GP_SET:
  0F9A'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0F9B'   26 00                 	MVI	H,0
  0F9D'   22 0000*              	SHLD	WINROW
  0FA0'   21 0000               	LXI	H,0
  0FA3'   22 0000*              	SHLD	LNDLT
  0FA6'   CD 0700'              	CALL	SETFUL		; the window may have paged: full repaint
  0FA9'                         GP_FIN:
  0FA9'   CD 0EC0'              	CALL	ZREST
  0FAC'   3A 2982'              	LDA	GPKEEP
  0FAF'   B7                    	ORA	A
  0FB0'   CA 07AD'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0FB3'   AF                    	XRA	A
  0FB4'   32 2982'              	STA	GPKEEP
  0FB7'   C3 0564'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0FBA'                         GP_ONS:
  0FBA'   6F                    	MOV	L,A
  0FBB'   26 00                 	MVI	H,0		; HL = the row it lands on
  0FBD'   EB                    	XCHG
  0FBE'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0FC1'   EB                    	XCHG
  0FC2'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0FC5'   22 0000*              	SHLD	LNDLT
  0FC8'   3E 01                 	MVI	A,R_MOVE
  0FCA'   32 28F9'              	STA	RINTENT
  0FCD'   C3 0FA9'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0FD0'                         OPPEND:
  0FD0'   AF                    	XRA	A
  0FD1'   32 2922'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0FD4'   3A 291F'              	LDA	PSAVE
  0FD7'   FE 63                 	CPI	'c'
  0FD9'   C2 0FF6'              	JNZ	OPP_ND
  0FDC'   79                    	MOV	A,C
  0FDD'   FE 77                 	CPI	'w'
  0FDF'   CA 0FE7'              	JZ	OPP_W
  0FE2'   FE 57                 	CPI	'W'
  0FE4'   C2 0FF6'              	JNZ	OPP_ND
  0FE7'                         OPP_W:
  0FE7'   CD 11C9'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0FEA'   DA 0FF6'              	JC	OPP_ND
  0FED'   79                    	MOV	A,C
  0FEE'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0FF0'   4F                    	MOV	C,A
  0FF1'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0FF3'   32 2922'              	STA	CWEOL		;   see the clamp in OPA_F
  0FF6'                         OPP_ND:
  0FF6'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  0FF7'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  0FF9'   C2 100D'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  0FFC'   CD 0218'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  0FFF'   DA 109D'              	JC	OPABRT
  1002'   79                    	MOV	A,C
  1003'   FE 67                 	CPI	'g'
  1005'   C2 109D'              	JNZ	OPABRT
  1008'   3E 01                 	MVI	A,PG
  100A'   32 291D'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  100D'                         OPP_NG:
  100D'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  100E'   21 291F'              	LXI	H,PSAVE
  1011'   BE                    	CMP	M
  1012'   CA 11EA'              	JZ	OPLINE
  1015'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1016'   CD 1200'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1019'   DA 109D'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  101C'   32 2921'              	STA	OPCLSV
  101F'   47                    	MOV	B,A		; B = the class
  1020'   3A 291F'              	LDA	PSAVE
  1023'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1025'   C2 1031'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  1028'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1029'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  102B'   C2 1053'              	JNZ	OPP_GO
  102E'   C3 103C'              	JMP	OPP_NO
  1031'                         OPP_NC:
  1031'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1033'   C2 1053'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1036'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1037'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1039'   CA 1053'              	JZ	OPP_GO		;   within a line -- neither of which is built
  103C'                         OPP_NO:
  103C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  103D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  103F'   CA 104D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1042'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1044'   CA 104D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1047'   CD 0348'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  104A'   C2 109D'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  104D'                         OPP_SW:
  104D'   CD 0218'              	CALL	MKGETK
  1050'   C3 109D'              	JMP	OPABRT
  1053'                         OPP_GO:
  1053'   AF                    	XRA	A
  1054'   32 2900'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1057'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  105A'   22 2923'              	SHLD	OPSTA
  105D'   C5                    	PUSH	B
  105E'   21 2927'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1061'   CD 0436'              	CALL	FPSTO		;   only good until the motion pages the window
  1064'   3A 2921'              	LDA	OPCLSV
  1067'   FE 02                 	CPI	2
  1069'   CC 10A0'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  106C'   C1                    	POP	B
  106D'   21 2823'              	LXI	H,CMDTAB
  1070'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1073'   3A 291F'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1076'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1077'   CA 06DF'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  107A'   CD 10CC'              	CALL	OPSFIX		; where the start is in the window NOW
  107D'   D2 10E8'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1080'   22 2923'              	SHLD	OPSTA
  1083'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1086'   22 2925'              	SHLD	OPEND2
  1089'   3A 291F'              	LDA	PSAVE
  108C'   FE 79                 	CPI	'y'
  108E'   CA 16AD'              	JZ	OPYANK		; a yank takes the span without losing it
  1091'   CD 123B'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1094'   3A 291F'              	LDA	PSAVE
  1097'   FE 63                 	CPI	'c'
  1099'   C0                    	RNZ
  109A'   C3 1469'              	JMP	SETINS
  109D'                         OPABRT:
  109D'   C3 06DF'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  10A0'                         OPENDS:
  10A0'   2A 2923'              	LHLD	OPSTA
  10A3'   CD 05CB'              	CALL	BOL
  10A6'   11 292A'              	LXI	D,OPSLO
  10A9'   CD 10BE'              	CALL	OPE_ST
  10AC'   2A 2923'              	LHLD	OPSTA
  10AF'   CD 05FB'              	CALL	NLSTART
  10B2'   11 292D'              	LXI	D,OPSHI
  10B5'   CD 10BE'              	CALL	OPE_ST
  10B8'   2A 2923'              	LHLD	OPSTA
  10BB'   C3 0000*              	JMP	GOTO
  10BE'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  10BE'   D5                    	PUSH	D
  10BF'   CD 0000*              	CALL	GOTO
  10C2'   E1                    	POP	H
  10C3'   C3 0436'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  10C6'                         CURBD:
  10C6'   CD 0E8A'              	CALL	CURFP
  10C9'   EB                    	XCHG
  10CA'   47                    	MOV	B,A
  10CB'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  10CC'                         OPSFIX:
  10CC'   21 2927'              	LXI	H,OPSFP
  10CF'   CD 03E9'              	CALL	MKLOAD
  10D2'   CD 10C6'              	CALL	CURBD
  10D5'   2A 298C'              	LHLD	MKPOS
  10D8'   3A 298E'              	LDA	MKPOS+2
  10DB'   CD 0E80'              	CALL	SUB24
  10DE'   B4                    	ORA	H
  10DF'   B5                    	ORA	L
  10E0'   C2 03F6'              	JNZ	MKWIN
  10E3'   CD 0000*              	CALL	CUROFF
  10E6'   37                    	STC
  10E7'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


                                ; that does not hold it: the bell, and the cursor back where it started.
  10E8'                         OPPGD:
  10E8'   47                    	MOV	B,A
  10E9'   3A 2921'              	LDA	OPCLSV
  10EC'   FE 02                 	CPI	2
  10EE'   C2 11AA'              	JNZ	OPG_NO
  10F1'   3A 291F'              	LDA	PSAVE
  10F4'   FE 64                 	CPI	'd'
  10F6'   C2 11AA'              	JNZ	OPG_NO
  10F9'   04                    	INR	B
  10FA'   CA 1109'              	JZ	OPG_FW
  10FD'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  1100'   CD 05CB'              	CALL	BOL		;   and the high end is OPSHI as it stands
  1103'   CD 0000*              	CALL	GOTO
  1106'   C3 1121'              	JMP	OPG_GO
  1109'                         OPG_FW:
  1109'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  110C'   CD 05FB'              	CALL	NLSTART		;   landed on, and the low one is where the
  110F'   11 292D'              	LXI	D,OPSHI		;   start line began
  1112'   CD 10BE'              	CALL	OPE_ST
  1115'   21 292A'              	LXI	H,OPSLO
  1118'   CD 03E9'              	CALL	MKLOAD
  111B'   CD 03C2'              	CALL	MKPAGE
  111E'   CD 0000*              	CALL	GOTO
  1121'                         OPG_GO:
  1121'   CD 10C6'              	CALL	CURBD
  1124'   2A 292D'              	LHLD	OPSHI
  1127'   3A 292F'              	LDA	OPSHI+2
  112A'   CD 0E80'              	CALL	SUB24		; A:HL = the bytes to take
  112D'                         OPG_SV:
  112D'   22 2930'              	SHLD	OPTOGO
  1130'   32 2932'              	STA	OPTOGO+2
  1133'                         OPG_NX:
  1133'   CD 064E'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  1136'   CD 0000*              	CALL	SUBHD
  1139'   EB                    	XCHG			; DE = what the window holds past the cursor
  113A'   2A 2930'              	LHLD	OPTOGO
  113D'   3A 2932'              	LDA	OPTOGO+2
  1140'   B7                    	ORA	A
  1141'   C2 1174'              	JNZ	OPG_PG		; 64K or more to go
  1144'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  1147'   DA 1174'              	JC	OPG_PG
  114A'   CA 1174'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  114D'                         OPG_FN:				; the rest of it is here
  114D'   E5                    	PUSH	H
  114E'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1151'   CD 0000*              	CALL	CUROFF
  1154'   22 2933'              	SHLD	OPLO
  1157'   D1                    	POP	D
  1158'   19                    	DAD	D
  1159'   22 2935'              	SHLD	OPHI
  115C'   CD 12D9'              	CALL	OPDSPN
  115F'   CD 0989'              	CALL	ATEOF
  1162'   D2 11C3'              	JNC	OPMID
  1165'   CD 0DCF'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1168'   CA 11C3'              	JZ	OPMID		;   last line, if there is one -- and the pager
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  116B'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  116E'   CD 0000*              	CALL	SETBWD
  1171'   C3 11C3'              	JMP	OPMID
  1174'                         OPG_PG:
  1174'   7A                    	MOV	A,D
  1175'   B3                    	ORA	E
  1176'   C2 118F'              	JNZ	OPG_DL
  1179'   CD 0989'              	CALL	ATEOF		; nothing held past the cursor
  117C'   21 0000               	LXI	H,0
  117F'   DA 114D'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1182'   2B                    	DCX	H
  1183'   CD 0000*              	CALL	SETC0
  1186'   CD 0000*              	CALL	GOLINE
  1189'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  118C'   C3 1133'              	JMP	OPG_NX
  118F'                         OPG_DL:
  118F'   D5                    	PUSH	D
  1190'   21 FFFF               	LXI	H,0FFFFH
  1193'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1196'   E1                    	POP	H
  1197'   E5                    	PUSH	H
  1198'   CD 0000*              	CALL	DELFWD
  119B'   D1                    	POP	D
  119C'   06 00                 	MVI	B,0
  119E'   2A 2930'              	LHLD	OPTOGO
  11A1'   3A 2932'              	LDA	OPTOGO+2
  11A4'   CD 0E80'              	CALL	SUB24
  11A7'   C3 112D'              	JMP	OPG_SV
  11AA'                         OPG_NO:
  11AA'   0E 07                 	MVI	C,BEL
  11AC'   CD 0000*              	CALL	BCONOU
  11AF'                         OPG_HM:				; the cursor back where the command found it
  11AF'   21 2927'              	LXI	H,OPSFP
  11B2'   CD 03E9'              	CALL	MKLOAD
  11B5'   CD 03C2'              	CALL	MKPAGE
  11B8'   CD 0000*              	CALL	GOTO
  11BB'   AF                    	XRA	A
  11BC'   32 291F'              	STA	PSAVE
  11BF'   3C                    	INR	A
  11C0'   32 2982'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  11C3'                         OPMID:
  11C3'   CD 0EAD'              	CALL	ZSAVE
  11C6'   C3 0F90'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  11C9'                         ONWHIT:
  11C9'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11CC'   CA 11E8'              	JZ	OW_YES
  11CF'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  11D2'   FE 20                 	CPI	' '
  11D4'   CA 11E8'              	JZ	OW_YES
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  11D7'   FE 09                 	CPI	TAB
  11D9'   CA 11E8'              	JZ	OW_YES
  11DC'   FE 0D                 	CPI	CR
  11DE'   CA 11E8'              	JZ	OW_YES
  11E1'   FE 0A                 	CPI	LF
  11E3'   CA 11E8'              	JZ	OW_YES
  11E6'   B7                    	ORA	A		; a char to change: CY clear
  11E7'   C9                    	RET
  11E8'                         OW_YES:
  11E8'   37                    	STC
  11E9'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  11EA'                         OPLINE:
  11EA'   3A 291F'              	LDA	PSAVE
  11ED'   FE 63                 	CPI	'c'
  11EF'   CA 06DF'              	JZ	SETMOV
  11F2'   FE 79                 	CPI	'y'
  11F4'   CA 168C'              	JZ	VY_YY
  11F7'   21 2927'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  11FA'   CD 0436'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  11FD'   C3 1605'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  1200'                         OPCLS:
  1200'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  1202'   CA 120F'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  1205'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  1207'   C2 1223'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  120A'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  120C'   C3 1211'              	JMP	OPC_FK
  120F'                         OPC_SEM:
  120F'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1211'                         OPC_FK:
  1211'   3A 2978'              	LDA	FNDKND
  1214'   B7                    	ORA	A
  1215'   37                    	STC
  1216'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  1217'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1218'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  121A'   CA 1221'              	JZ	OPC_EXC
  121D'   3E 01                 	MVI	A,1
  121F'   B7                    	ORA	A		; CY clear: a motion, class 1
  1220'   C9                    	RET
  1221'                         OPC_EXC:
  1221'   AF                    	XRA	A		; class 0, CY clear
  1222'   C9                    	RET
  1223'                         OPC_TB:
  1223'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1224'   21 135D'              	LXI	H,OPCTAB
  1227'                         OPC_LP:
  1227'   7E                    	MOV	A,M
  1228'   B7                    	ORA	A
  1229'   CA 1239'              	JZ	OPC_MS		; end of table -> not a motion
  122C'   B8                    	CMP	B
  122D'   CA 1235'              	JZ	OPC_HT
  1230'   23                    	INX	H
  1231'   23                    	INX	H
  1232'   C3 1227'              	JMP	OPC_LP
  1235'                         OPC_HT:
  1235'   23                    	INX	H
  1236'   7E                    	MOV	A,M		; class byte
  1237'   B7                    	ORA	A		; clear CY
  1238'   C9                    	RET
  1239'                         OPC_MS:
  1239'   37                    	STC
  123A'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  123B'                         OPAPPL:
  123B'   3A 2921'              	LDA	OPCLSV
  123E'   FE 02                 	CPI	2
  1240'   CA 1341'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  1243'   2A 2923'              	LHLD	OPSTA
  1246'   EB                    	XCHG			; DE = start
  1247'   2A 2925'              	LHLD	OPEND2		; HL = end
  124A'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  124D'   DA 125D'              	JC	OPA_F
  1250'   CA 125D'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1253'   22 2933'              	SHLD	OPLO
  1256'   EB                    	XCHG
  1257'   22 2935'              	SHLD	OPHI
  125A'   C3 12B5'              	JMP	OPA_DO
  125D'                         OPA_F:
  125D'   EB                    	XCHG			; HL = start, DE = end
  125E'   22 2933'              	SHLD	OPLO
  1261'   EB                    	XCHG			; HL = end
  1262'   3A 2921'              	LDA	OPCLSV
  1265'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1267'   CA 12B2'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  126A'   FE 01                 	CPI	1
  126C'   C2 128E'              	JNZ	OPA_EX
  126F'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  1270'   3A 2922'              	LDA	CWEOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1273'   B7                    	ORA	A
  1274'   CA 12B2'              	JZ	OPA_HI
  1277'   22 2935'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  127A'   2A 2933'              	LHLD	OPLO
  127D'   CD 13E7'              	CALL	CEND		; HL = the start line's content end
  1280'   EB                    	XCHG			; DE = that content end
  1281'   2A 2935'              	LHLD	OPHI		; HL = hi
  1284'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1287'   D2 12B2'              	JNC	OPA_HI		; hi is inside the line: keep it
  128A'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  128B'   C3 12B2'              	JMP	OPA_HI
  128E'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  128E'   22 2935'              	SHLD	OPHI		; the motion's own end, for now
  1291'   2A 2933'              	LHLD	OPLO
  1294'   CD 13E7'              	CALL	CEND		; HL = the start line's content end
  1297'   EB                    	XCHG			; DE = that content end
  1298'   3A 2900'              	LDA	WPULL		; the motion landed on a line's end and was
  129B'   B7                    	ORA	A		;   pulled back onto its last char (the command
  129C'   C2 12A8'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  129F'   2A 2935'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  12A2'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  12A5'   D2 12B5'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  12A8'                         OPA_CE:				;   deletes the word, not all but its last char
  12A8'   2A 2933'              	LHLD	OPLO
  12AB'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  12AE'   CA 12F3'              	JZ	OPA_LN
  12B1'   EB                    	XCHG			; HL = the content end
  12B2'                         OPA_HI:
  12B2'   22 2935'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  12B5'                         OPA_DO:
  12B5'   CD 12D9'              	CALL	OPDSPN
  12B8'   3A 291F'              	LDA	PSAVE
  12BB'   FE 63                 	CPI	'c'
  12BD'   C8                    	RZ
  12BE'   C3 13F8'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  12C1'                         SPNBRK:
  12C1'   2A 2933'              	LHLD	OPLO
  12C4'   CD 05DE'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  12C7'   EB                    	XCHG			; DE = it
  12C8'   2A 2935'              	LHLD	OPHI
  12CB'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12CE'                         OPSPNL:
  12CE'   2A 2935'              	LHLD	OPHI
  12D1'   EB                    	XCHG
  12D2'   2A 2933'              	LHLD	OPLO
  12D5'   EB                    	XCHG			; HL = hi, DE = lo
  12D6'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  12D9'                         OPDSPN:
  12D9'   CD 12C1'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  12DC'   F5                    	PUSH	PSW
  12DD'   2A 2933'              	LHLD	OPLO
  12E0'   CD 0000*              	CALL	GOTO
  12E3'   CD 12CE'              	CALL	OPSPNL		; HL = hi - lo
  12E6'   CD 0000*              	CALL	DELFWD
  12E9'   CD 0188'              	CALL	MARKMOD
  12EC'   F1                    	POP	PSW
  12ED'   DA 0700'              	JC	SETFUL		; a break went: every row below it moved up
  12F0'   C3 06E5'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  12F3'                         OPA_LN:
  12F3'   3A 291F'              	LDA	PSAVE
  12F6'   FE 63                 	CPI	'c'
  12F8'   C2 1301'              	JNZ	OPA_LD
  12FB'   2A 2933'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  12FE'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1301'                         OPA_LD:
  1301'   2A 2933'              	LHLD	OPLO
  1304'   22 2923'              	SHLD	OPSTA
  1307'   22 2925'              	SHLD	OPEND2
  130A'   C3 1341'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  130D'                         OPALSP:
  130D'   2A 2923'              	LHLD	OPSTA
  1310'   EB                    	XCHG
  1311'   2A 2925'              	LHLD	OPEND2
  1314'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1317'   DA 1324'              	JC	OPAL_F
  131A'   22 2933'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  131D'   EB                    	XCHG
  131E'   22 2935'              	SHLD	OPHI		; hi-src = start
  1321'   C3 132E'              	JMP	OPAL_R
  1324'                         OPAL_F:
  1324'   EB                    	XCHG			; HL = start
  1325'   22 2933'              	SHLD	OPLO		; lo-src = start
  1328'   2A 2925'              	LHLD	OPEND2
  132B'   22 2935'              	SHLD	OPHI		; hi-src = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  132E'                         OPAL_R:
  132E'   2A 2933'              	LHLD	OPLO
  1331'   CD 05CB'              	CALL	BOL
  1334'   22 2933'              	SHLD	OPLO		; lo = BOL(low line)
  1337'   2A 2935'              	LHLD	OPHI
  133A'   CD 05FB'              	CALL	NLSTART
  133D'   22 2935'              	SHLD	OPHI		; hi = start of line past the high line
  1340'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1341'                         OPALIN:
  1341'   CD 130D'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  1344'                         OPDLIN:
  1344'   CD 12D9'              	CALL	OPDSPN
  1347'   CD 064E'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  134A'   DA 135A'              	JC	OPDL_NB
  134D'   CD 0000*              	CALL	LOGLEN
  1350'   7C                    	MOV	A,H
  1351'   B5                    	ORA	L
  1352'   C8                    	RZ			; empty buffer
  1353'   2B                    	DCX	H
  1354'   CD 05CB'              	CALL	BOL
  1357'   CD 0000*              	CALL	GOTO
  135A'                         OPDL_NB:
  135A'   C3 07AD'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  135D'                         OPCTAB:
  135D'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1361'   62 00 42 00           
  1365'   68 00 6C 00           
  1369'   30 00 5E 00           
  136D'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  136F'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1373'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1377'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  137B'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  137F'   24 01                 
  1381'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1385'   47 02 48 02           
  1389'   4D 02 4C 02           
  138D'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  138F'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1391'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1392'                         VCB_C:
  1392'   CD 139E'              	CALL	VCB_CD
  1395'   C3 1469'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1398'                         VCB_D:
  1398'   CD 139E'              	CALL	VCB_CD
  139B'   C3 13F8'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  139E'                         VCB_CD:
  139E'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  13A1'   22 2933'              	SHLD	OPLO
  13A4'   CD 0000*              	CALL	CUROFF
  13A7'   CD 13E7'              	CALL	CEND		; to the line's content end, the CR,LF left
  13AA'   22 2935'              	SHLD	OPHI
  13AD'   C3 12D9'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  13B0'                         VC_X:
  13B0'   CD 0852'              	CALL	GLSTAL
  13B3'   CD 06E5'              	CALL	SETLIN
  13B6'   CD 0672'              	CALL	GETCNT
  13B9'   22 2937'              	SHLD	CNTV
  13BC'   CD 0000*              	CALL	CUROFF
  13BF'   22 293B'              	SHLD	WKI		; cur
  13C2'   CD 13E7'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  13C5'   EB                    	XCHG			; DE = contentend
  13C6'   2A 293B'              	LHLD	WKI		; HL = cur
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13C9'   EB                    	XCHG			; HL = contentend, DE = cur
  13CA'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  13CD'   7C                    	MOV	A,H
  13CE'   B5                    	ORA	L
  13CF'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  13D0'   EB                    	XCHG			; DE = available
  13D1'   2A 2937'              	LHLD	CNTV		; HL = count
  13D4'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  13D7'   DA 13DD'              	JC	VX_USEA
  13DA'   C3 13DE'              	JMP	VX_DEL		; count <= available -> HL = count = del
  13DD'                         VX_USEA:
  13DD'   EB                    	XCHG			; HL = available
  13DE'                         VX_DEL:
  13DE'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  13E1'   CD 0188'              	CALL	MARKMOD
  13E4'   C3 13F8'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  13E7'                         CEND:
  13E7'   CD 05DE'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  13EA'   7C                    	MOV	A,H
  13EB'   B5                    	ORA	L
  13EC'   C8                    	RZ			; the start of the text: nothing before it
  13ED'   2B                    	DCX	H
  13EE'   E5                    	PUSH	H
  13EF'   CD 0000*              	CALL	CHARAT
  13F2'   E1                    	POP	H		; HL = term-1
  13F3'   FE 0D                 	CPI	CR
  13F5'   C8                    	RZ			; a CR before the LF -> the content ends there
  13F6'   23                    	INX	H
  13F7'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  13F8'                         CLAMPE:
  13F8'   CD 0000*              	CALL	CUROFF
  13FB'   E5                    	PUSH	H
  13FC'   CD 060A'              	CALL	EOLC
  13FF'   D1                    	POP	D		; DE = cur
  1400'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  1403'   D8                    	RC
  1404'   C8                    	RZ
  1405'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1408'                         VC_I:
  1408'   CD 0672'              	CALL	GETCNT
  140B'   C3 1466'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  140E'                         VC_A:
  140E'   CD 0672'              	CALL	GETCNT
  1411'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1414'   CA 142B'              	JZ	VA_INS
  1417'   EB                    	XCHG			; HL = cur
  1418'   E5                    	PUSH	H
  1419'   CD 0000*              	CALL	CHARAT
  141C'   E1                    	POP	H
  141D'   FE 0A                 	CPI	LF
  141F'   CA 142B'              	JZ	VA_INS		; on the line terminator -> append in place
  1422'   FE 0D                 	CPI	CR
  1424'   CA 142B'              	JZ	VA_INS
  1427'   23                    	INX	H
  1428'   CD 0000*              	CALL	GOTO
  142B'                         VA_INS:
  142B'   C3 1466'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  142E'                         VCB_A:
  142E'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1431'   CD 060A'              	CALL	EOLC		; HL = last content char (the start when empty)
  1434'   E5                    	PUSH	H
  1435'   CD 0000*              	CALL	CHARAT
  1438'   E1                    	POP	H
  1439'   FE 0D                 	CPI	CR
  143B'   CA 1444'              	JZ	VBA_IN		; an empty line: insert at its start
  143E'   FE 0A                 	CPI	LF
  1440'   CA 1444'              	JZ	VBA_IN
  1443'   23                    	INX	H		; past the last content char
  1444'                         VBA_IN:
  1444'   CD 0000*              	CALL	GOTO
  1447'   C3 1466'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  144A'                         VCB_I:
  144A'   CD 0672'              	CALL	GETCNT
  144D'   CD 07AD'              	CALL	FNBLNK
  1450'   CD 0000*              	CALL	CUROFF
  1453'   E5                    	PUSH	H
  1454'   CD 0000*              	CALL	CHARAT
  1457'   E1                    	POP	H
  1458'   FE 20                 	CPI	' '
  145A'   CA 1462'              	JZ	VBI_SK
  145D'   FE 09                 	CPI	TAB
  145F'   C2 1466'              	JNZ	SETINM
  1462'                         VBI_SK:
  1462'   23                    	INX	H		; blanks only: past the last of them
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1463'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1466'                         SETINM:
  1466'   CD 06DF'              	CALL	SETMOV
  1469'                         SETINS:
  1469'   3E 01                 	MVI	A,EM_INS
  146B'   32 28F4'              	STA	EDMODE
  146E'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  146F'                         ATCEND:
  146F'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1472'   C8                    	RZ
  1473'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  1476'   FE 0D                 	CPI	CR
  1478'   C8                    	RZ
  1479'   FE 0A                 	CPI	LF
  147B'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  147C'                         OPNBRK:
  147C'   CD 1D6E'              	CALL	PUTBRK
  147F'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1482'   23                    	INX	H
  1483'   22 0000*              	SHLD	LNDLT
  1486'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1489'                         ENDBRK:
  1489'   CD 064E'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  148C'   C0                    	RNZ
  148D'   CD 147C'              	CALL	OPNBRK
  1490'   CD 0000*              	CALL	CUROFF
  1493'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1494'   2B                    	DCX	H		;   line, with its own terminator after it
  1495'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1498'                         VC_O:
  1498'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  149B'   CD 13E7'              	CALL	CEND
  149E'   CD 0000*              	CALL	GOTO
  14A1'   CD 147C'              	CALL	OPNBRK
  14A4'   CD 1489'              	CALL	ENDBRK		; a last line with no line end: the opened line
  14A7'   CD 06EB'              	CALL	SETILN		;   needs a terminator of its own to exist
  14AA'   C3 1469'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  14AD'                         VCB_O:
  14AD'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14B0'   CD 05CB'              	CALL	BOL
  14B3'   CD 0000*              	CALL	GOTO
  14B6'   CD 147C'              	CALL	OPNBRK
  14B9'   CD 0000*              	CALL	CUROFF
  14BC'   2B                    	DCX	H
  14BD'   2B                    	DCX	H
  14BE'   CD 0000*              	CALL	GOTO
  14C1'   CD 06EB'              	CALL	SETILN
  14C4'   C3 1469'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  14C7'                         VCB_J:
  14C7'   CD 0665'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14CA'   CD 13E7'              	CALL	CEND		; the join point: this line's content end
  14CD'   22 2933'              	SHLD	OPLO
  14D0'   CD 0000*              	CALL	CUROFF
  14D3'   CD 05FB'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  14D6'   E5                    	PUSH	H
  14D7'   CD 0000*              	CALL	LOGLEN
  14DA'   D1                    	POP	D		; DE = that start
  14DB'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  14DE'   CA 06DF'              	JZ	SETMOV
  14E1'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  14E2'                         VJ_WS:
  14E2'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14E3'   CD 0000*              	CALL	LOGLEN
  14E6'   D1                    	POP	D		; DE = the scan
  14E7'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  14EA'   CA 1501'              	JZ	VJ_DEL
  14ED'   EB                    	XCHG			; HL = the scan
  14EE'   E5                    	PUSH	H
  14EF'   CD 0000*              	CALL	CHARAT
  14F2'   E1                    	POP	H
  14F3'   FE 20                 	CPI	' '
  14F5'   CA 14FD'              	JZ	VJ_SKIP
  14F8'   FE 09                 	CPI	TAB
  14FA'   C2 1501'              	JNZ	VJ_DEL
  14FD'                         VJ_SKIP:
  14FD'   23                    	INX	H
  14FE'   C3 14E2'              	JMP	VJ_WS
  1501'                         VJ_DEL:
  1501'   22 2935'              	SHLD	OPHI
  1504'   CD 12D9'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1507'   CD 06FA'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  150A'   CD 064E'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  150D'   CA 13F8'              	JZ	CLAMPE
  1510'   CD 0659'              	CALL	CURCHR		; the first char of what was appended
  1513'   FE 0D                 	CPI	CR
  1515'   CA 13F8'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1518'   FE 0A                 	CPI	LF
  151A'   CA 13F8'              	JZ	CLAMPE
  151D'   FE 29                 	CPI	')'
  151F'   CA 13F8'              	JZ	CLAMPE		; vim puts no space before a ')'
  1522'   CD 0000*              	CALL	CUROFF
  1525'   7C                    	MOV	A,H
  1526'   B5                    	ORA	L
  1527'   CA 153D'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  152A'   2B                    	DCX	H
  152B'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  152E'   FE 20                 	CPI	' '
  1530'   CA 13F8'              	JZ	CLAMPE
  1533'   FE 09                 	CPI	TAB
  1535'   CA 13F8'              	JZ	CLAMPE
  1538'   FE 0A                 	CPI	LF
  153A'   CA 13F8'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  153D'                         VJ_SP:
  153D'   3E 20                 	MVI	A,' '
  153F'   CD 0000*              	CALL	PUTGAP
  1542'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1545'   2B                    	DCX	H
  1546'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1549'                         VC_TILD:
  1549'   CD 0672'              	CALL	GETCNT
  154C'   CD 06E5'              	CALL	SETLIN		; only this row changes
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  154F'   CD 0852'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1552'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1555'   CA 06DF'              	JZ	SETMOV
  1558'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  155B'   FE 0D                 	CPI	CR
  155D'   CA 06DF'              	JZ	SETMOV		; the line's end: nothing to toggle
  1560'   FE 0A                 	CPI	LF
  1562'   CA 06DF'              	JZ	SETMOV
  1565'   47                    	MOV	B,A
  1566'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1568'   FE 41                 	CPI	'A'
  156A'   DA 1576'              	JC	VT_PUT		; below 'A': no case
  156D'   FE 5B                 	CPI	'Z'+1
  156F'   D2 1576'              	JNC	VT_PUT		; above 'Z': no case
  1572'   78                    	MOV	A,B
  1573'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1575'   47                    	MOV	B,A
  1576'                         VT_PUT:
  1576'   78                    	MOV	A,B
  1577'   32 2944'              	STA	VRCH		; the calls below do not preserve B
  157A'   CD 0188'              	CALL	MARKMOD
  157D'   21 0001               	LXI	H,1
  1580'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1583'   3A 2944'              	LDA	VRCH
  1586'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1589'   C3 13F8'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  158C'                         VC_R:
  158C'   CD 065F'              	CALL	MOVCNT		; a cursor motion, and its count
  158F'   3E 03                 	MVI	A,PR
  1591'   32 291C'              	STA	GPEND
  1594'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1595'                         VR_DO:
  1595'   AF                    	XRA	A
  1596'   32 291C'              	STA	GPEND
  1599'   79                    	MOV	A,C
  159A'   32 2944'              	STA	VRCH		; the calls below do not preserve C
  159D'   CD 06E5'              	CALL	SETLIN		; only this row changed
  15A0'   CD 0852'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  15A3'   CD 064E'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  15A6'   CA 06DF'              	JZ	SETMOV		; the end of the text: vim does nothing
  15A9'   CD 0659'              	CALL	CURCHR		; A = the char under the cursor
  15AC'   FE 0D                 	CPI	CR
  15AE'   CA 06DF'              	JZ	SETMOV		; the line's end: nothing to replace
  15B1'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  15B3'   CA 06DF'              	JZ	SETMOV
  15B6'   CD 0188'              	CALL	MARKMOD
  15B9'   21 0001               	LXI	H,1
  15BC'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  15BF'   3A 2944'              	LDA	VRCH
  15C2'   FE 0D                 	CPI	CR
  15C4'   CA 15D1'              	JZ	VR_CR
  15C7'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  15CA'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  15CD'   2B                    	DCX	H		;   out, which moves every logical offset
  15CE'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  15D1'                         VR_CR:
  15D1'   CD 147C'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  15D4'   CD 1489'              	CALL	ENDBRK		;   replaced char may have been the text's last
  15D7'   CD 06EB'              	CALL	SETILN		;   row above it lost the char that was replaced,
  15DA'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  15DC'   32 28FC'              	STA	ILABOV
  15DF'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  15E0'                         VCB_R:
  15E0'   CD 0672'              	CALL	GETCNT
  15E3'   CD 06DF'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  15E6'   21 0000               	LXI	H,0
  15E9'   22 2945'              	SHLD	RPDEL		; nothing of ours to put back yet
  15EC'   22 2947'              	SHLD	RPAPP
  15EF'   3E 02                 	MVI	A,EM_REP
  15F1'   32 28F4'              	STA	EDMODE
  15F4'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  15F5'                         VC_D:
  15F5'   3E 64                 	MVI	A,'d'
  15F7'   32 291E'              	STA	PENDOP
  15FA'   C3 06DF'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  15FD'                         VC_C:
  15FD'   3E 63                 	MVI	A,'c'
  15FF'   32 291E'              	STA	PENDOP
  1602'   C3 06DF'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1605'                         VD_DD:
  1605'   CD 0852'              	CALL	GLSTAL
  1608'   CD 0672'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  160B'   22 2937'              	SHLD	CNTV
  160E'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1610'   32 2920'              	STA	DDSNG
  1613'   2B                    	DCX	H
  1614'   7C                    	MOV	A,H
  1615'   B5                    	ORA	L
  1616'   C2 1621'              	JNZ	VDD_LS
  1619'   3E 01                 	MVI	A,1
  161B'   32 2920'              	STA	DDSNG
  161E'   C3 1627'              	JMP	VDD_GO
  1621'                         VDD_LS:
  1621'   CD 0818'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1624'   DA 06DF'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1627'                         VDD_GO:
  1627'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  162A'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  162D'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1630'   CD 1FD1'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1633'   CD 0796'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1636'   2A 2937'              	LHLD	CNTV
  1639'   CD 0000*              	CALL	SETC0
  163C'                         VDD_FW:
  163C'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  163F'   DA 178D'              	JC	QREFUS		; ... which has no room for them
  1642'   CD 0687'              	CALL	CNTTST
  1645'   C2 163C'              	JNZ	VDD_FW
  1648'   CD 0188'              	CALL	MARKMOD
  164B'   CD 0989'              	CALL	ATEOF
  164E'   D2 1669'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1651'   3E 00                 	MVI	A,0
  1653'   32 2920'              	STA	DDSNG		; deleted to the end: full repaint
  1656'   CD 0DCF'              	CALL	ONFST
  1659'   CA 07AD'              	JZ	FNBLNK		; nothing left before it
  165C'   21 0001               	LXI	H,1		; onto the new last line
  165F'   CD 0000*              	CALL	SETBWD
  1662'   2A 0000*              	LHLD	LNDLT
  1665'   2B                    	DCX	H
  1666'   22 0000*              	SHLD	LNDLT
  1669'                         VDD_UP:
  1669'   CD 07AD'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  166C'   3A 2920'              	LDA	DDSNG
  166F'   B7                    	ORA	A
  1670'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1671'   3E 03                 	MVI	A,R_DLIN
  1673'   32 28F9'              	STA	RINTENT
  1676'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1677'                         QEMPTY:
  1677'   2A 0000*              	LHLD	QBEG
  167A'   EB                    	XCHG
  167B'   2A 0000*              	LHLD	QEND
  167E'   7C                    	MOV	A,H
  167F'   BA                    	CMP	D
  1680'   C0                    	RNZ
  1681'   7D                    	MOV	A,L
  1682'   BB                    	CMP	E
  1683'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1684'                         VC_Y:
  1684'   3E 79                 	MVI	A,'y'
  1686'   32 291E'              	STA	PENDOP
  1689'   C3 06DF'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  168C'                         VY_YY:
  168C'   21 2927'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  168F'   CD 0436'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1692'   CD 0000*              	CALL	CUROFF
  1695'   22 2968'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1698'   CD 05CB'              	CALL	BOL
  169B'   22 296A'              	SHLD	YPT		; where the lines come from, to put them back
  169E'   CD 17F3'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16A1'   CD 1836'              	CALL	YNCOPY		; copied where they lie, if that can be done
  16A4'   D2 17FA'              	JNC	YNDONE
  16A7'   21 1605'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  16AA'   C3 16D6'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  16AD'                         OPYANK:
  16AD'   CD 130D'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  16B0'   2A 2923'              	LHLD	OPSTA
  16B3'   EB                    	XCHG			; DE = start
  16B4'   2A 2925'              	LHLD	OPEND2		; HL = end
  16B7'   CD 0000*              	CALL	CMP16		; CY iff start < end
  16BA'   D2 16BE'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  16BD'   EB                    	XCHG			; ... otherwise the start is
  16BE'                         OPY_LO:
  16BE'   22 2968'              	SHLD	YOFF
  16C1'   2A 2933'              	LHLD	OPLO
  16C4'   22 296A'              	SHLD	YPT		; where the lines come from, to put them back
  16C7'   CD 17F3'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  16CA'   CD 18AE'              	CALL	YNSPAN		; copied where they lie, if there is room
  16CD'   D2 17FA'              	JNC	YNDONE
  16D0'   21 17B4'              	LXI	H,YSPAN
  16D3'   C3 16D6'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  16D6'                         YKGO:
  16D6'   22 2991'              	SHLD	YACT
  16D9'   2A 296A'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  16DC'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  16DD'   2A 2968'              	LHLD	YOFF		;   survive this -- the put-back below can page
  16E0'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  16E3'   22 2997'              	SHLD	YCOL		;   them -- but a distance within the lines does
  16E6'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  16E9'   E5                    	PUSH	H		;   pages the window on when the count's lines
  16EA'   2A 296A'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  16ED'   EB                    	XCHG			;   window as it was, then names other text
  16EE'   E1                    	POP	H
  16EF'   CD 0000*              	CALL	SUBHD
  16F2'   EB                    	XCHG			; DE = how far behind the cursor they start
  16F3'   CD 0E8A'              	CALL	CURFP
  16F6'   06 00                 	MVI	B,0
  16F8'   CD 0E80'              	CALL	SUB24
  16FB'   22 2999'              	SHLD	YPFP
  16FE'   32 299B'              	STA	YPFP+2
  1701'   3A 28F8'              	LDA	MODF
  1704'   32 2965'              	STA	YMODF
  1707'   3A 2911'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  170A'   32 2966'              	STA	YDCHG		;   a yank must not become the last change
  170D'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1710'   32 2967'              	STA	YURPL		;   back are not a change to undo either
  1713'   3E 01                 	MVI	A,1
  1715'   32 0000*              	STA	UNDRPL
  1718'   32 2990'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  171B'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  171E'   22 2973'              	SHLD	YLDLT
  1721'   CD 0000*              	CALL	LOGLEN
  1724'   22 2995'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1727'   2A 2991'              	LHLD	YACT
  172A'   CD 178C'              	CALL	YCALL		; the lines out of the file, into the register
  172D'   3A 2960'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1730'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1732'   CA 1770'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1735'   CD 0000*              	CALL	LOGLEN
  1738'   EB                    	XCHG
  1739'   2A 2995'              	LHLD	YWAS
  173C'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  173F'   CA 1751'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1742'   21 2999'              	LXI	H,YPFP		; back to where they came from, by its place in
  1745'   CD 03E9'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1748'   CD 03C2'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  174B'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  174E'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1751'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1751'   2A 2999'              	LHLD	YPFP		;   cursor is still owed its place)
  1754'   EB                    	XCHG
  1755'   2A 2997'              	LHLD	YCOL
  1758'   19                    	DAD	D
  1759'   22 298C'              	SHLD	MKPOS
  175C'   3A 299B'              	LDA	YPFP+2
  175F'   CE 00                 	ACI	0
  1761'   32 298E'              	STA	MKPOS+2
  1764'   CD 03C2'              	CALL	MKPAGE
  1767'   CD 0000*              	CALL	GOTO
  176A'                         YK_RST:
  176A'   2A 2973'              	LHLD	YLDLT
  176D'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1770'                         YK_RF:
  1770'   3A 2965'              	LDA	YMODF
  1773'   32 28F8'              	STA	MODF
  1776'   3A 2966'              	LDA	YDCHG
  1779'   32 2911'              	STA	DOTCHG
  177C'   3A 2967'              	LDA	YURPL
  177F'   32 0000*              	STA	UNDRPL
  1782'   AF                    	XRA	A
  1783'   32 2990'              	STA	MKHOLD
  1786'   CD 0852'              	CALL	GLSTAL
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  1789'   C3 0700'              	JMP	SETFUL		; the cheap paint cannot carry this
  178C'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  178D'                         QREFUS:
  178D'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1790'   CD 1677'              	CALL	QEMPTY
  1793'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1796'   CD 0000*              	CALL	QKILL
  1799'   3A 2990'              	LDA	MKHOLD
  179C'   B7                    	ORA	A
  179D'   C2 17AC'              	JNZ	QRF_Y
  17A0'   21 0000*              	LXI	H,MKSAV
  17A3'   11 0000*              	LXI	D,MKTAB
  17A6'   CD 1FD1'              	CALL	COPY12
  17A9'   CD 0000*              	CALL	UNDCLR
  17AC'                         QRF_Y:
  17AC'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  17AE'   32 2960'              	STA	MSGWHT
  17B1'   C3 11AF'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  17B4'                         YSPAN:
  17B4'   CD 0852'              	CALL	GLSTAL
  17B7'   CD 12CE'              	CALL	OPSPNL		; HL = the span's length
  17BA'   22 2993'              	SHLD	YTGT
  17BD'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  17C0'   EB                    	XCHG			; DE = it
  17C1'   2A 2993'              	LHLD	YTGT
  17C4'   EB                    	XCHG			; HL = the text's, DE = the span's
  17C5'   CD 0000*              	CALL	SUBHD
  17C8'   22 2993'              	SHLD	YTGT		; what the text is left at when the span is out
  17CB'   2A 2933'              	LHLD	OPLO
  17CE'   CD 0000*              	CALL	GOTO
  17D1'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  17D4'                         YS_LP:
  17D4'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  17D7'   CD 0000*              	CALL	SETC0
  17DA'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  17DD'   DA 178D'              	JC	QREFUS		; ... which has no room for it
  17E0'   CD 0000*              	CALL	LOGLEN
  17E3'   EB                    	XCHG			; DE = what is left
  17E4'   2A 2993'              	LHLD	YTGT
  17E7'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  17EA'   DA 17F0'              	JC	YS_END		; below it -- cannot happen over whole lines,
  17ED'   C2 17D4'              	JNZ	YS_LP		;   but never spin here if it ever did
  17F0'                         YS_END:
  17F0'   C3 0188'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  17F3'                         YNPRE:
  17F3'   2A 0000*              	LHLD	PGTOPM
  17F6'   22 299C'              	SHLD	YNPG
  17F9'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  17FA'                         YNDONE:
  17FA'   2A 2968'              	LHLD	YOFF
  17FD'   CD 0000*              	CALL	GOTO
  1800'   2A 0000*              	LHLD	PGTOPM
  1803'   EB                    	XCHG
  1804'   2A 299C'              	LHLD	YNPG
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1807'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  180A'   C2 0700'              	JNZ	SETFUL		; it moved under us: repaint after all
  180D'   C3 06DF'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1810'                         YNROOM:
  1810'   11 0100               	LXI	D,100H
  1813'   19                    	DAD	D
  1814'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1815'   E5                    	PUSH	H		; the span plus its slack
  1816'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1819'   EB                    	XCHG			; HL = free
  181A'   D1                    	POP	D		; DE = the span plus its slack
  181B'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  181E'   DA 1826'              	JC	YNR_OK
  1821'   CA 1826'              	JZ	YNR_OK
  1824'   37                    	STC			; not enough: the delete-and-put-back path
  1825'   C9                    	RET
  1826'                         YNR_OK:
  1826'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1827'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1828'                         YNGO:
  1828'   C5                    	PUSH	B
  1829'   CD 0672'              	CALL	GETCNT		; spent here: this yank is happening
  182C'   CD 0852'              	CALL	GLSTAL
  182F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1832'   C1                    	POP	B
  1833'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1836'                         YNCOPY:
  1836'   2A 28F5'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1839'   7C                    	MOV	A,H		;   the count itself
  183A'   B5                    	ORA	L
  183B'   C2 1841'              	JNZ	YNC_HV
  183E'   21 0001               	LXI	H,1
  1841'                         YNC_HV:
  1841'   7D                    	MOV	A,L		; a count of one always has its own line to take;
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1842'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1843'   B4                    	ORA	H
  1844'   CA 184F'              	JZ	YNC_M
  1847'   E5                    	PUSH	H
  1848'   CD 0818'              	CALL	ONLAST		; vim: a count over one on the last line does
  184B'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  184C'   DA 1861'              	JC	YNC_RF
  184F'                         YNC_M:
  184F'   E5                    	PUSH	H
  1850'   CD 0796'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1853'   E1                    	POP	H
  1854'   CD 1869'              	CALL	YNLINE		; BC = the span, measured where it stands
  1857'   D8                    	RC			; not measurable here: let the pager answer it
  1858'   60                    	MOV	H,B
  1859'   69                    	MOV	L,C
  185A'   CD 1810'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  185D'   D8                    	RC			; no: the delete-and-put-back path
  185E'   C3 1828'              	JMP	YNGO
  1861'                         YNC_RF:
  1861'   CD 0672'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1864'   CD 0852'              	CALL	GLSTAL		;   register alone, and that is the command
  1867'   B7                    	ORA	A		; NC: done
  1868'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1869'                         YNLINE:
  1869'   22 299E'              	SHLD	YNCNT		; the lines it still wants
  186C'   2A 0000*              	LHLD	GAPEND
  186F'                         YNL_LP:
  186F'   EB                    	XCHG			; DE = the scan
  1870'   2A 0000*              	LHLD	TXTEND
  1873'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1876'   EB                    	XCHG			; HL = the scan
  1877'   D2 1897'              	JNC	YNL_EN		; the resident text ran out
  187A'   7E                    	MOV	A,M
  187B'   23                    	INX	H
  187C'   FE 0A                 	CPI	LF
  187E'   C2 186F'              	JNZ	YNL_LP
  1881'   E5                    	PUSH	H
  1882'   2A 299E'              	LHLD	YNCNT
  1885'   2B                    	DCX	H
  1886'   22 299E'              	SHLD	YNCNT
  1889'   7C                    	MOV	A,H
  188A'   B5                    	ORA	L
  188B'   E1                    	POP	H
  188C'   C2 186F'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  188F'   EB                    	XCHG			; DE = past the last of them
  1890'   2A 0000*              	LHLD	GAPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1893'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1894'   C3 18A5'              	JMP	YNL_BC
  1897'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1897'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  189A'   C2 18AC'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  189D'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  18A0'   EB                    	XCHG			;   count clamps to it as vim's does
  18A1'   2A 0000*              	LHLD	GAPEND
  18A4'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  18A5'                         YNL_BC:
  18A5'   CD 0000*              	CALL	SUBHD		; HL = the span
  18A8'   44                    	MOV	B,H
  18A9'   4D                    	MOV	C,L
  18AA'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  18AB'   C9                    	RET
  18AC'                         YNL_NO:
  18AC'   37                    	STC
  18AD'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  18AE'                         YNSPAN:
  18AE'   CD 12CE'              	CALL	OPSPNL		; HL = the span's length
  18B1'   44                    	MOV	B,H
  18B2'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  18B3'   CD 1810'              	CALL	YNROOM
  18B6'   D8                    	RC			; no room: the delete-and-put-back path
  18B7'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  18B8'   2A 2933'              	LHLD	OPLO
  18BB'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  18BE'   C1                    	POP	B
  18BF'   C3 1828'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  18C2'                         VC_P:
  18C2'   CD 1677'              	CALL	QEMPTY
  18C5'   CA 197D'              	JZ	VP_BEL
  18C8'   CD 0672'              	CALL	GETCNT
  18CB'   22 296C'              	SHLD	PCNT
  18CE'   CD 0000*              	CALL	CUROFF
  18D1'   CD 05FB'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  18D4'   C3 18E9'              	JMP	VP_GO
  18D7'                         VCB_P:
  18D7'   CD 1677'              	CALL	QEMPTY
  18DA'   CA 197D'              	JZ	VP_BEL
  18DD'   CD 0672'              	CALL	GETCNT
  18E0'   22 296C'              	SHLD	PCNT
  18E3'   CD 0000*              	CALL	CUROFF
  18E6'   CD 05CB'              	CALL	BOL
  18E9'                         VP_GO:
  18E9'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                	;    still makes a new line, so the missing break goes in first ---
  18EC'   CD 0000*              	CALL	CUROFF
  18EF'   EB                    	XCHG
  18F0'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  18F3'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  18F6'   DA 190B'              	JC	VP_IN
  18F9'   EB                    	XCHG			; HL = the put point = LOGLEN
  18FA'   7C                    	MOV	A,H
  18FB'   B5                    	ORA	L
  18FC'   CA 1908'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  18FF'   2B                    	DCX	H
  1900'   CD 0000*              	CALL	CHARAT
  1903'   FE 0A                 	CPI	LF
  1905'   CA 190B'              	JZ	VP_IN
  1908'                         VP_BRK:
  1908'   CD 147C'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  190B'                         VP_IN:
  190B'   CD 0000*              	CALL	CUROFF
  190E'   22 296E'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1911'   2A 0000*              	LHLD	QBEG
  1914'   EB                    	XCHG
  1915'   2A 0000*              	LHLD	QEND
  1918'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  191B'   EB                    	XCHG
  191C'   22 2970'              	SHLD	PLFS
  191F'   2A 296C'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1922'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1923'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1924'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1926'   C2 192A'              	JNZ	VP_PZ
  1929'   7D                    	MOV	A,L
  192A'                         VP_PZ:
  192A'   32 2972'              	STA	PCPY
  192D'                         VP_LP:
  192D'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1930'   2A 0000*              	LHLD	LNDLT
  1933'   EB                    	XCHG
  1934'   2A 2970'              	LHLD	PLFS
  1937'   19                    	DAD	D
  1938'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  193B'   2A 296C'              	LHLD	PCNT
  193E'   2B                    	DCX	H
  193F'   22 296C'              	SHLD	PCNT
  1942'   7C                    	MOV	A,H
  1943'   B5                    	ORA	L
  1944'   C2 192D'              	JNZ	VP_LP
  1947'   CD 0188'              	CALL	MARKMOD
  194A'   2A 296E'              	LHLD	PPT
  194D'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  1950'   CD 0852'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1953'   3A 2972'              	LDA	PCPY
  1956'   B7                    	ORA	A
  1957'   CA 07AD'              	JZ	FNBLNK
  195A'   2A 2970'              	LHLD	PLFS
  195D'   7C                    	MOV	A,H
  195E'   B7                    	ORA	A
  195F'   C2 07AD'              	JNZ	FNBLNK
  1962'   3A 2972'              	LDA	PCPY
  1965'   CD 0D65'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1968'   7C                    	MOV	A,H
  1969'   B7                    	ORA	A
  196A'   C2 07AD'              	JNZ	FNBLNK
  196D'   7D                    	MOV	A,L
  196E'   B7                    	ORA	A
  196F'   CA 07AD'              	JZ	FNBLNK
  1972'   F5                    	PUSH	PSW
  1973'   CD 06EB'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1976'   F1                    	POP	PSW
  1977'   32 28FA'              	STA	ILN		; ... which the lines put now replace
  197A'   C3 07AD'              	JMP	FNBLNK
  197D'                         VP_BEL:
  197D'   CD 0672'              	CALL	GETCNT		; the count is spent either way
  1980'   0E 07                 	MVI	C,BEL
  1982'   CD 0000*              	CALL	BCONOU
  1985'   C3 06DF'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1988'                         VIREP:
  1988'   78                    	MOV	A,B
  1989'   FE 01                 	CPI	KT_ACT
  198B'   CA 1AB8'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  198E'   FE 02                 	CPI	KT_CHAR
  1990'   C0                    	RNZ			; ignore anything else
  1991'   79                    	MOV	A,C
  1992'   FE 0D                 	CPI	CR
  1994'   CA 19F8'              	JZ	VP_CR
  1997'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1999'   CA 19F8'              	JZ	VP_CR
  199C'   FE 08                 	CPI	BS
  199E'   CA 1A04'              	JZ	VP_BS
  19A1'   FE 7F                 	CPI	DEL
  19A3'   CA 1A04'              	JZ	VP_BS
  19A6'   32 2944'              	STA	VRCH		; the calls below do not preserve C
  19A9'   CD 06E5'              	CALL	SETLIN		; this row changed
  19AC'   CD 0188'              	CALL	MARKMOD
  19AF'   CD 146F'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  19B2'   CA 19EA'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  19B5'   3A 2944'              	LDA	VRCH
  19B8'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  19BB'   2A 2945'              	LHLD	RPDEL
  19BE'   7C                    	MOV	A,H
  19BF'   B5                    	ORA	L
  19C0'   CA 19D6'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  19C3'   2A 0000*              	LHLD	GAPEND
  19C6'   EB                    	XCHG
  19C7'   2A 2949'              	LHLD	RPGE
  19CA'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  19CD'   CA 19D6'              	JZ	VP_OVW
  19D0'   21 0000               	LXI	H,0
  19D3'   22 2945'              	SHLD	RPDEL		; the text moved: those originals are gone
  19D6'                         VP_OVW:
  19D6'   21 0001               	LXI	H,1
  19D9'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  19DC'   2A 0000*              	LHLD	GAPEND
  19DF'   22 2949'              	SHLD	RPGE
  19E2'   2A 2945'              	LHLD	RPDEL
  19E5'   23                    	INX	H
  19E6'   22 2945'              	SHLD	RPDEL
  19E9'   C9                    	RET
  19EA'                         VP_APP:
  19EA'   3A 2944'              	LDA	VRCH
  19ED'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  19F0'   2A 2947'              	LHLD	RPAPP
  19F3'   23                    	INX	H
  19F4'   22 2947'              	SHLD	RPAPP
  19F7'   C9                    	RET
  19F8'                         VP_CR:
  19F8'   21 0000               	LXI	H,0
  19FB'   22 2945'              	SHLD	RPDEL		; a line break ends what BS can put back
  19FE'   22 2947'              	SHLD	RPAPP
  1A01'   C3 1A8E'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1A04'                         VP_BS:
  1A04'   2A 2947'              	LHLD	RPAPP
  1A07'   7C                    	MOV	A,H
  1A08'   B5                    	ORA	L
  1A09'   CA 1A16'              	JZ	VP_BSD
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A0C'   2B                    	DCX	H
  1A0D'   22 2947'              	SHLD	RPAPP		; an appended char: it just goes
  1A10'   CD 06E5'              	CALL	SETLIN
  1A13'   C3 0000*              	JMP	DELPRV
  1A16'                         VP_BSD:
  1A16'   2A 2945'              	LHLD	RPDEL
  1A19'   7C                    	MOV	A,H
  1A1A'   B5                    	ORA	L
  1A1B'   CA 1A42'              	JZ	VP_BSM		; nothing of ours left
  1A1E'   2A 0000*              	LHLD	GAPEND
  1A21'   EB                    	XCHG
  1A22'   2A 2949'              	LHLD	RPGE
  1A25'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1A28'   C2 1A42'              	JNZ	VP_BSM
  1A2B'   2A 2945'              	LHLD	RPDEL
  1A2E'   2B                    	DCX	H
  1A2F'   22 2945'              	SHLD	RPDEL
  1A32'   CD 06E5'              	CALL	SETLIN
  1A35'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1A38'   CD 0000*              	CALL	UNDELF		; the original comes back
  1A3B'   2A 0000*              	LHLD	GAPEND
  1A3E'   22 2949'              	SHLD	RPGE
  1A41'   C9                    	RET
  1A42'                         VP_BSM:
  1A42'   CD 06DF'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1A45'   C3 074E'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1A48'                         VIINS:
  1A48'   78                    	MOV	A,B
  1A49'   FE 01                 	CPI	KT_ACT
  1A4B'   CA 1AB8'              	JZ	VI_ACT
  1A4E'   FE 02                 	CPI	KT_CHAR
  1A50'   C0                    	RNZ			; ignore anything else
  1A51'   79                    	MOV	A,C
  1A52'   FE 0D                 	CPI	CR
  1A54'   CA 1A8E'              	JZ	VI_CR
  1A57'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1A59'   CA 1A8E'              	JZ	VI_CR
  1A5C'   FE 08                 	CPI	BS
  1A5E'   CA 1AA6'              	JZ	VI_BS
  1A61'   FE 7F                 	CPI	DEL
  1A63'   CA 1AA6'              	JZ	VI_BS
  1A66'   79                    	MOV	A,C
  1A67'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1A6A'   CD 0188'              	CALL	MARKMOD
  1A6D'   CD 06E5'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1A70'   79                    	MOV	A,C
  1A71'   FE 20                 	CPI	' '
  1A73'   D8                    	RC			; control char -> keep R_LINE
  1A74'   FE 7F                 	CPI	DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A76'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1A77'   CD 0706'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1A7A'   B7                    	ORA	A
  1A7B'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1A7C'   3E 04                 	MVI	A,R_ICH
  1A7E'   32 28F9'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1A81'   CD 146F'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1A84'   3E 00                 	MVI	A,0
  1A86'   C2 1A8A'              	JNZ	VI_ICH
  1A89'   3C                    	INR	A
  1A8A'                         VI_ICH:
  1A8A'   32 28FB'              	STA	ICHAPP
  1A8D'   C9                    	RET
  1A8E'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1A8E'   CD 146F'              	CALL	ATCEND
  1A91'   3E 00                 	MVI	A,0
  1A93'   CA 1A97'              	JZ	VI_CRS
  1A96'   3C                    	INR	A
  1A97'                         VI_CRS:
  1A97'   F5                    	PUSH	PSW
  1A98'   CD 147C'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1A9B'   CD 1489'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1A9E'   CD 06EB'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1AA1'   F1                    	POP	PSW
  1AA2'   32 28FC'              	STA	ILABOV
  1AA5'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1AA6'                         VI_BS:
  1AA6'   CD 0000*              	CALL	PEEKL
  1AA9'   D8                    	RC			; start of the file: nothing to delete
  1AAA'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1AAC'   CA 1AB2'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1AAF'   CD 06E5'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1AB2'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1AB2'   CD 0188'              	CALL	MARKMOD
  1AB5'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1AB8'                         VI_ACT:
  1AB8'   79                    	MOV	A,C
  1AB9'   FE 0B                 	CPI	ACT_ESC
  1ABB'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1ABC'   3E 00                 	MVI	A,EM_CMD
  1ABE'   32 28F4'              	STA	EDMODE
  1AC1'   CD 06DF'              	CALL	SETMOV
  1AC4'   CD 074E'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1AC7'   C3 0852'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1ACA'                         RDLINE:
  1ACA'   EB                    	XCHG			; HL = buffer
  1ACB'   22 294B'              	SHLD	RLPTR
  1ACE'   3E 00                 	MVI	A,0
  1AD0'   32 294D'              	STA	RLLEN
  1AD3'   78                    	MOV	A,B
  1AD4'   32 294E'              	STA	RLMAX
  1AD7'   79                    	MOV	A,C
  1AD8'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1ADB'                         RL_LP:
  1ADB'   CD 0000*              	CALL	GETKEY
  1ADE'   78                    	MOV	A,B
  1ADF'   FE 01                 	CPI	KT_ACT
  1AE1'   CA 1B37'              	JZ	RL_ACT
  1AE4'   FE 02                 	CPI	KT_CHAR
  1AE6'   C2 1ADB'              	JNZ	RL_LP		; ignore other keys
  1AE9'   79                    	MOV	A,C
  1AEA'   FE 0D                 	CPI	CR
  1AEC'   CA 1B48'              	JZ	RL_DONE
  1AEF'   FE 08                 	CPI	BS
  1AF1'   CA 1B1F'              	JZ	RL_BS
  1AF4'   FE 7F                 	CPI	DEL
  1AF6'   CA 1B1F'              	JZ	RL_BS
  1AF9'   FE 20                 	CPI	' '
  1AFB'   DA 1ADB'              	JC	RL_LP		; control char -> ignore
  1AFE'   3A 294D'              	LDA	RLLEN
  1B01'   47                    	MOV	B,A
  1B02'   3A 294E'              	LDA	RLMAX
  1B05'   B8                    	CMP	B
  1B06'   CA 1ADB'              	JZ	RL_LP		; full -> ignore
  1B09'   2A 294B'              	LHLD	RLPTR
  1B0C'   71                    	MOV	M,C
  1B0D'   23                    	INX	H
  1B0E'   22 294B'              	SHLD	RLPTR
  1B11'   3A 294D'              	LDA	RLLEN
  1B14'   3C                    	INR	A
  1B15'   32 294D'              	STA	RLLEN
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B18'   79                    	MOV	A,C
  1B19'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1B1C'   C3 1ADB'              	JMP	RL_LP
  1B1F'                         RL_BS:				; WM LINEPOP
  1B1F'   3A 294D'              	LDA	RLLEN
  1B22'   B7                    	ORA	A
  1B23'   CA 1B3D'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1B26'   3D                    	DCR	A
  1B27'   32 294D'              	STA	RLLEN
  1B2A'   2A 294B'              	LHLD	RLPTR
  1B2D'   2B                    	DCX	H
  1B2E'   22 294B'              	SHLD	RLPTR
  1B31'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1B34'   C3 1ADB'              	JMP	RL_LP
  1B37'                         RL_ACT:
  1B37'   79                    	MOV	A,C
  1B38'   FE 0B                 	CPI	ACT_ESC
  1B3A'   C2 1ADB'              	JNZ	RL_LP
  1B3D'                         RL_CAN:
  1B3D'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1B3F'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1B42'   CD 06E5'              	CALL	SETLIN		; redraw one row
  1B45'   3E FF                 	MVI	A,0FFH		; cancelled
  1B47'   C9                    	RET
  1B48'                         RL_DONE:
  1B48'   AF                    	XRA	A
  1B49'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1B4A'                         VC_BZ:
  1B4A'   CD 06DF'              	CALL	SETMOV
  1B4D'   3A 291D'              	LDA	GSAVE
  1B50'   FE 02                 	CPI	PZ
  1B52'   CA 1B5D'              	JZ	VZ_ZZ
  1B55'   B7                    	ORA	A
  1B56'   C0                    	RNZ			; 'g' was pending: vim drops both
  1B57'   3E 02                 	MVI	A,PZ
  1B59'   32 291C'              	STA	GPEND
  1B5C'   C9                    	RET
  1B5D'                         VZ_ZZ:
  1B5D'   3E 04                 	MVI	A,EO_X
  1B5F'   32 294F'              	STA	EXOP
  1B62'   3E 01                 	MVI	A,1
  1B64'   32 2962'              	STA	EXBANG		; no '!'
  1B67'   AF                    	XRA	A
  1B68'   32 2950'              	STA	EXARG		; no file name
  1B6B'   3A 28F8'              	LDA	MODF		; as ':x': a changed text is written first
  1B6E'   B7                    	ORA	A
  1B6F'   CA 1CB0'              	JZ	EX_Q
  1B72'   C3 1C4A'              	JMP	EX_W
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1B75'                         VC_EX:
  1B75'   CD 0672'              	CALL	GETCNT
  1B78'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1B7B'   11 0000*              	LXI	D,EXBUF
  1B7E'   06 28                 	MVI	B,EXMAX
  1B80'   0E 3A                 	MVI	C,':'
  1B82'   CD 1ACA'              	CALL	RDLINE
  1B85'   B7                    	ORA	A
  1B86'   C0                    	RNZ			; cancelled
  1B87'   3A 294D'              	LDA	RLLEN
  1B8A'   5F                    	MOV	E,A
  1B8B'   16 00                 	MVI	D,0
  1B8D'   21 0000*              	LXI	H,EXBUF
  1B90'   19                    	DAD	D
  1B91'   36 00                 	MVI	M,0		; the line ends with a 0
  1B93'   21 0000*              	LXI	H,EXBUF
  1B96'   CD 2166'              	CALL	SKIPB
  1B99'   C8                    	RZ			; nothing on it
  1B9A'   22 2952'              	SHLD	EXCMD
  1B9D'   CD 234E'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1BA0'   CD 2166'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1BA3'   56                    	MOV	D,M
  1BA4'   23                    	INX	H
  1BA5'   1E 00                 	MVI	E,0
  1BA7'   CD 2172'              	CALL	ISLOW
  1BAA'   DA 1BB5'              	JC	EX_LK
  1BAD'   5F                    	MOV	E,A
  1BAE'   23                    	INX	H
  1BAF'   CD 2172'              	CALL	ISLOW
  1BB2'   D2 1BCE'              	JNC	EX_NOT		; a third letter: none of ours
  1BB5'                         EX_LK:
  1BB5'   E5                    	PUSH	H
  1BB6'   21 2335'              	LXI	H,EXTAB
  1BB9'                         EX_TL:
  1BB9'   7E                    	MOV	A,M
  1BBA'   B7                    	ORA	A
  1BBB'   CA 1BCD'              	JZ	EX_NTP		; not in the table
  1BBE'   23                    	INX	H
  1BBF'   BA                    	CMP	D
  1BC0'   7E                    	MOV	A,M
  1BC1'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC2'   C2 1BC9'              	JNZ	EX_TN
  1BC5'   BB                    	CMP	E
  1BC6'   CA 1BD4'              	JZ	EX_TF
  1BC9'                         EX_TN:
  1BC9'   23                    	INX	H
  1BCA'   C3 1BB9'              	JMP	EX_TL
  1BCD'                         EX_NTP:
  1BCD'   E1                    	POP	H
  1BCE'                         EX_NOT:
  1BCE'   21 222A'              	LXI	H,SNOT
  1BD1'   C3 21A7'              	JMP	EXERT
  1BD4'                         EX_TF:
  1BD4'   7E                    	MOV	A,M
  1BD5'   32 294F'              	STA	EXOP
  1BD8'   E1                    	POP	H
  1BD9'   FE 06                 	CPI	EO_S
  1BDB'   CA 23BD'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1BDE'   FE 01                 	CPI	EO_W
  1BE0'   CA 1BEF'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1BE3'   FE 08                 	CPI	EO_R
  1BE5'   CA 1BEF'              	JZ	EX_RG		; ... and ':Nr name' a line
  1BE8'   3A 29A7'              	LDA	SRNGF
  1BEB'   B7                    	ORA	A
  1BEC'   C2 1BCE'              	JNZ	EX_NOT		; a range on a command that does not take one
  1BEF'                         EX_RG:
                                	;--- '!', then the file name ---
  1BEF'   7E                    	MOV	A,M
  1BF0'   D6 21                 	SUI	'!'
  1BF2'   32 2962'              	STA	EXBANG		; 0 = '!'
  1BF5'   C2 1BF9'              	JNZ	EX_NB
  1BF8'   23                    	INX	H
  1BF9'                         EX_NB:
  1BF9'   CD 2166'              	CALL	SKIPB
  1BFC'   32 2950'              	STA	EXARG		; 0 = no file name
  1BFF'   CA 1C18'              	JZ	EX_RUN
  1C02'   22 2952'              	SHLD	EXCMD
  1C05'   3A 294F'              	LDA	EXOP
  1C08'   FE 02                 	CPI	EO_Q
  1C0A'   CA 21A4'              	JZ	EX_TRL		; :q takes none
  1C0D'   FE 07                 	CPI	EO_V
  1C0F'   CA 21A4'              	JZ	EX_TRL		; nor :ve
  1C12'   CD 20D0'              	CALL	PARSFN
  1C15'   C2 2198'              	JNZ	EX_INV
  1C18'                         EX_RUN:
  1C18'   3A 294F'              	LDA	EXOP
  1C1B'   FE 05                 	CPI	EO_E
  1C1D'   CA 1CC7'              	JZ	EX_E
  1C20'   FE 02                 	CPI	EO_Q
  1C22'   CA 1CB0'              	JZ	EX_Q
  1C25'   FE 07                 	CPI	EO_V
  1C27'   CA 219E'              	JZ	EX_V
  1C2A'   FE 08                 	CPI	EO_R
  1C2C'   CA 1E58'              	JZ	EX_R
  1C2F'   FE 04                 	CPI	EO_X
  1C31'   CA 1C43'              	JZ	EX_XM
  1C34'   FE 01                 	CPI	EO_W
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C36'   C2 1C4A'              	JNZ	EX_W		; :wq
  1C39'   3A 29A7'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1C3C'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1C3D'   C2 1D78'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1C40'   C3 1C4A'              	JMP	EX_W
  1C43'                         EX_XM:
  1C43'   3A 28F8'              	LDA	MODF		; :x writes only a changed text
  1C46'   B7                    	ORA	A
  1C47'   CA 1CB0'              	JZ	EX_Q
  1C4A'                         EX_W:
  1C4A'   CD 1F38'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1C4D'   D8                    	RC			; refused (message shown)
  1C4E'   32 2951'              	STA	EXBAK
  1C51'   3A 294F'              	LDA	EXOP
  1C54'   FE 01                 	CPI	EO_W
  1C56'   CA 1C6D'              	JZ	EX_WK
  1C59'   3A 2951'              	LDA	EXBAK
  1C5C'   B7                    	ORA	A
  1C5D'   C2 1CAD'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1C60'   3A 2962'              	LDA	EXBANG
  1C63'   B7                    	ORA	A
  1C64'   CA 1CAD'              	JZ	EX_WQ		; so it does with '!'
  1C67'   CD 1C6D'              	CALL	EX_WK		; else it may not: keep the text
  1C6A'   C3 1CB0'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1C6D'                         EX_WK:
  1C6D'   CD 0C71'              	CALL	CURRW		; the cursor's row and file position
  1C70'   32 2954'              	STA	WPROW
  1C73'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1C76'   7D                    	MOV	A,L
  1C77'   E6 7F                 	ANI	7FH
  1C79'   32 2955'              	STA	WPBYT
  1C7C'   7D                    	MOV	A,L
  1C7D'   17                    	RAL
  1C7E'   7C                    	MOV	A,H
  1C7F'   17                    	RAL
  1C80'   5F                    	MOV	E,A
  1C81'   3E 00                 	MVI	A,0
  1C83'   17                    	RAL
  1C84'   57                    	MOV	D,A		; DE = HL / 128
  1C85'   2A 0000*              	LHLD	OUTPOS
  1C88'   19                    	DAD	D
  1C89'   22 2956'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1C8C'   CD 1F6D'              	CALL	WRITE
  1C8F'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1C92'   2A 2956'              	LHLD	WPREC
  1C95'   EB                    	XCHG
  1C96'   3A 2955'              	LDA	WPBYT
  1C99'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1C9C'   CD 0000*              	CALL	GOTO
  1C9F'                         EX_WRW:
  1C9F'   21 0000               	LXI	H,0
  1CA2'   22 0000*              	SHLD	LNDLT
  1CA5'   3A 2954'              	LDA	WPROW
  1CA8'   6F                    	MOV	L,A
  1CA9'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1CAC'   C9                    	RET
  1CAD'                         EX_WQ:
  1CAD'   CD 1F6D'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1CB0'                         EX_Q:
  1CB0'   3A 2962'              	LDA	EXBANG
  1CB3'   B7                    	ORA	A
  1CB4'   CA 1CBE'              	JZ	EX_QT
  1CB7'   3A 28F8'              	LDA	MODF
  1CBA'   B7                    	ORA	A
  1CBB'   C2 218C'              	JNZ	MSGNWR		; changed, no '!': stay
  1CBE'                         EX_QT:
  1CBE'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1CC1'   3E 01                 	MVI	A,1
  1CC3'   32 28F7'              	STA	QUITF
  1CC6'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1CC7'                         EX_E:
  1CC7'   3A 2962'              	LDA	EXBANG
  1CCA'   B7                    	ORA	A
  1CCB'   CA 1CD5'              	JZ	EE_GO
  1CCE'   3A 28F8'              	LDA	MODF
  1CD1'   B7                    	ORA	A
  1CD2'   C2 218C'              	JNZ	MSGNWR
  1CD5'                         EE_GO:
  1CD5'   3A 2950'              	LDA	EXARG
  1CD8'   B7                    	ORA	A
  1CD9'   C2 1CE0'              	JNZ	EE_ARG
  1CDC'   CD 1FA9'              	CALL	OWNTF		; no name: the buffer's own
  1CDF'   D8                    	RC
  1CE0'                         EE_ARG:
  1CE0'   CD 1FBF'              	CALL	ISOWN
  1CE3'   21 0001               	LXI	H,1
  1CE6'   C2 1CED'              	JNZ	EE_LD		; another file: its first line
  1CE9'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1CEC'   23                    	INX	H		; HL = the cursor's line
  1CED'                         EE_LD:
  1CED'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1CEF'   32 2960'              	STA	MSGWHT
  1CF2'   E5                    	PUSH	H
  1CF3'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1CF6'   21 0000*              	LXI	H,TFCB
  1CF9'   11 0000*              	LXI	D,FNAME
  1CFC'   CD 1FD1'              	CALL	COPY12		; the buffer's name
  1CFF'   CD 1F96'              	CALL	SRCTF
  1D02'   CD 0000*              	CALL	REOPEN
  1D05'   CD 020B'              	CALL	MKCLR		; the marks named the buffer that just went
  1D08'   AF                    	XRA	A
  1D09'   32 28F8'              	STA	MODF
  1D0C'   E1                    	POP	H
  1D0D'   2B                    	DCX	H
  1D0E'   AF                    	XRA	A
  1D0F'   CD 0000*              	CALL	MVLIND		; down to the line
  1D12'   CD 0989'              	CALL	ATEOF
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1D15'   DC 098F'              	CC	LASTLN		; past the last line: onto it
  1D18'   CD 0EAD'              	CALL	ZSAVE
  1D1B'   C3 0F90'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 27 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1D1E'                         TFDOS:
  1D1E'   C5                    	PUSH	B
  1D1F'   11 0080               	LXI	D,CMDTAIL
  1D22'   0E 1A                 	MVI	C,1AH		; set the DMA
  1D24'   CD 0005               	CALL	BDOS
  1D27'   C1                    	POP	B
  1D28'   11 0000*              	LXI	D,TFCB
  1D2B'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1D2E'                         EXRNG:
  1D2E'   2A 29A8'              	LHLD	SRNG1
  1D31'   7C                    	MOV	A,H
  1D32'   B5                    	ORA	L
  1D33'   37                    	STC
  1D34'   C8                    	RZ
  1D35'   2A 29AA'              	LHLD	SRNG2
  1D38'   EB                    	XCHG
  1D39'   2A 29A8'              	LHLD	SRNG1
  1D3C'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1D3F'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D40'   EB                    	XCHG			; HL = the last line, DE = the first
  1D41'   CD 0000*              	CALL	SUBHD
  1D44'   23                    	INX	H
  1D45'   22 29B2'              	SHLD	SLINES
  1D48'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1D49'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1D4A'                         GOLNX:
  1D4A'   E5                    	PUSH	H
  1D4B'   CD 0E44'              	CALL	GOLN
  1D4E'   CD 0000*              	CALL	CNTLF
  1D51'   23                    	INX	H		; the line the cursor came to rest on
  1D52'   D1                    	POP	D
  1D53'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1D56'                         EXSAVP:
  1D56'   CD 0C71'              	CALL	CURRW
  1D59'   32 2954'              	STA	WPROW
  1D5C'   21 298C'              	LXI	H,MKPOS
  1D5F'   C3 0436'              	JMP	FPSTO
  1D62'                         EXRSTP:
  1D62'   CD 0000*              	CALL	CLRCNT
  1D65'   CD 03C2'              	CALL	MKPAGE		; page until that place is in the window again
  1D68'   CD 0000*              	CALL	GOTO
  1D6B'   C3 1C9F'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1D6E'                         PUTBRK:
  1D6E'   3E 0D                 	MVI	A,CR
  1D70'   CD 0000*              	CALL	PUTGAP
  1D73'   3E 0A                 	MVI	A,LF
  1D75'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1D78'                         EX_WR:
  1D78'   3A 2950'              	LDA	EXARG
  1D7B'   B7                    	ORA	A
  1D7C'   CA 217A'              	JZ	MSGNFN		; No file name
  1D7F'   CD 1FBF'              	CALL	ISOWN
  1D82'   CA 1E22'              	JZ	EXW_OW
  1D85'   CD 0000*              	CALL	TEXIST
  1D88'   32 29B5'              	STA	RWERR		; nonzero: a file of that name is there
  1D8B'   CA 1D95'              	JZ	EXW_GO
  1D8E'   3A 2962'              	LDA	EXBANG
  1D91'   B7                    	ORA	A
  1D92'   C2 2180'              	JNZ	MSGEXI		; File exists (! to force)
  1D95'                         EXW_GO:
  1D95'   CD 1D2E'              	CALL	EXRNG
  1D98'   DA 1E1C'              	JC	EXW_BD
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D9B'   CD 1D56'              	CALL	EXSAVP
  1D9E'   2A 29A8'              	LHLD	SRNG1
  1DA1'   CD 1D4A'              	CALL	GOLNX
  1DA4'   C2 1E19'              	JNZ	EXW_NL		; the text has no line N
  1DA7'   3A 29B5'              	LDA	RWERR		; a delete scans the whole directory, there or
  1DAA'   B7                    	ORA	A		;   not: only when TEXIST found one
  1DAB'   0E 13                 	MVI	C,13H
  1DAD'   C4 1D1E'              	CNZ	TFDOS		; delete what is there
  1DB0'   0E 16                 	MVI	C,16H
  1DB2'   CD 1D1E'              	CALL	TFDOS		; ... and make it
  1DB5'   3C                    	INR	A
  1DB6'   CA 1E0B'              	JZ	EXW_FL		; no directory entry left
  1DB9'   3E 80                 	MVI	A,80H
  1DBB'   32 29B4'              	STA	RWPTR
  1DBE'   AF                    	XRA	A
  1DBF'   32 29B5'              	STA	RWERR
  1DC2'   2A 29B2'              	LHLD	SLINES
  1DC5'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1DC8'                         EXW_LP:
  1DC8'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1DCB'   E5                    	PUSH	H
  1DCC'   EB                    	XCHG
  1DCD'   2A 0000*              	LHLD	GAPEND
  1DD0'   CD 1E28'              	CALL	RWOUT		; the text from the cursor to there
  1DD3'   E1                    	POP	H
  1DD4'   3A 29B5'              	LDA	RWERR
  1DD7'   B7                    	ORA	A
  1DD8'   C2 1DF4'              	JNZ	EXW_EN
  1DDB'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1DDE'   CD 0687'              	CALL	CNTTST
  1DE1'   C2 1DC8'              	JNZ	EXW_LP
  1DE4'                         EXW_PD:				; the last record is padded out with ^Z
  1DE4'   3A 29B4'              	LDA	RWPTR
  1DE7'   FE 80                 	CPI	80H
  1DE9'   CA 1DF4'              	JZ	EXW_EN
  1DEC'   3E 1A                 	MVI	A,CPMEOF
  1DEE'   CD 1E34'              	CALL	RWPUT
  1DF1'   C3 1DE4'              	JMP	EXW_PD
  1DF4'                         EXW_EN:
  1DF4'   0E 10                 	MVI	C,10H
  1DF6'   CD 1D1E'              	CALL	TFDOS		; close
  1DF9'   3A 29B5'              	LDA	RWERR
  1DFC'   B7                    	ORA	A
  1DFD'   C2 1E0B'              	JNZ	EXW_FL
  1E00'   CD 1D62'              	CALL	EXRSTP
  1E03'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1E05'   32 2960'              	STA	MSGWHT
  1E08'   C3 06DF'              	JMP	SETMOV		; nothing on the screen has changed
  1E0B'                         EXW_FL:				; no room: the part written is not left behind
  1E0B'   0E 13                 	MVI	C,13H
  1E0D'   CD 1D1E'              	CALL	TFDOS
  1E10'   CD 1D62'              	CALL	EXRSTP
  1E13'   21 232B'              	LXI	H,SDFUL
  1E16'   C3 21B2'              	JMP	EXERR
  1E19'                         EXW_NL:
  1E19'   CD 1D62'              	CALL	EXRSTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1E1C'                         EXW_BD:
  1E1C'   21 231D'              	LXI	H,SRNGE
  1E1F'   C3 21B2'              	JMP	EXERR
  1E22'                         EXW_OW:
  1E22'   21 21E1'              	LXI	H,SEXI
  1E25'   C3 21B2'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1E28'                         RWOUT:
  1E28'   CD 0000*              	CALL	CMP16
  1E2B'   C8                    	RZ
  1E2C'   7E                    	MOV	A,M
  1E2D'   23                    	INX	H
  1E2E'   CD 1E34'              	CALL	RWPUT
  1E31'   C3 1E28'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1E34'                         RWPUT:
  1E34'   E5                    	PUSH	H
  1E35'   F5                    	PUSH	PSW
  1E36'   3A 29B4'              	LDA	RWPTR
  1E39'   6F                    	MOV	L,A
  1E3A'   26 00                 	MVI	H,0
  1E3C'   F1                    	POP	PSW
  1E3D'   77                    	MOV	M,A
  1E3E'   2C                    	INR	L		; Z: that was the record's last byte
  1E3F'   7D                    	MOV	A,L
  1E40'   C2 1E53'              	JNZ	RWP_ST
  1E43'   D5                    	PUSH	D
  1E44'   0E 15                 	MVI	C,15H
  1E46'   CD 1D1E'              	CALL	TFDOS		; write it
  1E49'   D1                    	POP	D
  1E4A'   B7                    	ORA	A
  1E4B'   CA 1E51'              	JZ	RWP_OK
  1E4E'   32 29B5'              	STA	RWERR
  1E51'                         RWP_OK:
  1E51'   3E 80                 	MVI	A,80H
  1E53'                         RWP_ST:
  1E53'   32 29B4'              	STA	RWPTR
  1E56'   E1                    	POP	H
  1E57'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1E58'                         EX_R:
  1E58'   3A 2950'              	LDA	EXARG
  1E5B'   B7                    	ORA	A
  1E5C'   CA 217A'              	JZ	MSGNFN		; No file name
  1E5F'   0E 0F                 	MVI	C,0FH
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


  1E61'   CD 1D1E'              	CALL	TFDOS		; open
  1E64'   3C                    	INR	A
  1E65'   CA 1F32'              	JZ	ER_NOF
  1E68'   CD 0ED3'              	CALL	GZONE		; the screen's top line, before anything moves
  1E6B'   CD 1D56'              	CALL	EXSAVP
  1E6E'   3A 29A7'              	LDA	SRNGF
  1E71'   B7                    	ORA	A
  1E72'   CA 1E8B'              	JZ	ER_NXT		; no line given: below the cursor's
  1E75'   2A 29AA'              	LHLD	SRNG2
  1E78'   7C                    	MOV	A,H
  1E79'   B5                    	ORA	L
  1E7A'   C2 1E85'              	JNZ	ER_LN
  1E7D'   23                    	INX	H
  1E7E'   CD 0E44'              	CALL	GOLN		; ':0r': above line 1 ...
  1E81'   AF                    	XRA	A		;   which never wants a line end put in first
  1E82'   C3 1EAD'              	JMP	ER_BRK
  1E85'                         ER_LN:
  1E85'   CD 1D4A'              	CALL	GOLNX
  1E88'   C2 1E19'              	JNZ	EXW_NL		; the text has no line N
  1E8B'                         ER_NXT:
  1E8B'   21 0001               	LXI	H,1
  1E8E'   AF                    	XRA	A
  1E8F'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1E92'   CD 0989'              	CALL	ATEOF
  1E95'   3E 00                 	MVI	A,0
  1E97'   D2 1EAD'              	JNC	ER_BRK		; text follows
  1E9A'   2A 0000*              	LHLD	GAPBEG
  1E9D'   EB                    	XCHG
  1E9E'   2A 0000*              	LHLD	TXTBEG
  1EA1'   CD 0000*              	CALL	CMP16
  1EA4'   3E 01                 	MVI	A,1
  1EA6'   CA 1EAD'              	JZ	ER_BRK		; nothing before the cursor either
  1EA9'   1B                    	DCX	D
  1EAA'   1A                    	LDAX	D
  1EAB'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1EAD'                         ER_BRK:
  1EAD'   32 29B7'              	STA	RDBRK
  1EB0'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1EB3'   AF                    	XRA	A
  1EB4'   32 29B6'              	STA	RDANY
  1EB7'                         ER_LP:
  1EB7'   0E 14                 	MVI	C,14H
  1EB9'   CD 1D1E'              	CALL	TFDOS		; the next record
  1EBC'   B7                    	ORA	A
  1EBD'   C2 1EF0'              	JNZ	ER_END
  1EC0'   21 0080               	LXI	H,CMDTAIL
  1EC3'   0E 00                 	MVI	C,0
  1EC5'                         ER_SC:				; C = its bytes, up to a ^Z
  1EC5'   7E                    	MOV	A,M
  1EC6'   FE 1A                 	CPI	CPMEOF
  1EC8'   CA 1ED0'              	JZ	ER_GOT
  1ECB'   23                    	INX	H
  1ECC'   0C                    	INR	C
  1ECD'   F2 1EC5'              	JP	ER_SC		; (minus: all 128)
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1ED0'                         ER_GOT:
  1ED0'   79                    	MOV	A,C
  1ED1'   B7                    	ORA	A
  1ED2'   CA 1EF0'              	JZ	ER_END
  1ED5'   C5                    	PUSH	B
  1ED6'   3A 29B6'              	LDA	RDANY
  1ED9'   B7                    	ORA	A
  1EDA'   CC 1F21'              	CZ	ER_1ST
  1EDD'   C1                    	POP	B
  1EDE'   06 00                 	MVI	B,0
  1EE0'   11 0080               	LXI	D,CMDTAIL
  1EE3'   C5                    	PUSH	B
  1EE4'   CD 0000*              	CALL	INSBLK
  1EE7'   C1                    	POP	B
  1EE8'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1EEB'   79                    	MOV	A,C
  1EEC'   17                    	RAL
  1EED'   DA 1EB7'              	JC	ER_LP		; a full record: there may be more
  1EF0'                         ER_END:
  1EF0'   3A 29B6'              	LDA	RDANY
  1EF3'   B7                    	ORA	A
  1EF4'   CA 1F12'              	JZ	ER_PL		; nothing in the file: nothing has changed
  1EF7'   CD 0989'              	CALL	ATEOF
  1EFA'   DA 1F07'              	JC	ER_MD		; the text now ends as the file read ends
  1EFD'   2A 0000*              	LHLD	GAPBEG
  1F00'   2B                    	DCX	H
  1F01'   7E                    	MOV	A,M
  1F02'   FE 0A                 	CPI	LF
  1F04'   C4 1D6E'              	CNZ	PUTBRK		; text follows: what was read ends a line
  1F07'                         ER_MD:
  1F07'   3E 01                 	MVI	A,1
  1F09'   32 28F8'              	STA	MODF
  1F0C'   CD 03C2'              	CALL	MKPAGE		; back to the first line read
  1F0F'   CD 0000*              	CALL	GOTO
  1F12'                         ER_PL:
  1F12'   CD 0989'              	CALL	ATEOF
  1F15'   DC 098F'              	CC	LASTLN		; (nothing read, at the end: the last line)
  1F18'   CD 0000*              	CALL	CLRCNT
  1F1B'   CD 0EEB'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  1F1E'   C3 0700'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  1F21'                         ER_1ST:
  1F21'   3C                    	INR	A
  1F22'   32 29B6'              	STA	RDANY
  1F25'   3A 29B7'              	LDA	RDBRK
  1F28'   B7                    	ORA	A
  1F29'   C4 1D6E'              	CNZ	PUTBRK
  1F2C'   21 298C'              	LXI	H,MKPOS
  1F2F'   C3 0436'              	JMP	FPSTO
  1F32'                         ER_NOF:
  1F32'   21 230C'              	LXI	H,SNOPN
  1F35'   C3 21A7'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1F38'                         WRCHK:
  1F38'   3A 2950'              	LDA	EXARG
  1F3B'   B7                    	ORA	A
  1F3C'   C2 1F46'              	JNZ	WC_ARG
  1F3F'   CD 1FA9'              	CALL	OWNTF
  1F42'   D8                    	RC
  1F43'   C3 1F5B'              	JMP	WC_OWN
  1F46'                         WC_ARG:
  1F46'   CD 1FBF'              	CALL	ISOWN
  1F49'   CA 1F5B'              	JZ	WC_OWN
  1F4C'   3A 2962'              	LDA	EXBANG
  1F4F'   B7                    	ORA	A
  1F50'   CA 1F59'              	JZ	WC_OTH
  1F53'   CD 0000*              	CALL	TEXIST
  1F56'   C2 2180'              	JNZ	MSGEXI		; File exists (! to force)
  1F59'                         WC_OTH:
  1F59'   AF                    	XRA	A		; (NC)
  1F5A'   C9                    	RET
  1F5B'                         WC_OWN:
  1F5B'   3A 2963'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1F5E'   B7                    	ORA	A
  1F5F'   CA 1F69'              	JZ	WC_OK
  1F62'   3A 2962'              	LDA	EXBANG
  1F65'   B7                    	ORA	A
  1F66'   C2 2186'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1F69'                         WC_OK:
  1F69'   3E 01                 	MVI	A,1
  1F6B'   B7                    	ORA	A		; (NC)
  1F6C'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1F6D'                         WRITE:
  1F6D'   3A 2951'              	LDA	EXBAK
  1F70'   CD 0000*              	CALL	WRTO
  1F73'   3A 0001*              	LDA	FNAME+1
  1F76'   FE 20                 	CPI	' '
  1F78'   C2 1F84'              	JNZ	WR_HAS
  1F7B'   21 0000*              	LXI	H,TFCB
  1F7E'   11 0000*              	LXI	D,FNAME
  1F81'   CD 1FD1'              	CALL	COPY12
  1F84'                         WR_HAS:
  1F84'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1F86'   32 2960'              	STA	MSGWHT
  1F89'   CD 1FBF'              	CALL	ISOWN
  1F8C'   C2 1F96'              	JNZ	SRCTF
  1F8F'   AF                    	XRA	A
  1F90'   32 28F8'              	STA	MODF
  1F93'   32 2961'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1F96'                         SRCTF:
  1F96'   21 0000*              	LXI	H,TFCB
  1F99'   11 005C               	LXI	D,DFTFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F9C'   CD 1FD1'              	CALL	COPY12
  1F9F'   AF                    	XRA	A
  1FA0'   06 04                 	MVI	B,4
  1FA2'                         SRC_Z:
  1FA2'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1FA3'   13                    	INX	D
  1FA4'   05                    	DCR	B
  1FA5'   C2 1FA2'              	JNZ	SRC_Z
  1FA8'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1FA9'                         OWNTF:
  1FA9'   3A 0001*              	LDA	FNAME+1
  1FAC'   FE 20                 	CPI	' '
  1FAE'   CA 217A'              	JZ	MSGNFN
  1FB1'   CD 1FDC'              	CALL	TFCLR
  1FB4'   21 0000*              	LXI	H,FNAME
  1FB7'   11 0000*              	LXI	D,TFCB
  1FBA'   CD 1FD1'              	CALL	COPY12
  1FBD'   B7                    	ORA	A		; (NC)
  1FBE'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1FBF'                         ISOWN:
  1FBF'   21 0000*              	LXI	H,TFCB
  1FC2'   11 0000*              	LXI	D,FNAME
  1FC5'   06 0C                 	MVI	B,12
  1FC7'                         IO_LP:
  1FC7'   1A                    	LDAX	D
  1FC8'   BE                    	CMP	M
  1FC9'   C0                    	RNZ
  1FCA'   23                    	INX	H
  1FCB'   13                    	INX	D
  1FCC'   05                    	DCR	B
  1FCD'   C2 1FC7'              	JNZ	IO_LP
  1FD0'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1FD1'                         COPY12:
  1FD1'   06 0C                 	MVI	B,12
  1FD3'                         CP_LP:
  1FD3'   7E                    	MOV	A,M
  1FD4'   12                    	STAX	D
  1FD5'   23                    	INX	H
  1FD6'   13                    	INX	D
  1FD7'   05                    	DCR	B
  1FD8'   C2 1FD3'              	JNZ	CP_LP
  1FDB'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1FDC'                         TFCLR:
  1FDC'   11 0000*              	LXI	D,TFCB
  1FDF'   06 24                 	MVI	B,36
  1FE1'   AF                    	XRA	A
  1FE2'                         TC_LP:
  1FE2'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FE3'   13                    	INX	D
  1FE4'   05                    	DCR	B
  1FE5'   C2 1FE2'              	JNZ	TC_LP
  1FE8'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1FE9'                         FOPEN:
  1FE9'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1FEB'   32 2960'              	STA	MSGWHT
  1FEE'   21 005C               	LXI	H,DFTFCB
  1FF1'   CD 20C3'              	CALL	NRMDRV
  1FF4'   11 0000*              	LXI	D,FNAME
  1FF7'   CD 1FD1'              	CALL	COPY12
  1FFA'   CD 0000*              	CALL	OPENZ
  1FFD'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2000'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  2002'   C8                    	RZ
  2003'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2006'   32 2961'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2009'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  200A'                         ARGSCN:
  200A'   3A 0080               	LDA	CMDTAIL
  200D'   47                    	MOV	B,A		; B = what is left of the line
  200E'   B7                    	ORA	A
  200F'   C8                    	RZ
  2010'   21 0081               	LXI	H,CMDTAIL+1
  2013'                         AS_TOK:				; at a token, or the blanks before one
  2013'   7E                    	MOV	A,M
  2014'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  2016'   C2 201F'              	JNZ	AS_OPT
  2019'   23                    	INX	H
  201A'   05                    	DCR	B
  201B'   C2 2013'              	JNZ	AS_TOK
  201E'   C9                    	RET
  201F'                         AS_OPT:
  201F'   FE 2B                 	CPI	'+'
  2021'   CA 204B'              	JZ	AS_PLS
  2024'   FE 2D                 	CPI	'-'
  2026'   CA 203A'              	JZ	AS_SW
  2029'   FE 2F                 	CPI	'/'
  202B'   CA 203A'              	JZ	AS_SW
  202E'                         AS_SKP:				; not ours (the file name): on to the next one
  202E'   23                    	INX	H
  202F'   05                    	DCR	B
  2030'   C8                    	RZ
  2031'   7E                    	MOV	A,M
  2032'   FE 20                 	CPI	' '
  2034'   C2 202E'              	JNZ	AS_SKP
  2037'   C3 2013'              	JMP	AS_TOK
  203A'                         AS_SW:
  203A'   23                    	INX	H
  203B'   05                    	DCR	B
  203C'   C8                    	RZ
  203D'   7E                    	MOV	A,M
  203E'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2040'   FE 52                 	CPI	'R'
  2042'   C2 202E'              	JNZ	AS_SKP
  2045'   32 2963'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2048'   C3 202E'              	JMP	AS_SKP
  204B'                         AS_PLS:
  204B'   3E 01                 	MVI	A,1
  204D'   32 2964'              	STA	PLUSF		; '+' gets the line even with no number on it
  2050'   11 0000*              	LXI	D,PLUSB
  2053'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2055'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2056'   05                    	DCR	B
  2057'   CA 208E'              	JZ	AS_PE
  205A'   7E                    	MOV	A,M
  205B'   FE 30                 	CPI	'0'
  205D'   C2 2075'              	JNZ	AS_PD
  2060'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2060'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2061'   05                    	DCR	B
  2062'   CA 2096'              	JZ	AS_P1
  2065'   7E                    	MOV	A,M
  2066'   FE 30                 	CPI	'0'
  2068'   CA 2060'              	JZ	AS_PZ
  206B'   FE 31                 	CPI	'1'
  206D'   DA 2096'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2070'   FE 3A                 	CPI	'9'+1
  2072'   D2 2096'              	JNC	AS_P1
