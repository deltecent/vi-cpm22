  295E'                         EXTAB:
  295E'   77 00 01              	DB	'w',0,EO_W
  2961'   71 00 02              	DB	'q',0,EO_Q
  2964'   77 71 03              	DB	'w','q',EO_WQ
  2967'   78 00 04              	DB	'x',0,EO_X
