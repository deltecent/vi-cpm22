  299F'   61                    	DB	'a'
  29A0'   1526'                 	DW	VC_A
  29A2'   41                    	DB	'A'
  29A3'   1546'                 	DW	VCB_A
  29A5'   49                    	DB	'I'
  29A6'   1562'                 	DW	VCB_I
  29A8'   72                    	DB	'r'
  29A9'   16A4'                 	DW	VC_R
  29AB'   52                    	DB	'R'
  29AC'   16F8'                 	DW	VCB_R
  29AE'   64                    	DB	'd'
  29AF'   170D'                 	DW	VC_D
  29B1'   44                    	DB	'D'
  29B2'   14B0'                 	DW	VCB_D
  29B4'   43                    	DB	'C'
  29B5'   14AA'                 	DW	VCB_C
  29B7'   63                    	DB	'c'
  29B8'   1715'                 	DW	VC_C
  29BA'   6F                    	DB	'o'
  29BB'   15B0'                 	DW	VC_O
