  06B2'   78                    	MOV	A,B
  06B3'   B1                    	ORA	C
  06B4'   CA 06C3'              	JZ	BOL_B		; back at the gap: the rest is before it
  06B7'   2B                    	DCX	H
  06B8'   7E                    	MOV	A,M
  06B9'   FE 0A                 	CPI	LF
  06BB'   CA 06D7'              	JZ	BOL_X
  06BE'   1B                    	DCX	D
  06BF'   0B                    	DCX	B
  06C0'   C3 06B2'              	JMP	BOL_A
