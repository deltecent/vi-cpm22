  065F'                         SG_CUR:
  065F'   2A 0000*              	LHLD	TXTEND
  0662'   D5                    	PUSH	D
  0663'   EB                    	XCHG
  0664'   2A 0000*              	LHLD	GAPEND
  0667'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  066A'   D1                    	POP	D
  066B'   CA 067F'              	JZ	SG_SET
  066E'   7E                    	MOV	A,M
  066F'   FE 09                 	CPI	TAB
  0671'   C2 067F'              	JNZ	SG_SET
  0674'   6B                    	MOV	L,E
  0675'   CD 0684'              	CALL	CWID
  0678'   3D                    	DCR	A		; the TAB's last column
  0679'   83                    	ADD	E
  067A'   5F                    	MOV	E,A
  067B'   D2 067F'              	JNC	SG_SET
  067E'   14                    	INR	D
  067F'                         SG_SET:
  067F'   EB                    	XCHG
  0680'   22 31EF'              	SHLD	GOALCOL
  0683'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  0684'                         CWID:
  0684'   FE 0D                 	CPI	CR
  0686'   CA 0695'              	JZ	CW_0
  0689'   FE 09                 	CPI	TAB
  068B'   3E 01                 	MVI	A,1
  068D'   C0                    	RNZ
  068E'   7D                    	MOV	A,L
  068F'   E6 07                 	ANI	TABWID-1
  0691'   2F                    	CMA
  0692'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  0694'   C9                    	RET
  0695'                         CW_0:
  0695'   AF                    	XRA	A
  0696'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
                                ; The text is read where it lies, either side of the gap; keeps BC.
  0697'                         BOL:
  0697'   C5                    	PUSH	B
  0698'   E5                    	PUSH	H
  0699'   CD 0000*              	CALL	CUROFF
