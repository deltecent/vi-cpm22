  0FCA'   E1                    	POP	H
  0FCB'   C2 0FCF'              	JNZ	VPD_TP
  0FCE'   23                    	INX	H
  0FCF'                         VPD_TP:
  0FCF'   54                    	MOV	D,H
  0FD0'   5D                    	MOV	E,L
  0FD1'   C3 113E'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FD4'                         VC_PGUP:
  0FD4'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count
  0FD7'   22 0000*              	SHLD	RWR
  0FDA'   3A 0000*              	LDA	SCBOF
  0FDD'   B7                    	ORA	A
  0FDE'   C0                    	RNZ
  0FDF'   CD 0EDE'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FE2'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FE4'   0E 01                 	MVI	C,1
  0FE6'   D2 0FED'              	JNC	VPU_1
  0FE9'   3A 0000*              	LDA	NEDIT
  0FEC'   4F                    	MOV	C,A
  0FED'                         VPU_1:
  0FED'   3A 0000*              	LDA	NEDIT
  0FF0'   CD 11D7'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FF3'   E5                    	PUSH	H
  0FF4'   D5                    	PUSH	D
  0FF5'   2B                    	DCX	H		; the line above the top one, and on down
  0FF6'   04                    	INR	B
  0FF7'   3E 01                 	MVI	A,1
  0FF9'   CD 1045'              	CALL	OVLAP
  0FFC'   CD 1094'              	CALL	PGROWS		; RWR = the rows to go
  0FFF'   D1                    	POP	D
  1000'   E1                    	POP	H
  1001'   43                    	MOV	B,E
