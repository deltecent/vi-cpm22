  0A0B'   4D                    	MOV	C,L
  0A0C'   E1                    	POP	H
  0A0D'   D1                    	POP	D
  0A0E'                         KC_SC:
  0A0E'   78                    	MOV	A,B
  0A0F'   B1                    	ORA	C
  0A10'   CA 0A27'              	JZ	KC_TB
  0A13'   2B                    	DCX	H
  0A14'   0B                    	DCX	B
  0A15'   7E                    	MOV	A,M
  0A16'   FE 0A                 	CPI	LF
  0A18'   C2 0A0E'              	JNZ	KC_SC
  0A1B'   1B                    	DCX	D
  0A1C'   7A                    	MOV	A,D
  0A1D'   B3                    	ORA	E
  0A1E'   C2 0A0E'              	JNZ	KC_SC
  0A21'   2A 2A93'              	LHLD	JKCNT		; N lines above: the move is count lines
  0A24'   C3 0A47'              	JMP	KC_MV
  0A27'                         KC_TB:
  0A27'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0A28'   CD 06C4'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0A2B'   22 2A99'              	SHLD	JKBK
  0A2E'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0A31'   7C                    	MOV	A,H
  0A32'   B5                    	ORA	L
  0A33'   CA 0A40'              	JZ	KC_B0
