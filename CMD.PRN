  08D6'   CD 0995'              	CALL	ATEOF
  08D9'   D2 08ED'              	JNC	JC_DN
  08DC'   CD 099B'              	CALL	LASTLN		; ran past the last line: back onto it
  08DF'   3A 2914'              	LDA	JKPHN
  08E2'   B7                    	ORA	A
  08E3'   CA 08ED'              	JZ	JC_DN
  08E6'   2A 2910'              	LHLD	JKMOV
  08E9'   2B                    	DCX	H
  08EA'   22 2910'              	SHLD	JKMOV
