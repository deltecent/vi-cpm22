  261D'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  261E'   00                    EDMODE: DB	EM_CMD
  261F'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  2621'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  2622'   00                    MODF:	DB	0		; 1 = unsaved changes
  2623'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  2624'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  2625'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  2626'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  2627'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  2629'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  262A'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  262B'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  262C'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  262D'   0000                  JKCNT:	DW	0		; j/k: count
  262F'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  2631'   0000                  JKMOV:	DW	0		; j: lines moved
  2633'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  2635'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  2636'   00                    JKLST:	DB	0		; j: last byte of the scan
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2637'   0000                  JKVC:	DW	0		; j/k landing: screen column
  2639'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  263B'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  263C'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  263D'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  263E'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  263F'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  2640'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  2642'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  2643'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  2644'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  2646'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  2647'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  2648'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  2649'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
  264A'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  264B'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  264C'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  264D'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  264F'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  2651'   00 00 00              OPSFP:	DB	0,0,0		; operator: the start as a place in the file
  2654'   00 00 00              OPSLO:	DB	0,0,0		; ... where its line starts
  2657'   00 00 00              OPSHI:	DB	0,0,0		; ... where the next line does (OPPGD: the span's
                                				;   high end, whichever line that turned out to be)
  265A'   00 00 00              OPTOGO: DB	0,0,0		; OPPGD: bytes still to take
  265D'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  265F'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  2661'   0000                  CNTV:	DW	0		; motion repeat counter
  2663'   0000                  TTI:	DW	0		; TAILTAB scan index
  2665'   0000                  WKI:	DW	0		; scan index
  2667'   0000                  WKN:	DW	0		; cached LOGLEN
  2669'   0000                  WKTERM: DW	0		; line terminator offset
  266B'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  266D'   00                    WKCLS:	DB	0		; word motion: class of the current run
  266E'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  266F'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  2671'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  2673'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  2675'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2677'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2678'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2679'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  267A'   00                    EXARG:	DB	0		; ex: 0 = no file name given
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  267B'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  267C'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  267E'   00                    WPROW:	DB	0		; :w -- the cursor's row
  267F'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  2680'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  2682'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  2684'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  2685'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2687'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2689'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  268A'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  268B'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  268C'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  268D'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  268E'   00                    PLUSF:	DB	0		; command line: '+' was given
  268F'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  2690'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  2691'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  2692'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  2694'   0000                  YPT:	DW	0		; yy: where the lines came from
  2696'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2698'   0000                  PPT:	DW	0		; p/P: the first line put
  269A'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  269C'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  269D'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  269F'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  26A0'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
  26A1'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  26A2'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  26A3'   00                    FNDCH:	DB	0		; ... and the character it looked for
  26A4'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  26A5'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  26A6'   0000                  FNDN:	DW	0		; occurrences still to count off
  26A8'   0000                  FNDCUR: DW	0		; the cursor it started from
  26AA'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  26AC'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  26AD'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  26B0'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  26B3'   0000                  MKN:	DW	0		; ... how long it is
  26B5'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  26B6'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  26B9'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  26BA'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  26BB'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  26BD'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  26BF'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  26C1'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  26C3'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  26C5'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  26C7'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  26C9'   0000                  SCNT:	DW	0		; searches still to do (the count)
  26CB'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  26CD'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  26CF'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  26D0'   00                    SRNGF:	DB	0		; ex: a line range was given
  26D1'   0000                  SRNG1:	DW	0		; ex: its first line
  26D3'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  26D5'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  26D6'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  26D7'   00                    SANY:	DB	0		; ':s' something in the range has changed
  26D8'   00                    SLCHG:	DB	0		; ':s' this line changed
  26D9'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  26DB'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  26DD'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  26DF'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  26E1'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  26E2'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
                                				;   so INSSTR can splice it
                                
                                	END
