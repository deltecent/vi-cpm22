  0B7B'   B7                    	ORA	A
  0B7C'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B7D'                         DECC:
  0B7D'   CD 0000*              	CALL	PEEKL
  0B80'   DA 0B79'              	JC	IC_END
  0B83'   F5                    	PUSH	PSW
  0B84'   CD 0000*              	CALL	PUTCUR
  0B87'   F1                    	POP	PSW
  0B88'   FE 0A                 	CPI	LF
  0B8A'   3E 00                 	MVI	A,0
  0B8C'   C0                    	RNZ
  0B8D'   CD 0BAD'              	CALL	LNDEC
  0B90'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B93'   DA 0B9B'              	JC	DC_1
  0B96'   FE 0D                 	CPI	CR
  0B98'   CC 0000*              	CZ	PUTCUR
  0B9B'                         DC_1:
  0B9B'   3E 01                 	MVI	A,1
  0B9D'   B7                    	ORA	A
  0B9E'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
