  0AF2'   22 2F1F'              	SHLD	JKCNT
  0AF5'   CD 0EBB'              	CALL	CURRW		; limit = row + NEDIT
  0AF8'   5F                    	MOV	E,A
  0AF9'   16 00                 	MVI	D,0
  0AFB'   3A 0000*              	LDA	NEDIT
  0AFE'   6F                    	MOV	L,A
  0AFF'   26 00                 	MVI	H,0
  0B01'   19                    	DAD	D
  0B02'   EB                    	XCHG			; DE = limit
  0B03'   2A 2F1F'              	LHLD	JKCNT
  0B06'   CD 0000*              	CALL	CMP16		; CY iff limit < count
