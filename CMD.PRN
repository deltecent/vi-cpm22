  2072'   FE 30                 	CPI	'0'
  2074'   CA 206C'              	JZ	AS_PZ
  2077'   FE 31                 	CPI	'1'
  2079'   DA 20A2'              	JC	AS_P1		; zeros and then no digit at all: line 1
  207C'   FE 3A                 	CPI	'9'+1
  207E'   D2 20A2'              	JNC	AS_P1
  2081'                         AS_PD:				; the digits, as typed
  2081'   7E                    	MOV	A,M
  2082'   FE 30                 	CPI	'0'
  2084'   DA 209A'              	JC	AS_PE
  2087'   FE 3A                 	CPI	'9'+1
  2089'   D2 209A'              	JNC	AS_PE
  208C'   79                    	MOV	A,C
  208D'   B7                    	ORA	A
  208E'   CA 20A9'              	JZ	AS_POV
  2091'   0D                    	DCR	C
  2092'   7E                    	MOV	A,M
  2093'   12                    	STAX	D
  2094'   13                    	INX	D
  2095'   23                    	INX	H
  2096'   05                    	DCR	B
  2097'   C2 2081'              	JNZ	AS_PD
  209A'                         AS_PE:
  209A'   AF                    	XRA	A
  209B'   12                    	STAX	D		; the digits end with a 0
  209C'   78                    	MOV	A,B
  209D'   B7                    	ORA	A
  209E'   C8                    	RZ
  209F'   C3 201F'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  20A2'                         AS_P1:
  20A2'   3E 31                 	MVI	A,'1'
  20A4'   12                    	STAX	D
  20A5'   13                    	INX	D
  20A6'   C3 209A'              	JMP	AS_PE
  20A9'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  20A9'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  20AC'   C3 209A'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  20AF'                         ARGGO:
  20AF'   3A 296D'              	LDA	PLUSF
  20B2'   B7                    	ORA	A
  20B3'   C8                    	RZ
  20B4'   21 0000*              	LXI	H,PLUSB
