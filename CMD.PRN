  1EC1'   B7                    	ORA	A
  1EC2'   C9                    	RET
  1EC3'                         GF_CTL:
  1EC3'   BF                    	CMP	A
  1EC4'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1EC5'                         SKIPB:
  1EC5'   7E                    	MOV	A,M
  1EC6'   FE 20                 	CPI	' '
  1EC8'   C2 1ECF'              	JNZ	SB_DN
  1ECB'   23                    	INX	H
  1ECC'   C3 1EC5'              	JMP	SKIPB
