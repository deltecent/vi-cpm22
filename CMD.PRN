  06C5'   CA 06D3'              	JZ	BOL_X		; at 0
  06C8'   2B                    	DCX	H
  06C9'   7E                    	MOV	A,M
  06CA'   FE 0A                 	CPI	LF
  06CC'   CA 06D3'              	JZ	BOL_X
  06CF'   1B                    	DCX	D
  06D0'   C3 06C3'              	JMP	BOL_C
  06D3'                         BOL_X:
  06D3'   EB                    	XCHG
  06D4'   C1                    	POP	B
  06D5'   C9                    	RET
                                
