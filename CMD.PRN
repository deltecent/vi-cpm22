                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D0F'                         CURRW:
  0D0F'   2A 0000*              	LHLD	WINROW
  0D12'   EB                    	XCHG
  0D13'   2A 0000*              	LHLD	LNDLT
  0D16'   19                    	DAD	D		; HL = row (signed)
  0D17'   7C                    	MOV	A,H
  0D18'   B7                    	ORA	A
  0D19'   FA 0D2C'              	JM	CRW_0		; above the screen -> top row
  0D1C'   C2 0D27'              	JNZ	CRW_BT		; far below -> bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D1F'   3A 0000*              	LDA	NEDIT
  0D22'   3D                    	DCR	A		; A = bottom row
  0D23'   BD                    	CMP	L		; CY iff bottom < row
  0D24'   D8                    	RC
  0D25'   7D                    	MOV	A,L
  0D26'   C9                    	RET
  0D27'                         CRW_BT:
  0D27'   3A 0000*              	LDA	NEDIT
  0D2A'   3D                    	DCR	A
  0D2B'   C9                    	RET
  0D2C'                         CRW_0:
  0D2C'   AF                    	XRA	A
  0D2D'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D2E'                         SETRWT:
  0D2E'   2A 0000*              	LHLD	LNDLT
  0D31'   EB                    	XCHG
  0D32'   6F                    	MOV	L,A
  0D33'   26 00                 	MVI	H,0
  0D35'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D38'   22 0000*              	SHLD	WINROW
  0D3B'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D3C'                         MVROW:
  0D3C'   47                    	MOV	B,A
  0D3D'   CD 0D0F'              	CALL	CURRW
  0D40'   90                    	SUB	B		; A = row now - target
  0D41'   C8                    	RZ
  0D42'   DA 0D4B'              	JC	MR_DN
  0D45'   6F                    	MOV	L,A
  0D46'   26 00                 	MVI	H,0
  0D48'   C3 098C'              	JMP	KCORE
  0D4B'                         MR_DN:
  0D4B'   2F                    	CMA
  0D4C'   3C                    	INR	A		; A = target - row now
  0D4D'   6F                    	MOV	L,A
  0D4E'   26 00                 	MVI	H,0
  0D50'   C3 08EF'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D53'                         VC_HIGH:
  0D53'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D56'   2B                    	DCX	H		; row = count - 1
  0D57'   7C                    	MOV	A,H
  0D58'   B7                    	ORA	A
  0D59'   3A 0000*              	LDA	SCBOT
  0D5C'   C2 0D64'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D5F'   BD                    	CMP	L		; CY iff SCBOT < row
  0D60'   DA 0D64'              	JC	VH_GO
  0D63'   7D                    	MOV	A,L
  0D64'                         VH_GO:
  0D64'   CD 0D3C'              	CALL	MVROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D67'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D6A'                         VC_MIDL:
  0D6A'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D6D'   3A 0000*              	LDA	SCBOT
  0D70'   B7                    	ORA	A		; clear CY for the shift
  0D71'   1F                    	RAR			; A = SCBOT / 2
  0D72'   CD 0D3C'              	CALL	MVROW
  0D75'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D78'                         VC_LOWL:
  0D78'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D7B'   2B                    	DCX	H		; count - 1
  0D7C'   3A 0000*              	LDA	SCBOT
  0D7F'   5F                    	MOV	E,A
  0D80'   16 00                 	MVI	D,0
  0D82'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D83'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D86'   3E 00                 	MVI	A,0
  0D88'   D2 0D8F'              	JNC	VL_GO		; at or past the top -> row 0
  0D8B'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D8E'   7D                    	MOV	A,L
  0D8F'                         VL_GO:
  0D8F'   CD 0D3C'              	CALL	MVROW
  0D92'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D95'                         VC_PGDN:
  0D95'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D98'   3A 0000*              	LDA	SCEOF
  0D9B'   B7                    	ORA	A
  0D9C'   CA 0DAA'              	JZ	VPD_N
  0D9F'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0DA2'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0DA3'   C8                    	RZ			; it already is
  0DA4'   CD 0D3C'              	CALL	MVROW
  0DA7'   C3 0DBB'              	JMP	VPD_TP
  0DAA'                         VPD_N:
  0DAA'   3A 0000*              	LDA	NEDIT
  0DAD'   D6 02                 	SUI	2
  0DAF'   CD 0E03'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DB2'   E5                    	PUSH	H
  0DB3'   AF                    	XRA	A
  0DB4'   CD 0D3C'              	CALL	MVROW		; the top line
  0DB7'   E1                    	POP	H
  0DB8'   CD 08EF'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DBB'                         VPD_TP:
  0DBB'   AF                    	XRA	A
  0DBC'   CD 0D2E'              	CALL	SETRWT		; to the top row
  0DBF'   C3 0834'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0DC2'                         VC_PGUP:
  0DC2'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DC5'   3A 0000*              	LDA	SCBOF
  0DC8'   B7                    	ORA	A
  0DC9'   C0                    	RNZ
  0DCA'   3A 0000*              	LDA	NEDIT
  0DCD'   47                    	MOV	B,A
  0DCE'   3A 0000*              	LDA	SCEOF
  0DD1'   B7                    	ORA	A
  0DD2'   CA 0DE3'              	JZ	VPU_2
  0DD5'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DD8'   FE 02                 	CPI	2
  0DDA'   D2 0DE3'              	JNC	VPU_2
  0DDD'   2F                    	CMA
  0DDE'   3C                    	INR	A
  0DDF'   80                    	ADD	B
  0DE0'   C3 0DE6'              	JMP	VPU_P
  0DE3'                         VPU_2:
  0DE3'   78                    	MOV	A,B
  0DE4'   D6 02                 	SUI	2
  0DE6'                         VPU_P:
  0DE6'   CD 0E03'              	CALL	MULSAT		; HL = count * page
  0DE9'   E5                    	PUSH	H
  0DEA'   AF                    	XRA	A
  0DEB'   CD 0D3C'              	CALL	MVROW		; the top line
  0DEE'   E1                    	POP	H
  0DEF'   CD 098C'              	CALL	KCORE		; the new top line
  0DF2'   AF                    	XRA	A
  0DF3'   CD 0D2E'              	CALL	SETRWT		; on the top row
  0DF6'   3A 0000*              	LDA	NEDIT
  0DF9'   3D                    	DCR	A
  0DFA'   6F                    	MOV	L,A
  0DFB'   26 00                 	MVI	H,0
  0DFD'   CD 08EF'              	CALL	JCORE		; the bottom row's line
  0E00'   C3 0834'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0E03'                         MULSAT:
  0E03'   EB                    	XCHG
  0E04'   21 0000               	LXI	H,0
  0E07'   B7                    	ORA	A
  0E08'   C8                    	RZ
  0E09'                         MS_LP:
  0E09'   19                    	DAD	D
  0E0A'   DA 0E12'              	JC	MS_SAT
  0E0D'   3D                    	DCR	A
  0E0E'   C2 0E09'              	JNZ	MS_LP
  0E11'   C9                    	RET
  0E12'                         MS_SAT:
  0E12'   21 FFFF               	LXI	H,0FFFFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E15'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0E16'                         VC_HFDN:
  0E16'   CD 075A'              	CALL	SETMOV
  0E19'   CD 0D0F'              	CALL	CURRW
  0E1C'   32 2A23'              	STA	HFROW
  0E1F'   CD 0E8D'              	CALL	HFCNT		; HL = lines
  0E22'   3A 2A23'              	LDA	HFROW
  0E25'   47                    	MOV	B,A
  0E26'   3A 0000*              	LDA	SCEOF
  0E29'   B7                    	ORA	A
  0E2A'   CA 0E32'              	JZ	VHD_GO
  0E2D'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E30'   B8                    	CMP	B
  0E31'   C8                    	RZ			; the cursor is on it
  0E32'                         VHD_GO:
  0E32'   CD 08EF'              	CALL	JCORE
  0E35'   3A 0000*              	LDA	SCEOF
  0E38'   B7                    	ORA	A
  0E39'   C2 0834'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E3C'   3A 2A23'              	LDA	HFROW
  0E3F'   CD 0D2E'              	CALL	SETRWT
  0E42'   3E 01                 	MVI	A,1
  0E44'   32 0000*              	STA	WFILL		; not past the end of the file
  0E47'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E4A'                         VC_HFUP:
  0E4A'   CD 075A'              	CALL	SETMOV
  0E4D'   CD 0D0F'              	CALL	CURRW
  0E50'   32 2A23'              	STA	HFROW
  0E53'   CD 0E8D'              	CALL	HFCNT		; HL = lines
  0E56'   CD 0E6D'              	CALL	ONFST
  0E59'   C8                    	RZ			; the cursor is on the first line
  0E5A'   CD 098C'              	CALL	KCORE
  0E5D'   3A 0000*              	LDA	SCBOF
  0E60'   B7                    	ORA	A
  0E61'   C2 0834'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E64'   3A 2A23'              	LDA	HFROW
  0E67'   CD 0D2E'              	CALL	SETRWT
  0E6A'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E6D'                         ONFST:
  0E6D'   E5                    	PUSH	H
  0E6E'   2A 0000*              	LHLD	OUTPOS
  0E71'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E72'   B5                    	ORA	L
  0E73'   C2 0E8B'              	JNZ	OF_RET
  0E76'   2A 0000*              	LHLD	TXTBEG
  0E79'   EB                    	XCHG			; DE = TXTBEG
  0E7A'   2A 0000*              	LHLD	GAPBEG
  0E7D'                         OF_LP:
  0E7D'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E80'   CA 0E8B'              	JZ	OF_RET
  0E83'   2B                    	DCX	H
  0E84'   7E                    	MOV	A,M
  0E85'   FE 0A                 	CPI	LF
  0E87'   C2 0E7D'              	JNZ	OF_LP
  0E8A'   B7                    	ORA	A		; NZ
  0E8B'                         OF_RET:
  0E8B'   E1                    	POP	H
  0E8C'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E8D'                         HFCNT:
  0E8D'   2A 2A17'              	LHLD	CMDCNT
  0E90'   7C                    	MOV	A,H
  0E91'   B5                    	ORA	L
  0E92'   CA 0EA9'              	JZ	HFC_AM
  0E95'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E98'   3A 0000*              	LDA	NEDIT
  0E9B'   5F                    	MOV	E,A
  0E9C'   16 00                 	MVI	D,0
  0E9E'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0EA1'   D2 0EA5'              	JNC	HFC_ST
  0EA4'   EB                    	XCHG			; HL = NEDIT
  0EA5'                         HFC_ST:
  0EA5'   7D                    	MOV	A,L
  0EA6'   32 2A24'              	STA	HFAMT
  0EA9'                         HFC_AM:
  0EA9'   3A 2A24'              	LDA	HFAMT
  0EAC'   B7                    	ORA	A
  0EAD'   C2 0EBA'              	JNZ	HFC_HL
  0EB0'   3A 0000*              	LDA	NEDIT
  0EB3'   B7                    	ORA	A
  0EB4'   1F                    	RAR
  0EB5'   B7                    	ORA	A
  0EB6'   C2 0EBA'              	JNZ	HFC_HL
  0EB9'   3C                    	INR	A		; at least one line
  0EBA'                         HFC_HL:
  0EBA'   6F                    	MOV	L,A
  0EBB'   26 00                 	MVI	H,0
  0EBD'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EBE'                         VC_REDR:
  0EBE'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EC1'                         VC_G:
  0EC1'   CD 075A'              	CALL	SETMOV
  0EC4'   CD 0F83'              	CALL	GZONE		; the screen's top line, before the move
  0EC7'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0ECA'   2A 2A17'              	LHLD	CMDCNT
  0ECD'   7C                    	MOV	A,H
  0ECE'   B5                    	ORA	L
  0ECF'   C2 0EE2'              	JNZ	VG_N
  0ED2'   AF                    	XRA	A		; forward
  0ED3'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0ED6'   CD 06EB'              	CALL	BRKOFF
  0ED9'   DA 0703'              	JC	BRKBAK
  0EDC'   CD 0A23'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0EDF'   C3 0F9B'              	JMP	GPLACE
  0EE2'                         VG_N:
  0EE2'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0EE5'                         VG_LN:
  0EE5'   CD 0EF1'              	CALL	GOLN
  0EE8'   CD 06EB'              	CALL	BRKOFF
  0EEB'   DA 0703'              	JC	BRKBAK
  0EEE'   C3 0F9B'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EF1'                         GOLN:
  0EF1'   E5                    	PUSH	H
  0EF2'   CD 0000*              	CALL	CNTLF
  0EF5'   23                    	INX	H		; HL = the cursor's line
  0EF6'   D1                    	POP	D		; DE = the line wanted
  0EF7'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EFA'   DA 0F05'              	JC	GLN_BK
  0EFD'   EB                    	XCHG
  0EFE'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0F01'   AF                    	XRA	A
  0F02'   C3 0F0A'              	JMP	GLN_MV
  0F05'                         GLN_BK:
  0F05'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0F08'   3E FF                 	MVI	A,0FFH
  0F0A'                         GLN_MV:
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F0A'   CD 0000*              	CALL	MVLIND
  0F0D'   CD 0A1D'              	CALL	ATEOF
  0F10'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  0F13'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0F14'                         VC_LG:
  0F14'   CD 075A'              	CALL	SETMOV
  0F17'   3A 2A3F'              	LDA	GSAVE
  0F1A'   B7                    	ORA	A
  0F1B'   C2 0F24'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F1E'   3E 01                 	MVI	A,PG
  0F20'   32 2A3E'              	STA	GPEND
  0F23'   C9                    	RET
  0F24'                         VLG_GG:
  0F24'   CD 0F83'              	CALL	GZONE
  0F27'   CD 06B4'              	CALL	BRKON
  0F2A'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F2D'   C3 0EE5'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F30'                         SUB24:
  0F30'   4F                    	MOV	C,A
  0F31'   7D                    	MOV	A,L
  0F32'   93                    	SUB	E
  0F33'   6F                    	MOV	L,A
  0F34'   7C                    	MOV	A,H
  0F35'   9A                    	SBB	D
  0F36'   67                    	MOV	H,A
  0F37'   79                    	MOV	A,C
  0F38'   98                    	SBB	B
  0F39'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F3A'                         CURFP:
  0F3A'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F3D'                         FPOS:
  0F3D'   C5                    	PUSH	B
  0F3E'   D5                    	PUSH	D
  0F3F'   EB                    	XCHG
  0F40'   2A 0000*              	LHLD	TXTBEG
  0F43'   EB                    	XCHG
  0F44'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F47'   EB                    	XCHG			; DE = that
  0F48'   2A 0000*              	LHLD	OUTPOS
  0F4B'   7C                    	MOV	A,H
  0F4C'   B7                    	ORA	A		; CY = 0
  0F4D'   1F                    	RAR
  0F4E'   47                    	MOV	B,A
  0F4F'   7D                    	MOV	A,L
  0F50'   1F                    	RAR
  0F51'   67                    	MOV	H,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F52'   3E 00                 	MVI	A,0
  0F54'   1F                    	RAR
  0F55'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F56'   19                    	DAD	D
  0F57'   78                    	MOV	A,B
  0F58'   CE 00                 	ACI	0		; A:HL = the position
  0F5A'   D1                    	POP	D
  0F5B'   C1                    	POP	B
  0F5C'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F5D'                         ZSAVE:
  0F5D'   2A 2A17'              	LHLD	CMDCNT
  0F60'   22 2A7D'              	SHLD	ZSVCNT
  0F63'   2A 0000*              	LHLD	AUXCNT
  0F66'   22 2A7F'              	SHLD	ZSVAUX
  0F69'   3A 0000*              	LDA	DIRFLG
  0F6C'   32 2A81'              	STA	ZSVDIR
  0F6F'   C9                    	RET
  0F70'                         ZREST:
  0F70'   2A 2A7D'              	LHLD	ZSVCNT
  0F73'   22 2A17'              	SHLD	CMDCNT
  0F76'   2A 2A7F'              	LHLD	ZSVAUX
  0F79'   22 0000*              	SHLD	AUXCNT
  0F7C'   3A 2A81'              	LDA	ZSVDIR
  0F7F'   32 0000*              	STA	DIRFLG
  0F82'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F83'                         GZONE:
  0F83'   CD 0F5D'              	CALL	ZSAVE
  0F86'   CD 0D0F'              	CALL	CURRW
  0F89'   6F                    	MOV	L,A
  0F8A'   26 00                 	MVI	H,0
  0F8C'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F8F'   CD 0F3D'              	CALL	FPOS
  0F92'   22 0000*              	SHLD	ZTOP
  0F95'   32 0002*              	STA	ZTOP+2
  0F98'   C3 0F70'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F9B'                         GPLACE:
  0F9B'   CD 0F5D'              	CALL	ZSAVE
  0F9E'   CD 0F3A'              	CALL	CURFP
  0FA1'   EB                    	XCHG
  0FA2'   2A 0000*              	LHLD	ZTOP
  0FA5'   EB                    	XCHG
  0FA6'   4F                    	MOV	C,A		; C:HL = the target's position
  0FA7'   3A 0002*              	LDA	ZTOP+2
  0FAA'   47                    	MOV	B,A		; B:DE = the top's
  0FAB'   79                    	MOV	A,C
  0FAC'   CD 0F30'              	CALL	SUB24
  0FAF'   22 2A7A'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FB2'   DA 0FFF'              	JC	GP_UP
  0FB5'   B7                    	ORA	A
  0FB6'   C2 1040'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FB9'   3A 0000*              	LDA	NEDIT
  0FBC'   5F                    	MOV	E,A
  0FBD'   16 00                 	MVI	D,0
  0FBF'   B7                    	ORA	A
  0FC0'   1F                    	RAR
  0FC1'   6F                    	MOV	L,A
  0FC2'   26 00                 	MVI	H,0
  0FC4'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FC5'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FC8'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FCB'   EB                    	XCHG
  0FCC'   2A 2A7A'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FCF'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FD2'   DA 1040'              	JC	GP_MID
  0FD5'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FD8'   01 0000               	LXI	B,0		; BC = lines from the top
  0FDB'                         GP_CNT:
  0FDB'   7A                    	MOV	A,D
  0FDC'   B3                    	ORA	E
  0FDD'   CA 0FEC'              	JZ	GP_DN
  0FE0'   7E                    	MOV	A,M
  0FE1'   23                    	INX	H
  0FE2'   1B                    	DCX	D
  0FE3'   FE 0A                 	CPI	LF
  0FE5'   C2 0FDB'              	JNZ	GP_CNT
  0FE8'   03                    	INX	B
  0FE9'   C3 0FDB'              	JMP	GP_CNT
  0FEC'                         GP_DN:
  0FEC'   3A 0000*              	LDA	NEDIT
  0FEF'   3D                    	DCR	A
  0FF0'   5F                    	MOV	E,A
  0FF1'   16 00                 	MVI	D,0		; DE = the bottom row
  0FF3'   60                    	MOV	H,B
  0FF4'   69                    	MOV	L,C
  0FF5'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FF8'   DA 104A'              	JC	GP_SET		; A = the bottom row
  0FFB'   7D                    	MOV	A,L		; on the screen: its row
  0FFC'   C3 106A'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FFF'                         GP_UP:
  0FFF'   3C                    	INR	A
  1000'   C2 1040'              	JNZ	GP_MID		; 64K bytes or more above
  1003'   2A 2A7A'              	LHLD	ZDIF
  1006'   EB                    	XCHG
  1007'   21 0000               	LXI	H,0
  100A'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  100D'   7C                    	MOV	A,H
  100E'   B5                    	ORA	L
  100F'   CA 1040'              	JZ	GP_MID		; exactly 64K
  1012'   EB                    	XCHG			; DE = bytes to read
  1013'   AF                    	XRA	A
  1014'   32 2A7C'              	STA	ZLF
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1017'   CD 0000*              	CALL	RGET0
  101A'                         GP_RD:
  101A'   CD 0000*              	CALL	RDGET		; (keeps DE)
  101D'   DA 1040'              	JC	GP_MID
  1020'   FE 0A                 	CPI	LF
  1022'   C2 1036'              	JNZ	GP_RN
  1025'   3A 0000*              	LDA	NEDIT
  1028'   B7                    	ORA	A
  1029'   1F                    	RAR
  102A'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  102C'   E5                    	PUSH	H
  102D'   21 2A7C'              	LXI	H,ZLF
  1030'   34                    	INR	M
  1031'   BE                    	CMP	M		; CY iff more lines than that
  1032'   E1                    	POP	H
  1033'   DA 1040'              	JC	GP_MID
  1036'                         GP_RN:
  1036'   1B                    	DCX	D
  1037'   7A                    	MOV	A,D
  1038'   B3                    	ORA	E
  1039'   C2 101A'              	JNZ	GP_RD
  103C'   AF                    	XRA	A		; the top row
  103D'   C3 104A'              	JMP	GP_SET
  1040'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1040'   3E 01                 	MVI	A,1
  1042'   32 0000*              	STA	WFILL		; not past the end of the file
  1045'   3A 0000*              	LDA	NEDIT
  1048'   B7                    	ORA	A
  1049'   1F                    	RAR			; the middle row
  104A'                         GP_SET:
  104A'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  104B'   26 00                 	MVI	H,0
  104D'   22 0000*              	SHLD	WINROW
  1050'   21 0000               	LXI	H,0
  1053'   22 0000*              	SHLD	LNDLT
  1056'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  1059'                         GP_FIN:
  1059'   CD 0F70'              	CALL	ZREST
  105C'   3A 2AA4'              	LDA	GPKEEP
  105F'   B7                    	ORA	A
  1060'   CA 0834'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1063'   AF                    	XRA	A
  1064'   32 2AA4'              	STA	GPKEEP
  1067'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  106A'                         GP_ONS:
  106A'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  106B'   26 00                 	MVI	H,0		; HL = the row it lands on
  106D'   EB                    	XCHG
  106E'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1071'   EB                    	XCHG
  1072'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1075'   22 0000*              	SHLD	LNDLT
  1078'   3E 01                 	MVI	A,R_MOVE
  107A'   32 2A1B'              	STA	RINTENT
  107D'   C3 1059'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  1080'                         OPPEND:
  1080'   AF                    	XRA	A
  1081'   32 2A44'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1084'   3A 2A41'              	LDA	PSAVE
  1087'   FE 63                 	CPI	'c'
  1089'   C2 10A6'              	JNZ	OPP_ND
  108C'   79                    	MOV	A,C
  108D'   FE 77                 	CPI	'w'
  108F'   CA 1097'              	JZ	OPP_W
  1092'   FE 57                 	CPI	'W'
  1094'   C2 10A6'              	JNZ	OPP_ND
  1097'                         OPP_W:
  1097'   CD 1279'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  109A'   DA 10A6'              	JC	OPP_ND
  109D'   79                    	MOV	A,C
  109E'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  10A0'   4F                    	MOV	C,A
  10A1'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  10A3'   32 2A44'              	STA	CWEOL		;   see the clamp in OPA_F
  10A6'                         OPP_ND:
  10A6'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  10A7'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  10A9'   C2 10BD'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10AC'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  10AF'   DA 114D'              	JC	OPABRT
  10B2'   79                    	MOV	A,C
  10B3'   FE 67                 	CPI	'g'
  10B5'   C2 114D'              	JNZ	OPABRT
  10B8'   3E 01                 	MVI	A,PG
  10BA'   32 2A3F'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10BD'                         OPP_NG:
  10BD'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10BE'   21 2A41'              	LXI	H,PSAVE
  10C1'   BE                    	CMP	M
  10C2'   CA 129A'              	JZ	OPLINE
  10C5'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10C6'   CD 12B0'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10C9'   DA 114D'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10CC'   32 2A43'              	STA	OPCLSV
  10CF'   47                    	MOV	B,A		; B = the class
  10D0'   3A 2A41'              	LDA	PSAVE
  10D3'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10D5'   C2 10E1'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10D8'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10D9'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10DB'   C2 1103'              	JNZ	OPP_GO
  10DE'   C3 10EC'              	JMP	OPP_NO
  10E1'                         OPP_NC:
  10E1'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10E3'   C2 1103'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10E6'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10E7'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10E9'   CA 1103'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10EC'                         OPP_NO:
  10EC'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10ED'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10EF'   CA 10FD'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10F2'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10F4'   CA 10FD'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10F7'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10FA'   C2 114D'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10FD'                         OPP_SW:
  10FD'   CD 021C'              	CALL	MKGETK
  1100'   C3 114D'              	JMP	OPABRT
  1103'                         OPP_GO:
  1103'   AF                    	XRA	A
  1104'   32 2A22'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1107'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  110A'   22 2A45'              	SHLD	OPSTA
  110D'   C5                    	PUSH	B
  110E'   21 2A49'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1111'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  1114'   3A 2A43'              	LDA	OPCLSV
  1117'   FE 02                 	CPI	2
  1119'   CC 1150'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  111C'   C1                    	POP	B
  111D'   21 2945'              	LXI	H,CMDTAB
  1120'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1123'   3A 2A41'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1126'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1127'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  112A'   CD 117C'              	CALL	OPSFIX		; where the start is in the window NOW
  112D'   D2 1198'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1130'   22 2A45'              	SHLD	OPSTA
  1133'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1136'   22 2A47'              	SHLD	OPEND2
  1139'   3A 2A41'              	LDA	PSAVE
  113C'   FE 79                 	CPI	'y'
  113E'   CA 17C5'              	JZ	OPYANK		; a yank takes the span without losing it
  1141'   CD 12EB'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1144'   3A 2A41'              	LDA	PSAVE
  1147'   FE 63                 	CPI	'c'
  1149'   C0                    	RNZ
  114A'   C3 1581'              	JMP	SETINS
  114D'                         OPABRT:				; not a motion -> the operator is dropped and
  114D'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1150'                         OPENDS:
  1150'   2A 2A45'              	LHLD	OPSTA
  1153'   CD 05E4'              	CALL	BOL
  1156'   11 2A4C'              	LXI	D,OPSLO
  1159'   CD 116E'              	CALL	OPE_ST
  115C'   2A 2A45'              	LHLD	OPSTA
  115F'   CD 0614'              	CALL	NLSTART
  1162'   11 2A4F'              	LXI	D,OPSHI
  1165'   CD 116E'              	CALL	OPE_ST
  1168'   2A 2A45'              	LHLD	OPSTA
  116B'   C3 0000*              	JMP	GOTO
  116E'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  116E'   D5                    	PUSH	D
  116F'   CD 0000*              	CALL	GOTO
  1172'   E1                    	POP	H
  1173'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1176'                         CURBD:
  1176'   CD 0F3A'              	CALL	CURFP
  1179'   EB                    	XCHG
  117A'   47                    	MOV	B,A
  117B'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  117C'                         OPSFIX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  117C'   21 2A49'              	LXI	H,OPSFP
  117F'   CD 0402'              	CALL	MKLOAD
  1182'   CD 1176'              	CALL	CURBD
  1185'   2A 2AAE'              	LHLD	MKPOS
  1188'   3A 2AB0'              	LDA	MKPOS+2
  118B'   CD 0F30'              	CALL	SUB24
  118E'   B4                    	ORA	H
  118F'   B5                    	ORA	L
  1190'   C2 040F'              	JNZ	MKWIN
  1193'   CD 0000*              	CALL	CUROFF
  1196'   37                    	STC
  1197'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  1198'                         OPPGD:
  1198'   47                    	MOV	B,A
  1199'   3A 2A43'              	LDA	OPCLSV
  119C'   FE 02                 	CPI	2
  119E'   C2 125A'              	JNZ	OPG_NO
  11A1'   3A 2A41'              	LDA	PSAVE
  11A4'   FE 64                 	CPI	'd'
  11A6'   C2 125A'              	JNZ	OPG_NO
  11A9'   04                    	INR	B
  11AA'   CA 11B9'              	JZ	OPG_FW
  11AD'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11B0'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11B3'   CD 0000*              	CALL	GOTO
  11B6'   C3 11D1'              	JMP	OPG_GO
  11B9'                         OPG_FW:
  11B9'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11BC'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  11BF'   11 2A4F'              	LXI	D,OPSHI		;   start line began
  11C2'   CD 116E'              	CALL	OPE_ST
  11C5'   21 2A4C'              	LXI	H,OPSLO
  11C8'   CD 0402'              	CALL	MKLOAD
  11CB'   CD 03CF'              	CALL	MKPAGE
  11CE'   CD 0000*              	CALL	GOTO
  11D1'                         OPG_GO:
  11D1'   CD 1176'              	CALL	CURBD
  11D4'   2A 2A4F'              	LHLD	OPSHI
  11D7'   3A 2A51'              	LDA	OPSHI+2
  11DA'   CD 0F30'              	CALL	SUB24		; A:HL = the bytes to take
  11DD'                         OPG_SV:
  11DD'   22 2A52'              	SHLD	OPTOGO
  11E0'   32 2A54'              	STA	OPTOGO+2
  11E3'                         OPG_NX:
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11E3'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11E6'   CD 0000*              	CALL	SUBHD
  11E9'   EB                    	XCHG			; DE = what the window holds past the cursor
  11EA'   2A 2A52'              	LHLD	OPTOGO
  11ED'   3A 2A54'              	LDA	OPTOGO+2
  11F0'   B7                    	ORA	A
  11F1'   C2 1224'              	JNZ	OPG_PG		; 64K or more to go
  11F4'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11F7'   DA 1224'              	JC	OPG_PG
  11FA'   CA 1224'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11FD'                         OPG_FN:				; the rest of it is here
  11FD'   E5                    	PUSH	H
  11FE'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1201'   CD 0000*              	CALL	CUROFF
  1204'   22 2A55'              	SHLD	OPLO
  1207'   D1                    	POP	D
  1208'   19                    	DAD	D
  1209'   22 2A57'              	SHLD	OPHI
  120C'   CD 13F1'              	CALL	OPDSPN
  120F'   CD 0A1D'              	CALL	ATEOF
  1212'   D2 1273'              	JNC	OPMID
  1215'   CD 0E6D'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1218'   CA 1273'              	JZ	OPMID		;   last line, if there is one -- and the pager
  121B'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  121E'   CD 0000*              	CALL	SETBWD
  1221'   C3 1273'              	JMP	OPMID
  1224'                         OPG_PG:
  1224'   7A                    	MOV	A,D
  1225'   B3                    	ORA	E
  1226'   C2 123F'              	JNZ	OPG_DL
  1229'   CD 0A1D'              	CALL	ATEOF		; nothing held past the cursor
  122C'   21 0000               	LXI	H,0
  122F'   DA 11FD'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1232'   2B                    	DCX	H
  1233'   CD 0000*              	CALL	SETC0
  1236'   CD 0000*              	CALL	GOLINE
  1239'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  123C'   C3 11E3'              	JMP	OPG_NX
  123F'                         OPG_DL:
  123F'   D5                    	PUSH	D
  1240'   21 FFFF               	LXI	H,0FFFFH
  1243'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1246'   E1                    	POP	H
  1247'   E5                    	PUSH	H
  1248'   CD 0000*              	CALL	DELFWD
  124B'   D1                    	POP	D
  124C'   06 00                 	MVI	B,0
  124E'   2A 2A52'              	LHLD	OPTOGO
  1251'   3A 2A54'              	LDA	OPTOGO+2
  1254'   CD 0F30'              	CALL	SUB24
  1257'   C3 11DD'              	JMP	OPG_SV
  125A'                         OPG_NO:
  125A'   0E 07                 	MVI	C,BEL
  125C'   CD 0000*              	CALL	BCONOU
  125F'                         OPG_HM:				; the cursor back where the command found it
  125F'   21 2A49'              	LXI	H,OPSFP
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1262'   CD 0402'              	CALL	MKLOAD
  1265'   CD 03CF'              	CALL	MKPAGE
  1268'   CD 0000*              	CALL	GOTO
  126B'   AF                    	XRA	A
  126C'   32 2A41'              	STA	PSAVE
  126F'   3C                    	INR	A
  1270'   32 2AA4'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1273'                         OPMID:
  1273'   CD 0F5D'              	CALL	ZSAVE
  1276'   C3 1040'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  1279'                         ONWHIT:
  1279'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  127C'   CA 1298'              	JZ	OW_YES
  127F'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1282'   FE 20                 	CPI	' '
  1284'   CA 1298'              	JZ	OW_YES
  1287'   FE 09                 	CPI	TAB
  1289'   CA 1298'              	JZ	OW_YES
  128C'   FE 0D                 	CPI	CR
  128E'   CA 1298'              	JZ	OW_YES
  1291'   FE 0A                 	CPI	LF
  1293'   CA 1298'              	JZ	OW_YES
  1296'   B7                    	ORA	A		; a char to change: CY clear
  1297'   C9                    	RET
  1298'                         OW_YES:
  1298'   37                    	STC
  1299'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  129A'                         OPLINE:
  129A'   3A 2A41'              	LDA	PSAVE
  129D'   FE 63                 	CPI	'c'
  129F'   CA 075A'              	JZ	SETMOV
  12A2'   FE 79                 	CPI	'y'
  12A4'   CA 17A4'              	JZ	VY_YY
  12A7'   21 2A49'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  12AA'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  12AD'   C3 171D'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12B0'                         OPCLS:
  12B0'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12B2'   CA 12BF'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12B5'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12B7'   C2 12D3'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12BA'   06 20                 	MVI	B,20H		; ',' runs the find reversed
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12BC'   C3 12C1'              	JMP	OPC_FK
  12BF'                         OPC_SEM:
  12BF'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12C1'                         OPC_FK:
  12C1'   3A 2A9A'              	LDA	FNDKND
  12C4'   B7                    	ORA	A
  12C5'   37                    	STC
  12C6'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12C7'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12C8'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12CA'   CA 12D1'              	JZ	OPC_EXC
  12CD'   3E 01                 	MVI	A,1
  12CF'   B7                    	ORA	A		; CY clear: a motion, class 1
  12D0'   C9                    	RET
  12D1'                         OPC_EXC:
  12D1'   AF                    	XRA	A		; class 0, CY clear
  12D2'   C9                    	RET
  12D3'                         OPC_TB:
  12D3'   47                    	MOV	B,A
  12D4'   21 1475'              	LXI	H,OPCTAB
  12D7'                         OPC_LP:
  12D7'   7E                    	MOV	A,M
  12D8'   B7                    	ORA	A
  12D9'   CA 12E9'              	JZ	OPC_MS		; end of table -> not a motion
  12DC'   B8                    	CMP	B
  12DD'   CA 12E5'              	JZ	OPC_HT
  12E0'   23                    	INX	H
  12E1'   23                    	INX	H
  12E2'   C3 12D7'              	JMP	OPC_LP
  12E5'                         OPC_HT:
  12E5'   23                    	INX	H
  12E6'   7E                    	MOV	A,M		; class byte
  12E7'   B7                    	ORA	A		; clear CY
  12E8'   C9                    	RET
  12E9'                         OPC_MS:
  12E9'   37                    	STC
  12EA'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12EB'                         OPAPPL:
  12EB'   3A 2A43'              	LDA	OPCLSV
  12EE'   FE 02                 	CPI	2
  12F0'   CA 1459'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12F3'   2A 2A45'              	LHLD	OPSTA
  12F6'   EB                    	XCHG			; DE = start
  12F7'   2A 2A47'              	LHLD	OPEND2		; HL = end
  12FA'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12FD'   DA 130D'              	JC	OPA_F
  1300'   CA 130D'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1303'   22 2A55'              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1306'   EB                    	XCHG
  1307'   22 2A57'              	SHLD	OPHI
  130A'   C3 137E'              	JMP	OPA_C1
  130D'                         OPA_F:
  130D'   EB                    	XCHG			; HL = start, DE = end
  130E'   22 2A55'              	SHLD	OPLO
  1311'   EB                    	XCHG			; HL = end
  1312'   3A 2A43'              	LDA	OPCLSV
  1315'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1317'   CA 137B'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  131A'   FE 01                 	CPI	1
  131C'   C2 1348'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end).
                                	;    'cw' stops at the content end of the line it STARTED on, where a
                                	;    plain 'ce' (and 'de') runs on into the next line's word and 'd%'
                                	;    crosses to its mate -- all four recorded from vim 9.1.  vim's 'cw'
                                	;    is not simply 'ce': the rewrite keeps 'w's own end-of-line stop, so
                                	;    that clamp hangs off CWEOL (the rewrite) and not off the class. ---
  131F'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1320'   22 2A57'              	SHLD	OPHI		; park it: CEND clobbers DE
  1323'   2B                    	DCX	H		; the line it landed on ...
  1324'   3A 2A44'              	LDA	CWEOL
  1327'   B7                    	ORA	A
  1328'   CA 132E'              	JZ	OPA_LE
  132B'   2A 2A55'              	LHLD	OPLO		; ... or, for 'cw', the one it started on
  132E'                         OPA_LE:
  132E'   CD 14FF'              	CALL	CEND		; HL = that line's content end
  1331'   EB                    	XCHG			; DE = it
  1332'   2A 2A57'              	LHLD	OPHI		; HL = hi
  1335'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1338'   D2 136C'              	JNC	OPA_HI		; hi is inside the line: keep it
  133B'   2A 2A55'              	LHLD	OPLO
  133E'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1341'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1344'   EB                    	XCHG			; HL = the content end: the span stops there
  1345'   C3 136C'              	JMP	OPA_HI
  1348'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1348'   22 2A57'              	SHLD	OPHI		; the motion's own end, for now
  134B'   2A 2A55'              	LHLD	OPLO
  134E'   CD 14FF'              	CALL	CEND		; HL = the start line's content end
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1351'   EB                    	XCHG			; DE = that content end
  1352'   3A 2A22'              	LDA	WPULL		; the motion landed on a line's end and was
  1355'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1356'   C2 1362'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1359'   2A 2A57'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  135C'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  135F'   D2 136F'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1362'                         OPA_CE:				;   deletes the word, not all but its last char
  1362'   2A 2A55'              	LHLD	OPLO
  1365'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1368'   CA 140B'              	JZ	OPA_LN
  136B'   EB                    	XCHG			; HL = the content end
  136C'                         OPA_HI:
  136C'   22 2A57'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  136F'                         OPA_DO:
  136F'   CD 13F1'              	CALL	OPDSPN
  1372'   3A 2A41'              	LDA	PSAVE
  1375'   FE 63                 	CPI	'c'
  1377'   C8                    	RZ
  1378'   C3 1510'              	JMP	CLAMPE
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  137B'                         OPA_JP:
  137B'   22 2A57'              	SHLD	OPHI
  137E'                         OPA_C1:
  137E'   CD 13E6'              	CALL	OPSPNL
  1381'   7C                    	MOV	A,H
  1382'   B5                    	ORA	L
  1383'   CA 136F'              	JZ	OPA_DO		; nothing spanned
  1386'   2A 2A57'              	LHLD	OPHI
  1389'   CD 05E4'              	CALL	BOL
  138C'   EB                    	XCHG
  138D'   2A 2A57'              	LHLD	OPHI
  1390'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1393'   C2 136F'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1396'   2A 2A55'              	LHLD	OPLO
  1399'   CD 05E4'              	CALL	BOL
  139C'                         C1_LP:
  139C'   E5                    	PUSH	H
  139D'   EB                    	XCHG
  139E'   2A 2A55'              	LHLD	OPLO
  13A1'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  13A4'   E1                    	POP	H
  13A5'   CA 13C5'              	JZ	C1_LW		; only blanks before lo: whole lines
  13A8'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13A9'   CD 0000*              	CALL	CHARAT
  13AC'   E1                    	POP	H
  13AD'   23                    	INX	H
  13AE'   FE 20                 	CPI	' '
  13B0'   CA 139C'              	JZ	C1_LP
  13B3'   FE 09                 	CPI	TAB
  13B5'   CA 139C'              	JZ	C1_LP
  13B8'                         C1_CH:
  13B8'   2A 2A57'              	LHLD	OPHI		; back over the line break to the content end
  13BB'   2B                    	DCX	H		;   of the line before
  13BC'   CD 14FF'              	CALL	CEND
  13BF'   22 2A57'              	SHLD	OPHI
  13C2'   C3 136F'              	JMP	OPA_DO
  13C5'                         C1_LW:
  13C5'   2A 2A55'              	LHLD	OPLO
  13C8'   CD 05E4'              	CALL	BOL
  13CB'   22 2A55'              	SHLD	OPLO
  13CE'   3A 2A41'              	LDA	PSAVE
  13D1'   FE 63                 	CPI	'c'
  13D3'   CA 13B8'              	JZ	C1_CH
  13D6'   C3 145C'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  13D9'                         SPNBRK:
  13D9'   2A 2A55'              	LHLD	OPLO
  13DC'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  13DF'   EB                    	XCHG			; DE = it
  13E0'   2A 2A57'              	LHLD	OPHI
  13E3'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  13E6'                         OPSPNL:
  13E6'   2A 2A57'              	LHLD	OPHI
  13E9'   EB                    	XCHG
  13EA'   2A 2A55'              	LHLD	OPLO
  13ED'   EB                    	XCHG			; HL = hi, DE = lo
  13EE'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  13F1'                         OPDSPN:
  13F1'   CD 13D9'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  13F4'   F5                    	PUSH	PSW
  13F5'   2A 2A55'              	LHLD	OPLO
  13F8'   CD 0000*              	CALL	GOTO
  13FB'   CD 13E6'              	CALL	OPSPNL		; HL = hi - lo
  13FE'   CD 0000*              	CALL	DELFWD
  1401'   CD 018C'              	CALL	MARKMOD
  1404'   F1                    	POP	PSW
  1405'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  1408'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  140B'                         OPA_LN:
  140B'   3A 2A41'              	LDA	PSAVE
  140E'   FE 63                 	CPI	'c'
  1410'   C2 1419'              	JNZ	OPA_LD
  1413'   2A 2A55'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1416'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  1419'                         OPA_LD:
  1419'   2A 2A55'              	LHLD	OPLO
  141C'   22 2A45'              	SHLD	OPSTA
  141F'   22 2A47'              	SHLD	OPEND2
  1422'   C3 1459'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1425'                         OPALSP:
  1425'   2A 2A45'              	LHLD	OPSTA
  1428'   EB                    	XCHG
  1429'   2A 2A47'              	LHLD	OPEND2
  142C'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  142F'   DA 143C'              	JC	OPAL_F
  1432'   22 2A55'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1435'   EB                    	XCHG
  1436'   22 2A57'              	SHLD	OPHI		; hi-src = start
  1439'   C3 1446'              	JMP	OPAL_R
  143C'                         OPAL_F:
  143C'   EB                    	XCHG			; HL = start
  143D'   22 2A55'              	SHLD	OPLO		; lo-src = start
  1440'   2A 2A47'              	LHLD	OPEND2
  1443'   22 2A57'              	SHLD	OPHI		; hi-src = end
  1446'                         OPAL_R:
  1446'   2A 2A55'              	LHLD	OPLO
  1449'   CD 05E4'              	CALL	BOL
  144C'   22 2A55'              	SHLD	OPLO		; lo = BOL(low line)
  144F'   2A 2A57'              	LHLD	OPHI
  1452'   CD 0614'              	CALL	NLSTART
  1455'   22 2A57'              	SHLD	OPHI		; hi = start of line past the high line
  1458'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  1459'                         OPALIN:
  1459'   CD 1425'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  145C'                         OPDLIN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145C'   CD 13F1'              	CALL	OPDSPN
  145F'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1462'   DA 1472'              	JC	OPDL_NB
  1465'   CD 0000*              	CALL	LOGLEN
  1468'   7C                    	MOV	A,H
  1469'   B5                    	ORA	L
  146A'   C8                    	RZ			; empty buffer
  146B'   2B                    	DCX	H
  146C'   CD 05E4'              	CALL	BOL
  146F'   CD 0000*              	CALL	GOTO
  1472'                         OPDL_NB:
  1472'   C3 0834'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1475'                         OPCTAB:
  1475'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1479'   62 00 42 00           
  147D'   68 00 6C 00           
  1481'   30 00 5E 00           
  1485'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1487'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  148B'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  148F'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1493'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1497'   24 01                 
  1499'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  149D'   47 02 48 02           
  14A1'   4D 02 4C 02           
  14A5'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  14A7'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  14A9'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  14AA'                         VCB_C:
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  14AA'   CD 14B6'              	CALL	VCB_CD
  14AD'   C3 1581'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  14B0'                         VCB_D:
  14B0'   CD 14B6'              	CALL	VCB_CD
  14B3'   C3 1510'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  14B6'                         VCB_CD:
  14B6'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14B9'   22 2A55'              	SHLD	OPLO
  14BC'   CD 0000*              	CALL	CUROFF
  14BF'   CD 14FF'              	CALL	CEND		; to the line's content end, the CR,LF left
  14C2'   22 2A57'              	SHLD	OPHI
  14C5'   C3 13F1'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  14C8'                         VC_X:
  14C8'   CD 08E6'              	CALL	GLSTAL
  14CB'   CD 0760'              	CALL	SETLIN
  14CE'   CD 068B'              	CALL	GETCNT
  14D1'   22 2A59'              	SHLD	CNTV
  14D4'   CD 0000*              	CALL	CUROFF
  14D7'   22 2A5D'              	SHLD	WKI		; cur
  14DA'   CD 14FF'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  14DD'   EB                    	XCHG			; DE = contentend
  14DE'   2A 2A5D'              	LHLD	WKI		; HL = cur
  14E1'   EB                    	XCHG			; HL = contentend, DE = cur
  14E2'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14E5'   7C                    	MOV	A,H
  14E6'   B5                    	ORA	L
  14E7'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14E8'   EB                    	XCHG			; DE = available
  14E9'   2A 2A59'              	LHLD	CNTV		; HL = count
  14EC'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14EF'   DA 14F5'              	JC	VX_USEA
  14F2'   C3 14F6'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14F5'                         VX_USEA:
  14F5'   EB                    	XCHG			; HL = available
  14F6'                         VX_DEL:
  14F6'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14F9'   CD 018C'              	CALL	MARKMOD
  14FC'   C3 1510'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


                                ; the operator span clamp.
  14FF'                         CEND:
  14FF'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  1502'   7C                    	MOV	A,H
  1503'   B5                    	ORA	L
  1504'   C8                    	RZ			; the start of the text: nothing before it
  1505'   2B                    	DCX	H
  1506'   E5                    	PUSH	H
  1507'   CD 0000*              	CALL	CHARAT
  150A'   E1                    	POP	H		; HL = term-1
  150B'   FE 0D                 	CPI	CR
  150D'   C8                    	RZ			; a CR before the LF -> the content ends there
  150E'   23                    	INX	H
  150F'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1510'                         CLAMPE:
  1510'   CD 0000*              	CALL	CUROFF
  1513'   E5                    	PUSH	H
  1514'   CD 0623'              	CALL	EOLC
  1517'   D1                    	POP	D		; DE = cur
  1518'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  151B'   D8                    	RC
  151C'   C8                    	RZ
  151D'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1520'                         VC_I:
  1520'   CD 068B'              	CALL	GETCNT
  1523'   C3 157E'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1526'                         VC_A:
  1526'   CD 068B'              	CALL	GETCNT
  1529'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  152C'   CA 1543'              	JZ	VA_INS
  152F'   EB                    	XCHG			; HL = cur
  1530'   E5                    	PUSH	H
  1531'   CD 0000*              	CALL	CHARAT
  1534'   E1                    	POP	H
  1535'   FE 0A                 	CPI	LF
  1537'   CA 1543'              	JZ	VA_INS		; on the line terminator -> append in place
  153A'   FE 0D                 	CPI	CR
  153C'   CA 1543'              	JZ	VA_INS
  153F'   23                    	INX	H
  1540'   CD 0000*              	CALL	GOTO
  1543'                         VA_INS:
  1543'   C3 157E'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1546'                         VCB_A:
  1546'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1549'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  154C'   E5                    	PUSH	H
  154D'   CD 0000*              	CALL	CHARAT
  1550'   E1                    	POP	H
  1551'   FE 0D                 	CPI	CR
  1553'   CA 155C'              	JZ	VBA_IN		; an empty line: insert at its start
  1556'   FE 0A                 	CPI	LF
  1558'   CA 155C'              	JZ	VBA_IN
  155B'   23                    	INX	H		; past the last content char
  155C'                         VBA_IN:
  155C'   CD 0000*              	CALL	GOTO
  155F'   C3 157E'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1562'                         VCB_I:
  1562'   CD 068B'              	CALL	GETCNT
  1565'   CD 0834'              	CALL	FNBLNK
  1568'   CD 0000*              	CALL	CUROFF
  156B'   E5                    	PUSH	H
  156C'   CD 0000*              	CALL	CHARAT
  156F'   E1                    	POP	H
  1570'   FE 20                 	CPI	' '
  1572'   CA 157A'              	JZ	VBI_SK
  1575'   FE 09                 	CPI	TAB
  1577'   C2 157E'              	JNZ	SETINM
  157A'                         VBI_SK:
  157A'   23                    	INX	H		; blanks only: past the last of them
  157B'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  157E'                         SETINM:
  157E'   CD 075A'              	CALL	SETMOV
  1581'                         SETINS:
  1581'   3E 01                 	MVI	A,EM_INS
  1583'   32 2A16'              	STA	EDMODE
  1586'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1587'                         ATCEND:
  1587'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  158A'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  158B'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  158E'   FE 0D                 	CPI	CR
  1590'   C8                    	RZ
  1591'   FE 0A                 	CPI	LF
  1593'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1594'                         OPNBRK:
  1594'   CD 1E86'              	CALL	PUTBRK
  1597'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  159A'   23                    	INX	H
  159B'   22 0000*              	SHLD	LNDLT
  159E'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  15A1'                         ENDBRK:
  15A1'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  15A4'   C0                    	RNZ
  15A5'   CD 1594'              	CALL	OPNBRK
  15A8'   CD 0000*              	CALL	CUROFF
  15AB'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  15AC'   2B                    	DCX	H		;   line, with its own terminator after it
  15AD'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  15B0'                         VC_O:
  15B0'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15B3'   CD 14FF'              	CALL	CEND
  15B6'   CD 0000*              	CALL	GOTO
  15B9'   CD 1594'              	CALL	OPNBRK
  15BC'   CD 15A1'              	CALL	ENDBRK		; a last line with no line end: the opened line
  15BF'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  15C2'   C3 1581'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  15C5'                         VCB_O:
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15C5'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15C8'   CD 05E4'              	CALL	BOL
  15CB'   CD 0000*              	CALL	GOTO
  15CE'   CD 1594'              	CALL	OPNBRK
  15D1'   CD 0000*              	CALL	CUROFF
  15D4'   2B                    	DCX	H
  15D5'   2B                    	DCX	H
  15D6'   CD 0000*              	CALL	GOTO
  15D9'   CD 0766'              	CALL	SETILN
  15DC'   C3 1581'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  15DF'                         VCB_J:
  15DF'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15E2'   CD 14FF'              	CALL	CEND		; the join point: this line's content end
  15E5'   22 2A55'              	SHLD	OPLO
  15E8'   CD 0000*              	CALL	CUROFF
  15EB'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15EE'   E5                    	PUSH	H
  15EF'   CD 0000*              	CALL	LOGLEN
  15F2'   D1                    	POP	D		; DE = that start
  15F3'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15F6'   CA 075A'              	JZ	SETMOV
  15F9'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15FA'                         VJ_WS:
  15FA'   E5                    	PUSH	H
  15FB'   CD 0000*              	CALL	LOGLEN
  15FE'   D1                    	POP	D		; DE = the scan
  15FF'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1602'   CA 1619'              	JZ	VJ_DEL
  1605'   EB                    	XCHG			; HL = the scan
  1606'   E5                    	PUSH	H
  1607'   CD 0000*              	CALL	CHARAT
  160A'   E1                    	POP	H
  160B'   FE 20                 	CPI	' '
  160D'   CA 1615'              	JZ	VJ_SKIP
  1610'   FE 09                 	CPI	TAB
  1612'   C2 1619'              	JNZ	VJ_DEL
  1615'                         VJ_SKIP:
  1615'   23                    	INX	H
  1616'   C3 15FA'              	JMP	VJ_WS
  1619'                         VJ_DEL:
  1619'   22 2A57'              	SHLD	OPHI
  161C'   CD 13F1'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  161F'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1622'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1625'   CA 1510'              	JZ	CLAMPE
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  1628'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  162B'   FE 0D                 	CPI	CR
  162D'   CA 1510'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1630'   FE 0A                 	CPI	LF
  1632'   CA 1510'              	JZ	CLAMPE
  1635'   FE 29                 	CPI	')'
  1637'   CA 1510'              	JZ	CLAMPE		; vim puts no space before a ')'
  163A'   CD 0000*              	CALL	CUROFF
  163D'   7C                    	MOV	A,H
  163E'   B5                    	ORA	L
  163F'   CA 1655'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1642'   2B                    	DCX	H
  1643'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1646'   FE 20                 	CPI	' '
  1648'   CA 1510'              	JZ	CLAMPE
  164B'   FE 09                 	CPI	TAB
  164D'   CA 1510'              	JZ	CLAMPE
  1650'   FE 0A                 	CPI	LF
  1652'   CA 1510'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1655'                         VJ_SP:
  1655'   3E 20                 	MVI	A,' '
  1657'   CD 0000*              	CALL	PUTGAP
  165A'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  165D'   2B                    	DCX	H
  165E'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1661'                         VC_TILD:
  1661'   CD 068B'              	CALL	GETCNT
  1664'   CD 0760'              	CALL	SETLIN		; only this row changes
  1667'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  166A'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  166D'   CA 075A'              	JZ	SETMOV
  1670'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1673'   FE 0D                 	CPI	CR
  1675'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  1678'   FE 0A                 	CPI	LF
  167A'   CA 075A'              	JZ	SETMOV
  167D'   47                    	MOV	B,A
  167E'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1680'   FE 41                 	CPI	'A'
  1682'   DA 168E'              	JC	VT_PUT		; below 'A': no case
  1685'   FE 5B                 	CPI	'Z'+1
  1687'   D2 168E'              	JNC	VT_PUT		; above 'Z': no case
  168A'   78                    	MOV	A,B
  168B'   EE 20                 	XRI	20H		; a letter: flip the case bit
  168D'   47                    	MOV	B,A
  168E'                         VT_PUT:
  168E'   78                    	MOV	A,B
  168F'   32 2A66'              	STA	VRCH		; the calls below do not preserve B
  1692'   CD 018C'              	CALL	MARKMOD
  1695'   21 0001               	LXI	H,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1698'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  169B'   3A 2A66'              	LDA	VRCH
  169E'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  16A1'   C3 1510'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  16A4'                         VC_R:
  16A4'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  16A7'   3E 03                 	MVI	A,PR
  16A9'   32 2A3E'              	STA	GPEND
  16AC'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  16AD'                         VR_DO:
  16AD'   AF                    	XRA	A
  16AE'   32 2A3E'              	STA	GPEND
  16B1'   79                    	MOV	A,C
  16B2'   32 2A66'              	STA	VRCH		; the calls below do not preserve C
  16B5'   CD 0760'              	CALL	SETLIN		; only this row changed
  16B8'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16BB'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16BE'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  16C1'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  16C4'   FE 0D                 	CPI	CR
  16C6'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  16C9'   FE 0A                 	CPI	LF
  16CB'   CA 075A'              	JZ	SETMOV
  16CE'   CD 018C'              	CALL	MARKMOD
  16D1'   21 0001               	LXI	H,1
  16D4'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  16D7'   3A 2A66'              	LDA	VRCH
  16DA'   FE 0D                 	CPI	CR
  16DC'   CA 16E9'              	JZ	VR_CR
  16DF'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16E2'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16E5'   2B                    	DCX	H		;   out, which moves every logical offset
  16E6'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16E9'                         VR_CR:
  16E9'   CD 1594'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16EC'   CD 15A1'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16EF'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16F2'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16F4'   32 2A1E'              	STA	ILABOV
  16F7'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16F8'                         VCB_R:
  16F8'   CD 068B'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16FB'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  16FE'   21 0000               	LXI	H,0
  1701'   22 2A67'              	SHLD	RPDEL		; nothing of ours to put back yet
  1704'   22 2A69'              	SHLD	RPAPP
  1707'   3E 02                 	MVI	A,EM_REP
  1709'   32 2A16'              	STA	EDMODE
  170C'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  170D'                         VC_D:
  170D'   3E 64                 	MVI	A,'d'
  170F'   32 2A40'              	STA	PENDOP
  1712'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1715'                         VC_C:
  1715'   3E 63                 	MVI	A,'c'
  1717'   32 2A40'              	STA	PENDOP
  171A'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  171D'                         VD_DD:
  171D'   CD 08E6'              	CALL	GLSTAL
  1720'   CD 068B'              	CALL	GETCNT
  1723'   22 2A59'              	SHLD	CNTV
  1726'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1728'   32 2A42'              	STA	DDSNG
  172B'   2B                    	DCX	H
  172C'   7C                    	MOV	A,H
  172D'   B5                    	ORA	L
  172E'   C2 1739'              	JNZ	VDD_LS
  1731'   3E 01                 	MVI	A,1
  1733'   32 2A42'              	STA	DDSNG
  1736'   C3 173F'              	JMP	VDD_GO
  1739'                         VDD_LS:
  1739'   CD 089F'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  173C'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  173F'                         VDD_GO:
  173F'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1742'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1745'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1748'   CD 20E9'              	CALL	COPY12		;   every mark in the lines has closed up by then
  174B'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  174E'   2A 2A59'              	LHLD	CNTV
  1751'   CD 0000*              	CALL	SETC0
  1754'                         VDD_FW:
  1754'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1757'   DA 18A5'              	JC	QREFUS		; ... which has no room for them
  175A'   CD 06A0'              	CALL	CNTTST
  175D'   C2 1754'              	JNZ	VDD_FW
  1760'   CD 018C'              	CALL	MARKMOD
  1763'   CD 0A1D'              	CALL	ATEOF
  1766'   D2 1781'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1769'   3E 00                 	MVI	A,0
  176B'   32 2A42'              	STA	DDSNG		; deleted to the end: full repaint
  176E'   CD 0E6D'              	CALL	ONFST
  1771'   CA 0834'              	JZ	FNBLNK		; nothing left before it
  1774'   21 0001               	LXI	H,1		; onto the new last line
  1777'   CD 0000*              	CALL	SETBWD
  177A'   2A 0000*              	LHLD	LNDLT
  177D'   2B                    	DCX	H
  177E'   22 0000*              	SHLD	LNDLT
  1781'                         VDD_UP:
  1781'   CD 0834'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1784'   3A 2A42'              	LDA	DDSNG
  1787'   B7                    	ORA	A
  1788'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1789'   3E 03                 	MVI	A,R_DLIN
  178B'   32 2A1B'              	STA	RINTENT
  178E'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  178F'                         QEMPTY:
  178F'   2A 0000*              	LHLD	QBEG
  1792'   EB                    	XCHG
  1793'   2A 0000*              	LHLD	QEND
  1796'   7C                    	MOV	A,H
  1797'   BA                    	CMP	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1798'   C0                    	RNZ
  1799'   7D                    	MOV	A,L
  179A'   BB                    	CMP	E
  179B'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  179C'                         VC_Y:
  179C'   3E 79                 	MVI	A,'y'
  179E'   32 2A40'              	STA	PENDOP
  17A1'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  17A4'                         VY_YY:
  17A4'   21 2A49'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  17A7'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  17AA'   CD 0000*              	CALL	CUROFF
  17AD'   22 2A8A'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  17B0'   CD 05E4'              	CALL	BOL
  17B3'   22 2A8C'              	SHLD	YPT		; where the lines come from, to put them back
  17B6'   CD 190B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17B9'   CD 194E'              	CALL	YNCOPY		; copied where they lie, if that can be done
  17BC'   D2 1912'              	JNC	YNDONE
  17BF'   21 171D'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  17C2'   C3 17EE'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  17C5'                         OPYANK:
  17C5'   CD 1425'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  17C8'   2A 2A45'              	LHLD	OPSTA
  17CB'   EB                    	XCHG			; DE = start
  17CC'   2A 2A47'              	LHLD	OPEND2		; HL = end
  17CF'   CD 0000*              	CALL	CMP16		; CY iff start < end
  17D2'   D2 17D6'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  17D5'   EB                    	XCHG			; ... otherwise the start is
  17D6'                         OPY_LO:
  17D6'   22 2A8A'              	SHLD	YOFF
  17D9'   2A 2A55'              	LHLD	OPLO
  17DC'   22 2A8C'              	SHLD	YPT		; where the lines come from, to put them back
  17DF'   CD 190B'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17E2'   CD 19C6'              	CALL	YNSPAN		; copied where they lie, if there is room
  17E5'   D2 1912'              	JNC	YNDONE
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17E8'   21 18CC'              	LXI	H,YSPAN
  17EB'   C3 17EE'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  17EE'                         YKGO:
  17EE'   22 2AB3'              	SHLD	YACT
  17F1'   2A 2A8C'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17F4'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17F5'   2A 2A8A'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17F8'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17FB'   22 2AB9'              	SHLD	YCOL		;   them -- but a distance within the lines does
  17FE'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1801'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1802'   2A 2A8C'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1805'   EB                    	XCHG			;   window as it was, then names other text
  1806'   E1                    	POP	H
  1807'   CD 0000*              	CALL	SUBHD
  180A'   EB                    	XCHG			; DE = how far behind the cursor they start
  180B'   CD 0F3A'              	CALL	CURFP
  180E'   06 00                 	MVI	B,0
  1810'   CD 0F30'              	CALL	SUB24
  1813'   22 2ABB'              	SHLD	YPFP
  1816'   32 2ABD'              	STA	YPFP+2
  1819'   3A 2A1A'              	LDA	MODF
  181C'   32 2A87'              	STA	YMODF
  181F'   3A 2A33'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1822'   32 2A88'              	STA	YDCHG		;   a yank must not become the last change
  1825'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1828'   32 2A89'              	STA	YURPL		;   back are not a change to undo either
  182B'   3E 01                 	MVI	A,1
  182D'   32 0000*              	STA	UNDRPL
  1830'   32 2AB2'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1833'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1836'   22 2A95'              	SHLD	YLDLT
  1839'   CD 0000*              	CALL	LOGLEN
  183C'   22 2AB7'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  183F'   2A 2AB3'              	LHLD	YACT
  1842'   CD 18A4'              	CALL	YCALL		; the lines out of the file, into the register
  1845'   3A 2A82'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1848'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  184A'   CA 1888'              	JZ	YK_RF		;   cursor: only the flags are still owed
  184D'   CD 0000*              	CALL	LOGLEN
  1850'   EB                    	XCHG
  1851'   2A 2AB7'              	LHLD	YWAS
  1854'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1857'   CA 1869'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  185A'   21 2ABB'              	LXI	H,YPFP		; back to where they came from, by its place in
  185D'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  1860'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1863'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1866'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1869'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1869'   2A 2ABB'              	LHLD	YPFP		;   cursor is still owed its place)
  186C'   EB                    	XCHG
  186D'   2A 2AB9'              	LHLD	YCOL
  1870'   19                    	DAD	D
  1871'   22 2AAE'              	SHLD	MKPOS
  1874'   3A 2ABD'              	LDA	YPFP+2
  1877'   CE 00                 	ACI	0
  1879'   32 2AB0'              	STA	MKPOS+2
  187C'   CD 03CF'              	CALL	MKPAGE
  187F'   CD 0000*              	CALL	GOTO
  1882'                         YK_RST:
  1882'   2A 2A95'              	LHLD	YLDLT
  1885'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1888'                         YK_RF:
  1888'   3A 2A87'              	LDA	YMODF
  188B'   32 2A1A'              	STA	MODF
  188E'   3A 2A88'              	LDA	YDCHG
  1891'   32 2A33'              	STA	DOTCHG
  1894'   3A 2A89'              	LDA	YURPL
  1897'   32 0000*              	STA	UNDRPL
  189A'   AF                    	XRA	A
  189B'   32 2AB2'              	STA	MKHOLD
  189E'   CD 08E6'              	CALL	GLSTAL
  18A1'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  18A4'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  18A5'                         QREFUS:
  18A5'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  18A8'   CD 178F'              	CALL	QEMPTY
  18AB'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  18AE'   CD 0000*              	CALL	QKILL
  18B1'   3A 2AB2'              	LDA	MKHOLD
  18B4'   B7                    	ORA	A
  18B5'   C2 18C4'              	JNZ	QRF_Y
  18B8'   21 0000*              	LXI	H,MKSAV
  18BB'   11 0000*              	LXI	D,MKTAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  18BE'   CD 20E9'              	CALL	COPY12
  18C1'   CD 0000*              	CALL	UNDCLR
  18C4'                         QRF_Y:
  18C4'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  18C6'   32 2A82'              	STA	MSGWHT
  18C9'   C3 125F'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  18CC'                         YSPAN:
  18CC'   CD 08E6'              	CALL	GLSTAL
  18CF'   CD 13E6'              	CALL	OPSPNL		; HL = the span's length
  18D2'   22 2AB5'              	SHLD	YTGT
  18D5'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  18D8'   EB                    	XCHG			; DE = it
  18D9'   2A 2AB5'              	LHLD	YTGT
  18DC'   EB                    	XCHG			; HL = the text's, DE = the span's
  18DD'   CD 0000*              	CALL	SUBHD
  18E0'   22 2AB5'              	SHLD	YTGT		; what the text is left at when the span is out
  18E3'   2A 2A55'              	LHLD	OPLO
  18E6'   CD 0000*              	CALL	GOTO
  18E9'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18EC'                         YS_LP:
  18EC'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  18EF'   CD 0000*              	CALL	SETC0
  18F2'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18F5'   DA 18A5'              	JC	QREFUS		; ... which has no room for it
  18F8'   CD 0000*              	CALL	LOGLEN
  18FB'   EB                    	XCHG			; DE = what is left
  18FC'   2A 2AB5'              	LHLD	YTGT
  18FF'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  1902'   DA 1908'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1905'   C2 18EC'              	JNZ	YS_LP		;   but never spin here if it ever did
  1908'                         YS_END:
  1908'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  190B'                         YNPRE:
  190B'   2A 0000*              	LHLD	PGTOPM
  190E'   22 2ABE'              	SHLD	YNPG
  1911'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1912'                         YNDONE:
  1912'   2A 2A8A'              	LHLD	YOFF
  1915'   CD 0000*              	CALL	GOTO
  1918'   2A 0000*              	LHLD	PGTOPM
  191B'   EB                    	XCHG
  191C'   2A 2ABE'              	LHLD	YNPG
  191F'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1922'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  1925'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1928'                         YNROOM:
  1928'   11 0100               	LXI	D,100H
  192B'   19                    	DAD	D
  192C'   D8                    	RC			; within a chunk of 64K: no arena holds that
  192D'   E5                    	PUSH	H		; the span plus its slack
  192E'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1931'   EB                    	XCHG			; HL = free
  1932'   D1                    	POP	D		; DE = the span plus its slack
  1933'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1936'   DA 193E'              	JC	YNR_OK
  1939'   CA 193E'              	JZ	YNR_OK
  193C'   37                    	STC			; not enough: the delete-and-put-back path
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  193D'   C9                    	RET
  193E'                         YNR_OK:
  193E'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  193F'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1940'                         YNGO:
  1940'   C5                    	PUSH	B
  1941'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  1944'   CD 08E6'              	CALL	GLSTAL
  1947'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  194A'   C1                    	POP	B
  194B'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  194E'                         YNCOPY:
  194E'   2A 2A17'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1951'   7C                    	MOV	A,H		;   the count itself
  1952'   B5                    	ORA	L
  1953'   C2 1959'              	JNZ	YNC_HV
  1956'   21 0001               	LXI	H,1
  1959'                         YNC_HV:
  1959'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  195A'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  195B'   B4                    	ORA	H
  195C'   CA 1967'              	JZ	YNC_M
  195F'   E5                    	PUSH	H
  1960'   CD 089F'              	CALL	ONLAST		; vim: a count over one on the last line does
  1963'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1964'   DA 1979'              	JC	YNC_RF
  1967'                         YNC_M:
  1967'   E5                    	PUSH	H
  1968'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  196B'   E1                    	POP	H
  196C'   CD 1981'              	CALL	YNLINE		; BC = the span, measured where it stands
  196F'   D8                    	RC			; not measurable here: let the pager answer it
  1970'   60                    	MOV	H,B
  1971'   69                    	MOV	L,C
  1972'   CD 1928'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1975'   D8                    	RC			; no: the delete-and-put-back path
  1976'   C3 1940'              	JMP	YNGO
  1979'                         YNC_RF:
  1979'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  197C'   CD 08E6'              	CALL	GLSTAL		;   register alone, and that is the command
  197F'   B7                    	ORA	A		; NC: done
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  1980'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1981'                         YNLINE:
  1981'   22 2AC0'              	SHLD	YNCNT		; the lines it still wants
  1984'   2A 0000*              	LHLD	GAPEND
  1987'                         YNL_LP:
  1987'   EB                    	XCHG			; DE = the scan
  1988'   2A 0000*              	LHLD	TXTEND
  198B'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  198E'   EB                    	XCHG			; HL = the scan
  198F'   D2 19AF'              	JNC	YNL_EN		; the resident text ran out
  1992'   7E                    	MOV	A,M
  1993'   23                    	INX	H
  1994'   FE 0A                 	CPI	LF
  1996'   C2 1987'              	JNZ	YNL_LP
  1999'   E5                    	PUSH	H
  199A'   2A 2AC0'              	LHLD	YNCNT
  199D'   2B                    	DCX	H
  199E'   22 2AC0'              	SHLD	YNCNT
  19A1'   7C                    	MOV	A,H
  19A2'   B5                    	ORA	L
  19A3'   E1                    	POP	H
  19A4'   C2 1987'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  19A7'   EB                    	XCHG			; DE = past the last of them
  19A8'   2A 0000*              	LHLD	GAPEND
  19AB'   EB                    	XCHG			; HL = past them, DE = GAPEND
  19AC'   C3 19BD'              	JMP	YNL_BC
  19AF'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  19AF'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  19B2'   C2 19C4'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  19B5'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  19B8'   EB                    	XCHG			;   count clamps to it as vim's does
  19B9'   2A 0000*              	LHLD	GAPEND
  19BC'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  19BD'                         YNL_BC:
  19BD'   CD 0000*              	CALL	SUBHD		; HL = the span
  19C0'   44                    	MOV	B,H
  19C1'   4D                    	MOV	C,L
  19C2'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  19C3'   C9                    	RET
  19C4'                         YNL_NO:
  19C4'   37                    	STC
  19C5'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


                                ; already, so there is no question here of where it ends -- only of room.
  19C6'                         YNSPAN:
  19C6'   CD 13E6'              	CALL	OPSPNL		; HL = the span's length
  19C9'   44                    	MOV	B,H
  19CA'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  19CB'   CD 1928'              	CALL	YNROOM
  19CE'   D8                    	RC			; no room: the delete-and-put-back path
  19CF'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  19D0'   2A 2A55'              	LHLD	OPLO
  19D3'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  19D6'   C1                    	POP	B
  19D7'   C3 1940'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  19DA'                         VC_P:
  19DA'   CD 178F'              	CALL	QEMPTY
  19DD'   CA 1A95'              	JZ	VP_BEL
  19E0'   CD 068B'              	CALL	GETCNT
  19E3'   22 2A8E'              	SHLD	PCNT
  19E6'   CD 0000*              	CALL	CUROFF
  19E9'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19EC'   C3 1A01'              	JMP	VP_GO
  19EF'                         VCB_P:
  19EF'   CD 178F'              	CALL	QEMPTY
  19F2'   CA 1A95'              	JZ	VP_BEL
  19F5'   CD 068B'              	CALL	GETCNT
  19F8'   22 2A8E'              	SHLD	PCNT
  19FB'   CD 0000*              	CALL	CUROFF
  19FE'   CD 05E4'              	CALL	BOL
  1A01'                         VP_GO:
  1A01'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1A04'   CD 0000*              	CALL	CUROFF
  1A07'   EB                    	XCHG
  1A08'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1A0B'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A0E'   DA 1A23'              	JC	VP_IN
  1A11'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A12'   7C                    	MOV	A,H
  1A13'   B5                    	ORA	L
  1A14'   CA 1A20'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A17'   2B                    	DCX	H
  1A18'   CD 0000*              	CALL	CHARAT
  1A1B'   FE 0A                 	CPI	LF
  1A1D'   CA 1A23'              	JZ	VP_IN
  1A20'                         VP_BRK:
  1A20'   CD 1594'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A23'                         VP_IN:
  1A23'   CD 0000*              	CALL	CUROFF
  1A26'   22 2A90'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A29'   2A 0000*              	LHLD	QBEG
  1A2C'   EB                    	XCHG
  1A2D'   2A 0000*              	LHLD	QEND
  1A30'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1A33'   EB                    	XCHG
  1A34'   22 2A92'              	SHLD	PLFS
  1A37'   2A 2A8E'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1A3A'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1A3B'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1A3C'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1A3E'   C2 1A42'              	JNZ	VP_PZ
  1A41'   7D                    	MOV	A,L
  1A42'                         VP_PZ:
  1A42'   32 2A94'              	STA	PCPY
  1A45'                         VP_LP:
  1A45'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A48'   2A 0000*              	LHLD	LNDLT
  1A4B'   EB                    	XCHG
  1A4C'   2A 2A92'              	LHLD	PLFS
  1A4F'   19                    	DAD	D
  1A50'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1A53'   2A 2A8E'              	LHLD	PCNT
  1A56'   2B                    	DCX	H
  1A57'   22 2A8E'              	SHLD	PCNT
  1A5A'   7C                    	MOV	A,H
  1A5B'   B5                    	ORA	L
  1A5C'   C2 1A45'              	JNZ	VP_LP
  1A5F'   CD 018C'              	CALL	MARKMOD
  1A62'   2A 2A90'              	LHLD	PPT
  1A65'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1A68'   CD 08E6'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A6B'   3A 2A94'              	LDA	PCPY
  1A6E'   B7                    	ORA	A
  1A6F'   CA 0834'              	JZ	FNBLNK
  1A72'   2A 2A92'              	LHLD	PLFS
  1A75'   7C                    	MOV	A,H
  1A76'   B7                    	ORA	A
  1A77'   C2 0834'              	JNZ	FNBLNK
  1A7A'   3A 2A94'              	LDA	PCPY
  1A7D'   CD 0E03'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A80'   7C                    	MOV	A,H
  1A81'   B7                    	ORA	A
  1A82'   C2 0834'              	JNZ	FNBLNK
  1A85'   7D                    	MOV	A,L
  1A86'   B7                    	ORA	A
  1A87'   CA 0834'              	JZ	FNBLNK
  1A8A'   F5                    	PUSH	PSW
  1A8B'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A8E'   F1                    	POP	PSW
  1A8F'   32 2A1C'              	STA	ILN		; ... which the lines put now replace
  1A92'   C3 0834'              	JMP	FNBLNK
  1A95'                         VP_BEL:
  1A95'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A98'   0E 07                 	MVI	C,BEL
  1A9A'   CD 0000*              	CALL	BCONOU
  1A9D'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1AA0'                         VIREP:
  1AA0'   78                    	MOV	A,B
  1AA1'   FE 01                 	CPI	KT_ACT
  1AA3'   CA 1BD0'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1AA6'   FE 02                 	CPI	KT_CHAR
  1AA8'   C0                    	RNZ			; ignore anything else
  1AA9'   79                    	MOV	A,C
  1AAA'   FE 0D                 	CPI	CR
  1AAC'   CA 1B10'              	JZ	VP_CR
  1AAF'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1AB1'   CA 1B10'              	JZ	VP_CR
  1AB4'   FE 08                 	CPI	BS
  1AB6'   CA 1B1C'              	JZ	VP_BS
  1AB9'   FE 7F                 	CPI	DEL
  1ABB'   CA 1B1C'              	JZ	VP_BS
  1ABE'   32 2A66'              	STA	VRCH		; the calls below do not preserve C
  1AC1'   CD 0760'              	CALL	SETLIN		; this row changed
  1AC4'   CD 018C'              	CALL	MARKMOD
  1AC7'   CD 1587'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1ACA'   CA 1B02'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1ACD'   3A 2A66'              	LDA	VRCH
  1AD0'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1AD3'   2A 2A67'              	LHLD	RPDEL
  1AD6'   7C                    	MOV	A,H
  1AD7'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1AD8'   CA 1AEE'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1ADB'   2A 0000*              	LHLD	GAPEND
  1ADE'   EB                    	XCHG
  1ADF'   2A 2A6B'              	LHLD	RPGE
  1AE2'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1AE5'   CA 1AEE'              	JZ	VP_OVW
  1AE8'   21 0000               	LXI	H,0
  1AEB'   22 2A67'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AEE'                         VP_OVW:
  1AEE'   21 0001               	LXI	H,1
  1AF1'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1AF4'   2A 0000*              	LHLD	GAPEND
  1AF7'   22 2A6B'              	SHLD	RPGE
  1AFA'   2A 2A67'              	LHLD	RPDEL
  1AFD'   23                    	INX	H
  1AFE'   22 2A67'              	SHLD	RPDEL
  1B01'   C9                    	RET
  1B02'                         VP_APP:
  1B02'   3A 2A66'              	LDA	VRCH
  1B05'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1B08'   2A 2A69'              	LHLD	RPAPP
  1B0B'   23                    	INX	H
  1B0C'   22 2A69'              	SHLD	RPAPP
  1B0F'   C9                    	RET
  1B10'                         VP_CR:
  1B10'   21 0000               	LXI	H,0
  1B13'   22 2A67'              	SHLD	RPDEL		; a line break ends what BS can put back
  1B16'   22 2A69'              	SHLD	RPAPP
  1B19'   C3 1BA6'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1B1C'                         VP_BS:
  1B1C'   2A 2A69'              	LHLD	RPAPP
  1B1F'   7C                    	MOV	A,H
  1B20'   B5                    	ORA	L
  1B21'   CA 1B2E'              	JZ	VP_BSD
  1B24'   2B                    	DCX	H
  1B25'   22 2A69'              	SHLD	RPAPP		; an appended char: it just goes
  1B28'   CD 0760'              	CALL	SETLIN
  1B2B'   C3 0000*              	JMP	DELPRV
  1B2E'                         VP_BSD:
  1B2E'   2A 2A67'              	LHLD	RPDEL
  1B31'   7C                    	MOV	A,H
  1B32'   B5                    	ORA	L
  1B33'   CA 1B5A'              	JZ	VP_BSM		; nothing of ours left
  1B36'   2A 0000*              	LHLD	GAPEND
  1B39'   EB                    	XCHG
  1B3A'   2A 2A6B'              	LHLD	RPGE
  1B3D'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1B40'   C2 1B5A'              	JNZ	VP_BSM
  1B43'   2A 2A67'              	LHLD	RPDEL
  1B46'   2B                    	DCX	H
  1B47'   22 2A67'              	SHLD	RPDEL
  1B4A'   CD 0760'              	CALL	SETLIN
  1B4D'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B50'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B53'   2A 0000*              	LHLD	GAPEND
  1B56'   22 2A6B'              	SHLD	RPGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B59'   C9                    	RET
  1B5A'                         VP_BSM:
  1B5A'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B5D'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B60'                         VIINS:
  1B60'   78                    	MOV	A,B
  1B61'   FE 01                 	CPI	KT_ACT
  1B63'   CA 1BD0'              	JZ	VI_ACT
  1B66'   FE 02                 	CPI	KT_CHAR
  1B68'   C0                    	RNZ			; ignore anything else
  1B69'   79                    	MOV	A,C
  1B6A'   FE 0D                 	CPI	CR
  1B6C'   CA 1BA6'              	JZ	VI_CR
  1B6F'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B71'   CA 1BA6'              	JZ	VI_CR
  1B74'   FE 08                 	CPI	BS
  1B76'   CA 1BBE'              	JZ	VI_BS
  1B79'   FE 7F                 	CPI	DEL
  1B7B'   CA 1BBE'              	JZ	VI_BS
  1B7E'   79                    	MOV	A,C
  1B7F'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B82'   CD 018C'              	CALL	MARKMOD
  1B85'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B88'   79                    	MOV	A,C
  1B89'   FE 20                 	CPI	' '
  1B8B'   D8                    	RC			; control char -> keep R_LINE
  1B8C'   FE 7F                 	CPI	DEL
  1B8E'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B8F'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B92'   B7                    	ORA	A
  1B93'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B94'   3E 04                 	MVI	A,R_ICH
  1B96'   32 2A1B'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B99'   CD 1587'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B9C'   3E 00                 	MVI	A,0
  1B9E'   C2 1BA2'              	JNZ	VI_ICH
  1BA1'   3C                    	INR	A
  1BA2'                         VI_ICH:
  1BA2'   32 2A1D'              	STA	ICHAPP
  1BA5'   C9                    	RET
  1BA6'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


                                	;    every char it had and the opened row is all the paint there is. ---
  1BA6'   CD 1587'              	CALL	ATCEND
  1BA9'   3E 00                 	MVI	A,0
  1BAB'   CA 1BAF'              	JZ	VI_CRS
  1BAE'   3C                    	INR	A
  1BAF'                         VI_CRS:
  1BAF'   F5                    	PUSH	PSW
  1BB0'   CD 1594'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1BB3'   CD 15A1'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1BB6'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1BB9'   F1                    	POP	PSW
  1BBA'   32 2A1E'              	STA	ILABOV
  1BBD'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1BBE'                         VI_BS:
  1BBE'   CD 0000*              	CALL	PEEKL
  1BC1'   D8                    	RC			; start of the file: nothing to delete
  1BC2'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1BC4'   CA 1BCA'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1BC7'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1BCA'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1BCA'   CD 018C'              	CALL	MARKMOD
  1BCD'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1BD0'                         VI_ACT:
  1BD0'   79                    	MOV	A,C
  1BD1'   FE 0B                 	CPI	ACT_ESC
  1BD3'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1BD4'   3E 00                 	MVI	A,EM_CMD
  1BD6'   32 2A16'              	STA	EDMODE
  1BD9'   CD 075A'              	CALL	SETMOV
  1BDC'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1BDF'   C3 08E6'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BE2'                         RDLINE:
  1BE2'   EB                    	XCHG			; HL = buffer
  1BE3'   22 2A6D'              	SHLD	RLPTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BE6'   3E 00                 	MVI	A,0
  1BE8'   32 2A6F'              	STA	RLLEN
  1BEB'   78                    	MOV	A,B
  1BEC'   32 2A70'              	STA	RLMAX
  1BEF'   79                    	MOV	A,C
  1BF0'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  1BF3'                         RL_LP:
  1BF3'   CD 0000*              	CALL	GETKEY
  1BF6'   78                    	MOV	A,B
  1BF7'   FE 01                 	CPI	KT_ACT
  1BF9'   CA 1C4F'              	JZ	RL_ACT
  1BFC'   FE 02                 	CPI	KT_CHAR
  1BFE'   C2 1BF3'              	JNZ	RL_LP		; ignore other keys
  1C01'   79                    	MOV	A,C
  1C02'   FE 0D                 	CPI	CR
  1C04'   CA 1C60'              	JZ	RL_DONE
  1C07'   FE 08                 	CPI	BS
  1C09'   CA 1C37'              	JZ	RL_BS
  1C0C'   FE 7F                 	CPI	DEL
  1C0E'   CA 1C37'              	JZ	RL_BS
  1C11'   FE 20                 	CPI	' '
  1C13'   DA 1BF3'              	JC	RL_LP		; control char -> ignore
  1C16'   3A 2A6F'              	LDA	RLLEN
  1C19'   47                    	MOV	B,A
  1C1A'   3A 2A70'              	LDA	RLMAX
  1C1D'   B8                    	CMP	B
  1C1E'   CA 1BF3'              	JZ	RL_LP		; full -> ignore
  1C21'   2A 2A6D'              	LHLD	RLPTR
  1C24'   71                    	MOV	M,C
  1C25'   23                    	INX	H
  1C26'   22 2A6D'              	SHLD	RLPTR
  1C29'   3A 2A6F'              	LDA	RLLEN
  1C2C'   3C                    	INR	A
  1C2D'   32 2A6F'              	STA	RLLEN
  1C30'   79                    	MOV	A,C
  1C31'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1C34'   C3 1BF3'              	JMP	RL_LP
  1C37'                         RL_BS:				; WM LINEPOP
  1C37'   3A 2A6F'              	LDA	RLLEN
  1C3A'   B7                    	ORA	A
  1C3B'   CA 1C55'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1C3E'   3D                    	DCR	A
  1C3F'   32 2A6F'              	STA	RLLEN
  1C42'   2A 2A6D'              	LHLD	RLPTR
  1C45'   2B                    	DCX	H
  1C46'   22 2A6D'              	SHLD	RLPTR
  1C49'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C4C'   C3 1BF3'              	JMP	RL_LP
  1C4F'                         RL_ACT:
  1C4F'   79                    	MOV	A,C
  1C50'   FE 0B                 	CPI	ACT_ESC
  1C52'   C2 1BF3'              	JNZ	RL_LP
  1C55'                         RL_CAN:
  1C55'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C57'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C5A'   CD 0760'              	CALL	SETLIN		; redraw one row
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C5D'   3E FF                 	MVI	A,0FFH		; cancelled
  1C5F'   C9                    	RET
  1C60'                         RL_DONE:
  1C60'   AF                    	XRA	A
  1C61'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C62'                         VC_BZ:
  1C62'   CD 075A'              	CALL	SETMOV
  1C65'   3A 2A3F'              	LDA	GSAVE
  1C68'   FE 02                 	CPI	PZ
  1C6A'   CA 1C75'              	JZ	VZ_ZZ
  1C6D'   B7                    	ORA	A
  1C6E'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C6F'   3E 02                 	MVI	A,PZ
  1C71'   32 2A3E'              	STA	GPEND
  1C74'   C9                    	RET
  1C75'                         VZ_ZZ:
  1C75'   3E 04                 	MVI	A,EO_X
  1C77'   32 2A71'              	STA	EXOP
  1C7A'   3E 01                 	MVI	A,1
  1C7C'   32 2A84'              	STA	EXBANG		; no '!'
  1C7F'   AF                    	XRA	A
  1C80'   32 2A72'              	STA	EXARG		; no file name
  1C83'   3A 2A1A'              	LDA	MODF		; as ':x': a changed text is written first
  1C86'   B7                    	ORA	A
  1C87'   CA 1DC8'              	JZ	EX_Q
  1C8A'   C3 1D62'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C8D'                         VC_EX:
  1C8D'   CD 068B'              	CALL	GETCNT
  1C90'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C93'   11 0000*              	LXI	D,EXBUF
  1C96'   06 28                 	MVI	B,EXMAX
  1C98'   0E 3A                 	MVI	C,':'
  1C9A'   CD 1BE2'              	CALL	RDLINE
  1C9D'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C9E'   C0                    	RNZ			; cancelled
  1C9F'   3A 2A6F'              	LDA	RLLEN
  1CA2'   5F                    	MOV	E,A
  1CA3'   16 00                 	MVI	D,0
  1CA5'   21 0000*              	LXI	H,EXBUF
  1CA8'   19                    	DAD	D
  1CA9'   36 00                 	MVI	M,0		; the line ends with a 0
  1CAB'   21 0000*              	LXI	H,EXBUF
  1CAE'   CD 227E'              	CALL	SKIPB
  1CB1'   C8                    	RZ			; nothing on it
  1CB2'   22 2A74'              	SHLD	EXCMD
  1CB5'   CD 2472'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1CB8'   CD 227E'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1CBB'   56                    	MOV	D,M
  1CBC'   23                    	INX	H
  1CBD'   1E 00                 	MVI	E,0
  1CBF'   CD 228A'              	CALL	ISLOW
  1CC2'   DA 1CCD'              	JC	EX_LK
  1CC5'   5F                    	MOV	E,A
  1CC6'   23                    	INX	H
  1CC7'   CD 228A'              	CALL	ISLOW
  1CCA'   D2 1CE6'              	JNC	EX_NOT		; a third letter: none of ours
  1CCD'                         EX_LK:
  1CCD'   E5                    	PUSH	H
  1CCE'   21 2459'              	LXI	H,EXTAB
  1CD1'                         EX_TL:
  1CD1'   7E                    	MOV	A,M
  1CD2'   B7                    	ORA	A
  1CD3'   CA 1CE5'              	JZ	EX_NTP		; not in the table
  1CD6'   23                    	INX	H
  1CD7'   BA                    	CMP	D
  1CD8'   7E                    	MOV	A,M
  1CD9'   23                    	INX	H
  1CDA'   C2 1CE1'              	JNZ	EX_TN
  1CDD'   BB                    	CMP	E
  1CDE'   CA 1CEC'              	JZ	EX_TF
  1CE1'                         EX_TN:
  1CE1'   23                    	INX	H
  1CE2'   C3 1CD1'              	JMP	EX_TL
  1CE5'                         EX_NTP:
  1CE5'   E1                    	POP	H
  1CE6'                         EX_NOT:
  1CE6'   21 2342'              	LXI	H,SNOT
  1CE9'   C3 22BF'              	JMP	EXERT
  1CEC'                         EX_TF:
  1CEC'   7E                    	MOV	A,M
  1CED'   32 2A71'              	STA	EXOP
  1CF0'   E1                    	POP	H
  1CF1'   FE 06                 	CPI	EO_S
  1CF3'   CA 24E1'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CF6'   FE 01                 	CPI	EO_W
  1CF8'   CA 1D07'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CFB'   FE 08                 	CPI	EO_R
  1CFD'   CA 1D07'              	JZ	EX_RG		; ... and ':Nr name' a line
  1D00'   3A 2ACC'              	LDA	SRNGF
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1D03'   B7                    	ORA	A
  1D04'   C2 1CE6'              	JNZ	EX_NOT		; a range on a command that does not take one
  1D07'                         EX_RG:
                                	;--- '!', then the file name ---
  1D07'   7E                    	MOV	A,M
  1D08'   D6 21                 	SUI	'!'
  1D0A'   32 2A84'              	STA	EXBANG		; 0 = '!'
  1D0D'   C2 1D11'              	JNZ	EX_NB
  1D10'   23                    	INX	H
  1D11'                         EX_NB:
  1D11'   CD 227E'              	CALL	SKIPB
  1D14'   32 2A72'              	STA	EXARG		; 0 = no file name
  1D17'   CA 1D30'              	JZ	EX_RUN
  1D1A'   22 2A74'              	SHLD	EXCMD
  1D1D'   3A 2A71'              	LDA	EXOP
  1D20'   FE 02                 	CPI	EO_Q
  1D22'   CA 22BC'              	JZ	EX_TRL		; :q takes none
  1D25'   FE 07                 	CPI	EO_V
  1D27'   CA 22BC'              	JZ	EX_TRL		; nor :ve
  1D2A'   CD 21E8'              	CALL	PARSFN
  1D2D'   C2 22B0'              	JNZ	EX_INV
  1D30'                         EX_RUN:
  1D30'   3A 2A71'              	LDA	EXOP
  1D33'   FE 05                 	CPI	EO_E
  1D35'   CA 1DDF'              	JZ	EX_E
  1D38'   FE 02                 	CPI	EO_Q
  1D3A'   CA 1DC8'              	JZ	EX_Q
  1D3D'   FE 07                 	CPI	EO_V
  1D3F'   CA 22B6'              	JZ	EX_V
  1D42'   FE 08                 	CPI	EO_R
  1D44'   CA 1F70'              	JZ	EX_R
  1D47'   FE 04                 	CPI	EO_X
  1D49'   CA 1D5B'              	JZ	EX_XM
  1D4C'   FE 01                 	CPI	EO_W
  1D4E'   C2 1D62'              	JNZ	EX_W		; :wq
  1D51'   3A 2ACC'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D54'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D55'   C2 1E90'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D58'   C3 1D62'              	JMP	EX_W
  1D5B'                         EX_XM:
  1D5B'   3A 2A1A'              	LDA	MODF		; :x writes only a changed text
  1D5E'   B7                    	ORA	A
  1D5F'   CA 1DC8'              	JZ	EX_Q
  1D62'                         EX_W:
  1D62'   CD 2050'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D65'   D8                    	RC			; refused (message shown)
  1D66'   32 2A73'              	STA	EXBAK
  1D69'   3A 2A71'              	LDA	EXOP
  1D6C'   FE 01                 	CPI	EO_W
  1D6E'   CA 1D85'              	JZ	EX_WK
  1D71'   3A 2A73'              	LDA	EXBAK
  1D74'   B7                    	ORA	A
  1D75'   C2 1DC5'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D78'   3A 2A84'              	LDA	EXBANG
  1D7B'   B7                    	ORA	A
  1D7C'   CA 1DC5'              	JZ	EX_WQ		; so it does with '!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D7F'   CD 1D85'              	CALL	EX_WK		; else it may not: keep the text
  1D82'   C3 1DC8'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D85'                         EX_WK:
  1D85'   CD 0D0F'              	CALL	CURRW		; the cursor's row and file position
  1D88'   32 2A76'              	STA	WPROW
  1D8B'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D8E'   7D                    	MOV	A,L
  1D8F'   E6 7F                 	ANI	7FH
  1D91'   32 2A77'              	STA	WPBYT
  1D94'   7D                    	MOV	A,L
  1D95'   17                    	RAL
  1D96'   7C                    	MOV	A,H
  1D97'   17                    	RAL
  1D98'   5F                    	MOV	E,A
  1D99'   3E 00                 	MVI	A,0
  1D9B'   17                    	RAL
  1D9C'   57                    	MOV	D,A		; DE = HL / 128
  1D9D'   2A 0000*              	LHLD	OUTPOS
  1DA0'   19                    	DAD	D
  1DA1'   22 2A78'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1DA4'   CD 2085'              	CALL	WRITE
  1DA7'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1DAA'   2A 2A78'              	LHLD	WPREC
  1DAD'   EB                    	XCHG
  1DAE'   3A 2A77'              	LDA	WPBYT
  1DB1'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1DB4'   CD 0000*              	CALL	GOTO
  1DB7'                         EX_WRW:
  1DB7'   21 0000               	LXI	H,0
  1DBA'   22 0000*              	SHLD	LNDLT
  1DBD'   3A 2A76'              	LDA	WPROW
  1DC0'   6F                    	MOV	L,A
  1DC1'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1DC4'   C9                    	RET
  1DC5'                         EX_WQ:
  1DC5'   CD 2085'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1DC8'                         EX_Q:
  1DC8'   3A 2A84'              	LDA	EXBANG
  1DCB'   B7                    	ORA	A
  1DCC'   CA 1DD6'              	JZ	EX_QT
  1DCF'   3A 2A1A'              	LDA	MODF
  1DD2'   B7                    	ORA	A
  1DD3'   C2 22A4'              	JNZ	MSGNWR		; changed, no '!': stay
  1DD6'                         EX_QT:
  1DD6'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1DD9'   3E 01                 	MVI	A,1
  1DDB'   32 2A19'              	STA	QUITF
  1DDE'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1DDF'                         EX_E:
  1DDF'   3A 2A84'              	LDA	EXBANG
  1DE2'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DE3'   CA 1DED'              	JZ	EE_GO
  1DE6'   3A 2A1A'              	LDA	MODF
  1DE9'   B7                    	ORA	A
  1DEA'   C2 22A4'              	JNZ	MSGNWR
  1DED'                         EE_GO:
  1DED'   3A 2A72'              	LDA	EXARG
  1DF0'   B7                    	ORA	A
  1DF1'   C2 1DF8'              	JNZ	EE_ARG
  1DF4'   CD 20C1'              	CALL	OWNTF		; no name: the buffer's own
  1DF7'   D8                    	RC
  1DF8'                         EE_ARG:
  1DF8'   CD 20D7'              	CALL	ISOWN
  1DFB'   21 0001               	LXI	H,1
  1DFE'   C2 1E05'              	JNZ	EE_LD		; another file: its first line
  1E01'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1E04'   23                    	INX	H		; HL = the cursor's line
  1E05'                         EE_LD:
  1E05'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1E07'   32 2A82'              	STA	MSGWHT
  1E0A'   E5                    	PUSH	H
  1E0B'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E0E'   21 0000*              	LXI	H,TFCB
  1E11'   11 0000*              	LXI	D,FNAME
  1E14'   CD 20E9'              	CALL	COPY12		; the buffer's name
  1E17'   CD 20AE'              	CALL	SRCTF
  1E1A'   CD 0000*              	CALL	REOPEN
  1E1D'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1E20'   AF                    	XRA	A
  1E21'   32 2A1A'              	STA	MODF
  1E24'   E1                    	POP	H
  1E25'   2B                    	DCX	H
  1E26'   AF                    	XRA	A
  1E27'   CD 0000*              	CALL	MVLIND		; down to the line
  1E2A'   CD 0A1D'              	CALL	ATEOF
  1E2D'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  1E30'   CD 0F5D'              	CALL	ZSAVE
  1E33'   C3 1040'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1E36'                         TFDOS:
  1E36'   C5                    	PUSH	B
  1E37'   11 0080               	LXI	D,CMDTAIL
  1E3A'   0E 1A                 	MVI	C,1AH		; set the DMA
  1E3C'   CD 0005               	CALL	BDOS
  1E3F'   C1                    	POP	B
  1E40'   11 0000*              	LXI	D,TFCB
  1E43'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E46'                         EXRNG:
  1E46'   2A 2ACD'              	LHLD	SRNG1
  1E49'   7C                    	MOV	A,H
  1E4A'   B5                    	ORA	L
  1E4B'   37                    	STC
  1E4C'   C8                    	RZ
  1E4D'   2A 2ACF'              	LHLD	SRNG2
  1E50'   EB                    	XCHG
  1E51'   2A 2ACD'              	LHLD	SRNG1
  1E54'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E57'   D8                    	RC
  1E58'   EB                    	XCHG			; HL = the last line, DE = the first
  1E59'   CD 0000*              	CALL	SUBHD
  1E5C'   23                    	INX	H
  1E5D'   22 2AD7'              	SHLD	SLINES
  1E60'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E61'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E62'                         GOLNX:
  1E62'   E5                    	PUSH	H
  1E63'   CD 0EF1'              	CALL	GOLN
  1E66'   CD 0000*              	CALL	CNTLF
  1E69'   23                    	INX	H		; the line the cursor came to rest on
  1E6A'   D1                    	POP	D
  1E6B'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E6E'                         EXSAVP:
  1E6E'   CD 0D0F'              	CALL	CURRW
  1E71'   32 2A76'              	STA	WPROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E74'   21 2AAE'              	LXI	H,MKPOS
  1E77'   C3 044F'              	JMP	FPSTO
  1E7A'                         EXRSTP:
  1E7A'   CD 0000*              	CALL	CLRCNT
  1E7D'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1E80'   CD 0000*              	CALL	GOTO
  1E83'   C3 1DB7'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E86'                         PUTBRK:
  1E86'   3E 0D                 	MVI	A,CR
  1E88'   CD 0000*              	CALL	PUTGAP
  1E8B'   3E 0A                 	MVI	A,LF
  1E8D'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E90'                         EX_WR:
  1E90'   3A 2A72'              	LDA	EXARG
  1E93'   B7                    	ORA	A
  1E94'   CA 2292'              	JZ	MSGNFN		; No file name
  1E97'   CD 20D7'              	CALL	ISOWN
  1E9A'   CA 1F3A'              	JZ	EXW_OW
  1E9D'   CD 0000*              	CALL	TEXIST
  1EA0'   32 2ADA'              	STA	RWERR		; nonzero: a file of that name is there
  1EA3'   CA 1EAD'              	JZ	EXW_GO
  1EA6'   3A 2A84'              	LDA	EXBANG
  1EA9'   B7                    	ORA	A
  1EAA'   C2 2298'              	JNZ	MSGEXI		; File exists (! to force)
  1EAD'                         EXW_GO:
  1EAD'   CD 1E46'              	CALL	EXRNG
  1EB0'   DA 1F34'              	JC	EXW_BD
  1EB3'   CD 1E6E'              	CALL	EXSAVP
  1EB6'   2A 2ACD'              	LHLD	SRNG1
  1EB9'   CD 1E62'              	CALL	GOLNX
  1EBC'   C2 1F31'              	JNZ	EXW_NL		; the text has no line N
  1EBF'   3A 2ADA'              	LDA	RWERR		; a delete scans the whole directory, there or
  1EC2'   B7                    	ORA	A		;   not: only when TEXIST found one
  1EC3'   0E 13                 	MVI	C,13H
  1EC5'   C4 1E36'              	CNZ	TFDOS		; delete what is there
  1EC8'   0E 16                 	MVI	C,16H
  1ECA'   CD 1E36'              	CALL	TFDOS		; ... and make it
  1ECD'   3C                    	INR	A
  1ECE'   CA 1F23'              	JZ	EXW_FL		; no directory entry left
  1ED1'   3E 80                 	MVI	A,80H
  1ED3'   32 2AD9'              	STA	RWPTR
  1ED6'   AF                    	XRA	A
  1ED7'   32 2ADA'              	STA	RWERR
  1EDA'   2A 2AD7'              	LHLD	SLINES
  1EDD'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1EE0'                         EXW_LP:
  1EE0'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1EE3'   E5                    	PUSH	H
  1EE4'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EE5'   2A 0000*              	LHLD	GAPEND
  1EE8'   CD 1F40'              	CALL	RWOUT		; the text from the cursor to there
  1EEB'   E1                    	POP	H
  1EEC'   3A 2ADA'              	LDA	RWERR
  1EEF'   B7                    	ORA	A
  1EF0'   C2 1F0C'              	JNZ	EXW_EN
  1EF3'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EF6'   CD 06A0'              	CALL	CNTTST
  1EF9'   C2 1EE0'              	JNZ	EXW_LP
  1EFC'                         EXW_PD:				; the last record is padded out with ^Z
  1EFC'   3A 2AD9'              	LDA	RWPTR
  1EFF'   FE 80                 	CPI	80H
  1F01'   CA 1F0C'              	JZ	EXW_EN
  1F04'   3E 1A                 	MVI	A,CPMEOF
  1F06'   CD 1F4C'              	CALL	RWPUT
  1F09'   C3 1EFC'              	JMP	EXW_PD
  1F0C'                         EXW_EN:
  1F0C'   0E 10                 	MVI	C,10H
  1F0E'   CD 1E36'              	CALL	TFDOS		; close
  1F11'   3A 2ADA'              	LDA	RWERR
  1F14'   B7                    	ORA	A
  1F15'   C2 1F23'              	JNZ	EXW_FL
  1F18'   CD 1E7A'              	CALL	EXRSTP
  1F1B'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F1D'   32 2A82'              	STA	MSGWHT
  1F20'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1F23'                         EXW_FL:				; no room: the part written is not left behind
  1F23'   0E 13                 	MVI	C,13H
  1F25'   CD 1E36'              	CALL	TFDOS
  1F28'   CD 1E7A'              	CALL	EXRSTP
  1F2B'   21 244F'              	LXI	H,SDFUL
  1F2E'   C3 22CA'              	JMP	EXERR
  1F31'                         EXW_NL:
  1F31'   CD 1E7A'              	CALL	EXRSTP
  1F34'                         EXW_BD:
  1F34'   21 2441'              	LXI	H,SRNGE
  1F37'   C3 22CA'              	JMP	EXERR
  1F3A'                         EXW_OW:
  1F3A'   21 22F9'              	LXI	H,SEXI
  1F3D'   C3 22CA'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1F40'                         RWOUT:
  1F40'   CD 0000*              	CALL	CMP16
  1F43'   C8                    	RZ
  1F44'   7E                    	MOV	A,M
  1F45'   23                    	INX	H
  1F46'   CD 1F4C'              	CALL	RWPUT
  1F49'   C3 1F40'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F4C'                         RWPUT:
  1F4C'   E5                    	PUSH	H
  1F4D'   F5                    	PUSH	PSW
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F4E'   3A 2AD9'              	LDA	RWPTR
  1F51'   6F                    	MOV	L,A
  1F52'   26 00                 	MVI	H,0
  1F54'   F1                    	POP	PSW
  1F55'   77                    	MOV	M,A
  1F56'   2C                    	INR	L		; Z: that was the record's last byte
  1F57'   7D                    	MOV	A,L
  1F58'   C2 1F6B'              	JNZ	RWP_ST
  1F5B'   D5                    	PUSH	D
  1F5C'   0E 15                 	MVI	C,15H
  1F5E'   CD 1E36'              	CALL	TFDOS		; write it
  1F61'   D1                    	POP	D
  1F62'   B7                    	ORA	A
  1F63'   CA 1F69'              	JZ	RWP_OK
  1F66'   32 2ADA'              	STA	RWERR
  1F69'                         RWP_OK:
  1F69'   3E 80                 	MVI	A,80H
  1F6B'                         RWP_ST:
  1F6B'   32 2AD9'              	STA	RWPTR
  1F6E'   E1                    	POP	H
  1F6F'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F70'                         EX_R:
  1F70'   3A 2A72'              	LDA	EXARG
  1F73'   B7                    	ORA	A
  1F74'   CA 2292'              	JZ	MSGNFN		; No file name
  1F77'   0E 0F                 	MVI	C,0FH
  1F79'   CD 1E36'              	CALL	TFDOS		; open
  1F7C'   3C                    	INR	A
  1F7D'   CA 204A'              	JZ	ER_NOF
  1F80'   CD 0F83'              	CALL	GZONE		; the screen's top line, before anything moves
  1F83'   CD 1E6E'              	CALL	EXSAVP
  1F86'   3A 2ACC'              	LDA	SRNGF
  1F89'   B7                    	ORA	A
  1F8A'   CA 1FA3'              	JZ	ER_NXT		; no line given: below the cursor's
  1F8D'   2A 2ACF'              	LHLD	SRNG2
  1F90'   7C                    	MOV	A,H
  1F91'   B5                    	ORA	L
  1F92'   C2 1F9D'              	JNZ	ER_LN
  1F95'   23                    	INX	H
  1F96'   CD 0EF1'              	CALL	GOLN		; ':0r': above line 1 ...
  1F99'   AF                    	XRA	A		;   which never wants a line end put in first
  1F9A'   C3 1FC5'              	JMP	ER_BRK
  1F9D'                         ER_LN:
  1F9D'   CD 1E62'              	CALL	GOLNX
  1FA0'   C2 1F31'              	JNZ	EXW_NL		; the text has no line N
  1FA3'                         ER_NXT:
  1FA3'   21 0001               	LXI	H,1
  1FA6'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FA7'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1FAA'   CD 0A1D'              	CALL	ATEOF
  1FAD'   3E 00                 	MVI	A,0
  1FAF'   D2 1FC5'              	JNC	ER_BRK		; text follows
  1FB2'   2A 0000*              	LHLD	GAPBEG
  1FB5'   EB                    	XCHG
  1FB6'   2A 0000*              	LHLD	TXTBEG
  1FB9'   CD 0000*              	CALL	CMP16
  1FBC'   3E 01                 	MVI	A,1
  1FBE'   CA 1FC5'              	JZ	ER_BRK		; nothing before the cursor either
  1FC1'   1B                    	DCX	D
  1FC2'   1A                    	LDAX	D
  1FC3'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1FC5'                         ER_BRK:
  1FC5'   32 2ADC'              	STA	RDBRK
  1FC8'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1FCB'   AF                    	XRA	A
  1FCC'   32 2ADB'              	STA	RDANY
  1FCF'                         ER_LP:
  1FCF'   0E 14                 	MVI	C,14H
  1FD1'   CD 1E36'              	CALL	TFDOS		; the next record
  1FD4'   B7                    	ORA	A
  1FD5'   C2 2008'              	JNZ	ER_END
  1FD8'   21 0080               	LXI	H,CMDTAIL
  1FDB'   0E 00                 	MVI	C,0
  1FDD'                         ER_SC:				; C = its bytes, up to a ^Z
  1FDD'   7E                    	MOV	A,M
  1FDE'   FE 1A                 	CPI	CPMEOF
  1FE0'   CA 1FE8'              	JZ	ER_GOT
  1FE3'   23                    	INX	H
  1FE4'   0C                    	INR	C
  1FE5'   F2 1FDD'              	JP	ER_SC		; (minus: all 128)
  1FE8'                         ER_GOT:
  1FE8'   79                    	MOV	A,C
  1FE9'   B7                    	ORA	A
  1FEA'   CA 2008'              	JZ	ER_END
  1FED'   C5                    	PUSH	B
  1FEE'   3A 2ADB'              	LDA	RDANY
  1FF1'   B7                    	ORA	A
  1FF2'   CC 2039'              	CZ	ER_1ST
  1FF5'   C1                    	POP	B
  1FF6'   06 00                 	MVI	B,0
  1FF8'   11 0080               	LXI	D,CMDTAIL
  1FFB'   C5                    	PUSH	B
  1FFC'   CD 0000*              	CALL	INSBLK
  1FFF'   C1                    	POP	B
  2000'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2003'   79                    	MOV	A,C
  2004'   17                    	RAL
  2005'   DA 1FCF'              	JC	ER_LP		; a full record: there may be more
  2008'                         ER_END:
  2008'   3A 2ADB'              	LDA	RDANY
  200B'   B7                    	ORA	A
  200C'   CA 202A'              	JZ	ER_PL		; nothing in the file: nothing has changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  200F'   CD 0A1D'              	CALL	ATEOF
  2012'   DA 201F'              	JC	ER_MD		; the text now ends as the file read ends
  2015'   2A 0000*              	LHLD	GAPBEG
  2018'   2B                    	DCX	H
  2019'   7E                    	MOV	A,M
  201A'   FE 0A                 	CPI	LF
  201C'   C4 1E86'              	CNZ	PUTBRK		; text follows: what was read ends a line
  201F'                         ER_MD:
  201F'   3E 01                 	MVI	A,1
  2021'   32 2A1A'              	STA	MODF
  2024'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  2027'   CD 0000*              	CALL	GOTO
  202A'                         ER_PL:
  202A'   CD 0A1D'              	CALL	ATEOF
  202D'   DC 0A23'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2030'   CD 0000*              	CALL	CLRCNT
  2033'   CD 0F9B'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2036'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2039'                         ER_1ST:
  2039'   3C                    	INR	A
  203A'   32 2ADB'              	STA	RDANY
  203D'   3A 2ADC'              	LDA	RDBRK
  2040'   B7                    	ORA	A
  2041'   C4 1E86'              	CNZ	PUTBRK
  2044'   21 2AAE'              	LXI	H,MKPOS
  2047'   C3 044F'              	JMP	FPSTO
  204A'                         ER_NOF:
  204A'   21 2430'              	LXI	H,SNOPN
  204D'   C3 22BF'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2050'                         WRCHK:
  2050'   3A 2A72'              	LDA	EXARG
  2053'   B7                    	ORA	A
  2054'   C2 205E'              	JNZ	WC_ARG
  2057'   CD 20C1'              	CALL	OWNTF
  205A'   D8                    	RC
  205B'   C3 2073'              	JMP	WC_OWN
  205E'                         WC_ARG:
  205E'   CD 20D7'              	CALL	ISOWN
  2061'   CA 2073'              	JZ	WC_OWN
  2064'   3A 2A84'              	LDA	EXBANG
  2067'   B7                    	ORA	A
  2068'   CA 2071'              	JZ	WC_OTH
  206B'   CD 0000*              	CALL	TEXIST
  206E'   C2 2298'              	JNZ	MSGEXI		; File exists (! to force)
  2071'                         WC_OTH:
  2071'   AF                    	XRA	A		; (NC)
  2072'   C9                    	RET
  2073'                         WC_OWN:
  2073'   3A 2A85'              	LDA	ROFLAG		; '-R': this is the file it may not write
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2076'   B7                    	ORA	A
  2077'   CA 2081'              	JZ	WC_OK
  207A'   3A 2A84'              	LDA	EXBANG
  207D'   B7                    	ORA	A
  207E'   C2 229E'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2081'                         WC_OK:
  2081'   3E 01                 	MVI	A,1
  2083'   B7                    	ORA	A		; (NC)
  2084'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2085'                         WRITE:
  2085'   3A 2A73'              	LDA	EXBAK
  2088'   CD 0000*              	CALL	WRTO
  208B'   3A 0001*              	LDA	FNAME+1
  208E'   FE 20                 	CPI	' '
  2090'   C2 209C'              	JNZ	WR_HAS
  2093'   21 0000*              	LXI	H,TFCB
  2096'   11 0000*              	LXI	D,FNAME
  2099'   CD 20E9'              	CALL	COPY12
  209C'                         WR_HAS:
  209C'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  209E'   32 2A82'              	STA	MSGWHT
  20A1'   CD 20D7'              	CALL	ISOWN
  20A4'   C2 20AE'              	JNZ	SRCTF
  20A7'   AF                    	XRA	A
  20A8'   32 2A1A'              	STA	MODF
  20AB'   32 2A83'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  20AE'                         SRCTF:
  20AE'   21 0000*              	LXI	H,TFCB
  20B1'   11 005C               	LXI	D,DFTFCB
  20B4'   CD 20E9'              	CALL	COPY12
  20B7'   AF                    	XRA	A
  20B8'   06 04                 	MVI	B,4
  20BA'                         SRC_Z:
  20BA'   12                    	STAX	D		; extent, s1, s2, record count: 0
  20BB'   13                    	INX	D
  20BC'   05                    	DCR	B
  20BD'   C2 20BA'              	JNZ	SRC_Z
  20C0'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  20C1'                         OWNTF:
  20C1'   3A 0001*              	LDA	FNAME+1
  20C4'   FE 20                 	CPI	' '
  20C6'   CA 2292'              	JZ	MSGNFN
  20C9'   CD 20F4'              	CALL	TFCLR
  20CC'   21 0000*              	LXI	H,FNAME
  20CF'   11 0000*              	LXI	D,TFCB
  20D2'   CD 20E9'              	CALL	COPY12
  20D5'   B7                    	ORA	A		; (NC)
  20D6'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                                ;ISOWN -- Z iff TFCB names the buffer's file.
  20D7'                         ISOWN:
  20D7'   21 0000*              	LXI	H,TFCB
  20DA'   11 0000*              	LXI	D,FNAME
  20DD'   06 0C                 	MVI	B,12
  20DF'                         IO_LP:
  20DF'   1A                    	LDAX	D
  20E0'   BE                    	CMP	M
  20E1'   C0                    	RNZ
  20E2'   23                    	INX	H
  20E3'   13                    	INX	D
  20E4'   05                    	DCR	B
  20E5'   C2 20DF'              	JNZ	IO_LP
  20E8'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20E9'                         COPY12:
  20E9'   06 0C                 	MVI	B,12
  20EB'                         CP_LP:
  20EB'   7E                    	MOV	A,M
  20EC'   12                    	STAX	D
  20ED'   23                    	INX	H
  20EE'   13                    	INX	D
  20EF'   05                    	DCR	B
  20F0'   C2 20EB'              	JNZ	CP_LP
  20F3'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20F4'                         TFCLR:
  20F4'   11 0000*              	LXI	D,TFCB
  20F7'   06 24                 	MVI	B,36
  20F9'   AF                    	XRA	A
  20FA'                         TC_LP:
  20FA'   12                    	STAX	D
  20FB'   13                    	INX	D
  20FC'   05                    	DCR	B
  20FD'   C2 20FA'              	JNZ	TC_LP
  2100'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2101'                         FOPEN:
  2101'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2103'   32 2A82'              	STA	MSGWHT
  2106'   21 005C               	LXI	H,DFTFCB
  2109'   CD 21DB'              	CALL	NRMDRV
  210C'   11 0000*              	LXI	D,FNAME
  210F'   CD 20E9'              	CALL	COPY12
  2112'   CD 0000*              	CALL	OPENZ
  2115'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2118'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  211A'   C8                    	RZ
  211B'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  211E'   32 2A83'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2121'   C9                    	RET			;   the .BAK from it), so it is never written to
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2122'                         ARGSCN:
  2122'   3A 0080               	LDA	CMDTAIL
  2125'   47                    	MOV	B,A		; B = what is left of the line
  2126'   B7                    	ORA	A
  2127'   C8                    	RZ
  2128'   21 0081               	LXI	H,CMDTAIL+1
  212B'                         AS_TOK:				; at a token, or the blanks before one
  212B'   7E                    	MOV	A,M
  212C'   FE 20                 	CPI	' '
  212E'   C2 2137'              	JNZ	AS_OPT
  2131'   23                    	INX	H
  2132'   05                    	DCR	B
  2133'   C2 212B'              	JNZ	AS_TOK
  2136'   C9                    	RET
  2137'                         AS_OPT:
  2137'   FE 2B                 	CPI	'+'
  2139'   CA 2163'              	JZ	AS_PLS
  213C'   FE 2D                 	CPI	'-'
  213E'   CA 2152'              	JZ	AS_SW
  2141'   FE 2F                 	CPI	'/'
  2143'   CA 2152'              	JZ	AS_SW
  2146'                         AS_SKP:				; not ours (the file name): on to the next one
  2146'   23                    	INX	H
  2147'   05                    	DCR	B
  2148'   C8                    	RZ
  2149'   7E                    	MOV	A,M
  214A'   FE 20                 	CPI	' '
  214C'   C2 2146'              	JNZ	AS_SKP
  214F'   C3 212B'              	JMP	AS_TOK
  2152'                         AS_SW:
  2152'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2153'   05                    	DCR	B
  2154'   C8                    	RZ
  2155'   7E                    	MOV	A,M
  2156'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2158'   FE 52                 	CPI	'R'
  215A'   C2 2146'              	JNZ	AS_SKP
  215D'   32 2A85'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2160'   C3 2146'              	JMP	AS_SKP
  2163'                         AS_PLS:
  2163'   3E 01                 	MVI	A,1
  2165'   32 2A86'              	STA	PLUSF		; '+' gets the line even with no number on it
  2168'   11 0000*              	LXI	D,PLUSB
  216B'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  216D'   23                    	INX	H		;   line space, so it is taken as '+' alone
  216E'   05                    	DCR	B
  216F'   CA 21A6'              	JZ	AS_PE
  2172'   7E                    	MOV	A,M
  2173'   FE 30                 	CPI	'0'
  2175'   C2 218D'              	JNZ	AS_PD
  2178'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2178'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2179'   05                    	DCR	B
  217A'   CA 21AE'              	JZ	AS_P1
  217D'   7E                    	MOV	A,M
  217E'   FE 30                 	CPI	'0'
  2180'   CA 2178'              	JZ	AS_PZ
  2183'   FE 31                 	CPI	'1'
  2185'   DA 21AE'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2188'   FE 3A                 	CPI	'9'+1
  218A'   D2 21AE'              	JNC	AS_P1
  218D'                         AS_PD:				; the digits, as typed
  218D'   7E                    	MOV	A,M
  218E'   FE 30                 	CPI	'0'
  2190'   DA 21A6'              	JC	AS_PE
  2193'   FE 3A                 	CPI	'9'+1
  2195'   D2 21A6'              	JNC	AS_PE
  2198'   79                    	MOV	A,C
  2199'   B7                    	ORA	A
  219A'   CA 21B5'              	JZ	AS_POV
  219D'   0D                    	DCR	C
  219E'   7E                    	MOV	A,M
  219F'   12                    	STAX	D
  21A0'   13                    	INX	D
  21A1'   23                    	INX	H
  21A2'   05                    	DCR	B
  21A3'   C2 218D'              	JNZ	AS_PD
  21A6'                         AS_PE:
  21A6'   AF                    	XRA	A
  21A7'   12                    	STAX	D		; the digits end with a 0
  21A8'   78                    	MOV	A,B
  21A9'   B7                    	ORA	A
  21AA'   C8                    	RZ
  21AB'   C3 212B'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  21AE'                         AS_P1:
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AE'   3E 31                 	MVI	A,'1'
  21B0'   12                    	STAX	D
  21B1'   13                    	INX	D
  21B2'   C3 21A6'              	JMP	AS_PE
  21B5'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  21B5'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  21B8'   C3 21A6'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  21BB'                         ARGGO:
  21BB'   3A 2A86'              	LDA	PLUSF
  21BE'   B7                    	ORA	A
  21BF'   C8                    	RZ
  21C0'   21 0000*              	LXI	H,PLUSB
  21C3'                         AG_LP:
  21C3'   7E                    	MOV	A,M
  21C4'   B7                    	ORA	A
  21C5'   CA 21D4'              	JZ	AG_G
  21C8'   4F                    	MOV	C,A
  21C9'   06 02                 	MVI	B,KT_CHAR
  21CB'   E5                    	PUSH	H
  21CC'   CD 0023'              	CALL	VICMD
  21CF'   E1                    	POP	H
  21D0'   23                    	INX	H
  21D1'   C3 21C3'              	JMP	AG_LP
  21D4'                         AG_G:
  21D4'   0E 47                 	MVI	C,'G'
  21D6'   06 02                 	MVI	B,KT_CHAR
  21D8'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  21DB'                         NRMDRV:
  21DB'   7E                    	MOV	A,M
  21DC'   B7                    	ORA	A
  21DD'   C0                    	RNZ
  21DE'   E5                    	PUSH	H
  21DF'   0E 19                 	MVI	C,BF_CURDSK
  21E1'   CD 0005               	CALL	BDOS
  21E4'   E1                    	POP	H
  21E5'   3C                    	INR	A
  21E6'   77                    	MOV	M,A
  21E7'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21E8'                         PARSFN:
  21E8'   CD 20F4'              	CALL	TFCLR
  21EB'   11 0000*              	LXI	D,TFCB
  21EE'   23                    	INX	H
  21EF'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21F0'   2B                    	DCX	H
  21F1'   FE 3A                 	CPI	':'
  21F3'   C2 2205'              	JNZ	PF_NM
  21F6'   CD 224B'              	CALL	GETFNC
  21F9'   CA 2205'              	JZ	PF_NM
  21FC'   D6 40                 	SUI	40H
  21FE'   12                    	STAX	D
  21FF'   FE 11                 	CPI	17
  2201'   D2 2229'              	JNC	PF_BAD
  2204'   23                    	INX	H
  2205'                         PF_NM:
  2205'   13                    	INX	D
  2206'   0E 08                 	MVI	C,8
  2208'   CD 222D'              	CALL	CPYNAM
  220B'   FE 2E                 	CPI	'.'
  220D'   0E 03                 	MVI	C,3
  220F'   C4 2240'              	CNZ	PADFLD		; no type: blanks
  2212'   CC 222C'              	CZ	CPYNM0		; '.': the type
  2215'   3A 0001*              	LDA	TFCB+1
  2218'   FE 20                 	CPI	' '
  221A'   CA 2229'              	JZ	PF_BAD		; no name
  221D'   CD 227E'              	CALL	SKIPB
  2220'   C0                    	RNZ			; more after it
  2221'   21 0000*              	LXI	H,TFCB
  2224'   CD 21DB'              	CALL	NRMDRV
  2227'   AF                    	XRA	A
  2228'   C9                    	RET
  2229'                         PF_BAD:
  2229'   F6 01                 	ORI	1
  222B'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  222C'                         CPYNM0:
  222C'   23                    	INX	H
  222D'                         CPYNAM:
  222D'   CD 224B'              	CALL	GETFNC
  2230'   CA 2240'              	JZ	PADFLD
  2233'   12                    	STAX	D
  2234'   13                    	INX	D
  2235'   0D                    	DCR	C
  2236'   C2 222D'              	JNZ	CPYNAM
  2239'                         CN_SKP:
  2239'   CD 224B'              	CALL	GETFNC
  223C'   C2 2239'              	JNZ	CN_SKP
  223F'   C9                    	RET
  2240'                         PADFLD:
  2240'   F5                    	PUSH	PSW
  2241'                         PD_LP:
  2241'   3E 20                 	MVI	A,' '
  2243'   12                    	STAX	D
  2244'   13                    	INX	D
  2245'   0D                    	DCR	C
  2246'   C2 2241'              	JNZ	PD_LP
  2249'   F1                    	POP	PSW
  224A'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  224B'                         GETFNC:
  224B'   7E                    	MOV	A,M
  224C'   FE 3D                 	CPI	'='
  224E'   C8                    	RZ
  224F'   FE 5F                 	CPI	'_'
  2251'   C8                    	RZ
  2252'   FE 3B                 	CPI	';'
  2254'   C8                    	RZ
  2255'   FE 3C                 	CPI	'<'
  2257'   C8                    	RZ
  2258'   FE 3E                 	CPI	'>'
  225A'   C8                    	RZ
  225B'   FE 2E                 	CPI	'.'
  225D'   C8                    	RZ
  225E'   FE 3A                 	CPI	':'
  2260'   C8                    	RZ
  2261'   FE 2A                 	CPI	'*'
  2263'   C8                    	RZ
  2264'   FE 3F                 	CPI	'?'
  2266'   C8                    	RZ
  2267'   FE 20                 	CPI	' '
  2269'   DA 227C'              	JC	GF_CTL
  226C'   C8                    	RZ
  226D'   23                    	INX	H
  226E'   FE 61                 	CPI	'a'
  2270'   DA 227A'              	JC	GF_DN
  2273'   FE 7B                 	CPI	'z'+1
  2275'   D2 227A'              	JNC	GF_DN
  2278'   E6 DF                 	ANI	0DFH
  227A'                         GF_DN:
  227A'   B7                    	ORA	A
  227B'   C9                    	RET
  227C'                         GF_CTL:
  227C'   BF                    	CMP	A
  227D'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  227E'                         SKIPB:
  227E'   7E                    	MOV	A,M
  227F'   FE 20                 	CPI	' '
  2281'   C2 2288'              	JNZ	SB_DN
  2284'   23                    	INX	H
  2285'   C3 227E'              	JMP	SKIPB
  2288'                         SB_DN:
  2288'   B7                    	ORA	A
  2289'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  228A'                         ISLOW:
