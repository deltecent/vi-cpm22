                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0D02'                         CURRW:
  0D02'   2A 0000*              	LHLD	WINROW
  0D05'   EB                    	XCHG
  0D06'   2A 0000*              	LHLD	LNDLT
  0D09'   19                    	DAD	D		; HL = row (signed)
  0D0A'   7C                    	MOV	A,H
  0D0B'   B7                    	ORA	A
  0D0C'   FA 0D1F'              	JM	CRW_0		; above the screen -> top row
  0D0F'   C2 0D1A'              	JNZ	CRW_BT		; far below -> bottom row
  0D12'   3A 0000*              	LDA	NEDIT
  0D15'   3D                    	DCR	A		; A = bottom row
  0D16'   BD                    	CMP	L		; CY iff bottom < row
  0D17'   D8                    	RC
  0D18'   7D                    	MOV	A,L
  0D19'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


  0D1A'                         CRW_BT:
  0D1A'   3A 0000*              	LDA	NEDIT
  0D1D'   3D                    	DCR	A
  0D1E'   C9                    	RET
  0D1F'                         CRW_0:
  0D1F'   AF                    	XRA	A
  0D20'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0D21'                         SETRWT:
  0D21'   2A 0000*              	LHLD	LNDLT
  0D24'   EB                    	XCHG
  0D25'   6F                    	MOV	L,A
  0D26'   26 00                 	MVI	H,0
  0D28'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0D2B'   22 0000*              	SHLD	WINROW
  0D2E'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0D2F'                         MVROW:
  0D2F'   47                    	MOV	B,A
  0D30'   CD 0D02'              	CALL	CURRW
  0D33'   90                    	SUB	B		; A = row now - target
  0D34'   C8                    	RZ
  0D35'   DA 0D3E'              	JC	MR_DN
  0D38'   6F                    	MOV	L,A
  0D39'   26 00                 	MVI	H,0
  0D3B'   C3 098C'              	JMP	KCORE
  0D3E'                         MR_DN:
  0D3E'   2F                    	CMA
  0D3F'   3C                    	INR	A		; A = target - row now
  0D40'   6F                    	MOV	L,A
  0D41'   26 00                 	MVI	H,0
  0D43'   C3 08EF'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0D46'                         VC_HIGH:
  0D46'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D49'   2B                    	DCX	H		; row = count - 1
  0D4A'   7C                    	MOV	A,H
  0D4B'   B7                    	ORA	A
  0D4C'   3A 0000*              	LDA	SCBOT
  0D4F'   C2 0D57'              	JNZ	VH_GO		; >= 256 -> the last text row
  0D52'   BD                    	CMP	L		; CY iff SCBOT < row
  0D53'   DA 0D57'              	JC	VH_GO
  0D56'   7D                    	MOV	A,L
  0D57'                         VH_GO:
  0D57'   CD 0D2F'              	CALL	MVROW
  0D5A'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0D5D'                         VC_MIDL:
  0D5D'   CD 0678'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0D60'   3A 0000*              	LDA	SCBOT
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D63'   B7                    	ORA	A		; clear CY for the shift
  0D64'   1F                    	RAR			; A = SCBOT / 2
  0D65'   CD 0D2F'              	CALL	MVROW
  0D68'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0D6B'                         VC_LOWL:
  0D6B'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D6E'   2B                    	DCX	H		; count - 1
  0D6F'   3A 0000*              	LDA	SCBOT
  0D72'   5F                    	MOV	E,A
  0D73'   16 00                 	MVI	D,0
  0D75'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0D76'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0D79'   3E 00                 	MVI	A,0
  0D7B'   D2 0D82'              	JNC	VL_GO		; at or past the top -> row 0
  0D7E'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0D81'   7D                    	MOV	A,L
  0D82'                         VL_GO:
  0D82'   CD 0D2F'              	CALL	MVROW
  0D85'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0D88'                         VC_PGDN:
  0D88'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0D8B'   3A 0000*              	LDA	SCEOF
  0D8E'   B7                    	ORA	A
  0D8F'   CA 0D9D'              	JZ	VPD_N
  0D92'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0D95'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0D96'   C8                    	RZ			; it already is
  0D97'   CD 0D2F'              	CALL	MVROW
  0D9A'   C3 0DAE'              	JMP	VPD_TP
  0D9D'                         VPD_N:
  0D9D'   3A 0000*              	LDA	NEDIT
  0DA0'   D6 02                 	SUI	2
  0DA2'   CD 0DF6'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0DA5'   E5                    	PUSH	H
  0DA6'   AF                    	XRA	A
  0DA7'   CD 0D2F'              	CALL	MVROW		; the top line
  0DAA'   E1                    	POP	H
  0DAB'   CD 08EF'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0DAE'                         VPD_TP:
  0DAE'   AF                    	XRA	A
  0DAF'   CD 0D21'              	CALL	SETRWT		; to the top row
  0DB2'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DB5'                         VC_PGUP:
  0DB5'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  0DB8'   3A 0000*              	LDA	SCBOF
  0DBB'   B7                    	ORA	A
  0DBC'   C0                    	RNZ
  0DBD'   3A 0000*              	LDA	NEDIT
  0DC0'   47                    	MOV	B,A
  0DC1'   3A 0000*              	LDA	SCEOF
  0DC4'   B7                    	ORA	A
  0DC5'   CA 0DD6'              	JZ	VPU_2
  0DC8'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0DCB'   FE 02                 	CPI	2
  0DCD'   D2 0DD6'              	JNC	VPU_2
  0DD0'   2F                    	CMA
  0DD1'   3C                    	INR	A
  0DD2'   80                    	ADD	B
  0DD3'   C3 0DD9'              	JMP	VPU_P
  0DD6'                         VPU_2:
  0DD6'   78                    	MOV	A,B
  0DD7'   D6 02                 	SUI	2
  0DD9'                         VPU_P:
  0DD9'   CD 0DF6'              	CALL	MULSAT		; HL = count * page
  0DDC'   E5                    	PUSH	H
  0DDD'   AF                    	XRA	A
  0DDE'   CD 0D2F'              	CALL	MVROW		; the top line
  0DE1'   E1                    	POP	H
  0DE2'   CD 098C'              	CALL	KCORE		; the new top line
  0DE5'   AF                    	XRA	A
  0DE6'   CD 0D21'              	CALL	SETRWT		; on the top row
  0DE9'   3A 0000*              	LDA	NEDIT
  0DEC'   3D                    	DCR	A
  0DED'   6F                    	MOV	L,A
  0DEE'   26 00                 	MVI	H,0
  0DF0'   CD 08EF'              	CALL	JCORE		; the bottom row's line
  0DF3'   C3 0834'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0DF6'                         MULSAT:
  0DF6'   EB                    	XCHG
  0DF7'   21 0000               	LXI	H,0
  0DFA'   B7                    	ORA	A
  0DFB'   C8                    	RZ
  0DFC'                         MS_LP:
  0DFC'   19                    	DAD	D
  0DFD'   DA 0E05'              	JC	MS_SAT
  0E00'   3D                    	DCR	A
  0E01'   C2 0DFC'              	JNZ	MS_LP
  0E04'   C9                    	RET
  0E05'                         MS_SAT:
  0E05'   21 FFFF               	LXI	H,0FFFFH
  0E08'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E09'                         VC_HFDN:
  0E09'   CD 075A'              	CALL	SETMOV
  0E0C'   CD 0D02'              	CALL	CURRW
  0E0F'   32 2A16'              	STA	HFROW
  0E12'   CD 0E80'              	CALL	HFCNT		; HL = lines
  0E15'   3A 2A16'              	LDA	HFROW
  0E18'   47                    	MOV	B,A
  0E19'   3A 0000*              	LDA	SCEOF
  0E1C'   B7                    	ORA	A
  0E1D'   CA 0E25'              	JZ	VHD_GO
  0E20'   3A 0000*              	LDA	SCBOT		; the last line's row
  0E23'   B8                    	CMP	B
  0E24'   C8                    	RZ			; the cursor is on it
  0E25'                         VHD_GO:
  0E25'   CD 08EF'              	CALL	JCORE
  0E28'   3A 0000*              	LDA	SCEOF
  0E2B'   B7                    	ORA	A
  0E2C'   C2 0834'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0E2F'   3A 2A16'              	LDA	HFROW
  0E32'   CD 0D21'              	CALL	SETRWT
  0E35'   3E 01                 	MVI	A,1
  0E37'   32 0000*              	STA	WFILL		; not past the end of the file
  0E3A'   C3 0834'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0E3D'                         VC_HFUP:
  0E3D'   CD 075A'              	CALL	SETMOV
  0E40'   CD 0D02'              	CALL	CURRW
  0E43'   32 2A16'              	STA	HFROW
  0E46'   CD 0E80'              	CALL	HFCNT		; HL = lines
  0E49'   CD 0E60'              	CALL	ONFST
  0E4C'   C8                    	RZ			; the cursor is on the first line
  0E4D'   CD 098C'              	CALL	KCORE
  0E50'   3A 0000*              	LDA	SCBOF
  0E53'   B7                    	ORA	A
  0E54'   C2 0834'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0E57'   3A 2A16'              	LDA	HFROW
  0E5A'   CD 0D21'              	CALL	SETRWT
  0E5D'   C3 0834'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0E60'                         ONFST:
  0E60'   E5                    	PUSH	H
  0E61'   2A 0000*              	LHLD	OUTPOS
  0E64'   7C                    	MOV	A,H
  0E65'   B5                    	ORA	L
  0E66'   C2 0E7E'              	JNZ	OF_RET
  0E69'   2A 0000*              	LHLD	TXTBEG
  0E6C'   EB                    	XCHG			; DE = TXTBEG
  0E6D'   2A 0000*              	LHLD	GAPBEG
  0E70'                         OF_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0E70'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0E73'   CA 0E7E'              	JZ	OF_RET
  0E76'   2B                    	DCX	H
  0E77'   7E                    	MOV	A,M
  0E78'   FE 0A                 	CPI	LF
  0E7A'   C2 0E70'              	JNZ	OF_LP
  0E7D'   B7                    	ORA	A		; NZ
  0E7E'                         OF_RET:
  0E7E'   E1                    	POP	H
  0E7F'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0E80'                         HFCNT:
  0E80'   2A 2A0A'              	LHLD	CMDCNT
  0E83'   7C                    	MOV	A,H
  0E84'   B5                    	ORA	L
  0E85'   CA 0E9C'              	JZ	HFC_AM
  0E88'   CD 068B'              	CALL	GETCNT		; HL = count; clears it
  0E8B'   3A 0000*              	LDA	NEDIT
  0E8E'   5F                    	MOV	E,A
  0E8F'   16 00                 	MVI	D,0
  0E91'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0E94'   D2 0E98'              	JNC	HFC_ST
  0E97'   EB                    	XCHG			; HL = NEDIT
  0E98'                         HFC_ST:
  0E98'   7D                    	MOV	A,L
  0E99'   32 2A17'              	STA	HFAMT
  0E9C'                         HFC_AM:
  0E9C'   3A 2A17'              	LDA	HFAMT
  0E9F'   B7                    	ORA	A
  0EA0'   C2 0EAD'              	JNZ	HFC_HL
  0EA3'   3A 0000*              	LDA	NEDIT
  0EA6'   B7                    	ORA	A
  0EA7'   1F                    	RAR
  0EA8'   B7                    	ORA	A
  0EA9'   C2 0EAD'              	JNZ	HFC_HL
  0EAC'   3C                    	INR	A		; at least one line
  0EAD'                         HFC_HL:
  0EAD'   6F                    	MOV	L,A
  0EAE'   26 00                 	MVI	H,0
  0EB0'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0EB1'                         VC_REDR:
  0EB1'   C3 068B'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0EB4'                         VC_G:
  0EB4'   CD 075A'              	CALL	SETMOV
  0EB7'   CD 0F76'              	CALL	GZONE		; the screen's top line, before the move
  0EBA'   CD 06B4'              	CALL	BRKON		; ... and a ^C may stop it from here on
  0EBD'   2A 2A0A'              	LHLD	CMDCNT
  0EC0'   7C                    	MOV	A,H
  0EC1'   B5                    	ORA	L
  0EC2'   C2 0ED5'              	JNZ	VG_N
  0EC5'   AF                    	XRA	A		; forward
  0EC6'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0EC9'   CD 06EB'              	CALL	BRKOFF
  0ECC'   DA 0703'              	JC	BRKBAK
  0ECF'   CD 0A23'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0ED2'   C3 0F8E'              	JMP	GPLACE
  0ED5'                         VG_N:
  0ED5'   CD 068B'              	CALL	GETCNT		; HL = target line (1-based)
  0ED8'                         VG_LN:
  0ED8'   CD 0EE4'              	CALL	GOLN
  0EDB'   CD 06EB'              	CALL	BRKOFF
  0EDE'   DA 0703'              	JC	BRKBAK
  0EE1'   C3 0F8E'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  0EE4'                         GOLN:
  0EE4'   E5                    	PUSH	H
  0EE5'   CD 0000*              	CALL	CNTLF
  0EE8'   23                    	INX	H		; HL = the cursor's line
  0EE9'   D1                    	POP	D		; DE = the line wanted
  0EEA'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  0EED'   DA 0EF8'              	JC	GLN_BK
  0EF0'   EB                    	XCHG
  0EF1'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  0EF4'   AF                    	XRA	A
  0EF5'   C3 0EFD'              	JMP	GLN_MV
  0EF8'                         GLN_BK:
  0EF8'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  0EFB'   3E FF                 	MVI	A,0FFH
  0EFD'                         GLN_MV:
  0EFD'   CD 0000*              	CALL	MVLIND
  0F00'   CD 0A1D'              	CALL	ATEOF
  0F03'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  0F06'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


                                ; placed as G places it.
  0F07'                         VC_LG:
  0F07'   CD 075A'              	CALL	SETMOV
  0F0A'   3A 2A32'              	LDA	GSAVE
  0F0D'   B7                    	ORA	A
  0F0E'   C2 0F17'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0F11'   3E 01                 	MVI	A,PG
  0F13'   32 2A31'              	STA	GPEND
  0F16'   C9                    	RET
  0F17'                         VLG_GG:
  0F17'   CD 0F76'              	CALL	GZONE
  0F1A'   CD 06B4'              	CALL	BRKON
  0F1D'   CD 068B'              	CALL	GETCNT		; HL = target line (no count: 1)
  0F20'   C3 0ED8'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  0F23'                         SUB24:
  0F23'   4F                    	MOV	C,A
  0F24'   7D                    	MOV	A,L
  0F25'   93                    	SUB	E
  0F26'   6F                    	MOV	L,A
  0F27'   7C                    	MOV	A,H
  0F28'   9A                    	SBB	D
  0F29'   67                    	MOV	H,A
  0F2A'   79                    	MOV	A,C
  0F2B'   98                    	SBB	B
  0F2C'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  0F2D'                         CURFP:
  0F2D'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0F30'                         FPOS:
  0F30'   C5                    	PUSH	B
  0F31'   D5                    	PUSH	D
  0F32'   EB                    	XCHG
  0F33'   2A 0000*              	LHLD	TXTBEG
  0F36'   EB                    	XCHG
  0F37'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0F3A'   EB                    	XCHG			; DE = that
  0F3B'   2A 0000*              	LHLD	OUTPOS
  0F3E'   7C                    	MOV	A,H
  0F3F'   B7                    	ORA	A		; CY = 0
  0F40'   1F                    	RAR
  0F41'   47                    	MOV	B,A
  0F42'   7D                    	MOV	A,L
  0F43'   1F                    	RAR
  0F44'   67                    	MOV	H,A
  0F45'   3E 00                 	MVI	A,0
  0F47'   1F                    	RAR
  0F48'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0F49'   19                    	DAD	D
  0F4A'   78                    	MOV	A,B
  0F4B'   CE 00                 	ACI	0		; A:HL = the position
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F4D'   D1                    	POP	D
  0F4E'   C1                    	POP	B
  0F4F'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0F50'                         ZSAVE:
  0F50'   2A 2A0A'              	LHLD	CMDCNT
  0F53'   22 2A70'              	SHLD	ZSVCNT
  0F56'   2A 0000*              	LHLD	AUXCNT
  0F59'   22 2A72'              	SHLD	ZSVAUX
  0F5C'   3A 0000*              	LDA	DIRFLG
  0F5F'   32 2A74'              	STA	ZSVDIR
  0F62'   C9                    	RET
  0F63'                         ZREST:
  0F63'   2A 2A70'              	LHLD	ZSVCNT
  0F66'   22 2A0A'              	SHLD	CMDCNT
  0F69'   2A 2A72'              	LHLD	ZSVAUX
  0F6C'   22 0000*              	SHLD	AUXCNT
  0F6F'   3A 2A74'              	LDA	ZSVDIR
  0F72'   32 0000*              	STA	DIRFLG
  0F75'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0F76'                         GZONE:
  0F76'   CD 0F50'              	CALL	ZSAVE
  0F79'   CD 0D02'              	CALL	CURRW
  0F7C'   6F                    	MOV	L,A
  0F7D'   26 00                 	MVI	H,0
  0F7F'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0F82'   CD 0F30'              	CALL	FPOS
  0F85'   22 0000*              	SHLD	ZTOP
  0F88'   32 0002*              	STA	ZTOP+2
  0F8B'   C3 0F63'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  0F8E'                         GPLACE:
  0F8E'   CD 0F50'              	CALL	ZSAVE
  0F91'   CD 0F2D'              	CALL	CURFP
  0F94'   EB                    	XCHG
  0F95'   2A 0000*              	LHLD	ZTOP
  0F98'   EB                    	XCHG
  0F99'   4F                    	MOV	C,A		; C:HL = the target's position
  0F9A'   3A 0002*              	LDA	ZTOP+2
  0F9D'   47                    	MOV	B,A		; B:DE = the top's
  0F9E'   79                    	MOV	A,C
  0F9F'   CD 0F23'              	CALL	SUB24
  0FA2'   22 2A6D'              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  0FA5'   DA 0FF2'              	JC	GP_UP
  0FA8'   B7                    	ORA	A
  0FA9'   C2 1033'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0FAC'   3A 0000*              	LDA	NEDIT
  0FAF'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FB0'   16 00                 	MVI	D,0
  0FB2'   B7                    	ORA	A
  0FB3'   1F                    	RAR
  0FB4'   6F                    	MOV	L,A
  0FB5'   26 00                 	MVI	H,0
  0FB7'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0FB8'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0FBB'   CD 0684'              	CALL	GBSUB		; HL = bytes from there to the target
  0FBE'   EB                    	XCHG
  0FBF'   2A 2A6D'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0FC2'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0FC5'   DA 1033'              	JC	GP_MID
  0FC8'   CD 0684'              	CALL	GBSUB		; HL = the top line's start (resident)
  0FCB'   01 0000               	LXI	B,0		; BC = lines from the top
  0FCE'                         GP_CNT:
  0FCE'   7A                    	MOV	A,D
  0FCF'   B3                    	ORA	E
  0FD0'   CA 0FDF'              	JZ	GP_DN
  0FD3'   7E                    	MOV	A,M
  0FD4'   23                    	INX	H
  0FD5'   1B                    	DCX	D
  0FD6'   FE 0A                 	CPI	LF
  0FD8'   C2 0FCE'              	JNZ	GP_CNT
  0FDB'   03                    	INX	B
  0FDC'   C3 0FCE'              	JMP	GP_CNT
  0FDF'                         GP_DN:
  0FDF'   3A 0000*              	LDA	NEDIT
  0FE2'   3D                    	DCR	A
  0FE3'   5F                    	MOV	E,A
  0FE4'   16 00                 	MVI	D,0		; DE = the bottom row
  0FE6'   60                    	MOV	H,B
  0FE7'   69                    	MOV	L,C
  0FE8'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0FEB'   DA 103D'              	JC	GP_SET		; A = the bottom row
  0FEE'   7D                    	MOV	A,L		; on the screen: its row
  0FEF'   C3 105D'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0FF2'                         GP_UP:
  0FF2'   3C                    	INR	A
  0FF3'   C2 1033'              	JNZ	GP_MID		; 64K bytes or more above
  0FF6'   2A 2A6D'              	LHLD	ZDIF
  0FF9'   EB                    	XCHG
  0FFA'   21 0000               	LXI	H,0
  0FFD'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1000'   7C                    	MOV	A,H
  1001'   B5                    	ORA	L
  1002'   CA 1033'              	JZ	GP_MID		; exactly 64K
  1005'   EB                    	XCHG			; DE = bytes to read
  1006'   AF                    	XRA	A
  1007'   32 2A6F'              	STA	ZLF
  100A'   CD 0000*              	CALL	RGET0
  100D'                         GP_RD:
  100D'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1010'   DA 1033'              	JC	GP_MID
  1013'   FE 0A                 	CPI	LF
  1015'   C2 1029'              	JNZ	GP_RN
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  1018'   3A 0000*              	LDA	NEDIT
  101B'   B7                    	ORA	A
  101C'   1F                    	RAR
  101D'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  101F'   E5                    	PUSH	H
  1020'   21 2A6F'              	LXI	H,ZLF
  1023'   34                    	INR	M
  1024'   BE                    	CMP	M		; CY iff more lines than that
  1025'   E1                    	POP	H
  1026'   DA 1033'              	JC	GP_MID
  1029'                         GP_RN:
  1029'   1B                    	DCX	D
  102A'   7A                    	MOV	A,D
  102B'   B3                    	ORA	E
  102C'   C2 100D'              	JNZ	GP_RD
  102F'   AF                    	XRA	A		; the top row
  1030'   C3 103D'              	JMP	GP_SET
  1033'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1033'   3E 01                 	MVI	A,1
  1035'   32 0000*              	STA	WFILL		; not past the end of the file
  1038'   3A 0000*              	LDA	NEDIT
  103B'   B7                    	ORA	A
  103C'   1F                    	RAR			; the middle row
  103D'                         GP_SET:
  103D'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  103E'   26 00                 	MVI	H,0
  1040'   22 0000*              	SHLD	WINROW
  1043'   21 0000               	LXI	H,0
  1046'   22 0000*              	SHLD	LNDLT
  1049'   CD 077B'              	CALL	SETFUL		; the window may have paged: full repaint
  104C'                         GP_FIN:
  104C'   CD 0F63'              	CALL	ZREST
  104F'   3A 2A97'              	LDA	GPKEEP
  1052'   B7                    	ORA	A
  1053'   CA 0834'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  1056'   AF                    	XRA	A
  1057'   32 2A97'              	STA	GPKEEP
  105A'   C3 057D'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  105D'                         GP_ONS:
  105D'   6F                    	MOV	L,A
  105E'   26 00                 	MVI	H,0		; HL = the row it lands on
  1060'   EB                    	XCHG
  1061'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  1064'   EB                    	XCHG
  1065'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  1068'   22 0000*              	SHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  106B'   3E 01                 	MVI	A,R_MOVE
  106D'   32 2A0E'              	STA	RINTENT
  1070'   C3 104C'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  1073'                         OPPEND:
  1073'   AF                    	XRA	A
  1074'   32 2A37'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  1077'   3A 2A34'              	LDA	PSAVE
  107A'   FE 63                 	CPI	'c'
  107C'   C2 1099'              	JNZ	OPP_ND
  107F'   79                    	MOV	A,C
  1080'   FE 77                 	CPI	'w'
  1082'   CA 108A'              	JZ	OPP_W
  1085'   FE 57                 	CPI	'W'
  1087'   C2 1099'              	JNZ	OPP_ND
  108A'                         OPP_W:
  108A'   CD 126C'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  108D'   DA 1099'              	JC	OPP_ND
  1090'   79                    	MOV	A,C
  1091'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  1093'   4F                    	MOV	C,A
  1094'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  1096'   32 2A37'              	STA	CWEOL		;   see the clamp in OPA_F
  1099'                         OPP_ND:
  1099'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  109A'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  109C'   C2 10B0'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  109F'   CD 021C'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  10A2'   DA 1140'              	JC	OPABRT
  10A5'   79                    	MOV	A,C
  10A6'   FE 67                 	CPI	'g'
  10A8'   C2 1140'              	JNZ	OPABRT
  10AB'   3E 01                 	MVI	A,PG
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  10AD'   32 2A32'              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  10B0'                         OPP_NG:
  10B0'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  10B1'   21 2A34'              	LXI	H,PSAVE
  10B4'   BE                    	CMP	M
  10B5'   CA 128D'              	JZ	OPLINE
  10B8'   79                    	MOV	A,C		; (OPCLS classifies the key)
  10B9'   CD 12A3'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  10BC'   DA 1140'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  10BF'   32 2A36'              	STA	OPCLSV
  10C2'   47                    	MOV	B,A		; B = the class
  10C3'   3A 2A34'              	LDA	PSAVE
  10C6'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  10C8'   C2 10D4'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  10CB'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  10CC'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  10CE'   C2 10F6'              	JNZ	OPP_GO
  10D1'   C3 10DF'              	JMP	OPP_NO
  10D4'                         OPP_NC:
  10D4'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  10D6'   C2 10F6'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  10D9'   78                    	MOV	A,B		;   a charwise register would need a type flag
  10DA'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  10DC'   CA 10F6'              	JZ	OPP_GO		;   within a line -- neither of which is built
  10DF'                         OPP_NO:
  10DF'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  10E0'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  10E2'   CA 10F0'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  10E5'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  10E7'   CA 10F0'              	JZ	OPP_SW		;   so swallow it before dropping the command
  10EA'   CD 034C'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  10ED'   C2 1140'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  10F0'                         OPP_SW:
  10F0'   CD 021C'              	CALL	MKGETK
  10F3'   C3 1140'              	JMP	OPABRT
  10F6'                         OPP_GO:
  10F6'   AF                    	XRA	A
  10F7'   32 2A15'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  10FA'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  10FD'   22 2A38'              	SHLD	OPSTA
  1100'   C5                    	PUSH	B
  1101'   21 2A3C'              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1104'   CD 044F'              	CALL	FPSTO		;   only good until the motion pages the window
  1107'   3A 2A36'              	LDA	OPCLSV
  110A'   FE 02                 	CPI	2
  110C'   CC 1143'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  110F'   C1                    	POP	B
  1110'   21 2938'              	LXI	H,CMDTAB
  1113'   CD 00C9'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1116'   3A 2A34'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1119'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  111A'   CA 075A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  111D'   CD 116F'              	CALL	OPSFIX		; where the start is in the window NOW
  1120'   D2 118B'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1123'   22 2A38'              	SHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


  1126'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  1129'   22 2A3A'              	SHLD	OPEND2
  112C'   3A 2A34'              	LDA	PSAVE
  112F'   FE 79                 	CPI	'y'
  1131'   CA 17B8'              	JZ	OPYANK		; a yank takes the span without losing it
  1134'   CD 12DE'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  1137'   3A 2A34'              	LDA	PSAVE
  113A'   FE 63                 	CPI	'c'
  113C'   C0                    	RNZ
  113D'   C3 1574'              	JMP	SETINS
  1140'                         OPABRT:				; not a motion -> the operator is dropped and
  1140'   C3 00A9'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1143'                         OPENDS:
  1143'   2A 2A38'              	LHLD	OPSTA
  1146'   CD 05E4'              	CALL	BOL
  1149'   11 2A3F'              	LXI	D,OPSLO
  114C'   CD 1161'              	CALL	OPE_ST
  114F'   2A 2A38'              	LHLD	OPSTA
  1152'   CD 0614'              	CALL	NLSTART
  1155'   11 2A42'              	LXI	D,OPSHI
  1158'   CD 1161'              	CALL	OPE_ST
  115B'   2A 2A38'              	LHLD	OPSTA
  115E'   C3 0000*              	JMP	GOTO
  1161'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  1161'   D5                    	PUSH	D
  1162'   CD 0000*              	CALL	GOTO
  1165'   E1                    	POP	H
  1166'   C3 044F'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  1169'                         CURBD:
  1169'   CD 0F2D'              	CALL	CURFP
  116C'   EB                    	XCHG
  116D'   47                    	MOV	B,A
  116E'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  116F'                         OPSFIX:
  116F'   21 2A3C'              	LXI	H,OPSFP
  1172'   CD 0402'              	CALL	MKLOAD
  1175'   CD 1169'              	CALL	CURBD
  1178'   2A 2AA1'              	LHLD	MKPOS
  117B'   3A 2AA3'              	LDA	MKPOS+2
  117E'   CD 0F23'              	CALL	SUB24
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  1181'   B4                    	ORA	H
  1182'   B5                    	ORA	L
  1183'   C2 040F'              	JNZ	MKWIN
  1186'   CD 0000*              	CALL	CUROFF
  1189'   37                    	STC
  118A'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  118B'                         OPPGD:
  118B'   47                    	MOV	B,A
  118C'   3A 2A36'              	LDA	OPCLSV
  118F'   FE 02                 	CPI	2
  1191'   C2 124D'              	JNZ	OPG_NO
  1194'   3A 2A34'              	LDA	PSAVE
  1197'   FE 64                 	CPI	'd'
  1199'   C2 124D'              	JNZ	OPG_NO
  119C'   04                    	INR	B
  119D'   CA 11AC'              	JZ	OPG_FW
  11A0'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  11A3'   CD 05E4'              	CALL	BOL		;   and the high end is OPSHI as it stands
  11A6'   CD 0000*              	CALL	GOTO
  11A9'   C3 11C4'              	JMP	OPG_GO
  11AC'                         OPG_FW:
  11AC'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  11AF'   CD 0614'              	CALL	NLSTART		;   landed on, and the low one is where the
  11B2'   11 2A42'              	LXI	D,OPSHI		;   start line began
  11B5'   CD 1161'              	CALL	OPE_ST
  11B8'   21 2A3F'              	LXI	H,OPSLO
  11BB'   CD 0402'              	CALL	MKLOAD
  11BE'   CD 03CF'              	CALL	MKPAGE
  11C1'   CD 0000*              	CALL	GOTO
  11C4'                         OPG_GO:
  11C4'   CD 1169'              	CALL	CURBD
  11C7'   2A 2A42'              	LHLD	OPSHI
  11CA'   3A 2A44'              	LDA	OPSHI+2
  11CD'   CD 0F23'              	CALL	SUB24		; A:HL = the bytes to take
  11D0'                         OPG_SV:
  11D0'   22 2A45'              	SHLD	OPTOGO
  11D3'   32 2A47'              	STA	OPTOGO+2
  11D6'                         OPG_NX:
  11D6'   CD 0667'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  11D9'   CD 0000*              	CALL	SUBHD
  11DC'   EB                    	XCHG			; DE = what the window holds past the cursor
  11DD'   2A 2A45'              	LHLD	OPTOGO
  11E0'   3A 2A47'              	LDA	OPTOGO+2
  11E3'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11E4'   C2 1217'              	JNZ	OPG_PG		; 64K or more to go
  11E7'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  11EA'   DA 1217'              	JC	OPG_PG
  11ED'   CA 1217'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  11F0'                         OPG_FN:				; the rest of it is here
  11F0'   E5                    	PUSH	H
  11F1'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  11F4'   CD 0000*              	CALL	CUROFF
  11F7'   22 2A48'              	SHLD	OPLO
  11FA'   D1                    	POP	D
  11FB'   19                    	DAD	D
  11FC'   22 2A4A'              	SHLD	OPHI
  11FF'   CD 13E4'              	CALL	OPDSPN
  1202'   CD 0A1D'              	CALL	ATEOF
  1205'   D2 1266'              	JNC	OPMID
  1208'   CD 0E60'              	CALL	ONFST		; deleted to the end of the file: onto the new
  120B'   CA 1266'              	JZ	OPMID		;   last line, if there is one -- and the pager
  120E'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1211'   CD 0000*              	CALL	SETBWD
  1214'   C3 1266'              	JMP	OPMID
  1217'                         OPG_PG:
  1217'   7A                    	MOV	A,D
  1218'   B3                    	ORA	E
  1219'   C2 1232'              	JNZ	OPG_DL
  121C'   CD 0A1D'              	CALL	ATEOF		; nothing held past the cursor
  121F'   21 0000               	LXI	H,0
  1222'   DA 11F0'              	JC	OPG_FN		; ... and no more to come: the file ran out
  1225'   2B                    	DCX	H
  1226'   CD 0000*              	CALL	SETC0
  1229'   CD 0000*              	CALL	GOLINE
  122C'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  122F'   C3 11D6'              	JMP	OPG_NX
  1232'                         OPG_DL:
  1232'   D5                    	PUSH	D
  1233'   21 FFFF               	LXI	H,0FFFFH
  1236'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  1239'   E1                    	POP	H
  123A'   E5                    	PUSH	H
  123B'   CD 0000*              	CALL	DELFWD
  123E'   D1                    	POP	D
  123F'   06 00                 	MVI	B,0
  1241'   2A 2A45'              	LHLD	OPTOGO
  1244'   3A 2A47'              	LDA	OPTOGO+2
  1247'   CD 0F23'              	CALL	SUB24
  124A'   C3 11D0'              	JMP	OPG_SV
  124D'                         OPG_NO:
  124D'   0E 07                 	MVI	C,BEL
  124F'   CD 0000*              	CALL	BCONOU
  1252'                         OPG_HM:				; the cursor back where the command found it
  1252'   21 2A3C'              	LXI	H,OPSFP
  1255'   CD 0402'              	CALL	MKLOAD
  1258'   CD 03CF'              	CALL	MKPAGE
  125B'   CD 0000*              	CALL	GOTO
  125E'   AF                    	XRA	A
  125F'   32 2A34'              	STA	PSAVE
  1262'   3C                    	INR	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


  1263'   32 2A97'              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  1266'                         OPMID:
  1266'   CD 0F50'              	CALL	ZSAVE
  1269'   C3 1033'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  126C'                         ONWHIT:
  126C'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  126F'   CA 128B'              	JZ	OW_YES
  1272'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1275'   FE 20                 	CPI	' '
  1277'   CA 128B'              	JZ	OW_YES
  127A'   FE 09                 	CPI	TAB
  127C'   CA 128B'              	JZ	OW_YES
  127F'   FE 0D                 	CPI	CR
  1281'   CA 128B'              	JZ	OW_YES
  1284'   FE 0A                 	CPI	LF
  1286'   CA 128B'              	JZ	OW_YES
  1289'   B7                    	ORA	A		; a char to change: CY clear
  128A'   C9                    	RET
  128B'                         OW_YES:
  128B'   37                    	STC
  128C'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  128D'                         OPLINE:
  128D'   3A 2A34'              	LDA	PSAVE
  1290'   FE 63                 	CPI	'c'
  1292'   CA 075A'              	JZ	SETMOV
  1295'   FE 79                 	CPI	'y'
  1297'   CA 1797'              	JZ	VY_YY
  129A'   21 2A3C'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  129D'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  12A0'   C3 1710'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  12A3'                         OPCLS:
  12A3'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  12A5'   CA 12B2'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  12A8'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  12AA'   C2 12C6'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  12AD'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  12AF'   C3 12B4'              	JMP	OPC_FK
  12B2'                         OPC_SEM:
  12B2'   06 00                 	MVI	B,0		; ';' runs it as it stands
  12B4'                         OPC_FK:
  12B4'   3A 2A8D'              	LDA	FNDKND
  12B7'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  12B8'   37                    	STC
  12B9'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  12BA'   A8                    	XRA	B		; ... and now the direction ',' asked for
  12BB'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  12BD'   CA 12C4'              	JZ	OPC_EXC
  12C0'   3E 01                 	MVI	A,1
  12C2'   B7                    	ORA	A		; CY clear: a motion, class 1
  12C3'   C9                    	RET
  12C4'                         OPC_EXC:
  12C4'   AF                    	XRA	A		; class 0, CY clear
  12C5'   C9                    	RET
  12C6'                         OPC_TB:
  12C6'   47                    	MOV	B,A
  12C7'   21 1468'              	LXI	H,OPCTAB
  12CA'                         OPC_LP:
  12CA'   7E                    	MOV	A,M
  12CB'   B7                    	ORA	A
  12CC'   CA 12DC'              	JZ	OPC_MS		; end of table -> not a motion
  12CF'   B8                    	CMP	B
  12D0'   CA 12D8'              	JZ	OPC_HT
  12D3'   23                    	INX	H
  12D4'   23                    	INX	H
  12D5'   C3 12CA'              	JMP	OPC_LP
  12D8'                         OPC_HT:
  12D8'   23                    	INX	H
  12D9'   7E                    	MOV	A,M		; class byte
  12DA'   B7                    	ORA	A		; clear CY
  12DB'   C9                    	RET
  12DC'                         OPC_MS:
  12DC'   37                    	STC
  12DD'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  12DE'                         OPAPPL:
  12DE'   3A 2A36'              	LDA	OPCLSV
  12E1'   FE 02                 	CPI	2
  12E3'   CA 144C'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  12E6'   2A 2A38'              	LHLD	OPSTA
  12E9'   EB                    	XCHG			; DE = start
  12EA'   2A 2A3A'              	LHLD	OPEND2		; HL = end
  12ED'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  12F0'   DA 1300'              	JC	OPA_F
  12F3'   CA 1300'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  12F6'   22 2A48'              	SHLD	OPLO
  12F9'   EB                    	XCHG
  12FA'   22 2A4A'              	SHLD	OPHI
  12FD'   C3 1371'              	JMP	OPA_C1
  1300'                         OPA_F:
  1300'   EB                    	XCHG			; HL = start, DE = end
  1301'   22 2A48'              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  1304'   EB                    	XCHG			; HL = end
  1305'   3A 2A36'              	LDA	OPCLSV
  1308'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  130A'   CA 136E'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  130D'   FE 01                 	CPI	1
  130F'   C2 133B'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end).
                                	;    'cw' stops at the content end of the line it STARTED on, where a
                                	;    plain 'ce' (and 'de') runs on into the next line's word and 'd%'
                                	;    crosses to its mate -- all four recorded from vim 9.1.  vim's 'cw'
                                	;    is not simply 'ce': the rewrite keeps 'w's own end-of-line stop, so
                                	;    that clamp hangs off CWEOL (the rewrite) and not off the class. ---
  1312'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  1313'   22 2A4A'              	SHLD	OPHI		; park it: CEND clobbers DE
  1316'   2B                    	DCX	H		; the line it landed on ...
  1317'   3A 2A37'              	LDA	CWEOL
  131A'   B7                    	ORA	A
  131B'   CA 1321'              	JZ	OPA_LE
  131E'   2A 2A48'              	LHLD	OPLO		; ... or, for 'cw', the one it started on
  1321'                         OPA_LE:
  1321'   CD 14F2'              	CALL	CEND		; HL = that line's content end
  1324'   EB                    	XCHG			; DE = it
  1325'   2A 2A4A'              	LHLD	OPHI		; HL = hi
  1328'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  132B'   D2 135F'              	JNC	OPA_HI		; hi is inside the line: keep it
  132E'   2A 2A48'              	LHLD	OPLO
  1331'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1334'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1337'   EB                    	XCHG			; HL = the content end: the span stops there
  1338'   C3 135F'              	JMP	OPA_HI
  133B'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  133B'   22 2A4A'              	SHLD	OPHI		; the motion's own end, for now
  133E'   2A 2A48'              	LHLD	OPLO
  1341'   CD 14F2'              	CALL	CEND		; HL = the start line's content end
  1344'   EB                    	XCHG			; DE = that content end
  1345'   3A 2A15'              	LDA	WPULL		; the motion landed on a line's end and was
  1348'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1349'   C2 1355'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  134C'   2A 2A4A'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  134F'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  1352'   D2 1362'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  1355'                         OPA_CE:				;   deletes the word, not all but its last char
  1355'   2A 2A48'              	LHLD	OPLO
  1358'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  135B'   CA 13FE'              	JZ	OPA_LN
  135E'   EB                    	XCHG			; HL = the content end
  135F'                         OPA_HI:
  135F'   22 2A4A'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  1362'                         OPA_DO:
  1362'   CD 13E4'              	CALL	OPDSPN
  1365'   3A 2A34'              	LDA	PSAVE
  1368'   FE 63                 	CPI	'c'
  136A'   C8                    	RZ
  136B'   C3 1503'              	JMP	CLAMPE
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  136E'                         OPA_JP:
  136E'   22 2A4A'              	SHLD	OPHI
  1371'                         OPA_C1:
  1371'   CD 13D9'              	CALL	OPSPNL
  1374'   7C                    	MOV	A,H
  1375'   B5                    	ORA	L
  1376'   CA 1362'              	JZ	OPA_DO		; nothing spanned
  1379'   2A 2A4A'              	LHLD	OPHI
  137C'   CD 05E4'              	CALL	BOL
  137F'   EB                    	XCHG
  1380'   2A 2A4A'              	LHLD	OPHI
  1383'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1386'   C2 1362'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1389'   2A 2A48'              	LHLD	OPLO
  138C'   CD 05E4'              	CALL	BOL
  138F'                         C1_LP:
  138F'   E5                    	PUSH	H
  1390'   EB                    	XCHG
  1391'   2A 2A48'              	LHLD	OPLO
  1394'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  1397'   E1                    	POP	H
  1398'   CA 13B8'              	JZ	C1_LW		; only blanks before lo: whole lines
  139B'   E5                    	PUSH	H
  139C'   CD 0000*              	CALL	CHARAT
  139F'   E1                    	POP	H
  13A0'   23                    	INX	H
  13A1'   FE 20                 	CPI	' '
  13A3'   CA 138F'              	JZ	C1_LP
  13A6'   FE 09                 	CPI	TAB
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13A8'   CA 138F'              	JZ	C1_LP
  13AB'                         C1_CH:
  13AB'   2A 2A4A'              	LHLD	OPHI		; back over the line break to the content end
  13AE'   2B                    	DCX	H		;   of the line before
  13AF'   CD 14F2'              	CALL	CEND
  13B2'   22 2A4A'              	SHLD	OPHI
  13B5'   C3 1362'              	JMP	OPA_DO
  13B8'                         C1_LW:
  13B8'   2A 2A48'              	LHLD	OPLO
  13BB'   CD 05E4'              	CALL	BOL
  13BE'   22 2A48'              	SHLD	OPLO
  13C1'   3A 2A34'              	LDA	PSAVE
  13C4'   FE 63                 	CPI	'c'
  13C6'   CA 13AB'              	JZ	C1_CH
  13C9'   C3 144F'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  13CC'                         SPNBRK:
  13CC'   2A 2A48'              	LHLD	OPLO
  13CF'   CD 05F7'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  13D2'   EB                    	XCHG			; DE = it
  13D3'   2A 2A4A'              	LHLD	OPHI
  13D6'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  13D9'                         OPSPNL:
  13D9'   2A 2A4A'              	LHLD	OPHI
  13DC'   EB                    	XCHG
  13DD'   2A 2A48'              	LHLD	OPLO
  13E0'   EB                    	XCHG			; HL = hi, DE = lo
  13E1'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  13E4'                         OPDSPN:
  13E4'   CD 13CC'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  13E7'   F5                    	PUSH	PSW
  13E8'   2A 2A48'              	LHLD	OPLO
  13EB'   CD 0000*              	CALL	GOTO
  13EE'   CD 13D9'              	CALL	OPSPNL		; HL = hi - lo
  13F1'   CD 0000*              	CALL	DELFWD
  13F4'   CD 018C'              	CALL	MARKMOD
  13F7'   F1                    	POP	PSW
  13F8'   DA 077B'              	JC	SETFUL		; a break went: every row below it moved up
  13FB'   C3 0760'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  13FE'                         OPA_LN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13FE'   3A 2A34'              	LDA	PSAVE
  1401'   FE 63                 	CPI	'c'
  1403'   C2 140C'              	JNZ	OPA_LD
  1406'   2A 2A48'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  1409'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  140C'                         OPA_LD:
  140C'   2A 2A48'              	LHLD	OPLO
  140F'   22 2A38'              	SHLD	OPSTA
  1412'   22 2A3A'              	SHLD	OPEND2
  1415'   C3 144C'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  1418'                         OPALSP:
  1418'   2A 2A38'              	LHLD	OPSTA
  141B'   EB                    	XCHG
  141C'   2A 2A3A'              	LHLD	OPEND2
  141F'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  1422'   DA 142F'              	JC	OPAL_F
  1425'   22 2A48'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  1428'   EB                    	XCHG
  1429'   22 2A4A'              	SHLD	OPHI		; hi-src = start
  142C'   C3 1439'              	JMP	OPAL_R
  142F'                         OPAL_F:
  142F'   EB                    	XCHG			; HL = start
  1430'   22 2A48'              	SHLD	OPLO		; lo-src = start
  1433'   2A 2A3A'              	LHLD	OPEND2
  1436'   22 2A4A'              	SHLD	OPHI		; hi-src = end
  1439'                         OPAL_R:
  1439'   2A 2A48'              	LHLD	OPLO
  143C'   CD 05E4'              	CALL	BOL
  143F'   22 2A48'              	SHLD	OPLO		; lo = BOL(low line)
  1442'   2A 2A4A'              	LHLD	OPHI
  1445'   CD 0614'              	CALL	NLSTART
  1448'   22 2A4A'              	SHLD	OPHI		; hi = start of line past the high line
  144B'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  144C'                         OPALIN:
  144C'   CD 1418'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  144F'                         OPDLIN:
  144F'   CD 13E4'              	CALL	OPDSPN
  1452'   CD 0667'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  1455'   DA 1465'              	JC	OPDL_NB
  1458'   CD 0000*              	CALL	LOGLEN
  145B'   7C                    	MOV	A,H
  145C'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  145D'   C8                    	RZ			; empty buffer
  145E'   2B                    	DCX	H
  145F'   CD 05E4'              	CALL	BOL
  1462'   CD 0000*              	CALL	GOTO
  1465'                         OPDL_NB:
  1465'   C3 0834'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1468'                         OPCTAB:
  1468'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  146C'   62 00 42 00           
  1470'   68 00 6C 00           
  1474'   30 00 5E 00           
  1478'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  147A'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  147E'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1482'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1486'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  148A'   24 01                 
  148C'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1490'   47 02 48 02           
  1494'   4D 02 4C 02           
  1498'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  149A'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  149C'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  149D'                         VCB_C:
  149D'   CD 14A9'              	CALL	VCB_CD
  14A0'   C3 1574'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  14A3'                         VCB_D:
  14A3'   CD 14A9'              	CALL	VCB_CD
  14A6'   C3 1503'              	JMP	CLAMPE		; pull the cursor onto the new last content char
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  14A9'                         VCB_CD:
  14A9'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  14AC'   22 2A48'              	SHLD	OPLO
  14AF'   CD 0000*              	CALL	CUROFF
  14B2'   CD 14F2'              	CALL	CEND		; to the line's content end, the CR,LF left
  14B5'   22 2A4A'              	SHLD	OPHI
  14B8'   C3 13E4'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  14BB'                         VC_X:
  14BB'   CD 08E6'              	CALL	GLSTAL
  14BE'   CD 0760'              	CALL	SETLIN
  14C1'   CD 068B'              	CALL	GETCNT
  14C4'   22 2A4C'              	SHLD	CNTV
  14C7'   CD 0000*              	CALL	CUROFF
  14CA'   22 2A50'              	SHLD	WKI		; cur
  14CD'   CD 14F2'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  14D0'   EB                    	XCHG			; DE = contentend
  14D1'   2A 2A50'              	LHLD	WKI		; HL = cur
  14D4'   EB                    	XCHG			; HL = contentend, DE = cur
  14D5'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  14D8'   7C                    	MOV	A,H
  14D9'   B5                    	ORA	L
  14DA'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  14DB'   EB                    	XCHG			; DE = available
  14DC'   2A 2A4C'              	LHLD	CNTV		; HL = count
  14DF'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  14E2'   DA 14E8'              	JC	VX_USEA
  14E5'   C3 14E9'              	JMP	VX_DEL		; count <= available -> HL = count = del
  14E8'                         VX_USEA:
  14E8'   EB                    	XCHG			; HL = available
  14E9'                         VX_DEL:
  14E9'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  14EC'   CD 018C'              	CALL	MARKMOD
  14EF'   C3 1503'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  14F2'                         CEND:
  14F2'   CD 05F7'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  14F5'   7C                    	MOV	A,H
  14F6'   B5                    	ORA	L
  14F7'   C8                    	RZ			; the start of the text: nothing before it
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14F8'   2B                    	DCX	H
  14F9'   E5                    	PUSH	H
  14FA'   CD 0000*              	CALL	CHARAT
  14FD'   E1                    	POP	H		; HL = term-1
  14FE'   FE 0D                 	CPI	CR
  1500'   C8                    	RZ			; a CR before the LF -> the content ends there
  1501'   23                    	INX	H
  1502'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  1503'                         CLAMPE:
  1503'   CD 0000*              	CALL	CUROFF
  1506'   E5                    	PUSH	H
  1507'   CD 0623'              	CALL	EOLC
  150A'   D1                    	POP	D		; DE = cur
  150B'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  150E'   D8                    	RC
  150F'   C8                    	RZ
  1510'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  1513'                         VC_I:
  1513'   CD 068B'              	CALL	GETCNT
  1516'   C3 1571'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  1519'                         VC_A:
  1519'   CD 068B'              	CALL	GETCNT
  151C'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  151F'   CA 1536'              	JZ	VA_INS
  1522'   EB                    	XCHG			; HL = cur
  1523'   E5                    	PUSH	H
  1524'   CD 0000*              	CALL	CHARAT
  1527'   E1                    	POP	H
  1528'   FE 0A                 	CPI	LF
  152A'   CA 1536'              	JZ	VA_INS		; on the line terminator -> append in place
  152D'   FE 0D                 	CPI	CR
  152F'   CA 1536'              	JZ	VA_INS
  1532'   23                    	INX	H
  1533'   CD 0000*              	CALL	GOTO
  1536'                         VA_INS:
  1536'   C3 1571'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1539'                         VCB_A:
  1539'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  153C'   CD 0623'              	CALL	EOLC		; HL = last content char (the start when empty)
  153F'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  1540'   CD 0000*              	CALL	CHARAT
  1543'   E1                    	POP	H
  1544'   FE 0D                 	CPI	CR
  1546'   CA 154F'              	JZ	VBA_IN		; an empty line: insert at its start
  1549'   FE 0A                 	CPI	LF
  154B'   CA 154F'              	JZ	VBA_IN
  154E'   23                    	INX	H		; past the last content char
  154F'                         VBA_IN:
  154F'   CD 0000*              	CALL	GOTO
  1552'   C3 1571'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1555'                         VCB_I:
  1555'   CD 068B'              	CALL	GETCNT
  1558'   CD 0834'              	CALL	FNBLNK
  155B'   CD 0000*              	CALL	CUROFF
  155E'   E5                    	PUSH	H
  155F'   CD 0000*              	CALL	CHARAT
  1562'   E1                    	POP	H
  1563'   FE 20                 	CPI	' '
  1565'   CA 156D'              	JZ	VBI_SK
  1568'   FE 09                 	CPI	TAB
  156A'   C2 1571'              	JNZ	SETINM
  156D'                         VBI_SK:
  156D'   23                    	INX	H		; blanks only: past the last of them
  156E'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1571'                         SETINM:
  1571'   CD 075A'              	CALL	SETMOV
  1574'                         SETINS:
  1574'   3E 01                 	MVI	A,EM_INS
  1576'   32 2A09'              	STA	EDMODE
  1579'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  157A'                         ATCEND:
  157A'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  157D'   C8                    	RZ
  157E'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1581'   FE 0D                 	CPI	CR
  1583'   C8                    	RZ
  1584'   FE 0A                 	CPI	LF
  1586'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1587'                         OPNBRK:
  1587'   CD 1E79'              	CALL	PUTBRK
  158A'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  158D'   23                    	INX	H
  158E'   22 0000*              	SHLD	LNDLT
  1591'   C3 018C'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1594'                         ENDBRK:
  1594'   CD 0667'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1597'   C0                    	RNZ
  1598'   CD 1587'              	CALL	OPNBRK
  159B'   CD 0000*              	CALL	CUROFF
  159E'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  159F'   2B                    	DCX	H		;   line, with its own terminator after it
  15A0'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  15A3'                         VC_O:
  15A3'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15A6'   CD 14F2'              	CALL	CEND
  15A9'   CD 0000*              	CALL	GOTO
  15AC'   CD 1587'              	CALL	OPNBRK
  15AF'   CD 1594'              	CALL	ENDBRK		; a last line with no line end: the opened line
  15B2'   CD 0766'              	CALL	SETILN		;   needs a terminator of its own to exist
  15B5'   C3 1574'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  15B8'                         VCB_O:
  15B8'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15BB'   CD 05E4'              	CALL	BOL
  15BE'   CD 0000*              	CALL	GOTO
  15C1'   CD 1587'              	CALL	OPNBRK
  15C4'   CD 0000*              	CALL	CUROFF
  15C7'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15C8'   2B                    	DCX	H
  15C9'   CD 0000*              	CALL	GOTO
  15CC'   CD 0766'              	CALL	SETILN
  15CF'   C3 1574'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  15D2'                         VCB_J:
  15D2'   CD 067E'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  15D5'   CD 14F2'              	CALL	CEND		; the join point: this line's content end
  15D8'   22 2A48'              	SHLD	OPLO
  15DB'   CD 0000*              	CALL	CUROFF
  15DE'   CD 0614'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  15E1'   E5                    	PUSH	H
  15E2'   CD 0000*              	CALL	LOGLEN
  15E5'   D1                    	POP	D		; DE = that start
  15E6'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  15E9'   CA 075A'              	JZ	SETMOV
  15EC'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  15ED'                         VJ_WS:
  15ED'   E5                    	PUSH	H
  15EE'   CD 0000*              	CALL	LOGLEN
  15F1'   D1                    	POP	D		; DE = the scan
  15F2'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  15F5'   CA 160C'              	JZ	VJ_DEL
  15F8'   EB                    	XCHG			; HL = the scan
  15F9'   E5                    	PUSH	H
  15FA'   CD 0000*              	CALL	CHARAT
  15FD'   E1                    	POP	H
  15FE'   FE 20                 	CPI	' '
  1600'   CA 1608'              	JZ	VJ_SKIP
  1603'   FE 09                 	CPI	TAB
  1605'   C2 160C'              	JNZ	VJ_DEL
  1608'                         VJ_SKIP:
  1608'   23                    	INX	H
  1609'   C3 15ED'              	JMP	VJ_WS
  160C'                         VJ_DEL:
  160C'   22 2A4A'              	SHLD	OPHI
  160F'   CD 13E4'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1612'   CD 0775'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1615'   CD 0667'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1618'   CA 1503'              	JZ	CLAMPE
  161B'   CD 0672'              	CALL	CURCHR		; the first char of what was appended
  161E'   FE 0D                 	CPI	CR
  1620'   CA 1503'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1623'   FE 0A                 	CPI	LF
  1625'   CA 1503'              	JZ	CLAMPE
  1628'   FE 29                 	CPI	')'
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  162A'   CA 1503'              	JZ	CLAMPE		; vim puts no space before a ')'
  162D'   CD 0000*              	CALL	CUROFF
  1630'   7C                    	MOV	A,H
  1631'   B5                    	ORA	L
  1632'   CA 1648'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1635'   2B                    	DCX	H
  1636'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1639'   FE 20                 	CPI	' '
  163B'   CA 1503'              	JZ	CLAMPE
  163E'   FE 09                 	CPI	TAB
  1640'   CA 1503'              	JZ	CLAMPE
  1643'   FE 0A                 	CPI	LF
  1645'   CA 1503'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1648'                         VJ_SP:
  1648'   3E 20                 	MVI	A,' '
  164A'   CD 0000*              	CALL	PUTGAP
  164D'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1650'   2B                    	DCX	H
  1651'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1654'                         VC_TILD:
  1654'   CD 068B'              	CALL	GETCNT
  1657'   CD 0760'              	CALL	SETLIN		; only this row changes
  165A'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  165D'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1660'   CA 075A'              	JZ	SETMOV
  1663'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  1666'   FE 0D                 	CPI	CR
  1668'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to toggle
  166B'   FE 0A                 	CPI	LF
  166D'   CA 075A'              	JZ	SETMOV
  1670'   47                    	MOV	B,A
  1671'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1673'   FE 41                 	CPI	'A'
  1675'   DA 1681'              	JC	VT_PUT		; below 'A': no case
  1678'   FE 5B                 	CPI	'Z'+1
  167A'   D2 1681'              	JNC	VT_PUT		; above 'Z': no case
  167D'   78                    	MOV	A,B
  167E'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1680'   47                    	MOV	B,A
  1681'                         VT_PUT:
  1681'   78                    	MOV	A,B
  1682'   32 2A59'              	STA	VRCH		; the calls below do not preserve B
  1685'   CD 018C'              	CALL	MARKMOD
  1688'   21 0001               	LXI	H,1
  168B'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  168E'   3A 2A59'              	LDA	VRCH
  1691'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1694'   C3 1503'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1697'                         VC_R:
  1697'   CD 0678'              	CALL	MOVCNT		; a cursor motion, and its count
  169A'   3E 03                 	MVI	A,PR
  169C'   32 2A31'              	STA	GPEND
  169F'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  16A0'                         VR_DO:
  16A0'   AF                    	XRA	A
  16A1'   32 2A31'              	STA	GPEND
  16A4'   79                    	MOV	A,C
  16A5'   32 2A59'              	STA	VRCH		; the calls below do not preserve C
  16A8'   CD 0760'              	CALL	SETLIN		; only this row changed
  16AB'   CD 08E6'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  16AE'   CD 0667'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16B1'   CA 075A'              	JZ	SETMOV		; the end of the text: vim does nothing
  16B4'   CD 0672'              	CALL	CURCHR		; A = the char under the cursor
  16B7'   FE 0D                 	CPI	CR
  16B9'   CA 075A'              	JZ	SETMOV		; the line's end: nothing to replace
  16BC'   FE 0A                 	CPI	LF
  16BE'   CA 075A'              	JZ	SETMOV
  16C1'   CD 018C'              	CALL	MARKMOD
  16C4'   21 0001               	LXI	H,1
  16C7'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  16CA'   3A 2A59'              	LDA	VRCH
  16CD'   FE 0D                 	CPI	CR
  16CF'   CA 16DC'              	JZ	VR_CR
  16D2'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  16D5'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  16D8'   2B                    	DCX	H		;   out, which moves every logical offset
  16D9'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  16DC'                         VR_CR:
  16DC'   CD 1587'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  16DF'   CD 1594'              	CALL	ENDBRK		;   replaced char may have been the text's last
  16E2'   CD 0766'              	CALL	SETILN		;   row above it lost the char that was replaced,
  16E5'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  16E7'   32 2A11'              	STA	ILABOV
  16EA'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  16EB'                         VCB_R:
  16EB'   CD 068B'              	CALL	GETCNT
  16EE'   CD 075A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  16F1'   21 0000               	LXI	H,0
  16F4'   22 2A5A'              	SHLD	RPDEL		; nothing of ours to put back yet
  16F7'   22 2A5C'              	SHLD	RPAPP
  16FA'   3E 02                 	MVI	A,EM_REP
  16FC'   32 2A09'              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16FF'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1700'                         VC_D:
  1700'   3E 64                 	MVI	A,'d'
  1702'   32 2A33'              	STA	PENDOP
  1705'   C3 075A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1708'                         VC_C:
  1708'   3E 63                 	MVI	A,'c'
  170A'   32 2A33'              	STA	PENDOP
  170D'   C3 075A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1710'                         VD_DD:
  1710'   CD 08E6'              	CALL	GLSTAL
  1713'   CD 068B'              	CALL	GETCNT
  1716'   22 2A4C'              	SHLD	CNTV
  1719'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  171B'   32 2A35'              	STA	DDSNG
  171E'   2B                    	DCX	H
  171F'   7C                    	MOV	A,H
  1720'   B5                    	ORA	L
  1721'   C2 172C'              	JNZ	VDD_LS
  1724'   3E 01                 	MVI	A,1
  1726'   32 2A35'              	STA	DDSNG
  1729'   C3 1732'              	JMP	VDD_GO
  172C'                         VDD_LS:
  172C'   CD 089F'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  172F'   DA 075A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1732'                         VDD_GO:
  1732'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1735'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1738'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  173B'   CD 20DC'              	CALL	COPY12		;   every mark in the lines has closed up by then
  173E'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1741'   2A 2A4C'              	LHLD	CNTV
  1744'   CD 0000*              	CALL	SETC0
  1747'                         VDD_FW:
  1747'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  174A'   DA 1898'              	JC	QREFUS		; ... which has no room for them
  174D'   CD 06A0'              	CALL	CNTTST
  1750'   C2 1747'              	JNZ	VDD_FW
  1753'   CD 018C'              	CALL	MARKMOD
  1756'   CD 0A1D'              	CALL	ATEOF
  1759'   D2 1774'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  175C'   3E 00                 	MVI	A,0
  175E'   32 2A35'              	STA	DDSNG		; deleted to the end: full repaint
  1761'   CD 0E60'              	CALL	ONFST
  1764'   CA 0834'              	JZ	FNBLNK		; nothing left before it
  1767'   21 0001               	LXI	H,1		; onto the new last line
  176A'   CD 0000*              	CALL	SETBWD
  176D'   2A 0000*              	LHLD	LNDLT
  1770'   2B                    	DCX	H
  1771'   22 0000*              	SHLD	LNDLT
  1774'                         VDD_UP:
  1774'   CD 0834'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1777'   3A 2A35'              	LDA	DDSNG
  177A'   B7                    	ORA	A
  177B'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  177C'   3E 03                 	MVI	A,R_DLIN
  177E'   32 2A0E'              	STA	RINTENT
  1781'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1782'                         QEMPTY:
  1782'   2A 0000*              	LHLD	QBEG
  1785'   EB                    	XCHG
  1786'   2A 0000*              	LHLD	QEND
  1789'   7C                    	MOV	A,H
  178A'   BA                    	CMP	D
  178B'   C0                    	RNZ
  178C'   7D                    	MOV	A,L
  178D'   BB                    	CMP	E
  178E'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  178F'                         VC_Y:
  178F'   3E 79                 	MVI	A,'y'
  1791'   32 2A33'              	STA	PENDOP
  1794'   C3 075A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1797'                         VY_YY:
  1797'   21 2A3C'              	LXI	H,OPSFP		; where the cursor is, for a count the register
  179A'   CD 044F'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  179D'   CD 0000*              	CALL	CUROFF
  17A0'   22 2A7D'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  17A3'   CD 05E4'              	CALL	BOL
  17A6'   22 2A7F'              	SHLD	YPT		; where the lines come from, to put them back
  17A9'   CD 18FE'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17AC'   CD 1941'              	CALL	YNCOPY		; copied where they lie, if that can be done
  17AF'   D2 1905'              	JNC	YNDONE
  17B2'   21 1710'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  17B5'   C3 17E1'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  17B8'                         OPYANK:
  17B8'   CD 1418'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  17BB'   2A 2A38'              	LHLD	OPSTA
  17BE'   EB                    	XCHG			; DE = start
  17BF'   2A 2A3A'              	LHLD	OPEND2		; HL = end
  17C2'   CD 0000*              	CALL	CMP16		; CY iff start < end
  17C5'   D2 17C9'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  17C8'   EB                    	XCHG			; ... otherwise the start is
  17C9'                         OPY_LO:
  17C9'   22 2A7D'              	SHLD	YOFF
  17CC'   2A 2A48'              	LHLD	OPLO
  17CF'   22 2A7F'              	SHLD	YPT		; where the lines come from, to put them back
  17D2'   CD 18FE'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  17D5'   CD 19B9'              	CALL	YNSPAN		; copied where they lie, if there is room
  17D8'   D2 1905'              	JNC	YNDONE
  17DB'   21 18BF'              	LXI	H,YSPAN
  17DE'   C3 17E1'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17E1'                         YKGO:
  17E1'   22 2AA6'              	SHLD	YACT
  17E4'   2A 2A7F'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  17E7'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  17E8'   2A 2A7D'              	LHLD	YOFF		;   survive this -- the put-back below can page
  17EB'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  17EE'   22 2AAC'              	SHLD	YCOL		;   them -- but a distance within the lines does
  17F1'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  17F4'   E5                    	PUSH	H		;   pages the window on when the count's lines
  17F5'   2A 2A7F'              	LHLD	YPT		;   run past it, and YPT, an offset into the
  17F8'   EB                    	XCHG			;   window as it was, then names other text
  17F9'   E1                    	POP	H
  17FA'   CD 0000*              	CALL	SUBHD
  17FD'   EB                    	XCHG			; DE = how far behind the cursor they start
  17FE'   CD 0F2D'              	CALL	CURFP
  1801'   06 00                 	MVI	B,0
  1803'   CD 0F23'              	CALL	SUB24
  1806'   22 2AAE'              	SHLD	YPFP
  1809'   32 2AB0'              	STA	YPFP+2
  180C'   3A 2A0D'              	LDA	MODF
  180F'   32 2A7A'              	STA	YMODF
  1812'   3A 2A26'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1815'   32 2A7B'              	STA	YDCHG		;   a yank must not become the last change
  1818'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  181B'   32 2A7C'              	STA	YURPL		;   back are not a change to undo either
  181E'   3E 01                 	MVI	A,1
  1820'   32 0000*              	STA	UNDRPL
  1823'   32 2AA5'              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1826'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1829'   22 2A88'              	SHLD	YLDLT
  182C'   CD 0000*              	CALL	LOGLEN
  182F'   22 2AAA'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1832'   2A 2AA6'              	LHLD	YACT
  1835'   CD 1897'              	CALL	YCALL		; the lines out of the file, into the register
  1838'   3A 2A75'              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  183B'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  183D'   CA 187B'              	JZ	YK_RF		;   cursor: only the flags are still owed
  1840'   CD 0000*              	CALL	LOGLEN
  1843'   EB                    	XCHG
  1844'   2A 2AAA'              	LHLD	YWAS
  1847'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  184A'   CA 185C'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  184D'   21 2AAE'              	LXI	H,YPFP		; back to where they came from, by its place in
  1850'   CD 0402'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1853'   CD 03CF'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1856'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1859'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  185C'                         YK_FIN:				; (nothing came out: nothing went back, and the
  185C'   2A 2AAE'              	LHLD	YPFP		;   cursor is still owed its place)
  185F'   EB                    	XCHG
  1860'   2A 2AAC'              	LHLD	YCOL
  1863'   19                    	DAD	D
  1864'   22 2AA1'              	SHLD	MKPOS
  1867'   3A 2AB0'              	LDA	YPFP+2
  186A'   CE 00                 	ACI	0
  186C'   32 2AA3'              	STA	MKPOS+2
  186F'   CD 03CF'              	CALL	MKPAGE
  1872'   CD 0000*              	CALL	GOTO
  1875'                         YK_RST:
  1875'   2A 2A88'              	LHLD	YLDLT
  1878'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  187B'                         YK_RF:
  187B'   3A 2A7A'              	LDA	YMODF
  187E'   32 2A0D'              	STA	MODF
  1881'   3A 2A7B'              	LDA	YDCHG
  1884'   32 2A26'              	STA	DOTCHG
  1887'   3A 2A7C'              	LDA	YURPL
  188A'   32 0000*              	STA	UNDRPL
  188D'   AF                    	XRA	A
  188E'   32 2AA5'              	STA	MKHOLD
  1891'   CD 08E6'              	CALL	GLSTAL
  1894'   C3 077B'              	JMP	SETFUL		; the cheap paint cannot carry this
  1897'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1898'                         QREFUS:
  1898'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  189B'   CD 1782'              	CALL	QEMPTY
  189E'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  18A1'   CD 0000*              	CALL	QKILL
  18A4'   3A 2AA5'              	LDA	MKHOLD
  18A7'   B7                    	ORA	A
  18A8'   C2 18B7'              	JNZ	QRF_Y
  18AB'   21 0000*              	LXI	H,MKSAV
  18AE'   11 0000*              	LXI	D,MKTAB
  18B1'   CD 20DC'              	CALL	COPY12
  18B4'   CD 0000*              	CALL	UNDCLR
  18B7'                         QRF_Y:
  18B7'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  18B9'   32 2A75'              	STA	MSGWHT
  18BC'   C3 1252'              	JMP	OPG_HM
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  18BF'                         YSPAN:
  18BF'   CD 08E6'              	CALL	GLSTAL
  18C2'   CD 13D9'              	CALL	OPSPNL		; HL = the span's length
  18C5'   22 2AA8'              	SHLD	YTGT
  18C8'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  18CB'   EB                    	XCHG			; DE = it
  18CC'   2A 2AA8'              	LHLD	YTGT
  18CF'   EB                    	XCHG			; HL = the text's, DE = the span's
  18D0'   CD 0000*              	CALL	SUBHD
  18D3'   22 2AA8'              	SHLD	YTGT		; what the text is left at when the span is out
  18D6'   2A 2A48'              	LHLD	OPLO
  18D9'   CD 0000*              	CALL	GOTO
  18DC'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  18DF'                         YS_LP:
  18DF'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  18E2'   CD 0000*              	CALL	SETC0
  18E5'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  18E8'   DA 1898'              	JC	QREFUS		; ... which has no room for it
  18EB'   CD 0000*              	CALL	LOGLEN
  18EE'   EB                    	XCHG			; DE = what is left
  18EF'   2A 2AA8'              	LHLD	YTGT
  18F2'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  18F5'   DA 18FB'              	JC	YS_END		; below it -- cannot happen over whole lines,
  18F8'   C2 18DF'              	JNZ	YS_LP		;   but never spin here if it ever did
  18FB'                         YS_END:
  18FB'   C3 018C'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  18FE'                         YNPRE:
  18FE'   2A 0000*              	LHLD	PGTOPM
  1901'   22 2AB1'              	SHLD	YNPG
  1904'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1905'                         YNDONE:
  1905'   2A 2A7D'              	LHLD	YOFF
  1908'   CD 0000*              	CALL	GOTO
  190B'   2A 0000*              	LHLD	PGTOPM
  190E'   EB                    	XCHG
  190F'   2A 2AB1'              	LHLD	YNPG
  1912'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1915'   C2 077B'              	JNZ	SETFUL		; it moved under us: repaint after all
  1918'   C3 075A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  191B'                         YNROOM:
  191B'   11 0100               	LXI	D,100H
  191E'   19                    	DAD	D
  191F'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1920'   E5                    	PUSH	H		; the span plus its slack
  1921'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1924'   EB                    	XCHG			; HL = free
  1925'   D1                    	POP	D		; DE = the span plus its slack
  1926'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1929'   DA 1931'              	JC	YNR_OK
  192C'   CA 1931'              	JZ	YNR_OK
  192F'   37                    	STC			; not enough: the delete-and-put-back path
  1930'   C9                    	RET
  1931'                         YNR_OK:
  1931'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1932'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1933'                         YNGO:
  1933'   C5                    	PUSH	B
  1934'   CD 068B'              	CALL	GETCNT		; spent here: this yank is happening
  1937'   CD 08E6'              	CALL	GLSTAL
  193A'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  193D'   C1                    	POP	B
  193E'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1941'                         YNCOPY:
  1941'   2A 2A0A'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1944'   7C                    	MOV	A,H		;   the count itself
  1945'   B5                    	ORA	L
  1946'   C2 194C'              	JNZ	YNC_HV
  1949'   21 0001               	LXI	H,1
  194C'                         YNC_HV:
  194C'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  194D'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  194E'   B4                    	ORA	H
  194F'   CA 195A'              	JZ	YNC_M
  1952'   E5                    	PUSH	H
  1953'   CD 089F'              	CALL	ONLAST		; vim: a count over one on the last line does
  1956'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1957'   DA 196C'              	JC	YNC_RF
  195A'                         YNC_M:
  195A'   E5                    	PUSH	H
  195B'   CD 081D'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  195E'   E1                    	POP	H
  195F'   CD 1974'              	CALL	YNLINE		; BC = the span, measured where it stands
  1962'   D8                    	RC			; not measurable here: let the pager answer it
  1963'   60                    	MOV	H,B
  1964'   69                    	MOV	L,C
  1965'   CD 191B'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1968'   D8                    	RC			; no: the delete-and-put-back path
  1969'   C3 1933'              	JMP	YNGO
  196C'                         YNC_RF:
  196C'   CD 068B'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  196F'   CD 08E6'              	CALL	GLSTAL		;   register alone, and that is the command
  1972'   B7                    	ORA	A		; NC: done
  1973'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1974'                         YNLINE:
  1974'   22 2AB3'              	SHLD	YNCNT		; the lines it still wants
  1977'   2A 0000*              	LHLD	GAPEND
  197A'                         YNL_LP:
  197A'   EB                    	XCHG			; DE = the scan
  197B'   2A 0000*              	LHLD	TXTEND
  197E'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1981'   EB                    	XCHG			; HL = the scan
  1982'   D2 19A2'              	JNC	YNL_EN		; the resident text ran out
  1985'   7E                    	MOV	A,M
  1986'   23                    	INX	H
  1987'   FE 0A                 	CPI	LF
  1989'   C2 197A'              	JNZ	YNL_LP
  198C'   E5                    	PUSH	H
  198D'   2A 2AB3'              	LHLD	YNCNT
  1990'   2B                    	DCX	H
  1991'   22 2AB3'              	SHLD	YNCNT
  1994'   7C                    	MOV	A,H
  1995'   B5                    	ORA	L
  1996'   E1                    	POP	H
  1997'   C2 197A'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  199A'   EB                    	XCHG			; DE = past the last of them
  199B'   2A 0000*              	LHLD	GAPEND
  199E'   EB                    	XCHG			; HL = past them, DE = GAPEND
  199F'   C3 19B0'              	JMP	YNL_BC
  19A2'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  19A2'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  19A5'   C2 19B7'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  19A8'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  19AB'   EB                    	XCHG			;   count clamps to it as vim's does
  19AC'   2A 0000*              	LHLD	GAPEND
  19AF'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  19B0'                         YNL_BC:
  19B0'   CD 0000*              	CALL	SUBHD		; HL = the span
  19B3'   44                    	MOV	B,H
  19B4'   4D                    	MOV	C,L
  19B5'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  19B6'   C9                    	RET
  19B7'                         YNL_NO:
  19B7'   37                    	STC
  19B8'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  19B9'                         YNSPAN:
  19B9'   CD 13D9'              	CALL	OPSPNL		; HL = the span's length
  19BC'   44                    	MOV	B,H
  19BD'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  19BE'   CD 191B'              	CALL	YNROOM
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  19C1'   D8                    	RC			; no room: the delete-and-put-back path
  19C2'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  19C3'   2A 2A48'              	LHLD	OPLO
  19C6'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  19C9'   C1                    	POP	B
  19CA'   C3 1933'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  19CD'                         VC_P:
  19CD'   CD 1782'              	CALL	QEMPTY
  19D0'   CA 1A88'              	JZ	VP_BEL
  19D3'   CD 068B'              	CALL	GETCNT
  19D6'   22 2A81'              	SHLD	PCNT
  19D9'   CD 0000*              	CALL	CUROFF
  19DC'   CD 0614'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  19DF'   C3 19F4'              	JMP	VP_GO
  19E2'                         VCB_P:
  19E2'   CD 1782'              	CALL	QEMPTY
  19E5'   CA 1A88'              	JZ	VP_BEL
  19E8'   CD 068B'              	CALL	GETCNT
  19EB'   22 2A81'              	SHLD	PCNT
  19EE'   CD 0000*              	CALL	CUROFF
  19F1'   CD 05E4'              	CALL	BOL
  19F4'                         VP_GO:
  19F4'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  19F7'   CD 0000*              	CALL	CUROFF
  19FA'   EB                    	XCHG
  19FB'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  19FE'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  1A01'   DA 1A16'              	JC	VP_IN
  1A04'   EB                    	XCHG			; HL = the put point = LOGLEN
  1A05'   7C                    	MOV	A,H
  1A06'   B5                    	ORA	L
  1A07'   CA 1A13'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1A0A'   2B                    	DCX	H
  1A0B'   CD 0000*              	CALL	CHARAT
  1A0E'   FE 0A                 	CPI	LF
  1A10'   CA 1A16'              	JZ	VP_IN
  1A13'                         VP_BRK:
  1A13'   CD 1587'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1A16'                         VP_IN:
  1A16'   CD 0000*              	CALL	CUROFF
  1A19'   22 2A83'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1A1C'   2A 0000*              	LHLD	QBEG
  1A1F'   EB                    	XCHG
  1A20'   2A 0000*              	LHLD	QEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A23'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1A26'   EB                    	XCHG
  1A27'   22 2A85'              	SHLD	PLFS
  1A2A'   2A 2A81'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1A2D'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1A2E'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1A2F'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1A31'   C2 1A35'              	JNZ	VP_PZ
  1A34'   7D                    	MOV	A,L
  1A35'                         VP_PZ:
  1A35'   32 2A87'              	STA	PCPY
  1A38'                         VP_LP:
  1A38'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1A3B'   2A 0000*              	LHLD	LNDLT
  1A3E'   EB                    	XCHG
  1A3F'   2A 2A85'              	LHLD	PLFS
  1A42'   19                    	DAD	D
  1A43'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1A46'   2A 2A81'              	LHLD	PCNT
  1A49'   2B                    	DCX	H
  1A4A'   22 2A81'              	SHLD	PCNT
  1A4D'   7C                    	MOV	A,H
  1A4E'   B5                    	ORA	L
  1A4F'   C2 1A38'              	JNZ	VP_LP
  1A52'   CD 018C'              	CALL	MARKMOD
  1A55'   2A 2A83'              	LHLD	PPT
  1A58'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  1A5B'   CD 08E6'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1A5E'   3A 2A87'              	LDA	PCPY
  1A61'   B7                    	ORA	A
  1A62'   CA 0834'              	JZ	FNBLNK
  1A65'   2A 2A85'              	LHLD	PLFS
  1A68'   7C                    	MOV	A,H
  1A69'   B7                    	ORA	A
  1A6A'   C2 0834'              	JNZ	FNBLNK
  1A6D'   3A 2A87'              	LDA	PCPY
  1A70'   CD 0DF6'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1A73'   7C                    	MOV	A,H
  1A74'   B7                    	ORA	A
  1A75'   C2 0834'              	JNZ	FNBLNK
  1A78'   7D                    	MOV	A,L
  1A79'   B7                    	ORA	A
  1A7A'   CA 0834'              	JZ	FNBLNK
  1A7D'   F5                    	PUSH	PSW
  1A7E'   CD 0766'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1A81'   F1                    	POP	PSW
  1A82'   32 2A0F'              	STA	ILN		; ... which the lines put now replace
  1A85'   C3 0834'              	JMP	FNBLNK
  1A88'                         VP_BEL:
  1A88'   CD 068B'              	CALL	GETCNT		; the count is spent either way
  1A8B'   0E 07                 	MVI	C,BEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A8D'   CD 0000*              	CALL	BCONOU
  1A90'   C3 075A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  1A93'                         VIREP:
  1A93'   78                    	MOV	A,B
  1A94'   FE 01                 	CPI	KT_ACT
  1A96'   CA 1BC3'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  1A99'   FE 02                 	CPI	KT_CHAR
  1A9B'   C0                    	RNZ			; ignore anything else
  1A9C'   79                    	MOV	A,C
  1A9D'   FE 0D                 	CPI	CR
  1A9F'   CA 1B03'              	JZ	VP_CR
  1AA2'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1AA4'   CA 1B03'              	JZ	VP_CR
  1AA7'   FE 08                 	CPI	BS
  1AA9'   CA 1B0F'              	JZ	VP_BS
  1AAC'   FE 7F                 	CPI	DEL
  1AAE'   CA 1B0F'              	JZ	VP_BS
  1AB1'   32 2A59'              	STA	VRCH		; the calls below do not preserve C
  1AB4'   CD 0760'              	CALL	SETLIN		; this row changed
  1AB7'   CD 018C'              	CALL	MARKMOD
  1ABA'   CD 157A'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1ABD'   CA 1AF5'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1AC0'   3A 2A59'              	LDA	VRCH
  1AC3'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1AC6'   2A 2A5A'              	LHLD	RPDEL
  1AC9'   7C                    	MOV	A,H
  1ACA'   B5                    	ORA	L
  1ACB'   CA 1AE1'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1ACE'   2A 0000*              	LHLD	GAPEND
  1AD1'   EB                    	XCHG
  1AD2'   2A 2A5E'              	LHLD	RPGE
  1AD5'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1AD8'   CA 1AE1'              	JZ	VP_OVW
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1ADB'   21 0000               	LXI	H,0
  1ADE'   22 2A5A'              	SHLD	RPDEL		; the text moved: those originals are gone
  1AE1'                         VP_OVW:
  1AE1'   21 0001               	LXI	H,1
  1AE4'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1AE7'   2A 0000*              	LHLD	GAPEND
  1AEA'   22 2A5E'              	SHLD	RPGE
  1AED'   2A 2A5A'              	LHLD	RPDEL
  1AF0'   23                    	INX	H
  1AF1'   22 2A5A'              	SHLD	RPDEL
  1AF4'   C9                    	RET
  1AF5'                         VP_APP:
  1AF5'   3A 2A59'              	LDA	VRCH
  1AF8'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1AFB'   2A 2A5C'              	LHLD	RPAPP
  1AFE'   23                    	INX	H
  1AFF'   22 2A5C'              	SHLD	RPAPP
  1B02'   C9                    	RET
  1B03'                         VP_CR:
  1B03'   21 0000               	LXI	H,0
  1B06'   22 2A5A'              	SHLD	RPDEL		; a line break ends what BS can put back
  1B09'   22 2A5C'              	SHLD	RPAPP
  1B0C'   C3 1B99'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1B0F'                         VP_BS:
  1B0F'   2A 2A5C'              	LHLD	RPAPP
  1B12'   7C                    	MOV	A,H
  1B13'   B5                    	ORA	L
  1B14'   CA 1B21'              	JZ	VP_BSD
  1B17'   2B                    	DCX	H
  1B18'   22 2A5C'              	SHLD	RPAPP		; an appended char: it just goes
  1B1B'   CD 0760'              	CALL	SETLIN
  1B1E'   C3 0000*              	JMP	DELPRV
  1B21'                         VP_BSD:
  1B21'   2A 2A5A'              	LHLD	RPDEL
  1B24'   7C                    	MOV	A,H
  1B25'   B5                    	ORA	L
  1B26'   CA 1B4D'              	JZ	VP_BSM		; nothing of ours left
  1B29'   2A 0000*              	LHLD	GAPEND
  1B2C'   EB                    	XCHG
  1B2D'   2A 2A5E'              	LHLD	RPGE
  1B30'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  1B33'   C2 1B4D'              	JNZ	VP_BSM
  1B36'   2A 2A5A'              	LHLD	RPDEL
  1B39'   2B                    	DCX	H
  1B3A'   22 2A5A'              	SHLD	RPDEL
  1B3D'   CD 0760'              	CALL	SETLIN
  1B40'   CD 0000*              	CALL	DELPRV		; the typed char goes
  1B43'   CD 0000*              	CALL	UNDELF		; the original comes back
  1B46'   2A 0000*              	LHLD	GAPEND
  1B49'   22 2A5E'              	SHLD	RPGE
  1B4C'   C9                    	RET
  1B4D'                         VP_BSM:
  1B4D'   CD 075A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  1B50'   C3 07C9'              	JMP	HSTEP
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  1B53'                         VIINS:
  1B53'   78                    	MOV	A,B
  1B54'   FE 01                 	CPI	KT_ACT
  1B56'   CA 1BC3'              	JZ	VI_ACT
  1B59'   FE 02                 	CPI	KT_CHAR
  1B5B'   C0                    	RNZ			; ignore anything else
  1B5C'   79                    	MOV	A,C
  1B5D'   FE 0D                 	CPI	CR
  1B5F'   CA 1B99'              	JZ	VI_CR
  1B62'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  1B64'   CA 1B99'              	JZ	VI_CR
  1B67'   FE 08                 	CPI	BS
  1B69'   CA 1BB1'              	JZ	VI_BS
  1B6C'   FE 7F                 	CPI	DEL
  1B6E'   CA 1BB1'              	JZ	VI_BS
  1B71'   79                    	MOV	A,C
  1B72'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  1B75'   CD 018C'              	CALL	MARKMOD
  1B78'   CD 0760'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  1B7B'   79                    	MOV	A,C
  1B7C'   FE 20                 	CPI	' '
  1B7E'   D8                    	RC			; control char -> keep R_LINE
  1B7F'   FE 7F                 	CPI	DEL
  1B81'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  1B82'   CD 0781'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  1B85'   B7                    	ORA	A
  1B86'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  1B87'   3E 04                 	MVI	A,R_ICH
  1B89'   32 2A0E'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  1B8C'   CD 157A'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  1B8F'   3E 00                 	MVI	A,0
  1B91'   C2 1B95'              	JNZ	VI_ICH
  1B94'   3C                    	INR	A
  1B95'                         VI_ICH:
  1B95'   32 2A10'              	STA	ICHAPP
  1B98'   C9                    	RET
  1B99'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  1B99'   CD 157A'              	CALL	ATCEND
  1B9C'   3E 00                 	MVI	A,0
  1B9E'   CA 1BA2'              	JZ	VI_CRS
  1BA1'   3C                    	INR	A
  1BA2'                         VI_CRS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BA2'   F5                    	PUSH	PSW
  1BA3'   CD 1587'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  1BA6'   CD 1594'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1BA9'   CD 0766'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1BAC'   F1                    	POP	PSW
  1BAD'   32 2A11'              	STA	ILABOV
  1BB0'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  1BB1'                         VI_BS:
  1BB1'   CD 0000*              	CALL	PEEKL
  1BB4'   D8                    	RC			; start of the file: nothing to delete
  1BB5'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1BB7'   CA 1BBD'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1BBA'   CD 0760'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1BBD'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1BBD'   CD 018C'              	CALL	MARKMOD
  1BC0'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  1BC3'                         VI_ACT:
  1BC3'   79                    	MOV	A,C
  1BC4'   FE 0B                 	CPI	ACT_ESC
  1BC6'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1BC7'   3E 00                 	MVI	A,EM_CMD
  1BC9'   32 2A09'              	STA	EDMODE
  1BCC'   CD 075A'              	CALL	SETMOV
  1BCF'   CD 07C9'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  1BD2'   C3 08E6'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  1BD5'                         RDLINE:
  1BD5'   EB                    	XCHG			; HL = buffer
  1BD6'   22 2A60'              	SHLD	RLPTR
  1BD9'   3E 00                 	MVI	A,0
  1BDB'   32 2A62'              	STA	RLLEN
  1BDE'   78                    	MOV	A,B
  1BDF'   32 2A63'              	STA	RLMAX
  1BE2'   79                    	MOV	A,C
  1BE3'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1BE6'                         RL_LP:
  1BE6'   CD 0000*              	CALL	GETKEY
  1BE9'   78                    	MOV	A,B
  1BEA'   FE 01                 	CPI	KT_ACT
  1BEC'   CA 1C42'              	JZ	RL_ACT
  1BEF'   FE 02                 	CPI	KT_CHAR
  1BF1'   C2 1BE6'              	JNZ	RL_LP		; ignore other keys
  1BF4'   79                    	MOV	A,C
  1BF5'   FE 0D                 	CPI	CR
  1BF7'   CA 1C53'              	JZ	RL_DONE
  1BFA'   FE 08                 	CPI	BS
  1BFC'   CA 1C2A'              	JZ	RL_BS
  1BFF'   FE 7F                 	CPI	DEL
  1C01'   CA 1C2A'              	JZ	RL_BS
  1C04'   FE 20                 	CPI	' '
  1C06'   DA 1BE6'              	JC	RL_LP		; control char -> ignore
  1C09'   3A 2A62'              	LDA	RLLEN
  1C0C'   47                    	MOV	B,A
  1C0D'   3A 2A63'              	LDA	RLMAX
  1C10'   B8                    	CMP	B
  1C11'   CA 1BE6'              	JZ	RL_LP		; full -> ignore
  1C14'   2A 2A60'              	LHLD	RLPTR
  1C17'   71                    	MOV	M,C
  1C18'   23                    	INX	H
  1C19'   22 2A60'              	SHLD	RLPTR
  1C1C'   3A 2A62'              	LDA	RLLEN
  1C1F'   3C                    	INR	A
  1C20'   32 2A62'              	STA	RLLEN
  1C23'   79                    	MOV	A,C
  1C24'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1C27'   C3 1BE6'              	JMP	RL_LP
  1C2A'                         RL_BS:				; WM LINEPOP
  1C2A'   3A 2A62'              	LDA	RLLEN
  1C2D'   B7                    	ORA	A
  1C2E'   CA 1C48'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  1C31'   3D                    	DCR	A
  1C32'   32 2A62'              	STA	RLLEN
  1C35'   2A 2A60'              	LHLD	RLPTR
  1C38'   2B                    	DCX	H
  1C39'   22 2A60'              	SHLD	RLPTR
  1C3C'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1C3F'   C3 1BE6'              	JMP	RL_LP
  1C42'                         RL_ACT:
  1C42'   79                    	MOV	A,C
  1C43'   FE 0B                 	CPI	ACT_ESC
  1C45'   C2 1BE6'              	JNZ	RL_LP
  1C48'                         RL_CAN:
  1C48'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  1C4A'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  1C4D'   CD 0760'              	CALL	SETLIN		; redraw one row
  1C50'   3E FF                 	MVI	A,0FFH		; cancelled
  1C52'   C9                    	RET
  1C53'                         RL_DONE:
  1C53'   AF                    	XRA	A
  1C54'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  1C55'                         VC_BZ:
  1C55'   CD 075A'              	CALL	SETMOV
  1C58'   3A 2A32'              	LDA	GSAVE
  1C5B'   FE 02                 	CPI	PZ
  1C5D'   CA 1C68'              	JZ	VZ_ZZ
  1C60'   B7                    	ORA	A
  1C61'   C0                    	RNZ			; 'g' was pending: vim drops both
  1C62'   3E 02                 	MVI	A,PZ
  1C64'   32 2A31'              	STA	GPEND
  1C67'   C9                    	RET
  1C68'                         VZ_ZZ:
  1C68'   3E 04                 	MVI	A,EO_X
  1C6A'   32 2A64'              	STA	EXOP
  1C6D'   3E 01                 	MVI	A,1
  1C6F'   32 2A77'              	STA	EXBANG		; no '!'
  1C72'   AF                    	XRA	A
  1C73'   32 2A65'              	STA	EXARG		; no file name
  1C76'   3A 2A0D'              	LDA	MODF		; as ':x': a changed text is written first
  1C79'   B7                    	ORA	A
  1C7A'   CA 1DBB'              	JZ	EX_Q
  1C7D'   C3 1D55'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  1C80'                         VC_EX:
  1C80'   CD 068B'              	CALL	GETCNT
  1C83'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  1C86'   11 0000*              	LXI	D,EXBUF
  1C89'   06 28                 	MVI	B,EXMAX
  1C8B'   0E 3A                 	MVI	C,':'
  1C8D'   CD 1BD5'              	CALL	RDLINE
  1C90'   B7                    	ORA	A
  1C91'   C0                    	RNZ			; cancelled
  1C92'   3A 2A62'              	LDA	RLLEN
  1C95'   5F                    	MOV	E,A
  1C96'   16 00                 	MVI	D,0
  1C98'   21 0000*              	LXI	H,EXBUF
  1C9B'   19                    	DAD	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C9C'   36 00                 	MVI	M,0		; the line ends with a 0
  1C9E'   21 0000*              	LXI	H,EXBUF
  1CA1'   CD 2271'              	CALL	SKIPB
  1CA4'   C8                    	RZ			; nothing on it
  1CA5'   22 2A67'              	SHLD	EXCMD
  1CA8'   CD 2465'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1CAB'   CD 2271'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1CAE'   56                    	MOV	D,M
  1CAF'   23                    	INX	H
  1CB0'   1E 00                 	MVI	E,0
  1CB2'   CD 227D'              	CALL	ISLOW
  1CB5'   DA 1CC0'              	JC	EX_LK
  1CB8'   5F                    	MOV	E,A
  1CB9'   23                    	INX	H
  1CBA'   CD 227D'              	CALL	ISLOW
  1CBD'   D2 1CD9'              	JNC	EX_NOT		; a third letter: none of ours
  1CC0'                         EX_LK:
  1CC0'   E5                    	PUSH	H
  1CC1'   21 244C'              	LXI	H,EXTAB
  1CC4'                         EX_TL:
  1CC4'   7E                    	MOV	A,M
  1CC5'   B7                    	ORA	A
  1CC6'   CA 1CD8'              	JZ	EX_NTP		; not in the table
  1CC9'   23                    	INX	H
  1CCA'   BA                    	CMP	D
  1CCB'   7E                    	MOV	A,M
  1CCC'   23                    	INX	H
  1CCD'   C2 1CD4'              	JNZ	EX_TN
  1CD0'   BB                    	CMP	E
  1CD1'   CA 1CDF'              	JZ	EX_TF
  1CD4'                         EX_TN:
  1CD4'   23                    	INX	H
  1CD5'   C3 1CC4'              	JMP	EX_TL
  1CD8'                         EX_NTP:
  1CD8'   E1                    	POP	H
  1CD9'                         EX_NOT:
  1CD9'   21 2335'              	LXI	H,SNOT
  1CDC'   C3 22B2'              	JMP	EXERT
  1CDF'                         EX_TF:
  1CDF'   7E                    	MOV	A,M
  1CE0'   32 2A64'              	STA	EXOP
  1CE3'   E1                    	POP	H
  1CE4'   FE 06                 	CPI	EO_S
  1CE6'   CA 24D4'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1CE9'   FE 01                 	CPI	EO_W
  1CEB'   CA 1CFA'              	JZ	EX_RG		; ':N,Mw name' takes a range
  1CEE'   FE 08                 	CPI	EO_R
  1CF0'   CA 1CFA'              	JZ	EX_RG		; ... and ':Nr name' a line
  1CF3'   3A 2ABF'              	LDA	SRNGF
  1CF6'   B7                    	ORA	A
  1CF7'   C2 1CD9'              	JNZ	EX_NOT		; a range on a command that does not take one
  1CFA'                         EX_RG:
                                	;--- '!', then the file name ---
  1CFA'   7E                    	MOV	A,M
  1CFB'   D6 21                 	SUI	'!'
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


  1CFD'   32 2A77'              	STA	EXBANG		; 0 = '!'
  1D00'   C2 1D04'              	JNZ	EX_NB
  1D03'   23                    	INX	H
  1D04'                         EX_NB:
  1D04'   CD 2271'              	CALL	SKIPB
  1D07'   32 2A65'              	STA	EXARG		; 0 = no file name
  1D0A'   CA 1D23'              	JZ	EX_RUN
  1D0D'   22 2A67'              	SHLD	EXCMD
  1D10'   3A 2A64'              	LDA	EXOP
  1D13'   FE 02                 	CPI	EO_Q
  1D15'   CA 22AF'              	JZ	EX_TRL		; :q takes none
  1D18'   FE 07                 	CPI	EO_V
  1D1A'   CA 22AF'              	JZ	EX_TRL		; nor :ve
  1D1D'   CD 21DB'              	CALL	PARSFN
  1D20'   C2 22A3'              	JNZ	EX_INV
  1D23'                         EX_RUN:
  1D23'   3A 2A64'              	LDA	EXOP
  1D26'   FE 05                 	CPI	EO_E
  1D28'   CA 1DD2'              	JZ	EX_E
  1D2B'   FE 02                 	CPI	EO_Q
  1D2D'   CA 1DBB'              	JZ	EX_Q
  1D30'   FE 07                 	CPI	EO_V
  1D32'   CA 22A9'              	JZ	EX_V
  1D35'   FE 08                 	CPI	EO_R
  1D37'   CA 1F63'              	JZ	EX_R
  1D3A'   FE 04                 	CPI	EO_X
  1D3C'   CA 1D4E'              	JZ	EX_XM
  1D3F'   FE 01                 	CPI	EO_W
  1D41'   C2 1D55'              	JNZ	EX_W		; :wq
  1D44'   3A 2ABF'              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  1D47'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  1D48'   C2 1E83'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  1D4B'   C3 1D55'              	JMP	EX_W
  1D4E'                         EX_XM:
  1D4E'   3A 2A0D'              	LDA	MODF		; :x writes only a changed text
  1D51'   B7                    	ORA	A
  1D52'   CA 1DBB'              	JZ	EX_Q
  1D55'                         EX_W:
  1D55'   CD 2043'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1D58'   D8                    	RC			; refused (message shown)
  1D59'   32 2A66'              	STA	EXBAK
  1D5C'   3A 2A64'              	LDA	EXOP
  1D5F'   FE 01                 	CPI	EO_W
  1D61'   CA 1D78'              	JZ	EX_WK
  1D64'   3A 2A66'              	LDA	EXBAK
  1D67'   B7                    	ORA	A
  1D68'   C2 1DB8'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  1D6B'   3A 2A77'              	LDA	EXBANG
  1D6E'   B7                    	ORA	A
  1D6F'   CA 1DB8'              	JZ	EX_WQ		; so it does with '!'
  1D72'   CD 1D78'              	CALL	EX_WK		; else it may not: keep the text
  1D75'   C3 1DBB'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  1D78'                         EX_WK:
  1D78'   CD 0D02'              	CALL	CURRW		; the cursor's row and file position
  1D7B'   32 2A69'              	STA	WPROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1D7E'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  1D81'   7D                    	MOV	A,L
  1D82'   E6 7F                 	ANI	7FH
  1D84'   32 2A6A'              	STA	WPBYT
  1D87'   7D                    	MOV	A,L
  1D88'   17                    	RAL
  1D89'   7C                    	MOV	A,H
  1D8A'   17                    	RAL
  1D8B'   5F                    	MOV	E,A
  1D8C'   3E 00                 	MVI	A,0
  1D8E'   17                    	RAL
  1D8F'   57                    	MOV	D,A		; DE = HL / 128
  1D90'   2A 0000*              	LHLD	OUTPOS
  1D93'   19                    	DAD	D
  1D94'   22 2A6B'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  1D97'   CD 2078'              	CALL	WRITE
  1D9A'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  1D9D'   2A 2A6B'              	LHLD	WPREC
  1DA0'   EB                    	XCHG
  1DA1'   3A 2A6A'              	LDA	WPBYT
  1DA4'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  1DA7'   CD 0000*              	CALL	GOTO
  1DAA'                         EX_WRW:
  1DAA'   21 0000               	LXI	H,0
  1DAD'   22 0000*              	SHLD	LNDLT
  1DB0'   3A 2A69'              	LDA	WPROW
  1DB3'   6F                    	MOV	L,A
  1DB4'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  1DB7'   C9                    	RET
  1DB8'                         EX_WQ:
  1DB8'   CD 2078'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  1DBB'                         EX_Q:
  1DBB'   3A 2A77'              	LDA	EXBANG
  1DBE'   B7                    	ORA	A
  1DBF'   CA 1DC9'              	JZ	EX_QT
  1DC2'   3A 2A0D'              	LDA	MODF
  1DC5'   B7                    	ORA	A
  1DC6'   C2 2297'              	JNZ	MSGNWR		; changed, no '!': stay
  1DC9'                         EX_QT:
  1DC9'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1DCC'   3E 01                 	MVI	A,1
  1DCE'   32 2A0C'              	STA	QUITF
  1DD1'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1DD2'                         EX_E:
  1DD2'   3A 2A77'              	LDA	EXBANG
  1DD5'   B7                    	ORA	A
  1DD6'   CA 1DE0'              	JZ	EE_GO
  1DD9'   3A 2A0D'              	LDA	MODF
  1DDC'   B7                    	ORA	A
  1DDD'   C2 2297'              	JNZ	MSGNWR
  1DE0'                         EE_GO:
  1DE0'   3A 2A65'              	LDA	EXARG
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1DE3'   B7                    	ORA	A
  1DE4'   C2 1DEB'              	JNZ	EE_ARG
  1DE7'   CD 20B4'              	CALL	OWNTF		; no name: the buffer's own
  1DEA'   D8                    	RC
  1DEB'                         EE_ARG:
  1DEB'   CD 20CA'              	CALL	ISOWN
  1DEE'   21 0001               	LXI	H,1
  1DF1'   C2 1DF8'              	JNZ	EE_LD		; another file: its first line
  1DF4'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1DF7'   23                    	INX	H		; HL = the cursor's line
  1DF8'                         EE_LD:
  1DF8'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1DFA'   32 2A75'              	STA	MSGWHT
  1DFD'   E5                    	PUSH	H
  1DFE'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1E01'   21 0000*              	LXI	H,TFCB
  1E04'   11 0000*              	LXI	D,FNAME
  1E07'   CD 20DC'              	CALL	COPY12		; the buffer's name
  1E0A'   CD 20A1'              	CALL	SRCTF
  1E0D'   CD 0000*              	CALL	REOPEN
  1E10'   CD 020F'              	CALL	MKCLR		; the marks named the buffer that just went
  1E13'   AF                    	XRA	A
  1E14'   32 2A0D'              	STA	MODF
  1E17'   E1                    	POP	H
  1E18'   2B                    	DCX	H
  1E19'   AF                    	XRA	A
  1E1A'   CD 0000*              	CALL	MVLIND		; down to the line
  1E1D'   CD 0A1D'              	CALL	ATEOF
  1E20'   DC 0A23'              	CC	LASTLN		; past the last line: onto it
  1E23'   CD 0F50'              	CALL	ZSAVE
  1E26'   C3 1033'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  1E29'                         TFDOS:
  1E29'   C5                    	PUSH	B
  1E2A'   11 0080               	LXI	D,CMDTAIL
  1E2D'   0E 1A                 	MVI	C,1AH		; set the DMA
  1E2F'   CD 0005               	CALL	BDOS
  1E32'   C1                    	POP	B
  1E33'   11 0000*              	LXI	D,TFCB
  1E36'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  1E39'                         EXRNG:
  1E39'   2A 2AC0'              	LHLD	SRNG1
  1E3C'   7C                    	MOV	A,H
  1E3D'   B5                    	ORA	L
  1E3E'   37                    	STC
  1E3F'   C8                    	RZ
  1E40'   2A 2AC2'              	LHLD	SRNG2
  1E43'   EB                    	XCHG
  1E44'   2A 2AC0'              	LHLD	SRNG1
  1E47'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1E4A'   D8                    	RC
  1E4B'   EB                    	XCHG			; HL = the last line, DE = the first
  1E4C'   CD 0000*              	CALL	SUBHD
  1E4F'   23                    	INX	H
  1E50'   22 2ACA'              	SHLD	SLINES
  1E53'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  1E54'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  1E55'                         GOLNX:
  1E55'   E5                    	PUSH	H
  1E56'   CD 0EE4'              	CALL	GOLN
  1E59'   CD 0000*              	CALL	CNTLF
  1E5C'   23                    	INX	H		; the line the cursor came to rest on
  1E5D'   D1                    	POP	D
  1E5E'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  1E61'                         EXSAVP:
  1E61'   CD 0D02'              	CALL	CURRW
  1E64'   32 2A69'              	STA	WPROW
  1E67'   21 2AA1'              	LXI	H,MKPOS
  1E6A'   C3 044F'              	JMP	FPSTO
  1E6D'                         EXRSTP:
  1E6D'   CD 0000*              	CALL	CLRCNT
  1E70'   CD 03CF'              	CALL	MKPAGE		; page until that place is in the window again
  1E73'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E76'   C3 1DAA'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  1E79'                         PUTBRK:
  1E79'   3E 0D                 	MVI	A,CR
  1E7B'   CD 0000*              	CALL	PUTGAP
  1E7E'   3E 0A                 	MVI	A,LF
  1E80'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  1E83'                         EX_WR:
  1E83'   3A 2A65'              	LDA	EXARG
  1E86'   B7                    	ORA	A
  1E87'   CA 2285'              	JZ	MSGNFN		; No file name
  1E8A'   CD 20CA'              	CALL	ISOWN
  1E8D'   CA 1F2D'              	JZ	EXW_OW
  1E90'   CD 0000*              	CALL	TEXIST
  1E93'   32 2ACD'              	STA	RWERR		; nonzero: a file of that name is there
  1E96'   CA 1EA0'              	JZ	EXW_GO
  1E99'   3A 2A77'              	LDA	EXBANG
  1E9C'   B7                    	ORA	A
  1E9D'   C2 228B'              	JNZ	MSGEXI		; File exists (! to force)
  1EA0'                         EXW_GO:
  1EA0'   CD 1E39'              	CALL	EXRNG
  1EA3'   DA 1F27'              	JC	EXW_BD
  1EA6'   CD 1E61'              	CALL	EXSAVP
  1EA9'   2A 2AC0'              	LHLD	SRNG1
  1EAC'   CD 1E55'              	CALL	GOLNX
  1EAF'   C2 1F24'              	JNZ	EXW_NL		; the text has no line N
  1EB2'   3A 2ACD'              	LDA	RWERR		; a delete scans the whole directory, there or
  1EB5'   B7                    	ORA	A		;   not: only when TEXIST found one
  1EB6'   0E 13                 	MVI	C,13H
  1EB8'   C4 1E29'              	CNZ	TFDOS		; delete what is there
  1EBB'   0E 16                 	MVI	C,16H
  1EBD'   CD 1E29'              	CALL	TFDOS		; ... and make it
  1EC0'   3C                    	INR	A
  1EC1'   CA 1F16'              	JZ	EXW_FL		; no directory entry left
  1EC4'   3E 80                 	MVI	A,80H
  1EC6'   32 2ACC'              	STA	RWPTR
  1EC9'   AF                    	XRA	A
  1ECA'   32 2ACD'              	STA	RWERR
  1ECD'   2A 2ACA'              	LHLD	SLINES
  1ED0'   CD 0000*              	CALL	SETC0		; that many lines, forward
  1ED3'                         EXW_LP:
  1ED3'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  1ED6'   E5                    	PUSH	H
  1ED7'   EB                    	XCHG
  1ED8'   2A 0000*              	LHLD	GAPEND
  1EDB'   CD 1F33'              	CALL	RWOUT		; the text from the cursor to there
  1EDE'   E1                    	POP	H
  1EDF'   3A 2ACD'              	LDA	RWERR
  1EE2'   B7                    	ORA	A
  1EE3'   C2 1EFF'              	JNZ	EXW_EN
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EE6'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  1EE9'   CD 06A0'              	CALL	CNTTST
  1EEC'   C2 1ED3'              	JNZ	EXW_LP
  1EEF'                         EXW_PD:				; the last record is padded out with ^Z
  1EEF'   3A 2ACC'              	LDA	RWPTR
  1EF2'   FE 80                 	CPI	80H
  1EF4'   CA 1EFF'              	JZ	EXW_EN
  1EF7'   3E 1A                 	MVI	A,CPMEOF
  1EF9'   CD 1F3F'              	CALL	RWPUT
  1EFC'   C3 1EEF'              	JMP	EXW_PD
  1EFF'                         EXW_EN:
  1EFF'   0E 10                 	MVI	C,10H
  1F01'   CD 1E29'              	CALL	TFDOS		; close
  1F04'   3A 2ACD'              	LDA	RWERR
  1F07'   B7                    	ORA	A
  1F08'   C2 1F16'              	JNZ	EXW_FL
  1F0B'   CD 1E6D'              	CALL	EXRSTP
  1F0E'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
  1F10'   32 2A75'              	STA	MSGWHT
  1F13'   C3 075A'              	JMP	SETMOV		; nothing on the screen has changed
  1F16'                         EXW_FL:				; no room: the part written is not left behind
  1F16'   0E 13                 	MVI	C,13H
  1F18'   CD 1E29'              	CALL	TFDOS
  1F1B'   CD 1E6D'              	CALL	EXRSTP
  1F1E'   21 2442'              	LXI	H,SDFUL
  1F21'   C3 22BD'              	JMP	EXERR
  1F24'                         EXW_NL:
  1F24'   CD 1E6D'              	CALL	EXRSTP
  1F27'                         EXW_BD:
  1F27'   21 2434'              	LXI	H,SRNGE
  1F2A'   C3 22BD'              	JMP	EXERR
  1F2D'                         EXW_OW:
  1F2D'   21 22EC'              	LXI	H,SEXI
  1F30'   C3 22BD'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  1F33'                         RWOUT:
  1F33'   CD 0000*              	CALL	CMP16
  1F36'   C8                    	RZ
  1F37'   7E                    	MOV	A,M
  1F38'   23                    	INX	H
  1F39'   CD 1F3F'              	CALL	RWPUT
  1F3C'   C3 1F33'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  1F3F'                         RWPUT:
  1F3F'   E5                    	PUSH	H
  1F40'   F5                    	PUSH	PSW
  1F41'   3A 2ACC'              	LDA	RWPTR
  1F44'   6F                    	MOV	L,A
  1F45'   26 00                 	MVI	H,0
  1F47'   F1                    	POP	PSW
  1F48'   77                    	MOV	M,A
  1F49'   2C                    	INR	L		; Z: that was the record's last byte
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F4A'   7D                    	MOV	A,L
  1F4B'   C2 1F5E'              	JNZ	RWP_ST
  1F4E'   D5                    	PUSH	D
  1F4F'   0E 15                 	MVI	C,15H
  1F51'   CD 1E29'              	CALL	TFDOS		; write it
  1F54'   D1                    	POP	D
  1F55'   B7                    	ORA	A
  1F56'   CA 1F5C'              	JZ	RWP_OK
  1F59'   32 2ACD'              	STA	RWERR
  1F5C'                         RWP_OK:
  1F5C'   3E 80                 	MVI	A,80H
  1F5E'                         RWP_ST:
  1F5E'   32 2ACC'              	STA	RWPTR
  1F61'   E1                    	POP	H
  1F62'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  1F63'                         EX_R:
  1F63'   3A 2A65'              	LDA	EXARG
  1F66'   B7                    	ORA	A
  1F67'   CA 2285'              	JZ	MSGNFN		; No file name
  1F6A'   0E 0F                 	MVI	C,0FH
  1F6C'   CD 1E29'              	CALL	TFDOS		; open
  1F6F'   3C                    	INR	A
  1F70'   CA 203D'              	JZ	ER_NOF
  1F73'   CD 0F76'              	CALL	GZONE		; the screen's top line, before anything moves
  1F76'   CD 1E61'              	CALL	EXSAVP
  1F79'   3A 2ABF'              	LDA	SRNGF
  1F7C'   B7                    	ORA	A
  1F7D'   CA 1F96'              	JZ	ER_NXT		; no line given: below the cursor's
  1F80'   2A 2AC2'              	LHLD	SRNG2
  1F83'   7C                    	MOV	A,H
  1F84'   B5                    	ORA	L
  1F85'   C2 1F90'              	JNZ	ER_LN
  1F88'   23                    	INX	H
  1F89'   CD 0EE4'              	CALL	GOLN		; ':0r': above line 1 ...
  1F8C'   AF                    	XRA	A		;   which never wants a line end put in first
  1F8D'   C3 1FB8'              	JMP	ER_BRK
  1F90'                         ER_LN:
  1F90'   CD 1E55'              	CALL	GOLNX
  1F93'   C2 1F24'              	JNZ	EXW_NL		; the text has no line N
  1F96'                         ER_NXT:
  1F96'   21 0001               	LXI	H,1
  1F99'   AF                    	XRA	A
  1F9A'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  1F9D'   CD 0A1D'              	CALL	ATEOF
  1FA0'   3E 00                 	MVI	A,0
  1FA2'   D2 1FB8'              	JNC	ER_BRK		; text follows
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FA5'   2A 0000*              	LHLD	GAPBEG
  1FA8'   EB                    	XCHG
  1FA9'   2A 0000*              	LHLD	TXTBEG
  1FAC'   CD 0000*              	CALL	CMP16
  1FAF'   3E 01                 	MVI	A,1
  1FB1'   CA 1FB8'              	JZ	ER_BRK		; nothing before the cursor either
  1FB4'   1B                    	DCX	D
  1FB5'   1A                    	LDAX	D
  1FB6'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  1FB8'                         ER_BRK:
  1FB8'   32 2ACF'              	STA	RDBRK
  1FBB'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  1FBE'   AF                    	XRA	A
  1FBF'   32 2ACE'              	STA	RDANY
  1FC2'                         ER_LP:
  1FC2'   0E 14                 	MVI	C,14H
  1FC4'   CD 1E29'              	CALL	TFDOS		; the next record
  1FC7'   B7                    	ORA	A
  1FC8'   C2 1FFB'              	JNZ	ER_END
  1FCB'   21 0080               	LXI	H,CMDTAIL
  1FCE'   0E 00                 	MVI	C,0
  1FD0'                         ER_SC:				; C = its bytes, up to a ^Z
  1FD0'   7E                    	MOV	A,M
  1FD1'   FE 1A                 	CPI	CPMEOF
  1FD3'   CA 1FDB'              	JZ	ER_GOT
  1FD6'   23                    	INX	H
  1FD7'   0C                    	INR	C
  1FD8'   F2 1FD0'              	JP	ER_SC		; (minus: all 128)
  1FDB'                         ER_GOT:
  1FDB'   79                    	MOV	A,C
  1FDC'   B7                    	ORA	A
  1FDD'   CA 1FFB'              	JZ	ER_END
  1FE0'   C5                    	PUSH	B
  1FE1'   3A 2ACE'              	LDA	RDANY
  1FE4'   B7                    	ORA	A
  1FE5'   CC 202C'              	CZ	ER_1ST
  1FE8'   C1                    	POP	B
  1FE9'   06 00                 	MVI	B,0
  1FEB'   11 0080               	LXI	D,CMDTAIL
  1FEE'   C5                    	PUSH	B
  1FEF'   CD 0000*              	CALL	INSBLK
  1FF2'   C1                    	POP	B
  1FF3'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  1FF6'   79                    	MOV	A,C
  1FF7'   17                    	RAL
  1FF8'   DA 1FC2'              	JC	ER_LP		; a full record: there may be more
  1FFB'                         ER_END:
  1FFB'   3A 2ACE'              	LDA	RDANY
  1FFE'   B7                    	ORA	A
  1FFF'   CA 201D'              	JZ	ER_PL		; nothing in the file: nothing has changed
  2002'   CD 0A1D'              	CALL	ATEOF
  2005'   DA 2012'              	JC	ER_MD		; the text now ends as the file read ends
  2008'   2A 0000*              	LHLD	GAPBEG
  200B'   2B                    	DCX	H
  200C'   7E                    	MOV	A,M
  200D'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  200F'   C4 1E79'              	CNZ	PUTBRK		; text follows: what was read ends a line
  2012'                         ER_MD:
  2012'   3E 01                 	MVI	A,1
  2014'   32 2A0D'              	STA	MODF
  2017'   CD 03CF'              	CALL	MKPAGE		; back to the first line read
  201A'   CD 0000*              	CALL	GOTO
  201D'                         ER_PL:
  201D'   CD 0A1D'              	CALL	ATEOF
  2020'   DC 0A23'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2023'   CD 0000*              	CALL	CLRCNT
  2026'   CD 0F8E'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2029'   C3 077B'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  202C'                         ER_1ST:
  202C'   3C                    	INR	A
  202D'   32 2ACE'              	STA	RDANY
  2030'   3A 2ACF'              	LDA	RDBRK
  2033'   B7                    	ORA	A
  2034'   C4 1E79'              	CNZ	PUTBRK
  2037'   21 2AA1'              	LXI	H,MKPOS
  203A'   C3 044F'              	JMP	FPSTO
  203D'                         ER_NOF:
  203D'   21 2423'              	LXI	H,SNOPN
  2040'   C3 22B2'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2043'                         WRCHK:
  2043'   3A 2A65'              	LDA	EXARG
  2046'   B7                    	ORA	A
  2047'   C2 2051'              	JNZ	WC_ARG
  204A'   CD 20B4'              	CALL	OWNTF
  204D'   D8                    	RC
  204E'   C3 2066'              	JMP	WC_OWN
  2051'                         WC_ARG:
  2051'   CD 20CA'              	CALL	ISOWN
  2054'   CA 2066'              	JZ	WC_OWN
  2057'   3A 2A77'              	LDA	EXBANG
  205A'   B7                    	ORA	A
  205B'   CA 2064'              	JZ	WC_OTH
  205E'   CD 0000*              	CALL	TEXIST
  2061'   C2 228B'              	JNZ	MSGEXI		; File exists (! to force)
  2064'                         WC_OTH:
  2064'   AF                    	XRA	A		; (NC)
  2065'   C9                    	RET
  2066'                         WC_OWN:
  2066'   3A 2A78'              	LDA	ROFLAG		; '-R': this is the file it may not write
  2069'   B7                    	ORA	A
  206A'   CA 2074'              	JZ	WC_OK
  206D'   3A 2A77'              	LDA	EXBANG
  2070'   B7                    	ORA	A
  2071'   C2 2291'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2074'                         WC_OK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2074'   3E 01                 	MVI	A,1
  2076'   B7                    	ORA	A		; (NC)
  2077'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2078'                         WRITE:
  2078'   3A 2A66'              	LDA	EXBAK
  207B'   CD 0000*              	CALL	WRTO
  207E'   3A 0001*              	LDA	FNAME+1
  2081'   FE 20                 	CPI	' '
  2083'   C2 208F'              	JNZ	WR_HAS
  2086'   21 0000*              	LXI	H,TFCB
  2089'   11 0000*              	LXI	D,FNAME
  208C'   CD 20DC'              	CALL	COPY12
  208F'                         WR_HAS:
  208F'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  2091'   32 2A75'              	STA	MSGWHT
  2094'   CD 20CA'              	CALL	ISOWN
  2097'   C2 20A1'              	JNZ	SRCTF
  209A'   AF                    	XRA	A
  209B'   32 2A0D'              	STA	MODF
  209E'   32 2A76'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  20A1'                         SRCTF:
  20A1'   21 0000*              	LXI	H,TFCB
  20A4'   11 005C               	LXI	D,DFTFCB
  20A7'   CD 20DC'              	CALL	COPY12
  20AA'   AF                    	XRA	A
  20AB'   06 04                 	MVI	B,4
  20AD'                         SRC_Z:
  20AD'   12                    	STAX	D		; extent, s1, s2, record count: 0
  20AE'   13                    	INX	D
  20AF'   05                    	DCR	B
  20B0'   C2 20AD'              	JNZ	SRC_Z
  20B3'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  20B4'                         OWNTF:
  20B4'   3A 0001*              	LDA	FNAME+1
  20B7'   FE 20                 	CPI	' '
  20B9'   CA 2285'              	JZ	MSGNFN
  20BC'   CD 20E7'              	CALL	TFCLR
  20BF'   21 0000*              	LXI	H,FNAME
  20C2'   11 0000*              	LXI	D,TFCB
  20C5'   CD 20DC'              	CALL	COPY12
  20C8'   B7                    	ORA	A		; (NC)
  20C9'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  20CA'                         ISOWN:
  20CA'   21 0000*              	LXI	H,TFCB
  20CD'   11 0000*              	LXI	D,FNAME
  20D0'   06 0C                 	MVI	B,12
  20D2'                         IO_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20D2'   1A                    	LDAX	D
  20D3'   BE                    	CMP	M
  20D4'   C0                    	RNZ
  20D5'   23                    	INX	H
  20D6'   13                    	INX	D
  20D7'   05                    	DCR	B
  20D8'   C2 20D2'              	JNZ	IO_LP
  20DB'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  20DC'                         COPY12:
  20DC'   06 0C                 	MVI	B,12
  20DE'                         CP_LP:
  20DE'   7E                    	MOV	A,M
  20DF'   12                    	STAX	D
  20E0'   23                    	INX	H
  20E1'   13                    	INX	D
  20E2'   05                    	DCR	B
  20E3'   C2 20DE'              	JNZ	CP_LP
  20E6'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  20E7'                         TFCLR:
  20E7'   11 0000*              	LXI	D,TFCB
  20EA'   06 24                 	MVI	B,36
  20EC'   AF                    	XRA	A
  20ED'                         TC_LP:
  20ED'   12                    	STAX	D
  20EE'   13                    	INX	D
  20EF'   05                    	DCR	B
  20F0'   C2 20ED'              	JNZ	TC_LP
  20F3'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  20F4'                         FOPEN:
  20F4'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  20F6'   32 2A75'              	STA	MSGWHT
  20F9'   21 005C               	LXI	H,DFTFCB
  20FC'   CD 21CE'              	CALL	NRMDRV
  20FF'   11 0000*              	LXI	D,FNAME
  2102'   CD 20DC'              	CALL	COPY12
  2105'   CD 0000*              	CALL	OPENZ
  2108'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  210B'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  210D'   C8                    	RZ
  210E'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  2111'   32 2A76'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2114'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  2115'                         ARGSCN:
  2115'   3A 0080               	LDA	CMDTAIL
  2118'   47                    	MOV	B,A		; B = what is left of the line
  2119'   B7                    	ORA	A
  211A'   C8                    	RZ
  211B'   21 0081               	LXI	H,CMDTAIL+1
  211E'                         AS_TOK:				; at a token, or the blanks before one
  211E'   7E                    	MOV	A,M
  211F'   FE 20                 	CPI	' '
  2121'   C2 212A'              	JNZ	AS_OPT
  2124'   23                    	INX	H
  2125'   05                    	DCR	B
  2126'   C2 211E'              	JNZ	AS_TOK
  2129'   C9                    	RET
  212A'                         AS_OPT:
  212A'   FE 2B                 	CPI	'+'
  212C'   CA 2156'              	JZ	AS_PLS
  212F'   FE 2D                 	CPI	'-'
  2131'   CA 2145'              	JZ	AS_SW
  2134'   FE 2F                 	CPI	'/'
  2136'   CA 2145'              	JZ	AS_SW
  2139'                         AS_SKP:				; not ours (the file name): on to the next one
  2139'   23                    	INX	H
  213A'   05                    	DCR	B
  213B'   C8                    	RZ
  213C'   7E                    	MOV	A,M
  213D'   FE 20                 	CPI	' '
  213F'   C2 2139'              	JNZ	AS_SKP
  2142'   C3 211E'              	JMP	AS_TOK
  2145'                         AS_SW:
  2145'   23                    	INX	H
  2146'   05                    	DCR	B
  2147'   C8                    	RZ
  2148'   7E                    	MOV	A,M
  2149'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  214B'   FE 52                 	CPI	'R'
  214D'   C2 2139'              	JNZ	AS_SKP
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2150'   32 2A78'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2153'   C3 2139'              	JMP	AS_SKP
  2156'                         AS_PLS:
  2156'   3E 01                 	MVI	A,1
  2158'   32 2A79'              	STA	PLUSF		; '+' gets the line even with no number on it
  215B'   11 0000*              	LXI	D,PLUSB
  215E'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  2160'   23                    	INX	H		;   line space, so it is taken as '+' alone
  2161'   05                    	DCR	B
  2162'   CA 2199'              	JZ	AS_PE
  2165'   7E                    	MOV	A,M
  2166'   FE 30                 	CPI	'0'
  2168'   C2 2180'              	JNZ	AS_PD
  216B'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  216B'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  216C'   05                    	DCR	B
  216D'   CA 21A1'              	JZ	AS_P1
  2170'   7E                    	MOV	A,M
  2171'   FE 30                 	CPI	'0'
  2173'   CA 216B'              	JZ	AS_PZ
  2176'   FE 31                 	CPI	'1'
  2178'   DA 21A1'              	JC	AS_P1		; zeros and then no digit at all: line 1
  217B'   FE 3A                 	CPI	'9'+1
  217D'   D2 21A1'              	JNC	AS_P1
  2180'                         AS_PD:				; the digits, as typed
  2180'   7E                    	MOV	A,M
  2181'   FE 30                 	CPI	'0'
  2183'   DA 2199'              	JC	AS_PE
  2186'   FE 3A                 	CPI	'9'+1
  2188'   D2 2199'              	JNC	AS_PE
  218B'   79                    	MOV	A,C
  218C'   B7                    	ORA	A
  218D'   CA 21A8'              	JZ	AS_POV
  2190'   0D                    	DCR	C
  2191'   7E                    	MOV	A,M
  2192'   12                    	STAX	D
  2193'   13                    	INX	D
  2194'   23                    	INX	H
  2195'   05                    	DCR	B
  2196'   C2 2180'              	JNZ	AS_PD
  2199'                         AS_PE:
  2199'   AF                    	XRA	A
  219A'   12                    	STAX	D		; the digits end with a 0
  219B'   78                    	MOV	A,B
  219C'   B7                    	ORA	A
  219D'   C8                    	RZ
  219E'   C3 211E'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  21A1'                         AS_P1:
  21A1'   3E 31                 	MVI	A,'1'
  21A3'   12                    	STAX	D
  21A4'   13                    	INX	D
  21A5'   C3 2199'              	JMP	AS_PE
  21A8'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  21A8'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21AB'   C3 2199'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  21AE'                         ARGGO:
  21AE'   3A 2A79'              	LDA	PLUSF
  21B1'   B7                    	ORA	A
  21B2'   C8                    	RZ
  21B3'   21 0000*              	LXI	H,PLUSB
  21B6'                         AG_LP:
  21B6'   7E                    	MOV	A,M
  21B7'   B7                    	ORA	A
  21B8'   CA 21C7'              	JZ	AG_G
  21BB'   4F                    	MOV	C,A
  21BC'   06 02                 	MVI	B,KT_CHAR
  21BE'   E5                    	PUSH	H
  21BF'   CD 0023'              	CALL	VICMD
  21C2'   E1                    	POP	H
  21C3'   23                    	INX	H
  21C4'   C3 21B6'              	JMP	AG_LP
  21C7'                         AG_G:
  21C7'   0E 47                 	MVI	C,'G'
  21C9'   06 02                 	MVI	B,KT_CHAR
  21CB'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  21CE'                         NRMDRV:
  21CE'   7E                    	MOV	A,M
  21CF'   B7                    	ORA	A
  21D0'   C0                    	RNZ
  21D1'   E5                    	PUSH	H
  21D2'   0E 19                 	MVI	C,BF_CURDSK
  21D4'   CD 0005               	CALL	BDOS
  21D7'   E1                    	POP	H
  21D8'   3C                    	INR	A
  21D9'   77                    	MOV	M,A
  21DA'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  21DB'                         PARSFN:
  21DB'   CD 20E7'              	CALL	TFCLR
  21DE'   11 0000*              	LXI	D,TFCB
  21E1'   23                    	INX	H
  21E2'   7E                    	MOV	A,M
  21E3'   2B                    	DCX	H
  21E4'   FE 3A                 	CPI	':'
  21E6'   C2 21F8'              	JNZ	PF_NM
  21E9'   CD 223E'              	CALL	GETFNC
  21EC'   CA 21F8'              	JZ	PF_NM
  21EF'   D6 40                 	SUI	40H
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  21F1'   12                    	STAX	D
  21F2'   FE 11                 	CPI	17
  21F4'   D2 221C'              	JNC	PF_BAD
  21F7'   23                    	INX	H
  21F8'                         PF_NM:
  21F8'   13                    	INX	D
  21F9'   0E 08                 	MVI	C,8
  21FB'   CD 2220'              	CALL	CPYNAM
  21FE'   FE 2E                 	CPI	'.'
  2200'   0E 03                 	MVI	C,3
  2202'   C4 2233'              	CNZ	PADFLD		; no type: blanks
  2205'   CC 221F'              	CZ	CPYNM0		; '.': the type
  2208'   3A 0001*              	LDA	TFCB+1
  220B'   FE 20                 	CPI	' '
  220D'   CA 221C'              	JZ	PF_BAD		; no name
  2210'   CD 2271'              	CALL	SKIPB
  2213'   C0                    	RNZ			; more after it
  2214'   21 0000*              	LXI	H,TFCB
  2217'   CD 21CE'              	CALL	NRMDRV
  221A'   AF                    	XRA	A
  221B'   C9                    	RET
  221C'                         PF_BAD:
  221C'   F6 01                 	ORI	1
  221E'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  221F'                         CPYNM0:
  221F'   23                    	INX	H
  2220'                         CPYNAM:
  2220'   CD 223E'              	CALL	GETFNC
  2223'   CA 2233'              	JZ	PADFLD
  2226'   12                    	STAX	D
  2227'   13                    	INX	D
  2228'   0D                    	DCR	C
  2229'   C2 2220'              	JNZ	CPYNAM
  222C'                         CN_SKP:
  222C'   CD 223E'              	CALL	GETFNC
  222F'   C2 222C'              	JNZ	CN_SKP
  2232'   C9                    	RET
  2233'                         PADFLD:
  2233'   F5                    	PUSH	PSW
  2234'                         PD_LP:
  2234'   3E 20                 	MVI	A,' '
  2236'   12                    	STAX	D
  2237'   13                    	INX	D
  2238'   0D                    	DCR	C
  2239'   C2 2234'              	JNZ	PD_LP
  223C'   F1                    	POP	PSW
  223D'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  223E'                         GETFNC:
  223E'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  223F'   FE 3D                 	CPI	'='
  2241'   C8                    	RZ
  2242'   FE 5F                 	CPI	'_'
  2244'   C8                    	RZ
  2245'   FE 3B                 	CPI	';'
  2247'   C8                    	RZ
  2248'   FE 3C                 	CPI	'<'
  224A'   C8                    	RZ
  224B'   FE 3E                 	CPI	'>'
  224D'   C8                    	RZ
  224E'   FE 2E                 	CPI	'.'
  2250'   C8                    	RZ
  2251'   FE 3A                 	CPI	':'
  2253'   C8                    	RZ
  2254'   FE 2A                 	CPI	'*'
  2256'   C8                    	RZ
  2257'   FE 3F                 	CPI	'?'
  2259'   C8                    	RZ
  225A'   FE 20                 	CPI	' '
  225C'   DA 226F'              	JC	GF_CTL
  225F'   C8                    	RZ
  2260'   23                    	INX	H
  2261'   FE 61                 	CPI	'a'
  2263'   DA 226D'              	JC	GF_DN
  2266'   FE 7B                 	CPI	'z'+1
  2268'   D2 226D'              	JNC	GF_DN
  226B'   E6 DF                 	ANI	0DFH
  226D'                         GF_DN:
  226D'   B7                    	ORA	A
  226E'   C9                    	RET
  226F'                         GF_CTL:
  226F'   BF                    	CMP	A
  2270'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  2271'                         SKIPB:
  2271'   7E                    	MOV	A,M
  2272'   FE 20                 	CPI	' '
  2274'   C2 227B'              	JNZ	SB_DN
  2277'   23                    	INX	H
  2278'   C3 2271'              	JMP	SKIPB
  227B'                         SB_DN:
  227B'   B7                    	ORA	A
  227C'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  227D'                         ISLOW:
  227D'   7E                    	MOV	A,M
  227E'   FE 61                 	CPI	'a'
  2280'   D8                    	RC
  2281'   FE 7B                 	CPI	'z'+1
  2283'   3F                    	CMC
  2284'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  2285'                         MSGNFN:
