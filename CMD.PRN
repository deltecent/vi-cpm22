  06C7'   7A                    	MOV	A,D
  06C8'   B3                    	ORA	E
  06C9'   CA 06D7'              	JZ	BOL_X		; at 0
  06CC'   2B                    	DCX	H
  06CD'   7E                    	MOV	A,M
  06CE'   FE 0A                 	CPI	LF
  06D0'   CA 06D7'              	JZ	BOL_X
  06D3'   1B                    	DCX	D
  06D4'   C3 06C7'              	JMP	BOL_C
  06D7'                         BOL_X:
  06D7'   EB                    	XCHG
  06D8'   C1                    	POP	B
  06D9'   C9                    	RET
                                
