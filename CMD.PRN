  0B28'   CA 0B37'              	JZ	NX_LF
  0B2B'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0B2E'   D8                    	RC
  0B2F'   FE 0A                 	CPI	LF
  0B31'   CA 0B37'              	JZ	NX_LF
  0B34'   2B                    	DCX	H		; a lone CR
  0B35'   AF                    	XRA	A
  0B36'   C9                    	RET
  0B37'                         NX_LF:
  0B37'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0B3A'   D8                    	RC
  0B3B'   2B                    	DCX	H
  0B3C'   3E 01                 	MVI	A,1
  0B3E'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0B3F'                         INCC:
  0B3F'   CD 0989'              	CALL	ATEOF
  0B42'   DA 0B7D'              	JC	IC_END
  0B45'   FE 0D                 	CPI	CR
  0B47'   CA 0B68'              	JZ	IC_NL
  0B4A'   FE 0A                 	CPI	LF
  0B4C'   CA 0B68'              	JZ	IC_NL
  0B4F'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0B52'                         IC_CH:
  0B52'   CD 0989'              	CALL	ATEOF
  0B55'   DA 0B64'              	JC	IC_2
  0B58'   FE 0D                 	CPI	CR
  0B5A'   CA 0B64'              	JZ	IC_2
  0B5D'   FE 0A                 	CPI	LF
  0B5F'   CA 0B64'              	JZ	IC_2
  0B62'   AF                    	XRA	A
  0B63'   C9                    	RET
  0B64'                         IC_2:
  0B64'   3E 02                 	MVI	A,2
  0B66'   B7                    	ORA	A
  0B67'   C9                    	RET
  0B68'                         IC_NL:
  0B68'   CD 0B26'              	CALL	NXLN
  0B6B'   DA 0B7D'              	JC	IC_END
  0B6E'   F5                    	PUSH	PSW
  0B6F'   CD 0000*              	CALL	PUTCUR
  0B72'   F1                    	POP	PSW
  0B73'   B7                    	ORA	A
  0B74'   CA 0B52'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0B77'   CD 0BA3'              	CALL	LNINC
  0B7A'   3E 01                 	MVI	A,1
  0B7C'   C9                    	RET
  0B7D'                         IC_END:
  0B7D'   3E FF                 	MVI	A,0FFH
  0B7F'   B7                    	ORA	A
  0B80'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0B81'                         DECC:
  0B81'   CD 0000*              	CALL	PEEKL
  0B84'   DA 0B7D'              	JC	IC_END
  0B87'   F5                    	PUSH	PSW
  0B88'   CD 0000*              	CALL	PUTCUR
  0B8B'   F1                    	POP	PSW
  0B8C'   FE 0A                 	CPI	LF
  0B8E'   3E 00                 	MVI	A,0
  0B90'   C0                    	RNZ
  0B91'   CD 0BB1'              	CALL	LNDEC
  0B94'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B97'   DA 0B9F'              	JC	DC_1
  0B9A'   FE 0D                 	CPI	CR
  0B9C'   CC 0000*              	CZ	PUTCUR
  0B9F'                         DC_1:
  0B9F'   3E 01                 	MVI	A,1
  0BA1'   B7                    	ORA	A
  0BA2'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0BA3'                         LNINC:
  0BA3'   E5                    	PUSH	H
  0BA4'   2A 0000*              	LHLD	LNDLT
  0BA7'   7C                    	MOV	A,H
  0BA8'   FE 40                 	CPI	40H
  0BAA'   CA 0BBF'              	JZ	LN_X
  0BAD'   23                    	INX	H
  0BAE'   C3 0BBC'              	JMP	LN_ST
  0BB1'                         LNDEC:
