  0B87'   F1                    	POP	PSW
  0B88'   FE 0A                 	CPI	LF
  0B8A'   3E 00                 	MVI	A,0
  0B8C'   C0                    	RNZ
  0B8D'   CD 0BAD'              	CALL	LNDEC
  0B90'   CD 0000*              	CALL	PEEKL		; onto its CR
  0B93'   DA 0B9B'              	JC	DC_1
  0B96'   FE 0D                 	CPI	CR
  0B98'   CC 0000*              	CZ	PUTCUR
