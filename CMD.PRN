  0A75'   CA 0A96'              	JZ	IC_NL
  0A78'   FE 0A                 	CPI	LF
  0A7A'   CA 0A96'              	JZ	IC_NL
  0A7D'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0A80'                         IC_CH:
