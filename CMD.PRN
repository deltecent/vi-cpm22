                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the cursor's line is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
                         C      ; PLACE -- what a command asks of the next layout (SCRN.MAC), cleared by it.
  0000                   C      PL_ASK	EQU	0		; the cursor only moved: is its line on the screen
                         C      				;   still, near it, or far off? (vim's rule)
  0001                   C      PL_SET	EQU	1		; the command set the lines above it (WINROW)
  0002                   C      PL_MID	EQU	2		; mid-screen, as the rows fall
                         C      
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; the cursor's line changed only -> redraw it from the cursor's row
  0003                   C      R_DLIN	EQU	3		; the cursor's line deleted -> DL its rows + redraw the bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted, no TAB after it -> ICH
  0005                   C      R_ILIN	EQU	5		; ILN lines opened at the cursor -> IL + their rows (ILABOV: the line above)
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw it + DL the rows saved
  0007                   C      R_DCH	EQU	7		; chars deleted at the cursor, none after it a TAB -> DCH
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
  0004                   C      MW_BIG	EQU	4		; the yank register cannot hold that
  0005                   C      MW_MEM	EQU	5		; out of memory: the key abandoned (MEMABT)
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: a 3-byte file position (the 4th is spare)
  0024                   C      SREPMX	EQU	EXMAX-4		; ':s' replacement -- bounded by the ex line
                         C      				;   itself, so SCOPY can never truncate a line
                         C      				;   anyone is able to type: the shortest
                         C      				;   substitute is 's' '/' + one pattern char +
                         C      				;   '/' before the replacement starts, and
                         C      				;   RDLINE stores at most EXMAX.  Tied to
                         C      				;   EXMAX rather than written out, so the two
                         C      				;   cannot drift apart.
                         C      
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	BOL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	DCHN				; ... the cells an R_DCH deletes
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	MKSHFT				; the marks follow an edit (VI.MAC hooks it)
                                	PUBLIC	MEMABT				; out of room: the key goes (VI.MAC hooks it)
                                	EXTRN	ERRMSG				; BUF.MAC -- ... unless it cannot
                                	EXTRN	MLDRAW				; VI.MAC  -- the main loop's repaint
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	KBBRK, KBFLSH			; KEY.MAC -- an ESC waiting / drop type-ahead
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	MKSAV				; ... and a refused 'dd's copy of them
                                	EXTRN	MKUND				; ... and the copy 'u' puts back
                                	EXTRN	UNDST, UNDNEW			; BUF.MAC -- undone or not; no change yet
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDCLR				; ... nothing to undo
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	INSBLK, UNDINS			; BUF.MAC -- a block in at the cursor (':r')
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	UNDML, UNDL0			; ... and whether one line changed
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	UNDLK, UNDLC, UNDLL0		; ... or whole lines came or went
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, PLACE	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	SKIPR, TALLF		; a top line taller than the screen
                                	EXTRN	TXEND, CSUB, HTBLD		; ... its rows of text, the cursor's row
                                						;   in its line, and the row table
                                	EXTRN	HTAB				; RSV.MAC -- the row table itself
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	SETC0				; BUF.MAC -- WM count set, forward
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GOLINE				; BUF.MAC -- WM 2228 (a mark's page loop)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                	EXTRN	PGJUMP, TOPLF			; PAGE.MAC -- a far move up starts over (#34 B)
                                	EXTRN	SCNREC, SECBUF			; PAGE.MAC -- a record outside it, read
                                	EXTRN	BAKRDY, BAKPOS			; ... and the backup stack below it
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   AF                    	XRA	A		; no command is ever left open to an ESC by the
  0001'   32 0000*              	STA	BRKARM		;   one before it (BRKON)
  0004'   32 0000*              	STA	ABTFLG		; ... and MEMABT's repaint is behind it
  0007'   CD 00DA'              	CALL	DOTPRE
  000A'   CD 0010'              	CALL	CDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


  000D'   C3 011F'              	JMP	DOTPOST
  0010'                         CDMODE:
  0010'   3A 0000*              	LDA	EDMODE
  0013'   FE 01                 	CPI	EM_INS
  0015'   CA 0020'              	JZ	CD_INS
  0018'   FE 02                 	CPI	EM_REP
  001A'   CA 0023'              	JZ	CD_REP
  001D'   C3 0026'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0020'                         CD_INS:
  0020'   C3 20D6'              	JMP	VIINS
  0023'                         CD_REP:
  0023'   C3 200B'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  C = the key.
                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  0026'                         VICMD:
  0026'   79                    	MOV	A,C
  0027'   FE 1B                 	CPI	ESC
  0029'   CA 00AF'              	JZ	VIC_ESC
  002C'   3A 0000*              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002F'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  0031'   CA 1BAE'              	JZ	VR_DO
                                	;--- maybe a count digit ---
  0034'   79                    	MOV	A,C
  0035'   FE 31                 	CPI	'1'
  0037'   DA 0042'              	JC	VIC_NOTD	; < '1'
  003A'   FE 3A                 	CPI	'9'+1
  003C'   D2 0042'              	JNC	VIC_NOTD	; > '9'
  003F'   C3 0052'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  0042'                         VIC_NOTD:
  0042'   79                    	MOV	A,C
  0043'   FE 30                 	CPI	'0'
  0045'   C2 007A'              	JNZ	VICDSP
  0048'   2A 0000*              	LHLD	CMDCNT
  004B'   7C                    	MOV	A,H
  004C'   B5                    	ORA	L
  004D'   CA 007A'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  0050'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  0052'                         VICDIG:
  0052'   2A 0000*              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0055'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0056'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0057'   29                    	DAD	H		; *2
  0058'   DA 0071'              	JC	VIC_SAT
  005B'   29                    	DAD	H		; *4
  005C'   DA 0071'              	JC	VIC_SAT
  005F'   19                    	DAD	D		; *5
  0060'   DA 0071'              	JC	VIC_SAT
  0063'   29                    	DAD	H		; *10
  0064'   DA 0071'              	JC	VIC_SAT
  0067'   79                    	MOV	A,C
  0068'   D6 30                 	SUI	'0'
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  006A'   5F                    	MOV	E,A
  006B'   16 00                 	MVI	D,0
  006D'   19                    	DAD	D
  006E'   D2 0074'              	JNC	VIC_CNT
  0071'                         VIC_SAT:
  0071'   21 FFFF               	LXI	H,0FFFFH
  0074'                         VIC_CNT:
  0074'   22 0000*              	SHLD	CMDCNT
  0077'   C3 0871'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  007A'                         VICDSP:
  007A'   3A 0000*              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  007D'   32 0000*              	STA	GSAVE
  0080'   AF                    	XRA	A
  0081'   32 0000*              	STA	GPEND
  0084'   3A 0000*              	LDA	PENDOP
  0087'   32 0000*              	STA	PSAVE
  008A'   AF                    	XRA	A
  008B'   32 0000*              	STA	PENDOP
  008E'   3A 0000*              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  0091'   B7                    	ORA	A
  0092'   C2 14F4'              	JNZ	OPPEND
  0095'   3A 0000*              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0098'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  009A'   C2 00A3'              	JNZ	VIC_TB
  009D'   79                    	MOV	A,C
  009E'   FE 5A                 	CPI	'Z'
  00A0'   C2 00A9'              	JNZ	VIC_SW
  00A3'                         VIC_TB:
  00A3'   21 3135'              	LXI	H,CMDTAB
  00A6'   C3 00BF'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A9'                         VIC_SW:
  00A9'   CD 0871'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00AC'   C3 079C'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AF'                         VIC_ESC:
  00AF'   AF                    	XRA	A		; ESC drops whatever was pending, the count too
  00B0'   32 0000*              	STA	GPEND
  00B3'   32 0000*              	STA	GSAVE
  00B6'   32 0000*              	STA	PENDOP
  00B9'   32 0000*              	STA	PSAVE
  00BC'   C3 00A9'              	JMP	VIC_SW
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the TOP-LEVEL key table, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BF'                         VSCANQ:
  00BF'   CD 00CB'              	CALL	VSCLK
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00C2'   CA 00A9'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C5'   E9                    	PCHL
  00C6'                         VSCAN:
  00C6'   CD 00CB'              	CALL	VSCLK
  00C9'   C8                    	RZ			; miss
  00CA'   E9                    	PCHL
  00CB'                         VSCLK:
  00CB'   7E                    VSCAN1: MOV	A,M
  00CC'   B7                    	ORA	A
  00CD'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CE'   23                    	INX	H
  00CF'   B9                    	CMP	C
  00D0'   5E                    	MOV	E,M
  00D1'   23                    	INX	H
  00D2'   56                    	MOV	D,M
  00D3'   23                    	INX	H
  00D4'   C2 00CB'              	JNZ	VSCAN1
  00D7'   EB                    	XCHG			; HL = the handler
  00D8'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D9'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00DA'                         DOTPRE:
  00DA'   3A 0000*              	LDA	DOTRPL
  00DD'   B7                    	ORA	A
  00DE'   C0                    	RNZ			; the replay's own keys are not recorded
  00DF'   C5                    	PUSH	B
  00E0'   D5                    	PUSH	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00E1'   E5                    	PUSH	H
  00E2'   3A 31F1'              	LDA	DOTSTA
  00E5'   B7                    	ORA	A
  00E6'   CA 00F9'              	JZ	DOTP1
  00E9'   AF                    	XRA	A		; a new command: the recording starts over
  00EA'   32 31F1'              	STA	DOTSTA
  00ED'   32 0000*              	STA	DOTOVF
  00F0'   21 0000*              	LXI	H,DOTSCR
  00F3'   22 31F2'              	SHLD	DOTSP
  00F6'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F9'                         DOTP1:
  00F9'   79                    	MOV	A,C
  00FA'   32 0000*              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  00FD'   47                    	MOV	B,A
  00FE'   2A 31F2'              	LHLD	DOTSP
  0101'   EB                    	XCHG
  0102'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0105'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0108'   D2 0117'              	JNC	DOTPOV
  010B'   2A 31F2'              	LHLD	DOTSP
  010E'   70                    	MOV	M,B
  010F'   23                    	INX	H
  0110'   22 31F2'              	SHLD	DOTSP
  0113'                         DOTPX:
  0113'   E1                    	POP	H
  0114'   D1                    	POP	D
  0115'   C1                    	POP	B
  0116'   C9                    	RET
  0117'                         DOTPOV:
  0117'   3E 01                 	MVI	A,1
  0119'   32 0000*              	STA	DOTOVF		; too long to record: give this recording up
  011C'   C3 0113'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  011F'                         DOTPOST:
  011F'   3A 0000*              	LDA	DOTRPL
  0122'   B7                    	ORA	A
  0123'   C0                    	RNZ
  0124'   3A 0000*              	LDA	EDMODE
  0127'   B7                    	ORA	A
  0128'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  0129'   3A 0000*              	LDA	GPEND
  012C'   B7                    	ORA	A
  012D'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  012E'   3A 0000*              	LDA	PENDOP
  0131'   B7                    	ORA	A
  0132'   C0                    	RNZ			; an operator still waiting for its motion
  0133'   2A 0000*              	LHLD	CMDCNT
  0136'   7C                    	MOV	A,H
  0137'   B5                    	ORA	L
  0138'   CA 0146'              	JZ	DOTQ1
  013B'   3A 0000*              	LDA	DOTLK		; a digit with the count still up: the command
  013E'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0140'   DA 0146'              	JC	DOTQ1
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0143'   FE 3A                 	CPI	'9'+1
  0145'   D8                    	RC
  0146'                         DOTQ1:
  0146'   3E 01                 	MVI	A,1
  0148'   32 31F1'              	STA	DOTSTA		; the next key starts a new recording
  014B'   3A 0000*              	LDA	DOTCHG
  014E'   B7                    	ORA	A
  014F'   C8                    	RZ			; changed nothing: not a repeatable command
  0150'   AF                    	XRA	A
  0151'   32 0000*              	STA	DOTCHG
  0154'   32 0000*              	STA	DOTLEN
  0157'   3A 0000*              	LDA	DOTOVF
  015A'   B7                    	ORA	A
  015B'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  015C'   2A 31F2'              	LHLD	DOTSP
  015F'   11 0000*              	LXI	D,DOTSCR
  0162'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0165'   7D                    	MOV	A,L
  0166'   32 0000*              	STA	DOTLEN
  0169'   B7                    	ORA	A
  016A'   C8                    	RZ
  016B'   4F                    	MOV	C,A
  016C'   06 00                 	MVI	B,0
  016E'   21 0000*              	LXI	H,DOTSCR
  0171'   11 0000*              	LXI	D,DOTBUF
  0174'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0177'                         MARKMOD:
  0177'   3E 01                 	MVI	A,1
  0179'   32 0000*              	STA	MODF
  017C'   32 0000*              	STA	DOTCHG
  017F'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0180'                         VC_DOT:
  0180'   2A 0000*              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0183'   22 0000*              	SHLD	DOTNCT
  0186'   21 0000               	LXI	H,0
  0189'   22 0000*              	SHLD	CMDCNT
  018C'   3A 0000*              	LDA	DOTLEN
  018F'   B7                    	ORA	A
  0190'   CA 01DF'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  0193'   AF                    	XRA	A
  0194'   32 0000*              	STA	DOTIX
  0197'   2A 0000*              	LHLD	DOTNCT
  019A'   7C                    	MOV	A,H
  019B'   B5                    	ORA	L
  019C'   CA 01BC'              	JZ	DOTGO
  019F'   22 0000*              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01A2'                         DOTSKP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01A2'   CD 0617'              	CALL	DOTGET		; ... so step past the digits it recorded
  01A5'   DA 01BC'              	JC	DOTGO
  01A8'   FE 30                 	CPI	'0'
  01AA'   DA 01BC'              	JC	DOTGO
  01AD'   FE 3A                 	CPI	'9'+1
  01AF'   D2 01BC'              	JNC	DOTGO
  01B2'   3A 0000*              	LDA	DOTIX
  01B5'   3C                    	INR	A
  01B6'   32 0000*              	STA	DOTIX
  01B9'   C3 01A2'              	JMP	DOTSKP
  01BC'                         DOTGO:
  01BC'   3E 01                 	MVI	A,1
  01BE'   32 0000*              	STA	DOTRPL
  01C1'                         DOTLP:
  01C1'   CD 0617'              	CALL	DOTGET
  01C4'   DA 01D5'              	JC	DOTDN
  01C7'   4F                    	MOV	C,A
  01C8'   3A 0000*              	LDA	DOTIX
  01CB'   3C                    	INR	A
  01CC'   32 0000*              	STA	DOTIX
  01CF'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01D2'   C3 01C1'              	JMP	DOTLP
  01D5'                         DOTDN:
  01D5'   AF                    	XRA	A
  01D6'   32 0000*              	STA	DOTRPL
  01D9'   32 0000*              	STA	DOTCHG		; the '.' is not itself the new last change
  01DC'   C3 08AE'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01DF'                         DOTBEL:
  01DF'   0E 07                 	MVI	C,BEL
  01E1'   CD 0000*              	CALL	BCONOU
  01E4'   C3 0871'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a 3-byte position in the FILE (FPOS: the records paged out ahead
                                ; of the window, plus the offset into it), so it does not care which part of
                                ; the file is resident: a jump pages until the window holds it (MKPAGE).  It
                                ; FOLLOWS its text, as vim's does: every edit passes MKSHFT, which moves the
                                ; marks past it by the bytes that went in or came out.
                                ;
                                ; DEVIATIONS from vim, in COMMANDS.md: a mark whose own text is deleted closes
                                ; up to where the delete was, where vim deletes the mark with its line; and
                                ; within its line a mark stays with its CHARACTER, where vim keeps the column
                                ; number.  'u' puts the marks back where they were when the change it
                                ; undoes began (MKSNAP / MKREST).
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  01E7'                         MKVAD:
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


  01E7'   16 00                 	MVI	D,0
  01E9'   59                    	MOV	E,C
  01EA'   21 0000*              	LXI	H,MKVAL
  01ED'   19                    	DAD	D
  01EE'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  01EF'                         MKCLR:
  01EF'   21 0000*              	LXI	H,MKVAL
  01F2'   06 03                 	MVI	B,MKMAX
  01F4'   AF                    	XRA	A
  01F5'                         MKC_LP:
  01F5'   77                    	MOV	M,A
  01F6'   23                    	INX	H
  01F7'   05                    	DCR	B
  01F8'   C2 01F5'              	JNZ	MKC_LP
  01FB'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was an ESC.
                                ;A key typed here did not come through the dispatcher, so it is handed to
                                ;DOTPRE to join the recording: that is what lets '.' repeat "dfa", "dgg" and
                                ;"d'a".
  01FC'                         MKGETK:
  01FC'   3A 0000*              	LDA	DOTRPL
  01FF'   B7                    	ORA	A
  0200'   CA 0211'              	JZ	MKG_KB
  0203'   CD 0617'              	CALL	DOTGET		; the recording's next key
  0206'   D8                    	RC
  0207'   4F                    	MOV	C,A
  0208'   3A 0000*              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  020B'   3C                    	INR	A
  020C'   32 0000*              	STA	DOTIX
  020F'   B7                    	ORA	A		; CY clear
  0210'   C9                    	RET
  0211'                         MKG_KB:
  0211'   CD 0000*              	CALL	GETKEY
  0214'   FE 1B                 	CPI	ESC
  0216'   37                    	STC
  0217'   C8                    	RZ			; ESC cancels the command
  0218'   CD 00DA'              	CALL	DOTPRE		; C kept
  021B'   B7                    	ORA	A		; CY clear
  021C'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; the motion returns.  MKGETK puts the character in the '.' recording, so
                                ; '.' can repeat "dfa".
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  021D'                         VC_FF:				; 'f' -- forward, onto the character
  021D'   3E 66                 	MVI	A,'f'
  021F'   C3 022E'              	JMP	FNDNEW
  0222'                         VC_FB:				; 'F' -- backward, onto it
  0222'   3E 46                 	MVI	A,'F'
  0224'   C3 022E'              	JMP	FNDNEW
  0227'                         VC_TF:				; 't' -- forward, up to it
  0227'   3E 74                 	MVI	A,'t'
  0229'   C3 022E'              	JMP	FNDNEW
  022C'                         VC_TB:				; 'T' -- backward, up to it
  022C'   3E 54                 	MVI	A,'T'
  022E'                         FNDNEW:
  022E'   32 0000*              	STA	FNDKND		; the find ';' and ',' will repeat
  0231'   CD 01FC'              	CALL	MKGETK		; the character it looks for
  0234'   DA 0266'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0237'   79                    	MOV	A,C
  0238'   32 0000*              	STA	FNDCH
  023B'   3A 0000*              	LDA	FNDKND
  023E'   06 01                 	MVI	B,1		; a find starts at the next character along
  0240'   C3 026D'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0243'                         VC_SEMI:
  0243'   3A 0000*              	LDA	FNDKND
  0246'   B7                    	ORA	A
  0247'   CA 0266'              	JZ	FNDNIL		; nothing has been looked for yet
  024A'   C3 0256'              	JMP	FNDREP
  024D'                         VC_COMMA:
  024D'   3A 0000*              	LDA	FNDKND
  0250'   B7                    	ORA	A
  0251'   CA 0266'              	JZ	FNDNIL
  0254'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0256'                         FNDREP:
  0256'   06 01                 	MVI	B,1
  0258'   F5                    	PUSH	PSW
  0259'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  025B'   FE 54                 	CPI	'T'
  025D'   C2 0262'              	JNZ	FNDR_GO
  0260'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0262'                         FNDR_GO:
  0262'   F1                    	POP	PSW
  0263'   C3 026D'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0266'                         FNDNIL:
  0266'   AF                    	XRA	A
  0267'   32 0000*              	STA	PSAVE
  026A'   C3 0871'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  026D'                         FNDGO:
  026D'   32 0000*              	STA	FNDRUN
  0270'   78                    	MOV	A,B
  0271'   32 0000*              	STA	FNDSTP
  0274'   CD 0789'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0277'   22 0000*              	SHLD	FNDN		; the occurrence wanted
  027A'   CD 0000*              	CALL	CUROFF
  027D'   22 0000*              	SHLD	FNDCUR
  0280'   3A 0000*              	LDA	FNDRUN
  0283'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  0285'   CA 02B9'              	JZ	FNDBWD
  0288'   2A 0000*              	LHLD	FNDCUR
  028B'   CD 073D'              	CALL	EOLC		; HL = the line's last content character
  028E'   22 0000*              	SHLD	FNDLIM
  0291'   2A 0000*              	LHLD	FNDCUR
  0294'   3A 0000*              	LDA	FNDSTP
  0297'   5F                    	MOV	E,A
  0298'   16 00                 	MVI	D,0
  029A'   19                    	DAD	D		; HL = where the scan starts
  029B'                         FNDF_LP:
  029B'   EB                    	XCHG			; DE = the scan
  029C'   2A 0000*              	LHLD	FNDLIM
  029F'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02A2'   EB                    	XCHG			; HL = the scan
  02A3'   CA 02A9'              	JZ	FNDF_AT		; the last character is still a candidate
  02A6'   D2 030B'              	JNC	FNDMIS		; past it: not on this line
  02A9'                         FNDF_AT:
  02A9'   CD 0312'              	CALL	FNDSEE		; Z iff this is the character
  02AC'   C2 02B5'              	JNZ	FNDF_NX
  02AF'   CD 031D'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02B2'   CA 02F1'              	JZ	FNDHIT
  02B5'                         FNDF_NX:
  02B5'   23                    	INX	H
  02B6'   C3 029B'              	JMP	FNDF_LP
  02B9'                         FNDBWD:
  02B9'   2A 0000*              	LHLD	FNDCUR
  02BC'   CD 0697'              	CALL	BOL		; HL = the line's first character
  02BF'   22 0000*              	SHLD	FNDLIM
  02C2'   2A 0000*              	LHLD	FNDCUR
  02C5'   3A 0000*              	LDA	FNDSTP
  02C8'   2F                    	CMA
  02C9'   5F                    	MOV	E,A
  02CA'   16 FF                 	MVI	D,0FFH
  02CC'   13                    	INX	D		; DE = -step
  02CD'   19                    	DAD	D		; HL = where the scan starts
  02CE'   D2 030B'              	JNC	FNDMIS		; ... off the front of the text altogether
  02D1'                         FNDB_LP:
  02D1'   EB                    	XCHG			; DE = the scan
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02D2'   2A 0000*              	LHLD	FNDLIM
  02D5'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02D8'   EB                    	XCHG			; HL = the scan
  02D9'   DA 030B'              	JC	FNDMIS		; before this line: not on it
  02DC'   CD 0312'              	CALL	FNDSEE
  02DF'   C2 02E8'              	JNZ	FNDB_NX
  02E2'   CD 031D'              	CALL	FNDCNT
  02E5'   CA 02F1'              	JZ	FNDHIT
  02E8'                         FNDB_NX:
  02E8'   7C                    	MOV	A,H
  02E9'   B5                    	ORA	L
  02EA'   CA 030B'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  02ED'   2B                    	DCX	H
  02EE'   C3 02D1'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  02F1'                         FNDHIT:
  02F1'   3A 0000*              	LDA	FNDRUN
  02F4'   E6 5F                 	ANI	5FH
  02F6'   FE 54                 	CPI	'T'
  02F8'   C2 0308'              	JNZ	FNDLND
  02FB'   3A 0000*              	LDA	FNDRUN
  02FE'   E6 20                 	ANI	20H
  0300'   CA 0307'              	JZ	FNDH_BW
  0303'   2B                    	DCX	H		; forward 't': the character before it
  0304'   C3 0308'              	JMP	FNDLND
  0307'                         FNDH_BW:
  0307'   23                    	INX	H		; backward 'T': the character after it
  0308'                         FNDLND:
  0308'   C3 062D'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  030B'                         FNDMIS:
  030B'   AF                    	XRA	A
  030C'   32 0000*              	STA	PSAVE
  030F'   C3 01DF'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0312'                         FNDSEE:
  0312'   E5                    	PUSH	H
  0313'   CD 0000*              	CALL	CHARAT
  0316'   E1                    	POP	H
  0317'   47                    	MOV	B,A
  0318'   3A 0000*              	LDA	FNDCH
  031B'   B8                    	CMP	B
  031C'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
                                ; the scan and stays it.
  031D'                         FNDCNT:
  031D'   E5                    	PUSH	H
  031E'   2A 0000*              	LHLD	FNDN
  0321'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


  0322'   22 0000*              	SHLD	FNDN
  0325'   7C                    	MOV	A,H
  0326'   B5                    	ORA	L
  0327'   E1                    	POP	H
  0328'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  0329'                         ISFIND:
  0329'   E6 5F                 	ANI	5FH		; fold the case away
  032B'   FE 46                 	CPI	'F'
  032D'   C8                    	RZ
  032E'   FE 54                 	CPI	'T'
  0330'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0331'                         VC_MK:
  0331'   3E 04                 	MVI	A,PM
  0333'   C3 033D'              	JMP	MKGO
  0336'                         VC_BQ:
  0336'   3E 05                 	MVI	A,PJ
  0338'   C3 033D'              	JMP	MKGO
  033B'                         VC_AQ:
  033B'   3E 06                 	MVI	A,PJL
  033D'                         MKGO:
  033D'   32 0000*              	STA	MKWHAT
  0340'   CD 0789'              	CALL	MOVCNT		; a count means nothing on any of the three
  0343'   CD 01FC'              	CALL	MKGETK		; the key that names the mark
  0346'   DA 0441'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out.  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist: 'm' with any other key
                                ;drops the whole thing, as vim's 'Z{other}' does, and a jump to one is a jump
                                ;to a mark that is not set.
  0349'                         MKOP:
  0349'   79                    	MOV	A,C
  034A'   D6 61                 	SUI	'a'
  034C'   FE 03                 	CPI	MKMAX
  034E'   D2 0439'              	JNC	MKNOLT		; not a mark letter
  0351'   4F                    	MOV	C,A		; C = the mark's index
  0352'   87                    	ADD	A
  0353'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0354'   5F                    	MOV	E,A
  0355'   16 00                 	MVI	D,0
  0357'   21 0000*              	LXI	H,MKTAB
  035A'   19                    	DAD	D		; HL -> this mark's slot
  035B'   3A 0000*              	LDA	MKWHAT
  035E'   FE 04                 	CPI	PM
  0360'   CA 0454'              	JZ	MKSET
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark, paging to it if the window has left it.
                                ;'Mark not set', as vim says it, when it was never set.
                                ;Under an OPERATOR a mark the window does not hold is refused with the bell
                                ;and stays set, all but "d'a": a line delete is the one operator that can take
                                ;a span the window does not hold whole (OPPGD), and going there only to be
                                ;turned away by it would page the file twice for nothing.
  0363'                         MKJMP:
  0363'   E5                    	PUSH	H
  0364'   CD 01E7'              	CALL	MKVAD
  0367'   7E                    	MOV	A,M
  0368'   E1                    	POP	H
  0369'   B7                    	ORA	A
  036A'   CA 042F'              	JZ	MKNSET		; never set
  036D'   CD 03FB'              	CALL	MKLOAD		; the file position it holds
  0370'   CD 0408'              	CALL	MKWIN
  0373'   DA 038A'              	JC	MKJ_GO		; in the window: any command may go there
  0376'   3A 0000*              	LDA	PSAVE
  0379'   B7                    	ORA	A
  037A'   CA 038A'              	JZ	MKJ_GO
  037D'   FE 64                 	CPI	'd'		; paged out, and an operator wants the span
  037F'   C2 0441'              	JNZ	MKBAD
  0382'   3A 0000*              	LDA	MKWHAT
  0385'   FE 06                 	CPI	PJL
  0387'   C2 0441'              	JNZ	MKBAD
  038A'                         MKJ_GO:
  038A'   CD 1405'              	CALL	GZONE		; the screen's top line, before the cursor
                                				;   moves: GPLACE measures the landing against
                                				;   it, and one left over from an earlier 'G'
                                				;   had it keep a window the line is not in
  038D'   CD 07C5'              	CALL	BRKON		; ... and an ESC may stop it from here on
  0390'   CD 03AC'              	CALL	MKPAGE		; HL = the mark's offset in the window
  0393'   CD 0802'              	CALL	BRKOFF		; (A only)
  0396'   DA 081A'              	JC	BRKBAK
  0399'   3A 0000*              	LDA	MKWHAT
  039C'   FE 06                 	CPI	PJL
  039E'   CA 03A6'              	JZ	MKJ_LN		; ''': GPKEEP is 0, so GPLACE finds the first
  03A1'   3E 01                 	MVI	A,1		;   non-blank
  03A3'   32 0000*              	STA	GPKEEP		; '`': land on the column it was set at
  03A6'                         MKJ_LN:
  03A6'   CD 0000*              	CALL	GOTO
  03A9'   C3 141D'              	JMP	GPLACE		; (which sets LNDLT itself)
                                
                                ;MKPAGE -- page until MKPOS is in the window: HL = its logical offset there.
                                ;The loop is WM's own whole-file line move (MVLMAX: GOLINE to the window's
                                ;edge, SCRLST to page one step), stopped by where the window is instead of by
                                ;the count.  A step cannot carry the window past the mark: the pager evicts
                                ;only behind the cursor, and the cursor is on the edge nearer the mark.
                                ;A mark less than half as far down as the window's top, on a file not changed
                                ;since it was opened or written, is read again from the file's start instead
                                ;(MKFAR, #34 part B).
  03AC'                         MKPAGE:
  03AC'   CD 0408'              	CALL	MKWIN
  03AF'   DA 0000*              	JC	CLRCNT		; there: and the count that paged is spent,
                                				;   not left for the next command to take
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


  03B2'   C4 03D6'              	CNZ	MKFAR		; above the window (A = FFH, NZ)
  03B5'   32 0000*              	STA	DIRFLG
  03B8'   21 FFFF               	LXI	H,0FFFFH
  03BB'   22 0000*              	SHLD	CMDCNT
  03BE'   CD 0000*              	CALL	GOLINE
  03C1'   CD 0000*              	CALL	SCRLST
  03C4'   CD 07B1'              	CALL	CNTTST
  03C7'   C2 03AC'              	JNZ	MKPAGE
  03CA'   CD 0408'              	CALL	MKWIN		; the file ran out: that was its last step
  03CD'   DA 0000*              	JC	CLRCNT
  03D0'   21 FFFF               	LXI	H,0FFFFH	; the very end of the text, which MKWIN does not
  03D3'   C3 0000*              	JMP	CLRCNT		;   count as in the window: GOTO clamps it
                                
                                ;MKFAR -- the mark is above the window: if PGJUMP starts the file again from
                                ;its record 0, look for the mark again from there; if not, A = FFH, page back.
  03D6'                         MKFAR:
  03D6'   2A 0000*              	LHLD	MKPOS
  03D9'   29                    	DAD	H		; CY = bit 15
  03DA'   3A 0002*              	LDA	MKPOS+2
  03DD'   17                    	RAL
  03DE'   6C                    	MOV	L,H
  03DF'   67                    	MOV	H,A		; HL = the mark's record
  03E0'   EB                    	XCHG
  03E1'   2A 0000*              	LHLD	OUTPOS
  03E4'   EB                    	XCHG			; DE = the window's top's
  03E5'   CD 0000*              	CALL	PGJUMP
  03E8'   3E FF                 	MVI	A,0FFH
  03EA'   D0                    	RNC
  03EB'   E1                    	POP	H		; (MKPAGE's return)
  03EC'   C3 03AC'              	JMP	MKPAGE
                                
                                ;BACKTO -- back to the 3-byte file position at HL, paging to it: where a
                                ;command that came to nothing started.  The place has to be kept as a file
                                ;position -- a sweep of the whole file leaves the window at the far end of
                                ;it, and an offset into the window it started in means nothing there.
  03EF'                         BACKTO:
  03EF'   CD 03FB'              	CALL	MKLOAD
  03F2'   CD 0000*              	CALL	CLRCNT
  03F5'   CD 03AC'              	CALL	MKPAGE
  03F8'   C3 0000*              	JMP	GOTO
                                
                                ;MKLOAD -- MKPOS = the 3-byte file position at HL.
  03FB'                         MKLOAD:
  03FB'   5E                    	MOV	E,M
  03FC'   23                    	INX	H
  03FD'   56                    	MOV	D,M
  03FE'   23                    	INX	H
  03FF'   7E                    	MOV	A,M
  0400'   EB                    	XCHG
  0401'   22 0000*              	SHLD	MKPOS
  0404'   32 0002*              	STA	MKPOS+2
  0407'   C9                    	RET
                                
                                ;MKWIN -- CY and HL = MKPOS as a logical offset if the window holds it; NC and
                                ;A = the way to page for it, as DIRFLG has it (0 forward, FFH back), if not.
  0408'                         MKWIN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0408'   2A 0000*              	LHLD	TXTBEG
  040B'   CD 13BF'              	CALL	FPOS
  040E'   EB                    	XCHG
  040F'   47                    	MOV	B,A		; B:DE = the window's first byte
  0410'   2A 0000*              	LHLD	MKPOS
  0413'   3A 0002*              	LDA	MKPOS+2
  0416'   CD 13B2'              	CALL	SUB24		; A:HL = the mark, from the window's top
  0419'   DA 042B'              	JC	MKW_BK		; above it
  041C'   C2 0429'              	JNZ	MKW_FW		; 64K or more below it
  041F'   E5                    	PUSH	H
  0420'   CD 0000*              	CALL	LOGLEN
  0423'   D1                    	POP	D
  0424'   CD 0000*              	CALL	CMP16		; DE = the offset vs HL = the window's length
  0427'   EB                    	XCHG
  0428'   D8                    	RC			; inside
  0429'                         MKW_FW:
  0429'   AF                    	XRA	A
  042A'   C9                    	RET
  042B'                         MKW_BK:
  042B'   3E FF                 	MVI	A,0FFH
  042D'   B7                    	ORA	A
  042E'   C9                    	RET
                                
                                ;MKNSET -- a jump to a mark that will not answer: vim's E20 on the bottom row
                                ;(without the number, and without a bell, as every message here), the cursor
                                ;and the screen left alone.  The operator is cancelled as MKBAD cancels it.
  042F'                         MKNSET:
  042F'   AF                    	XRA	A
  0430'   32 0000*              	STA	PSAVE
  0433'   21 2986'              	LXI	H,SMKNS
  0436'   C3 284B'              	JMP	EXERR
  0439'                         MKNOLT:
  0439'   3A 0000*              	LDA	MKWHAT
  043C'   FE 04                 	CPI	PM
  043E'   C2 042F'              	JNZ	MKNSET		; a jump: that mark is not set
                                				; 'm{other}': fall into MKBAD
                                
                                ;MKBAD -- no mark was named: 'm' with a key that is not a mark letter, ESC in
                                ;place of the letter, or a '.' replay that ran out.  The bell, and an operator
                                ;running the motion is cancelled whole: PSAVE is what OPPEND's tail reads to
                                ;decide whether to open an insert, so clearing it stops a "c`z" opening one
                                ;over a span of nothing.
  0441'                         MKBAD:
  0441'   AF                    	XRA	A
  0442'   32 0000*              	STA	PSAVE
  0445'   C3 01DF'              	JMP	DOTBEL
                                
                                ;FPSTO -- the cursor's file position into the 3 bytes at HL.  Keeps BC.
  0448'                         FPSTO:
  0448'   E5                    	PUSH	H
  0449'   CD 13BC'              	CALL	CURFP		; A:HL = the cursor's file position
  044C'   EB                    	XCHG
  044D'   E1                    	POP	H
  044E'   73                    	MOV	M,E
  044F'   23                    	INX	H
  0450'   72                    	MOV	M,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0451'   23                    	INX	H
  0452'   77                    	MOV	M,A
  0453'   C9                    	RET
                                
                                ;MKSET -- remember where in the FILE the cursor is.
  0454'                         MKSET:
  0454'   CD 0448'              	CALL	FPSTO
  0457'   CD 01E7'              	CALL	MKVAD
  045A'   36 01                 	MVI	M,1		; ... and the mark is live
  045C'   C3 0871'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKSNAP -- keep the marks as they stand, for 'u' (MKREST).  Each copy's spare
                                ;fourth byte takes that mark's live flag.  HL and BC are kept.
  045F'                         MKSNAP:
  045F'   C5                    	PUSH	B
  0460'   E5                    	PUSH	H
  0461'   21 0000*              	LXI	H,MKTAB
  0464'   11 0000*              	LXI	D,MKUND
  0467'   CD 266E'              	CALL	COPY12
  046A'   21 0000*              	LXI	H,MKVAL
  046D'   11 0003*              	LXI	D,MKUND+MKSIZ-1
  0470'   06 03                 	MVI	B,MKMAX
  0472'                         MSN_LP:
  0472'   7E                    	MOV	A,M
  0473'   12                    	STAX	D
  0474'   23                    	INX	H
  0475'   13                    	INX	D
  0476'   13                    	INX	D
  0477'   13                    	INX	D
  0478'   13                    	INX	D
  0479'   05                    	DCR	B
  047A'   C2 0472'              	JNZ	MSN_LP
  047D'   E1                    	POP	H
  047E'   C1                    	POP	B
  047F'   C9                    	RET
                                
                                ;MKREST -- a change has been undone: every mark that was set when it began
                                ;goes back where it was then, whether the change ran over it or 'm' has moved
                                ;it since (vim keeps them with the undo too).  One first set AFTER the change
                                ;is left where the replay's own edits carried it.
  0480'                         MKREST:
  0480'   0E 02                 	MVI	C,MKMAX-1
  0482'                         MRS_LP:
  0482'   79                    	MOV	A,C
  0483'   87                    	ADD	A
  0484'   87                    	ADD	A
  0485'   5F                    	MOV	E,A
  0486'   16 00                 	MVI	D,0
  0488'   21 0003*              	LXI	H,MKUND+MKSIZ-1
  048B'   19                    	DAD	D
  048C'   7E                    	MOV	A,M
  048D'   B7                    	ORA	A
  048E'   CA 04AA'              	JZ	MRS_NX		; it was not set then
  0491'   2B                    	DCX	H
  0492'   2B                    	DCX	H
  0493'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  0494'   E5                    	PUSH	H
  0495'   21 0000*              	LXI	H,MKTAB
  0498'   19                    	DAD	D
  0499'   EB                    	XCHG			; DE -> the mark
  049A'   E1                    	POP	H		; HL -> its copy
  049B'   06 03                 	MVI	B,MKSIZ-1
  049D'                         MRS_CP:
  049D'   7E                    	MOV	A,M
  049E'   12                    	STAX	D
  049F'   23                    	INX	H
  04A0'   13                    	INX	D
  04A1'   05                    	DCR	B
  04A2'   C2 049D'              	JNZ	MRS_CP
  04A5'   CD 01E7'              	CALL	MKVAD
  04A8'   36 01                 	MVI	M,1
  04AA'                         MRS_NX:
  04AA'   0D                    	DCR	C
  04AB'   F2 0482'              	JP	MRS_LP
  04AE'   C9                    	RET
                                
                                ;MKSHFT -- the text is changing: every mark follows its own text.  BUF.MAC's
                                ;UNDCHG calls this through EDTHK from all six edit primitives -- 'u's replay
                                ;of them included -- with A = 1 for an insert (the text is in) or 2 for a
                                ;delete (it is about to go), HL = the edit's logical offset and BC = its
                                ;length.  A mark before the edit stays; one after it moves by the length; one
                                ;INSIDE a delete closes up to where the delete was.  An insert AT a mark
                                ;leaves the mark in front of the new text, unless that text ends a line -- a
                                ;line opened or put above the mark's is above the mark too.
                                ;The edit is found from the CURSOR's file position less its distance behind
                                ;the cursor, never from the offset alone: a put bigger than the window pages
                                ;its own start out, and that offset has then wrapped.  BC is kept.
  04AF'                         MKSHFT:
  04AF'   32 0000*              	STA	MKTYP
  04B2'   3A 0000*              	LDA	MKHOLD		; a yank that could not copy takes its lines out
  04B5'   B7                    	ORA	A		;   and puts them back unchanged (YKGO): the text
  04B6'   C0                    	RNZ			;   every mark points into is still there
  04B7'   3A 0000*              	LDA	UNDRPL
  04BA'   B7                    	ORA	A
  04BB'   C2 04C5'              	JNZ	MKS_GO		; 'u' replaying: not a new change
  04BE'   3A 0000*              	LDA	UNDNEW		; the first edit of a new change (UNDCHG calls
  04C1'   B7                    	ORA	A		;   here BEFORE it claims the change): the marks
  04C2'   C4 045F'              	CNZ	MKSNAP		;   as they are now are the ones 'u' puts back
  04C5'                         MKS_GO:
  04C5'   C5                    	PUSH	B
  04C6'   50                    	MOV	D,B
  04C7'   59                    	MOV	E,C
  04C8'   EB                    	XCHG
  04C9'   22 0000*              	SHLD	MKN		; the edit's length
  04CC'   D5                    	PUSH	D		; ... and its offset
  04CD'   CD 0000*              	CALL	CUROFF
  04D0'   D1                    	POP	D
  04D1'   CD 0000*              	CALL	SUBHD
  04D4'   EB                    	XCHG			; DE = how far behind the cursor it is
  04D5'   CD 13BC'              	CALL	CURFP		; A:HL = the cursor's file position
  04D8'   06 00                 	MVI	B,0
  04DA'   CD 13B2'              	CALL	SUB24
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04DD'   22 0000*              	SHLD	MKEDIT
  04E0'   32 0002*              	STA	MKEDIT+2	; where in the file the edit is
  04E3'   21 0000*              	LXI	H,MKVAL
  04E6'   11 0000*              	LXI	D,MKTAB
  04E9'   06 03                 	MVI	B,MKMAX
  04EB'                         MKS_LP:
  04EB'   7E                    	MOV	A,M
  04EC'   B7                    	ORA	A
  04ED'   CA 0559'              	JZ	MKS_N0		; that mark is not set
  04F0'   E5                    	PUSH	H
  04F1'   C5                    	PUSH	B
  04F2'   21 0000*              	LXI	H,MKEDIT
  04F5'   1A                    	LDAX	D		; the mark's position less the edit's, a byte
  04F6'   96                    	SUB	M		;   at a time (neither INX nor LDAX touch CY)
  04F7'   4F                    	MOV	C,A
  04F8'   13                    	INX	D
  04F9'   23                    	INX	H
  04FA'   1A                    	LDAX	D
  04FB'   9E                    	SBB	M
  04FC'   47                    	MOV	B,A
  04FD'   13                    	INX	D
  04FE'   23                    	INX	H
  04FF'   1A                    	LDAX	D
  0500'   9E                    	SBB	M		; A:BC = how far past the edit the mark is
  0501'   DA 0554'              	JC	MKS_PP		; before it: nothing moves
  0504'   6F                    	MOV	L,A
  0505'   3A 0000*              	LDA	MKTYP
  0508'   3D                    	DCR	A
  0509'   CA 052E'              	JZ	MKS_IN
                                	;--- a delete: back by its length, or to it if the mark is inside ---
  050C'   7D                    	MOV	A,L
  050D'   2A 0000*              	LHLD	MKN
  0510'   B7                    	ORA	A
  0511'   C2 051D'              	JNZ	MKS_DL		; 64K or more past it
  0514'   79                    	MOV	A,C
  0515'   95                    	SUB	L
  0516'   78                    	MOV	A,B
  0517'   9C                    	SBB	H
  0518'   D2 051D'              	JNC	MKS_DL		; past the end of what goes
  051B'   60                    	MOV	H,B
  051C'   69                    	MOV	L,C		; inside it: close up to the edit
  051D'                         MKS_DL:
  051D'   1B                    	DCX	D
  051E'   1B                    	DCX	D
  051F'   1A                    	LDAX	D
  0520'   95                    	SUB	L
  0521'   12                    	STAX	D
  0522'   13                    	INX	D
  0523'   1A                    	LDAX	D
  0524'   9C                    	SBB	H
  0525'   12                    	STAX	D
  0526'   13                    	INX	D
  0527'   1A                    	LDAX	D
  0528'   DE 00                 	SBI	0
  052A'   12                    	STAX	D
  052B'   C3 0554'              	JMP	MKS_PP
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


                                	;--- an insert: on by its length ---
  052E'                         MKS_IN:
  052E'   7D                    	MOV	A,L
  052F'   B0                    	ORA	B
  0530'   B1                    	ORA	C
  0531'   C2 0543'              	JNZ	MKS_AD		; the mark is past it
  0534'   2A 0000*              	LHLD	GAPBEG		; AT the mark: only a line end carries it on
  0537'   2B                    	DCX	H
  0538'   7E                    	MOV	A,M		; the last byte that went in
  0539'   FE 0A                 	CPI	LF
  053B'   CA 0543'              	JZ	MKS_AD
  053E'   FE 0D                 	CPI	CR
  0540'   C2 0554'              	JNZ	MKS_PP
  0543'                         MKS_AD:
  0543'   2A 0000*              	LHLD	MKN
  0546'   1B                    	DCX	D
  0547'   1B                    	DCX	D
  0548'   1A                    	LDAX	D
  0549'   85                    	ADD	L
  054A'   12                    	STAX	D
  054B'   13                    	INX	D
  054C'   1A                    	LDAX	D
  054D'   8C                    	ADC	H
  054E'   12                    	STAX	D
  054F'   13                    	INX	D
  0550'   1A                    	LDAX	D
  0551'   CE 00                 	ACI	0
  0553'   12                    	STAX	D
  0554'                         MKS_PP:
  0554'   C1                    	POP	B
  0555'   E1                    	POP	H
  0556'   C3 055B'              	JMP	MKS_NX
  0559'                         MKS_N0:
  0559'   13                    	INX	D
  055A'   13                    	INX	D
  055B'                         MKS_NX:
  055B'   13                    	INX	D
  055C'   13                    	INX	D
  055D'   23                    	INX	H
  055E'   05                    	DCR	B
  055F'   C2 04EB'              	JNZ	MKS_LP
  0562'   C1                    	POP	B
  0563'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  0564'                         VC_UNDO:
  0564'   21 0000               	LXI	H,0
  0567'   22 0000*              	SHLD	CMDCNT
  056A'   CD 0000*              	CALL	UNDO
  056D'   DA 05FA'              	JC	UNDNO
  0570'   3A 0000*              	LDA	UNDST
  0573'   FE 02                 	CPI	2
  0575'   CC 0480'              	CZ	MKREST		; undone (not redone): the marks go back too
  0578'   2A 0000*              	LHLD	UNDCUR
  057B'   CD 05E0'              	CALL	UCLAMP		; vi never sits on a line terminator
  057E'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0581'   3E 01                 	MVI	A,1
  0583'   32 0000*              	STA	MODF		; undone past a ':w' still differs from the file
  0586'   CD 0A29'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  0589'   3A 0000*              	LDA	UNDML		; every step on one line, no line end among
  058C'   B7                    	ORA	A		;   them, and the cursor back on that line:
  058D'   C2 05A5'              	JNZ	VU_LNS		;   the line is the repaint -- all of it, the
  0590'   2A 0000*              	LHLD	UNDL0		;   cursor need not be where the change began.
  0593'   EB                    	XCHG			;   Anything else, and whole spans moved:
  0594'   2A 0000*              	LHLD	LNDLT		;   repaint rather than guess
  0597'   CD 0000*              	CALL	CMP16
  059A'   C2 08AE'              	JNZ	SETFUL
  059D'   3E 01                 	MVI	A,1
  059F'   32 0000*              	STA	LNALL
  05A2'   C3 0877'              	JMP	SETLIN
                                
                                ;VU_LNS -- more than a line changed.  Whole lines put back, the cursor on the
                                ; first of them, are rows opened there as a put opens them (R_ILIN; SCDRAW
                                ; wants them at the line the cursor was on or right under it).  One whole
                                ; line taken from under the cursor is 'dd' (R_DLIN), whether the next comes
                                ; up into its place or the cursor goes to the line over it.  Anything else
                                ; is the screen.
  05A5'                         VU_LNS:
  05A5'   CD 08AE'              	CALL	SETFUL
  05A8'   3A 0000*              	LDA	UNDLC
  05AB'   B7                    	ORA	A
  05AC'   C8                    	RZ
  05AD'   47                    	MOV	B,A
  05AE'   2A 0000*              	LHLD	UNDLL0
  05B1'   EB                    	XCHG
  05B2'   2A 0000*              	LHLD	LNDLT		; DE = where the lines start, HL = the cursor
  05B5'   3A 0000*              	LDA	UNDLK
  05B8'   FE 01                 	CPI	1
  05BA'   CA 05D4'              	JZ	VU_IN
  05BD'   FE 02                 	CPI	2
  05BF'   C0                    	RNZ
  05C0'   05                    	DCR	B
  05C1'   C0                    	RNZ
  05C2'   7A                    	MOV	A,D
  05C3'   B3                    	ORA	E
  05C4'   C0                    	RNZ			; (not the line the cursor was on)
  05C5'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C6'   B5                    	ORA	L
  05C7'   CA 05CE'              	JZ	VU_DL
  05CA'   23                    	INX	H		; ... or the cursor went onto the line over it:
  05CB'   7C                    	MOV	A,H		;   a line put under the cursor's, or opened
  05CC'   B5                    	ORA	L		;   there, and taken back
  05CD'   C0                    	RNZ
  05CE'                         VU_DL:
  05CE'   3E 03                 	MVI	A,R_DLIN
  05D0'   32 0000*              	STA	RINTENT
  05D3'   C9                    	RET
  05D4'                         VU_IN:
  05D4'   CD 0000*              	CALL	CMP16
  05D7'   C0                    	RNZ
  05D8'   CD 0899'              	CALL	SETILN
  05DB'   78                    	MOV	A,B
  05DC'   32 31ED'              	STA	ILN
  05DF'   C9                    	RET
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  05E0'                         UCLAMP:
  05E0'   E5                    	PUSH	H
  05E1'   CD 1A00'              	CALL	CEND		; HL = the line's content end
  05E4'   D1                    	POP	D		; DE = the offset wanted
  05E5'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  05E8'   D2 05ED'              	JNC	UCL_BK
  05EB'   EB                    	XCHG
  05EC'   C9                    	RET
  05ED'                         UCL_BK:
  05ED'   E5                    	PUSH	H		; the content end
  05EE'   EB                    	XCHG			; HL = the offset wanted
  05EF'   CD 0697'              	CALL	BOL
  05F2'   D1                    	POP	D		; DE = the content end, HL = the line's start
  05F3'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  05F6'   EB                    	XCHG			; HL = the content end
  05F7'   C8                    	RZ
  05F8'   2B                    	DCX	H		; ... its last character
  05F9'   C9                    	RET
  05FA'                         UNDNO:
  05FA'   3A 0000*              	LDA	UNDWHY
  05FD'   B7                    	ORA	A
  05FE'   CA 060F'              	JZ	UNDBEL
  0601'   21 2920'              	LXI	H,SUNDW		; the change has paged away: say so
  0604'   FE 01                 	CPI	1
  0606'   CA 284B'              	JZ	EXERR
  0609'   21 2942'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  060C'   C3 284B'              	JMP	EXERR
  060F'                         UNDBEL:
  060F'   0E 07                 	MVI	C,BEL
  0611'   CD 0000*              	CALL	BCONOU
  0614'   C3 0871'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0617'                         DOTGET:
  0617'   3A 0000*              	LDA	DOTIX
