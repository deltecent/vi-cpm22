  2480'   0D18'                 	DW	VC_PGUP
  2482'   04                    	DB	04H			; ^D -- half page down
  2483'   0D6C'                 	DW	VC_HFDN
  2485'   15                    	DB	15H			; ^U -- half page up
  2486'   0DA0'                 	DW	VC_HFUP
  2488'   0C                    	DB	0CH			; ^L -- redraw
  2489'   0E14'                 	DW	VC_REDR
  248B'   2E                    	DB	'.'			; '.' -- repeat the last change
  248C'   0191'                 	DW	VC_DOT
  248E'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  248F'   04E8'                 	DW	VC_UNDO
  2491'   6D                    	DB	'm'		; m{a-c} -- set a mark
  2492'   0350'                 	DW	VC_MK
  2494'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  2495'   0355'                 	DW	VC_BQ
  2497'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  2498'   035A'                 	DW	VC_AQ
  249A'   00                    	DB	0
                                
  249B'                         ACTTAB:
  249B'   04                    	DB	ACT_CURLT
  249C'   072C'                 	DW	VC_H
  249E'   03                    	DB	ACT_CURRT
  249F'   0756'                 	DW	VC_L
  24A1'   02                    	DB	ACT_CURDN
  24A2'   081B'                 	DW	VC_J
  24A4'   01                    	DB	ACT_CURUP
  24A5'   082A'                 	DW	VC_K
  24A7'   05                    	DB	ACT_LINST
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  24A8'   077D'                 	DW	VC_0
  24AA'   06                    	DB	ACT_LINEN
  24AB'   07D9'                 	DW	VC_EOL
  24AD'   07                    	DB	ACT_PGUP
  24AE'   0D18'                 	DW	VC_PGUP
  24B0'   08                    	DB	ACT_PGDN
  24B1'   0CEB'                 	DW	VC_PGDN
  24B3'   00                    	DB	0
                                
                                ;============================================================
                                ; DATA
                                ;============================================================
  24B4'   00                    EDMODE: DB	EM_CMD
  24B5'   0000                  CMDCNT: DW	0		; count prefix (0 = none)
  24B7'   00                    QUITF:	DB	0		; set 1 by :q / :wq
  24B8'   00                    MODF:	DB	0		; 1 = unsaved changes
  24B9'   00                    RINTENT:DB	R_FULL		; render intent for the last key (SCRN.MAC reads)
  24BA'   01                    ILN:	DB	1		; lines an R_ILIN paint opens (SCRN.MAC reads)
  24BB'   00                    ICHAPP:	DB	0		; 1 = the R_ICH char went at the row's end, so
                                				;   nothing follows it to shift: no ICH needed
  24BC'   00                    ILABOV:	DB	0		; 1 = the row above an R_ILIN's opened rows lost
                                				;   text to them and must be redrawn too
  24BD'   FFFE                  GOALCOL:DW	0FFFEH		; sticky goal screen column for j/k (0FFFFH = EOL, 0FFFEH = stale)
  24BF'   00                    WBIG:	DB	0		; word motion: 0 = w/b/e, 1 = W/B/E
  24C0'   00                    WPULL:	DB	0		; w/W ended off a line's end and was pulled back
  24C1'   00                    HFROW:	DB	0		; ^D/^U: the cursor's row before the move
  24C2'   00                    HFAMT:	DB	0		; ^D/^U: lines (vim's 'scroll'); 0 = NEDIT/2
  24C3'   0000                  JKCNT:	DW	0		; j/k: count
  24C5'   0000                  JKN:	DW	0		; j/k: lines scanned for (min(count, limit))
  24C7'   0000                  JKMOV:	DW	0		; j: lines moved
  24C9'   0000                  JKBK:	DW	0		; k: scan position, bytes back from GAPBEG
  24CB'   00                    JKPHN:	DB	0		; j: 1 = moved may be one less (last LF ends the file)
  24CC'   00                    JKLST:	DB	0		; j: last byte of the scan
  24CD'   0000                  JKVC:	DW	0		; j/k landing: screen column
  24CF'   0000                  JKLS:	DW	0		; j/k landing: last content char (0FFFFH = none)
  0001                          PG	EQU	1		; pending-prefix codes held in GPEND/GSAVE
  0002                          PZ	EQU	2
  0003                          PR	EQU	3		;   ('r', whose next key is its operand)
  0004                          PM	EQU	4		; which of 'm' / '`' / ''' is running (MKWHAT, not
  0005                          PJ	EQU	5		;   GPEND: each reads its own mark letter, so none
  0006                          PJL	EQU	6		;   of them leaves anything pending)
                                ;--- '.' (repeat): see the '.' section above for how these are driven.
  24D1'   00                    DOTCHG: DB	0		; 1 = the command being typed changed the text
  24D2'   01                    DOTSTA: DB	1		; 1 = the next key starts a new recording
  24D3'   00                    DOTRPL: DB	0		; 1 = '.' is replaying, so nothing is recorded
  24D4'   00                    DOTOVF: DB	0		; 1 = the change outgrew the scratch
  24D5'   00                    DOTLK:	DB	0		; the last key recorded, encoded
  24D6'   0000*                 DOTSP:	DW	DOTSCR		; the scratch's write pointer
  24D8'   00                    DOTLEN: DB	0		; keys in DOTBUF (0 = nothing to repeat)
  24D9'   00                    DOTIX:	DB	0		; the replay's read index into DOTBUF
  24DA'   0000                  DOTNCT: DW	0		; the count typed on the '.' (0 = none)
                                
  24DC'   00                    GPEND:	DB	0		; pending 'g' / 'Z' / 'r' (gg / ZZ / r{char})
  24DD'   00                    GSAVE:	DB	0		; the pending snapshot for the current command
  24DE'   00                    PENDOP: DB	0		; pending operator ('d' for dd)
  24DF'   00                    PSAVE:	DB	0		; pending-op snapshot for the current command
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  24E0'   00                    DDSNG:	DB	0		; 1 = the current dd deletes a single line (DL paint)
  24E1'   00                    OPCLSV: DB	0		; operator: motion class (0 excl, 1 incl, 2 linewise,
                                				;   3 excl but a jump -- no end-of-line clamp)
  24E2'   00                    CWEOL:	DB	0		; operator: the motion is 'cw' rewritten to 'ce',
                                				;   so it stops at the line's content end
  24E3'   0000                  OPSTA:	DW	0		; operator: span start (cursor before the motion)
  24E5'   0000                  OPEND2: DW	0		; operator: span end (cursor after the motion)
  24E7'   0000                  OPLO:	DW	0		; operator: low offset of the delete range
  24E9'   0000                  OPHI:	DW	0		; operator: high offset of the delete range
                                
  24EB'   0000                  CNTV:	DW	0		; motion repeat counter
  24ED'   0000                  TTI:	DW	0		; TAILTAB scan index
  24EF'   0000                  WKI:	DW	0		; scan index
  24F1'   0000                  WKN:	DW	0		; cached LOGLEN
  24F3'   0000                  WKTERM: DW	0		; line terminator offset
  24F5'   0000                  WKBOL:	DW	0		; EOLC scratch: line BOL
  24F7'   00                    WKCLS:	DB	0		; word motion: class of the current run
  24F8'   00                    VRCH:	DB	0		; 'r' / R: the char being stored
  24F9'   0000                  RPDEL:	DW	0		; R: chars overwritten, still in the gap (BS puts back)
  24FB'   0000                  RPAPP:	DW	0		; R: chars appended past the line end (BS deletes)
  24FD'   0000                  RPGE:	DW	0		; R: GAPEND as the last overwrite left it
                                
                                
  24FF'   0000                  RLPTR:	DW	0		; RDLINE: write pointer
  2501'   00                    RLLEN:	DB	0		; RDLINE: chars stored
  2502'   00                    RLMAX:	DB	0		; RDLINE: capacity
  2503'   00                    EXOP:	DB	0		; ex: the command (EO_xx)
  2504'   00                    EXARG:	DB	0		; ex: 0 = no file name given
  2505'   00                    EXBAK:	DB	0		; ex: the write keeps a backup
  2506'   0000                  EXCMD:	DW	0		; ex: text shown after a message
  2508'   00                    WPROW:	DB	0		; :w -- the cursor's row
  2509'   00                    WPBYT:	DB	0		; :w -- the cursor's byte in its record
  250A'   0000                  WPREC:	DW	0		; :w -- the cursor's record in the file
  250C'   0000                  ZDIF:	DW	0		; G/gg: target - top (low 16 bits)
  250E'   00                    ZLF:	DB	0		; G/gg: lines from the target up to the top
  250F'   0000                  ZSVCNT: DW	0		; G/gg: CMDCNT around LINPSB
  2511'   0000                  ZSVAUX: DW	0		; G/gg: AUXCNT around LINPSB
  2513'   00                    ZSVDIR: DB	0		; G/gg: DIRFLG around LINPSB
  2514'   00                    MSGWHT: DB	0		; the message the bottom row still owes (MW_xxx)
  2515'   00                    MSGNEW: DB	0		; the file was not there when it was opened ('[New]')
  2516'   00                    EXBANG: DB	0		; ex: 0 = '!' given
  2517'   00                    ROFLAG: DB	0		; command line: '-R' / '/R' was given
  2518'   00                    PLUSF:	DB	0		; command line: '+' was given
  2519'   00                    YMODF:	DB	0		; yy: MODF across the delete + put back
  251A'   00                    YDCHG:	DB	0		; yy: DOTCHG across it too (see '.')
  251B'   00                    YURPL:	DB	0		; yy: UNDRPL across it too (see 'u')
  251C'   0000                  YOFF:	DW	0		; yy: the cursor, which a yank leaves alone
  251E'   0000                  YPT:	DW	0		; yy: where the lines came from
  2520'   0000                  PCNT:	DW	0		; p/P: copies still to put
  2522'   0000                  PPT:	DW	0		; p/P: the first line put
  2524'   0000                  PLFS:	DW	0		; p/P: the lines in the register
  2526'   00                    PCPY:	DB	0		; p/P: the copies, kept for the paint
  2527'   0000                  YLDLT:	DW	0		; yy: LNDLT across the delete + put back
                                
  2529'   00                    SDIR:	DB	0		; the last '/' or '?' direction (FFH = back)
  252A'   00                    SDIRE:	DB	0		; ... the direction THIS search runs in ('N')
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  252B'   00                    SHAVE:	DB	0		; nonzero once a pattern has been entered
  252C'   00                    FNDKND: DB	0		; f/F/t/T: which find ';' repeats (0 = none yet)
  252D'   00                    FNDCH:	DB	0		; ... and the character it looked for
  252E'   00                    FNDRUN: DB	0		; the find THIS command is running (',' reverses)
  252F'   00                    FNDSTP: DB	0		; how far along it starts: 2 for a 't' repeat
  2530'   0000                  FNDN:	DW	0		; occurrences still to count off
  2532'   0000                  FNDCUR: DW	0		; the cursor it started from
  2534'   0000                  FNDLIM: DW	0		; ... and the end of the line it may not pass
  2536'   00                    GPKEEP: DB	0		; GPLACE: keep the column (a search) not FNBLNK
  2537'   00 00 00              MKVAL:	DB	0,0,0		; marks: nonzero once 'm' has set that one.  It
                                				;   lives HERE and not in MKTAB because the image
                                				;   guarantees a DB, and nothing guarantees a DS
  253A'   00 00 00              MKEDIT: DB	0,0,0		; MKSHFT: where in the file the edit is
  253D'   0000                  MKN:	DW	0		; ... how long it is
  253F'   00                    MKTYP:	DB	0		; ... and which way: 1 text went in, 2 came out
  2540'   00 00 00              MKPOS:	DB	0,0,0		; MKJMP: the file position being jumped to
  2543'   00                    MKWHAT: DB	0		; which of 'm' / '`' / ''' is running
  2544'   00                    MKHOLD: DB	0		; set across YKGO's delete + put back (a yank
                                				;   that could not copy): MKSHFT must leave the
                                				;   marks alone through it
  2545'   0000                  YACT:	DW	0		; how this yank takes its lines (VD_DD / YSPAN)
  2547'   0000                  YTGT:	DW	0		; YSPAN: the text's length once the span is out
  2549'   0000                  YWAS:	DW	0		; ... and its length BEFORE the lines came out
  254B'   0000                  YCOL:	DW	0		; ... how far into them the cursor sat
  254D'   0000                  YBLK:	DW	0		; ... and where they ended when they came back
                                ;--- the yank that copies instead (YNCOPY / YNSPAN) ---
  254F'   0000                  YNPG:	DW	0		; the window the yank started in (YNDONE's paint)
  2551'   0000                  YNCNT:	DW	0		; YNLINE: the lines it still wants
  2553'   0000                  SCNT:	DW	0		; searches still to do (the count)
  2555'   0000                  SOFF:	DW	0		; where the cursor was when the search began
  2557'   0000                  SLDLT:	DW	0		; ... and LNDLT, for the search that fails
  2559'   00                    SSKIP:	DB	0		; skip the character under the cursor (not
                                				;   on the wrapped pass)
                                
  0024                          SREPMX	EQU	EXMAX-4		; ':s' -- bounded by the ex line itself, so
                                				;   SCOPY can never truncate a line anyone is
                                				;   able to type: the shortest possible
                                				;   substitute is 's' '/' + one pattern char +
                                				;   '/' before the replacement starts, and
                                				;   RDLINE stores at most EXMAX.  Tied to
                                				;   EXMAX rather than written out, the way
                                				;   BUF.MAC ties SRCMAX to SRMAX, so the two
                                				;   cannot drift apart.
  255A'   00                    SRNGF:	DB	0		; ex: a line range was given
  255B'   0000                  SRNG1:	DW	0		; ex: its first line
  255D'   0000                  SRNG2:	DW	0		; ... and its last (FFFFH = the file's last)
  255F'   00                    SDELIM: DB	0		; ':s' the delimiter typed
  2560'   00                    SGFLAG: DB	0		; ':s' the 'g' flag
  2561'   00                    SANY:	DB	0		; ':s' something in the range has changed
  2562'   00                    SLCHG:	DB	0		; ':s' this line changed
  2563'   0000                  SBACK:	DW	0		; ':s' lines walked past the last change
  2565'   0000                  SLINES: DW	0		; ':s' lines of the range still to do
  2567'   0000                  SOFFS:	DW	0		; ':s' the cursor, for a substitute that
  2569'   0000                  SLDLTS: DW	0		;   changes nothing, and its LNDLT
  256B'   00                    SREPLN: DB	0		; ':s' the replacement's length, kept
  256C'                         SREPL:	DS	SREPMX+1	;   just below it: WM's RDSTR layout,
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


                                				;   so INSSTR can splice it
                                
                                	END
