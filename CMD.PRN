  295F'   20 66 75 6C           
  2963'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  2965'                         EXTAB:
  2965'   77 00 01              	DB	'w',0,EO_W
  2968'   71 00 02              	DB	'q',0,EO_Q
  296B'   77 71 03              	DB	'w','q',EO_WQ
  296E'   78 00 04              	DB	'x',0,EO_X
  2971'   65 00 05              	DB	'e',0,EO_E
  2974'   73 00 06              	DB	's',0,EO_S
  2977'   76 65 07              	DB	'v','e',EO_V
  297A'   72 00 08              	DB	'r',0,EO_R
  297D'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- are cut from BUF.MAC:
                                ; RDLINE drops control characters, so no pattern could ever hold one.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
	MACRO-80 3.44	09-Dec-81	PAGE	1-128


                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  297E'                         EXADDR:
  297E'   AF                    	XRA	A
  297F'   32 0000*              	STA	SRNGF
  2982'   7E                    	MOV	A,M
  2983'   FE 25                 	CPI	'%'
  2985'   CA 29AE'              	JZ	EXA_AL
	MACRO-80 3.44	09-Dec-81	PAGE	1-129


  2988'   EB                    	XCHG			; DE walks the line, HL takes the number
  2989'   CD 29C3'              	CALL	EXNUM
  298C'   DA 29AC'              	JC	EXA_NO
  298F'   22 0000*              	SHLD	SRNG1
  2992'   22 0000*              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  2995'   1A                    	LDAX	D
  2996'   FE 2C                 	CPI	','
  2998'   C2 29A5'              	JNZ	EXA_YS
  299B'   13                    	INX	D
  299C'   CD 29C3'              	CALL	EXNUM
  299F'   DA 29AC'              	JC	EXA_NO		; ',' with no number: not a range at all
  29A2'   22 0000*              	SHLD	SRNG2
  29A5'                         EXA_YS:
  29A5'   EB                    	XCHG
  29A6'   3E 01                 	MVI	A,1
  29A8'   32 0000*              	STA	SRNGF
  29AB'   C9                    	RET
  29AC'                         EXA_NO:
  29AC'   EB                    	XCHG
  29AD'   C9                    	RET
  29AE'                         EXA_AL:
  29AE'   23                    	INX	H
  29AF'   E5                    	PUSH	H
  29B0'   21 0001               	LXI	H,1
  29B3'   22 0000*              	SHLD	SRNG1
  29B6'   21 FFFF               	LXI	H,0FFFFH
  29B9'   22 0000*              	SHLD	SRNG2
  29BC'   E1                    	POP	H
  29BD'   3E 01                 	MVI	A,1
  29BF'   32 0000*              	STA	SRNGF
  29C2'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  29C3'                         EXNUM:
  29C3'   1A                    	LDAX	D
  29C4'   D6 30                 	SUI	'0'
  29C6'   D8                    	RC
  29C7'   FE 0A                 	CPI	10
  29C9'   3F                    	CMC
  29CA'   D8                    	RC
  29CB'   21 0000               	LXI	H,0
  29CE'                         EXN_LP:
  29CE'   1A                    	LDAX	D
  29CF'   D6 30                 	SUI	'0'
  29D1'   DA 29EB'              	JC	EXN_DN
  29D4'   FE 0A                 	CPI	10
  29D6'   D2 29EB'              	JNC	EXN_DN
  29D9'   13                    	INX	D
  29DA'   C5                    	PUSH	B
  29DB'   4F                    	MOV	C,A
  29DC'   06 00                 	MVI	B,0		; BC = the digit
  29DE'   D5                    	PUSH	D
  29DF'   54                    	MOV	D,H
  29E0'   5D                    	MOV	E,L
  29E1'   29                    	DAD	H		; *2
	MACRO-80 3.44	09-Dec-81	PAGE	1-130


  29E2'   29                    	DAD	H		; *4
  29E3'   19                    	DAD	D		; *5
  29E4'   29                    	DAD	H		; *10
  29E5'   D1                    	POP	D
  29E6'   09                    	DAD	B
  29E7'   C1                    	POP	B
  29E8'   C3 29CE'              	JMP	EXN_LP
  29EB'                         EXN_DN:
  29EB'   B7                    	ORA	A		; CY clear: there was a number
  29EC'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  29ED'                         EX_S:
  29ED'   7E                    	MOV	A,M
  29EE'   B7                    	ORA	A
  29EF'   CA 2A31'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  29F2'   32 0000*              	STA	SDELIM
  29F5'   23                    	INX	H
  29F6'   11 0000*              	LXI	D,SRCHST
  29F9'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  29FC'   4F                    	MOV	C,A
  29FD'   CD 2A37'              	CALL	SCOPY
  2A00'   78                    	MOV	A,B
  2A01'   B7                    	ORA	A
  2A02'   CA 2A31'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  2A05'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  2A08'   3E 01                 	MVI	A,1
  2A0A'   32 0000*              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2A0D'   11 0000*              	LXI	D,SREPL
  2A10'   0E 24                 	MVI	C,SREPMX
  2A12'   CD 2A37'              	CALL	SCOPY
  2A15'   78                    	MOV	A,B
  2A16'   32 0000*              	STA	SREPLN
  2A19'   AF                    	XRA	A
  2A1A'   32 0000*              	STA	SGFLAG
  2A1D'   7E                    	MOV	A,M
  2A1E'   FE 67                 	CPI	'g'
  2A20'   C2 2A29'              	JNZ	EX_SG
  2A23'   23                    	INX	H
  2A24'   3E 01                 	MVI	A,1
  2A26'   32 0000*              	STA	SGFLAG
  2A29'                         EX_SG:
  2A29'   7E                    	MOV	A,M
  2A2A'   B7                    	ORA	A
  2A2B'   C2 27B8'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2A2E'   C3 2A57'              	JMP	SUBGO
  2A31'                         SUBNOP:
  2A31'   21 2880'              	LXI	H,SNOPAT
  2A34'   C3 27C6'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  2A37'                         SCOPY:
  2A37'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-131


  2A39'                         SCP_LP:
  2A39'   78                    	MOV	A,B
  2A3A'   B9                    	CMP	C
  2A3B'   D2 2A54'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  2A3E'   7E                    	MOV	A,M
  2A3F'   B7                    	ORA	A
  2A40'   CA 2A54'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  2A43'   E5                    	PUSH	H
  2A44'   21 0000*              	LXI	H,SDELIM
  2A47'   BE                    	CMP	M
  2A48'   E1                    	POP	H
  2A49'   CA 2A53'              	JZ	SCP_SK
  2A4C'   12                    	STAX	D
  2A4D'   13                    	INX	D
  2A4E'   23                    	INX	H
  2A4F'   04                    	INR	B
  2A50'   C3 2A39'              	JMP	SCP_LP
  2A53'                         SCP_SK:
  2A53'   23                    	INX	H
  2A54'                         SCP_DN:
  2A54'   AF                    	XRA	A
  2A55'   12                    	STAX	D
  2A56'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  2A57'                         SUBGO:
  2A57'   CD 13D1'              	CALL	GZONE
  2A5A'   2A 0000*              	LHLD	LNDLT
  2A5D'   22 0000*              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  2A60'   21 0000*              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  2A63'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  2A66'   AF                    	XRA	A
  2A67'   32 0000*              	STA	SANY
  2A6A'   21 0000               	LXI	H,0
  2A6D'   22 0000*              	SHLD	SBACK
  2A70'   3A 0000*              	LDA	SRNGF
  2A73'   B7                    	ORA	A
  2A74'   CA 2A86'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  2A77'   CD 2346'              	CALL	EXRNG		; SLINES = the lines in the range
  2A7A'   DA 2B02'              	JC	SUBBAD
  2A7D'   2A 0000*              	LHLD	SRNG1
  2A80'   CD 133F'              	CALL	GOLN
  2A83'   C3 2A8C'              	JMP	SUBLP
  2A86'                         SUB_1L:
  2A86'   21 0001               	LXI	H,1
  2A89'   22 0000*              	SHLD	SLINES
  2A8C'                         SUBLP:
  2A8C'   CD 2B08'              	CALL	SUBLIN		; A = 1 when this line changed
  2A8F'   B7                    	ORA	A
  2A90'   CA 2A9E'              	JZ	SUB_NX
  2A93'   3E 01                 	MVI	A,1
  2A95'   32 0000*              	STA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-132


  2A98'   21 0000               	LXI	H,0
  2A9B'   22 0000*              	SHLD	SBACK		; the cursor is ON the last line changed
  2A9E'                         SUB_NX:
  2A9E'   2A 0000*              	LHLD	SLINES
  2AA1'   2B                    	DCX	H
  2AA2'   22 0000*              	SHLD	SLINES
  2AA5'   7C                    	MOV	A,H
  2AA6'   B5                    	ORA	L
  2AA7'   CA 2AC5'              	JZ	SUBDON		; the range is spent
  2AAA'   21 0001               	LXI	H,1
  2AAD'   AF                    	XRA	A
  2AAE'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2AB1'   3A 0000*              	LDA	SANY
  2AB4'   B7                    	ORA	A
  2AB5'   CA 2ABF'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  2AB8'   2A 0000*              	LHLD	SBACK
  2ABB'   23                    	INX	H
  2ABC'   22 0000*              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  2ABF'                         SUB_AE:
  2ABF'   CD 0BDB'              	CALL	ATEOF
  2AC2'   D2 2A8C'              	JNC	SUBLP		; ... unless that ran off the end of the file
  2AC5'                         SUBDON:
  2AC5'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  2AC8'   3A 0000*              	LDA	SANY
  2ACB'   B7                    	ORA	A
  2ACC'   CA 2AEA'              	JZ	SUBNFD
  2ACF'   3E 01                 	MVI	A,1
  2AD1'   32 0000*              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2AD4'   2A 0000*              	LHLD	SBACK
  2AD7'   7C                    	MOV	A,H
  2AD8'   B5                    	ORA	L
  2AD9'   CA 2AE4'              	JZ	SUB_PL
  2ADC'   3E FF                 	MVI	A,0FFH
  2ADE'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2AE1'   CD 0000*              	CALL	CLRCNT
  2AE4'                         SUB_PL:
  2AE4'   CD 13E9'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  2AE7'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  2AEA'                         SUBNFD:
  2AEA'   21 0000*              	LXI	H,SOFFS
  2AED'   CD 03D0'              	CALL	BACKTO
  2AF0'   2A 0000*              	LHLD	SLDLTS
	MACRO-80 3.44	09-Dec-81	PAGE	1-133


  2AF3'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  2AF6'   21 2850'              	LXI	H,SNOTFD
  2AF9'   CD 27C6'              	CALL	EXERR
  2AFC'   21 0000*              	LXI	H,SRCHST
  2AFF'   C3 27C1'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2B02'                         SUBBAD:
  2B02'   21 283E'              	LXI	H,SNOT
  2B05'   C3 27BB'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  2B08'                         SUBLIN:
  2B08'   AF                    	XRA	A
  2B09'   32 0000*              	STA	SLCHG
  2B0C'   CD 2B87'              	CALL	SUBBOL
  2B0F'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  2B12'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2B12'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  2B15'   DA 2B1D'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2B18'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2B1A'   C2 2B12'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2B1D'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2B1D'   CD 0000*              	CALL	CUROFF
  2B20'   E5                    	PUSH	H
  2B21'   CD 19CC'              	CALL	CEND
  2B24'   D1                    	POP	D
  2B25'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2B28'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2B29'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2B2C'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2B2D'   B7                    	ORA	A		;   span is a line, not a pair.)
  2B2E'   FA 2B80'              	JM	SUBL_D		; what is left is shorter than the pattern
  2B31'   44                    	MOV	B,H
  2B32'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2B33'   11 0000*              	LXI	D,SRCHST
  2B36'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2B39'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2B3C'   DA 2B80'              	JC	SUBL_D
  2B3F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  2B42'   EB                    	XCHG
  2B43'   2A 0000*              	LHLD	GAPEND
  2B46'   EB                    	XCHG
  2B47'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2B4A'   EB                    	XCHG
  2B4B'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2B4C'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2B4F'   D1                    	POP	D
  2B50'   19                    	DAD	D		; ... and so the match's logical offset
	MACRO-80 3.44	09-Dec-81	PAGE	1-134


  2B51'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  2B54'   3A 0000*              	LDA	SANY
  2B57'   B7                    	ORA	A
  2B58'   C2 2B65'              	JNZ	SUBL_C
  2B5B'   3A 0000*              	LDA	SLCHG
  2B5E'   B7                    	ORA	A
  2B5F'   C2 2B65'              	JNZ	SUBL_C
  2B62'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  2B65'                         SUBL_C:
  2B65'   3A 0000*              	LDA	SRCHBF
  2B68'   6F                    	MOV	L,A
  2B69'   26 00                 	MVI	H,0
  2B6B'   CD 0000*              	CALL	DELFWD		; the match goes
  2B6E'   11 0000*              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  2B71'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  2B74'                         SUBL_I:
  2B74'   3E 01                 	MVI	A,1
  2B76'   32 0000*              	STA	SLCHG
  2B79'   3A 0000*              	LDA	SGFLAG
  2B7C'   B7                    	ORA	A
  2B7D'   C2 2B1D'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  2B80'                         SUBL_D:
  2B80'   CD 2B87'              	CALL	SUBBOL
  2B83'   3A 0000*              	LDA	SLCHG
  2B86'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2B87'                         SUBBOL:
  2B87'   CD 0000*              	CALL	CUROFF
  2B8A'   CD 0678'              	CALL	BOL
  2B8D'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  2B90'                         VC_SRCH:
  2B90'   CD 0852'              	CALL	SETMOV
  2B93'   C5                    	PUSH	B
  2B94'   CD 077D'              	CALL	GETCNT
  2B97'   22 0000*              	SHLD	SCNT
  2B9A'   C1                    	POP	B
  2B9B'   79                    	MOV	A,C
  2B9C'   FE 2F                 	CPI	'/'
  2B9E'   3E 00                 	MVI	A,0
  2BA0'   CA 2BA5'              	JZ	VS_DIR
  2BA3'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  2BA5'                         VS_DIR:
  2BA5'   32 0000*              	STA	SDIR
  2BA8'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2BAB'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2BAE'   47                    	MOV	B,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-135


  2BAF'   CD 20EA'              	CALL	RDLINE
  2BB2'   B7                    	ORA	A
  2BB3'   C0                    	RNZ			; cancelled: nothing happens at all
  2BB4'   3A 0000*              	LDA	RLLEN
  2BB7'   B7                    	ORA	A
  2BB8'   CA 2BCD'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2BBB'   5F                    	MOV	E,A
  2BBC'   16 00                 	MVI	D,0
  2BBE'   21 0000*              	LXI	H,SRCHST
  2BC1'   19                    	DAD	D
  2BC2'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2BC4'   7B                    	MOV	A,E
  2BC5'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  2BC8'   3E 01                 	MVI	A,1
  2BCA'   32 0000*              	STA	SHAVE
  2BCD'                         VS_OLD:
  2BCD'   3A 0000*              	LDA	SHAVE
  2BD0'   B7                    	ORA	A
  2BD1'   CA 2BDD'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  2BD4'   3A 0000*              	LDA	SDIR
  2BD7'   32 0000*              	STA	SDIRE
  2BDA'   C3 2C06'              	JMP	SRCHN
  2BDD'                         VS_NOP:
  2BDD'   21 2880'              	LXI	H,SNOPAT
  2BE0'   C3 27C6'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2BE3'                         VC_N:
  2BE3'   CD 0852'              	CALL	SETMOV
  2BE6'   3A 0000*              	LDA	SDIR
  2BE9'   C3 2BF3'              	JMP	VN_GO
  2BEC'                         VCB_N:
  2BEC'   CD 0852'              	CALL	SETMOV
  2BEF'   3A 0000*              	LDA	SDIR
  2BF2'   2F                    	CMA			; the other way: 0 <-> FFH
  2BF3'                         VN_GO:
  2BF3'   32 0000*              	STA	SDIRE
  2BF6'   CD 077D'              	CALL	GETCNT
  2BF9'   22 0000*              	SHLD	SCNT
  2BFC'   3A 0000*              	LDA	SHAVE
  2BFF'   B7                    	ORA	A
  2C00'   CA 2BDD'              	JZ	VS_NOP
  2C03'   C3 2C06'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  2C06'                         SRCHN:
  2C06'   CD 13D1'              	CALL	GZONE		; the screen's top line, before the cursor moves
  2C09'   CD 07A6'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2C0C'                         SN_LP:
  2C0C'   CD 2C41'              	CALL	SRCHGO
  2C0F'   DA 2C2C'              	JC	SN_BAD
	MACRO-80 3.44	09-Dec-81	PAGE	1-136


  2C12'   2A 0000*              	LHLD	SCNT
  2C15'   2B                    	DCX	H
  2C16'   22 0000*              	SHLD	SCNT
  2C19'   7C                    	MOV	A,H
  2C1A'   B5                    	ORA	L
  2C1B'   C2 2C0C'              	JNZ	SN_LP
  2C1E'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2C21'   CD 07E3'              	CALL	BRKOFF
  2C24'   3E 01                 	MVI	A,1
  2C26'   32 0000*              	STA	GPKEEP		; land on the match, not the first non-blank
  2C29'   C3 13E9'              	JMP	GPLACE		; (which sets LNDLT itself)
  2C2C'                         SN_BAD:
  2C2C'   CD 07E3'              	CALL	BRKOFF
  2C2F'   DA 07FB'              	JC	BRKBAK		; stopped, which is not the same as not found
  2C32'   CD 07EE'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  2C35'   21 2850'              	LXI	H,SNOTFD
  2C38'   CD 27C6'              	CALL	EXERR
  2C3B'   21 0000*              	LXI	H,SRCHST
  2C3E'   C3 27C1'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2C41'                         SRCHGO:
  2C41'   3E 01                 	MVI	A,1
  2C43'   32 0000*              	STA	SSKIP		; this pass starts one past the cursor
  2C46'   CD 2C5C'              	CALL	SRCHW
  2C49'   D0                    	RNC
  2C4A'   CD 07E7'              	CALL	BRKQ
  2C4D'   D8                    	RC			; stopped: no second pass
  2C4E'   3A 0000*              	LDA	SDIRE
  2C51'   2F                    	CMA
  2C52'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2C55'   AF                    	XRA	A
  2C56'   32 0000*              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  2C59'   C3 2C5C'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  2C5C'                         SRCHW:
  2C5C'   3A 0000*              	LDA	SDIRE
  2C5F'   32 0000*              	STA	DIRFLG
  2C62'   21 FFFF               	LXI	H,0FFFFH
  2C65'   22 0000*              	SHLD	CMDCNT
  2C68'   AF                    	XRA	A
  2C69'   32 0000*              	STA	AUXCNT
  2C6C'                         SW_LP:
	MACRO-80 3.44	09-Dec-81	PAGE	1-137


  2C6C'   CD 07E7'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  2C6F'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  2C70'   CD 2C7C'              	CALL	SRCH1
  2C73'   D0                    	RNC
  2C74'   CD 0000*              	CALL	SCRLST
  2C77'   D2 2C6C'              	JNC	SW_LP
  2C7A'   37                    	STC
  2C7B'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  2C7C'                         SRCH1:
  2C7C'   11 0000*              	LXI	D,SRCHST
  2C7F'   3A 0000*              	LDA	DIRFLG
  2C82'   B7                    	ORA	A
  2C83'   FA 2CA7'              	JM	SR1_BK
  2C86'   21 0000*              	LXI	H,GAPEND
  2C89'   CD 0000*              	CALL	FWDCNT
  2C8C'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  2C8F'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  2C90'   3A 0000*              	LDA	SSKIP
  2C93'   B7                    	ORA	A
  2C94'   CA 2C9D'              	JZ	SR1_FW
  2C97'   78                    	MOV	A,B
  2C98'   B1                    	ORA	C
  2C99'   37                    	STC
  2C9A'   C8                    	RZ			; no room for a match even before the skip
  2C9B'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2C9C'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2C9D'                         SR1_FW:
  2C9D'   CD 0000*              	CALL	MATCHF
  2CA0'   D8                    	RC
  2CA1'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2CA4'   C3 0000*              	JMP	PUTCUR
  2CA7'                         SR1_BK:
  2CA7'   21 0000*              	LXI	H,TXTBEG
  2CAA'   CD 0000*              	CALL	FWDCNT
  2CAD'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2CB0'   D8                    	RC
  2CB1'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2CB4'   CD 0000*              	CALL	MATCHB
  2CB7'   D8                    	RC
  2CB8'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
	MACRO-80 3.44	09-Dec-81	PAGE	1-138


                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2CBB'                         MSGNAM:
  2CBB'   E5                    	PUSH	H
  2CBC'   3E 22                 	MVI	A,'"'
  2CBE'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2CC1'   E1                    	POP	H
  2CC2'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2CC3'   23                    	INX	H
  2CC4'   7E                    	MOV	A,M
  2CC5'   FE 20                 	CPI	' '
  2CC7'   C2 2CD4'              	JNZ	MN_HAS
  2CCA'   21 28EE'              	LXI	H,SNONM
  2CCD'   CD 0000*              	CALL	OUTSTR
  2CD0'   E1                    	POP	H
  2CD1'   C3 2D1E'              	JMP	MN_END
  2CD4'                         MN_HAS:
  2CD4'   0E 19                 	MVI	C,BF_CURDSK
  2CD6'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  2CD9'   E1                    	POP	H
  2CDA'   E5                    	PUSH	H
  2CDB'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2CDC'   BE                    	CMP	M
  2CDD'   CA 2CEB'              	JZ	MN_NAM
  2CE0'   7E                    	MOV	A,M
  2CE1'   C6 40                 	ADI	'A'-1
  2CE3'   CD 0000*              	CALL	OUTCH
  2CE6'   3E 3A                 	MVI	A,':'
  2CE8'   CD 0000*              	CALL	OUTCH
  2CEB'                         MN_NAM:
  2CEB'   E1                    	POP	H
  2CEC'   E5                    	PUSH	H
  2CED'   23                    	INX	H
  2CEE'   0E 08                 	MVI	C,8
  2CF0'                         MN_NM:
  2CF0'   7E                    	MOV	A,M
  2CF1'   FE 20                 	CPI	' '
  2CF3'   CA 2CFE'              	JZ	MN_EXT
  2CF6'   CD 0000*              	CALL	OUTCH
  2CF9'   23                    	INX	H
  2CFA'   0D                    	DCR	C
  2CFB'   C2 2CF0'              	JNZ	MN_NM
  2CFE'                         MN_EXT:
  2CFE'   E1                    	POP	H
  2CFF'   11 0009               	LXI	D,9
	MACRO-80 3.44	09-Dec-81	PAGE	1-139


  2D02'   19                    	DAD	D		; the type field
  2D03'   7E                    	MOV	A,M
  2D04'   FE 20                 	CPI	' '
  2D06'   CA 2D1E'              	JZ	MN_END
  2D09'   3E 2E                 	MVI	A,'.'
  2D0B'   CD 0000*              	CALL	OUTCH
  2D0E'   0E 03                 	MVI	C,3
  2D10'                         MN_XL:
  2D10'   7E                    	MOV	A,M
  2D11'   FE 20                 	CPI	' '
  2D13'   CA 2D1E'              	JZ	MN_END
  2D16'   CD 0000*              	CALL	OUTCH
  2D19'   23                    	INX	H
  2D1A'   0D                    	DCR	C
  2D1B'   C2 2D10'              	JNZ	MN_XL
  2D1E'                         MN_END:
  2D1E'   3E 22                 	MVI	A,'"'
  2D20'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2D23'                         MSGFLG:
  2D23'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2D25'   B7                    	ORA	A
  2D26'   CA 2D36'              	JZ	MF_RO
  2D29'   3A 0000*              	LDA	MODF
  2D2C'   B7                    	ORA	A
  2D2D'   CA 2D36'              	JZ	MF_RO
  2D30'   21 28F8'              	LXI	H,SMODM
  2D33'   CD 2D4B'              	CALL	MF_PUT
  2D36'                         MF_RO:
  2D36'   3A 0000*              	LDA	ROFLAG
  2D39'   B7                    	ORA	A
  2D3A'   CA 2D43'              	JZ	MF_NEW
  2D3D'   21 2903'              	LXI	H,SROM
  2D40'   CD 2D4B'              	CALL	MF_PUT
  2D43'                         MF_NEW:
  2D43'   3A 0000*              	LDA	MSGNEW
  2D46'   B7                    	ORA	A
  2D47'   C8                    	RZ
  2D48'   21 290E'              	LXI	H,SNEWM
  2D4B'                         MF_PUT:
  2D4B'   78                    	MOV	A,B
  2D4C'   B7                    	ORA	A
  2D4D'   C2 2D59'              	JNZ	MF_STR
  2D50'   06 01                 	MVI	B,1
  2D52'   E5                    	PUSH	H
  2D53'   3E 20                 	MVI	A,' '
  2D55'   CD 0000*              	CALL	OUTCH
  2D58'   E1                    	POP	H
  2D59'                         MF_STR:
  2D59'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
	MACRO-80 3.44	09-Dec-81	PAGE	1-140


                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  2D5C'                         EMITW:
  2D5C'   C5                    	PUSH	B
  2D5D'   D5                    	PUSH	D
  2D5E'   06 00                 	MVI	B,0
  2D60'   11 2710               	LXI	D,10000
  2D63'   CD 2D81'              	CALL	EWDIG
  2D66'   11 03E8               	LXI	D,1000
  2D69'   CD 2D81'              	CALL	EWDIG
  2D6C'   11 0064               	LXI	D,100
  2D6F'   CD 2D81'              	CALL	EWDIG
  2D72'   11 000A               	LXI	D,10
  2D75'   CD 2D81'              	CALL	EWDIG
  2D78'   7D                    	MOV	A,L		; the units digit is always printed
  2D79'   C6 30                 	ADI	'0'
  2D7B'   CD 0000*              	CALL	OUTCH
  2D7E'   D1                    	POP	D
  2D7F'   C1                    	POP	B
  2D80'   C9                    	RET
  2D81'                         EWDIG:
  2D81'   0E 00                 	MVI	C,0
  2D83'                         EW_LP:
  2D83'   7D                    	MOV	A,L
  2D84'   93                    	SUB	E
  2D85'   6F                    	MOV	L,A
  2D86'   7C                    	MOV	A,H
  2D87'   9A                    	SBB	D
  2D88'   67                    	MOV	H,A
  2D89'   DA 2D90'              	JC	EW_DN
  2D8C'   0C                    	INR	C
  2D8D'   C3 2D83'              	JMP	EW_LP
  2D90'                         EW_DN:
  2D90'   19                    	DAD	D		; one subtraction too many: give it back
  2D91'   79                    	MOV	A,C
  2D92'   B7                    	ORA	A
  2D93'   C2 2D99'              	JNZ	EW_PR
  2D96'   78                    	MOV	A,B
  2D97'   B7                    	ORA	A
  2D98'   C8                    	RZ			; a leading zero: write nothing
  2D99'                         EW_PR:
  2D99'   79                    	MOV	A,C
  2D9A'   C6 30                 	ADI	'0'
  2D9C'   CD 0000*              	CALL	OUTCH
  2D9F'   06 01                 	MVI	B,1
  2DA1'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2DA2'                         ISEMPT:
  2DA2'   2A 0000*              	LHLD	OUTPOS
  2DA5'   7C                    	MOV	A,H
  2DA6'   B5                    	ORA	L
  2DA7'   C0                    	RNZ
  2DA8'   CD 0000*              	CALL	LOGLEN
  2DAB'   7C                    	MOV	A,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-141


  2DAC'   B5                    	ORA	L
  2DAD'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2DAE'                         MSGCTG:
  2DAE'   21 0000*              	LXI	H,FNAME
  2DB1'   CD 2CBB'              	CALL	MSGNAM
  2DB4'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  2DB6'   CD 2D23'              	CALL	MSGFLG
  2DB9'   CD 2DA2'              	CALL	ISEMPT
  2DBC'   C2 2DC5'              	JNZ	MG_POS
  2DBF'   21 2921'              	LXI	H,SNOLIN
  2DC2'   C3 0000*              	JMP	OUTSTR
  2DC5'                         MG_POS:
  2DC5'   21 2914'              	LXI	H,SLINE
  2DC8'   CD 0000*              	CALL	OUTSTR
  2DCB'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  2DCE'   23                    	INX	H		;   ... so the line it is on
  2DCF'   CD 2D5C'              	CALL	EMITW
  2DD2'   21 291B'              	LXI	H,SCOLM
  2DD5'   CD 0000*              	CALL	OUTSTR
  2DD8'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2DDB'   23                    	INX	H
  2DDC'   E5                    	PUSH	H
  2DDD'   CD 2D5C'              	CALL	EMITW
  2DE0'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2DE3'   23                    	INX	H
  2DE4'   D1                    	POP	D
  2DE5'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  2DE8'   C8                    	RZ
  2DE9'   E5                    	PUSH	H
  2DEA'   3E 2D                 	MVI	A,'-'
  2DEC'   CD 0000*              	CALL	OUTCH
  2DEF'   E1                    	POP	H
  2DF0'   C3 2D5C'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2DF3'                         FILMSG:
  2DF3'   3A 0001*              	LDA	FNAME+1
  2DF6'   FE 20                 	CPI	' '
  2DF8'   C8                    	RZ
  2DF9'   21 0000*              	LXI	H,FNAME
  2DFC'   CD 2CBB'              	CALL	MSGNAM
  2DFF'   AF                    	XRA	A		; nothing has been changed yet
  2E00'   C3 2D23'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2E03'                         WRMSG:
  2E03'   21 0000*              	LXI	H,TFCB
	MACRO-80 3.44	09-Dec-81	PAGE	1-142


  2E06'   CD 2CBB'              	CALL	MSGNAM
  2E09'   21 2933'              	LXI	H,SWRIT
  2E0C'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2E0F'                         MSGPST:
  2E0F'   3A 0000*              	LDA	MSGWHT
  2E12'   B7                    	ORA	A
  2E13'   C8                    	RZ
  2E14'   47                    	MOV	B,A
  2E15'   AF                    	XRA	A
  2E16'   32 0000*              	STA	MSGWHT
  2E19'   78                    	MOV	A,B
  2E1A'   FE 01                 	CPI	MW_FIL
  2E1C'   CA 2E38'              	JZ	MP_FIL
  2E1F'   FE 02                 	CPI	MW_WRT
  2E21'   CA 2E3E'              	JZ	MP_WRT
  2E24'   FE 04                 	CPI	MW_BIG
  2E26'   CA 2E2F'              	JZ	MP_BIG
  2E29'   CD 2DAE'              	CALL	MSGCTG
  2E2C'   C3 0000*              	JMP	SCURS
  2E2F'                         MP_BIG:
  2E2F'   21 28CF'              	LXI	H,SQBIG
  2E32'   CD 0000*              	CALL	EXMSG
  2E35'   C3 0000*              	JMP	SCURS
  2E38'                         MP_FIL:
  2E38'   CD 2DF3'              	CALL	FILMSG
  2E3B'   C3 0000*              	JMP	SCURS
  2E3E'                         MP_WRT:
  2E3E'   CD 2E03'              	CALL	WRMSG
  2E41'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2E44'                         VC_CTLG:
  2E44'   3E 03                 	MVI	A,MW_CTG
  2E46'   32 0000*              	STA	MSGWHT
  2E49'   3E 01                 	MVI	A,R_MOVE
  2E4B'   32 0000*              	STA	RINTENT
  2E4E'   C3 077D'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
  2E51'                         CMDTAB:
  2E51'   07                    	DB	07H			; ^G -- where am I?
  2E52'   2E44'                 	DW	VC_CTLG
