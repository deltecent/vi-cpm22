  08B0'   CD 0000*              	CALL	SUBHD
  08B3'   22 0000*              	SHLD	LNDLT
  08B6'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  08B7'                         ATEOF:
  08B7'   CD 0000*              	CALL	RGET0
  08BA'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  08BD'                         LASTLN:
  08BD'   2A 0000*              	LHLD	GAPBEG
  08C0'   EB                    	XCHG
  08C1'   2A 0000*              	LHLD	TXTBEG
  08C4'   CD 0000*              	CALL	CMP16
  08C7'   21 0000               	LXI	H,0
  08CA'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  08CD'   1B                    	DCX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  08CE'   1A                    	LDAX	D
  08CF'   FE 0A                 	CPI	LF
  08D1'   C2 0000*              	JNZ	SETBWD
  08D4'   23                    	INX	H
  08D5'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  08D8'                         JKLAND:
  08D8'   21 0000               	LXI	H,0
  08DB'   22 23FA'              	SHLD	JKVC		; screen column
  08DE'   2B                    	DCX	H
  08DF'   22 23FC'              	SHLD	JKLS		; last content char: none yet
  08E2'   CD 0000*              	CALL	RGET0
  08E5'   11 0000               	LXI	D,0		; DE = chars read
  08E8'                         JL_RD:
  08E8'   CD 0000*              	CALL	RDGET
  08EB'   DA 0925'              	JC	JL_END
  08EE'   FE 0A                 	CPI	LF
  08F0'   CA 0925'              	JZ	JL_END
  08F3'   E5                    	PUSH	H
  08F4'   C5                    	PUSH	B
  08F5'   2A 23FA'              	LHLD	JKVC
  08F8'   CD 04E6'              	CALL	CWID
  08FB'   B7                    	ORA	A
  08FC'   CA 091F'              	JZ	JL_NX		; a CR
  08FF'   EB                    	XCHG
  0900'   22 23FC'              	SHLD	JKLS		; the last content char so far
  0903'   EB                    	XCHG
  0904'   4F                    	MOV	C,A
  0905'   06 00                 	MVI	B,0
  0907'   09                    	DAD	B		; HL = the column after this char
  0908'   22 23FA'              	SHLD	JKVC
  090B'   D5                    	PUSH	D
  090C'   EB                    	XCHG
  090D'   2A 23EA'              	LHLD	GOALCOL
