  27DF'                         CPYNM0:
  27DF'   23                    	INX	H
  27E0'                         CPYNAM:
  27E0'   CD 27FE'              	CALL	GETFNC
  27E3'   CA 27F3'              	JZ	PADFLD
  27E6'   12                    	STAX	D
  27E7'   13                    	INX	D
  27E8'   0D                    	DCR	C
  27E9'   C2 27E0'              	JNZ	CPYNAM
