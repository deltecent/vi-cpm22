  092B'   C2 092F'              	JNZ	JL_LS
  092E'   23                    	INX	H		; no content: the line's start
  092F'                         JL_LS:
  092F'   EB                    	XCHG
  0930'                         JL_GO:
  0930'   D5                    	PUSH	D		; DE = step from the line start
  0931'   CD 0000*              	CALL	CUROFF
  0934'   D1                    	POP	D
  0935'   19                    	DAD	D
  0936'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0939'   AF                    VC_W:	XRA	A
  093A'   32 23EC'              	STA	WBIG
  093D'   C3 0945'              	JMP	WDO
  0940'   3E 01                 VCBGW:	MVI	A,1
  0942'   32 23EC'              	STA	WBIG
  0945'   CD 060D'              WDO:	CALL	SETMOV
  0948'   AF                    	XRA	A
  0949'   32 23ED'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  094C'   CD 05A0'              	CALL	GETCNT
  094F'   22 2418'              	SHLD	CNTV
  0952'   2A 2418'              WDO_LP: LHLD	CNTV
  0955'   7C                    	MOV	A,H
  0956'   B5                    	ORA	L
  0957'   CA 0964'              	JZ	WDO_DN
  095A'   2B                    	DCX	H
  095B'   22 2418'              	SHLD	CNTV
  095E'   CD 09B4'              	CALL	FWD1
  0961'   D2 0952'              	JNC	WDO_LP
  0964'                         WDO_DN:
  0964'   CD 08B7'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0967'   DA 0974'              	JC	WDO_NL
  096A'   FE 0D                 	CPI	CR
  096C'   CA 0974'              	JZ	WDO_NL
  096F'   FE 0A                 	CPI	LF
  0971'   C2 0492'              	JNZ	SETGL
  0974'                         WDO_NL:
  0974'   CD 0000*              	CALL	PEEKL
  0977'   DA 0492'              	JC	SETGL
  097A'   FE 0A                 	CPI	LF
  097C'   CA 0492'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  097F'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0981'   32 23ED'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0984'   CD 0AAF'              	CALL	DECC		; back onto its last char
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  0987'   C3 0492'              	JMP	SETGL
                                
  098A'   AF                    VC_B:	XRA	A
  098B'   32 23EC'              	STA	WBIG
  098E'   C3 0996'              	JMP	BDO
  0991'   3E 01                 VCBGB:	MVI	A,1
  0993'   32 23EC'              	STA	WBIG
  0996'   CD 060D'              BDO:	CALL	SETMOV
  0999'   CD 05A0'              	CALL	GETCNT
  099C'   22 2418'              	SHLD	CNTV
  099F'   2A 2418'              BDO_LP: LHLD	CNTV
  09A2'   7C                    	MOV	A,H
  09A3'   B5                    	ORA	L
  09A4'   CA 0492'              	JZ	SETGL
  09A7'   2B                    	DCX	H
  09A8'   22 2418'              	SHLD	CNTV
  09AB'   CD 0A00'              	CALL	BCK1
  09AE'   D2 099F'              	JNC	BDO_LP
  09B1'   C3 0492'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  09B4'                         FWD1:
  09B4'   CD 0A33'              	CALL	CCLS
  09B7'   32 2424'              	STA	WKCLS		; the starting class
  09BA'   CD 0A6D'              	CALL	INCC
  09BD'   B7                    	ORA	A
  09BE'   CA 09D6'              	JZ	FW_WD
  09C1'   37                    	STC
  09C2'   F8                    	RM			; -1: already at the end
  09C3'   FE 02                 	CPI	2
  09C5'   C2 09D6'              	JNZ	FW_WD		; 1: a next line was reached
  09C8'   CD 08B7'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  09CB'   D4 0A54'              	CNC	NXLN
  09CE'   D2 09D6'              	JNC	FW_WD
  09D1'   CD 0AAF'              	CALL	DECC		; yes: back onto its last char, failed
  09D4'   37                    	STC
  09D5'   C9                    	RET
  09D6'                         FW_WD:
  09D6'   3A 2424'              	LDA	WKCLS		; go past the rest of this word
  09D9'   B7                    	ORA	A
  09DA'   CA 09EF'              	JZ	FW_WS
  09DD'                         FW_WLP:
  09DD'   CD 0A33'              	CALL	CCLS
  09E0'   21 2424'              	LXI	H,WKCLS
  09E3'   BE                    	CMP	M
  09E4'   C2 09EF'              	JNZ	FW_WS
  09E7'   CD 0A6D'              	CALL	INCC
  09EA'   B7                    	ORA	A
  09EB'   F8                    	RM			; the end of the file (NC)
  09EC'   C3 09DD'              	JMP	FW_WLP
  09EF'                         FW_WS:
  09EF'   CD 0A33'              	CALL	CCLS		; then over blanks to the next word
  09F2'   B7                    	ORA	A
  09F3'   C0                    	RNZ
  09F4'   CD 0A3B'              	CALL	EMPTY
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09F7'   C8                    	RZ			; an empty line is a word
  09F8'   CD 0A6D'              	CALL	INCC
  09FB'   B7                    	ORA	A
  09FC'   F8                    	RM
  09FD'   C3 09EF'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0A00'                         BCK1:
  0A00'   CD 0AAF'              	CALL	DECC
  0A03'   B7                    	ORA	A
  0A04'   37                    	STC
  0A05'   F8                    	RM
  0A06'                         BK_WS:
  0A06'   CD 0A33'              	CALL	CCLS		; back over blanks
  0A09'   B7                    	ORA	A
  0A0A'   C2 0A1A'              	JNZ	BK_WD
  0A0D'   CD 0A3B'              	CALL	EMPTY
  0A10'   C8                    	RZ			; an empty line is a word
  0A11'   CD 0AAF'              	CALL	DECC
  0A14'   B7                    	ORA	A
  0A15'   F2 0A06'              	JP	BK_WS
  0A18'   AF                    	XRA	A		; the start of the file (NC)
  0A19'   C9                    	RET
