  10E6'                         VHD_0:
  10E6'   16 00                 	MVI	D,0
  10E8'                         VHD_1:
  10E8'   7A                    	MOV	A,D
  10E9'   B7                    	ORA	A
  10EA'   CA 1105'              	JZ	VHD_C		; the text stays
  10ED'   4A                    	MOV	C,D
  10EE'   CD 11F7'              	CALL	HTFQ		; HL -> the line that row is in, C = which of its
  10F1'   79                    	MOV	A,C
  10F2'   B7                    	ORA	A
  10F3'   CA 1105'              	JZ	VHD_C
  10F6'   BA                    	CMP	D
  10F7'   C2 1102'              	JNZ	VHD_R
  10FA'   7E                    	MOV	A,M		; the top line still: past all of it
  10FB'   91                    	SUB	C
  10FC'   83                    	ADD	E
  10FD'   5F                    	MOV	E,A
  10FE'   23                    	INX	H
  10FF'   C3 1105'              	JMP	VHD_C
  1102'                         VHD_R:
  1102'   7B                    	MOV	A,E		; part of the way down a line: its start
  1103'   91                    	SUB	C
  1104'   5F                    	MOV	E,A
  1105'                         VHD_C:
  1105'   22 0000*              	SHLD	HFTP
  1108'   3A 0000*              	LDA	CSUB		; the cursor: E rows down from the one it is on
  110B'   83                    	ADD	E
  110C'   4F                    	MOV	C,A
  110D'   3A 0000*              	LDA	HTCUR
  1110'   CD 11D9'              	CALL	HTPT
  1113'   CD 11F7'              	CALL	HTFQ
  1116'   D2 111A'              	JNC	HFEND
  1119'   2B                    	DCX	H		; the file ends first: its last line
                                ;HFEND -- ^D / ^U: HL -> the rows of the line the cursor goes to.
  111A'                         HFEND:
  111A'   EB                    	XCHG
  111B'   2A 0000*              	LHLD	HFTP
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  111E'   EB                    	XCHG
                                ;HTLAND -- the cursor to the line whose rows HL points at, DE -> those of the
                                ; line the screen is to start with (never one under it); first non-blank.
  111F'                         HTLAND:
  111F'   E5                    	PUSH	H
  1120'   D5                    	PUSH	D
  1121'   CD 11EC'              	CALL	HTGO
  1124'   D1                    	POP	D
  1125'   E1                    	POP	H
  1126'   CD 0000*              	CALL	SUBHD		; HL = the lines between them
  1129'   7C                    	MOV	A,H
  112A'   B7                    	ORA	A
  112B'   7D                    	MOV	A,L
  112C'   CA 1130'              	JZ	HL_SET
  112F'   AF                    	XRA	A
  1130'                         HL_SET:
  1130'   CD 0EDE'              	CALL	SETRWT
  1133'   C3 0958'              	JMP	FNBLNK
                                
                                ;--- the top line is taller than the screen, and the cursor in it: vim goes
                                ;    on scrolling until the next line is at the top, the cursor keeping its
                                ;    row of the screen ---
  1136'                         VHD_TL:
  1136'   3A 0000*              	LDA	SKIPR
  1139'   47                    	MOV	B,A
  113A'   3A 0000*              	LDA	CSUB
  113D'   90                    	SUB	B		; A = that row
  113E'   F5                    	PUSH	PSW
  113F'   21 0001               	LXI	H,1
  1142'   CD 0A13'              	CALL	JCORE		; (on the last line: nowhere to go)
  1145'   F1                    	POP	PSW
  1146'   4F                    	MOV	C,A
  1147'   C5                    	PUSH	B
  1148'   0C                    	INR	C
  1149'   06 00                 	MVI	B,0
  114B'   CD 11CD'              	CALL	HTRB		; HL -> the rows of the line now the cursor's
  114E'   22 0000*              	SHLD	HFTP
  1151'   D1                    	POP	D
  1152'   4B                    	MOV	C,E
  1153'   CD 11F7'              	CALL	HTFQ
  1156'   D2 111A'              	JNC	HFEND
  1159'   2B                    	DCX	H
  115A'   C3 111A'              	JMP	HFEND
                                
                                ;VC_HFUP -- '^U': the text and the cursor up HFAMT ROWS (HFCNT), then the
                                ; cursor's first non-blank.  vim's pagescroll (NOT WordMaster).  The text
                                ; stops at the first line, the cursor goes on.  Where the rows end part of
                                ; the way up a line, the top line is the one under it and the cursor moves as
                                ; many rows less -- but the line itself, and as many more, when it is the
                                ; first one back.  On the first line nothing moves, the column included.
  115D'                         VC_HFUP:
  115D'   CD 0852'              	CALL	SETMOV
  1160'   CD 12DB'              	CALL	HFCNT		; HFN = the rows
  1163'   CD 12BB'              	CALL	ONFST
  1166'   C8                    	RZ			; the cursor is on the first line
  1167'   0E 01                 	MVI	C,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  1169'   3A 0000*              	LDA	HFN
  116C'   CD 11B8'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  116F'   43                    	MOV	B,E
  1170'   3A 0000*              	LDA	HFN
  1173'   4F                    	MOV	C,A
  1174'   5F                    	MOV	E,A		; E = the rows the cursor moves
  1175'   CD 1208'              	CALL	HTBQ		; HL -> the line that row is in, C = its rows
  1178'   DA 1193'              	JC	VHU_C		;   above it; or the file's first line
  117B'   79                    	MOV	A,C
  117C'   B7                    	ORA	A
  117D'   CA 1193'              	JZ	VHU_C
  1180'   3A 0000*              	LDA	HTTP
  1183'   3D                    	DCR	A
  1184'   B8                    	CMP	B
  1185'   CA 1190'              	JZ	VHU_F
  1188'   7B                    	MOV	A,E		; part of the way up a line: the one under it
  1189'   96                    	SUB	M
  118A'   81                    	ADD	C
  118B'   5F                    	MOV	E,A
  118C'   23                    	INX	H
  118D'   C3 1193'              	JMP	VHU_C
  1190'                         VHU_F:
  1190'   7B                    	MOV	A,E		; ... the first line back: all of it
  1191'   81                    	ADD	C
  1192'   5F                    	MOV	E,A
  1193'                         VHU_C:
  1193'   22 0000*              	SHLD	HFTP
  1196'   4B                    	MOV	C,E
  1197'   3A 0000*              	LDA	HTCUR
  119A'   CD 11D9'              	CALL	HTPT		; HL -> the cursor line's rows, E = lines above it
  119D'   3A 0000*              	LDA	CSUB
  11A0'   57                    	MOV	D,A
  11A1'   79                    	MOV	A,C
  11A2'   92                    	SUB	D		; the rows to go, less those of its own line above it
  11A3'   DA 111A'              	JC	HFEND
  11A6'   CA 111A'              	JZ	HFEND
  11A9'   4F                    	MOV	C,A
  11AA'   43                    	MOV	B,E
  11AB'   CD 1208'              	CALL	HTBQ		; (off the top: the file's first line)
  11AE'   C3 111A'              	JMP	HFEND
                                
                                ;------------------------------------------------------------
                                ; The row table.  HTAB[0..HTN) holds the rows of consecutive lines, HTCUR is
                                ; the cursor line's entry, HTTP the top line's (HTSET).  The walks below take
                                ; HL -> an entry and answer with HL -> another.
                                ;------------------------------------------------------------
                                
                                ;HTSET -- measure the lines about the screen: A = the lines above the top one
                                ; to take too, C = the rows to gather from the cursor's line on (HTBLD).
                                ;   out: HL -> the top line's rows, B = the entries from it on, E = HTTP =
                                ;        the entries above it
                                ;HTRB -- the same about the cursor alone: B = the lines above it, C as above.
                                ;   out: HL -> the cursor line's rows, B = the entries from it on, E = those
                                ;        above it
                                ;HTPT -- A = an entry's index: HL -> it, B = the entries from it on, E = A.
                                ; Keeps C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ;HTSCR -- the table as the last layout left it, which is the screen's own:
                                ; HL, B and E as HTSET gives them, and nothing measured.
  11B1'                         HTSCR:
  11B1'   CD 0EBF'              	CALL	CURRW
  11B4'   47                    	MOV	B,A
  11B5'   C3 11C3'              	JMP	HS_TP
  11B8'                         HTSET:
  11B8'   47                    	MOV	B,A
  11B9'   CD 0EBF'              	CALL	CURRW		; (keeps BC)
  11BC'   F5                    	PUSH	PSW
  11BD'   80                    	ADD	B
  11BE'   47                    	MOV	B,A
  11BF'   CD 11CD'              	CALL	HTRB
  11C2'   C1                    	POP	B		; B = the lines from the top one to the cursor's
  11C3'                         HS_TP:
  11C3'   3A 0000*              	LDA	HTCUR
  11C6'   90                    	SUB	B
  11C7'   32 0000*              	STA	HTTP
  11CA'   C3 11D9'              	JMP	HTPT
  11CD'                         HTRB:
  11CD'   CD 13AB'              	CALL	ZSAVE
  11D0'   CD 0000*              	CALL	HTBLD
  11D3'   CD 13BE'              	CALL	ZREST
  11D6'   3A 0000*              	LDA	HTCUR
  11D9'                         HTPT:
  11D9'   5F                    	MOV	E,A
  11DA'   16 00                 	MVI	D,0
  11DC'   21 0000*              	LXI	H,HTAB
  11DF'   19                    	DAD	D
  11E0'   3A 0000*              	LDA	HTN
  11E3'   93                    	SUB	E
  11E4'   47                    	MOV	B,A
  11E5'   C9                    	RET
                                
                                ;HTIX -- HL -> an entry: A = its index.  Keeps HL, BC.
  11E6'                         HTIX:
  11E6'   11 0000*              	LXI	D,HTAB
  11E9'   7D                    	MOV	A,L
  11EA'   93                    	SUB	E
  11EB'   C9                    	RET
                                
                                ;HTGO -- the cursor to the start of the line whose entry HL points at (its
                                ; own: unmoved).
  11EC'                         HTGO:
  11EC'   CD 11E6'              	CALL	HTIX
  11EF'   47                    	MOV	B,A
  11F0'   3A 0000*              	LDA	HTCUR
  11F3'   90                    	SUB	B		; A = the lines up to it
  11F4'   C3 0EF6'              	JMP	MR_GO
                                
                                ;HTFQ -- down the table.  HL -> a line's entry, B = the entries from it on,
                                ; C = rows, counted from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = the row within it, B
                                ;        = the entries from there on; CY if the table ends first (HL past its
                                ;        last entry, C = the rows short)
  11F7'                         HTFQ:
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  11F7'   78                    	MOV	A,B
  11F8'   B7                    	ORA	A
  11F9'   37                    	STC
  11FA'   C8                    	RZ
  11FB'   79                    	MOV	A,C
  11FC'   96                    	SUB	M
  11FD'   DA 1206'              	JC	HF_IN
  1200'   4F                    	MOV	C,A
  1201'   23                    	INX	H
  1202'   05                    	DCR	B
  1203'   C3 11F7'              	JMP	HTFQ
  1206'                         HF_IN:
  1206'   B7                    	ORA	A
  1207'   C9                    	RET
                                
                                ;HTBQ -- up the table.  HL -> a line's entry, B = the entries above it, C =
                                ; rows (not 0), counted up from that line's first.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it (0: it is the line's first), B = the entries above; CY if
                                ;        the table starts first (HL -> its first entry, C = the rows short)
  1208'                         HTBQ:
  1208'   78                    	MOV	A,B
  1209'   B7                    	ORA	A
  120A'   37                    	STC
  120B'   C8                    	RZ
  120C'   2B                    	DCX	H
  120D'   05                    	DCR	B
  120E'   7E                    	MOV	A,M
  120F'   91                    	SUB	C
  1210'   D2 1219'              	JNC	HQ_IN
  1213'   2F                    	CMA
  1214'   3C                    	INR	A
  1215'   4F                    	MOV	C,A
  1216'   C3 1208'              	JMP	HTBQ
  1219'                         HQ_IN:
  1219'   4F                    	MOV	C,A
  121A'   C9                    	RET
                                
                                ;RWQ -- C = RWR, or 100 if it is more: the rows one table is asked for.
                                ; Keeps HL, B, DE.
  121B'                         RWQ:
  121B'   0E 64                 	MVI	C,100
  121D'   3A 0001*              	LDA	RWR+1
  1220'   B7                    	ORA	A
  1221'   C0                    	RNZ
  1222'   3A 0000*              	LDA	RWR
  1225'   B9                    	CMP	C
  1226'   D0                    	RNC
  1227'   4F                    	MOV	C,A
  1228'   C9                    	RET
                                
                                ;RWSUB -- RWR -= A.  Keeps HL, BC.
  1229'                         RWSUB:
  1229'   E5                    	PUSH	H
  122A'   5F                    	MOV	E,A
  122B'   16 00                 	MVI	D,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  122D'   2A 0000*              	LHLD	RWR
  1230'   CD 0000*              	CALL	SUBHD
  1233'   22 0000*              	SHLD	RWR
  1236'   E1                    	POP	H
  1237'   C9                    	RET
                                
                                ;RWFWD -- a page scroll down: RWR rows on from the first row of the line
                                ; whose entry HL points at (B = the entries from it on), however far that is:
                                ; where the table runs out the cursor is moved up to there and the table made
                                ; again from it (RWMV: that happened).
                                ;   out: HL -> the entry of the line that row is in, C = the row within it;
                                ;        CY if the text ends first (HL -> its last line)
  1238'                         RWFWD:
  1238'   CD 121B'              	CALL	RWQ
  123B'   51                    	MOV	D,C
  123C'   CD 11F7'              	CALL	HTFQ
  123F'   F5                    	PUSH	PSW
  1240'   7A                    	MOV	A,D
  1241'   91                    	SUB	C		; the rows that took it to that line's first
  1242'   CD 1229'              	CALL	RWSUB
  1245'   F1                    	POP	PSW
  1246'   DA 125A'              	JC	RF_OFF
  1249'   3A 0001*              	LDA	RWR+1		; is what is left inside this line?
  124C'   B7                    	ORA	A
  124D'   C2 1264'              	JNZ	RF_GO
  1250'   3A 0000*              	LDA	RWR
  1253'   BE                    	CMP	M
  1254'   D2 1264'              	JNC	RF_GO
  1257'   4F                    	MOV	C,A
  1258'   B7                    	ORA	A
  1259'   C9                    	RET
  125A'                         RF_OFF:
  125A'   3A 0000*              	LDA	HTEOF
  125D'   B7                    	ORA	A
  125E'   CA 1264'              	JZ	RF_GO		; (HL -> where the next line's entry would be)
  1261'   2B                    	DCX	H
  1262'   37                    	STC
  1263'   C9                    	RET
  1264'                         RF_GO:
  1264'   CD 11EC'              	CALL	HTGO
  1267'   3E 01                 	MVI	A,1
  1269'   32 0000*              	STA	RWMV
  126C'   CD 121B'              	CALL	RWQ
  126F'   0C                    	INR	C
  1270'   06 00                 	MVI	B,0
  1272'   CD 11CD'              	CALL	HTRB
  1275'   C3 1238'              	JMP	RWFWD
                                
                                ;RWBAK -- a page scroll up: RWR rows up from the first row of the line whose
                                ; entry HL points at (B = the entries above it), as RWFWD.
                                ;   out: HL -> the entry of the line that row is in, C = that line's rows
                                ;        above it; CY if the file starts first (HL -> its first line)
  1278'                         RWBAK:
  1278'   CD 121B'              	CALL	RWQ
  127B'   51                    	MOV	D,C
  127C'   CD 1208'              	CALL	HTBQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


  127F'   DA 129C'              	JC	RB_OFF
  1282'   7A                    	MOV	A,D
  1283'   81                    	ADD	C
  1284'   5F                    	MOV	E,A		; E = the rows up to that line's first
  1285'   3A 0001*              	LDA	RWR+1
  1288'   B7                    	ORA	A
  1289'   C2 1298'              	JNZ	RB_ON
  128C'   3A 0000*              	LDA	RWR
  128F'   57                    	MOV	D,A
  1290'   7B                    	MOV	A,E
  1291'   92                    	SUB	D		; no fewer than are wanted: it is in this line
  1292'   DA 1298'              	JC	RB_ON
  1295'   4F                    	MOV	C,A
  1296'   B7                    	ORA	A
  1297'   C9                    	RET
  1298'                         RB_ON:
  1298'   7B                    	MOV	A,E
  1299'   C3 12A3'              	JMP	RB_GO
  129C'                         RB_OFF:
  129C'   3A 0000*              	LDA	HTBOF
  129F'   0F                    	RRC			; CY: that is the file's first line
  12A0'   D8                    	RC
  12A1'   7A                    	MOV	A,D
  12A2'   91                    	SUB	C
  12A3'                         RB_GO:
  12A3'   CD 1229'              	CALL	RWSUB
  12A6'   CD 11EC'              	CALL	HTGO
  12A9'   3E 01                 	MVI	A,1
  12AB'   32 0000*              	STA	RWMV
  12AE'   CD 121B'              	CALL	RWQ
  12B1'   41                    	MOV	B,C
  12B2'   0E 01                 	MVI	C,1
  12B4'   CD 11CD'              	CALL	HTRB
  12B7'   43                    	MOV	B,E
  12B8'   C3 1278'              	JMP	RWBAK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  12BB'                         ONFST:
  12BB'   E5                    	PUSH	H
  12BC'   2A 0000*              	LHLD	OUTPOS
  12BF'   7C                    	MOV	A,H
  12C0'   B5                    	ORA	L
  12C1'   C2 12D9'              	JNZ	OF_RET
  12C4'   2A 0000*              	LHLD	TXTBEG
  12C7'   EB                    	XCHG			; DE = TXTBEG
  12C8'   2A 0000*              	LHLD	GAPBEG
  12CB'                         OF_LP:
  12CB'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  12CE'   CA 12D9'              	JZ	OF_RET
  12D1'   2B                    	DCX	H
  12D2'   7E                    	MOV	A,M
  12D3'   FE 0A                 	CPI	LF
  12D5'   C2 12CB'              	JNZ	OF_LP
  12D8'   B7                    	ORA	A		; NZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  12D9'                         OF_RET:
  12D9'   E1                    	POP	H
  12DA'   C9                    	RET
                                
                                ;HFCNT -- HFN = the ^D/^U row count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  12DB'                         HFCNT:
  12DB'   2A 0000*              	LHLD	CMDCNT
  12DE'   7C                    	MOV	A,H
  12DF'   B5                    	ORA	L
  12E0'   CA 12F7'              	JZ	HFC_AM
  12E3'   CD 077D'              	CALL	GETCNT		; HL = count; clears it
  12E6'   3A 0000*              	LDA	NEDIT
  12E9'   5F                    	MOV	E,A
  12EA'   16 00                 	MVI	D,0
  12EC'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  12EF'   D2 12F3'              	JNC	HFC_ST
  12F2'   EB                    	XCHG			; HL = NEDIT
  12F3'                         HFC_ST:
  12F3'   7D                    	MOV	A,L
  12F4'   32 0000*              	STA	HFAMT
  12F7'                         HFC_AM:
  12F7'   3A 0000*              	LDA	HFAMT
  12FA'   B7                    	ORA	A
  12FB'   C2 1308'              	JNZ	HFC_HL
  12FE'   3A 0000*              	LDA	NEDIT
  1301'   B7                    	ORA	A
  1302'   1F                    	RAR
  1303'   B7                    	ORA	A
  1304'   C2 1308'              	JNZ	HFC_HL
  1307'   3C                    	INR	A		; at least one row
  1308'                         HFC_HL:
  1308'   32 0000*              	STA	HFN
  130B'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  130C'                         VC_REDR:
  130C'   C3 077D'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (PLACE) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  130F'                         VC_G:
  130F'   CD 0852'              	CALL	SETMOV
  1312'   CD 13D1'              	CALL	GZONE		; the screen's top line, before the move
  1315'   CD 07A6'              	CALL	BRKON		; ... and an ESC may stop it from here on
  1318'   2A 0000*              	LHLD	CMDCNT
  131B'   7C                    	MOV	A,H
  131C'   B5                    	ORA	L
  131D'   C2 1330'              	JNZ	VG_N
  1320'   AF                    	XRA	A		; forward
  1321'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  1324'   CD 07E3'              	CALL	BRKOFF
  1327'   DA 07FB'              	JC	BRKBAK
  132A'   CD 0BE1'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  132D'   C3 13E9'              	JMP	GPLACE
  1330'                         VG_N:
  1330'   CD 077D'              	CALL	GETCNT		; HL = target line (1-based)
  1333'                         VG_LN:
  1333'   CD 133F'              	CALL	GOLN
  1336'   CD 07E3'              	CALL	BRKOFF
  1339'   DA 07FB'              	JC	BRKBAK
  133C'   C3 13E9'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
                                ;The move is counted from the line the cursor is on (CNTLF keeps that without
                                ;reading the disk), so it costs the distance and not the line number: it used
                                ;to go back to line 1 and count forward from there, whatever the distance.
  133F'                         GOLN:
  133F'   E5                    	PUSH	H
  1340'   CD 0000*              	CALL	CNTLF
  1343'   23                    	INX	H		; HL = the cursor's line
  1344'   D1                    	POP	D		; DE = the line wanted
  1345'   CD 0000*              	CALL	CMP16		; CY iff DE < HL: it is above
  1348'   DA 1353'              	JC	GLN_BK
  134B'   EB                    	XCHG
  134C'   CD 0000*              	CALL	SUBHD		; HL = the lines down to it (0: this line's start)
  134F'   AF                    	XRA	A
  1350'   C3 1358'              	JMP	GLN_MV
  1353'                         GLN_BK:
  1353'   CD 0000*              	CALL	SUBHD		; HL = the lines up to it
  1356'   3E FF                 	MVI	A,0FFH
  1358'                         GLN_MV:
  1358'   CD 0000*              	CALL	MVLIND
  135B'   CD 0BDB'              	CALL	ATEOF
  135E'   DC 0BE1'              	CC	LASTLN		; past the last line: onto it
  1361'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  1362'                         VC_LG:
  1362'   CD 0852'              	CALL	SETMOV
  1365'   3A 0000*              	LDA	GSAVE
  1368'   B7                    	ORA	A
  1369'   C2 1372'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  136C'   3E 01                 	MVI	A,PG
  136E'   32 0000*              	STA	GPEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1371'   C9                    	RET
  1372'                         VLG_GG:
  1372'   CD 13D1'              	CALL	GZONE
  1375'   CD 07A6'              	CALL	BRKON
  1378'   CD 077D'              	CALL	GETCNT		; HL = target line (no count: 1)
  137B'   C3 1333'              	JMP	VG_LN
                                
                                ;SUB24 -- A:HL less B:DE -> A:HL, a file position from a file position.  CY
                                ; if it went below zero, Z if the top byte came out 0.  Uses C.
  137E'                         SUB24:
  137E'   4F                    	MOV	C,A
  137F'   7D                    	MOV	A,L
  1380'   93                    	SUB	E
  1381'   6F                    	MOV	L,A
  1382'   7C                    	MOV	A,H
  1383'   9A                    	SBB	D
  1384'   67                    	MOV	H,A
  1385'   79                    	MOV	A,C
  1386'   98                    	SBB	B
  1387'   C9                    	RET
                                
                                ;CURFP -- A:HL = the cursor's file position.  NOTE: falls into FPOS.
  1388'                         CURFP:
  1388'   2A 0000*              	LHLD	GAPBEG
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  138B'                         FPOS:
  138B'   C5                    	PUSH	B
  138C'   D5                    	PUSH	D
  138D'   EB                    	XCHG
  138E'   2A 0000*              	LHLD	TXTBEG
  1391'   EB                    	XCHG
  1392'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  1395'   EB                    	XCHG			; DE = that
  1396'   2A 0000*              	LHLD	OUTPOS
  1399'   7C                    	MOV	A,H
  139A'   B7                    	ORA	A		; CY = 0
  139B'   1F                    	RAR
  139C'   47                    	MOV	B,A
  139D'   7D                    	MOV	A,L
  139E'   1F                    	RAR
  139F'   67                    	MOV	H,A
  13A0'   3E 00                 	MVI	A,0
  13A2'   1F                    	RAR
  13A3'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  13A4'   19                    	DAD	D
  13A5'   78                    	MOV	A,B
  13A6'   CE 00                 	ACI	0		; A:HL = the position
  13A8'   D1                    	POP	D
  13A9'   C1                    	POP	B
  13AA'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  13AB'                         ZSAVE:
  13AB'   2A 0000*              	LHLD	CMDCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  13AE'   22 0000*              	SHLD	ZSVCNT
  13B1'   2A 0000*              	LHLD	AUXCNT
  13B4'   22 0000*              	SHLD	ZSVAUX
  13B7'   3A 0000*              	LDA	DIRFLG
  13BA'   32 0000*              	STA	ZSVDIR
  13BD'   C9                    	RET
  13BE'                         ZREST:
  13BE'   2A 0000*              	LHLD	ZSVCNT
  13C1'   22 0000*              	SHLD	CMDCNT
  13C4'   2A 0000*              	LHLD	ZSVAUX
  13C7'   22 0000*              	SHLD	AUXCNT
  13CA'   3A 0000*              	LDA	ZSVDIR
  13CD'   32 0000*              	STA	DIRFLG
  13D0'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  13D1'                         GZONE:
  13D1'   CD 13AB'              	CALL	ZSAVE
  13D4'   CD 0EBF'              	CALL	CURRW
  13D7'   6F                    	MOV	L,A
  13D8'   26 00                 	MVI	H,0
  13DA'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  13DD'   CD 138B'              	CALL	FPOS
  13E0'   22 0000*              	SHLD	ZTOP
  13E3'   32 0002*              	STA	ZTOP+2
  13E6'   C3 13BE'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
  13E9'                         GPLACE:
  13E9'   CD 13AB'              	CALL	ZSAVE
  13EC'   CD 1388'              	CALL	CURFP
  13EF'   EB                    	XCHG
  13F0'   2A 0000*              	LHLD	ZTOP
  13F3'   EB                    	XCHG
  13F4'   4F                    	MOV	C,A		; C:HL = the target's position
  13F5'   3A 0002*              	LDA	ZTOP+2
  13F8'   47                    	MOV	B,A		; B:DE = the top's
  13F9'   79                    	MOV	A,C
  13FA'   CD 137E'              	CALL	SUB24
  13FD'   22 0000*              	SHLD	ZDIF		; A:ZDIF = target - top; CY iff above the top
  1400'   DA 143A'              	JC	GP_UP
  1403'   B7                    	ORA	A
  1404'   C2 1480'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most 2*NEDIT+1 lines between?  (More
                                	;    is far off, whatever the lines are: SCRN.MAC LYFAR) ---
  1407'   3A 0000*              	LDA	NEDIT
  140A'   87                    	ADD	A
  140B'   3C                    	INR	A
  140C'   6F                    	MOV	L,A
  140D'   26 00                 	MVI	H,0
  140F'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  1412'   CD 0776'              	CALL	GBSUB		; HL = bytes from there to the target
  1415'   EB                    	XCHG
  1416'   2A 0000*              	LHLD	ZDIF		; HL = bytes from the top to the target
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  1419'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  141C'   DA 1480'              	JC	GP_MID
  141F'   CD 0776'              	CALL	GBSUB		; HL = the top line's start (resident)
  1422'   01 0000               	LXI	B,0		; BC = lines from the top
  1425'                         GP_CNT:
  1425'   7A                    	MOV	A,D
  1426'   B3                    	ORA	E
  1427'   CA 1436'              	JZ	GP_DN
  142A'   7E                    	MOV	A,M
  142B'   23                    	INX	H
  142C'   1B                    	DCX	D
  142D'   FE 0A                 	CPI	LF
  142F'   C2 1425'              	JNZ	GP_CNT
  1432'   03                    	INX	B
  1433'   C3 1425'              	JMP	GP_CNT
  1436'                         GP_DN:
  1436'   79                    	MOV	A,C		; the lines from the top one to it
  1437'   C3 14AA'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  143A'                         GP_UP:
  143A'   3C                    	INR	A
  143B'   C2 1480'              	JNZ	GP_MID		; 64K bytes or more above
  143E'   2A 0000*              	LHLD	ZDIF
  1441'   EB                    	XCHG
  1442'   21 0000               	LXI	H,0
  1445'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  1448'   7C                    	MOV	A,H
  1449'   B5                    	ORA	L
  144A'   CA 1480'              	JZ	GP_MID		; exactly 64K
  144D'   EB                    	XCHG			; DE = bytes to read
  144E'   AF                    	XRA	A
  144F'   32 0000*              	STA	ZLF
  1452'   CD 0000*              	CALL	RGET0
  1455'                         GP_RD:
  1455'   CD 0000*              	CALL	RDGET		; (keeps DE)
  1458'   DA 1480'              	JC	GP_MID
  145B'   FE 0A                 	CPI	LF
  145D'   C2 1471'              	JNZ	GP_RN
  1460'   3A 0000*              	LDA	NEDIT
  1463'   B7                    	ORA	A
  1464'   1F                    	RAR
  1465'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  1467'   E5                    	PUSH	H
  1468'   21 0000*              	LXI	H,ZLF
  146B'   34                    	INR	M
  146C'   BE                    	CMP	M		; CY iff more lines than that
  146D'   E1                    	POP	H
  146E'   DA 1480'              	JC	GP_MID
  1471'                         GP_RN:
  1471'   1B                    	DCX	D
  1472'   7A                    	MOV	A,D
  1473'   B3                    	ORA	E
  1474'   C2 1455'              	JNZ	GP_RD
  1477'   3E 01                 	MVI	A,PL_SET	; the top row
  1479'   32 0000*              	STA	PLACE
  147C'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


  147D'   C3 148A'              	JMP	GP_SET
  1480'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  1480'   3E 02                 	MVI	A,PL_MID
  1482'   32 0000*              	STA	PLACE		; mid-screen, as the rows fall
  1485'   3A 0000*              	LDA	NEDIT
  1488'   B7                    	ORA	A
  1489'   1F                    	RAR			; (no more lines above it than this)
  148A'                         GP_SET:
  148A'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  148B'   26 00                 	MVI	H,0
  148D'   22 0000*              	SHLD	WINROW
  1490'   21 0000               	LXI	H,0
  1493'   22 0000*              	SHLD	LNDLT
  1496'   CD 088F'              	CALL	SETFUL		; the window may have paged: full repaint
  1499'                         GP_FIN:
  1499'   CD 13BE'              	CALL	ZREST
  149C'   3A 0000*              	LDA	GPKEEP
  149F'   B7                    	ORA	A
  14A0'   CA 0958'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  14A3'   AF                    	XRA	A
  14A4'   32 0000*              	STA	GPKEEP
  14A7'   C3 0611'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is A lines below the top line of the screen the reader
                                ; is looking at: this is a cursor motion, not a jump, and LAYOUT is told the
                                ; truth -- the cursor moved as many lines as that differs from where it was.
                                ; If the line is on the screen, the top line does not move and NOTHING on it
                                ; changes: the text scrolled LNDLT - (the row change) lines, which comes out
                                ; zero, and R_MOVE then repositions the cursor and draws nothing.  If it is
                                ; not, LAYOUT's own rule (LYFAR: rows, once lines wrap) scrolls up to it or
                                ; puts it mid-screen, as for any other motion.  WINROW is left alone: CURRW
                                ; adds LNDLT to it and arrives at the same line.
  14AA'                         GP_ONS:
  14AA'   6F                    	MOV	L,A
  14AB'   26 00                 	MVI	H,0		; HL = the lines from the top line to it
  14AD'   EB                    	XCHG
  14AE'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  14B1'   EB                    	XCHG
  14B2'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  14B5'   22 0000*              	SHLD	LNDLT
  14B8'   3E 01                 	MVI	A,R_MOVE
  14BA'   32 0000*              	STA	RINTENT
  14BD'   C3 1499'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (never an ESC:
                                ; VIC_ESC cleared PENDOP).  Apply the operator to this key.
  14C0'                         OPPEND:
  14C0'   AF                    	XRA	A
  14C1'   32 0000*              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  14C4'   3A 0000*              	LDA	PSAVE
  14C7'   FE 63                 	CPI	'c'
  14C9'   C2 14E6'              	JNZ	OPP_ND
  14CC'   79                    	MOV	A,C
  14CD'   FE 77                 	CPI	'w'
  14CF'   CA 14D7'              	JZ	OPP_W
  14D2'   FE 57                 	CPI	'W'
  14D4'   C2 14E6'              	JNZ	OPP_ND
  14D7'                         OPP_W:
  14D7'   CD 16C1'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  14DA'   DA 14E6'              	JC	OPP_ND
  14DD'   79                    	MOV	A,C
  14DE'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  14E0'   4F                    	MOV	C,A
  14E1'   3E 01                 	MVI	A,1		; ... and one that does not leave a word's last
  14E3'   32 0000*              	STA	CWEOL		;   char for the next word's: see ESTEP
  14E6'                         OPP_ND:
  14E6'   79                    	MOV	A,C		; 'gg' is two keys, and the second has to be read
  14E7'   FE 67                 	CPI	'g'		;   HERE, as a mark's letter is: left to the next
  14E9'   C2 14FD'              	JNZ	OPP_NG		;   dispatch it would arrive with the operator
  14EC'   CD 01F9'              	CALL	MKGETK		;   gone.  Anything but a second 'g' drops both
  14EF'   DA 1595'              	JC	OPABRT
  14F2'   79                    	MOV	A,C
  14F3'   FE 67                 	CPI	'g'
  14F5'   C2 1595'              	JNZ	OPABRT
  14F8'   3E 01                 	MVI	A,PG
  14FA'   32 0000*              	STA	GSAVE		; ... and VC_LG runs it as the 'gg' it is
  14FD'                         OPP_NG:
  14FD'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  14FE'   21 0000*              	LXI	H,PSAVE
  1501'   BE                    	CMP	M
  1502'   CA 16E2'              	JZ	OPLINE
  1505'   79                    	MOV	A,C		; (OPCLS classifies the key)
  1506'   CD 16F8'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  1509'   DA 1595'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  150C'   32 0000*              	STA	OPCLSV
  150F'   47                    	MOV	B,A		; B = the class
  1510'   3A 0000*              	LDA	PSAVE
  1513'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  1515'   C2 1521'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  1518'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  1519'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  151B'   C2 1543'              	JNZ	OPP_GO
  151E'   C3 152C'              	JMP	OPP_NO
  1521'                         OPP_NC:
  1521'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  1523'   C2 1543'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  1526'   78                    	MOV	A,B		;   a charwise register would need a type flag
  1527'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  1529'   CA 1543'              	JZ	OPP_GO		;   within a line -- neither of which is built
  152C'                         OPP_NO:
  152C'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  152D'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  152F'   CA 153D'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  1532'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  1534'   CA 153D'              	JZ	OPP_SW		;   so swallow it before dropping the command
  1537'   CD 0326'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  153A'   C2 1595'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  153D'                         OPP_SW:
  153D'   CD 01F9'              	CALL	MKGETK
  1540'   C3 1595'              	JMP	OPABRT
  1543'                         OPP_GO:
  1543'   AF                    	XRA	A
  1544'   32 0000*              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  1547'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  154A'   22 0000*              	SHLD	OPSTA
  154D'   C5                    	PUSH	B
  154E'   21 0000*              	LXI	H,OPSFP		; ... and as a place in the FILE: an offset is
  1551'   CD 0429'              	CALL	FPSTO		;   only good until the motion pages the window
  1554'   3A 0000*              	LDA	OPCLSV
  1557'   FE 02                 	CPI	2
  1559'   CC 1598'              	CZ	OPENDS		; a line motion: the start LINE's two ends too
  155C'   C1                    	POP	B
  155D'   21 2E51'              	LXI	H,CMDTAB
  1560'   CD 00C3'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  1563'   3A 0000*              	LDA	PSAVE		; the motion may have cancelled the operator -- a
  1566'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  1567'   CA 0852'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  156A'   3A 0000*              	LDA	OPCLSV
  156D'   FE 02                 	CPI	2
  156F'   CC 0945'              	CZ	LNEND		; a line motion: the line it landed on whole, or
                                				;   the span ends inside it (#38).  It may page
                                				;   the start out; OPSFIX asks next
  1572'   CD 15C4'              	CALL	OPSFIX		; where the start is in the window NOW
  1575'   D2 15E0'              	JNC	OPPGD		; ... and it is not: the motion paged it out
  1578'   22 0000*              	SHLD	OPSTA
  157B'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  157E'   22 0000*              	SHLD	OPEND2
  1581'   3A 0000*              	LDA	PSAVE
  1584'   FE 79                 	CPI	'y'
  1586'   CA 1C9A'              	JZ	OPYANK		; a yank takes the span without losing it
  1589'   CD 1733'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  158C'   3A 0000*              	LDA	PSAVE
  158F'   FE 63                 	CPI	'c'
  1591'   C0                    	RNZ
  1592'   C3 1A4E'              	JMP	SETINS
  1595'                         OPABRT:				; not a motion -> the operator is dropped and
  1595'   C3 00A6'              	JMP	VIC_SW		;   nothing drew; its count goes with it, or the
                                				;   NEXT command would run that many times
                                
                                ;OPENDS -- OPSLO / OPSHI = where in the file the cursor's line starts, and
                                ; where the line after it does.  Whichever way a line motion then goes, one of
                                ; them is an end of the span, and if the motion pages it is too late to ask.
                                ; The cursor is walked to each and put back: all three are on its own line.
  1598'                         OPENDS:
  1598'   2A 0000*              	LHLD	OPSTA
  159B'   CD 0678'              	CALL	BOL
  159E'   11 0000*              	LXI	D,OPSLO
  15A1'   CD 15B6'              	CALL	OPE_ST
  15A4'   2A 0000*              	LHLD	OPSTA
  15A7'   CD 070F'              	CALL	NLSTART
  15AA'   11 0000*              	LXI	D,OPSHI
  15AD'   CD 15B6'              	CALL	OPE_ST
  15B0'   2A 0000*              	LHLD	OPSTA
  15B3'   C3 0000*              	JMP	GOTO
  15B6'                         OPE_ST:				; the file position of offset HL, into DE's 3 bytes
  15B6'   D5                    	PUSH	D
  15B7'   CD 0000*              	CALL	GOTO
  15BA'   E1                    	POP	H
  15BB'   C3 0429'              	JMP	FPSTO
                                
                                ;CURBD -- B:DE = the cursor's file position, for SUB24 to take away.
  15BE'                         CURBD:
  15BE'   CD 1388'              	CALL	CURFP
  15C1'   EB                    	XCHG
  15C2'   47                    	MOV	B,A
  15C3'   C9                    	RET
                                
                                ;OPSFIX -- after the motion: CY and HL = the span's start as an offset in the
                                ; window as it is now; NC and A = which way it lies (MKWIN) if the window no
                                ; longer holds it.  A motion that went nowhere is asked first: the cursor at
                                ; the very end of the text -- an empty file -- is past MKWIN's last byte.
  15C4'                         OPSFIX:
  15C4'   21 0000*              	LXI	H,OPSFP
  15C7'   CD 03DC'              	CALL	MKLOAD
  15CA'   CD 15BE'              	CALL	CURBD
  15CD'   2A 0000*              	LHLD	MKPOS
  15D0'   3A 0002*              	LDA	MKPOS+2
  15D3'   CD 137E'              	CALL	SUB24
  15D6'   B4                    	ORA	H
  15D7'   B5                    	ORA	L
  15D8'   C2 03E9'              	JNZ	MKWIN
  15DB'   CD 0000*              	CALL	CUROFF
  15DE'   37                    	STC
  15DF'   C9                    	RET
                                
                                ;OPPGD -- the motion paged the span's start out of the window; A says which
                                ; way it lies (FFH above, 0 below).  A LINE DELETE is carried through the
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


                                ; pager: the cursor goes to the low line's start and the text is taken a
                                ; window at a time -- DELFWD to the window's end with the count unspent, so
                                ; DELTO's PAGESTP pages the next of it in, as it does for 'dd's count -- until
                                ; what is left to take is in the window, and that goes as any line delete
                                ; does.  It is not kept in the register (no 'd{motion}' is) and it is far too
                                ; big for 'u', which says so.  The cursor lands as 'dd' lands, on the middle
                                ; row: the screen it started from may be gone with the text.
                                ; Anything else -- a yank, a charwise span -- cannot be taken from a window
                                ; that does not hold it: the bell, and the cursor back where it started.
  15E0'                         OPPGD:
  15E0'   47                    	MOV	B,A
  15E1'   3A 0000*              	LDA	OPCLSV
  15E4'   FE 02                 	CPI	2
  15E6'   C2 16A2'              	JNZ	OPG_NO
  15E9'   3A 0000*              	LDA	PSAVE
  15EC'   FE 64                 	CPI	'd'
  15EE'   C2 16A2'              	JNZ	OPG_NO
  15F1'   04                    	INR	B
  15F2'   CA 1601'              	JZ	OPG_FW
  15F5'   CD 0000*              	CALL	CUROFF		; the motion went BACK: its line is the low one,
  15F8'   CD 0678'              	CALL	BOL		;   and the high end is OPSHI as it stands
  15FB'   CD 0000*              	CALL	GOTO
  15FE'   C3 1619'              	JMP	OPG_GO
  1601'                         OPG_FW:
  1601'   CD 0000*              	CALL	CUROFF		; it went ON: the high end is past the line it
  1604'   CD 070F'              	CALL	NLSTART		;   landed on, and the low one is where the
  1607'   11 0000*              	LXI	D,OPSHI		;   start line began
  160A'   CD 15B6'              	CALL	OPE_ST
  160D'   21 0000*              	LXI	H,OPSLO
  1610'   CD 03DC'              	CALL	MKLOAD
  1613'   CD 03A9'              	CALL	MKPAGE
  1616'   CD 0000*              	CALL	GOTO
  1619'                         OPG_GO:
  1619'   CD 15BE'              	CALL	CURBD
  161C'   2A 0000*              	LHLD	OPSHI
  161F'   3A 0002*              	LDA	OPSHI+2
  1622'   CD 137E'              	CALL	SUB24		; A:HL = the bytes to take
  1625'                         OPG_SV:
  1625'   22 0000*              	SHLD	OPTOGO
  1628'   32 0002*              	STA	OPTOGO+2
  162B'                         OPG_NX:
  162B'   CD 0759'              	CALL	ATENDQ		; HL = the text's length, DE = the cursor
  162E'   CD 0000*              	CALL	SUBHD
  1631'   EB                    	XCHG			; DE = what the window holds past the cursor
  1632'   2A 0000*              	LHLD	OPTOGO
  1635'   3A 0002*              	LDA	OPTOGO+2
  1638'   B7                    	ORA	A
  1639'   C2 166C'              	JNZ	OPG_PG		; 64K or more to go
  163C'   CD 0000*              	CALL	CMP16		; DE = held vs HL = to go
  163F'   DA 166C'              	JC	OPG_PG
  1642'   CA 166C'              	JZ	OPG_PG		; just all of it: take it, and page before looking
  1645'                         OPG_FN:				; the rest of it is here
  1645'   E5                    	PUSH	H
  1646'   CD 0000*              	CALL	CLRCNT		; (the count spent: this delete must not page)
  1649'   CD 0000*              	CALL	CUROFF
  164C'   22 0000*              	SHLD	OPLO
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  164F'   D1                    	POP	D
  1650'   19                    	DAD	D
  1651'   22 0000*              	SHLD	OPHI
  1654'   CD 1866'              	CALL	OPDSPN
  1657'   CD 0BDB'              	CALL	ATEOF
  165A'   D2 16BB'              	JNC	OPMID
  165D'   CD 12BB'              	CALL	ONFST		; deleted to the end of the file: onto the new
  1660'   CA 16BB'              	JZ	OPMID		;   last line, if there is one -- and the pager
  1663'   21 0001               	LXI	H,1		;   may have to fetch it, as for 'dd' there
  1666'   CD 0000*              	CALL	SETBWD
  1669'   C3 16BB'              	JMP	OPMID
  166C'                         OPG_PG:
  166C'   7A                    	MOV	A,D
  166D'   B3                    	ORA	E
  166E'   C2 1687'              	JNZ	OPG_DL
  1671'   CD 0BDB'              	CALL	ATEOF		; nothing held past the cursor
  1674'   21 0000               	LXI	H,0
  1677'   DA 1645'              	JC	OPG_FN		; ... and no more to come: the file ran out
  167A'   2B                    	DCX	H
  167B'   CD 0000*              	CALL	SETC0
  167E'   CD 0000*              	CALL	GOLINE
  1681'   CD 0000*              	CALL	SCRLST		; page a step, as MKPAGE does
  1684'   C3 162B'              	JMP	OPG_NX
  1687'                         OPG_DL:
  1687'   D5                    	PUSH	D
  1688'   21 FFFF               	LXI	H,0FFFFH
  168B'   CD 0000*              	CALL	SETC0		; the count unspent: DELTO pages on behind it
  168E'   E1                    	POP	H
  168F'   E5                    	PUSH	H
  1690'   CD 0000*              	CALL	DELFWD
  1693'   D1                    	POP	D
  1694'   06 00                 	MVI	B,0
  1696'   2A 0000*              	LHLD	OPTOGO
  1699'   3A 0002*              	LDA	OPTOGO+2
  169C'   CD 137E'              	CALL	SUB24
  169F'   C3 1625'              	JMP	OPG_SV
  16A2'                         OPG_NO:
  16A2'   0E 07                 	MVI	C,BEL
  16A4'   CD 0000*              	CALL	BCONOU
  16A7'                         OPG_HM:				; the cursor back where the command found it
  16A7'   21 0000*              	LXI	H,OPSFP
  16AA'   CD 03DC'              	CALL	MKLOAD
  16AD'   CD 03A9'              	CALL	MKPAGE
  16B0'   CD 0000*              	CALL	GOTO
  16B3'   AF                    	XRA	A
  16B4'   32 0000*              	STA	PSAVE
  16B7'   3C                    	INR	A
  16B8'   32 0000*              	STA	GPKEEP		; the column it had, not the first non-blank
                                ;OPMID -- the cursor's line on the middle row and the screen drawn whole.
  16BB'                         OPMID:
  16BB'   CD 13AB'              	CALL	ZSAVE
  16BE'   C3 1480'              	JMP	GP_MID
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  16C1'                         ONWHIT:
  16C1'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  16C4'   CA 16E0'              	JZ	OW_YES
  16C7'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  16CA'   FE 20                 	CPI	' '
  16CC'   CA 16E0'              	JZ	OW_YES
  16CF'   FE 09                 	CPI	TAB
  16D1'   CA 16E0'              	JZ	OW_YES
  16D4'   FE 0D                 	CPI	CR
  16D6'   CA 16E0'              	JZ	OW_YES
  16D9'   FE 0A                 	CPI	LF
  16DB'   CA 16E0'              	JZ	OW_YES
  16DE'   B7                    	ORA	A		; a char to change: CY clear
  16DF'   C9                    	RET
  16E0'                         OW_YES:
  16E0'   37                    	STC
  16E1'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  16E2'                         OPLINE:
  16E2'   3A 0000*              	LDA	PSAVE
  16E5'   FE 63                 	CPI	'c'
  16E7'   CA 0852'              	JZ	SETMOV
  16EA'   FE 79                 	CPI	'y'
  16EC'   CA 1C79'              	JZ	VY_YY
  16EF'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  16F2'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  16F5'   C3 1BEF'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  16F8'                         OPCLS:
  16F8'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  16FA'   CA 1707'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  16FD'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  16FF'   C2 171B'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  1702'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  1704'   C3 1709'              	JMP	OPC_FK
  1707'                         OPC_SEM:
  1707'   06 00                 	MVI	B,0		; ';' runs it as it stands
  1709'                         OPC_FK:
  1709'   3A 0000*              	LDA	FNDKND
  170C'   B7                    	ORA	A
  170D'   37                    	STC
  170E'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  170F'   A8                    	XRA	B		; ... and now the direction ',' asked for
  1710'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  1712'   CA 1719'              	JZ	OPC_EXC
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1715'   3E 01                 	MVI	A,1
  1717'   B7                    	ORA	A		; CY clear: a motion, class 1
  1718'   C9                    	RET
  1719'                         OPC_EXC:
  1719'   AF                    	XRA	A		; class 0, CY clear
  171A'   C9                    	RET
  171B'                         OPC_TB:
  171B'   47                    	MOV	B,A
  171C'   21 190B'              	LXI	H,OPCTAB
  171F'                         OPC_LP:
  171F'   7E                    	MOV	A,M
  1720'   B7                    	ORA	A
  1721'   CA 1731'              	JZ	OPC_MS		; end of table -> not a motion
  1724'   B8                    	CMP	B
  1725'   CA 172D'              	JZ	OPC_HT
  1728'   23                    	INX	H
  1729'   23                    	INX	H
  172A'   C3 171F'              	JMP	OPC_LP
  172D'                         OPC_HT:
  172D'   23                    	INX	H
  172E'   7E                    	MOV	A,M		; class byte
  172F'   B7                    	ORA	A		; clear CY
  1730'   C9                    	RET
  1731'                         OPC_MS:
  1731'   37                    	STC
  1732'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  1733'                         OPAPPL:
  1733'   3A 0000*              	LDA	OPCLSV
  1736'   FE 02                 	CPI	2
  1738'   CA 18DF'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  173B'   2A 0000*              	LHLD	OPSTA
  173E'   EB                    	XCHG			; DE = start
  173F'   2A 0000*              	LHLD	OPEND2		; HL = end
  1742'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1745'   DA 1758'              	JC	OPA_F
  1748'   CA 1758'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  174B'   22 0000*              	SHLD	OPLO
  174E'   EB                    	XCHG
  174F'   22 0000*              	SHLD	OPHI
  1752'   CD 0000*              	CALL	UNDHER		; 'u' goes to where the CHANGE began, and that
  1755'   C3 180F'              	JMP	OPA_C1		;   is here, where the motion landed (vim)
  1758'                         OPA_F:
  1758'   EB                    	XCHG			; HL = start, DE = end
  1759'   22 0000*              	SHLD	OPLO
  175C'   EB                    	XCHG			; HL = end
  175D'   3A 0000*              	LDA	OPCLSV
  1760'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  1762'   CA 180C'              	JZ	OPA_JP		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  1765'   FE 01                 	CPI	1
  1767'   C2 1789'              	JNZ	OPA_EX
                                	;--- inclusive: the char the motion landed on goes too -- when there is
                                	;    one.  '$' on an empty line lands on its CR, and 'e' with no word
                                	;    left to find lands on the file's last LF; neither is a char of the
                                	;    text, and taking it leaves half a line end in the file.  So the
                                	;    span never runs past the content end of the line it landed on
                                	;    (vim: 'd$' on an empty line changes nothing, 'de' on the file's
                                	;    last char takes it and keeps the line end). ---
  176A'   23                    	INX	H		; inclusive endpoint -> hi = end+1
  176B'   22 0000*              	SHLD	OPHI		; park it: CEND clobbers DE
  176E'   2B                    	DCX	H		; the line it landed on
  176F'   CD 19CC'              	CALL	CEND		; HL = that line's content end
  1772'   EB                    	XCHG			; DE = it
  1773'   2A 0000*              	LHLD	OPHI		; HL = hi
  1776'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  1779'   D2 1794'              	JNC	OPA_HI		; hi is inside the line: keep it
  177C'   2A 0000*              	LHLD	OPLO
  177F'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1782'   CA 0000*              	JZ	GOTO		; nothing is spanned, so nothing changes: back
                                				;   to where the command started
  1785'   EB                    	XCHG			; HL = the content end: the span stops there
  1786'   C3 1794'              	JMP	OPA_HI
  1789'                         OPA_EX:
                                	;--- exclusive and forward.  A motion that came to rest on a line's
                                	;    end was pulled back onto the last char (WPULL: the command cursor
                                	;    may not sit past it), and its span runs to that line's content
                                	;    end -- 'dw' on a line's last word takes the word and not all but
                                	;    its last char.  One that was not may have stopped in a line's
                                	;    first column, which OPA_C1 sees to. ---
  1789'   22 0000*              	SHLD	OPHI
  178C'   3A 0000*              	LDA	WPULL
  178F'   B7                    	ORA	A
  1790'   CA 180F'              	JZ	OPA_C1
  1793'   23                    	INX	H
  1794'                         OPA_HI:
  1794'   22 0000*              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
                                ; A DELETE of more than one line that leaves nothing but blanks on either side
                                ; of it -- only blanks before its start, only blanks from its end to the line's
                                ; end -- takes the whole lines instead (vim's op_delete; recorded from vim 9.1:
                                ; 'd2w' from an empty line takes it and the next line's only word, lines and
                                ; all).  A change never does.
  1797'                         OPA_DO:
  1797'   CD 185B'              	CALL	OPSPNL
  179A'   7C                    	MOV	A,H
  179B'   B5                    	ORA	L
  179C'   C2 17A5'              	JNZ	OPA_D1
  179F'   2A 0000*              	LHLD	OPLO		; nothing is spanned, so nothing changes: back
  17A2'   C3 0000*              	JMP	GOTO		;   to where the span starts
  17A5'                         OPA_D1:
  17A5'   3A 0000*              	LDA	PSAVE
  17A8'   FE 63                 	CPI	'c'
  17AA'   CA 1866'              	JZ	OPDSPN
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


  17AD'   CD 184E'              	CALL	SPNBRK
  17B0'   D2 17D1'              	JNC	OPA_D2
  17B3'   2A 0000*              	LHLD	OPHI
  17B6'   CD 19CC'              	CALL	CEND
  17B9'   EB                    	XCHG			; DE = the content end of the line it ends in
  17BA'   2A 0000*              	LHLD	OPHI
  17BD'                         OPA_BL:
  17BD'   CD 0000*              	CALL	CMP16
  17C0'   CA 17D7'              	JZ	OPA_BI		; only blanks after it
  17C3'   D5                    	PUSH	D
  17C4'   E5                    	PUSH	H
  17C5'   CD 0000*              	CALL	CHARAT
  17C8'   E1                    	POP	H
  17C9'   D1                    	POP	D
  17CA'   23                    	INX	H
  17CB'   CD 1806'              	CALL	BLANKQ
  17CE'   CA 17BD'              	JZ	OPA_BL
  17D1'                         OPA_D2:
  17D1'   CD 1866'              	CALL	OPDSPN
  17D4'   C3 19DD'              	JMP	CLAMPE
  17D7'                         OPA_BI:
  17D7'   CD 17E9'              	CALL	LOIND
  17DA'   C2 17D1'              	JNZ	OPA_D2
  17DD'   2A 0000*              	LHLD	OPHI
  17E0'   CD 070F'              	CALL	NLSTART
  17E3'   22 0000*              	SHLD	OPHI
  17E6'   C3 183A'              	JMP	C1_LW
                                
                                ;LOIND -- Z iff only blanks lie before OPLO on its line.
  17E9'                         LOIND:
  17E9'   2A 0000*              	LHLD	OPLO
  17EC'   CD 0678'              	CALL	BOL
  17EF'                         LI_LP:
  17EF'   E5                    	PUSH	H
  17F0'   EB                    	XCHG
  17F1'   2A 0000*              	LHLD	OPLO
  17F4'   CD 0000*              	CALL	CMP16		; DE = the scan vs HL = lo
  17F7'   E1                    	POP	H
  17F8'   C8                    	RZ
  17F9'   E5                    	PUSH	H
  17FA'   CD 0000*              	CALL	CHARAT
  17FD'   E1                    	POP	H
  17FE'   23                    	INX	H
  17FF'   CD 1806'              	CALL	BLANKQ
  1802'   CA 17EF'              	JZ	LI_LP
  1805'   C9                    	RET
                                ;BLANKQ -- Z iff A is a space or a TAB.
  1806'                         BLANKQ:
  1806'   FE 20                 	CPI	' '
  1808'   C8                    	RZ
  1809'   FE 09                 	CPI	TAB
  180B'   C9                    	RET
                                ;OPA_C1 -- a span that crosses lines and ends in a line's FIRST column: a
                                ; backward word ('db' from the start of a line) or a jump to a mark.  vim's
                                ; rule for an exclusive motion ending there (':help exclusive'):
                                ;   * the span stops at the end of the line before -- 'db' from a line's
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


                                ;     start takes the word and leaves the line break, where taking it joined
                                ;     the two lines;
                                ;   * and if it also STARTS at or before its line's first non-blank it is a
                                ;     span of whole lines, and goes as one: indent and all, the cursor on the
                                ;     next line's first non-blank.  A change keeps the emptied line to type on.
                                ; Both recorded from vim 9.1.
  180C'                         OPA_JP:
  180C'   22 0000*              	SHLD	OPHI
  180F'                         OPA_C1:
  180F'   CD 185B'              	CALL	OPSPNL
  1812'   7C                    	MOV	A,H
  1813'   B5                    	ORA	L
  1814'   CA 1797'              	JZ	OPA_DO		; nothing spanned
  1817'   2A 0000*              	LHLD	OPHI
  181A'   CD 0678'              	CALL	BOL
  181D'   EB                    	XCHG
  181E'   2A 0000*              	LHLD	OPHI
  1821'   CD 0000*              	CALL	CMP16		; DE = that line's start vs HL = hi
  1824'   C2 1797'              	JNZ	OPA_DO		; it ends inside a line: as it stands
  1827'   CD 17E9'              	CALL	LOIND
  182A'   CA 183A'              	JZ	C1_LW		; only blanks before lo: whole lines
  182D'                         C1_CH:
  182D'   2A 0000*              	LHLD	OPHI		; back over the line break to the content end
  1830'   2B                    	DCX	H		;   of the line before
  1831'   CD 19CC'              	CALL	CEND
  1834'   22 0000*              	SHLD	OPHI
  1837'   C3 1797'              	JMP	OPA_DO
  183A'                         C1_LW:
  183A'   2A 0000*              	LHLD	OPLO
  183D'   CD 0678'              	CALL	BOL
  1840'   22 0000*              	SHLD	OPLO
  1843'   3A 0000*              	LDA	PSAVE
  1846'   FE 63                 	CPI	'c'
  1848'   CA 182D'              	JZ	C1_CH
  184B'   C3 18F2'              	JMP	OPDLIN
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  184E'                         SPNBRK:
  184E'   2A 0000*              	LHLD	OPLO
  1851'   CD 06BB'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  1854'   EB                    	XCHG			; DE = it
  1855'   2A 0000*              	LHLD	OPHI
  1858'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  185B'                         OPSPNL:
  185B'   2A 0000*              	LHLD	OPHI
  185E'   EB                    	XCHG
  185F'   2A 0000*              	LHLD	OPLO
  1862'   EB                    	XCHG			; HL = hi, DE = lo
  1863'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


                                ; No break in it: 'dw' 'cw' 'D' changed one row, and only that row is stale.
                                ; And from where the cursor was on (OPSTA: 'dw', not 'db'), the terminal may
                                ; close the cells up.
  1866'                         OPDSPN:
  1866'   CD 184E'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1869'   F5                    	PUSH	PSW
  186A'   2A 0000*              	LHLD	OPSTA
  186D'   EB                    	XCHG
  186E'   2A 0000*              	LHLD	OPLO
  1871'   22 0000*              	SHLD	WKI
  1874'   CD 0000*              	CALL	CMP16
  1877'   F5                    	PUSH	PSW		; Z: the span starts under the screen's cursor
  1878'   CD 0000*              	CALL	GOTO
  187B'   CD 185B'              	CALL	OPSPNL		; HL = hi - lo
  187E'   CD 0858'              	CALL	SETLIN
  1881'   F1                    	POP	PSW
  1882'   CC 199B'              	CZ	DCHQ
  1885'   CD 0000*              	CALL	DELFWD
  1888'   CD 0174'              	CALL	MARKMOD
  188B'   F1                    	POP	PSW
  188C'   D0                    	RNC
  188D'   C3 088F'              	JMP	SETFUL		; a break went: every row below it moved up
                                
                                ;UNDFNB -- ONE whole line is going: 'u' brings it back with the cursor on its
                                ; first non-blank, or where it is now if that is further left (vim).  Go
                                ; there, and say so; the delete starts from the line's start anyway.
  1890'                         UNDFNB:
  1890'   CD 0000*              	CALL	CUROFF
  1893'   E5                    	PUSH	H
  1894'   CD 0958'              	CALL	FNBLNK
  1897'   CD 0000*              	CALL	CUROFF
  189A'   D1                    	POP	D		; DE = where it was, HL = the first non-blank
  189B'   CD 0000*              	CALL	CMP16
  189E'   D2 0000*              	JNC	UNDHER
  18A1'   EB                    	XCHG
  18A2'   CD 0000*              	CALL	GOTO
  18A5'   C3 0000*              	JMP	UNDHER
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  18A8'                         OPALSP:
  18A8'   2A 0000*              	LHLD	OPSTA
  18AB'   EB                    	XCHG
  18AC'   2A 0000*              	LHLD	OPEND2
  18AF'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  18B2'   DA 18C2'              	JC	OPAL_F
  18B5'   22 0000*              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  18B8'   EB                    	XCHG
  18B9'   22 0000*              	SHLD	OPHI		; hi-src = start
  18BC'   CD 0000*              	CALL	UNDHER		; 'u' goes back to where the motion landed
  18BF'   C3 18CC'              	JMP	OPAL_R
  18C2'                         OPAL_F:
  18C2'   EB                    	XCHG			; HL = start
  18C3'   22 0000*              	SHLD	OPLO		; lo-src = start
  18C6'   2A 0000*              	LHLD	OPEND2
  18C9'   22 0000*              	SHLD	OPHI		; hi-src = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  18CC'                         OPAL_R:
  18CC'   2A 0000*              	LHLD	OPLO
  18CF'   CD 0678'              	CALL	BOL
  18D2'   22 0000*              	SHLD	OPLO		; lo = BOL(low line)
  18D5'   2A 0000*              	LHLD	OPHI
  18D8'   CD 070F'              	CALL	NLSTART
  18DB'   22 0000*              	SHLD	OPHI		; hi = start of line past the high line
  18DE'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  18DF'                         OPALIN:
  18DF'   CD 18A8'              	CALL	OPALSP
  18E2'   2A 0000*              	LHLD	OPLO		; ONE line?  Then 'u' brings it back as it does
  18E5'   CD 070F'              	CALL	NLSTART		;   after 'dd' (UNDFNB; two lines or more keep
  18E8'   EB                    	XCHG			;   the column)
  18E9'   2A 0000*              	LHLD	OPHI
  18EC'   CD 0000*              	CALL	CMP16
  18EF'   CC 1890'              	CZ	UNDFNB
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  18F2'                         OPDLIN:
  18F2'   CD 1866'              	CALL	OPDSPN
  18F5'   CD 0759'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  18F8'   DA 1908'              	JC	OPDL_NB
  18FB'   CD 0000*              	CALL	LOGLEN
  18FE'   7C                    	MOV	A,H
  18FF'   B5                    	ORA	L
  1900'   C8                    	RZ			; empty buffer
  1901'   2B                    	DCX	H
  1902'   CD 0678'              	CALL	BOL
  1905'   CD 0000*              	CALL	GOTO
  1908'                         OPDL_NB:
  1908'   C3 0958'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  190B'                         OPCTAB:
  190B'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  190F'   62 00 42 00           
  1913'   68 00 6C 00           
  1917'   30 00 5E 00           
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  191B'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  191D'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1921'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  1925'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1929'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  192D'   24 01                 
  192F'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  1933'   47 02 48 02           
  1937'   4D 02 4C 02           
  193B'   67 02                 	DB	'g',2		; 'gg' -- OPPEND reads the second 'g' itself
  193D'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  193F'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1940'                         VCB_C:
  1940'   CD 194C'              	CALL	VCB_CD
  1943'   C3 1A4E'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  1946'                         VCB_D:
  1946'   CD 194C'              	CALL	VCB_CD
  1949'   C3 19DD'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  194C'                         VCB_CD:
  194C'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  194F'   22 0000*              	SHLD	OPLO
  1952'   22 0000*              	SHLD	OPSTA
  1955'   CD 0000*              	CALL	CUROFF
  1958'   CD 19CC'              	CALL	CEND		; to the line's content end, the CR,LF left
  195B'   22 0000*              	SHLD	OPHI
  195E'   C3 1866'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1961'                         VC_X:
  1961'   CD 0A0A'              	CALL	GLSTAL
  1964'   CD 0858'              	CALL	SETLIN
  1967'   CD 077D'              	CALL	GETCNT
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  196A'   22 0000*              	SHLD	CNTV
  196D'   CD 0000*              	CALL	CUROFF
  1970'   22 0000*              	SHLD	WKI		; cur
  1973'   CD 19CC'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1976'   EB                    	XCHG			; DE = contentend
  1977'   2A 0000*              	LHLD	WKI		; HL = cur
  197A'   EB                    	XCHG			; HL = contentend, DE = cur
  197B'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  197E'   7C                    	MOV	A,H
  197F'   B5                    	ORA	L
  1980'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1981'   EB                    	XCHG			; DE = available
  1982'   2A 0000*              	LHLD	CNTV		; HL = count
  1985'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  1988'   DA 198E'              	JC	VX_USEA
  198B'   C3 198F'              	JMP	VX_DEL		; count <= available -> HL = count = del
  198E'                         VX_USEA:
  198E'   EB                    	XCHG			; HL = available
  198F'                         VX_DEL:
  198F'   CD 199B'              	CALL	DCHQ
  1992'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1995'   CD 0174'              	CALL	MARKMOD
  1998'   C3 19DD'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;DCHQ -- HL bytes are about to go from under the cursor, none of them a line
                                ; end, and WKI is the cursor's offset.  Plain chars, and plain chars after
                                ; them: the terminal can close the cells up itself (R_DCH).  A TAB there would
                                ; change width.  Keeps HL.
  199B'                         DCHQ:
  199B'   E5                    	PUSH	H
  199C'   CD 0895'              	CALL	TAILTAB
  199F'   E1                    	POP	H
  19A0'   47                    	MOV	B,A
  19A1'   7C                    	MOV	A,H		; (more of them than a byte counts)
  19A2'   B7                    	ORA	A
  19A3'   C0                    	RNZ
  19A4'   B5                    	ORA	L
  19A5'   C8                    	RZ			; (or none at all)
  19A6'   32 2F0A'              	STA	DCHN
  19A9'   78                    	MOV	A,B
  19AA'   87                    	ADD	A
  19AB'   32 0000*              	STA	DCHBS		; 2: a TAB follows, to take the cells up
  19AE'   CA 19C6'              	JZ	DQ_0
  19B1'   7D                    	MOV	A,L		; ... if it is past what goes, and can
  19B2'   FE 08                 	CPI	8
  19B4'   D0                    	RNC
  19B5'   E5                    	PUSH	H
  19B6'   2A 0000*              	LHLD	WKI
  19B9'   EB                    	XCHG
  19BA'   2A 0000*              	LHLD	TTI
  19BD'   CD 0000*              	CALL	SUBHD
  19C0'   EB                    	XCHG			; DE = the chars before it
  19C1'   E1                    	POP	H
  19C2'   CD 0000*              	CALL	CMP16
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  19C5'   D8                    	RC
  19C6'                         DQ_0:
  19C6'   3E 07                 	MVI	A,R_DCH
  19C8'   32 0000*              	STA	RINTENT
  19CB'   C9                    	RET
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  19CC'                         CEND:
  19CC'   CD 06BB'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  19CF'   7C                    	MOV	A,H
  19D0'   B5                    	ORA	L
  19D1'   C8                    	RZ			; the start of the text: nothing before it
  19D2'   2B                    	DCX	H
  19D3'   E5                    	PUSH	H
  19D4'   CD 0000*              	CALL	CHARAT
  19D7'   E1                    	POP	H		; HL = term-1
  19D8'   FE 0D                 	CPI	CR
  19DA'   C8                    	RZ			; a CR before the LF -> the content ends there
  19DB'   23                    	INX	H
  19DC'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  19DD'                         CLAMPE:
  19DD'   CD 0000*              	CALL	CUROFF
  19E0'   E5                    	PUSH	H
  19E1'   CD 071E'              	CALL	EOLC
  19E4'   D1                    	POP	D		; DE = cur
  19E5'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  19E8'   D8                    	RC
  19E9'   C8                    	RZ
  19EA'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  19ED'                         VC_I:
  19ED'   CD 077D'              	CALL	GETCNT
  19F0'   C3 1A4B'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  19F3'                         VC_A:
  19F3'   CD 077D'              	CALL	GETCNT
  19F6'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  19F9'   CA 1A10'              	JZ	VA_INS
  19FC'   EB                    	XCHG			; HL = cur
  19FD'   E5                    	PUSH	H
  19FE'   CD 0000*              	CALL	CHARAT
  1A01'   E1                    	POP	H
  1A02'   FE 0A                 	CPI	LF
  1A04'   CA 1A10'              	JZ	VA_INS		; on the line terminator -> append in place
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1A07'   FE 0D                 	CPI	CR
  1A09'   CA 1A10'              	JZ	VA_INS
  1A0C'   23                    	INX	H
  1A0D'   CD 0000*              	CALL	GOTO
  1A10'                         VA_INS:
  1A10'   C3 1A4B'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  1A13'                         VCB_A:
  1A13'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A16'   CD 071E'              	CALL	EOLC		; HL = last content char (the start when empty)
  1A19'   E5                    	PUSH	H
  1A1A'   CD 0000*              	CALL	CHARAT
  1A1D'   E1                    	POP	H
  1A1E'   FE 0D                 	CPI	CR
  1A20'   CA 1A29'              	JZ	VBA_IN		; an empty line: insert at its start
  1A23'   FE 0A                 	CPI	LF
  1A25'   CA 1A29'              	JZ	VBA_IN
  1A28'   23                    	INX	H		; past the last content char
  1A29'                         VBA_IN:
  1A29'   CD 0000*              	CALL	GOTO
  1A2C'   C3 1A4B'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  1A2F'                         VCB_I:
  1A2F'   CD 077D'              	CALL	GETCNT
  1A32'   CD 0958'              	CALL	FNBLNK
  1A35'   CD 0000*              	CALL	CUROFF
  1A38'   E5                    	PUSH	H
  1A39'   CD 0000*              	CALL	CHARAT
  1A3C'   E1                    	POP	H
  1A3D'   FE 20                 	CPI	' '
  1A3F'   CA 1A47'              	JZ	VBI_SK
  1A42'   FE 09                 	CPI	TAB
  1A44'   C2 1A4B'              	JNZ	SETINM
  1A47'                         VBI_SK:
  1A47'   23                    	INX	H		; blanks only: past the last of them
  1A48'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1A4B'                         SETINM:
  1A4B'   CD 0852'              	CALL	SETMOV
  1A4E'                         SETINS:
  1A4E'   3E 01                 	MVI	A,EM_INS
  1A50'   32 0000*              	STA	EDMODE
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1A53'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1A54'                         ATCEND:
  1A54'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1A57'   C8                    	RZ
  1A58'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1A5B'   FE 0D                 	CPI	CR
  1A5D'   C8                    	RZ
  1A5E'   FE 0A                 	CPI	LF
  1A60'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  1A61'                         OPNBRK:
  1A61'   CD 2386'              	CALL	PUTBRK
  1A64'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  1A67'   23                    	INX	H
  1A68'   22 0000*              	SHLD	LNDLT
  1A6B'   C3 0174'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1A6E'                         ENDBRK:
  1A6E'   CD 0759'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1A71'   C0                    	RNZ
  1A72'   CD 1A61'              	CALL	OPNBRK
  1A75'   CD 0000*              	CALL	CUROFF
  1A78'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  1A79'   2B                    	DCX	H		;   line, with its own terminator after it
  1A7A'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1A7D'                         VC_O:
  1A7D'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A80'   CD 19CC'              	CALL	CEND
  1A83'   CD 0000*              	CALL	GOTO
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1A86'   CD 1A61'              	CALL	OPNBRK
  1A89'   CD 1A6E'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1A8C'   CD 087A'              	CALL	SETILN		;   needs a terminator of its own to exist
  1A8F'   C3 1A4E'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1A92'                         VCB_O:
  1A92'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1A95'   CD 0678'              	CALL	BOL
  1A98'   CD 0000*              	CALL	GOTO
  1A9B'   CD 1A61'              	CALL	OPNBRK
  1A9E'   CD 0000*              	CALL	CUROFF
  1AA1'   2B                    	DCX	H
  1AA2'   2B                    	DCX	H
  1AA3'   CD 0000*              	CALL	GOTO
  1AA6'   CD 087A'              	CALL	SETILN
  1AA9'   C3 1A4E'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1AAC'                         VCB_J:
  1AAC'   CD 0770'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1AAF'   CD 19CC'              	CALL	CEND		; the join point: this line's content end
  1AB2'   22 0000*              	SHLD	OPLO
  1AB5'   CD 0000*              	CALL	CUROFF
  1AB8'   CD 070F'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1ABB'   E5                    	PUSH	H
  1ABC'   CD 0000*              	CALL	LOGLEN
  1ABF'   D1                    	POP	D		; DE = that start
  1AC0'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1AC3'   CA 0852'              	JZ	SETMOV
  1AC6'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  1AC7'                         VJ_WS:
  1AC7'   E5                    	PUSH	H
  1AC8'   CD 0000*              	CALL	LOGLEN
  1ACB'   D1                    	POP	D		; DE = the scan
  1ACC'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  1ACF'   CA 1AE6'              	JZ	VJ_DEL
  1AD2'   EB                    	XCHG			; HL = the scan
  1AD3'   E5                    	PUSH	H
  1AD4'   CD 0000*              	CALL	CHARAT
  1AD7'   E1                    	POP	H
  1AD8'   FE 20                 	CPI	' '
  1ADA'   CA 1AE2'              	JZ	VJ_SKIP
  1ADD'   FE 09                 	CPI	TAB
  1ADF'   C2 1AE6'              	JNZ	VJ_DEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1AE2'                         VJ_SKIP:
  1AE2'   23                    	INX	H
  1AE3'   C3 1AC7'              	JMP	VJ_WS
  1AE6'                         VJ_DEL:
  1AE6'   22 0000*              	SHLD	OPHI
  1AE9'   CD 1866'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  1AEC'   CD 0889'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  1AEF'   CD 0759'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  1AF2'   CA 19DD'              	JZ	CLAMPE
  1AF5'   CD 0764'              	CALL	CURCHR		; the first char of what was appended
  1AF8'   FE 0D                 	CPI	CR
  1AFA'   CA 19DD'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  1AFD'   FE 0A                 	CPI	LF
  1AFF'   CA 19DD'              	JZ	CLAMPE
  1B02'   FE 29                 	CPI	')'
  1B04'   CA 19DD'              	JZ	CLAMPE		; vim puts no space before a ')'
  1B07'   CD 0000*              	CALL	CUROFF
  1B0A'   7C                    	MOV	A,H
  1B0B'   B5                    	ORA	L
  1B0C'   CA 1B22'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  1B0F'   2B                    	DCX	H
  1B10'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  1B13'   FE 20                 	CPI	' '
  1B15'   CA 19DD'              	JZ	CLAMPE
  1B18'   FE 09                 	CPI	TAB
  1B1A'   CA 19DD'              	JZ	CLAMPE
  1B1D'   FE 0A                 	CPI	LF
  1B1F'   CA 19DD'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  1B22'                         VJ_SP:
  1B22'   3E 20                 	MVI	A,' '
  1B24'   CD 0000*              	CALL	PUTGAP
  1B27'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1B2A'   2B                    	DCX	H
  1B2B'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1B2E'                         VC_TILD:
  1B2E'   CD 077D'              	CALL	GETCNT
  1B31'   CD 0858'              	CALL	SETLIN		; only this row changes
  1B34'   CD 0A0A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B37'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B3A'   CA 0852'              	JZ	SETMOV
  1B3D'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1B40'   FE 0D                 	CPI	CR
  1B42'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to toggle
  1B45'   FE 0A                 	CPI	LF
  1B47'   CA 0852'              	JZ	SETMOV
  1B4A'   47                    	MOV	B,A
  1B4B'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1B4D'   FE 41                 	CPI	'A'
  1B4F'   DA 1B5B'              	JC	VT_PUT		; below 'A': no case
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1B52'   FE 5B                 	CPI	'Z'+1
  1B54'   D2 1B5B'              	JNC	VT_PUT		; above 'Z': no case
  1B57'   78                    	MOV	A,B
  1B58'   EE 20                 	XRI	20H		; a letter: flip the case bit
  1B5A'   47                    	MOV	B,A
  1B5B'                         VT_PUT:
  1B5B'   78                    	MOV	A,B
  1B5C'   32 0000*              	STA	VRCH		; the calls below do not preserve B
  1B5F'   CD 0174'              	CALL	MARKMOD
  1B62'   21 0001               	LXI	H,1
  1B65'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1B68'   3A 0000*              	LDA	VRCH
  1B6B'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1B6E'   C3 19DD'              	JMP	CLAMPE		; ... unless that was the line's last char
                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (VIC_ESC clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter.
  1B71'                         VC_R:
  1B71'   CD 076A'              	CALL	MOVCNT		; a cursor motion, and its count
  1B74'   3E 03                 	MVI	A,PR
  1B76'   32 0000*              	STA	GPEND
  1B79'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  1B7A'                         VR_DO:
  1B7A'   AF                    	XRA	A
  1B7B'   32 0000*              	STA	GPEND
  1B7E'   79                    	MOV	A,C
  1B7F'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1B82'   CD 0858'              	CALL	SETLIN		; only this row changed
  1B85'   CD 0A0A'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  1B88'   CD 0759'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1B8B'   CA 0852'              	JZ	SETMOV		; the end of the text: vim does nothing
  1B8E'   CD 0764'              	CALL	CURCHR		; A = the char under the cursor
  1B91'   FE 0D                 	CPI	CR
  1B93'   CA 0852'              	JZ	SETMOV		; the line's end: nothing to replace
  1B96'   FE 0A                 	CPI	LF
  1B98'   CA 0852'              	JZ	SETMOV
  1B9B'   06 02                 	MVI	B,2		; a cell for a cell: the char is the paint
  1B9D'   CD 085E'              	CALL	SETCEL
  1BA0'   CD 0174'              	CALL	MARKMOD
  1BA3'   21 0001               	LXI	H,1
  1BA6'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1BA9'   3A 0000*              	LDA	VRCH
  1BAC'   FE 0D                 	CPI	CR
  1BAE'   CA 1BBB'              	JZ	VR_CR
  1BB1'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1BB4'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1BB7'   2B                    	DCX	H		;   out, which moves every logical offset
  1BB8'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1BBB'                         VR_CR:
  1BBB'   CD 1A61'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  1BBE'   CD 1A6E'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1BC1'   CD 087A'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1BC4'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1BC6'   32 0000*              	STA	ILABOV
  1BC9'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  1BCA'                         VCB_R:
  1BCA'   CD 077D'              	CALL	GETCNT
  1BCD'   CD 0852'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  1BD0'   21 0000               	LXI	H,0
  1BD3'   22 0000*              	SHLD	RPDEL		; nothing of ours to put back yet
  1BD6'   22 0000*              	SHLD	RPAPP
  1BD9'   3E 02                 	MVI	A,EM_REP
  1BDB'   32 0000*              	STA	EDMODE
  1BDE'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  1BDF'                         VC_D:
  1BDF'   3E 64                 	MVI	A,'d'
  1BE1'   32 0000*              	STA	PENDOP
  1BE4'   C3 0852'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  1BE7'                         VC_C:
  1BE7'   3E 63                 	MVI	A,'c'
  1BE9'   32 0000*              	STA	PENDOP
  1BEC'   C3 0852'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  1BEF'                         VD_DD:
  1BEF'   CD 0A0A'              	CALL	GLSTAL
  1BF2'   CD 077D'              	CALL	GETCNT
  1BF5'   22 0000*              	SHLD	CNTV
  1BF8'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  1BFA'   32 0000*              	STA	DDSNG
  1BFD'   2B                    	DCX	H
  1BFE'   7C                    	MOV	A,H
  1BFF'   B5                    	ORA	L
  1C00'   C2 1C0E'              	JNZ	VDD_LS
  1C03'   3E 01                 	MVI	A,1
  1C05'   32 0000*              	STA	DDSNG
  1C08'   CD 1890'              	CALL	UNDFNB		; one line: where 'u' is to put the cursor
  1C0B'   C3 1C14'              	JMP	VDD_GO
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1C0E'                         VDD_LS:
  1C0E'   CD 09C3'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  1C11'   DA 0852'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  1C14'                         VDD_GO:
  1C14'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1C17'   21 0000*              	LXI	H,MKTAB		; the marks as they are now: a count the register
  1C1A'   11 0000*              	LXI	D,MKSAV		;   cannot hold is refused part way through, and
  1C1D'   CD 25E9'              	CALL	COPY12		;   every mark in the lines has closed up by then
  1C20'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  1C23'   2A 0000*              	LHLD	CNTV
  1C26'   CD 0000*              	CALL	SETC0
  1C29'                         VDD_FW:
  1C29'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  1C2C'   DA 1D7A'              	JC	QREFUS		; ... which has no room for them
  1C2F'   CD 0792'              	CALL	CNTTST
  1C32'   C2 1C29'              	JNZ	VDD_FW
  1C35'   CD 0174'              	CALL	MARKMOD
  1C38'   CD 0BDB'              	CALL	ATEOF
  1C3B'   D2 1C56'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  1C3E'   3E 00                 	MVI	A,0
  1C40'   32 0000*              	STA	DDSNG		; deleted to the end: full repaint
  1C43'   CD 12BB'              	CALL	ONFST
  1C46'   CA 0958'              	JZ	FNBLNK		; nothing left before it
  1C49'   21 0001               	LXI	H,1		; onto the new last line
  1C4C'   CD 0000*              	CALL	SETBWD
  1C4F'   2A 0000*              	LHLD	LNDLT
  1C52'   2B                    	DCX	H
  1C53'   22 0000*              	SHLD	LNDLT
  1C56'                         VDD_UP:
  1C56'   CD 0958'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  1C59'   3A 0000*              	LDA	DDSNG
  1C5C'   B7                    	ORA	A
  1C5D'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  1C5E'   3E 03                 	MVI	A,R_DLIN
  1C60'   32 0000*              	STA	RINTENT
  1C63'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and lines that will not fit are refused
                                ; whole (QREFUS), where WM raised a fatal 'QBUF FULL'.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1C64'                         QEMPTY:
  1C64'   2A 0000*              	LHLD	QBEG
  1C67'   EB                    	XCHG
  1C68'   2A 0000*              	LHLD	QEND
  1C6B'   7C                    	MOV	A,H
  1C6C'   BA                    	CMP	D
  1C6D'   C0                    	RNZ
  1C6E'   7D                    	MOV	A,L
  1C6F'   BB                    	CMP	E
  1C70'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
  1C71'                         VC_Y:
  1C71'   3E 79                 	MVI	A,'y'
  1C73'   32 0000*              	STA	PENDOP
  1C76'   C3 0852'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  1C79'                         VY_YY:
  1C79'   21 0000*              	LXI	H,OPSFP		; where the cursor is, for a count the register
  1C7C'   CD 0429'              	CALL	FPSTO		;   cannot hold to come back to (QREFUS)
  1C7F'   CD 0000*              	CALL	CUROFF
  1C82'   22 0000*              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1C85'   CD 0678'              	CALL	BOL
  1C88'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1C8B'   CD 1DD6'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1C8E'   CD 1E19'              	CALL	YNCOPY		; copied where they lie, if that can be done
  1C91'   D2 1DDD'              	JNC	YNDONE
  1C94'   21 1BEF'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1C97'   C3 1CC3'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1C9A'                         OPYANK:
  1C9A'   CD 18A8'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1C9D'   2A 0000*              	LHLD	OPSTA
	MACRO-80 3.44	09-Dec-81	PAGE	1-93


  1CA0'   EB                    	XCHG			; DE = start
  1CA1'   2A 0000*              	LHLD	OPEND2		; HL = end
  1CA4'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1CA7'   D2 1CAB'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1CAA'   EB                    	XCHG			; ... otherwise the start is
  1CAB'                         OPY_LO:
  1CAB'   22 0000*              	SHLD	YOFF
  1CAE'   2A 0000*              	LHLD	OPLO
  1CB1'   22 0000*              	SHLD	YPT		; where the lines come from, to put them back
  1CB4'   CD 1DD6'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1CB7'   CD 1E91'              	CALL	YNSPAN		; copied where they lie, if there is room
  1CBA'   D2 1DDD'              	JNC	YNDONE
  1CBD'   21 1DA1'              	LXI	H,YSPAN
  1CC0'   C3 1CC3'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  1CC3'                         YKGO:
  1CC3'   22 0000*              	SHLD	YACT
  1CC6'   2A 0000*              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1CC9'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
  1CCA'   2A 0000*              	LHLD	YOFF		;   survive this -- the put-back below can page
  1CCD'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  1CD0'   22 0000*              	SHLD	YCOL		;   them -- but a distance within the lines does
  1CD3'   CD 0000*              	CALL	CUROFF		; ... and where in the FILE they start: the take
  1CD6'   E5                    	PUSH	H		;   pages the window on when the count's lines
  1CD7'   2A 0000*              	LHLD	YPT		;   run past it, and YPT, an offset into the
  1CDA'   EB                    	XCHG			;   window as it was, then names other text
  1CDB'   E1                    	POP	H
  1CDC'   CD 0000*              	CALL	SUBHD
  1CDF'   EB                    	XCHG			; DE = how far behind the cursor they start
  1CE0'   CD 1388'              	CALL	CURFP
  1CE3'   06 00                 	MVI	B,0
  1CE5'   CD 137E'              	CALL	SUB24
  1CE8'   22 0000*              	SHLD	YPFP
  1CEB'   32 0002*              	STA	YPFP+2
  1CEE'   3A 0000*              	LDA	MODF
  1CF1'   32 0000*              	STA	YMODF
  1CF4'   3A 0000*              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1CF7'   32 0000*              	STA	YDCHG		;   a yank must not become the last change
  1CFA'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  1CFD'   32 0000*              	STA	YURPL		;   back are not a change to undo either
  1D00'   3E 01                 	MVI	A,1
  1D02'   32 0000*              	STA	UNDRPL
  1D05'   32 0000*              	STA	MKHOLD		; ... nor a change for a mark to follow: MKSHFT
  1D08'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  1D0B'   22 0000*              	SHLD	YLDLT
  1D0E'   CD 0000*              	CALL	LOGLEN
  1D11'   22 0000*              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  1D14'   2A 0000*              	LHLD	YACT
  1D17'   CD 1D79'              	CALL	YCALL		; the lines out of the file, into the register
  1D1A'   3A 0000*              	LDA	MSGWHT		; refused -- the register cannot hold them -- and
  1D1D'   FE 04                 	CPI	MW_BIG		;   QREFUS has put back what went and placed the
  1D1F'   CA 1D5D'              	JZ	YK_RF		;   cursor: only the flags are still owed
	MACRO-80 3.44	09-Dec-81	PAGE	1-94


  1D22'   CD 0000*              	CALL	LOGLEN
  1D25'   EB                    	XCHG
  1D26'   2A 0000*              	LHLD	YWAS
  1D29'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  1D2C'   CA 1D3E'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  1D2F'   21 0000*              	LXI	H,YPFP		; back to where they came from, by its place in
  1D32'   CD 03DC'              	CALL	MKLOAD		;   the file.  ('3000yy' at line 6000 of a 100 K
  1D35'   CD 03A9'              	CALL	MKPAGE		;   file pages 185 lines on while it takes them,
  1D38'   CD 0000*              	CALL	GOTO		;   and going back by the old offset put all 24 K
  1D3B'   CD 0000*              	CALL	QGET		;   of them in 185 lines below where they belong.)
                                	;--- Putting them back can PAGE as well: QGET splices the register
                                	;    through INSBLK, whose MKGAP reaches MKROOM when the arena is tight,
                                	;    and a spill writes the window's top out to disk.  ('500yy' at line
                                	;    2500 of a 40 K file spills 48 records and used to land the cursor
                                	;    573 lines below where it started; a yank moves the cursor nowhere.)
                                	;    So the cursor is found the same way: the lines' place in the file,
                                	;    and YCOL into them. ---
  1D3E'                         YK_FIN:				; (nothing came out: nothing went back, and the
  1D3E'   2A 0000*              	LHLD	YPFP		;   cursor is still owed its place)
  1D41'   EB                    	XCHG
  1D42'   2A 0000*              	LHLD	YCOL
  1D45'   19                    	DAD	D
  1D46'   22 0000*              	SHLD	MKPOS
  1D49'   3A 0002*              	LDA	YPFP+2
  1D4C'   CE 00                 	ACI	0
  1D4E'   32 0002*              	STA	MKPOS+2
  1D51'   CD 03A9'              	CALL	MKPAGE
  1D54'   CD 0000*              	CALL	GOTO
  1D57'                         YK_RST:
  1D57'   2A 0000*              	LHLD	YLDLT
  1D5A'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  1D5D'                         YK_RF:
  1D5D'   3A 0000*              	LDA	YMODF
  1D60'   32 0000*              	STA	MODF
  1D63'   3A 0000*              	LDA	YDCHG
  1D66'   32 0000*              	STA	DOTCHG
  1D69'   3A 0000*              	LDA	YURPL
  1D6C'   32 0000*              	STA	UNDRPL
  1D6F'   AF                    	XRA	A
  1D70'   32 0000*              	STA	MKHOLD
  1D73'   CD 0A0A'              	CALL	GLSTAL
  1D76'   C3 088F'              	JMP	SETFUL		; the cheap paint cannot carry this
  1D79'   E9                    YCALL:	PCHL
                                
                                ;QREFUS -- the yank register cannot hold the lines a 'dd' or a yank asked for
                                ; (QPUTLN's CY).  The register is a part of the arena, so that is a limit of
                                ; the machine and not an error: it used to be WordMaster's 'QBUF FULL', which
                                ; ends the editor.  What the earlier passes took is put straight back, so the
                                ; text is what it was; the marks a 'dd' closed up on the way are put back as
                                ; they were, and its part-capture is dropped so 'u' cannot replay half of a
                                ; command that did nothing.  (A yank runs under YKGO, which holds both still.)
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; The register is left EMPTY -- the lines it held went when the count began --
                                ; and the cursor goes back where it started, as OPG_NO puts it.
  1D7A'                         QREFUS:
  1D7A'   CD 0000*              	CALL	CLRCNT		; the count is spent: nothing below may page on it
  1D7D'   CD 1C64'              	CALL	QEMPTY
  1D80'   C4 0000*              	CNZ	QGET		; what went, back where it came from
  1D83'   CD 0000*              	CALL	QKILL
  1D86'   3A 0000*              	LDA	MKHOLD
  1D89'   B7                    	ORA	A
  1D8A'   C2 1D99'              	JNZ	QRF_Y
  1D8D'   21 0000*              	LXI	H,MKSAV
  1D90'   11 0000*              	LXI	D,MKTAB
  1D93'   CD 25E9'              	CALL	COPY12
  1D96'   CD 0000*              	CALL	UNDCLR
  1D99'                         QRF_Y:
  1D99'   3E 04                 	MVI	A,MW_BIG	; said once the screen is drawn (MSGPST)
  1D9B'   32 0000*              	STA	MSGWHT
  1D9E'   C3 16A7'              	JMP	OPG_HM
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the REGISTER holds the
                                ; span's length, and asks for ONE line a pass.
                                ;
                                ; The register, not the text: this loop used to stop when the text in RAM was
                                ; the span's length shorter than at the start (issue #32).  But QPUTLN's MKGAP
                                ; can page the window's top out to make room, and every record that goes takes
                                ; 128 bytes off the text that this loop never took.  With the arena nearly
                                ; full the page-outs alone went past that target, and the loop stopped after a
                                ; line, or partway through one (GOLINE stops short when the window pages): the
                                ; register held 49 bytes of a 631-byte 'y''a', and YKGO put back only those.
                                ; The register starts empty (QKILL below) and only this loop fills it, so its
                                ; length is exactly what has been taken, whatever the pager did meanwhile.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  1DA1'                         YSPAN:
  1DA1'   CD 0A0A'              	CALL	GLSTAL
  1DA4'   CD 185B'              	CALL	OPSPNL		; HL = the span's length
  1DA7'   22 0000*              	SHLD	YTGT		; what the register holds when the span is out
  1DAA'   2A 0000*              	LHLD	OPLO
  1DAD'   CD 0000*              	CALL	GOTO
  1DB0'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1DB3'                         YS_LP:
  1DB3'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  1DB6'   CD 0000*              	CALL	SETC0
  1DB9'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1DBC'   DA 1D7A'              	JC	QREFUS		; ... which has no room for it
  1DBF'   2A 0000*              	LHLD	QBEG
  1DC2'   EB                    	XCHG
  1DC3'   2A 0000*              	LHLD	QEND
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1DC6'   CD 0000*              	CALL	SUBHD
  1DC9'   EB                    	XCHG			; DE = what the register holds
  1DCA'   2A 0000*              	LHLD	YTGT
  1DCD'   CD 0000*              	CALL	CMP16		; CY iff it is short of the span: another pass
  1DD0'   DA 1DB3'              	JC	YS_LP		;   (never more than the span over whole lines)
  1DD3'   C3 0174'              	JMP	MARKMOD
                                
                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1DD6'                         YNPRE:
  1DD6'   2A 0000*              	LHLD	PGTOPM
  1DD9'   22 0000*              	SHLD	YNPG
  1DDC'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; moved, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  1DDD'                         YNDONE:
  1DDD'   2A 0000*              	LHLD	YOFF
  1DE0'   CD 0000*              	CALL	GOTO
  1DE3'   2A 0000*              	LHLD	PGTOPM
  1DE6'   EB                    	XCHG
  1DE7'   2A 0000*              	LHLD	YNPG
  1DEA'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  1DED'   C2 088F'              	JNZ	SETFUL		; it moved under us: repaint after all
  1DF0'   C3 0852'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1DF3'                         YNROOM:
  1DF3'   11 0100               	LXI	D,100H
  1DF6'   19                    	DAD	D
  1DF7'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1DF8'   E5                    	PUSH	H		; the span plus its slack
  1DF9'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  1DFC'   EB                    	XCHG			; HL = free
  1DFD'   D1                    	POP	D		; DE = the span plus its slack
  1DFE'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1E01'   DA 1E09'              	JC	YNR_OK
  1E04'   CA 1E09'              	JZ	YNR_OK
  1E07'   37                    	STC			; not enough: the delete-and-put-back path
  1E08'   C9                    	RET
  1E09'                         YNR_OK:
  1E09'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  1E0A'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  1E0B'                         YNGO:
  1E0B'   C5                    	PUSH	B
  1E0C'   CD 077D'              	CALL	GETCNT		; spent here: this yank is happening
  1E0F'   CD 0A0A'              	CALL	GLSTAL
  1E12'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1E15'   C1                    	POP	B
  1E16'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  1E19'                         YNCOPY:
  1E19'   2A 0000*              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  1E1C'   7C                    	MOV	A,H		;   the count itself
  1E1D'   B5                    	ORA	L
  1E1E'   C2 1E24'              	JNZ	YNC_HV
  1E21'   21 0001               	LXI	H,1
  1E24'                         YNC_HV:
  1E24'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  1E25'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  1E26'   B4                    	ORA	H
  1E27'   CA 1E32'              	JZ	YNC_M
  1E2A'   E5                    	PUSH	H
  1E2B'   CD 09C3'              	CALL	ONLAST		; vim: a count over one on the last line does
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1E2E'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  1E2F'   DA 1E44'              	JC	YNC_RF
  1E32'                         YNC_M:
  1E32'   E5                    	PUSH	H
  1E33'   CD 0934'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  1E36'   E1                    	POP	H
  1E37'   CD 1E4C'              	CALL	YNLINE		; BC = the span, measured where it stands
  1E3A'   D8                    	RC			; not measurable here: let the pager answer it
  1E3B'   60                    	MOV	H,B
  1E3C'   69                    	MOV	L,C
  1E3D'   CD 1DF3'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  1E40'   D8                    	RC			; no: the delete-and-put-back path
  1E41'   C3 1E0B'              	JMP	YNGO
  1E44'                         YNC_RF:
  1E44'   CD 077D'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  1E47'   CD 0A0A'              	CALL	GLSTAL		;   register alone, and that is the command
  1E4A'   B7                    	ORA	A		; NC: done
  1E4B'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  1E4C'                         YNLINE:
  1E4C'   22 0000*              	SHLD	YNCNT		; the lines it still wants
  1E4F'   2A 0000*              	LHLD	GAPEND
  1E52'                         YNL_LP:
  1E52'   EB                    	XCHG			; DE = the scan
  1E53'   2A 0000*              	LHLD	TXTEND
  1E56'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  1E59'   EB                    	XCHG			; HL = the scan
  1E5A'   D2 1E7A'              	JNC	YNL_EN		; the resident text ran out
  1E5D'   7E                    	MOV	A,M
  1E5E'   23                    	INX	H
  1E5F'   FE 0A                 	CPI	LF
  1E61'   C2 1E52'              	JNZ	YNL_LP
  1E64'   E5                    	PUSH	H
  1E65'   2A 0000*              	LHLD	YNCNT
  1E68'   2B                    	DCX	H
  1E69'   22 0000*              	SHLD	YNCNT
  1E6C'   7C                    	MOV	A,H
  1E6D'   B5                    	ORA	L
  1E6E'   E1                    	POP	H
  1E6F'   C2 1E52'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  1E72'   EB                    	XCHG			; DE = past the last of them
  1E73'   2A 0000*              	LHLD	GAPEND
  1E76'   EB                    	XCHG			; HL = past them, DE = GAPEND
  1E77'   C3 1E88'              	JMP	YNL_BC
  1E7A'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  1E7A'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  1E7D'   C2 1E8F'              	JNZ	YNL_NO		;   then what is past the window is not knowable
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1E80'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1E83'   EB                    	XCHG			;   count clamps to it as vim's does
  1E84'   2A 0000*              	LHLD	GAPEND
  1E87'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1E88'                         YNL_BC:
  1E88'   CD 0000*              	CALL	SUBHD		; HL = the span
  1E8B'   44                    	MOV	B,H
  1E8C'   4D                    	MOV	C,L
  1E8D'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  1E8E'   C9                    	RET
  1E8F'                         YNL_NO:
  1E8F'   37                    	STC
  1E90'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1E91'                         YNSPAN:
  1E91'   CD 185B'              	CALL	OPSPNL		; HL = the span's length
  1E94'   44                    	MOV	B,H
  1E95'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1E96'   CD 1DF3'              	CALL	YNROOM
  1E99'   D8                    	RC			; no room: the delete-and-put-back path
  1E9A'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  1E9B'   2A 0000*              	LHLD	OPLO
  1E9E'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1EA1'   C1                    	POP	B
  1EA2'   C3 1E0B'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1EA5'                         VC_P:
  1EA5'   CD 1C64'              	CALL	QEMPTY
  1EA8'   CA 1F7B'              	JZ	VP_BEL
  1EAB'   CD 077D'              	CALL	GETCNT
  1EAE'   22 0000*              	SHLD	PCNT
  1EB1'   CD 0000*              	CALL	CUROFF
  1EB4'   CD 070F'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1EB7'   C3 1ECC'              	JMP	VP_GO
  1EBA'                         VCB_P:
  1EBA'   CD 1C64'              	CALL	QEMPTY
  1EBD'   CA 1F7B'              	JZ	VP_BEL
  1EC0'   CD 077D'              	CALL	GETCNT
  1EC3'   22 0000*              	SHLD	PCNT
  1EC6'   CD 0000*              	CALL	CUROFF
  1EC9'   CD 0678'              	CALL	BOL
  1ECC'                         VP_GO:
  1ECC'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1ECF'   CD 0000*              	CALL	CUROFF
  1ED2'   EB                    	XCHG
  1ED3'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1ED6'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


  1ED9'   DA 1EEE'              	JC	VP_IN
  1EDC'   EB                    	XCHG			; HL = the put point = LOGLEN
  1EDD'   7C                    	MOV	A,H
  1EDE'   B5                    	ORA	L
  1EDF'   CA 1EEB'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1EE2'   2B                    	DCX	H
  1EE3'   CD 0000*              	CALL	CHARAT
  1EE6'   FE 0A                 	CPI	LF
  1EE8'   CA 1EEE'              	JZ	VP_IN
  1EEB'                         VP_BRK:
  1EEB'   CD 1A61'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  1EEE'                         VP_IN:
  1EEE'   21 0000*              	LXI	H,PPFP		; the first line put, where the cursor ends -- as
  1EF1'   CD 0429'              	CALL	FPSTO		;   a place in the FILE: a put the window cannot
  1EF4'   CD 13D1'              	CALL	GZONE		;   hold pages its own start out (and the top
                                				;   line, which GPLACE then wants, with it)
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1EF7'   2A 0000*              	LHLD	QBEG
  1EFA'   EB                    	XCHG
  1EFB'   2A 0000*              	LHLD	QEND
  1EFE'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  1F01'   EB                    	XCHG
  1F02'   22 0000*              	SHLD	PLFS
  1F05'   2A 0000*              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1F08'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1F09'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1F0A'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  1F0C'   C2 1F10'              	JNZ	VP_PZ
  1F0F'   7D                    	MOV	A,L
  1F10'                         VP_PZ:
  1F10'   32 0000*              	STA	PCPY
  1F13'                         VP_LP:
  1F13'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1F16'   2A 0000*              	LHLD	LNDLT
  1F19'   EB                    	XCHG
  1F1A'   2A 0000*              	LHLD	PLFS
  1F1D'   19                    	DAD	D
  1F1E'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  1F21'   2A 0000*              	LHLD	PCNT
  1F24'   2B                    	DCX	H
  1F25'   22 0000*              	SHLD	PCNT
  1F28'   7C                    	MOV	A,H
  1F29'   B5                    	ORA	L
  1F2A'   C2 1F13'              	JNZ	VP_LP
  1F2D'   CD 0174'              	CALL	MARKMOD
  1F30'   21 0000*              	LXI	H,PPFP
  1F33'   CD 03DC'              	CALL	MKLOAD
  1F36'   CD 03E9'              	CALL	MKWIN		; CY and HL = where it is, if still in the window
  1F39'   D2 1F6C'              	JNC	VP_PGD
  1F3C'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  1F3F'   CD 0A0A'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  1F42'   3A 0000*              	LDA	PCPY
  1F45'   B7                    	ORA	A
  1F46'   CA 0958'              	JZ	FNBLNK
  1F49'   2A 0000*              	LHLD	PLFS
  1F4C'   7C                    	MOV	A,H
  1F4D'   B7                    	ORA	A
  1F4E'   C2 0958'              	JNZ	FNBLNK
  1F51'   3A 0000*              	LDA	PCPY
  1F54'   CD 1083'              	CALL	MULSAT		; HL = the lines this put put, saturated
  1F57'   7C                    	MOV	A,H
  1F58'   B7                    	ORA	A
  1F59'   C2 0958'              	JNZ	FNBLNK
  1F5C'   7D                    	MOV	A,L
  1F5D'   B7                    	ORA	A
  1F5E'   CA 0958'              	JZ	FNBLNK
  1F61'   F5                    	PUSH	PSW
  1F62'   CD 087A'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  1F65'   F1                    	POP	PSW
  1F66'   32 2F09'              	STA	ILN		; ... which the lines put now replace
  1F69'   C3 0958'              	JMP	FNBLNK
  1F6C'                         VP_PGD:				; the put paged its first line out: page back
  1F6C'   CD 03A9'              	CALL	MKPAGE		;   to it, and place it as a jump is placed
  1F6F'   CD 0000*              	CALL	GOTO
  1F72'   CD 0A0A'              	CALL	GLSTAL
  1F75'   CD 13E9'              	CALL	GPLACE
  1F78'   C3 088F'              	JMP	SETFUL		; ... but every row below it is new, even when
                                				;   GPLACE finds the top line where it was
  1F7B'                         VP_BEL:
  1F7B'   CD 077D'              	CALL	GETCNT		; the count is spent either way
  1F7E'   0E 07                 	MVI	C,BEL
  1F80'   CD 0000*              	CALL	BCONOU
  1F83'   C3 0852'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  C = the key.
  1F86'                         VIREP:
  1F86'   79                    	MOV	A,C
  1F87'   FE 1B                 	CPI	ESC
  1F89'   CA 20DC'              	JZ	VI_ESC		; ESC: command mode, the cursor steps left
  1F8C'   FE 0D                 	CPI	CR
  1F8E'   CA 2001'              	JZ	VP_CR
  1F91'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  1F93'   CA 2001'              	JZ	VP_CR
  1F96'   FE 08                 	CPI	BS
  1F98'   CA 200D'              	JZ	VP_BS
  1F9B'   FE 7F                 	CPI	DEL
  1F9D'   CA 200D'              	JZ	VP_BS
  1FA0'   32 0000*              	STA	VRCH		; the calls below do not preserve C
  1FA3'   CD 0858'              	CALL	SETLIN		; this row changed
  1FA6'   CD 0174'              	CALL	MARKMOD
  1FA9'   CD 1A54'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1FAC'   CA 1FEC'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1FAF'   CD 0764'              	CALL	CURCHR
  1FB2'   06 01                 	MVI	B,1
  1FB4'   CD 085E'              	CALL	SETCEL
  1FB7'   3A 0000*              	LDA	VRCH
  1FBA'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  1FBD'   2A 0000*              	LHLD	RPDEL
  1FC0'   7C                    	MOV	A,H
  1FC1'   B5                    	ORA	L
  1FC2'   CA 1FD8'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1FC5'   2A 0000*              	LHLD	GAPEND
  1FC8'   EB                    	XCHG
  1FC9'   2A 0000*              	LHLD	RPGE
  1FCC'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1FCF'   CA 1FD8'              	JZ	VP_OVW
  1FD2'   21 0000               	LXI	H,0
  1FD5'   22 0000*              	SHLD	RPDEL		; the text moved: those originals are gone
  1FD8'                         VP_OVW:
  1FD8'   21 0001               	LXI	H,1
  1FDB'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1FDE'   2A 0000*              	LHLD	GAPEND
  1FE1'   22 0000*              	SHLD	RPGE
  1FE4'   2A 0000*              	LHLD	RPDEL
  1FE7'   23                    	INX	H
  1FE8'   22 0000*              	SHLD	RPDEL
  1FEB'   C9                    	RET
  1FEC'                         VP_APP:
  1FEC'   3E 20                 	MVI	A,' '		; (the cell there is blank)
  1FEE'   06 01                 	MVI	B,1
  1FF0'   CD 085E'              	CALL	SETCEL
  1FF3'   3A 0000*              	LDA	VRCH
  1FF6'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1FF9'   2A 0000*              	LHLD	RPAPP
  1FFC'   23                    	INX	H
  1FFD'   22 0000*              	SHLD	RPAPP
  2000'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


  2001'                         VP_CR:
  2001'   21 0000               	LXI	H,0
  2004'   22 0000*              	SHLD	RPDEL		; a line break ends what BS can put back
  2007'   22 0000*              	SHLD	RPAPP
  200A'   C3 2098'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  200D'                         VP_BS:
  200D'   2A 0000*              	LHLD	RPAPP
  2010'   7C                    	MOV	A,H
  2011'   B5                    	ORA	L
  2012'   CA 201F'              	JZ	VP_BSD
  2015'   2B                    	DCX	H
  2016'   22 0000*              	SHLD	RPAPP		; an appended char: it just goes
  2019'   CD 0858'              	CALL	SETLIN
  201C'   C3 0000*              	JMP	DELPRV
  201F'                         VP_BSD:
  201F'   2A 0000*              	LHLD	RPDEL
  2022'   7C                    	MOV	A,H
  2023'   B5                    	ORA	L
  2024'   CA 204B'              	JZ	VP_BSM		; nothing of ours left
  2027'   2A 0000*              	LHLD	GAPEND
  202A'   EB                    	XCHG
  202B'   2A 0000*              	LHLD	RPGE
  202E'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  2031'   C2 204B'              	JNZ	VP_BSM
  2034'   2A 0000*              	LHLD	RPDEL
  2037'   2B                    	DCX	H
  2038'   22 0000*              	SHLD	RPDEL
  203B'   CD 0858'              	CALL	SETLIN
  203E'   CD 0000*              	CALL	DELPRV		; the typed char goes
  2041'   CD 0000*              	CALL	UNDELF		; the original comes back
  2044'   2A 0000*              	LHLD	GAPEND
  2047'   22 0000*              	SHLD	RPGE
  204A'   C9                    	RET
  204B'                         VP_BSM:
  204B'   CD 0852'              	CALL	SETMOV		; nothing changed: back over the text as it is
  204E'   C3 08E0'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  C = the key.
  2051'                         VIINS:
  2051'   79                    	MOV	A,C
  2052'   FE 1B                 	CPI	ESC
  2054'   CA 20DC'              	JZ	VI_ESC
  2057'   FE 0D                 	CPI	CR
  2059'   CA 2098'              	JZ	VI_CR
  205C'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  205E'   CA 2098'              	JZ	VI_CR
  2061'   FE 08                 	CPI	BS
  2063'   CA 20B0'              	JZ	VI_BS
  2066'   FE 7F                 	CPI	DEL
  2068'   CA 20B0'              	JZ	VI_BS
  206B'   79                    	MOV	A,C
  206C'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  206F'   CD 0174'              	CALL	MARKMOD
  2072'   CD 0858'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


                                	;--- can the cheaper ICH be used?  Only for a plain printable char.  With
                                	;    a TAB after the cursor nothing past the TAB moves, so long as the
                                	;    TAB can give the cell up: the chars as far as it are the paint. ---
  2075'   79                    	MOV	A,C
  2076'   FE 20                 	CPI	' '
  2078'   D8                    	RC			; control char -> keep R_LINE
  2079'   FE 7F                 	CPI	DEL
  207B'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  207C'   CD 0895'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  207F'   47                    	MOV	B,A
  2080'   3E 04                 	MVI	A,R_ICH
  2082'   32 0000*              	STA	RINTENT
  2085'   3E 03                 	MVI	A,3		; a TAB there: it takes the cell up if it can
  2087'   05                    	DCR	B		;   (SCRN.MAC knows where it stands)
  2088'   CA 2094'              	JZ	VI_ICH
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  208B'   CD 1A54'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
  208E'   3E 00                 	MVI	A,0
  2090'   C2 2094'              	JNZ	VI_ICH
  2093'   3C                    	INR	A
  2094'                         VI_ICH:
  2094'   32 0000*              	STA	ICHAPP
  2097'   C9                    	RET
  2098'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  2098'   CD 1A54'              	CALL	ATCEND
  209B'   3E 00                 	MVI	A,0
  209D'   CA 20A1'              	JZ	VI_CRS
  20A0'   3C                    	INR	A
  20A1'                         VI_CRS:
  20A1'   F5                    	PUSH	PSW
  20A2'   CD 1A61'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  20A5'   CD 1A6E'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  20A8'   CD 087A'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  20AB'   F1                    	POP	PSW
  20AC'   32 0000*              	STA	ILABOV
  20AF'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  20B0'                         VI_BS:
  20B0'   CD 0000*              	CALL	PEEKL
  20B3'   D8                    	RC			; start of the file: nothing to delete
  20B4'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  20B6'   CA 20D6'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  20B9'   47                    	MOV	B,A		;   and the screen repaints in full.  Any other
  20BA'   CD 0858'              	CALL	SETLIN		;   char is inside the row -- redraw just that row
  20BD'   78                    	MOV	A,B
  20BE'   CD 0873'              	CALL	PLAINQ		; ... or, when it is one cell and no TAB follows
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  20C1'   D2 20D6'              	JNC	VI_BSJ		;   to be drawn up short, let the terminal close
  20C4'   CD 0895'              	CALL	TAILTAB		;   the cell up (R_DCH, from the left of the
  20C7'   87                    	ADD	A		;   cursor) -- or the TAB that follows take it
  20C8'   3C                    	INR	A
  20C9'   32 0000*              	STA	DCHBS		; 1, and 2 with it for the TAB
  20CC'   3E 01                 	MVI	A,1
  20CE'   32 2F0A'              	STA	DCHN
  20D1'   3E 07                 	MVI	A,R_DCH
  20D3'   32 0000*              	STA	RINTENT
  20D6'                         VI_BSJ:
  20D6'   CD 0174'              	CALL	MARKMOD
  20D9'   C3 0000*              	JMP	DELPRV
                                ;VI_ESC -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  20DC'                         VI_ESC:
  20DC'   3E 00                 	MVI	A,EM_CMD
  20DE'   32 0000*              	STA	EDMODE
  20E1'   CD 0852'              	CALL	SETMOV
  20E4'   CD 08E0'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  20E7'   C3 0A0A'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  20EA'                         RDLINE:
  20EA'   EB                    	XCHG			; HL = buffer
  20EB'   22 0000*              	SHLD	RLPTR
  20EE'   3E 00                 	MVI	A,0
  20F0'   32 0000*              	STA	RLLEN
  20F3'   78                    	MOV	A,B
  20F4'   32 0000*              	STA	RLMAX
  20F7'   79                    	MOV	A,C
  20F8'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  20FB'                         RL_LP:
  20FB'   CD 0000*              	CALL	GETKEY
  20FE'   FE 1B                 	CPI	ESC
  2100'   CA 2150'              	JZ	RL_CAN
  2103'   FE 0D                 	CPI	CR
  2105'   CA 215B'              	JZ	RL_DONE
  2108'   FE 08                 	CPI	BS
  210A'   CA 2138'              	JZ	RL_BS
  210D'   FE 7F                 	CPI	DEL
  210F'   CA 2138'              	JZ	RL_BS
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2112'   FE 20                 	CPI	' '
  2114'   DA 20FB'              	JC	RL_LP		; control char -> ignore
  2117'   3A 0000*              	LDA	RLLEN
  211A'   47                    	MOV	B,A
  211B'   3A 0000*              	LDA	RLMAX
  211E'   B8                    	CMP	B
  211F'   CA 20FB'              	JZ	RL_LP		; full -> ignore
  2122'   2A 0000*              	LHLD	RLPTR
  2125'   71                    	MOV	M,C
  2126'   23                    	INX	H
  2127'   22 0000*              	SHLD	RLPTR
  212A'   3A 0000*              	LDA	RLLEN
  212D'   3C                    	INR	A
  212E'   32 0000*              	STA	RLLEN
  2131'   79                    	MOV	A,C
  2132'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  2135'   C3 20FB'              	JMP	RL_LP
  2138'                         RL_BS:				; WM LINEPOP
  2138'   3A 0000*              	LDA	RLLEN
  213B'   B7                    	ORA	A
  213C'   CA 2150'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  213F'   3D                    	DCR	A
  2140'   32 0000*              	STA	RLLEN
  2143'   2A 0000*              	LHLD	RLPTR
  2146'   2B                    	DCX	H
  2147'   22 0000*              	SHLD	RLPTR
  214A'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  214D'   C3 20FB'              	JMP	RL_LP
  2150'                         RL_CAN:
  2150'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  2152'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  2155'   CD 0858'              	CALL	SETLIN		; redraw one row
  2158'   3E FF                 	MVI	A,0FFH		; cancelled
  215A'   C9                    	RET
  215B'                         RL_DONE:
  215B'   3E 0D                 	MVI	A,CR		; vim: the cursor waits under the prompt while
  215D'   CD 0000*              	CALL	OUTCH		;   the command runs, not after its last char
  2160'   AF                    	XRA	A
  2161'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.
  2162'                         VC_BZ:
  2162'   CD 0852'              	CALL	SETMOV
  2165'   3A 0000*              	LDA	GSAVE
  2168'   FE 02                 	CPI	PZ
  216A'   CA 2175'              	JZ	VZ_ZZ
  216D'   B7                    	ORA	A
  216E'   C0                    	RNZ			; 'g' was pending: vim drops both
  216F'   3E 02                 	MVI	A,PZ
  2171'   32 0000*              	STA	GPEND
  2174'   C9                    	RET
  2175'                         VZ_ZZ:
  2175'   3E 04                 	MVI	A,EO_X
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2177'   32 0000*              	STA	EXOP
  217A'   3E 01                 	MVI	A,1
  217C'   32 0000*              	STA	EXBANG		; no '!'
  217F'   AF                    	XRA	A
  2180'   32 0000*              	STA	EXARG		; no file name
  2183'   3A 0000*              	LDA	MODF		; as ':x': a changed text is written first
  2186'   B7                    	ORA	A
  2187'   CA 22C8'              	JZ	EX_Q
  218A'   C3 2262'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :N,Mw name  write lines N to M to a file of their own (EX_WR)
                                ;   :[N]r name  read a file in below the cursor's line, or line N (EX_R)
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
  218D'                         VC_EX:
  218D'   CD 077D'              	CALL	GETCNT
  2190'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  2193'   11 0000*              	LXI	D,EXBUF
  2196'   06 28                 	MVI	B,EXMAX
  2198'   0E 3A                 	MVI	C,':'
  219A'   CD 20EA'              	CALL	RDLINE
  219D'   B7                    	ORA	A
  219E'   C0                    	RNZ			; cancelled
  219F'   3A 0000*              	LDA	RLLEN
  21A2'   5F                    	MOV	E,A
  21A3'   16 00                 	MVI	D,0
  21A5'   21 0000*              	LXI	H,EXBUF
  21A8'   19                    	DAD	D
  21A9'   36 00                 	MVI	M,0		; the line ends with a 0
  21AB'   21 0000*              	LXI	H,EXBUF
  21AE'   CD 277A'              	CALL	SKIPB
  21B1'   C8                    	RZ			; nothing on it
  21B2'   22 0000*              	SHLD	EXCMD
  21B5'   CD 297E'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  21B8'   CD 277A'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  21BB'   56                    	MOV	D,M
  21BC'   23                    	INX	H
  21BD'   1E 00                 	MVI	E,0
  21BF'   CD 2786'              	CALL	ISLOW
  21C2'   DA 21CD'              	JC	EX_LK
  21C5'   5F                    	MOV	E,A
  21C6'   23                    	INX	H
  21C7'   CD 2786'              	CALL	ISLOW
  21CA'   D2 21E6'              	JNC	EX_NOT		; a third letter: none of ours
  21CD'                         EX_LK:
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  21CD'   E5                    	PUSH	H
  21CE'   21 2965'              	LXI	H,EXTAB
  21D1'                         EX_TL:
  21D1'   7E                    	MOV	A,M
  21D2'   B7                    	ORA	A
  21D3'   CA 21E5'              	JZ	EX_NTP		; not in the table
  21D6'   23                    	INX	H
  21D7'   BA                    	CMP	D
  21D8'   7E                    	MOV	A,M
  21D9'   23                    	INX	H
  21DA'   C2 21E1'              	JNZ	EX_TN
  21DD'   BB                    	CMP	E
  21DE'   CA 21EC'              	JZ	EX_TF
  21E1'                         EX_TN:
  21E1'   23                    	INX	H
  21E2'   C3 21D1'              	JMP	EX_TL
  21E5'                         EX_NTP:
  21E5'   E1                    	POP	H
  21E6'                         EX_NOT:
  21E6'   21 283E'              	LXI	H,SNOT
  21E9'   C3 27BB'              	JMP	EXERT
  21EC'                         EX_TF:
  21EC'   7E                    	MOV	A,M
  21ED'   32 0000*              	STA	EXOP
  21F0'   E1                    	POP	H
  21F1'   FE 06                 	CPI	EO_S
  21F3'   CA 29ED'              	JZ	EX_S		; ':s' reads the rest of the line itself
  21F6'   FE 01                 	CPI	EO_W
  21F8'   CA 2207'              	JZ	EX_RG		; ':N,Mw name' takes a range
  21FB'   FE 08                 	CPI	EO_R
  21FD'   CA 2207'              	JZ	EX_RG		; ... and ':Nr name' a line
  2200'   3A 0000*              	LDA	SRNGF
  2203'   B7                    	ORA	A
  2204'   C2 21E6'              	JNZ	EX_NOT		; a range on a command that does not take one
  2207'                         EX_RG:
                                	;--- '!', then the file name ---
  2207'   7E                    	MOV	A,M
  2208'   D6 21                 	SUI	'!'
  220A'   32 0000*              	STA	EXBANG		; 0 = '!'
  220D'   C2 2211'              	JNZ	EX_NB
  2210'   23                    	INX	H
  2211'                         EX_NB:
  2211'   CD 277A'              	CALL	SKIPB
  2214'   32 0000*              	STA	EXARG		; 0 = no file name
  2217'   CA 2230'              	JZ	EX_RUN
  221A'   22 0000*              	SHLD	EXCMD
  221D'   3A 0000*              	LDA	EXOP
  2220'   FE 02                 	CPI	EO_Q
  2222'   CA 27B8'              	JZ	EX_TRL		; :q takes none
  2225'   FE 07                 	CPI	EO_V
  2227'   CA 27B8'              	JZ	EX_TRL		; nor :ve
  222A'   CD 26E4'              	CALL	PARSFN
  222D'   C2 27AC'              	JNZ	EX_INV
  2230'                         EX_RUN:
  2230'   3A 0000*              	LDA	EXOP
  2233'   FE 05                 	CPI	EO_E
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


  2235'   CA 22DF'              	JZ	EX_E
  2238'   FE 02                 	CPI	EO_Q
  223A'   CA 22C8'              	JZ	EX_Q
  223D'   FE 07                 	CPI	EO_V
  223F'   CA 27B2'              	JZ	EX_V
  2242'   FE 08                 	CPI	EO_R
  2244'   CA 2470'              	JZ	EX_R
  2247'   FE 04                 	CPI	EO_X
  2249'   CA 225B'              	JZ	EX_XM
  224C'   FE 01                 	CPI	EO_W
  224E'   C2 2262'              	JNZ	EX_W		; :wq
  2251'   3A 0000*              	LDA	SRNGF		; (tested here and not in EX_W: ZZ comes in
  2254'   B7                    	ORA	A		;   there with whatever range the last ':' left)
  2255'   C2 2390'              	JNZ	EX_WR		; ':N,Mw name': those lines only
  2258'   C3 2262'              	JMP	EX_W
  225B'                         EX_XM:
  225B'   3A 0000*              	LDA	MODF		; :x writes only a changed text
  225E'   B7                    	ORA	A
  225F'   CA 22C8'              	JZ	EX_Q
  2262'                         EX_W:
  2262'   CD 2550'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  2265'   D8                    	RC			; refused (message shown)
  2266'   32 0000*              	STA	EXBAK
  2269'   3A 0000*              	LDA	EXOP
  226C'   FE 01                 	CPI	EO_W
  226E'   CA 2285'              	JZ	EX_WK
  2271'   3A 0000*              	LDA	EXBAK
  2274'   B7                    	ORA	A
  2275'   C2 22C5'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  2278'   3A 0000*              	LDA	EXBANG
  227B'   B7                    	ORA	A
  227C'   CA 22C5'              	JZ	EX_WQ		; so it does with '!'
  227F'   CD 2285'              	CALL	EX_WK		; else it may not: keep the text
  2282'   C3 22C8'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  2285'                         EX_WK:
  2285'   CD 0EBF'              	CALL	CURRW		; the cursor's row and file position
  2288'   32 0000*              	STA	WPROW
  228B'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  228E'   7D                    	MOV	A,L
  228F'   E6 7F                 	ANI	7FH
  2291'   32 0000*              	STA	WPBYT
  2294'   7D                    	MOV	A,L
  2295'   17                    	RAL
  2296'   7C                    	MOV	A,H
  2297'   17                    	RAL
  2298'   5F                    	MOV	E,A
  2299'   3E 00                 	MVI	A,0
  229B'   17                    	RAL
  229C'   57                    	MOV	D,A		; DE = HL / 128
  229D'   2A 0000*              	LHLD	OUTPOS
  22A0'   19                    	DAD	D
  22A1'   22 0000*              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  22A4'   CD 2585'              	CALL	WRITE
  22A7'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  22AA'   2A 0000*              	LHLD	WPREC
	MACRO-80 3.44	09-Dec-81	PAGE	1-110


  22AD'   EB                    	XCHG
  22AE'   3A 0000*              	LDA	WPBYT
  22B1'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  22B4'   CD 0000*              	CALL	GOTO
  22B7'                         EX_WRW:
  22B7'   21 0000               	LXI	H,0
  22BA'   22 0000*              	SHLD	LNDLT
  22BD'   3A 0000*              	LDA	WPROW
  22C0'   6F                    	MOV	L,A
  22C1'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  22C4'   C9                    	RET
  22C5'                         EX_WQ:
  22C5'   CD 2585'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  22C8'                         EX_Q:
  22C8'   3A 0000*              	LDA	EXBANG
  22CB'   B7                    	ORA	A
  22CC'   CA 22D6'              	JZ	EX_QT
  22CF'   3A 0000*              	LDA	MODF
  22D2'   B7                    	ORA	A
  22D3'   C2 27A0'              	JNZ	MSGNWR		; changed, no '!': stay
  22D6'                         EX_QT:
  22D6'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  22D9'   3E 01                 	MVI	A,1
  22DB'   32 0000*              	STA	QUITF
  22DE'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  22DF'                         EX_E:
  22DF'   3A 0000*              	LDA	EXBANG
  22E2'   B7                    	ORA	A
  22E3'   CA 22ED'              	JZ	EE_GO
  22E6'   3A 0000*              	LDA	MODF
  22E9'   B7                    	ORA	A
  22EA'   C2 27A0'              	JNZ	MSGNWR
  22ED'                         EE_GO:
  22ED'   3A 0000*              	LDA	EXARG
  22F0'   B7                    	ORA	A
  22F1'   C2 22F8'              	JNZ	EE_ARG
  22F4'   CD 25C1'              	CALL	OWNTF		; no name: the buffer's own
  22F7'   D8                    	RC
  22F8'                         EE_ARG:
  22F8'   CD 25D7'              	CALL	ISOWN
  22FB'   21 0001               	LXI	H,1
  22FE'   C2 2305'              	JNZ	EE_LD		; another file: its first line
  2301'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  2304'   23                    	INX	H		; HL = the cursor's line
  2305'                         EE_LD:
  2305'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  2307'   32 0000*              	STA	MSGWHT
  230A'   E5                    	PUSH	H
  230B'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  230E'   21 0000*              	LXI	H,TFCB
  2311'   11 0000*              	LXI	D,FNAME
  2314'   CD 25E9'              	CALL	COPY12		; the buffer's name
	MACRO-80 3.44	09-Dec-81	PAGE	1-111


  2317'   CD 25AE'              	CALL	SRCTF
  231A'   CD 0000*              	CALL	REOPEN
  231D'   CD 01EC'              	CALL	MKCLR		; the marks named the buffer that just went
  2320'   AF                    	XRA	A
  2321'   32 0000*              	STA	MODF
  2324'   E1                    	POP	H
  2325'   2B                    	DCX	H
  2326'   AF                    	XRA	A
  2327'   CD 0000*              	CALL	MVLIND		; down to the line
  232A'   CD 0BDB'              	CALL	ATEOF
  232D'   DC 0BE1'              	CC	LASTLN		; past the last line: onto it
  2330'   CD 13AB'              	CALL	ZSAVE
  2333'   C3 1480'              	JMP	GP_MID
                                
                                ;============================================================
                                ; A BLOCK THROUGH A FILE  (:N,Mw name   :[N]r name)
                                ;
                                ; The yank register lives in the text's own arena: it tops out near 23 K, and
                                ; every byte it holds is a byte the window loses.  A block past that is moved
                                ; the way vi has always moved one -- written to a file the user names and read
                                ; back in somewhere else.  Neither command touches the register or the arena:
                                ; both stream through the pager a record at a time, so the size is the disk's
                                ; to limit, and the block outlives ':e' besides.
                                ;
                                ; Both use TFCB and the default record at 0080H, which nothing else holds once
                                ; ARGSCN has read the command line out of it.  The pager points the DMA at the
                                ; text it is moving, so TFDOS sets it back before every call of its own.
                                ;
                                ; Recorded from vim before any of this was written (VIM_RDWR, accept_vi.py):
                                ;   - a ranged write moves nothing: the cursor and the window are as they were.
                                ;   - ':r' puts the text in BELOW the cursor's line and lands on the first line
                                ;     read, on its first non-blank; ':Nr' below line N, ':0r' above line 1.
                                ;     The window is placed as a jump to that line is (GZONE / GPLACE).
                                ;   - a file that ends without a line end still reads in as whole lines, and
                                ;     below a last line that has no line end the missing break goes in first.
                                ;   - a file that is not there, or a line the text has not got, changes
                                ;     nothing and moves nothing.
                                ; Where this is NOT vim (COMMANDS.md has each): the ranged write never goes to
                                ; the buffer's own file, '!' or not -- the pager is still reading it; ':r'
                                ; with no name reads nothing; and a write whose last line is past the end of
                                ; the text stops at the end instead of refusing.
                                ;============================================================
                                
                                ;TFDOS -- BDOS function C on TFCB, its record the one at 0080H.  A = the answer.
  2336'                         TFDOS:
  2336'   C5                    	PUSH	B
  2337'   11 0080               	LXI	D,CMDTAIL
  233A'   0E 1A                 	MVI	C,1AH		; set the DMA
  233C'   CD 0005               	CALL	BDOS
  233F'   C1                    	POP	B
  2340'   11 0000*              	LXI	D,TFCB
  2343'   C3 0005               	JMP	BDOS
                                
                                ;EXRNG -- SLINES = the lines in the range SRNG1..SRNG2.  CY: there is no line
                                ; 0, and a range that runs backwards is refused (vim offers to swap it).
  2346'                         EXRNG:
	MACRO-80 3.44	09-Dec-81	PAGE	1-112


  2346'   2A 0000*              	LHLD	SRNG1
  2349'   7C                    	MOV	A,H
  234A'   B5                    	ORA	L
  234B'   37                    	STC
  234C'   C8                    	RZ
  234D'   2A 0000*              	LHLD	SRNG2
  2350'   EB                    	XCHG
  2351'   2A 0000*              	LHLD	SRNG1
  2354'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  2357'   D8                    	RC
  2358'   EB                    	XCHG			; HL = the last line, DE = the first
  2359'   CD 0000*              	CALL	SUBHD
  235C'   23                    	INX	H
  235D'   22 0000*              	SHLD	SLINES
  2360'   B7                    	ORA	A		; (SUBHD's DAD leaves the carry set)
  2361'   C9                    	RET
                                
                                ;GOLNX -- GOLN, and Z iff the text HAS a line HL: GOLN stops on the last line
                                ; when it has not.
  2362'                         GOLNX:
  2362'   E5                    	PUSH	H
  2363'   CD 133F'              	CALL	GOLN
  2366'   CD 0000*              	CALL	CNTLF
  2369'   23                    	INX	H		; the line the cursor came to rest on
  236A'   D1                    	POP	D
  236B'   C3 0000*              	JMP	CMP16
                                
                                ;EXSAVP / EXRSTP -- where the cursor is, as a place in the FILE and a row on
                                ; the screen, and back to it: the window may page any distance in between.
  236E'                         EXSAVP:
  236E'   CD 0EBF'              	CALL	CURRW
  2371'   32 0000*              	STA	WPROW
  2374'   21 0000*              	LXI	H,MKPOS
  2377'   C3 0429'              	JMP	FPSTO
  237A'                         EXRSTP:
  237A'   CD 0000*              	CALL	CLRCNT
  237D'   CD 03A9'              	CALL	MKPAGE		; page until that place is in the window again
  2380'   CD 0000*              	CALL	GOTO
  2383'   C3 22B7'              	JMP	EX_WRW		; ... and its line back on its row
                                
                                ;PUTBRK -- a line end (CR, LF) in at the cursor.
  2386'                         PUTBRK:
  2386'   3E 0D                 	MVI	A,CR
  2388'   CD 0000*              	CALL	PUTGAP
  238B'   3E 0A                 	MVI	A,LF
  238D'   C3 0000*              	JMP	PUTGAP
                                
                                ;EX_WR -- ':N,Mw name': lines N to M to a file of their own.  The walk is WM's
                                ; whole-file line move (GOLINE to the window's edge, SCRLST to page a step) with
                                ; the text it steps over copied out on the way, so it costs what moving there
                                ; costs.  A file of that name is refused without '!'; the buffer's own always.
  2390'                         EX_WR:
  2390'   3A 0000*              	LDA	EXARG
  2393'   B7                    	ORA	A
  2394'   CA 278E'              	JZ	MSGNFN		; No file name
  2397'   CD 25D7'              	CALL	ISOWN
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


  239A'   CA 243A'              	JZ	EXW_OW
  239D'   CD 0000*              	CALL	TEXIST
  23A0'   32 0000*              	STA	RWERR		; nonzero: a file of that name is there
  23A3'   CA 23AD'              	JZ	EXW_GO
  23A6'   3A 0000*              	LDA	EXBANG
  23A9'   B7                    	ORA	A
  23AA'   C2 2794'              	JNZ	MSGEXI		; File exists (! to force)
  23AD'                         EXW_GO:
  23AD'   CD 2346'              	CALL	EXRNG
  23B0'   DA 2434'              	JC	EXW_BD
  23B3'   CD 236E'              	CALL	EXSAVP
  23B6'   2A 0000*              	LHLD	SRNG1
  23B9'   CD 2362'              	CALL	GOLNX
  23BC'   C2 2431'              	JNZ	EXW_NL		; the text has no line N
  23BF'   3A 0000*              	LDA	RWERR		; a delete scans the whole directory, there or
  23C2'   B7                    	ORA	A		;   not: only when TEXIST found one
  23C3'   0E 13                 	MVI	C,13H
  23C5'   C4 2336'              	CNZ	TFDOS		; delete what is there
  23C8'   0E 16                 	MVI	C,16H
  23CA'   CD 2336'              	CALL	TFDOS		; ... and make it
  23CD'   3C                    	INR	A
  23CE'   CA 2423'              	JZ	EXW_FL		; no directory entry left
  23D1'   3E 80                 	MVI	A,80H
  23D3'   32 0000*              	STA	RWPTR
  23D6'   AF                    	XRA	A
  23D7'   32 0000*              	STA	RWERR
  23DA'   2A 0000*              	LHLD	SLINES
  23DD'   CD 0000*              	CALL	SETC0		; that many lines, forward
  23E0'                         EXW_LP:
  23E0'   CD 0000*              	CALL	GOLINE		; HL = as far as the window holds of them
  23E3'   E5                    	PUSH	H
  23E4'   EB                    	XCHG
  23E5'   2A 0000*              	LHLD	GAPEND
  23E8'   CD 2440'              	CALL	RWOUT		; the text from the cursor to there
  23EB'   E1                    	POP	H
  23EC'   3A 0000*              	LDA	RWERR
  23EF'   B7                    	ORA	A
  23F0'   C2 240C'              	JNZ	EXW_EN
  23F3'   CD 0000*              	CALL	SCRLST		; the cursor up to it, and page a step
  23F6'   CD 0792'              	CALL	CNTTST
  23F9'   C2 23E0'              	JNZ	EXW_LP
  23FC'                         EXW_PD:				; the last record is padded out with ^Z
  23FC'   3A 0000*              	LDA	RWPTR
  23FF'   FE 80                 	CPI	80H
  2401'   CA 240C'              	JZ	EXW_EN
  2404'   3E 1A                 	MVI	A,CPMEOF
  2406'   CD 244C'              	CALL	RWPUT
  2409'   C3 23FC'              	JMP	EXW_PD
  240C'                         EXW_EN:
  240C'   0E 10                 	MVI	C,10H
  240E'   CD 2336'              	CALL	TFDOS		; close
  2411'   3A 0000*              	LDA	RWERR
  2414'   B7                    	ORA	A
  2415'   C2 2423'              	JNZ	EXW_FL
  2418'   CD 237A'              	CALL	EXRSTP
  241B'   3E 02                 	MVI	A,MW_WRT	; '"NAME" written', as ':w name' says it
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  241D'   32 0000*              	STA	MSGWHT
  2420'   C3 0852'              	JMP	SETMOV		; nothing on the screen has changed
  2423'                         EXW_FL:				; no room: the part written is not left behind
  2423'   0E 13                 	MVI	C,13H
  2425'   CD 2336'              	CALL	TFDOS
  2428'   CD 237A'              	CALL	EXRSTP
  242B'   21 295B'              	LXI	H,SDFUL
  242E'   C3 27C6'              	JMP	EXERR
  2431'                         EXW_NL:
  2431'   CD 237A'              	CALL	EXRSTP
  2434'                         EXW_BD:
  2434'   21 294D'              	LXI	H,SRNGE
  2437'   C3 27C6'              	JMP	EXERR
  243A'                         EXW_OW:
  243A'   21 27F5'              	LXI	H,SEXI
  243D'   C3 27C6'              	JMP	EXERR
                                
                                ;RWOUT -- the text from HL up to DE into the record, written out as it fills.
  2440'                         RWOUT:
  2440'   CD 0000*              	CALL	CMP16
  2443'   C8                    	RZ
  2444'   7E                    	MOV	A,M
  2445'   23                    	INX	H
  2446'   CD 244C'              	CALL	RWPUT
  2449'   C3 2440'              	JMP	RWOUT
                                
                                ;RWPUT -- A into the record at 0080H; a full one is written to TFCB.  Keeps
                                ; DE and HL.  A write that fails sets RWERR (which EX_WR also borrows, before
                                ; the walk, to remember that the file was there).
  244C'                         RWPUT:
  244C'   E5                    	PUSH	H
  244D'   F5                    	PUSH	PSW
  244E'   3A 0000*              	LDA	RWPTR
  2451'   6F                    	MOV	L,A
  2452'   26 00                 	MVI	H,0
  2454'   F1                    	POP	PSW
  2455'   77                    	MOV	M,A
  2456'   2C                    	INR	L		; Z: that was the record's last byte
  2457'   7D                    	MOV	A,L
  2458'   C2 246B'              	JNZ	RWP_ST
  245B'   D5                    	PUSH	D
  245C'   0E 15                 	MVI	C,15H
  245E'   CD 2336'              	CALL	TFDOS		; write it
  2461'   D1                    	POP	D
  2462'   B7                    	ORA	A
  2463'   CA 2469'              	JZ	RWP_OK
  2466'   32 0000*              	STA	RWERR
  2469'                         RWP_OK:
  2469'   3E 80                 	MVI	A,80H
  246B'                         RWP_ST:
  246B'   32 0000*              	STA	RWPTR
  246E'   E1                    	POP	H
  246F'   C9                    	RET
                                
                                ;EX_R -- ':r name' / ':Nr name': the file in below the cursor's line, or line
                                ; N.  Each record goes in at the cursor through INSBLK, so the window pages out
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


                                ; behind it exactly as it does behind typing; ^Z ends the file and bit 7 is
                                ; masked, as the loader has it (PAGE.MAC CLNSEC).  A read of more than the undo
                                ; region holds is one 'u' answers 'Too large to undo' to, like any other.
                                ; MODF is set by hand, not MARKMOD: that also sets DOTCHG, and '.' does not
                                ; repeat a ':r' in vim either.
  2470'                         EX_R:
  2470'   3A 0000*              	LDA	EXARG
  2473'   B7                    	ORA	A
  2474'   CA 278E'              	JZ	MSGNFN		; No file name
  2477'   0E 0F                 	MVI	C,0FH
  2479'   CD 2336'              	CALL	TFDOS		; open
  247C'   3C                    	INR	A
  247D'   CA 254A'              	JZ	ER_NOF
  2480'   CD 13D1'              	CALL	GZONE		; the screen's top line, before anything moves
  2483'   CD 236E'              	CALL	EXSAVP
  2486'   3A 0000*              	LDA	SRNGF
  2489'   B7                    	ORA	A
  248A'   CA 24A3'              	JZ	ER_NXT		; no line given: below the cursor's
  248D'   2A 0000*              	LHLD	SRNG2
  2490'   7C                    	MOV	A,H
  2491'   B5                    	ORA	L
  2492'   C2 249D'              	JNZ	ER_LN
  2495'   23                    	INX	H
  2496'   CD 133F'              	CALL	GOLN		; ':0r': above line 1 ...
  2499'   AF                    	XRA	A		;   which never wants a line end put in first
  249A'   C3 24C5'              	JMP	ER_BRK
  249D'                         ER_LN:
  249D'   CD 2362'              	CALL	GOLNX
  24A0'   C2 2431'              	JNZ	EXW_NL		; the text has no line N
  24A3'                         ER_NXT:
  24A3'   21 0001               	LXI	H,1
  24A6'   AF                    	XRA	A
  24A7'   CD 0000*              	CALL	MVLIND		; the start of the next line, or the text's end
                                	;--- below a last line that has no line end, the break goes in first; an
                                	;    empty buffer still has its one empty line, and the text goes below it
  24AA'   CD 0BDB'              	CALL	ATEOF
  24AD'   3E 00                 	MVI	A,0
  24AF'   D2 24C5'              	JNC	ER_BRK		; text follows
  24B2'   2A 0000*              	LHLD	GAPBEG
  24B5'   EB                    	XCHG
  24B6'   2A 0000*              	LHLD	TXTBEG
  24B9'   CD 0000*              	CALL	CMP16
  24BC'   3E 01                 	MVI	A,1
  24BE'   CA 24C5'              	JZ	ER_BRK		; nothing before the cursor either
  24C1'   1B                    	DCX	D
  24C2'   1A                    	LDAX	D
  24C3'   D6 0A                 	SUI	LF		; A = 0 when the last line is terminated
  24C5'                         ER_BRK:
  24C5'   32 0000*              	STA	RDBRK
  24C8'   CD 0000*              	CALL	CLRCNT		; forward, so the window pages out BEHIND
  24CB'   AF                    	XRA	A
  24CC'   32 0000*              	STA	RDANY
  24CF'                         ER_LP:
  24CF'   0E 14                 	MVI	C,14H
  24D1'   CD 2336'              	CALL	TFDOS		; the next record
  24D4'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  24D5'   C2 2508'              	JNZ	ER_END
  24D8'   21 0080               	LXI	H,CMDTAIL
  24DB'   0E 00                 	MVI	C,0
  24DD'                         ER_SC:				; C = its bytes, up to a ^Z
  24DD'   7E                    	MOV	A,M
  24DE'   FE 1A                 	CPI	CPMEOF
  24E0'   CA 24E8'              	JZ	ER_GOT
  24E3'   23                    	INX	H
  24E4'   0C                    	INR	C
  24E5'   F2 24DD'              	JP	ER_SC		; (minus: all 128)
  24E8'                         ER_GOT:
  24E8'   79                    	MOV	A,C
  24E9'   B7                    	ORA	A
  24EA'   CA 2508'              	JZ	ER_END
  24ED'   C5                    	PUSH	B
  24EE'   3A 0000*              	LDA	RDANY
  24F1'   B7                    	ORA	A
  24F2'   CC 2539'              	CZ	ER_1ST
  24F5'   C1                    	POP	B
  24F6'   06 00                 	MVI	B,0
  24F8'   11 0080               	LXI	D,CMDTAIL
  24FB'   C5                    	PUSH	B
  24FC'   CD 0000*              	CALL	INSBLK
  24FF'   C1                    	POP	B
  2500'   CD 0000*              	CALL	UNDINS		; ... for 'u', and for the marks
  2503'   79                    	MOV	A,C
  2504'   17                    	RAL
  2505'   DA 24CF'              	JC	ER_LP		; a full record: there may be more
  2508'                         ER_END:
  2508'   3A 0000*              	LDA	RDANY
  250B'   B7                    	ORA	A
  250C'   CA 252A'              	JZ	ER_PL		; nothing in the file: nothing has changed
  250F'   CD 0BDB'              	CALL	ATEOF
  2512'   DA 251F'              	JC	ER_MD		; the text now ends as the file read ends
  2515'   2A 0000*              	LHLD	GAPBEG
  2518'   2B                    	DCX	H
  2519'   7E                    	MOV	A,M
  251A'   FE 0A                 	CPI	LF
  251C'   C4 2386'              	CNZ	PUTBRK		; text follows: what was read ends a line
  251F'                         ER_MD:
  251F'   3E 01                 	MVI	A,1
  2521'   32 0000*              	STA	MODF
  2524'   CD 03A9'              	CALL	MKPAGE		; back to the first line read
  2527'   CD 0000*              	CALL	GOTO
  252A'                         ER_PL:
  252A'   CD 0BDB'              	CALL	ATEOF
  252D'   DC 0BE1'              	CC	LASTLN		; (nothing read, at the end: the last line)
  2530'   CD 0000*              	CALL	CLRCNT
  2533'   CD 13E9'              	CALL	GPLACE		; first non-blank, the window placed as 'G'
  2536'   C3 088F'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the line is on the
                                				;   screen already, and the text below it moved
                                ;ER_1ST -- the first bytes are about to go in (A = 0): the break before them
                                ; if one is wanted, and where they start, for the cursor to come back to.
  2539'                         ER_1ST:
  2539'   3C                    	INR	A
  253A'   32 0000*              	STA	RDANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  253D'   3A 0000*              	LDA	RDBRK
  2540'   B7                    	ORA	A
  2541'   C4 2386'              	CNZ	PUTBRK
  2544'   21 0000*              	LXI	H,MKPOS
  2547'   C3 0429'              	JMP	FPSTO
  254A'                         ER_NOF:
  254A'   21 293C'              	LXI	H,SNOPN
  254D'   C3 27BB'              	JMP	EXERT
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  2550'                         WRCHK:
  2550'   3A 0000*              	LDA	EXARG
  2553'   B7                    	ORA	A
  2554'   C2 255E'              	JNZ	WC_ARG
  2557'   CD 25C1'              	CALL	OWNTF
  255A'   D8                    	RC
  255B'   C3 2573'              	JMP	WC_OWN
  255E'                         WC_ARG:
  255E'   CD 25D7'              	CALL	ISOWN
  2561'   CA 2573'              	JZ	WC_OWN
  2564'   3A 0000*              	LDA	EXBANG
  2567'   B7                    	ORA	A
  2568'   CA 2571'              	JZ	WC_OTH
  256B'   CD 0000*              	CALL	TEXIST
  256E'   C2 2794'              	JNZ	MSGEXI		; File exists (! to force)
  2571'                         WC_OTH:
  2571'   AF                    	XRA	A		; (NC)
  2572'   C9                    	RET
  2573'                         WC_OWN:
  2573'   3A 0000*              	LDA	ROFLAG		; '-R': this is the file it may not write
  2576'   B7                    	ORA	A
  2577'   CA 2581'              	JZ	WC_OK
  257A'   3A 0000*              	LDA	EXBANG
  257D'   B7                    	ORA	A
  257E'   C2 279A'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  2581'                         WC_OK:
  2581'   3E 01                 	MVI	A,1
  2583'   B7                    	ORA	A		; (NC)
  2584'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  2585'                         WRITE:
  2585'   3A 0000*              	LDA	EXBAK
  2588'   CD 0000*              	CALL	WRTO
  258B'   3A 0001*              	LDA	FNAME+1
  258E'   FE 20                 	CPI	' '
  2590'   C2 259C'              	JNZ	WR_HAS
  2593'   21 0000*              	LXI	H,TFCB
  2596'   11 0000*              	LXI	D,FNAME
  2599'   CD 25E9'              	CALL	COPY12
  259C'                         WR_HAS:
  259C'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  259E'   32 0000*              	STA	MSGWHT
  25A1'   CD 25D7'              	CALL	ISOWN
  25A4'   C2 25AE'              	JNZ	SRCTF
  25A7'   AF                    	XRA	A
  25A8'   32 0000*              	STA	MODF
  25AB'   32 0000*              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  25AE'                         SRCTF:
  25AE'   21 0000*              	LXI	H,TFCB
  25B1'   11 005C               	LXI	D,DFTFCB
  25B4'   CD 25E9'              	CALL	COPY12
  25B7'   AF                    	XRA	A
  25B8'   06 04                 	MVI	B,4
  25BA'                         SRC_Z:
  25BA'   12                    	STAX	D		; extent, s1, s2, record count: 0
  25BB'   13                    	INX	D
  25BC'   05                    	DCR	B
  25BD'   C2 25BA'              	JNZ	SRC_Z
  25C0'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  25C1'                         OWNTF:
  25C1'   3A 0001*              	LDA	FNAME+1
  25C4'   FE 20                 	CPI	' '
  25C6'   CA 278E'              	JZ	MSGNFN
  25C9'   CD 25F4'              	CALL	TFCLR
  25CC'   21 0000*              	LXI	H,FNAME
  25CF'   11 0000*              	LXI	D,TFCB
  25D2'   CD 25E9'              	CALL	COPY12
  25D5'   B7                    	ORA	A		; (NC)
  25D6'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  25D7'                         ISOWN:
  25D7'   21 0000*              	LXI	H,TFCB
  25DA'   11 0000*              	LXI	D,FNAME
  25DD'   06 0C                 	MVI	B,12
  25DF'                         IO_LP:
  25DF'   1A                    	LDAX	D
  25E0'   BE                    	CMP	M
  25E1'   C0                    	RNZ
  25E2'   23                    	INX	H
  25E3'   13                    	INX	D
  25E4'   05                    	DCR	B
  25E5'   C2 25DF'              	JNZ	IO_LP
  25E8'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  25E9'                         COPY12:
  25E9'   06 0C                 	MVI	B,12
  25EB'                         CP_LP:
  25EB'   7E                    	MOV	A,M
  25EC'   12                    	STAX	D
  25ED'   23                    	INX	H
  25EE'   13                    	INX	D
  25EF'   05                    	DCR	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


  25F0'   C2 25EB'              	JNZ	CP_LP
  25F3'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  25F4'                         TFCLR:
  25F4'   11 0000*              	LXI	D,TFCB
  25F7'   06 24                 	MVI	B,36
  25F9'   AF                    	XRA	A
  25FA'                         TC_LP:
  25FA'   12                    	STAX	D
  25FB'   13                    	INX	D
  25FC'   05                    	DCR	B
  25FD'   C2 25FA'              	JNZ	TC_LP
  2600'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  2601'                         FOPEN:
  2601'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  2603'   32 0000*              	STA	MSGWHT
  2606'   21 005C               	LXI	H,DFTFCB
  2609'   CD 26D7'              	CALL	NRMDRV
  260C'   11 0000*              	LXI	D,FNAME
  260F'   CD 25E9'              	CALL	COPY12
  2612'   CD 0000*              	CALL	OPENZ
  2615'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  2618'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  261A'   C8                    	RZ
  261B'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  261E'   32 0000*              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  2621'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


                                ;============================================================
  2622'                         ARGSCN:
  2622'   3A 0080               	LDA	CMDTAIL
  2625'   47                    	MOV	B,A		; B = what is left of the line
  2626'   B7                    	ORA	A
  2627'   C8                    	RZ
  2628'   21 0081               	LXI	H,CMDTAIL+1
  262B'                         AS_TOK:				; at a token, or the blanks before one
  262B'   7E                    	MOV	A,M
  262C'   FE 20                 	CPI	' '
  262E'   C2 2637'              	JNZ	AS_OPT
  2631'   23                    	INX	H
  2632'   05                    	DCR	B
  2633'   C2 262B'              	JNZ	AS_TOK
  2636'   C9                    	RET
  2637'                         AS_OPT:
  2637'   FE 2B                 	CPI	'+'
  2639'   CA 2663'              	JZ	AS_PLS
  263C'   FE 2D                 	CPI	'-'
  263E'   CA 2652'              	JZ	AS_SW
  2641'   FE 2F                 	CPI	'/'
  2643'   CA 2652'              	JZ	AS_SW
  2646'                         AS_SKP:				; not ours (the file name): on to the next one
  2646'   23                    	INX	H
  2647'   05                    	DCR	B
  2648'   C8                    	RZ
  2649'   7E                    	MOV	A,M
  264A'   FE 20                 	CPI	' '
  264C'   C2 2646'              	JNZ	AS_SKP
  264F'   C3 262B'              	JMP	AS_TOK
  2652'                         AS_SW:
  2652'   23                    	INX	H
  2653'   05                    	DCR	B
  2654'   C8                    	RZ
  2655'   7E                    	MOV	A,M
  2656'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  2658'   FE 52                 	CPI	'R'
  265A'   C2 2646'              	JNZ	AS_SKP
  265D'   32 0000*              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  2660'   C3 2646'              	JMP	AS_SKP
  2663'                         AS_PLS:
  2663'   3E 01                 	MVI	A,1
  2665'   32 0000*              	STA	PLUSF		; '+' gets the line even with no number on it
  2668'   11 0000*              	LXI	D,PLUSB
  266B'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  266D'   23                    	INX	H		;   line space, so it is taken as '+' alone
  266E'   05                    	DCR	B
  266F'   CA 26A6'              	JZ	AS_PE
  2672'   7E                    	MOV	A,M
  2673'   FE 30                 	CPI	'0'
  2675'   C2 268D'              	JNZ	AS_PD
  2678'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  2678'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  2679'   05                    	DCR	B
  267A'   CA 26AE'              	JZ	AS_P1
  267D'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


  267E'   FE 30                 	CPI	'0'
  2680'   CA 2678'              	JZ	AS_PZ
  2683'   FE 31                 	CPI	'1'
  2685'   DA 26AE'              	JC	AS_P1		; zeros and then no digit at all: line 1
  2688'   FE 3A                 	CPI	'9'+1
  268A'   D2 26AE'              	JNC	AS_P1
  268D'                         AS_PD:				; the digits, as typed
  268D'   7E                    	MOV	A,M
  268E'   FE 30                 	CPI	'0'
  2690'   DA 26A6'              	JC	AS_PE
  2693'   FE 3A                 	CPI	'9'+1
  2695'   D2 26A6'              	JNC	AS_PE
  2698'   79                    	MOV	A,C
  2699'   B7                    	ORA	A
  269A'   CA 26B5'              	JZ	AS_POV
  269D'   0D                    	DCR	C
  269E'   7E                    	MOV	A,M
  269F'   12                    	STAX	D
  26A0'   13                    	INX	D
  26A1'   23                    	INX	H
  26A2'   05                    	DCR	B
  26A3'   C2 268D'              	JNZ	AS_PD
  26A6'                         AS_PE:
  26A6'   AF                    	XRA	A
  26A7'   12                    	STAX	D		; the digits end with a 0
  26A8'   78                    	MOV	A,B
  26A9'   B7                    	ORA	A
  26AA'   C8                    	RZ
  26AB'   C3 262B'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  26AE'                         AS_P1:
  26AE'   3E 31                 	MVI	A,'1'
  26B0'   12                    	STAX	D
  26B1'   13                    	INX	D
  26B2'   C3 26A6'              	JMP	AS_PE
  26B5'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  26B5'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  26B8'   C3 26A6'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  26BB'                         ARGGO:
  26BB'   3A 0000*              	LDA	PLUSF
  26BE'   B7                    	ORA	A
  26BF'   C8                    	RZ
  26C0'   21 0000*              	LXI	H,PLUSB
  26C3'                         AG_LP:
  26C3'   7E                    	MOV	A,M
  26C4'   B7                    	ORA	A
  26C5'   CA 26D2'              	JZ	AG_G
  26C8'   4F                    	MOV	C,A
  26C9'   E5                    	PUSH	H
  26CA'   CD 0023'              	CALL	VICMD
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  26CD'   E1                    	POP	H
  26CE'   23                    	INX	H
  26CF'   C3 26C3'              	JMP	AG_LP
  26D2'                         AG_G:
  26D2'   0E 47                 	MVI	C,'G'
  26D4'   C3 0023'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  26D7'                         NRMDRV:
  26D7'   7E                    	MOV	A,M
  26D8'   B7                    	ORA	A
  26D9'   C0                    	RNZ
  26DA'   E5                    	PUSH	H
  26DB'   0E 19                 	MVI	C,BF_CURDSK
  26DD'   CD 0005               	CALL	BDOS
  26E0'   E1                    	POP	H
  26E1'   3C                    	INR	A
  26E2'   77                    	MOV	M,A
  26E3'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  26E4'                         PARSFN:
  26E4'   CD 25F4'              	CALL	TFCLR
  26E7'   11 0000*              	LXI	D,TFCB
  26EA'   23                    	INX	H
  26EB'   7E                    	MOV	A,M
  26EC'   2B                    	DCX	H
  26ED'   FE 3A                 	CPI	':'
  26EF'   C2 2701'              	JNZ	PF_NM
  26F2'   CD 2747'              	CALL	GETFNC
  26F5'   CA 2701'              	JZ	PF_NM
  26F8'   D6 40                 	SUI	40H
  26FA'   12                    	STAX	D
  26FB'   FE 11                 	CPI	17
  26FD'   D2 2725'              	JNC	PF_BAD
  2700'   23                    	INX	H
  2701'                         PF_NM:
  2701'   13                    	INX	D
  2702'   0E 08                 	MVI	C,8
  2704'   CD 2729'              	CALL	CPYNAM
  2707'   FE 2E                 	CPI	'.'
  2709'   0E 03                 	MVI	C,3
  270B'   C4 273C'              	CNZ	PADFLD		; no type: blanks
  270E'   CC 2728'              	CZ	CPYNM0		; '.': the type
  2711'   3A 0001*              	LDA	TFCB+1
  2714'   FE 20                 	CPI	' '
  2716'   CA 2725'              	JZ	PF_BAD		; no name
  2719'   CD 277A'              	CALL	SKIPB
  271C'   C0                    	RNZ			; more after it
  271D'   21 0000*              	LXI	H,TFCB
  2720'   CD 26D7'              	CALL	NRMDRV
  2723'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2724'   C9                    	RET
  2725'                         PF_BAD:
  2725'   F6 01                 	ORI	1
  2727'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  2728'                         CPYNM0:
  2728'   23                    	INX	H
  2729'                         CPYNAM:
  2729'   CD 2747'              	CALL	GETFNC
  272C'   CA 273C'              	JZ	PADFLD
  272F'   12                    	STAX	D
  2730'   13                    	INX	D
  2731'   0D                    	DCR	C
  2732'   C2 2729'              	JNZ	CPYNAM
  2735'                         CN_SKP:
  2735'   CD 2747'              	CALL	GETFNC
  2738'   C2 2735'              	JNZ	CN_SKP
  273B'   C9                    	RET
  273C'                         PADFLD:
  273C'   F5                    	PUSH	PSW
  273D'                         PD_LP:
  273D'   3E 20                 	MVI	A,' '
  273F'   12                    	STAX	D
  2740'   13                    	INX	D
  2741'   0D                    	DCR	C
  2742'   C2 273D'              	JNZ	PD_LP
  2745'   F1                    	POP	PSW
  2746'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  2747'                         GETFNC:
  2747'   7E                    	MOV	A,M
  2748'   FE 3D                 	CPI	'='
  274A'   C8                    	RZ
  274B'   FE 5F                 	CPI	'_'
  274D'   C8                    	RZ
  274E'   FE 3B                 	CPI	';'
  2750'   C8                    	RZ
  2751'   FE 3C                 	CPI	'<'
  2753'   C8                    	RZ
  2754'   FE 3E                 	CPI	'>'
  2756'   C8                    	RZ
  2757'   FE 2E                 	CPI	'.'
  2759'   C8                    	RZ
  275A'   FE 3A                 	CPI	':'
  275C'   C8                    	RZ
  275D'   FE 2A                 	CPI	'*'
  275F'   C8                    	RZ
  2760'   FE 3F                 	CPI	'?'
  2762'   C8                    	RZ
  2763'   FE 20                 	CPI	' '
  2765'   DA 2778'              	JC	GF_CTL
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


  2768'   C8                    	RZ
  2769'   23                    	INX	H
  276A'   FE 61                 	CPI	'a'
  276C'   DA 2776'              	JC	GF_DN
  276F'   FE 7B                 	CPI	'z'+1
  2771'   D2 2776'              	JNC	GF_DN
  2774'   E6 DF                 	ANI	0DFH
  2776'                         GF_DN:
  2776'   B7                    	ORA	A
  2777'   C9                    	RET
  2778'                         GF_CTL:
  2778'   BF                    	CMP	A
  2779'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  277A'                         SKIPB:
  277A'   7E                    	MOV	A,M
  277B'   FE 20                 	CPI	' '
  277D'   C2 2784'              	JNZ	SB_DN
  2780'   23                    	INX	H
  2781'   C3 277A'              	JMP	SKIPB
  2784'                         SB_DN:
  2784'   B7                    	ORA	A
  2785'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  2786'                         ISLOW:
  2786'   7E                    	MOV	A,M
  2787'   FE 61                 	CPI	'a'
  2789'   D8                    	RC
  278A'   FE 7B                 	CPI	'z'+1
  278C'   3F                    	CMC
  278D'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  278E'                         MSGNFN:
  278E'   21 27DB'              	LXI	H,SNFN
  2791'   C3 27C6'              	JMP	EXERR
  2794'                         MSGEXI:
  2794'   21 27F5'              	LXI	H,SEXI
  2797'   C3 27A3'              	JMP	EXBNG
  279A'                         MSGRO:
  279A'   21 2801'              	LXI	H,SRO
  279D'   C3 27A3'              	JMP	EXBNG
  27A0'                         MSGNWR:
  27A0'   21 27E8'              	LXI	H,SNWR
  27A3'                         EXBNG:
  27A3'   CD 27C6'              	CALL	EXERR
  27A6'   21 280D'              	LXI	H,SBNG
  27A9'   C3 27C1'              	JMP	EXOUT
  27AC'                         EX_INV:
  27AC'   21 281B'              	LXI	H,SINV
  27AF'   C3 27C6'              	JMP	EXERR
  27B2'                         EX_V:				; :ve -- the version, on the bottom row
  27B2'   21 27D6'              	LXI	H,SVER
  27B5'   C3 27C6'              	JMP	EXERR
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


  27B8'                         EX_TRL:
  27B8'   21 282D'              	LXI	H,STRL
  27BB'                         EXERT:				; the message, then the text at EXCMD
  27BB'   CD 27C6'              	CALL	EXERR
  27BE'   2A 0000*              	LHLD	EXCMD
  27C1'                         EXOUT:
  27C1'   CD 0000*              	CALL	OUTSTR
  27C4'   37                    	STC
  27C5'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  27C6'                         EXERR:
  27C6'   E5                    	PUSH	H
  27C7'   AF                    	XRA	A		; an error outranks whatever this key meant to
  27C8'   32 0000*              	STA	MSGWHT		;   say: ':wq NAME' writes, then refuses to quit
  27CB'   E1                    	POP	H
  27CC'   CD 0000*              	CALL	EXMSG
  27CF'   3E 01                 	MVI	A,R_MOVE
  27D1'   32 0000*              	STA	RINTENT
  27D4'   37                    	STC
  27D5'   C9                    	RET
                                
