  1C21'   66 6F 75 6E           
  1C25'   64 3A 20 00           
  1C29'   4E 6F 20 70           SNOPAT: DB	'No previous search pattern',0
  1C2D'   72 65 76 69           
  1C31'   6F 75 73 20           
  1C35'   73 65 61 72           
  1C39'   63 68 20 70           
