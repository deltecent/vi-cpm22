  0BA5'   2B                    	DCX	H
  0BA6'   7E                    	MOV	A,M
  0BA7'   BA                    	CMP	D
  0BA8'   C2 0B9D'              	JNZ	KQ_LP
  0BAB'   1D                    	DCR	E
  0BAC'   C2 0B9D'              	JNZ	KQ_LP
  0BAF'   23                    	INX	H
  0BB0'                         KQ_GO:
  0BB0'   CD 0000*              	CALL	PUTCUR
  0BB3'   21 0000               	LXI	H,0
  0BB6'   CD 0000*              	CALL	SETC0		; the count spent, backward: as SETBWD leaves it
  0BB9'   3E FF                 	MVI	A,0FFH
  0BBB'   32 0000*              	STA	DIRFLG
  0BBE'   2A 2F1F'              	LHLD	JKCNT
  0BC1'   EB                    	XCHG			; DE = the lines moved
  0BC2'   C3 0B79'              	JMP	KC_AD
  0BC5'                         KQ_TB:
  0BC5'   1D                    	DCR	E
  0BC6'   C2 0B10'              	JNZ	KC_SL
  0BC9'   2A 0000*              	LHLD	OUTPOS
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0BCC'   7C                    	MOV	A,H
  0BCD'   B5                    	ORA	L
  0BCE'   C2 0B10'              	JNZ	KC_SL
  0BD1'   2A 0000*              	LHLD	TXTBEG
  0BD4'   C3 0BB0'              	JMP	KQ_GO
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  0BD7'                         ATEOF:
  0BD7'   CD 0000*              	CALL	RGET0
  0BDA'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  0BDD'                         LASTLN:
  0BDD'   2A 0000*              	LHLD	GAPBEG
  0BE0'   EB                    	XCHG
  0BE1'   2A 0000*              	LHLD	TXTBEG
  0BE4'   CD 0000*              	CALL	CMP16
  0BE7'   21 0000               	LXI	H,0
  0BEA'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  0BED'   1B                    	DCX	D
  0BEE'   1A                    	LDAX	D
  0BEF'   FE 0A                 	CPI	LF
  0BF1'   C2 0000*              	JNZ	SETBWD
  0BF4'   23                    	INX	H
  0BF5'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  0BF8'                         JKLAND:
  0BF8'   21 0000               	LXI	H,0
  0BFB'   22 2F29'              	SHLD	JKVC		; screen column
  0BFE'   2B                    	DCX	H
  0BFF'   22 2F2B'              	SHLD	JKLS		; last content char: none yet
  0C02'   CD 0000*              	CALL	RGET0
  0C05'   11 0000               	LXI	D,0		; DE = chars read
  0C08'                         JL_RD:
  0C08'   CD 0000*              	CALL	RDGET
  0C0B'   DA 0C45'              	JC	JL_END
  0C0E'   FE 0A                 	CPI	LF
  0C10'   CA 0C45'              	JZ	JL_END
  0C13'   E5                    	PUSH	H
  0C14'   C5                    	PUSH	B
  0C15'   2A 2F29'              	LHLD	JKVC
  0C18'   CD 0665'              	CALL	CWID
  0C1B'   B7                    	ORA	A
  0C1C'   CA 0C3F'              	JZ	JL_NX		; a CR
  0C1F'   EB                    	XCHG
  0C20'   22 2F2B'              	SHLD	JKLS		; the last content char so far
  0C23'   EB                    	XCHG
  0C24'   4F                    	MOV	C,A
  0C25'   06 00                 	MVI	B,0
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C27'   09                    	DAD	B		; HL = the column after this char
  0C28'   22 2F29'              	SHLD	JKVC
  0C2B'   D5                    	PUSH	D
  0C2C'   EB                    	XCHG
  0C2D'   2A 2F0E'              	LHLD	GOALCOL
  0C30'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0C33'   D1                    	POP	D
  0C34'   DA 0C3F'              	JC	JL_NX
  0C37'   CA 0C3F'              	JZ	JL_NX
  0C3A'   C1                    	POP	B		; this char holds the goal column
  0C3B'   E1                    	POP	H
  0C3C'   C3 0C50'              	JMP	JL_GO
  0C3F'                         JL_NX:
  0C3F'   C1                    	POP	B
  0C40'   E1                    	POP	H
  0C41'   13                    	INX	D
  0C42'   C3 0C08'              	JMP	JL_RD
  0C45'                         JL_END:
  0C45'   2A 2F2B'              	LHLD	JKLS		; past the line's end: its last content char
  0C48'   7C                    	MOV	A,H
  0C49'   A5                    	ANA	L
  0C4A'   3C                    	INR	A
  0C4B'   C2 0C4F'              	JNZ	JL_LS
  0C4E'   23                    	INX	H		; no content: the line's start
  0C4F'                         JL_LS:
  0C4F'   EB                    	XCHG
  0C50'                         JL_GO:
  0C50'   D5                    	PUSH	D		; DE = step from the line start
  0C51'   CD 0000*              	CALL	CUROFF
  0C54'   D1                    	POP	D
  0C55'   19                    	DAD	D
  0C56'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0C59'   AF                    VC_W:	XRA	A
  0C5A'   32 2F10'              	STA	WBIG
  0C5D'   C3 0C65'              	JMP	WDO
  0C60'   3E 01                 VCBGW:	MVI	A,1
  0C62'   32 2F10'              	STA	WBIG
  0C65'   CD 085B'              WDO:	CALL	SETMOV
  0C68'   AF                    	XRA	A
  0C69'   32 2F11'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0C6C'   CD 0786'              	CALL	GETCNT
  0C6F'   22 2F53'              	SHLD	CNTV
  0C72'   2A 2F53'              WDO_LP: LHLD	CNTV
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0C75'   7C                    	MOV	A,H
  0C76'   B5                    	ORA	L
  0C77'   CA 0C84'              	JZ	WDO_DN
  0C7A'   2B                    	DCX	H
  0C7B'   22 2F53'              	SHLD	CNTV
  0C7E'   CD 0CE1'              	CALL	FWD1
  0C81'   D2 0C72'              	JNC	WDO_LP
  0C84'                         WDO_DN:
  0C84'   CD 0BD7'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0C87'   DA 0C94'              	JC	WDO_NL
  0C8A'   FE 0D                 	CPI	CR
  0C8C'   CA 0C94'              	JZ	WDO_NL
  0C8F'   FE 0A                 	CPI	LF
  0C91'   C2 0611'              	JNZ	SETGL
  0C94'                         WDO_NL:
  0C94'   CD 0000*              	CALL	PEEKL
  0C97'   DA 0611'              	JC	SETGL
  0C9A'   FE 0A                 	CPI	LF
  0C9C'   CA 0611'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0C9F'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0CA1'   32 2F11'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0CA4'   CD 0E00'              	CALL	DECC		; back onto its last char
  0CA7'   C3 0611'              	JMP	SETGL
                                
  0CAA'   AF                    VC_B:	XRA	A
  0CAB'   32 2F10'              	STA	WBIG
  0CAE'   C3 0CB6'              	JMP	BDO
  0CB1'   3E 01                 VCBGB:	MVI	A,1
  0CB3'   32 2F10'              	STA	WBIG
  0CB6'   CD 085B'              BDO:	CALL	SETMOV
  0CB9'   CD 0786'              	CALL	GETCNT
  0CBC'   22 2F53'              	SHLD	CNTV
  0CBF'   CD 0D51'              	CALL	BCK1		; the first step, apart: with nowhere to go back
  0CC2'   D2 0CD2'              	JNC	BDO_NX		;   to the motion has failed, and an operator
  0CC5'   AF                    	XRA	A		;   waiting on it is dropped ('cb' on the file's
  0CC6'   32 2F3B'              	STA	PSAVE		;   first char opened an insert).  A count that
  0CC9'   C3 0611'              	JMP	SETGL		;   runs out at the start has still moved, and
  0CCC'                         BDO_LP:				;   its operator stands -- both as vim
  0CCC'   CD 0D51'              	CALL	BCK1
  0CCF'   DA 0611'              	JC	SETGL
  0CD2'   2A 2F53'              BDO_NX: LHLD	CNTV
  0CD5'   2B                    	DCX	H
  0CD6'   22 2F53'              	SHLD	CNTV
  0CD9'   7C                    	MOV	A,H
  0CDA'   B5                    	ORA	L
  0CDB'   C2 0CCC'              	JNZ	BDO_LP
  0CDE'   C3 0611'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
                                ; Under an operator the LAST word of the count does not leave its line (vim's
                                ; fwd_word, 'eol'): the first step that comes to a line's end stops there, so
                                ; 'dw' on a line's last word takes the word and keeps the line break.  The
                                ; words before the last run on freely -- 'd2w' there takes the line break and
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ; the next line's first word as well.
  0CE1'                         FWD1:
  0CE1'   CD 0D84'              	CALL	CCLS
  0CE4'   32 2F5D'              	STA	WKCLS		; the starting class
  0CE7'   CD 0DBE'              	CALL	INCC
  0CEA'   B7                    	ORA	A
  0CEB'   CA 0D04'              	JZ	FW_WD
  0CEE'   37                    	STC
  0CEF'   F8                    	RM			; -1: already at the end
  0CF0'   CD 0D3C'              	CALL	WLAST
  0CF3'   C8                    	RZ
  0CF4'   FE 02                 	CPI	2
  0CF6'   C2 0D04'              	JNZ	FW_WD		; 1: a next line was reached
  0CF9'   CD 0BD7'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0CFC'   D4 0DA5'              	CNC	NXLN
  0CFF'   D2 0D04'              	JNC	FW_WD
  0D02'   37                    	STC			; yes: failed
  0D03'   C9                    	RET
  0D04'                         FW_WD:
  0D04'   3A 2F5D'              	LDA	WKCLS		; go past the rest of this word
  0D07'   B7                    	ORA	A
  0D08'   CA 0D24'              	JZ	FW_WS
  0D0B'                         FW_WLP:
  0D0B'   CD 0D84'              	CALL	CCLS
  0D0E'   21 2F5D'              	LXI	H,WKCLS
  0D11'   BE                    	CMP	M
  0D12'   C2 0D24'              	JNZ	FW_WS
  0D15'   CD 0DBE'              	CALL	INCC
  0D18'   B7                    	ORA	A
  0D19'   F8                    	RM			; the end of the file (NC)
  0D1A'   CA 0D0B'              	JZ	FW_WLP
  0D1D'   CD 0D3C'              	CALL	WLAST
  0D20'   C8                    	RZ
  0D21'   C3 0D0B'              	JMP	FW_WLP
  0D24'                         FW_WS:
  0D24'   CD 0D84'              	CALL	CCLS		; then over blanks to the next word
  0D27'   B7                    	ORA	A
  0D28'   C0                    	RNZ
  0D29'   CD 0D8C'              	CALL	EMPTY
  0D2C'   C8                    	RZ			; an empty line is a word
  0D2D'   CD 0DBE'              	CALL	INCC
  0D30'   B7                    	ORA	A
  0D31'   F8                    	RM
  0D32'   CA 0D24'              	JZ	FW_WS
  0D35'   CD 0D3C'              	CALL	WLAST
  0D38'   C8                    	RZ
  0D39'   C3 0D24'              	JMP	FW_WS
                                
                                ;WLAST -- A = INCC's answer, kept.  Z (and NC) iff this is the last word of the
                                ; count and an operator is waiting on it: the step stops where it is.
  0D3C'                         WLAST:
  0D3C'   47                    	MOV	B,A
  0D3D'   2A 2F53'              	LHLD	CNTV
  0D40'   7C                    	MOV	A,H
  0D41'   B5                    	ORA	L
  0D42'   C2 0D4D'              	JNZ	WL_X		; words still owed
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D45'   3A 2F3B'              	LDA	PSAVE
  0D48'   B7                    	ORA	A
  0D49'   CA 0D4F'              	JZ	WL_NO		; a plain 'w'
  0D4C'   AF                    	XRA	A
  0D4D'   78                    WL_X:	MOV	A,B
  0D4E'   C9                    	RET
  0D4F'   B0                    WL_NO:	ORA	B
  0D50'   C9                    	RET
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0D51'                         BCK1:
  0D51'   CD 0E00'              	CALL	DECC
  0D54'   B7                    	ORA	A
  0D55'   37                    	STC
  0D56'   F8                    	RM
  0D57'                         BK_WS:
  0D57'   CD 0D84'              	CALL	CCLS		; back over blanks
  0D5A'   B7                    	ORA	A
  0D5B'   C2 0D6B'              	JNZ	BK_WD
  0D5E'   CD 0D8C'              	CALL	EMPTY
  0D61'   C8                    	RZ			; an empty line is a word
  0D62'   CD 0E00'              	CALL	DECC
  0D65'   B7                    	ORA	A
  0D66'   F2 0D57'              	JP	BK_WS
  0D69'   AF                    	XRA	A		; the start of the file (NC)
  0D6A'   C9                    	RET
  0D6B'                         BK_WD:
  0D6B'   32 2F5D'              	STA	WKCLS		; back to the start of this word
  0D6E'                         BK_WLP:
  0D6E'   CD 0E00'              	CALL	DECC
  0D71'   B7                    	ORA	A
  0D72'   FA 0D82'              	JM	BK_OK		; the start of the file
  0D75'   CD 0D84'              	CALL	CCLS
  0D78'   21 2F5D'              	LXI	H,WKCLS
  0D7B'   BE                    	CMP	M
  0D7C'   CA 0D6E'              	JZ	BK_WLP
  0D7F'   CD 0DBE'              	CALL	INCC		; overshot: forward one
  0D82'                         BK_OK:
  0D82'   AF                    	XRA	A
  0D83'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0D84'                         CCLS:
  0D84'   CD 0BD7'              	CALL	ATEOF
  0D87'   D2 0810'              	JNC	CLASSF
  0D8A'   AF                    	XRA	A
  0D8B'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0D8C'                         EMPTY:
  0D8C'   CD 0BD7'              	CALL	ATEOF
  0D8F'   DA 0D9A'              	JC	EM_ST
  0D92'   FE 0D                 	CPI	CR
  0D94'   CA 0D9A'              	JZ	EM_ST
  0D97'   FE 0A                 	CPI	LF
  0D99'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0D9A'                         EM_ST:
  0D9A'   CD 0000*              	CALL	PEEKL
  0D9D'   DA 0DA3'              	JC	EM_Y
  0DA0'   FE 0A                 	CPI	LF
  0DA2'   C9                    	RET
  0DA3'                         EM_Y:
  0DA3'   AF                    	XRA	A
  0DA4'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0DA5'                         NXLN:
  0DA5'   FE 0A                 	CPI	LF
  0DA7'   CA 0DB6'              	JZ	NX_LF
  0DAA'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0DAD'   D8                    	RC
  0DAE'   FE 0A                 	CPI	LF
  0DB0'   CA 0DB6'              	JZ	NX_LF
  0DB3'   2B                    	DCX	H		; a lone CR
  0DB4'   AF                    	XRA	A
  0DB5'   C9                    	RET
  0DB6'                         NX_LF:
  0DB6'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0DB9'   D8                    	RC
  0DBA'   2B                    	DCX	H
  0DBB'   3E 01                 	MVI	A,1
  0DBD'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0DBE'                         INCC:
  0DBE'   CD 0BD7'              	CALL	ATEOF
  0DC1'   DA 0DFC'              	JC	IC_END
  0DC4'   FE 0D                 	CPI	CR
  0DC6'   CA 0DE7'              	JZ	IC_NL
  0DC9'   FE 0A                 	CPI	LF
  0DCB'   CA 0DE7'              	JZ	IC_NL
  0DCE'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0DD1'                         IC_CH:
  0DD1'   CD 0BD7'              	CALL	ATEOF
  0DD4'   DA 0DE3'              	JC	IC_2
  0DD7'   FE 0D                 	CPI	CR
  0DD9'   CA 0DE3'              	JZ	IC_2
  0DDC'   FE 0A                 	CPI	LF
  0DDE'   CA 0DE3'              	JZ	IC_2
  0DE1'   AF                    	XRA	A
  0DE2'   C9                    	RET
  0DE3'                         IC_2:
  0DE3'   3E 02                 	MVI	A,2
  0DE5'   B7                    	ORA	A
  0DE6'   C9                    	RET
  0DE7'                         IC_NL:
  0DE7'   CD 0DA5'              	CALL	NXLN
  0DEA'   DA 0DFC'              	JC	IC_END
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0DED'   F5                    	PUSH	PSW
  0DEE'   CD 0000*              	CALL	PUTCUR
  0DF1'   F1                    	POP	PSW
  0DF2'   B7                    	ORA	A
  0DF3'   CA 0DD1'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0DF6'   CD 0E22'              	CALL	LNINC
  0DF9'   3E 01                 	MVI	A,1
  0DFB'   C9                    	RET
  0DFC'                         IC_END:
  0DFC'   3E FF                 	MVI	A,0FFH
  0DFE'   B7                    	ORA	A
  0DFF'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0E00'                         DECC:
  0E00'   CD 0000*              	CALL	PEEKL
  0E03'   DA 0DFC'              	JC	IC_END
  0E06'   F5                    	PUSH	PSW
  0E07'   CD 0000*              	CALL	PUTCUR
  0E0A'   F1                    	POP	PSW
  0E0B'   FE 0A                 	CPI	LF
  0E0D'   3E 00                 	MVI	A,0
  0E0F'   C0                    	RNZ
  0E10'   CD 0E30'              	CALL	LNDEC
  0E13'   CD 0000*              	CALL	PEEKL		; onto its CR
  0E16'   DA 0E1E'              	JC	DC_1
  0E19'   FE 0D                 	CPI	CR
  0E1B'   CC 0000*              	CZ	PUTCUR
  0E1E'                         DC_1:
  0E1E'   3E 01                 	MVI	A,1
  0E20'   B7                    	ORA	A
  0E21'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0E22'                         LNINC:
  0E22'   E5                    	PUSH	H
  0E23'   2A 0000*              	LHLD	LNDLT
  0E26'   7C                    	MOV	A,H
  0E27'   FE 40                 	CPI	40H
  0E29'   CA 0E3E'              	JZ	LN_X
  0E2C'   23                    	INX	H
  0E2D'   C3 0E3B'              	JMP	LN_ST
  0E30'                         LNDEC:
  0E30'   E5                    	PUSH	H
  0E31'   2A 0000*              	LHLD	LNDLT
  0E34'   7C                    	MOV	A,H
  0E35'   FE C0                 	CPI	0C0H
  0E37'   CA 0E3E'              	JZ	LN_X
  0E3A'   2B                    	DCX	H
  0E3B'                         LN_ST:
  0E3B'   22 0000*              	SHLD	LNDLT
  0E3E'                         LN_X:
  0E3E'   E1                    	POP	H
  0E3F'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


                                
  0E40'   AF                    VC_E:	XRA	A
  0E41'   32 2F10'              	STA	WBIG
  0E44'   C3 0E4C'              	JMP	EDO
  0E47'   3E 01                 VCBGE:	MVI	A,1
  0E49'   32 2F10'              	STA	WBIG
  0E4C'   CD 085B'              EDO:	CALL	SETMOV
  0E4F'   CD 0786'              	CALL	GETCNT
  0E52'   22 2F53'              	SHLD	CNTV
  0E55'   2A 2F53'              EDO_LP: LHLD	CNTV
  0E58'   7C                    	MOV	A,H
  0E59'   B5                    	ORA	L
  0E5A'   CA 0C84'              	JZ	WDO_DN		; not left on a line's end, as after 'w'
  0E5D'   2B                    	DCX	H
  0E5E'   22 2F53'              	SHLD	CNTV
  0E61'   CD 0E6F'              	CALL	ESTEP
  0E64'   21 2F3E'              	LXI	H,CWEOL		; only the count's first word stays where it is
  0E67'   36 00                 	MVI	M,0
  0E69'   D2 0E55'              	JNC	EDO_LP
  0E6C'   C3 0C84'              	JMP	WDO_DN
                                
                                ;ESTEP -- vim end_word, once: forward to the end of the next word.  CY =
                                ; failed: the file ran out (the cursor is left on its last line's end).  Like
                                ; FWD1 it steps with INCC, which reads through the pager, so a count runs on
                                ; through the whole file; it once scanned window offsets, and stopped for good
                                ; at the last line the window held.
  0E6F'                         ESTEP:
  0E6F'   CD 0D84'              	CALL	CCLS
  0E72'   32 2F5D'              	STA	WKCLS		; the starting class
  0E75'   CD 0DBE'              	CALL	INCC
  0E78'   B7                    	ORA	A
  0E79'   FA 0E9F'              	JM	ES_F
  0E7C'   CD 0D84'              	CALL	CCLS
  0E7F'   B7                    	ORA	A
  0E80'   CA 0E8A'              	JZ	ES_ST
  0E83'   21 2F5D'              	LXI	H,WKCLS
  0E86'   BE                    	CMP	M
  0E87'   CA 0EA1'              	JZ	ES_SK		; still in the word it started in: on to its end
  0E8A'                         ES_ST:
  0E8A'   3A 2F3E'              	LDA	CWEOL		; it started on a word's last char.  As 'cw'
  0E8D'   B7                    	ORA	A		;   that char is the word's end already, and
  0E8E'   C2 0EB8'              	JNZ	ES_BK		;   the step stays on it (vim end_word, 'stop')
  0E91'                         ES_WS:
  0E91'   CD 0D84'              	CALL	CCLS		; over blanks, line ends and empty lines
  0E94'   B7                    	ORA	A
  0E95'   C2 0EA1'              	JNZ	ES_SK
  0E98'   CD 0DBE'              	CALL	INCC
  0E9B'   B7                    	ORA	A
  0E9C'   F2 0E91'              	JP	ES_WS
  0E9F'                         ES_F:
  0E9F'   37                    	STC
  0EA0'   C9                    	RET
  0EA1'                         ES_SK:
  0EA1'   CD 0D84'              	CALL	CCLS		; past the rest of this word ...
  0EA4'   32 2F5D'              	STA	WKCLS
  0EA7'                         ES_SL:
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EA7'   CD 0DBE'              	CALL	INCC
  0EAA'   B7                    	ORA	A
  0EAB'   FA 0E9F'              	JM	ES_F
  0EAE'   CD 0D84'              	CALL	CCLS
  0EB1'   21 2F5D'              	LXI	H,WKCLS
  0EB4'   BE                    	CMP	M
  0EB5'   CA 0EA7'              	JZ	ES_SL
  0EB8'   C3 0E00'              ES_BK:	JMP	DECC		; ... and back onto its last char (NC)
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's place among the screen's LINES (CURRW) and the
                                ; last layout's facts from SCRN.MAC: SCBOT (the last line shown), SCEOF / SCBOF
                                ; (the file's end / start is on the screen).  H and L count lines.  M and the
                                ; scrolls count screen ROWS, as vim does once lines wrap, and a line's rows
                                ; are not known without measuring it: SCRN.MAC's HTBLD measures the lines
                                ; about the screen into a table (HTAB), and the rest is arithmetic on that.
                                ; A scroll then moves the cursor and names the line the screen is to start
                                ; with (HTLAND -> SETRWT), so the text scrolls around it.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0EBB'                         CURRW:
  0EBB'   2A 0000*              	LHLD	WINROW
  0EBE'   EB                    	XCHG
  0EBF'   2A 0000*              	LHLD	LNDLT
  0EC2'   19                    	DAD	D		; HL = row (signed)
  0EC3'   7C                    	MOV	A,H
  0EC4'   B7                    	ORA	A
  0EC5'   FA 0ED8'              	JM	CRW_0		; above the screen -> top row
  0EC8'   C2 0ED3'              	JNZ	CRW_BT		; far below -> bottom row
  0ECB'   3A 0000*              	LDA	NEDIT
  0ECE'   3D                    	DCR	A		; A = bottom row
  0ECF'   BD                    	CMP	L		; CY iff bottom < row
  0ED0'   D8                    	RC
  0ED1'   7D                    	MOV	A,L
  0ED2'   C9                    	RET
  0ED3'                         CRW_BT:
  0ED3'   3A 0000*              	LDA	NEDIT
  0ED6'   3D                    	DCR	A
  0ED7'   C9                    	RET
  0ED8'                         CRW_0:
  0ED8'   AF                    	XRA	A
  0ED9'   C9                    	RET
                                
                                ;SETRWT -- A = lines: the next layout puts that many above the cursor's, and
                                ; does not ask whether the line has gone far (PLACE).
  0EDA'                         SETRWT:
  0EDA'   2A 0000*              	LHLD	LNDLT
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0EDD'   EB                    	XCHG
  0EDE'   6F                    	MOV	L,A
  0EDF'   26 00                 	MVI	H,0
  0EE1'   CD 0000*              	CALL	SUBHD		; HL = lines - LNDLT
  0EE4'   22 0000*              	SHLD	WINROW
  0EE7'   3E 01                 	MVI	A,PL_SET
  0EE9'   32 0000*              	STA	PLACE
  0EEC'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0EED'                         MVROW:
  0EED'   47                    	MOV	B,A
  0EEE'   CD 0EBB'              	CALL	CURRW
  0EF1'   90                    	SUB	B		; A = row now - target
  0EF2'                         MR_GO:
  0EF2'   C8                    	RZ
  0EF3'   DA 0EFC'              	JC	MR_DN
  0EF6'   6F                    	MOV	L,A
  0EF7'   26 00                 	MVI	H,0
  0EF9'   C3 0AEF'              	JMP	KCORE
  0EFC'                         MR_DN:
  0EFC'   2F                    	CMA
  0EFD'   3C                    	INR	A		; A = target - row now
  0EFE'   6F                    	MOV	L,A
  0EFF'   26 00                 	MVI	H,0
  0F01'   C3 0A0F'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0F04'                         VC_HIGH:
  0F04'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  0F07'   2B                    	DCX	H		; row = count - 1
  0F08'   7C                    	MOV	A,H
  0F09'   B7                    	ORA	A
  0F0A'   3A 0000*              	LDA	SCBOT
  0F0D'   C2 0F15'              	JNZ	VH_GO		; >= 256 -> the last text row
  0F10'   BD                    	CMP	L		; CY iff SCBOT < row
  0F11'   DA 0F15'              	JC	VH_GO
  0F14'   7D                    	MOV	A,L
  0F15'                         VH_GO:
  0F15'   CD 0EED'              	CALL	MVROW
  0F18'   C3 0954'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': the line the middle ROW of the text is on (vim: the first
                                ; whose rows, with those above it, come to half of them); count ignored.
  0F1B'                         VC_MIDL:
  0F1B'   CD 0773'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0F1E'   CD 11AD'              	CALL	HTSCR		; HL -> the top line's rows
  0F21'   3A 0000*              	LDA	TXEND
  0F24'   3C                    	INR	A
  0F25'   B7                    	ORA	A
  0F26'   1F                    	RAR
  0F27'   3D                    	DCR	A
  0F28'   4F                    	MOV	C,A		; C = (rows of text + 1) / 2 - 1
  0F29'   CD 11F3'              	CALL	HTFQ
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0F2C'   D2 0F30'              	JNC	VM_GO
  0F2F'   2B                    	DCX	H
  0F30'                         VM_GO:
  0F30'   CD 11E8'              	CALL	HTGO
  0F33'   C3 0954'              	JMP	FNBLNK
                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0F36'                         VC_LOWL:
  0F36'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  0F39'   2B                    	DCX	H		; count - 1
  0F3A'   3A 0000*              	LDA	SCBOT
  0F3D'   5F                    	MOV	E,A
  0F3E'   16 00                 	MVI	D,0
  0F40'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0F41'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0F44'   3E 00                 	MVI	A,0
  0F46'   D2 0F4D'              	JNC	VL_GO		; at or past the top -> row 0
  0F49'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0F4C'   7D                    	MOV	A,L
  0F4D'                         VL_GO:
  0F4D'   CD 0EED'              	CALL	MVROW
  0F50'   C3 0954'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the text forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is the
                                ; screen's ROWS less the overlap (OVLAP), and the line that many rows down
                                ; becomes the top line -- from its first row, vim never showing part of one.
                                ; The top line stops at the last line ('~' rows below); no-op when it is
                                ; already there.
  0F53'                         VC_PGDN:
  0F53'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  0F56'   22 2F1B'              	SHLD	RWR
  0F59'   3A 0000*              	LDA	SCEOF
  0F5C'   B7                    	ORA	A
  0F5D'   CA 0F65'              	JZ	VPD_N
  0F60'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: it becomes the
  0F63'   B7                    	ORA	A		;   top line
  0F64'   C8                    	RZ			; it already is
  0F65'                         VPD_N:
  0F65'   3A 0000*              	LDA	NEDIT
  0F68'   3C                    	INR	A
  0F69'   4F                    	MOV	C,A
  0F6A'   3E 02                 	MVI	A,2
  0F6C'   CD 11B4'              	CALL	HTSET		; HL -> the top line's rows
  0F6F'   E5                    	PUSH	H
  0F70'   C5                    	PUSH	B
  0F71'   3A 0000*              	LDA	NEDIT
  0F74'   4F                    	MOV	C,A
  0F75'   CD 11F3'              	CALL	HTFQ		; HL -> the first line the screen has not room for
  0F78'   3A 0000*              	LDA	NEDIT
  0F7B'   DA 0F88'              	JC	VPD_R		; there is none: no overlap
  0F7E'   3A 2F16'              	LDA	HTN
  0F81'   90                    	SUB	B
  0F82'   3C                    	INR	A
  0F83'   47                    	MOV	B,A		; the lines from it up to the table's first
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0F84'   AF                    	XRA	A
  0F85'   CD 1022'              	CALL	OVLAP
  0F88'                         VPD_R:
  0F88'   CD 1071'              	CALL	PGROWS		; RWR = the rows to go
  0F8B'   C1                    	POP	B
  0F8C'   E1                    	POP	H
  0F8D'   CD 1234'              	CALL	RWFWD		; HL -> the line that row is in, C = which of its
  0F90'   DA 0FAC'              	JC	VPD_TP		; the text ended: its last line
  0F93'   79                    	MOV	A,C
  0F94'   B7                    	ORA	A
  0F95'   CA 0FAC'              	JZ	VPD_TP
  0F98'   3A 2F1D'              	LDA	RWMV		; part of the way down a line: its start -- unless
  0F9B'   B7                    	ORA	A		;   that is the top line still, then the next
  0F9C'   C2 0FAC'              	JNZ	VPD_TP
  0F9F'   E5                    	PUSH	H
  0FA0'   CD 11E2'              	CALL	HTIX
  0FA3'   21 2F18'              	LXI	H,HTTP
  0FA6'   BE                    	CMP	M
  0FA7'   E1                    	POP	H
  0FA8'   C2 0FAC'              	JNZ	VPD_TP
  0FAB'   23                    	INX	H
  0FAC'                         VPD_TP:
  0FAC'   54                    	MOV	D,H
  0FAD'   5D                    	MOV	E,L
  0FAE'   C3 111B'              	JMP	HTLAND
                                
                                ;VC_PGUP -- '^B': the text back count pages, not above the first line, the
                                ; cursor on the last line that then shows whole, first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is the screen's ROWS less the overlap
                                ; (OVLAP).  Where that ends part of the way up a line, the top line is the one
                                ; under it -- but the line itself, when it is the first one back.  No-op when
                                ; the first line is already at the top.
  0FB1'                         VC_PGUP:
  0FB1'   CD 0773'              	CALL	MOVCNT		; a cursor motion, and its count
  0FB4'   22 2F1B'              	SHLD	RWR
  0FB7'   3A 0000*              	LDA	SCBOF
  0FBA'   B7                    	ORA	A
  0FBB'   C0                    	RNZ
  0FBC'   CD 0EBB'              	CALL	CURRW		; OVLAP reads the top line and the two under it:
  0FBF'   FE 02                 	CPI	2		;   lines the cursor's is not below are read for
  0FC1'   0E 01                 	MVI	C,1
  0FC3'   D2 0FCA'              	JNC	VPU_1
  0FC6'   3A 0000*              	LDA	NEDIT
  0FC9'   4F                    	MOV	C,A
  0FCA'                         VPU_1:
  0FCA'   3A 0000*              	LDA	NEDIT
  0FCD'   CD 11B4'              	CALL	HTSET		; HL -> the top line's rows, E = lines above it
  0FD0'   E5                    	PUSH	H
  0FD1'   D5                    	PUSH	D
  0FD2'   2B                    	DCX	H		; the line above the top one, and on down
  0FD3'   04                    	INR	B
  0FD4'   3E 01                 	MVI	A,1
  0FD6'   CD 1022'              	CALL	OVLAP
  0FD9'   CD 1071'              	CALL	PGROWS		; RWR = the rows to go
  0FDC'   D1                    	POP	D
  0FDD'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  0FDE'   43                    	MOV	B,E
  0FDF'   CD 1274'              	CALL	RWBAK		; HL -> the line that row is in, C = its rows
  0FE2'   DA 0FFF'              	JC	VPU_3		;   above it; or the file's first line
  0FE5'   79                    	MOV	A,C
  0FE6'   B7                    	ORA	A
  0FE7'   CA 0FFF'              	JZ	VPU_3
  0FEA'   3A 2F1D'              	LDA	RWMV
  0FED'   B7                    	ORA	A
  0FEE'   C2 0FFE'              	JNZ	VPU_2
  0FF1'   E5                    	PUSH	H
  0FF2'   CD 11E2'              	CALL	HTIX
  0FF5'   3C                    	INR	A
  0FF6'   21 2F18'              	LXI	H,HTTP
  0FF9'   BE                    	CMP	M
  0FFA'   E1                    	POP	H
  0FFB'   CA 0FFF'              	JZ	VPU_3		; the first line back: all of it
  0FFE'                         VPU_2:
  0FFE'   23                    	INX	H
  0FFF'                         VPU_3:
  0FFF'   CD 11E8'              	CALL	HTGO		; the cursor on the new top line ...
  1002'   3A 0000*              	LDA	NEDIT
  1005'   4F                    	MOV	C,A
  1006'   06 00                 	MVI	B,0
  1008'   CD 11C9'              	CALL	HTRB		; ... and the lines under it measured
  100B'   E5                    	PUSH	H
  100C'   3A 0000*              	LDA	NEDIT
  100F'   4F                    	MOV	C,A
  1010'   CD 11F3'              	CALL	HTFQ		; HL -> the first the screen has not room for
  1013'   2B                    	DCX	H
  1014'   D1                    	POP	D		; DE -> the top line's rows
  1015'   EB                    	XCHG
  1016'   CD 0000*              	CALL	CMP16		; CY iff that is above the top line (it alone
  1019'   D2 101E'              	JNC	VPU_4		;   fills the screen)
  101C'   54                    	MOV	D,H
  101D'   5D                    	MOV	E,L
  101E'                         VPU_4:
  101E'   EB                    	XCHG
  101F'   C3 111B'              	JMP	HTLAND
                                
                                ;OVLAP -- A = the rows one page scrolls, as vim's get_scroll_overlap: the
                                ; screen less two lines of overlap -- or less one, or none, where the lines at
                                ; that edge are too tall to be shown twice or the file ends among them.
                                ;   in : HL -> the rows of the line just off the screen at that edge (h1),
                                ;        A = 0 when the next (h2, h3, h4) are above it in the table, 1 when
                                ;        below, B = the entries the table has that way, h1's among them
  1022'                         OVLAP:
  1022'   32 2F1E'              	STA	OVDIR
  1025'   3A 0000*              	LDA	NEDIT
  1028'   D6 02                 	SUI	2
  102A'   4F                    	MOV	C,A		; C = the rows two lines of overlap leave
  102B'   56                    	MOV	D,M		; D = h1
  102C'   CD 1063'              	CALL	OV_NX
  102F'   DA 105F'              	JC	OV_0
  1032'   5E                    	MOV	E,M		; E = h2
  1033'   7A                    	MOV	A,D
  1034'   83                    	ADD	E
