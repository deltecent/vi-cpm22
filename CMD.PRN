  29E6'   67                    	DB	'g'
  29E7'   0F46'                 	DW	VC_LG
  29E9'   78                    	DB	'x'
  29EA'   1538'                 	DW	VC_X
  29EC'   5A                    	DB	'Z'
  29ED'   1CD7'                 	DW	VC_BZ
  29EF'   66                    	DB	'f'
