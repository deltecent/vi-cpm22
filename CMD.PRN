  0A94'   23                    	INX	H		; no content: the line's start
  0A95'                         JL_LS:
  0A95'   EB                    	XCHG
  0A96'                         JL_GO:
  0A96'   D5                    	PUSH	D		; DE = step from the line start
  0A97'   CD 0000*              	CALL	CUROFF
  0A9A'   D1                    	POP	D
  0A9B'   19                    	DAD	D
  0A9C'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0A9F'   AF                    VC_W:	XRA	A
  0AA0'   32 2A14'              	STA	WBIG
  0AA3'   C3 0AAB'              	JMP	WDO
  0AA6'   3E 01                 VCBGW:	MVI	A,1
  0AA8'   32 2A14'              	STA	WBIG
  0AAB'   CD 075A'              WDO:	CALL	SETMOV
  0AAE'   AF                    	XRA	A
  0AAF'   32 2A15'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0AB2'   CD 068B'              	CALL	GETCNT
  0AB5'   22 2A4C'              	SHLD	CNTV
  0AB8'   2A 2A4C'              WDO_LP: LHLD	CNTV
  0ABB'   7C                    	MOV	A,H
  0ABC'   B5                    	ORA	L
  0ABD'   CA 0ACA'              	JZ	WDO_DN
  0AC0'   2B                    	DCX	H
  0AC1'   22 2A4C'              	SHLD	CNTV
  0AC4'   CD 0B1A'              	CALL	FWD1
  0AC7'   D2 0AB8'              	JNC	WDO_LP
  0ACA'                         WDO_DN:
  0ACA'   CD 0A1D'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0ACD'   DA 0ADA'              	JC	WDO_NL
  0AD0'   FE 0D                 	CPI	CR
  0AD2'   CA 0ADA'              	JZ	WDO_NL
  0AD5'   FE 0A                 	CPI	LF
  0AD7'   C2 057D'              	JNZ	SETGL
  0ADA'                         WDO_NL:
  0ADA'   CD 0000*              	CALL	PEEKL
  0ADD'   DA 057D'              	JC	SETGL
  0AE0'   FE 0A                 	CPI	LF
  0AE2'   CA 057D'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  0AE5'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  0AE7'   32 2A15'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0AEA'   CD 0C12'              	CALL	DECC		; back onto its last char
  0AED'   C3 057D'              	JMP	SETGL
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


                                
  0AF0'   AF                    VC_B:	XRA	A
  0AF1'   32 2A14'              	STA	WBIG
  0AF4'   C3 0AFC'              	JMP	BDO
  0AF7'   3E 01                 VCBGB:	MVI	A,1
  0AF9'   32 2A14'              	STA	WBIG
  0AFC'   CD 075A'              BDO:	CALL	SETMOV
  0AFF'   CD 068B'              	CALL	GETCNT
  0B02'   22 2A4C'              	SHLD	CNTV
  0B05'   2A 2A4C'              BDO_LP: LHLD	CNTV
  0B08'   7C                    	MOV	A,H
  0B09'   B5                    	ORA	L
  0B0A'   CA 057D'              	JZ	SETGL
  0B0D'   2B                    	DCX	H
  0B0E'   22 2A4C'              	SHLD	CNTV
  0B11'   CD 0B63'              	CALL	BCK1
  0B14'   D2 0B05'              	JNC	BDO_LP
  0B17'   C3 057D'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char, and is left on the line's end past it, as any 'w' that runs off a line
                                ; is: WDO_DN pulls it back and says so (WPULL), so that 'dw' there takes the
                                ; char as it does on the last char of any other line.
  0B1A'                         FWD1:
  0B1A'   CD 0B96'              	CALL	CCLS
  0B1D'   32 2A58'              	STA	WKCLS		; the starting class
  0B20'   CD 0BD0'              	CALL	INCC
  0B23'   B7                    	ORA	A
  0B24'   CA 0B39'              	JZ	FW_WD
  0B27'   37                    	STC
  0B28'   F8                    	RM			; -1: already at the end
  0B29'   FE 02                 	CPI	2
  0B2B'   C2 0B39'              	JNZ	FW_WD		; 1: a next line was reached
  0B2E'   CD 0A1D'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0B31'   D4 0BB7'              	CNC	NXLN
  0B34'   D2 0B39'              	JNC	FW_WD
  0B37'   37                    	STC			; yes: failed
  0B38'   C9                    	RET
  0B39'                         FW_WD:
  0B39'   3A 2A58'              	LDA	WKCLS		; go past the rest of this word
  0B3C'   B7                    	ORA	A
  0B3D'   CA 0B52'              	JZ	FW_WS
  0B40'                         FW_WLP:
  0B40'   CD 0B96'              	CALL	CCLS
  0B43'   21 2A58'              	LXI	H,WKCLS
  0B46'   BE                    	CMP	M
  0B47'   C2 0B52'              	JNZ	FW_WS
  0B4A'   CD 0BD0'              	CALL	INCC
  0B4D'   B7                    	ORA	A
  0B4E'   F8                    	RM			; the end of the file (NC)
  0B4F'   C3 0B40'              	JMP	FW_WLP
  0B52'                         FW_WS:
  0B52'   CD 0B96'              	CALL	CCLS		; then over blanks to the next word
  0B55'   B7                    	ORA	A
  0B56'   C0                    	RNZ
  0B57'   CD 0B9E'              	CALL	EMPTY
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0B5A'   C8                    	RZ			; an empty line is a word
  0B5B'   CD 0BD0'              	CALL	INCC
  0B5E'   B7                    	ORA	A
  0B5F'   F8                    	RM
  0B60'   C3 0B52'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0B63'                         BCK1:
  0B63'   CD 0C12'              	CALL	DECC
  0B66'   B7                    	ORA	A
  0B67'   37                    	STC
  0B68'   F8                    	RM
