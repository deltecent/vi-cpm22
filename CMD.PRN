  0A81'   E1                    	POP	H
  0A82'   C3 0A96'              	JMP	JL_GO
  0A85'                         JL_NX:
  0A85'   C1                    	POP	B
  0A86'   E1                    	POP	H
  0A87'   13                    	INX	D
  0A88'   C3 0A4E'              	JMP	JL_RD
  0A8B'                         JL_END:
