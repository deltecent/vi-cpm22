  1E50'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
	MACRO-80 3.44	09-Dec-81	PAGE	1-95


                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  1E51'                         EXADDR:
  1E51'   AF                    	XRA	A
  1E52'   32 249F'              	STA	SRNGF
  1E55'   7E                    	MOV	A,M
  1E56'   FE 25                 	CPI	'%'
  1E58'   CA 1E81'              	JZ	EXA_AL
  1E5B'   EB                    	XCHG			; DE walks the line, HL takes the number
  1E5C'   CD 1E96'              	CALL	EXNUM
  1E5F'   DA 1E7F'              	JC	EXA_NO
  1E62'   22 24A0'              	SHLD	SRNG1
  1E65'   22 24A2'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  1E68'   1A                    	LDAX	D
  1E69'   FE 2C                 	CPI	','
  1E6B'   C2 1E78'              	JNZ	EXA_YS
  1E6E'   13                    	INX	D
  1E6F'   CD 1E96'              	CALL	EXNUM
  1E72'   DA 1E7F'              	JC	EXA_NO		; ',' with no number: not a range at all
  1E75'   22 24A2'              	SHLD	SRNG2
  1E78'                         EXA_YS:
  1E78'   EB                    	XCHG
  1E79'   3E 01                 	MVI	A,1
  1E7B'   32 249F'              	STA	SRNGF
  1E7E'   C9                    	RET
  1E7F'                         EXA_NO:
  1E7F'   EB                    	XCHG
  1E80'   C9                    	RET
  1E81'                         EXA_AL:
  1E81'   23                    	INX	H
  1E82'   E5                    	PUSH	H
  1E83'   21 0001               	LXI	H,1
  1E86'   22 24A0'              	SHLD	SRNG1
  1E89'   21 FFFF               	LXI	H,0FFFFH
  1E8C'   22 24A2'              	SHLD	SRNG2
  1E8F'   E1                    	POP	H
  1E90'   3E 01                 	MVI	A,1
  1E92'   32 249F'              	STA	SRNGF
  1E95'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  1E96'                         EXNUM:
  1E96'   1A                    	LDAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-96


  1E97'   D6 30                 	SUI	'0'
  1E99'   D8                    	RC
  1E9A'   FE 0A                 	CPI	10
  1E9C'   3F                    	CMC
  1E9D'   D8                    	RC
  1E9E'   21 0000               	LXI	H,0
  1EA1'                         EXN_LP:
  1EA1'   1A                    	LDAX	D
  1EA2'   D6 30                 	SUI	'0'
  1EA4'   DA 1EBE'              	JC	EXN_DN
  1EA7'   FE 0A                 	CPI	10
  1EA9'   D2 1EBE'              	JNC	EXN_DN
  1EAC'   13                    	INX	D
  1EAD'   C5                    	PUSH	B
  1EAE'   4F                    	MOV	C,A
  1EAF'   06 00                 	MVI	B,0		; BC = the digit
  1EB1'   D5                    	PUSH	D
  1EB2'   54                    	MOV	D,H
  1EB3'   5D                    	MOV	E,L
  1EB4'   29                    	DAD	H		; *2
  1EB5'   29                    	DAD	H		; *4
  1EB6'   19                    	DAD	D		; *5
  1EB7'   29                    	DAD	H		; *10
  1EB8'   D1                    	POP	D
  1EB9'   09                    	DAD	B
  1EBA'   C1                    	POP	B
  1EBB'   C3 1EA1'              	JMP	EXN_LP
  1EBE'                         EXN_DN:
  1EBE'   B7                    	ORA	A		; CY clear: there was a number
  1EBF'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  1EC0'                         EX_S:
  1EC0'   7E                    	MOV	A,M
  1EC1'   B7                    	ORA	A
  1EC2'   CA 1F04'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  1EC5'   32 24A4'              	STA	SDELIM
  1EC8'   23                    	INX	H
  1EC9'   11 0000*              	LXI	D,SRCHST
  1ECC'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  1ECF'   4F                    	MOV	C,A
  1ED0'   CD 1F0A'              	CALL	SCOPY
  1ED3'   78                    	MOV	A,B
  1ED4'   B7                    	ORA	A
  1ED5'   CA 1F04'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  1ED8'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  1EDB'   3E 01                 	MVI	A,1
  1EDD'   32 2477'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  1EE0'   11 24B1'              	LXI	D,SREPL
  1EE3'   0E 24                 	MVI	C,SREPMX
  1EE5'   CD 1F0A'              	CALL	SCOPY
  1EE8'   78                    	MOV	A,B
  1EE9'   32 24B0'              	STA	SREPLN
  1EEC'   AF                    	XRA	A
  1EED'   32 24A5'              	STA	SGFLAG
	MACRO-80 3.44	09-Dec-81	PAGE	1-97


  1EF0'   7E                    	MOV	A,M
  1EF1'   FE 67                 	CPI	'g'
  1EF3'   C2 1EFC'              	JNZ	EX_SG
  1EF6'   23                    	INX	H
  1EF7'   3E 01                 	MVI	A,1
  1EF9'   32 24A5'              	STA	SGFLAG
  1EFC'                         EX_SG:
  1EFC'   7E                    	MOV	A,M
  1EFD'   B7                    	ORA	A
  1EFE'   C2 1CE5'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  1F01'   C3 1F2A'              	JMP	SUBGO
  1F04'                         SUBNOP:
  1F04'   21 1D91'              	LXI	H,SNOPAT
  1F07'   C3 1CF3'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  1F0A'                         SCOPY:
  1F0A'   06 00                 	MVI	B,0
  1F0C'                         SCP_LP:
  1F0C'   78                    	MOV	A,B
  1F0D'   B9                    	CMP	C
  1F0E'   D2 1F27'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  1F11'   7E                    	MOV	A,M
  1F12'   B7                    	ORA	A
  1F13'   CA 1F27'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  1F16'   E5                    	PUSH	H
  1F17'   21 24A4'              	LXI	H,SDELIM
  1F1A'   BE                    	CMP	M
  1F1B'   E1                    	POP	H
  1F1C'   CA 1F26'              	JZ	SCP_SK
  1F1F'   12                    	STAX	D
  1F20'   13                    	INX	D
  1F21'   23                    	INX	H
  1F22'   04                    	INR	B
  1F23'   C3 1F0C'              	JMP	SCP_LP
  1F26'                         SCP_SK:
  1F26'   23                    	INX	H
  1F27'                         SCP_DN:
  1F27'   AF                    	XRA	A
  1F28'   12                    	STAX	D
  1F29'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  1F2A'                         SUBGO:
  1F2A'   CD 0DF6'              	CALL	GZONE
  1F2D'   2A 0000*              	LHLD	LNDLT
  1F30'   22 24AE'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  1F33'   CD 0000*              	CALL	CUROFF		;   finds nothing puts both back, as the
  1F36'   22 24AC'              	SHLD	SOFFS		;   search's SN_BAD does
  1F39'   AF                    	XRA	A
  1F3A'   32 24A6'              	STA	SANY
	MACRO-80 3.44	09-Dec-81	PAGE	1-98


  1F3D'   21 0000               	LXI	H,0
  1F40'   22 24A8'              	SHLD	SBACK
  1F43'   3A 249F'              	LDA	SRNGF
  1F46'   B7                    	ORA	A
  1F47'   CA 1F70'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  1F4A'   2A 24A0'              	LHLD	SRNG1
  1F4D'   7C                    	MOV	A,H
  1F4E'   B5                    	ORA	L
  1F4F'   CA 1FEC'              	JZ	SUBBAD		; ':0s' -- there is no line 0
  1F52'   2A 24A2'              	LHLD	SRNG2
  1F55'   EB                    	XCHG
  1F56'   2A 24A0'              	LHLD	SRNG1
  1F59'   CD 0000*              	CALL	CMP16		; CY iff SRNG2 < SRNG1
  1F5C'   DA 1FEC'              	JC	SUBBAD		; backwards: vim offers to swap, this refuses
  1F5F'   EB                    	XCHG			; HL = the last line, DE = the first
  1F60'   CD 0000*              	CALL	SUBHD
  1F63'   23                    	INX	H		; HL = the lines in the range
  1F64'   22 24AA'              	SHLD	SLINES
  1F67'   2A 24A0'              	LHLD	SRNG1
  1F6A'   CD 0D84'              	CALL	GOLN
  1F6D'   C3 1F76'              	JMP	SUBLP
  1F70'                         SUB_1L:
  1F70'   21 0001               	LXI	H,1
  1F73'   22 24AA'              	SHLD	SLINES
  1F76'                         SUBLP:
  1F76'   CD 1FF2'              	CALL	SUBLIN		; A = 1 when this line changed
  1F79'   B7                    	ORA	A
  1F7A'   CA 1F88'              	JZ	SUB_NX
  1F7D'   3E 01                 	MVI	A,1
  1F7F'   32 24A6'              	STA	SANY
  1F82'   21 0000               	LXI	H,0
  1F85'   22 24A8'              	SHLD	SBACK		; the cursor is ON the last line changed
  1F88'                         SUB_NX:
  1F88'   2A 24AA'              	LHLD	SLINES
  1F8B'   2B                    	DCX	H
  1F8C'   22 24AA'              	SHLD	SLINES
  1F8F'   7C                    	MOV	A,H
  1F90'   B5                    	ORA	L
  1F91'   CA 1FAF'              	JZ	SUBDON		; the range is spent
  1F94'   21 0001               	LXI	H,1
  1F97'   AF                    	XRA	A
  1F98'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  1F9B'   3A 24A6'              	LDA	SANY
  1F9E'   B7                    	ORA	A
  1F9F'   CA 1FA9'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  1FA2'   2A 24A8'              	LHLD	SBACK
  1FA5'   23                    	INX	H
  1FA6'   22 24A8'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
  1FA9'                         SUB_AE:
  1FA9'   CD 08C9'              	CALL	ATEOF
  1FAC'   D2 1F76'              	JNC	SUBLP		; ... unless that ran off the end of the file
  1FAF'                         SUBDON:
  1FAF'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
	MACRO-80 3.44	09-Dec-81	PAGE	1-99


  1FB2'   3A 24A6'              	LDA	SANY
  1FB5'   B7                    	ORA	A
  1FB6'   CA 1FD4'              	JZ	SUBNFD
  1FB9'   3E 01                 	MVI	A,1
  1FBB'   32 2404'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  1FBE'   2A 24A8'              	LHLD	SBACK
  1FC1'   7C                    	MOV	A,H
  1FC2'   B5                    	ORA	L
  1FC3'   CA 1FCE'              	JZ	SUB_PL
  1FC6'   3E FF                 	MVI	A,0FFH
  1FC8'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  1FCB'   CD 0000*              	CALL	CLRCNT
  1FCE'                         SUB_PL:
  1FCE'   CD 0E0E'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  1FD1'   C3 0640'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  1FD4'                         SUBNFD:
  1FD4'   2A 24AC'              	LHLD	SOFFS
  1FD7'   CD 0000*              	CALL	GOTO
  1FDA'   2A 24AE'              	LHLD	SLDLTS
  1FDD'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  1FE0'   21 1D7D'              	LXI	H,SNOTFD
  1FE3'   CD 1CF3'              	CALL	EXERR
  1FE6'   21 0000*              	LXI	H,SRCHST
  1FE9'   C3 1CEE'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  1FEC'                         SUBBAD:
  1FEC'   21 1D6B'              	LXI	H,SNOT
  1FEF'   C3 1CE8'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  1FF2'                         SUBLIN:
  1FF2'   AF                    	XRA	A
  1FF3'   32 24A7'              	STA	SLCHG
  1FF6'   CD 2071'              	CALL	SUBBOL
  1FF9'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
  1FFC'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  1FFC'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  1FFF'   DA 2007'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  2002'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  2004'   C2 1FFC'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
	MACRO-80 3.44	09-Dec-81	PAGE	1-100


                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2007'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2007'   CD 0000*              	CALL	CUROFF
  200A'   E5                    	PUSH	H
  200B'   CD 11AF'              	CALL	CEND
  200E'   D1                    	POP	D
  200F'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  2012'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  2013'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2016'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2017'   B7                    	ORA	A		;   span is a line, not a pair.)
  2018'   FA 206A'              	JM	SUBL_D		; what is left is shorter than the pattern
  201B'   44                    	MOV	B,H
  201C'   4D                    	MOV	C,L		; BC = the start positions a match can take
  201D'   11 0000*              	LXI	D,SRCHST
  2020'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  2023'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  2026'   DA 206A'              	JC	SUBL_D
  2029'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  202C'   EB                    	XCHG
  202D'   2A 0000*              	LHLD	GAPEND
  2030'   EB                    	XCHG
  2031'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  2034'   EB                    	XCHG
  2035'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  2036'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  2039'   D1                    	POP	D
  203A'   19                    	DAD	D		; ... and so the match's logical offset
  203B'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  203E'   3A 24A6'              	LDA	SANY
  2041'   B7                    	ORA	A
  2042'   C2 204F'              	JNZ	SUBL_C
  2045'   3A 24A7'              	LDA	SLCHG
  2048'   B7                    	ORA	A
  2049'   C2 204F'              	JNZ	SUBL_C
  204C'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  204F'                         SUBL_C:
  204F'   3A 0000*              	LDA	SRCHBF
  2052'   6F                    	MOV	L,A
  2053'   26 00                 	MVI	H,0
  2055'   CD 0000*              	CALL	DELFWD		; the match goes
  2058'   11 24B0'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  205B'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
                                				;   its string above it, 'u' capture included
  205E'                         SUBL_I:
  205E'   3E 01                 	MVI	A,1
  2060'   32 24A7'              	STA	SLCHG
  2063'   3A 24A5'              	LDA	SGFLAG
	MACRO-80 3.44	09-Dec-81	PAGE	1-101


  2066'   B7                    	ORA	A
  2067'   C2 2007'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  206A'                         SUBL_D:
  206A'   CD 2071'              	CALL	SUBBOL
  206D'   3A 24A7'              	LDA	SLCHG
  2070'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  2071'                         SUBBOL:
  2071'   CD 0000*              	CALL	CUROFF
  2074'   CD 050B'              	CALL	BOL
  2077'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  207A'                         VC_SRCH:
  207A'   CD 061F'              	CALL	SETMOV
  207D'   C5                    	PUSH	B
  207E'   CD 05B2'              	CALL	GETCNT
  2081'   22 2498'              	SHLD	SCNT
  2084'   C1                    	POP	B
  2085'   79                    	MOV	A,C
  2086'   FE 2F                 	CPI	'/'
  2088'   3E 00                 	MVI	A,0
  208A'   CA 208F'              	JZ	VS_DIR
  208D'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  208F'                         VS_DIR:
  208F'   32 2475'              	STA	SDIR
  2092'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2095'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2098'   47                    	MOV	B,A
  2099'   CD 1843'              	CALL	RDLINE
  209C'   B7                    	ORA	A
  209D'   C0                    	RNZ			; cancelled: nothing happens at all
  209E'   3A 244D'              	LDA	RLLEN
  20A1'   B7                    	ORA	A
  20A2'   CA 20B7'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  20A5'   5F                    	MOV	E,A
  20A6'   16 00                 	MVI	D,0
  20A8'   21 0000*              	LXI	H,SRCHST
  20AB'   19                    	DAD	D
  20AC'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  20AE'   7B                    	MOV	A,E
  20AF'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  20B2'   3E 01                 	MVI	A,1
  20B4'   32 2477'              	STA	SHAVE
  20B7'                         VS_OLD:
  20B7'   3A 2477'              	LDA	SHAVE
  20BA'   B7                    	ORA	A
  20BB'   CA 20C7'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
  20BE'   3A 2475'              	LDA	SDIR
  20C1'   32 2476'              	STA	SDIRE
  20C4'   C3 20F0'              	JMP	SRCHN
  20C7'                         VS_NOP:
  20C7'   21 1D91'              	LXI	H,SNOPAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-102


  20CA'   C3 1CF3'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  20CD'                         VC_N:
  20CD'   CD 061F'              	CALL	SETMOV
  20D0'   3A 2475'              	LDA	SDIR
  20D3'   C3 20DD'              	JMP	VN_GO
  20D6'                         VCB_N:
  20D6'   CD 061F'              	CALL	SETMOV
  20D9'   3A 2475'              	LDA	SDIR
  20DC'   2F                    	CMA			; the other way: 0 <-> FFH
  20DD'                         VN_GO:
  20DD'   32 2476'              	STA	SDIRE
  20E0'   CD 05B2'              	CALL	GETCNT
  20E3'   22 2498'              	SHLD	SCNT
  20E6'   3A 2477'              	LDA	SHAVE
  20E9'   B7                    	ORA	A
  20EA'   CA 20C7'              	JZ	VS_NOP
  20ED'   C3 20F0'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  20F0'                         SRCHN:
  20F0'   CD 0DF6'              	CALL	GZONE		; the screen's top line, before the cursor moves
  20F3'   2A 0000*              	LHLD	LNDLT
  20F6'   22 249C'              	SHLD	SLDLT		; the sweep moves the cursor with PUTCUR, which
                                				;   does not maintain LNDLT (GOTO does)
  20F9'   CD 0000*              	CALL	CUROFF
  20FC'   22 249A'              	SHLD	SOFF
  20FF'                         SN_LP:
  20FF'   CD 2137'              	CALL	SRCHGO
  2102'   DA 211C'              	JC	SN_BAD
  2105'   2A 2498'              	LHLD	SCNT
  2108'   2B                    	DCX	H
  2109'   22 2498'              	SHLD	SCNT
  210C'   7C                    	MOV	A,H
  210D'   B5                    	ORA	L
  210E'   C2 20FF'              	JNZ	SN_LP
  2111'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2114'   3E 01                 	MVI	A,1
  2116'   32 2482'              	STA	GPKEEP		; land on the match, not the first non-blank
  2119'   C3 0E0E'              	JMP	GPLACE		; (which sets LNDLT itself)
  211C'                         SN_BAD:
  211C'   CD 0000*              	CALL	CLRCNT
  211F'   2A 249A'              	LHLD	SOFF
  2122'   CD 0000*              	CALL	GOTO
  2125'   2A 249C'              	LHLD	SLDLT
  2128'   22 0000*              	SHLD	LNDLT		; nothing moved: the row the cursor was on
  212B'   21 1D7D'              	LXI	H,SNOTFD
  212E'   CD 1CF3'              	CALL	EXERR
  2131'   21 0000*              	LXI	H,SRCHST
  2134'   C3 1CEE'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
	MACRO-80 3.44	09-Dec-81	PAGE	1-103


                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  2137'                         SRCHGO:
  2137'   3E 01                 	MVI	A,1
  2139'   32 249E'              	STA	SSKIP		; this pass starts one past the cursor
  213C'   CD 214E'              	CALL	SRCHW
  213F'   D0                    	RNC
  2140'   3A 2476'              	LDA	SDIRE
  2143'   2F                    	CMA
  2144'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  2147'   AF                    	XRA	A
  2148'   32 249E'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  214B'   C3 214E'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  214E'                         SRCHW:
  214E'   3A 2476'              	LDA	SDIRE
  2151'   32 0000*              	STA	DIRFLG
  2154'   21 FFFF               	LXI	H,0FFFFH
  2157'   22 2401'              	SHLD	CMDCNT
  215A'   AF                    	XRA	A
  215B'   32 0000*              	STA	AUXCNT
  215E'                         SW_LP:
  215E'   CD 216A'              	CALL	SRCH1
  2161'   D0                    	RNC
  2162'   CD 0000*              	CALL	SCRLST
  2165'   D2 215E'              	JNC	SW_LP
  2168'   37                    	STC
  2169'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  216A'                         SRCH1:
  216A'   11 0000*              	LXI	D,SRCHST
  216D'   3A 0000*              	LDA	DIRFLG
  2170'   B7                    	ORA	A
  2171'   FA 2195'              	JM	SR1_BK
  2174'   21 0000*              	LXI	H,GAPEND
  2177'   CD 0000*              	CALL	FWDCNT
  217A'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
  217D'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  217E'   3A 249E'              	LDA	SSKIP
  2181'   B7                    	ORA	A
  2182'   CA 218B'              	JZ	SR1_FW
	MACRO-80 3.44	09-Dec-81	PAGE	1-104


  2185'   78                    	MOV	A,B
  2186'   B1                    	ORA	C
  2187'   37                    	STC
  2188'   C8                    	RZ			; no room for a match even before the skip
  2189'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  218A'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  218B'                         SR1_FW:
  218B'   CD 0000*              	CALL	MATCHF
  218E'   D8                    	RC
  218F'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2192'   C3 0000*              	JMP	PUTCUR
  2195'                         SR1_BK:
  2195'   21 0000*              	LXI	H,TXTBEG
  2198'   CD 0000*              	CALL	FWDCNT
  219B'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  219E'   D8                    	RC
  219F'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  21A2'   CD 0000*              	CALL	MATCHB
  21A5'   D8                    	RC
  21A6'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  21A9'                         MSGNAM:
  21A9'   E5                    	PUSH	H
  21AA'   3E 22                 	MVI	A,'"'
  21AC'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  21AF'   E1                    	POP	H
  21B0'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  21B1'   23                    	INX	H
  21B2'   7E                    	MOV	A,M
  21B3'   FE 20                 	CPI	' '
  21B5'   C2 21C2'              	JNZ	MN_HAS
  21B8'   21 1DED'              	LXI	H,SNONM
  21BB'   CD 0000*              	CALL	OUTSTR
  21BE'   E1                    	POP	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-105


  21BF'   C3 220C'              	JMP	MN_END
  21C2'                         MN_HAS:
  21C2'   0E 19                 	MVI	C,BF_CURDSK
  21C4'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  21C7'   E1                    	POP	H
  21C8'   E5                    	PUSH	H
  21C9'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  21CA'   BE                    	CMP	M
  21CB'   CA 21D9'              	JZ	MN_NAM
  21CE'   7E                    	MOV	A,M
  21CF'   C6 40                 	ADI	'A'-1
  21D1'   CD 0000*              	CALL	OUTCH
  21D4'   3E 3A                 	MVI	A,':'
  21D6'   CD 0000*              	CALL	OUTCH
  21D9'                         MN_NAM:
  21D9'   E1                    	POP	H
  21DA'   E5                    	PUSH	H
  21DB'   23                    	INX	H
  21DC'   0E 08                 	MVI	C,8
  21DE'                         MN_NM:
  21DE'   7E                    	MOV	A,M
  21DF'   FE 20                 	CPI	' '
  21E1'   CA 21EC'              	JZ	MN_EXT
  21E4'   CD 0000*              	CALL	OUTCH
  21E7'   23                    	INX	H
  21E8'   0D                    	DCR	C
  21E9'   C2 21DE'              	JNZ	MN_NM
  21EC'                         MN_EXT:
  21EC'   E1                    	POP	H
  21ED'   11 0009               	LXI	D,9
  21F0'   19                    	DAD	D		; the type field
  21F1'   7E                    	MOV	A,M
  21F2'   FE 20                 	CPI	' '
  21F4'   CA 220C'              	JZ	MN_END
  21F7'   3E 2E                 	MVI	A,'.'
  21F9'   CD 0000*              	CALL	OUTCH
  21FC'   0E 03                 	MVI	C,3
  21FE'                         MN_XL:
  21FE'   7E                    	MOV	A,M
  21FF'   FE 20                 	CPI	' '
  2201'   CA 220C'              	JZ	MN_END
  2204'   CD 0000*              	CALL	OUTCH
  2207'   23                    	INX	H
  2208'   0D                    	DCR	C
  2209'   C2 21FE'              	JNZ	MN_XL
  220C'                         MN_END:
  220C'   3E 22                 	MVI	A,'"'
  220E'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2211'                         MSGFLG:
  2211'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  2213'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-106


  2214'   CA 2224'              	JZ	MF_RO
  2217'   3A 2404'              	LDA	MODF
  221A'   B7                    	ORA	A
  221B'   CA 2224'              	JZ	MF_RO
  221E'   21 1DF7'              	LXI	H,SMODM
  2221'   CD 2239'              	CALL	MF_PUT
  2224'                         MF_RO:
  2224'   3A 2463'              	LDA	ROFLAG
  2227'   B7                    	ORA	A
  2228'   CA 2231'              	JZ	MF_NEW
  222B'   21 1E02'              	LXI	H,SROM
  222E'   CD 2239'              	CALL	MF_PUT
  2231'                         MF_NEW:
  2231'   3A 2461'              	LDA	MSGNEW
  2234'   B7                    	ORA	A
  2235'   C8                    	RZ
  2236'   21 1E0D'              	LXI	H,SNEWM
  2239'                         MF_PUT:
  2239'   78                    	MOV	A,B
  223A'   B7                    	ORA	A
  223B'   C2 2247'              	JNZ	MF_STR
  223E'   06 01                 	MVI	B,1
  2240'   E5                    	PUSH	H
  2241'   3E 20                 	MVI	A,' '
  2243'   CD 0000*              	CALL	OUTCH
  2246'   E1                    	POP	H
  2247'                         MF_STR:
  2247'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  224A'                         EMITW:
  224A'   C5                    	PUSH	B
  224B'   D5                    	PUSH	D
  224C'   06 00                 	MVI	B,0
  224E'   11 2710               	LXI	D,10000
  2251'   CD 226F'              	CALL	EWDIG
  2254'   11 03E8               	LXI	D,1000
  2257'   CD 226F'              	CALL	EWDIG
  225A'   11 0064               	LXI	D,100
  225D'   CD 226F'              	CALL	EWDIG
  2260'   11 000A               	LXI	D,10
  2263'   CD 226F'              	CALL	EWDIG
  2266'   7D                    	MOV	A,L		; the units digit is always printed
  2267'   C6 30                 	ADI	'0'
  2269'   CD 0000*              	CALL	OUTCH
  226C'   D1                    	POP	D
  226D'   C1                    	POP	B
  226E'   C9                    	RET
  226F'                         EWDIG:
  226F'   0E 00                 	MVI	C,0
  2271'                         EW_LP:
  2271'   7D                    	MOV	A,L
  2272'   93                    	SUB	E
  2273'   6F                    	MOV	L,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-107


  2274'   7C                    	MOV	A,H
  2275'   9A                    	SBB	D
  2276'   67                    	MOV	H,A
  2277'   DA 227E'              	JC	EW_DN
  227A'   0C                    	INR	C
  227B'   C3 2271'              	JMP	EW_LP
  227E'                         EW_DN:
  227E'   19                    	DAD	D		; one subtraction too many: give it back
  227F'   79                    	MOV	A,C
  2280'   B7                    	ORA	A
  2281'   C2 2287'              	JNZ	EW_PR
  2284'   78                    	MOV	A,B
  2285'   B7                    	ORA	A
  2286'   C8                    	RZ			; a leading zero: write nothing
  2287'                         EW_PR:
  2287'   79                    	MOV	A,C
  2288'   C6 30                 	ADI	'0'
  228A'   CD 0000*              	CALL	OUTCH
  228D'   06 01                 	MVI	B,1
  228F'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2290'                         ISEMPT:
  2290'   2A 0000*              	LHLD	OUTPOS
  2293'   7C                    	MOV	A,H
  2294'   B5                    	ORA	L
  2295'   C0                    	RNZ
  2296'   CD 0000*              	CALL	LOGLEN
  2299'   7C                    	MOV	A,H
  229A'   B5                    	ORA	L
  229B'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  229C'                         MSGCTG:
  229C'   21 0000*              	LXI	H,FNAME
  229F'   CD 21A9'              	CALL	MSGNAM
  22A2'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  22A4'   CD 2211'              	CALL	MSGFLG
  22A7'   CD 2290'              	CALL	ISEMPT
  22AA'   C2 22B3'              	JNZ	MG_POS
  22AD'   21 1E20'              	LXI	H,SNOLIN
  22B0'   C3 0000*              	JMP	OUTSTR
  22B3'                         MG_POS:
  22B3'   21 1E13'              	LXI	H,SLINE
  22B6'   CD 0000*              	CALL	OUTSTR
  22B9'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
  22BC'   23                    	INX	H		;   ... so the line it is on
  22BD'   CD 224A'              	CALL	EMITW
  22C0'   21 1E1A'              	LXI	H,SCOLM
  22C3'   CD 0000*              	CALL	OUTSTR
  22C6'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  22C9'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-108


  22CA'   E5                    	PUSH	H
  22CB'   CD 224A'              	CALL	EMITW
  22CE'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  22D1'   23                    	INX	H
  22D2'   D1                    	POP	D
  22D3'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  22D6'   C8                    	RZ
  22D7'   E5                    	PUSH	H
  22D8'   3E 2D                 	MVI	A,'-'
  22DA'   CD 0000*              	CALL	OUTCH
  22DD'   E1                    	POP	H
  22DE'   C3 224A'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  22E1'                         FILMSG:
  22E1'   3A 0001*              	LDA	FNAME+1
  22E4'   FE 20                 	CPI	' '
  22E6'   C8                    	RZ
  22E7'   21 0000*              	LXI	H,FNAME
  22EA'   CD 21A9'              	CALL	MSGNAM
  22ED'   AF                    	XRA	A		; nothing has been changed yet
  22EE'   C3 2211'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  22F1'                         WRMSG:
  22F1'   21 0000*              	LXI	H,TFCB
  22F4'   CD 21A9'              	CALL	MSGNAM
  22F7'   21 1E32'              	LXI	H,SWRIT
  22FA'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  22FD'                         MSGPST:
  22FD'   3A 2460'              	LDA	MSGWHT
  2300'   B7                    	ORA	A
  2301'   C8                    	RZ
  2302'   47                    	MOV	B,A
  2303'   AF                    	XRA	A
  2304'   32 2460'              	STA	MSGWHT
  2307'   78                    	MOV	A,B
  2308'   FE 01                 	CPI	MW_FIL
  230A'   CA 2318'              	JZ	MP_FIL
  230D'   FE 02                 	CPI	MW_WRT
  230F'   CA 231E'              	JZ	MP_WRT
  2312'   CD 229C'              	CALL	MSGCTG
  2315'   C3 0000*              	JMP	SCURS
  2318'                         MP_FIL:
  2318'   CD 22E1'              	CALL	FILMSG
  231B'   C3 0000*              	JMP	SCURS
  231E'                         MP_WRT:
  231E'   CD 22F1'              	CALL	WRMSG
  2321'   C3 0000*              	JMP	SCURS
	MACRO-80 3.44	09-Dec-81	PAGE	1-109


                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  2324'                         VC_CTLG:
  2324'   3E 03                 	MVI	A,MW_CTG
  2326'   32 2460'              	STA	MSGWHT
  2329'   3E 01                 	MVI	A,R_MOVE
  232B'   32 2405'              	STA	RINTENT
  232E'   C9                    	RET
                                
  232F'                         CMDTAB:
  232F'   07                    	DB	07H			; ^G -- where am I?
  2330'   2324'                 	DW	VC_CTLG
  2332'   68                    	DB	'h'
  2333'   0678'                 	DW	VC_H
  2335'   6C                    	DB	'l'
  2336'   06A2'                 	DW	VC_L
  2338'   6A                    	DB	'j'
  2339'   0767'                 	DW	VC_J
  233B'   6B                    	DB	'k'
  233C'   0776'                 	DW	VC_K
  233E'   30                    	DB	'0'
  233F'   06C9'                 	DW	VC_0
  2341'   5E                    	DB	'^'
  2342'   06E7'                 	DW	VC_CRT
  2344'   24                    	DB	'$'
  2345'   0725'                 	DW	VC_EOL
  2347'   0D                    	DB	CR			; <CR> -- down to the first non-blank
  2348'   0749'                 	DW	VC_CR
  234A'   77                    	DB	'w'
  234B'   094B'                 	DW	VC_W
  234D'   62                    	DB	'b'
  234E'   099C'                 	DW	VC_B
  2350'   65                    	DB	'e'
  2351'   0B01'                 	DW	VC_E
  2353'   57                    	DB	'W'
  2354'   0952'                 	DW	VCBGW
  2356'   42                    	DB	'B'
  2357'   09A3'                 	DW	VCBGB
  2359'   45                    	DB	'E'
  235A'   0B08'                 	DW	VCBGE
  235C'   47                    	DB	'G'
  235D'   0D63'                 	DW	VC_G
  235F'   67                    	DB	'g'
  2360'   0D97'                 	DW	VC_LG
  2362'   78                    	DB	'x'
  2363'   1178'                 	DW	VC_X
  2365'   5A                    	DB	'Z'
  2366'   18C3'                 	DW	VC_BZ
  2368'   66                    	DB	'f'
