  0760'   C3 0764'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  0763'                         EOLC_CR:
  0763'   2B                    	DCX	H		; last = (term-1) - 1
  0764'                         EOLC_LS:
  0764'   EB                    	XCHG			; DE = last
  0765'   2A 0000*              	LHLD	WKBOL
  0768'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  076B'   DA 0770'              	JC	EOLC_MT
  076E'   EB                    	XCHG			; HL = last
  076F'   C9                    	RET
