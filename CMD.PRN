  1DEF'   5D 00                 
  1DF1'   20 6C 69 6E           SLINE:	DB	' line ',0
  1DF5'   65 20 00              
  1DF8'   20 63 6F 6C           SCOLM:	DB	' col ',0
  1DFC'   20 00                 
  1DFE'   20 2D 2D 42           SNOLIN: DB	' --Buffer empty--',0
  1E02'   75 66 66 65           
  1E06'   72 20 65 6D           
  1E0A'   70 74 79 2D           
