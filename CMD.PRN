  05FB'   5F                    	MOV	E,A
  05FC'   3A 0000*              	LDA	DOTLEN
  05FF'   BB                    	CMP	E
  0600'   CA 060C'              	JZ	DOTGEF
  0603'   16 00                 	MVI	D,0
  0605'   21 0000*              	LXI	H,DOTBUF
  0608'   19                    	DAD	D
  0609'   7E                    	MOV	A,M
  060A'   B7                    	ORA	A		; CY clear: a key was returned
  060B'   C9                    	RET
