                                ; no default type (WM's is LIB), and the drive must be A-P.
  2506'                         PARSFN:
  2506'   CD 2416'              	CALL	TFCLR
  2509'   11 0000*              	LXI	D,TFCB
  250C'   23                    	INX	H
