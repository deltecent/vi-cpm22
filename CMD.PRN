  0C61'                         ESTEP:
  0C61'   CD 0000*              	CALL	CUROFF
  0C64'   22 29D2'              	SHLD	WKI
  0C67'   CD 0000*              	CALL	LOGLEN
  0C6A'   22 29D4'              	SHLD	WKN
  0C6D'   2A 29D2'              	LHLD	WKI
  0C70'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0C71'   22 29D2'              	SHLD	WKI
  0C74'                         ES_WS:
  0C74'   2A 29D2'              	LHLD	WKI
  0C77'   EB                    	XCHG
  0C78'   2A 29D4'              	LHLD	WKN
  0C7B'   CD 0000*              	CALL	CMP16
  0C7E'   D2 0CCC'              	JNC	ES_LND
  0C81'   2A 29D2'              	LHLD	WKI
  0C84'   CD 0000*              	CALL	CHARAT
  0C87'   CD 070F'              	CALL	CLASSF
  0C8A'   B7                    	ORA	A
  0C8B'   C2 0C98'              	JNZ	ES_WD
  0C8E'   2A 29D2'              	LHLD	WKI
  0C91'   23                    	INX	H
  0C92'   22 29D2'              	SHLD	WKI
  0C95'   C3 0C74'              	JMP	ES_WS
