  27CF'   C8                    	RZ
  27D0'   FE 5F                 	CPI	'_'
  27D2'   C8                    	RZ
  27D3'   FE 3B                 	CPI	';'
  27D5'   C8                    	RZ
  27D6'   FE 3C                 	CPI	'<'
  27D8'   C8                    	RZ
  27D9'   FE 3E                 	CPI	'>'
  27DB'   C8                    	RZ
  27DC'   FE 2E                 	CPI	'.'
  27DE'   C8                    	RZ
  27DF'   FE 3A                 	CPI	':'
  27E1'   C8                    	RZ
  27E2'   FE 2A                 	CPI	'*'
  27E4'   C8                    	RZ
  27E5'   FE 3F                 	CPI	'?'
  27E7'   C8                    	RZ
  27E8'   FE 20                 	CPI	' '
  27EA'   DA 27FD'              	JC	GF_CTL
  27ED'   C8                    	RZ
  27EE'   23                    	INX	H
  27EF'   FE 61                 	CPI	'a'
