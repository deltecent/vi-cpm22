  0B3B'   1B                    	DCX	D
  0B3C'   7A                    	MOV	A,D
  0B3D'   B3                    	ORA	E
  0B3E'   C2 0B2E'              	JNZ	KC_SC
  0B41'   2A 2F1F'              	LHLD	JKCNT		; N lines above: the move is count lines
  0B44'   C3 0B67'              	JMP	KC_MV
  0B47'                         KC_TB:
  0B47'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0B48'   CD 077F'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0B4B'   22 2F25'              	SHLD	JKBK
  0B4E'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0B51'   7C                    	MOV	A,H
  0B52'   B5                    	ORA	L
  0B53'   CA 0B60'              	JZ	KC_B0
