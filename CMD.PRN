                                ;============================================================
                                ; FILE:    CMD.MAC
                                ; PROJECT: VI
                                ; MODULE:  Command-mode dispatch + the vi core.
                                ;------------------------------------------------------------
                                ; The vi layer.  Most verbs work in the buffer's gap-agnostic LOGICAL-OFFSET
                                ; space -- a byte index into the resident text as if the gap were not there --
                                ; through the API BUF.MAC appends (CUROFF/LOGLEN/CHARAT/GOTO + the DELFWD/DELPRV
                                ; deletes).  Anything that has to reach past the resident window drives
                                ; WordMaster's own routines instead -- the line moves (MVLMAX/MVLIND/SETBWD),
                                ; RGET, the matchers swept by SCRLST, the line kill and the Q-buffer -- which
                                ; page as they go.  A few places read the pointer row directly (the char under
                                ; the cursor, the end-of-file test).
                                ;
                                ; The cursor sits on the byte at GAPEND (first byte after the gap).  Because
                                ; PUTCUR slides the gap so the cursor lands on whatever byte lives at the target
                                ; PHYSICAL address, a motion is just: scan logical space for a target offset,
                                ; map it to a physical address (L2PHYS), PUTCUR there.
                                ;
                                ; Every key goes through CMDDIS, the one chokepoint the main loop, the
                                ; headless harnesses and '.' (which replays keys) all share.  The command set,
                                ; and where each command deviates from vim, is COMMANDS.md.
                                ;============================================================
                         C      	INCLUDE VI.INC
                         C      ;============================================================
                         C      ; FILE:    VI.INC
                         C      ; PROJECT: VI -- vi-style CP/M editor on WordMaster's gap buffer
                         C      ; CPU:     Intel 8080 (strict -- no Z80 extensions)
                         C      ; ASSEMBLER: Microsoft M80
                         C      ;------------------------------------------------------------
                         C      ; Shared equates for the vi LAYER only (KEY.MAC, CMD.MAC).  BUF.MAC and
                         C      ; PAGE.MAC are verbatim WordMaster transcriptions and define their own local
                         C      ; constants; they do NOT include this file.  INCLUDE VI.INC first in KEY/CMD.
                         C      ; There is one windowed gap buffer (BUF.MAC's flat pointer row), so there is no
                         C      ; buffer descriptor or mode flag here.
                         C      ;============================================================
                         C      
                         C      ;------------------------------------------------------------
                         C      ; CP/M SYSTEM ADDRESSES
                         C      ;------------------------------------------------------------
  0005                   C      BDOS	EQU	0005H		; BDOS entry point
  0000                   C      WBOOT	EQU	0000H		; warm boot / exit to CP/M
  005C                   C      DFTFCB	EQU	005CH		; default FCB (command argument 1)
  0080                   C      CMDTAIL EQU	0080H		; command tail / default DMA
                         C      
                         C      ;------------------------------------------------------------
                         C      ; BDOS FUNCTION NUMBERS (only those the vi layer uses)
                         C      ;------------------------------------------------------------
  0001                   C      BF_CONIN  EQU	1		; console input (blocking)
  0002                   C      BF_CONOUT EQU	2		; console output: E = char
  0009                   C      BF_PRTSTR EQU	9		; print $-terminated string: DE = addr
  000B                   C      BF_CONST  EQU	11		; console status
  0019                   C      BF_CURDSK EQU	25		; current disk: A = 0 (A:) ..
                         C      
                         C      ;------------------------------------------------------------
                         C      ; ASCII AND CP/M CONTROL CODES
	MACRO-80 3.44	09-Dec-81	PAGE	1-1


                         C      ;------------------------------------------------------------
  0000                   C      NUL	EQU	00H		; null (string terminator)
  0007                   C      BEL	EQU	07H		; bell
  0008                   C      BS	EQU	08H		; backspace (Ctrl-H)
  0009                   C      TAB	EQU	09H		; horizontal tab
  000A                   C      LF	EQU	0AH		; line feed  -- the line TERMINATOR
  000D                   C      CR	EQU	0DH		; carriage return -- decoration before LF
  001B                   C      ESC	EQU	1BH		; escape
  007F                   C      DEL	EQU	7FH		; rubout / delete
  001A                   C      CPMEOF	EQU	1AH		; CP/M end-of-file marker (Ctrl-Z)
                         C      
  0008                   C      TABWID	EQU	8		; tab stop interval (display only)
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RENDER INTENT (RINTENT) -- what the last dispatched command did, so SCRN.MAC
                         C      ; can choose the cheapest correct paint.  The command layer (CMD.MAC) sets it
                         C      ; per key; SCRN.MAC reads it.  The default is the conservative R_FULL (full
                         C      ; repaint = the proven Stage-3a behavior); pure cursor motions lower it to
                         C      ; R_MOVE so the renderer repositions the cursor without redrawing; an in-line
                         C      ; edit lowers it to R_LINE so only the current row is redrawn.  A mistag can
                         C      ; therefore only cost an unnecessary full repaint, never leave stale text.
                         C      ;------------------------------------------------------------
  0000                   C      R_FULL	EQU	0		; edit area may be stale -> full repaint (SCDRAW)
  0001                   C      R_MOVE	EQU	1		; cursor moved only -> reposition (if viewport stable)
  0002                   C      R_LINE	EQU	2		; current line changed only -> redraw that one row
  0003                   C      R_DLIN	EQU	3		; one line deleted at the cursor row -> DL + redraw bottom
  0004                   C      R_ICH	EQU	4		; one printable char inserted mid-line -> ICH (no tail redraw)
  0005                   C      R_ILIN	EQU	5		; one line opened at the cursor row -> IL + redraw that row and the one above
  0006                   C      R_JOIN	EQU	6		; the line below joined onto the cursor's -> redraw that row + DL the one under it
                         C      
                         C      ;------------------------------------------------------------
                         C      ; EDITOR MODES (EDMODE)
                         C      ;------------------------------------------------------------
  0000                   C      EM_CMD	EQU	0		; command mode (default)
  0001                   C      EM_INS	EQU	1		; insert mode
  0002                   C      EM_REP	EQU	2		; replace mode ('R')
  0003                   C      EM_EX	EQU	3		; ex command line (transient, inside VC_EX)
                         C      
                         C      ; THE MESSAGE THE BOTTOM ROW STILL OWES (MSGWHT).  A message is drawn after the
                         C      ; frame, never during the command, because a full repaint blanks that row.
  0000                   C      MW_NON	EQU	0		; nothing to say
  0001                   C      MW_FIL	EQU	1		; the file just opened
  0002                   C      MW_WRT	EQU	2		; ':w' wrote it
  0003                   C      MW_CTG	EQU	3		; '^G' -- where am I
                         C      
  0028                   C      EXMAX	EQU	40		; max chars on the ':' ex command line
                         C      
                         C      ;------------------------------------------------------------
                         C      ; RESERVE BLOCK -- sizes of storage that RSV.MAC holds above the linked image
                         C      ; on behalf of another module.  They live here, not in the module that uses
                         C      ; the storage, so the module and RSV.MAC cannot disagree about a size.
                         C      ;------------------------------------------------------------
  0080                   C      DOTMAX	EQU	128		; keys one recorded change may hold (see '.')
  0020                   C      KBRSIZ	EQU	32		; KEY.MAC's type-ahead ring (a power of two)
  0003                   C      MKMAX	EQU	3		; marks 'a'-'c' -- three is enough (COMMANDS.md)
  0004                   C      MKSIZ	EQU	4		; each: its offset, then PGTOPM when it was set
	MACRO-80 3.44	09-Dec-81	PAGE	1-2


                         C      
                         C      ;------------------------------------------------------------
                         C      ; KEY DECODER -- GETKEY return types (B) and action codes (C when B=KT_ACT).
                         C      ; See KEY.MAC.
                         C      ;------------------------------------------------------------
  0000                   C      KT_NONE EQU	0		; no key (unrecognised ESC sequence, discarded)
  0001                   C      KT_ACT	EQU	1		; C = ACT_xxx action code
  0002                   C      KT_CHAR EQU	2		; C = ASCII character (printable or control)
                         C      
  0001                   C      ACT_CURUP EQU	1		; cursor up    (ESC[A / ESC OA)
  0002                   C      ACT_CURDN EQU	2		; cursor down  (ESC[B / ESC OB)
  0003                   C      ACT_CURRT EQU	3		; cursor right (ESC[C / ESC OC)
  0004                   C      ACT_CURLT EQU	4		; cursor left  (ESC[D / ESC OD)
  0005                   C      ACT_LINST EQU	5		; Home / line start (ESC[H / ESC[1~)
  0006                   C      ACT_LINEN EQU	6		; End  / line end   (ESC[F / ESC[4~)
  0007                   C      ACT_PGUP  EQU	7		; page up   (ESC[5~)
  0008                   C      ACT_PGDN  EQU	8		; page down (ESC[6~)
  0009                   C      ACT_INS	  EQU	9		; Insert key (ESC[2~)
  000A                   C      ACT_DEL	  EQU	10		; Delete key (ESC[3~)
  000B                   C      ACT_ESC	  EQU	11		; lone ESC (after timeout)
  000B                   C      ACT_MAX	  EQU	11		; highest defined action code
                         C      
  01F4                   C      ESCTMO	EQU	500		; polls before a lone ESC is confirmed
                                
                                	PUBLIC	CMDDIS
                                	PUBLIC	EDMODE, QUITF, MODF, CMDCNT
                                	PUBLIC	MSGPST				; the message this key left
                                	PUBLIC	COL				; QSN.MAC's cursor column (test hook)
                                	PUBLIC	RINTENT				; render intent (read by SCRN.MAC)
                                	PUBLIC	ILN				; ... and the lines an R_ILIN opens
                                	PUBLIC	ICHAPP				; ... 1 = an R_ICH needs no ICH
                                	PUBLIC	ILABOV				; ... 1 = an R_ILIN's row above is stale
                                	PUBLIC	CNTTST				; count-test (BUF.MAC PAGESTP reads)
                                	PUBLIC	CURRW				; cursor's screen row (SCRN.MAC reads)
                                	PUBLIC	FOPEN				; open the command-line file
                                	PUBLIC	ARGSCN, ARGGO			; the rest of the command line
                                	PUBLIC	CMDTAB, OPCTAB			; the two tables build_vi.py pairs up
                                
                                	EXTRN	GETKEY				; KEY.MAC
                                	EXTRN	OPENZ				; PAGE.MAC -- open + load (cold)
                                	EXTRN	TFCB, WRTO, TEXIST, DISCRD, CNTLF ; PAGE.MAC -- :w name, :e
                                	EXTRN	REOPEN, SEEKTO			; PAGE.MAC -- :w keeps editing
                                	EXTRN	POLLBRK				; PAGE.MAC -- break poll (CNTTST tail)
                                	EXTRN	PUTGAP, PUTCUR, PEEKL		; BUF.MAC gap insert / cursor move
                                	EXTRN	CUROFF, LOGLEN, CHARAT, GOTO	; BUF.MAC logical-offset API
                                	EXTRN	PGTOPM				; PAGE.MAC -- the window signature
                                	EXTRN	MKTAB				; RSV.MAC  -- the marks, above the image
                                	EXTRN	DELFWD, DELPRV, UNDELF			; BUF.MAC deletes
                                	EXTRN	CMP16, SUBHD, MEMCPY		; BUF.MAC 16-bit helpers
                                	EXTRN	UNDBEG, UNDO, UNDRPL, UNDWHY	; BUF.MAC single-level undo
                                	EXTRN	UNDBAD				; ... and 'too big to capture'
                                	EXTRN	UNDHER				; ... where this change starts
                                	EXTRN	UNDCUR				; ... the cursor it restores
                                	EXTRN	BCONOU				; SCRN.MAC -- console out (miss bell)
                                	EXTRN	EXPRM, EXRUB, OUTCH		; SCRN.MAC -- ':' / '/' line echo
                                	EXTRN	EXMSG, OUTSTR			; SCRN.MAC -- ex message
	MACRO-80 3.44	09-Dec-81	PAGE	1-3


                                	EXTRN	SCURS				; SCRN.MAC -- cursor back on the text
                                	EXTRN	CBOL, CURDCL			; SCRN.MAC -- cursor column ('^G')
                                	EXTRN	NEWFIL				; PAGE.MAC -- the file was not there
                                	EXTRN	NEDIT, WINROW			; SCRN.MAC -- edit rows / cursor line's row
                                	EXTRN	SCBOT, SCEOF, SCBOF, WFILL	; SCRN.MAC -- last layout (H/M/L, scrolls)
                                	EXTRN	AUXCNT				; PAGE.MAC -- WM L271E (follows NEWFIL)
                                	EXTRN	MVLMAX, MVLIND, SETBWD		; BUF.MAC -- WM line move (pages)
                                	EXTRN	CLRCNT				; BUF.MAC -- WM count/direction reset
                                	EXTRN	DELLN, SETC0			; BUF.MAC -- WM line kill (dd)
                                	EXTRN	QPUTLN, QGET, QKILL		; BUF.MAC -- the yank register
                                	EXTRN	QCPYN, BUFSUM			; ... the copy that does not delete
                                	EXTRN	INRDY				; PAGE.MAC -- is any of the file unread
                                	EXTRN	QBEG, QEND			; BUF.MAC -- ... and whether it is empty
                                	EXTRN	LFCNT				; BUF.MAC -- LFs in a span (p/P row)
                                	EXTRN	INSSTR				; BUF.MAC -- splice WM's string
                                	EXTRN	RGET0, RGET			; ... and WM's paged line reader
                                	EXTRN	MATCHF, MATCHB, FWDCNT, SUBLEN	; BUF.MAC -- WM's string matchers
                                	EXTRN	SRCHBF, SRCHST, SRCMAX		; BUF.MAC -- ... and the pattern
                                	EXTRN	SCRLST				; BUF.MAC -- WM 4307 (sweep + page)
                                	EXTRN	GAPBEG, TXTBEG			; BUF.MAC -- EOF last-line test (G)
                                	EXTRN	RGET0, RDGET, LNDLT		; BUF.MAC -- WM read-ahead / lines moved
                                	EXTRN	LINPSB, DIRFLG			; BUF.MAC / PAGE.MAC -- G/gg placement
                                	EXTRN	GAPEND, TXTEND			; BUF.MAC -- the char under the cursor (goal)
                                	EXTRN	OUTPOS, REWIND			; PAGE.MAC -- records before the window / page back
                                
                                ;DOTMAX, and the buffers it sizes, are in VI.INC / RSV.MAC: see RSV.MAC for
                                ;why storage that starts life unread is held above the image, not inside it.
                                	EXTRN	DOTSCR, DOTBUF			; RSV.MAC -- '.' scratch + last change
                                	EXTRN	FNAME, ZTOP, PLUSB, EXBUF	; RSV.MAC -- name / G top / '+{n}' / ':'
                                
  0000'                         	CSEG
                                
                                ;CMDDIS -- dispatch one already-read key (B = KT type, C = char/action) by mode.
                                ;The key passes through the '.' recorder on the way in and the way out: DOTPRE
                                ;adds it to the recording of the command being typed, DOTPOST notices when that
                                ;command has finished and, if it changed the text, makes its keys the ones '.'
                                ;replays.  Both are no-ops while '.' is itself replaying.  CDMODE is the mode
                                ;dispatch proper.
  0000'                         CMDDIS:
  0000'   CD 00D9'              	CALL	DOTPRE
  0003'   CD 0009'              	CALL	CDMODE
  0006'   C3 0130'              	JMP	DOTPOST
  0009'                         CDMODE:
  0009'   3A 23DE'              	LDA	EDMODE
  000C'   FE 01                 	CPI	EM_INS
  000E'   CA 0019'              	JZ	CD_INS
  0011'   FE 02                 	CPI	EM_REP
  0013'   CA 001C'              	JZ	CD_REP
  0016'   C3 001F'              	JMP	VICMD		; tail: VICMD RETs to CDMODE's caller
  0019'                         CD_INS:
  0019'   C3 17AC'              	JMP	VIINS
  001C'                         CD_REP:
  001C'   C3 16EC'              	JMP	VIREP
                                
                                ;============================================================
                                ; VICMD -- command-mode key.  B = KT type, C = char / action.
	MACRO-80 3.44	09-Dec-81	PAGE	1-4


                                ; Count prefix accumulates into CMDCNT; a leading '0' is the BOL motion, a '0'
                                ; after a count is a digit.  Pending 'g' (for gg) and pending 'd' (for dd) are
                                ; cleared on every dispatched command except the one that re-arms them.
                                ;============================================================
  001F'                         VICMD:
  001F'   78                    	MOV	A,B
  0020'   FE 00                 	CPI	KT_NONE
  0022'   C8                    	RZ			; discarded key
  0023'   FE 01                 	CPI	KT_ACT
  0025'   CA 00AB'              	JZ	VIC_ACT
  0028'   3A 2406'              	LDA	GPEND		; 'r' pending: this char is the replacement, a
  002B'   FE 03                 	CPI	PR		;   count digit included (vim's 'r3' stores '3')
  002D'   CA 134F'              	JZ	VR_DO
                                	;--- KT_CHAR: maybe a count digit ---
  0030'   79                    	MOV	A,C
  0031'   FE 31                 	CPI	'1'
  0033'   DA 003E'              	JC	VIC_NOTD	; < '1'
  0036'   FE 3A                 	CPI	'9'+1
  0038'   D2 003E'              	JNC	VIC_NOTD	; > '9'
  003B'   C3 004E'              	JMP	VICDIG	       ; '1'..'9' -> accumulate
  003E'                         VIC_NOTD:
  003E'   79                    	MOV	A,C
  003F'   FE 30                 	CPI	'0'
  0041'   C2 0076'              	JNZ	VICDSP
  0044'   2A 23DF'              	LHLD	CMDCNT
  0047'   7C                    	MOV	A,H
  0048'   B5                    	ORA	L
  0049'   CA 0076'              	JZ	VICDSP	      ; bare '0' -> BOL motion
  004C'   0E 30                 	MVI	C,'0'		; '0' after a count -> digit
  004E'                         VICDIG:
  004E'   2A 23DF'              	LHLD	CMDCNT		; CMDCNT = CMDCNT*10 + (C-'0'), held at FFFFH
  0051'   54                    	MOV	D,H		;   rather than wrapping (vim's counts do not
  0052'   5D                    	MOV	E,L		;   wrap: 99999w runs to the end of the file)
  0053'   29                    	DAD	H		; *2
  0054'   DA 006D'              	JC	VIC_SAT
  0057'   29                    	DAD	H		; *4
  0058'   DA 006D'              	JC	VIC_SAT
  005B'   19                    	DAD	D		; *5
  005C'   DA 006D'              	JC	VIC_SAT
  005F'   29                    	DAD	H		; *10
  0060'   DA 006D'              	JC	VIC_SAT
  0063'   79                    	MOV	A,C
  0064'   D6 30                 	SUI	'0'
  0066'   5F                    	MOV	E,A
  0067'   16 00                 	MVI	D,0
  0069'   19                    	DAD	D
  006A'   D2 0070'              	JNC	VIC_CNT
  006D'                         VIC_SAT:
  006D'   21 FFFF               	LXI	H,0FFFFH
  0070'                         VIC_CNT:
  0070'   22 23DF'              	SHLD	CMDCNT
  0073'   C3 060A'              	JMP	SETMOV		; a count digit draws nothing -> cursor-only, not full
  0076'                         VICDSP:
  0076'   3A 2406'              	LDA	GPEND		; snapshot + clear the pending-g / pending-d state
  0079'   32 2407'              	STA	GSAVE
  007C'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-5


  007D'   32 2406'              	STA	GPEND
  0080'   3A 2408'              	LDA	PENDOP
  0083'   32 2409'              	STA	PSAVE
  0086'   AF                    	XRA	A
  0087'   32 2408'              	STA	PENDOP
  008A'   3A 2409'              	LDA	PSAVE		; operator pending? -> this key is its motion/double
  008D'   B7                    	ORA	A
  008E'   C2 0EE4'              	JNZ	OPPEND
  0091'   3A 2407'              	LDA	GSAVE		; 'Z' pending: only a second 'Z' runs -- vim beeps
  0094'   FE 02                 	CPI	PZ		;   on any other key and drops both, count included
  0096'   C2 009F'              	JNZ	VIC_TB
  0099'   79                    	MOV	A,C
  009A'   FE 5A                 	CPI	'Z'
  009C'   C2 00A5'              	JNZ	VIC_SW
  009F'                         VIC_TB:
  009F'   21 230D'              	LXI	H,CMDTAB
  00A2'   C3 00BE'              	JMP	VSCANQ		; tail: handler RETs to CMDRUN (miss -> no-op)
  00A5'                         VIC_SW:
  00A5'   CD 060A'              	CALL	SETMOV		; dropped: nothing drawn, nothing moved
  00A8'   C3 059D'              	JMP	GETCNT		; the count goes with it (tail: GETCNT RETs)
  00AB'                         VIC_ACT:
  00AB'   AF                    	XRA	A		; action key clears all pending state
  00AC'   32 2406'              	STA	GPEND
  00AF'   32 2407'              	STA	GSAVE
  00B2'   32 2408'              	STA	PENDOP
  00B5'   32 2409'              	STA	PSAVE
  00B8'   21 23C5'              	LXI	H,ACTTAB
  00BB'   C3 00BE'              	JMP	VSCANQ
                                
                                ;------------------------------------------------------------
                                ; VSCAN -- table dispatch.  C = key, HL -> {DB ch, DW addr}
                                ; table ending DB 0.  Match -> JMP handler (handler RETs to VICMD's caller).
                                ; Miss -> RET.  Preserves B,C.
                                ;
                                ; VSCANQ is the same dispatch for the two TOP-LEVEL key tables, where a miss
                                ; means the key is not a command at all: no handler ran, so nothing was drawn
                                ; and nothing moved, and the frame is a reposition rather than a 24-row
                                ; repaint (a repaint costs seconds at 9600 baud, for a key that did
                                ; nothing).  It is NOT used for the operator's
                                ; motion lookup: the delete that follows relies on the R_FULL default.
                                ; VSCLK is the walk alone -- HL = the handler, NZ; Z on a miss.
                                ;------------------------------------------------------------
  00BE'                         VSCANQ:
  00BE'   CD 00CA'              	CALL	VSCLK
  00C1'   CA 00A5'              	JZ	VIC_SW		; not a command: drawn nothing, count dropped
  00C4'   E9                    	PCHL
  00C5'                         VSCAN:
  00C5'   CD 00CA'              	CALL	VSCLK
  00C8'   C8                    	RZ			; miss
  00C9'   E9                    	PCHL
  00CA'                         VSCLK:
  00CA'   7E                    VSCAN1: MOV	A,M
  00CB'   B7                    	ORA	A
  00CC'   C8                    	RZ			; miss: Z, and A = the terminating 0
  00CD'   23                    	INX	H
  00CE'   B9                    	CMP	C
	MACRO-80 3.44	09-Dec-81	PAGE	1-6


  00CF'   5E                    	MOV	E,M
  00D0'   23                    	INX	H
  00D1'   56                    	MOV	D,M
  00D2'   23                    	INX	H
  00D3'   C2 00CA'              	JNZ	VSCAN1
  00D6'   EB                    	XCHG			; HL = the handler
  00D7'   B7                    	ORA	A		; A is the key that matched -- never 0, so NZ
  00D8'   C9                    	RET
                                
                                ;============================================================
                                ; '.' -- REPEAT THE LAST CHANGE.
                                ; The repeat IS the keystrokes, not a description of them.  Every key the editor
                                ; dispatches passes through DOTPRE on its way into CMDDIS, which appends it to
                                ; the recording of the command currently being typed, and through DOTPOST on the
                                ; way out, which notices when that command has finished and, if it changed the
                                ; text, makes its keys THE recording.  '.' feeds those keys back through CMDDIS
                                ; one at a time, so the repeat runs the same handlers the original keys ran --
                                ; there is no second implementation of any command to keep in step, an insert
                                ; repeats with its typed text because the text is part of the recording, and a
                                ; command written later is repeatable the day it is written.
                                ;
                                ; A command is still being TYPED while insert or replace mode is up, while
                                ; 'g' / 'Z' / 'r' or an operator is pending, and while a count is accumulating;
                                ; DOTPOST tests exactly those four.  DOTCHG is what says "this one changed the
                                ; text": MARKMOD sets it beside MODF, so every edit that marks the buffer
                                ; modified is recorded and nothing else is.  'yy' puts DOTCHG back the way it
                                ; puts MODF back -- a yank takes its lines out and returns them, and must not
                                ; become the repeat.
                                ;
                                ; LIMIT (deviation from vim, which has no such limit): a recording is DOTMAX
                                ; bytes.  A change longer than that -- an insert of more than DOTMAX-2
                                ; characters -- is not repeatable at all, and '.' after one rings the bell
                                ; rather than repeating a truncated version of it.
                                ;============================================================
                                
                                ;DOTPRE -- record the key in B (type) / C (char), starting a new recording when
                                ; the previous key finished a command.  B and C are preserved: CMDDIS dispatches
                                ; them the moment this returns.
  00D9'                         DOTPRE:
  00D9'   3A 23FD'              	LDA	DOTRPL
  00DC'   B7                    	ORA	A
  00DD'   C0                    	RNZ			; the replay's own keys are not recorded
  00DE'   C5                    	PUSH	B
  00DF'   D5                    	PUSH	D
  00E0'   E5                    	PUSH	H
  00E1'   3A 23FC'              	LDA	DOTSTA
  00E4'   B7                    	ORA	A
  00E5'   CA 00F8'              	JZ	DOTP1
  00E8'   AF                    	XRA	A		; a new command: the recording starts over
  00E9'   32 23FC'              	STA	DOTSTA
  00EC'   32 23FE'              	STA	DOTOVF
  00EF'   21 0000*              	LXI	H,DOTSCR
  00F2'   22 2400'              	SHLD	DOTSP
  00F5'   CD 0000*              	CALL	UNDBEG		; ... and 'u' hears that boundary too
  00F8'                         DOTP1:
  00F8'   78                    	MOV	A,B
	MACRO-80 3.44	09-Dec-81	PAGE	1-7


  00F9'   FE 00                 	CPI	KT_NONE
  00FB'   CA 0124'              	JZ	DOTPX		; a discarded key is not a keystroke
  00FE'   FE 01                 	CPI	KT_ACT
  0100'   79                    	MOV	A,C
  0101'   CA 0109'              	JZ	DOTP2
  0104'   E6 7F                 	ANI	7FH		; a char stands for itself (CPYGAP masks inserts
  0106'   C3 010B'              	JMP	DOTP3		;   the same way), bit 7 marks an action key
  0109'                         DOTP2:
  0109'   F6 80                 	ORI	80H		; an action key (an arrow) rides in bit 7
  010B'                         DOTP3:
  010B'   32 23FF'              	STA	DOTLK		; the last key recorded (DOTPOST reads it)
  010E'   47                    	MOV	B,A
  010F'   2A 2400'              	LHLD	DOTSP
  0112'   EB                    	XCHG
  0113'   21 0080*              	LXI	H,DOTSCR+DOTMAX
  0116'   CD 0000*              	CALL	CMP16		; CY iff the write pointer is still inside it
  0119'   D2 0128'              	JNC	DOTPOV
  011C'   2A 2400'              	LHLD	DOTSP
  011F'   70                    	MOV	M,B
  0120'   23                    	INX	H
  0121'   22 2400'              	SHLD	DOTSP
  0124'                         DOTPX:
  0124'   E1                    	POP	H
  0125'   D1                    	POP	D
  0126'   C1                    	POP	B
  0127'   C9                    	RET
  0128'                         DOTPOV:
  0128'   3E 01                 	MVI	A,1
  012A'   32 23FE'              	STA	DOTOVF		; too long to record: give this recording up
  012D'   C3 0124'              	JMP	DOTPX
                                
                                ;DOTPOST -- the dispatch has returned.  When it finished a command, arm the
                                ; reset for the next key; and when that command changed the text, make its
                                ; recording the one '.' replays.
  0130'                         DOTPOST:
  0130'   3A 23FD'              	LDA	DOTRPL
  0133'   B7                    	ORA	A
  0134'   C0                    	RNZ
  0135'   3A 23DE'              	LDA	EDMODE
  0138'   B7                    	ORA	A
  0139'   C0                    	RNZ			; EM_CMD is 0: any other mode is mid-command
  013A'   3A 2406'              	LDA	GPEND
  013D'   B7                    	ORA	A
  013E'   C0                    	RNZ			; 'g' / 'Z' / 'r' still pending
  013F'   3A 2408'              	LDA	PENDOP
  0142'   B7                    	ORA	A
  0143'   C0                    	RNZ			; an operator still waiting for its motion
  0144'   2A 23DF'              	LHLD	CMDCNT
  0147'   7C                    	MOV	A,H
  0148'   B5                    	ORA	L
  0149'   CA 0157'              	JZ	DOTQ1
  014C'   3A 23FF'              	LDA	DOTLK		; a digit with the count still up: the command
  014F'   FE 30                 	CPI	'0'		;   itself has not been typed yet
  0151'   DA 0157'              	JC	DOTQ1
  0154'   FE 3A                 	CPI	'9'+1
  0156'   D8                    	RC
	MACRO-80 3.44	09-Dec-81	PAGE	1-8


  0157'                         DOTQ1:
  0157'   3E 01                 	MVI	A,1
  0159'   32 23FC'              	STA	DOTSTA		; the next key starts a new recording
  015C'   3A 23FB'              	LDA	DOTCHG
  015F'   B7                    	ORA	A
  0160'   C8                    	RZ			; changed nothing: not a repeatable command
  0161'   AF                    	XRA	A
  0162'   32 23FB'              	STA	DOTCHG
  0165'   32 2402'              	STA	DOTLEN
  0168'   3A 23FE'              	LDA	DOTOVF
  016B'   B7                    	ORA	A
  016C'   C0                    	RNZ			; outgrew the scratch: DOTLEN stays 0
  016D'   2A 2400'              	LHLD	DOTSP
  0170'   11 0000*              	LXI	D,DOTSCR
  0173'   CD 0000*              	CALL	SUBHD		; HL = the recording's length
  0176'   7D                    	MOV	A,L
  0177'   32 2402'              	STA	DOTLEN
  017A'   B7                    	ORA	A
  017B'   C8                    	RZ
  017C'   4F                    	MOV	C,A
  017D'   06 00                 	MVI	B,0
  017F'   21 0000*              	LXI	H,DOTSCR
  0182'   11 0000*              	LXI	D,DOTBUF
  0185'   C3 0000*              	JMP	MEMCPY		; the change '.' will replay
                                
                                ;MARKMOD -- the text has changed: mark the buffer modified, and mark the command
                                ; being typed as a change so '.' records it.
  0188'                         MARKMOD:
  0188'   CD 03E0'              	CALL	MKDROP		; any mark this edit leaves pointing wrong
  018B'   3E 01                 	MVI	A,1
  018D'   32 23E2'              	STA	MODF
  0190'   32 23FB'              	STA	DOTCHG
  0193'   C9                    	RET
                                
                                ;VC_DOT -- '.': replay the recorded change.  A count typed on the '.' REPLACES
                                ; the recorded one, as vim's does ('3x' then '2.' deletes two), which is why the
                                ; recorded count's digits are skipped when one is given.  With nothing recorded
                                ; the bell rings and nothing moves.  '.' never becomes the last change itself:
                                ; DOTCHG is cleared on the way out, so a second '.' repeats the same change.
  0194'                         VC_DOT:
  0194'   2A 23DF'              	LHLD	CMDCNT		; the count typed on the '.' (0 = none given)
  0197'   22 2404'              	SHLD	DOTNCT
  019A'   21 0000               	LXI	H,0
  019D'   22 23DF'              	SHLD	CMDCNT
  01A0'   3A 2402'              	LDA	DOTLEN
  01A3'   B7                    	ORA	A
  01A4'   CA 01FE'              	JZ	DOTBEL		; nothing recorded: nothing to repeat
  01A7'   AF                    	XRA	A
  01A8'   32 2403'              	STA	DOTIX
  01AB'   2A 2404'              	LHLD	DOTNCT
  01AE'   7C                    	MOV	A,H
  01AF'   B5                    	ORA	L
  01B0'   CA 01D0'              	JZ	DOTGO
  01B3'   22 23DF'              	SHLD	CMDCNT		; the new count takes the recorded one's place
  01B6'                         DOTSKP:
  01B6'   CD 0476'              	CALL	DOTGET		; ... so step past the digits it recorded
	MACRO-80 3.44	09-Dec-81	PAGE	1-9


  01B9'   DA 01D0'              	JC	DOTGO
  01BC'   FE 30                 	CPI	'0'
  01BE'   DA 01D0'              	JC	DOTGO
  01C1'   FE 3A                 	CPI	'9'+1
  01C3'   D2 01D0'              	JNC	DOTGO
  01C6'   3A 2403'              	LDA	DOTIX
  01C9'   3C                    	INR	A
  01CA'   32 2403'              	STA	DOTIX
  01CD'   C3 01B6'              	JMP	DOTSKP
  01D0'                         DOTGO:
  01D0'   3E 01                 	MVI	A,1
  01D2'   32 23FD'              	STA	DOTRPL
  01D5'                         DOTLP:
  01D5'   CD 0476'              	CALL	DOTGET
  01D8'   DA 01F4'              	JC	DOTDN
  01DB'   4F                    	MOV	C,A
  01DC'   06 02                 	MVI	B,KT_CHAR
  01DE'   B7                    	ORA	A
  01DF'   F2 01E7'              	JP	DOTLP2
  01E2'   E6 7F                 	ANI	7FH		; bit 7: the key was an action, not a char
  01E4'   4F                    	MOV	C,A
  01E5'   06 01                 	MVI	B,KT_ACT
  01E7'                         DOTLP2:
  01E7'   3A 2403'              	LDA	DOTIX
  01EA'   3C                    	INR	A
  01EB'   32 2403'              	STA	DOTIX
  01EE'   CD 0000'              	CALL	CMDDIS		; the recorded key, dispatched as if typed
  01F1'   C3 01D5'              	JMP	DOTLP
  01F4'                         DOTDN:
  01F4'   AF                    	XRA	A
  01F5'   32 23FD'              	STA	DOTRPL
  01F8'   32 23FB'              	STA	DOTCHG		; the '.' is not itself the new last change
  01FB'   C3 062B'              	JMP	SETFUL		; whole handlers ran: repaint rather than guess
  01FE'                         DOTBEL:
  01FE'   0E 07                 	MVI	C,BEL
  0200'   CD 0000*              	CALL	BCONOU
  0203'   C3 060A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; MARKS -- 'm{a-c}' sets one, '`{a-c}' goes back to the exact spot, and
                                ; '''{a-c}' to that line's first non-blank.  Three of them, which is all
                                ; COMMANDS.md asks for.
                                ;
                                ; A mark is a logical offset plus the PGTOPM the window carried when it was
                                ; set.  It is DROPPED, never shifted, the moment it could no longer point at
                                ; the same text: MKDROP clears it when an edit happens at or before it, and a
                                ; jump refuses when the window has paged since.  That is the decided
                                ; behaviour -- a mark that survived an edit above it would point somewhere
                                ; plausible and wrong, which is worse than one that admits it is gone.
                                ;
                                ; DEVIATION from vim, deliberate and in COMMANDS.md: vim shifts a mark to
                                ; follow the text.  A consequence worth knowing is that '.' after a 'd''a'
                                ; refuses, because the delete drops the very mark the replay would need.
                                ;
                                ; The three keys arm a pending code in GPEND exactly as 'r' does, and VICMD
                                ; hands the NEXT key to MKOP instead of dispatching it: a mark letter is an
	MACRO-80 3.44	09-Dec-81	PAGE	1-10


                                ; operand, not a command.
                                ;============================================================
                                
                                ;MKVAD -- HL -> MKVAL[C], the live flag for the mark C names.  Clobbers DE.
  0206'                         MKVAD:
  0206'   16 00                 	MVI	D,0
  0208'   59                    	MOV	E,C
  0209'   21 2461'              	LXI	H,MKVAL
  020C'   19                    	DAD	D
  020D'   C9                    	RET
                                
                                ;MKCLR -- every mark goes: the buffer they named has been replaced (':e').
  020E'                         MKCLR:
  020E'   21 2461'              	LXI	H,MKVAL
  0211'   06 03                 	MVI	B,MKMAX
  0213'   AF                    	XRA	A
  0214'                         MKC_LP:
  0214'   77                    	MOV	M,A
  0215'   23                    	INX	H
  0216'   05                    	DCR	B
  0217'   C2 0214'              	JNZ	MKC_LP
  021A'   C9                    	RET
                                
                                ;MKGETK -- C = this command's next key.  During a '.' replay it has to come
                                ;from the recording: calling GETKEY there would stop dead waiting for a key
                                ;nobody is going to press.  CY = there is no key, or it was not a character.
  021B'                         MKGETK:
  021B'   3A 23FD'              	LDA	DOTRPL
  021E'   B7                    	ORA	A
  021F'   CA 0230'              	JZ	MKG_KB
  0222'   CD 0476'              	CALL	DOTGET		; the recording's next key
  0225'   D8                    	RC
  0226'   4F                    	MOV	C,A
  0227'   3A 2403'              	LDA	DOTIX		; ... stepped past, exactly as DOTLP does
  022A'   3C                    	INR	A
  022B'   32 2403'              	STA	DOTIX
  022E'   B7                    	ORA	A		; CY clear
  022F'   C9                    	RET
  0230'                         MKG_KB:
  0230'   CD 0000*              	CALL	GETKEY
  0233'   78                    	MOV	A,B
  0234'   FE 02                 	CPI	KT_CHAR
  0236'   37                    	STC
  0237'   C0                    	RNZ			; an action key (ESC) cancels the command
  0238'   B7                    	ORA	A		; CY clear
  0239'   C9                    	RET
                                
                                ;============================================================
                                ; FIND A CHARACTER -- 'f' 'F' 't' 'T' and the repeats ';' ',' .
                                ;
                                ; Each looks on THIS LINE only, whatever is on the next one, and moves nothing
                                ; at all when the character is not there -- taking a pending operator with it,
                                ; so 'dfz' with no 'z' on the line deletes nothing (recorded from vim 9.1,
                                ; VIM_FIND in accept_vi.py).
                                ;
                                ; The target is read by the command ITSELF, the way 'm' and the two mark jumps
	MACRO-80 3.44	09-Dec-81	PAGE	1-11


                                ; read the letter that names their mark: under an operator the whole of "df,"
                                ; has to happen inside one VSCAN, because OPPEND measures the span the moment
                                ; the motion returns.  Unlike the marks, the character is then handed to
                                ; DOTPRE, so it joins the recording and '.' can repeat "dfa" -- MKGETK's
                                ; keyboard path does not record for itself.
                                ;
                                ; ';' repeats the find and ',' repeats it reversed, and the stored find is NOT
                                ; changed by the ',': a ';' after it goes the original way again, as vim's
                                ; does.  A repeat of a 't' starts TWO characters along rather than one, which
                                ; is vim's one special case here and the whole reason FNDGO takes a step: the
                                ; cursor is sitting one short of the target it just found, so a repeat that
                                ; started one along would find that same target and go nowhere.
                                ;============================================================
  023A'                         VC_FF:				; 'f' -- forward, onto the character
  023A'   3E 66                 	MVI	A,'f'
  023C'   C3 024B'              	JMP	FNDNEW
  023F'                         VC_FB:				; 'F' -- backward, onto it
  023F'   3E 46                 	MVI	A,'F'
  0241'   C3 024B'              	JMP	FNDNEW
  0244'                         VC_TF:				; 't' -- forward, up to it
  0244'   3E 74                 	MVI	A,'t'
  0246'   C3 024B'              	JMP	FNDNEW
  0249'                         VC_TB:				; 'T' -- backward, up to it
  0249'   3E 54                 	MVI	A,'T'
  024B'                         FNDNEW:
  024B'   32 2456'              	STA	FNDKND		; the find ';' and ',' will repeat
  024E'   CD 021B'              	CALL	MKGETK		; the character it looks for
  0251'   DA 0288'              	JC	FNDNIL		; ESC, or a '.' replay that ran out of keys
  0254'   79                    	MOV	A,C
  0255'   32 2457'              	STA	FNDCH
  0258'   06 02                 	MVI	B,KT_CHAR	; ... and into the '.' recording (see the head)
  025A'   CD 00D9'              	CALL	DOTPRE
  025D'   3A 2456'              	LDA	FNDKND
  0260'   06 01                 	MVI	B,1		; a find starts at the next character along
  0262'   C3 028F'              	JMP	FNDGO
                                
                                ;VC_SEMI / VC_COMMA -- ';' repeats the last find, ',' repeats it reversed.
  0265'                         VC_SEMI:
  0265'   3A 2456'              	LDA	FNDKND
  0268'   B7                    	ORA	A
  0269'   CA 0288'              	JZ	FNDNIL		; nothing has been looked for yet
  026C'   C3 0278'              	JMP	FNDREP
  026F'                         VC_COMMA:
  026F'   3A 2456'              	LDA	FNDKND
  0272'   B7                    	ORA	A
  0273'   CA 0288'              	JZ	FNDNIL
  0276'   EE 20                 	XRI	20H		; the case IS the direction, and FNDKND keeps
                                				;   the find as it was
  0278'                         FNDREP:
  0278'   06 01                 	MVI	B,1
  027A'   F5                    	PUSH	PSW
  027B'   E6 5F                 	ANI	5FH		; fold to 'F' / 'T'
  027D'   FE 54                 	CPI	'T'
  027F'   C2 0284'              	JNZ	FNDR_GO
  0282'   06 02                 	MVI	B,2		; a 't' repeat starts two along (see the head)
  0284'                         FNDR_GO:
	MACRO-80 3.44	09-Dec-81	PAGE	1-12


  0284'   F1                    	POP	PSW
  0285'   C3 028F'              	JMP	FNDGO
                                
                                ;FNDNIL -- there is nothing to look for: no character was typed, or ';' / ','
                                ; came before any find at all.  Nothing moves, and an operator waiting on this
                                ; motion is cancelled whole (PSAVE is what OPPEND's tail reads).
  0288'                         FNDNIL:
  0288'   AF                    	XRA	A
  0289'   32 2409'              	STA	PSAVE
  028C'   C3 060A'              	JMP	SETMOV
                                
                                ;FNDGO -- A = the find to run, B = how far along to start.  The count's
                                ; occurrence of FNDCH on this line, or nothing.
  028F'                         FNDGO:
  028F'   32 2458'              	STA	FNDRUN
  0292'   78                    	MOV	A,B
  0293'   32 2459'              	STA	FNDSTP
  0296'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count -- spent here
  0299'   22 245A'              	SHLD	FNDN		; the occurrence wanted
  029C'   CD 0000*              	CALL	CUROFF
  029F'   22 245C'              	SHLD	FNDCUR
  02A2'   3A 2458'              	LDA	FNDRUN
  02A5'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward
  02A7'   CA 02DB'              	JZ	FNDBWD
  02AA'   2A 245C'              	LHLD	FNDCUR
  02AD'   CD 0535'              	CALL	EOLC		; HL = the line's last content character
  02B0'   22 245E'              	SHLD	FNDLIM
  02B3'   2A 245C'              	LHLD	FNDCUR
  02B6'   3A 2459'              	LDA	FNDSTP
  02B9'   5F                    	MOV	E,A
  02BA'   16 00                 	MVI	D,0
  02BC'   19                    	DAD	D		; HL = where the scan starts
  02BD'                         FNDF_LP:
  02BD'   EB                    	XCHG			; DE = the scan
  02BE'   2A 245E'              	LHLD	FNDLIM
  02C1'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  02C4'   EB                    	XCHG			; HL = the scan
  02C5'   CA 02CB'              	JZ	FNDF_AT		; the last character is still a candidate
  02C8'   D2 032D'              	JNC	FNDMIS		; past it: not on this line
  02CB'                         FNDF_AT:
  02CB'   CD 0334'              	CALL	FNDSEE		; Z iff this is the character
  02CE'   C2 02D7'              	JNZ	FNDF_NX
  02D1'   CD 033F'              	CALL	FNDCNT		; Z iff it is the one the count asked for
  02D4'   CA 0313'              	JZ	FNDHIT
  02D7'                         FNDF_NX:
  02D7'   23                    	INX	H
  02D8'   C3 02BD'              	JMP	FNDF_LP
  02DB'                         FNDBWD:
  02DB'   2A 245C'              	LHLD	FNDCUR
  02DE'   CD 04F6'              	CALL	BOL		; HL = the line's first character
  02E1'   22 245E'              	SHLD	FNDLIM
  02E4'   2A 245C'              	LHLD	FNDCUR
  02E7'   3A 2459'              	LDA	FNDSTP
  02EA'   2F                    	CMA
  02EB'   5F                    	MOV	E,A
  02EC'   16 FF                 	MVI	D,0FFH
	MACRO-80 3.44	09-Dec-81	PAGE	1-13


  02EE'   13                    	INX	D		; DE = -step
  02EF'   19                    	DAD	D		; HL = where the scan starts
  02F0'   D2 032D'              	JNC	FNDMIS		; ... off the front of the text altogether
  02F3'                         FNDB_LP:
  02F3'   EB                    	XCHG			; DE = the scan
  02F4'   2A 245E'              	LHLD	FNDLIM
  02F7'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is below the start
  02FA'   EB                    	XCHG			; HL = the scan
  02FB'   DA 032D'              	JC	FNDMIS		; before this line: not on it
  02FE'   CD 0334'              	CALL	FNDSEE
  0301'   C2 030A'              	JNZ	FNDB_NX
  0304'   CD 033F'              	CALL	FNDCNT
  0307'   CA 0313'              	JZ	FNDHIT
  030A'                         FNDB_NX:
  030A'   7C                    	MOV	A,H
  030B'   B5                    	ORA	L
  030C'   CA 032D'              	JZ	FNDMIS		; offset 0 and no hit: there is nowhere below
  030F'   2B                    	DCX	H
  0310'   C3 02F3'              	JMP	FNDB_LP
                                
                                ;FNDHIT -- HL = where the character is.  A 't' stops one short of it, on the
                                ; side the search came from.
  0313'                         FNDHIT:
  0313'   3A 2458'              	LDA	FNDRUN
  0316'   E6 5F                 	ANI	5FH
  0318'   FE 54                 	CPI	'T'
  031A'   C2 032A'              	JNZ	FNDLND
  031D'   3A 2458'              	LDA	FNDRUN
  0320'   E6 20                 	ANI	20H
  0322'   CA 0329'              	JZ	FNDH_BW
  0325'   2B                    	DCX	H		; forward 't': the character before it
  0326'   C3 032A'              	JMP	FNDLND
  0329'                         FNDH_BW:
  0329'   23                    	INX	H		; backward 'T': the character after it
  032A'                         FNDLND:
  032A'   C3 048C'              	JMP	GOSET		; there, and the goal column with it
                                
                                ;FNDMIS -- the character is not on this line.  vim moves nothing and rings the
                                ; bell; an operator running the motion is cancelled whole, so 'dfz' deletes
                                ; nothing rather than falling back on some other span.
  032D'                         FNDMIS:
  032D'   AF                    	XRA	A
  032E'   32 2409'              	STA	PSAVE
  0331'   C3 01FE'              	JMP	DOTBEL
                                
                                ;FNDSEE -- Z iff the character at HL is the one being looked for.  Keeps HL.
  0334'                         FNDSEE:
  0334'   E5                    	PUSH	H
  0335'   CD 0000*              	CALL	CHARAT
  0338'   E1                    	POP	H
  0339'   47                    	MOV	B,A
  033A'   3A 2457'              	LDA	FNDCH
  033D'   B8                    	CMP	B
  033E'   C9                    	RET
                                
                                ;FNDCNT -- count one occurrence off; Z iff that was the one asked for.  HL is
	MACRO-80 3.44	09-Dec-81	PAGE	1-14


                                ; the scan and stays it.
  033F'                         FNDCNT:
  033F'   E5                    	PUSH	H
  0340'   2A 245A'              	LHLD	FNDN
  0343'   2B                    	DCX	H
  0344'   22 245A'              	SHLD	FNDN
  0347'   7C                    	MOV	A,H
  0348'   B5                    	ORA	L
  0349'   E1                    	POP	H
  034A'   C9                    	RET
                                
                                ;ISFIND -- Z iff A is one of 'f' 'F' 't' 'T': the finds that read a character
                                ; of their own, and so owe one back when the operator drops the motion.
  034B'                         ISFIND:
  034B'   E6 5F                 	ANI	5FH		; fold the case away
  034D'   FE 46                 	CPI	'F'
  034F'   C8                    	RZ
  0350'   FE 54                 	CPI	'T'
  0352'   C9                    	RET
                                
                                ;VC_MK / VC_BQ / VC_AQ -- 'm', '`' and '''.  Each reads the key that names its
                                ;mark ITSELF, the way RDLINE reads a '/' pattern, instead of leaving a pending
                                ;code for the next dispatch: under an operator the whole of "d'a" has to
                                ;happen inside one VSCAN, because OPPEND measures the span the moment the
                                ;motion returns to it.
  0353'                         VC_MK:
  0353'   3E 04                 	MVI	A,PM
  0355'   C3 035F'              	JMP	MKGO
  0358'                         VC_BQ:
  0358'   3E 05                 	MVI	A,PJ
  035A'   C3 035F'              	JMP	MKGO
  035D'                         VC_AQ:
  035D'   3E 06                 	MVI	A,PJL
  035F'                         MKGO:
  035F'   32 2466'              	STA	MKWHAT
  0362'   CD 058A'              	CALL	MOVCNT		; a count means nothing on any of the three
  0365'   CD 021B'              	CALL	MKGETK		; the key that names the mark
  0368'   DA 03C0'              	JC	MKBAD		; no key: ESC cancelled it, or a '.' replay
                                				;   ran out -- the letter is read here and so
                                				;   was never recorded, which is why a '.'
                                				;   after "d'a" refuses (COMMANDS.md).  It must
                                				;   CANCEL, not just return: an empty linewise
                                				;   span still takes a whole line
                                				; ... otherwise fall into MKOP
                                
                                ;MKOP -- C names the mark.  Only 'a' to 'c' exist; any other key drops the
                                ;whole thing, as vim's 'Z{other}' does.
  036B'                         MKOP:
  036B'   79                    	MOV	A,C
  036C'   D6 61                 	SUI	'a'
  036E'   FE 03                 	CPI	MKMAX
  0370'   D2 03C0'              	JNC	MKBAD		; not a mark letter: nothing happens
  0373'   4F                    	MOV	C,A		; C = the mark's index
  0374'   87                    	ADD	A
  0375'   87                    	ADD	A		; ... and MKSIZ bytes to each slot
  0376'   5F                    	MOV	E,A
	MACRO-80 3.44	09-Dec-81	PAGE	1-15


  0377'   16 00                 	MVI	D,0
  0379'   21 0000*              	LXI	H,MKTAB
  037C'   19                    	DAD	D		; HL -> this mark's slot
  037D'   3A 2466'              	LDA	MKWHAT
  0380'   FE 04                 	CPI	PM
  0382'   CA 03C7'              	JZ	MKSET
                                				; ... otherwise fall into MKJMP
                                
                                ;MKJMP -- go back to the mark.  It refuses, with the bell, when the mark was
                                ;never set or when the window has paged away from under it.
  0385'                         MKJMP:
  0385'   E5                    	PUSH	H
  0386'   CD 0206'              	CALL	MKVAD
  0389'   7E                    	MOV	A,M
  038A'   E1                    	POP	H
  038B'   B7                    	ORA	A
  038C'   CA 03C0'              	JZ	MKBAD		; never set
  038F'   5E                    	MOV	E,M
  0390'   23                    	INX	H
  0391'   56                    	MOV	D,M		; DE = the offset it holds
  0392'   23                    	INX	H
  0393'   7E                    	MOV	A,M
  0394'   23                    	INX	H
  0395'   66                    	MOV	H,M
  0396'   6F                    	MOV	L,A		; HL = the window signature it was set under
  0397'   D5                    	PUSH	D
  0398'   EB                    	XCHG			; DE = that signature
  0399'   2A 0000*              	LHLD	PGTOPM
  039C'   7D                    	MOV	A,L
  039D'   BB                    	CMP	E
  039E'   C2 03BA'              	JNZ	MKSTAL
  03A1'   7C                    	MOV	A,H
  03A2'   BA                    	CMP	D
  03A3'   C2 03BA'              	JNZ	MKSTAL
  03A6'   3A 2466'              	LDA	MKWHAT		; decided BEFORE the GOTO, so no register of
  03A9'   FE 06                 	CPI	PJL		;   ours has to survive a BUF primitive
  03AB'   CA 03B3'              	JZ	MKJ_GO		; ''': GPKEEP is 0, so GPLACE finds the first
  03AE'   3E 01                 	MVI	A,1		;   non-blank
  03B0'   32 2460'              	STA	GPKEEP		; '`': land on the column it was set at
  03B3'                         MKJ_GO:
  03B3'   E1                    	POP	H		; HL = the offset
  03B4'   CD 0000*              	CALL	GOTO
  03B7'   C3 0DF9'              	JMP	GPLACE		; (which sets LNDLT itself)
  03BA'                         MKSTAL:
  03BA'   E1                    	POP	H		; the window paged: the mark is gone for good
  03BB'   CD 0206'              	CALL	MKVAD
  03BE'   36 00                 	MVI	M,0
                                				; ... and fall into MKBAD
                                
                                ;MKBAD -- this mark will not answer.  An operator running the motion is
                                ;cancelled whole: PSAVE is what OPPEND's tail reads to decide whether to open
                                ;an insert, so clearing it stops a "c`z" opening one over a span of nothing.
  03C0'                         MKBAD:
  03C0'   AF                    	XRA	A
  03C1'   32 2409'              	STA	PSAVE
  03C4'   C3 01FE'              	JMP	DOTBEL
	MACRO-80 3.44	09-Dec-81	PAGE	1-16


                                
                                ;MKSET -- remember where the cursor is, and which window it is in.
  03C7'                         MKSET:
  03C7'   E5                    	PUSH	H
  03C8'   CD 0000*              	CALL	CUROFF		; HL = the cursor's logical offset
  03CB'   EB                    	XCHG
  03CC'   2A 0000*              	LHLD	PGTOPM
  03CF'   E3                    	XTHL			; HL = the slot, (SP) = the signature
  03D0'   73                    	MOV	M,E
  03D1'   23                    	INX	H
  03D2'   72                    	MOV	M,D
  03D3'   23                    	INX	H
  03D4'   D1                    	POP	D
  03D5'   73                    	MOV	M,E
  03D6'   23                    	INX	H
  03D7'   72                    	MOV	M,D
  03D8'   CD 0206'              	CALL	MKVAD
  03DB'   36 01                 	MVI	M,1		; ... and the mark is live
  03DD'   C3 060A'              	JMP	SETMOV		; 'm' draws nothing and moves nothing
                                
                                ;MKDROP -- an edit is happening at the cursor: drop every mark it could have
                                ;left pointing at different text.  A mark BEFORE the edit still names what it
                                ;named; one at or after it does not, because the text moved under it.  Called
                                ;from MARKMOD, so it must come back with every register as it found it.
  03E0'                         MKDROP:
  03E0'   F5                    	PUSH	PSW
  03E1'   3A 2467'              	LDA	MKHOLD		; a yank takes its lines out and puts them back
  03E4'   B7                    	ORA	A		;   unchanged (VY_YY): the text every mark points
  03E5'   C2 041A'              	JNZ	MKD_HL		;   into is still there, so none of them goes
  03E8'   C5                    	PUSH	B
  03E9'   D5                    	PUSH	D
  03EA'   E5                    	PUSH	H
  03EB'   CD 0000*              	CALL	CUROFF		; HL = where the edit is (CUROFF clobbers DE)
  03EE'   22 2464'              	SHLD	MKEDIT
  03F1'   21 2461'              	LXI	H,MKVAL
  03F4'   11 0000*              	LXI	D,MKTAB
  03F7'   06 03                 	MVI	B,MKMAX
  03F9'                         MKD_LP:
  03F9'   7E                    	MOV	A,M
  03FA'   B7                    	ORA	A
  03FB'   CA 040E'              	JZ	MKD_NX		; that mark is not set: nothing to drop
  03FE'   E5                    	PUSH	H
  03FF'   2A 2464'              	LHLD	MKEDIT
  0402'   1A                    	LDAX	D		; the mark's offset, low
  0403'   95                    	SUB	L
  0404'   13                    	INX	D
  0405'   1A                    	LDAX	D		; ... and high (neither INX nor LDAX touch CY)
  0406'   1B                    	DCX	D
  0407'   9C                    	SBB	H		; CY iff the mark is BEFORE the edit
  0408'   E1                    	POP	H
  0409'   DA 040E'              	JC	MKD_NX
  040C'   36 00                 	MVI	M,0		; at it or after it: the mark is dropped
  040E'                         MKD_NX:
  040E'   23                    	INX	H
  040F'   13                    	INX	D
  0410'   13                    	INX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-17


  0411'   13                    	INX	D
  0412'   13                    	INX	D
  0413'   05                    	DCR	B
  0414'   C2 03F9'              	JNZ	MKD_LP
  0417'   E1                    	POP	H
  0418'   D1                    	POP	D
  0419'   C1                    	POP	B
  041A'                         MKD_HL:
  041A'   F1                    	POP	PSW
  041B'   C9                    	RET
                                
                                
                                ;============================================================
                                ; UNDO -- 'u'.  One level, as real vi has it: 'u' undoes the last change and a
                                ; second 'u' puts it back.  The capture, the record format and everything that
                                ; puts undo out of reach are BUF.MAC's UNDO section; all that belongs up here is
                                ; the key, the repaint and what to say when it will not run.
                                ;
                                ; 'u' is not itself a change: it calls neither MARKMOD nor anything else that
                                ; sets DOTCHG, so a '.' after a 'u' still repeats the command the undo took
                                ; back -- which is what vim does.  It does set MODF, because a buffer that has
                                ; been undone past a ':w' no longer matches the file on disk.
                                ;============================================================
                                
                                ;VC_UNDO -- 'u'.  A count is meaningless with a single level, so it is
                                ;swallowed rather than obeyed (as the counts on i a A I r R o O J ~ are -- see
                                ;COMMANDS.md).
  041C'                         VC_UNDO:
  041C'   21 0000               	LXI	H,0
  041F'   22 23DF'              	SHLD	CMDCNT
  0422'   CD 0000*              	CALL	UNDO
  0425'   DA 0459'              	JC	UNDNO
  0428'   2A 0000*              	LHLD	UNDCUR
  042B'   CD 043F'              	CALL	UCLAMP		; vi never sits on a line terminator
  042E'   CD 0000*              	CALL	GOTO		; ... and this keeps LNDLT, as the replay did
  0431'   CD 03E0'              	CALL	MKDROP		; the undo moved text back under any mark past it
  0434'   3E 01                 	MVI	A,1
  0436'   32 23E2'              	STA	MODF		; undone past a ':w' still differs from the file
  0439'   CD 077D'              	CALL	GLSTAL		; the cursor jumped to the change: no goal column
  043C'   C3 062B'              	JMP	SETFUL		; whole spans moved: repaint rather than guess
                                
                                ;UCLAMP -- HL(off) -> HL, held inside its line: vi never sits on a terminator,
                                ;so an offset at or past the line's content end comes back onto the last char.
                                ;An empty line keeps the offset at its start, there being nothing to sit on.
  043F'                         UCLAMP:
  043F'   E5                    	PUSH	H
  0440'   CD 119A'              	CALL	CEND		; HL = the line's content end
  0443'   D1                    	POP	D		; DE = the offset wanted
  0444'   CD 0000*              	CALL	CMP16		; CY iff it is inside the line
  0447'   D2 044C'              	JNC	UCL_BK
  044A'   EB                    	XCHG
  044B'   C9                    	RET
  044C'                         UCL_BK:
  044C'   E5                    	PUSH	H		; the content end
  044D'   EB                    	XCHG			; HL = the offset wanted
  044E'   CD 04F6'              	CALL	BOL
	MACRO-80 3.44	09-Dec-81	PAGE	1-18


  0451'   D1                    	POP	D		; DE = the content end, HL = the line's start
  0452'   CD 0000*              	CALL	CMP16		; Z iff the line is empty
  0455'   EB                    	XCHG			; HL = the content end
  0456'   C8                    	RZ
  0457'   2B                    	DCX	H		; ... its last character
  0458'   C9                    	RET
  0459'                         UNDNO:
  0459'   3A 0000*              	LDA	UNDWHY
  045C'   B7                    	ORA	A
  045D'   CA 046E'              	JZ	UNDBEL
  0460'   21 1D97'              	LXI	H,SUNDW		; the change has paged away: say so
  0463'   FE 01                 	CPI	1
  0465'   CA 1CDE'              	JZ	EXERR
  0468'   21 1DB9'              	LXI	H,SUNDB		; ... or it never fitted the undo region
  046B'   C3 1CDE'              	JMP	EXERR
  046E'                         UNDBEL:
  046E'   0E 07                 	MVI	C,BEL
  0470'   CD 0000*              	CALL	BCONOU
  0473'   C3 060A'              	JMP	SETMOV
                                
                                ;DOTGET -- A = the recorded key at DOTIX; CY when the recording is spent.
  0476'                         DOTGET:
  0476'   3A 2403'              	LDA	DOTIX
  0479'   5F                    	MOV	E,A
  047A'   3A 2402'              	LDA	DOTLEN
  047D'   BB                    	CMP	E
  047E'   CA 048A'              	JZ	DOTGEF
  0481'   16 00                 	MVI	D,0
  0483'   21 0000*              	LXI	H,DOTBUF
  0486'   19                    	DAD	D
  0487'   7E                    	MOV	A,M
  0488'   B7                    	ORA	A		; CY clear: a key was returned
  0489'   C9                    	RET
  048A'                         DOTGEF:
  048A'   37                    	STC
  048B'   C9                    	RET
                                
                                ;============================================================
                                ; GOAL-COLUMN + LINE STRUCTURE (vi semantics; logical-offset space).
                                ; The gap-agnostic offset<->pointer mapping (CUROFF/LOGLEN/CHARAT/GOTO, plus the
                                ; private L2PHYS/CLAMPL helpers and the DELFWD/DELPRV deletes) now lives in
                                ; BUF.MAC and is EXTRN'd above; this module works purely in logical offsets.
                                ;============================================================
                                
                                ;GOSET -- HL(off): GOTO then refresh GOALCOL from the landing column.
  048C'                         GOSET:
  048C'   CD 0000*              	CALL	GOTO
                                ;SETGL -- GOALCOL = the cursor's screen column, as vim's curswant: a TAB under
                                ; the cursor counts at its last column.  The line's start is found with WM's
                                ; LINPSB, so a line begun before the window is paged back.
  048F'                         SETGL:
  048F'   CD 0DBB'              	CALL	ZSAVE
  0492'   21 0000               	LXI	H,0
  0495'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  0498'   E5                    	PUSH	H
  0499'   CD 0DCE'              	CALL	ZREST
	MACRO-80 3.44	09-Dec-81	PAGE	1-19


  049C'   E1                    	POP	H
  049D'   E5                    	PUSH	H
  049E'   CD 0596'              	CALL	GBSUB		; HL = bytes to the cursor
  04A1'   44                    	MOV	B,H
  04A2'   4D                    	MOV	C,L
  04A3'   E1                    	POP	H		; HL = the line's start
  04A4'   11 0000               	LXI	D,0		; DE = screen column
  04A7'                         SG_LP:
  04A7'   78                    	MOV	A,B
  04A8'   B1                    	ORA	C
  04A9'   CA 04BE'              	JZ	SG_CUR
  04AC'   7E                    	MOV	A,M
  04AD'   23                    	INX	H
  04AE'   0B                    	DCX	B
  04AF'   E5                    	PUSH	H
  04B0'   6B                    	MOV	L,E
  04B1'   CD 04E3'              	CALL	CWID
  04B4'   E1                    	POP	H
  04B5'   83                    	ADD	E
  04B6'   5F                    	MOV	E,A
  04B7'   D2 04A7'              	JNC	SG_LP
  04BA'   14                    	INR	D
  04BB'   C3 04A7'              	JMP	SG_LP
  04BE'                         SG_CUR:
  04BE'   2A 0000*              	LHLD	TXTEND
  04C1'   D5                    	PUSH	D
  04C2'   EB                    	XCHG
  04C3'   2A 0000*              	LHLD	GAPEND
  04C6'   CD 0000*              	CALL	CMP16		; Z iff no char under the cursor
  04C9'   D1                    	POP	D
  04CA'   CA 04DE'              	JZ	SG_SET
  04CD'   7E                    	MOV	A,M
  04CE'   FE 09                 	CPI	TAB
  04D0'   C2 04DE'              	JNZ	SG_SET
  04D3'   6B                    	MOV	L,E
  04D4'   CD 04E3'              	CALL	CWID
  04D7'   3D                    	DCR	A		; the TAB's last column
  04D8'   83                    	ADD	E
  04D9'   5F                    	MOV	E,A
  04DA'   D2 04DE'              	JNC	SG_SET
  04DD'   14                    	INR	D
  04DE'                         SG_SET:
  04DE'   EB                    	XCHG
  04DF'   22 23E7'              	SHLD	GOALCOL
  04E2'   C9                    	RET
                                
                                ;CWID -- A = a char, L = its screen column (low byte) -> A = its width: a TAB
                                ; runs to the next multiple of TABWID, a CR takes none (as LAYOUT draws them).
  04E3'                         CWID:
  04E3'   FE 0D                 	CPI	CR
  04E5'   CA 04F4'              	JZ	CW_0
  04E8'   FE 09                 	CPI	TAB
  04EA'   3E 01                 	MVI	A,1
  04EC'   C0                    	RNZ
  04ED'   7D                    	MOV	A,L
  04EE'   E6 07                 	ANI	TABWID-1
	MACRO-80 3.44	09-Dec-81	PAGE	1-20


  04F0'   2F                    	CMA
  04F1'   C6 09                 	ADI	TABWID+1	; TABWID - (column MOD TABWID)
  04F3'   C9                    	RET
  04F4'                         CW_0:
  04F4'   AF                    	XRA	A
  04F5'   C9                    	RET
                                
                                ;============================================================
                                ; LINE-STRUCTURE HELPERS (all in logical-offset space).
                                ; A line ends at its LF; a CR immediately before that LF is part of the break.
                                ;============================================================
                                
                                ;BOL -- HL(off) -> HL = start-of-line offset (just past the previous LF, or 0).
  04F6'                         BOL:
  04F6'                         BOL_LP:
  04F6'   7C                    	MOV	A,H
  04F7'   B5                    	ORA	L
  04F8'   C8                    	RZ			; at 0
  04F9'   2B                    	DCX	H		; look at off-1
  04FA'   E5                    	PUSH	H
  04FB'   CD 0000*              	CALL	CHARAT
  04FE'   E1                    	POP	H		; HL = off-1
  04FF'   FE 0A                 	CPI	LF
  0501'   CA 0507'              	JZ	BOL_DN
  0504'   C3 04F6'              	JMP	BOL_LP
  0507'                         BOL_DN:
  0507'   23                    	INX	H		; line starts just after the LF
  0508'   C9                    	RET
                                
                                ;EOLNL -- HL(off) -> HL = offset of the LF ending this line, or LOGLEN if none.
  0509'                         EOLNL:
  0509'   E5                    	PUSH	H
  050A'   CD 0000*              	CALL	LOGLEN
  050D'   22 241B'              	SHLD	WKN
  0510'   E1                    	POP	H
  0511'                         ENL_LP:
  0511'   EB                    	XCHG			; DE = i
  0512'   2A 241B'              	LHLD	WKN
  0515'   CD 0000*              	CALL	CMP16		; DE=i vs HL=n: CY iff i < n
  0518'   EB                    	XCHG			; HL = i, DE = n
  0519'   D0                    	RNC			; i >= n: no LF on this line
  051A'   E5                    	PUSH	H
  051B'   CD 0000*              	CALL	CHARAT
  051E'   E1                    	POP	H
  051F'   FE 0A                 	CPI	LF
  0521'   C8                    	RZ			; the LF: HL is its offset
  0522'   23                    	INX	H
  0523'   C3 0511'              	JMP	ENL_LP
                                
                                ;NLSTART -- HL(off) -> HL = start of next line (EOLNL+1), or LOGLEN if last.
  0526'                         NLSTART:
  0526'   CD 0509'              	CALL	EOLNL
  0529'   E5                    	PUSH	H
  052A'   CD 0000*              	CALL	LOGLEN
  052D'   D1                    	POP	D		; DE = eol result
  052E'   CD 0000*              	CALL	CMP16		; DE=eol vs HL=LOGLEN: Z iff equal
	MACRO-80 3.44	09-Dec-81	PAGE	1-21


  0531'   C8                    	RZ			; no next line: HL = LOGLEN
  0532'   EB                    	XCHG			; HL = eol
  0533'   23                    	INX	H
  0534'   C9                    	RET
                                
                                ;EOLC -- HL(off) -> HL = last content-char offset of the line (>= BOL).
  0535'                         EOLC:
  0535'   E5                    	PUSH	H
  0536'   CD 0509'              	CALL	EOLNL
  0539'   22 241D'              	SHLD	WKTERM
  053C'   E1                    	POP	H
  053D'   CD 04F6'              	CALL	BOL
  0540'   22 241F'              	SHLD	WKBOL
  0543'   2A 241D'              	LHLD	WKTERM
  0546'   EB                    	XCHG			; DE = term
  0547'   2A 241F'              	LHLD	WKBOL
  054A'   CD 0000*              	CALL	CMP16		; DE=term vs HL=bol: Z iff empty line
  054D'   CA 056C'              	JZ	EOLC_MT
  0550'   EB                    	XCHG			; HL = term
  0551'   2B                    	DCX	H		; term-1
  0552'   E5                    	PUSH	H
  0553'   CD 0000*              	CALL	CHARAT
  0556'   E1                    	POP	H		; HL = term-1
  0557'   FE 0D                 	CPI	CR
  0559'   CA 055F'              	JZ	EOLC_CR		; content ends at term-1
  055C'   C3 0560'              	JMP	EOLC_LS		; content ends at term; last = term-1 = HL
  055F'                         EOLC_CR:
  055F'   2B                    	DCX	H		; last = (term-1) - 1
  0560'                         EOLC_LS:
  0560'   EB                    	XCHG			; DE = last
  0561'   2A 241F'              	LHLD	WKBOL
  0564'   CD 0000*              	CALL	CMP16		; DE=last vs HL=bol: CY iff last < bol
  0567'   DA 056C'              	JC	EOLC_MT
  056A'   EB                    	XCHG			; HL = last
  056B'   C9                    	RET
  056C'                         EOLC_MT:
  056C'   2A 241F'              	LHLD	WKBOL
  056F'   C9                    	RET
                                
                                ;COL -- HL(off) -> HL = off - BOL(off).
  0570'                         COL:
  0570'   E5                    	PUSH	H
  0571'   CD 04F6'              	CALL	BOL
  0574'   D1                    	POP	D		; DE = off
  0575'   EB                    	XCHG			; HL = off, DE = bol
  0576'   C3 0000*              	JMP	SUBHD
                                
                                ;--- the idioms this module repeats, each written once ---------------------
                                ; Every one of these is the sequence it replaces, tail-called so the last
                                ; routine's registers and flags reach the caller untouched.
                                ;
                                ;ATENDQ -- Z iff the cursor is at the end of the text.  Leaves what the
                                ; sequence left: HL = LOGLEN, DE = the cursor's offset, CMP16's flags.
  0579'                         ATENDQ:
  0579'   CD 0000*              	CALL	CUROFF
  057C'   E5                    	PUSH	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-22


  057D'   CD 0000*              	CALL	LOGLEN
  0580'   D1                    	POP	D		; DE = cur
  0581'   C3 0000*              	JMP	CMP16		; DE=cur vs HL=LOGLEN: Z iff at the very end
                                ;CURCHR -- A = the char under the cursor.
  0584'                         CURCHR:
  0584'   CD 0000*              	CALL	CUROFF
  0587'   C3 0000*              	JMP	CHARAT
                                ;MOVCNT -- a pure cursor motion, and its count in HL.
  058A'                         MOVCNT:
  058A'   CD 060A'              	CALL	SETMOV
  058D'   C3 059D'              	JMP	GETCNT
                                ;CNTOFF -- spend the count, then HL = the cursor's offset.
  0590'                         CNTOFF:
  0590'   CD 059D'              	CALL	GETCNT
  0593'   C3 0000*              	JMP	CUROFF
                                ;GBSUB -- HL(a pointer into the text) -> HL = GAPBEG - it.
  0596'                         GBSUB:
  0596'   EB                    	XCHG
  0597'   2A 0000*              	LHLD	GAPBEG
  059A'   C3 0000*              	JMP	SUBHD
                                
                                ;GETCNT -- HL = count (>=1); clears CMDCNT.
  059D'                         GETCNT:
  059D'   2A 23DF'              	LHLD	CMDCNT
  05A0'   7C                    	MOV	A,H
  05A1'   B5                    	ORA	L
  05A2'   C2 05A9'              	JNZ	GC_HAVE
  05A5'   21 0001               	LXI	H,1
  05A8'   C9                    	RET
  05A9'                         GC_HAVE:
  05A9'   E5                    	PUSH	H
  05AA'   21 0000               	LXI	H,0
  05AD'   22 23DF'              	SHLD	CMDCNT
  05B0'   E1                    	POP	H
  05B1'   C9                    	RET
                                
                                ;CNTTST -- WM 1175: Z iff the command count is exhausted -- both CMDCNT and the
                                ;auxiliary counter AUXCNT are zero -- then poll for a ^C break.  BUF.MAC's PAGESTP
                                ;(reached from DELTO) and the count loops (the line moves, dd, the search
                                ;sweep) test it to decide whether to stop or page one more step.  POLLBRK is tail-called (JMP) and
                                ;preserves the ORA-set Z flag (PAGE.MAC POLLBRK, as WM, brackets its body in
                                ;PUSH/POP PSW), so the caller sees the count's Z.
  05B2'                         CNTTST:				; WM 1175
  05B2'   E5                    	PUSH	H
  05B3'   2A 23DF'              	LHLD	CMDCNT
  05B6'   3A 0000*              	LDA	AUXCNT		; low byte of the auxiliary count (WM's L271E)
  05B9'   B4                    	ORA	H
  05BA'   B5                    	ORA	L
  05BB'   E1                    	POP	H
  05BC'   C3 0000*              	JMP	POLLBRK
                                
                                ;CLASSF -- A(byte) -> A = char class.  0 = whitespace, 1 = word, 2 = other.
                                ; WBIG=1 collapses word/other into class 1 (big-word: non-ws is one class).
  05BF'                         CLASSF:
  05BF'   47                    	MOV	B,A
  05C0'   FE 20                 	CPI	' '
	MACRO-80 3.44	09-Dec-81	PAGE	1-23


  05C2'   CA 0602'              	JZ	CLS0
  05C5'   FE 09                 	CPI	TAB
  05C7'   CA 0602'              	JZ	CLS0
  05CA'   FE 0A                 	CPI	LF
  05CC'   CA 0602'              	JZ	CLS0
  05CF'   FE 0D                 	CPI	CR
  05D1'   CA 0602'              	JZ	CLS0
  05D4'   3A 23E9'              	LDA	WBIG
  05D7'   B7                    	ORA	A
  05D8'   C2 0604'              	JNZ	CLS1
  05DB'   78                    	MOV	A,B
  05DC'   FE 5F                 	CPI	'_'
  05DE'   CA 0604'              	JZ	CLS1
  05E1'   FE 30                 	CPI	'0'
  05E3'   DA 0607'              	JC	CLS2
  05E6'   FE 3A                 	CPI	'9'+1
  05E8'   DA 0604'              	JC	CLS1
  05EB'   FE 41                 	CPI	'A'
  05ED'   DA 0607'              	JC	CLS2
  05F0'   FE 5B                 	CPI	'Z'+1
  05F2'   DA 0604'              	JC	CLS1
  05F5'   FE 61                 	CPI	'a'
  05F7'   DA 0607'              	JC	CLS2
  05FA'   FE 7B                 	CPI	'z'+1
  05FC'   DA 0604'              	JC	CLS1
  05FF'   C3 0607'              	JMP	CLS2
  0602'   AF                    CLS0:	XRA	A
  0603'   C9                    	RET
  0604'   3E 01                 CLS1:	MVI	A,1
  0606'   C9                    	RET
  0607'   3E 02                 CLS2:	MVI	A,2
  0609'   C9                    	RET
                                
                                ;============================================================
                                ; MOTIONS -- horizontal
                                ;============================================================
                                
                                ;SETMOV -- mark the current command a pure cursor motion (R_MOVE) so SCRN.MAC
                                ; repositions the cursor without a full repaint.  Clobbers A only.  Every motion
                                ; handler CALLs this at entry; NEVER call it from a shared step (e.g. HSTEP),
                                ; which insert-exit reuses and which must keep the R_FULL default.
  060A'                         SETMOV:
  060A'   3E 01                 	MVI	A,R_MOVE
  060C'   32 23E3'              	STA	RINTENT
  060F'   C9                    	RET
                                
                                ;SETLIN -- mark the current command an in-line edit (R_LINE): it changed only
                                ; bytes within the cursor's line (no LF added/removed, so the line count and
                                ; every other row are unchanged), and SCRN.MAC redraws just that one row.  Call
                                ; it ONLY from a handler that cannot alter the line structure -- never from a
                                ; path that may insert/delete an LF (that must keep the R_FULL default so the
                                ; renderer repaints in full).  Clobbers A only.
  0610'                         SETLIN:
  0610'   3E 02                 	MVI	A,R_LINE
  0612'   32 23E3'              	STA	RINTENT
  0615'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-24


                                
                                ;SETILN -- mark the current command an opened line (R_ILIN): exactly ONE line
                                ; break went in at the cursor, so the terminal can open a row (IL) and only the
                                ; opened rows need drawing.  Call it ONLY where a single break was added --
                                ; never from OPNBRK itself, which the put ('p') also calls before inserting a
                                ; whole register's worth of lines.  Clobbers A only.
                                ; ILABOV is cleared here because that is the common case: 'o', 'O' and a put
                                ; leave the line ABOVE the opened rows exactly as it was, so re-sending that
                                ; row is a whole row of wire for nothing.  Only a command that takes text OFF
                                ; that line -- a mid-line <CR>, 'r<CR>' -- sets it afterwards.
  0616'                         SETILN:
  0616'   3E 01                 	MVI	A,1
  0618'   32 23E4'              	STA	ILN		; one line, unless a put overwrites it below
  061B'   3E 05                 	MVI	A,R_ILIN
  061D'   32 23E3'              	STA	RINTENT
  0620'   AF                    	XRA	A
  0621'   32 23E6'              	STA	ILABOV		; the row above the opened ones is untouched
  0624'   C9                    	RET
                                
                                ;SETJON -- mark the current command a join (R_JOIN): the line below came up
                                ; onto the cursor's, so that row and the row under it are what changed.
  0625'                         SETJON:
  0625'   3E 06                 	MVI	A,R_JOIN
  0627'   32 23E3'              	STA	RINTENT
  062A'   C9                    	RET
                                
                                ;SETFUL -- put the render intent back to R_FULL (the main loop's own default),
                                ; for a handler that lowered it and then found it had more to change than the
                                ; cheap paint can carry.  Clobbers A only.
  062B'                         SETFUL:
  062B'   3E 00                 	MVI	A,R_FULL
  062D'   32 23E3'              	STA	RINTENT
  0630'   C9                    	RET
                                
                                ;TAILTAB -- A = 1 if a TAB occurs from the cursor to the end of its line, else 0.
                                ; Scans forward from the cursor via CHARAT until LF or end of text (no gap move).
                                ; Gates the ICH insert fast path: a tab after the cursor would re-expand.
  0631'                         TAILTAB:
  0631'   CD 0000*              	CALL	CUROFF
  0634'   22 2417'              	SHLD	TTI
  0637'                         TT_LP:
  0637'   2A 2417'              	LHLD	TTI
  063A'   EB                    	XCHG			; DE = TTI
  063B'   CD 0000*              	CALL	LOGLEN		; HL = LOGLEN
  063E'   CD 0000*              	CALL	CMP16		; CY iff TTI < LOGLEN
  0641'   D2 0661'              	JNC	TT_NO		; reached end of text -> no tab
  0644'   2A 2417'              	LHLD	TTI
  0647'   CD 0000*              	CALL	CHARAT
  064A'   FE 0A                 	CPI	LF
  064C'   CA 0661'              	JZ	TT_NO		; end of line -> no tab
  064F'   FE 09                 	CPI	TAB
  0651'   CA 065E'              	JZ	TT_YES
  0654'   2A 2417'              	LHLD	TTI
  0657'   23                    	INX	H
  0658'   22 2417'              	SHLD	TTI
  065B'   C3 0637'              	JMP	TT_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-25


  065E'                         TT_YES:
  065E'   3E 01                 	MVI	A,1
  0660'   C9                    	RET
  0661'                         TT_NO:
  0661'   AF                    	XRA	A
  0662'   C9                    	RET
                                
                                ;VC_H -- left, count times, stopping at BOL.
  0663'                         VC_H:
  0663'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0666'   22 2415'              	SHLD	CNTV
  0669'                         VCH_LP:
  0669'   2A 2415'              	LHLD	CNTV
  066C'   7C                    	MOV	A,H
  066D'   B5                    	ORA	L
  066E'   C8                    	RZ
  066F'   2B                    	DCX	H
  0670'   22 2415'              	SHLD	CNTV
  0673'   CD 0679'              	CALL	HSTEP
  0676'   C3 0669'              	JMP	VCH_LP
  0679'                         HSTEP:
  0679'   CD 0000*              	CALL	CUROFF		; HL = cur
  067C'   7C                    	MOV	A,H
  067D'   B5                    	ORA	L
  067E'   C8                    	RZ			; at 0
  067F'   E5                    	PUSH	H
  0680'   CD 04F6'              	CALL	BOL		; HL = bol
  0683'   D1                    	POP	D		; DE = cur
  0684'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=bol: Z iff cur==bol
  0687'   C8                    	RZ			; at BOL, cannot go left
  0688'   EB                    	XCHG			; HL = cur
  0689'   2B                    	DCX	H
  068A'   C3 048C'              	JMP	GOSET
                                
                                ;VC_L -- right, count times, stopping at last content char.
  068D'                         VC_L:
  068D'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0690'   22 2415'              	SHLD	CNTV
  0693'                         VCL_LP:
  0693'   2A 2415'              	LHLD	CNTV
  0696'   7C                    	MOV	A,H
  0697'   B5                    	ORA	L
  0698'   C8                    	RZ
  0699'   2B                    	DCX	H
  069A'   22 2415'              	SHLD	CNTV
  069D'   CD 06A3'              	CALL	LSTEP
  06A0'   C3 0693'              	JMP	VCL_LP
  06A3'                         LSTEP:
  06A3'   CD 0000*              	CALL	CUROFF		; HL = cur
  06A6'   E5                    	PUSH	H
  06A7'   CD 0535'              	CALL	EOLC		; HL = eolc
  06AA'   D1                    	POP	D		; DE = cur
  06AB'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  06AE'   D0                    	RNC			; cur >= eolc, cannot go right
  06AF'   EB                    	XCHG			; HL = cur
  06B0'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-26


  06B1'   C3 048C'              	JMP	GOSET
                                
                                ;VC_0 -- start of line (WM ^B: GOALCOL = 0; the start is found with WM's
                                ; LINPOSB, so a line begun before the window is paged back).
  06B4'                         VC_0:
  06B4'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  06B7'   CD 06C1'              	CALL	LNSTRT
  06BA'   21 0000               	LXI	H,0
  06BD'   22 23E7'              	SHLD	GOALCOL
  06C0'   C9                    	RET
                                
                                ;LNSTRT -- the cursor to the start of its line (WM LINPOSB + PUTCUR).
  06C1'                         LNSTRT:
  06C1'   CD 0DBB'              	CALL	ZSAVE
  06C4'   21 0000               	LXI	H,0
  06C7'   CD 0000*              	CALL	LINPSB		; HL = the cursor line's start
  06CA'   E5                    	PUSH	H
  06CB'   CD 0DCE'              	CALL	ZREST
  06CE'   E1                    	POP	H
  06CF'   C3 0000*              	JMP	PUTCUR
                                
                                ;VC_CRT -- '^': first non-blank of the line (the count is ignored, as vim's).
  06D2'                         VC_CRT:
  06D2'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  06D5'   C3 06D8'              	JMP	FNBLNK
                                
                                ;FNBLNK -- the cursor to the first non-blank of its line, as vim's beginline
                                ; (BL_WHITE | BL_FIX): skip spaces/TABs, but stay on the last one when the line
                                ; ends after it.  The line is read with WM's RGET (paged in as it goes), then
                                ; the goal column is taken from the landing.  Shared by '^', <CR>, G/gg, the
                                ; scrolls, H/M/L and dd.
  06D8'                         FNBLNK:
  06D8'   CD 06C1'              	CALL	LNSTRT
  06DB'   CD 0000*              	CALL	RGET0
  06DE'   11 0000               	LXI	D,0		; DE = blanks skipped
  06E1'                         FN_LP:
  06E1'   CD 0000*              	CALL	RDGET
  06E4'   DA 0707'              	JC	FN_GO		; the end of the file
  06E7'   FE 20                 	CPI	' '
  06E9'   CA 06F1'              	JZ	FN_WH
  06EC'   FE 09                 	CPI	TAB
  06EE'   C2 0707'              	JNZ	FN_GO		; a non-blank, or the line's end
  06F1'                         FN_WH:
  06F1'   CD 0000*              	CALL	RDGET		; a blank: stay on it when the line ends next
  06F4'   DA 0707'              	JC	FN_GO
  06F7'   FE 0D                 	CPI	CR
  06F9'   CA 0707'              	JZ	FN_GO
  06FC'   FE 0A                 	CPI	LF
  06FE'   CA 0707'              	JZ	FN_GO
  0701'   2B                    	DCX	H		; not yet: read that char again
  0702'   03                    	INX	B
  0703'   13                    	INX	D
  0704'   C3 06E1'              	JMP	FN_LP
  0707'                         FN_GO:
  0707'   D5                    	PUSH	D
  0708'   CD 0000*              	CALL	CUROFF
	MACRO-80 3.44	09-Dec-81	PAGE	1-27


  070B'   D1                    	POP	D
  070C'   19                    	DAD	D
  070D'   C3 048C'              	JMP	GOSET
                                
                                ;VC_EOL -- '$': the last char of the line, count-1 lines down first (vim's
                                ; cursor_down + coladvance(MAXCOL)): the goal becomes the line end, and on the
                                ; last line a count > 1 moves nothing.
  0710'                         VC_EOL:
  0710'   CD 060A'              	CALL	SETMOV
  0713'   21 FFFF               	LXI	H,0FFFFH
  0716'   22 23E7'              	SHLD	GOALCOL
  0719'   CD 059D'              	CALL	GETCNT
  071C'   2B                    	DCX	H		; count-1
  071D'   7C                    	MOV	A,H
  071E'   B5                    	ORA	L
  071F'   CA 072E'              	JZ	VEOL_0
  0722'   E5                    	PUSH	H
  0723'   CD 0743'              	CALL	ONLAST
  0726'   E1                    	POP	H
  0727'   D8                    	RC			; the last line: no move (vim)
  0728'   CD 0786'              	CALL	JCORE
  072B'   C3 08D5'              	JMP	JKLAND
  072E'                         VEOL_0:
  072E'   CD 06C1'              	CALL	LNSTRT
  0731'   C3 08D5'              	JMP	JKLAND
                                
                                ;VC_CR -- <CR>: count lines down to the first non-blank (vim's nv_down with
                                ; beginline); on the last line nothing moves.
  0734'                         VC_CR:
  0734'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0737'   E5                    	PUSH	H
  0738'   CD 0743'              	CALL	ONLAST
  073B'   E1                    	POP	H
  073C'   D8                    	RC
  073D'   CD 0786'              	CALL	JCORE
  0740'   C3 06D8'              	JMP	FNBLNK
                                
                                ;ONLAST -- CY iff no line follows the cursor's (read ahead with WM's RGET).
  0743'                         ONLAST:
  0743'   CD 0000*              	CALL	RGET0
  0746'                         OL_LP:
  0746'   CD 0000*              	CALL	RDGET
  0749'   D8                    	RC			; the file ends on this line
  074A'   FE 0A                 	CPI	LF
  074C'   C2 0746'              	JNZ	OL_LP
  074F'   C3 0000*              	JMP	RDGET		; CY iff nothing follows its LF
                                
                                ;============================================================
                                ; MOTIONS -- vertical (j/k keep the goal column)
                                ;
                                ; A line move is ONE WM paging line move (MVLIND / SETBWD), as WM's nL moves
                                ; lines: the window pages with the cursor.  The screen needs to know how many
                                ; lines the cursor went (LNDLT), so JCORE/KCORE first count them over a short
                                ; scan -- at most two screens; past that the exact number does not matter to
                                ; the screen (the cursor lands on the bottom/top row and it repaints).
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-28


                                
                                ;VC_J -- down count lines, clamped at the last line.
  0752'                         VC_J:
  0752'   CD 060A'              	CALL	SETMOV
  0755'   CD 0770'              	CALL	GLCHK		; the goal column, from the cursor if stale
  0758'   CD 059D'              	CALL	GETCNT		; HL = count
  075B'   CD 0786'              	CALL	JCORE
  075E'   C3 08D5'              	JMP	JKLAND
                                
                                ;VC_K -- up count lines, clamped at the first line.
  0761'                         VC_K:
  0761'   CD 060A'              	CALL	SETMOV
  0764'   CD 0770'              	CALL	GLCHK
  0767'   CD 059D'              	CALL	GETCNT
  076A'   CD 0823'              	CALL	KCORE
  076D'   C3 08D5'              	JMP	JKLAND
                                
                                ;GLCHK -- GOALCOL 0FFFEH (stale: the file was just opened, or an edit moved
                                ; the cursor) -> take it from the cursor now, as vim's w_set_curswant does.
  0770'                         GLCHK:
  0770'   2A 23E7'              	LHLD	GOALCOL
  0773'   7C                    	MOV	A,H
  0774'   3C                    	INR	A
  0775'   C0                    	RNZ
  0776'   7D                    	MOV	A,L
  0777'   FE FE                 	CPI	0FEH
  0779'   C0                    	RNZ
  077A'   C3 048F'              	JMP	SETGL
                                
                                ;GLSTAL -- mark the goal column stale (see GLCHK).  Keeps BC, DE.
  077D'                         GLSTAL:
  077D'   E5                    	PUSH	H
  077E'   21 FFFE               	LXI	H,0FFFEH
  0781'   22 23E7'              	SHLD	GOALCOL
  0784'   E1                    	POP	H
  0785'   C9                    	RET
                                
                                ;JCORE -- HL = count: cursor to the start of the line count below (of the last
                                ; line when the file ends first); LNDLT += the lines moved.
  0786'                         JCORE:
  0786'   7C                    	MOV	A,H
  0787'   B5                    	ORA	L
  0788'   C8                    	RZ
  0789'   22 23ED'              	SHLD	JKCNT
  078C'   CD 0B9C'              	CALL	CURRW		; limit = rows under the cursor's + NEDIT
  078F'   47                    	MOV	B,A
  0790'   3A 0000*              	LDA	NEDIT
  0793'   3D                    	DCR	A
  0794'   90                    	SUB	B
  0795'   5F                    	MOV	E,A
  0796'   16 00                 	MVI	D,0
  0798'   3A 0000*              	LDA	NEDIT
  079B'   6F                    	MOV	L,A
  079C'   26 00                 	MVI	H,0
  079E'   19                    	DAD	D
  079F'   EB                    	XCHG			; DE = limit
	MACRO-80 3.44	09-Dec-81	PAGE	1-29


  07A0'   2A 23ED'              	LHLD	JKCNT
  07A3'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  07A6'   D2 07AA'              	JNC	JC_N
  07A9'   EB                    	XCHG			; HL = limit
  07AA'                         JC_N:
  07AA'   22 23EF'              	SHLD	JKN		; N = min(count, limit)
  07AD'   EB                    	XCHG			; DE = LFs to find
  07AE'   CD 0000*              	CALL	RGET0
  07B1'                         JC_SC:
  07B1'   CD 0000*              	CALL	RDGET		; (pages in on demand; keeps DE)
  07B4'   DA 07D3'              	JC	JC_EOF
  07B7'   32 23F6'              	STA	JKLST
  07BA'   FE 0A                 	CPI	LF
  07BC'   C2 07B1'              	JNZ	JC_SC
  07BF'   1B                    	DCX	D
  07C0'   7A                    	MOV	A,D
  07C1'   B3                    	ORA	E
  07C2'   C2 07B1'              	JNZ	JC_SC
  07C5'   2A 23ED'              	LHLD	JKCNT		; N lines follow: the move is count lines, less
  07C8'   22 23F1'              	SHLD	JKMOV		;   one if the last LF found ends the file
  07CB'   3E 01                 	MVI	A,1
  07CD'   32 23F5'              	STA	JKPHN
  07D0'   C3 07EE'              	JMP	JC_MV
  07D3'                         JC_EOF:
  07D3'   2A 23EF'              	LHLD	JKN		; the file ends first: LFs found, less a final LF
  07D6'   CD 0000*              	CALL	SUBHD		; HL = N - LFs still wanted
  07D9'   7C                    	MOV	A,H
  07DA'   B5                    	ORA	L
  07DB'   CA 07E7'              	JZ	JC_AV
  07DE'   3A 23F6'              	LDA	JKLST
  07E1'   FE 0A                 	CPI	LF
  07E3'   C2 07E7'              	JNZ	JC_AV
  07E6'   2B                    	DCX	H
  07E7'                         JC_AV:
  07E7'   22 23F1'              	SHLD	JKMOV
  07EA'   AF                    	XRA	A
  07EB'   32 23F5'              	STA	JKPHN
  07EE'                         JC_MV:
  07EE'   2A 23ED'              	LHLD	JKCNT
  07F1'   AF                    	XRA	A
  07F2'   CD 0000*              	CALL	MVLIND		; WM line move: start of the line count below
  07F5'   CD 08B4'              	CALL	ATEOF
  07F8'   D2 080C'              	JNC	JC_DN
  07FB'   CD 08BA'              	CALL	LASTLN		; ran past the last line: back onto it
  07FE'   3A 23F5'              	LDA	JKPHN
  0801'   B7                    	ORA	A
  0802'   CA 080C'              	JZ	JC_DN
  0805'   2A 23F1'              	LHLD	JKMOV
  0808'   2B                    	DCX	H
  0809'   22 23F1'              	SHLD	JKMOV
  080C'                         JC_DN:
  080C'   2A 23EF'              	LHLD	JKN		; LNDLT += min(moved, N)
  080F'   EB                    	XCHG
  0810'   2A 23F1'              	LHLD	JKMOV
  0813'   CD 0000*              	CALL	CMP16		; CY iff N < moved
  0816'   D2 081A'              	JNC	JC_AD
	MACRO-80 3.44	09-Dec-81	PAGE	1-30


  0819'   EB                    	XCHG
  081A'                         JC_AD:
  081A'   EB                    	XCHG			; DE = lines moved
  081B'   2A 0000*              	LHLD	LNDLT
  081E'   19                    	DAD	D
  081F'   22 0000*              	SHLD	LNDLT
  0822'   C9                    	RET
                                
                                ;KCORE -- HL = count: cursor to the start of the line count above (of the first
                                ; line when the file starts first); LNDLT -= the lines moved.
  0823'                         KCORE:
  0823'   7C                    	MOV	A,H
  0824'   B5                    	ORA	L
  0825'   C8                    	RZ
  0826'   22 23ED'              	SHLD	JKCNT
  0829'   CD 0B9C'              	CALL	CURRW		; limit = row + NEDIT
  082C'   5F                    	MOV	E,A
  082D'   16 00                 	MVI	D,0
  082F'   3A 0000*              	LDA	NEDIT
  0832'   6F                    	MOV	L,A
  0833'   26 00                 	MVI	H,0
  0835'   19                    	DAD	D
  0836'   EB                    	XCHG			; DE = limit
  0837'   2A 23ED'              	LHLD	JKCNT
  083A'   CD 0000*              	CALL	CMP16		; CY iff limit < count
  083D'   D2 0841'              	JNC	KC_N
  0840'   EB                    	XCHG			; HL = limit
  0841'                         KC_N:
  0841'   22 23EF'              	SHLD	JKN		; N = min(count, limit)
  0844'   EB                    	XCHG			; DE = LFs to find
  0845'   21 0000               	LXI	H,0
  0848'   22 23F3'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  084B'                         KC_ED:
  084B'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  084C'   2A 23F3'              	LHLD	JKBK
  084F'   CD 0596'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  0852'   E5                    	PUSH	H
  0853'   EB                    	XCHG
  0854'   2A 0000*              	LHLD	TXTBEG
  0857'   EB                    	XCHG
  0858'   CD 0000*              	CALL	SUBHD
  085B'   44                    	MOV	B,H
  085C'   4D                    	MOV	C,L
  085D'   E1                    	POP	H
  085E'   D1                    	POP	D
  085F'                         KC_SC:
  085F'   78                    	MOV	A,B
  0860'   B1                    	ORA	C
  0861'   CA 0878'              	JZ	KC_TB
  0864'   2B                    	DCX	H
  0865'   0B                    	DCX	B
  0866'   7E                    	MOV	A,M
  0867'   FE 0A                 	CPI	LF
  0869'   C2 085F'              	JNZ	KC_SC
  086C'   1B                    	DCX	D
  086D'   7A                    	MOV	A,D
	MACRO-80 3.44	09-Dec-81	PAGE	1-31


  086E'   B3                    	ORA	E
  086F'   C2 085F'              	JNZ	KC_SC
  0872'   2A 23ED'              	LHLD	JKCNT		; N lines above: the move is count lines
  0875'   C3 0898'              	JMP	KC_MV
  0878'                         KC_TB:
  0878'   D5                    	PUSH	D		; at TXTBEG: page back, or the file starts here
  0879'   CD 0596'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  087C'   22 23F3'              	SHLD	JKBK
  087F'   2A 0000*              	LHLD	OUTPOS		; records before TXTBEG?
  0882'   7C                    	MOV	A,H
  0883'   B5                    	ORA	L
  0884'   CA 0891'              	JZ	KC_B0
  0887'   CD 0000*              	CALL	REWIND		; read them back (the text may move; JKBK holds)
  088A'   D1                    	POP	D
  088B'   DA 0892'              	JC	KC_BOF
  088E'   C3 084B'              	JMP	KC_ED
  0891'                         KC_B0:
  0891'   D1                    	POP	D
  0892'                         KC_BOF:
  0892'   2A 23EF'              	LHLD	JKN		; moved = LFs found
  0895'   CD 0000*              	CALL	SUBHD
  0898'                         KC_MV:
  0898'   E5                    	PUSH	H
  0899'   2A 23ED'              	LHLD	JKCNT
  089C'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  089F'   D1                    	POP	D		; DE = moved
  08A0'   2A 23EF'              	LHLD	JKN
  08A3'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  08A6'   DA 08AA'              	JC	KC_AD
  08A9'   EB                    	XCHG			; DE = N
  08AA'                         KC_AD:
  08AA'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  08AD'   CD 0000*              	CALL	SUBHD
  08B0'   22 0000*              	SHLD	LNDLT
  08B3'   C9                    	RET
                                
                                ;ATEOF -- CY iff nothing follows the cursor (end of the file).  RGET pages in
                                ; what is still on disk; RDGET also catches the stale-INRDY empty refill.
  08B4'                         ATEOF:
  08B4'   CD 0000*              	CALL	RGET0
  08B7'   C3 0000*              	JMP	RDGET
                                
                                ;LASTLN -- cursor at end of file -> start of the last line: back 1 line when
                                ; the file ends in LF (the cursor sits past it), else back 0 (this line).
  08BA'                         LASTLN:
  08BA'   2A 0000*              	LHLD	GAPBEG
  08BD'   EB                    	XCHG
  08BE'   2A 0000*              	LHLD	TXTBEG
  08C1'   CD 0000*              	CALL	CMP16
  08C4'   21 0000               	LXI	H,0
  08C7'   CA 0000*              	JZ	SETBWD		; nothing before the cursor
  08CA'   1B                    	DCX	D
  08CB'   1A                    	LDAX	D
  08CC'   FE 0A                 	CPI	LF
  08CE'   C2 0000*              	JNZ	SETBWD
  08D1'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-32


  08D2'   C3 0000*              	JMP	SETBWD
                                
                                ;JKLAND -- cursor at a line start: step onto the char whose screen columns hold
                                ; GOALCOL, or the line's last content char when the line is shorter (as vim's
                                ; coladvance; GOALCOL 0FFFFH = the last char).  A CR takes no column, so it is
                                ; never landed on.  The line is read with RGET, so a line running off the end
                                ; of the window is paged in, and only up to the goal.
  08D5'                         JKLAND:
  08D5'   21 0000               	LXI	H,0
  08D8'   22 23F7'              	SHLD	JKVC		; screen column
  08DB'   2B                    	DCX	H
  08DC'   22 23F9'              	SHLD	JKLS		; last content char: none yet
  08DF'   CD 0000*              	CALL	RGET0
  08E2'   11 0000               	LXI	D,0		; DE = chars read
  08E5'                         JL_RD:
  08E5'   CD 0000*              	CALL	RDGET
  08E8'   DA 0922'              	JC	JL_END
  08EB'   FE 0A                 	CPI	LF
  08ED'   CA 0922'              	JZ	JL_END
  08F0'   E5                    	PUSH	H
  08F1'   C5                    	PUSH	B
  08F2'   2A 23F7'              	LHLD	JKVC
  08F5'   CD 04E3'              	CALL	CWID
  08F8'   B7                    	ORA	A
  08F9'   CA 091C'              	JZ	JL_NX		; a CR
  08FC'   EB                    	XCHG
  08FD'   22 23F9'              	SHLD	JKLS		; the last content char so far
  0900'   EB                    	XCHG
  0901'   4F                    	MOV	C,A
  0902'   06 00                 	MVI	B,0
  0904'   09                    	DAD	B		; HL = the column after this char
  0905'   22 23F7'              	SHLD	JKVC
  0908'   D5                    	PUSH	D
  0909'   EB                    	XCHG
  090A'   2A 23E7'              	LHLD	GOALCOL
  090D'   CD 0000*              	CALL	CMP16		; CY iff after < goal, Z iff after == goal
  0910'   D1                    	POP	D
  0911'   DA 091C'              	JC	JL_NX
  0914'   CA 091C'              	JZ	JL_NX
  0917'   C1                    	POP	B		; this char holds the goal column
  0918'   E1                    	POP	H
  0919'   C3 092D'              	JMP	JL_GO
  091C'                         JL_NX:
  091C'   C1                    	POP	B
  091D'   E1                    	POP	H
  091E'   13                    	INX	D
  091F'   C3 08E5'              	JMP	JL_RD
  0922'                         JL_END:
  0922'   2A 23F9'              	LHLD	JKLS		; past the line's end: its last content char
  0925'   7C                    	MOV	A,H
  0926'   A5                    	ANA	L
  0927'   3C                    	INR	A
  0928'   C2 092C'              	JNZ	JL_LS
  092B'   23                    	INX	H		; no content: the line's start
  092C'                         JL_LS:
  092C'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-33


  092D'                         JL_GO:
  092D'   D5                    	PUSH	D		; DE = step from the line start
  092E'   CD 0000*              	CALL	CUROFF
  0931'   D1                    	POP	D
  0932'   19                    	DAD	D
  0933'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  0936'   AF                    VC_W:	XRA	A
  0937'   32 23E9'              	STA	WBIG
  093A'   C3 0942'              	JMP	WDO
  093D'   3E 01                 VCBGW:	MVI	A,1
  093F'   32 23E9'              	STA	WBIG
  0942'   CD 060A'              WDO:	CALL	SETMOV
  0945'   AF                    	XRA	A
  0946'   32 23EA'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  0949'   CD 059D'              	CALL	GETCNT
  094C'   22 2415'              	SHLD	CNTV
  094F'   2A 2415'              WDO_LP: LHLD	CNTV
  0952'   7C                    	MOV	A,H
  0953'   B5                    	ORA	L
  0954'   CA 0961'              	JZ	WDO_DN
  0957'   2B                    	DCX	H
  0958'   22 2415'              	SHLD	CNTV
  095B'   CD 09B1'              	CALL	FWD1
  095E'   D2 094F'              	JNC	WDO_LP
  0961'                         WDO_DN:
  0961'   CD 08B4'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  0964'   DA 0971'              	JC	WDO_NL
  0967'   FE 0D                 	CPI	CR
  0969'   CA 0971'              	JZ	WDO_NL
  096C'   FE 0A                 	CPI	LF
  096E'   C2 048F'              	JNZ	SETGL
  0971'                         WDO_NL:
  0971'   CD 0000*              	CALL	PEEKL
  0974'   DA 048F'              	JC	SETGL
  0977'   FE 0A                 	CPI	LF
  0979'   CA 048F'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  097C'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  097E'   32 23EA'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  0981'   CD 0AAC'              	CALL	DECC		; back onto its last char
  0984'   C3 048F'              	JMP	SETGL
                                
  0987'   AF                    VC_B:	XRA	A
  0988'   32 23E9'              	STA	WBIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-34


  098B'   C3 0993'              	JMP	BDO
  098E'   3E 01                 VCBGB:	MVI	A,1
  0990'   32 23E9'              	STA	WBIG
  0993'   CD 060A'              BDO:	CALL	SETMOV
  0996'   CD 059D'              	CALL	GETCNT
  0999'   22 2415'              	SHLD	CNTV
  099C'   2A 2415'              BDO_LP: LHLD	CNTV
  099F'   7C                    	MOV	A,H
  09A0'   B5                    	ORA	L
  09A1'   CA 048F'              	JZ	SETGL
  09A4'   2B                    	DCX	H
  09A5'   22 2415'              	SHLD	CNTV
  09A8'   CD 09FD'              	CALL	BCK1
  09AB'   D2 099C'              	JNC	BDO_LP
  09AE'   C3 048F'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  09B1'                         FWD1:
  09B1'   CD 0A30'              	CALL	CCLS
  09B4'   32 2421'              	STA	WKCLS		; the starting class
  09B7'   CD 0A6A'              	CALL	INCC
  09BA'   B7                    	ORA	A
  09BB'   CA 09D3'              	JZ	FW_WD
  09BE'   37                    	STC
  09BF'   F8                    	RM			; -1: already at the end
  09C0'   FE 02                 	CPI	2
  09C2'   C2 09D3'              	JNZ	FW_WD		; 1: a next line was reached
  09C5'   CD 08B4'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  09C8'   D4 0A51'              	CNC	NXLN
  09CB'   D2 09D3'              	JNC	FW_WD
  09CE'   CD 0AAC'              	CALL	DECC		; yes: back onto its last char, failed
  09D1'   37                    	STC
  09D2'   C9                    	RET
  09D3'                         FW_WD:
  09D3'   3A 2421'              	LDA	WKCLS		; go past the rest of this word
  09D6'   B7                    	ORA	A
  09D7'   CA 09EC'              	JZ	FW_WS
  09DA'                         FW_WLP:
  09DA'   CD 0A30'              	CALL	CCLS
  09DD'   21 2421'              	LXI	H,WKCLS
  09E0'   BE                    	CMP	M
  09E1'   C2 09EC'              	JNZ	FW_WS
  09E4'   CD 0A6A'              	CALL	INCC
  09E7'   B7                    	ORA	A
  09E8'   F8                    	RM			; the end of the file (NC)
  09E9'   C3 09DA'              	JMP	FW_WLP
  09EC'                         FW_WS:
  09EC'   CD 0A30'              	CALL	CCLS		; then over blanks to the next word
  09EF'   B7                    	ORA	A
  09F0'   C0                    	RNZ
  09F1'   CD 0A38'              	CALL	EMPTY
  09F4'   C8                    	RZ			; an empty line is a word
  09F5'   CD 0A6A'              	CALL	INCC
  09F8'   B7                    	ORA	A
  09F9'   F8                    	RM
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09FA'   C3 09EC'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  09FD'                         BCK1:
  09FD'   CD 0AAC'              	CALL	DECC
  0A00'   B7                    	ORA	A
  0A01'   37                    	STC
  0A02'   F8                    	RM
  0A03'                         BK_WS:
  0A03'   CD 0A30'              	CALL	CCLS		; back over blanks
  0A06'   B7                    	ORA	A
  0A07'   C2 0A17'              	JNZ	BK_WD
  0A0A'   CD 0A38'              	CALL	EMPTY
  0A0D'   C8                    	RZ			; an empty line is a word
  0A0E'   CD 0AAC'              	CALL	DECC
  0A11'   B7                    	ORA	A
  0A12'   F2 0A03'              	JP	BK_WS
  0A15'   AF                    	XRA	A		; the start of the file (NC)
  0A16'   C9                    	RET
  0A17'                         BK_WD:
  0A17'   32 2421'              	STA	WKCLS		; back to the start of this word
  0A1A'                         BK_WLP:
  0A1A'   CD 0AAC'              	CALL	DECC
  0A1D'   B7                    	ORA	A
  0A1E'   FA 0A2E'              	JM	BK_OK		; the start of the file
  0A21'   CD 0A30'              	CALL	CCLS
  0A24'   21 2421'              	LXI	H,WKCLS
  0A27'   BE                    	CMP	M
  0A28'   CA 0A1A'              	JZ	BK_WLP
  0A2B'   CD 0A6A'              	CALL	INCC		; overshot: forward one
  0A2E'                         BK_OK:
  0A2E'   AF                    	XRA	A
  0A2F'   C9                    	RET
                                
                                ;CCLS -- A = the class of the char under the cursor (a line's end is blank).
  0A30'                         CCLS:
  0A30'   CD 08B4'              	CALL	ATEOF
  0A33'   D2 05BF'              	JNC	CLASSF
  0A36'   AF                    	XRA	A
  0A37'   C9                    	RET
                                
                                ;EMPTY -- Z iff the cursor is on an empty line (on a line's end at its start).
  0A38'                         EMPTY:
  0A38'   CD 08B4'              	CALL	ATEOF
  0A3B'   DA 0A46'              	JC	EM_ST
  0A3E'   FE 0D                 	CPI	CR
  0A40'   CA 0A46'              	JZ	EM_ST
  0A43'   FE 0A                 	CPI	LF
  0A45'   C0                    	RNZ
  0A46'                         EM_ST:
  0A46'   CD 0000*              	CALL	PEEKL
  0A49'   DA 0A4F'              	JC	EM_Y
  0A4C'   FE 0A                 	CPI	LF
  0A4E'   C9                    	RET
  0A4F'                         EM_Y:
  0A4F'   AF                    	XRA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A50'   C9                    	RET
                                
                                ;NXLN -- cursor on a line's end (A = its CR or LF; HL, BC as RGET left them):
                                ; HL = the next line's start, A = 1; CY if there is none.  A CR not before a LF
                                ; is not a line's end: HL = the char after it, A = 0.
  0A51'                         NXLN:
  0A51'   FE 0A                 	CPI	LF
  0A53'   CA 0A62'              	JZ	NX_LF
  0A56'   CD 0000*              	CALL	RDGET		; a CR: its LF
  0A59'   D8                    	RC
  0A5A'   FE 0A                 	CPI	LF
  0A5C'   CA 0A62'              	JZ	NX_LF
  0A5F'   2B                    	DCX	H		; a lone CR
  0A60'   AF                    	XRA	A
  0A61'   C9                    	RET
  0A62'                         NX_LF:
  0A62'   CD 0000*              	CALL	RDGET		; CY iff nothing follows the LF
  0A65'   D8                    	RC
  0A66'   2B                    	DCX	H
  0A67'   3E 01                 	MVI	A,1
  0A69'   C9                    	RET
                                
                                ;INCC -- vim inc_cursor: A = 0 (the cursor went a char right, onto a char),
                                ; 2 (onto its line's end), 1 (to the next line's start) or FFH (at the end of
                                ; the file: no move).
  0A6A'                         INCC:
  0A6A'   CD 08B4'              	CALL	ATEOF
  0A6D'   DA 0AA8'              	JC	IC_END
  0A70'   FE 0D                 	CPI	CR
  0A72'   CA 0A93'              	JZ	IC_NL
  0A75'   FE 0A                 	CPI	LF
  0A77'   CA 0A93'              	JZ	IC_NL
  0A7A'   CD 0000*              	CALL	PUTCUR		; HL = past the char
  0A7D'                         IC_CH:
  0A7D'   CD 08B4'              	CALL	ATEOF
  0A80'   DA 0A8F'              	JC	IC_2
  0A83'   FE 0D                 	CPI	CR
  0A85'   CA 0A8F'              	JZ	IC_2
  0A88'   FE 0A                 	CPI	LF
  0A8A'   CA 0A8F'              	JZ	IC_2
  0A8D'   AF                    	XRA	A
  0A8E'   C9                    	RET
  0A8F'                         IC_2:
  0A8F'   3E 02                 	MVI	A,2
  0A91'   B7                    	ORA	A
  0A92'   C9                    	RET
  0A93'                         IC_NL:
  0A93'   CD 0A51'              	CALL	NXLN
  0A96'   DA 0AA8'              	JC	IC_END
  0A99'   F5                    	PUSH	PSW
  0A9A'   CD 0000*              	CALL	PUTCUR
  0A9D'   F1                    	POP	PSW
  0A9E'   B7                    	ORA	A
  0A9F'   CA 0A7D'              	JZ	IC_CH		; a lone CR: stepped over as a char
  0AA2'   CD 0ACE'              	CALL	LNINC
  0AA5'   3E 01                 	MVI	A,1
	MACRO-80 3.44	09-Dec-81	PAGE	1-37


  0AA7'   C9                    	RET
  0AA8'                         IC_END:
  0AA8'   3E FF                 	MVI	A,0FFH
  0AAA'   B7                    	ORA	A
  0AAB'   C9                    	RET
                                
                                ;DECC -- vim dec_cursor: A = 0 (a char left), 1 (back to the previous line's
                                ; end) or FFH (at the start of the file: no move).  WM ^A's step: PEEKL, PUTCUR.
  0AAC'                         DECC:
  0AAC'   CD 0000*              	CALL	PEEKL
  0AAF'   DA 0AA8'              	JC	IC_END
  0AB2'   F5                    	PUSH	PSW
  0AB3'   CD 0000*              	CALL	PUTCUR
  0AB6'   F1                    	POP	PSW
  0AB7'   FE 0A                 	CPI	LF
  0AB9'   3E 00                 	MVI	A,0
  0ABB'   C0                    	RNZ
  0ABC'   CD 0ADC'              	CALL	LNDEC
  0ABF'   CD 0000*              	CALL	PEEKL		; onto its CR
  0AC2'   DA 0ACA'              	JC	DC_1
  0AC5'   FE 0D                 	CPI	CR
  0AC7'   CC 0000*              	CZ	PUTCUR
  0ACA'                         DC_1:
  0ACA'   3E 01                 	MVI	A,1
  0ACC'   B7                    	ORA	A
  0ACD'   C9                    	RET
                                
                                ;LNINC / LNDEC -- the cursor crossed a LF: LNDLT +/- 1, held short of the sign
                                ; (a count through a file of empty lines).  Keep all but A.
  0ACE'                         LNINC:
  0ACE'   E5                    	PUSH	H
  0ACF'   2A 0000*              	LHLD	LNDLT
  0AD2'   7C                    	MOV	A,H
  0AD3'   FE 40                 	CPI	40H
  0AD5'   CA 0AEA'              	JZ	LN_X
  0AD8'   23                    	INX	H
  0AD9'   C3 0AE7'              	JMP	LN_ST
  0ADC'                         LNDEC:
  0ADC'   E5                    	PUSH	H
  0ADD'   2A 0000*              	LHLD	LNDLT
  0AE0'   7C                    	MOV	A,H
  0AE1'   FE C0                 	CPI	0C0H
  0AE3'   CA 0AEA'              	JZ	LN_X
  0AE6'   2B                    	DCX	H
  0AE7'                         LN_ST:
  0AE7'   22 0000*              	SHLD	LNDLT
  0AEA'                         LN_X:
  0AEA'   E1                    	POP	H
  0AEB'   C9                    	RET
                                
  0AEC'   AF                    VC_E:	XRA	A
  0AED'   32 23E9'              	STA	WBIG
  0AF0'   C3 0AF8'              	JMP	EDO
  0AF3'   3E 01                 VCBGE:	MVI	A,1
  0AF5'   32 23E9'              	STA	WBIG
  0AF8'   CD 060A'              EDO:	CALL	SETMOV
	MACRO-80 3.44	09-Dec-81	PAGE	1-38


  0AFB'   CD 059D'              	CALL	GETCNT
  0AFE'   22 2415'              	SHLD	CNTV
  0B01'   2A 2415'              EDO_LP: LHLD	CNTV
  0B04'   7C                    	MOV	A,H
  0B05'   B5                    	ORA	L
  0B06'   C8                    	RZ
  0B07'   2B                    	DCX	H
  0B08'   22 2415'              	SHLD	CNTV
  0B0B'   CD 0B11'              	CALL	ESTEP
  0B0E'   C3 0B01'              	JMP	EDO_LP
                                
                                ;ESTEP -- forward to the end of the next word.
  0B11'                         ESTEP:
  0B11'   CD 0000*              	CALL	CUROFF
  0B14'   22 2419'              	SHLD	WKI
  0B17'   CD 0000*              	CALL	LOGLEN
  0B1A'   22 241B'              	SHLD	WKN
  0B1D'   2A 2419'              	LHLD	WKI
  0B20'   23                    	INX	H
  0B21'   22 2419'              	SHLD	WKI
  0B24'                         ES_WS:
  0B24'   2A 2419'              	LHLD	WKI
  0B27'   EB                    	XCHG
  0B28'   2A 241B'              	LHLD	WKN
  0B2B'   CD 0000*              	CALL	CMP16
  0B2E'   D2 0B7C'              	JNC	ES_LND
  0B31'   2A 2419'              	LHLD	WKI
  0B34'   CD 0000*              	CALL	CHARAT
  0B37'   CD 05BF'              	CALL	CLASSF
  0B3A'   B7                    	ORA	A
  0B3B'   C2 0B48'              	JNZ	ES_WD
  0B3E'   2A 2419'              	LHLD	WKI
  0B41'   23                    	INX	H
  0B42'   22 2419'              	SHLD	WKI
  0B45'   C3 0B24'              	JMP	ES_WS
  0B48'                         ES_WD:
  0B48'   2A 2419'              	LHLD	WKI
  0B4B'   CD 0000*              	CALL	CHARAT
  0B4E'   CD 05BF'              	CALL	CLASSF
  0B51'   32 2421'              	STA	WKCLS
  0B54'                         ES_RUN:
  0B54'   2A 2419'              	LHLD	WKI
  0B57'   23                    	INX	H
  0B58'   EB                    	XCHG			; DE = i+1
  0B59'   2A 241B'              	LHLD	WKN
  0B5C'   CD 0000*              	CALL	CMP16		; DE=(i+1) vs HL=n: CY iff (i+1) < n
  0B5F'   D2 0B7C'              	JNC	ES_LND
  0B62'   2A 2419'              	LHLD	WKI
  0B65'   23                    	INX	H
  0B66'   E5                    	PUSH	H		; i+1
  0B67'   CD 0000*              	CALL	CHARAT
  0B6A'   CD 05BF'              	CALL	CLASSF
  0B6D'   E1                    	POP	H		; HL = i+1
  0B6E'   47                    	MOV	B,A
  0B6F'   3A 2421'              	LDA	WKCLS
  0B72'   B8                    	CMP	B
	MACRO-80 3.44	09-Dec-81	PAGE	1-39


  0B73'   C2 0B7C'              	JNZ	ES_LND
  0B76'   22 2419'              	SHLD	WKI
  0B79'   C3 0B54'              	JMP	ES_RUN
  0B7C'                         ES_LND:
  0B7C'   2A 241B'              	LHLD	WKN
  0B7F'   EB                    	XCHG
  0B80'   2A 2419'              	LHLD	WKI
  0B83'   CD 0000*              	CALL	CMP16		; DE=n vs HL=i: CY iff n < i
  0B86'   DA 0B92'              	JC	ES_CL
  0B89'   CA 0B92'              	JZ	ES_CL
  0B8C'   2A 2419'              	LHLD	WKI
  0B8F'   C3 048C'              	JMP	GOSET
  0B92'                         ES_CL:
  0B92'   2A 241B'              	LHLD	WKN
  0B95'   7C                    	MOV	A,H
  0B96'   B5                    	ORA	L
  0B97'   C8                    	RZ
  0B98'   2B                    	DCX	H
  0B99'   C3 048C'              	JMP	GOSET
                                
                                ;--- e / E stay because OPPEND rewrites a pending "cw"/"cW" to "ce"/"cE"
                                ; and dispatches it through CMDTAB (vi's one operator+motion special case),
                                ; so the change operator needs these two rows even though f F t T ; , % went.
                                
                                ;============================================================
                                ; MOTIONS -- screen-relative (H M L) and scrolls (^F ^B ^D ^U ^L)
                                ;
                                ; These work on the cursor's screen row (CURRW) and the last layout's facts
                                ; from SCRN.MAC: SCBOT (last text row), SCEOF / SCBOF (the file's end / start
                                ; is on the screen).  H/M/L move the cursor to a row.  The scrolls move it and
                                ; name the row it should appear on (SETRWT), so the text scrolls around it;
                                ; WFILL keeps ^D (and G) from running past the end of the file.  ^L just leaves
                                ; RINTENT at its R_FULL default so the next SCDRAW repaints in full.
                                ;============================================================
                                
                                ;CURRW -- A = the cursor line's screen row now: WINROW + LNDLT, clamped to the
                                ; edit rows.  Keeps BC.
  0B9C'                         CURRW:
  0B9C'   2A 0000*              	LHLD	WINROW
  0B9F'   EB                    	XCHG
  0BA0'   2A 0000*              	LHLD	LNDLT
  0BA3'   19                    	DAD	D		; HL = row (signed)
  0BA4'   7C                    	MOV	A,H
  0BA5'   B7                    	ORA	A
  0BA6'   FA 0BB9'              	JM	CRW_0		; above the screen -> top row
  0BA9'   C2 0BB4'              	JNZ	CRW_BT		; far below -> bottom row
  0BAC'   3A 0000*              	LDA	NEDIT
  0BAF'   3D                    	DCR	A		; A = bottom row
  0BB0'   BD                    	CMP	L		; CY iff bottom < row
  0BB1'   D8                    	RC
  0BB2'   7D                    	MOV	A,L
  0BB3'   C9                    	RET
  0BB4'                         CRW_BT:
  0BB4'   3A 0000*              	LDA	NEDIT
  0BB7'   3D                    	DCR	A
  0BB8'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-40


  0BB9'                         CRW_0:
  0BB9'   AF                    	XRA	A
  0BBA'   C9                    	RET
                                
                                ;SETRWT -- A = row: the next layout puts the cursor's line on that row.
  0BBB'                         SETRWT:
  0BBB'   2A 0000*              	LHLD	LNDLT
  0BBE'   EB                    	XCHG
  0BBF'   6F                    	MOV	L,A
  0BC0'   26 00                 	MVI	H,0
  0BC2'   CD 0000*              	CALL	SUBHD		; HL = row - LNDLT
  0BC5'   22 0000*              	SHLD	WINROW
  0BC8'   C9                    	RET
                                
                                ;MVROW -- A = row: cursor to the start of the line on that row (the cursor's
                                ; own row: unmoved -- FNBLNK follows).
  0BC9'                         MVROW:
  0BC9'   47                    	MOV	B,A
  0BCA'   CD 0B9C'              	CALL	CURRW
  0BCD'   90                    	SUB	B		; A = row now - target
  0BCE'   C8                    	RZ
  0BCF'   DA 0BD8'              	JC	MR_DN
  0BD2'   6F                    	MOV	L,A
  0BD3'   26 00                 	MVI	H,0
  0BD5'   C3 0823'              	JMP	KCORE
  0BD8'                         MR_DN:
  0BD8'   2F                    	CMA
  0BD9'   3C                    	INR	A		; A = target - row now
  0BDA'   6F                    	MOV	L,A
  0BDB'   26 00                 	MVI	H,0
  0BDD'   C3 0786'              	JMP	JCORE
                                
                                ;VC_HIGH -- 'H': count'th row from the top (1 = top), not below the last text
                                ; row, then first non-blank.
  0BE0'                         VC_HIGH:
  0BE0'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0BE3'   2B                    	DCX	H		; row = count - 1
  0BE4'   7C                    	MOV	A,H
  0BE5'   B7                    	ORA	A
  0BE6'   3A 0000*              	LDA	SCBOT
  0BE9'   C2 0BF1'              	JNZ	VH_GO		; >= 256 -> the last text row
  0BEC'   BD                    	CMP	L		; CY iff SCBOT < row
  0BED'   DA 0BF1'              	JC	VH_GO
  0BF0'   7D                    	MOV	A,L
  0BF1'                         VH_GO:
  0BF1'   CD 0BC9'              	CALL	MVROW
  0BF4'   C3 06D8'              	JMP	FNBLNK
                                
                                ;VC_MIDL -- 'M': middle of the text rows; count ignored.
  0BF7'                         VC_MIDL:
  0BF7'   CD 058A'              	CALL	MOVCNT		; a cursor motion; the count is discarded
  0BFA'   3A 0000*              	LDA	SCBOT
  0BFD'   B7                    	ORA	A		; clear CY for the shift
  0BFE'   1F                    	RAR			; A = SCBOT / 2
  0BFF'   CD 0BC9'              	CALL	MVROW
  0C02'   C3 06D8'              	JMP	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-41


                                
                                ;VC_LOWL -- 'L': count'th row up from the last text row (1 = that row), not
                                ; above the top row, then first non-blank.
  0C05'                         VC_LOWL:
  0C05'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0C08'   2B                    	DCX	H		; count - 1
  0C09'   3A 0000*              	LDA	SCBOT
  0C0C'   5F                    	MOV	E,A
  0C0D'   16 00                 	MVI	D,0
  0C0F'   EB                    	XCHG			; HL = SCBOT, DE = count-1
  0C10'   CD 0000*              	CALL	CMP16		; CY iff count-1 < SCBOT
  0C13'   3E 00                 	MVI	A,0
  0C15'   D2 0C1C'              	JNC	VL_GO		; at or past the top -> row 0
  0C18'   CD 0000*              	CALL	SUBHD		; HL = SCBOT - (count-1)
  0C1B'   7D                    	MOV	A,L
  0C1C'                         VL_GO:
  0C1C'   CD 0BC9'              	CALL	MVROW
  0C1F'   C3 06D8'              	JMP	FNBLNK
                                
                                ;VC_PGDN -- '^F': the window forward count pages, the cursor on the new top
                                ; line's first non-blank.  vim's pagescroll (NOT WordMaster): a page is NEDIT-2
                                ; lines (2-line overlap), NEDIT once the last line is on the screen; the top
                                ; line stops at the last line ('~' rows below); no-op when it is already there.
  0C22'                         VC_PGDN:
  0C22'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0C25'   3A 0000*              	LDA	SCEOF
  0C28'   B7                    	ORA	A
  0C29'   CA 0C37'              	JZ	VPD_N
  0C2C'   3A 0000*              	LDA	SCBOT		; the last line is on the screen: count*NEDIT
  0C2F'   B7                    	ORA	A		;   lines pass it, so it becomes the top line
  0C30'   C8                    	RZ			; it already is
  0C31'   CD 0BC9'              	CALL	MVROW
  0C34'   C3 0C48'              	JMP	VPD_TP
  0C37'                         VPD_N:
  0C37'   3A 0000*              	LDA	NEDIT
  0C3A'   D6 02                 	SUI	2
  0C3C'   CD 0C90'              	CALL	MULSAT		; HL = count * (NEDIT-2)
  0C3F'   E5                    	PUSH	H
  0C40'   AF                    	XRA	A
  0C41'   CD 0BC9'              	CALL	MVROW		; the top line
  0C44'   E1                    	POP	H
  0C45'   CD 0786'              	CALL	JCORE		; the new top line (the last, if the file ends)
  0C48'                         VPD_TP:
  0C48'   AF                    	XRA	A
  0C49'   CD 0BBB'              	CALL	SETRWT		; to the top row
  0C4C'   C3 06D8'              	JMP	FNBLNK
                                
                                ;VC_PGUP -- '^B': the window back count pages, not above the first line, the
                                ; cursor on the bottom row's line (or the last line), first non-blank.  vim's
                                ; pagescroll (NOT WordMaster): a page is NEDIT-2 lines, NEDIT when the top line
                                ; is the last line, NEDIT-1 when it is the one before (vim's overlap stops at
                                ; the end of the file).  No-op when the first line is already at the top.
  0C4F'                         VC_PGUP:
  0C4F'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  0C52'   3A 0000*              	LDA	SCBOF
  0C55'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-42


  0C56'   C0                    	RNZ
  0C57'   3A 0000*              	LDA	NEDIT
  0C5A'   47                    	MOV	B,A
  0C5B'   3A 0000*              	LDA	SCEOF
  0C5E'   B7                    	ORA	A
  0C5F'   CA 0C70'              	JZ	VPU_2
  0C62'   3A 0000*              	LDA	SCBOT		; the last line's row: 0 -> NEDIT, 1 -> NEDIT-1
  0C65'   FE 02                 	CPI	2
  0C67'   D2 0C70'              	JNC	VPU_2
  0C6A'   2F                    	CMA
  0C6B'   3C                    	INR	A
  0C6C'   80                    	ADD	B
  0C6D'   C3 0C73'              	JMP	VPU_P
  0C70'                         VPU_2:
  0C70'   78                    	MOV	A,B
  0C71'   D6 02                 	SUI	2
  0C73'                         VPU_P:
  0C73'   CD 0C90'              	CALL	MULSAT		; HL = count * page
  0C76'   E5                    	PUSH	H
  0C77'   AF                    	XRA	A
  0C78'   CD 0BC9'              	CALL	MVROW		; the top line
  0C7B'   E1                    	POP	H
  0C7C'   CD 0823'              	CALL	KCORE		; the new top line
  0C7F'   AF                    	XRA	A
  0C80'   CD 0BBB'              	CALL	SETRWT		; on the top row
  0C83'   3A 0000*              	LDA	NEDIT
  0C86'   3D                    	DCR	A
  0C87'   6F                    	MOV	L,A
  0C88'   26 00                 	MVI	H,0
  0C8A'   CD 0786'              	CALL	JCORE		; the bottom row's line
  0C8D'   C3 06D8'              	JMP	FNBLNK
                                
                                ;MULSAT -- HL = HL * A, saturated at 0FFFFH (more lines than any file has).
  0C90'                         MULSAT:
  0C90'   EB                    	XCHG
  0C91'   21 0000               	LXI	H,0
  0C94'   B7                    	ORA	A
  0C95'   C8                    	RZ
  0C96'                         MS_LP:
  0C96'   19                    	DAD	D
  0C97'   DA 0C9F'              	JC	MS_SAT
  0C9A'   3D                    	DCR	A
  0C9B'   C2 0C96'              	JNZ	MS_LP
  0C9E'   C9                    	RET
  0C9F'                         MS_SAT:
  0C9F'   21 FFFF               	LXI	H,0FFFFH
  0CA2'   C9                    	RET
                                
                                ;VC_HFDN -- '^D': cursor and text down HFAMT lines (HFCNT), the cursor
                                ; keeping its row, then its first non-blank; the text stops once the last line
                                ; is on the bottom row, the cursor goes on.  vim's pagescroll (NOT WordMaster).
                                ; On the last line nothing moves, the column included.
  0CA3'                         VC_HFDN:
  0CA3'   CD 060A'              	CALL	SETMOV
  0CA6'   CD 0B9C'              	CALL	CURRW
  0CA9'   32 23EB'              	STA	HFROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-43


  0CAC'   CD 0D1A'              	CALL	HFCNT		; HL = lines
  0CAF'   3A 23EB'              	LDA	HFROW
  0CB2'   47                    	MOV	B,A
  0CB3'   3A 0000*              	LDA	SCEOF
  0CB6'   B7                    	ORA	A
  0CB7'   CA 0CBF'              	JZ	VHD_GO
  0CBA'   3A 0000*              	LDA	SCBOT		; the last line's row
  0CBD'   B8                    	CMP	B
  0CBE'   C8                    	RZ			; the cursor is on it
  0CBF'                         VHD_GO:
  0CBF'   CD 0786'              	CALL	JCORE
  0CC2'   3A 0000*              	LDA	SCEOF
  0CC5'   B7                    	ORA	A
  0CC6'   C2 06D8'              	JNZ	FNBLNK		; the end is on the screen: only the cursor moves
  0CC9'   3A 23EB'              	LDA	HFROW
  0CCC'   CD 0BBB'              	CALL	SETRWT
  0CCF'   3E 01                 	MVI	A,1
  0CD1'   32 0000*              	STA	WFILL		; not past the end of the file
  0CD4'   C3 06D8'              	JMP	FNBLNK
                                
                                ;VC_HFUP -- '^U': cursor and text up HFAMT lines (HFCNT), the cursor keeping
                                ; its row, then its first non-blank; the text stops at the first line, the
                                ; cursor goes on.  vim's pagescroll (NOT WordMaster).  On the first line
                                ; nothing moves, the column included.
  0CD7'                         VC_HFUP:
  0CD7'   CD 060A'              	CALL	SETMOV
  0CDA'   CD 0B9C'              	CALL	CURRW
  0CDD'   32 23EB'              	STA	HFROW
  0CE0'   CD 0D1A'              	CALL	HFCNT		; HL = lines
  0CE3'   CD 0CFA'              	CALL	ONFST
  0CE6'   C8                    	RZ			; the cursor is on the first line
  0CE7'   CD 0823'              	CALL	KCORE
  0CEA'   3A 0000*              	LDA	SCBOF
  0CED'   B7                    	ORA	A
  0CEE'   C2 06D8'              	JNZ	FNBLNK		; the start is on the screen: only the cursor moves
  0CF1'   3A 23EB'              	LDA	HFROW
  0CF4'   CD 0BBB'              	CALL	SETRWT
  0CF7'   C3 06D8'              	JMP	FNBLNK
                                
                                ;ONFST -- Z iff the cursor is on the file's first line: nothing is paged out
                                ; before the text and no LF precedes the cursor (scans back to its line start).
                                ; Keeps HL.
  0CFA'                         ONFST:
  0CFA'   E5                    	PUSH	H
  0CFB'   2A 0000*              	LHLD	OUTPOS
  0CFE'   7C                    	MOV	A,H
  0CFF'   B5                    	ORA	L
  0D00'   C2 0D18'              	JNZ	OF_RET
  0D03'   2A 0000*              	LHLD	TXTBEG
  0D06'   EB                    	XCHG			; DE = TXTBEG
  0D07'   2A 0000*              	LHLD	GAPBEG
  0D0A'                         OF_LP:
  0D0A'   CD 0000*              	CALL	CMP16		; Z iff at the start of the text
  0D0D'   CA 0D18'              	JZ	OF_RET
  0D10'   2B                    	DCX	H
  0D11'   7E                    	MOV	A,M
	MACRO-80 3.44	09-Dec-81	PAGE	1-44


  0D12'   FE 0A                 	CPI	LF
  0D14'   C2 0D0A'              	JNZ	OF_LP
  0D17'   B7                    	ORA	A		; NZ
  0D18'                         OF_RET:
  0D18'   E1                    	POP	H
  0D19'   C9                    	RET
                                
                                ;HFCNT -- HL = the ^D/^U line count.  As vim's 'scroll': a count (at most
                                ; NEDIT) becomes the amount from now on; until one does, it is NEDIT/2.
  0D1A'                         HFCNT:
  0D1A'   2A 23DF'              	LHLD	CMDCNT
  0D1D'   7C                    	MOV	A,H
  0D1E'   B5                    	ORA	L
  0D1F'   CA 0D36'              	JZ	HFC_AM
  0D22'   CD 059D'              	CALL	GETCNT		; HL = count; clears it
  0D25'   3A 0000*              	LDA	NEDIT
  0D28'   5F                    	MOV	E,A
  0D29'   16 00                 	MVI	D,0
  0D2B'   CD 0000*              	CALL	CMP16		; CY iff NEDIT < count
  0D2E'   D2 0D32'              	JNC	HFC_ST
  0D31'   EB                    	XCHG			; HL = NEDIT
  0D32'                         HFC_ST:
  0D32'   7D                    	MOV	A,L
  0D33'   32 23EC'              	STA	HFAMT
  0D36'                         HFC_AM:
  0D36'   3A 23EC'              	LDA	HFAMT
  0D39'   B7                    	ORA	A
  0D3A'   C2 0D47'              	JNZ	HFC_HL
  0D3D'   3A 0000*              	LDA	NEDIT
  0D40'   B7                    	ORA	A
  0D41'   1F                    	RAR
  0D42'   B7                    	ORA	A
  0D43'   C2 0D47'              	JNZ	HFC_HL
  0D46'   3C                    	INR	A		; at least one line
  0D47'                         HFC_HL:
  0D47'   6F                    	MOV	L,A
  0D48'   26 00                 	MVI	H,0
  0D4A'   C9                    	RET
                                
                                ;VC_REDR -- '^L': force a full repaint.  The main loop defaults RINTENT to R_FULL
                                ; before each key, so leaving it untouched (never calling SETMOV) repaints in
                                ; full; just clear any pending count.
  0D4B'                         VC_REDR:
  0D4B'   C3 059D'              	JMP	GETCNT
                                
                                ;============================================================
                                ; MOTIONS -- goto line (G, gg)
                                ;
                                ; The move is WM's paging line move (MVLMAX / MVLIND), so it reaches the true
                                ; line of the whole file, not the resident edge.  Where the line lands on the
                                ; screen is vim's rule (NOT WordMaster), measured on vim 9.1 with a 23-row
                                ; window: a line already on the screen keeps the window; one up to NEDIT/2+1
                                ; lines below it goes on the bottom row, one up to NEDIT/2-2 lines above it on
                                ; the top row; anything farther goes on the middle row, the rows filled from
                                ; above at the end of the file (WFILL) and clamped at its start (LAYOUT).
                                ; GZONE notes the screen's top line before the move, GPLACE measures the
	MACRO-80 3.44	09-Dec-81	PAGE	1-45


                                ; target against it after.  Both count lines with WM's LINPSB / RGET.
                                ;============================================================
                                
                                ;VC_G -- 'G': count -> that line (1-based); no count -> last line.
  0D4E'                         VC_G:
  0D4E'   CD 060A'              	CALL	SETMOV
  0D51'   CD 0DE1'              	CALL	GZONE		; the screen's top line, before the move
  0D54'   2A 23DF'              	LHLD	CMDCNT
  0D57'   7C                    	MOV	A,H
  0D58'   B5                    	ORA	L
  0D59'   C2 0D66'              	JNZ	VG_N
  0D5C'   AF                    	XRA	A		; forward
  0D5D'   CD 0000*              	CALL	MVLMAX		; whole file: cursor to EOF
  0D60'   CD 08BA'              	CALL	LASTLN		; vi G lands on the start of the LAST line
  0D63'   C3 0DF9'              	JMP	GPLACE
  0D66'                         VG_N:
  0D66'   CD 059D'              	CALL	GETCNT		; HL = target line (1-based)
  0D69'                         VG_LN:
  0D69'   CD 0D6F'              	CALL	GOLN
  0D6C'   C3 0DF9'              	JMP	GPLACE
                                
                                ;GOLN -- to the start of line HL (1-based), without G's window placement: the
                                ;substitute walks a range from here and places the screen once, at the end.
  0D6F'                         GOLN:
  0D6F'   2B                    	DCX	H		; lines to move from line 1
  0D70'   E5                    	PUSH	H
  0D71'   3E FF                 	MVI	A,0FFH
  0D73'   CD 0000*              	CALL	MVLMAX		; to BOF
  0D76'   E1                    	POP	H
  0D77'   AF                    	XRA	A
  0D78'   CD 0000*              	CALL	MVLIND		; forward count-1 lines
  0D7B'   CD 08B4'              	CALL	ATEOF
  0D7E'   DC 08BA'              	CC	LASTLN		; past the last line: onto it
  0D81'   C9                    	RET
                                
                                ;VC_LG -- 'g': pending; second 'g' (gg) goes to line count (no count: 1),
                                ; placed as G places it.
  0D82'                         VC_LG:
  0D82'   CD 060A'              	CALL	SETMOV
  0D85'   3A 2407'              	LDA	GSAVE
  0D88'   B7                    	ORA	A
  0D89'   C2 0D92'              	JNZ	VLG_GG		; (never PZ: VICDSP drops every key but 'Z')
  0D8C'   3E 01                 	MVI	A,PG
  0D8E'   32 2406'              	STA	GPEND
  0D91'   C9                    	RET
  0D92'                         VLG_GG:
  0D92'   CD 0DE1'              	CALL	GZONE
  0D95'   CD 059D'              	CALL	GETCNT		; HL = target line (no count: 1)
  0D98'   C3 0D69'              	JMP	VG_LN
                                
                                ;FPOS -- HL = a pointer into the text before the gap -> A:HL = its file
                                ; position (OUTPOS * 128 + HL - TXTBEG).  Keeps BC, DE.
  0D9B'                         FPOS:
  0D9B'   C5                    	PUSH	B
  0D9C'   D5                    	PUSH	D
  0D9D'   EB                    	XCHG
	MACRO-80 3.44	09-Dec-81	PAGE	1-46


  0D9E'   2A 0000*              	LHLD	TXTBEG
  0DA1'   EB                    	XCHG
  0DA2'   CD 0000*              	CALL	SUBHD		; HL = bytes from TXTBEG
  0DA5'   EB                    	XCHG			; DE = that
  0DA6'   2A 0000*              	LHLD	OUTPOS
  0DA9'   7C                    	MOV	A,H
  0DAA'   B7                    	ORA	A		; CY = 0
  0DAB'   1F                    	RAR
  0DAC'   47                    	MOV	B,A
  0DAD'   7D                    	MOV	A,L
  0DAE'   1F                    	RAR
  0DAF'   67                    	MOV	H,A
  0DB0'   3E 00                 	MVI	A,0
  0DB2'   1F                    	RAR
  0DB3'   6F                    	MOV	L,A		; B:HL = OUTPOS * 128
  0DB4'   19                    	DAD	D
  0DB5'   78                    	MOV	A,B
  0DB6'   CE 00                 	ACI	0		; A:HL = the position
  0DB8'   D1                    	POP	D
  0DB9'   C1                    	POP	B
  0DBA'   C9                    	RET
                                
                                ;ZSAVE / ZREST -- LINPSB runs WM's SETCNT: keep the count and the line-move
                                ; state (CMDCNT, AUXCNT, DIRFLG) around it, as LAYOUT does.
  0DBB'                         ZSAVE:
  0DBB'   2A 23DF'              	LHLD	CMDCNT
  0DBE'   22 2439'              	SHLD	ZSVCNT
  0DC1'   2A 0000*              	LHLD	AUXCNT
  0DC4'   22 243B'              	SHLD	ZSVAUX
  0DC7'   3A 0000*              	LDA	DIRFLG
  0DCA'   32 243D'              	STA	ZSVDIR
  0DCD'   C9                    	RET
  0DCE'                         ZREST:
  0DCE'   2A 2439'              	LHLD	ZSVCNT
  0DD1'   22 23DF'              	SHLD	CMDCNT
  0DD4'   2A 243B'              	LHLD	ZSVAUX
  0DD7'   22 0000*              	SHLD	AUXCNT
  0DDA'   3A 243D'              	LDA	ZSVDIR
  0DDD'   32 0000*              	STA	DIRFLG
  0DE0'   C9                    	RET
                                
                                ;GZONE -- ZTOP = the file position of the screen's top line (the cursor's
                                ; row, lines back from its line).
  0DE1'                         GZONE:
  0DE1'   CD 0DBB'              	CALL	ZSAVE
  0DE4'   CD 0B9C'              	CALL	CURRW
  0DE7'   6F                    	MOV	L,A
  0DE8'   26 00                 	MVI	H,0
  0DEA'   CD 0000*              	CALL	LINPSB		; HL = the top line's start
  0DED'   CD 0D9B'              	CALL	FPOS
  0DF0'   22 0000*              	SHLD	ZTOP
  0DF3'   32 0002*              	STA	ZTOP+2
  0DF6'   C3 0DCE'              	JMP	ZREST
                                
                                ;GPLACE -- cursor at the start of the G/gg target line: set its row (the
                                ; rule above), ask for a full repaint, and land on the first non-blank.
	MACRO-80 3.44	09-Dec-81	PAGE	1-47


  0DF9'                         GPLACE:
  0DF9'   CD 0DBB'              	CALL	ZSAVE
  0DFC'   2A 0000*              	LHLD	GAPBEG
  0DFF'   CD 0D9B'              	CALL	FPOS
  0E02'   EB                    	XCHG
  0E03'   4F                    	MOV	C,A		; C:DE = the target's position
  0E04'   2A 0000*              	LHLD	ZTOP
  0E07'   7B                    	MOV	A,E
  0E08'   95                    	SUB	L
  0E09'   6F                    	MOV	L,A
  0E0A'   7A                    	MOV	A,D
  0E0B'   9C                    	SBB	H
  0E0C'   67                    	MOV	H,A
  0E0D'   22 2436'              	SHLD	ZDIF
  0E10'   3A 0002*              	LDA	ZTOP+2
  0E13'   47                    	MOV	B,A
  0E14'   79                    	MOV	A,C
  0E15'   98                    	SBB	B		; A:ZDIF = target - top; CY iff above the top
  0E16'   DA 0E63'              	JC	GP_UP
  0E19'   B7                    	ORA	A
  0E1A'   C2 0EA4'              	JNZ	GP_MID		; 64K bytes or more below
                                	;--- below the top: are there at most NEDIT+NEDIT/2 lines between? ---
  0E1D'   3A 0000*              	LDA	NEDIT
  0E20'   5F                    	MOV	E,A
  0E21'   16 00                 	MVI	D,0
  0E23'   B7                    	ORA	A
  0E24'   1F                    	RAR
  0E25'   6F                    	MOV	L,A
  0E26'   26 00                 	MVI	H,0
  0E28'   19                    	DAD	D		; HL = NEDIT + NEDIT/2
  0E29'   CD 0000*              	CALL	LINPSB		; HL = the line that many lines up
  0E2C'   CD 0596'              	CALL	GBSUB		; HL = bytes from there to the target
  0E2F'   EB                    	XCHG
  0E30'   2A 2436'              	LHLD	ZDIF		; HL = bytes from the top to the target
  0E33'   CD 0000*              	CALL	CMP16		; CY iff the top is farther up
  0E36'   DA 0EA4'              	JC	GP_MID
  0E39'   CD 0596'              	CALL	GBSUB		; HL = the top line's start (resident)
  0E3C'   01 0000               	LXI	B,0		; BC = lines from the top
  0E3F'                         GP_CNT:
  0E3F'   7A                    	MOV	A,D
  0E40'   B3                    	ORA	E
  0E41'   CA 0E50'              	JZ	GP_DN
  0E44'   7E                    	MOV	A,M
  0E45'   23                    	INX	H
  0E46'   1B                    	DCX	D
  0E47'   FE 0A                 	CPI	LF
  0E49'   C2 0E3F'              	JNZ	GP_CNT
  0E4C'   03                    	INX	B
  0E4D'   C3 0E3F'              	JMP	GP_CNT
  0E50'                         GP_DN:
  0E50'   3A 0000*              	LDA	NEDIT
  0E53'   3D                    	DCR	A
  0E54'   5F                    	MOV	E,A
  0E55'   16 00                 	MVI	D,0		; DE = the bottom row
  0E57'   60                    	MOV	H,B
  0E58'   69                    	MOV	L,C
	MACRO-80 3.44	09-Dec-81	PAGE	1-48


  0E59'   CD 0000*              	CALL	CMP16		; CY iff below the screen
  0E5C'   DA 0EAE'              	JC	GP_SET		; A = the bottom row
  0E5F'   7D                    	MOV	A,L		; on the screen: its row
  0E60'   C3 0ECE'              	JMP	GP_ONS
                                	;--- above the top: at most NEDIT/2-2 lines? (read down to the top) ---
  0E63'                         GP_UP:
  0E63'   3C                    	INR	A
  0E64'   C2 0EA4'              	JNZ	GP_MID		; 64K bytes or more above
  0E67'   2A 2436'              	LHLD	ZDIF
  0E6A'   EB                    	XCHG
  0E6B'   21 0000               	LXI	H,0
  0E6E'   CD 0000*              	CALL	SUBHD		; HL = bytes from the target to the top
  0E71'   7C                    	MOV	A,H
  0E72'   B5                    	ORA	L
  0E73'   CA 0EA4'              	JZ	GP_MID		; exactly 64K
  0E76'   EB                    	XCHG			; DE = bytes to read
  0E77'   AF                    	XRA	A
  0E78'   32 2438'              	STA	ZLF
  0E7B'   CD 0000*              	CALL	RGET0
  0E7E'                         GP_RD:
  0E7E'   CD 0000*              	CALL	RDGET		; (keeps DE)
  0E81'   DA 0EA4'              	JC	GP_MID
  0E84'   FE 0A                 	CPI	LF
  0E86'   C2 0E9A'              	JNZ	GP_RN
  0E89'   3A 0000*              	LDA	NEDIT
  0E8C'   B7                    	ORA	A
  0E8D'   1F                    	RAR
  0E8E'   D6 02                 	SUI	2		; A = NEDIT/2 - 2
  0E90'   E5                    	PUSH	H
  0E91'   21 2438'              	LXI	H,ZLF
  0E94'   34                    	INR	M
  0E95'   BE                    	CMP	M		; CY iff more lines than that
  0E96'   E1                    	POP	H
  0E97'   DA 0EA4'              	JC	GP_MID
  0E9A'                         GP_RN:
  0E9A'   1B                    	DCX	D
  0E9B'   7A                    	MOV	A,D
  0E9C'   B3                    	ORA	E
  0E9D'   C2 0E7E'              	JNZ	GP_RD
  0EA0'   AF                    	XRA	A		; the top row
  0EA1'   C3 0EAE'              	JMP	GP_SET
  0EA4'                         GP_MID:				; NOTE: falls through to GP_SET -- keep it
                                				;   adjacent, the A it computes is the row
  0EA4'   3E 01                 	MVI	A,1
  0EA6'   32 0000*              	STA	WFILL		; not past the end of the file
  0EA9'   3A 0000*              	LDA	NEDIT
  0EAC'   B7                    	ORA	A
  0EAD'   1F                    	RAR			; the middle row
  0EAE'                         GP_SET:
  0EAE'   6F                    	MOV	L,A		; the cursor's row, lines counted from here
  0EAF'   26 00                 	MVI	H,0
  0EB1'   22 0000*              	SHLD	WINROW
  0EB4'   21 0000               	LXI	H,0
  0EB7'   22 0000*              	SHLD	LNDLT
  0EBA'   CD 062B'              	CALL	SETFUL		; the window may have paged: full repaint
  0EBD'                         GP_FIN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-49


  0EBD'   CD 0DCE'              	CALL	ZREST
  0EC0'   3A 2460'              	LDA	GPKEEP
  0EC3'   B7                    	ORA	A
  0EC4'   CA 06D8'              	JZ	FNBLNK		; the first non-blank (and its goal column)
  0EC7'   AF                    	XRA	A
  0EC8'   32 2460'              	STA	GPKEEP
  0ECB'   C3 048F'              	JMP	SETGL		; ... except a search, which keeps the column
                                				;   it matched at
                                
                                ;GP_ONS -- the target is on the screen the reader is already looking at, so
                                ; the top line does not move and NOTHING on it changes: this is a cursor
                                ; motion, not a jump.  LAYOUT works out how far the text scrolled as
                                ; LNDLT - (the row change), so telling it the truth -- the cursor moved
                                ; exactly as many lines as its row did -- makes that come out zero, and
                                ; R_MOVE then repositions the cursor and draws nothing.  WINROW is left
                                ; alone: CURRW adds LNDLT to it and arrives at the same row.
  0ECE'                         GP_ONS:
  0ECE'   6F                    	MOV	L,A
  0ECF'   26 00                 	MVI	H,0		; HL = the row it lands on
  0ED1'   EB                    	XCHG
  0ED2'   2A 0000*              	LHLD	WINROW		; (still the row it started on: SCPRE's OLDWR)
  0ED5'   EB                    	XCHG
  0ED6'   CD 0000*              	CALL	SUBHD		; HL = the lines the cursor moved
  0ED9'   22 0000*              	SHLD	LNDLT
  0EDC'   3E 01                 	MVI	A,R_MOVE
  0EDE'   32 23E3'              	STA	RINTENT
  0EE1'   C3 0EBD'              	JMP	GP_FIN
                                
                                ;============================================================
                                ; OPERATORS  (d c y + motion, dd, D)
                                ;
                                ; An operator key (VC_D) arms PENDOP.  On the NEXT key, VICDSP snapshots PENDOP
                                ; into PSAVE, clears it, and -- because PSAVE is now set -- routes here instead of
                                ; the plain motion dispatch.  If that key repeats the operator (dd) it is the
                                ; doubled linewise form (OPLINE); otherwise it is a motion whose span the operator
                                ; consumes: OPPEND classifies the motion (OPCLS), records the start offset, runs
                                ; the motion through the normal table (so f/F/t/T read their own target char, %
                                ; matches, counts apply), reads the landing offset, and deletes the span.
                                ;
                                ; Motion class governs the span:  charwise-exclusive (w b h l 0 ^) deletes up to
                                ; but not the endpoint; charwise-inclusive (e $ f t ; , %) includes it on a
                                ; forward motion; linewise (j k G H M L) deletes whole lines start-line..end-line.
                                ;============================================================
                                
                                ;OPPEND -- PSAVE = pending operator, C = the following key (always KT_CHAR here;
                                ; action keys cleared PENDOP in VIC_ACT).  Apply the operator to this key.
  0EE4'                         OPPEND:
  0EE4'   AF                    	XRA	A
  0EE5'   32 240C'              	STA	CWEOL		; set only by the 'cw' -> 'ce' rewrite below
                                	;--- 'cw' / 'cW' change to the WORD'S END, like 'ce' / 'cE': vi's one
                                	;    operator+motion special case.  Only with an ordinary char under
                                	;    the cursor, though -- on a blank or a line's end vim's 'cw' is a
                                	;    plain 'w' (recorded: 'cw' on a blank-only line changes just the
                                	;    blanks, and on an empty line it changes nothing at all). ---
  0EE8'   3A 2409'              	LDA	PSAVE
  0EEB'   FE 63                 	CPI	'c'
	MACRO-80 3.44	09-Dec-81	PAGE	1-50


  0EED'   C2 0F0A'              	JNZ	OPP_ND
  0EF0'   79                    	MOV	A,C
  0EF1'   FE 77                 	CPI	'w'
  0EF3'   CA 0EFB'              	JZ	OPP_W
  0EF6'   FE 57                 	CPI	'W'
  0EF8'   C2 0F0A'              	JNZ	OPP_ND
  0EFB'                         OPP_W:
  0EFB'   CD 0F84'              	CALL	ONWHIT		; CY iff there is no ordinary char there
  0EFE'   DA 0F0A'              	JC	OPP_ND
  0F01'   79                    	MOV	A,C
  0F02'   D6 12                 	SUI	'w'-'e'		; 'w'->'e' and 'W'->'E' (both 18 apart)
  0F04'   4F                    	MOV	C,A
  0F05'   3E 01                 	MVI	A,1		; ... but it is still a 'w' where the line ends:
  0F07'   32 240C'              	STA	CWEOL		;   see the clamp in OPA_F
  0F0A'                         OPP_ND:
  0F0A'   79                    	MOV	A,C		; doubled operator (dd / cc)?
  0F0B'   21 2409'              	LXI	H,PSAVE
  0F0E'   BE                    	CMP	M
  0F0F'   CA 0FA5'              	JZ	OPLINE
  0F12'   79                    	MOV	A,C		; (OPCLS classifies the key)
  0F13'   CD 0FB5'              	CALL	OPCLS		; classify the motion: CY = not a motion (cancel)
  0F16'   DA 0F81'              	JC	OPABRT		;   -- and not a mark, so nothing is owed below
  0F19'   32 240B'              	STA	OPCLSV
  0F1C'   47                    	MOV	B,A		; B = the class
  0F1D'   3A 2409'              	LDA	PSAVE
  0F20'   FE 63                 	CPI	'c'		; 'c' takes charwise motions only: a linewise one
  0F22'   C2 0F2E'              	JNZ	OPP_NC		;   (cj cG cH ...) would have to keep an empty
  0F25'   78                    	MOV	A,B		;   line to insert on, which is not built here,
  0F26'   FE 02                 	CPI	2		;   so it is dropped rather than got wrong
  0F28'   C2 0F50'              	JNZ	OPP_GO
  0F2B'   C3 0F39'              	JMP	OPP_NO
  0F2E'                         OPP_NC:
  0F2E'   FE 79                 	CPI	'y'		; 'y' is the other way about: it takes LINEWISE
  0F30'   C2 0F50'              	JNZ	OPP_GO		;   motions only ('y''a' 'yj' 'yG' 'yH'), because
  0F33'   78                    	MOV	A,B		;   a charwise register would need a type flag
  0F34'   FE 02                 	CPI	2		;   beside the Q-buffer and a 'p' that puts
  0F36'   CA 0F50'              	JZ	OPP_GO		;   within a line -- neither of which is built
  0F39'                         OPP_NO:
  0F39'   79                    	MOV	A,C		; dropped -- but the mark jumps and the finds still
  0F3A'   FE 27                 	CPI	27H		;   owe us the character they were going to read,
  0F3C'   CA 0F4A'              	JZ	OPP_SW		;   and an orphan would be dispatched as a command
  0F3F'   FE 60                 	CPI	60H		;   ('a' opens an insert and types into the buffer),
  0F41'   CA 0F4A'              	JZ	OPP_SW		;   so swallow it before dropping the command
  0F44'   CD 034B'              	CALL	ISFIND		; f F t T read one too ('yfx': 'y' takes linewise
  0F47'   C2 0F81'              	JNZ	OPABRT		;   motions only, so the find is dropped here)
  0F4A'                         OPP_SW:
  0F4A'   CD 021B'              	CALL	MKGETK
  0F4D'   C3 0F81'              	JMP	OPABRT
  0F50'                         OPP_GO:
  0F50'   AF                    	XRA	A
  0F51'   32 23EA'              	STA	WPULL		; only this motion's own answer counts (OPA_EX)
  0F54'   CD 0000*              	CALL	CUROFF		; span start = cursor before the motion
  0F57'   22 240D'              	SHLD	OPSTA
  0F5A'   21 230D'              	LXI	H,CMDTAB
  0F5D'   CD 00C5'              	CALL	VSCAN		; run the motion (moves the cursor; miss -> no move)
  0F60'   3A 2409'              	LDA	PSAVE		; the motion may have cancelled the operator -- a
	MACRO-80 3.44	09-Dec-81	PAGE	1-51


  0F63'   B7                    	ORA	A		;   mark that would not answer clears PSAVE.  The
  0F64'   CA 060A'              	JZ	SETMOV		;   span is empty then, and an empty LINEWISE span
                                				;   still takes a whole line, so stop here instead
  0F67'   CD 0000*              	CALL	CUROFF		; span end = cursor after the motion
  0F6A'   22 240F'              	SHLD	OPEND2
  0F6D'   3A 2409'              	LDA	PSAVE
  0F70'   FE 79                 	CPI	'y'
  0F72'   CA 1455'              	JZ	OPYANK		; a yank takes the span without losing it
  0F75'   CD 0FF0'              	CALL	OPAPPL		; delete the span
                                	;--- 'c' -> insert at the deletion point (OPAPPL left the cursor there,
                                	;    unclamped: on 'cw' at a line's end the text goes past its last
                                	;    char, where a clamped cursor would put it one char to the left) ---
  0F78'   3A 2409'              	LDA	PSAVE
  0F7B'   FE 63                 	CPI	'c'
  0F7D'   C0                    	RNZ
  0F7E'   C3 121C'              	JMP	SETINS
  0F81'                         OPABRT:
  0F81'   C3 060A'              	JMP	SETMOV		; not a motion -> operator cancelled, nothing drew
                                
                                ;ONWHIT -- CY iff there is no ordinary char under the cursor to change: a blank
                                ; (a space or a TAB), a line's end -- the CR,LF, so an empty line too -- or the
                                ; end of the text.  vim's 'cw'-is-'ce' test is exactly that (gchar_cursor() is
                                ; not NUL and not white), so on an empty line 'cw' stays a plain 'w': it must
                                ; not run 'e' off to the next line's word and swallow the line break.
  0F84'                         ONWHIT:
  0F84'   CD 0579'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  0F87'   CA 0FA3'              	JZ	OW_YES
  0F8A'   CD 0584'              	CALL	CURCHR		; A = the char under the cursor
  0F8D'   FE 20                 	CPI	' '
  0F8F'   CA 0FA3'              	JZ	OW_YES
  0F92'   FE 09                 	CPI	TAB
  0F94'   CA 0FA3'              	JZ	OW_YES
  0F97'   FE 0D                 	CPI	CR
  0F99'   CA 0FA3'              	JZ	OW_YES
  0F9C'   FE 0A                 	CPI	LF
  0F9E'   CA 0FA3'              	JZ	OW_YES
  0FA1'   B7                    	ORA	A		; a char to change: CY clear
  0FA2'   C9                    	RET
  0FA3'                         OW_YES:
  0FA3'   37                    	STC
  0FA4'   C9                    	RET
                                
                                ;OPLINE -- doubled operator: 'dd' deletes count whole lines.  'cc' is NOT built
                                ; (it would have to keep one empty line to insert on): it does nothing at all,
                                ; rather than deleting the lines the way 'dd' does.
  0FA5'                         OPLINE:
  0FA5'   3A 2409'              	LDA	PSAVE
  0FA8'   FE 63                 	CPI	'c'
  0FAA'   CA 060A'              	JZ	SETMOV
  0FAD'   FE 79                 	CPI	'y'
  0FAF'   CA 143A'              	JZ	VY_YY
  0FB2'   C3 13BF'              	JMP	VD_DD
                                
                                ;OPCLS -- A(key) -> A = motion class (0 excl, 1 incl, 2 linewise); CY if the key
                                ; is not an operator-usable motion (scan OPCTAB).
  0FB5'                         OPCLS:
	MACRO-80 3.44	09-Dec-81	PAGE	1-52


  0FB5'   FE 3B                 	CPI	';'		; ';' and ',' are whatever find they repeat: 'd;'
  0FB7'   CA 0FC4'              	JZ	OPC_SEM		;   after 'fx' is inclusive, after 'Fx' exclusive,
  0FBA'   FE 2C                 	CPI	','		;   and ',' is the reverse of that -- one class per
  0FBC'   C2 0FD8'              	JNZ	OPC_TB		;   KEY, as the table holds, cannot say it
  0FBF'   06 20                 	MVI	B,20H		; ',' runs the find reversed
  0FC1'   C3 0FC6'              	JMP	OPC_FK
  0FC4'                         OPC_SEM:
  0FC4'   06 00                 	MVI	B,0		; ';' runs it as it stands
  0FC6'                         OPC_FK:
  0FC6'   3A 2456'              	LDA	FNDKND
  0FC9'   B7                    	ORA	A
  0FCA'   37                    	STC
  0FCB'   C8                    	RZ			; nothing looked for yet: not a motion, so the
                                				;   operator is dropped and nothing is owed.  This
                                				;   test comes BEFORE the reversal: 0 flipped is
                                				;   20H, which would read as a find that was never
                                				;   made
  0FCC'   A8                    	XRA	B		; ... and now the direction ',' asked for
  0FCD'   E6 20                 	ANI	20H		; lower case ('f' / 't') = forward = inclusive
  0FCF'   CA 0FD6'              	JZ	OPC_EXC
  0FD2'   3E 01                 	MVI	A,1
  0FD4'   B7                    	ORA	A		; CY clear: a motion, class 1
  0FD5'   C9                    	RET
  0FD6'                         OPC_EXC:
  0FD6'   AF                    	XRA	A		; class 0, CY clear
  0FD7'   C9                    	RET
  0FD8'                         OPC_TB:
  0FD8'   47                    	MOV	B,A
  0FD9'   21 1112'              	LXI	H,OPCTAB
  0FDC'                         OPC_LP:
  0FDC'   7E                    	MOV	A,M
  0FDD'   B7                    	ORA	A
  0FDE'   CA 0FEE'              	JZ	OPC_MS		; end of table -> not a motion
  0FE1'   B8                    	CMP	B
  0FE2'   CA 0FEA'              	JZ	OPC_HT
  0FE5'   23                    	INX	H
  0FE6'   23                    	INX	H
  0FE7'   C3 0FDC'              	JMP	OPC_LP
  0FEA'                         OPC_HT:
  0FEA'   23                    	INX	H
  0FEB'   7E                    	MOV	A,M		; class byte
  0FEC'   B7                    	ORA	A		; clear CY
  0FED'   C9                    	RET
  0FEE'                         OPC_MS:
  0FEE'   37                    	STC
  0FEF'   C9                    	RET
                                
                                ;OPAPPL -- apply the operator over [OPSTA,OPEND2] using class OPCLSV.
  0FF0'                         OPAPPL:
  0FF0'   3A 240B'              	LDA	OPCLSV
  0FF3'   FE 02                 	CPI	2
  0FF5'   CA 10F6'              	JZ	OPALIN		; linewise
                                	;--- charwise: order the endpoints, adjust for inclusive ---
  0FF8'   2A 240D'              	LHLD	OPSTA
  0FFB'   EB                    	XCHG			; DE = start
  0FFC'   2A 240F'              	LHLD	OPEND2		; HL = end
	MACRO-80 3.44	09-Dec-81	PAGE	1-53


  0FFF'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end, Z iff ==
  1002'   DA 1012'              	JC	OPA_F
  1005'   CA 1012'              	JZ	OPA_F		; forward or empty
                                	;--- backward: lo = end (HL), hi = start (DE) ---
  1008'   22 2411'              	SHLD	OPLO
  100B'   EB                    	XCHG
  100C'   22 2413'              	SHLD	OPHI
  100F'   C3 106A'              	JMP	OPA_DO
  1012'                         OPA_F:
  1012'   EB                    	XCHG			; HL = start, DE = end
  1013'   22 2411'              	SHLD	OPLO
  1016'   EB                    	XCHG			; HL = end
  1017'   3A 240B'              	LDA	OPCLSV
  101A'   FE 03                 	CPI	3		; a JUMP ('`'): its end is exactly where it landed.
  101C'   CA 1067'              	JZ	OPA_HI		;   OPA_EX below cuts an exclusive forward span back
                                				;   to the line's content end because that is what
                                				;   vim's 'w' does under an operator -- but a jump
                                				;   crosses line breaks, which is the whole point
                                				;   of it, so it must not be cut back
  101F'   FE 01                 	CPI	1
  1021'   C2 1043'              	JNZ	OPA_EX
  1024'   23                    	INX	H		; inclusive endpoint -> hi = end+1
                                	;--- 'cw' stops at the line's content end, where a plain 'ce' (and 'de')
                                	;    runs on into the next line's word and 'd%' crosses to its mate --
                                	;    all four recorded from vim 9.1.  vim's 'cw' is not simply 'ce': the
                                	;    rewrite keeps 'w's own end-of-line stop, so the clamp hangs off
                                	;    CWEOL (the rewrite) and not off the inclusive class. ---
  1025'   3A 240C'              	LDA	CWEOL
  1028'   B7                    	ORA	A
  1029'   CA 1067'              	JZ	OPA_HI
  102C'   22 2413'              	SHLD	OPHI		; park the motion's own end: CEND clobbers DE
  102F'   2A 2411'              	LHLD	OPLO
  1032'   CD 119A'              	CALL	CEND		; HL = the start line's content end
  1035'   EB                    	XCHG			; DE = that content end
  1036'   2A 2413'              	LHLD	OPHI		; HL = hi
  1039'   CD 0000*              	CALL	CMP16		; CY iff the content end is below hi
  103C'   D2 1067'              	JNC	OPA_HI		; hi is inside the line: keep it
  103F'   EB                    	XCHG			; HL = the content end: 'cw' stops there
  1040'   C3 1067'              	JMP	OPA_HI
  1043'                         OPA_EX:
                                	;--- exclusive and forward: vim's 'w' under an operator stops at the end
                                	;    of the line (fwd_word's 'eol'), so the span is cut back to the
                                	;    cursor line's content end -- 'dw' on the last word of a line
                                	;    deletes to the line's end and does NOT join the next line up.
                                	;    The end goes to OPHI first: CEND does not preserve DE. ---
  1043'   22 2413'              	SHLD	OPHI		; the motion's own end, for now
  1046'   2A 2411'              	LHLD	OPLO
  1049'   CD 119A'              	CALL	CEND		; HL = the start line's content end
  104C'   EB                    	XCHG			; DE = that content end
  104D'   3A 23EA'              	LDA	WPULL		; the motion landed on a line's end and was
  1050'   B7                    	ORA	A		;   pulled back onto its last char (the command
  1051'   C2 105D'              	JNZ	OPA_CE		;   cursor may not sit past it): under an
  1054'   2A 2413'              	LHLD	OPHI		;   operator vim's own w stops AT that end, so
  1057'   CD 0000*              	CALL	CMP16		;   the span runs to the line's content end --
  105A'   D2 106A'              	JNC	OPA_DO		;   'dw' on the last word of the last line
  105D'                         OPA_CE:				;   deletes the word, not all but its last char
	MACRO-80 3.44	09-Dec-81	PAGE	1-54


  105D'   2A 2411'              	LHLD	OPLO
  1060'   CD 0000*              	CALL	CMP16		; DE = the content end vs HL = lo: Z iff equal
  1063'   CA 10A8'              	JZ	OPA_LN
  1066'   EB                    	XCHG			; HL = the content end
  1067'                         OPA_HI:
  1067'   22 2413'              	SHLD	OPHI
                                ;OPA_DO -- delete the charwise span, then place the cursor: a delete never
                                ; leaves it past the line's last char, a change leaves it at the deletion point
                                ; (where the typed text goes).
  106A'                         OPA_DO:
  106A'   CD 108E'              	CALL	OPDSPN
  106D'   3A 2409'              	LDA	PSAVE
  1070'   FE 63                 	CPI	'c'
  1072'   C8                    	RZ
  1073'   C3 11AB'              	JMP	CLAMPE
                                ;SPNBRK -- CY iff the span [OPLO,OPHI) takes a line break with it.  The first
                                ; LF at or after OPLO ends the span's own line; the span reaches a break only
                                ; if it runs past that one.  A span ending exactly ON it (OPHI = the LF's
                                ; offset) stops short of it, and takes none.
  1076'                         SPNBRK:
  1076'   2A 2411'              	LHLD	OPLO
  1079'   CD 0509'              	CALL	EOLNL		; HL = that LF's offset, or LOGLEN on a last line
  107C'   EB                    	XCHG			; DE = it
  107D'   2A 2413'              	LHLD	OPHI
  1080'   C3 0000*              	JMP	CMP16		; CY iff the break lies inside the span
                                
                                ;OPSPNL -- HL = OPHI - OPLO, the operator span's length.  Three callers measure
                                ; it the same way and none of them wants DE afterwards.
  1083'                         OPSPNL:
  1083'   2A 2413'              	LHLD	OPHI
  1086'   EB                    	XCHG
  1087'   2A 2411'              	LHLD	OPLO
  108A'   EB                    	XCHG			; HL = hi, DE = lo
  108B'   C3 0000*              	JMP	SUBHD
                                
                                ;OPDSPN -- delete the logical span [OPLO,OPHI) (charwise).
  108E'                         OPDSPN:
  108E'   CD 1076'              	CALL	SPNBRK		; asked BEFORE the delete, while the text is there
  1091'   F5                    	PUSH	PSW
  1092'   2A 2411'              	LHLD	OPLO
  1095'   CD 0000*              	CALL	GOTO
  1098'   CD 1083'              	CALL	OPSPNL		; HL = hi - lo
  109B'   CD 0000*              	CALL	DELFWD
  109E'   CD 0188'              	CALL	MARKMOD
  10A1'   F1                    	POP	PSW
  10A2'   DA 062B'              	JC	SETFUL		; a break went: every row below it moved up
  10A5'   C3 0610'              	JMP	SETLIN		; no break: 'dw' 'cw' 'D' changed one row, and
                                				;   only that row is stale -- 1.6 s of repaint
                                				;   for a word was the whole cost of these
                                
                                ;OPA_LN -- the span came out empty because the line holds nothing at all (the
                                ; cursor is on an empty line): vim's do_pending_operator promotes such a span to
                                ; LINEWISE there ('inindent'), so 'dw' takes the line away, exactly as a 'J' on
                                ; the line above would.  A change has nothing to delete: it just opens its
                                ; insert on the empty line (vim's 'cw' there is a linewise change, same effect).
  10A8'                         OPA_LN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-55


  10A8'   3A 2409'              	LDA	PSAVE
  10AB'   FE 63                 	CPI	'c'
  10AD'   C2 10B6'              	JNZ	OPA_LD
  10B0'   2A 2411'              	LHLD	OPLO		; nothing to delete, and the motion has moved
  10B3'   C3 0000*              	JMP	GOTO		;   on: back to the empty line to insert there
  10B6'                         OPA_LD:
  10B6'   2A 2411'              	LHLD	OPLO
  10B9'   22 240D'              	SHLD	OPSTA
  10BC'   22 240F'              	SHLD	OPEND2
  10BF'   C3 10F6'              	JMP	OPALIN
                                
                                ;OPALSP -- the linewise span [OPSTA,OPEND2] as whole lines: OPLO = the start of
                                ; the LOW endpoint's line, OPHI = the start of the line past the HIGH one.
  10C2'                         OPALSP:
  10C2'   2A 240D'              	LHLD	OPSTA
  10C5'   EB                    	XCHG
  10C6'   2A 240F'              	LHLD	OPEND2
  10C9'   CD 0000*              	CALL	CMP16		; DE=start vs HL=end: CY iff start<end
  10CC'   DA 10D9'              	JC	OPAL_F
  10CF'   22 2411'              	SHLD	OPLO		; end <= start: lo-src = end (HL)
  10D2'   EB                    	XCHG
  10D3'   22 2413'              	SHLD	OPHI		; hi-src = start
  10D6'   C3 10E3'              	JMP	OPAL_R
  10D9'                         OPAL_F:
  10D9'   EB                    	XCHG			; HL = start
  10DA'   22 2411'              	SHLD	OPLO		; lo-src = start
  10DD'   2A 240F'              	LHLD	OPEND2
  10E0'   22 2413'              	SHLD	OPHI		; hi-src = end
  10E3'                         OPAL_R:
  10E3'   2A 2411'              	LHLD	OPLO
  10E6'   CD 04F6'              	CALL	BOL
  10E9'   22 2411'              	SHLD	OPLO		; lo = BOL(low line)
  10EC'   2A 2413'              	LHLD	OPHI
  10EF'   CD 0526'              	CALL	NLSTART
  10F2'   22 2413'              	SHLD	OPHI		; hi = start of line past the high line
  10F5'   C9                    	RET
                                
                                ;OPALIN -- linewise operator over a motion span: delete whole lines from the low
                                ; endpoint's line through the high endpoint's line.  A yank wants the same span
                                ; measured but NOT deleted, so it calls OPALSP on its own (OPYANK).
  10F6'                         OPALIN:
  10F6'   CD 10C2'              	CALL	OPALSP
                                ;OPDLIN -- delete the whole-line span [OPLO,OPHI); if the cursor ends past the
                                ; text, drop it to the last line's start.  Either way it ends on the line's
                                ; first NON-BLANK, as 'dd' does -- a linewise delete is a linewise delete,
                                ; whether the span was linewise to begin with ('dj') or was promoted there for
                                ; being empty ('dw' on an empty line).  Landing on the line START instead was
                                ; invisible for as long as the only test case had an unindented line after the
                                ; empty one.
  10F9'                         OPDLIN:
  10F9'   CD 108E'              	CALL	OPDSPN
  10FC'   CD 0579'              	CALL	ATENDQ		; CY iff the cursor is short of the end
  10FF'   DA 110F'              	JC	OPDL_NB
  1102'   CD 0000*              	CALL	LOGLEN
  1105'   7C                    	MOV	A,H
  1106'   B5                    	ORA	L
	MACRO-80 3.44	09-Dec-81	PAGE	1-56


  1107'   C8                    	RZ			; empty buffer
  1108'   2B                    	DCX	H
  1109'   CD 04F6'              	CALL	BOL
  110C'   CD 0000*              	CALL	GOTO
  110F'                         OPDL_NB:
  110F'   C3 06D8'              	JMP	FNBLNK
                                
                                ;OPCTAB -- operator motion classes: DB key, class.  0 = charwise exclusive,
                                ; 1 = charwise inclusive, 2 = linewise, 3 = charwise exclusive but a JUMP.
                                ; 'c' takes everything but class 2, 'y' takes class 2 alone.  Ends with a 0 key.
                                ; Every key here MUST also be a row in CMDTAB.  A key classified here but not
                                ; dispatchable there is worse than useless: OPPEND takes the class, VSCAN finds
                                ; nothing and the cursor does not move, and OPAPPL is then handed a span of
                                ; length zero -- which class 1 turns into a span of ONE by the inclusive INX H.
                                ; 'f F t T ; , %' once stayed classed here after their handlers were cut, and
                                ; for that reason 'df' deleted the character under the cursor and 'cf' deleted
                                ; it and opened an insert: 'x' and 's' under another name.
  1112'                         OPCTAB:
  1112'   77 00 57 00           	DB	'w',0, 'W',0, 'b',0, 'B',0, 'h',0, 'l',0, '0',0, '^',0
  1116'   62 00 42 00           
  111A'   68 00 6C 00           
  111E'   30 00 5E 00           
  1122'   60 03                 	DB	60H,3		; `{a-c} -- charwise exclusive, but a JUMP: class 3
                                				;   so OPA_EX's end-of-line clamp does not apply
  1124'   66 01 74 01           	DB	'f',1, 't',1		; onto / up to the character: INCLUSIVE
  1128'   46 00 54 00           	DB	'F',0, 'T',0		; ... backward, and so exclusive
  112C'   3B 01 2C 01           	DB	';',1, ',',1		; the class OPCLS works out from FNDKND --
                                				;   these two only have to be IN the table
  1130'   65 01 45 01           	DB	'e',1, 'E',1, '$',1
  1134'   24 01                 
  1136'   6A 02 6B 02           	DB	'j',2, 'k',2, 'G',2, 'H',2, 'M',2, 'L',2
  113A'   47 02 48 02           
  113E'   4D 02 4C 02           
  1142'   27 02                 	DB	27H,2		; '{a-c} -- linewise, as j and G are
  1144'   00                    	DB	0
                                
                                ;VCB_C -- 'C' = change to the line's end: vi's 'c$'.  It takes exactly the span
                                ; 'D' takes and then opens an insert at the deletion point, instead of pulling
                                ; the cursor back onto the new last char -- that is the whole difference, which
                                ; is why the span is shared below.
                                ;
                                ; 'C' is NOT 'D' then 'a', though the text they leave is identical (measured in
                                ; vim 9.1, and here).  'C' is ONE change: '.' repeats the delete and the typed
                                ; text together, and 'u' takes the whole thing back.  'D' then 'a' is TWO, so
                                ; '.' repeats only the append, and since undo here is single-level and 'u'
                                ; undoes 'u', one 'u' gets back to the truncated line and the next one just
                                ; puts the insert back -- the text 'D' removed is gone.  That asymmetry is the
                                ; reason this is its own command and not an idiom.
  1145'                         VCB_C:
  1145'   CD 1151'              	CALL	VCB_CD
  1148'   C3 121C'              	JMP	SETINS		; the cursor is at the deletion point already
                                ;VCB_D -- 'D' = delete to end of line (content only, not the newline).
  114B'                         VCB_D:
  114B'   CD 1151'              	CALL	VCB_CD
  114E'   C3 11AB'              	JMP	CLAMPE		; pull the cursor onto the new last content char
                                ;VCB_CD -- the span 'C' and 'D' share: [cursor, the line's content end).  Leaves
	MACRO-80 3.44	09-Dec-81	PAGE	1-57


                                ; the cursor at the deletion point, which is where OPDSPN's GOTO puts it.
  1151'                         VCB_CD:
  1151'   CD 0590'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1154'   22 2411'              	SHLD	OPLO
  1157'   CD 0000*              	CALL	CUROFF
  115A'   CD 119A'              	CALL	CEND		; to the line's content end, the CR,LF left
  115D'   22 2413'              	SHLD	OPHI
  1160'   C3 108E'              	JMP	OPDSPN
                                
                                ;============================================================
                                ; EDITS
                                ;============================================================
                                
                                ;VC_X -- delete count chars at the cursor, not past the line's content end.
                                ; The delete is clamped to the line's content end, so it never removes the LF:
                                ; the line count is unchanged and only this row is stale -> R_LINE.
  1163'                         VC_X:
  1163'   CD 077D'              	CALL	GLSTAL
  1166'   CD 0610'              	CALL	SETLIN
  1169'   CD 059D'              	CALL	GETCNT
  116C'   22 2415'              	SHLD	CNTV
  116F'   CD 0000*              	CALL	CUROFF
  1172'   22 2419'              	SHLD	WKI		; cur
  1175'   CD 119A'              	CALL	CEND		; HL = the line's content end (HL = cur on entry)
                                	;--- available = contentend - cur ---
  1178'   EB                    	XCHG			; DE = contentend
  1179'   2A 2419'              	LHLD	WKI		; HL = cur
  117C'   EB                    	XCHG			; HL = contentend, DE = cur
  117D'   CD 0000*              	CALL	SUBHD		; HL = contentend - cur
  1180'   7C                    	MOV	A,H
  1181'   B5                    	ORA	L
  1182'   C8                    	RZ			; nothing to delete (empty line / at end)
                                	;--- del = min(available, count) ---
  1183'   EB                    	XCHG			; DE = available
  1184'   2A 2415'              	LHLD	CNTV		; HL = count
  1187'   CD 0000*              	CALL	CMP16		; DE=available vs HL=count: CY iff available < count
  118A'   DA 1190'              	JC	VX_USEA
  118D'   C3 1191'              	JMP	VX_DEL		; count <= available -> HL = count = del
  1190'                         VX_USEA:
  1190'   EB                    	XCHG			; HL = available
  1191'                         VX_DEL:
  1191'   CD 0000*              	CALL	DELFWD		; HL = del bytes, forward-delete from cursor
  1194'   CD 0188'              	CALL	MARKMOD
  1197'   C3 11AB'              	JMP	CLAMPE		; pull the cursor back to the line's content end
                                
                                ;CEND -- HL(off) -> HL = the line's CONTENT end: its terminator offset (EOLNL,
                                ; which is LOGLEN on a last line with no line end), less a CR that immediately
                                ; precedes the LF.  It is the offset text appended to the line goes at, so it is
                                ; also where 'o' opens its line and where 'J' joins.  Shared by x, D, o, J and
                                ; the operator span clamp.
  119A'                         CEND:
  119A'   CD 0509'              	CALL	EOLNL		; HL = the LF's offset, or LOGLEN
  119D'   7C                    	MOV	A,H
  119E'   B5                    	ORA	L
  119F'   C8                    	RZ			; the start of the text: nothing before it
  11A0'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-58


  11A1'   E5                    	PUSH	H
  11A2'   CD 0000*              	CALL	CHARAT
  11A5'   E1                    	POP	H		; HL = term-1
  11A6'   FE 0D                 	CPI	CR
  11A8'   C8                    	RZ			; a CR before the LF -> the content ends there
  11A9'   23                    	INX	H
  11AA'   C9                    	RET
                                
                                ;CLAMPE -- if the cursor sits past its line's last content char, pull it back to
                                ; that char.  Shared by x, D, ~, J and the d{motion} operators (post-delete
                                ; cursor fix: vim never leaves the cursor past the end of a line).
  11AB'                         CLAMPE:
  11AB'   CD 0000*              	CALL	CUROFF
  11AE'   E5                    	PUSH	H
  11AF'   CD 0535'              	CALL	EOLC
  11B2'   D1                    	POP	D		; DE = cur
  11B3'   CD 0000*              	CALL	CMP16		; DE=cur vs HL=eolc: CY iff cur < eolc
  11B6'   D8                    	RC
  11B7'   C8                    	RZ
  11B8'   C3 0000*              	JMP	GOTO		; cur > eolc -> HL = eolc
                                
                                ;VC_I -- insert before the cursor.
  11BB'                         VC_I:
  11BB'   CD 059D'              	CALL	GETCNT
  11BE'   C3 1219'              	JMP	SETINM
                                
                                ;VC_A -- 'a': append after the cursor char.  On the line's terminator -- the LF,
                                ; or the CR of the CR,LF an empty line is -- the insert stays in place: stepping
                                ; over a CR would put the text between the CR and its LF.
  11C1'                         VC_A:
  11C1'   CD 059D'              	CALL	GETCNT
  11C4'   CD 0579'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  11C7'   CA 11DE'              	JZ	VA_INS
  11CA'   EB                    	XCHG			; HL = cur
  11CB'   E5                    	PUSH	H
  11CC'   CD 0000*              	CALL	CHARAT
  11CF'   E1                    	POP	H
  11D0'   FE 0A                 	CPI	LF
  11D2'   CA 11DE'              	JZ	VA_INS		; on the line terminator -> append in place
  11D5'   FE 0D                 	CPI	CR
  11D7'   CA 11DE'              	JZ	VA_INS
  11DA'   23                    	INX	H
  11DB'   CD 0000*              	CALL	GOTO
  11DE'                         VA_INS:
  11DE'   C3 1219'              	JMP	SETINM
                                
                                ;VCB_A -- 'A': insert at the line's content end (vim's A: '$' then 'a', but
                                ; past the end rather than on the last char, and past all of a blank-only
                                ; line's blanks).  The insert point is before the CR,LF, or LOGLEN on a last
                                ; line that has no line end.  A count is ignored -- DEVIATION: vim's '3AX'
                                ; appends the text three times.
  11E1'                         VCB_A:
  11E1'   CD 0590'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  11E4'   CD 0535'              	CALL	EOLC		; HL = last content char (the start when empty)
  11E7'   E5                    	PUSH	H
  11E8'   CD 0000*              	CALL	CHARAT
	MACRO-80 3.44	09-Dec-81	PAGE	1-59


  11EB'   E1                    	POP	H
  11EC'   FE 0D                 	CPI	CR
  11EE'   CA 11F7'              	JZ	VBA_IN		; an empty line: insert at its start
  11F1'   FE 0A                 	CPI	LF
  11F3'   CA 11F7'              	JZ	VBA_IN
  11F6'   23                    	INX	H		; past the last content char
  11F7'                         VBA_IN:
  11F7'   CD 0000*              	CALL	GOTO
  11FA'   C3 1219'              	JMP	SETINM
                                
                                ;VCB_I -- 'I': insert at the first non-blank (vim's I: '^' then 'i').  NOT
                                ; '^' itself on a line of blanks only: vim's whitespace skip runs past the last
                                ; blank, where '^' -- a motion, so it must land on a char -- stays on it, and
                                ; 'I' inserts after it.  A count is ignored (DEVIATION, as VCB_A).
  11FD'                         VCB_I:
  11FD'   CD 059D'              	CALL	GETCNT
  1200'   CD 06D8'              	CALL	FNBLNK
  1203'   CD 0000*              	CALL	CUROFF
  1206'   E5                    	PUSH	H
  1207'   CD 0000*              	CALL	CHARAT
  120A'   E1                    	POP	H
  120B'   FE 20                 	CPI	' '
  120D'   CA 1215'              	JZ	VBI_SK
  1210'   FE 09                 	CPI	TAB
  1212'   C2 1219'              	JNZ	SETINM
  1215'                         VBI_SK:
  1215'   23                    	INX	H		; blanks only: past the last of them
  1216'   CD 0000*              	CALL	GOTO
                                ;SETINM -- enter insert mode from a COMMAND key ('i' 'a' 'A' 'I').  Those
                                ; keys change no text and no line count: they move the cursor at most, so the
                                ; frame is a cursor reposition (R_MOVE), not a repaint.  The mode word on the
                                ; message row is MODEMS's business and is drawn after the frame either way.
                                ; SETINS itself must NOT do this: the 'c' operator ends there too, and its
                                ; span has already said what it changed.
  1219'                         SETINM:
  1219'   CD 060A'              	CALL	SETMOV
  121C'                         SETINS:
  121C'   3E 01                 	MVI	A,EM_INS
  121E'   32 23DE'              	STA	EDMODE
  1221'   C9                    	RET
                                
                                ;ATCEND -- Z iff the cursor is at its line's CONTENT end: the next char is the
                                ; line's CR or LF, or there is no next char at all.  Nothing of the line follows
                                ; the cursor on its row, which is what the cheap paints want to know -- a char
                                ; typed there shifts nothing along, and a line break taken there carries nothing
                                ; away from the row it leaves behind.  Clobbers A, HL, DE (CURCHR's).
  1222'                         ATCEND:
  1222'   CD 0579'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1225'   C8                    	RZ
  1226'   CD 0584'              	CALL	CURCHR		; A = the char under the cursor
  1229'   FE 0D                 	CPI	CR
  122B'   C8                    	RZ
  122C'   FE 0A                 	CPI	LF
  122E'   C9                    	RET
                                
                                ;OPNBRK -- put a line break (CR,LF) in at the cursor, which ends a line further
	MACRO-80 3.44	09-Dec-81	PAGE	1-60


                                ; down.  The insert-mode <CR>, 'r<CR>' and o/O all open a line this way.
  122F'                         OPNBRK:
  122F'   3E 0D                 	MVI	A,CR
  1231'   CD 0000*              	CALL	PUTGAP
  1234'   3E 0A                 	MVI	A,LF
  1236'   CD 0000*              	CALL	PUTGAP
  1239'   2A 0000*              	LHLD	LNDLT		; the cursor is a line further down
  123C'   23                    	INX	H
  123D'   22 0000*              	SHLD	LNDLT
  1240'   C3 0188'              	JMP	MARKMOD
                                
                                ;ENDBRK -- call after OPNBRK: give the line it opened a terminator of its own
                                ; when it has none.  An empty last line IS a line -- vim's buffer holds [abc,
                                ; ""] whether or not the file ended with a line end (measured: line("$") is 2
                                ; with 'endofline' off as well as on) -- but here the text IS the file's bytes,
                                ; so the break just put in only terminates the line the cursor LEFT.  With
                                ; nothing marking the new one it exists on the screen and nowhere else: the row
                                ; is painted, no motion can reach it, and ':w' writes it away.  A second break
                                ; makes it a line like any other, which is exactly the text a line opened at a
                                ; TERMINATED last line already produces.
                                ; Not in OPNBRK itself: the put ('p') calls that at the end of the text too,
                                ; and would gain an empty line of its own.
                                ; OPNBRK counts the cursor a line lower and the step back over the new break
                                ; counts it one higher again, so LNDLT keeps the one line this added.
  1243'                         ENDBRK:
  1243'   CD 0579'              	CALL	ATENDQ		; NZ: text follows, so the line is terminated
  1246'   C0                    	RNZ
  1247'   CD 122F'              	CALL	OPNBRK
  124A'   CD 0000*              	CALL	CUROFF
  124D'   2B                    	DCX	H		; back over the LF, then the CR: onto the new
  124E'   2B                    	DCX	H		;   line, with its own terminator after it
  124F'   C3 0000*              	JMP	GOTO
                                
                                ;VC_O -- 'o': open a line below the cursor's and insert on it.  The break goes
                                ; in at the line's CONTENT end -- before its CR,LF, so the new empty line comes
                                ; after the cursor's own and the typing lands on it.  On a last line with no
                                ; line end the content end is the end of the text, so the break is appended.
                                ; A count is ignored -- DEVIATION: vim's '3oX' opens three lines.
  1252'                         VC_O:
  1252'   CD 0590'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1255'   CD 119A'              	CALL	CEND
  1258'   CD 0000*              	CALL	GOTO
  125B'   CD 122F'              	CALL	OPNBRK
  125E'   CD 1243'              	CALL	ENDBRK		; a last line with no line end: the opened line
  1261'   CD 0616'              	CALL	SETILN		;   needs a terminator of its own to exist
  1264'   C3 121C'              	JMP	SETINS
                                
                                ;VCB_O -- 'O': open a line above.  The break goes in at the line's start and
                                ; the cursor steps back over it (the LF, then the CR) onto the new empty line.
                                ; The offsets are taken fresh: an insert can page the window out, which moves
                                ; every logical offset.  A count is ignored, as for 'o'.
  1267'                         VCB_O:
  1267'   CD 0590'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  126A'   CD 04F6'              	CALL	BOL
  126D'   CD 0000*              	CALL	GOTO
  1270'   CD 122F'              	CALL	OPNBRK
	MACRO-80 3.44	09-Dec-81	PAGE	1-61


  1273'   CD 0000*              	CALL	CUROFF
  1276'   2B                    	DCX	H
  1277'   2B                    	DCX	H
  1278'   CD 0000*              	CALL	GOTO
  127B'   CD 0616'              	CALL	SETILN
  127E'   C3 121C'              	JMP	SETINS
                                
                                ;VCB_J -- 'J': join the next line onto the cursor's.  vim's rules, recorded from
                                ; vim 9.1 (accept_vi.py "o O J ~ dw cw D"): the next line's leading blanks go,
                                ; and ONE space is put in their place -- unless nothing is appended at all (the
                                ; next line is empty or blank-only), what is appended starts with ')', the line
                                ; already ends in a blank, or the line is empty.  The cursor lands on the join
                                ; point, pulled back onto the last char when nothing was appended.  On the last
                                ; line nothing happens (vim beeps there).  A count is ignored -- DEVIATION:
                                ; vim's '3J' joins three lines.
  1281'                         VCB_J:
  1281'   CD 0590'              	CALL	CNTOFF		; the count is spent; HL = the cursor
  1284'   CD 119A'              	CALL	CEND		; the join point: this line's content end
  1287'   22 2411'              	SHLD	OPLO
  128A'   CD 0000*              	CALL	CUROFF
  128D'   CD 0526'              	CALL	NLSTART		; HL = the next line's start, or LOGLEN
  1290'   E5                    	PUSH	H
  1291'   CD 0000*              	CALL	LOGLEN
  1294'   D1                    	POP	D		; DE = that start
  1295'   CD 0000*              	CALL	CMP16		; Z iff there is no line after this one
  1298'   CA 060A'              	JZ	SETMOV
  129B'   EB                    	XCHG			; HL = the next line's start
                                ;--- skip that line's leading blanks: they go with the break ---
  129C'                         VJ_WS:
  129C'   E5                    	PUSH	H
  129D'   CD 0000*              	CALL	LOGLEN
  12A0'   D1                    	POP	D		; DE = the scan
  12A1'   CD 0000*              	CALL	CMP16		; Z iff the text ends here
  12A4'   CA 12BB'              	JZ	VJ_DEL
  12A7'   EB                    	XCHG			; HL = the scan
  12A8'   E5                    	PUSH	H
  12A9'   CD 0000*              	CALL	CHARAT
  12AC'   E1                    	POP	H
  12AD'   FE 20                 	CPI	' '
  12AF'   CA 12B7'              	JZ	VJ_SKIP
  12B2'   FE 09                 	CPI	TAB
  12B4'   C2 12BB'              	JNZ	VJ_DEL
  12B7'                         VJ_SKIP:
  12B7'   23                    	INX	H
  12B8'   C3 129C'              	JMP	VJ_WS
  12BB'                         VJ_DEL:
  12BB'   22 2413'              	SHLD	OPHI
  12BE'   CD 108E'              	CALL	OPDSPN		; the break and those blanks go; MODF + R_FULL
  12C1'   CD 0625'              	CALL	SETJON		; ... and a join is a join: two rows, not a screen
                                ;--- the one space, unless one of vim's four exceptions applies ---
  12C4'   CD 0579'              	CALL	ATENDQ		; Z iff the text ends here: nothing was appended
  12C7'   CA 11AB'              	JZ	CLAMPE
  12CA'   CD 0584'              	CALL	CURCHR		; the first char of what was appended
  12CD'   FE 0D                 	CPI	CR
  12CF'   CA 11AB'              	JZ	CLAMPE		; nothing was: an empty or blank-only line
  12D2'   FE 0A                 	CPI	LF
	MACRO-80 3.44	09-Dec-81	PAGE	1-62


  12D4'   CA 11AB'              	JZ	CLAMPE
  12D7'   FE 29                 	CPI	')'
  12D9'   CA 11AB'              	JZ	CLAMPE		; vim puts no space before a ')'
  12DC'   CD 0000*              	CALL	CUROFF
  12DF'   7C                    	MOV	A,H
  12E0'   B5                    	ORA	L
  12E1'   CA 12F7'              	JZ	VJ_SP		; the very start of the text: nothing behind it
  12E4'   2B                    	DCX	H
  12E5'   CD 0000*              	CALL	CHARAT		; the char the line already ends with
  12E8'   FE 20                 	CPI	' '
  12EA'   CA 11AB'              	JZ	CLAMPE
  12ED'   FE 09                 	CPI	TAB
  12EF'   CA 11AB'              	JZ	CLAMPE
  12F2'   FE 0A                 	CPI	LF
  12F4'   CA 11AB'              	JZ	CLAMPE		; the line is empty: its own LF is right behind
  12F7'                         VJ_SP:
  12F7'   3E 20                 	MVI	A,' '
  12F9'   CD 0000*              	CALL	PUTGAP
  12FC'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  12FF'   2B                    	DCX	H
  1300'   C3 0000*              	JMP	GOTO		; onto the space, where vim leaves the cursor
                                
                                ;VC_TILD -- '~': toggle the case of the char under the cursor, then step right.
                                ; Recorded from vim: on a line's last char the cursor stays on it (CLAMPE), a
                                ; char with no case still steps over, and where there is no char at all -- an
                                ; empty line, a line's terminator, the end of the text -- nothing happens.
                                ; A count is ignored -- DEVIATION: vim's '3~' toggles three chars.
  1303'                         VC_TILD:
  1303'   CD 059D'              	CALL	GETCNT
  1306'   CD 0610'              	CALL	SETLIN		; only this row changes
  1309'   CD 077D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  130C'   CD 0579'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  130F'   CA 060A'              	JZ	SETMOV
  1312'   CD 0584'              	CALL	CURCHR		; A = the char under the cursor
  1315'   FE 0D                 	CPI	CR
  1317'   CA 060A'              	JZ	SETMOV		; the line's end: nothing to toggle
  131A'   FE 0A                 	CPI	LF
  131C'   CA 060A'              	JZ	SETMOV
  131F'   47                    	MOV	B,A
  1320'   E6 DF                 	ANI	0DFH		; fold to the upper-case letter, if it is one
  1322'   FE 41                 	CPI	'A'
  1324'   DA 1330'              	JC	VT_PUT		; below 'A': no case
  1327'   FE 5B                 	CPI	'Z'+1
  1329'   D2 1330'              	JNC	VT_PUT		; above 'Z': no case
  132C'   78                    	MOV	A,B
  132D'   EE 20                 	XRI	20H		; a letter: flip the case bit
  132F'   47                    	MOV	B,A
  1330'                         VT_PUT:
  1330'   78                    	MOV	A,B
  1331'   32 2422'              	STA	VRCH		; the calls below do not preserve B
  1334'   CD 0188'              	CALL	MARKMOD
  1337'   21 0001               	LXI	H,1
  133A'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  133D'   3A 2422'              	LDA	VRCH
  1340'   CD 0000*              	CALL	PUTGAP		; the new one in its place; the cursor steps past
  1343'   C3 11AB'              	JMP	CLAMPE		; ... unless that was the line's last char
	MACRO-80 3.44	09-Dec-81	PAGE	1-63


                                
                                ;VC_R -- 'r': pending; the next char replaces the one under the cursor.  VICMD
                                ; routes that char to VR_DO before the count digits, so 'r3' stores '3' as vim
                                ; does.  An ESC drops it (an action key: VIC_ACT clears the pending state).
                                ; DEVIATION: a count is ignored -- vim's '3rx' replaces three chars, or refuses
                                ; when the line is shorter; and an arrow key clears the pending 'r' and moves,
                                ; where vim drops it.
  1346'                         VC_R:
  1346'   CD 058A'              	CALL	MOVCNT		; a cursor motion, and its count
  1349'   3E 03                 	MVI	A,PR
  134B'   32 2406'              	STA	GPEND
  134E'   C9                    	RET
                                
                                ;VR_DO -- the char in C replaces the one under the cursor.  Where there is no
                                ; char -- an empty line, the end of the file -- nothing happens at all, as in
                                ; vim.  A <CR> makes the char a line break instead (vim's 'r<CR>' splits the
                                ; line there), which changes the line count, so that case repaints in full.
  134F'                         VR_DO:
  134F'   AF                    	XRA	A
  1350'   32 2406'              	STA	GPEND
  1353'   79                    	MOV	A,C
  1354'   32 2422'              	STA	VRCH		; the calls below do not preserve C
  1357'   CD 0610'              	CALL	SETLIN		; only this row changed
  135A'   CD 077D'              	CALL	GLSTAL		; the goal column comes fresh from the cursor
  135D'   CD 0579'              	CALL	ATENDQ		; Z iff the cursor is at the end of the text
  1360'   CA 060A'              	JZ	SETMOV		; the end of the text: vim does nothing
  1363'   CD 0584'              	CALL	CURCHR		; A = the char under the cursor
  1366'   FE 0D                 	CPI	CR
  1368'   CA 060A'              	JZ	SETMOV		; the line's end: nothing to replace
  136B'   FE 0A                 	CPI	LF
  136D'   CA 060A'              	JZ	SETMOV
  1370'   CD 0188'              	CALL	MARKMOD
  1373'   21 0001               	LXI	H,1
  1376'   CD 0000*              	CALL	DELFWD		; the old char goes first: a delete never pages
  1379'   3A 2422'              	LDA	VRCH
  137C'   FE 0D                 	CPI	CR
  137E'   CA 138B'              	JZ	VR_CR
  1381'   CD 0000*              	CALL	PUTGAP		; the replacement in its place
  1384'   CD 0000*              	CALL	CUROFF		; fresh: the insert may have paged the window
  1387'   2B                    	DCX	H		;   out, which moves every logical offset
  1388'   C3 0000*              	JMP	GOTO		; back onto the replacement (tail)
  138B'                         VR_CR:
  138B'   CD 122F'              	CALL	OPNBRK		; 'r<CR>': the char becomes a line break -- the
  138E'   CD 1243'              	CALL	ENDBRK		;   replaced char may have been the text's last
  1391'   CD 0616'              	CALL	SETILN		;   row above it lost the char that was replaced,
  1394'   3E 01                 	MVI	A,1		;   so unlike 'o' and 'O' that row IS stale
  1396'   32 23E6'              	STA	ILABOV
  1399'   C9                    	RET
                                
                                ;VCB_R -- 'R': replace mode.  A count is ignored (DEVIATION, as VCB_A).
  139A'                         VCB_R:
  139A'   CD 059D'              	CALL	GETCNT
  139D'   CD 060A'              	CALL	SETMOV		; as SETINM: 'R' moves nothing and draws nothing
  13A0'   21 0000               	LXI	H,0
  13A3'   22 2423'              	SHLD	RPDEL		; nothing of ours to put back yet
  13A6'   22 2425'              	SHLD	RPAPP
	MACRO-80 3.44	09-Dec-81	PAGE	1-64


  13A9'   3E 02                 	MVI	A,EM_REP
  13AB'   32 23DE'              	STA	EDMODE
  13AE'   C9                    	RET
                                
                                ;VC_D -- 'd': arm the delete operator.  The next key is its motion (d{motion})
                                ; or a second 'd' (dd); VICDSP routes both to OPPEND on the following key.
  13AF'                         VC_D:
  13AF'   3E 64                 	MVI	A,'d'
  13B1'   32 2408'              	STA	PENDOP
  13B4'   C3 060A'              	JMP	SETMOV		; nothing drew -> cursor-only, not a full repaint
                                ;VC_C -- 'c': arm the change operator.  It shares d's span machinery; OPPEND
                                ; enters insert at the deletion point afterwards, remaps 'cw'/'cW' to 'ce'/'cE'
                                ; on a non-blank, and drops a linewise motion.  'cc' does nothing (OPLINE).
  13B7'                         VC_C:
  13B7'   3E 63                 	MVI	A,'c'
  13B9'   32 2408'              	STA	PENDOP
  13BC'   C3 060A'              	JMP	SETMOV
                                ;VD_DD -- 'dd': delete count whole lines (reached from OPLINE) into the yank
                                ; register.  WM's ^Y (KEYY, WM 3350) goes back to the line start and kills the
                                ; lines forward; here LNSTRT, then QPUTLN (WM QPUT's body) with the count
                                ; instead of SETC1.  QPUTLN is repeated while CNTTST says the count is not
                                ; spent (DELTO's PAGESTP has paged a step), as MVLLOOP repeats GOLINE, so a
                                ; count runs past the window.  WM's MRKCURE and
                                ; screen marks are left out (SCRN.MAC repaints).  vim, NOT WordMaster: a count
                                ; over 1 on the last line does nothing (vim's cursor_down fails there), a count
                                ; past the end deletes to it and lands on the new last line, and the cursor
                                ; goes to the first non-blank.
  13BF'                         VD_DD:
  13BF'   CD 077D'              	CALL	GLSTAL
  13C2'   CD 059D'              	CALL	GETCNT
  13C5'   22 2415'              	SHLD	CNTV
  13C8'   3E 00                 	MVI	A,0		; DDSNG = (count == 1) -> the DL fast-paint case
  13CA'   32 240A'              	STA	DDSNG
  13CD'   2B                    	DCX	H
  13CE'   7C                    	MOV	A,H
  13CF'   B5                    	ORA	L
  13D0'   C2 13DB'              	JNZ	VDD_LS
  13D3'   3E 01                 	MVI	A,1
  13D5'   32 240A'              	STA	DDSNG
  13D8'   C3 13E1'              	JMP	VDD_GO
  13DB'                         VDD_LS:
  13DB'   CD 0743'              	CALL	ONLAST		; vim: is this the last line?  (pages in, and it is
  13DE'   DA 060A'              	JC	SETMOV		;   the same question <CR> and 'j' ask) -- then a
                                				;   count over one does nothing at all
  13E1'                         VDD_GO:
  13E1'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  13E4'   CD 06C1'              	CALL	LNSTRT		; the WHOLE line is yanked, so start at its start.
                                				;   WM deleted BACKWARD to here instead (KEYU, WM
                                				;   3333), and a backward delete cannot reach the
                                				;   Q-buffer -- QCOPY's source is always GAPEND --
                                				;   so the line's head would be left out of it.
  13E7'   2A 2415'              	LHLD	CNTV
  13EA'   CD 0000*              	CALL	SETC0
  13ED'                         VDD_FW:
  13ED'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: the lines, into the register
  13F0'   CD 05B2'              	CALL	CNTTST
	MACRO-80 3.44	09-Dec-81	PAGE	1-65


  13F3'   C2 13ED'              	JNZ	VDD_FW
  13F6'   CD 0188'              	CALL	MARKMOD
  13F9'   CD 08B4'              	CALL	ATEOF
  13FC'   D2 1417'              	JNC	VDD_UP		; a line below moved up into the cursor's row
  13FF'   3E 00                 	MVI	A,0
  1401'   32 240A'              	STA	DDSNG		; deleted to the end: full repaint
  1404'   CD 0CFA'              	CALL	ONFST
  1407'   CA 06D8'              	JZ	FNBLNK		; nothing left before it
  140A'   21 0001               	LXI	H,1		; onto the new last line
  140D'   CD 0000*              	CALL	SETBWD
  1410'   2A 0000*              	LHLD	LNDLT
  1413'   2B                    	DCX	H
  1414'   22 0000*              	SHLD	LNDLT
  1417'                         VDD_UP:
  1417'   CD 06D8'              	CALL	FNBLNK
                                	;--- A single dd (not the last line) is the LNOP delete-line case: one
                                	;    DL + a bottom redraw. ---
  141A'   3A 240A'              	LDA	DDSNG
  141D'   B7                    	ORA	A
  141E'   C8                    	RZ			; Ndd -> keep the R_FULL default (full repaint)
  141F'   3E 03                 	MVI	A,R_DLIN
  1421'   32 23E3'              	STA	RINTENT
  1424'   C9                    	RET
                                
                                ;============================================================
                                ; YANK REGISTER  (yy Y p P)  -- the register itself is WM's Q-buffer, a second
                                ; gap buffer inside the arena (see BUF.MAC).  It is not a fixed block, so what
                                ; can be yanked is bounded by QROOM -- the arena less RESVMEM, with the text
                                ; paging out from underneath it -- and an overflow raises WM's 'QBUF FULL' with
                                ; what has already moved safely in the register.
                                ;
                                ; Linewise only: 'dd'/'yy' put whole lines in and 'p'/'P' put whole lines back.
                                ; A charwise register (from x / D / dw) would need a type flag beside it and is
                                ; NOT built -- which is why 'y' takes LINEWISE motions only ('y''a' 'yj' 'yG'
                                ; 'yH' 'yM' 'yL') and OPPEND turns every charwise one away.
                                ;
                                ; Recorded from vim (VIM_PUT in accept_vi.py): a count CLAMPS at the last line
                                ; rather than refusing, the cursor lands on the FIRST NON-BLANK of the FIRST
                                ; line put whatever the count, and 'yy' does not move the cursor at all.
                                ;============================================================
                                
                                ;QEMPTY -- Z iff nothing has been yanked (the Q-buffer is empty: QEND = QBEG).
  1425'                         QEMPTY:
  1425'   2A 0000*              	LHLD	QBEG
  1428'   EB                    	XCHG
  1429'   2A 0000*              	LHLD	QEND
  142C'   7C                    	MOV	A,H
  142D'   BA                    	CMP	D
  142E'   C0                    	RNZ
  142F'   7D                    	MOV	A,L
  1430'   BB                    	CMP	E
  1431'   C9                    	RET
                                
                                ;VC_Y -- 'y': arm the yank operator.  A second 'y' is the doubled linewise form
                                ; (OPPEND sends 'yy' to OPLINE); anything else is a motion, and OPPEND keeps the
                                ; linewise ones and turns the rest away.
	MACRO-80 3.44	09-Dec-81	PAGE	1-66


  1432'                         VC_Y:
  1432'   3E 79                 	MVI	A,'y'
  1434'   32 2408'              	STA	PENDOP
  1437'   C3 060A'              	JMP	SETMOV
                                
                                ;VY_YY -- 'yy' / 'Y': count whole lines into the register, the file unchanged.
                                ; The copy that leaves the lines where they are (YNCOPY, below) runs whenever
                                ; it can.  Where it cannot -- no room in the arena for the span, or a count
                                ; whose lines are not all in the resident text to be measured -- they are taken
                                ; out with dd's own engine and put straight back with QGET (YKGO), which leaves
                                ; the right text behind but has to hold everything else still while it runs and
                                ; repaint the screen whole afterwards.
  143A'                         VY_YY:
  143A'   CD 0000*              	CALL	CUROFF
  143D'   22 2446'              	SHLD	YOFF		; the cursor, which a yank leaves alone
  1440'   CD 04F6'              	CALL	BOL
  1443'   22 2448'              	SHLD	YPT		; where the lines come from, to put them back
  1446'   CD 1557'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1449'   CD 159A'              	CALL	YNCOPY		; copied where they lie, if that can be done
  144C'   D2 155E'              	JNC	YNDONE
  144F'   21 13BF'              	LXI	H,VD_DD		; the count's worth of them, dd's own engine
  1452'   C3 147E'              	JMP	YKGO
                                
                                ;OPYANK -- 'y{motion}' with a LINEWISE motion ('y''a', 'yj', 'yG', 'yH'): the
                                ; motion's whole lines into the register, the file unchanged.  Reached from
                                ; OPPEND with the span already measured into OPSTA/OPEND2.
                                ;
                                ; Recorded from vim: the cursor lands on the LOW endpoint exactly as the motion
                                ; left it -- 'y''a' takes the marked line's first non-blank because that is
                                ; where ''' itself lands, while 'yk' keeps the column it had.  So it is that
                                ; endpoint's offset, not the line's start.
  1455'                         OPYANK:
  1455'   CD 10C2'              	CALL	OPALSP		; OPLO = the low line's start, OPHI = past the high
  1458'   2A 240D'              	LHLD	OPSTA
  145B'   EB                    	XCHG			; DE = start
  145C'   2A 240F'              	LHLD	OPEND2		; HL = end
  145F'   CD 0000*              	CALL	CMP16		; CY iff start < end
  1462'   D2 1466'              	JNC	OPY_LO		; end <= start -> the END is the low endpoint
  1465'   EB                    	XCHG			; ... otherwise the start is
  1466'                         OPY_LO:
  1466'   22 2446'              	SHLD	YOFF
  1469'   2A 2411'              	LHLD	OPLO
  146C'   22 2448'              	SHLD	YPT		; where the lines come from, to put them back
  146F'   CD 1557'              	CALL	YNPRE		; the window it starts in, for YNDONE's paint
  1472'   CD 1612'              	CALL	YNSPAN		; copied where they lie, if there is room
  1475'   D2 155E'              	JNC	YNDONE
  1478'   21 151B'              	LXI	H,YSPAN
  147B'   C3 147E'              	JMP	YKGO
                                
                                ;YKGO -- HL = how this yank takes its lines out.  WordMaster has no copy-without-
                                ; delete (see the section head), so either way they come out and go straight
                                ; back, and everything a change would leave behind is put back with them.
  147E'                         YKGO:
  147E'   22 2468'              	SHLD	YACT
  1481'   2A 2448'              	LHLD	YPT		; how far INTO the lines being taken the cursor
  1484'   EB                    	XCHG			;   sits.  A logical offset (YOFF) does not
	MACRO-80 3.44	09-Dec-81	PAGE	1-67


  1485'   2A 2446'              	LHLD	YOFF		;   survive this -- the put-back below can page
  1488'   CD 0000*              	CALL	SUBHD		;   the window's top out and shift every one of
  148B'   22 246E'              	SHLD	YCOL		;   them -- but a distance within the lines does
  148E'   3A 23E2'              	LDA	MODF
  1491'   32 2443'              	STA	YMODF
  1494'   3A 23FB'              	LDA	DOTCHG		; ... and the '.' recorder's own change flag:
  1497'   32 2444'              	STA	YDCHG		;   a yank must not become the last change
  149A'   3A 0000*              	LDA	UNDRPL		; ... and undo's: the lines going out and coming
  149D'   32 2445'              	STA	YURPL		;   back are not a change to undo either
  14A0'   3E 01                 	MVI	A,1
  14A2'   32 0000*              	STA	UNDRPL
  14A5'   32 2467'              	STA	MKHOLD		; ... nor a change to drop a mark for: MKDROP
  14A8'   2A 0000*              	LHLD	LNDLT		; GOTO does not maintain this and VD_DD moves it
  14AB'   22 2451'              	SHLD	YLDLT
  14AE'   CD 0000*              	CALL	LOGLEN
  14B1'   22 246C'              	SHLD	YWAS		; ... and the text itself, to tell a yank that
                                				;   took lines from one that took none
  14B4'   2A 2468'              	LHLD	YACT
  14B7'   CD 151A'              	CALL	YCALL		; the lines out of the file, into the register
  14BA'   CD 0000*              	CALL	LOGLEN
  14BD'   EB                    	XCHG
  14BE'   2A 246C'              	LHLD	YWAS
  14C1'   CD 0000*              	CALL	CMP16		; Z iff the text is the length it was, so nothing
  14C4'   CA 14F2'              	JZ	YK_FIN		;   came out and there is nothing to put back --
                                				;   VD_DD refuses a count of more than one on the
                                				;   last line ('2yy' there), and putting the
                                				;   register back after THAT spliced whatever an
                                				;   earlier yank had left in it into the file.
                                				;   vim refuses it too, register untouched.
  14C7'   2A 2448'              	LHLD	YPT
  14CA'   CD 0000*              	CALL	GOTO
  14CD'   CD 0000*              	CALL	QGET		; and straight back in
                                	;--- Putting them back can PAGE: QGET splices the register through
                                	;    INSBLK, whose MKGAP reaches MKROOM when the arena is tight, and a
                                	;    spill writes the window's top out to disk -- which moves TXTBEG and
                                	;    shifts every logical offset under us, YOFF among them.  ('500yy' at
                                	;    line 2500 of a 40 K file spills 48 records and used to land the
                                	;    cursor 573 lines below where it started; a yank moves the cursor
                                	;    nowhere.)  So the cursor is found again from the lines THEMSELVES:
                                	;    QGET leaves it just past them, so they start at the cursor less the
                                	;    register's length, and the cursor was YCOL bytes into them.  Both
                                	;    terms are read AFTER the paging, so neither can be stale. ---
  14D0'   CD 0000*              	CALL	CUROFF		; where QGET left it: just past the lines
  14D3'   22 2470'              	SHLD	YBLK
  14D6'   2A 0000*              	LHLD	QBEG
  14D9'   EB                    	XCHG
  14DA'   2A 0000*              	LHLD	QEND
  14DD'   CD 0000*              	CALL	SUBHD		; HL = the register's length = what went back
  14E0'   EB                    	XCHG
  14E1'   2A 2470'              	LHLD	YBLK
  14E4'   CD 0000*              	CALL	SUBHD		; HL = where those lines start NOW
  14E7'   EB                    	XCHG
  14E8'   2A 246E'              	LHLD	YCOL
  14EB'   19                    	DAD	D		; ... and the cursor is YCOL into them
  14EC'   CD 0000*              	CALL	GOTO
  14EF'   C3 14F8'              	JMP	YK_RST
	MACRO-80 3.44	09-Dec-81	PAGE	1-68


  14F2'                         YK_FIN:				; nothing came out, so nothing was put back and
  14F2'   2A 2446'              	LHLD	YOFF		;   no offset can have shifted: the cursor is
  14F5'   CD 0000*              	CALL	GOTO		;   where it was
  14F8'                         YK_RST:
  14F8'   2A 2451'              	LHLD	YLDLT
  14FB'   22 0000*              	SHLD	LNDLT		; nothing moved: the cursor is on the row it was
  14FE'   3A 2443'              	LDA	YMODF
  1501'   32 23E2'              	STA	MODF
  1504'   3A 2444'              	LDA	YDCHG
  1507'   32 23FB'              	STA	DOTCHG
  150A'   3A 2445'              	LDA	YURPL
  150D'   32 0000*              	STA	UNDRPL
  1510'   AF                    	XRA	A
  1511'   32 2467'              	STA	MKHOLD
  1514'   CD 077D'              	CALL	GLSTAL
  1517'   C3 062B'              	JMP	SETFUL		; the cheap paint cannot carry this
  151A'   E9                    YCALL:	PCHL
                                
                                ;YSPAN -- the lines of [OPLO,OPHI) out of the file and into the register, one at
                                ; a time as 'dd' does it.  There is no line COUNT to drive the loop with here --
                                ; the span is a pair of offsets -- so it runs until the text is exactly the
                                ; span's length shorter than it was, and asks for ONE line a pass.
                                ;
                                ; That one line is not decoration: QPUTLN goes through WM's GOLINE, which takes
                                ; its count from CMDCNT and its DIRECTION from DIRFLG, and on a count of zero
                                ; decrements DIRFLG to FFH and walks BACKWARD -- into a QCOPY whose source is
                                ; always GAPEND.  VD_DD sets both with SETC0 before its own loop; this must too.
                                ; Asking for one line at a time also costs nothing when the window pages: GOLINE
                                ; stops short and leaves the rest in CMDCNT, and a short pass is just a pass
                                ; that moved fewer bytes, which the byte target below already allows for.
  151B'                         YSPAN:
  151B'   CD 077D'              	CALL	GLSTAL
  151E'   CD 1083'              	CALL	OPSPNL		; HL = the span's length
  1521'   22 246A'              	SHLD	YTGT
  1524'   CD 0000*              	CALL	LOGLEN		; HL = the text's length
  1527'   EB                    	XCHG			; DE = it
  1528'   2A 246A'              	LHLD	YTGT
  152B'   EB                    	XCHG			; HL = the text's, DE = the span's
  152C'   CD 0000*              	CALL	SUBHD
  152F'   22 246A'              	SHLD	YTGT		; what the text is left at when the span is out
  1532'   2A 2411'              	LHLD	OPLO
  1535'   CD 0000*              	CALL	GOTO
  1538'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  153B'                         YS_LP:
  153B'   21 0001               	LXI	H,1		; CMDCNT = 1 line, DIRFLG = forward (see above)
  153E'   CD 0000*              	CALL	SETC0
  1541'   CD 0000*              	CALL	QPUTLN		; WM 3355 / QPUT: that line, into the register
  1544'   CD 0000*              	CALL	LOGLEN
  1547'   EB                    	XCHG			; DE = what is left
  1548'   2A 246A'              	LHLD	YTGT
  154B'   CD 0000*              	CALL	CMP16		; Z iff it is down to the target
  154E'   DA 1554'              	JC	YS_END		; below it -- cannot happen over whole lines,
  1551'   C2 153B'              	JNZ	YS_LP		;   but never spin here if it ever did
  1554'                         YS_END:
  1554'   C3 0188'              	JMP	MARKMOD
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-69


                                ;============================================================
                                ; THE YANK THAT COPIES  (APPENDED -- NOT WordMaster, which has no verb for a
                                ; copy that does not delete, and until QCPYN neither had this.)
                                ;
                                ; Taking the lines out and putting them straight back (YKGO above) ends with
                                ; the right text, but everything ELSE has to be held still while it runs --
                                ; MODF, DOTCHG, UNDRPL, the marks, LNDLT -- and the screen repainted whole
                                ; afterwards, because the delete and the re-insert may have moved the window
                                ; under it.  That is 1467 characters, a second and a half at 9600 baud, spent
                                ; on a command that changed nothing at all.
                                ;
                                ; QCPYN (BUF.MAC) copies the span into the register and leaves the text where
                                ; it is, so none of that is owed and the paint is a cursor move: 13 characters.
                                ;
                                ; Two things have to hold first, and where either does not the old path runs
                                ; exactly as it did:
                                ;   * the span must fit in the arena's free space with a chunk to spare
                                ;     (YNROOM).  The copy must not reach MKROOM, which pages resident text out
                                ;     to disk -- and the text it would page out is the source being read.
                                ;   * 'yy' must be able to measure its count's lines in the resident text
                                ;     (YNLINE).  Past the window's end only the pager can say where they are.
                                ; On a file that fits in RAM both hold for any yank at all.  On a paged one
                                ; they hold for the small yanks and not the large: mid-file the arena runs to a
                                ; few hundred free bytes, so 'yy' copies where '20yy' is taken out and put back.
                                ;============================================================
                                
                                ;YNPRE -- remember which window the yank starts in, for YNDONE's paint test.
  1557'                         YNPRE:
  1557'   2A 0000*              	LHLD	PGTOPM
  155A'   22 2472'              	SHLD	YNPG
  155D'   C9                    	RET
                                
                                ;YNDONE -- the tail of a yank that copied: the cursor back where it started and
                                ; the cheapest paint there is.  Nothing else is owed -- the text was never
                                ; changed, so MODF, DOTCHG and UNDRPL were never disturbed, no mark was
                                ; dropped, and 'u' saw nothing go by.  The WINDOW is the one thing that could
                                ; still have moved (LNSTRT pages back to reach a line start the window has
                                ; cut), and PGTOPM is what says whether it did.
  155E'                         YNDONE:
  155E'   2A 2446'              	LHLD	YOFF
  1561'   CD 0000*              	CALL	GOTO
  1564'   2A 0000*              	LHLD	PGTOPM
  1567'   EB                    	XCHG
  1568'   2A 2472'              	LHLD	YNPG
  156B'   CD 0000*              	CALL	CMP16		; DE = the window now vs HL = the one it began in
  156E'   C2 062B'              	JNZ	SETFUL		; it moved under us: repaint after all
  1571'   C3 060A'              	JMP	SETMOV		; nothing on the screen changed
                                
                                ;YNROOM -- HL = a span: NC if the register can take a copy of it without the
                                ; pager being reached, CY if not.  MKGAP pages only once the free space in the
                                ; WHOLE arena is under one chunk (256 bytes), and the copy takes that free
                                ; space as it goes, so what must be free when it starts is the span plus a
                                ; chunk.  BUFSUM is the arena's holes: the gap, the tail above TXTEND, and
                                ; whatever the regions below the text are not using.
  1574'                         YNROOM:
  1574'   11 0100               	LXI	D,100H
	MACRO-80 3.44	09-Dec-81	PAGE	1-70


  1577'   19                    	DAD	D
  1578'   D8                    	RC			; within a chunk of 64K: no arena holds that
  1579'   E5                    	PUSH	H		; the span plus its slack
  157A'   CD 0000*              	CALL	BUFSUM		; DE = the free bytes (BC and HL are kept)
  157D'   EB                    	XCHG			; HL = free
  157E'   D1                    	POP	D		; DE = the span plus its slack
  157F'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff it fits, Z iff it just fits
  1582'   DA 158A'              	JC	YNR_OK
  1585'   CA 158A'              	JZ	YNR_OK
  1588'   37                    	STC			; not enough: the delete-and-put-back path
  1589'   C9                    	RET
  158A'                         YNR_OK:
  158A'   B7                    	ORA	A		; NC: there is room to copy it where it lies
  158B'   C9                    	RET
                                
                                ;YNGO -- BC = the span at the cursor: the count spent, the goal column stale as
                                ; dd leaves it, and the register replaced by a copy of the span.  The text is
                                ; not touched.
  158C'                         YNGO:
  158C'   C5                    	PUSH	B
  158D'   CD 059D'              	CALL	GETCNT		; spent here: this yank is happening
  1590'   CD 077D'              	CALL	GLSTAL
  1593'   CD 0000*              	CALL	QKILL		; these lines become the register, not the last
  1596'   C1                    	POP	B
  1597'   C3 0000*              	JMP	QCPYN
                                
                                ;YNCOPY -- 'yy' where the lines lie: NC when the register holds the count's
                                ; lines, or deliberately does not (vim refuses a count over one on the last
                                ; line, and that refusal IS the whole command); CY when this yank has to be
                                ; taken out and put back after all.  The cursor is left at the line's start --
                                ; YNDONE puts it back.
                                ;
                                ; The refusal is ONLAST's answer -- the question 'dd' and '<CR>' already ask:
                                ; is there a line below this one?  It reads ahead THROUGH the pager, so it is
                                ; answered the same wherever the window happens to end, and the walk below is
                                ; left with nothing to decide but where the count clamps.
  159A'                         YNCOPY:
  159A'   2A 23DF'              	LHLD	CMDCNT		; PEEKED, not spent: a fall back to VD_DD reads
  159D'   7C                    	MOV	A,H		;   the count itself
  159E'   B5                    	ORA	L
  159F'   C2 15A5'              	JNZ	YNC_HV
  15A2'   21 0001               	LXI	H,1
  15A5'                         YNC_HV:
  15A5'   7D                    	MOV	A,L		; a count of one always has its own line to take;
  15A6'   3D                    	DCR	A		;   a count over one has to have the NEXT one
  15A7'   B4                    	ORA	H
  15A8'   CA 15B3'              	JZ	YNC_M
  15AB'   E5                    	PUSH	H
  15AC'   CD 0743'              	CALL	ONLAST		; vim: a count over one on the last line does
  15AF'   E1                    	POP	H		;   nothing at all, and leaves the register alone
  15B0'   DA 15C5'              	JC	YNC_RF
  15B3'                         YNC_M:
  15B3'   E5                    	PUSH	H
  15B4'   CD 06C1'              	CALL	LNSTRT		; the WHOLE line is yanked: start at its start
  15B7'   E1                    	POP	H
  15B8'   CD 15CD'              	CALL	YNLINE		; BC = the span, measured where it stands
	MACRO-80 3.44	09-Dec-81	PAGE	1-71


  15BB'   D8                    	RC			; not measurable here: let the pager answer it
  15BC'   60                    	MOV	H,B
  15BD'   69                    	MOV	L,C
  15BE'   CD 1574'              	CALL	YNROOM		; room to copy it where it lies?  (BC kept)
  15C1'   D8                    	RC			; no: the delete-and-put-back path
  15C2'   C3 158C'              	JMP	YNGO
  15C5'                         YNC_RF:
  15C5'   CD 059D'              	CALL	GETCNT		; refused: vim does nothing and leaves the
  15C8'   CD 077D'              	CALL	GLSTAL		;   register alone, and that is the command
  15CB'   B7                    	ORA	A		; NC: done
  15CC'   C9                    	RET
                                
                                ;YNLINE -- HL = the count: the span 'yy' takes, measured in the RESIDENT text
                                ; alone.  The cursor is at the line's start, so the span starts at GAPEND and
                                ; the measure is a walk up to TXTEND -- no CHARAT, no logical offsets, and
                                ; nothing that could page.  Returns BC = the span's length and NC; or CY, and
                                ; then the count's lines are not all here to be measured: the text ran out with
                                ; some of the file still unread, and only the pager can say where they end.
                                ; Running out with the file fully READ is not a no -- vim clamps a count at the
                                ; last line, and the one count that refuses instead never reaches here.
  15CD'                         YNLINE:
  15CD'   22 2474'              	SHLD	YNCNT		; the lines it still wants
  15D0'   2A 0000*              	LHLD	GAPEND
  15D3'                         YNL_LP:
  15D3'   EB                    	XCHG			; DE = the scan
  15D4'   2A 0000*              	LHLD	TXTEND
  15D7'   CD 0000*              	CALL	CMP16		; DE vs HL: CY iff the scan is short of the end
  15DA'   EB                    	XCHG			; HL = the scan
  15DB'   D2 15FB'              	JNC	YNL_EN		; the resident text ran out
  15DE'   7E                    	MOV	A,M
  15DF'   23                    	INX	H
  15E0'   FE 0A                 	CPI	LF
  15E2'   C2 15D3'              	JNZ	YNL_LP
  15E5'   E5                    	PUSH	H
  15E6'   2A 2474'              	LHLD	YNCNT
  15E9'   2B                    	DCX	H
  15EA'   22 2474'              	SHLD	YNCNT
  15ED'   7C                    	MOV	A,H
  15EE'   B5                    	ORA	L
  15EF'   E1                    	POP	H
  15F0'   C2 15D3'              	JNZ	YNL_LP
                                	;--- every line of the count is here: the span is what was walked ---
  15F3'   EB                    	XCHG			; DE = past the last of them
  15F4'   2A 0000*              	LHLD	GAPEND
  15F7'   EB                    	XCHG			; HL = past them, DE = GAPEND
  15F8'   C3 1609'              	JMP	YNL_BC
  15FB'                         YNL_EN:				; HL = TXTEND: the resident text ran out here
  15FB'   CD 0000*              	CALL	INRDY		; NZ while any of the file is still unread, and
  15FE'   C2 1610'              	JNZ	YNL_NO		;   then what is past the window is not knowable
  1601'   2A 0000*              	LHLD	TXTEND		; ... otherwise the file ends here too, and the
  1604'   EB                    	XCHG			;   count clamps to it as vim's does
  1605'   2A 0000*              	LHLD	GAPEND
  1608'   EB                    	XCHG			; HL = TXTEND, DE = GAPEND
  1609'                         YNL_BC:
  1609'   CD 0000*              	CALL	SUBHD		; HL = the span
  160C'   44                    	MOV	B,H
	MACRO-80 3.44	09-Dec-81	PAGE	1-72


  160D'   4D                    	MOV	C,L
  160E'   B7                    	ORA	A		; NC (SUBHD's DAD leaves the carry set)
  160F'   C9                    	RET
  1610'                         YNL_NO:
  1610'   37                    	STC
  1611'   C9                    	RET
                                
                                ;YNSPAN -- 'y{motion}' where the lines lie: the span [OPLO,OPHI) copied.  NC
                                ; when it is in the register, CY when there is no room for it and the delete-
                                ; and-put-back path has to run.  OPALSP measured the span in resident text
                                ; already, so there is no question here of where it ends -- only of room.
  1612'                         YNSPAN:
  1612'   CD 1083'              	CALL	OPSPNL		; HL = the span's length
  1615'   44                    	MOV	B,H
  1616'   4D                    	MOV	C,L		; BC = it, the way QCPYN wants it (YNROOM keeps BC)
  1617'   CD 1574'              	CALL	YNROOM
  161A'   D8                    	RC			; no room: the delete-and-put-back path
  161B'   C5                    	PUSH	B		; GOTO's LFCNT takes BC, so the span rides the stack
  161C'   2A 2411'              	LHLD	OPLO
  161F'   CD 0000*              	CALL	GOTO		; the span starts at the cursor, as QCPYN wants
  1622'   C1                    	POP	B
  1623'   C3 158C'              	JMP	YNGO
                                
                                ;VC_P -- 'p': the register's lines in AFTER the cursor's line, count copies.
                                ;VCB_P -- 'P': the same, in BEFORE the cursor's line.
                                ; Both land the cursor on the first non-blank of the first line put.
  1626'                         VC_P:
  1626'   CD 1425'              	CALL	QEMPTY
  1629'   CA 16E1'              	JZ	VP_BEL
  162C'   CD 059D'              	CALL	GETCNT
  162F'   22 244A'              	SHLD	PCNT
  1632'   CD 0000*              	CALL	CUROFF
  1635'   CD 0526'              	CALL	NLSTART		; after the cursor's LINE -- a linewise put
  1638'   C3 164D'              	JMP	VP_GO
  163B'                         VCB_P:
  163B'   CD 1425'              	CALL	QEMPTY
  163E'   CA 16E1'              	JZ	VP_BEL
  1641'   CD 059D'              	CALL	GETCNT
  1644'   22 244A'              	SHLD	PCNT
  1647'   CD 0000*              	CALL	CUROFF
  164A'   CD 04F6'              	CALL	BOL
  164D'                         VP_GO:
  164D'   CD 0000*              	CALL	GOTO
                                	;--- appending past a last line that has no terminator on it: vim's put
                                	;    still makes a new line, so the missing break goes in first ---
  1650'   CD 0000*              	CALL	CUROFF
  1653'   EB                    	XCHG
  1654'   CD 0000*              	CALL	LOGLEN		; (DE preserved)
  1657'   CD 0000*              	CALL	CMP16		; CY iff the put point is before the end
  165A'   DA 166F'              	JC	VP_IN
  165D'   EB                    	XCHG			; HL = the put point = LOGLEN
  165E'   7C                    	MOV	A,H
  165F'   B5                    	ORA	L
  1660'   CA 166C'              	JZ	VP_BRK		; an EMPTY buffer: vim still has one (empty) line
                                				;   there, and the put goes AFTER it
  1663'   2B                    	DCX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-73


  1664'   CD 0000*              	CALL	CHARAT
  1667'   FE 0A                 	CPI	LF
  1669'   CA 166F'              	JZ	VP_IN
  166C'                         VP_BRK:
  166C'   CD 122F'              	CALL	OPNBRK		; (which counts the cursor a line lower itself)
  166F'                         VP_IN:
  166F'   CD 0000*              	CALL	CUROFF
  1672'   22 244C'              	SHLD	PPT		; the first line put: where the cursor ends
                                	;--- GOTO maintains LNDLT by counting the line feeds the cursor crosses
                                	;    (BUF.MAC), but INSBLK does not: the put leaves the cursor past
                                	;    every line it inserted without saying so, and the GOTO back to the
                                	;    first line put would then subtract lines LNDLT never gained.  So
                                	;    the register's own line count is added for each copy put. ---
  1675'   2A 0000*              	LHLD	QBEG
  1678'   EB                    	XCHG
  1679'   2A 0000*              	LHLD	QEND
  167C'   CD 0000*              	CALL	LFCNT		; DE = the lines in the register
  167F'   EB                    	XCHG
  1680'   22 244E'              	SHLD	PLFS
  1683'   2A 244A'              	LHLD	PCNT		; the copies, kept for the paint: the loop below
  1686'   7C                    	MOV	A,H		;   counts PCNT down to nothing.  A count that
  1687'   B7                    	ORA	A		;   does not fit a byte leaves PCPY 0, and the
  1688'   3E 00                 	MVI	A,0		;   put keeps the full repaint (MVI keeps flags)
  168A'   C2 168E'              	JNZ	VP_PZ
  168D'   7D                    	MOV	A,L
  168E'                         VP_PZ:
  168E'   32 2450'              	STA	PCPY
  1691'                         VP_LP:
  1691'   CD 0000*              	CALL	QGET		; a count puts the register that many times
  1694'   2A 0000*              	LHLD	LNDLT
  1697'   EB                    	XCHG
  1698'   2A 244E'              	LHLD	PLFS
  169B'   19                    	DAD	D
  169C'   22 0000*              	SHLD	LNDLT		; the cursor is past the lines this copy put
  169F'   2A 244A'              	LHLD	PCNT
  16A2'   2B                    	DCX	H
  16A3'   22 244A'              	SHLD	PCNT
  16A6'   7C                    	MOV	A,H
  16A7'   B5                    	ORA	L
  16A8'   C2 1691'              	JNZ	VP_LP
  16AB'   CD 0188'              	CALL	MARKMOD
  16AE'   2A 244C'              	LHLD	PPT
  16B1'   CD 0000*              	CALL	GOTO		; back to the first line put -- and GOTO's own
                                				;   arithmetic now has the lines to subtract
  16B4'   CD 077D'              	CALL	GLSTAL
                                	;--- the put opened whole lines at the cursor's row, which is the same
                                	;    thing 'o' does, only more of them: ask for that paint with the
                                	;    count.  Too many to count in a byte -> the full repaint stands,
                                	;    and at that size it is the cheaper frame anyway. ---
  16B7'   3A 2450'              	LDA	PCPY
  16BA'   B7                    	ORA	A
  16BB'   CA 06D8'              	JZ	FNBLNK
  16BE'   2A 244E'              	LHLD	PLFS
  16C1'   7C                    	MOV	A,H
  16C2'   B7                    	ORA	A
  16C3'   C2 06D8'              	JNZ	FNBLNK
	MACRO-80 3.44	09-Dec-81	PAGE	1-74


  16C6'   3A 2450'              	LDA	PCPY
  16C9'   CD 0C90'              	CALL	MULSAT		; HL = the lines this put put, saturated
  16CC'   7C                    	MOV	A,H
  16CD'   B7                    	ORA	A
  16CE'   C2 06D8'              	JNZ	FNBLNK
  16D1'   7D                    	MOV	A,L
  16D2'   B7                    	ORA	A
  16D3'   CA 06D8'              	JZ	FNBLNK
  16D6'   F5                    	PUSH	PSW
  16D7'   CD 0616'              	CALL	SETILN		; R_ILIN, and ILN = 1 ...
  16DA'   F1                    	POP	PSW
  16DB'   32 23E4'              	STA	ILN		; ... which the lines put now replace
  16DE'   C3 06D8'              	JMP	FNBLNK
  16E1'                         VP_BEL:
  16E1'   CD 059D'              	CALL	GETCNT		; the count is spent either way
  16E4'   0E 07                 	MVI	C,BEL
  16E6'   CD 0000*              	CALL	BCONOU
  16E9'   C3 060A'              	JMP	SETMOV
                                
                                ;============================================================
                                ; INSERT MODE
                                ;============================================================
                                ; REPLACE MODE ('R') -- vim's Replace mode; WordMaster has no such mode.
                                ; A typed char overwrites the one under the cursor: PUTGAP puts it in and a
                                ; one-byte DELFWD takes the old one, which leaves that old char inside the gap,
                                ; just below GAPEND -- a forward delete only moves the pointer past it.  At the
                                ; line's end (its CR / LF, or the end of the text) there is nothing to overwrite
                                ; and the char is appended instead, as vim does.
                                ; BS walks back over what was typed, in reverse: an appended char is deleted
                                ; (RPAPP counts those), an overwritten one is deleted and its original put back
                                ; with BUF.MAC's UNDELF (RPDEL counts those).  RPGE holds GAPEND as it was left
                                ; by the last overwrite; if it no longer matches, an insert has had to relocate
                                ; the text and the originals are not where UNDELF would look, so they are given
                                ; up rather than got wrong.
                                ; DEVIATIONS: a BS with nothing of ours left stops at the line's start, where
                                ; vim goes on to the line above; and a line break typed in R ends what BS can
                                ; put back (vim rejoins it).  Neither loses or corrupts text.
                                ;============================================================
                                
                                ;VIREP -- one key in replace mode.  B = KT type, C = char/action.
  16EC'                         VIREP:
  16EC'   78                    	MOV	A,B
  16ED'   FE 01                 	CPI	KT_ACT
  16EF'   CA 181C'              	JZ	VI_ACT		; ESC: command mode, the cursor steps left
  16F2'   FE 02                 	CPI	KT_CHAR
  16F4'   C0                    	RNZ			; ignore anything else
  16F5'   79                    	MOV	A,C
  16F6'   FE 0D                 	CPI	CR
  16F8'   CA 175C'              	JZ	VP_CR
  16FB'   FE 0A                 	CPI	LF		; ^J is a newline too, as in insert
  16FD'   CA 175C'              	JZ	VP_CR
  1700'   FE 08                 	CPI	BS
  1702'   CA 1768'              	JZ	VP_BS
  1705'   FE 7F                 	CPI	DEL
  1707'   CA 1768'              	JZ	VP_BS
  170A'   32 2422'              	STA	VRCH		; the calls below do not preserve C
	MACRO-80 3.44	09-Dec-81	PAGE	1-75


  170D'   CD 0610'              	CALL	SETLIN		; this row changed
  1710'   CD 0188'              	CALL	MARKMOD
  1713'   CD 1222'              	CALL	ATCEND		; the line's end: nothing there to overwrite
  1716'   CA 174E'              	JZ	VP_APP
                                	;--- overwrite: the new char in, the old one into the gap ---
  1719'   3A 2422'              	LDA	VRCH
  171C'   CD 0000*              	CALL	PUTGAP		; may have had to relocate the text
  171F'   2A 2423'              	LHLD	RPDEL
  1722'   7C                    	MOV	A,H
  1723'   B5                    	ORA	L
  1724'   CA 173A'              	JZ	VP_OVW		; nothing held yet -> nothing to lose
  1727'   2A 0000*              	LHLD	GAPEND
  172A'   EB                    	XCHG
  172B'   2A 2427'              	LHLD	RPGE
  172E'   CD 0000*              	CALL	CMP16		; Z iff the gap is where the last overwrite left it
  1731'   CA 173A'              	JZ	VP_OVW
  1734'   21 0000               	LXI	H,0
  1737'   22 2423'              	SHLD	RPDEL		; the text moved: those originals are gone
  173A'                         VP_OVW:
  173A'   21 0001               	LXI	H,1
  173D'   CD 0000*              	CALL	DELFWD		; the old char, still in the gap below GAPEND
  1740'   2A 0000*              	LHLD	GAPEND
  1743'   22 2427'              	SHLD	RPGE
  1746'   2A 2423'              	LHLD	RPDEL
  1749'   23                    	INX	H
  174A'   22 2423'              	SHLD	RPDEL
  174D'   C9                    	RET
  174E'                         VP_APP:
  174E'   3A 2422'              	LDA	VRCH
  1751'   CD 0000*              	CALL	PUTGAP		; past the line's end: vim appends
  1754'   2A 2425'              	LHLD	RPAPP
  1757'   23                    	INX	H
  1758'   22 2425'              	SHLD	RPAPP
  175B'   C9                    	RET
  175C'                         VP_CR:
  175C'   21 0000               	LXI	H,0
  175F'   22 2423'              	SHLD	RPDEL		; a line break ends what BS can put back
  1762'   22 2425'              	SHLD	RPAPP
  1765'   C3 17F2'              	JMP	VI_CR		; tail: the newline goes in as in insert mode
  1768'                         VP_BS:
  1768'   2A 2425'              	LHLD	RPAPP
  176B'   7C                    	MOV	A,H
  176C'   B5                    	ORA	L
  176D'   CA 177A'              	JZ	VP_BSD
  1770'   2B                    	DCX	H
  1771'   22 2425'              	SHLD	RPAPP		; an appended char: it just goes
  1774'   CD 0610'              	CALL	SETLIN
  1777'   C3 0000*              	JMP	DELPRV
  177A'                         VP_BSD:
  177A'   2A 2423'              	LHLD	RPDEL
  177D'   7C                    	MOV	A,H
  177E'   B5                    	ORA	L
  177F'   CA 17A6'              	JZ	VP_BSM		; nothing of ours left
  1782'   2A 0000*              	LHLD	GAPEND
  1785'   EB                    	XCHG
  1786'   2A 2427'              	LHLD	RPGE
	MACRO-80 3.44	09-Dec-81	PAGE	1-76


  1789'   CD 0000*              	CALL	CMP16		; the gap moved -> the originals are gone
  178C'   C2 17A6'              	JNZ	VP_BSM
  178F'   2A 2423'              	LHLD	RPDEL
  1792'   2B                    	DCX	H
  1793'   22 2423'              	SHLD	RPDEL
  1796'   CD 0610'              	CALL	SETLIN
  1799'   CD 0000*              	CALL	DELPRV		; the typed char goes
  179C'   CD 0000*              	CALL	UNDELF		; the original comes back
  179F'   2A 0000*              	LHLD	GAPEND
  17A2'   22 2427'              	SHLD	RPGE
  17A5'   C9                    	RET
  17A6'                         VP_BSM:
  17A6'   CD 060A'              	CALL	SETMOV		; nothing changed: back over the text as it is
  17A9'   C3 0679'              	JMP	HSTEP
                                
                                ;============================================================
                                
                                ;VIINS -- one key in insert mode.  B = KT type, C = char/action.
  17AC'                         VIINS:
  17AC'   78                    	MOV	A,B
  17AD'   FE 01                 	CPI	KT_ACT
  17AF'   CA 181C'              	JZ	VI_ACT
  17B2'   FE 02                 	CPI	KT_CHAR
  17B4'   C0                    	RNZ			; ignore anything else
  17B5'   79                    	MOV	A,C
  17B6'   FE 0D                 	CPI	CR
  17B8'   CA 17F2'              	JZ	VI_CR
  17BB'   FE 0A                 	CPI	LF		; ^J is a newline too (a bare LF would break the row paint)
  17BD'   CA 17F2'              	JZ	VI_CR
  17C0'   FE 08                 	CPI	BS
  17C2'   CA 180A'              	JZ	VI_BS
  17C5'   FE 7F                 	CPI	DEL
  17C7'   CA 180A'              	JZ	VI_BS
  17CA'   79                    	MOV	A,C
  17CB'   CD 0000*              	CALL	PUTGAP		; insert the byte at the cursor
  17CE'   CD 0188'              	CALL	MARKMOD
  17D1'   CD 0610'              	CALL	SETLIN		; base: this row changed -> whole-line redraw
                                	;--- can the cheaper ICH be used?  Only a plain printable char whose line
                                	;    has no TAB after the cursor (a following tab's expansion would shift,
                                	;    so a one-cell ICH would be wrong); else keep the whole-line R_LINE. ---
  17D4'   79                    	MOV	A,C
  17D5'   FE 20                 	CPI	' '
  17D7'   D8                    	RC			; control char -> keep R_LINE
  17D8'   FE 7F                 	CPI	DEL
  17DA'   D0                    	RNC			; DEL / high bytes -> keep R_LINE
  17DB'   CD 0631'              	CALL	TAILTAB		; A = 1 if a TAB is in the tail
  17DE'   B7                    	ORA	A
  17DF'   C0                    	RNZ			; tab after cursor -> keep R_LINE
  17E0'   3E 04                 	MVI	A,R_ICH
  17E2'   32 23E3'              	STA	RINTENT
                                	;--- and does the row need a cell opened at all?  ICH (ESC[1@) exists to
                                	;    shift the rest of the row right, out of the way; with nothing after
                                	;    the cursor there is nothing to shift, and the char typed into the
                                	;    blank cell where it already belongs IS the whole update -- one byte
                                	;    on the wire instead of a cell-open, an address and a hide/show. ---
  17E5'   CD 1222'              	CALL	ATCEND		; NZ: text follows on the row -> open a cell
	MACRO-80 3.44	09-Dec-81	PAGE	1-77


  17E8'   3E 00                 	MVI	A,0
  17EA'   C2 17EE'              	JNZ	VI_ICH
  17ED'   3C                    	INR	A
  17EE'                         VI_ICH:
  17EE'   32 23E5'              	STA	ICHAPP
  17F1'   C9                    	RET
  17F2'                         VI_CR:
                                	;--- a <CR> ends the row it was typed on.  If text followed the cursor,
                                	;    that text goes down to the new row and the row left behind is a
                                	;    shorter line -> it must be redrawn; typed at the line's end it keeps
                                	;    every char it had and the opened row is all the paint there is. ---
  17F2'   CD 1222'              	CALL	ATCEND
  17F5'   3E 00                 	MVI	A,0
  17F7'   CA 17FB'              	JZ	VI_CRS
  17FA'   3C                    	INR	A
  17FB'                         VI_CRS:
  17FB'   F5                    	PUSH	PSW
  17FC'   CD 122F'              	CALL	OPNBRK		; a verbatim newline: CR,LF, a line further down
  17FF'   CD 1243'              	CALL	ENDBRK		;   -- and its own terminator if it ends the text
  1802'   CD 0616'              	CALL	SETILN		;   -- one row opens, the rest of the screen stands
  1805'   F1                    	POP	PSW
  1806'   32 23E6'              	STA	ILABOV
  1809'   C9                    	RET
                                ;VI_BS -- BS / DEL: WM's RUBOUT (DELPRV).  vim, NOT WordMaster's insert ^H
                                ;(which stops at the line start): BS joins lines and goes back past where the
                                ;insert began (backspace=indent,eol,start).
  180A'                         VI_BS:
  180A'   CD 0000*              	CALL	PEEKL
  180D'   D8                    	RC			; start of the file: nothing to delete
  180E'   FE 0A                 	CPI	LF		; a LF behind the cursor: this BS joins the line
  1810'   CA 1816'              	JZ	VI_BSJ		;   onto the one above, so the line count changes
  1813'   CD 0610'              	CALL	SETLIN		;   and the screen repaints in full.  Any other
  1816'                         VI_BSJ:				;   char is inside the row -- redraw just that row
  1816'   CD 0188'              	CALL	MARKMOD
  1819'   C3 0000*              	JMP	DELPRV
                                ;VI_ACT -- ESC: back to command mode.  Nothing is inserted and nothing is
                                ; deleted -- the cursor steps one left -- so this is a cursor reposition, not
                                ; a repaint.  (What the row shows does not change: the mode word is MODEMS's,
                                ; and a cursor sitting on a TAB moves to the tab's last column, which is where
                                ; SCRN.MAC's own TABCUR puts it for a command-mode frame.)
  181C'                         VI_ACT:
  181C'   79                    	MOV	A,C
  181D'   FE 0B                 	CPI	ACT_ESC
  181F'   C0                    	RNZ			; ignore arrows etc. in insert (minimal)
  1820'   3E 00                 	MVI	A,EM_CMD
  1822'   32 23DE'              	STA	EDMODE
  1825'   CD 060A'              	CALL	SETMOV
  1828'   CD 0679'              	CALL	HSTEP		; vi: cursor steps left on leaving insert
  182B'   C3 077D'              	JMP	GLSTAL
                                
                                ;============================================================
                                ; EX LINE  (:w :q :wq :x :e)
                                ;============================================================
                                
                                ;RDLINE -- WM RDLINE (WM 5870), cut down for the ':' and '/' lines: read a line
                                ; into (DE), max B chars, until CR, on the bottom row after the prompt char in C.
	MACRO-80 3.44	09-Dec-81	PAGE	1-78


                                ; Each char stored is echoed (WM CONOUTC); BS drops the last one and erases it
                                ; (WM LINEPOP + BSCHAR).  On return: A = 0 for a completed line (length in
                                ; RLLEN), A = 0FFH if cancelled.
                                ; vim, NOT WordMaster: DEL erases like BS (WM echoes the dropped char); BS or DEL
                                ; on an empty line cancels, as ESC does, and a cancel blanks the row, prompt
                                ; char and all; a control char is ignored (WM stores it and shows ^X).  WM's
                                ; ^X ^U ^\ ^R ^E ^C line edits are not kept.
  182E'                         RDLINE:
  182E'   EB                    	XCHG			; HL = buffer
  182F'   22 2429'              	SHLD	RLPTR
  1832'   3E 00                 	MVI	A,0
  1834'   32 242B'              	STA	RLLEN
  1837'   78                    	MOV	A,B
  1838'   32 242C'              	STA	RLMAX
  183B'   79                    	MOV	A,C
  183C'   CD 0000*              	CALL	EXPRM		; bottom row cleared, prompt shown
  183F'                         RL_LP:
  183F'   CD 0000*              	CALL	GETKEY
  1842'   78                    	MOV	A,B
  1843'   FE 01                 	CPI	KT_ACT
  1845'   CA 189B'              	JZ	RL_ACT
  1848'   FE 02                 	CPI	KT_CHAR
  184A'   C2 183F'              	JNZ	RL_LP		; ignore other keys
  184D'   79                    	MOV	A,C
  184E'   FE 0D                 	CPI	CR
  1850'   CA 18AC'              	JZ	RL_DONE
  1853'   FE 08                 	CPI	BS
  1855'   CA 1883'              	JZ	RL_BS
  1858'   FE 7F                 	CPI	DEL
  185A'   CA 1883'              	JZ	RL_BS
  185D'   FE 20                 	CPI	' '
  185F'   DA 183F'              	JC	RL_LP		; control char -> ignore
  1862'   3A 242B'              	LDA	RLLEN
  1865'   47                    	MOV	B,A
  1866'   3A 242C'              	LDA	RLMAX
  1869'   B8                    	CMP	B
  186A'   CA 183F'              	JZ	RL_LP		; full -> ignore
  186D'   2A 2429'              	LHLD	RLPTR
  1870'   71                    	MOV	M,C
  1871'   23                    	INX	H
  1872'   22 2429'              	SHLD	RLPTR
  1875'   3A 242B'              	LDA	RLLEN
  1878'   3C                    	INR	A
  1879'   32 242B'              	STA	RLLEN
  187C'   79                    	MOV	A,C
  187D'   CD 0000*              	CALL	OUTCH		; WM CONOUTC: echo it
  1880'   C3 183F'              	JMP	RL_LP
  1883'                         RL_BS:				; WM LINEPOP
  1883'   3A 242B'              	LDA	RLLEN
  1886'   B7                    	ORA	A
  1887'   CA 18A1'              	JZ	RL_CAN		; vim: BS on an empty line cancels
  188A'   3D                    	DCR	A
  188B'   32 242B'              	STA	RLLEN
  188E'   2A 2429'              	LHLD	RLPTR
  1891'   2B                    	DCX	H
  1892'   22 2429'              	SHLD	RLPTR
	MACRO-80 3.44	09-Dec-81	PAGE	1-79


  1895'   CD 0000*              	CALL	EXRUB		; WM BSCHAR
  1898'   C3 183F'              	JMP	RL_LP
  189B'                         RL_ACT:
  189B'   79                    	MOV	A,C
  189C'   FE 0B                 	CPI	ACT_ESC
  189E'   C2 183F'              	JNZ	RL_LP
  18A1'                         RL_CAN:
  18A1'   3E 20                 	MVI	A,' '		; vim: the cancelled line goes, its prompt char too
  18A3'   CD 0000*              	CALL	EXPRM		;   (the row cleared, a blank where the prompt was)
  18A6'   CD 0610'              	CALL	SETLIN		; redraw one row
  18A9'   3E FF                 	MVI	A,0FFH		; cancelled
  18AB'   C9                    	RET
  18AC'                         RL_DONE:
  18AC'   AF                    	XRA	A
  18AD'   C9                    	RET
                                
                                ;VC_BZ -- 'Z': pending; ZZ writes a changed text and quits -- vim's ZZ, which
                                ; is ':x' (so no '!' and no file name: a buffer with none says so).  A count is
                                ; ignored.  Only a second 'Z' may follow (VICDSP drops any other key, as vim
                                ; does); 'g' pending drops this one the same way.  DEVIATION: an action key
                                ; (arrow/PgUp/PgDn -- no vi key of its own) clears the pending 'Z' and runs,
                                ; where vim would drop it; VIC_ACT clears the pending state before dispatch.
  18AE'                         VC_BZ:
  18AE'   CD 060A'              	CALL	SETMOV
  18B1'   3A 2407'              	LDA	GSAVE
  18B4'   FE 02                 	CPI	PZ
  18B6'   CA 18C1'              	JZ	VZ_ZZ
  18B9'   B7                    	ORA	A
  18BA'   C0                    	RNZ			; 'g' was pending: vim drops both
  18BB'   3E 02                 	MVI	A,PZ
  18BD'   32 2406'              	STA	GPEND
  18C0'   C9                    	RET
  18C1'                         VZ_ZZ:
  18C1'   3E 04                 	MVI	A,EO_X
  18C3'   32 242D'              	STA	EXOP
  18C6'   3E 01                 	MVI	A,1
  18C8'   32 2440'              	STA	EXBANG		; no '!'
  18CB'   AF                    	XRA	A
  18CC'   32 242E'              	STA	EXARG		; no file name
  18CF'   3A 23E2'              	LDA	MODF		; as ':x': a changed text is written first
  18D2'   B7                    	ORA	A
  18D3'   CA 19F6'              	JZ	EX_Q
  18D6'   C3 1990'              	JMP	EX_W
                                
                                ;VC_EX -- ':' ex line: a command, an optional '!', an optional file name.
                                ;   :w [name]   write (the buffer's own file keeps a .BAK, as WM's save does)
                                ;   :q          quit; a changed text needs '!'
                                ;   :wq [name]  write, then quit
                                ;   :x [name]   write only a changed text, then quit
                                ;   :e [name]   edit that file, or the buffer's own again at the same line;
                                ;               a changed text needs '!'
                                ;   :ve         the version, on the bottom row
                                ; vim, NOT WordMaster: vim's commands and messages (without the Enn number),
                                ; shown on the bottom row when a command fails.  A buffer without a name (no
                                ; file on the command line) takes the first name written to (vim's cpo-F);
                                ; a write to another name leaves the buffer's name and changed flag alone.
	MACRO-80 3.44	09-Dec-81	PAGE	1-80


  18D9'                         VC_EX:
  18D9'   CD 059D'              	CALL	GETCNT
  18DC'   CD 0000*              	CALL	CLRCNT		; WM KEYESC/CMDSCAN: command line runs forward
  18DF'   11 0000*              	LXI	D,EXBUF
  18E2'   06 28                 	MVI	B,EXMAX
  18E4'   0E 3A                 	MVI	C,':'
  18E6'   CD 182E'              	CALL	RDLINE
  18E9'   B7                    	ORA	A
  18EA'   C0                    	RNZ			; cancelled
  18EB'   3A 242B'              	LDA	RLLEN
  18EE'   5F                    	MOV	E,A
  18EF'   16 00                 	MVI	D,0
  18F1'   21 0000*              	LXI	H,EXBUF
  18F4'   19                    	DAD	D
  18F5'   36 00                 	MVI	M,0		; the line ends with a 0
  18F7'   21 0000*              	LXI	H,EXBUF
  18FA'   CD 1C92'              	CALL	SKIPB
  18FD'   C8                    	RZ			; nothing on it
  18FE'   22 2430'              	SHLD	EXCMD
  1901'   CD 1E2F'              	CALL	EXADDR		; an optional line range first (':%s', ':N,Ms')
  1904'   CD 1C92'              	CALL	SKIPB		; blanks between the range and the command name
                                	;--- the command: one or two lower-case letters, looked up in EXTAB ---
  1907'   56                    	MOV	D,M
  1908'   23                    	INX	H
  1909'   1E 00                 	MVI	E,0
  190B'   CD 1C9E'              	CALL	ISLOW
  190E'   DA 1919'              	JC	EX_LK
  1911'   5F                    	MOV	E,A
  1912'   23                    	INX	H
  1913'   CD 1C9E'              	CALL	ISLOW
  1916'   D2 1932'              	JNC	EX_NOT		; a third letter: none of ours
  1919'                         EX_LK:
  1919'   E5                    	PUSH	H
  191A'   21 1E19'              	LXI	H,EXTAB
  191D'                         EX_TL:
  191D'   7E                    	MOV	A,M
  191E'   B7                    	ORA	A
  191F'   CA 1931'              	JZ	EX_NTP		; not in the table
  1922'   23                    	INX	H
  1923'   BA                    	CMP	D
  1924'   7E                    	MOV	A,M
  1925'   23                    	INX	H
  1926'   C2 192D'              	JNZ	EX_TN
  1929'   BB                    	CMP	E
  192A'   CA 1938'              	JZ	EX_TF
  192D'                         EX_TN:
  192D'   23                    	INX	H
  192E'   C3 191D'              	JMP	EX_TL
  1931'                         EX_NTP:
  1931'   E1                    	POP	H
  1932'                         EX_NOT:
  1932'   21 1D56'              	LXI	H,SNOT
  1935'   C3 1CD3'              	JMP	EXERT
  1938'                         EX_TF:
  1938'   7E                    	MOV	A,M
  1939'   32 242D'              	STA	EXOP
	MACRO-80 3.44	09-Dec-81	PAGE	1-81


  193C'   E1                    	POP	H
  193D'   FE 06                 	CPI	EO_S
  193F'   CA 1E9E'              	JZ	EX_S		; ':s' reads the rest of the line itself
  1942'   3A 247D'              	LDA	SRNGF
  1945'   B7                    	ORA	A
  1946'   C2 1932'              	JNZ	EX_NOT		; a range on a command that does not take one
                                	;--- '!', then the file name ---
  1949'   7E                    	MOV	A,M
  194A'   D6 21                 	SUI	'!'
  194C'   32 2440'              	STA	EXBANG		; 0 = '!'
  194F'   C2 1953'              	JNZ	EX_NB
  1952'   23                    	INX	H
  1953'                         EX_NB:
  1953'   CD 1C92'              	CALL	SKIPB
  1956'   32 242E'              	STA	EXARG		; 0 = no file name
  1959'   CA 1972'              	JZ	EX_RUN
  195C'   22 2430'              	SHLD	EXCMD
  195F'   3A 242D'              	LDA	EXOP
  1962'   FE 02                 	CPI	EO_Q
  1964'   CA 1CD0'              	JZ	EX_TRL		; :q takes none
  1967'   FE 07                 	CPI	EO_V
  1969'   CA 1CD0'              	JZ	EX_TRL		; nor :ve
  196C'   CD 1BFC'              	CALL	PARSFN
  196F'   C2 1CC4'              	JNZ	EX_INV
  1972'                         EX_RUN:
  1972'   3A 242D'              	LDA	EXOP
  1975'   FE 05                 	CPI	EO_E
  1977'   CA 1A0D'              	JZ	EX_E
  197A'   FE 02                 	CPI	EO_Q
  197C'   CA 19F6'              	JZ	EX_Q
  197F'   FE 07                 	CPI	EO_V
  1981'   CA 1CCA'              	JZ	EX_V
  1984'   FE 04                 	CPI	EO_X
  1986'   C2 1990'              	JNZ	EX_W
  1989'   3A 23E2'              	LDA	MODF		; :x writes only a changed text
  198C'   B7                    	ORA	A
  198D'   CA 19F6'              	JZ	EX_Q
  1990'                         EX_W:
  1990'   CD 1A64'              	CALL	WRCHK		; TFCB = the target, A = keep a backup
  1993'   D8                    	RC			; refused (message shown)
  1994'   32 242F'              	STA	EXBAK
  1997'   3A 242D'              	LDA	EXOP
  199A'   FE 01                 	CPI	EO_W
  199C'   CA 19B3'              	JZ	EX_WK
  199F'   3A 242F'              	LDA	EXBAK
  19A2'   B7                    	ORA	A
  19A3'   C2 19F3'              	JNZ	EX_WQ		; the buffer's own file: the quit goes through
  19A6'   3A 2440'              	LDA	EXBANG
  19A9'   B7                    	ORA	A
  19AA'   CA 19F3'              	JZ	EX_WQ		; so it does with '!'
  19AD'   CD 19B3'              	CALL	EX_WK		; else it may not: keep the text
  19B0'   C3 19F6'              	JMP	EX_Q
                                ;EX_WK -- write, then keep editing where the cursor was.
  19B3'                         EX_WK:
  19B3'   CD 0B9C'              	CALL	CURRW		; the cursor's row and file position
  19B6'   32 2432'              	STA	WPROW
	MACRO-80 3.44	09-Dec-81	PAGE	1-82


  19B9'   CD 0000*              	CALL	CUROFF		; HL = bytes past TXTBEG
  19BC'   7D                    	MOV	A,L
  19BD'   E6 7F                 	ANI	7FH
  19BF'   32 2433'              	STA	WPBYT
  19C2'   7D                    	MOV	A,L
  19C3'   17                    	RAL
  19C4'   7C                    	MOV	A,H
  19C5'   17                    	RAL
  19C6'   5F                    	MOV	E,A
  19C7'   3E 00                 	MVI	A,0
  19C9'   17                    	RAL
  19CA'   57                    	MOV	D,A		; DE = HL / 128
  19CB'   2A 0000*              	LHLD	OUTPOS
  19CE'   19                    	DAD	D
  19CF'   22 2434'              	SHLD	WPREC		; its record (OUTPOS = records before TXTBEG)
  19D2'   CD 1A99'              	CALL	WRITE
  19D5'   CD 0000*              	CALL	REOPEN		; the file just written, from its start
  19D8'   2A 2434'              	LHLD	WPREC
  19DB'   EB                    	XCHG
  19DC'   3A 2433'              	LDA	WPBYT
  19DF'   CD 0000*              	CALL	SEEKTO		; HL = the old position in the new window
  19E2'   CD 0000*              	CALL	GOTO
  19E5'   21 0000               	LXI	H,0
  19E8'   22 0000*              	SHLD	LNDLT
  19EB'   3A 2432'              	LDA	WPROW
  19EE'   6F                    	MOV	L,A
  19EF'   22 0000*              	SHLD	WINROW		; the cursor's line back on its row
  19F2'   C9                    	RET
  19F3'                         EX_WQ:
  19F3'   CD 1A99'              	CALL	WRITE		; :wq / :x -- nothing to come back to
  19F6'                         EX_Q:
  19F6'   3A 2440'              	LDA	EXBANG
  19F9'   B7                    	ORA	A
  19FA'   CA 1A04'              	JZ	EX_QT
  19FD'   3A 23E2'              	LDA	MODF
  1A00'   B7                    	ORA	A
  1A01'   C2 1CB8'              	JNZ	MSGNWR		; changed, no '!': stay
  1A04'                         EX_QT:
  1A04'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1A07'   3E 01                 	MVI	A,1
  1A09'   32 23E1'              	STA	QUITF
  1A0C'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1A0D'                         EX_E:
  1A0D'   3A 2440'              	LDA	EXBANG
  1A10'   B7                    	ORA	A
  1A11'   CA 1A1B'              	JZ	EE_GO
  1A14'   3A 23E2'              	LDA	MODF
  1A17'   B7                    	ORA	A
  1A18'   C2 1CB8'              	JNZ	MSGNWR
  1A1B'                         EE_GO:
  1A1B'   3A 242E'              	LDA	EXARG
  1A1E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-83


  1A1F'   C2 1A26'              	JNZ	EE_ARG
  1A22'   CD 1AD5'              	CALL	OWNTF		; no name: the buffer's own
  1A25'   D8                    	RC
  1A26'                         EE_ARG:
  1A26'   CD 1AEB'              	CALL	ISOWN
  1A29'   21 0001               	LXI	H,1
  1A2C'   C2 1A33'              	JNZ	EE_LD		; another file: its first line
  1A2F'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1A32'   23                    	INX	H		; HL = the cursor's line
  1A33'                         EE_LD:
  1A33'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1A35'   32 243E'              	STA	MSGWHT
  1A38'   E5                    	PUSH	H
  1A39'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1A3C'   21 0000*              	LXI	H,TFCB
  1A3F'   11 0000*              	LXI	D,FNAME
  1A42'   CD 1AFD'              	CALL	COPY12		; the buffer's name
  1A45'   CD 1AC2'              	CALL	SRCTF
  1A48'   CD 0000*              	CALL	REOPEN
  1A4B'   CD 020E'              	CALL	MKCLR		; the marks named the buffer that just went
  1A4E'   AF                    	XRA	A
  1A4F'   32 23E2'              	STA	MODF
  1A52'   E1                    	POP	H
  1A53'   2B                    	DCX	H
  1A54'   AF                    	XRA	A
  1A55'   CD 0000*              	CALL	MVLIND		; down to the line
  1A58'   CD 08B4'              	CALL	ATEOF
  1A5B'   DC 08BA'              	CC	LASTLN		; past the last line: onto it
  1A5E'   CD 0DBB'              	CALL	ZSAVE
  1A61'   C3 0EA4'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1A64'                         WRCHK:
  1A64'   3A 242E'              	LDA	EXARG
  1A67'   B7                    	ORA	A
  1A68'   C2 1A72'              	JNZ	WC_ARG
  1A6B'   CD 1AD5'              	CALL	OWNTF
  1A6E'   D8                    	RC
  1A6F'   C3 1A87'              	JMP	WC_OWN
  1A72'                         WC_ARG:
  1A72'   CD 1AEB'              	CALL	ISOWN
  1A75'   CA 1A87'              	JZ	WC_OWN
  1A78'   3A 2440'              	LDA	EXBANG
  1A7B'   B7                    	ORA	A
  1A7C'   CA 1A85'              	JZ	WC_OTH
  1A7F'   CD 0000*              	CALL	TEXIST
  1A82'   C2 1CAC'              	JNZ	MSGEXI		; File exists (! to force)
  1A85'                         WC_OTH:
  1A85'   AF                    	XRA	A		; (NC)
  1A86'   C9                    	RET
  1A87'                         WC_OWN:
  1A87'   3A 2441'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1A8A'   B7                    	ORA	A
  1A8B'   CA 1A95'              	JZ	WC_OK
	MACRO-80 3.44	09-Dec-81	PAGE	1-84


  1A8E'   3A 2440'              	LDA	EXBANG
  1A91'   B7                    	ORA	A
  1A92'   C2 1CB2'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1A95'                         WC_OK:
  1A95'   3E 01                 	MVI	A,1
  1A97'   B7                    	ORA	A		; (NC)
  1A98'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1A99'                         WRITE:
  1A99'   3A 242F'              	LDA	EXBAK
  1A9C'   CD 0000*              	CALL	WRTO
  1A9F'   3A 0001*              	LDA	FNAME+1
  1AA2'   FE 20                 	CPI	' '
  1AA4'   C2 1AB0'              	JNZ	WR_HAS
  1AA7'   21 0000*              	LXI	H,TFCB
  1AAA'   11 0000*              	LXI	D,FNAME
  1AAD'   CD 1AFD'              	CALL	COPY12
  1AB0'                         WR_HAS:
  1AB0'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1AB2'   32 243E'              	STA	MSGWHT
  1AB5'   CD 1AEB'              	CALL	ISOWN
  1AB8'   C2 1AC2'              	JNZ	SRCTF
  1ABB'   AF                    	XRA	A
  1ABC'   32 23E2'              	STA	MODF
  1ABF'   32 243F'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1AC2'                         SRCTF:
  1AC2'   21 0000*              	LXI	H,TFCB
  1AC5'   11 005C               	LXI	D,DFTFCB
  1AC8'   CD 1AFD'              	CALL	COPY12
  1ACB'   AF                    	XRA	A
  1ACC'   06 04                 	MVI	B,4
  1ACE'                         SRC_Z:
  1ACE'   12                    	STAX	D		; extent, s1, s2, record count: 0
  1ACF'   13                    	INX	D
  1AD0'   05                    	DCR	B
  1AD1'   C2 1ACE'              	JNZ	SRC_Z
  1AD4'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1AD5'                         OWNTF:
  1AD5'   3A 0001*              	LDA	FNAME+1
  1AD8'   FE 20                 	CPI	' '
  1ADA'   CA 1CA6'              	JZ	MSGNFN
  1ADD'   CD 1B08'              	CALL	TFCLR
  1AE0'   21 0000*              	LXI	H,FNAME
  1AE3'   11 0000*              	LXI	D,TFCB
  1AE6'   CD 1AFD'              	CALL	COPY12
  1AE9'   B7                    	ORA	A		; (NC)
  1AEA'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1AEB'                         ISOWN:
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AEB'   21 0000*              	LXI	H,TFCB
  1AEE'   11 0000*              	LXI	D,FNAME
  1AF1'   06 0C                 	MVI	B,12
  1AF3'                         IO_LP:
  1AF3'   1A                    	LDAX	D
  1AF4'   BE                    	CMP	M
  1AF5'   C0                    	RNZ
  1AF6'   23                    	INX	H
  1AF7'   13                    	INX	D
  1AF8'   05                    	DCR	B
  1AF9'   C2 1AF3'              	JNZ	IO_LP
  1AFC'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1AFD'                         COPY12:
  1AFD'   06 0C                 	MVI	B,12
  1AFF'                         CP_LP:
  1AFF'   7E                    	MOV	A,M
  1B00'   12                    	STAX	D
  1B01'   23                    	INX	H
  1B02'   13                    	INX	D
  1B03'   05                    	DCR	B
  1B04'   C2 1AFF'              	JNZ	CP_LP
  1B07'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1B08'                         TFCLR:
  1B08'   11 0000*              	LXI	D,TFCB
  1B0B'   06 24                 	MVI	B,36
  1B0D'   AF                    	XRA	A
  1B0E'                         TC_LP:
  1B0E'   12                    	STAX	D
  1B0F'   13                    	INX	D
  1B10'   05                    	DCR	B
  1B11'   C2 1B0E'              	JNZ	TC_LP
  1B14'   C9                    	RET
                                
                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1B15'                         FOPEN:
  1B15'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1B17'   32 243E'              	STA	MSGWHT
  1B1A'   21 005C               	LXI	H,DFTFCB
  1B1D'   CD 1BEF'              	CALL	NRMDRV
  1B20'   11 0000*              	LXI	D,FNAME
  1B23'   CD 1AFD'              	CALL	COPY12
  1B26'   CD 0000*              	CALL	OPENZ
  1B29'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1B2C'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1B2E'   C8                    	RZ
  1B2F'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1B32'   32 243F'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1B35'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1B36'                         ARGSCN:
  1B36'   3A 0080               	LDA	CMDTAIL
  1B39'   47                    	MOV	B,A		; B = what is left of the line
  1B3A'   B7                    	ORA	A
  1B3B'   C8                    	RZ
  1B3C'   21 0081               	LXI	H,CMDTAIL+1
  1B3F'                         AS_TOK:				; at a token, or the blanks before one
  1B3F'   7E                    	MOV	A,M
  1B40'   FE 20                 	CPI	' '
  1B42'   C2 1B4B'              	JNZ	AS_OPT
  1B45'   23                    	INX	H
  1B46'   05                    	DCR	B
  1B47'   C2 1B3F'              	JNZ	AS_TOK
  1B4A'   C9                    	RET
  1B4B'                         AS_OPT:
  1B4B'   FE 2B                 	CPI	'+'
  1B4D'   CA 1B77'              	JZ	AS_PLS
  1B50'   FE 2D                 	CPI	'-'
  1B52'   CA 1B66'              	JZ	AS_SW
  1B55'   FE 2F                 	CPI	'/'
  1B57'   CA 1B66'              	JZ	AS_SW
  1B5A'                         AS_SKP:				; not ours (the file name): on to the next one
  1B5A'   23                    	INX	H
  1B5B'   05                    	DCR	B
  1B5C'   C8                    	RZ
  1B5D'   7E                    	MOV	A,M
  1B5E'   FE 20                 	CPI	' '
  1B60'   C2 1B5A'              	JNZ	AS_SKP
  1B63'   C3 1B3F'              	JMP	AS_TOK
  1B66'                         AS_SW:
  1B66'   23                    	INX	H
  1B67'   05                    	DCR	B
  1B68'   C8                    	RZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


  1B69'   7E                    	MOV	A,M
  1B6A'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1B6C'   FE 52                 	CPI	'R'
  1B6E'   C2 1B5A'              	JNZ	AS_SKP
  1B71'   32 2441'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1B74'   C3 1B5A'              	JMP	AS_SKP
  1B77'                         AS_PLS:
  1B77'   3E 01                 	MVI	A,1
  1B79'   32 2442'              	STA	PLUSF		; '+' gets the line even with no number on it
  1B7C'   11 0000*              	LXI	D,PLUSB
  1B7F'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1B81'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1B82'   05                    	DCR	B
  1B83'   CA 1BBA'              	JZ	AS_PE
  1B86'   7E                    	MOV	A,M
  1B87'   FE 30                 	CPI	'0'
  1B89'   C2 1BA1'              	JNZ	AS_PD
  1B8C'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1B8C'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1B8D'   05                    	DCR	B
  1B8E'   CA 1BC2'              	JZ	AS_P1
  1B91'   7E                    	MOV	A,M
  1B92'   FE 30                 	CPI	'0'
  1B94'   CA 1B8C'              	JZ	AS_PZ
  1B97'   FE 31                 	CPI	'1'
  1B99'   DA 1BC2'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1B9C'   FE 3A                 	CPI	'9'+1
  1B9E'   D2 1BC2'              	JNC	AS_P1
  1BA1'                         AS_PD:				; the digits, as typed
  1BA1'   7E                    	MOV	A,M
  1BA2'   FE 30                 	CPI	'0'
  1BA4'   DA 1BBA'              	JC	AS_PE
  1BA7'   FE 3A                 	CPI	'9'+1
  1BA9'   D2 1BBA'              	JNC	AS_PE
  1BAC'   79                    	MOV	A,C
  1BAD'   B7                    	ORA	A
  1BAE'   CA 1BC9'              	JZ	AS_POV
  1BB1'   0D                    	DCR	C
  1BB2'   7E                    	MOV	A,M
  1BB3'   12                    	STAX	D
  1BB4'   13                    	INX	D
  1BB5'   23                    	INX	H
  1BB6'   05                    	DCR	B
  1BB7'   C2 1BA1'              	JNZ	AS_PD
  1BBA'                         AS_PE:
  1BBA'   AF                    	XRA	A
  1BBB'   12                    	STAX	D		; the digits end with a 0
  1BBC'   78                    	MOV	A,B
  1BBD'   B7                    	ORA	A
  1BBE'   C8                    	RZ
  1BBF'   C3 1B3F'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1BC2'                         AS_P1:
  1BC2'   3E 31                 	MVI	A,'1'
  1BC4'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BC5'   13                    	INX	D
  1BC6'   C3 1BBA'              	JMP	AS_PE
  1BC9'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1BC9'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1BCC'   C3 1BBA'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1BCF'                         ARGGO:
  1BCF'   3A 2442'              	LDA	PLUSF
  1BD2'   B7                    	ORA	A
  1BD3'   C8                    	RZ
  1BD4'   21 0000*              	LXI	H,PLUSB
  1BD7'                         AG_LP:
  1BD7'   7E                    	MOV	A,M
  1BD8'   B7                    	ORA	A
  1BD9'   CA 1BE8'              	JZ	AG_G
  1BDC'   4F                    	MOV	C,A
  1BDD'   06 02                 	MVI	B,KT_CHAR
  1BDF'   E5                    	PUSH	H
  1BE0'   CD 001F'              	CALL	VICMD
  1BE3'   E1                    	POP	H
  1BE4'   23                    	INX	H
  1BE5'   C3 1BD7'              	JMP	AG_LP
  1BE8'                         AG_G:
  1BE8'   0E 47                 	MVI	C,'G'
  1BEA'   06 02                 	MVI	B,KT_CHAR
  1BEC'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1BEF'                         NRMDRV:
  1BEF'   7E                    	MOV	A,M
  1BF0'   B7                    	ORA	A
  1BF1'   C0                    	RNZ
  1BF2'   E5                    	PUSH	H
  1BF3'   0E 19                 	MVI	C,BF_CURDSK
  1BF5'   CD 0005               	CALL	BDOS
  1BF8'   E1                    	POP	H
  1BF9'   3C                    	INR	A
  1BFA'   77                    	MOV	M,A
  1BFB'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1BFC'                         PARSFN:
  1BFC'   CD 1B08'              	CALL	TFCLR
  1BFF'   11 0000*              	LXI	D,TFCB
  1C02'   23                    	INX	H
  1C03'   7E                    	MOV	A,M
  1C04'   2B                    	DCX	H
  1C05'   FE 3A                 	CPI	':'
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C07'   C2 1C19'              	JNZ	PF_NM
  1C0A'   CD 1C5F'              	CALL	GETFNC
  1C0D'   CA 1C19'              	JZ	PF_NM
  1C10'   D6 40                 	SUI	40H
  1C12'   12                    	STAX	D
  1C13'   FE 11                 	CPI	17
  1C15'   D2 1C3D'              	JNC	PF_BAD
  1C18'   23                    	INX	H
  1C19'                         PF_NM:
  1C19'   13                    	INX	D
  1C1A'   0E 08                 	MVI	C,8
  1C1C'   CD 1C41'              	CALL	CPYNAM
  1C1F'   FE 2E                 	CPI	'.'
  1C21'   0E 03                 	MVI	C,3
  1C23'   C4 1C54'              	CNZ	PADFLD		; no type: blanks
  1C26'   CC 1C40'              	CZ	CPYNM0		; '.': the type
  1C29'   3A 0001*              	LDA	TFCB+1
  1C2C'   FE 20                 	CPI	' '
  1C2E'   CA 1C3D'              	JZ	PF_BAD		; no name
  1C31'   CD 1C92'              	CALL	SKIPB
  1C34'   C0                    	RNZ			; more after it
  1C35'   21 0000*              	LXI	H,TFCB
  1C38'   CD 1BEF'              	CALL	NRMDRV
  1C3B'   AF                    	XRA	A
  1C3C'   C9                    	RET
  1C3D'                         PF_BAD:
  1C3D'   F6 01                 	ORI	1
  1C3F'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1C40'                         CPYNM0:
  1C40'   23                    	INX	H
  1C41'                         CPYNAM:
  1C41'   CD 1C5F'              	CALL	GETFNC
  1C44'   CA 1C54'              	JZ	PADFLD
  1C47'   12                    	STAX	D
  1C48'   13                    	INX	D
  1C49'   0D                    	DCR	C
  1C4A'   C2 1C41'              	JNZ	CPYNAM
  1C4D'                         CN_SKP:
  1C4D'   CD 1C5F'              	CALL	GETFNC
  1C50'   C2 1C4D'              	JNZ	CN_SKP
  1C53'   C9                    	RET
  1C54'                         PADFLD:
  1C54'   F5                    	PUSH	PSW
  1C55'                         PD_LP:
  1C55'   3E 20                 	MVI	A,' '
  1C57'   12                    	STAX	D
  1C58'   13                    	INX	D
  1C59'   0D                    	DCR	C
  1C5A'   C2 1C55'              	JNZ	PD_LP
  1C5D'   F1                    	POP	PSW
  1C5E'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1C5F'                         GETFNC:
  1C5F'   7E                    	MOV	A,M
  1C60'   FE 3D                 	CPI	'='
  1C62'   C8                    	RZ
  1C63'   FE 5F                 	CPI	'_'
  1C65'   C8                    	RZ
  1C66'   FE 3B                 	CPI	';'
  1C68'   C8                    	RZ
  1C69'   FE 3C                 	CPI	'<'
  1C6B'   C8                    	RZ
  1C6C'   FE 3E                 	CPI	'>'
  1C6E'   C8                    	RZ
  1C6F'   FE 2E                 	CPI	'.'
  1C71'   C8                    	RZ
  1C72'   FE 3A                 	CPI	':'
  1C74'   C8                    	RZ
  1C75'   FE 2A                 	CPI	'*'
  1C77'   C8                    	RZ
  1C78'   FE 3F                 	CPI	'?'
  1C7A'   C8                    	RZ
  1C7B'   FE 20                 	CPI	' '
  1C7D'   DA 1C90'              	JC	GF_CTL
  1C80'   C8                    	RZ
  1C81'   23                    	INX	H
  1C82'   FE 61                 	CPI	'a'
  1C84'   DA 1C8E'              	JC	GF_DN
  1C87'   FE 7B                 	CPI	'z'+1
  1C89'   D2 1C8E'              	JNC	GF_DN
  1C8C'   E6 DF                 	ANI	0DFH
  1C8E'                         GF_DN:
  1C8E'   B7                    	ORA	A
  1C8F'   C9                    	RET
  1C90'                         GF_CTL:
  1C90'   BF                    	CMP	A
  1C91'   C9                    	RET
                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1C92'                         SKIPB:
  1C92'   7E                    	MOV	A,M
  1C93'   FE 20                 	CPI	' '
  1C95'   C2 1C9C'              	JNZ	SB_DN
  1C98'   23                    	INX	H
  1C99'   C3 1C92'              	JMP	SKIPB
  1C9C'                         SB_DN:
  1C9C'   B7                    	ORA	A
  1C9D'   C9                    	RET
                                
