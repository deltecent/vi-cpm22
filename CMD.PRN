  08FC'   EB                    	XCHG			; HL = limit
  08FD'                         KC_N:
  08FD'   22 24BF'              	SHLD	JKN		; N = min(count, limit)
  0900'   EB                    	XCHG			; DE = LFs to find
  0901'   21 0000               	LXI	H,0
  0904'   22 24C3'              	SHLD	JKBK		; scan position, as bytes back from GAPBEG
  0907'                         KC_ED:
  0907'   D5                    	PUSH	D		; HL = the scan position, BC = bytes to TXTBEG
  0908'   2A 24C3'              	LHLD	JKBK
  090B'   CD 0652'              	CALL	GBSUB		; HL = GAPBEG - that pointer
  090E'   E5                    	PUSH	H
