  099A'   19                    	DAD	D
  099B'   C3 0000*              	JMP	GOTO
                                
                                ;============================================================
                                ; MOTIONS -- word (w b W B; e E below)
                                ;
                                ; vim, NOT WordMaster: vim 9.1's fwd_word / bck_word, which step the cursor one
                                ; position at a time (inc_cursor / dec_cursor) over vim's classes (CLASSF:
                                ; blanks; letters, digits and '_'; other chars; W/B make every non-blank one
                                ; class) and stop on an empty line.  WM's ^F / ^A only skip letters and digits.
                                ; The steps are WM's: forward reads with RGET (paged in) and back with PEEKL
                                ; (paged back), and PUTCUR moves the cursor each step, so a count runs through
                                ; the whole file.  A line's end (its CR,LF, or the end of the file) is vim's
                                ; NUL position; the cursor is left there only on an empty line.
                                ;============================================================
  099E'   AF                    VC_W:	XRA	A
  099F'   32 245E'              	STA	WBIG
  09A2'   C3 09AA'              	JMP	WDO
  09A5'   3E 01                 VCBGW:	MVI	A,1
  09A7'   32 245E'              	STA	WBIG
  09AA'   CD 0672'              WDO:	CALL	SETMOV
  09AD'   AF                    	XRA	A
  09AE'   32 245F'              	STA	WPULL		; see OPA_EX: did this w/W end off a line's end?
  09B1'   CD 0605'              	CALL	GETCNT
  09B4'   22 248A'              	SHLD	CNTV
  09B7'   2A 248A'              WDO_LP: LHLD	CNTV
  09BA'   7C                    	MOV	A,H
  09BB'   B5                    	ORA	L
  09BC'   CA 09C9'              	JZ	WDO_DN
  09BF'   2B                    	DCX	H
  09C0'   22 248A'              	SHLD	CNTV
  09C3'   CD 0A19'              	CALL	FWD1
  09C6'   D2 09B7'              	JNC	WDO_LP
	MACRO-80 3.44	09-Dec-81	PAGE	1-35


  09C9'                         WDO_DN:
  09C9'   CD 091C'              	CALL	ATEOF		; not left on a line's end (vim adjust_cursor)
  09CC'   DA 09D9'              	JC	WDO_NL
  09CF'   FE 0D                 	CPI	CR
  09D1'   CA 09D9'              	JZ	WDO_NL
  09D4'   FE 0A                 	CPI	LF
  09D6'   C2 04F7'              	JNZ	SETGL
  09D9'                         WDO_NL:
  09D9'   CD 0000*              	CALL	PEEKL
  09DC'   DA 04F7'              	JC	SETGL
  09DF'   FE 0A                 	CPI	LF
  09E1'   CA 04F7'              	JZ	SETGL		; an empty line is a word: the cursor stays on it
  09E4'   3E 01                 	MVI	A,1		; the landing is pulled back off the line's end,
  09E6'   32 245F'              	STA	WPULL		;   which an operator span must NOT be (OPA_EX)
  09E9'   CD 0B14'              	CALL	DECC		; back onto its last char
  09EC'   C3 04F7'              	JMP	SETGL
                                
  09EF'   AF                    VC_B:	XRA	A
  09F0'   32 245E'              	STA	WBIG
  09F3'   C3 09FB'              	JMP	BDO
  09F6'   3E 01                 VCBGB:	MVI	A,1
  09F8'   32 245E'              	STA	WBIG
  09FB'   CD 0672'              BDO:	CALL	SETMOV
  09FE'   CD 0605'              	CALL	GETCNT
  0A01'   22 248A'              	SHLD	CNTV
  0A04'   2A 248A'              BDO_LP: LHLD	CNTV
  0A07'   7C                    	MOV	A,H
  0A08'   B5                    	ORA	L
  0A09'   CA 04F7'              	JZ	SETGL
  0A0C'   2B                    	DCX	H
  0A0D'   22 248A'              	SHLD	CNTV
  0A10'   CD 0A65'              	CALL	BCK1
  0A13'   D2 0A04'              	JNC	BDO_LP
  0A16'   C3 04F7'              	JMP	SETGL
                                
                                ;FWD1 -- vim fwd_word, once.  CY = failed: the cursor was on the file's last
                                ; char (it is left there).
  0A19'                         FWD1:
  0A19'   CD 0A98'              	CALL	CCLS
  0A1C'   32 2496'              	STA	WKCLS		; the starting class
  0A1F'   CD 0AD2'              	CALL	INCC
  0A22'   B7                    	ORA	A
  0A23'   CA 0A3B'              	JZ	FW_WD
  0A26'   37                    	STC
  0A27'   F8                    	RM			; -1: already at the end
  0A28'   FE 02                 	CPI	2
  0A2A'   C2 0A3B'              	JNZ	FW_WD		; 1: a next line was reached
  0A2D'   CD 091C'              	CALL	ATEOF		; 2: on the line's end -- the last line?
  0A30'   D4 0AB9'              	CNC	NXLN
  0A33'   D2 0A3B'              	JNC	FW_WD
  0A36'   CD 0B14'              	CALL	DECC		; yes: back onto its last char, failed
  0A39'   37                    	STC
  0A3A'   C9                    	RET
  0A3B'                         FW_WD:
  0A3B'   3A 2496'              	LDA	WKCLS		; go past the rest of this word
  0A3E'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-36


  0A3F'   CA 0A54'              	JZ	FW_WS
  0A42'                         FW_WLP:
  0A42'   CD 0A98'              	CALL	CCLS
  0A45'   21 2496'              	LXI	H,WKCLS
  0A48'   BE                    	CMP	M
  0A49'   C2 0A54'              	JNZ	FW_WS
  0A4C'   CD 0AD2'              	CALL	INCC
  0A4F'   B7                    	ORA	A
  0A50'   F8                    	RM			; the end of the file (NC)
  0A51'   C3 0A42'              	JMP	FW_WLP
  0A54'                         FW_WS:
  0A54'   CD 0A98'              	CALL	CCLS		; then over blanks to the next word
  0A57'   B7                    	ORA	A
  0A58'   C0                    	RNZ
  0A59'   CD 0AA0'              	CALL	EMPTY
  0A5C'   C8                    	RZ			; an empty line is a word
  0A5D'   CD 0AD2'              	CALL	INCC
  0A60'   B7                    	ORA	A
  0A61'   F8                    	RM
  0A62'   C3 0A54'              	JMP	FW_WS
                                
                                ;BCK1 -- vim bck_word, once.  CY = failed: the cursor was at the file's start.
  0A65'                         BCK1:
  0A65'   CD 0B14'              	CALL	DECC
  0A68'   B7                    	ORA	A
  0A69'   37                    	STC
  0A6A'   F8                    	RM
  0A6B'                         BK_WS:
  0A6B'   CD 0A98'              	CALL	CCLS		; back over blanks
  0A6E'   B7                    	ORA	A
  0A6F'   C2 0A7F'              	JNZ	BK_WD
  0A72'   CD 0AA0'              	CALL	EMPTY
  0A75'   C8                    	RZ			; an empty line is a word
  0A76'   CD 0B14'              	CALL	DECC
  0A79'   B7                    	ORA	A
