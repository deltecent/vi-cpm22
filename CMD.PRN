  1A6C'                         EX_QT:
  1A6C'   CD 0000*              	CALL	DISCRD		; WM EDEND: no work files left behind
  1A6F'   3E 01                 	MVI	A,1
  1A71'   32 2456'              	STA	QUITF
  1A74'   C9                    	RET
                                
                                ;EX_E -- :e.  The same file comes back at the cursor's line (counted before
                                ; the text is dropped), another at its first line; either on the middle row,
                                ; the cursor on the first non-blank, as vim opens a file.
  1A75'                         EX_E:
  1A75'   3A 24B5'              	LDA	EXBANG
  1A78'   B7                    	ORA	A
  1A79'   CA 1A83'              	JZ	EE_GO
  1A7C'   3A 2457'              	LDA	MODF
  1A7F'   B7                    	ORA	A
  1A80'   C2 1D20'              	JNZ	MSGNWR
  1A83'                         EE_GO:
  1A83'   3A 24A3'              	LDA	EXARG
  1A86'   B7                    	ORA	A
  1A87'   C2 1A8E'              	JNZ	EE_ARG
  1A8A'   CD 1B3D'              	CALL	OWNTF		; no name: the buffer's own
  1A8D'   D8                    	RC
  1A8E'                         EE_ARG:
  1A8E'   CD 1B53'              	CALL	ISOWN
  1A91'   21 0001               	LXI	H,1
  1A94'   C2 1A9B'              	JNZ	EE_LD		; another file: its first line
  1A97'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor
  1A9A'   23                    	INX	H		; HL = the cursor's line
  1A9B'                         EE_LD:
  1A9B'   3E 01                 	MVI	A,MW_FIL	; vim names the file ':e' opened, as at startup
  1A9D'   32 24B3'              	STA	MSGWHT
  1AA0'   E5                    	PUSH	H
  1AA1'   CD 0000*              	CALL	DISCRD		; the edit is dropped
  1AA4'   21 0000*              	LXI	H,TFCB
  1AA7'   11 0000*              	LXI	D,FNAME
  1AAA'   CD 1B65'              	CALL	COPY12		; the buffer's name
  1AAD'   CD 1B2A'              	CALL	SRCTF
  1AB0'   CD 0000*              	CALL	REOPEN
  1AB3'   CD 020E'              	CALL	MKCLR		; the marks named the buffer that just went
  1AB6'   AF                    	XRA	A
  1AB7'   32 2457'              	STA	MODF
  1ABA'   E1                    	POP	H
  1ABB'   2B                    	DCX	H
  1ABC'   AF                    	XRA	A
  1ABD'   CD 0000*              	CALL	MVLIND		; down to the line
  1AC0'   CD 091C'              	CALL	ATEOF
  1AC3'   DC 0922'              	CC	LASTLN		; past the last line: onto it
  1AC6'   CD 0E23'              	CALL	ZSAVE
  1AC9'   C3 0F0C'              	JMP	GP_MID
                                
                                ;WRCHK -- the target of a write into TFCB: the file name given, else the
                                ; buffer's own.  A = 1 (keep a backup) when it is the buffer's own file.  CY
                                ; (message shown) when there is no name, or another file is there and no '!'.
  1ACC'                         WRCHK:
  1ACC'   3A 24A3'              	LDA	EXARG
  1ACF'   B7                    	ORA	A
	MACRO-80 3.44	09-Dec-81	PAGE	1-85


  1AD0'   C2 1ADA'              	JNZ	WC_ARG
  1AD3'   CD 1B3D'              	CALL	OWNTF
  1AD6'   D8                    	RC
  1AD7'   C3 1AEF'              	JMP	WC_OWN
  1ADA'                         WC_ARG:
  1ADA'   CD 1B53'              	CALL	ISOWN
  1ADD'   CA 1AEF'              	JZ	WC_OWN
  1AE0'   3A 24B5'              	LDA	EXBANG
  1AE3'   B7                    	ORA	A
  1AE4'   CA 1AED'              	JZ	WC_OTH
  1AE7'   CD 0000*              	CALL	TEXIST
  1AEA'   C2 1D14'              	JNZ	MSGEXI		; File exists (! to force)
  1AED'                         WC_OTH:
  1AED'   AF                    	XRA	A		; (NC)
  1AEE'   C9                    	RET
  1AEF'                         WC_OWN:
  1AEF'   3A 24B6'              	LDA	ROFLAG		; '-R': this is the file it may not write
  1AF2'   B7                    	ORA	A
  1AF3'   CA 1AFD'              	JZ	WC_OK
  1AF6'   3A 24B5'              	LDA	EXBANG
  1AF9'   B7                    	ORA	A
  1AFA'   C2 1D1A'              	JNZ	MSGRO		; and no '!' to override it -- vim's E45
  1AFD'                         WC_OK:
  1AFD'   3E 01                 	MVI	A,1
  1AFF'   B7                    	ORA	A		; (NC)
  1B00'   C9                    	RET
                                
                                ;WRITE -- write the text to TFCB's file (EXBAK: keep a backup).  A buffer
                                ; without a name takes that one; writing the buffer's own file clears its
                                ; changed flag.  The file written is where the text is read from next.
  1B01'                         WRITE:
  1B01'   3A 24A4'              	LDA	EXBAK
  1B04'   CD 0000*              	CALL	WRTO
  1B07'   3A 0001*              	LDA	FNAME+1
  1B0A'   FE 20                 	CPI	' '
  1B0C'   C2 1B18'              	JNZ	WR_HAS
  1B0F'   21 0000*              	LXI	H,TFCB
  1B12'   11 0000*              	LXI	D,FNAME
  1B15'   CD 1B65'              	CALL	COPY12
  1B18'                         WR_HAS:
  1B18'   3E 02                 	MVI	A,MW_WRT	; vim says what it wrote, on the bottom row
  1B1A'   32 24B3'              	STA	MSGWHT
  1B1D'   CD 1B53'              	CALL	ISOWN
  1B20'   C2 1B2A'              	JNZ	SRCTF
  1B23'   AF                    	XRA	A
  1B24'   32 2457'              	STA	MODF
  1B27'   32 24B4'              	STA	MSGNEW		; written: the file is not new any more
                                ;SRCTF -- the source FCB (005CH) = TFCB's name, for REOPEN.
  1B2A'                         SRCTF:
  1B2A'   21 0000*              	LXI	H,TFCB
  1B2D'   11 005C               	LXI	D,DFTFCB
  1B30'   CD 1B65'              	CALL	COPY12
  1B33'   AF                    	XRA	A
  1B34'   06 04                 	MVI	B,4
  1B36'                         SRC_Z:
  1B36'   12                    	STAX	D		; extent, s1, s2, record count: 0
	MACRO-80 3.44	09-Dec-81	PAGE	1-86


  1B37'   13                    	INX	D
  1B38'   05                    	DCR	B
  1B39'   C2 1B36'              	JNZ	SRC_Z
  1B3C'   C9                    	RET
                                
                                ;OWNTF -- TFCB = the buffer's name; CY (No file name shown) if it has none.
  1B3D'                         OWNTF:
  1B3D'   3A 0001*              	LDA	FNAME+1
  1B40'   FE 20                 	CPI	' '
  1B42'   CA 1D0E'              	JZ	MSGNFN
  1B45'   CD 1B70'              	CALL	TFCLR
  1B48'   21 0000*              	LXI	H,FNAME
  1B4B'   11 0000*              	LXI	D,TFCB
  1B4E'   CD 1B65'              	CALL	COPY12
  1B51'   B7                    	ORA	A		; (NC)
  1B52'   C9                    	RET
                                
                                ;ISOWN -- Z iff TFCB names the buffer's file.
  1B53'                         ISOWN:
  1B53'   21 0000*              	LXI	H,TFCB
  1B56'   11 0000*              	LXI	D,FNAME
  1B59'   06 0C                 	MVI	B,12
  1B5B'                         IO_LP:
  1B5B'   1A                    	LDAX	D
  1B5C'   BE                    	CMP	M
  1B5D'   C0                    	RNZ
  1B5E'   23                    	INX	H
  1B5F'   13                    	INX	D
  1B60'   05                    	DCR	B
  1B61'   C2 1B5B'              	JNZ	IO_LP
  1B64'   C9                    	RET
                                
                                ;COPY12 -- copy 12 bytes (drive, name, type) from HL to DE.
  1B65'                         COPY12:
  1B65'   06 0C                 	MVI	B,12
  1B67'                         CP_LP:
  1B67'   7E                    	MOV	A,M
  1B68'   12                    	STAX	D
  1B69'   23                    	INX	H
  1B6A'   13                    	INX	D
  1B6B'   05                    	DCR	B
  1B6C'   C2 1B67'              	JNZ	CP_LP
  1B6F'   C9                    	RET
                                
                                ;TFCLR -- zero TFCB.  Keeps HL.
  1B70'                         TFCLR:
  1B70'   11 0000*              	LXI	D,TFCB
  1B73'   06 24                 	MVI	B,36
  1B75'   AF                    	XRA	A
  1B76'                         TC_LP:
  1B76'   12                    	STAX	D
  1B77'   13                    	INX	D
  1B78'   05                    	DCR	B
  1B79'   C2 1B76'              	JNZ	TC_LP
  1B7C'   C9                    	RET
                                
	MACRO-80 3.44	09-Dec-81	PAGE	1-87


                                ;FOPEN -- open the file named on the command line: the buffer takes its name
                                ; (the drive made explicit), then OPENZ.  With no name the buffer is empty
                                ; and has none, as in vim.
  1B7D'                         FOPEN:
  1B7D'   3E 01                 	MVI	A,MW_FIL	; vim names the file it opened, on the bottom row
  1B7F'   32 24B3'              	STA	MSGWHT
  1B82'   21 005C               	LXI	H,DFTFCB
  1B85'   CD 1C57'              	CALL	NRMDRV
  1B88'   11 0000*              	LXI	D,FNAME
  1B8B'   CD 1B65'              	CALL	COPY12
  1B8E'   CD 0000*              	CALL	OPENZ
  1B91'   3A 0001*              	LDA	FNAME+1		; a buffer with no file at all is not a new file:
  1B94'   FE 20                 	CPI	' '		;   vim's '"[No Name]"' carries no flag
  1B96'   C8                    	RZ
  1B97'   3A 0000*              	LDA	NEWFIL		; '[New]' is the MESSAGE's flag, taken once here:
  1B9A'   32 24B4'              	STA	MSGNEW		;   NEWFIL is the pager's own (SAVEFIL decides
  1B9D'   C9                    	RET			;   the .BAK from it), so it is never written to
                                
                                ;============================================================
                                ; ARGSCN / ARGGO -- the rest of the command line.  The CCP leaves the line at
                                ; CMDTAIL (a length byte, then the text, upper cased) and its first name parsed
                                ; into the FCB at 005CH, which is the file FOPEN opens:
                                ;
                                ;   VI name +{n}    start on line {n} ('+' alone: the last line)
                                ;   VI name -R      read only: a write to that file needs ':w!'
                                ;
                                ; vim takes both BEFORE the file name; here they come after it, because the CCP
                                ; parses the first token of the line into the FCB.  '/R' is taken as well, the
                                ; way CP/M programs are usually given a switch, and the CCP's upper casing
                                ; makes '-r' the same as '-R'.  Anything else on the line is left alone.
                                ;
                                ; ARGSCN must run before any file is read: CMDTAIL is also the default DMA
                                ; address, so the first sector read would take the line with it.  ARGGO runs
                                ; after the file is loaded, before the first paint.
                                ;
                                ; '+{n}' is not placed by hand: its digits go through the command dispatcher
                                ; and a 'G' then does the work, so the line lands where vim's own '+{n}' puts
                                ; it -- the minimum scroll near the top of the file, centred when it is far
                                ; off, on the line's first non-blank (accept_vi.py's VIM_PLUS records both, on
                                ; 8 files).  The count machinery's clamp and saturation come with it: '+99999'
                                ; is the last line, as vim's is.
                                ;============================================================
  1B9E'                         ARGSCN:
  1B9E'   3A 0080               	LDA	CMDTAIL
  1BA1'   47                    	MOV	B,A		; B = what is left of the line
  1BA2'   B7                    	ORA	A
  1BA3'   C8                    	RZ
  1BA4'   21 0081               	LXI	H,CMDTAIL+1
  1BA7'                         AS_TOK:				; at a token, or the blanks before one
  1BA7'   7E                    	MOV	A,M
  1BA8'   FE 20                 	CPI	' '
  1BAA'   C2 1BB3'              	JNZ	AS_OPT
  1BAD'   23                    	INX	H
  1BAE'   05                    	DCR	B
  1BAF'   C2 1BA7'              	JNZ	AS_TOK
  1BB2'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-88


  1BB3'                         AS_OPT:
  1BB3'   FE 2B                 	CPI	'+'
  1BB5'   CA 1BDF'              	JZ	AS_PLS
  1BB8'   FE 2D                 	CPI	'-'
  1BBA'   CA 1BCE'              	JZ	AS_SW
  1BBD'   FE 2F                 	CPI	'/'
  1BBF'   CA 1BCE'              	JZ	AS_SW
  1BC2'                         AS_SKP:				; not ours (the file name): on to the next one
  1BC2'   23                    	INX	H
  1BC3'   05                    	DCR	B
  1BC4'   C8                    	RZ
  1BC5'   7E                    	MOV	A,M
  1BC6'   FE 20                 	CPI	' '
  1BC8'   C2 1BC2'              	JNZ	AS_SKP
  1BCB'   C3 1BA7'              	JMP	AS_TOK
  1BCE'                         AS_SW:
  1BCE'   23                    	INX	H
  1BCF'   05                    	DCR	B
  1BD0'   C8                    	RZ
  1BD1'   7E                    	MOV	A,M
  1BD2'   E6 5F                 	ANI	5FH		; 'r' and 'R' alike
  1BD4'   FE 52                 	CPI	'R'
  1BD6'   C2 1BC2'              	JNZ	AS_SKP
  1BD9'   32 24B6'              	STA	ROFLAG		; A = 'R': not 0, which is all WC_OWN asks
  1BDC'   C3 1BC2'              	JMP	AS_SKP
  1BDF'                         AS_PLS:
  1BDF'   3E 01                 	MVI	A,1
  1BE1'   32 24B7'              	STA	PLUSF		; '+' gets the line even with no number on it
  1BE4'   11 0000*              	LXI	D,PLUSB
  1BE7'   0E 05                 	MVI	C,5		; room for 65535; a longer number is past the
  1BE9'   23                    	INX	H		;   line space, so it is taken as '+' alone
  1BEA'   05                    	DCR	B
  1BEB'   CA 1C22'              	JZ	AS_PE
  1BEE'   7E                    	MOV	A,M
  1BEF'   FE 30                 	CPI	'0'
  1BF1'   C2 1C09'              	JNZ	AS_PD
  1BF4'                         AS_PZ:				; leading zeros: '+0' is line 1 (not the '0'
  1BF4'   23                    	INX	H		;   motion the dispatcher would see), '+007' 7
  1BF5'   05                    	DCR	B
  1BF6'   CA 1C2A'              	JZ	AS_P1
  1BF9'   7E                    	MOV	A,M
  1BFA'   FE 30                 	CPI	'0'
  1BFC'   CA 1BF4'              	JZ	AS_PZ
  1BFF'   FE 31                 	CPI	'1'
  1C01'   DA 1C2A'              	JC	AS_P1		; zeros and then no digit at all: line 1
  1C04'   FE 3A                 	CPI	'9'+1
  1C06'   D2 1C2A'              	JNC	AS_P1
  1C09'                         AS_PD:				; the digits, as typed
  1C09'   7E                    	MOV	A,M
  1C0A'   FE 30                 	CPI	'0'
  1C0C'   DA 1C22'              	JC	AS_PE
  1C0F'   FE 3A                 	CPI	'9'+1
  1C11'   D2 1C22'              	JNC	AS_PE
  1C14'   79                    	MOV	A,C
  1C15'   B7                    	ORA	A
  1C16'   CA 1C31'              	JZ	AS_POV
	MACRO-80 3.44	09-Dec-81	PAGE	1-89


  1C19'   0D                    	DCR	C
  1C1A'   7E                    	MOV	A,M
  1C1B'   12                    	STAX	D
  1C1C'   13                    	INX	D
  1C1D'   23                    	INX	H
  1C1E'   05                    	DCR	B
  1C1F'   C2 1C09'              	JNZ	AS_PD
  1C22'                         AS_PE:
  1C22'   AF                    	XRA	A
  1C23'   12                    	STAX	D		; the digits end with a 0
  1C24'   78                    	MOV	A,B
  1C25'   B7                    	ORA	A
  1C26'   C8                    	RZ
  1C27'   C3 1BA7'              	JMP	AS_TOK		; what stopped the digits is where the next
                                				;   token starts -- NOT AS_SKP, which would
                                				;   take a '-R' after them for a file name
  1C2A'                         AS_P1:
  1C2A'   3E 31                 	MVI	A,'1'
  1C2C'   12                    	STAX	D
  1C2D'   13                    	INX	D
  1C2E'   C3 1C22'              	JMP	AS_PE
  1C31'                         AS_POV:				; past the 16-bit line space: '+' alone, whose
  1C31'   11 0000*              	LXI	D,PLUSB		;   last line is the answer vim's clamp gives
  1C34'   C3 1C22'              	JMP	AS_PE
                                
                                ;ARGGO -- '+{n}' on the line: its digits through the dispatcher, then a 'G'.
                                ; The digits leave R_MOVE behind them (a count paints nothing), but every 'G'
                                ; placement ends at GP_SET, which forces R_FULL -- so the first paint is still
                                ; the full one it has to be.
  1C37'                         ARGGO:
  1C37'   3A 24B7'              	LDA	PLUSF
  1C3A'   B7                    	ORA	A
  1C3B'   C8                    	RZ
  1C3C'   21 0000*              	LXI	H,PLUSB
  1C3F'                         AG_LP:
  1C3F'   7E                    	MOV	A,M
  1C40'   B7                    	ORA	A
  1C41'   CA 1C50'              	JZ	AG_G
  1C44'   4F                    	MOV	C,A
  1C45'   06 02                 	MVI	B,KT_CHAR
  1C47'   E5                    	PUSH	H
  1C48'   CD 001F'              	CALL	VICMD
  1C4B'   E1                    	POP	H
  1C4C'   23                    	INX	H
  1C4D'   C3 1C3F'              	JMP	AG_LP
  1C50'                         AG_G:
  1C50'   0E 47                 	MVI	C,'G'
  1C52'   06 02                 	MVI	B,KT_CHAR
  1C54'   C3 001F'              	JMP	VICMD
                                
                                ;NRMDRV -- HL = an FCB: a drive byte of 0 becomes the current drive's, so
                                ; names compare byte for byte.  Keeps HL.
  1C57'                         NRMDRV:
  1C57'   7E                    	MOV	A,M
  1C58'   B7                    	ORA	A
  1C59'   C0                    	RNZ
	MACRO-80 3.44	09-Dec-81	PAGE	1-90


  1C5A'   E5                    	PUSH	H
  1C5B'   0E 19                 	MVI	C,BF_CURDSK
  1C5D'   CD 0005               	CALL	BDOS
  1C60'   E1                    	POP	H
  1C61'   3C                    	INR	A
  1C62'   77                    	MOV	M,A
  1C63'   C9                    	RET
                                
                                ;PARSFN -- HL = [d:]name[.typ], then blanks to the end of the line -> TFCB,
                                ; the drive made explicit.  NZ if it is not a file name.  WM GETFCB (WM 1379):
                                ; upper case, the name cut to 8 chars and the type to 3.  vim, NOT WordMaster:
                                ; no default type (WM's is LIB), and the drive must be A-P.
  1C64'                         PARSFN:
  1C64'   CD 1B70'              	CALL	TFCLR
  1C67'   11 0000*              	LXI	D,TFCB
  1C6A'   23                    	INX	H
  1C6B'   7E                    	MOV	A,M
  1C6C'   2B                    	DCX	H
  1C6D'   FE 3A                 	CPI	':'
  1C6F'   C2 1C81'              	JNZ	PF_NM
  1C72'   CD 1CC7'              	CALL	GETFNC
  1C75'   CA 1C81'              	JZ	PF_NM
  1C78'   D6 40                 	SUI	40H
  1C7A'   12                    	STAX	D
  1C7B'   FE 11                 	CPI	17
  1C7D'   D2 1CA5'              	JNC	PF_BAD
  1C80'   23                    	INX	H
  1C81'                         PF_NM:
  1C81'   13                    	INX	D
  1C82'   0E 08                 	MVI	C,8
  1C84'   CD 1CA9'              	CALL	CPYNAM
  1C87'   FE 2E                 	CPI	'.'
  1C89'   0E 03                 	MVI	C,3
  1C8B'   C4 1CBC'              	CNZ	PADFLD		; no type: blanks
  1C8E'   CC 1CA8'              	CZ	CPYNM0		; '.': the type
  1C91'   3A 0001*              	LDA	TFCB+1
  1C94'   FE 20                 	CPI	' '
  1C96'   CA 1CA5'              	JZ	PF_BAD		; no name
  1C99'   CD 1CFA'              	CALL	SKIPB
  1C9C'   C0                    	RNZ			; more after it
  1C9D'   21 0000*              	LXI	H,TFCB
  1CA0'   CD 1C57'              	CALL	NRMDRV
  1CA3'   AF                    	XRA	A
  1CA4'   C9                    	RET
  1CA5'                         PF_BAD:
  1CA5'   F6 01                 	ORI	1
  1CA7'   C9                    	RET
                                
                                ;CPYNAM -- WM CPYNAME (WM 1590): copy up to C name chars from HL to DE, pad
                                ; with blanks, skip the rest of the field.  CPYNM0 steps over the '.' first.
  1CA8'                         CPYNM0:
  1CA8'   23                    	INX	H
  1CA9'                         CPYNAM:
  1CA9'   CD 1CC7'              	CALL	GETFNC
  1CAC'   CA 1CBC'              	JZ	PADFLD
  1CAF'   12                    	STAX	D
	MACRO-80 3.44	09-Dec-81	PAGE	1-91


  1CB0'   13                    	INX	D
  1CB1'   0D                    	DCR	C
  1CB2'   C2 1CA9'              	JNZ	CPYNAM
  1CB5'                         CN_SKP:
  1CB5'   CD 1CC7'              	CALL	GETFNC
  1CB8'   C2 1CB5'              	JNZ	CN_SKP
  1CBB'   C9                    	RET
  1CBC'                         PADFLD:
  1CBC'   F5                    	PUSH	PSW
  1CBD'                         PD_LP:
  1CBD'   3E 20                 	MVI	A,' '
  1CBF'   12                    	STAX	D
  1CC0'   13                    	INX	D
  1CC1'   0D                    	DCR	C
  1CC2'   C2 1CBD'              	JNZ	PD_LP
  1CC5'   F1                    	POP	PSW
  1CC6'   C9                    	RET
                                
                                ;GETFNC -- WM GETFNC: the next name char, upper case, HL past it; Z (HL kept)
                                ; at a delimiter: . : * ? blank or a control char, and (NOT WordMaster) the
                                ; CCP's = _ ; < > so no name is made that the CCP cannot type.
  1CC7'                         GETFNC:
  1CC7'   7E                    	MOV	A,M
  1CC8'   FE 3D                 	CPI	'='
  1CCA'   C8                    	RZ
  1CCB'   FE 5F                 	CPI	'_'
  1CCD'   C8                    	RZ
  1CCE'   FE 3B                 	CPI	';'
  1CD0'   C8                    	RZ
  1CD1'   FE 3C                 	CPI	'<'
  1CD3'   C8                    	RZ
  1CD4'   FE 3E                 	CPI	'>'
  1CD6'   C8                    	RZ
  1CD7'   FE 2E                 	CPI	'.'
  1CD9'   C8                    	RZ
  1CDA'   FE 3A                 	CPI	':'
  1CDC'   C8                    	RZ
  1CDD'   FE 2A                 	CPI	'*'
  1CDF'   C8                    	RZ
  1CE0'   FE 3F                 	CPI	'?'
  1CE2'   C8                    	RZ
  1CE3'   FE 20                 	CPI	' '
  1CE5'   DA 1CF8'              	JC	GF_CTL
  1CE8'   C8                    	RZ
  1CE9'   23                    	INX	H
  1CEA'   FE 61                 	CPI	'a'
  1CEC'   DA 1CF6'              	JC	GF_DN
  1CEF'   FE 7B                 	CPI	'z'+1
  1CF1'   D2 1CF6'              	JNC	GF_DN
  1CF4'   E6 DF                 	ANI	0DFH
  1CF6'                         GF_DN:
  1CF6'   B7                    	ORA	A
  1CF7'   C9                    	RET
  1CF8'                         GF_CTL:
  1CF8'   BF                    	CMP	A
  1CF9'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-92


                                
                                ;SKIPB -- HL past blanks; A = the char there, Z at the end of the line.
  1CFA'                         SKIPB:
  1CFA'   7E                    	MOV	A,M
  1CFB'   FE 20                 	CPI	' '
  1CFD'   C2 1D04'              	JNZ	SB_DN
  1D00'   23                    	INX	H
  1D01'   C3 1CFA'              	JMP	SKIPB
  1D04'                         SB_DN:
  1D04'   B7                    	ORA	A
  1D05'   C9                    	RET
                                
                                ;ISLOW -- A = the char at HL; NC iff a-z.
  1D06'                         ISLOW:
  1D06'   7E                    	MOV	A,M
  1D07'   FE 61                 	CPI	'a'
  1D09'   D8                    	RC
  1D0A'   FE 7B                 	CPI	'z'+1
  1D0C'   3F                    	CMC
  1D0D'   C9                    	RET
                                
                                ;--- ex messages (vim's, without the Enn number) ---
  1D0E'                         MSGNFN:
  1D0E'   21 1D5B'              	LXI	H,SNFN
  1D11'   C3 1D46'              	JMP	EXERR
  1D14'                         MSGEXI:
  1D14'   21 1D75'              	LXI	H,SEXI
  1D17'   C3 1D23'              	JMP	EXBNG
  1D1A'                         MSGRO:
  1D1A'   21 1D81'              	LXI	H,SRO
  1D1D'   C3 1D23'              	JMP	EXBNG
  1D20'                         MSGNWR:
  1D20'   21 1D68'              	LXI	H,SNWR
  1D23'                         EXBNG:
  1D23'   CD 1D46'              	CALL	EXERR
  1D26'   21 1D8D'              	LXI	H,SBNG
  1D29'   C3 1D41'              	JMP	EXOUT
  1D2C'                         EX_INV:
  1D2C'   21 1D9B'              	LXI	H,SINV
  1D2F'   C3 1D46'              	JMP	EXERR
  1D32'                         EX_V:				; :ve -- the version, on the bottom row
  1D32'   21 1D56'              	LXI	H,SVER
  1D35'   C3 1D46'              	JMP	EXERR
  1D38'                         EX_TRL:
  1D38'   21 1DAD'              	LXI	H,STRL
  1D3B'                         EXERT:				; the message, then the text at EXCMD
  1D3B'   CD 1D46'              	CALL	EXERR
  1D3E'   2A 24A5'              	LHLD	EXCMD
  1D41'                         EXOUT:
  1D41'   CD 0000*              	CALL	OUTSTR
  1D44'   37                    	STC
  1D45'   C9                    	RET
                                ;EXERR -- HL = a message for the bottom row; it stays there (only the cursor
                                ; goes back), CY.
  1D46'                         EXERR:
  1D46'   E5                    	PUSH	H
