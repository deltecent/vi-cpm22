  2990'   AF                    	XRA	A
  2991'   32 2AF0'              	STA	MSGWHT
  2994'   78                    	MOV	A,B
  2995'   FE 01                 	CPI	MW_FIL
  2997'   CA 29B3'              	JZ	MP_FIL
  299A'   FE 02                 	CPI	MW_WRT
  299C'   CA 29B9'              	JZ	MP_WRT
  299F'   FE 04                 	CPI	MW_BIG
  29A1'   CA 29AA'              	JZ	MP_BIG
  29A4'   CD 2929'              	CALL	MSGCTG
  29A7'   C3 0000*              	JMP	SCURS
  29AA'                         MP_BIG:
  29AA'   21 244A'              	LXI	H,SQBIG
  29AD'   CD 0000*              	CALL	EXMSG
  29B0'   C3 0000*              	JMP	SCURS
