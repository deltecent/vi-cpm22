  0C05'   CD 0000*              	CALL	CHARAT
  0C08'   CD 0679'              	CALL	CLASSF
  0C0B'   32 24EF'              	STA	WKCLS
  0C0E'                         ES_RUN:
  0C0E'   2A 24E7'              	LHLD	WKI
  0C11'   23                    	INX	H
