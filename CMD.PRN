  0AC5'   DA 0ACD'              	JC	DC_1
  0AC8'   FE 0D                 	CPI	CR
  0ACA'   CC 0000*              	CZ	PUTCUR
  0ACD'                         DC_1:
  0ACD'   3E 01                 	MVI	A,1
  0ACF'   B7                    	ORA	A
  0AD0'   C9                    	RET
                                
