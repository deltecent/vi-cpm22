  28C6'   0DAC'                 	DW	VC_HFUP
  28C8'   0C                    	DB	0CH			; ^L -- redraw
  28C9'   0E20'                 	DW	VC_REDR
  28CB'   2E                    	DB	'.'			; '.' -- repeat the last change
  28CC'   0191'                 	DW	VC_DOT
  28CE'   75                    	DB	'u'			; 'u' -- undo (and undo the undo)
  28CF'   04F4'                 	DW	VC_UNDO
