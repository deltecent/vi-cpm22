  24C8'   6C 00                 
                                
                                ;EXTAB -- the ex commands: DB first letter, second letter (0: none), EXOP.
  0001                          EO_W	EQU	1
  0002                          EO_Q	EQU	2
  0003                          EO_WQ	EQU	3
  0004                          EO_X	EQU	4
  0005                          EO_E	EQU	5
  0006                          EO_S	EQU	6
  0007                          EO_V	EQU	7
  0008                          EO_R	EQU	8
  24CA'                         EXTAB:
  24CA'   77 00 01              	DB	'w',0,EO_W
  24CD'   71 00 02              	DB	'q',0,EO_Q
  24D0'   77 71 03              	DB	'w','q',EO_WQ
  24D3'   78 00 04              	DB	'x',0,EO_X
  24D6'   65 00 05              	DB	'e',0,EO_E
  24D9'   73 00 06              	DB	's',0,EO_S
  24DC'   76 65 07              	DB	'v','e',EO_V
  24DF'   72 00 08              	DB	'r',0,EO_R
  24E2'   00                    	DB	0
                                
                                ;============================================================
                                ; SEARCH  (/ ? n N)
                                ;
                                ; vi's search on WordMaster's matcher.  What it is NOT: vim searches with a
                                ; REGULAR EXPRESSION and this searches for the literal string typed.  An 8080
                                ; has no room for a regex engine; COMMANDS.md records the deviation.  (WM's own
                                ; search wildcards -- ^A any, ^S separator, ^O not -- still reach WCMATCH from
                                ; here, because MATCHF/MATCHB compare through it, but they are WordMaster's
                                ; syntax, not vim's, and nothing advertises them.)
                                ;
                                ; Recorded from vim before any of this was written (VIM_SRCH, accept_vi.py):
                                ;   - '/' starts one character PAST the cursor and lands ON the match's first
                                ;     character; '?' finds the last match that ends before the cursor.
                                ;   - 'wrapscan' is on: a search that runs off one end of the file starts
                                ;     again at the other, so '/' on the file's ONLY match finds it again.
                                ;   - 'n' repeats the last search's DIRECTION and 'N' reverses it, so 'n'
                                ;     after a '?' keeps going backward.
                                ;   - An empty pattern ('/' then <CR>) repeats the last pattern.
                                ;   - A count repeats the search: '2/a' is the second match, '15n' fifteen
                                ;     n's.  Not found leaves the cursor exactly where it was, at any count.
                                ;   - The window is placed as 'G' places it -- least scroll when the match is
                                ;     near, centred when it is far -- which is why this ends in GPLACE.
                                ;
                                ; This replaces a byte-at-a-time search that ran through CHARAT over logical
                                ; offsets: it could only see the resident window (so a match further into a
                                ; paged file did not exist), had no '?' or 'N', and failed silently.
                                ;============================================================
                                
                                ;============================================================
                                ; SUBSTITUTE  (:s  :%s  :N,Ms  and the 'g' flag)
                                ;
                                ; vi's substitute on WordMaster's matcher, so it finds the same LITERAL string
                                ; the search does -- not a regular expression.  COMMANDS.md records that
                                ; deviation for '/' and it is the same one here, which is why nothing below
	MACRO-80 3.44	09-Dec-81	PAGE	1-113


                                ; honours '&', '\1' or '~'.  The pattern goes into the SEARCH's own buffer
                                ; because vim's ':s' also sets the last search pattern, so 'n' afterwards
                                ; repeats it.
                                ;
                                ; Recorded from vim before any of this was written (VIM_SUBST, accept_vi.py):
                                ;   - ':s' changes the FIRST match on the cursor's line, ':s...g' every match,
                                ;     and the scan goes on PAST the replacement, so a replacement that
                                ;     contains the pattern is not substituted again.
                                ;   - the cursor lands on the first non-blank of the LAST line changed, placed
                                ;     exactly as 'G' places a line -- which is what GZONE before and GPLACE
                                ;     after are for, and it is measured: ':12800,12800s' leaves the last line
                                ;     on row 22 (top 012778) and ':100,105s' leaves line 105 on row 11.
                                ;   - a pattern that is nowhere in the range changes nothing and moves nothing.
                                ;
                                ; A whole substitute is ONE change for 'u': the second UNDBEG, at the first
                                ; match, is what makes the undo's cursor the first match (where vim leaves it)
                                ; rather than the line the ':' was typed on.  A substitute of more than about a
                                ; dozen lines overruns the undo region, which is accepted -- but it SAYS so,
                                ; both when it happens and when 'u' is then pressed.
                                ;============================================================
                                
                                ;EXADDR -- the optional line range before an ex command: '%' (the whole file),
                                ;'N', or 'N,M'.  SRNGF = 0 when there is none, and SRNG2 = 0FFFFH is the last
                                ;line, whatever it turns out to be.  HL comes back on the command letter.
                                ;
                                ; It does NOT consume the blanks after itself: VC_EX's SKIPB does that, so
                                ; ':2,4 s/a/Z/' reads as ':2,4s/a/Z/' the way ex has always taken it.  The one
                                ; place a blank is still refused is INSIDE the range, around the comma
                                ; (':2, 4s'), which ex accepts and this does not -- the comma is read here off
                                ; DE mid-number and skipping there costs more than the position is worth.
  24E3'                         EXADDR:
  24E3'   AF                    	XRA	A
  24E4'   32 2B25'              	STA	SRNGF
  24E7'   7E                    	MOV	A,M
  24E8'   FE 25                 	CPI	'%'
  24EA'   CA 2513'              	JZ	EXA_AL
  24ED'   EB                    	XCHG			; DE walks the line, HL takes the number
  24EE'   CD 2528'              	CALL	EXNUM
  24F1'   DA 2511'              	JC	EXA_NO
  24F4'   22 2B26'              	SHLD	SRNG1
  24F7'   22 2B28'              	SHLD	SRNG2		; 'N' alone is the single line 'N,N'
  24FA'   1A                    	LDAX	D
  24FB'   FE 2C                 	CPI	','
  24FD'   C2 250A'              	JNZ	EXA_YS
  2500'   13                    	INX	D
  2501'   CD 2528'              	CALL	EXNUM
  2504'   DA 2511'              	JC	EXA_NO		; ',' with no number: not a range at all
  2507'   22 2B28'              	SHLD	SRNG2
  250A'                         EXA_YS:
  250A'   EB                    	XCHG
  250B'   3E 01                 	MVI	A,1
  250D'   32 2B25'              	STA	SRNGF
  2510'   C9                    	RET
  2511'                         EXA_NO:
  2511'   EB                    	XCHG
  2512'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-114


  2513'                         EXA_AL:
  2513'   23                    	INX	H
  2514'   E5                    	PUSH	H
  2515'   21 0001               	LXI	H,1
  2518'   22 2B26'              	SHLD	SRNG1
  251B'   21 FFFF               	LXI	H,0FFFFH
  251E'   22 2B28'              	SHLD	SRNG2
  2521'   E1                    	POP	H
  2522'   3E 01                 	MVI	A,1
  2524'   32 2B25'              	STA	SRNGF
  2527'   C9                    	RET
                                
                                ;EXNUM -- a decimal number at DE -> HL, DE left past it.  CY when there is no
                                ;digit there at all.
  2528'                         EXNUM:
  2528'   1A                    	LDAX	D
  2529'   D6 30                 	SUI	'0'
  252B'   D8                    	RC
  252C'   FE 0A                 	CPI	10
  252E'   3F                    	CMC
  252F'   D8                    	RC
  2530'   21 0000               	LXI	H,0
  2533'                         EXN_LP:
  2533'   1A                    	LDAX	D
  2534'   D6 30                 	SUI	'0'
  2536'   DA 2550'              	JC	EXN_DN
  2539'   FE 0A                 	CPI	10
  253B'   D2 2550'              	JNC	EXN_DN
  253E'   13                    	INX	D
  253F'   C5                    	PUSH	B
  2540'   4F                    	MOV	C,A
  2541'   06 00                 	MVI	B,0		; BC = the digit
  2543'   D5                    	PUSH	D
  2544'   54                    	MOV	D,H
  2545'   5D                    	MOV	E,L
  2546'   29                    	DAD	H		; *2
  2547'   29                    	DAD	H		; *4
  2548'   19                    	DAD	D		; *5
  2549'   29                    	DAD	H		; *10
  254A'   D1                    	POP	D
  254B'   09                    	DAD	B
  254C'   C1                    	POP	B
  254D'   C3 2533'              	JMP	EXN_LP
  2550'                         EXN_DN:
  2550'   B7                    	ORA	A		; CY clear: there was a number
  2551'   C9                    	RET
                                
                                ;EX_S -- ':s': the delimiter, the pattern, the replacement, an optional 'g'.
  2552'                         EX_S:
  2552'   7E                    	MOV	A,M
  2553'   B7                    	ORA	A
  2554'   CA 2596'              	JZ	SUBNOP		; ':s' alone -- repeating the last one is not
                                				;   built (COMMANDS.md)
  2557'   32 2B2A'              	STA	SDELIM
  255A'   23                    	INX	H
  255B'   11 0000*              	LXI	D,SRCHST
	MACRO-80 3.44	09-Dec-81	PAGE	1-115


  255E'   3A 0000*              	LDA	SRCMAX		; the pattern's capacity is BUF.MAC's to state
  2561'   4F                    	MOV	C,A
  2562'   CD 259C'              	CALL	SCOPY
  2565'   78                    	MOV	A,B
  2566'   B7                    	ORA	A
  2567'   CA 2596'              	JZ	SUBNOP		; ':s//x/' -- an empty pattern matches nothing
  256A'   32 0000*              	STA	SRCHBF		; WM's RDSTR layout: the length below the string
  256D'   3E 01                 	MVI	A,1
  256F'   32 2AF2'              	STA	SHAVE		; 'n' repeats it, as after a '/'
  2572'   11 2B3C'              	LXI	D,SREPL
  2575'   0E 24                 	MVI	C,SREPMX
  2577'   CD 259C'              	CALL	SCOPY
  257A'   78                    	MOV	A,B
  257B'   32 2B3B'              	STA	SREPLN
  257E'   AF                    	XRA	A
  257F'   32 2B2B'              	STA	SGFLAG
  2582'   7E                    	MOV	A,M
  2583'   FE 67                 	CPI	'g'
  2585'   C2 258E'              	JNZ	EX_SG
  2588'   23                    	INX	H
  2589'   3E 01                 	MVI	A,1
  258B'   32 2B2B'              	STA	SGFLAG
  258E'                         EX_SG:
  258E'   7E                    	MOV	A,M
  258F'   B7                    	ORA	A
  2590'   C2 232D'              	JNZ	EX_TRL		; 'Trailing chars: ' -- vim's, shortened
  2593'   C3 25BC'              	JMP	SUBGO
  2596'                         SUBNOP:
  2596'   21 23E5'              	LXI	H,SNOPAT
  2599'   C3 233B'              	JMP	EXERR
                                
                                ;SCOPY -- the text at HL up to SDELIM (or the line's end) into [DE], C its
                                ;capacity: B = how many were taken, HL past the delimiter, and [DE] is left
                                ;0-terminated as WM's RDSTR leaves a string.
  259C'                         SCOPY:
  259C'   06 00                 	MVI	B,0
  259E'                         SCP_LP:
  259E'   78                    	MOV	A,B
  259F'   B9                    	CMP	C
  25A0'   D2 25B9'              	JNC	SCP_DN		; full: what is left stays on the line, and so
                                				;   comes back as trailing characters
  25A3'   7E                    	MOV	A,M
  25A4'   B7                    	ORA	A
  25A5'   CA 25B9'              	JZ	SCP_DN		; the line ended: no closing delimiter wanted
  25A8'   E5                    	PUSH	H
  25A9'   21 2B2A'              	LXI	H,SDELIM
  25AC'   BE                    	CMP	M
  25AD'   E1                    	POP	H
  25AE'   CA 25B8'              	JZ	SCP_SK
  25B1'   12                    	STAX	D
  25B2'   13                    	INX	D
  25B3'   23                    	INX	H
  25B4'   04                    	INR	B
  25B5'   C3 259E'              	JMP	SCP_LP
  25B8'                         SCP_SK:
  25B8'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-116


  25B9'                         SCP_DN:
  25B9'   AF                    	XRA	A
  25BA'   12                    	STAX	D
  25BB'   C9                    	RET
                                
                                ;SUBGO -- run the substitute.  GZONE comes first, before anything moves: the
                                ;landing is placed as 'G' places a line, and GPLACE measures it against the
                                ;screen's top line as it was when the command was typed.
  25BC'                         SUBGO:
  25BC'   CD 0FB5'              	CALL	GZONE
  25BF'   2A 0000*              	LHLD	LNDLT
  25C2'   22 2B39'              	SHLD	SLDLTS		; the walk moves the cursor; a substitute that
  25C5'   21 2B36'              	LXI	H,SOFFS		;   finds nothing puts both back, as the
  25C8'   CD 0429'              	CALL	FPSTO		;   search's SN_BAD does
  25CB'   AF                    	XRA	A
  25CC'   32 2B2C'              	STA	SANY
  25CF'   21 0000               	LXI	H,0
  25D2'   22 2B2E'              	SHLD	SBACK
  25D5'   3A 2B25'              	LDA	SRNGF
  25D8'   B7                    	ORA	A
  25D9'   CA 25EB'              	JZ	SUB_1L
                                	;--- ':N,Ms' / ':%s': to the range's first line, then walk it ---
  25DC'   CD 1EBB'              	CALL	EXRNG		; SLINES = the lines in the range
  25DF'   DA 2667'              	JC	SUBBAD
  25E2'   2A 2B26'              	LHLD	SRNG1
  25E5'   CD 0F23'              	CALL	GOLN
  25E8'   C3 25F1'              	JMP	SUBLP
  25EB'                         SUB_1L:
  25EB'   21 0001               	LXI	H,1
  25EE'   22 2B30'              	SHLD	SLINES
  25F1'                         SUBLP:
  25F1'   CD 266D'              	CALL	SUBLIN		; A = 1 when this line changed
  25F4'   B7                    	ORA	A
  25F5'   CA 2603'              	JZ	SUB_NX
  25F8'   3E 01                 	MVI	A,1
  25FA'   32 2B2C'              	STA	SANY
  25FD'   21 0000               	LXI	H,0
  2600'   22 2B2E'              	SHLD	SBACK		; the cursor is ON the last line changed
  2603'                         SUB_NX:
  2603'   2A 2B30'              	LHLD	SLINES
  2606'   2B                    	DCX	H
  2607'   22 2B30'              	SHLD	SLINES
  260A'   7C                    	MOV	A,H
  260B'   B5                    	ORA	L
  260C'   CA 262A'              	JZ	SUBDON		; the range is spent
  260F'   21 0001               	LXI	H,1
  2612'   AF                    	XRA	A
  2613'   CD 0000*              	CALL	MVLIND		; the next line, paging with it
  2616'   3A 2B2C'              	LDA	SANY
  2619'   B7                    	ORA	A
  261A'   CA 2624'              	JZ	SUB_AE		; nothing changed yet: nothing to count from
  261D'   2A 2B2E'              	LHLD	SBACK
  2620'   23                    	INX	H
  2621'   22 2B2E'              	SHLD	SBACK		; every step taken after the last change has
                                				;   to be walked back at the end -- including
                                				;   this one, when it lands past the last line
	MACRO-80 3.44	09-Dec-81	PAGE	1-117


  2624'                         SUB_AE:
  2624'   CD 0A5D'              	CALL	ATEOF
  2627'   D2 25F1'              	JNC	SUBLP		; ... unless that ran off the end of the file
  262A'                         SUBDON:
  262A'   CD 0000*              	CALL	CLRCNT		; the walk left the count and direction set
  262D'   3A 2B2C'              	LDA	SANY
  2630'   B7                    	ORA	A
  2631'   CA 264F'              	JZ	SUBNFD
  2634'   3E 01                 	MVI	A,1
  2636'   32 2A72'              	STA	MODF		; the text changed, so ':w' has work to do.  NOT
                                				;   MARKMOD: that also sets DOTCHG, and '.' does
                                				;   not repeat a substitute in vim either (that
                                				;   is '&', which is not built)
  2639'   2A 2B2E'              	LHLD	SBACK
  263C'   7C                    	MOV	A,H
  263D'   B5                    	ORA	L
  263E'   CA 2649'              	JZ	SUB_PL
  2641'   3E FF                 	MVI	A,0FFH
  2643'   CD 0000*              	CALL	MVLIND		; back to the last line changed
  2646'   CD 0000*              	CALL	CLRCNT
  2649'                         SUB_PL:
  2649'   CD 0FCD'              	CALL	GPLACE		; the landing: first non-blank, placed as 'G'
  264C'   C3 07BB'              	JMP	SETFUL		; GPLACE asks for R_MOVE when the target is
                                				;   which rewrote the line under the cursor.
                                				; And that repaint is why a substitute too big
                                				;   for the undo does NOT say so here: EXMSG
                                				;   draws the bottom row there and then, and
                                				;   the full paint this needs takes the status
                                				;   row back (SCRN.MAC says so itself).  'u'
                                				;   carries the message instead -- UNDWHY = 2,
                                				;   at the moment the reader asks for the undo
                                				;   and can still act on the answer.
  264F'                         SUBNFD:
  264F'   21 2B36'              	LXI	H,SOFFS
  2652'   CD 03D0'              	CALL	BACKTO
  2655'   2A 2B39'              	LHLD	SLDLTS
  2658'   22 0000*              	SHLD	LNDLT		; nothing changed: the row the cursor was on
  265B'   21 23C5'              	LXI	H,SNOTFD
  265E'   CD 233B'              	CALL	EXERR
  2661'   21 0000*              	LXI	H,SRCHST
  2664'   C3 2336'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
  2667'                         SUBBAD:
  2667'   21 23B3'              	LXI	H,SNOT
  266A'   C3 2330'              	JMP	EXERT
                                
                                ;SUBLIN -- the substitute on the cursor's line: the first match, or every match
                                ;when 'g' was given.  A = 1 when the line changed.  The cursor is left at the
                                ;line's start either way, so the walk to the next line always starts from one.
                                ;Every offset is re-derived from the cursor after each change, never held
                                ;across one: an insert can page (':%s/0/ZZ/' grows a 100 K file by 12800
                                ;bytes) and paging shifts every logical offset in the window.
  266D'                         SUBLIN:
  266D'   AF                    	XRA	A
  266E'   32 2B2D'              	STA	SLCHG
  2671'   CD 26EC'              	CALL	SUBBOL
  2674'   CD 0000*              	CALL	RGET0		; the line has to be RESIDENT before CEND can
	MACRO-80 3.44	09-Dec-81	PAGE	1-118


  2677'                         SUBL_R:				;   find its end: the pager keeps the CURSOR in
  2677'   CD 0000*              	CALL	RGET		;   the window, not the whole line it sits on,
  267A'   DA 2682'              	JC	SUBL_L		;   and EOLNL only ever scans resident text --
  267D'   FE 0A                 	CPI	LF		;   so a line straddling the resident end came
  267F'   C2 2677'              	JNZ	SUBL_R		;   out short and went unsubstituted (line 179
                                				;   of the 66 K indented file, which starts at
                                				;   byte 2047).  RGET pages through NEEDIN, as
                                				;   every other line reader here does.
  2682'                         SUBL_L:
                                	;--- the scan window: the cursor to the line's content end ---
  2682'   CD 0000*              	CALL	CUROFF
  2685'   E5                    	PUSH	H
  2686'   CD 156F'              	CALL	CEND
  2689'   D1                    	POP	D
  268A'   CD 0000*              	CALL	SUBHD		; HL = the bytes left on the line
  268D'   23                    	INX	H		; FWDCNT's own arithmetic, inline: the span it
  268E'   CD 0000*              	CALL	SUBLEN		;   would measure, plus one, less the pattern.
  2691'   7C                    	MOV	A,H		;   (FWDCNT needs a real pointer pair and this
  2692'   B7                    	ORA	A		;   span is a line, not a pair.)
  2693'   FA 26E5'              	JM	SUBL_D		; what is left is shorter than the pattern
  2696'   44                    	MOV	B,H
  2697'   4D                    	MOV	C,L		; BC = the start positions a match can take
  2698'   11 0000*              	LXI	D,SRCHST
  269B'   2A 0000*              	LHLD	GAPEND		; with the gap at the cursor, the line runs
  269E'   CD 0000*              	CALL	MATCHF		;   forward from GAPEND
  26A1'   DA 26E5'              	JC	SUBL_D
  26A4'   CD 0000*              	CALL	SUBLEN		; MATCHF ends past the match; back to its start
  26A7'   EB                    	XCHG
  26A8'   2A 0000*              	LHLD	GAPEND
  26AB'   EB                    	XCHG
  26AC'   CD 0000*              	CALL	SUBHD		; HL = how far into the scan the match is
  26AF'   EB                    	XCHG
  26B0'   D5                    	PUSH	D		; CUROFF does NOT keep DE (it reads TXTBEG into
  26B1'   CD 0000*              	CALL	CUROFF		;   it), so the delta goes on the stack
  26B4'   D1                    	POP	D
  26B5'   19                    	DAD	D		; ... and so the match's logical offset
  26B6'   CD 0000*              	CALL	GOTO
                                	;--- the first change of the whole substitute re-arms the undo, so 'u'
                                	;    lands on the first match, which is where vim leaves it ---
  26B9'   3A 2B2C'              	LDA	SANY
  26BC'   B7                    	ORA	A
  26BD'   C2 26CA'              	JNZ	SUBL_C
  26C0'   3A 2B2D'              	LDA	SLCHG
  26C3'   B7                    	ORA	A
  26C4'   C2 26CA'              	JNZ	SUBL_C
  26C7'   CD 0000*              	CALL	UNDHER		; the cursor snapshot only: UNDBEG would re-run
                                				;   UNDGRW mid-command, and growing the region
                                				;   where a primitive can see it corrupts the
                                				;   gap ('COPY ERR')
  26CA'                         SUBL_C:
  26CA'   3A 0000*              	LDA	SRCHBF
  26CD'   6F                    	MOV	L,A
  26CE'   26 00                 	MVI	H,0
  26D0'   CD 0000*              	CALL	DELFWD		; the match goes
  26D3'   11 2B3B'              	LXI	D,SREPLN	; ... and the replacement takes its place, the
  26D6'   CD 0000*              	CALL	INSSTR		;   way WM splices one: the length byte with
	MACRO-80 3.44	09-Dec-81	PAGE	1-119


                                				;   its string above it, 'u' capture included
  26D9'                         SUBL_I:
  26D9'   3E 01                 	MVI	A,1
  26DB'   32 2B2D'              	STA	SLCHG
  26DE'   3A 2B2B'              	LDA	SGFLAG
  26E1'   B7                    	ORA	A
  26E2'   C2 2682'              	JNZ	SUBL_L		; 'g': on from PAST the replacement
  26E5'                         SUBL_D:
  26E5'   CD 26EC'              	CALL	SUBBOL
  26E8'   3A 2B2D'              	LDA	SLCHG
  26EB'   C9                    	RET
                                
                                ;SUBBOL -- the cursor to the start of the line it is on.
  26EC'                         SUBBOL:
  26EC'   CD 0000*              	CALL	CUROFF
  26EF'   CD 0624'              	CALL	BOL
  26F2'   C3 0000*              	JMP	GOTO
                                
                                ;VC_SRCH -- '/' and '?': read the pattern, then search.  C is the key, which
                                ; is both the prompt character and the direction.
  26F5'                         VC_SRCH:
  26F5'   CD 079A'              	CALL	SETMOV
  26F8'   C5                    	PUSH	B
  26F9'   CD 06CB'              	CALL	GETCNT
  26FC'   22 2B1B'              	SHLD	SCNT
  26FF'   C1                    	POP	B
  2700'   79                    	MOV	A,C
  2701'   FE 2F                 	CPI	'/'
  2703'   3E 00                 	MVI	A,0
  2705'   CA 270A'              	JZ	VS_DIR
  2708'   3E FF                 	MVI	A,0FFH		; '?' -- backward
  270A'                         VS_DIR:
  270A'   32 2AF0'              	STA	SDIR
  270D'   11 0000*              	LXI	D,SRCHST	; the line is read straight into the pattern
  2710'   3A 0000*              	LDA	SRCMAX		; its capacity is BUF.MAC's to state
  2713'   47                    	MOV	B,A
  2714'   CD 1C64'              	CALL	RDLINE
  2717'   B7                    	ORA	A
  2718'   C0                    	RNZ			; cancelled: nothing happens at all
  2719'   3A 2AC7'              	LDA	RLLEN
  271C'   B7                    	ORA	A
  271D'   CA 2732'              	JZ	VS_OLD		; an empty line repeats the last pattern --
                                				;   RDLINE stored nothing, so it is still there
  2720'   5F                    	MOV	E,A
  2721'   16 00                 	MVI	D,0
  2723'   21 0000*              	LXI	H,SRCHST
  2726'   19                    	DAD	D
  2727'   36 00                 	MVI	M,0		; 0-terminated, and the length below it:
  2729'   7B                    	MOV	A,E
  272A'   32 0000*              	STA	SRCHBF		;   WM's RDSTR layout, built by hand
  272D'   3E 01                 	MVI	A,1
  272F'   32 2AF2'              	STA	SHAVE
  2732'                         VS_OLD:
  2732'   3A 2AF2'              	LDA	SHAVE
  2735'   B7                    	ORA	A
  2736'   CA 2742'              	JZ	VS_NOP		; '/' <CR> with nothing ever searched for
	MACRO-80 3.44	09-Dec-81	PAGE	1-120


  2739'   3A 2AF0'              	LDA	SDIR
  273C'   32 2AF1'              	STA	SDIRE
  273F'   C3 276B'              	JMP	SRCHN
  2742'                         VS_NOP:
  2742'   21 23E5'              	LXI	H,SNOPAT
  2745'   C3 233B'              	JMP	EXERR
                                
                                ;VC_N / VCB_N -- 'n' repeats the last search, 'N' reverses its direction.
  2748'                         VC_N:
  2748'   CD 079A'              	CALL	SETMOV
  274B'   3A 2AF0'              	LDA	SDIR
  274E'   C3 2758'              	JMP	VN_GO
  2751'                         VCB_N:
  2751'   CD 079A'              	CALL	SETMOV
  2754'   3A 2AF0'              	LDA	SDIR
  2757'   2F                    	CMA			; the other way: 0 <-> FFH
  2758'                         VN_GO:
  2758'   32 2AF1'              	STA	SDIRE
  275B'   CD 06CB'              	CALL	GETCNT
  275E'   22 2B1B'              	SHLD	SCNT
  2761'   3A 2AF2'              	LDA	SHAVE
  2764'   B7                    	ORA	A
  2765'   CA 2742'              	JZ	VS_NOP
  2768'   C3 276B'              	JMP	SRCHN
                                
                                ;SRCHN -- the count, one whole-file search each.  Not found at ANY repeat
                                ; leaves the cursor where the command started, as vim does, and says so; the
                                ; message wants the screen left alone, which is what EXERR's R_MOVE is for.
  276B'                         SRCHN:
  276B'   CD 0FB5'              	CALL	GZONE		; the screen's top line, before the cursor moves
  276E'   CD 06F4'              	CALL	BRKON		; where it started (the sweep moves the cursor
                                				;   with PUTCUR, which does not maintain LNDLT;
                                				;   GOTO does), and an ESC may stop it
  2771'                         SN_LP:
  2771'   CD 27A6'              	CALL	SRCHGO
  2774'   DA 2791'              	JC	SN_BAD
  2777'   2A 2B1B'              	LHLD	SCNT
  277A'   2B                    	DCX	H
  277B'   22 2B1B'              	SHLD	SCNT
  277E'   7C                    	MOV	A,H
  277F'   B5                    	ORA	L
  2780'   C2 2771'              	JNZ	SN_LP
  2783'   CD 0000*              	CALL	CLRCNT		; the sweep left CMDCNT wide open (and DIRFLG
                                				;   backward): WM clears both per command
  2786'   CD 072B'              	CALL	BRKOFF
  2789'   3E 01                 	MVI	A,1
  278B'   32 2AFD'              	STA	GPKEEP		; land on the match, not the first non-blank
  278E'   C3 0FCD'              	JMP	GPLACE		; (which sets LNDLT itself)
  2791'                         SN_BAD:
  2791'   CD 072B'              	CALL	BRKOFF
  2794'   DA 0743'              	JC	BRKBAK		; stopped, which is not the same as not found
  2797'   CD 0736'              	CALL	RSTPL		; nothing moved: the row the cursor was on
  279A'   21 23C5'              	LXI	H,SNOTFD
  279D'   CD 233B'              	CALL	EXERR
  27A0'   21 0000*              	LXI	H,SRCHST
  27A3'   C3 2336'              	JMP	EXOUT		; 'Pattern not found: ' and the pattern
	MACRO-80 3.44	09-Dec-81	PAGE	1-121


                                
                                ;SRCHGO -- one search of the whole file, wrapping once: from the cursor to the
                                ; end in SDIRE's direction, then from the other end back to it.  CY = the
                                ; pattern is nowhere in the file (and the cursor is left at an end of it --
                                ; SRCHN is what puts it back).
  27A6'                         SRCHGO:
  27A6'   3E 01                 	MVI	A,1
  27A8'   32 2B24'              	STA	SSKIP		; this pass starts one past the cursor
  27AB'   CD 27C1'              	CALL	SRCHW
  27AE'   D0                    	RNC
  27AF'   CD 072F'              	CALL	BRKQ
  27B2'   D8                    	RC			; stopped: no second pass
  27B3'   3A 2AF1'              	LDA	SDIRE
  27B6'   2F                    	CMA
  27B7'   CD 0000*              	CALL	MVLMAX		; to the end the wrapped pass starts from
  27BA'   AF                    	XRA	A
  27BB'   32 2B24'              	STA	SSKIP		; ... but the wrapped pass starts AT it, or a
                                				;   match on the file's very first character
                                				;   would be stepped over and never found
  27BE'   C3 27C1'              	JMP	SRCHW
                                
                                ;SRCHW -- WM FINDA (WM 1943): the file from the cursor on, one resident
                                ; window at a time.  A miss moves the cursor to that window's edge and pages
                                ; one step (SCRLST), so the search runs off the window and through the file;
                                ; CY when the file runs out.  PAGESTP only pages while the count is unspent,
                                ; so the sweep opens CMDCNT wide, as MVLMAX does.  WM's FINDA then puts the
                                ; cursor exactly at the file's end (WM 1949); nothing here needs that -- the
                                ; caller either wraps to the other end or restores the cursor outright.
  27C1'                         SRCHW:
  27C1'   3A 2AF1'              	LDA	SDIRE
  27C4'   32 0000*              	STA	DIRFLG
  27C7'   21 FFFF               	LXI	H,0FFFFH
  27CA'   22 2A6F'              	SHLD	CMDCNT
  27CD'   AF                    	XRA	A
  27CE'   32 0000*              	STA	AUXCNT
  27D1'                         SW_LP:
  27D1'   CD 072F'              	CALL	BRKQ		; an ESC spent the count, here or on the way to
  27D4'   D8                    	RC			;   the wrapped pass: SCRLST no longer pages
  27D5'   CD 27E1'              	CALL	SRCH1
  27D8'   D0                    	RNC
  27D9'   CD 0000*              	CALL	SCRLST
  27DC'   D2 27D1'              	JNC	SW_LP
  27DF'   37                    	STC
  27E0'   C9                    	RET
                                
                                ;SRCH1 -- WM FINDB (WM 1984) without its RDSTR: one search inside the
                                ; resident window, DIRFLG picking the direction.  CY = not in this window; on
                                ; a hit the cursor is ON the match's first character.
  27E1'                         SRCH1:
  27E1'   11 0000*              	LXI	D,SRCHST
  27E4'   3A 0000*              	LDA	DIRFLG
  27E7'   B7                    	ORA	A
  27E8'   FA 280C'              	JM	SR1_BK
  27EB'   21 0000*              	LXI	H,GAPEND
  27EE'   CD 0000*              	CALL	FWDCNT
  27F1'   2A 0000*              	LHLD	GAPEND		; WM loads the pointer BEFORE testing the
	MACRO-80 3.44	09-Dec-81	PAGE	1-122


  27F4'   D8                    	RC			;   carry: a miss still has to leave HL a
                                				;   real text address, because SCRLST puts
                                				;   the cursor there on the way to paging
  27F5'   3A 2B24'              	LDA	SSKIP
  27F8'   B7                    	ORA	A
  27F9'   CA 2802'              	JZ	SR1_FW
  27FC'   78                    	MOV	A,B
  27FD'   B1                    	ORA	C
  27FE'   37                    	STC
  27FF'   C8                    	RZ			; no room for a match even before the skip
  2800'   0B                    	DCX	B		; vim's '/' starts one character PAST the
  2801'   23                    	INX	H		;   cursor, so the character under it can
                                				;   never be the one that matches
  2802'                         SR1_FW:
  2802'   CD 0000*              	CALL	MATCHF
  2805'   D8                    	RC
  2806'   CD 0000*              	CALL	SUBLEN		; MATCHF ends PAST the match; vi lands on it
  2809'   C3 0000*              	JMP	PUTCUR
  280C'                         SR1_BK:
  280C'   21 0000*              	LXI	H,TXTBEG
  280F'   CD 0000*              	CALL	FWDCNT
  2812'   2A 0000*              	LHLD	GAPBEG		; (as above: the pointer, then the carry)
  2815'   D8                    	RC
  2816'   CD 0000*              	CALL	SUBLEN		; MATCHB already lands on the first character
  2819'   CD 0000*              	CALL	MATCHB
  281C'   D8                    	RC
  281D'   C3 0000*              	JMP	PUTCUR
                                
                                ;============================================================
                                ; DISPATCH TABLES -- the messages first, then CMDTAB and ACTTAB.
                                ;============================================================
                                ;============================================================
                                ; MESSAGES -- the bottom row is vim's message line: blank unless something has
                                ; been said on it.  A message is built by successive calls -- EXPRM first, which
                                ; clears the row, then the pieces straight to the terminal.  There is no
                                ; concatenation buffer and none is wanted: the pieces are a name, a flag and a
                                ; number, and each knows how to write itself.
                                ;
                                ; Every message is drawn AFTER the frame (MSGPST, from the main loop), because
                                ; a full repaint blanks the bottom row -- so a message written during the
                                ; command would be wiped by the repaint that same key causes.
                                ;============================================================
                                
                                ;MSGNAM -- open the row and write the file name at HL (a 12-byte FCB field:
                                ; drive, 8 name, 3 type) in quotes, the way vim opens a message: "TEST.TXT".
                                ; A blank name field is vim's "[No Name]".  vim writes a path relative to the
                                ; current directory -- a file in it bare, "../x/VI.MAC" otherwise -- and the
                                ; logged drive is CP/M's current directory, so the drive is written only when
                                ; it is another one: "B:TEST.TXT".
  2820'                         MSGNAM:
  2820'   E5                    	PUSH	H
  2821'   3E 22                 	MVI	A,'"'
  2823'   CD 0000*              	CALL	EXPRM		; clears the row, writes the opening quote
  2826'   E1                    	POP	H
  2827'   E5                    	PUSH	H		; keep the base: the type field is 9 past it
  2828'   23                    	INX	H
	MACRO-80 3.44	09-Dec-81	PAGE	1-123


  2829'   7E                    	MOV	A,M
  282A'   FE 20                 	CPI	' '
  282C'   C2 2839'              	JNZ	MN_HAS
  282F'   21 2453'              	LXI	H,SNONM
  2832'   CD 0000*              	CALL	OUTSTR
  2835'   E1                    	POP	H
  2836'   C3 2883'              	JMP	MN_END
  2839'                         MN_HAS:
  2839'   0E 19                 	MVI	C,BF_CURDSK
  283B'   CD 0005               	CALL	BDOS		; A = the logged drive, A: = 0
  283E'   E1                    	POP	H
  283F'   E5                    	PUSH	H
  2840'   3C                    	INR	A		; the FCB's drive byte is explicit, A: = 1
  2841'   BE                    	CMP	M
  2842'   CA 2850'              	JZ	MN_NAM
  2845'   7E                    	MOV	A,M
  2846'   C6 40                 	ADI	'A'-1
  2848'   CD 0000*              	CALL	OUTCH
  284B'   3E 3A                 	MVI	A,':'
  284D'   CD 0000*              	CALL	OUTCH
  2850'                         MN_NAM:
  2850'   E1                    	POP	H
  2851'   E5                    	PUSH	H
  2852'   23                    	INX	H
  2853'   0E 08                 	MVI	C,8
  2855'                         MN_NM:
  2855'   7E                    	MOV	A,M
  2856'   FE 20                 	CPI	' '
  2858'   CA 2863'              	JZ	MN_EXT
  285B'   CD 0000*              	CALL	OUTCH
  285E'   23                    	INX	H
  285F'   0D                    	DCR	C
  2860'   C2 2855'              	JNZ	MN_NM
  2863'                         MN_EXT:
  2863'   E1                    	POP	H
  2864'   11 0009               	LXI	D,9
  2867'   19                    	DAD	D		; the type field
  2868'   7E                    	MOV	A,M
  2869'   FE 20                 	CPI	' '
  286B'   CA 2883'              	JZ	MN_END
  286E'   3E 2E                 	MVI	A,'.'
  2870'   CD 0000*              	CALL	OUTCH
  2873'   0E 03                 	MVI	C,3
  2875'                         MN_XL:
  2875'   7E                    	MOV	A,M
  2876'   FE 20                 	CPI	' '
  2878'   CA 2883'              	JZ	MN_END
  287B'   CD 0000*              	CALL	OUTCH
  287E'   23                    	INX	H
  287F'   0D                    	DCR	C
  2880'   C2 2875'              	JNZ	MN_XL
  2883'                         MN_END:
  2883'   3E 22                 	MVI	A,'"'
  2885'   C3 0000*              	JMP	OUTCH
                                
                                ;MSGFLG -- the flags after the name, in vim's order and with vim's spelling:
	MACRO-80 3.44	09-Dec-81	PAGE	1-124


                                ; [Modified][readonly][New], run together with ONE space before the first of
                                ; them (measured from vim 9.1).  A = 0 leaves [Modified] out, which is the load
                                ; message, where nothing has been changed yet.
  2888'                         MSGFLG:
  2888'   06 00                 	MVI	B,0		; B: a flag has been written (the space goes once)
  288A'   B7                    	ORA	A
  288B'   CA 289B'              	JZ	MF_RO
  288E'   3A 2A72'              	LDA	MODF
  2891'   B7                    	ORA	A
  2892'   CA 289B'              	JZ	MF_RO
  2895'   21 245D'              	LXI	H,SMODM
  2898'   CD 28B0'              	CALL	MF_PUT
  289B'                         MF_RO:
  289B'   3A 2ADD'              	LDA	ROFLAG
  289E'   B7                    	ORA	A
  289F'   CA 28A8'              	JZ	MF_NEW
  28A2'   21 2468'              	LXI	H,SROM
  28A5'   CD 28B0'              	CALL	MF_PUT
  28A8'                         MF_NEW:
  28A8'   3A 2ADB'              	LDA	MSGNEW
  28AB'   B7                    	ORA	A
  28AC'   C8                    	RZ
  28AD'   21 2473'              	LXI	H,SNEWM
  28B0'                         MF_PUT:
  28B0'   78                    	MOV	A,B
  28B1'   B7                    	ORA	A
  28B2'   C2 28BE'              	JNZ	MF_STR
  28B5'   06 01                 	MVI	B,1
  28B7'   E5                    	PUSH	H
  28B8'   3E 20                 	MVI	A,' '
  28BA'   CD 0000*              	CALL	OUTCH
  28BD'   E1                    	POP	H
  28BE'                         MF_STR:
  28BE'   C3 0000*              	JMP	OUTSTR
                                
                                ;EMITW -- HL as unsigned decimal, no leading zeros (0 still prints one digit).
                                ; Repeated subtraction of each power of ten, which is all an 8080 has.  B
                                ; carries 'a digit has been printed' so the leading zeros are skipped.
  28C1'                         EMITW:
  28C1'   C5                    	PUSH	B
  28C2'   D5                    	PUSH	D
  28C3'   06 00                 	MVI	B,0
  28C5'   11 2710               	LXI	D,10000
  28C8'   CD 28E6'              	CALL	EWDIG
  28CB'   11 03E8               	LXI	D,1000
  28CE'   CD 28E6'              	CALL	EWDIG
  28D1'   11 0064               	LXI	D,100
  28D4'   CD 28E6'              	CALL	EWDIG
  28D7'   11 000A               	LXI	D,10
  28DA'   CD 28E6'              	CALL	EWDIG
  28DD'   7D                    	MOV	A,L		; the units digit is always printed
  28DE'   C6 30                 	ADI	'0'
  28E0'   CD 0000*              	CALL	OUTCH
  28E3'   D1                    	POP	D
  28E4'   C1                    	POP	B
  28E5'   C9                    	RET
	MACRO-80 3.44	09-Dec-81	PAGE	1-125


  28E6'                         EWDIG:
  28E6'   0E 00                 	MVI	C,0
  28E8'                         EW_LP:
  28E8'   7D                    	MOV	A,L
  28E9'   93                    	SUB	E
  28EA'   6F                    	MOV	L,A
  28EB'   7C                    	MOV	A,H
  28EC'   9A                    	SBB	D
  28ED'   67                    	MOV	H,A
  28EE'   DA 28F5'              	JC	EW_DN
  28F1'   0C                    	INR	C
  28F2'   C3 28E8'              	JMP	EW_LP
  28F5'                         EW_DN:
  28F5'   19                    	DAD	D		; one subtraction too many: give it back
  28F6'   79                    	MOV	A,C
  28F7'   B7                    	ORA	A
  28F8'   C2 28FE'              	JNZ	EW_PR
  28FB'   78                    	MOV	A,B
  28FC'   B7                    	ORA	A
  28FD'   C8                    	RZ			; a leading zero: write nothing
  28FE'                         EW_PR:
  28FE'   79                    	MOV	A,C
  28FF'   C6 30                 	ADI	'0'
  2901'   CD 0000*              	CALL	OUTCH
  2904'   06 01                 	MVI	B,1
  2906'   C9                    	RET
                                
                                ;ISEMPT -- Z iff the buffer holds nothing at all: no resident text, and nothing
                                ; spilled behind the window either.  vim's '--No lines in buffer--', shortened.
  2907'                         ISEMPT:
  2907'   2A 0000*              	LHLD	OUTPOS
  290A'   7C                    	MOV	A,H
  290B'   B5                    	ORA	L
  290C'   C0                    	RNZ
  290D'   CD 0000*              	CALL	LOGLEN
  2910'   7C                    	MOV	A,H
  2911'   B5                    	ORA	L
  2912'   C9                    	RET
                                
                                ;MSGCTG -- '^G': the file, its flags, and where the cursor is.  DEVIATION: vim
                                ; also gives the file's line total and a percentage of it; no line total is kept
                                ; anywhere here, and counting one means a sweep of the whole file out to EOF and
                                ; a page back -- which would cost the undo region (PGTOPM) as well as the wait.
  2913'                         MSGCTG:
  2913'   21 0000*              	LXI	H,FNAME
  2916'   CD 2820'              	CALL	MSGNAM
  2919'   3E 01                 	MVI	A,1		; '^G' is where vim shows [Modified]
  291B'   CD 2888'              	CALL	MSGFLG
  291E'   CD 2907'              	CALL	ISEMPT
  2921'   C2 292A'              	JNZ	MG_POS
  2924'   21 2486'              	LXI	H,SNOLIN
  2927'   C3 0000*              	JMP	OUTSTR
  292A'                         MG_POS:
  292A'   21 2479'              	LXI	H,SLINE
  292D'   CD 0000*              	CALL	OUTSTR
  2930'   CD 0000*              	CALL	CNTLF		; the line feeds before the cursor ...
	MACRO-80 3.44	09-Dec-81	PAGE	1-126


  2933'   23                    	INX	H		;   ... so the line it is on
  2934'   CD 28C1'              	CALL	EMITW
  2937'   21 2480'              	LXI	H,SCOLM
  293A'   CD 0000*              	CALL	OUTSTR
  293D'   2A 0000*              	LHLD	CBOL		; the byte column within the line, 0-based
  2940'   23                    	INX	H
  2941'   E5                    	PUSH	H
  2942'   CD 28C1'              	CALL	EMITW
  2945'   2A 0000*              	LHLD	CURDCL		; the column a TAB expands that byte to
  2948'   23                    	INX	H
  2949'   D1                    	POP	D
  294A'   CD 0000*              	CALL	CMP16		; the same -> vim writes one number, not two
  294D'   C8                    	RZ
  294E'   E5                    	PUSH	H
  294F'   3E 2D                 	MVI	A,'-'
  2951'   CD 0000*              	CALL	OUTCH
  2954'   E1                    	POP	H
  2955'   C3 28C1'              	JMP	EMITW
                                
                                ;FILMSG -- the load message: the file and its flags.  vim adds the line and
                                ; byte totals ('3L, 30B'); the line total is the sweep MSGCTG's note describes.
                                ; A buffer with no file name gets no message at all, as in vim.
  2958'                         FILMSG:
  2958'   3A 0001*              	LDA	FNAME+1
  295B'   FE 20                 	CPI	' '
  295D'   C8                    	RZ
  295E'   21 0000*              	LXI	H,FNAME
  2961'   CD 2820'              	CALL	MSGNAM
  2964'   AF                    	XRA	A		; nothing has been changed yet
  2965'   C3 2888'              	JMP	MSGFLG
                                
                                ;WRMSG -- what ':w' says.  vim counts what it wrote ('"TEST.TXT" 3L, 29B
                                ; written'); the counts are the same sweep, so this says only that it happened.
                                ; The name is TFCB's, so ':w OTHER.TXT' names the file it really wrote.
  2968'                         WRMSG:
  2968'   21 0000*              	LXI	H,TFCB
  296B'   CD 2820'              	CALL	MSGNAM
  296E'   21 2498'              	LXI	H,SWRIT
  2971'   C3 0000*              	JMP	OUTSTR
                                
                                ;MSGPST -- draw the message this key asked for, once the frame is painted, and
                                ; put the cursor back.  The main loop calls it after SCDRAW and MODEMS.
  2974'                         MSGPST:
  2974'   3A 2ADA'              	LDA	MSGWHT
  2977'   B7                    	ORA	A
  2978'   C8                    	RZ
  2979'   47                    	MOV	B,A
  297A'   AF                    	XRA	A
  297B'   32 2ADA'              	STA	MSGWHT
  297E'   78                    	MOV	A,B
  297F'   FE 01                 	CPI	MW_FIL
  2981'   CA 299D'              	JZ	MP_FIL
  2984'   FE 02                 	CPI	MW_WRT
  2986'   CA 29A3'              	JZ	MP_WRT
  2989'   FE 04                 	CPI	MW_BIG
  298B'   CA 2994'              	JZ	MP_BIG
	MACRO-80 3.44	09-Dec-81	PAGE	1-127


  298E'   CD 2913'              	CALL	MSGCTG
  2991'   C3 0000*              	JMP	SCURS
  2994'                         MP_BIG:
  2994'   21 2434'              	LXI	H,SQBIG
  2997'   CD 0000*              	CALL	EXMSG
  299A'   C3 0000*              	JMP	SCURS
  299D'                         MP_FIL:
  299D'   CD 2958'              	CALL	FILMSG
  29A0'   C3 0000*              	JMP	SCURS
  29A3'                         MP_WRT:
  29A3'   CD 2968'              	CALL	WRMSG
  29A6'   C3 0000*              	JMP	SCURS
                                
                                ;VC_CTLG -- '^G'.  It changes nothing and moves nothing, so the frame is a
                                ; still one and the message goes on after it.
  29A9'                         VC_CTLG:
  29A9'   3E 03                 	MVI	A,MW_CTG
  29AB'   32 2ADA'              	STA	MSGWHT
  29AE'   3E 01                 	MVI	A,R_MOVE
  29B0'   32 2A73'              	STA	RINTENT
  29B3'   C3 06CB'              	JMP	GETCNT		; a count typed before it is spent here, not
                                				;   left for the next command
                                
