  0B6B'   CD 0000*              	CALL	SETBWD		; WM line move: start of the line count above
  0B6E'   D1                    	POP	D		; DE = moved
  0B6F'   2A 2F21'              	LHLD	JKN
  0B72'   CD 0000*              	CALL	CMP16		; CY iff moved < N
  0B75'   DA 0B79'              	JC	KC_AD
  0B78'   EB                    	XCHG			; DE = N
  0B79'                         KC_AD:
  0B79'   2A 0000*              	LHLD	LNDLT		; LNDLT -= min(moved, N)
  0B7C'   CD 0000*              	CALL	SUBHD
  0B7F'   22 0000*              	SHLD	LNDLT
  0B82'   C9                    	RET
                                ;--- as JC_QK, back: the line starts after the LF one past the count, or
                                ;    where the text does when that is the file's start and the count ends
                                ;    there.  Fewer lines than the count, or text paged out: the long way ---
  0B83'                         KC_QK:
  0B83'   22 2F21'              	SHLD	JKN		; N = the count
  0B86'   2A 0000*              	LHLD	TXTBEG
  0B89'   EB                    	XCHG
  0B8A'   2A 0000*              	LHLD	GAPBEG
  0B8D'   E5                    	PUSH	H
  0B8E'   CD 0000*              	CALL	SUBHD
  0B91'   44                    	MOV	B,H
  0B92'   4D                    	MOV	C,L		; BC = the bytes before the cursor
  0B93'   E1                    	POP	H
  0B94'   3A 2F21'              	LDA	JKN
  0B97'   3C                    	INR	A
  0B98'   5F                    	MOV	E,A		; E = LFs to find
  0B99'   16 0A                 	MVI	D,LF
  0B9B'   04                    	INR	B
  0B9C'   0C                    	INR	C
  0B9D'                         KQ_LP:
  0B9D'   0D                    	DCR	C
  0B9E'   C2 0BA5'              	JNZ	KQ_CH
  0BA1'   05                    	DCR	B
  0BA2'   CA 0BC5'              	JZ	KQ_TB
