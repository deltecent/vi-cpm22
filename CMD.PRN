  28D4'   60                    	DB	60H		; `{a-c} -- back to its exact spot
  28D5'   0355'                 	DW	VC_BQ
  28D7'   27                    	DB	27H		; '{a-c} -- back to its line's first non-blank
  28D8'   035A'                 	DW	VC_AQ
